%% ERROR in double nesting
%% Declaration: foo(Outer?) - input
%% In HEAD: complement -> output
%% outer(Inner?): combine(output, input) = input
%% inner(Number?): combine(input, input) = output
%% Expects reader X?, but has writer X - ERROR

Inner ::= inner(Number?).
Outer ::= outer(Inner?).

procedure foo(Outer?).
procedure produce(Number).

foo(outer(inner(X))) :- produce(X?).
produce(0).
