%% ERROR: Wrong mode after double involution
%% Declaration: foo(Outer?) - input
%% combine(input, input) = output, then combine(output, input) = input
%% At input position, head expects WRITER
%% But X? is reader - MODE ERROR

Inner ::= inner(Number?).
Outer ::= outer(Inner?).

procedure foo(Outer?).
procedure source(Number).

foo(outer(inner(X?))) :- source(X).
source(0).
