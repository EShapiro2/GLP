%% ERROR: Wrong mode in list element
%% request(Number?) inside MsgList?
%% HEAD complement -> output
%% combine(output, input) = input
%% Expects writer, but X? is reader - ERROR

Msg ::= request(Number?).
MsgList ::= [] ; [Msg | MsgList].

procedure process(MsgList?).

process([request(X?)|Rest]) :- process(Rest?).
process([]).
