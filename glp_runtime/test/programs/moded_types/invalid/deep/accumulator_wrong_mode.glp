%% INVALID: SRSW violation - Result has no corresponding reader
%% 
%% Mode analysis:
%%   - Nat (output, ↑) expects writer in head → Result is writer ✓
%% 
%% SRSW analysis:
%%   - Result is writer, but Result? never appears → SRSW violation

Nat ::= z ; s(Nat).
List ::= [] ; [Nat | List].

procedure sum(List?, Nat?, Nat).

%% ERROR: Result is writer but Result? never appears → SRSW violation
sum([X|Xs], Acc, Result) :-
    NewAcc := Acc? + X?,
    sum(Xs?, NewAcc?, Result).
sum([], Acc, Acc?).
