%% INVALID: SRSW violation - V? appears but V never does
%%
%% Tree = leaf(Number) ; node(Tree, Tree) - no embedded ?
%% At Forest? (input ↓):
%%   - leaf position at ↓
%%   - Number position at ↓ (no ? to flip)
%%   - At ↓, expects reader → V? is reader ✓
%%
%% SRSW: V? is reader in head AND body, but V never appears → SRSW violation

Tree ::= leaf(Number) ; node(Tree, Tree).
Forest ::= [] ; [Tree | Forest].

procedure collect(Forest?, Number?).

%% ERROR: V? is reader but V never appears → SRSW violation
collect([leaf(V?)|Rest], Acc) :- 
    NewAcc := Acc? + V?,
    collect(Rest?, NewAcc?).
collect([node(L,R)|Rest], Acc) :- 
    collect([L?,R?|Rest?], Acc?).
collect([], Acc).
