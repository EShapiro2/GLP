%% INVALID: SRSW violation - Req and Resp have no corresponding pairs
%%
%% Mode analysis for ch(Number?, Number) at INPUT (↓):
%%   - First arg Number? at ↓: combine(↓, ↓) = ↑, expects writer
%%   - Second arg Number at ↓: combine(↓, ↑) = ↑, expects writer
%%   - Req? is reader at position expecting writer → mode error
%%   - Resp? is reader at position expecting writer → mode error
%%
%% Also SRSW violations: Req? without Req, Resp? without Resp

Channel ::= ch(Number?, Number).

procedure bad_channel(Channel?).

%% ERROR: Mode errors (readers where writers expected) AND SRSW violations
bad_channel(ch(Req?, Resp?)).
