%% Double embedding - two inversions cancel out
%% Declaration: foo(Outer?) - input
%% In HEAD: complement -> output
%% Inside outer(Inner?): input embedded
%% Combined: combine(output, input) = input
%% Inside inner(Number?): input embedded
%% Combined: combine(input, input) = output (involution!)
%% So expects reader X?

Inner ::= inner(Number?).
Outer ::= outer(Inner?).

procedure foo(Outer?).
procedure use(Number?).

foo(outer(inner(X?))) :- use(X?).
use(Y).
