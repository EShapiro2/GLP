%% Real-world: counter with response slot
%% CounterStream? = input at top
%% In HEAD: complement -> output
%% List cons [H|T]: head is output, tail is output
%% So CounterMsg position is output
%% Inside show(Number?): embedded input
%% Combined: combine(output, input) = input
%% So expects writer for response slot

CounterMsg ::= clear ; up ; down ; show(Number?).
CounterStream ::= [] ; [CounterMsg | CounterStream].

procedure counter(CounterStream?, Number).

counter([show(State)|S], State?) :- counter(S?, State?).
counter([clear|S], _) :- counter(S?, 0).
counter([], _).
