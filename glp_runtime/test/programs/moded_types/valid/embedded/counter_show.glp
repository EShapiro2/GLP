%% Real-world counter with response slot
%% Both arguments are inputs (CounterStream?, Number?)
%% show(Number?) has embedded output position for response
%% State? is reader at input position - CORRECT

CounterMsg ::= clear ; up ; down ; show(Number?).
CounterStream ::= [] ; [CounterMsg | CounterStream].

procedure counter(CounterStream?, Number?).

counter([show(State?)|S], State) :- number(State?) | counter(S?, State?).
counter([up|S], State) :- number(State?) | Next := State? + 1, counter(S?, Next?).
counter([down|S], State) :- number(State?) | Next := State? - 1, counter(S?, Next?).
counter([clear|S], _) :- counter(S?, 0).
counter([], _).
