%% Real-world counter with response slot
%% CounterStream? = input
%% List element position: input (same as parent)
%% show(Number?): combine(input, input) = output
%% At output position, head expects READER for response slot
%% State? is reader - CORRECT
%% Uses ground guard for multiple reader occurrences

CounterMsg ::= clear ; up ; down ; show(Number?).
CounterStream ::= [] ; [CounterMsg | CounterStream].

procedure counter(CounterStream?, Number).

counter([show(State?)|S], State) :- number(State?) | counter(S?, State?).
counter([clear|S], _) :- counter(S?, 0).
counter([], _).
