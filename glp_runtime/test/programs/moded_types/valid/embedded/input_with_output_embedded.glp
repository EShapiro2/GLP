%% combine(input, output) = input
%% Head complement: input -> output at top
%% Then combine(output, output) = output
%% Wait - need to think through head complement...
%%
%% Declaration: consume(Wrapper?) - input mode
%% In HEAD: complement -> expects output (writer fills slot)
%% Inside wrap(Number): Number is output (no ?)
%% Combined: combine(output, output) = output
%% So expects reader X?

Wrapper ::= wrap(Number).

procedure consume(Wrapper?).
procedure use(Number?).

consume(wrap(X?)) :- use(X?).
use(Y).
