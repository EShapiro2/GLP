% test: constant_to_integer_reverse
% expected: fail (even with subtyping)
% description: Subtyping is directional.  Integer <: Constant, but Constant is
%   not a subtype of Integer (Definition "Primitive Subtype Order" is the least
%   partial order, so it relates nothing else).  A Constant writer therefore
%   cannot fill an Integer reader.  Positive twin:
%   positive/subtyping/integer_below_number_and_constant.glp.

procedure constant_source(Constant).
constant_source(a).

procedure int_sink(Integer?).
int_sink(_).

procedure connect.
connect :- constant_source(X), int_sink(X?).
