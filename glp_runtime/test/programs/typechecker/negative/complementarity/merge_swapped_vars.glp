% Test: Merge - swapped reader/writer
% Paper: Appendix A.1 (negative control)
% Description: Complementarity error - X? used at both input and output

%% TEST: Merge swapped reader/writer
%% PAPER: Appendix A.1
%% EXPECT: ill-typed
%% ERROR: complementarity: X? appears at incompatible positions

% Uses predefined Stream type from stdlib

procedure merge(Stream?, Stream?, Stream).

% WRONG: X? in input head element (gets _?) AND in output head element (expects _)
merge([X?|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).
