% Test: Merge - writers at output position (mode error)
% Paper: Appendix A.1 (negative control)
% Description: Head error - writers X, Zs at output position (should be readers)

%% TEST: Merge writer at output position
%% PAPER: Appendix A.1
%% EXPECT: ill-typed
%% ERROR: Arg 3 has mode error: X, Zs are writers at output (should be readers X?, Zs?)

% Uses predefined Stream type from stdlib

procedure merge(Stream?, Stream?, Stream).

% WRONG: Arg 3 output position expects readers, but X and Zs are writers
merge([X|Xs], Ys, [X|Zs]) :- merge(Ys?, Xs?, Zs?).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).
