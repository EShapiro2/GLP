% Test: Merge - writer at output position
% Paper: Appendix A.1 (negative control)
% Description: Head error - writer X at output position (should be reader X?)

%% TEST: Merge writer at output position
%% PAPER: Appendix A.1
%% EXPECT: ill-typed
%% ERROR: head: mode mismatch

Stream ::= [] ; [_|Stream].

procedure merge(Stream?, Stream?, Stream).

% WRONG: X and Zs are writers at output position (should be readers)
merge([X|Xs], Ys, [X|Zs]) :- merge(Ys?, Xs?, Zs?).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).
