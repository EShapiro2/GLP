% Test: Merge - reader at input position
% Paper: Appendix A.1 (negative control)
% Description: Head error - reader X? at input position (should be writer X)

%% TEST: Merge reader at input position
%% PAPER: Appendix A.1
%% EXPECT: ill-typed
%% ERROR: head: mode mismatch

Stream ::= [] ; [_|Stream].

procedure merge(Stream?, Stream?, Stream).

% WRONG: X? and Xs? are readers at input positions (should be writers)
merge([X?|Xs?], Ys, [X|Zs]) :- merge(Ys?, Xs, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).
