% test: merge_variable_coverage_mixed
% expected: pass
% description: Demonstrates that variables at input positions cover all type alternatives.
%              Clause 2 has Xs at arg1, covering all of Stream? (both [] and [_?|Stream?]).
%              Per Definition 5.5 (Consistent Paths): X? is compatible with any state with mode down.
%              Missing merge([], Ys, Ys?) but Xs in clause 2 provides coverage for [] at arg1.

% Uses predefined Stream type from stdlib

procedure merge(Stream?, Stream?, Stream).

merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
