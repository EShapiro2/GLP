% test: monitor_simple
% expected: pass
% description: Simplified monitor - tests basic stream processing
% (Full monitor with hollow messages requires nested type automaton fix)

IntStream ::= [] ; [Integer|IntStream].

procedure process_ints(IntStream?, Integer).

process_ints([], 0).
process_ints([X|Xs], N) :- process_ints(Xs?, M), N := X? + M?.
