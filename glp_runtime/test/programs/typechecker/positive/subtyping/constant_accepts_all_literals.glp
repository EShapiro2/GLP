% test: constant_accepts_all_literals
% expected: pass
% description: A Constant-typed position accepts every kind of constant term.
%   Constant ::= Number ; String ; Module. is a root self.glp union, so a
%   literal matches by descending the union to the primitive it belongs to:
%   an integer or real through Number ::= Integer ; Real., a quoted string or
%   an unquoted constant through String (rows 4-6 of the consistency table,
%   Definition "Consistent Paths").

ConstantList ::= [] ; [Constant|ConstantList].

procedure lit(Constant).
lit(42).
lit(2.5).
lit("hello").
lit(ok).

procedure lits(ConstantList).
lits([1, 2.5, "s", ok]).
