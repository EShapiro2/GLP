% test: integer_below_number_and_constant
% expected: pass (requires subtyping)
% description: Integer <: Number and Integer <: Constant, derived from the root
%   self.glp unions Number ::= Integer ; Real. and
%   Constant ::= Number ; String ; Module. — there is no built-in order among
%   the primitives.  Body-body pair: writer X at Integer (from int_source
%   output), reader X? at Number? / Constant? (from the sink's input).

procedure int_source(Integer).
int_source(1).

procedure number_sink(Number?).
number_sink(_).

procedure constant_sink(Constant?).
constant_sink(_).

procedure to_number.
to_number :- int_source(X), number_sink(X?).

procedure to_constant.
to_constant :- int_source(X), constant_sink(X?).
