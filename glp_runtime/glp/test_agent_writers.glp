%% test_agent_writers.glp - Test agent with writers passed to agent_loop

merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys?, Ys).
merge(Xs?, [], Xs).

%% Agent passes WRITERS to agent_loop (not readers)
agent(Id, ch(UserIn, UserOut), ch(NetIn, NetOut)) :-
    merge(UserIn?, NetIn?, In),
    agent_loop(Id?, In?, UserOut, NetOut).

%% agent_loop builds output in head patterns (echo style)
agent_loop(Id, [send(To, Content)|In], [sent(To?, Content?)|UserOut?], [msg(Id?, To?, Content?)|NetOut?]) :-
    ground(Id?), ground(To?), ground(Content?) |
    agent_loop(Id?, In?, UserOut, NetOut).

agent_loop(_, [], [], []).

check_user([sent(bob, ping)|_]).
check_net([msg(alice, bob, ping)|_]).

test_agent_writers :-
    agent(alice, ch(UserIn?, UserOut), ch(NetIn?, NetOut)),
    UserIn = [send(bob, ping)],
    NetIn = [],
    check_user(UserOut?),
    check_net(NetOut?).
