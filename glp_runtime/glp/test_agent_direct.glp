%% test_agent_direct.glp - Agent with direct output patterns (no wrapper)

merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys?, Ys).
merge(Xs?, [], Xs).

%% Agent directly handles send command - builds output in head (echo style)
%% This avoids the wrapper passing writers to another predicate
agent(Id, ch([send(To, Content)|UserIn], [sent(To?, Content?)|UserOut?]),
          ch(NetIn, [msg(Id?, To?, Content?)|NetOut?])) :-
    ground(Id?), ground(To?), ground(Content?) |
    agent(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut)).

%% Base case - empty inputs close outputs
agent(_, ch([], []), ch([], [])).

check_user([sent(bob, ping)|_]).
check_net([msg(alice, bob, ping)|_]).

test_agent_direct :-
    agent(alice, ch(UserIn?, UserOut), ch(NetIn?, NetOut)),
    UserIn = [send(bob, ping)],
    NetIn = [],
    check_user(UserOut?),
    check_net(NetOut?).
