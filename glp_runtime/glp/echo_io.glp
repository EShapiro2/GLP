%% echo_io.glp - Simple echo for I/O testing (Phase 0)
%%
%% Test with io_test_harness.dart:
%%   IO> load echo_io.glp
%%   IO> goal echo_test(Ch)
%%   IO> inject hello
%%   IO> run
%%   IO> output
%%
%% Expected: Output stream receives echo(hello)

%% Main entry: pattern match directly in head to satisfy SRSW
%% ch(In, Out) where In is input reader, Out is output writer
%% Pattern [H|In] matches input element, produces echo(H) on output
%% Out? in head is reader - we READ the output stream position
%% Out in body is writer - we WRITE the tail for the recursive call
echo_test(ch([H|In], [echo(H?)|Out?])) :-
    ground(H?) |
    echo_test(ch(In?, Out)).

%% Empty input: close output stream
echo_test(ch([], [])).
