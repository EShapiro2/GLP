%% play_ping_pong.glp - Test play for ping-pong agent
%%
%% Scenario: Alice sends ping to Bob via network, Bob auto-responds with pong.
%% Uses friends list + lookup_send pattern (same as play_alice_bob.glp)

%% === Library predicates (inlined) ===

merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys?, Ys).
merge(Xs?, [], Xs).

%% === Network switch (2-way) ===
%% Routes msg(From, To, Content) based on To field

network2((alice, ch([msg(alice, bob, X)|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [msg(alice, bob, X?)|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [msg(bob, alice, X?)|AliceOut?])),
         (bob, ch([msg(bob, alice, X)|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% === Simple Ping-Pong Agent (using friends list pattern) ===
%% Agent wraps streams in friends list, passes to loop

agent(Id, ch(UserIn, UserOut), ch(NetIn, NetOut)) :-
    merge(UserIn?, NetIn?, In),
    build_friends(UserOut?, NetOut?, Fs),
    ping_pong_loop(Id?, In?, Fs?).

build_friends(UserOut, NetOut, [(user, UserOut?), (net, NetOut?)]).

%% User sends a message - forward to network
ping_pong_loop(Id, [send(To, Content)|In], Fs) :-
    ground(Id?), ground(To?), ground(Content?) |
    lookup_send(user, sent(To?, Content?), Fs?, Fs1),
    lookup_send(net, msg(Id?, To?, Content?), Fs1?, Fs2),
    ping_pong_loop(Id?, In?, Fs2?).

%% Receive ping from network - reply with pong
ping_pong_loop(Id, [msg(From, To, ping)|In], Fs) :-
    ground(Id?), ground(From?), ground(To?), Id? =?= To? |
    lookup_send(user, received_ping(From?), Fs?, Fs1),
    lookup_send(net, msg(Id?, From?, pong), Fs1?, Fs2),
    ping_pong_loop(Id?, In?, Fs2?).

%% Receive pong from network - report to user
ping_pong_loop(Id, [msg(From, To, pong)|In], Fs) :-
    ground(Id?), ground(From?), ground(To?), Id? =?= To? |
    lookup_send(user, received_pong(From?), Fs?, Fs1),
    ping_pong_loop(Id?, In?, Fs1?).

%% Empty input - close all outputs
ping_pong_loop(_, [], Fs) :- close_all(Fs?).

close_all([]).
close_all([(_, Out)|Rest]) :- Out? = [], close_all(Rest?).

%% === lookup_send: find channel by key and extend its stream ===

lookup_send(Key, Msg, [(K, Out)|Rest], [(K?, Out1?)|Rest?]) :-
    Key? =?= K? |
    Out? = [Msg?|Out1].

lookup_send(Key, Msg, [(K, Out)|Rest], [(K?, Out?)|Rest1?]) :-
    otherwise |
    lookup_send(Key?, Msg?, Rest?, Rest1).

%% === Actors ===

%% Alice: sends ping command
alice_actor(_, [send(bob, ping)]).

%% Bob: no user input
bob_actor(_, []).

%% === The Play ===

play_ping_pong :-
    %% Network switch
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),

    %% Alice's agent
    agent(alice, ch(AliceUserIn?, AliceUserOut), ch(AliceNetIn?, AliceNetOut)),

    %% Bob's agent
    agent(bob, ch(BobUserIn?, BobUserOut), ch(BobNetIn?, BobNetOut)),

    %% Actors
    alice_actor(AliceUserOut?, AliceUserIn),
    bob_actor(BobUserOut?, BobUserIn).
