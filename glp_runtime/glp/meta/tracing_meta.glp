%% tracing_meta.glp - Tracing meta-interpreter
%%
%% Records execution tree for inspection and replay.
%% Tree format: reduction(Goal, ClauseId, BodyTree) | fork(T1, T2) | true
%%
%% Uses '_copy'/2 kernel to snapshot goals before reduction.

run(_, true, true).                              % halt
run(M, (A,B), fork(TA?, TB?)) :-                 % fork
    ground(M?) |
    run(M?, A?, TA),
    run(M?, B?, TB).
run(M, A, reduction(A_copy?, I?, TB?)) :-        % reduce
    tuple(A?) |
    '_copy'(A?, A_copy),
    reduce(A?, B, I),
    run(M?, B?, TB).

%% Object program: merge with clause indices
reduce(merge([X|Xs], Ys, [X?|Zs?]), merge(Xs?, Ys?, Zs), 1).
reduce(merge(Xs, [Y|Ys], [Y?|Zs?]), merge(Xs?, Ys?, Zs), 2).
reduce(merge([], [], []), true, 3).

%% Test
test(Zs?, Tree?) :- run(m, merge([1,2], [3,4], Zs), Tree).
