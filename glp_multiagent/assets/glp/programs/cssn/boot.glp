%% =============================================================================
%% FPLAY4 — CSSG: All four accept (tagged output)
%% =============================================================================

exported procedure fplay4.
fplay4 :-
    actors # alice4(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetAndChildIn?, AliceConvs?,
          [user_output(AliceAgentToUser),
           child_output(carol, AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob4(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetAndChildIn?, BobConvs?,
          [user_output(BobAgentToUser),
           child_output(dave, BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # carol4(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolCmds, CarolDispCmd),
    superapp # split_cmds(CarolCmds?, CarolMedIn, CarolSgCmds),
    superapp # superapp(carol, CarolSgCmds?, CarolSgNotify, CarolConvs, CarolSgOut, CarolSgIn?, [], 1),
    childsafe # child_agent(carol, alice, state(0, 0, [], []), CarolAgentIn?, CarolFromAlice?, CarolConvs?,
          [user_output(CarolAgentToUser),
           parent_output(alice, CarolToAlice)]),
    childsafe # ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    superapp # merge_notify(CarolSgNotify?, CarolMedOut?, CarolNotify),
    tee(CarolNotify?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    actors # dave4(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveCmds, DaveDispCmd),
    superapp # split_cmds(DaveCmds?, DaveMedIn, DaveSgCmds),
    superapp # superapp(dave, DaveSgCmds?, DaveSgNotify, DaveConvs, DaveSgOut, DaveSgIn?, [], 1),
    childsafe # child_agent(dave, bob, state(0, 0, [], []), DaveAgentIn?, DaveFromBob?, DaveConvs?,
          [user_output(DaveAgentToUser),
           parent_output(bob, DaveToBob)]),
    childsafe # ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    superapp # merge_notify(DaveSgNotify?, DaveMedOut?, DaveNotify),
    tee(DaveNotify?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave),

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, CarolSgOut?, SG2),
    merge(SG2?, DaveSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(carol, CarolSgIn),
                                   sg_entry(dave, DaveSgIn)]).


