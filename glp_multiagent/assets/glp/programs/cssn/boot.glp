%% =============================================================================
%% LOCAL UTILITIES
%% =============================================================================

%% merge/3 is now defined once in the root programs/self.glp (A3 amendment).

procedure tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

%% Merge two streams into an agent's network input.  merge/3 is parametric and
%% takes its element type from the streams handed to it, so merging a friend
%% channel with a group-hub stream fixes it at the narrower of the two; this
%% names the type the agent actually reads, and every stream a boot wires into it
%% --- friend, parent-child, group-hub, and the switch's own --- is a subtype.
procedure merge_in(Stream(NetInMsg)?, Stream(NetInMsg)?, Stream(NetInMsg)).
merge_in(A, B, C?) :- merge(A?, B?, C).

procedure sink(Stream(X)?).
sink([_|Xs]) :- sink(Xs?).
sink([]).

%% =============================================================================
%% SEND_TO_USER_TAGGED — Merge display streams, tag with agent ID
%% =============================================================================

procedure send_to_user_tagged(Constant?, Stream(UserCmd)?, Stream(UserNotify)?).
send_to_user_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, cmd(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, notify(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(_, [], []).
send_to_user_tagged(_, Cmds, []) :- sink(Cmds?).

%% =============================================================================
%% NETWORK SWITCH (name-routed, any number of agents)
%%
%% village_net's pairwise clauses cost one clause per ordered pair --- thirty for
%% the village's six agents, where three cost six.  This routes on the
%% destination name instead, so an agent costs one entry.  Every party has a
%% network entry now: childhood is not given, so a party has nowhere else to
%% receive the enrolment offer that makes it a child, and a released child has
%% nowhere else to place the cold call that makes it a friend.
%% =============================================================================

%% An agent's net_output carries cold calls only (NetOutMsg), whose first
%% argument IS the destination; friend traffic goes on the friend channels the
%% commit allocates and never crosses the switch.
%% =============================================================================
%% FPLAY1 — Both accept introduction (tagged output)
%% =============================================================================

exported procedure fplay1.
fplay1 :-
    actors # alice1(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetIn?, AliceConvs?,
          [user_output(AliceAgentToUser)]),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob1(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetIn?, BobConvs?,
          [user_output(BobAgentToUser)]),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # charlie1(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieCmds, CharlieDispCmd),
    superapp # split_cmds(CharlieCmds?, CharlieMedIn, CharlieSgCmds),
    superapp # superapp(charlie, CharlieSgCmds?, CharlieSgNotify, CharlieConvs, CharlieSgOut, CharlieSgIn?, [], 1),
    childsafe # agent(charlie, state(0, 0, [], []), CharlieAgentIn?, CharlieNetIn?, CharlieConvs?,
          [user_output(CharlieAgentToUser)]),
    childsafe # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    superapp # merge_notify(CharlieSgNotify?, CharlieMedOut?, CharlieNotify),
    tee(CharlieNotify?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?),

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, CharlieSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(charlie, CharlieSgIn)]).


