%% boot.glp — CSSN play orchestrator
%%
%% Wires together: network <-> agent <-> ui_mediator <-> actor
%% Types: from self.glp (ancestor scoping)
%%
%% Cross-module dependencies declared via imported procedures.


%% Exported entry points (project-compilation spec §3.4: only exported
%% root-level procedures alias). Each `exported procedure` declaration sits
%% immediately above its clause, as the parser requires.

%% =============================================================================
%% IMPORTED PROCEDURES — Cross-module dependencies
%% =============================================================================

%% From agent.glp (sibling)
imported procedure childsafe#agent(Constant?, AgentState?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Conversation)?, Stream(OutputEntry)?).

%% From child_agent.glp (sibling)
imported procedure childsafe#child_agent(Constant?, Constant?, AgentState?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Conversation)?, Stream(OutputEntry)?).

%% From ui/mediator.glp
imported procedure childsafe#ui_mediator(Constant?, Channel(Stream(AgentToUserMsg), Stream(MediatorToAgentMsg))?, Channel(Stream(AppCmd), Stream(AppNotify))?, Stream(PendingEntry)?, Constant?).

%% From superapp.glp (sibling): the stand-in for the Grassroots Super-App.
imported procedure superapp#split_cmds(Stream(UserCmd)?, Stream(AppCmd), Stream(SgCmd)).
imported procedure superapp#merge_notify(Stream(UserNotify)?, Stream(UserNotify)?, Stream(UserNotify)).
imported procedure superapp#superapp(Constant?, Stream(SgCmd)?, Stream(SgNotify), Stream(Conversation), SgOutStream, SgInStream?, Stream(SgPending)?, Integer?).
imported procedure superapp#sg_switch(SgOutStream?, Stream(SgEntry)?).

