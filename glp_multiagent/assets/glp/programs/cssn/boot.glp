                                   sg_entry(carol, CarolSgIn),
                                   sg_entry(dave, DaveSgIn),
                                   sg_entry(eve, EveSgIn)]).


%% =============================================================================
%% FPLAY12 — CSSN: Parental Consent for Groups, 5 agents (tagged output)
%% =============================================================================

exported procedure fplay12.
fplay12 :-
    actors # alice12(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetIn?, AliceConvs?,
          [user_output(AliceAgentToUser)]),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob12(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetAndChildIn?, BobConvs?,
          [user_output(BobAgentToUser),
           child_output(dave, BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # charlie12(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieCmds, CharlieDispCmd),
    superapp # split_cmds(CharlieCmds?, CharlieMedIn, CharlieSgCmds),
    superapp # superapp(charlie, CharlieSgCmds?, CharlieSgNotify, CharlieConvs, CharlieSgOut, CharlieSgIn?, [], 1),
    childsafe # agent(charlie, state(0, 0, [], []), CharlieAgentIn?, CharlieNetAndChildIn?, CharlieConvs?,
          [user_output(CharlieAgentToUser),
           child_output(eve, CharlieToEve)]),
    merge(CharlieNetIn?, CharlieFromEve?, CharlieNetAndChildIn),
    childsafe # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    superapp # merge_notify(CharlieSgNotify?, CharlieMedOut?, CharlieNotify),
    tee(CharlieNotify?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?),

    actors # dave12(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveCmds, DaveDispCmd),
    superapp # split_cmds(DaveCmds?, DaveMedIn, DaveSgCmds),
    superapp # superapp(dave, DaveSgCmds?, DaveSgNotify, DaveConvs, DaveSgOut, DaveSgIn?, [], 1),
    childsafe # child_agent(dave, bob, state(0, 0, [], []), DaveAgentIn?, DaveFromBob?, DaveConvs?,
          [user_output(DaveAgentToUser),
           parent_output(bob, DaveToBob)]),
    childsafe # ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    superapp # merge_notify(DaveSgNotify?, DaveMedOut?, DaveNotify),
    tee(DaveNotify?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    actors # eve12(ch(EveActorIn?, EveActorOut)),
    tee(EveActorOut?, EveCmds, EveDispCmd),
    superapp # split_cmds(EveCmds?, EveMedIn, EveSgCmds),
    superapp # superapp(eve, EveSgCmds?, EveSgNotify, EveConvs, EveSgOut, EveSgIn?, [], 1),
    childsafe # child_agent(eve, charlie, state(0, 0, [], []), EveAgentIn?, EveFromCharlie?, EveConvs?,
          [user_output(EveAgentToUser),
           parent_output(charlie, EveToCharlie)]),
    childsafe # ui_mediator(eve, ch(EveAgentToUser?, EveAgentIn),
                ch(EveMedIn?, EveMedOut), [], 1),
    superapp # merge_notify(EveSgNotify?, EveMedOut?, EveNotify),
    tee(EveNotify?, EveActorIn, EveDispNotify),
    send_to_user_tagged(eve, EveDispCmd?, EveDispNotify?),

    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave),
    merge(CharlieToEve?, [], EveFromCharlie),
    merge(EveToCharlie?, [], CharlieFromEve),

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, CharlieSgOut?, SG2),
    merge(SG2?, DaveSgOut?, SG3),
    merge(SG3?, EveSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(charlie, CharlieSgIn),
                                   sg_entry(dave, DaveSgIn),
                                   sg_entry(eve, EveSgIn)]).


%% =============================================================================
%% NARRATIVE DISPLAY — for village scenario actors
%% =============================================================================

procedure send_to_user_narrate(Constant?, Stream(NarrativeItem)?).
send_to_user_narrate(Id, [friend(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, friend(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(Id, [say(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, say(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(Id, [act(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, act(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(Id, [event(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, event(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(_, []).

%% =============================================================================
%% FPLAY13 — Village Scenario: 3 adults, 3 children (tagged output + narrative)
%% =============================================================================

exported procedure fplay13.
fplay13 :-

    %% Alice — boots of no age, with no parent and no child: childhood is not given.
    alice # alice13(alice, ch(AliceActorIn?, AliceActorOut), AliceNarr),
    send_to_user_narrate(alice, AliceNarr?),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetIn?, AliceConvs?,
          [user_output(AliceAgentToUser)]),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob — boots of no age, with no parent and no child: childhood is not given.
    bob # bob13(bob, ch(BobActorIn?, BobActorOut), BobNarr),
    send_to_user_narrate(bob, BobNarr?),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetIn?, BobConvs?,
          [user_output(BobAgentToUser)]),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Frank — boots of no age, with no parent and no child: childhood is not given.
    frank # frank13(frank, ch(FrankActorIn?, FrankActorOut), FrankNarr),
    send_to_user_narrate(frank, FrankNarr?),
    tee(FrankActorOut?, FrankCmds, FrankDispCmd),
    superapp # split_cmds(FrankCmds?, FrankMedIn, FrankSgCmds),
    superapp # superapp(frank, FrankSgCmds?, FrankSgNotify, FrankConvs, FrankSgOut, FrankSgIn?, [], 1),
    childsafe # agent(frank, state(0, 0, [], []), FrankAgentIn?, FrankNetIn?, FrankConvs?,
          [user_output(FrankAgentToUser)]),
    childsafe # ui_mediator(frank, ch(FrankAgentToUser?, FrankAgentIn),
                ch(FrankMedIn?, FrankMedOut), [], 1),
    superapp # merge_notify(FrankSgNotify?, FrankMedOut?, FrankNotify),
    tee(FrankNotify?, FrankActorIn, FrankDispNotify),
    send_to_user_tagged(frank, FrankDispCmd?, FrankDispNotify?),

    %% Carol — boots of no age, with no parent and no child: childhood is not given.
    carol # carol13(carol, ch(CarolActorIn?, CarolActorOut), CarolNarr),
    send_to_user_narrate(carol, CarolNarr?),
    tee(CarolActorOut?, CarolCmds, CarolDispCmd),
    superapp # split_cmds(CarolCmds?, CarolMedIn, CarolSgCmds),
    superapp # superapp(carol, CarolSgCmds?, CarolSgNotify, CarolConvs, CarolSgOut, CarolSgIn?, [], 1),
    childsafe # agent(carol, state(0, 0, [], []), CarolAgentIn?, CarolNetIn?, CarolConvs?,
          [user_output(CarolAgentToUser)]),
    childsafe # ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    superapp # merge_notify(CarolSgNotify?, CarolMedOut?, CarolNotify),
    tee(CarolNotify?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    %% Dave — boots of no age, with no parent and no child: childhood is not given.
    dave # dave13(dave, ch(DaveActorIn?, DaveActorOut), DaveNarr),
    send_to_user_narrate(dave, DaveNarr?),
    tee(DaveActorOut?, DaveCmds, DaveDispCmd),
    superapp # split_cmds(DaveCmds?, DaveMedIn, DaveSgCmds),
    superapp # superapp(dave, DaveSgCmds?, DaveSgNotify, DaveConvs, DaveSgOut, DaveSgIn?, [], 1),
    childsafe # agent(dave, state(0, 0, [], []), DaveAgentIn?, DaveNetIn?, DaveConvs?,
          [user_output(DaveAgentToUser)]),
    childsafe # ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    superapp # merge_notify(DaveSgNotify?, DaveMedOut?, DaveNotify),
    tee(DaveNotify?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    %% Eve — boots of no age, with no parent and no child: childhood is not given.
    eve # eve13(eve, ch(EveActorIn?, EveActorOut), EveNarr),
    send_to_user_narrate(eve, EveNarr?),
    tee(EveActorOut?, EveCmds, EveDispCmd),
    superapp # split_cmds(EveCmds?, EveMedIn, EveSgCmds),
    superapp # superapp(eve, EveSgCmds?, EveSgNotify, EveConvs, EveSgOut, EveSgIn?, [], 1),
    childsafe # agent(eve, state(0, 0, [], []), EveAgentIn?, EveNetIn?, EveConvs?,
          [user_output(EveAgentToUser)]),
    childsafe # ui_mediator(eve, ch(EveAgentToUser?, EveAgentIn),
                ch(EveMedIn?, EveMedOut), [], 1),
    superapp # merge_notify(EveSgNotify?, EveMedOut?, EveNotify),
    tee(EveNotify?, EveActorIn, EveDispNotify),
    send_to_user_tagged(eve, EveDispCmd?, EveDispNotify?),

    %% One switch for all six.  No parent-child channel is wired here: enrol
    %% creates each one and release tears it down.,

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, FrankSgOut?, SG2),
    merge(SG2?, CarolSgOut?, SG3),
    merge(SG3?, DaveSgOut?, SG4),
    merge(SG4?, EveSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(frank, FrankSgIn),
                                   sg_entry(carol, CarolSgIn),
                                   sg_entry(dave, DaveSgIn),
                                   sg_entry(eve, EveSgIn)]).


%% =============================================================================
%% FPLAY14 — Idempotent befriend commit: redundant child_introduce
%% Same wiring as fplay4 (alice, bob, carol, dave) but with the alice14/bob14/
%% carol14/dave14 actors which exercise a duplicate child_introduce.
%% Each child accepts both introductions; the second commit is suppressed by
%% the idempotency rule, so only one `connected(dave)` / `connected(carol)` is
%% emitted per child.
%% =============================================================================

exported procedure fplay14.
fplay14 :-
    actors # alice14(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetAndChildIn?, AliceConvs?,
          [user_output(AliceAgentToUser),
           child_output(carol, AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob14(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetAndChildIn?, BobConvs?,
          [user_output(BobAgentToUser),
           child_output(dave, BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # carol14(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolCmds, CarolDispCmd),
    superapp # split_cmds(CarolCmds?, CarolMedIn, CarolSgCmds),
    superapp # superapp(carol, CarolSgCmds?, CarolSgNotify, CarolConvs, CarolSgOut, CarolSgIn?, [], 1),
    childsafe # child_agent(carol, alice, state(0, 0, [], []), CarolAgentIn?, CarolFromAlice?, CarolConvs?,
          [user_output(CarolAgentToUser),
           parent_output(alice, CarolToAlice)]),
    childsafe # ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    superapp # merge_notify(CarolSgNotify?, CarolMedOut?, CarolNotify),
    tee(CarolNotify?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    actors # dave14(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveCmds, DaveDispCmd),
    superapp # split_cmds(DaveCmds?, DaveMedIn, DaveSgCmds),
    superapp # superapp(dave, DaveSgCmds?, DaveSgNotify, DaveConvs, DaveSgOut, DaveSgIn?, [], 1),
    childsafe # child_agent(dave, bob, state(0, 0, [], []), DaveAgentIn?, DaveFromBob?, DaveConvs?,
          [user_output(DaveAgentToUser),
           parent_output(bob, DaveToBob)]),
    childsafe # ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    superapp # merge_notify(DaveSgNotify?, DaveMedOut?, DaveNotify),
    tee(DaveNotify?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave),

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, CarolSgOut?, SG2),
    merge(SG2?, DaveSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(carol, CarolSgIn),
                                   sg_entry(dave, DaveSgIn)]).


%% =============================================================================
%% FPLAY15 — Idempotent befriend commit: simultaneous bilateral cold-call
%% =============================================================================

exported procedure fplay15.
fplay15 :-
    actors # alice15(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetIn?, AliceConvs?,
          [user_output(AliceAgentToUser)]),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob15(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetIn?, BobConvs?,
          [user_output(BobAgentToUser)]),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn)]).


%% =============================================================================
%% FPLAY16 — the two acts, measured without the mediator
%%
%% Alice offers to become Bob's parent; Bob accepts and so becomes a child; Bob
%% asks Alice to end the parenting and she does; Bob, holding no parent and so an
%% adult again, befriends Alice directly, with no parent among the guards.  That
%% last step is village act 7 in miniature.
%%
%% The two drivers stand in for the mediator, which is vGLP's and does not yet
%% route these acts, and for the super-app: they read the agent's own
%% user_output and answer on its UserIn, so the acts can be measured at the
%% agent level meanwhile.
%%
%% Act 7 is measured here as the mini-app makes it visible.  A conversation with
%% Charlie is put to Bob only once the parenting has ended: a child refuses one,
%% because a child's friendships are its parents' to approve, and an adult
%% adopts it --- and holding no parent is the whole of being an adult.
%% =============================================================================

procedure drive_parent(Constant?, Constant?, Stream(AgentToUserMsg)?, Stream(UserInMsg), Stream(NarrativeItem)).

%% Open: offer to become Bob's parent, once the conversation the super-app
%% opened between them has been adopted --- the offer travels it, this platform
%% holding no network entry.  Nothing else precedes it: Alice starts an adult,
%% and starting one is not an act.
drive_parent(Id, Kid, [msg(agent, person, connected(Who))|In],
             [msg(person, Id?, enrol_child(Kid?))|Out?],
             [friend(Who?), act('Becoming the parent of Bob')|Narr?]) :-
    ground(Id?), ground(Kid?), ground(Who?) |
    drive_parent_wait(Id?, Kid?, In?, Out, Narr).
drive_parent(Id, Kid, [_|In], Out?, Narr?) :-
    otherwise |
    drive_parent(Id?, Kid?, In?, Out, Narr).
drive_parent(_, _, [], [], []).

procedure drive_parent_wait(Constant?, Constant?, Stream(AgentToUserMsg)?, Stream(UserInMsg), Stream(NarrativeItem)).

drive_parent_wait(Id, Kid, [msg(agent, person, enrolled(Who))|In], Out?,
                  [event('Bob is my child')|Narr?]) :-
    ground(Who?) |
    drive_parent_wait(Id?, Kid?, In?, Out, Narr).

%% Ending the parenting is owed, and answering is the parent's act.
drive_parent_wait(Id, Kid, [msg(agent, person, release_asked(Child))|In],
                  [msg(person, Id?, approve_release(Child?))|Out?],
                  [act('Ending the parenting of Bob')|Narr?]) :-
    ground(Child?) |
    drive_parent_wait(Id?, Kid?, In?, Out, Narr).

drive_parent_wait(Id, Kid, [msg(agent, person, released(Who))|In], Out?,
                  [event('Bob is no longer my child')|Narr?]) :-
    ground(Who?) |
    drive_parent_wait(Id?, Kid?, In?, Out, Narr).

drive_parent_wait(Id, Kid, [msg(agent, person, connected(Who))|In], Out?,
                  [friend(Who?)|Narr?]) :-
    ground(Who?) |
    drive_parent_wait(Id?, Kid?, In?, Out, Narr).

drive_parent_wait(Id, Kid, [_|In], Out?, Narr?) :-
    otherwise |
    drive_parent_wait(Id?, Kid?, In?, Out, Narr).
drive_parent_wait(_, _, [], [], []).

procedure drive_child(Constant?, Constant?, Stream(AgentToUserMsg)?, Stream(UserInMsg), Conversation?, Stream(Conversation), Stream(NarrativeItem)).

drive_child(Id, Parent, [msg(agent, person, enrol_offer(P, Resp?))|In],
            [msg(person, Id?, enrol_decision(yes, P?, enrol_response(Resp)))|Out?],
            Conv, Convs?, [act('Accepting Alice as my parent')|Narr?]) :-
    ground(P?) |
    drive_child(Id?, Parent?, In?, Out, Conv?, Convs, Narr).

drive_child(Id, Parent, [msg(agent, person, enrolled(Who))|In],
            [msg(person, Id?, request_release)|Out?],
            Conv, Convs?, [event('Alice is my parent'),
             act('Asking Alice to end the parenting')|Narr?]) :-
    ground(Who?) |
    drive_child(Id?, Parent?, In?, Out, Conv?, Convs, Narr).

%% The parenting is over, so rho is empty and I am an adult.  The conversation
%% with Charlie, which a child refuses, is put to the agent now.
drive_child(Id, Parent, [msg(agent, person, released(Who))|In], Out?,
            Conv, [Conv?|Convs?],
            [event('No parent on record, so an adult'),
             act('Taking up a conversation, which a child refuses')|Narr?]) :-
    ground(Who?) |
    drive_child_done(Id?, Parent?, In?, Out, Convs, Narr).

drive_child(Id, Parent, [msg(agent, person, connected(Who))|In], Out?,
            Conv, Convs?, [friend(Who?)|Narr?]) :-
    ground(Who?) |
    drive_child(Id?, Parent?, In?, Out, Conv?, Convs, Narr).

drive_child(Id, Parent, [_|In], Out?, Conv, Convs?, Narr?) :-
    otherwise |
    drive_child(Id?, Parent?, In?, Out, Conv?, Convs, Narr).
drive_child(_, _, [], [], _, [], []).

%% After the release: the friendship the adopted conversation is, and nothing
%% further to offer.
procedure drive_child_done(Constant?, Constant?, Stream(AgentToUserMsg)?, Stream(UserInMsg), Stream(Conversation), Stream(NarrativeItem)).
drive_child_done(Id, Parent, [msg(agent, person, connected(Who))|In], Out?, Convs?,
                 [friend(Who?)|Narr?]) :-
    ground(Who?) |
    drive_child_done(Id?, Parent?, In?, Out, Convs, Narr).
drive_child_done(Id, Parent, [_|In], Out?, Convs?, Narr?) :-
    otherwise |
    drive_child_done(Id?, Parent?, In?, Out, Convs, Narr).
drive_child_done(_, _, [], [], [], []).

%% A person who wills nothing: Charlie is here to be befriended.
procedure idle_person(Stream(AgentToUserMsg)?, Stream(UserInMsg)).
idle_person([_|In], Out?) :- idle_person(In?, Out).
idle_person([], []).

exported procedure fplay16.
fplay16 :-
    %% The super-app has befriended Alice and Bob and opened the conversation
    %% between their two executions: on this platform that IS the friendship,
    %% and it is what the enrolment then travels.
    childsafe # agent(alice, state(0, 0, [], []), AliceIn?, AliceNetIn?,
          [conversation(bob, ch(AB?, BA))],
          [user_output(AliceToUser)]),
    drive_parent(alice, bob, AliceToUser?, AliceIn, AliceNarr),
    send_to_user_narrate(alice, AliceNarr?),

    childsafe # agent(bob, state(0, 0, [], []), BobIn?, BobNetIn?,
          [conversation(alice, ch(BA?, AB))|BobRest?],
          [user_output(BobToUser)]),
    drive_child(bob, alice, BobToUser?, BobIn,
                conversation(charlie, ch(BC?, CB)), BobRest, BobNarr),
    send_to_user_narrate(bob, BobNarr?),

    childsafe # agent(charlie, state(0, 0, [], []), CharlieIn?, CharlieNetIn?,
          [conversation(bob, ch(CB?, BC))],
          [user_output(CharlieToUser)]),
    idle_person(CharlieToUser?, CharlieIn).

%% =============================================================================
%% FPLAY17 — a member that joins after a post was made
%%
%% Three adults on the name-routed switch.  Alice creates a group, Bob joins,
%% Alice posts, and Carol joins only after Alice has seen her own post come
%% round.  Whether Carol receives that post is the whole of the measurement.
%% =============================================================================

exported procedure fplay17.
fplay17 :-
    actors # alice17(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetIn?, AliceConvs?,
          [user_output(AliceAgentToUser)]),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob17(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetIn?, BobConvs?,
          [user_output(BobAgentToUser)]),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # carol17(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolCmds, CarolDispCmd),
    superapp # split_cmds(CarolCmds?, CarolMedIn, CarolSgCmds),
    superapp # superapp(carol, CarolSgCmds?, CarolSgNotify, CarolConvs, CarolSgOut, CarolSgIn?, [], 1),
    childsafe # agent(carol, state(0, 0, [], []), CarolAgentIn?, CarolNetIn?, CarolConvs?,
          [user_output(CarolAgentToUser)]),
    childsafe # ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    superapp # merge_notify(CarolSgNotify?, CarolMedOut?, CarolNotify),
    tee(CarolNotify?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    actors # dave17(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveCmds, DaveDispCmd),
    superapp # split_cmds(DaveCmds?, DaveMedIn, DaveSgCmds),
    superapp # superapp(dave, DaveSgCmds?, DaveSgNotify, DaveConvs, DaveSgOut, DaveSgIn?, [], 1),
    childsafe # agent(dave, state(0, 0, [], []), DaveAgentIn?, DaveNetIn?, DaveConvs?,
          [user_output(DaveAgentToUser)]),
    childsafe # ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    superapp # merge_notify(DaveSgNotify?, DaveMedOut?, DaveNotify),
    tee(DaveNotify?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, CarolSgOut?, SG2),
    merge(SG2?, DaveSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(carol, CarolSgIn),
                                   sg_entry(dave, DaveSgIn)]).


%% =============================================================================
%% FPLAY18 — a child that is a parent
%%
%% Three agents, all starting adults.  Alice becomes Bob's parent; Bob, now a
%% child, becomes Carol's; Carol asks Bob to end it and Bob does.  Nothing tests
%% whether a party is an adult before it becomes a parent, and nothing may.
%% =============================================================================

exported procedure fplay18.
fplay18 :-
    actors # alice18(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceNetIn?, AliceConvs?,
          [user_output(AliceAgentToUser)]),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob18(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobNetIn?, BobConvs?,
          [user_output(BobAgentToUser)]),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # carol18(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolCmds, CarolDispCmd),
    superapp # split_cmds(CarolCmds?, CarolMedIn, CarolSgCmds),
    superapp # superapp(carol, CarolSgCmds?, CarolSgNotify, CarolConvs, CarolSgOut, CarolSgIn?, [], 1),
    childsafe # agent(carol, state(0, 0, [], []), CarolAgentIn?, CarolNetIn?, CarolConvs?,
          [user_output(CarolAgentToUser)]),
    childsafe # ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    superapp # merge_notify(CarolSgNotify?, CarolMedOut?, CarolNotify),
    tee(CarolNotify?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, CarolSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(carol, CarolSgIn)]).


%% =============================================================================
%% FPLAY19 — the four-role ending of a child's membership, at two of its roles
%%
%% Carol is a child of Alice and the creator of kids_chat; Dave, a child of Bob,
%% and Eve, a child of Charlie, are on its member list.  The parent-child
%% channels and the member streams are wired here rather than built by the acts
%% that create them, which fplay11 covers: what this play measures is the
%% ending.  Carol removes Dave, which is the creator's role of child_leave_2,
%% and Alice removes Eve, which is the role of the creator's parent --- the
%% fourth, and the one that had no route until now.  Alice holds no member list
%% and no record of whom Carol listed, so all she can do is tell Carol; the two
%% roles reach the same commit and differ only in who willed them.
%% =============================================================================

exported procedure fplay19.
fplay19 :-

    %% Alice — Carol's parent.  She reads Carol's parent-channel traffic, which
    %% is where the withdrawal each removal owes her arrives.
    actors # alice19(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceCmds, AliceDispCmd),
    superapp # split_cmds(AliceCmds?, AliceMedIn, AliceSgCmds),
    superapp # superapp(alice, AliceSgCmds?, AliceSgNotify, AliceConvs, AliceSgOut, AliceSgIn?, [], 1),
    merge_in(AliceNetIn?, CarolToAlice?, AliceAllIn),
    childsafe # agent(alice, state(0, 0, [], []), AliceAgentIn?, AliceAllIn?, AliceConvs?,
          [user_output(AliceAgentToUser),
           child_output(carol, AliceToCarol)]),
    childsafe # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    superapp # merge_notify(AliceSgNotify?, AliceMedOut?, AliceNotify),
    tee(AliceNotify?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob — Dave's parent.
    actors # bob19(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobCmds, BobDispCmd),
    superapp # split_cmds(BobCmds?, BobMedIn, BobSgCmds),
    superapp # superapp(bob, BobSgCmds?, BobSgNotify, BobConvs, BobSgOut, BobSgIn?, [], 1),
    merge_in(BobNetIn?, DaveToBob?, BobAllIn),
    childsafe # agent(bob, state(0, 0, [], []), BobAgentIn?, BobAllIn?, BobConvs?,
          [user_output(BobAgentToUser),
           child_output(dave, BobToDave)]),
    childsafe # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    superapp # merge_notify(BobSgNotify?, BobMedOut?, BobNotify),
    tee(BobNotify?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie — Eve's parent.
    actors # charlie19(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieCmds, CharlieDispCmd),
    superapp # split_cmds(CharlieCmds?, CharlieMedIn, CharlieSgCmds),
    superapp # superapp(charlie, CharlieSgCmds?, CharlieSgNotify, CharlieConvs, CharlieSgOut, CharlieSgIn?, [], 1),
    merge_in(CharlieNetIn?, EveToCharlie?, CharlieAllIn),
    childsafe # agent(charlie, state(0, 0, [], []), CharlieAgentIn?, CharlieAllIn?, CharlieConvs?,
          [user_output(CharlieAgentToUser),
           child_output(eve, CharlieToEve)]),
    childsafe # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    superapp # merge_notify(CharlieSgNotify?, CharlieMedOut?, CharlieNotify),
    tee(CharlieNotify?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?),

    %% Carol — a child, and the creator of the group.  Her outputs carry the
    %% member list: one entry per member, which is what a removal closes.
    actors # carol19(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolCmds, CarolDispCmd),
    superapp # split_cmds(CarolCmds?, CarolMedIn, CarolSgCmds),
    superapp # superapp(carol, CarolSgCmds?, CarolSgNotify, CarolConvs, CarolSgOut, CarolSgIn?, [], 1),
    merge_in(CarolNetIn?, AliceToCarol?, CarolIn1),
    merge_in(CarolIn1?, DaveToHub?, CarolIn2),
    merge_in(CarolIn2?, EveToHub?, CarolAllIn),
    childsafe # child_agent(carol, alice, state(0, 0, [], []), CarolAgentIn?, CarolAllIn?, CarolConvs?,
          [user_output(CarolAgentToUser),
           parent_output(alice, CarolToAlice),
           group_entry(group_member(group_id(carol, kids_chat), dave), CarolToDave),
           group_entry(group_member(group_id(carol, kids_chat), eve), CarolToEve)]),
    childsafe # ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    superapp # merge_notify(CarolSgNotify?, CarolMedOut?, CarolNotify),
    tee(CarolNotify?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    %% Dave — a member, removed by the creator.
    actors # dave19(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveCmds, DaveDispCmd),
    superapp # split_cmds(DaveCmds?, DaveMedIn, DaveSgCmds),
    superapp # superapp(dave, DaveSgCmds?, DaveSgNotify, DaveConvs, DaveSgOut, DaveSgIn?, [], 1),
    merge_in(DaveNetIn?, BobToDave?, DaveIn1),
    merge_in(DaveIn1?, CarolToDave?, DaveAllIn),
    childsafe # child_agent(dave, bob, state(0, 0, [], []), DaveAgentIn?, DaveAllIn?, DaveConvs?,
          [user_output(DaveAgentToUser),
           parent_output(bob, DaveToBob),
           group_entry(group(group_id(carol, kids_chat)), DaveToHub)]),
    childsafe # ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    superapp # merge_notify(DaveSgNotify?, DaveMedOut?, DaveNotify),
    tee(DaveNotify?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    %% Eve — a member, removed by the creator's parent.
    actors # eve19(ch(EveActorIn?, EveActorOut)),
    tee(EveActorOut?, EveCmds, EveDispCmd),
    superapp # split_cmds(EveCmds?, EveMedIn, EveSgCmds),
    superapp # superapp(eve, EveSgCmds?, EveSgNotify, EveConvs, EveSgOut, EveSgIn?, [], 1),
    merge_in(EveNetIn?, CharlieToEve?, EveIn1),
    merge_in(EveIn1?, CarolToEve?, EveAllIn),
    childsafe # child_agent(eve, charlie, state(0, 0, [], []), EveAgentIn?, EveAllIn?, EveConvs?,
          [user_output(EveAgentToUser),
           parent_output(charlie, EveToCharlie),
           group_entry(group(group_id(carol, kids_chat)), EveToHub)]),
    childsafe # ui_mediator(eve, ch(EveAgentToUser?, EveAgentIn),
                ch(EveMedIn?, EveMedOut), [], 1),
    superapp # merge_notify(EveSgNotify?, EveMedOut?, EveNotify),
    tee(EveNotify?, EveActorIn, EveDispNotify),
    send_to_user_tagged(eve, EveDispCmd?, EveDispNotify?),

    %% One switch for all six.  Nothing travels it in this play — every party is
    %% already in relation with the parties it acts on — but a party with no
    %% network entry could not be cold-called at all.,

    %% The super-apps' own network, one entry per party: the invitation and
    %% its answer travel it, and the platform travels none.
    merge(AliceSgOut?, BobSgOut?, SG1),
    merge(SG1?, CharlieSgOut?, SG2),
    merge(SG2?, CarolSgOut?, SG3),
    merge(SG3?, DaveSgOut?, SG4),
    merge(SG4?, EveSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, AliceSgIn),
                                   sg_entry(bob, BobSgIn),
                                   sg_entry(charlie, CharlieSgIn),
                                   sg_entry(carol, CarolSgIn),
                                   sg_entry(dave, DaveSgIn),
                                   sg_entry(eve, EveSgIn)]).
