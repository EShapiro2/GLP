%% agent.glp — CSSN social agent module (v2)
%%
%% Exports: agent/4
%% Types and helpers (merge, setup_group_*): from self.glp (ancestor scoping)
%% bind_response, handle_response, await_group_channel: local (call agent recursively)
%%
%% v2 changes:
%%   - Helpers moved to self.glp (except merge-dependent ones)
%%   - Added parent consent clauses: group_consent_req, approve/reject_child_group


%% =============================================================================
%% AWAIT_GROUP_CHANNEL — local (calls merge and agent)
%% =============================================================================

procedure await_group_channel(Constant?, GroupId?, Stream(GroupSetupResponse)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?).
await_group_channel(Id, GroupId, [group_channel(ch(FromHub, ToHub?))|_],
        UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?) |
    add_group_output(group(GroupId?), ToHub, Outs?, Outs1),
    merge(NetIn?, FromHub?, NetIn1),
    send_user( msg(agent, person, group_joined(GroupId?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?).
await_group_channel(_, _, [], _, _, _) :- true.

%% =============================================================================
%% RESPONSE HANDLING — local (calls merge)
%% =============================================================================

procedure bind_response(Constant?, Decision?, Constant?, Response, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
bind_response(Id, yes, From, accept(RetCh?), Outs, Outs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(Id?, accept(LocalCh?), From?, Outs?, Outs1, In?, In1).
bind_response(_, no, _, no, Outs, Outs1?, In, In?) :-
    send_user( msg(agent, person, rejected), Outs?, Outs1).

procedure handle_response(Constant?, Response?, Constant?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
handle_response(Id, accept(Ch), From, Outs, Outs1?, In, In1?) :-
    ground(From?) |
    befriend_commit(Id?, From?, Ch?, Outs?, Outs1, In?, In1).
handle_response(_, no, From, Outs, Outs1?, In, In?) :-
    ground(From?) |
    send_user( msg(agent, person, rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% AGENT/4
%% =============================================================================

exported procedure agent(Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?).

%% --- User messages ---

%% User initiates cold call
agent(Id, [msg(person, Id1, connect(Target))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    send_net( msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User decision on cold-call
agent(Id, [msg(person, Id1, decision(Dec, From, response(Resp?)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    bind_response(Id?, Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% User sends text message to friend
agent(Id, [msg(person, Id1, send(Target, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    send_friend(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% User introduces friend P to friend Q
agent(Id, [msg(person, Id1, introduce(P, Q))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    send_friend(P?, msg(Id?, P?, intro(Q?, QPCh?)), Outs?, Outs1),
    send_friend(Q?, msg(Id?, Q?, intro(P?, PQCh?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% User accepts intro — send ack, spawn peer-wait, inject result
agent(Id, [msg(person, Id1, accept_intro(Other, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).

%% User rejects intro — send nack on channel, close it
agent(Id, [msg(person, Id1, reject_intro(_, channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Intro result: peer acked — idempotent befriend commit with smaller-name tie-break.
agent(Id, [intro_result(Other, Ch)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Other?) |
    befriend_commit(Id?, Other?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% Intro result: peer nacked — notify rejected
agent(Id, [intro_rejected(Other)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user( msg(agent, person, rejected(Other?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Response to cold-call (injected by inject_msg)
agent(Id, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    handle_response(Id?, Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% --- CSSG: Child-safe social graph ---

%% Sibling case: parent introduces own children to each other (Friend =?= Id)
agent(Id, [msg(person, Id1, child_introduce(Child1, Friend, Child2))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, Friend? =?= Id?,
    ground(Child1?), ground(Child2?),
    new_channel(C1Ch, C2Ch) |
    send_child(Child1?, msg(Id?, Child1?, child_intro(Child2?, C1Ch?)), Outs?, Outs1),
    send_child(Child2?, msg(Id?, Child2?, child_intro(Child1?, C2Ch?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% Non-sibling case: parent introduces own child to friend's child (otherwise)
agent(Id, [msg(person, Id1, child_introduce(MyChild, Friend, FriendChild))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(MyChild?), ground(Friend?), ground(FriendChild?),
    otherwise,
    new_channel(C1Ch, C2Ch) |
    send_child(MyChild?, msg(Id?, MyChild?, child_intro(FriendChild?, C1Ch?)), Outs?, Outs1),
    send_friend(Friend?, msg(Id?, Friend?, child_intro(MyChild?, C2Ch?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% Child (or parent) accepts child_intro — send ack, spawn peer-wait, inject result
agent(Id, [msg(person, Id1, accept_child_intro(Other, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).

%% Child (or parent) rejects child_intro — send nack on channel, close it
agent(Id, [msg(person, Id1, reject_child_intro(_, channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Parent approves child_intro — forward to own child
agent(Id, [msg(person, Id1, approve_child_intro(OtherChild, MyChild, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(OtherChild?), ground(MyChild?) |
    send_child(MyChild?, msg(Id?, MyChild?, child_intro(OtherChild?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- CSSN: Child-safe social networking (groups) ---

%% User creates a group — creator sets up member-side write (no hub self-loop)
agent(Id, [msg(person, Id1, create_group(Name))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Name?) |
    setup_group_creator(group_id(Id?, Name?),
        Outs?, Outs1, NetIn?, NetIn1),
    send_user( msg(agent, person, group_joined(group_id(Id?, Name?))),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?).

%% User invites member to group
agent(Id, [msg(person, Id1, invite_group(GroupId, Invitee))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Invitee?),
    new_channel(InviteeCh, CreatorCh) |
    send_friend(Invitee?,
        msg(Id?, Invitee?, group_invite(GroupId?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Invitee?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User invites child to group via parent
agent(Id, [msg(person, Id1, invite_group(GroupId, Child, Parent))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?), ground(Parent?),
    new_channel(InviteeCh, CreatorCh) |
    send_friend(Parent?,
        msg(Id?, Parent?, group_invite_child(GroupId?, Child?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Child?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User accepts group invite
agent(Id, [msg(person, Id1, accept_group(GroupId,
        group_channel(ch(ChRead, [ack(Id?)|[]]))))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    await_group_channel(Id?, GroupId?, ChRead?, UserIn?, NetIn?, Outs?).

%% User rejects group invite — send nack, close channel
agent(Id, [msg(person, Id1, reject_group(_, group_channel(ch(_, [nack|[]]))))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Injected group_join_ack — creator wires hub-side, sends member-end channel
agent(Id, [group_join_ack(GroupId, Invitee, ch(_, [group_channel(MemberEnd?)|[]]))|UserIn],
        NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    setup_group_hub_side(GroupId?, Invitee?, Outs?, Outs1, NetIn?, NetIn1, MemberEnd),
    send_user( msg(agent, person, group_joined_member(GroupId?, Invitee?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?).

%% Injected group_join_nack — nothing to clean up
agent(Id, [group_join_nack(_, _)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% User sends group message — send on member-to-hub channel
agent(Id, [msg(person, Id1, send_group(GroupId, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Text?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_msg(GroupId?, Id?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Parent approves group invite for child — forward group_invite to child channel
agent(Id, [msg(person, Id1, approve_group(Child, GroupId, group_channel(Ch)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    send_child(Child?, msg(Id?, Child?, group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- Leave group (v3) ---

%% Member leaves group (own choice)
agent(Id, [msg(person, Id1, leave_group(GroupId))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_leave(GroupId?, Id?)), Outs?, Outs1),
    close_output(group(GroupId?), Outs1?, Outs2),
    send_user( msg(agent, person, group_left(GroupId?)), Outs2?, Outs3),
    agent(Id?, UserIn?, NetIn?, Outs3?).

%% Parent tells child to leave group
agent(Id, [msg(person, Id1, leave_child_group(Child, GroupId))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Child?), ground(GroupId?) |
    send_child(Child?, msg(Id?, Child?, leave_group(GroupId?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Creator removes member from group
agent(Id, [msg(person, Id1, remove_from_group(GroupId, Member))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Member?) |
    lookup_send_group(group_member(GroupId?, Member?),
        msg(Id?, Member?, group_removed(GroupId?)), Outs?, Outs1),
    close_output(group_member(GroupId?, Member?), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% --- Parent consent for child-managed groups (v2) ---

%% Parent approves child group consent — binds Decision to yes
agent(Id, [msg(person, Id1, approve_child_group(_, _, consent(yes)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Parent rejects child group consent — binds Decision to no
agent(Id, [msg(person, Id1, reject_child_group(_, _, consent(no)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Unfriend (v3) ---

%% Parent initiates unfriend on behalf of child
agent(Id, [msg(person, Id1, unfriend_child_of(MyChild, Target))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(MyChild?), ground(Target?) |
    send_child(MyChild?, msg(Id?, MyChild?, unfriend_child(Target?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- Network messages ---

%% Cold-call from network
agent(Id, UserIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs) :-
    Id? =?= Id1? |
    send_user( msg(agent, person, befriend(From?, Resp)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Response to cold-call from network
agent(Id, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs) :-
    Id? =?= Id1? |
    handle_response(Id?, Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% Text from friend
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs) :-
    Id? =?= Id1? |
    send_user( msg(agent, person, received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Introduction from friend — pass channel to user via mediator
agent(Id, UserIn, [msg(From, Id1, intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Other?) |
    send_user( msg(agent, person, befriend_intro(From?, Other?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- CSSG network messages ---

%% Child receives child_intro from parent (or parent forwards from friend)
agent(Id, UserIn, [msg(From, Id1, child_intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Other?) |
    send_user( msg(agent, person, child_befriend(From?, Other?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- CSSN network messages ---

%% Group invite from friend — forward to user via mediator
agent(Id, UserIn, [msg(_, Id1, group_invite(GroupId, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    send_user( msg(agent, person, group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Group invite for child from friend — forward to parent user via mediator
agent(Id, UserIn, [msg(_, Id1, group_invite_child(GroupId, Child, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    send_user( msg(agent, person, group_invite_child(GroupId?, Child?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Consent request from child — forward to parent user via mediator (v2)
agent(Id, UserIn, [msg(Child, Id1, group_consent_req(GroupId, Consent?))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Child?), ground(GroupId?) |
    send_user( msg(agent, person,
        child_group_consent(Child?, GroupId?, Consent)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Group message from group channel — distribute to all members and notify user
agent(Id, UserIn, [msg(_, _, group_msg(GroupId, Author, Text))|NetIn], Outs) :-
    ground(Id?), ground(GroupId?), ground(Author?), ground(Text?) |
    distribute_group_msg(GroupId?,
        msg(Author?, Author?, group_msg(GroupId?, Author?, Text?)), Outs?, Outs1),
    send_user( msg(agent, person, group_received(GroupId?, Author?, Text?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% Creator receives leave notification from member
agent(Id, UserIn, [msg(Member, _, group_leave(GroupId, Member1))|NetIn], Outs) :-
    ground(Id?), ground(GroupId?), ground(Member?), Member? =?= Member1? |
    close_output(group_member(GroupId?, Member?), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Member receives removal notification from creator
agent(Id, UserIn, [msg(_, Id1, group_removed(GroupId))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    close_output(group(GroupId?), Outs?, Outs1),
    send_user( msg(agent, person, group_removed(GroupId?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% Receive unfriend from friend — close friend channel, notify UI
agent(Id, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs) :-
    Id? =?= Id1?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    send_user( msg(agent, person, unfriended(From?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% --- Termination ---

agent(_, [], _, Outs) :- close_outputs(Outs?).
agent(_, _, [], Outs) :- close_outputs(Outs?).
