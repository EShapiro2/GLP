%% =============================================================================
%% PLAY 8 — CSSN: Group join (Alice creates group, invites Bob, Bob accepts)
%% =============================================================================

exported procedure alice8(Channel(Stream(UserNotify), Stream(UserCmd))?).
alice8(ch(In, [connect(bob)|Out?])) :-
    alice8_wait_connected(In?, Out).

procedure alice8_wait_connected(Stream(UserNotify)?, Stream(UserCmd)).
alice8_wait_connected([connected(bob)|In],
                      [create_group(book_club)|Out?]) :-
    alice8_wait_group_joined(In?, Out).
alice8_wait_connected([_|In], Out?) :-
    otherwise | alice8_wait_connected(In?, Out).
alice8_wait_connected([], []).

procedure alice8_wait_group_joined(Stream(UserNotify)?, Stream(UserCmd)).
alice8_wait_group_joined(
        [group_joined(group_id(alice, book_club))|In],
        [invite_group(group_id(alice, book_club), bob)|Out?]) :-
    alice8_wait_member_joined(In?, Out).
alice8_wait_group_joined([_|In], Out?) :-
    otherwise | alice8_wait_group_joined(In?, Out).
alice8_wait_group_joined([], []).

procedure alice8_wait_member_joined(Stream(UserNotify)?, Stream(UserCmd)).
alice8_wait_member_joined(
        [group_joined_member(group_id(alice, book_club), bob)|In],
        Out?) :-
    alice8_wait_bob_msg(In?, Out).
alice8_wait_member_joined([_|In], Out?) :-
    otherwise | alice8_wait_member_joined(In?, Out).
alice8_wait_member_joined([], []).

procedure alice8_wait_bob_msg(Stream(UserNotify)?, Stream(UserCmd)).
alice8_wait_bob_msg(
        [group_received(group_id(alice, book_club), bob, 'Hello everyone')|_],
        [send_group(group_id(alice, book_club), 'Hi Bob')]).
alice8_wait_bob_msg([_|In], Out?) :-
    otherwise | alice8_wait_bob_msg(In?, Out).
alice8_wait_bob_msg([], []).

exported procedure bob8(Channel(Stream(UserNotify), Stream(UserCmd))?).
bob8(ch([befriend(alice, ReqId)|In],
        [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob8_wait_connected(In?, Out).
bob8(ch([_|In], Out?)) :-
    otherwise | bob8(ch(In?, Out)).
bob8(ch([], [])).

procedure bob8_wait_connected(Stream(UserNotify)?, Stream(UserCmd)).
bob8_wait_connected([connected(alice)|In], Out?) :-
    bob8_wait_group_invite(In?, Out).
bob8_wait_connected([_|In], Out?) :-
    otherwise | bob8_wait_connected(In?, Out).
bob8_wait_connected([], []).

procedure bob8_wait_group_invite(Stream(UserNotify)?, Stream(UserCmd)).
