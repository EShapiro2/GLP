
%% Cross-lib dependency: the output routers (exposed at the root for platforms,
%% but a sibling lib module is reached by explicit import + qualified call).
imported procedure output#send_user(M?, Stream(Ent)?, Stream(Ent)).
imported procedure output#add_friend_output(Constant?, Stream(M), Stream(Ent)?, Stream(Ent)).

%% Idempotent befriend commit with smaller-name tie-break and fresh-friend-channel
%% conveyance (CSSN Issue 16), lifted from social/network and generalised so all
%% platforms share one copy.  Parameters, inferred at each call:
%%   C   — the SETUP-channel content (the platform's IntroContent).  Its
%%         friend_channel(Channel(Stream(FM), Stream(FM))) alternative carries the
%%         fresh friend channel; per-instantiation checking rejects a C lacking it.
%%   Ent — the output-entry union (must have friend_output and the agent message
%%         used by connected/1).
%%   NIM — the network-input alphabet.  merge requires FM ⊆ NIM, so the fresh
%%         friend channel (Stream(FM)) is mergeable into NetIn (Stream(NIM)); this
%%         is the canonical-free constraint, enforced per instantiation.
%% The setup channel is consumed at commit and never merged into NetIn; only the
%% fresh FM-typed friend channel is.  send_user / add_friend_output resolve from
%% lib/routing/output (exposed at the root); merge / new_channel from root self.glp.

%% Decision is internal to the commit (already_friend -> smaller_dispatch); it does
%% not cross the export boundary.  Structurally identical to each platform's.
Decision ::= yes ; no.

%% Walk Outs, binding Decision to yes iff friend(Other) is already present.
procedure already_friend(Constant?, Stream(Ent)?, Stream(Ent), Decision).
already_friend(Other, [friend_output(O, Out?)|Rest], [friend_output(O?, Out)|Rest?], yes) :-
    Other? =?= O? | true.
already_friend(Other, [E|Rest], [E?|Rest1?], Decision?) :-
    otherwise | already_friend(Other?, Rest?, Rest1, Decision).
already_friend(_, [], [], no).

%% Remove a friend_output by friend id (no-op if absent).  Exported: platforms'
%% unfriend handlers call it, and await_friend_channel uses it.
exported procedure close_friend(Constant?, Stream(Ent)?, Stream(Ent)).
close_friend(_, [], []).
close_friend(Name, [friend_output(K, [])|Rest], Rest?) :-
    Name? =?= K? | true.
close_friend(Name, [E|Rest], [E?|Rest1?]) :-
    otherwise | close_friend(Name?, Rest?, Rest1).

%% Top-level befriend commit.  Ch is the post-handshake SETUP channel.
exported procedure befriend_commit(Constant?, Constant?, Channel(Stream(C), Stream(C))?,
                          Stream(Ent)?, Stream(Ent), Stream(NIM)?, Stream(NIM)).

%% Smaller-name side: I decide.  Test already_friend then dispatch.
befriend_commit(Id, Other, Ch, Outs, Outs1?, NetIn, NetIn1?) :-
    Id? @< Other? |
    already_friend(Other?, Outs?, Outs2, Decision),
    smaller_dispatch(Decision?, Other?, Ch?, Outs2?, Outs1, NetIn?, NetIn1).

%% Larger-name side: I adopt the friend channel the smaller-name side conveys.
befriend_commit(_, Other, Ch, Outs, Outs1?, NetIn, NetIn1?) :-
    otherwise |
    await_friend_channel(Other?, Ch?, Outs?, Outs1, NetIn?, NetIn1).

%% Smaller-name dispatch on whether friend(Other) is already present.
procedure smaller_dispatch(Decision?, Constant?, Channel(Stream(C), Stream(C))?,
                           Stream(Ent)?, Stream(Ent), Stream(NIM)?, Stream(NIM)).

%% Already friend: suppress.  Close the setup write end to []; the larger-name
%% side reads [] and drops.  Allocate no friend channel, merge nothing.
smaller_dispatch(yes, _, ch(_, []), Outs, Outs?, NetIn, NetIn?).

%% Not yet friend: allocate a fresh friend channel; convey its peer end on the
%% setup write end (this conveyance is the smaller-name marker); install the
%% local end (add_friend_output) and merge its read side into NetIn.
smaller_dispatch(no, Other, ch(_, [friend_channel(PeerEnd?)|[]]), Outs, Outs2?, NetIn, NetIn1?) :-
    ground(Other?), new_channel(PeerEnd, ch(FIn, FOut?)) |
    output # add_friend_output(Other?, FOut, Outs?, Outs1),
    output # send_user(msg(agent, '_user', connected(Other?)), Outs1?, Outs2),
    merge(NetIn?, FIn?, NetIn1).

%% Larger-name side: read the setup channel's read end.
procedure await_friend_channel(Constant?, Channel(Stream(C), Stream(C))?,
                          Stream(Ent)?, Stream(Ent), Stream(NIM)?, Stream(NIM)).

%% Friend channel conveyed: adopt it — install its write end and merge its read
%% side into NetIn.  close_friend handles the rare case where an earlier adoption
%% for a different channel already installed friend(Other); a no-op if absent.
await_friend_channel(Other, ch([friend_channel(ch(FIn, FOut?))|_], []), Outs, Outs3?, NetIn, NetIn1?) :-
    ground(Other?) |
    close_friend(Other?, Outs?, Outs1),
    output # add_friend_output(Other?, FOut, Outs1?, Outs2),
    output # send_user(msg(agent, '_user', connected(Other?)), Outs2?, Outs3),
    merge(NetIn?, FIn?, NetIn1).

%% Setup closed ([]): smaller-name side suppressed this offer.  Drop it.
await_friend_channel(_, ch([], []), Outs, Outs?, NetIn, NetIn?).
