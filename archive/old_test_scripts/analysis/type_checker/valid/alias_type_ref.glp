%% VALID: Type alias to type reference (v0.7)
%% Aliases are resolved at preprocessing
%% Per spec type-environment.md v0.7

Stream ::= [] ; [_|Stream].
MyStream ::= Stream.
ConsumedStream ::= Stream?.

%% Use the aliases in procedures
procedure produce(MyStream).
produce([]).
produce([X?|Xs?]) :- produce(Xs).

procedure consume(ConsumedStream).
consume([]).
consume([X|Xs]) :- consume(Xs?).
