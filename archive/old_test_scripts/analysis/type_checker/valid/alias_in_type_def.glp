%% VALID: Alias used within type definition (v0.7)
%% Aliases can be used as arguments in other type definitions
%% Per spec type-environment.md v0.7

Element ::= Integer.
MyList ::= [] ; [Element|MyList].

%% Use the type
procedure sum(MyList?, Integer).
sum([], 0).
sum([X|Xs], R?) :- sum(Xs?, R1), R := X? + R1?.
