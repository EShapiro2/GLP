% GLP System Predicate: Equator (Many-to-One Signaling)
% Creates equator structure for many-to-one communication.

% create_equator(C, Eq, Handle)
% C - collapse constant (reader)
% Eq - binds to '_equator'(E, C) structure (writer)
% Handle - binds to E? reader of the fresh variable inside structure
create_equator(C, '_equator'(E, C?), E?).
