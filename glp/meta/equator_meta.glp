%% equator_meta.glp - Metainterpreter with equator-based emergency brake
%% Source: The Art of Grassroots Logic Programming, Chapter on Metaprogramming
%%
%% Demonstrates many-to-one signaling via equators.
%% Any process can pull the brake (trigger the equator), the controller detects it.
%%
%% Parameters:
%%   P  - Program (ground)
%%   G  - Goal
%%   Cs - Command stream [suspend|Cs], [resume|Cs], [brake|_]
%%   Eq - Equator structure '_equator'(E, C)
%%   L  - Log accumulator
%%   L' - Final log

run(_, true, _, _, L, L?).                          % halt

run(P, (A, B), Cs, Eq, L, L2?) :-                   % fork
    equator(Eq?) |
    distribute(Cs?, Cs1, Cs2),
    run(P?, A?, Cs1?, Eq?, L?, L1),
    run(P?, B?, Cs2?, Eq?, L1?, L2).

run(P, G, [suspend|Cs], Eq, L, L?) :-               % suspend
    equator(Eq?) |
    suspended_run(P?, G?, Cs?, Eq?, L?, L).

run(P, G, Cs, Eq, L, L2?) :-                        % reduce
    equator(Eq?), ground(P?), known(G?),
    ~(G? =?= true), ~(G? =?= (_, _)) |
    reduce(G?, P?, Body),
    run(P?, Body?, Cs?, Eq?, L?, L2).

suspended_run(P, G, [resume|Cs], Eq, L, L?) :-      % resume
    run(P?, G?, Cs?, Eq?, L?, L).

suspended_run(_, _, [brake|_], Eq, L, L?) :-        % pull brake
    equate(Eq?).

suspended_run(_, _, [abort|_], _, L, L?).           % abort (terminate)

%% Usage:
%%   create_equator(stop, Eq, Handle),
%%   controller(Handle?, Commands),
%%   run(Program, Goal, Commands?, Eq?, [], Log).
%%
%% Any suspended_run can pull the brake via equate(Eq?).
%% The controller detects via Handle being bound to 'stop'.
