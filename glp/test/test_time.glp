% Test time mechanisms

% Test that two consecutive _now calls advance (T2 > T1)
time_advances(Result?) :- get_current_time(T1), check_time_advances(T1?, Result).
get_current_time(T?) :- '_now'(T).
check_time_advances(T1, Result?) :- get_current_time(T2), check_time_advances2(T1?, T2?, Result).
check_time_advances2(T1, T2, true) :- T1? < T2? | true.
check_time_advances2(T1, T2, false) :- T1? >= T2? | true.

% Test wait_until - succeeds if time >= T
past_time(T, yes) :- wait_until(T?) | true.

% Test wait - suspends for duration then succeeds
wait_test(done) :- wait(100) | true.
