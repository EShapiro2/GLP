% test_guards_comprehensive.glp - Comprehensive guard tests
% Tests success cases only (failure tested via "fails" expected result)

% list guard - success case
test_list_ok(X, ok) :- list(X?) | true.

% tuple guard - success case
test_tuple_ok(X, ok) :- tuple(X?) | true.

% string guard - success case
test_string_ok(X, ok) :- string(X?) | true.

% constant guard - success case
test_constant_ok(X, ok) :- constant(X?) | true.
