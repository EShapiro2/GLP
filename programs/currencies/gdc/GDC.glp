%% ---------------------------------------------------------------------------
%% GDC.glp --- Grassroots Denominated Coins, the contract GDC, Currencies' (Coordination Appendix C; Udi, 2026-11-04), in the clause syntax of GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint, Guards), as programs/gsc/README.md reads it.  The clauses are in GDC.txt beside this file.  GDC extends GC, which extends GKK, so the term holds their schemas, written here in the clause syntax: coin(Holder, u) a coin of u, dcoin(Holder, u, f) a coin of u denominated by f, u's debt of one unit of f (GDC:2).  GDC:1, Minting, is dmint; GC's swap, pay and redeem take a denominated coin in place of a coin, lot by lot, so each has twins named with d for the denominated lot, under GC's buttons.  GDC:2 and GDC:3 are undertaken and have no schema.  GCC.glp holds the same schemas, GCC extending GDC.  Written by Currencies #16 Cowork, 2026-11-06, the schemas as GCC.glp writes them at GLP main 060468f7, replacing the earlier term form of 2026-11-04.
%% ---------------------------------------------------------------------------

%% contract_named(gdc, C): the contract, GDC (Coordination Appendix C).
procedure contract_named(Constant?, SContract).
contract_named(gdc,
   [
%% GKK:1, Identity.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
%% GKK:2, Acquaintance.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
%% GKK:3, Introduction.
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
%% GC:1, Minting.
    sas(mint, ['Alice'], [k],
       [times(num(k), atom(coin, ['Alice', 'Alice']))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
%% GC:2, Swap.
    sas(swap, ['Alice', 'Bob', u, v], [u, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:3, Payment.
    sas(pay, ['Alice', 'Bob'], [k],
       [not(times(num(k), atom(coin, ['Alice', 'Bob']))),
        times(num(k), atom(coin, ['Bob', 'Bob']))],
       [times(num(k), atom(coin, ['Alice', 'Bob'])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4, Redemption.
    sas(redeem, ['Alice', 'Bob', r], [r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(coin, ['Bob', r]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDC:1, Minting: a coin denominated by f.
    sas(dmint, ['Alice'], [f, k],
       [times(num(k), atom(dcoin, ['Alice', 'Alice', num(f)]))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
%% GC:2 for a denominated coin given.
    sas(swap_dc, ['Alice', 'Bob', u, v], [u, f, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(dcoin, ['Alice', u, num(f)]))),
        times(num(k), atom(dcoin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(dcoin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:2 for a denominated coin wanted.
    sas(swap_cd, ['Alice', 'Bob', u, v], [u, k, v, f1, k1],
       [times(num(k1), atom(dcoin, ['Alice', v, num(f1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(dcoin, ['Bob', v, num(f1)])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(dcoin, ['Bob', v, num(f1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:2 for denominated coins.
    sas(swap_dd, ['Alice', 'Bob', u, v], [u, f, k, v, f1, k1],
       [times(num(k1), atom(dcoin, ['Alice', v, num(f1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(dcoin, ['Alice', u, num(f)]))),
        times(num(k), atom(dcoin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(dcoin, ['Bob', v, num(f1)])))],
       [times(num(k), atom(dcoin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(dcoin, ['Bob', v, num(f1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:3 for denominated coins.
    sas(pay_d, ['Alice', 'Bob'], [f, k],
       [not(times(num(k), atom(dcoin, ['Alice', 'Bob', num(f)]))),
        times(num(k), atom(dcoin, ['Bob', 'Bob', num(f)]))],
       [times(num(k), atom(dcoin, ['Alice', 'Bob', num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for a denominated coin presented.
    sas(redeem_dc, ['Alice', 'Bob', r], [f, r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(dcoin, ['Alice', 'Bob', num(f)])),
        atom(dcoin, ['Bob', 'Bob', num(f)]),
        not(atom(coin, ['Bob', r]))],
       [atom(dcoin, ['Alice', 'Bob', num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for a denominated coin taken.
    sas(redeem_cd, ['Alice', 'Bob', r], [f1, r],
       [atom(dcoin, ['Alice', r, num(f1)]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(dcoin, ['Bob', r, num(f1)]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(dcoin, ['Bob', r, num(f1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for denominated coins.
    sas(redeem_dd, ['Alice', 'Bob', r], [f, f1, r],
       [atom(dcoin, ['Alice', r, num(f1)]),
        atom(knows, ['Alice', r]),
        not(atom(dcoin, ['Alice', 'Bob', num(f)])),
        atom(dcoin, ['Bob', 'Bob', num(f)]),
        not(atom(dcoin, ['Bob', r, num(f1)]))],
       [atom(dcoin, ['Alice', 'Bob', num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(dcoin, ['Bob', r, num(f1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice'])]).
