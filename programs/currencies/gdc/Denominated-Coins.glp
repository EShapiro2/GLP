 sas(pay, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Type', 'Dollar', 'SumSet', 'Sum'], [not(atom(note, ['Alice', 'Carol', const('Type'), const('Dollar'), set('SumSet')])), atom(note, ['Bob', 'Carol', const('Type'), const('Dollar'), set('SumSet')]), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Carol', const('Type'), const('Dollar'), set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Alice', 'Bob']),
 sas(pay_issuer, ['Alice', 'Bob'], ['Type', 'Dollar', 'SumSet', 'Sum'], [not(atom(note, ['Alice', 'Bob', const('Type'), const('Dollar'), set('SumSet')])), atom(note, ['Bob', 'Bob', const('Type'), const('Dollar'), set('SumSet')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Bob', const('Type'), const('Dollar'), set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Alice']),
 sas(deposit, ['Alice', 'Carol', one('Dave', ['Alice', 'Carol']), one('Bob', 'Dave')], ['Dave', 'Type', 'Dollar', 'SumSet', 'Sum', 'Bob', 'Cond'], [not(atom(note, ['Alice', 'Dave', const('Type'), const('Dollar'), set('SumSet')])), atom(escrow_note, ['Carol', 'Dave', const('Type'), const('Dollar'), 'Alice', 'Bob', 'Cond', set('SumSet')])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Dave', const('Type'), const('Dollar'), set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Alice', 'Carol']),
 sas(release, ['Carol', 'Bob', one('Dave', ['Carol', 'Bob']), one('Alice', 'Dave')], ['Dave', 'Type', 'Dollar', 'Alice', 'Cond', 'SumSet', 'Sum'], [not(atom(escrow_note, ['Carol', 'Dave', const('Type'), const('Dollar'), 'Alice', 'Bob', 'Cond', set('SumSet')])), atom(note, ['Bob', 'Dave', const('Type'), const('Dollar'), set('SumSet')]), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), atom(escrow_note, ['Carol', 'Dave', const('Type'), const('Dollar'), 'Alice', 'Bob', 'Cond', set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Carol', 'Bob']),
 sas(return, ['Carol', 'Alice', one('Dave', ['Carol', 'Alice']), one('Bob', 'Dave')], ['Dave', 'Type', 'Dollar', 'Bob', 'Cond', 'SumSet', 'Sum'], [not(atom(escrow_note, ['Carol', 'Dave', const('Type'), const('Dollar'), 'Alice', 'Bob', 'Cond', set('SumSet')])), atom(note, ['Alice', 'Dave', const('Type'), const('Dollar'), set('SumSet')]), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), atom(escrow_note, ['Carol', 'Dave', const('Type'), const('Dollar'), 'Alice', 'Bob', 'Cond', set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Carol', 'Alice']),
 sas(redeem, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Dollar', 'BobCoinDollar1Set', 'Carol', 'CarolCoinDollar1Set'], [not(atom(note, ['Alice', 'Bob', val(coin), const('Dollar'), set('BobCoinDollar1Set')])), atom(note, ['Bob', 'Bob', val(coin), const('Dollar'), set('BobCoinDollar1Set')]), not(atom(note, ['Bob', 'Carol', val(coin), const('Dollar'), set('CarolCoinDollar1Set')])), atom(note, ['Alice', 'Carol', val(coin), const('Dollar'), set('CarolCoinDollar1Set')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Bob', val(coin), const('Dollar'), set('BobCoinDollar1Set')]), atom(note, ['Bob', 'Carol', val(coin), const('Dollar'), set('CarolCoinDollar1Set')])], and(eq(size('BobCoinDollar1Set'), num(1)), eq(size('CarolCoinDollar1Set'), num(1))), ['Alice']),
 sas(first_issue, ['Alice'], ['Dollar', 'SumSet', 'Sum'], [atom(note, ['Alice', 'Alice', val(coin), const('Dollar'), set('SumSet')]), atom(issued_in, ['Alice', const('Dollar')])], [atom(identity, ['Alice']), not(atom(issued_in, ['Alice', '_']))], eq(size('SumSet'), num('Sum')), ['Alice'])])).
