%% boot.glp — Bonds V2 play orchestrator
%%
%% Full stack: network2 <-> agent/6 <-> ui_mediator <-> tee <-> actor
%%                                                       |
%%                                                  sink (display)
%%
%% Phase 1: Single-agent plays (no network).
%% Phase 2: Two-agent plays with network2.
%% Phase 3: Credit + payment (two-agent).
%% Phase 4: Credit + redemption (two-agent).


%% Exported entry points (project-compilation spec §3.4: only exported
%% root-level procedures alias). Each `exported procedure` declaration sits
%% immediately above its clause, as the parser requires.

%% =============================================================================
%% IMPORTED PROCEDURES
%% =============================================================================

%% From agent.glp
imported procedure agent#agent(Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Stream(Bond)?, Constant?, Constant?).

%% From mediator.glp
imported procedure mediator#ui_mediator(Constant?, AgentChannel?, UserChannel?, Stream(PendingEntry)?, Constant?).

%% From actors.glp — play actors
imported procedure actors#alice_p1(ActorChannel?).
imported procedure actors#alice_p2(ActorChannel?).
imported procedure actors#bob_p2(ActorChannel?).
imported procedure actors#alice_p3(ActorChannel?).
imported procedure actors#bob_p3(ActorChannel?).
imported procedure actors#alice_p4(ActorChannel?).
imported procedure actors#bob_p4(ActorChannel?).
imported procedure actors#alice_p4b(ActorChannel?, Constant?).
imported procedure actors#bob_p4b(ActorChannel?, Constant?).
imported procedure actors#alice_p5(ActorChannel?).
imported procedure actors#bob_p5(ActorChannel?).
imported procedure actors#alice_p6(ActorChannel?).
imported procedure actors#bob_p6(ActorChannel?).
imported procedure actors#alice_p8(ActorChannel?).
imported procedure actors#bob_p8(ActorChannel?).
imported procedure actors#alice_p9(ActorChannel?).
imported procedure actors#bob_p9(ActorChannel?).
imported procedure actors#alice_p10(Constant?, ActorChannel?).
imported procedure actors#bob_p10(ActorChannel?).
imported procedure actors#alice_p11(Constant?, ActorChannel?).
imported procedure actors#bob_p11(ActorChannel?).
imported procedure actors#alice_p13(ActorChannel?).
imported procedure actors#bob_p13(ActorChannel?).
imported procedure actors#alice_cl(ActorChannel?).
imported procedure actors#bob_cl(ActorChannel?).
imported procedure actors#charlie_cl(ActorChannel?).

%% From play12/*.glp — village actors
imported procedure alice#alice_p12(Constant?, ActorChannel?, Stream(NarrativeItem)).
imported procedure bob#bob_p12(ActorChannel?, Stream(NarrativeItem)).
imported procedure charlie#charlie_p12(Constant?, ActorChannel?, Stream(NarrativeItem)).
imported procedure diana#diana_p12(ActorChannel?, Stream(NarrativeItem)).
imported procedure eve#eve_p12(ActorChannel?, Stream(NarrativeItem)).
imported procedure frank#frank_p12(ActorChannel?, Stream(NarrativeItem)).

%% =============================================================================
%% TEE — Stream splitter
%% =============================================================================

procedure tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

%% =============================================================================
%% SINK — Dummy consumer (discards stream)
%% =============================================================================

procedure sink(Stream(X)?).
sink([_|Xs]) :- sink(Xs?).
sink([]).

%% =============================================================================
%% SEND_TO_USER_TAGGED — Merge display streams, tag with agent ID
%% =============================================================================

procedure send_to_user_tagged(Constant?, Stream(UserCmd)?, Stream(UserNotify)?).
send_to_user_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, cmd(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, notify(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(_, [], []).
send_to_user_tagged(_, Cmds, []) :- sink(Cmds?).

%% =============================================================================
%% SEND_TO_USER_NARRATE — Emit narrative items as tagged output
%% =============================================================================

procedure send_to_user_narrate(Constant?, Stream(NarrativeItem)?).

send_to_user_narrate(Id, [friend(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, friend(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(Id, [say(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, say(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(Id, [act(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, act(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(Id, [event(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, event(X?))]),
    send_to_user_narrate(Id?, Ns?).
send_to_user_narrate(_, []).

%% =============================================================================
%% NETWORK SWITCH (2-way)
%% =============================================================================

%% Cold-call routing (2-arg msg)
%% Simulated network switch carries the transport union NetInStream
%% (writer ⊆ reader: producers emit the narrower NetOutStream).
procedure network2(Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?).
network2(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

%% Friend-to-friend routing (3-arg msg)
network2(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

%% Termination
network2(ch([], []), ch([], [])).

%% =============================================================================
%% NETWORK SWITCH (3-way) — lender alice, borrower bob, escrow agent charlie,
%% for the credit-line construction (paper §5).  Cold-call (2-arg) and
%% friend-to-friend (3-arg) routing, as network2/network6.
%% =============================================================================

procedure network3(Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?).
network3(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch([msg(bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% --- Friend-to-friend routing (3-arg msg) ---

network3(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(alice, charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(alice, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(bob, charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(bob, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(charlie, alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(charlie, alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(charlie, bob, X?)|BobOut?]),
         ch([msg(charlie, bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Termination
network3(ch([], []), ch([], []), ch([], [])).

%% =============================================================================
%% PLAY 1 — Solo mint + balance (with tee + sink display)
%% =============================================================================

exported procedure play1.
play1 :-
    actors # alice_p1(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, [],
          [user_output(AliceAgentToUser)], [], 1, 0),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?).

%% =============================================================================
%% FLUTTER PLAY 1 — Solo mint + balance (with tagged output for UI)
%% =============================================================================

exported procedure fplay1.
fplay1 :-
    actors # alice_p1(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, [],
          [user_output(AliceAgentToUser)], [], 1, 0),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?).

%% =============================================================================
%% PLAY 2 — Befriend + credit line (with tee + sink display)
%% =============================================================================

exported procedure play2.
play2 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    %% Alice
    actors # alice_p2(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [user_output(AliceAgentToUser), net_output(AliceNetOut)],
          [], 1, 0),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob
    actors # bob_p2(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetIn?,
          [user_output(BobAgentToUser), net_output(BobNetOut)],
          [], 1, 0),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?).

