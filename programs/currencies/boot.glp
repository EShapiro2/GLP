%% =============================================================================
%% FLUTTER PLAY 13 — Loan then issuer-dated redemption (2 agents)
%% =============================================================================
%%
%% Alice (lender) mints coins (maturity 0), Bob (borrower) mints a larger
%% future-maturity bond; they swap (the loan).  Alice presents the dated bond
%% for redemption before it matures at BOB's date, so it reaches Bob as a normal
%% swap offer (Def 3.2: a bond is a coin only at its issuer's date), which Bob
%% declines; Bob then advances HIS OWN local date past maturity (Def 3.2), and
%% Alice's second presentation is a coin Bob must fulfil — set-off.  Per-agent
%% local clocks, no global clock.

exported procedure fplay13.
fplay13 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    %% Alice — lender
    actors # alice_p13(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [user_output(AliceAgentToUser), net_output(AliceNetOut)],
          [], 1, 0),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob — borrower
    actors # bob_p13(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetIn?,
          [user_output(BobAgentToUser), net_output(BobNetOut)],
          [], 1, 0),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?).

%% =============================================================================
%% CREDIT LINE (paper §5 item 7) — lender alice (p), borrower bob (q), escrow
%% agent charlie (e), over the 3-way network.
%% =============================================================================

exported procedure fplay_cl.
fplay_cl :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice — lender p
    actors # alice_cl(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [user_output(AliceAgentToUser), net_output(AliceNetOut)], [], 1, 0),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob — borrower q
    actors # bob_cl(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetIn?,
          [user_output(BobAgentToUser), net_output(BobNetOut)], [], 1, 0),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie — escrow agent e
    actors # charlie_cl(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent # agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [user_output(CharlieAgentToUser), net_output(CharlieNetOut)], [], 1, 0),
    mediator # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?).

%% =============================================================================
%% NETWORK SWITCH (6-way)
%% =============================================================================

%% --- Cold-call routing (2-arg msg) ---

procedure network6(Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?).
network6(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?),
         ch(DianaIn, DianaOut?),
         ch(EveIn, EveOut?),
         ch(FrankIn, FrankOut?)) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
             ch(DianaIn?, DianaOut), ch(EveIn?, EveOut), ch(FrankIn?, FrankOut)).

network6(ch([msg(charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?]),
         ch(DianaIn, DianaOut?),
         ch(EveIn, EveOut?),
         ch(FrankIn, FrankOut?)) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
             ch(DianaIn?, DianaOut), ch(EveIn?, EveOut), ch(FrankIn?, FrankOut)).

network6(ch([msg(diana, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, CharlieOut?),
         ch(DianaIn, [msg(diana, X?)|DianaOut?]),
         ch(EveIn, EveOut?),
         ch(FrankIn, FrankOut?)) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
             ch(DianaIn?, DianaOut), ch(EveIn?, EveOut), ch(FrankIn?, FrankOut)).

network6(ch([msg(eve, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, CharlieOut?),
         ch(DianaIn, DianaOut?),
         ch(EveIn, [msg(eve, X?)|EveOut?]),
         ch(FrankIn, FrankOut?)) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
             ch(DianaIn?, DianaOut), ch(EveIn?, EveOut), ch(FrankIn?, FrankOut)).

network6(ch([msg(frank, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, CharlieOut?),
         ch(DianaIn, DianaOut?),
         ch(EveIn, EveOut?),
         ch(FrankIn, [msg(frank, X?)|FrankOut?])) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
             ch(DianaIn?, DianaOut), ch(EveIn?, EveOut), ch(FrankIn?, FrankOut)).

network6(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?),
         ch(DianaIn, DianaOut?),
         ch(EveIn, EveOut?),
         ch(FrankIn, FrankOut?)) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
             ch(DianaIn?, DianaOut), ch(EveIn?, EveOut), ch(FrankIn?, FrankOut)).

network6(ch(AliceIn, AliceOut?),
         ch([msg(charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?]),
         ch(DianaIn, DianaOut?),
         ch(EveIn, EveOut?),
         ch(FrankIn, FrankOut?)) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
             ch(DianaIn?, DianaOut), ch(EveIn?, EveOut), ch(FrankIn?, FrankOut)).

network6(ch(AliceIn, AliceOut?),
         ch([msg(diana, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?),
         ch(DianaIn, [msg(diana, X?)|DianaOut?]),
         ch(EveIn, EveOut?),
         ch(FrankIn, FrankOut?)) :-
    network6(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut),
