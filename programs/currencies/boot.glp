%% =============================================================================

exported procedure play6.
play6 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    %% Alice
    actors # alice_p6(ch(AliceActorIn?, AliceActorOut)),
