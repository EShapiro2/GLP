%% =============================================================================
%% FLUTTER PLAY 12 — Village Market Month (6 agents + narrative)
%% =============================================================================

exported procedure fplay12.
fplay12 :-
    now(Now),
    T := Now? + 700,
    network6(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn),
             ch(DianaNetOut?, DianaNetIn),
             ch(EveNetOut?, EveNetIn),
             ch(FrankNetOut?, FrankNetIn)),

    %% Alice (T unused by alice, pass dummy constant to avoid SRSW on T?)
    alice # alice_p12(0, ch(AliceActorIn?, AliceActorOut), AliceNarr),
    send_to_user_narrate(alice, AliceNarr?),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [user_output(AliceAgentToUser), net_output(AliceNetOut)], [], 1, 0),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob
    bob # bob_p12(ch(BobActorIn?, BobActorOut), BobNarr),
    send_to_user_narrate(bob, BobNarr?),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetIn?,
          [user_output(BobAgentToUser), net_output(BobNetOut)], [], 1, 0),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie
    charlie # charlie_p12(T?, ch(CharlieActorIn?, CharlieActorOut), CharlieNarr),
    send_to_user_narrate(charlie, CharlieNarr?),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent # agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [user_output(CharlieAgentToUser), net_output(CharlieNetOut)], [], 1, 0),
    mediator # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?),

    %% Diana
    diana # diana_p12(ch(DianaActorIn?, DianaActorOut), DianaNarr),
    send_to_user_narrate(diana, DianaNarr?),
    tee(DianaActorOut?, DianaMedIn, DianaDispCmd),
    agent # agent(diana, DianaAgentIn?, DianaNetIn?,
          [user_output(DianaAgentToUser), net_output(DianaNetOut)], [], 1, 0),
    mediator # ui_mediator(diana, ch(DianaAgentToUser?, DianaAgentIn),
                ch(DianaMedIn?, DianaMedOut), [], 1),
    tee(DianaMedOut?, DianaActorIn, DianaDispNotify),
    send_to_user_tagged(diana, DianaDispCmd?, DianaDispNotify?),

    %% Eve
    eve # eve_p12(ch(EveActorIn?, EveActorOut), EveNarr),
    send_to_user_narrate(eve, EveNarr?),
    tee(EveActorOut?, EveMedIn, EveDispCmd),
    agent # agent(eve, EveAgentIn?, EveNetIn?,
          [user_output(EveAgentToUser), net_output(EveNetOut)], [], 1, 0),
    mediator # ui_mediator(eve, ch(EveAgentToUser?, EveAgentIn),
                ch(EveMedIn?, EveMedOut), [], 1),
    tee(EveMedOut?, EveActorIn, EveDispNotify),
    send_to_user_tagged(eve, EveDispCmd?, EveDispNotify?),

    %% Frank
    frank # frank_p12(ch(FrankActorIn?, FrankActorOut), FrankNarr),
    send_to_user_narrate(frank, FrankNarr?),
    tee(FrankActorOut?, FrankMedIn, FrankDispCmd),
    agent # agent(frank, FrankAgentIn?, FrankNetIn?,
          [user_output(FrankAgentToUser), net_output(FrankNetOut)], [], 1, 0),
    mediator # ui_mediator(frank, ch(FrankAgentToUser?, FrankAgentIn),
