        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(coin, ['Bob', r]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDC:1, Minting: a coin denominated by f.
    sas(dmint, ['Alice'], [f, k],
       [times(num(k), atom(dcoin, ['Alice', 'Alice', num(f)]))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
%% BCC:3 where a giver gives a denominated or community coin; GC:2 for a denominated coin given.
    sas(swap_dc, ['Alice', 'Bob', u, v, bc1, bw6, bc7, bq9, bx10, bc11], [u, f, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(dcoin, ['Alice', u, num(f)]))),
        times(num(k), atom(dcoin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(dcoin, ['Alice', u, num(f)])),
