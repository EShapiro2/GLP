%% ---------------------------------------------------------------------------
%% BCC.glp --- Backed Community Currencies, the contract BCC, Currencies' (Coordination Appendix C; Udi, 2026-11-04), in the clause syntax of GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint, Guards), as programs/gsc/README.md reads it.  The clauses are in BCC.txt beside this file.  BCC restricts GCC (GSC, Section 8): the term holds GCC's schemas (programs/currencies/gcc/GCC.glp, with GKK's, GC's and GDC's), each with GCC's name, head and guards, and the body of appoint (BCC:1; a removal changes no one's backing), cmint (BCC:2), and of the twins of GC:2 to GC:4 and GCC:5 in which a giver gives a denominated or a community coin (BCC:3) strengthened by "stays backed".  A schema whose givers give only undenominated coins is GCC's: the act changes no one's backing, and every person with coins out is backed in every state the contract reaches.
%%
%% Backed, as BCC's declaration defines it, for a person X in a community N of denomination g, read in X's state: the treasurers are those appointed to N, the q of appointed(X, q, N), n their number, a removed treasurer counted among them as an insolvent one, and for a person removed from N those appointed before X was removed (GCC.glp's remove); X's coins out are i, of issued(X, N, i), less the community coins of N that X minted and holds, ccoin(X, X, N, g); h(v), for a treasurer v but X, is the coins of v denominated g that X holds, dcoin(X, v, g) and ccoin(X, v, M, g) of every community M; L = floor(f n), f read from the environment predicate fraction(f), the contract's f, declared by environment([fraction], Contract) and given at deployment (vGLP 9ee6f87, Section 5.4), which no schema adds or deletes, its value a real, real(f) (GSC 8b1460f; GSC #13, 2026-11-07 17:24 UTC).  X is backed if the sum of h over the treasurers but X, leaving out the L largest, is at least X's coins out, Y.  That sum is at least Y if and only if Y <= 0 or, for some treasurer w but X, sum over v of min(h(v), h(w)) - L h(w) >= Y; this is how the term writes it.
%%
%% "Stays backed" is a condition on the state before the act, which the act's head makes equivalent to X being backed after it (GSC #12, 2026-11-06 16:45 UTC): h and Y are written with the head's changes to X's coins, each coin moved by the act counted by an indicator, cardinality([], identity(X), C), which is 1 where C holds and 0 where not; for appoint, Bob added to the treasurers appointed.  The sum is GSC's, sum(Xs, Anchor, Phi, Expr) (GSC main 0ee69c7), which the checker reads since GLP main 32cd174e (Code #24, 17:14 UTC); a count or a sum takes each instance of its anchor as many times as the anchor is held, so cardinality([], dcoin(X, v, g), true) is the number of copies X holds (GSC 67a7da0, Section 3.1; GSC #12, 17:23 UTC).  fn(floor, [E]) and fn(min, [E1, E2]) are functions the numbers provide.  Every bound person is in Names, each scope with its own name (Code #24, 2026-11-06 11:08 UTC, as GDO-LB.glp has it).
%%
%% Generated by Currencies #16 Cowork, 2026-11-06, from GCC.glp at GLP main b660e1fa with its start, appoint and remove of the same day, by a script that writes the backing condition the same way in every schema.
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant)
              ; sgn(Constant, Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SHead       ::= SMult ; not(SMult) ; forall(PNames, SAtom, SCond, SHeads).
SHeads      ::= [] ; [SHead | SHeads].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr)
              ; fn(Constant, SExprs) ; cardinality(PNames, SAtom, SCond)
              ; sum(PNames, SAtom, SCond, SExpr).
SExprs      ::= [] ; [SExpr | SExprs].
SCond       ::= true ; SMult ; not(SCond) ; and(SCond, SCond) ; or(SCond, SCond)
              ; eq(SExpr, SExpr) ; ne(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg)
              ; forall(PNames, SAtom, SCond, SCond) ; exists(PNames, SAtom, SCond).
SConds      ::= [] ; [SCond | SConds].
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SHeads, SConds, SCond, PNames).
Contract    ::= [] ; [Schema | Contract].
Preds       ::= [] ; [Constant | Preds].
Declared    ::= Contract ; reflexive(Preds, Contract) ; environment(Preds, Contract).

%% contract_named(bcc, C): the contract, BCC (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(bcc, environment([fraction],
   [
%% GKK:1, Identity.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
%% GKK:2, Acquaintance.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
%% GKK:3, Introduction.
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
%% GC:1, Minting.
    sas(mint, ['Alice'], [k],
       [times(num(k), atom(coin, ['Alice', 'Alice']))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
%% GC:2, Swap.
    sas(swap, ['Alice', 'Bob', u, v], [u, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:3, Payment.
    sas(pay, ['Alice', 'Bob'], [k],
       [not(times(num(k), atom(coin, ['Alice', 'Bob']))),
        times(num(k), atom(coin, ['Bob', 'Bob']))],
       [times(num(k), atom(coin, ['Alice', 'Bob'])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4, Redemption.
    sas(redeem, ['Alice', 'Bob', r], [r],
