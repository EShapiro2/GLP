%% ---------------------------------------------------------------------------
%% GCC.glp --- Grassroots Community Coins, the contract GCC, Currencies' (Coordination Appendix C; Udi, 2026-11-04), in the clause syntax of GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint, Guards), as programs/gsc/README.md reads it.  The clauses are in GCC.txt beside this file.  GCC extends GDC, which extends GC and GKK, so the term holds their schemas, written here in the clause syntax: coin(Holder, u) a personal coin of u, dcoin(Holder, u, f) a coin of u denominated by f, ccoin(Holder, u, N, f) a community coin of the community N minted by u, a coin of u, treasurer(Holder, q, N) that q is a treasurer of N, denomination(Holder, N, f) the community's denomination.  A community is named <c>.n by its founder c and a speech act n.  GCC:2's joint decision is a listed role that guards, and its exclusion of Carol a constraint ne (GSC main f5b3f06).  GCC:4, Fiat Redemption, is undertaken and has no schema; GDC:2 and GDC:3 likewise.  Written by Currencies #15 Cowork, 2026-11-06, the GC, GDC and GCC schemas translated from the earlier term form at GLP main 7e86f7fa.
%% ---------------------------------------------------------------------------

%% contract_named(gcc, C): the contract, GCC (Coordination Appendix C).
procedure contract_named(Constant?, SContract).
contract_named(gcc,
   [
%% GKK:1, Identity.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
%% GKK:2, Acquaintance.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
%% GKK:3, Introduction.
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
%% GC:1, Minting.
    sas(mint, ['Alice'], [k],
       [times(num(k), atom(coin, ['Alice', 'Alice']))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
%% GC:2, Swap.
    sas(swap, ['Alice', 'Bob', u, v], [u, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:3, Payment.
    sas(pay, ['Alice', 'Bob'], [k],
       [not(times(num(k), atom(coin, ['Alice', 'Bob']))),
        times(num(k), atom(coin, ['Bob', 'Bob']))],
       [times(num(k), atom(coin, ['Alice', 'Bob'])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4, Redemption.
    sas(redeem, ['Alice', 'Bob', r], [r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(coin, ['Bob', r]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDC:1, Minting: a coin denominated by f.
    sas(dmint, ['Alice'], [f, k],
       [times(num(k), atom(dcoin, ['Alice', 'Alice', num(f)]))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
%% GC:2 for a denominated coin given.
    sas(swap_dc, ['Alice', 'Bob', u, v], [u, f, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(dcoin, ['Alice', u, num(f)]))),
        times(num(k), atom(dcoin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(dcoin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:2 for a denominated coin wanted.
    sas(swap_cd, ['Alice', 'Bob', u, v], [u, k, v, f1, k1],
       [times(num(k1), atom(dcoin, ['Alice', v, num(f1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(dcoin, ['Bob', v, num(f1)])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(dcoin, ['Bob', v, num(f1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:2 for denominated coins.
    sas(swap_dd, ['Alice', 'Bob', u, v], [u, f, k, v, f1, k1],
       [times(num(k1), atom(dcoin, ['Alice', v, num(f1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(dcoin, ['Alice', u, num(f)]))),
        times(num(k), atom(dcoin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(dcoin, ['Bob', v, num(f1)])))],
       [times(num(k), atom(dcoin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(dcoin, ['Bob', v, num(f1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:3 for denominated coins.
    sas(pay_d, ['Alice', 'Bob'], [f, k],
       [not(times(num(k), atom(dcoin, ['Alice', 'Bob', num(f)]))),
        times(num(k), atom(dcoin, ['Bob', 'Bob', num(f)]))],
       [times(num(k), atom(dcoin, ['Alice', 'Bob', num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for a denominated coin presented.
    sas(redeem_dc, ['Alice', 'Bob', r], [f, r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(dcoin, ['Alice', 'Bob', num(f)])),
        atom(dcoin, ['Bob', 'Bob', num(f)]),
        not(atom(coin, ['Bob', r]))],
       [atom(dcoin, ['Alice', 'Bob', num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for a denominated coin taken.
    sas(redeem_cd, ['Alice', 'Bob', r], [f1, r],
       [atom(dcoin, ['Alice', r, num(f1)]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(dcoin, ['Bob', r, num(f1)]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(dcoin, ['Bob', r, num(f1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for denominated coins.
    sas(redeem_dd, ['Alice', 'Bob', r], [f, f1, r],
       [atom(dcoin, ['Alice', r, num(f1)]),
        atom(knows, ['Alice', r]),
        not(atom(dcoin, ['Alice', 'Bob', num(f)])),
        atom(dcoin, ['Bob', 'Bob', num(f)]),
        not(atom(dcoin, ['Bob', r, num(f1)]))],
       [atom(dcoin, ['Alice', 'Bob', num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(dcoin, ['Bob', r, num(f1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GCC:1, Community: Alice starts <Alice>.n with denomination f, its first treasurer; every treasurer of N lists every treasurer of N, treasurer(Holder, q, N), and every treasurer appointed to N while they are a treasurer, appointed(Holder, q, N).
    sas(start, ['Alice'], [n, f],
       [atom(treasurer, ['Alice', 'Alice', ext(own('Alice'), n)]),
        atom(denomination, ['Alice', ext(own('Alice'), n), num(f)]),
        atom(issued, ['Alice', ext(own('Alice'), n), num(0)]),
        atom(appointed, ['Alice', 'Alice', ext(own('Alice'), n)])],
       [atom(identity, ['Alice']),
        not(atom(treasurer, ['Alice', 'Alice', ext(own('Alice'), n)]))],
       true,
       ['Alice']),
%% GCC:2, Treasurers, appointment: Alice, every treasurer Alice lists (Carol, a listed role that guards) and Bob, by their joint decision; every treasurer and Bob then list each other (GSC f5b3f06), every treasurer lists Bob as appointed, and Bob lists every treasurer Alice lists as appointed, and himself.  Bob is a new treasurer: he has no issued count of the community, so a removed treasurer is not appointed again.
    sas(appoint, ['Alice', 'Bob', 'Carol', 'Dave', c], [c, n, f],
       [forall(['Carol'], atom(treasurer, ['Alice', 'Carol', ext(own(c), n)]), true,
               [atom(treasurer, ['Carol', 'Bob', ext(own(c), n)]), atom(treasurer, ['Bob', 'Carol', ext(own(c), n)]), atom(appointed, ['Carol', 'Bob', ext(own(c), n)])]),
        forall(['Dave'], atom(appointed, ['Alice', 'Dave', ext(own(c), n)]), true,
               [atom(appointed, ['Bob', 'Dave', ext(own(c), n)])]),
        atom(appointed, ['Bob', 'Bob', ext(own(c), n)]),
        atom(treasurer, ['Bob', 'Bob', ext(own(c), n)]),
        atom(denomination, ['Bob', ext(own(c), n), num(f)]),
        atom(issued, ['Bob', ext(own(c), n), num(0)])],
       [atom(identity, ['Alice']),
        atom(treasurer, ['Alice', 'Alice', ext(own(c), n)]),
        atom(denomination, ['Alice', ext(own(c), n), num(f)]),
        forall(['Carol'], atom(treasurer, ['Alice', 'Carol', ext(own(c), n)]), true,
               and(atom(identity, ['Carol']), atom(treasurer, ['Carol', 'Carol', ext(own(c), n)]))),
        atom(identity, ['Bob']),
        not(atom(treasurer, ['Bob', 'Bob', ext(own(c), n)])),
        not(atom(issued, ['Bob', ext(own(c), n), '_']))],
       true,
       ['Alice', 'Carol', 'Bob']),
%% GCC:2, Treasurers, removal: Alice and every treasurer Alice lists but Carol (Dave, a listed role that guards, constrained Dave != Carol), by their joint decision; Carol's treasurer listings of the community are cleared; she keeps the community's denomination, her issued count and the treasurers she lists as appointed, so that BCC reads her backing against the treasurers appointed until she was removed (Udi, 2026-11-06, to Currencies #16).  Seniority as the tie breaker is the realisation's (GSC f5b3f06).
    sas(remove, ['Alice', 'Carol', 'Dave', c], [c, n, f],
       [forall(['Dave'], atom(treasurer, ['Alice', 'Dave', ext(own(c), n)]), ne('Dave', 'Carol'),
               [not(atom(treasurer, ['Dave', 'Carol', ext(own(c), n)]))]),
        not(atom(treasurer, ['Carol', '_', ext(own(c), n)]))],
       [atom(identity, ['Alice']),
        atom(treasurer, ['Alice', 'Alice', ext(own(c), n)]),
        atom(treasurer, ['Alice', 'Carol', ext(own(c), n)]),
        forall(['Dave'], atom(treasurer, ['Alice', 'Dave', ext(own(c), n)]), ne('Dave', 'Carol'),
               and(atom(identity, ['Dave']), atom(treasurer, ['Dave', 'Carol', ext(own(c), n)]))),
        atom(identity, ['Carol']),
        atom(denomination, ['Carol', ext(own(c), n), num(f)])],
       true,
       ['Alice', 'Dave']),
%% GCC:3, Minting: a treasurer of <c>.n mints k community coins of it, ccoin(u, N, f) a coin of its minter u.
    sas(cmint, ['Alice', c], [c, n, f, k, i, i1],
       [times(num(k), atom(ccoin, ['Alice', 'Alice', ext(own(c), n), num(f)])),
        not(atom(issued, ['Alice', ext(own(c), n), num(i)])),
        atom(issued, ['Alice', ext(own(c), n), num(i1)])],
       [atom(identity, ['Alice']),
        atom(treasurer, ['Alice', 'Alice', ext(own(c), n)]),
        atom(denomination, ['Alice', ext(own(c), n), num(f)]),
        atom(issued, ['Alice', ext(own(c), n), num(i)])],
       eq(num(i1), plus(num(i), num(k))),
       ['Alice']),
%% GC:2 for a community coin given.
    sas(swap_xc, ['Alice', 'Bob', u, c, v], [u, c, n, f, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(ccoin, ['Alice', u, ext(own(c), n), num(f)]))),
        times(num(k), atom(ccoin, ['Bob', u, ext(own(c), n), num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(ccoin, ['Alice', u, ext(own(c), n), num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:2 for a community coin wanted.
    sas(swap_cx, ['Alice', 'Bob', u, v, c1], [u, k, v, c1, n1, f1, k1],
       [times(num(k1), atom(ccoin, ['Alice', v, ext(own(c1), n1), num(f1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(ccoin, ['Bob', v, ext(own(c1), n1), num(f1)])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(ccoin, ['Bob', v, ext(own(c1), n1), num(f1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:2 for community coins.
    sas(swap_xx, ['Alice', 'Bob', u, c, v, c1], [u, c, n, f, k, v, c1, n1, f1, k1],
       [times(num(k1), atom(ccoin, ['Alice', v, ext(own(c1), n1), num(f1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(ccoin, ['Alice', u, ext(own(c), n), num(f)]))),
        times(num(k), atom(ccoin, ['Bob', u, ext(own(c), n), num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(ccoin, ['Bob', v, ext(own(c1), n1), num(f1)])))],
       [times(num(k), atom(ccoin, ['Alice', u, ext(own(c), n), num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(ccoin, ['Bob', v, ext(own(c1), n1), num(f1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GC:3 for community coins, paid to their minter.
    sas(pay_x, ['Alice', 'Bob', c], [c, n, f, k],
       [not(times(num(k), atom(ccoin, ['Alice', 'Bob', ext(own(c), n), num(f)]))),
        times(num(k), atom(ccoin, ['Bob', 'Bob', ext(own(c), n), num(f)]))],
       [times(num(k), atom(ccoin, ['Alice', 'Bob', ext(own(c), n), num(f)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for a community coin presented to its minter.
    sas(redeem_xc, ['Alice', 'Bob', c, r], [c, n, f, r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(ccoin, ['Alice', 'Bob', ext(own(c), n), num(f)])),
        atom(ccoin, ['Bob', 'Bob', ext(own(c), n), num(f)]),
        not(atom(coin, ['Bob', r]))],
       [atom(ccoin, ['Alice', 'Bob', ext(own(c), n), num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for a community coin taken.
    sas(redeem_cx, ['Alice', 'Bob', c1, r], [c1, n1, f1, r],
       [atom(ccoin, ['Alice', r, ext(own(c1), n1), num(f1)]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(ccoin, ['Bob', r, ext(own(c1), n1), num(f1)]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(ccoin, ['Bob', r, ext(own(c1), n1), num(f1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GC:4 for community coins.
    sas(redeem_xx, ['Alice', 'Bob', c, c1, r], [c, n, f, c1, n1, f1, r],
       [atom(ccoin, ['Alice', r, ext(own(c1), n1), num(f1)]),
        atom(knows, ['Alice', r]),
        not(atom(ccoin, ['Alice', 'Bob', ext(own(c), n), num(f)])),
        atom(ccoin, ['Bob', 'Bob', ext(own(c), n), num(f)]),
        not(atom(ccoin, ['Bob', r, ext(own(c1), n1), num(f1)]))],
       [atom(ccoin, ['Alice', 'Bob', ext(own(c), n), num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(ccoin, ['Bob', r, ext(own(c1), n1), num(f1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GCC:5, Coin Redemption: from a treasurer Bob, who need not have minted it, against a coin Bob holds.
    sas(credeem_c, ['Alice', 'Bob', c, u, r], [c, n, f, u, r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(ccoin, ['Alice', u, ext(own(c), n), num(f)])),
        atom(ccoin, ['Bob', u, ext(own(c), n), num(f)]),
        not(atom(coin, ['Bob', r]))],
       [atom(ccoin, ['Alice', u, ext(own(c), n), num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob']),
        atom(treasurer, ['Bob', 'Bob', ext(own(c), n)])],
       true,
       ['Alice']),
%% GCC:5, against a community coin Bob holds.
    sas(credeem_x, ['Alice', 'Bob', c, u, c1, r], [c, n, f, u, c1, n1, f1, r],
       [atom(ccoin, ['Alice', r, ext(own(c1), n1), num(f1)]),
        atom(knows, ['Alice', r]),
        not(atom(ccoin, ['Alice', u, ext(own(c), n), num(f)])),
        atom(ccoin, ['Bob', u, ext(own(c), n), num(f)]),
        not(atom(ccoin, ['Bob', r, ext(own(c1), n1), num(f1)]))],
       [atom(ccoin, ['Alice', u, ext(own(c), n), num(f)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(ccoin, ['Bob', r, ext(own(c1), n1), num(f1)]),
        atom(identity, ['Bob']),
        atom(treasurer, ['Bob', 'Bob', ext(own(c), n)])],
       true,
       ['Alice'])]).
