%% mad_fplay4b.glp — madGLP boot for bonds fplay4b (2 isolates: alice, bob)
%%
%% Derived from: bonds/boot.glp fplay4b clause
%% Bonds: Time-dependent redemption (2 agents)
%% Each isolate computes its own T = now() + 500.


procedure boot.
boot :-
    agent_init_4b(alice, _)@alice,
    agent_init_4b(bob, _)@bob.

%% Time-dependent agent — computes T = now + 500 locally
procedure agent_init_4b(Constant?, Stream(_)?).
agent_init_4b(Id, NetIn) :-
    ground(Id?) |
    now(Now),
    T := Now? + 500,
    actor_dispatch_4b(Id?, T?, ch(ActorIn?, ActorOut)),
    tee(ActorOut?, MedIn, DispCmd),
    agent(Id?, AgentIn?, NetIn?,
          [user_output(AgentToUser), net_output(NetOut)],
          [], 1, 0),
    send_to_net(NetOut?),
    ui_mediator(Id?, ch(AgentToUser?, AgentIn),
                ch(MedIn?, MedOut), [], 1),
    tee(MedOut?, ActorIn, DispNotify),
    send_to_user_tagged(Id?, DispCmd?, DispNotify?).

procedure tee(Stream(_)?, Stream(_), Stream(_)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

procedure send_to_user_tagged(Constant?, Stream(_)?, Stream(_)?).
send_to_user_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, cmd(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, notify(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(_, [], []).
send_to_user_tagged(_, Cmds, []) :- sink(Cmds?).

procedure sink(Stream(_)?).
sink([_|Xs]) :- sink(Xs?).
sink([]).

procedure actor_dispatch_4b(Constant?, Constant?, Channel(Stream(UserNotify), Stream(UserCmd))).
actor_dispatch_4b(alice, T, Ch) :- alice_p4b(Ch?, T?).
actor_dispatch_4b(bob, T, Ch) :- bob_p4b(Ch?, T?).
