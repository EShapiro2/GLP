%% mad_fplay10.glp — madGLP boot for bonds fplay10 (2 isolates: alice, bob)
%%
%% Derived from: bonds/boot.glp fplay10 clause
%% Bonds: Escrow — Time Release (2 agents)
%% Alice deposits until date 30 and advances her own date to it. Bob has no date arg.


procedure boot.
boot :-
    alice_init_10(alice, _)@alice,
    agent_init(bob, 10, _)@bob.

%% Alice — time-dependent escrow depositor
procedure alice_init_10(Constant?, Stream(_)?).
alice_init_10(Id, NetIn) :-
    ground(Id?) |
    T := 30,
    alice_p10(T?, ch(ActorIn?, ActorOut)),
    tee(ActorOut?, MedIn, DispCmd),
    agent(Id?, AgentIn?, NetIn?,
          [user_output(AgentToPerson), net_output(NetOut)],
          [], 1, 0),
    send_to_net(NetOut?),
    ui_mediator(Id?, ch(AgentToPerson?, AgentIn),
                ch(MedIn?, MedOut), [], 1),
    tee(MedOut?, ActorIn, DispNotify),
    send_to_person_tagged(Id?, DispCmd?, DispNotify?).

%% Bob — standard agent (no time)
procedure agent_init(Constant?, Constant?, Stream(_)?).
agent_init(Id, PlayNum, NetIn) :-
    ground(Id?), ground(PlayNum?) |
    actor_dispatch(Id?, PlayNum?, ch(ActorIn?, ActorOut)),
    tee(ActorOut?, MedIn, DispCmd),
    agent(Id?, AgentIn?, NetIn?,
          [user_output(AgentToPerson), net_output(NetOut)],
          [], 1, 0),
    send_to_net(NetOut?),
    ui_mediator(Id?, ch(AgentToPerson?, AgentIn),
                ch(MedIn?, MedOut), [], 1),
    tee(MedOut?, ActorIn, DispNotify),
    send_to_person_tagged(Id?, DispCmd?, DispNotify?).

procedure tee(Stream(_)?, Stream(_), Stream(_)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

procedure send_to_person_tagged(Constant?, Stream(_)?, Stream(_)?).
send_to_person_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, cmd(T?))]),
    send_to_person_tagged(Id?, Cmds?, Notifies?).
send_to_person_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, notify(T?))]),
    send_to_person_tagged(Id?, Cmds?, Notifies?).
send_to_person_tagged(_, [], []).
send_to_person_tagged(_, Cmds, []) :- sink(Cmds?).

procedure sink(Stream(_)?).
sink([_|Xs]) :- sink(Xs?).
sink([]).

procedure actor_dispatch(Constant?, Constant?, Channel(Stream(PersonNotify), Stream(PersonCmd))).
actor_dispatch(bob, 10, Ch) :- bob_p10(Ch?).
