%% frank.glp -- Fisherman actor for Play 12 (Village Market Month)
%%
%% Frank accepts befriends from Charlie, Diana, and Eve (concurrent, any order).
%% Accepts Diana's loan (15 diana-coins for 18 frank-bonds).
%% Symmetric trade with Eve (10-for-10).
%% Pays Diana (medical checkup).
%% Receives escrow from Charlie, waits for release (dock done).
%% Redeems from Diana.
%%
%% Types: from bonds/self.glp (ancestor scoping)


exported procedure frank_p12(ActorChannel?, Stream(NarrativeItem)).
frank_p12(ch(In, Out?), Narr?) :-
    frank_p12_gather(none, none, none, In?, Out, Narr).

%% Gather befriends from Charlie, Diana, Eve (3 actors, any order).
%% CS = charlie status, DS = diana status, ES = eve status.
%% Status atoms: none → befriended → done.
procedure frank_p12_gather(Constant?, Constant?, Constant?, Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).

%% All three connected — proceed to mint bonds for Diana's loan
frank_p12_gather(done, done, done, In, [mint(18, 28)|Out?], Narr?) :-
    frank_p12_wait_minted1(In?, Out, Narr).

%% Befriend from Charlie
frank_p12_gather(none, DS, ES, [befriend(charlie, ReqId)|In],
                 [decision(yes, charlie, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) |
    frank_p12_gather(befriended, DS?, ES?, In?, Out, Narr).

%% Connected Charlie
frank_p12_gather(befriended, DS, ES, [connected(charlie)|In], Out?,
                 [friend(charlie)|Narr?]) :-
    frank_p12_gather(done, DS?, ES?, In?, Out, Narr).

%% Befriend from Diana
frank_p12_gather(CS, none, ES, [befriend(diana, ReqId)|In],
                 [decision(yes, diana, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) |
    frank_p12_gather(CS?, befriended, ES?, In?, Out, Narr).

%% Connected Diana
frank_p12_gather(CS, befriended, ES, [connected(diana)|In], Out?,
                 [friend(diana)|Narr?]) :-
    frank_p12_gather(CS?, done, ES?, In?, Out, Narr).

%% Befriend from Eve
frank_p12_gather(CS, DS, none, [befriend(eve, ReqId)|In],
                 [decision(yes, eve, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) |
    frank_p12_gather(CS?, DS?, befriended, In?, Out, Narr).

%% Connected Eve
frank_p12_gather(CS, DS, befriended, [connected(eve)|In], Out?,
                 [friend(eve)|Narr?]) :-
    frank_p12_gather(CS?, DS?, done, In?, Out, Narr).

%% Skip other messages
frank_p12_gather(CS, DS, ES, [_|In], Out?, Narr?) :-
    otherwise | frank_p12_gather(CS?, DS?, ES?, In?, Out, Narr).
frank_p12_gather(_, _, _, [], [], []).

%% Act 2e: Mint frank-bonds(Day28) for Diana's loan
procedure frank_p12_wait_minted1(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_minted1([minted(18, 28)|In], Out?, Narr?) :-
    frank_p12_wait_trade_diana(In?, Out, Narr).
frank_p12_wait_minted1([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_minted1(In?, Out, Narr).
frank_p12_wait_minted1([], [], []).

%% Accept Diana's loan: 15 diana-coins for 18 frank-bonds(28)
procedure frank_p12_wait_trade_diana(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_trade_diana([trade_proposed(diana, _, ReqId)|In],
                           [accept_trade(diana, ReqId?), mint(10, 0)|Out?],
                           [say('Diana, deal — 18 bonds maturing day 28 for 15 coins'),
                            act('Loan from Diana: 15 diana-coins for 18 frank-bonds(28)')|Narr?]) :-
    ground(ReqId?) |
    frank_p12_wait_minted2(In?, Out, Narr).
frank_p12_wait_trade_diana([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_trade_diana(In?, Out, Narr).
frank_p12_wait_trade_diana([], [], []).

%% Act 2f: Mint frank-coins for symmetric trade with Eve
procedure frank_p12_wait_minted2(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_minted2([minted(10, 0)|In], Out?, Narr?) :-
    frank_p12_wait_trade_eve(In?, Out, Narr).
frank_p12_wait_minted2([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_minted2(In?, Out, Narr).
frank_p12_wait_minted2([], [], []).

%% Accept Eve's symmetric trade proposal
procedure frank_p12_wait_trade_eve(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_trade_eve([trade_proposed(eve, _, ReqId)|In],
                         [accept_trade(eve, ReqId?),
                          trade(diana, [lot(diana, 0, 3)], [])|Out?],
                         [say('Eve, of course — 10 for 10'),
                          act('Credit line with Eve: 10 frank-coins for 10 eve-coins'),
                          say('Diana, checkup please — 3 coins')|Narr?]) :-
    ground(ReqId?) |
    frank_p12_wait_trade_pay(In?, Out, Narr).
frank_p12_wait_trade_eve([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_trade_eve(In?, Out, Narr).
frank_p12_wait_trade_eve([], [], []).

%% Act 3b: Frank pays Diana for medical checkup
procedure frank_p12_wait_trade_pay(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_trade_pay([trade_completed(diana)|In], Out?,
                         [act('Paid Diana 3 for checkup')|Narr?]) :-
    frank_p12_wait_escrow_received(In?, Out, Narr).
frank_p12_wait_trade_pay([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_trade_pay(In?, Out, Narr).
frank_p12_wait_trade_pay([], [], []).

%% Act 5: Receive escrow from Charlie (dock work)
procedure frank_p12_wait_escrow_received(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_escrow_received([escrow_received(charlie, _)|In], Out?,
                               [event('Escrow from Charlie: 5 frank-coins, release day 15')|Narr?]) :-
    frank_p12_wait_escrow_released(In?, Out, Narr).
frank_p12_wait_escrow_received([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_escrow_received(In?, Out, Narr).
frank_p12_wait_escrow_received([], [], []).

%% Dock done, escrow released — send first unit redemption
procedure frank_p12_wait_escrow_released(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_escrow_released([escrow_released(charlie)|In],
                               [trade(diana, [lot(diana, 0, 1)], [lot(frank, 28, 1)])|Out?],
                               [event('Escrow released — received 5 frank-coins for dock'),
                                say('Diana, Id like to redeem 5 of your coins')|Narr?]) :-
    frank_p12_wait_redeem1(In?, Out, Narr).
frank_p12_wait_escrow_released([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_escrow_released(In?, Out, Narr).
frank_p12_wait_escrow_released([], [], []).

%% Act 6: Redeem diana-coins — 5 sequential unit trades
procedure frank_p12_wait_redeem1(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_redeem1([trade_completed(diana)|In],
                       [trade(diana, [lot(diana, 0, 1)], [lot(frank, 28, 1)])|Out?], Narr?) :-
    frank_p12_wait_redeem2(In?, Out, Narr).
frank_p12_wait_redeem1([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_redeem1(In?, Out, Narr).
frank_p12_wait_redeem1([], [], []).

procedure frank_p12_wait_redeem2(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_redeem2([trade_completed(diana)|In],
                       [trade(diana, [lot(diana, 0, 1)], [lot(frank, 28, 1)])|Out?], Narr?) :-
    frank_p12_wait_redeem3(In?, Out, Narr).
frank_p12_wait_redeem2([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_redeem2(In?, Out, Narr).
frank_p12_wait_redeem2([], [], []).

procedure frank_p12_wait_redeem3(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_redeem3([trade_completed(diana)|In],
                       [trade(diana, [lot(diana, 0, 1)], [lot(frank, 28, 1)])|Out?], Narr?) :-
    frank_p12_wait_redeem4(In?, Out, Narr).
frank_p12_wait_redeem3([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_redeem3(In?, Out, Narr).
frank_p12_wait_redeem3([], [], []).

procedure frank_p12_wait_redeem4(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_redeem4([trade_completed(diana)|In],
                       [trade(diana, [lot(diana, 0, 1)], [lot(frank, 28, 1)])|Out?], Narr?) :-
    frank_p12_wait_redeem5(In?, Out, Narr).
frank_p12_wait_redeem4([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_redeem4(In?, Out, Narr).
frank_p12_wait_redeem4([], [], []).

procedure frank_p12_wait_redeem5(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_redeem5([trade_completed(diana)|In], [balance|Out?],
                       [act('Redeemed 5 diana-coins from Diana')|Narr?]) :-
    frank_p12_wait_balance(In?, Out, Narr).
frank_p12_wait_redeem5([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_redeem5(In?, Out, Narr).
frank_p12_wait_redeem5([], [], []).

procedure frank_p12_wait_balance(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_wait_balance([balance_report(_)|In], [done|Out?],
                       [act('Balance: 7 diana-coins, 10 eve-coins')|Narr?]) :-
    frank_p12_finish(In?, Out, Narr).
frank_p12_wait_balance([_|In], Out?, Narr?) :-
    otherwise | frank_p12_wait_balance(In?, Out, Narr).
frank_p12_wait_balance([], [], []).

procedure frank_p12_finish(Stream(PersonNotify)?, Stream(PersonCmd), Stream(NarrativeItem)).
frank_p12_finish(_, [], []).
