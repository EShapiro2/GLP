procedure alice_p10_wait_minted(Constant?, Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p10_wait_minted(T, [minted(5, 0)|In],
                      [trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)])|Out?]) :-
