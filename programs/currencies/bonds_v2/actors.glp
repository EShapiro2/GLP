procedure bob_p3_wait_balance(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p3_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p3_finish(In?, Out).
bob_p3_wait_balance([_|In], Out?) :-
    otherwise | bob_p3_wait_balance(In?, Out).
bob_p3_wait_balance([], []).

procedure bob_p3_finish(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p3_finish(_, []).

%% =============================================================================
%% PLAY 4 — Credit + redemption (via mint+trade+trade)
%% =============================================================================

exported procedure alice_p4(ActorChannel?).
alice_p4(ch(In, [connect(bob)|Out?])) :-
    alice_p4_wait_connected(In?, Out).

procedure alice_p4_wait_connected(Stream(PersonNotify)?, Stream(PersonCmd)).
