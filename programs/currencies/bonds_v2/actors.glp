bob_p4_wait_trade1([_|In], Out?) :-
    otherwise | bob_p4_wait_trade1(In?, Out).
bob_p4_wait_trade1([], []).

procedure bob_p4_wait_trade2(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p4_wait_trade2([trade_completed(alice)|In], Out?) :-
    bob_p4_wait_trade3(In?, Out).
bob_p4_wait_trade2([_|In], Out?) :-
    otherwise | bob_p4_wait_trade2(In?, Out).
bob_p4_wait_trade2([], []).

