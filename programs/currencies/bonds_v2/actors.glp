bob_p3_wait_minted(_, [], []).

procedure bob_p3_wait_trade1(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p3_wait_trade1([trade_completed(alice)|In], Out?) :-
    bob_p3_wait_trade2(In?, Out).
bob_p3_wait_trade1([_|In], Out?) :-
