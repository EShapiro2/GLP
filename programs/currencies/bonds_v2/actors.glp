procedure bob_p3_wait_minted(ReqId?, Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p3_wait_minted(ReqId, [minted(3, 0)|In],
                   [accept_trade(alice, ReqId?)|Out?]) :-
