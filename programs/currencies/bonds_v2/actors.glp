%% Once deposited, Alice advances her own date to the release date: the escrow
%% reads that date and releases on it.  There is no wall clock to wait for.
procedure alice_p10_wait_deposited(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p10_wait_deposited([escrow_deposited(bob, T, _)|In], [advance_date(T?)|Out?]) :-
