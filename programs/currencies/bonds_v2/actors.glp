%% actors.glp — Bonds V2 scripted actors for play testing
%%
%% Phase 1: alice_p1 — solo mint + balance
%% Phase 2: alice_p2, bob_p2 — befriend + symmetric credit (mint+trade)
%% Phase 3: alice_p3, bob_p3 — credit + payment (mint+trade+trade)
%% Phase 4: alice_p4, bob_p4 — credit + redemption (mint+trade+trade)
%% Phase 4b: alice_p4b, bob_p4b — time-dependent redemption (mint+trade)
%% Phase 5: alice_p5, bob_p5 — zero-coupon loan (mint+trade)
%% Phase 6: alice_p6, bob_p6 — balloon loan (mint+trade)
%% Phase 8: alice_p8, bob_p8 — credit + sale of debt (mint+trade+trade)
%% Phase 9: alice_p9, bob_p9 — forward contract (mint+trade)
%% Phase 10: alice_p10, bob_p10 — credit + escrow time-release (mint+trade+escrow)
%% Phase 11: alice_p11, bob_p11 — credit + escrow cancel (mint+trade+escrow)


%% =============================================================================
%% PLAY 1 — Solo mint + balance
%% =============================================================================

exported procedure alice_p1(ActorChannel?).
alice_p1(ch(In, [mint(3, 0)|Out?])) :-
    alice_p1_wait_minted1(In?, Out).

procedure alice_p1_wait_minted1(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p1_wait_minted1([minted(3, 0)|In], [mint(2, 10)|Out?]) :-
    alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted1([_|In], Out?) :-
    otherwise | alice_p1_wait_minted1(In?, Out).
alice_p1_wait_minted1([], []).

procedure alice_p1_wait_minted2(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p1_wait_minted2([minted(2, 10)|In], [balance|Out?]) :-
    alice_p1_wait_balance(In?, Out).
alice_p1_wait_minted2([_|In], Out?) :-
    otherwise | alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted2([], []).

procedure alice_p1_wait_balance(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p1_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p1_finish(In?, Out).
alice_p1_wait_balance([_|In], Out?) :-
    otherwise | alice_p1_wait_balance(In?, Out).
alice_p1_wait_balance([], []).

procedure alice_p1_finish(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p1_finish(_, []).

%% =============================================================================
%% PLAY 2 — Alice cold-calls Bob, then symmetric credit via mint+trade
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(3, 0) → wait minted(3, 0)
%% 3. trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)]) → wait trade_completed(bob)
%% 4. balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait trade_proposed(alice, _, ReqId2) → mint(3, 0) → wait minted(3, 0)
%%    → accept_trade(alice, ReqId2) → wait trade_completed(alice)
%% 4. balance → wait balance_report(_) → done

exported procedure alice_p2(ActorChannel?).
alice_p2(ch(In, [connect(bob)|Out?])) :-
    alice_p2_wait_connected(In?, Out).

procedure alice_p2_wait_connected(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p2_wait_connected([connected(bob)|In], [mint(3, 0)|Out?]) :-
    alice_p2_wait_minted(In?, Out).
alice_p2_wait_connected([_|In], Out?) :-
    otherwise | alice_p2_wait_connected(In?, Out).
alice_p2_wait_connected([], []).

procedure alice_p2_wait_minted(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p2_wait_minted([minted(3, 0)|In],
                     [trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)])|Out?]) :-
    alice_p2_wait_trade(In?, Out).
alice_p2_wait_minted([_|In], Out?) :-
    otherwise | alice_p2_wait_minted(In?, Out).
alice_p2_wait_minted([], []).

procedure alice_p2_wait_trade(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p2_wait_trade([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p2_wait_balance(In?, Out).
alice_p2_wait_trade([_|In], Out?) :-
    otherwise | alice_p2_wait_trade(In?, Out).
alice_p2_wait_trade([], []).

procedure alice_p2_wait_balance(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p2_finish(In?, Out).
alice_p2_wait_balance([_|In], Out?) :-
    otherwise | alice_p2_wait_balance(In?, Out).
alice_p2_wait_balance([], []).

procedure alice_p2_finish(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p2_finish(_, []).

%% --- Bob (play2) ---

exported procedure bob_p2(ActorChannel?).
bob_p2(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p2_wait_connected(In?, Out).
bob_p2(ch([_|In], Out?)) :-
    otherwise | bob_p2(ch(In?, Out)).
bob_p2(ch([], [])).

procedure bob_p2_wait_connected(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p2_wait_connected([connected(alice)|In], Out?) :-
    bob_p2_wait_trade_proposed(In?, Out).
bob_p2_wait_connected([_|In], Out?) :-
    otherwise | bob_p2_wait_connected(In?, Out).
bob_p2_wait_connected([], []).

procedure bob_p2_wait_trade_proposed(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p2_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                           [mint(3, 0)|Out?]) :-
    ground(ReqId?) |
    bob_p2_wait_minted(ReqId?, In?, Out).
bob_p2_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p2_wait_trade_proposed(In?, Out).
bob_p2_wait_trade_proposed([], []).

procedure bob_p2_wait_minted(ReqId?, Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p2_wait_minted(ReqId, [minted(3, 0)|In],
                   [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p2_wait_trade_completed(In?, Out).
bob_p2_wait_minted(ReqId, [_|In], Out?) :-
    otherwise | bob_p2_wait_minted(ReqId?, In?, Out).
bob_p2_wait_minted(_, [], []).

procedure bob_p2_wait_trade_completed(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p2_wait_trade_completed([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p2_wait_balance(In?, Out).
bob_p2_wait_trade_completed([_|In], Out?) :-
    otherwise | bob_p2_wait_trade_completed(In?, Out).
bob_p2_wait_trade_completed([], []).

procedure bob_p2_wait_balance(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p2_finish(In?, Out).
bob_p2_wait_balance([_|In], Out?) :-
    otherwise | bob_p2_wait_balance(In?, Out).
bob_p2_wait_balance([], []).

procedure bob_p2_finish(Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p2_finish(_, []).

%% =============================================================================
%% PLAY 3 — Credit + payment (via mint+trade+trade)
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(3, 0) → wait minted(3, 0)
%% 3. trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)]) → wait trade_completed(bob)
%% 4. trade(bob, [lot(bob, 0, 2)], []) → wait trade_completed(bob)
%% 5. balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait trade_proposed → mint(3, 0) → wait minted → accept_trade
%%    → wait trade_completed(alice)
%% 4. Wait trade_completed(alice) — payment auto-accepted
%% 5. balance → wait balance_report(_) → done

exported procedure alice_p3(ActorChannel?).
alice_p3(ch(In, [connect(bob)|Out?])) :-
    alice_p3_wait_connected(In?, Out).

procedure alice_p3_wait_connected(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p3_wait_connected([connected(bob)|In], [mint(3, 0)|Out?]) :-
    alice_p3_wait_minted(In?, Out).
alice_p3_wait_connected([_|In], Out?) :-
    otherwise | alice_p3_wait_connected(In?, Out).
alice_p3_wait_connected([], []).

procedure alice_p3_wait_minted(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p3_wait_minted([minted(3, 0)|In],
                     [trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)])|Out?]) :-
    alice_p3_wait_trade1(In?, Out).
alice_p3_wait_minted([_|In], Out?) :-
    otherwise | alice_p3_wait_minted(In?, Out).
alice_p3_wait_minted([], []).

procedure alice_p3_wait_trade1(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p3_wait_trade1([trade_completed(bob)|In],
                     [trade(bob, [lot(bob, 0, 2)], [])|Out?]) :-
    alice_p3_wait_trade2(In?, Out).
alice_p3_wait_trade1([_|In], Out?) :-
    otherwise | alice_p3_wait_trade1(In?, Out).
alice_p3_wait_trade1([], []).

procedure alice_p3_wait_trade2(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p3_wait_trade2([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p3_wait_balance(In?, Out).
alice_p3_wait_trade2([_|In], Out?) :-
    otherwise | alice_p3_wait_trade2(In?, Out).
alice_p3_wait_trade2([], []).

procedure alice_p3_wait_balance(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p3_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p3_finish(In?, Out).
alice_p3_wait_balance([_|In], Out?) :-
    otherwise | alice_p3_wait_balance(In?, Out).
alice_p3_wait_balance([], []).

procedure alice_p3_finish(Stream(PersonNotify)?, Stream(PersonCmd)).
alice_p3_finish(_, []).

