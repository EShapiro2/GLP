exported procedure bob_p4b(ActorChannel?, Constant?).
bob_p4b(ch([befriend(alice, ReqId)|In],
           [decision(yes, alice, ReqId?)|Out?]), T) :-
    ground(ReqId?) |
    bob_p4b_wait_connected(T?, In?, Out).
bob_p4b(ch([_|In], Out?), T) :-
    otherwise | bob_p4b(ch(In?, Out), T?).
bob_p4b(ch([], []), _).

procedure bob_p4b_wait_connected(Constant?, Stream(PersonNotify)?, Stream(PersonCmd)).
bob_p4b_wait_connected(T, [connected(alice)|In], Out?) :-
    bob_p4b_wait_trade_proposed1(T?, In?, Out).
bob_p4b_wait_connected(T, [_|In], Out?) :-
    otherwise | bob_p4b_wait_connected(T?, In?, Out).
bob_p4b_wait_connected(_, [], []).

