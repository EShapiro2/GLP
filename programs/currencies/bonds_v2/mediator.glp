%% mediator.glp — Bond UI mediator module (v2)
%%
%% Exports: ui_mediator/5
%% Types and lookup_pending: from self.glp (ancestor scoping)
%% Local: send, receive, new_channel (channel operations)
%%
%% v2 changes:
%%   - Types and lookup_pending moved to self.glp
%%   - Standalone stream types eliminated (use Stream(X))
%%   - Module structure with exported procedure


%% Channel operations (send/receive/new_channel/close) are provided canonically
%% by the root self.glp; local duplicates removed.

%% =============================================================================
%% UI MEDIATOR — Main loop
%% =============================================================================

exported procedure ui_mediator(Constant?, AgentChannel?, PersonChannel?, Stream(PendingEntry)?, Constant?).

%% --- Agent-to-person: Phase 1 ground pass-through ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, minted(K, Maturity)),
            AgentCh?, AgentCh1),
    ground(K?), ground(Maturity?) |
    send(minted(K?, Maturity?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, date_advanced(D)),
            AgentCh?, AgentCh1),
    ground(D?) |
    send(date_advanced(D?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, balance_report(Holdings)),
            AgentCh?, AgentCh1),
    ground(Holdings?) |
    send(balance_report(Holdings?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Agent-to-person: befriend (non-ground — store Response in pending) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), PersonCh?, PersonCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, PersonCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% --- Agent-to-person: connected (ground — pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(connected(Who?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, rejected),
            AgentCh?, AgentCh1) |
    send(rejected, PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(rejected(Who?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: Phase 1 pass-through ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(mint(K, Maturity), PersonCh?, PersonCh1),
    ground(Id?), ground(K?), ground(Maturity?) |
    send(msg(person, Id?, mint(K?, Maturity?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(balance, PersonCh?, PersonCh1),
    ground(Id?) |
    send(msg(person, Id?, balance),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(done, PersonCh?, PersonCh1),
    ground(Id?) |
    send(msg(person, Id?, done),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: connect (pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(connect(Target), PersonCh?, PersonCh1),
    ground(Id?), ground(Target?) |
    send(msg(person, Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: decision (with pending lookup) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(Dec?), ground(From?),
    ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, decision(Dec?, From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% --- Agent-to-person: trade_proposed (non-ground — store TradeResp + data in pending) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, trade_proposed(From, WantSpec, TradeResp?, OfferedBonds)),
            AgentCh?, AgentCh1),
    ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    send(trade_proposed(From?, WantSpec?, req(N?)), PersonCh?, PersonCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, PersonCh1?,
        [pending(req(N?), trade_pending(TradeResp, WantSpec?, OfferedBonds?)) | Ps?], N1?).

%% --- Agent-to-person: trade_completed (ground — pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, trade_completed(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_completed(Who?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Agent-to-person: trade_failed (ground — pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, trade_failed(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_failed(Who?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Agent-to-person: trade_returned (ground — pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, trade_returned(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_returned(Who?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Agent-to-person: trade_returned_menu (ground — pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, trade_returned_menu(From, Menu)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Menu?) |
    send(trade_returned_menu(From?, Menu?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: trade (pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(trade(Target, GiveSpec, WantSpec), PersonCh?, PersonCh1),
    ground(Id?), ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    send(msg(person, Id?, trade(Target?, GiveSpec?, WantSpec?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: redeem (pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(redeem(Target, GiveSpec, WantSpec), PersonCh?, PersonCh1),
    ground(Id?), ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    send(msg(person, Id?, redeem(Target?, GiveSpec?, WantSpec?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: advance_date (pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(advance_date(D), PersonCh?, PersonCh1),
    ground(Id?), ground(D?) |
    send(msg(person, Id?, advance_date(D?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: accept_trade (with pending lookup) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(accept_trade(From, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, accept_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% --- Person-to-agent: reject_trade (with pending lookup) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(reject_trade(From, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, reject_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% --- Agent-to-person: escrow_deposited (non-ground — store CancelSignal in pending) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, escrow_deposited(Target, ReleaseTime, CancelSignal?)),
            AgentCh?, AgentCh1),
    ground(Target?), ground(ReleaseTime?) |
    send(escrow_deposited(Target?, ReleaseTime?, req(N?)), PersonCh?, PersonCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, PersonCh1?,
        [pending(req(N?), escrow_pending(CancelSignal)) | Ps?], N1?).

%% --- Agent-to-person: escrow_received (ground — pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, escrow_received(From, ReleaseTime)),
            AgentCh?, AgentCh1),
    ground(From?), ground(ReleaseTime?) |
    send(escrow_received(From?, ReleaseTime?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Agent-to-person: escrow_released (ground — pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, escrow_released(From)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(escrow_released(From?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

