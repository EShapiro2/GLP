%% mad_fplay12.glp — madGLP boot for bonds fplay12 (6 isolates: alice, bob, charlie, diana, eve, frank)
%%
%% Derived from: bonds/boot.glp fplay12 clause
%% Bonds: Village Market Month (6 agents + narrative)
%% One isolate per agent. Charlie escrows until date 30 and advances his own date to it.
%% Each agent has its own init procedure to avoid SRSW on Narr.


procedure boot.
boot :-
    alice_init(alice, _)@alice,
    bob_init(bob, _)@bob,
    charlie_init(charlie, _)@charlie,
    diana_init(diana, _)@diana,
    eve_init(eve, _)@eve,
    frank_init(frank, _)@frank.

%% Alice — alice_p12(0, Ch, Narr), 0 is dummy constant (T unused)
procedure alice_init(Constant?, Stream(_)?).
alice_init(Id, NetIn) :-
    ground(Id?) |
    alice_p12(0, ch(ActorIn?, ActorOut), Narr),
    send_to_person_narrate(Id?, Narr?),
    tee(ActorOut?, MedIn, DispCmd),
    agent(Id?, AgentIn?, NetIn?,
          [user_output(AgentToPerson), net_output(NetOut)],
          [], 1, 0),
    send_to_net(NetOut?),
    ui_mediator(Id?, ch(AgentToPerson?, AgentIn),
                ch(MedIn?, MedOut), [], 1),
    tee(MedOut?, ActorIn, DispNotify),
    send_to_person_tagged(Id?, DispCmd?, DispNotify?).

%% Bob — bob_p12(Ch, Narr)
procedure bob_init(Constant?, Stream(_)?).
bob_init(Id, NetIn) :-
    ground(Id?) |
    bob_p12(ch(ActorIn?, ActorOut), Narr),
    send_to_person_narrate(Id?, Narr?),
    tee(ActorOut?, MedIn, DispCmd),
    agent(Id?, AgentIn?, NetIn?,
          [user_output(AgentToPerson), net_output(NetOut)],
          [], 1, 0),
    send_to_net(NetOut?),
    ui_mediator(Id?, ch(AgentToPerson?, AgentIn),
                ch(MedIn?, MedOut), [], 1),
    tee(MedOut?, ActorIn, DispNotify),
    send_to_person_tagged(Id?, DispCmd?, DispNotify?).

%% Charlie — charlie_p12(T, Ch, Narr), T = 30, the escrow release date
procedure charlie_init(Constant?, Stream(_)?).
charlie_init(Id, NetIn) :-
    ground(Id?) |
    T := 30,
    charlie_p12(T?, ch(ActorIn?, ActorOut), Narr),
    send_to_person_narrate(Id?, Narr?),
    tee(ActorOut?, MedIn, DispCmd),
    agent(Id?, AgentIn?, NetIn?,
          [user_output(AgentToPerson), net_output(NetOut)],
          [], 1, 0),
    send_to_net(NetOut?),
    ui_mediator(Id?, ch(AgentToPerson?, AgentIn),
                ch(MedIn?, MedOut), [], 1),
    tee(MedOut?, ActorIn, DispNotify),
    send_to_person_tagged(Id?, DispCmd?, DispNotify?).

