procedure tee(Stream(_)?, Stream(_), Stream(_)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

procedure send_to_person_tagged(Constant?, Stream(_)?, Stream(_)?).
send_to_person_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, cmd(T?))]),
    send_to_person_tagged(Id?, Cmds?, Notifies?).
send_to_person_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, notify(T?))]),
    send_to_person_tagged(Id?, Cmds?, Notifies?).
send_to_person_tagged(_, [], []).
send_to_person_tagged(_, Cmds, []) :- sink(Cmds?).

procedure send_to_person_narrate(Constant?, Stream(_)?).
send_to_person_narrate(Id, [friend(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, friend(X?))]),
    send_to_person_narrate(Id?, Ns?).
send_to_person_narrate(Id, [say(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, say(X?))]),
    send_to_person_narrate(Id?, Ns?).
send_to_person_narrate(Id, [act(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, act(X?))]),
    send_to_person_narrate(Id?, Ns?).
send_to_person_narrate(Id, [event(X)|Ns]) :-
    ground(Id?), ground(X?) |
    send_to_user([tagged(Id?, event(X?))]),
    send_to_person_narrate(Id?, Ns?).
send_to_person_narrate(_, []).

procedure sink(Stream(_)?).
sink([_|Xs]) :- sink(Xs?).
sink([]).
