bob_p4_wait_balance([], []).

procedure bob_p4_finish(Stream(UserNotify)?, Stream(UserCmd)).
bob_p4_finish(_, []).

%% =============================================================================
%% PLAY 4b — Time-dependent: coin credit + bond credit (via mint+trade)
%% =============================================================================

exported procedure alice_p4b(ActorChannel?, Constant?).
alice_p4b(ch(In, [connect(bob)|Out?]), T) :-
    alice_p4b_wait_connected(T?, In?, Out).

procedure alice_p4b_wait_connected(Constant?, Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_connected(T, [connected(bob)|In], [mint(5, 0)|Out?]) :-
    alice_p4b_wait_minted1(T?, In?, Out).
alice_p4b_wait_connected(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_connected(T?, In?, Out).
alice_p4b_wait_connected(_, [], []).

procedure alice_p4b_wait_minted1(Constant?, Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_minted1(T, [minted(5, 0)|In],
                       [trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)])|Out?]) :-
    alice_p4b_wait_trade1(T?, In?, Out).
alice_p4b_wait_minted1(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_minted1(T?, In?, Out).
alice_p4b_wait_minted1(_, [], []).

procedure alice_p4b_wait_trade1(Constant?, Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_trade1(T, [trade_completed(bob)|In], [mint(5, T?)|Out?]) :-
    alice_p4b_wait_minted2(T?, In?, Out).
alice_p4b_wait_trade1(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_trade1(T?, In?, Out).
alice_p4b_wait_trade1(_, [], []).

procedure alice_p4b_wait_minted2(Constant?, Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_minted2(T, [minted(5, _)|In],
                       [trade(bob, [lot(alice, T?, 5)], [lot(bob, T?, 5)])|Out?]) :-
    alice_p4b_wait_trade2(T?, In?, Out).
alice_p4b_wait_minted2(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_minted2(T?, In?, Out).
alice_p4b_wait_minted2(_, [], []).

procedure alice_p4b_wait_trade2(Constant?, Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_trade2(T, [trade_completed(bob)|In],
                      [trade(bob, [lot(bob, 0, 1)], [lot(alice, T?, 1)])|Out?]) :-
    alice_p4b_wait_trade3(T?, In?, Out).
alice_p4b_wait_trade2(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_trade2(T?, In?, Out).
alice_p4b_wait_trade2(_, [], []).

procedure alice_p4b_wait_trade3(Constant?, Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_trade3(T, [trade_completed(bob)|In],
                      [trade(bob, [lot(bob, 0, 1)], [lot(alice, T?, 1)])|Out?]) :-
    alice_p4b_wait_trade4(In?, Out).
alice_p4b_wait_trade3(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_trade3(T?, In?, Out).
alice_p4b_wait_trade3(_, [], []).

procedure alice_p4b_wait_trade4(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_trade4([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4b_wait_balance1(In?, Out).
alice_p4b_wait_trade4([_|In], Out?) :-
    otherwise | alice_p4b_wait_trade4(In?, Out).
alice_p4b_wait_trade4([], []).

%% Wait for balance report, then wait 500ms, then trade again (post-maturity)
procedure alice_p4b_wait_balance1(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_balance1([balance_report(_)|In],
                        [trade(bob, [lot(bob, 0, 1)], [lot(alice, 0, 1)])|Out?]) :-
    wait(500) |
    alice_p4b_wait_trade5(In?, Out).
alice_p4b_wait_balance1([_|In], Out?) :-
    otherwise | alice_p4b_wait_balance1(In?, Out).
alice_p4b_wait_balance1([], []).

procedure alice_p4b_wait_trade5(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_trade5([trade_completed(bob)|In],
                      [trade(bob, [lot(bob, 0, 1)], [lot(alice, 0, 1)])|Out?]) :-
    alice_p4b_wait_trade6(In?, Out).
alice_p4b_wait_trade5([_|In], Out?) :-
    otherwise | alice_p4b_wait_trade5(In?, Out).
alice_p4b_wait_trade5([], []).

procedure alice_p4b_wait_trade6(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4b_wait_trade6([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4b_wait_balance2(In?, Out).
alice_p4b_wait_trade6([_|In], Out?) :-
    otherwise | alice_p4b_wait_trade6(In?, Out).
alice_p4b_wait_trade6([], []).

