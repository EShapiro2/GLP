alice_p4_wait_trade2([_|In], Out?) :-
    otherwise | alice_p4_wait_trade2(In?, Out).
alice_p4_wait_trade2([], []).

procedure alice_p4_wait_trade3(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4_wait_trade3([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4_wait_balance(In?, Out).
alice_p4_wait_trade3([_|In], Out?) :-
    otherwise | alice_p4_wait_trade3(In?, Out).
