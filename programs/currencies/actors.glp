procedure alice_p4_wait_balance(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p4_finish(In?, Out).
alice_p4_wait_balance([_|In], Out?) :-
    otherwise | alice_p4_wait_balance(In?, Out).
alice_p4_wait_balance([], []).

procedure alice_p4_finish(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4_finish(_, []).

%% --- Bob (play4) ---

exported procedure bob_p4(ActorChannel?).
bob_p4(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p4_wait_connected(In?, Out).
bob_p4(ch([_|In], Out?)) :-
    otherwise | bob_p4(ch(In?, Out)).
bob_p4(ch([], [])).

procedure bob_p4_wait_connected(Stream(UserNotify)?, Stream(UserCmd)).
bob_p4_wait_connected([connected(alice)|In], Out?) :-
    bob_p4_wait_trade_proposed(In?, Out).
