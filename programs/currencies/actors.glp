procedure bob_p3_wait_minted(ReqId?, Stream(UserNotify)?, Stream(UserCmd)).
bob_p3_wait_minted(ReqId, [minted(3, 0)|In],
                   [accept_trade(alice, ReqId?)|Out?]) :-
