procedure alice_p4_wait_trade1(Stream(UserNotify)?, Stream(UserCmd)).
alice_p4_wait_trade1([trade_completed(bob)|In],
                     [trade(bob, [lot(bob, 0, 1)], [lot(alice, 0, 1)])|Out?]) :-
