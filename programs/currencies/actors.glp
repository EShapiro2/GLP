%% =============================================================================
%% Play 13: alice_p13, bob_p13 — loan then maturity-gated redemption
%% =============================================================================
%%
%% Alice (lender): connect; mint 3 coins (maturity 0); propose the loan swap
%% (give 3 alice-coins, want 5 bob-bonds maturing at date 10 — face 5 > 3 lent
%% is the interest); try to redeem 3 of the bob-bonds BEFORE advancing (refused
%% by her own local-clock gate); advance her local date past maturity; redeem;
%% report balance.
%% Bob (borrower): accept the cold call; on the loan proposal mint 5 bonds
%% maturing at 10 and accept the swap; his agent then auto-honours Alice's
%% redemption (the issuer must fulfil); report balance.

%% --- Alice (play13) — lender ---

exported procedure alice_p13(ActorChannel?).
alice_p13(ch(In, [connect(bob)|Out?])) :-
    alice_p13_wait_connected(In?, Out).

procedure alice_p13_wait_connected(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_wait_connected([connected(bob)|In], [mint(3, 0)|Out?]) :-
    alice_p13_wait_minted(In?, Out).
alice_p13_wait_connected([_|In], Out?) :-
    otherwise | alice_p13_wait_connected(In?, Out).
alice_p13_wait_connected([], []).

procedure alice_p13_wait_minted(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_wait_minted([minted(3, 0)|In],
                      [trade(bob, [lot(alice, 0, 3)], [lot(bob, 10, 5)])|Out?]) :-
    alice_p13_wait_loan(In?, Out).
alice_p13_wait_minted([_|In], Out?) :-
    otherwise | alice_p13_wait_minted(In?, Out).
alice_p13_wait_minted([], []).

%% Loan swap done — attempt to redeem BEFORE advancing our clock; the bob-bonds
%% mature at 10 but our local date is still 0, so our own gate refuses it.
procedure alice_p13_wait_loan(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_wait_loan([trade_completed(bob)|In],
                    [redeem(bob, [lot(bob, 10, 3)], [lot(alice, 0, 3)])|Out?]) :-
    alice_p13_wait_early_redeem(In?, Out).
alice_p13_wait_loan([_|In], Out?) :-
    otherwise | alice_p13_wait_loan(In?, Out).
alice_p13_wait_loan([], []).

%% Early redeem refused (trade_failed) — advance our local date past maturity.
procedure alice_p13_wait_early_redeem(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_wait_early_redeem([trade_failed(bob)|In], [advance_date(11)|Out?]) :-
    alice_p13_wait_advanced(In?, Out).
alice_p13_wait_early_redeem([_|In], Out?) :-
    otherwise | alice_p13_wait_early_redeem(In?, Out).
alice_p13_wait_early_redeem([], []).

%% Date advanced past maturity — redeem the now-mature bob-bonds (set-off:
%% take back our own coins).
procedure alice_p13_wait_advanced(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_wait_advanced([date_advanced(11)|In],
                        [redeem(bob, [lot(bob, 10, 3)], [lot(alice, 0, 3)])|Out?]) :-
    alice_p13_wait_redeemed(In?, Out).
alice_p13_wait_advanced([_|In], Out?) :-
    otherwise | alice_p13_wait_advanced(In?, Out).
alice_p13_wait_advanced([], []).

procedure alice_p13_wait_redeemed(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_wait_redeemed([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p13_wait_balance(In?, Out).
alice_p13_wait_redeemed([_|In], Out?) :-
    otherwise | alice_p13_wait_redeemed(In?, Out).
alice_p13_wait_redeemed([], []).

procedure alice_p13_wait_balance(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p13_finish(In?, Out).
alice_p13_wait_balance([_|In], Out?) :-
    otherwise | alice_p13_wait_balance(In?, Out).
alice_p13_wait_balance([], []).

procedure alice_p13_finish(Stream(UserNotify)?, Stream(UserCmd)).
alice_p13_finish(_, []).

%% --- Bob (play13) — borrower ---

exported procedure bob_p13(ActorChannel?).
bob_p13(ch([befriend(alice, ReqId)|In],
           [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p13_wait_connected(In?, Out).
bob_p13(ch([_|In], Out?)) :-
    otherwise | bob_p13(ch(In?, Out)).
bob_p13(ch([], [])).

procedure bob_p13_wait_connected(Stream(UserNotify)?, Stream(UserCmd)).
bob_p13_wait_connected([connected(alice)|In], Out?) :-
    bob_p13_wait_trade_proposed(In?, Out).
bob_p13_wait_connected([_|In], Out?) :-
    otherwise | bob_p13_wait_connected(In?, Out).
bob_p13_wait_connected([], []).

%% Loan proposed — mint the bonds to lend (face 5, maturity 10), then accept.
procedure bob_p13_wait_trade_proposed(Stream(UserNotify)?, Stream(UserCmd)).
bob_p13_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                            [mint(5, 10)|Out?]) :-
    ground(ReqId?) |
    bob_p13_wait_minted(ReqId?, In?, Out).
bob_p13_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p13_wait_trade_proposed(In?, Out).
bob_p13_wait_trade_proposed([], []).

procedure bob_p13_wait_minted(ReqId?, Stream(UserNotify)?, Stream(UserCmd)).
bob_p13_wait_minted(ReqId, [minted(5, 10)|In],
                    [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p13_wait_loan(In?, Out).
bob_p13_wait_minted(ReqId, [_|In], Out?) :-
    otherwise | bob_p13_wait_minted(ReqId?, In?, Out).
bob_p13_wait_minted(_, [], []).

%% Swap completed (we now hold alice-coins).  Wait for Alice's redemption, which
%% our agent auto-honours; observe its completion, then report.
procedure bob_p13_wait_loan(Stream(UserNotify)?, Stream(UserCmd)).
bob_p13_wait_loan([trade_completed(alice)|In], Out?) :-
    bob_p13_wait_redeemed(In?, Out).
bob_p13_wait_loan([_|In], Out?) :-
    otherwise | bob_p13_wait_loan(In?, Out).
bob_p13_wait_loan([], []).

procedure bob_p13_wait_redeemed(Stream(UserNotify)?, Stream(UserCmd)).
bob_p13_wait_redeemed([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p13_wait_balance(In?, Out).
bob_p13_wait_redeemed([_|In], Out?) :-
    otherwise | bob_p13_wait_redeemed(In?, Out).
bob_p13_wait_redeemed([], []).

procedure bob_p13_wait_balance(Stream(UserNotify)?, Stream(UserCmd)).
bob_p13_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p13_finish(In?, Out).
bob_p13_wait_balance([_|In], Out?) :-
    otherwise | bob_p13_wait_balance(In?, Out).
bob_p13_wait_balance([], []).

procedure bob_p13_finish(Stream(UserNotify)?, Stream(UserCmd)).
bob_p13_finish(_, []).
