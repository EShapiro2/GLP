%% options.glp --- the option of Appendix C of "Grassroots Bonds", item 3, with
%% a strike price, in both of its outcomes: exercised and expired.
%%
%% A call option: the holder p acquires the right, but not the obligation, to
%% buy the underlying y from the writer q at or before expiry.  Three deposits
%% at establishment --- p's premium, p's strike price, and q's underlying ---
%% and then one of two outcomes:
%%
%%   exercised   the escrow agent releases the underlying to p, and the premium
%%               and the strike to q
%%   expired     the escrow agent returns the underlying to q, transfers the
%%               premium to q, and returns the strike to p
%%
%% Alice is the holder, Bob the writer.  The premium is 2 alice-coins, the
%% strike 8, and the underlying 10 bob-bonds maturing day 40.
%%
%% option_exercised/0 is AMERICAN exercise, the window [0, d]: Alice exercises
%% while the escrow agent's date is still inside it.  option_expired/0 is
%% EUROPEAN, the window [d, d2] with d2 = 40: Alice does not exercise, the
%% escrow agent's date passes 40, and it unwinds the agreement.  A window is
%% needed, as the paper says, because Advance-date is unguarded and may raise
%% the agent's date past d without ever equalling it.
%%
%% WHERE EACH CONDITION COMES FROM (Udi, 2026-09-15).  The escrow agent judges
%% from what it sees.  Expiry it sees: its own date, which it advances and
%% which its screen reports, so the expiry run turns on `advance(41)`.  The
%% exercise it does not: p's signal is not an act of the contract and reaches
%% the agent outside it, as the payment of a fiat coin does, so the exercise
%% enters the program from the escrow agent's person.  That is the
%% specification, not a stopgap.
%%
%% Entry points: option_exercised/0 and option_expired/0, exported by self.glp.

imported procedure village#villager(Constant?, Script?, Stream(NetInMsg)?, Stream(NetOutMsg)).

exported procedure option_exercised.
option_exercised :-
    network3o(AOut?, BOut?, GOut?, AIn, BIn, GIn),
    village # villager(alice,
        [mint(10, 0), deposit(escrow, alice, 0, 2), deposit(escrow, alice, 0, 8),
         accept_transfer(escrow)],
        AIn?, AOut),
    village # villager(bob,
        [mint(10, 40), deposit(escrow, bob, 40, 10),
         accept_transfer(escrow), accept_transfer(escrow)],
        BIn?, BOut),
    village # villager(escrow,
        [accept_transfer(alice), accept_transfer(alice), accept_transfer(bob),
         release(alice, bob, 40, 10),
         release(bob, alice, 0, 2),
         release(bob, alice, 0, 8)],
        GIn?, GOut).

exported procedure option_expired.
option_expired :-
    network3o(AOut?, BOut?, GOut?, AIn, BIn, GIn),
    village # villager(alice,
        [mint(10, 0), deposit(escrow, alice, 0, 2), deposit(escrow, alice, 0, 8),
         accept_transfer(escrow)],
        AIn?, AOut),
    village # villager(bob,
        [mint(10, 40), deposit(escrow, bob, 40, 10),
         accept_transfer(escrow), accept_transfer(escrow)],
        BIn?, BOut),
    village # villager(escrow,
        [accept_transfer(alice), accept_transfer(alice), accept_transfer(bob),
         advance(41),
         return(bob, bob, 40, 10),
         release(bob, alice, 0, 2),
         return(alice, alice, 0, 8)],
        GIn?, GOut).

%% --- The network: first contacts, routed by addressee ---

procedure route3o(Stream(NetOutMsg)?, Stream(NetInMsg), Stream(NetInMsg), Stream(NetInMsg)).
route3o([msg(alice, C)|Rest], [msg(alice, C?)|A?], B?, G?) :- route3o(Rest?, A, B, G).
route3o([msg(bob, C)|Rest], A?, [msg(bob, C?)|B?], G?) :- route3o(Rest?, A, B, G).
route3o([msg(escrow, C)|Rest], A?, B?, [msg(escrow, C?)|G?]) :- route3o(Rest?, A, B, G).
route3o([], [], [], []).

procedure network3o(Stream(NetOutMsg)?, Stream(NetOutMsg)?, Stream(NetOutMsg)?, Stream(NetInMsg), Stream(NetInMsg), Stream(NetInMsg)).
network3o(AOut, BOut, GOut, AIn?, BIn?, GIn?) :-
    merge(AOut?, BOut?, AB),
    merge(AB?, GOut?, All),
    route3o(All?, AIn, BIn, GIn).
