Question ::= swapCard_w(SwapCard) ; transferCard_w(TransferCard) ; stream_request_r(Stream(Request)?).

procedure respond_swap(SwapOffer?, SwapResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_swap(S1, S2?, S3?, [ask('SwapCard', swapCard_w(X?)) | D?]) :- respond_swap1(S1?, S2, S3, X, D).

procedure respond_swap1(SwapOffer?, SwapResponse, Stream(UserInMsg), SwapCard, Stream(Ask(Question))).
respond_swap1(offer(From, Want, Offered), Resp?, Ans?, card(offer(From?, Want?, Offered?), Answer), []) :- ground(From?), ground(Want?), ground(Offered?) | decide_swap(Answer?, From?, Want?, Offered?, Resp, Ans).

procedure decide_swap(YesNo?, Key?, Lot?, Stream(Instrument)?, SwapResponse, Stream(UserInMsg)).
decide_swap(yes, From, Want, Offered, Resp?, Ans?) :- accept_answer(From?, Want?, Offered?, Resp, Ans).
decide_swap(no, From, _, Offered, Resp?, Ans?) :- decline_answer(From?, Offered?, Resp, Ans).

procedure respond_transfer(TransferOffer?, TransferResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_transfer(S1, S2?, S3?, [ask('TransferCard', transferCard_w(X?)) | D?]) :- respond_transfer1(S1?, S2, S3, X, D).

procedure respond_transfer1(TransferOffer?, TransferResponse, Stream(UserInMsg), TransferCard, Stream(Ask(Question))).
respond_transfer1(offer_transfer(Kind, From, Terms, Given), Resp?, Ans?, card(offer_transfer(Kind?, From?, Terms?, Given?), Answer), []) :- ground(Kind?), ground(From?), ground(Terms?), ground(Given?) | decide_transfer(Answer?, Kind?, From?, Terms?, Given?, Resp, Ans).

procedure decide_transfer(YesNo?, Kind?, Key?, Terms?, Stream(Instrument)?, TransferResponse, Stream(UserInMsg)).
decide_transfer(yes, Kind, From, Terms, Given, Resp?, Ans?) :- accept_transfer_answer(Kind?, From?, Terms?, Given?, Resp, Ans).
decide_transfer(no, Kind, From, _, Given, Resp?, Ans?) :- decline_transfer_answer(Kind?, From?, Given?, Resp, Ans).

exported procedure agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
agent(S1, S2, S3, S4, S5, S6, S7, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- agent1(S1?, S2?, S3?, S4?, S5?, S6?, S7?, X?, D).

exported procedure agent1(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Request)?, Stream(Ask(Question))).
agent1(Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, Reqs, D?) :- serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).

procedure serve(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
serve(Reqs, Id, UserIn, [msg(From, Id1, Act) | PeerIn], Convs, Outs, Holdings, Serial, D?) :- (Id? =?= Id1?), ground(From?) | on_act(Act?, From?, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve(Reqs, Id, UserIn, [_ | PeerIn], Convs, Outs, Holdings, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve(Reqs, Id, UserIn, PeerIn, [conversation(Q, Ch) | Convs], Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?) | adopt(Q?, Ch?, Outs?, Outs1, PeerIn?, PeerIn1), show(opened(Q?), Outs1?, Outs2), serve(Reqs?, Id?, UserIn?, PeerIn1?, Convs?, Outs2?, Holdings?, Serial?, D).
serve(Reqs, Id, [accept_swap(From, lot(V, D1, K1), Offered, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(From?), ground(V?), ground(D1?), integer(K1?) | select_instruments(V?, D1?, K1?, Holdings?, Status, Give, Rest), fill_swap(Status?, Id?, From?, Resp, Give?, Offered?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve(Reqs, Id, [decline_swap(From, Offered, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(From?) | decline(Resp, Offered?), show(declined(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).
serve(Reqs, Id, [swap_accepted(Q, Given) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Given?) | append_instruments(Holdings?, Given?, Holdings1), show(swap_done(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [swap_declined_by(Q, Given) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Given?) | append_instruments(Holdings?, Given?, Holdings1), show(swap_declined(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [pay_taken_by(Q, K) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), integer(K?) | show(paid(Q?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).
serve(Reqs, Id, [pay_returned_by(Q, Coins) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coins?) | append_instruments(Holdings?, Coins?, Holdings1), count_instruments(Coins?, 0, K), show(not_accepted(Q?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_given(Q, D, R, D1, X) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D2?) :- ground(Id?), ground(Q?), ground(D?), ground(R?), ground(D1?), ground(X?) | append_instruments(Holdings?, [X?], Holdings1), show(redeemed(Q?, D?, R?, D1?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D2).
serve(Reqs, Id, [redeem_menu_from(Q, X, Menu) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(X?), ground(Menu?) | append_instruments(Holdings?, [X?], Holdings1), show(menu(Q?, Menu?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_not_mature_by(Q, bond(I, M, S)) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(I?), integer(M?), integer(S?) | append_instruments(Holdings?, [bond(I?, M?, S?)], Holdings1), show(not_mature(Q?, M?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_declined_by(Q, X) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(X?) | append_instruments(Holdings?, [X?], Holdings1), show(refused(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [accept_transfer(deposit, From, terms(_, Q, C), Given, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(From?), ground(Q?), ground(C?), ground(Given?) | take_transfer(Resp), to_escrow(Given?, From?, Q?, C?, Records), append_instruments(Holdings?, Records?, Holdings1), tally(Given?, [], Lots), show(received_transfer(deposit, From?, Lots?), Outs?, Outs1), after_escrow(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [accept_transfer(Kind, From, _, Given, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Kind?), (Kind? =?\= deposit), ground(From?), ground(Given?) | take_transfer(Resp), append_instruments(Holdings?, Given?, Holdings1), tally(Given?, [], Lots), show(received_transfer(Kind?, From?, Lots?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [decline_transfer(Kind, From, Given, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Kind?), ground(From?) | decline_transfer_resp(Resp, Given?), show(declined_transfer(Kind?, From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).
serve(Reqs, Id, [transfer_accepted(Kind, Q) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Kind?), ground(Q?) | show(transferred(Kind?, Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).
serve(Reqs, Id, [transfer_declined_by(deposit, Q, _, Given) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Given?) | append_instruments(Holdings?, Given?, Holdings1), show(transfer_declined(deposit, Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [transfer_declined_by(Kind, Q, terms(P, B, C), Given) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Kind?), (Kind? =?\= deposit), ground(Q?), ground(P?), ground(B?), ground(C?), ground(Given?) | to_escrow(Given?, P?, B?, C?, Records), append_instruments(Holdings?, Records?, Holdings1), show(transfer_declined(Kind?, Q?), Outs?, Outs1), after_escrow(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [_ | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve([issue(K) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), integer(K?), (K? >= 1) | create_coins(Id?, K?, Serial?, New), Serial1 := (Serial? + K?), append_instruments(Holdings?, New?, Holdings1), show(issued(K?, now), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial1?, D).
serve([issue(K, D) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D1?) :- ground(Id?), integer(K?), (K? >= 1), integer(D?) | today(Day), issue_bonds(Day?, K?, D?, Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D1).
serve([swap(Q, U, D, K, V, D1, K1) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D2?) :- ground(Id?), ground(Q?), ground(U?), ground(D?), integer(K?), (K? >= 1), ground(V?), ground(D1?), integer(K1?), (K1? >= 1), (lot(U?, D?, K?) =?\= lot(V?, D1?, K1?)) | select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest), propose_swap(Status?, Id?, Q?, lot(U?, D?, K?), lot(V?, D1?, K1?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D2).
serve([swap(Q, U, D, K, V, D1, K1) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D2?) :- ground(Id?), ground(Q?), ground(U?), ground(D?), integer(K?), (K? >= 1), ground(V?), ground(D1?), integer(K1?), (K1? >= 1), (lot(U?, D?, K?) =?= lot(V?, D1?, K1?)) | show(swap_same(Q?, U?, D?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D2).
serve([pay(Q, K) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), integer(K?), (K? >= 1) | select_instruments(Q?, now, K?, Holdings?, Status, Give, Rest), do_pay(Status?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve([redeem(Q, D, R, D1) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D2?) :- ground(Id?), ground(Q?), ground(D?), ground(R?), ground(D1?), (lot(Q?, D?, 1) =?\= lot(R?, D1?, 1)) | take_instrument(Q?, D?, Holdings?, Found, Rest), do_redeem(Found?, Id?, Q?, D?, R?, D1?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D2).
serve([redeem(Q, D, R, D1) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D2?) :- ground(Id?), ground(Q?), ground(D?), ground(R?), ground(D1?), (lot(Q?, D?, 1) =?= lot(R?, D1?, 1)) | show(redeem_same(Q?, D?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D2).
serve([deposit(E, U, D, K, Q, C) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D1?) :- ground(Id?), ground(E?), ground(U?), ground(D?), integer(K?), (K? >= 1), ground(Q?), ground(C?) | has_peer(Q?, Outs?, Outs1, Known), deposit_for(Known?, E?, U?, D?, K?, Q?, C?, Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D1).
serve([release(Q, U, D, K, P, C) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D1?) :- ground(Id?), ground(Q?), ground(U?), ground(D?), integer(K?), (K? >= 1), ground(P?), ground(C?) | select_escrow(U?, D?, K?, P?, Q?, C?, Holdings?, Status, Give, Rest), propose_transfer(Status?, release, terms(P?, Q?, C?), Id?, Q?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D1).
serve([return(P, U, D, K, Q, C) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D1?) :- ground(Id?), ground(P?), ground(U?), ground(D?), integer(K?), (K? >= 1), ground(Q?), ground(C?) | select_escrow(U?, D?, K?, P?, Q?, C?, Holdings?, Status, Give, Rest), propose_transfer(Status?, return, terms(P?, Q?, C?), Id?, P?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D1).

procedure issue_bonds(Integer?, Integer?, Integer?, Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
issue_bonds(Day, K, D, Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D1?) :- (D? > Day?) | create_bonds(Id?, D?, K?, Serial?, New), Serial1 := (Serial? + K?), append_instruments(Holdings?, New?, Holdings1), show(issued(K?, D?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial1?, D1).
issue_bonds(Day, _, D, Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D1?) :- (D? =< Day?) | show(not_later(D?, Day?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D1).

procedure deposit_for(Decision?, Key?, Key?, Constant?, Integer?, Key?, Condition?, Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
deposit_for(yes, E, U, D, K, Q, C, Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D1?) :- select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest), propose_transfer(Status?, deposit, terms(Id?, Q?, C?), Id?, E?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D1).
deposit_for(no, _, _, _, _, Q, _, Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure on_act(PeerContent?, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
on_act(pay(Coins, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | own_coins(Id?, Coins?, Own), take_payment(Own?, Id?, From?, Coins?, Resp, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
on_act(redeem(X, R, D1, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(X?), ground(R?), ground(D1?) | fulfil(X?, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
on_act(swap(Want, Offered, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Want?), ground(Offered?) | respond_swap(offer(From?, Want?, Offered?), Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D2), merge(D1?, D2?, D).
on_act(transfer(Kind, Terms, Given, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Kind?), ground(Terms?), ground(Given?), ground(From?), ground(Id?) | names_me(Kind?, Terms?, From?, Id?, Mine), pose_transfer(Mine?, Kind?, Terms?, Given?, Resp, From?, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).

procedure names_me(Kind?, Terms?, Key?, Key?, Decision).
names_me(deposit, terms(P, _, _), From, _, yes) :- (P? =?= From?) | true.
names_me(release, terms(_, Q, _), _, Id, yes) :- (Q? =?= Id?) | true.
names_me(return, terms(P, _, _), _, Id, yes) :- (P? =?= Id?) | true.
names_me(_, _, _, _, no) :- otherwise | true.

procedure pose_transfer(Decision?, Kind?, Terms?, Stream(Instrument)?, TransferResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
pose_transfer(yes, Kind, Terms, Given, Resp?, From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- respond_transfer(offer_transfer(Kind?, From?, Terms?, Given?), Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D2), merge(D1?, D2?, D).
pose_transfer(no, Kind, _, Given, transfer_decline(Given?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- show(declined_transfer(Kind?, From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure take_payment(Decision?, Key?, Key?, Stream(Instrument)?, PayResponse, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
take_payment(yes, Id, From, Coins, pay_taken, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | append_instruments(Holdings?, Coins?, Holdings1), count_instruments(Coins?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
take_payment(no, Id, From, Coins, pay_returned(Coins?), Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | count_instruments(Coins?, 0, K), show(refused_payment(From?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure fulfil(Instrument?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
fulfil(coin(I, S), R, D1, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- (I? =?= Id?) | take_instrument(R?, D1?, Holdings?, Found, Rest), give(Found?, coin(I?, S?), now, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Rest?, Serial?, D).
fulfil(bond(I, M, S), R, D1, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- (I? =?= Id?) | today(Day), fulfil_bond(Day?, I?, M?, S?, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
fulfil(X, _, _, redeem_declined(X?), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- otherwise | show(refused(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure fulfil_bond(Integer?, Key?, Integer?, Integer?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
fulfil_bond(Day, I, M, S, R, D1, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- (M? =< Day?) | take_instrument(R?, D1?, Holdings?, Found, Rest), give(Found?, bond(I?, M?, S?), M?, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Rest?, Serial?, D).
fulfil_bond(Day, I, M, S, _, _, redeem_not_mature(bond(I?, M?, S?)), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- (M? > Day?) | show(not_mature_for(From?, M?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure give(Found?, Instrument?, Constant?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
give(found(X), Mine, D, R, D1, redeem_give(X?), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Rest, Serial, D2?) :- append_instruments(Rest?, [Mine?], Holdings1), show(presented(From?, D?, R?, D1?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D2).
give(not_found, Mine, _, R, D1, redeem_menu(Mine?, Menu?), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Rest, Serial, D?) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?, D1?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).

procedure fill_swap(Status?, Key?, Key?, SwapResponse, Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
fill_swap(ok, Id, From, swap_accept(Give?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_instruments(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
fill_swap(fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure propose_swap(Status?, Key?, Key?, Lot?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
propose_swap(ok, Id, Q, _, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?), ground(Want?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_swap(Known?, Id?, Q?, Want?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
propose_swap(fail, Id, _, lot(U, D, K), _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D1?) :- append_instruments(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D1).

procedure send_swap(Decision?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_swap(yes, Id, Q, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).
send_swap(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure propose_transfer(Status?, Kind?, Terms?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
propose_transfer(ok, Kind, Terms, Id, Q, Lot, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Kind?), ground(Terms?), ground(Q?), ground(Lot?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_transfer(Known?, Kind?, Terms?, Id?, Q?, Lot?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
propose_transfer(fail, Kind, Terms, Id, _, lot(U, D, K), Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D1?) :- ground(Kind?), ground(Terms?) | put_back(Kind?, Terms?, Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D1).

procedure put_back(Kind?, Terms?, Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)).
put_back(deposit, _, Give, Rest, Orig?) :- append_instruments(Give?, Rest?, Orig).
put_back(Kind, terms(P, Q, C), Give, Rest, Orig?) :- (Kind? =?\= deposit) | to_escrow(Give?, P?, Q?, C?, Records), append_instruments(Records?, Rest?, Orig).

procedure send_transfer(Decision?, Kind?, Terms?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_transfer(yes, Kind, Terms, Id, Q, Lot, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Kind?), ground(Terms?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Terms?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, Terms?, UserIn?, UserIn1), show(offered_transfer(Kind?, Q?, Lot?), Outs1?, Outs2), after_sent(Kind?, Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs2?, Rest?, Serial?, D).
send_transfer(no, Kind, Terms, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Kind?), ground(Terms?) | put_back(Kind?, Terms?, Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure do_pay(Status?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
do_pay(ok, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Known?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
do_pay(fail, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(lacking(Q?, now, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure send_pay(Decision?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_pay(yes, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, pay(Give?, Resp)), Outs?, Outs1), inject_pay_result(Resp?, Q?, K?, UserIn?, UserIn1), show(paying(Q?, K?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs2?, Rest?, Serial?, D).
send_pay(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure do_redeem(Found?, Key?, Key?, Constant?, Key?, Constant?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
do_redeem(found(X), Id, Q, D, R, D1, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D2?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_redeem(Known?, Id?, Q?, D?, R?, D1?, X?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D2).
do_redeem(not_found, Id, Q, D, _, _, Holdings, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D1?) :- show(lacking(Q?, D?, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D1).

procedure send_redeem(Decision?, Key?, Key?, Constant?, Key?, Constant?, Instrument?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_redeem(yes, Id, Q, D, R, D1, X, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D2?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, redeem(X?, R?, D1?, Resp)), Outs?, Outs1), inject_redeem_result(Resp?, Q?, D?, R?, D1?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D2).
send_redeem(no, Id, Q, _, _, _, X, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_instruments(Rest?, [X?], Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure after_change(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
after_change(Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure after_escrow(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
after_escrow(Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), escrow_tally(Holdings?, [], Held), show(escrowed(Held?), Outs1?, Outs2), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs2?, Holdings?, Serial?, D).

procedure after_sent(Kind?, Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Ask(Question))).
after_sent(deposit, Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
after_sent(Kind, Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- (Kind? =?\= deposit) | after_escrow(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).
Event(Q, T) ::= Ask(Q) ; Input(T) ; Draw(T).
Events(Q, T) ::= [Event(Q, T) | Events(Q, T)].
Turn ::= ask ; grant ; draw.
Questioned(S) ::= S ; input(Path).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(Input(T)), Stream(Draw(T))), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), fair(ask, Asks?, Inputs?, COut?, Es), serve_1(Es?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(Input(T)), Stream(Draw(T))?, Inputs(T), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, G0s?, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), fair(ask, Asks?, Inputs?, COut?, Es), serve_1(Es?, COut, DOut, [route(0, G0s)], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(Input(T))).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([refresh | Gs], [refresh | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) fair(Turn?, Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Events(Q, T)).
fair(ask, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(grant, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(draw, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(ask, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(grant, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(draw, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(ask, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(grant, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(draw, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).

procedure(Q, T) serve_1(Events(Q, T)?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve_1([ask(_, Q) | Es], CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Es?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1([input(Id, P, R) | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(input(Id?, P?, R?), Rs?, Rs1), serve_1(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1([refresh | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- refresh_routes(Rs?, Rs1), serve_1(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1([draw(Id, W, V) | Es], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Es?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1([withdraw(Id) | Es], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Es?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) refresh_routes(Routes(T)?, Routes(T)).
refresh_routes([route(Id, [refresh | Gs1?]) | Rs], [route(Id?, Gs1) | Rs1?]) :- refresh_routes(Rs?, Rs1).
refresh_routes([], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure(T) form_string(T?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure(T) form_integer(T?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure(T) form_constant(T?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= swapCard_w(View_swapCard) ; transferCard_w(View_transferCard) ; stream_request_r(View_stream_request_r) ; output(List(Output)) ; YesNo ; Request.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, G0s, Ss), output(thread(menu([form(holdings, [field('Holdings', thread(form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])))]), form(opened, [field('Friend', shown)]), form(issued, [field('Amount', shown), field('Due', shown)]), form(not_later, [field('Maturity', shown), field('Date', shown)]), form(paying, [field('Friend', shown), field('Amount', shown)]), form(paid, [field('Friend', shown), field('Amount', shown)]), form(not_accepted, [field('Friend', shown), field('Amount', shown)]), form(received, [field('From', shown), field('Amount', shown)]), form(refused_payment, [field('From', shown), field('Amount', shown)]), form(swap_done, [field('Friend', shown)]), form(swap_declined, [field('Friend', shown)]), form(swap_failed, [field('From', shown)]), form(declined, [field('From', shown)]), form(swap_same, [field('Friend', shown), field('GiveIssuer', shown), field('GiveDue', shown), field('GiveAmount', shown)]), form(redeemed, [field('Friend', shown), field('GiveDue', shown), field('WantIssuer', shown), field('WantDue', shown)]), form(menu, [field('Friend', shown), field('Menu', thread(form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])))]), form(refused, [field('Friend', shown)]), form(redeem_same, [field('Friend', shown), field('GiveDue', shown)]), form(presented, [field('From', shown), field('GiveDue', shown), field('WantIssuer', shown), field('WantDue', shown)]), form(unfulfilled, [field('From', shown), field('WantIssuer', shown), field('WantDue', shown)]), form(not_mature, [field('Friend', shown), field('Maturity', shown)]), form(not_mature_for, [field('From', shown), field('Maturity', shown)]), form(offered_transfer, [field('Kind', shown), field('Friend', shown), field('Lot', form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)]))]), form(transferred, [field('Kind', shown), field('Friend', shown)]), form(transfer_declined, [field('Kind', shown), field('Friend', shown)]), form(received_transfer, [field('Kind', shown), field('From', shown), field('Lots', thread(form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])))]), form(escrowed, [field('EscrowLots', thread(form(in_escrow, [field('Issuer', shown), field('Due', shown), field('Amount', shown), field('Depositor', shown), field('Beneficiary', shown), field('Condition', menu([form(day, [field('Date', shown)]), form(agreed, [field('Constant', shown)])]))])))]), form(declined_transfer, [field('Kind', shown), field('From', shown)]), form(lacking, [field('Issuer', shown), field('Due', shown), field('Amount', shown)]), form(no_conversation, [field('Friend', shown)]), form(date, [field('Date', shown)])])), MOut?, G0s?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, swapCard_w(X), Gs, Ds?) :- present_swapCard([], X?, Gs1?, _, Vs, Done), run_swapCard_w(Id?, form(card, [field('SwapOffer', form(offer, [field('From', shown), field('Want', form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])), field('Offered', thread(menu([form(coin, [field('Issuer', shown), field('Serial', shown)]), form(bond, [field('Issuer', shown), field('Maturity', shown), field('Serial', shown)]), form(escrow_coin, [field('Issuer', shown), field('Serial', shown), field('Depositor', shown), field('Beneficiary', shown), field('Condition', menu([form(day, [field('Date', shown)]), form(agreed, [field('Constant', shown)])]))]), form(escrow_bond, [field('Issuer', shown), field('Maturity', shown), field('Serial', shown), field('Depositor', shown), field('Beneficiary', shown), field('Condition', menu([form(day, [field('Date', shown)]), form(agreed, [field('Constant', shown)])]))])])))])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Gs?, Gs1, Ds).
construct(Id, transferCard_w(X), Gs, Ds?) :- present_transferCard([], X?, Gs1?, _, Vs, Done), run_transferCard_w(Id?, form(card, [field('TransferOffer', form(offer_transfer, [field('Kind', shown), field('From', shown), field('Terms', form(terms, [field('Depositor', shown), field('Beneficiary', shown), field('Condition', menu([form(day, [field('Date', shown)]), form(agreed, [field('Constant', shown)])]))])), field('Given', thread(menu([form(coin, [field('Issuer', shown), field('Serial', shown)]), form(bond, [field('Issuer', shown), field('Maturity', shown), field('Serial', shown)]), form(escrow_coin, [field('Issuer', shown), field('Serial', shown), field('Depositor', shown), field('Beneficiary', shown), field('Condition', menu([form(day, [field('Date', shown)]), form(agreed, [field('Constant', shown)])]))]), form(escrow_bond, [field('Issuer', shown), field('Maturity', shown), field('Serial', shown), field('Depositor', shown), field('Beneficiary', shown), field('Condition', menu([form(day, [field('Date', shown)]), form(agreed, [field('Constant', shown)])]))])])))])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Gs?, Gs1, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs1?, _, Done), run_stream_request_r(Id?, input_box(menu([form(issue, [field('Amount', number)]), form(issue, [field('Amount', number), field('Maturity', number)]), form(swap, [field('Friend', peer), field('GiveIssuer', peer), field('GiveDue', text), field('GiveAmount', number), field('WantIssuer', peer), field('WantDue', text), field('WantAmount', number)]), form(pay, [field('Friend', peer), field('Amount', number)]), form(redeem, [field('Friend', peer), field('GiveDue', text), field('WantIssuer', peer), field('WantDue', text)]), form(deposit, [field('EscrowAgent', peer), field('Issuer', peer), field('Due', text), field('Amount', number), field('Beneficiary', peer), field('Condition', menu([form(day, [field('Date', number)]), form(agreed, [field('Constant', text)])]))]), form(release, [field('Beneficiary', peer), field('Issuer', peer), field('Due', text), field('Amount', number), field('Depositor', peer), field('Condition', menu([form(day, [field('Date', number)]), form(agreed, [field('Constant', text)])]))]), form(return, [field('Depositor', peer), field('Issuer', peer), field('Due', text), field('Amount', number), field('Beneficiary', peer), field('Condition', menu([form(day, [field('Date', number)]), form(agreed, [field('Constant', text)])]))])])), [input([])], Done?, Gs?, Gs1, Ds).

procedure output(Widget(Drawn)?, Stream(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output(W, Ms, Gs, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Gs?, Ds).

procedure output_more(Widget(Drawn)?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Gs, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Gs?, Ds).
output_more(W, Ms, Es, [refresh | Gs], Ds?) :- output_draw(W?, Ms?, Es?, Gs?, Ds).
output_more(W, Ms, Es, [input(_, _, _) | Gs], Ds?) :- output_more(W?, Ms?, Es?, Gs?, Ds).
output_more(W, [], Es, Gs, Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_draw(Widget(Drawn)?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, Gs, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Gs?, Ds).

procedure output_end(Widget(Drawn)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_end(W, Es, [refresh | Gs], [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_end(W?, Es?, Gs?, Ds).
output_end(W, Es, [input(_, _, _) | Gs], Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure form_yesNo(Drawn?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

View_swapCard ::= card(SwapOffer, Questioned(YesNo)).
procedure present_swapCard(Path?, SwapCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(View_swapCard), Done).
present_swapCard(P, card(H1, H2?), Gs, Gs1?, [card(H1?, input(M2?))], D2?) :- ground(P?), ground(H1?) | path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2).

procedure run_swapCard_w(Integer?, Widget(Drawn)?, Stream(View_swapCard)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_swapCard_w(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, swapCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_swapCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_swapCard_w(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_swapCard_w_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_swapCard_w_more(Integer?, Widget(Drawn)?, View_swapCard?, Stream(View_swapCard)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_swapCard_w_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_swapCard_w_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, swapCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_swapCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_swapCard_w_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, swapCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_swapCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_swapCard_w_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_swapCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_swapCard_w_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_swapCard_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_swapCard_w_last(Integer?, Widget(Drawn)?, View_swapCard?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_swapCard_w_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_swapCard_w_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, swapCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_swapCard_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_swapCard_w_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_swapCard_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_swapCard_w_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_swapCard_w_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_swapCard_w_grants(Gs?, Gs1).
run_swapCard_w_grants([refresh | Gs], Gs1?) :- run_swapCard_w_grants(Gs?, Gs1).

View_transferCard ::= card(TransferOffer, Questioned(YesNo)).
procedure present_transferCard(Path?, TransferCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(View_transferCard), Done).
present_transferCard(P, card(H1, H2?), Gs, Gs1?, [card(H1?, input(M2?))], D2?) :- ground(P?), ground(H1?) | path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2).

procedure run_transferCard_w(Integer?, Widget(Drawn)?, Stream(View_transferCard)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_transferCard_w(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, transferCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_transferCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_transferCard_w(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_transferCard_w_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_transferCard_w_more(Integer?, Widget(Drawn)?, View_transferCard?, Stream(View_transferCard)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_transferCard_w_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_transferCard_w_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, transferCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_transferCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_transferCard_w_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, transferCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_transferCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_transferCard_w_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_transferCard_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_transferCard_w_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_transferCard_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_transferCard_w_last(Integer?, Widget(Drawn)?, View_transferCard?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_transferCard_w_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_transferCard_w_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, transferCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_transferCard_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_transferCard_w_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_transferCard_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_transferCard_w_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_transferCard_w_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_transferCard_w_grants(Gs?, Gs1).
run_transferCard_w_grants([refresh | Gs], Gs1?) :- run_transferCard_w_grants(Gs?, Gs1).

procedure join_request_issue_1(Formed(Amount)?, Formed(Request)).
join_request_issue_1(formed(X1), formed(issue(X1?))).
join_request_issue_1(refused, refused).

procedure join_request_issue_2(Formed(Amount)?, Formed(Maturity)?, Formed(Request)).
join_request_issue_2(formed(X1), formed(X2), formed(issue(X1?, X2?))).
join_request_issue_2(refused, _, refused).
join_request_issue_2(_, refused, refused).

procedure join_request_swap_7(Formed(Friend)?, Formed(GiveIssuer)?, Formed(GiveDue)?, Formed(GiveAmount)?, Formed(WantIssuer)?, Formed(WantDue)?, Formed(WantAmount)?, Formed(Request)).
join_request_swap_7(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(X7), formed(swap(X1?, X2?, X3?, X4?, X5?, X6?, X7?))).
join_request_swap_7(refused, _, _, _, _, _, _, refused).
join_request_swap_7(_, refused, _, _, _, _, _, refused).
join_request_swap_7(_, _, refused, _, _, _, _, refused).
join_request_swap_7(_, _, _, refused, _, _, _, refused).
join_request_swap_7(_, _, _, _, refused, _, _, refused).
join_request_swap_7(_, _, _, _, _, refused, _, refused).
join_request_swap_7(_, _, _, _, _, _, refused, refused).

procedure join_request_pay_2(Formed(Friend)?, Formed(Amount)?, Formed(Request)).
join_request_pay_2(formed(X1), formed(X2), formed(pay(X1?, X2?))).
join_request_pay_2(refused, _, refused).
join_request_pay_2(_, refused, refused).

procedure join_request_redeem_4(Formed(Friend)?, Formed(GiveDue)?, Formed(WantIssuer)?, Formed(WantDue)?, Formed(Request)).
join_request_redeem_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(redeem(X1?, X2?, X3?, X4?))).
join_request_redeem_4(refused, _, _, _, refused).
join_request_redeem_4(_, refused, _, _, refused).
join_request_redeem_4(_, _, refused, _, refused).
join_request_redeem_4(_, _, _, refused, refused).

procedure join_condition_day_1(Formed(Date)?, Formed(Condition)).
join_condition_day_1(formed(X1), formed(day(X1?))).
join_condition_day_1(refused, refused).

procedure join_condition_agreed_1(Formed(Constant)?, Formed(Condition)).
join_condition_agreed_1(formed(X1), formed(agreed(X1?))).
join_condition_agreed_1(refused, refused).

procedure form_condition(Condition?, Formed(Condition)).
form_condition(day(R1), F?) :- form_integer(R1?, F1), join_condition_day_1(F1?, F).
form_condition(agreed(R1), F?) :- form_constant(R1?, F1), join_condition_agreed_1(F1?, F).
form_condition(_, refused) :- otherwise | true.

procedure join_request_deposit_6(Formed(EscrowAgent)?, Formed(Issuer)?, Formed(Due)?, Formed(Amount)?, Formed(Beneficiary)?, Formed(Condition)?, Formed(Request)).
join_request_deposit_6(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(deposit(X1?, X2?, X3?, X4?, X5?, X6?))).
join_request_deposit_6(refused, _, _, _, _, _, refused).
join_request_deposit_6(_, refused, _, _, _, _, refused).
join_request_deposit_6(_, _, refused, _, _, _, refused).
join_request_deposit_6(_, _, _, refused, _, _, refused).
join_request_deposit_6(_, _, _, _, refused, _, refused).
join_request_deposit_6(_, _, _, _, _, refused, refused).

procedure join_request_release_6(Formed(Beneficiary)?, Formed(Issuer)?, Formed(Due)?, Formed(Amount)?, Formed(Depositor)?, Formed(Condition)?, Formed(Request)).
join_request_release_6(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(release(X1?, X2?, X3?, X4?, X5?, X6?))).
join_request_release_6(refused, _, _, _, _, _, refused).
join_request_release_6(_, refused, _, _, _, _, refused).
join_request_release_6(_, _, refused, _, _, _, refused).
join_request_release_6(_, _, _, refused, _, _, refused).
join_request_release_6(_, _, _, _, refused, _, refused).
join_request_release_6(_, _, _, _, _, refused, refused).

procedure join_request_return_6(Formed(Depositor)?, Formed(Issuer)?, Formed(Due)?, Formed(Amount)?, Formed(Beneficiary)?, Formed(Condition)?, Formed(Request)).
join_request_return_6(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(return(X1?, X2?, X3?, X4?, X5?, X6?))).
join_request_return_6(refused, _, _, _, _, _, refused).
join_request_return_6(_, refused, _, _, _, _, refused).
join_request_return_6(_, _, refused, _, _, _, refused).
join_request_return_6(_, _, _, refused, _, _, refused).
join_request_return_6(_, _, _, _, refused, _, refused).
join_request_return_6(_, _, _, _, _, refused, refused).

procedure form_request(Drawn?, Formed(Request)).
form_request(issue(R1), F?) :- form_integer(R1?, F1), join_request_issue_1(F1?, F).
form_request(issue(R1, R2), F?) :- form_integer(R1?, F1), form_integer(R2?, F2), join_request_issue_2(F1?, F2?, F).
form_request(swap(R1, R2, R3, R4, R5, R6, R7), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), form_string(R5?, F5), form_constant(R6?, F6), form_integer(R7?, F7), join_request_swap_7(F1?, F2?, F3?, F4?, F5?, F6?, F7?, F).
form_request(pay(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_request_pay_2(F1?, F2?, F).
form_request(redeem(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_string(R3?, F3), form_constant(R4?, F4), join_request_redeem_4(F1?, F2?, F3?, F4?, F).
form_request(deposit(R1, R2, R3, R4, R5, R6), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), form_string(R5?, F5), form_condition(R6?, F6), join_request_deposit_6(F1?, F2?, F3?, F4?, F5?, F6?, F).
form_request(release(R1, R2, R3, R4, R5, R6), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), form_string(R5?, F5), form_condition(R6?, F6), join_request_release_6(F1?, F2?, F3?, F4?, F5?, F6?, F).
form_request(return(R1, R2, R3, R4, R5, R6), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), form_string(R5?, F5), form_condition(R6?, F6), join_request_return_6(F1?, F2?, F3?, F4?, F5?, F6?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs(Drawn)?, Inputs(Drawn), Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

View_stream_request_r ::= Stream(Request) ; input(Path).
procedure run_stream_request_r(Integer?, Widget(Drawn)?, Stream(View_stream_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_stream_request_r_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_stream_request_r_more(Integer?, Widget(Drawn)?, View_stream_request_r?, Stream(View_stream_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_stream_request_r_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_stream_request_r_last(Integer?, Widget(Drawn)?, View_stream_request_r?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_stream_request_r_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_stream_request_r_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_stream_request_r_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_stream_request_r_grants(Gs?, Gs1).
run_stream_request_r_grants([refresh | Gs], Gs1?) :- run_stream_request_r_grants(Gs?, Gs1).

