send_transfer(yes, Kind, Id, Q, Lot, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- ground(Kind?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, UserIn?, UserIn1), show(offered_transfer(Kind?, Q?, Lot?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Serial?, D).
send_transfer(no, _, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?, D).

procedure do_pay(Status?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?, Stream(Ask(Question))).
do_pay(ok, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Known?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Serial?, D).
do_pay(fail, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(lacking(Q?, now, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?, D).

procedure send_pay(Decision?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?, Stream(Ask(Question))).
send_pay(yes, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, pay(Give?, Resp)), Outs?, Outs1), inject_pay_result(Resp?, Q?, K?, UserIn?, UserIn1), show(paying(Q?, K?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Serial?, D).
send_pay(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?, D).

procedure do_redeem(Found?, Key?, Key?, Key?, Constant?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?, Stream(Ask(Question))).
do_redeem(found(Coin), Id, Q, R, D1, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_redeem(Known?, Id?, Q?, R?, D1?, Coin?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Serial?, D).
do_redeem(not_found, Id, Q, _, _, Holdings, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- show(lacking(Q?, now, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?, D).

procedure send_redeem(Decision?, Key?, Key?, Key?, Constant?, Instrument?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?, Stream(Ask(Question))).
send_redeem(yes, Id, Q, R, D1, Coin, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, redeem(Coin?, R?, D1?, Resp)), Outs?, Outs1), inject_redeem_result(Resp?, Q?, R?, D1?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Serial?, D).
send_redeem(no, Id, Q, _, _, Coin, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- append_instruments(Rest?, [Coin?], Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?, D).

procedure do_mature(Found?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?, Stream(Ask(Question))).
do_mature(found(Bond), Id, Q, D, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D1?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_mature(Known?, Id?, Q?, D?, Bond?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Serial?, D1).
do_mature(not_found, Id, Q, D, Holdings, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D1?) :- show(lacking(Q?, D?, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?, D1).

procedure send_mature(Decision?, Key?, Key?, Integer?, Instrument?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?, Stream(Ask(Question))).
send_mature(yes, Id, Q, D, Bond, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D1?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, mature(Bond?, Resp)), Outs?, Outs1), inject_mature_result(Resp?, Q?, D?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Serial?, D1).
send_mature(no, Id, Q, _, Bond, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial, D?) :- append_instruments(Rest?, [Bond?], Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?, D).

procedure after_change(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?, Stream(Ask(Question))).
after_change(Reqs, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial, D?) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?, D).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), serve_1(Asks?, Inputs?, COut?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(_), Stream(Draw(T))?, Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), serve_1(Asks?, Inputs?, COut?, COut, DOut, [], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) serve_1(Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve_1([ask(_, Q) | Asks], Is, COut, CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Asks?, Is?, COut?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1(Asks, [G | Is], COut, CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(G?, Rs?, Rs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1(Asks, Is, [draw(Id, W, V) | COut], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Asks?, Is?, COut?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1(Asks, Is, [withdraw(Id) | COut], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(Path?, _?, Stream(_)).
shown(_, X, [X?]) :- ground(X?) | true.
shown(P, X, [pending(P?) | Vs?]) :- shown_whole(X?, Vs).

procedure shown_whole(_?, Stream(_)).
shown_whole(X, [X?]) :- ground(X?) | true.

procedure thread(Path?, Stream(_)?, Stream(Stream(_))).
thread(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread(_, [], [[]]).
thread(P, Xs, [[] | Vs?]) :- thread_tail(P?, Xs?, Vs).

procedure thread_tail(Path?, Stream(_)?, Stream(Stream(_))).
thread_tail(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread_tail(_, [], []).

procedure thread_cell(Path?, _?, Stream(_)?, Stream(Stream(_))).
thread_cell(P, X, Xs, Vs?) :- ground(P?) | path(P?, 1, P1), path(P?, 2, P2), shown(P1?, X?, V1), thread(P2?, Xs?, V2), cons_views(V1?, V2?, Vs).

procedure cons_views(Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_views([E | Es], [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_views([], _, []).
cons_views(_, [], []).

procedure cons_more(_?, Stream(_)?, Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_more(_, T, [E | Es], Ts, [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(E, _, Es, [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(_, _, [], [], []).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= swapCard_w(_) ; transferCard_w(_) ; stream_request_r(_) ; output(List(Output)) ; YesNo ; Request.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, Ss), output(thread(menu([form(holdings, [field('Holdings', thread(form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])))]), form(opened, [field('Friend', shown)]), form(date_advanced, [field('Date', shown)]), form(minted, [field('Amount', shown), field('Due', shown)]), form(paying, [field('Friend', shown), field('Amount', shown)]), form(paid, [field('Friend', shown), field('Amount', shown)]), form(not_accepted, [field('Friend', shown), field('Amount', shown)]), form(received, [field('From', shown), field('Amount', shown)]), form(refused_payment, [field('From', shown), field('Amount', shown)]), form(swap_done, [field('Friend', shown)]), form(swap_declined, [field('Friend', shown)]), form(swap_failed, [field('From', shown)]), form(declined, [field('From', shown)]), form(redeemed, [field('Friend', shown), field('WantIssuer', shown), field('WantDue', shown)]), form(menu, [field('Friend', shown), field('Menu', thread(form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])))]), form(refused, [field('Friend', shown)]), form(presented, [field('From', shown), field('WantIssuer', shown), field('WantDue', shown)]), form(unfulfilled, [field('From', shown), field('WantIssuer', shown), field('WantDue', shown)]), form(matured, [field('Friend', shown), field('Maturity', shown)]), form(not_mature, [field('Friend', shown), field('Maturity', shown)]), form(matured_for, [field('From', shown), field('Maturity', shown)]), form(not_mature_for, [field('From', shown), field('Maturity', shown)]), form(offered_transfer, [field('Kind', shown), field('Friend', shown), field('Lot', form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)]))]), form(transferred, [field('Kind', shown), field('Friend', shown)]), form(transfer_declined, [field('Kind', shown), field('Friend', shown)]), form(received_transfer, [field('Kind', shown), field('From', shown), field('Lots', thread(form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])))]), form(declined_transfer, [field('Kind', shown), field('From', shown)]), form(lacking, [field('Issuer', shown), field('Due', shown), field('Amount', shown)]), form(no_conversation, [field('Friend', shown)])])), MOut?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, swapCard_w(X), Gs, Ds?) :- present_swapCard([], X?, Gs?, _, Vs, Done), run_swapCard_w(Id?, form(card, [field('SwapOffer', form(offer, [field('From', shown), field('Want', form(lot, [field('Issuer', shown), field('Due', shown), field('Amount', shown)])), field('Offered', thread(menu([form(coin, [field('Issuer', shown), field('Serial', shown)]), form(bond, [field('Issuer', shown), field('Maturity', shown), field('Serial', shown)])])))])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, transferCard_w(X), Gs, Ds?) :- present_transferCard([], X?, Gs?, _, Vs, Done), run_transferCard_w(Id?, form(card, [field('TransferOffer', form(offer_transfer, [field('Kind', shown), field('From', shown), field('Given', thread(menu([form(coin, [field('Issuer', shown), field('Serial', shown)]), form(bond, [field('Issuer', shown), field('Maturity', shown), field('Serial', shown)])])))])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs?, _, Done), run_stream_request_r(Id?, input_box(menu([form(mint, [field('Amount', number)]), form(mint, [field('Amount', number), field('Maturity', number)]), form(swap, [field('Friend', peer), field('GiveIssuer', peer), field('GiveDue', text), field('GiveAmount', number), field('WantIssuer', peer), field('WantDue', text), field('WantAmount', number)]), form(pay, [field('Friend', peer), field('Amount', number)]), form(redeem, [field('Friend', peer), field('WantIssuer', peer), field('WantDue', text)]), form(mature, [field('Friend', peer), field('Maturity', number)]), form(deposit, [field('EscrowAgent', peer), field('Issuer', peer), field('Due', text), field('Amount', number)]), form(release, [field('Beneficiary', peer), field('Issuer', peer), field('Due', text), field('Amount', number)]), form(return, [field('Depositor', peer), field('Issuer', peer), field('Due', text), field('Amount', number)])])), [input([])], Done?, Ds).

procedure output(_?, Stream(Output)?, Stream(Draw(Drawn))).
output(W, Ms, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Ds).

procedure output_more(_?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Ds).
output_more(_, [], _, []).

procedure output_draw(_?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure form_yesNo(_?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

procedure start_swapCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_swapCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_swapCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_swapCard_card_2([], _, []).
start_swapCard_card_2(_, [], []).

procedure comb_swapCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_swapCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_swapCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_swapCard_card_2(_, _, [], [], []).

procedure present_swapCard(Path?, SwapCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_swapCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_swapCard_card_2(V1?, [input(M2?)], Vs).
present_swapCard(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_swapCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_swapCard_wait(Path?, SwapCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_swapCard_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_swapCard(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_swapCard_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_swapCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_swapCard_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_swapCard_w(Id, _, _, done, [withdraw(Id?)]).
run_swapCard_w(Id, W, [V | Vs], Done, [draw(Id?, W?, swapCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_swapCard_w(Id?, W?, Vs?, Done?, Ds).
run_swapCard_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure start_transferCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_transferCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_transferCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_transferCard_card_2([], _, []).
start_transferCard_card_2(_, [], []).

procedure comb_transferCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_transferCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_transferCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_transferCard_card_2(_, _, [], [], []).

procedure present_transferCard(Path?, TransferCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_transferCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_transferCard_card_2(V1?, [input(M2?)], Vs).
present_transferCard(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_transferCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_transferCard_wait(Path?, TransferCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_transferCard_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_transferCard(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_transferCard_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_transferCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_transferCard_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_transferCard_w(Id, _, _, done, [withdraw(Id?)]).
run_transferCard_w(Id, W, [V | Vs], Done, [draw(Id?, W?, transferCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_transferCard_w(Id?, W?, Vs?, Done?, Ds).
run_transferCard_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure join_request_mint_1(Formed(Amount)?, Formed(Request)).
join_request_mint_1(formed(X1), formed(mint(X1?))).
join_request_mint_1(refused, refused).

procedure join_request_mint_2(Formed(Amount)?, Formed(Maturity)?, Formed(Request)).
join_request_mint_2(formed(X1), formed(X2), formed(mint(X1?, X2?))).
join_request_mint_2(refused, _, refused).
join_request_mint_2(_, refused, refused).

procedure join_request_swap_7(Formed(Friend)?, Formed(GiveIssuer)?, Formed(GiveDue)?, Formed(GiveAmount)?, Formed(WantIssuer)?, Formed(WantDue)?, Formed(WantAmount)?, Formed(Request)).
join_request_swap_7(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(X7), formed(swap(X1?, X2?, X3?, X4?, X5?, X6?, X7?))).
join_request_swap_7(refused, _, _, _, _, _, _, refused).
join_request_swap_7(_, refused, _, _, _, _, _, refused).
join_request_swap_7(_, _, refused, _, _, _, _, refused).
join_request_swap_7(_, _, _, refused, _, _, _, refused).
join_request_swap_7(_, _, _, _, refused, _, _, refused).
join_request_swap_7(_, _, _, _, _, refused, _, refused).
join_request_swap_7(_, _, _, _, _, _, refused, refused).

procedure join_request_pay_2(Formed(Friend)?, Formed(Amount)?, Formed(Request)).
join_request_pay_2(formed(X1), formed(X2), formed(pay(X1?, X2?))).
join_request_pay_2(refused, _, refused).
join_request_pay_2(_, refused, refused).

procedure join_request_redeem_3(Formed(Friend)?, Formed(WantIssuer)?, Formed(WantDue)?, Formed(Request)).
join_request_redeem_3(formed(X1), formed(X2), formed(X3), formed(redeem(X1?, X2?, X3?))).
join_request_redeem_3(refused, _, _, refused).
join_request_redeem_3(_, refused, _, refused).
join_request_redeem_3(_, _, refused, refused).

procedure join_request_mature_2(Formed(Friend)?, Formed(Maturity)?, Formed(Request)).
join_request_mature_2(formed(X1), formed(X2), formed(mature(X1?, X2?))).
join_request_mature_2(refused, _, refused).
join_request_mature_2(_, refused, refused).

procedure join_request_deposit_4(Formed(EscrowAgent)?, Formed(Issuer)?, Formed(Due)?, Formed(Amount)?, Formed(Request)).
join_request_deposit_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(deposit(X1?, X2?, X3?, X4?))).
join_request_deposit_4(refused, _, _, _, refused).
join_request_deposit_4(_, refused, _, _, refused).
join_request_deposit_4(_, _, refused, _, refused).
join_request_deposit_4(_, _, _, refused, refused).

procedure join_request_release_4(Formed(Beneficiary)?, Formed(Issuer)?, Formed(Due)?, Formed(Amount)?, Formed(Request)).
join_request_release_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(release(X1?, X2?, X3?, X4?))).
join_request_release_4(refused, _, _, _, refused).
join_request_release_4(_, refused, _, _, refused).
join_request_release_4(_, _, refused, _, refused).
join_request_release_4(_, _, _, refused, refused).

procedure join_request_return_4(Formed(Depositor)?, Formed(Issuer)?, Formed(Due)?, Formed(Amount)?, Formed(Request)).
join_request_return_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(return(X1?, X2?, X3?, X4?))).
join_request_return_4(refused, _, _, _, refused).
join_request_return_4(_, refused, _, _, refused).
join_request_return_4(_, _, refused, _, refused).
join_request_return_4(_, _, _, refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(mint(R1), F?) :- form_integer(R1?, F1), join_request_mint_1(F1?, F).
form_request(mint(R1, R2), F?) :- form_integer(R1?, F1), form_integer(R2?, F2), join_request_mint_2(F1?, F2?, F).
form_request(swap(R1, R2, R3, R4, R5, R6, R7), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), form_string(R5?, F5), form_constant(R6?, F6), form_integer(R7?, F7), join_request_swap_7(F1?, F2?, F3?, F4?, F5?, F6?, F7?, F).
form_request(pay(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_request_pay_2(F1?, F2?, F).
form_request(redeem(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), join_request_redeem_3(F1?, F2?, F3?, F).
form_request(mature(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_request_mature_2(F1?, F2?, F).
form_request(deposit(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), join_request_deposit_4(F1?, F2?, F3?, F4?, F).
form_request(release(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), join_request_release_4(F1?, F2?, F3?, F4?, F).
form_request(return(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), join_request_return_4(F1?, F2?, F3?, F4?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs(Drawn)?, Inputs(Drawn), Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

procedure run_stream_request_r(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_stream_request_r(Id, _, _, done, [withdraw(Id?)]).
run_stream_request_r(Id, W, [V | Vs], Done, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r(Id?, W?, Vs?, Done?, Ds).
run_stream_request_r(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

