Question ::= swapCard_w(SwapCard) ; transferCard_w(TransferCard) ; stream_request_r(Stream(Request)?).

procedure respond_swap(SwapOffer?, SwapResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_swap(S1, S2?, S3?, [ask('SwapCard', swapCard_w(X?)) | D?]) :- respond_swap1(S1?, S2, S3, X, D).

procedure respond_swap1(SwapOffer?, SwapResponse, Stream(UserInMsg), SwapCard, Stream(Ask(Question))).
respond_swap1(offer(From, Want, Offered), Resp?, Ans?, card(offer(From?, Want?, Offered?), Answer), []) :- ground(From?), ground(Want?), ground(Offered?) | decide_swap(Answer?, From?, Want?, Offered?, Resp, Ans).

procedure decide_swap(YesNo?, Key?, Lot?, Stream(Instrument)?, SwapResponse, Stream(UserInMsg)).
decide_swap(yes, From, Want, Offered, Resp?, Ans?) :- accept_answer(From?, Want?, Offered?, Resp, Ans).
decide_swap(no, From, _, Offered, Resp?, Ans?) :- decline_answer(From?, Offered?, Resp, Ans).

procedure respond_transfer(TransferOffer?, TransferResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_transfer(S1, S2?, S3?, [ask('TransferCard', transferCard_w(X?)) | D?]) :- respond_transfer1(S1?, S2, S3, X, D).

procedure respond_transfer1(TransferOffer?, TransferResponse, Stream(UserInMsg), TransferCard, Stream(Ask(Question))).
respond_transfer1(offer_transfer(Kind, From, Given), Resp?, Ans?, card(offer_transfer(Kind?, From?, Given?), Answer), []) :- ground(Kind?), ground(From?), ground(Given?) | decide_transfer(Answer?, Kind?, From?, Given?, Resp, Ans).

procedure decide_transfer(YesNo?, Kind?, Key?, Stream(Instrument)?, TransferResponse, Stream(UserInMsg)).
decide_transfer(yes, Kind, From, Given, Resp?, Ans?) :- accept_transfer_answer(Kind?, From?, Given?, Resp, Ans).
decide_transfer(no, Kind, From, Given, Resp?, Ans?) :- decline_transfer_answer(Kind?, From?, Given?, Resp, Ans).

exported procedure agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?, Stream(Ask(Question))).
agent(S1, S2, S3, S4, S5, S6, S7, S8, S9, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- agent1(S1?, S2?, S3?, S4?, S5?, S6?, S7?, S8?, S9?, X?, D).

exported procedure agent1(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?, Stream(Request)?, Stream(Ask(Question))).
agent1(Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial, Reqs, D?) :- serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?, D).

procedure serve(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?, Stream(Ask(Question))).
serve(Reqs, Id, UserIn, [msg(From, Id1, Act) | PeerIn], Convs, Cal, Outs, Holdings, Date, Serial, D?) :- (Id? =?= Id1?), ground(From?) | on_act(Act?, From?, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?, D).
serve(Reqs, Id, UserIn, [_ | PeerIn], Convs, Cal, Outs, Holdings, Date, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?, D).
