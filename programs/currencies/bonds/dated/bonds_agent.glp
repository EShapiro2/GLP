on_act(mature(Bond, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial, D?) :- ground(Bond?) | grant(Bond?, Id?, Date?, Serial?, Resp, From?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, D).
