%% bonds_agent.vglp --- the bond agent of grassroots bonds, in vGLP.
%%
%% The program every participant runs, derived from the transactions of
%% Section 3.4 of "Grassroots Bonds: Financing by the People, for the People",
%% Definition "The Transactions of Grassroots Bonds" --- Mint, Advance, Swap,
%% Pay, Redeem, Deposit, Release and Return --- one clause each, guarded where
%% the transaction is guarded: Mint, Pay and Redeem by the one party whose
%% election they are, Mint in its two forms; Swap, Deposit, Release and Return
%% by both, the giver by its request clause and the receiver by a responder,
%% respond_swap or respond_transfer; Advance by no one, the calendar being a
%% stream the agent reads.  It extends the coins program
%% (programs/currencies/coins) by what dates add: a coin and a bond are two
%% instruments, a coin carrying no date and a bond its maturity; the agent
%% keeps its date; pay carries coins and reads no date; redeem presents a coin
%% or a matured bond of the issuer, against any coin or bond the issuer holds,
%% of the bearer's choice (clause 5), and the issuer tests a bond presented to
%% it by its own date, a bond not mature going back; and the three escrow
%% transfers are new.  Its canonical compilation (vGLP,
%% Definition "Canonical Compilation"), the agent with its dispatcher and
%% construct processes, is bonds_agent.glp beside this file (glpc :emit); the
%% compiled module is not edited.
%%
%% The syntax is vGLP's (Definition "Guarded Clause, Volitional Procedure,
%% Interactive Type, Interactive Term, Ordinary Clause, Procedure, vGLP
%% Program").  The agent is a volitional procedure whose question is the
%% stream of the person's requests, Stream(Request)?, of a union type with one
%% alternative per request; its one clause asks it, once, and passes it to
%% serve, ordinary GLP, which has one clause per alternative, each the clause
%% of its transaction reading its request at the head of the stream, and
%% carries the rest of the stream, Reqs?, through every helper that continues
%% the agent.  A swap takes two lots that differ, and a redemption an
%% instrument that is not the one presented (Definition "The Transactions of
%% Grassroots Bonds"): a binding at which a schema changes no state determines
%% no transaction (Appendix A), so the clause of each carries the difference in
%% its guard, and a second clause refuses the request whose lots are the same,
%% before anything is sent, the screen saying so.  A responder is a volitional
%% procedure whose interactive type, a card, is in writer mode: its clause
%% writes the card at once, the offer for
%% the person to see, and hands the person the writer of their answer, which a
%% helper reads with a clause per answer.
%%
%% The agent runs as a mini-app of the Grassroots Super-App (miniapp.glp) and
%% holds no network entry.  Two parties transact over the root channel of the
%% conversation the social graph opens between their two executions of this
%% program, at an invitation: the agent takes each conversation from the
%% social graph, and thereafter sends the acts of the contract on it.  An act
%% willed towards a party with whom no conversation is open is not sent: the
%% instruments stay, and the screen says so.
%%
%% The machine state of a party is its holdings, a multiset of coins and
%% bonds; its date; and the serial its next instrument takes.
%%
%% The types --- the requests and the cards among them --- and the helpers
%% over holdings, dates and conversations, are ../self.glp's.

%% =============================================================================
%% The swap responder: one goal per arriving proposal, so proposals pend
%% concurrently and are answered in any order.  Swap is guarded by both
%% parties; this is the counterparty's guard.
%% =============================================================================

procedure (SwapCard)*respond_swap(SwapOffer?, SwapResponse, Stream(UserInMsg)).

%% Show the person the offer, and pass their answer on.
(card(offer(From?, Want?, Offered?), Answer))*respond_swap(offer(From, Want, Offered), Resp?, Ans?) :-
    ground(From?), ground(Want?), ground(Offered?) |
    decide_swap(Answer?, From?, Want?, Offered?, Resp, Ans).

%% yes accepts: the agent gives the wanted instruments and takes the offered
%% ones, declining itself when it does not hold the wanted ones.  no is the
%% person's decline.
procedure decide_swap(YesNo?, Key?, Lot?, Stream(Instrument)?, SwapResponse, Stream(UserInMsg)).
decide_swap(yes, From, Want, Offered, Resp?, Ans?) :-
    accept_answer(From?, Want?, Offered?, Resp, Ans).
decide_swap(no, From, _, Offered, Resp?, Ans?) :-
    decline_answer(From?, Offered?, Resp, Ans).

%% =============================================================================
%% The transfer responder: the receiver's guard of a deposit, a release or a
%% return, each guarded by both participants (clause 7 of the contract).  At
%% the escrow agent the escrow program answers in place of the person.
%% =============================================================================

procedure (TransferCard)*respond_transfer(TransferOffer?, TransferResponse, Stream(UserInMsg)).

%% Show the person the transfer, and pass their answer on.
(card(offer_transfer(Kind?, From?, Given?), Answer))*respond_transfer(offer_transfer(Kind, From, Given), Resp?, Ans?) :-
    ground(Kind?), ground(From?), ground(Given?) |
    decide_transfer(Answer?, Kind?, From?, Given?, Resp, Ans).

%% yes accepts: the instruments are taken.  no is the person's decline.
procedure decide_transfer(YesNo?, Kind?, Key?, Stream(Instrument)?, TransferResponse, Stream(UserInMsg)).
decide_transfer(yes, Kind, From, Given, Resp?, Ans?) :-
    accept_transfer_answer(Kind?, From?, Given?, Resp, Ans).
decide_transfer(no, Kind, From, Given, Resp?, Ans?) :-
    decline_transfer_answer(Kind?, From?, Given?, Resp, Ans).

%% =============================================================================
%% The agent
%% =============================================================================
%%
%% agent(Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial): the
%% party's name; its own input; the input from counterparties; the
%% conversations the social graph hands it; the calendar, a stream of dates;
%% its outputs --- the screen and a channel per counterparty; and its machine state --- holdings and date --- and the
%% serial its next instrument takes.  Its question is the stream of
%% the person's requests.

exported procedure (Stream(Request)?)*agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?).

%% Ask the person for their requests, once, and serve them.
(Reqs)*agent(Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% serve(Reqs, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date,
%% Serial): the agent, with the rest of the person's requests.

procedure serve(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?).

%% --- Reactive: acts arriving from counterparties, on their conversations ---

%% An act on the conversation with From.
serve(Reqs, Id, UserIn, [msg(From, Id1, Act)|PeerIn], Convs, Cal, Outs, Holdings, Date, Serial) :-
    Id? =?= Id1?, ground(From?) |
    on_act(Act?, From?, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% Anything else from a counterparty is dropped.
serve(Reqs, Id, UserIn, [_|PeerIn], Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), otherwise |
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% --- Reactive: a conversation the social graph hands the agent ---

%% A conversation with Q opened: its channel is adopted --- the write side
%% becomes the output to Q, the read side joins the input from counterparties
%% --- and the screen shows it.
serve(Reqs, Id, UserIn, PeerIn, [conversation(Q, Ch)|Convs], Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?) |
    adopt(Q?, Ch?, Outs?, Outs1, PeerIn?, PeerIn1),
    show(opened(Q?), Outs1?, Outs2),
    serve(Reqs?, Id?, UserIn?, PeerIn1?, Convs?, Cal?, Outs2?, Holdings?, Date?, Serial?).

%% --- Reactive: the person's answers to swap and transfer offers, and the
%% results of the acts this agent proposed, on its own input ---

%% The person accepted a proposed swap (respond_swap): give the wanted
%% instruments and take the offered ones, if the wanted ones are held.
serve(Reqs, Id, [accept_swap(From, lot(V, D1, K1), Offered, Resp?)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(From?), ground(V?), ground(D1?), integer(K1?) |
    select_instruments(V?, D1?, K1?, Holdings?, Status, Give, Rest),
    fill_swap(Status?, Id?, From?, Resp, Give?, Offered?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Serial?).

%% The person declined one.
serve(Reqs, Id, [decline_swap(From, Offered, Resp?)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(From?) |
    decline(Resp, Offered?),
    show(declined(From?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% My proposal was accepted: the counterparty's instruments are mine.
serve(Reqs, Id, [swap_accepted(Q, Given)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(Given?) |
    append_instruments(Holdings?, Given?, Holdings1),
    show(swap_done(Q?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% My proposal was declined: my instruments come back.
serve(Reqs, Id, [swap_declined_by(Q, Given)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(Given?) |
    append_instruments(Holdings?, Given?, Holdings1),
    show(swap_declined(Q?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% My payment was taken: the payee's coins are its own.
serve(Reqs, Id, [pay_taken_by(Q, K)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), integer(K?) |
    show(paid(Q?, K?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% My payment was returned: the instruments were not the payee's coins.
serve(Reqs, Id, [pay_returned_by(Q, Coins)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(Coins?) |
    append_instruments(Holdings?, Coins?, Holdings1),
    count_instruments(Coins?, 0, K),
    show(not_accepted(Q?, K?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% My presentation was fulfilled: the instrument I chose is mine, and the
%% screen names the instrument I presented, of Q due D, and the one I took, of
%% R due D1.
serve(Reqs, Id, [redeem_given(Q, D, R, D1, X)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(D?), ground(R?), ground(D1?), ground(X?) |
    append_instruments(Holdings?, [X?], Holdings1),
    show(redeemed(Q?, D?, R?, D1?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% The issuer holds no instrument of the issuer and due I named: what I
%% presented is back, with the lots it does hold, to choose among.
serve(Reqs, Id, [redeem_menu_from(Q, X, Menu)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(X?), ground(Menu?) |
    append_instruments(Holdings?, [X?], Holdings1),
    show(menu(Q?, Menu?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% The bond I presented is not mature by its issuer's date: back, and nothing
%% is recorded, as no transaction took place.
serve(Reqs, Id, [redeem_not_mature_by(Q, bond(I, M, S))|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(I?), integer(M?), integer(S?) |
    append_instruments(Holdings?, [bond(I?, M?, S?)], Holdings1),
    show(not_mature(Q?, M?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% What I presented was neither the issuer's coin nor its bond: back.
serve(Reqs, Id, [redeem_declined_by(Q, X)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(X?) |
    append_instruments(Holdings?, [X?], Holdings1),
    show(refused(Q?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% The person accepted a proposed transfer (respond_transfer): the
%% instruments are taken.
serve(Reqs, Id, [accept_transfer(Kind, From, Given, Resp?)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Kind?), ground(From?), ground(Given?) |
    take_transfer(Resp),
    append_instruments(Holdings?, Given?, Holdings1),
    tally(Given?, [], Lots),
    show(received_transfer(Kind?, From?, Lots?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% The person declined one: the instruments go back.
serve(Reqs, Id, [decline_transfer(Kind, From, Given, Resp?)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Kind?), ground(From?) |
    decline_transfer_resp(Resp, Given?),
    show(declined_transfer(Kind?, From?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% My transfer was accepted: the instruments set aside for it are gone.
serve(Reqs, Id, [transfer_accepted(Kind, Q)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Kind?), ground(Q?) |
    show(transferred(Kind?, Q?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% My transfer was declined: my instruments come back.
serve(Reqs, Id, [transfer_declined_by(Kind, Q, Given)|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Kind?), ground(Q?), ground(Given?) |
    append_instruments(Holdings?, Given?, Holdings1),
    show(transfer_declined(Kind?, Q?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).

%% Anything else on the input is dropped.
serve(Reqs, Id, [_|UserIn], PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), otherwise |
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% --- Advance_p, guarded by no one: the calendar.  A date past the agent's
%% advances it by one day, the effect d'*_p = d*_p + 1, and stays at the head
%% of the calendar, so a date k days past the agent's is taken as k advances;
%% a date not past it is no transaction and is dropped.  In a headless run the
%% play writes the calendar; on a device the clock does. ---

serve(Reqs, Id, UserIn, PeerIn, Convs, [T|Cal], Outs, Holdings, Date, Serial) :-
    ground(Id?), T? > Date? |
    Date1 := Date? + 1,
    show(date_advanced(Date1?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, [T?|Cal?], Outs1?, Holdings?, Date1?, Serial?).

serve(Reqs, Id, UserIn, PeerIn, Convs, [T|Cal], Outs, Holdings, Date, Serial) :-
    ground(Id?), T? =< Date? |
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% --- Volitional: the transactions of Section 3.4 at the party whose election
%% they are, one clause per alternative of Request, each reading its request
%% at the head of the person's stream, after every otherwise clause of the
%% procedure. ---

%% Mint_p(k), guarded by p: c'_p = c_p + cent^k_p, k coins, carrying no date.
serve([mint(K)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), integer(K?), K? >= 1 |
    create_coins(Id?, K?, Serial?, New),
    Serial1 := Serial? + K?,
    append_instruments(Holdings?, New?, Holdings1),
    show(minted(K?, now), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial1?).

%% Mint_p(d, k), guarded by p: precondition d > d*_p, so no bond is born
%% mature; c'_p = c_p + cent^k_{p,d}.
serve([mint(K, D)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), integer(K?), K? >= 1, integer(D?), D? > Date? |
    create_bonds(Id?, D?, K?, Serial?, New),
    Serial1 := Serial? + K?,
    append_instruments(Holdings?, New?, Holdings1),
    show(minted(K?, D?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial1?).

%% Swap_{p,q}(cent^k_{u,*}, cent^{k'}_{v,*}), guarded by both, with the two
%% lots different: p proposes, giving one lot for another, coins or bonds, and
%% q answers by respond_swap.  The precondition at p, cent^k_{u,*} in c_p, is
%% the selection; q's part of it is q's.
serve([swap(Q, U, D, K, V, D1, K1)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(U?), ground(D?), integer(K?), K? >= 1,
    ground(V?), ground(D1?), integer(K1?), K1? >= 1,
    lot(U?, D?, K?) =?\= lot(V?, D1?, K1?) |
    select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest),
    propose_swap(Status?, Id?, Q?, lot(U?, D?, K?), lot(V?, D1?, K1?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Serial?).

%% A swap of a lot for the same lot changes no state, and is not a transaction
%% (Appendix A): refused before anything is sent, the screen saying so.
serve([swap(Q, U, D, K, V, D1, K1)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(U?), ground(D?), integer(K?), K? >= 1,
    ground(V?), ground(D1?), integer(K1?), K1? >= 1,
    lot(U?, D?, K?) =?= lot(V?, D1?, K1?) |
    show(swap_same(Q?, U?, D?, K?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% Pay_{p,q}(k), guarded by p: k q-coins to q, which q takes (clause 4 of the
%% contract).  Only coins are paid, and no date is read.  The precondition
%% cent^k_q in c_p is the selection.
serve([pay(Q, K)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), integer(K?), K? >= 1 |
    select_instruments(Q?, now, K?, Holdings?, Status, Give, Rest),
    do_pay(Status?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Serial?).

%% Redeem_{p,q}(x, r, *), guarded by p: x, a q-coin or a q-bond, due D,
%% presented to q for a coin or a bond of r that q holds, of p's choice
%% (clause 5), due D1, the instrument taken not x: each a lot of one, the two
%% lots different.  The precondition x in c_p is the selection; that a bond x
%% is mature by q's date, d <= d*_q, and cent_{r,*} in c_q are tested at q,
%% which discloses what it holds where the second fails.
serve([redeem(Q, D, R, D1)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(D?), ground(R?), ground(D1?),
    lot(Q?, D?, 1) =?\= lot(R?, D1?, 1) |
    take_instrument(Q?, D?, Holdings?, Found, Rest),
    do_redeem(Found?, Id?, Q?, D?, R?, D1?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Serial?).

%% A redemption of an instrument against one of its own issuer and due
%% changes no state, and is not a transaction (Appendix A): refused before
%% anything is sent, the screen saying so.
serve([redeem(Q, D, R, D1)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(D?), ground(R?), ground(D1?),
    lot(Q?, D?, 1) =?= lot(R?, D1?, 1) |
    show(redeem_same(Q?, D?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% Deposit_{p,e}(cent^k_{u,*}), guarded by both: p proposes the transfer to
%% the escrow agent e, which answers by respond_transfer.  The precondition
%% cent^k_{u,*} in c_p is the selection.
serve([deposit(E, U, D, K)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(E?), ground(U?), ground(D?), integer(K?), K? >= 1 |
    select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest),
    propose_transfer(Status?, deposit, Id?, E?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Serial?).

%% Release_{e,q}(cent^k_{u,*}), guarded by both: the escrow agent e proposes
%% the transfer to the beneficiary q, which answers by respond_transfer.
serve([release(Q, U, D, K)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(Q?), ground(U?), ground(D?), integer(K?), K? >= 1 |
    select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest),
    propose_transfer(Status?, release, Id?, Q?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Serial?).

%% Return_{e,p}(cent^k_{u,*}), guarded by both: the escrow agent e proposes
%% the transfer back to the depositor p, which answers by respond_transfer.
serve([return(P, U, D, K)|Reqs], Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Id?), ground(P?), ground(U?), ground(D?), integer(K?), K? >= 1 |
    select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest),
    propose_transfer(Status?, return, Id?, P?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Serial?).

%% =============================================================================
%% An arriving act, on the conversation it came on
%% =============================================================================

procedure on_act(PeerContent?, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?).

%% Pay_{p,q}(k) at q: q's own coins are taken, and no date is read.
on_act(pay(Coins, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Coins?) |
    own_coins(Id?, Coins?, Own),
    take_payment(Own?, Id?, From?, Coins?, Resp, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% Redeem_{p,q}(x, r, *) at q: the presented instrument is taken back and the
%% instrument named given, if the presented instrument is q's coin, or q's
%% bond mature by q's date, and the instrument named is held.
on_act(redeem(X, R, D1, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(X?), ground(R?), ground(D1?) |
    fulfil(X?, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% Swap at q: a responder poses it to the person; the answer reaches the agent
%% on its input.
on_act(swap(Want, Offered, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Want?), ground(Offered?) |
    respond_swap(offer(From?, Want?, Offered?), Resp, Ans),
    merge(Ans?, UserIn?, UserIn1),
    serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% A deposit, release or return at its receiver: a responder poses it to the
%% person --- at the escrow agent, to the escrow program.
on_act(transfer(Kind, Given, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Kind?), ground(Given?) |
    respond_transfer(offer_transfer(Kind?, From?, Given?), Resp, Ans),
    merge(Ans?, UserIn?, UserIn1),
    serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Serial?).

%% A payment of my own coins is taken; instruments that are not my coins are
%% no payment of clause 4, and go back.
procedure take_payment(Decision?, Key?, Key?, Stream(Instrument)?, PayResponse, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?).
take_payment(yes, Id, From, Coins, pay_taken, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Coins?) |
    append_instruments(Holdings?, Coins?, Holdings1),
    count_instruments(Coins?, 0, K),
    show(received(From?, K?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).
take_payment(no, Id, From, Coins, pay_returned(Coins?), Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Coins?) |
    count_instruments(Coins?, 0, K),
    show(refused_payment(From?, K?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% A presentation: my coin, or my bond mature by my date, d <= d*_q, is taken
%% back and the instrument named given, if held, the screen naming the due of
%% the instrument presented, `now` for my coin and the maturity for my bond;
%% else what was presented goes back with the lots I hold.  My bond not mature
%% by my date goes back, and nothing is recorded, as no transaction took
%% place.  Anything but my coin or my bond goes back.
procedure fulfil(Instrument?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?).
fulfil(coin(I, S), R, D1, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    I? =?= Id? |
    take_instrument(R?, D1?, Holdings?, Found, Rest),
    give(Found?, coin(I?, S?), now, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Rest?, Date?, Serial?).
fulfil(bond(I, M, S), R, D1, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    I? =?= Id?, M? =< Date? |
    take_instrument(R?, D1?, Holdings?, Found, Rest),
    give(Found?, bond(I?, M?, S?), M?, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Rest?, Date?, Serial?).
fulfil(bond(I, M, S), _, _, redeem_not_mature(bond(I?, M?, S?)), Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    I? =?= Id?, M? > Date? |
    show(not_mature_for(From?, M?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).
fulfil(X, _, _, redeem_declined(X?), Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    otherwise |
    show(refused(From?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

procedure give(Found?, Instrument?, Constant?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?).
give(found(X), Mine, D, R, D1, redeem_give(X?), Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Rest, Date, Serial) :-
    append_instruments(Rest?, [Mine?], Holdings1),
    show(presented(From?, D?, R?, D1?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).
give(not_found, Mine, _, R, D1, redeem_menu(Mine?, Menu?), Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Rest, Date, Serial) :-
    ground(Rest?) |
    menu_of(Id?, Rest?, [], Menu),
    show(unfulfilled(From?, R?, D1?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Serial?).

%% An accepted swap is filled: the wanted instruments go and the offered ones
%% come; wanted instruments not held decline it.
procedure fill_swap(Status?, Key?, Key?, SwapResponse, Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
fill_swap(ok, Id, From, swap_accept(Give?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Rest?, Offered?, Holdings1),
    show(swap_done(From?), Outs?, Outs1),
    after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Serial?).
fill_swap(fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Give?, Rest?, Orig),
    show(swap_failed(From?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% =============================================================================
%% The acts this agent proposes, each on the conversation with its counterparty
%% =============================================================================

%% Swap: the proposal, with the instruments given set aside until the answer.
procedure propose_swap(Status?, Key?, Key?, Lot?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
propose_swap(ok, Id, Q, _, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Q?), ground(Want?), ground(Give?) |
    has_peer(Q?, Outs?, Outs1, Known),
    send_swap(Known?, Id?, Q?, Want?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Serial?).
propose_swap(fail, Id, _, lot(U, D, K), _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Give?, Rest?, Orig),
    show(lacking(U?, D?, K?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% On the conversation with Q, holding the instruments given until Q answers;
%% with no conversation open, the instruments stay.
procedure send_swap(Decision?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
send_swap(yes, Id, Q, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Q?) |
    send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1),
    inject_swap_result(Resp?, Q?, UserIn?, UserIn1),
    after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Serial?).
send_swap(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Give?, Rest?, Orig),
    show(no_conversation(Q?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% A deposit, release or return: the proposal, with the instruments given set
%% aside until the answer.
procedure propose_transfer(Status?, Kind?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
propose_transfer(ok, Kind, Id, Q, Lot, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Kind?), ground(Q?), ground(Lot?), ground(Give?) |
    has_peer(Q?, Outs?, Outs1, Known),
    send_transfer(Known?, Kind?, Id?, Q?, Lot?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Serial?).
propose_transfer(fail, _, Id, _, lot(U, D, K), Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Give?, Rest?, Orig),
    show(lacking(U?, D?, K?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% On the conversation with Q; with no conversation open, the instruments
%% stay.
procedure send_transfer(Decision?, Kind?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
send_transfer(yes, Kind, Id, Q, Lot, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Kind?), ground(Q?) |
    send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1),
    inject_transfer_result(Resp?, Kind?, Q?, UserIn?, UserIn1),
    show(offered_transfer(Kind?, Q?, Lot?), Outs1?, Outs2),
    after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Serial?).
send_transfer(no, _, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Give?, Rest?, Orig),
    show(no_conversation(Q?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% Pay: the coins go to Q, set aside until Q answers.
procedure do_pay(Status?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
do_pay(ok, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Q?) |
    has_peer(Q?, Outs?, Outs1, Known),
    send_pay(Known?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Serial?).
do_pay(fail, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Give?, Rest?, Orig),
    show(lacking(Q?, now, K?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% On the conversation with Q; with no conversation open, the coins stay.
procedure send_pay(Decision?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
send_pay(yes, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Q?) |
    send_friend(Q?, msg(Id?, Q?, pay(Give?, Resp)), Outs?, Outs1),
    inject_pay_result(Resp?, Q?, K?, UserIn?, UserIn1),
    show(paying(Q?, K?), Outs1?, Outs2),
    after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Serial?).
send_pay(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Give?, Rest?, Orig),
    show(no_conversation(Q?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% Redeem: the coin or the bond is presented to Q, with the issuer and due
%% wanted, and its own due D kept for the screen; holding none of Q due D, the
%% bearer presents nothing.
procedure do_redeem(Found?, Key?, Key?, Constant?, Key?, Constant?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
do_redeem(found(X), Id, Q, D, R, D1, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Q?) |
    has_peer(Q?, Outs?, Outs1, Known),
    send_redeem(Known?, Id?, Q?, D?, R?, D1?, X?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Serial?).
do_redeem(not_found, Id, Q, D, _, _, Holdings, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    show(lacking(Q?, D?, 1), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).

%% On the conversation with Q; with no conversation open, the instrument
%% stays.
procedure send_redeem(Decision?, Key?, Key?, Constant?, Key?, Constant?, Instrument?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Integer?).
send_redeem(yes, Id, Q, D, R, D1, X, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    ground(Q?) |
    send_friend(Q?, msg(Id?, Q?, redeem(X?, R?, D1?, Resp)), Outs?, Outs1),
    inject_redeem_result(Resp?, Q?, D?, R?, D1?, UserIn?, UserIn1),
    after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Serial?).
send_redeem(no, Id, Q, _, _, _, X, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Serial) :-
    append_instruments(Rest?, [X?], Orig),
    show(no_conversation(Q?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Serial?).

%% After a change of holdings: the screen shows them, and the agent continues.
procedure after_change(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?).
after_change(Reqs, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Serial) :-
    ground(Holdings?) |
    tally(Holdings?, [], Lots),
    show(holdings(Lots?), Outs?, Outs1),
    serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Serial?).
