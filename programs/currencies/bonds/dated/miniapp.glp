%% miniapp.glp --- the bonds program as a mini-app of the Grassroots Super-App
%% (Grassroots Social Graph paper, Section 3).
%%
%% bonds(Id, Ui, Convs) is the goal the super-app activates by run/3, with
%% exactly its two channels.  Ui is the person channel (vGLP, Definition
%% "Person Channel, Person Writer, GLP with Persons, Grant"): on it the
%% mini-app receives the person's grants, input(Id, P, R), and shows the
%% constructs its dispatcher draws and withdraws and the screen of its agent.
%% Convs is the channel to the social graph, on which the social graph hands
%% the mini-app, at each invitation, one end of the root channel of a
%% conversation with the execution of this program at a friend.  The mini-app
%% holds nothing else --- no network entry, and no call to a predicate that
%% reaches the network or the person --- so the program is certified.
%%
%% bonds/4 is the same with the agent's calendar, a stream of dates, which on
%% a device the clock writes and which the headless plays write themselves
%% (../village.glp, ../credit_line.glp, the instruments' plays, plays.glp).
%% The super-app grants the two channels and no clock, so bonds/3 gives the
%% agent an empty calendar: its date stands at 0, so a bond it mints matures
%% on a date later than 0, and no bond of its own is mature by its date.

imported procedure bonds_agent#agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Integer?, Stream(Ask(Question))).
imported procedure bonds_agent#dispatch(Stream(Ask(Question))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(Output))).

%% The mini-app the super-app activates: no clock, so no date ever advances.
exported procedure bonds(Key?, Channel(PersonIn, Stream(_))?, Stream(Conversation)?).
bonds(Id, Ui, Convs) :- bonds(Id?, Ui?, Convs?, []).

%% The agent with its dispatcher, the calls of the canonical compilation
%% (vGLP, Definition "Canonical Compilation"): the agent starts with no
%% holdings, date 0, serial 1, no conversation and its screen, and its asks
%% go to the dispatcher, which reads the person channel; the screen goes to
%% the person on the dispatcher's channel to the program, which merges it with
%% the constructs' draws.
exported procedure bonds(Key?, Channel(PersonIn, Stream(_))?, Stream(Conversation)?, Stream(Integer)?).
bonds(Id, Ui, Convs, Cal) :-
    ground(Id?) |
    bonds_agent # agent(Id?, [], [], Convs?, Cal?, [user_output(Screen)], [], 0, 1, Asks),
    bonds_agent # dispatch(Asks?, Ui?, MCh),
    show_screen(MCh?, Screen?).

%% The screen, onto the program's output to the person, which the
%% dispatcher's channel to the program carries as any term; the person's
%% input other than grants is not read.
procedure show_screen(Channel(Stream(_), Stream(Output))?, Stream(ScreenMsg)?).
show_screen(ch(_, Out?), Screen) :- relay(Screen?, Out).

%% Each message as it comes, its content: the envelope msg(agent, person, C)
%% stripped (Currencies, 2026-10-14 08:48 UTC, item 2).
procedure relay(Stream(ScreenMsg)?, Stream(Output)).
relay([msg(_, _, C)|Ms], [C?|Out?]) :- relay(Ms?, Out).
relay([], []).
