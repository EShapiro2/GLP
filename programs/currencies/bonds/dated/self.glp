%% dated/self.glp --- the bonds program as a certified program of its own: the
%% bond agent (bonds_agent.vglp, its compilation bonds_agent.glp), the
%% mini-app entry bonds/3 (miniapp.glp), a scripted person (person.glp) with
%% the escrow programs it answers by (escrow.glp), and the plays that activate
%% the mini-app by run/3 (plays.glp); the types and the helpers are the
%% parent's (../self.glp, an ancestor scope).  It is a program of its own
%% because the certificate of a program is refused where any entry point
%% reaches the person or the network, and the parent's plays do
%% (send_to_user/1): loaded here, without them, the program is certified, and
%% its module value is the mini-app the super-app installs and activates by
%% run/3.  The parent's plays (../village.glp, ../credit_line.glp and the
%% instruments' plays) call bonds/4, the mini-app with its calendar, and the
%% scripted person/7 through this directory, which exports both (TGLP
%% modules.tex: a qualifier is a single child directory, entered through its
%% self.glp).

imported procedure miniapp#bonds(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?).
exported procedure bonds(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?).
bonds(Id, Ui, Convs) :- miniapp # bonds(Id?, Ui?, Convs?).

imported procedure miniapp#bonds(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?).
exported procedure bonds(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?).
bonds(Id, Ui, Convs, Cal) :- miniapp # bonds(Id?, Ui?, Convs?, Cal?).

imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(PeerMsg)?, Stream(Integer)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(PeerMsg)?, Stream(Integer)?).
miniapp(Id, Ui, Sg, Cal) :- miniapp # miniapp(Id?, Ui?, Sg?, Cal?).

imported procedure person#person(Key?, PersonOut(Drawn)?, PersonIn(Drawn), Stream(Integer), Script?, Agreement?, Stream(ScreenContent)).
exported procedure person(Key?, PersonOut(Drawn)?, PersonIn(Drawn), Stream(Integer), Script?, Agreement?, Stream(ScreenContent)).
person(Id, Draws, Grants?, Cal?, Script, Ag, Screen?) :- person # person(Id?, Draws?, Grants, Cal, Script?, Ag?, Screen).

imported procedure plays#miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(ScreenContent)).
exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(ScreenContent)).
miniapp_person(Id, Role, Ps, PEnd, Screen?) :- plays # miniapp_person(Id?, Role?, Ps?, PEnd?, Screen).

imported procedure plays#play_mint(Stream(ScreenContent)).
exported procedure play_mint(Stream(ScreenContent)).
play_mint(S?) :- plays # play_mint(S).

imported procedure plays#play_swap(Stream(ScreenContent), Stream(ScreenContent)).
exported procedure play_swap(Stream(ScreenContent), Stream(ScreenContent)).
play_swap(A?, B?) :- plays # play_swap(A, B).

imported procedure plays#play_same(Stream(ScreenContent), Stream(ScreenContent)).
exported procedure play_same(Stream(ScreenContent), Stream(ScreenContent)).
play_same(A?, B?) :- plays # play_same(A, B).

%% =============================================================================
%% The agent's initial goal
%% =============================================================================

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel
%% first and the network channel second (GLP-Spec maglp.tex, Definition
%% "Multiagent GLP"), on a phone as in a simulation (IGLP, Implementation
%% Notes, "Boot": "a deployed agent is spawned by its application with the same
%% initial goal"), as the coins and the sovereign programs answer it
%% (../../coins/self.glp, ../../sovereign/self.glp).  self_key/1 first makes
%% the agent's key, before which nothing is sent on the network (GLP-Spec
%% appendix-guards.tex, "Identity and signature").  The person's first act
%% names the entry the plays start, bonds/3 (plays.glp), and carries its
%% argument: bonds(Me), the agent's own key (IGLP, "Boot"; Remark "Agent
%% Names": a readable name is a variable standing for a key).  The person's
%% acts after the first are the grants of the mini-app's person channel, and
%% what its dispatcher draws goes out on the agent's person channel.  The
%% mini-app's conversations are the root channels the super-app hands it
%% (miniapp/4 above); the agent alone has none, and its network input is not
%% read.
DatedNet    ::= Stream(NetMsg(PeerMsg)).
DatedAct    ::= bonds(Key).
DatedIn     ::= [] ; [DatedAct | DatedGrants].
DatedGrants ::= [] ; [Input(Drawn) | DatedGrants].

exported procedure agent(Channel(DatedIn, PersonOut(Drawn))?, Channel(DatedNet, DatedNet)?).
agent(ch(In, Out?), ch(_, [])) :- self_key(_), dated_start(In?, Out).

%% The entry the person's first act names, its draws onto the person channel,
%% which never closes: where the person's stream closes before the first act,
%% nothing is drawn, on a fresh channel nothing writes.
procedure dated_start(DatedIn?, PersonOut(Drawn)).
dated_start([bonds(Me) | Gs], Draws?) :-
    person_grants(Gs?, Grants),
    bonds(Me?, ch(Grants?, Draws), []).
dated_start([], Draws?) :- new_channel(A, B), hold_draws(A?, B?, Draws).

procedure hold_draws(Channel(PersonIn(Drawn), PersonOut(Drawn))?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, PersonOut(Drawn)).
hold_draws(ch([_ | Gs], Ds?), B, Out?) :- hold_draws(ch(Gs?, Ds), B?, Out).

%% The person's grants after the first act, onto the mini-app's person
%% channel, which never closes (vGLP, Definition "Person Channel, Person
%% Writer, GLP with Persons, Grant"): where the person's stream closes, no
%% grant comes again, and the channel's grants are held for good, on a fresh
%% channel nothing writes.
procedure person_grants(DatedGrants?, PersonIn(Drawn)).
person_grants([G | Gs], [G? | Ps?]) :- person_grants(Gs?, Ps).
person_grants([], Ps?) :- new_channel(A, B), hold_grants(A?, B?, Ps).

procedure hold_grants(Channel(PersonOut(Drawn), PersonIn(Drawn))?, Channel(PersonIn(Drawn), PersonOut(Drawn))?, PersonIn(Drawn)).
hold_grants(ch([_ | Ds], Gs?), B, Ps?) :- hold_grants(ch(Ds?, Gs), B?, Ps).
