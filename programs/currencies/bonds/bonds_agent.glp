Question ::= swapCard_w(SwapCard) ; transferCard_w(TransferCard) ; stream_request_r(Stream(Request)?).

procedure respond_swap(SwapOffer?, Link?, SwapResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_swap(S1, S2, S3?, S4?, [ask('SwapCard', swapCard_w(X?)) | D?]) :- respond_swap1(S1?, S2?, S3, S4, X, D).

procedure respond_swap1(SwapOffer?, Link?, SwapResponse, Stream(UserInMsg), SwapCard, Stream(Ask(Question))).
respond_swap1(offer(From, Want, Offered), Link, Resp?, Ans?, card(offer(From?, Want?, Offered?), Answer), []) :- ground(From?), ground(Want?), ground(Offered?) | decide_swap(Answer?, From?, Want?, Offered?, Resp, Link?, Ans).

procedure decide_swap(YesNo?, Key?, Lot?, Stream(Instrument)?, SwapResponse, Link?, Stream(UserInMsg)).
decide_swap(yes, From, Want, Offered, Resp?, Link, Ans?) :- accept_answer(From?, Want?, Offered?, Resp, Link?, Ans).
decide_swap(no, From, _, Offered, Resp?, Link, Ans?) :- decline_answer(From?, Offered?, Resp, Link?, Ans).

procedure respond_transfer(TransferOffer?, Link?, TransferResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_transfer(S1, S2, S3?, S4?, [ask('TransferCard', transferCard_w(X?)) | D?]) :- respond_transfer1(S1?, S2?, S3, S4, X, D).

procedure respond_transfer1(TransferOffer?, Link?, TransferResponse, Stream(UserInMsg), TransferCard, Stream(Ask(Question))).
respond_transfer1(offer_transfer(Kind, From, Given), Link, Resp?, Ans?, card(offer_transfer(Kind?, From?, Given?), Answer), []) :- ground(Kind?), ground(From?), ground(Given?) | decide_transfer(Answer?, Kind?, From?, Given?, Resp, Link?, Ans).

procedure decide_transfer(YesNo?, Kind?, Key?, Stream(Instrument)?, TransferResponse, Link?, Stream(UserInMsg)).
decide_transfer(yes, Kind, From, Given, Resp?, Link, Ans?) :- accept_transfer_answer(Kind?, From?, Given?, Resp, Link?, Ans).
decide_transfer(no, Kind, From, Given, Resp?, Link, Ans?) :- decline_transfer_answer(Kind?, From?, Given?, Resp, Link?, Ans).

exported procedure agent(Key?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
agent(S1, S2, S3, S4, S5, S6, S7, S8, S9, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- agent1(S1?, S2?, S3?, S4?, S5?, S6?, S7?, S8?, S9?, X?, D).

exported procedure agent1(Key?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Request)?, Stream(Ask(Question))).
agent1(Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, Reqs, D?) :- serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D).

procedure serve(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
serve(Reqs, Id, UserIn, [msg(Id1, call(From, Act, Ch)) | NetIn], Cal, Outs, Holdings, Date, Ws, Serial, D?) :- (Id? =?= Id1?), ground(From?) | on_act(Act?, link(Ch?), From?, Id?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, UserIn, [msg(From, Id1, Act) | NetIn], Cal, Outs, Holdings, Date, Ws, Serial, D?) :- (Id? =?= Id1?), ground(From?) | on_act(Act?, linked, From?, Id?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, UserIn, [_ | NetIn], Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [accept_swap(From, lot(V, D1, K1), Offered, Resp?, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(From?), ground(V?), ground(D1?), integer(K1?) | select_instruments(V?, D1?, K1?, Holdings?, Status, Give, Rest), fill_swap(Status?, Id?, From?, Resp, Give?, Offered?, Rest?, Link?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [decline_swap(From, Offered, Resp?, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(From?) | decline(Resp, Offered?), drop_link(Link?), show(declined(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [swap_accepted(Q, Given, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(Given?) | adopt(Link?, Q?, Outs?, Outs1, NetIn?, NetIn1), append_instruments(Holdings?, Given?, Holdings1), show(swap_done(Q?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn?, NetIn1?, Cal?, Outs2?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [swap_declined_by(Q, Given, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(Given?) | drop_link(Link?), append_instruments(Holdings?, Given?, Holdings1), show(swap_declined(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [pay_taken_by(Q, K) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), integer(K?) | show(paid(Q?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [pay_returned_by(Q, Coins) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(Coins?) | append_instruments(Holdings?, Coins?, Holdings1), count_instruments(Coins?, 0, K), show(not_accepted(Q?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [redeem_given(Q, R, D1, X) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(R?), ground(D1?), ground(X?) | append_instruments(Holdings?, [X?], Holdings1), show(redeemed(Q?, R?, D1?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [redeem_menu_from(Q, Coin, Menu) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(Coin?), ground(Menu?) | append_instruments(Holdings?, [Coin?], Holdings1), show(menu(Q?, Menu?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [redeem_declined_by(Q, Coin) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(Coin?) | append_instruments(Holdings?, [Coin?], Holdings1), show(refused(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [matured_by(Q, D, Coin, T) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D1?) :- ground(Id?), ground(Q?), integer(D?), ground(Coin?), integer(T?) | append_instruments(Holdings?, [Coin?], Holdings1), add_warranty(Q?, T?, Ws?, Ws1), show(matured(Q?, D?), Outs?, Outs1), show(warranty(Q?, T?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs2?, Holdings1?, Date?, Ws1?, Serial?, D1).
serve(Reqs, Id, [not_matured_by(Q, bond(I, M, S)) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(I?), integer(M?), integer(S?) | append_instruments(Holdings?, [bond(I?, M?, S?)], Holdings1), show(not_mature(Q?, M?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [accept_transfer(Kind, From, Given, Resp?, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Kind?), ground(From?), ground(Given?) | take_transfer(Resp), adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), append_instruments(Holdings?, Given?, Holdings1), tally(Given?, [], Lots), show(received_transfer(Kind?, From?, Lots?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn?, NetIn1?, Cal?, Outs2?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [decline_transfer(Kind, From, Given, Resp?, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Kind?), ground(From?) | decline_transfer_resp(Resp, Given?), drop_link(Link?), show(declined_transfer(Kind?, From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [transfer_accepted(Kind, Q, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Kind?), ground(Q?) | adopt(Link?, Q?, Outs?, Outs1, NetIn?, NetIn1), show(transferred(Kind?, Q?), Outs1?, Outs2), serve(Reqs?, Id?, UserIn?, NetIn1?, Cal?, Outs2?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [transfer_declined_by(Kind, Q, Given, Link) | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Kind?), ground(Q?), ground(Given?) | drop_link(Link?), append_instruments(Holdings?, Given?, Holdings1), show(transfer_declined(Kind?, Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, [_ | UserIn], NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D).
serve(Reqs, Id, UserIn, NetIn, [T | Cal], Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), (T? > Date?) | show(date_advanced(T?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, T?, Ws?, Serial?, D).
serve(Reqs, Id, UserIn, NetIn, [T | Cal], Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), (T? =< Date?) | serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D).
serve([mint(K) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), integer(K?), (K? >= 1) | create_coins(Id?, K?, Serial?, New), Serial1 := (Serial? + K?), append_instruments(Holdings?, New?, Holdings1), show(minted(K?, now), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial1?, D).
serve([mint(K, D) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D1?) :- ground(Id?), integer(K?), (K? >= 1), integer(D?), (D? > Date?) | create_bonds(Id?, D?, K?, Serial?, New), Serial1 := (Serial? + K?), append_instruments(Holdings?, New?, Holdings1), show(minted(K?, D?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial1?, D1).
serve([swap(Q, U, D, K, V, D1, K1) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D2?) :- ground(Id?), ground(Q?), ground(U?), ground(D?), integer(K?), (K? >= 1), ground(V?), ground(D1?), integer(K1?), (K1? >= 1) | select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest), propose_swap(Status?, Id?, Q?, lot(U?, D?, K?), lot(V?, D1?, K1?), Give?, Rest?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Date?, Ws?, Serial?, D2).
serve([pay(Q, K) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), integer(K?), (K? >= 1) | select_instruments(Q?, now, K?, Holdings?, Status, Give, Rest), do_pay(Status?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Date?, Ws?, Serial?, D).
serve([redeem(Q, R, D1) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Id?), ground(Q?), ground(R?), ground(D1?) | take_instrument(Q?, now, Holdings?, Found, Rest), do_redeem(Found?, Id?, Q?, R?, D1?, Rest?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Date?, Ws?, Serial?, D).
serve([mature(Q, D) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D1?) :- ground(Id?), ground(Q?), integer(D?) | take_bond(Q?, D?, Holdings?, Found, Rest), do_mature(Found?, Id?, Q?, D?, Rest?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Date?, Ws?, Serial?, D1).
serve([deposit(E, U, D, K) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D1?) :- ground(Id?), ground(E?), ground(U?), ground(D?), integer(K?), (K? >= 1) | select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest), propose_transfer(Status?, deposit, Id?, E?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Date?, Ws?, Serial?, D1).
