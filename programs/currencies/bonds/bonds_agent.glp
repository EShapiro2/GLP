do_redeem(Med, found(Coin), Id, Q, R, D1, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | med_split(Med?, Medb, Medr), has_peer(Q?, Outs?, Outs1, Known), send_owed(Medb?, Known?, Id?, Q?, redeem(Coin?, R?, D1?, Resp), Outs1?, Outs2, NetIn?, NetIn1), inject_redeem_result(Resp?, Q?, R?, D1?, UserIn?, UserIn1), after_change(Medr?, Id?, UserIn1?, NetIn1?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?).
do_redeem(Med, not_found, Id, Q, _, _, Holdings, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- show(lacking(Q?, now, 1), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none, none, none).

procedure do_mature(Channel(Closed, Stream(AgentMsg))?, Found?, Constant?, Constant?, Integer?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
do_mature(Med, found(Bond), Id, Q, D, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | med_split(Med?, Medb, Medr), has_peer(Q?, Outs?, Outs1, Known), send_owed(Medb?, Known?, Id?, Q?, mature(Bond?, Resp), Outs1?, Outs2, NetIn?, NetIn1), inject_mature_result(Resp?, Q?, D?, UserIn?, UserIn1), after_change(Medr?, Id?, UserIn1?, NetIn1?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?).
do_mature(Med, not_found, Id, Q, D, Holdings, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- show(lacking(Q?, D?, 1), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none, none, none).

procedure send_owed(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, PeerContent?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
send_owed(_, yes, Id, Q, Act, Outs, Outs1?, NetIn, NetIn?) :- send_friend(Q?, msg(Id?, Q?, Act?), Outs?, Outs1).
send_owed(_, no, Id, Q, Act, Outs, Outs2?, NetIn, NetIn1?) :- ground(Q?), new_channel(TheirEnd, MyEnd) | send_net(msg(Q?, call(Id?, Act?, TheirEnd?)), Outs?, Outs1), adopt(link(MyEnd?), Q?, Outs1?, Outs2, NetIn?, NetIn1).

procedure after_change(Channel(Closed, Stream(AgentMsg))?, Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?).
after_change(Med, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none, none, none).

%% --- the mediator, and the pending table with the program's clauses ahead of the search clauses ---
exported procedure med(Channel(Stream(UserAnswer), Stream(Card))?, Channel(Stream(AgentMsg), Closed)?, PendingList?, Integer?).
med(UserCh, AgentCh, Ps, N) :- receive(ask(C, Ctx, Esc, Id?), AgentCh?, AgentCh1), ground(C?), ground(Ctx?) | Id = req(N?), send(card(C?, Ctx?, req(N?)), UserCh?, UserCh1), N1 := (N? + 1), med(UserCh1?, AgentCh1?, [pending(req(N?), Esc?) | Ps?], N1?).
med(UserCh, AgentCh, Ps, N) :- receive(answer(ReqId, Vs), UserCh?, UserCh1), ground(ReqId?), ground(Vs?) | answer(ReqId?, Vs?, Ps?, Ps1), send(closed(ReqId?), UserCh1?, UserCh2), med(UserCh2?, AgentCh?, Ps1?, N?).
med(UserCh, AgentCh, Ps, N) :- receive(decline(ReqId), UserCh?, UserCh1), ground(ReqId?) | close(ReqId?, Ps?, Ps1), send(closed(ReqId?), UserCh1?, UserCh2), med(UserCh2?, AgentCh?, Ps1?, N?).
med(UserCh, AgentCh, Ps, N) :- receive(abort(ReqId), AgentCh?, AgentCh1), ground(ReqId?) | drop(ReqId?, Ps?, Ps1), send(aborted(ReqId?), UserCh?, UserCh1), med(UserCh1?, AgentCh1?, Ps1?, N?).

exported procedure answer(ReqId?, Answer?, PendingList?, PendingList).
answer(ReqId, xs_respond_swap_1(X1), [pending(Id, esc_respond_swap_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_swap_1(X1?)).
answer(ReqId, xs_respond_transfer_1(X1), [pending(Id, esc_respond_transfer_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_transfer_1(X1?)).
answer(ReqId, xs_agent_1(X1), [pending(Id, esc_agent_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_1(X1?)).
answer(ReqId, xs_agent_2(X1, X2), [pending(Id, esc_agent_2(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_2(X1?, X2?)).
answer(ReqId, xs_agent_3(X1, X2, X3, X4, X5, X6, X7), [pending(Id, esc_agent_3(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_3(X1?, X2?, X3?, X4?, X5?, X6?, X7?)).
answer(ReqId, xs_agent_4(X1, X2), [pending(Id, esc_agent_4(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_4(X1?, X2?)).
answer(ReqId, xs_agent_5(X1, X2, X3), [pending(Id, esc_agent_5(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_5(X1?, X2?, X3?)).
answer(ReqId, xs_agent_6(X1, X2), [pending(Id, esc_agent_6(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_6(X1?, X2?)).
answer(ReqId, xs_agent_7(X1, X2, X3, X4), [pending(Id, esc_agent_7(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_7(X1?, X2?, X3?, X4?)).
answer(ReqId, xs_agent_8(X1, X2, X3, X4), [pending(Id, esc_agent_8(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_8(X1?, X2?, X3?, X4?)).
answer(ReqId, xs_agent_9(X1, X2, X3, X4), [pending(Id, esc_agent_9(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_9(X1?, X2?, X3?, X4?)).
answer(ReqId, Vs, [P | Ps], [P? | Ps1?]) :- otherwise | answer(ReqId?, Vs?, Ps?, Ps1).
answer(_, _, [], []).

exported procedure close(ReqId?, PendingList?, PendingList).
close(ReqId, [pending(Id, esc_respond_swap_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = else.
close(ReqId, [pending(Id, esc_respond_transfer_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = else.
close(ReqId, [P | Ps], [P? | Ps1?]) :- otherwise | close(ReqId?, Ps?, Ps1).
close(_, [], []).

exported procedure drop(ReqId?, PendingList?, PendingList).
drop(ReqId, [pending(Id, _) | Ps], Ps?) :- (ReqId? =?= Id?) | true.
drop(ReqId, [P | Ps], [P? | Ps1?]) :- otherwise | drop(ReqId?, Ps?, Ps1).
drop(_, [], []).

exported procedure(R) abort(Slot(R)?, Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg))).
abort(none, Med, Med?).
abort(ask(_, Id), Med, Med1?) :- ground(Id?) | send(abort(Id?), Med?, Med1).

exported procedure med_split(Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg)), Channel(Closed, Stream(AgentMsg))).
med_split(ch(_, Out?), ch([], O1), ch([], O2)) :- merge(O1?, O2?, Out).

