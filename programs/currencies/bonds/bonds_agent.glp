serve([return(P, U, D, K) | Reqs], Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D1?) :- ground(Id?), ground(P?), ground(U?), ground(D?), integer(K?), (K? >= 1) | select_instruments(U?, D?, K?, Holdings?, Status, Give, Rest), propose_transfer(Status?, return, Id?, P?, lot(U?, D?, K?), Give?, Rest?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Date?, Ws?, Serial?, D1).

procedure on_act(PeerContent?, Link?, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
on_act(pay(Coins, Resp?), Link, From, Id, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Coins?) | adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), own_coins(Id?, Coins?, Own), take_payment(Own?, Id?, From?, Coins?, Resp, Reqs?, UserIn?, NetIn1?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).
on_act(redeem(Coin, R, D1, Resp?), Link, From, Id, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Coin?), ground(R?), ground(D1?) | adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), fulfil(Coin?, R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, NetIn1?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).
on_act(mature(Bond, Resp?), Link, From, Id, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Bond?) | adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), grant(Bond?, Id?, Date?, Serial?, Resp, From?, Reqs?, UserIn?, NetIn1?, Cal?, Outs1?, Holdings?, Ws?, D).
on_act(swap(Want, Offered, Resp?), Link, From, Id, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Want?), ground(Offered?) | respond_swap(offer(From?, Want?, Offered?), Link?, Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D2), merge(D1?, D2?, D).
on_act(transfer(Kind, Given, Resp?), Link, From, Id, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Kind?), ground(Given?) | respond_transfer(offer_transfer(Kind?, From?, Given?), Link?, Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, D2), merge(D1?, D2?, D).

procedure take_payment(Decision?, Key?, Key?, Stream(Instrument)?, PayResponse, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
take_payment(yes, Id, From, Coins, pay_taken, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Coins?) | append_instruments(Holdings?, Coins?, Holdings1), count_instruments(Coins?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
take_payment(no, Id, From, Coins, pay_returned(Coins?), Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Coins?) | count_instruments(Coins?, 0, K), show(refused_payment(From?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).

procedure fulfil(Instrument?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
fulfil(coin(I, S), R, D1, Resp?, Id, From, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- (I? =?= Id?) | take_instrument(R?, D1?, Holdings?, Found, Rest), give(Found?, coin(I?, S?), R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, NetIn?, Cal?, Outs?, Rest?, Date?, Ws?, Serial?, D).
fulfil(X, _, _, redeem_declined(X?), Id, From, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- otherwise | show(refused(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).

procedure give(Found?, Instrument?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
give(found(X), Mine, R, D1, redeem_give(X?), Id, From, Reqs, UserIn, NetIn, Cal, Outs, Rest, Date, Ws, Serial, D?) :- append_instruments(Rest?, [Mine?], Holdings1), show(presented(From?, R?, D1?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?, D).
give(not_found, Mine, R, D1, redeem_menu(Mine?, Menu?), Id, From, Reqs, UserIn, NetIn, Cal, Outs, Rest, Date, Ws, Serial, D?) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?, D1?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Rest?, Date?, Ws?, Serial?, D).

procedure grant(Instrument?, Key?, Integer?, Integer?, MatureResponse, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Stream(Warranty)?, Stream(Ask(Question))).
grant(bond(I, M, _), Id, Date, Serial, mature_give(coin(Id?, Serial?), Date?), From, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Ws, D?) :- (I? =?= Id?), (M? =< Date?) | Serial1 := (Serial? + 1), show(matured_for(From?, M?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial1?, D).
grant(bond(I, M, S), Id, Date, Serial, mature_declined(bond(I?, M?, S?)), From, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Ws, D?) :- otherwise | show(not_mature_for(From?, M?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).
grant(coin(I, S), Id, Date, Serial, mature_declined(coin(I?, S?)), From, Reqs, UserIn, NetIn, Cal, Outs, Holdings, Ws, D?) :- show(refused(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).

procedure fill_swap(Status?, Key?, Key?, SwapResponse, Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)?, Link?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
fill_swap(ok, Id, From, swap_accept(Give?), Give, Offered, Rest, Link, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), append_instruments(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn?, NetIn1?, Cal?, Outs2?, Holdings1?, Date?, Ws?, Serial?, D).
fill_swap(fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, Link, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- drop_link(Link?), append_instruments(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, D).

procedure propose_swap(Status?, Key?, Key?, Lot?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
propose_swap(ok, Id, Q, _, Want, Give, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- ground(Q?), ground(Want?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_swap(Known?, Id?, Q?, Want?, Give?, Outs1?, Outs2, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, NetIn?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?, D).
propose_swap(fail, Id, _, lot(U, D, K), _, Give, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D1?) :- append_instruments(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, D1).

procedure send_swap(Decision?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(UserInMsg)?, Stream(UserInMsg)).
send_swap(yes, Id, Q, Want, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, linked, UserIn?, UserIn1).
send_swap(no, Id, Q, Want, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Q?), new_channel(TheirEnd, MyEnd) | send_net(msg(Q?, call(Id?, swap(Want?, Give?, Resp), TheirEnd?)), Outs?, Outs1), inject_swap_result(Resp?, Q?, link(MyEnd?), UserIn?, UserIn1).

procedure propose_transfer(Status?, Kind?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
propose_transfer(ok, Kind, Id, Q, Lot, Give, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- ground(Kind?), ground(Q?), ground(Lot?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_transfer(Known?, Kind?, Id?, Q?, Give?, Outs1?, Outs2, UserIn?, UserIn1), show(offered_transfer(Kind?, Q?, Lot?), Outs2?, Outs3), after_change(Reqs?, Id?, UserIn1?, NetIn?, Cal?, Outs3?, Rest?, Date?, Ws?, Serial?, D).
propose_transfer(fail, _, Id, _, lot(U, D, K), Give, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D1?) :- append_instruments(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, D1).

procedure send_transfer(Decision?, Kind?, Key?, Key?, Stream(Instrument)?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(UserInMsg)?, Stream(UserInMsg)).
send_transfer(yes, Kind, Id, Q, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Kind?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, linked, UserIn?, UserIn1).
send_transfer(no, Kind, Id, Q, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Kind?), ground(Q?), new_channel(TheirEnd, MyEnd) | send_net(msg(Q?, call(Id?, transfer(Kind?, Give?, Resp), TheirEnd?)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, link(MyEnd?), UserIn?, UserIn1).

procedure do_pay(Status?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
do_pay(ok, Id, Q, K, Give, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_owed(Known?, Id?, Q?, pay(Give?, Resp), Outs1?, Outs2, NetIn?, NetIn1), inject_pay_result(Resp?, Q?, K?, UserIn?, UserIn1), show(paying(Q?, K?), Outs2?, Outs3), after_change(Reqs?, Id?, UserIn1?, NetIn1?, Cal?, Outs3?, Rest?, Date?, Ws?, Serial?, D).
do_pay(fail, Id, Q, K, Give, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(lacking(Q?, now, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, D).

procedure do_redeem(Found?, Key?, Key?, Key?, Constant?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
do_redeem(found(Coin), Id, Q, R, D1, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_owed(Known?, Id?, Q?, redeem(Coin?, R?, D1?, Resp), Outs1?, Outs2, NetIn?, NetIn1), inject_redeem_result(Resp?, Q?, R?, D1?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, NetIn1?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?, D).
do_redeem(not_found, Id, Q, _, _, Holdings, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D?) :- show(lacking(Q?, now, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).

procedure do_mature(Found?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
do_mature(found(Bond), Id, Q, D, Rest, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D1?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_owed(Known?, Id?, Q?, mature(Bond?, Resp), Outs1?, Outs2, NetIn?, NetIn1), inject_mature_result(Resp?, Q?, D?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, NetIn1?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?, D1).
do_mature(not_found, Id, Q, D, Holdings, Reqs, UserIn, NetIn, Cal, Outs, Date, Ws, Serial, D1?) :- show(lacking(Q?, D?, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D1).

procedure send_owed(Decision?, Key?, Key?, PeerContent?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
send_owed(yes, Id, Q, Act, Outs, Outs1?, NetIn, NetIn?) :- send_friend(Q?, msg(Id?, Q?, Act?), Outs?, Outs1).
send_owed(no, Id, Q, Act, Outs, Outs2?, NetIn, NetIn1?) :- ground(Q?), new_channel(TheirEnd, MyEnd) | send_net(msg(Q?, call(Id?, Act?, TheirEnd?)), Outs?, Outs1), adopt(link(MyEnd?), Q?, Outs1?, Outs2, NetIn?, NetIn1).

procedure after_change(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?, Stream(Ask(Question))).
after_change(Reqs, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, D?) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, D).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Draw ::= draw(Integer, _, _) ; withdraw(Integer).
PersonIn ::= [_ | PersonIn].
Input ::= input(_, _, _).
Path ::= [] ; [Integer | Path].
Inputs ::= [Input | Inputs].
Route ::= route(Integer, Inputs?).
Routes ::= [] ; [Route | Routes].
Deads ::= [] ; [Inputs? | Deads].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q) ::= spawn(Integer, Q, Inputs, Stream(Draw)?).

procedure(Q) dispatch(Stream(Ask(Q))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, MOut), Ss?) :- split_grants(PIn?, Inputs, MIn), merge(MOut?, DOut?, POut), serve_1(Asks?, Inputs?, COut?, COut, DOut, [], [], 0, Ss).

procedure split_grants(PersonIn?, Inputs, Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([G | Gs], Is?, [G? | Ms?]) :- otherwise | split_grants(Gs?, Is, Ms).

procedure(Q) serve_1(Stream(Ask(Q))?, Inputs?, Stream(Draw)?, Stream(Draw), Stream(_), Routes?, Deads?, Integer?, Stream(Spawn(Q))).
serve_1([ask(_, Q) | Asks], Is, COut, CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Asks?, Is?, COut?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1(Asks, [G | Is], COut, CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(G?, Rs?, Rs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1(Asks, Is, [draw(Id, W, V) | COut], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Asks?, Is?, COut?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1(Asks, Is, [withdraw(Id) | COut], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure route_grant(Input?, Routes?, Routes).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure remove_route(Integer?, Routes?, Routes, Deads?, Deads).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure run(Integer?, _?, Stream(_)?, Done?, Stream(Draw)).
run(Id, _, _, done, [withdraw(Id?)]).
run(Id, W, [V | Vs], Done, [draw(Id?, W?, V?) | Ds?]) :- ground(W?), ground(V?) | run(Id?, W?, Vs?, Done?, Ds).
run(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure run_end(Integer?, Done?, Stream(Draw)).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(_?, Stream(_)).
shown(X, [X?]) :- ground(X?) | true.

procedure thread(Stream(_)?, Stream(Stream(_))).
thread(Xs, [[] | Vs?]) :- thread(Xs?, [], Vs).

procedure thread(Stream(_)?, Stream(_)?, Stream(Stream(_))).
thread([X | Xs], Prev, Vs?) :- ground(X?), ground(Prev?) | append_one(Prev?, X?, New), thread_more(Xs?, New?, Vs).
thread([], _, []).

procedure thread_more(Stream(_)?, Stream(_)?, Stream(Stream(_))).
thread_more(Xs, New, [New? | Vs?]) :- ground(New?) | thread(Xs?, New?, Vs).

procedure append_one(Stream(_)?, _?, Stream(_)).
append_one([Y | Ys], X, [Y? | Zs?]) :- append_one(Ys?, X?, Zs).
append_one([], X, [X?]).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

procedure form_any(_?, Formed(_)).
form_any(R, F?) :- ground(R?) | F = formed(R?).
form_any(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

exported procedure dispatch(Stream(Ask(Question))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_))).
dispatch(Asks, PCh, MCh?) :- dispatch(Asks?, PCh?, MCh, Ss), constructs(Ss?).

procedure constructs(Stream(Spawn(Question))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs?, Stream(Draw)).
construct(Id, swapCard_w(X), Gs, Ds?) :- present_swapCard([], X?, Gs?, _, Vs, Done), run(Id?, form(card, [shown, buttons([yes, no])]), Vs?, Done?, Ds).
construct(Id, transferCard_w(X), Gs, Ds?) :- present_transferCard([], X?, Gs?, _, Vs, Done), run(Id?, form(card, [shown, buttons([yes, no])]), Vs?, Done?, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs?, _, Done), run(Id?, input_box(menu([form(mint, [number]), form(mint, [number, number]), form(swap, [text, text, text, number, text, text, number]), form(pay, [text, number]), form(redeem, [text, text, text]), form(mature, [text, number]), form(deposit, [text, text, text, number]), form(release, [text, text, text, number]), form(return, [text, text, text, number])])), [input([])], Done?, Ds).

procedure form_yesNo(_?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs?, Inputs, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input?, Inputs?, Inputs, Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

procedure start_swapCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_swapCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_swapCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_swapCard_card_2([], _, []).
start_swapCard_card_2(_, [], []).

procedure comb_swapCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_swapCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_swapCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_swapCard_card_2(_, _, [], [], []).

procedure present_swapCard(Path?, SwapCard?, Inputs?, Inputs, Stream(_), Done).
present_swapCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | shown(H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_swapCard_card_2(V1?, [input(M2?)], Vs).

procedure start_transferCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_transferCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_transferCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_transferCard_card_2([], _, []).
start_transferCard_card_2(_, [], []).

procedure comb_transferCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_transferCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_transferCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_transferCard_card_2(_, _, [], [], []).

procedure present_transferCard(Path?, TransferCard?, Inputs?, Inputs, Stream(_), Done).
present_transferCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | shown(H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_transferCard_card_2(V1?, [input(M2?)], Vs).

procedure join_request_mint_1(Formed(Integer)?, Formed(Request)).
join_request_mint_1(formed(X1), formed(mint(X1?))).
join_request_mint_1(refused, refused).

procedure join_request_mint_2(Formed(Integer)?, Formed(Integer)?, Formed(Request)).
join_request_mint_2(formed(X1), formed(X2), formed(mint(X1?, X2?))).
join_request_mint_2(refused, _, refused).
join_request_mint_2(_, refused, refused).

procedure join_request_swap_7(Formed(Key)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_swap_7(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(X7), formed(swap(X1?, X2?, X3?, X4?, X5?, X6?, X7?))).
join_request_swap_7(refused, _, _, _, _, _, _, refused).
join_request_swap_7(_, refused, _, _, _, _, _, refused).
join_request_swap_7(_, _, refused, _, _, _, _, refused).
join_request_swap_7(_, _, _, refused, _, _, _, refused).
join_request_swap_7(_, _, _, _, refused, _, _, refused).
join_request_swap_7(_, _, _, _, _, refused, _, refused).
join_request_swap_7(_, _, _, _, _, _, refused, refused).

procedure join_request_pay_2(Formed(Key)?, Formed(Integer)?, Formed(Request)).
join_request_pay_2(formed(X1), formed(X2), formed(pay(X1?, X2?))).
join_request_pay_2(refused, _, refused).
join_request_pay_2(_, refused, refused).

procedure join_request_redeem_3(Formed(Key)?, Formed(Key)?, Formed(Constant)?, Formed(Request)).
join_request_redeem_3(formed(X1), formed(X2), formed(X3), formed(redeem(X1?, X2?, X3?))).
join_request_redeem_3(refused, _, _, refused).
join_request_redeem_3(_, refused, _, refused).
join_request_redeem_3(_, _, refused, refused).

procedure join_request_mature_2(Formed(Key)?, Formed(Integer)?, Formed(Request)).
join_request_mature_2(formed(X1), formed(X2), formed(mature(X1?, X2?))).
join_request_mature_2(refused, _, refused).
join_request_mature_2(_, refused, refused).

procedure join_request_deposit_4(Formed(Key)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_deposit_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(deposit(X1?, X2?, X3?, X4?))).
join_request_deposit_4(refused, _, _, _, refused).
join_request_deposit_4(_, refused, _, _, refused).
join_request_deposit_4(_, _, refused, _, refused).
join_request_deposit_4(_, _, _, refused, refused).

procedure join_request_release_4(Formed(Key)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_release_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(release(X1?, X2?, X3?, X4?))).
join_request_release_4(refused, _, _, _, refused).
join_request_release_4(_, refused, _, _, refused).
join_request_release_4(_, _, refused, _, refused).
join_request_release_4(_, _, _, refused, refused).

procedure join_request_return_4(Formed(Key)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_return_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(return(X1?, X2?, X3?, X4?))).
join_request_return_4(refused, _, _, _, refused).
join_request_return_4(_, refused, _, _, refused).
join_request_return_4(_, _, refused, _, refused).
join_request_return_4(_, _, _, refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(mint(R1), F?) :- form_integer(R1?, F1), join_request_mint_1(F1?, F).
form_request(mint(R1, R2), F?) :- form_integer(R1?, F1), form_integer(R2?, F2), join_request_mint_2(F1?, F2?, F).
form_request(swap(R1, R2, R3, R4, R5, R6, R7), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), form_string(R5?, F5), form_constant(R6?, F6), form_integer(R7?, F7), join_request_swap_7(F1?, F2?, F3?, F4?, F5?, F6?, F7?, F).
form_request(pay(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_request_pay_2(F1?, F2?, F).
form_request(redeem(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), join_request_redeem_3(F1?, F2?, F3?, F).
form_request(mature(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_request_mature_2(F1?, F2?, F).
form_request(deposit(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), join_request_deposit_4(F1?, F2?, F3?, F4?, F).
form_request(release(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), join_request_release_4(F1?, F2?, F3?, F4?, F).
form_request(return(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), join_request_return_4(F1?, F2?, F3?, F4?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs?, Inputs, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input?, Inputs?, Inputs, Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

