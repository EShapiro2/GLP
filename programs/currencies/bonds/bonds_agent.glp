grant(Med, bond(I, M, _), Id, Date, Serial, mature_give(coin(Id?, Serial?), Date?), From, UserIn, NetIn, Cal, Outs, Holdings, Ws) :- (I? =?= Id?), (M? =< Date?) | Serial1 := (Serial? + 1), show(matured_for(From?, M?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial1?, none, none, none, none, none, none, none, none, none).
grant(Med, bond(I, M, S), Id, Date, Serial, mature_declined(bond(I?, M?, S?)), From, UserIn, NetIn, Cal, Outs, Holdings, Ws) :- otherwise | show(not_mature_for(From?, M?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none, none, none).
