display agent *(K) : panel(bonds), label("Mint coins"), field(K, number), persistent.
display agent *(K, D) : panel(bonds), label("Mint bonds"), field(K, number), field(D, date), persistent.
display agent *(Q, U, D, K, V, D1, K1) : panel(bonds), label("Swap"), field(Q, peer), field(U, peer), field(D, text), field(K, number), field(V, peer), field(D1, text), field(K1, number), persistent.
display agent *(Q, K) : panel(bonds), label("Pay"), field(Q, peer), field(K, number), persistent.
display agent *(Q, R, D1) : panel(bonds), label("Redeem"), field(Q, peer), field(R, peer), field(D1, text), persistent.
display agent *(Q, D) : panel(bonds), label("Mature"), field(Q, peer), field(D, date), persistent.
display agent *(E, U, D, K) : panel(bonds), label("Deposit"), field(E, peer), field(U, peer), field(D, text), field(K, number), persistent.
display agent *(Q, U, D, K) : panel(bonds), label("Release"), field(Q, peer), field(U, peer), field(D, text), field(K, number), persistent.
display agent *(P, U, D, K) : panel(bonds), label("Return"), field(P, peer), field(U, peer), field(D, text), field(K, number), persistent.
display respond_swap *(yes, From?, Want?, Offered?) : panel(bonds), label("Accept"), transient.
display respond_transfer *(yes, Kind?, From?, Given?) : panel(bonds), label("Accept"), transient.
display msg(agent, person, holdings(Lots)) : panel(bonds), view(balances).

