fulfil(Med, coin(I, S), R, D1, Resp?, Id, From, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- (I? =?= Id?) | take_instrument(R?, D1?, Holdings?, Found, Rest), give(Med?, Found?, coin(I?, S?), R?, D1?, Resp, Id?, From?, UserIn?, NetIn?, Cal?, Outs?, Rest?, Date?, Ws?, Serial?).
fulfil(Med, X, _, _, redeem_declined(X?), Id, From, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- otherwise | show(refused(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none, none, none).

procedure give(Channel(Closed, Stream(AgentMsg))?, Found?, Instrument?, Constant?, Constant?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Integer?).
give(Med, found(X), Mine, R, D1, redeem_give(X?), Id, From, UserIn, NetIn, Cal, Outs, Rest, Date, Ws, Serial) :- append_instruments(Rest?, [Mine?], Holdings1), show(presented(From?, R?, D1?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?).
