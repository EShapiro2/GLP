send_transfer(_, yes, Kind, Id, Q, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Kind?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, linked, UserIn?, UserIn1).
