%% village.glp --- the village market of Section 7 of "Grassroots Bonds:
%% Financing by the People, for the People", on the compiled bond agent.
%%
%% Six villagers --- Alice (baker), Bob (farmer), Charlie (carpenter), Diana
%% (doctor), Eve (teacher), Frank (fisherman) --- and an escrow agent perform
%% the seven operations of Section 7.1, each an act of the contract:
%%
%%   1. symmetric mutual credit   Alice-Bob 15, Alice-Charlie 15, Charlie-Eve 10,
%%                                Eve-Frank 10, all coins
%%   2. loans                     Diana gives Bob 20 diana-coins for 24 bob-bonds
%%                                maturing day 25, and Frank 15 for 18 frank-bonds
%%                                maturing day 28
%%   3. pay                       Bob pays Alice 5, Eve pays Charlie 6, Frank pays
%%                                Diana 3, Eve pays Alice 3, each in coins of the
%%                                payee
%%   4. portfolio swap            Eve gives Charlie 5 frank-coins for 5 alice-coins
%%   5. escrow                    Charlie deposits 5 frank-coins with the escrow
%%                                agent for Frank, released to Frank when the
%%                                escrow agent's date reaches day 30
%%   6. redeem                    Frank redeems 5 diana-coins from Diana, one at a
%%                                time, taking back his own bonds maturing day 28
%%   7. sale of debt              Alice sells 10 bob-coins to Eve for 4 frank-coins
%%
%% What dates add is shown once, on Frank's bonds: before Frank's date reaches
%% day 28, Diana presents one of the frank-bonds she holds for a frank-coin,
%% and Frank's agent returns it, as it is not mature by his date; Frank's date
%% then advances to 28 by his own calendar, and once he has presented his
%% first diana-coin, Diana presents a frank-bond again and takes a frank-coin
%% for it.  Bob's date advances to 25 by his own calendar.  The play drives
%% the calendars.
%%
%% Each party runs the mini-app (dated/miniapp.glp): the compiled agent with
%% its dispatcher, activated with its person channel, its conversations, and
%% its calendar.  The play stands in for the super-app: it opens, before the
%% market, the conversation between every two parties who transact --- one
%% root channel each, an end to each of the two --- and hands each party its
%% conversations on its channel to the social graph.  A scripted person
%% (dated/person.glp) stands in for the super-app user interface: it reads the
%% constructs the dispatcher draws --- the agent's request form, drawn once and
%% kept on screen, and a card per proposed swap or transfer --- and the screen
%% the agent writes, and grants its acts on them --- the person's taps and
%% submissions --- in the order of its script, each step when the one before
%% it has taken effect; it also writes the agent's calendar, which on a device
%% the clock would.  At the escrow agent the escrow program (dated/escrow.glp)
%% answers the transfer cards and wills the release, and the person performs
%% it.  The screen messages are logged as tagged(Party, Message), so the run
%% is observable and the final holdings can be read off it.
%%
%% Entry point: market/0, exported by self.glp as village/0.

imported procedure dated#bonds(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?).
imported procedure dated#person(Key?, _?, PersonIn(Drawn), Stream(Integer), Script?, Agreement?, Stream(ScreenContent)).

%% =============================================================================
%% The scripts
%% =============================================================================

procedure script(Key?, Script).
script(alice, [mint(15), swap(bob, alice, now, 15, bob, now, 15),
               mint(15), swap(charlie, alice, now, 15, charlie, now, 15),
               swap(eve, bob, now, 10, frank, now, 4)]).
script(bob, [mint(15), accept(alice), mint(24, 25), accept(diana),
             pay(alice, 5), advance(25)]).
script(charlie, [mint(15), accept(alice), mint(10),
                 swap(eve, charlie, now, 10, eve, now, 10), accept(eve),
                 deposit(escrow, frank, now, 5)]).
script(diana, [mint(20), swap(bob, diana, now, 20, bob, 25, 24),
               mint(15), swap(frank, diana, now, 15, frank, 28, 18),
               mature(frank, 28),
               await(presented(frank, frank, 28)), mature(frank, 28)]).
script(eve, [mint(10), accept(charlie), mint(10),
             swap(frank, eve, now, 10, frank, now, 10),
             pay(charlie, 6), swap(charlie, frank, now, 5, alice, now, 5),
             pay(alice, 3), accept(alice)]).
script(frank, [mint(18, 28), accept(diana), mint(10), accept(eve),
               pay(diana, 3),
               await(not_mature_for(diana, 28)), advance(28),
               redeem(diana, frank, 28), redeem(diana, frank, 28),
               redeem(diana, frank, 28), redeem(diana, frank, 28),
               redeem(diana, frank, 28),
               accept_transfer(escrow)]).
%% The escrow agent's calendar: its date reaches day 30 once the deposit is
%% held.  Its acts are the escrow program's.
script(escrow, [await(received_transfer(deposit, charlie, [lot(frank, now, 5)])),
                advance(30)]).

%% =============================================================================
%% The village
%% =============================================================================
%%
%% Nine conversations, one root channel each: the pairs that transact ---
%% alice-bob, alice-charlie, alice-eve, bob-diana, charlie-eve,
%% charlie-escrow, diana-frank, eve-frank and escrow-frank.

exported procedure market.
market :-
    script(alice, SA),
    villager(alice, SA?, [conversation(bob, ch(AB?, BA)), conversation(charlie, ch(AC?, CA)),
                          conversation(eve, ch(AE?, EA))]),
    script(bob, SB),
    villager(bob, SB?, [conversation(alice, ch(BA?, AB)), conversation(diana, ch(BD?, DB))]),
    script(charlie, SC),
    villager(charlie, SC?, [conversation(alice, ch(CA?, AC)), conversation(eve, ch(CE?, EC)),
                            conversation(escrow, ch(CG?, GC))]),
    script(diana, SD),
    villager(diana, SD?, [conversation(bob, ch(DB?, BD)), conversation(frank, ch(DF?, FD))]),
    script(eve, SE),
    villager(eve, SE?, [conversation(alice, ch(EA?, AE)), conversation(charlie, ch(EC?, CE)),
                        conversation(frank, ch(EF?, FE))]),
    script(frank, SF),
    villager(frank, SF?, [conversation(diana, ch(FD?, DF)), conversation(eve, ch(FE?, EF)),
                          conversation(escrow, ch(FG?, GF))]),
    script(escrow, SG),
    escrow_agent(escrow, SG?, dated_escrow(charlie, frank, lot(frank, now, 5), 30, awaiting, 0),
                 [conversation(charlie, ch(GC?, CG)), conversation(frank, ch(GF?, FG))]).

%% =============================================================================
%% Two escrows open at once
%% =============================================================================
%%
%% Charlie and Frank swap 4 of their coins, and Charlie deposits 2 frank-coins
%% with the escrow agent for Frank until day 30, then 2 more: two date-based
%% escrows, each its own agreement, held by the one escrow agent at once.  The
%% escrow agent's date reaches 30 once both deposits are held, and it releases
%% both to Frank.  Three conversations, one root channel each: charlie-frank,
%% charlie-escrow and escrow-frank.
%%
%% Entry point: two_escrows/0, exported by self.glp.

exported procedure two_escrows.
two_escrows :-
    villager(charlie, [mint(4), swap(frank, charlie, now, 4, frank, now, 4),
                       deposit(escrow, frank, now, 2), deposit(escrow, frank, now, 2)],
             [conversation(frank, ch(CF?, FC)), conversation(escrow, ch(CG?, GC))]),
    villager(frank, [mint(4), accept(charlie), accept_transfer(escrow), accept_transfer(escrow)],
             [conversation(charlie, ch(FC?, CF)), conversation(escrow, ch(FG?, GF))]),
    escrow_agent(escrow,
                 [await(received_transfer(deposit, charlie, [lot(frank, now, 2)])),
                  await(received_transfer(deposit, charlie, [lot(frank, now, 2)])),
                  advance(30)],
                 agreements([dated_escrow(charlie, frank, lot(frank, now, 2), 30, awaiting, 0),
                             dated_escrow(charlie, frank, lot(frank, now, 2), 30, awaiting, 0)]),
                 [conversation(charlie, ch(GC?, CG)), conversation(frank, ch(GF?, FG))]).

%% One villager: the mini-app, activated with its person channel, its
%% conversations and its calendar; the scripted person on the other end of the
%% channel, under no agreement; and its screen logged.
exported procedure villager(Key?, Script?, Stream(Conversation(PeerMsg))?).
villager(Id, Script, Convs) :-
    ground(Id?) |
    escrow_agent(Id?, Script?, none, Convs?).

%% A party under an agreement: the same, with the escrow program answering its
%% transfer cards and willing its releases and returns.
exported procedure escrow_agent(Key?, Script?, Agreement?, Stream(Conversation(PeerMsg))?).
escrow_agent(Id, Script, Ag, Convs) :-
    ground(Id?) |
    dated # bonds(Id?, ch(Grants?, Draws), Convs?, Cal?),
    dated # person(Id?, Draws?, Grants, Cal, Script?, Ag?, Screen),
    log(Id?, Screen?).

%% The screen messages, logged as tagged(Party, Message).
procedure log(Key?, Stream(ScreenContent)?).
log(Id, [M|Ms]) :- ground(M?) | send_to_user([tagged(Id?, M?)]), log(Id?, Ms?).
log(_, []).
