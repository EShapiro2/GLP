%% Bonds.glp --- printed by adopt.py from Bonds.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Bonds.txt and run adopt.py Bonds.
% contract_named(bonds, C): the contract, Bonds.
procedure contract_named(Constant?, SDeclared).
contract_named(bonds, environment([today], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], [], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(identity, ['Carol']), atom(person, ['Alice']), atom(person, ['Bob']), atom(person, ['Carol']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(issue, ['Alice'], ['Type', 'SumSet', 'Sum'], [atom(note, ['Alice', 'Alice', const('Type'), set('SumSet')])], [atom(identity, ['Alice'])], eq(size('SumSet'), num('Sum')), ['Alice']),
 sas(swap, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob']), one('Dave', ['Alice', 'Bob', 'Carol'])], ['Carol', 'Type', 'SumSet', 'Sum', 'Dave', 'Other', 'TotalSet', 'Total'], [not(atom(note, ['Alice', 'Carol', const('Type'), set('SumSet')])), atom(note, ['Bob', 'Carol', const('Type'), set('SumSet')]), not(atom(note, ['Bob', 'Dave', const('Other'), set('TotalSet')])), atom(note, ['Alice', 'Dave', const('Other'), set('TotalSet')]), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(note, ['Alice', 'Carol', const('Type'), set('SumSet')]), atom(note, ['Bob', 'Dave', const('Other'), set('TotalSet')])], and(eq(size('SumSet'), num('Sum')), eq(size('TotalSet'), num('Total'))), ['Alice', 'Bob']),
 sas(pay, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Type', 'SumSet', 'Sum'], [not(atom(note, ['Alice', 'Carol', const('Type'), set('SumSet')])), atom(note, ['Bob', 'Carol', const('Type'), set('SumSet')]), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Carol', const('Type'), set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Alice', 'Bob']),
 sas(pay_issuer, ['Alice', 'Bob'], ['Type', 'SumSet', 'Sum'], [not(atom(note, ['Alice', 'Bob', const('Type'), set('SumSet')])), atom(note, ['Bob', 'Bob', const('Type'), set('SumSet')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Bob', const('Type'), set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Alice']),
 sas(deposit, ['Alice', 'Carol', one('Dave', ['Alice', 'Carol']), one('Bob', 'Dave')], ['Dave', 'Type', 'SumSet', 'Sum', 'Bob', 'Cond'], [not(atom(note, ['Alice', 'Dave', const('Type'), set('SumSet')])), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond', set('SumSet')])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Dave', const('Type'), set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Alice', 'Carol']),
 sas(release, ['Carol', 'Bob', one('Dave', ['Carol', 'Bob']), one('Alice', 'Dave')], ['Dave', 'Type', 'Alice', 'Cond', 'SumSet', 'Sum'], [not(atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond', set('SumSet')])), atom(note, ['Bob', 'Dave', const('Type'), set('SumSet')]), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond', set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Carol', 'Bob']),
 sas(return, ['Carol', 'Alice', one('Dave', ['Carol', 'Alice']), one('Bob', 'Dave')], ['Dave', 'Type', 'Bob', 'Cond', 'SumSet', 'Sum'], [not(atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond', set('SumSet')])), atom(note, ['Alice', 'Dave', const('Type'), set('SumSet')]), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond', set('SumSet')])], eq(size('SumSet'), num('Sum')), ['Carol', 'Alice']),
 sas(redeem, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['BobCoin1Set', 'Carol', 'CarolCoin1Set'], [not(atom(note, ['Alice', 'Bob', val(coin), set('BobCoin1Set')])), atom(note, ['Bob', 'Bob', val(coin), set('BobCoin1Set')]), not(atom(note, ['Bob', 'Carol', val(coin), set('CarolCoin1Set')])), atom(note, ['Alice', 'Carol', val(coin), set('CarolCoin1Set')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Bob', val(coin), set('BobCoin1Set')]), atom(note, ['Bob', 'Carol', val(coin), set('CarolCoin1Set')])], and(eq(size('BobCoin1Set'), num(1)), eq(size('CarolCoin1Set'), num(1))), ['Alice']),
 sas(redeem_coin_against_bond, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['BobCoin1Set', 'Carol', 'Day', 'CarolBondDay1Set'], [not(atom(note, ['Alice', 'Bob', val(coin), set('BobCoin1Set')])), atom(note, ['Bob', 'Bob', val(coin), set('BobCoin1Set')]), not(atom(note, ['Bob', 'Carol', val(bond, [num('Day')]), set('CarolBondDay1Set')])), atom(note, ['Alice', 'Carol', val(bond, [num('Day')]), set('CarolBondDay1Set')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Bob', val(coin), set('BobCoin1Set')]), atom(note, ['Bob', 'Carol', val(bond, [num('Day')]), set('CarolBondDay1Set')])], and(eq(size('BobCoin1Set'), num(1)), eq(size('CarolBondDay1Set'), num(1))), ['Alice']),
 sas(redeem_bond, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Day', 'BobBondDay1Set', 'Carol', 'CarolCoin1Set', 'Today'], [not(atom(note, ['Alice', 'Bob', val(bond, [num('Day')]), set('BobBondDay1Set')])), atom(note, ['Bob', 'Bob', val(bond, [num('Day')]), set('BobBondDay1Set')]), not(atom(note, ['Bob', 'Carol', val(coin), set('CarolCoin1Set')])), atom(note, ['Alice', 'Carol', val(coin), set('CarolCoin1Set')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(today, ['Bob', num('Today')]), atom(note, ['Alice', 'Bob', val(bond, [num('Day')]), set('BobBondDay1Set')]), atom(note, ['Bob', 'Carol', val(coin), set('CarolCoin1Set')])], and(le(num('Day'), num('Today')), and(eq(size('BobBondDay1Set'), num(1)), eq(size('CarolCoin1Set'), num(1)))), ['Alice']),
 sas(redeem_bond_against_bond, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Day', 'BobBondDay1Set', 'Carol', 'Term', 'CarolBondTerm1Set', 'Today'], [not(atom(note, ['Alice', 'Bob', val(bond, [num('Day')]), set('BobBondDay1Set')])), atom(note, ['Bob', 'Bob', val(bond, [num('Day')]), set('BobBondDay1Set')]), not(atom(note, ['Bob', 'Carol', val(bond, [num('Term')]), set('CarolBondTerm1Set')])), atom(note, ['Alice', 'Carol', val(bond, [num('Term')]), set('CarolBondTerm1Set')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(today, ['Bob', num('Today')]), atom(note, ['Alice', 'Bob', val(bond, [num('Day')]), set('BobBondDay1Set')]), atom(note, ['Bob', 'Carol', val(bond, [num('Term')]), set('CarolBondTerm1Set')])], and(le(num('Day'), num('Today')), and(eq(size('BobBondDay1Set'), num(1)), eq(size('CarolBondTerm1Set'), num(1)))), ['Alice'])]))).
