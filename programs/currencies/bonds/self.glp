%% self.glp — grassroots bonds, the bonds program.
%%
%% The program every participant runs under the grassroots social contract of
%% "Grassroots Bonds: Financing by the People, for the People" (Section 3),
%% derived from the transactions of its Section 3.4, Definition "The
%% Transactions of Grassroots Bonds".  It extends the coins program
%% (programs/currencies/coins) by what dates add.  This file holds the types shared by the
%% agent (bonds_agent.vglp, compiled by the vGLP canonical compilation into
%% bonds_agent.glp beside it), the escrow programs (escrow.glp) and the plays
%% (village.glp, credit_line.glp), and the helpers over holdings, dates and
%% channels that the agent calls.
%%
%% A coin and a bond are two instruments.  A coin is coin(Issuer, Serial), a
%% unit of its issuer's debt due now, carrying no date: the atom cent(u, bot)
%% of the act schemas.  A bond is bond(Issuer, Maturity, Serial), such a unit
%% due at its maturity date: the atom cent(u, d).  The serial is the one a
%% practical implementation gives each instrument.  A party's holdings are a
%% multiset of instruments, Stream(Instrument).  A lot is k instruments of one
%% issuer, kind and maturity, lot(Issuer, Due, K), its due `now` for coins and
%% the maturity date for bonds: the cent^k_{u,*} of Section 3.4.  A warranty
%% dated(Issuer, Date) is the pair (q, d*_q) of Mature: the issuer's warranty
%% of its date, recorded at the bearer of a bond it took for a coin.

Instrument ::= coin(Key, Integer) ; bond(Key, Integer, Integer).
Lot        ::= lot(Key, Constant, Integer).
Warranty   ::= dated(Key, Integer).

%% The three escrow transfers of clause 7: a deposit by the depositor with the
%% escrow agent, a release by the escrow agent to the beneficiary, a return by
%% the escrow agent to the depositor.  Each is a transfer of one lot guarded by
%% both participants, and the kind is what the receiver's card shows.
Kind ::= deposit ; release ; return.

%% The counterparty's answer to a swap: the instruments it gives, or the
%% offered instruments returned.
SwapResponse ::= swap_accept(Stream(Instrument)) ; swap_decline(Stream(Instrument)).

%% The payee's answer to a payment: the coins taken, or returned because they
%% are not the payee's own coins.  No date is read and none is warranted.
PayResponse ::= pay_taken ; pay_returned(Stream(Instrument)).

%% The issuer's answer to a presentation of its coin: the instrument taken in
%% exchange; the presented coin returned with the lots the issuer holds, its
%% own apart, for the bearer to choose among; or what was presented returned
%% because it is not the issuer's coin.  No date is read and none is
%% warranted.
RedeemResponse ::= redeem_give(Instrument)
                 ; redeem_menu(Instrument, Stream(Lot))
                 ; redeem_declined(Instrument).

%% The issuer's answer to a matured bond presented to it: a coin of its own
%% for it, with its date --- the warranty of clause 2 --- or the bond
%% returned, because it is not mature by the issuer's date.
MatureResponse ::= mature_give(Instrument, Integer) ; mature_declined(Instrument).

%% The receiver's answer to an escrow transfer: taken, or the instruments
%% returned.
TransferResponse ::= transfer_accept ; transfer_decline(Stream(Instrument)).

%% What one agent sends another: the bilateral acts of Section 3.4.  A position
%% that forwards a writer carries ? in the type (typed-glp-manual, 15B).
PeerContent ::= pay(Stream(Instrument), PayResponse?)
              ; swap(Lot, Stream(Instrument), SwapResponse?)
              ; redeem(Instrument, Key, Constant, RedeemResponse?)
              ; mature(Instrument, MatureResponse?)
              ; transfer(Kind, Stream(Instrument), TransferResponse?).
PeerMsg     ::= msg(Key, Key, PeerContent).
PeerChannel ::= ch(Stream(PeerMsg), Stream(PeerMsg)?).

%% First contact.  An act sent to a party the sender has no channel to carries
%% the receiver's end of a fresh channel, on which the two transact thereafter.
NetCall   ::= call(Key, PeerContent, PeerChannel).
NetOutMsg ::= msg(Key, NetCall).
NetInMsg  ::= msg(Key, NetCall)
            ; msg(Key, Key, PeerContent).

%% A channel held for a swap or a transfer proposed at first contact ---
%% adopted when it is accepted, closed when it is declined --- or linked, an
%% established channel.
Link ::= link(PeerChannel) ; linked.

%% Whether an instrument was found in the holdings.
Found ::= found(Instrument) ; not_found.

%% The answer to a question the agent, the scripted person or the escrow
%% program asks of its state: whether every instrument of a payment is a coin
%% of the payee (own_coins), whether a channel to a counterparty is open
%% (has_peer), whether the screen shows a step's effect, and whether a lot is
%% one of a list, is owed, or every lot of a list is held (escrow.glp).  The
%% name is the one bonds_v2 and the social graph give the same two constants.
Decision ::= yes ; no.

%% Whether k instruments of an issuer and due were selected out of the
%% holdings: ok, or fail --- the precondition cent^k_{u,*} in c_p of Section
%% 3.4 does not hold.
Status ::= ok ; fail.

%% The agent's outputs: the screen, the network, and a channel per
%% counterparty, keyed by its name.  The routers send_user, send_net,
%% send_friend and add_friend_output are those of lib/routing, exposed from the
%% root scope.
OutputEntry ::= user_output(Stream(ScreenMsg)?)
              ; net_output(Stream(NetOutMsg)?)
              ; friend_output(Key, Stream(PeerMsg)?).

%% The screen: the holdings, tallied by issuer and due, after every change of
%% them; the date after every advance; each warranty as it is recorded; and
%% what each act came to.  A due is `now` for coins and the maturity date for
%% bonds.
ScreenContent ::= holdings(Stream(Lot))
                ; date_advanced(Integer)
                ; warranty(Key, Integer)
                ; minted(Integer, Constant)
                ; paying(Key, Integer)
                ; paid(Key, Integer)
                ; not_accepted(Key, Integer)
                ; received(Key, Integer)
                ; refused_payment(Key, Integer)
                ; swap_done(Key)
                ; swap_declined(Key)
                ; swap_failed(Key)
                ; declined(Key)
                ; redeemed(Key, Key, Constant)
                ; menu(Key, Stream(Lot))
                ; refused(Key)
                ; presented(Key, Key, Constant)
                ; unfulfilled(Key, Key, Constant)
                ; matured(Key, Integer)
                ; not_mature(Key, Integer)
                ; matured_for(Key, Integer)
                ; not_mature_for(Key, Integer)
                ; offered_transfer(Kind, Key, Lot)
                ; transferred(Kind, Key)
                ; transfer_declined(Kind, Key)
                ; received_transfer(Kind, Key, Stream(Lot))
                ; declined_transfer(Kind, Key)
                ; lacking(Key, Constant, Integer).
ScreenMsg ::= msg(Constant, Constant, ScreenContent).

%% The agent's own input: the answers its responders inject, and the results
%% of the acts it proposed.
UserInMsg ::= accept_swap(Key, Lot, Stream(Instrument), SwapResponse?, Link)
            ; decline_swap(Key, Stream(Instrument), SwapResponse?, Link)
            ; swap_accepted(Key, Stream(Instrument), Link)
            ; swap_declined_by(Key, Stream(Instrument), Link)
            ; pay_taken_by(Key, Integer)
            ; pay_returned_by(Key, Stream(Instrument))
            ; redeem_given(Key, Key, Constant, Instrument)
            ; redeem_menu_from(Key, Instrument, Stream(Lot))
            ; redeem_declined_by(Key, Instrument)
            ; matured_by(Key, Integer, Instrument, Integer)
            ; not_matured_by(Key, Instrument)
            ; accept_transfer(Kind, Key, Stream(Instrument), TransferResponse?, Link)
            ; decline_transfer(Kind, Key, Stream(Instrument), TransferResponse?, Link)
            ; transfer_accepted(Kind, Key, Link)
            ; transfer_declined_by(Kind, Key, Stream(Instrument), Link).

%% The offer a swap responder carries: the proposer, the lot it wants, the
%% instruments it offers.  The offer a transfer responder carries: the kind,
%% the giver, the instruments.
SwapOffer     ::= offer(Key, Lot, Stream(Instrument)).
TransferOffer ::= offer_transfer(Kind, Key, Stream(Instrument)).

%% =============================================================================
%% The agent's questions (vGLP, Definition "Guarded Clause, Volitional
%% Procedure, Interactive Type, ..."): the person's requests, the agent's
%% interactive type in reader mode, and the responders' cards, in writer mode.
%% =============================================================================

%% A request: one alternative per request clause of the agent, each a
%% transaction at the party whose election it is --- Mint_p(k), Mint_p(d, k),
%% Swap, Pay, Redeem, Mature, Deposit, Release and Return --- with the
%% arguments its clause reads.  A due is `now` for coins and the maturity date
%% for bonds.
Request ::= mint(Integer)
          ; mint(Integer, Integer)
          ; swap(Key, Key, Constant, Integer, Key, Constant, Integer)
          ; pay(Key, Integer)
          ; redeem(Key, Key, Constant)
          ; mature(Key, Integer)
          ; deposit(Key, Key, Constant, Integer)
          ; release(Key, Key, Constant, Integer)
          ; return(Key, Key, Constant, Integer).

%% A responder's card: the offer, which the agent writes for the person to
%% see, and the person's answer, yes accepting and no declining.
YesNo        ::= yes ; no.
SwapCard     ::= card(SwapOffer, YesNo?).
TransferCard ::= card(TransferOffer, YesNo?).

%% =============================================================================
%% The vocabulary of the compiled agent's dispatcher, so that the plays can
%% type the goals they spawn: the union of the agent's questions and the asks
%% its goals send, as the canonical compilation emits them into
%% bonds_agent.glp, and the person channel's input, as programs/vglp/
%% dispatcher.glp gives it.  The compiled module's own definitions shadow
%% these within it, and the two must agree.
%% =============================================================================

Question ::= swapCard_w(SwapCard) ; transferCard_w(TransferCard) ; stream_request_r(Stream(Request)?).
Ask(Q)   ::= ask(Constant, Q).
PersonIn ::= [_ | PersonIn].

%% =============================================================================
%% The plays' vocabulary: what a person sees, and the agreements the escrow
%% programs run.
%% =============================================================================

%% What a person sees: the constructs the dispatcher draws and withdraws,
%% draw(Id, W, V) and withdraw(Id), each a term of any type the bridge would
%% render; and the screen.  The dispatcher's stream never closes, as the
%% person channel never does, and neither do the events.
Event ::= draw(_, _, _)
        ; withdraw(_)
        ; msg(Constant, Constant, ScreenContent).
Events ::= [Event | Events].

%% A script: the person's acts, in order.  A step is a request, granted on the
%% agent's request form --- mint(K) for coins and mint(K, D) for bonds; an
%% advance of the calendar, which in a headless run the play drives; an
%% acceptance of a swap or of a transfer the named party proposes, granted on
%% its card; or a wait for a screen message.  A due is `now` for coins and the
%% maturity date for bonds.
Step ::= mint(Integer)
       ; mint(Integer, Integer)
       ; advance(Integer)
       ; swap(Key, Key, Constant, Integer, Key, Constant, Integer)
       ; pay(Key, Integer)
       ; redeem(Key, Key, Constant)
       ; mature(Key, Integer)
       ; deposit(Key, Key, Constant, Integer)
       ; release(Key, Key, Constant, Integer)
       ; return(Key, Key, Constant, Integer)
       ; accept(Key)
       ; accept_transfer(Key)
       ; await(ScreenContent).
Script ::= [] ; [Step | Script].

%% An escrow agreement, run by the escrow program of escrow.glp as the will of
%% the escrow agent, with its state: none, for a party under no agreement; a
%% date-based escrow --- the depositor, the beneficiary, the lot, the date of
%% the escrow agent at which it releases, its phase, and the escrow agent's
%% date; or a credit line --- the lender, the borrower, the limit, the expiry,
%% the date of the coupon bonds, the drawn amount, the principal of a draw
%% deposited and awaiting its coupon lot (0 when none), its phase, and the
%% escrow agent's date; or a packaged exchange --- the two parties, the lots
%% each owes, the lots deposited so far, its phase, and the escrow agent's
%% date.  The packaged
%% exchange is the construction of Section 5 item 1: each party deposits its
%% lots, one transfer per lot, and once every lot of both is held the escrow
%% agent releases them crosswise, so all the lots change hands or none do.  It
%% realises the balloon loan, the fixed-payment loan and the interest rate
%% swap (loans.glp).
Agreement ::= none
            ; dated_escrow(Key, Key, Lot, Integer, Phase, Integer)
            ; credit_line(Key, Key, Integer, Integer, Integer, Integer, Integer, Phase, Integer)
            ; packaged(Key, Key, Stream(Lot), Stream(Lot), Stream(Lot), Phase, Integer).
Phase ::= awaiting ; deposited ; released ; opening ; open ; closed.

%% =============================================================================
%% Holdings
%% =============================================================================

%% K fresh coins of Issuer, serials from Serial up.
procedure create_coins(Key?, Integer?, Integer?, Stream(Instrument)).
create_coins(Issuer, K, Serial, [coin(Issuer?, Serial?)|Rest?]) :-
    K? > 0 |
    K1 := K? - 1,
    S1 := Serial? + 1,
    create_coins(Issuer?, K1?, S1?, Rest).
create_coins(_, 0, _, []).

%% K fresh bonds of Issuer maturing at D, serials from Serial up.
procedure create_bonds(Key?, Integer?, Integer?, Integer?, Stream(Instrument)).
create_bonds(Issuer, D, K, Serial, [bond(Issuer?, D?, Serial?)|Rest?]) :-
    K? > 0 |
    K1 := K? - 1,
    S1 := Serial? + 1,
    create_bonds(Issuer?, D?, K1?, S1?, Rest).
create_bonds(_, _, 0, _, []).

procedure append_instruments(Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)).
append_instruments([X|Xs], Ys, [X?|Zs?]) :- append_instruments(Xs?, Ys?, Zs).
append_instruments([], Ys, Ys?).

%% K instruments of Issuer and due D out of the holdings --- coins where D is
%% `now`, bonds maturing at D otherwise: ok, with the instruments and the
%% rest; or fail --- the precondition cent^k_{u,*} in c_p of Section 3.4 does
%% not hold --- with the instruments found and the rest, which the caller puts
%% back together.
procedure select_instruments(Key?, Constant?, Integer?, Stream(Instrument)?, Status, Stream(Instrument), Stream(Instrument)).
select_instruments(_, _, 0, Hs, ok, [], Hs?).
select_instruments(Issuer, D, K, [coin(I, S)|Rest], Status?, [coin(I?, S?)|Sel?], Rem?) :-
    K? > 0, Issuer? =?= I?, D? =?= now |
    K1 := K? - 1,
    select_instruments(Issuer?, D?, K1?, Rest?, Status, Sel, Rem).
select_instruments(Issuer, D, K, [bond(I, M, S)|Rest], Status?, [bond(I?, M?, S?)|Sel?], Rem?) :-
    K? > 0, Issuer? =?= I?, D? =?= M? |
    K1 := K? - 1,
    select_instruments(Issuer?, D?, K1?, Rest?, Status, Sel, Rem).
select_instruments(Issuer, D, K, [X|Rest], Status?, Sel?, [X?|Rem?]) :-
    otherwise |
    select_instruments(Issuer?, D?, K?, Rest?, Status, Sel, Rem).
select_instruments(_, _, K, [], fail, [], []) :- K? > 0 | true.

%% One instrument of Issuer and due D out of the holdings, or not_found with
%% the holdings intact.
procedure take_instrument(Key?, Constant?, Stream(Instrument)?, Found, Stream(Instrument)).
take_instrument(Issuer, D, [coin(I, S)|Rest], found(coin(I?, S?)), Rest?) :-
    Issuer? =?= I?, D? =?= now | true.
take_instrument(Issuer, D, [bond(I, M, S)|Rest], found(bond(I?, M?, S?)), Rest?) :-
    Issuer? =?= I?, D? =?= M? | true.
take_instrument(Issuer, D, [X|Rest], Found?, [X?|Rem?]) :-
    otherwise |
    take_instrument(Issuer?, D?, Rest?, Found, Rem).
take_instrument(_, _, [], not_found, []).

%% One bond of Issuer maturing at D out of the holdings, or not_found with the
%% holdings intact.
procedure take_bond(Key?, Integer?, Stream(Instrument)?, Found, Stream(Instrument)).
take_bond(Issuer, D, [bond(I, M, S)|Rest], found(bond(I?, M?, S?)), Rest?) :-
    Issuer? =?= I?, D? =:= M? | true.
take_bond(Issuer, D, [X|Rest], Found?, [X?|Rem?]) :-
    otherwise |
    take_bond(Issuer?, D?, Rest?, Found, Rem).
take_bond(_, _, [], not_found, []).

%% Whether every instrument is a coin of the holder: what a payee takes as a
%% payment of its own coins.
procedure own_coins(Key?, Stream(Instrument)?, Decision).
own_coins(Id, [coin(I, _)|Rest], R?) :-
    Id? =?= I? |
    own_coins(Id?, Rest?, R).
own_coins(_, [_|_], no) :- otherwise | true.
own_coins(_, [], yes).

procedure count_instruments(Stream(Instrument)?, Integer?, Integer).
count_instruments([_|Xs], N, M?) :- N1 := N? + 1, count_instruments(Xs?, N1?, M).
count_instruments([], N, N?).

%% The holdings tallied by issuer and due, in order of first appearance.
procedure tally(Stream(Instrument)?, Stream(Lot)?, Stream(Lot)).
tally([coin(I, _)|Rest], Acc, Lots?) :-
    ground(I?) |
    tally_add(I?, now, Acc?, Acc1),
    tally(Rest?, Acc1?, Lots).
tally([bond(I, M, _)|Rest], Acc, Lots?) :-
    ground(I?), integer(M?) |
    tally_add(I?, M?, Acc?, Acc1),
    tally(Rest?, Acc1?, Lots).
tally([], Acc, Acc?).

procedure tally_add(Key?, Constant?, Stream(Lot)?, Stream(Lot)).
tally_add(I, D, [lot(I2, D2, N)|Rest], [lot(I2?, D2?, N1?)|Rest?]) :-
    I? =?= I2?, D? =?= D2? |
    N1 := N? + 1.
tally_add(I, D, [L|Rest], [L?|Rest1?]) :- otherwise | tally_add(I?, D?, Rest?, Rest1).
tally_add(I, D, [], [lot(I?, D?, 1)]).

%% The lots held, the holder's own apart, coins and bonds: what an issuer
%% discloses to a bearer whose presentation it cannot fulfil as named.
procedure menu_of(Key?, Stream(Instrument)?, Stream(Lot)?, Stream(Lot)).
menu_of(Id, [coin(I, _)|Rest], Acc, Menu?) :-
    Id? =?= I? |
    menu_of(Id?, Rest?, Acc?, Menu).
menu_of(Id, [bond(I, _, _)|Rest], Acc, Menu?) :-
    Id? =?= I? |
    menu_of(Id?, Rest?, Acc?, Menu).
menu_of(Id, [coin(I, _)|Rest], Acc, Menu?) :-
    otherwise |
    tally_add(I?, now, Acc?, Acc1),
    menu_of(Id?, Rest?, Acc1?, Menu).
menu_of(Id, [bond(I, M, _)|Rest], Acc, Menu?) :-
    otherwise |
    tally_add(I?, M?, Acc?, Acc1),
    menu_of(Id?, Rest?, Acc1?, Menu).
menu_of(_, [], Acc, Acc?).

%% =============================================================================
%% Warranties
%% =============================================================================

%% The warranties with the pair (Issuer, Date) added: the set union
%% w'_p = w_p + {(q, d*_q)} of mature.
procedure add_warranty(Key?, Integer?, Stream(Warranty)?, Stream(Warranty)).
add_warranty(Q, T, [dated(Q1, T1)|Rest], [dated(Q1?, T1?)|Rest?]) :-
    Q? =?= Q1?, T? =:= T1? | true.
add_warranty(Q, T, [W|Rest], [W?|Rest1?]) :-
    otherwise |
    add_warranty(Q?, T?, Rest?, Rest1).
add_warranty(Q, T, [], [dated(Q?, T?)]).

%% =============================================================================
%% Channels to counterparties
%% =============================================================================

%% Whether a channel to Q is among the outputs.
procedure has_peer(Key?, Stream(OutputEntry)?, Stream(OutputEntry), Decision).
has_peer(Q, [friend_output(K, Out?)|Rest], [friend_output(K?, Out)|Rest?], yes) :-
    Q? =?= K? | true.
has_peer(Q, [E|Rest], [E?|Rest1?], Known?) :-
    otherwise |
    has_peer(Q?, Rest?, Rest1, Known).
has_peer(_, [], [], no).

%% Adopt a channel to Q: its write side becomes Q's output entry and its read
%% side joins the network input.  An established link adopts nothing.
procedure adopt(Link?, Key?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
adopt(link(ch(In, Out?)), Q, Outs, Outs1?, NetIn, NetIn1?) :-
    ground(Q?) |
    add_friend_output(Q?, Out, Outs?, Outs1),
    merge(NetIn?, In?, NetIn1).
adopt(linked, _, Outs, Outs?, NetIn, NetIn?).

%% A channel held for a declined swap or transfer: its write side closes.  An
%% established link stays.
procedure drop_link(Link?).
drop_link(link(ch(_, []))).
drop_link(linked).

%% =============================================================================
%% Results injected into the agent's input
%% =============================================================================

%% The counterparty's answer to a proposed swap, when it comes, with the link
%% the proposal was made on.
procedure inject_swap_result(SwapResponse?, Key?, Link?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_swap_result(swap_accept(Given), Q, Link, Ys, [swap_accepted(Q?, Given?, Link?)|Ys?]) :-
    ground(Q?), ground(Given?) | true.
inject_swap_result(swap_decline(Given), Q, Link, Ys, [swap_declined_by(Q?, Given?, Link?)|Ys?]) :-
    ground(Q?), ground(Given?) | true.
inject_swap_result(R, Q, Link, [Y|Ys], [Y?|Ys1?]) :-
    inject_swap_result(R?, Q?, Link?, Ys?, Ys1).

%% The payee's answer to a payment of K coins, when it comes.
procedure inject_pay_result(PayResponse?, Key?, Integer?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_pay_result(pay_taken, Q, K, Ys, [pay_taken_by(Q?, K?)|Ys?]) :-
    ground(Q?) | true.
inject_pay_result(pay_returned(Coins), Q, _, Ys, [pay_returned_by(Q?, Coins?)|Ys?]) :-
    ground(Q?), ground(Coins?) | true.
inject_pay_result(R, Q, K, [Y|Ys], [Y?|Ys1?]) :-
    inject_pay_result(R?, Q?, K?, Ys?, Ys1).

%% The issuer's answer to a presentation for an instrument of R due D1, when
%% it comes.
procedure inject_redeem_result(RedeemResponse?, Key?, Key?, Constant?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_redeem_result(redeem_give(X), Q, R, D1, Ys, [redeem_given(Q?, R?, D1?, X?)|Ys?]) :-
    ground(Q?), ground(X?) | true.
inject_redeem_result(redeem_menu(Coin, Menu), Q, _, _, Ys, [redeem_menu_from(Q?, Coin?, Menu?)|Ys?]) :-
    ground(Q?), ground(Coin?), ground(Menu?) | true.
inject_redeem_result(redeem_declined(Coin), Q, _, _, Ys, [redeem_declined_by(Q?, Coin?)|Ys?]) :-
    ground(Q?), ground(Coin?) | true.
inject_redeem_result(Resp, Q, R, D1, [Y|Ys], [Y?|Ys1?]) :-
    inject_redeem_result(Resp?, Q?, R?, D1?, Ys?, Ys1).

%% The issuer's answer to a bond maturing at D presented to it, when it comes.
procedure inject_mature_result(MatureResponse?, Key?, Integer?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_mature_result(mature_give(Coin, T), Q, D, Ys, [matured_by(Q?, D?, Coin?, T?)|Ys?]) :-
    ground(Q?), ground(Coin?), integer(T?) | true.
inject_mature_result(mature_declined(Bond), Q, _, Ys, [not_matured_by(Q?, Bond?)|Ys?]) :-
    ground(Q?), ground(Bond?) | true.
inject_mature_result(Resp, Q, D, [Y|Ys], [Y?|Ys1?]) :-
    inject_mature_result(Resp?, Q?, D?, Ys?, Ys1).

%% The receiver's answer to a proposed transfer, when it comes, with the link
%% the proposal was made on.
procedure inject_transfer_result(TransferResponse?, Kind?, Key?, Link?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_transfer_result(transfer_accept, Kind, Q, Link, Ys, [transfer_accepted(Kind?, Q?, Link?)|Ys?]) :-
    ground(Kind?), ground(Q?) | true.
inject_transfer_result(transfer_decline(Given), Kind, Q, Link, Ys, [transfer_declined_by(Kind?, Q?, Given?, Link?)|Ys?]) :-
    ground(Kind?), ground(Q?), ground(Given?) | true.
inject_transfer_result(R, Kind, Q, Link, [Y|Ys], [Y?|Ys1?]) :-
    inject_transfer_result(R?, Kind?, Q?, Link?, Ys?, Ys1).

%% The bodies of the swap responder's two answers (decide_swap): the
%% acceptance, on yes, and the decline, on no.  Each hands the agent the offer
%% with the response writer and the link.
procedure accept_answer(Key?, Lot?, Stream(Instrument)?, SwapResponse, Link?, Stream(UserInMsg)).
accept_answer(From, Want, Offered, Resp?, Link, [accept_swap(From?, Want?, Offered?, Resp, Link?)]).

procedure decline_answer(Key?, Stream(Instrument)?, SwapResponse, Link?, Stream(UserInMsg)).
decline_answer(From, Offered, Resp?, Link, [decline_swap(From?, Offered?, Resp, Link?)]).

%% The same for the transfer responder (decide_transfer).
procedure accept_transfer_answer(Kind?, Key?, Stream(Instrument)?, TransferResponse, Link?, Stream(UserInMsg)).
accept_transfer_answer(Kind, From, Given, Resp?, Link, [accept_transfer(Kind?, From?, Given?, Resp, Link?)]).

procedure decline_transfer_answer(Kind?, Key?, Stream(Instrument)?, TransferResponse, Link?, Stream(UserInMsg)).
decline_transfer_answer(Kind, From, Given, Resp?, Link, [decline_transfer(Kind?, From?, Given?, Resp, Link?)]).

%% Binding a declined swap's response: the offered instruments go back.
procedure decline(SwapResponse, Stream(Instrument)?).
decline(swap_decline(Given?), Given).

%% Binding a transfer's response: taken, or the instruments go back.
procedure take_transfer(TransferResponse).
take_transfer(transfer_accept).

procedure decline_transfer_resp(TransferResponse, Stream(Instrument)?).
decline_transfer_resp(transfer_decline(Given?), Given).

%% =============================================================================
%% The screen, and the outputs
%% =============================================================================

procedure show(ScreenContent?, Stream(OutputEntry)?, Stream(OutputEntry)).
show(C, Outs, Outs1?) :- send_user(msg(agent, person, C?), Outs?, Outs1).

%% =============================================================================
%% Entry points: the village market of Section 7 of the paper, and the credit
%% line of its Section 5
%% =============================================================================

imported procedure village#market.
exported procedure village.
village :- village # market.

imported procedure credit_line#run.
exported procedure credit_line.
credit_line :- credit_line # run.

imported procedure collateral#run.
