%% ---------------------------------------------------------------------------
%% GB.glp --- the grassroots bonds contract, Currencies' (a contract is its
%% platform's paper's; Coordination Appendix C), in the term form
%% programs/gsc reads (its README, "Writing a contract"), with the numbers
%% act schemas allow (GB, Appendix A).  The clauses are in GB.txt beside
%% this file.  GB extends GKK, Grassroots Keys and
%% Knowledge, GSC's (programs/gsc/GKK.glp), so the term holds GKK's three
%% schemas, establish, meet and introduce; every role but establish's
%% requires identity.  The parties to a swap and to each escrow transfer
%% know each other, and pay, redeem and mature require knows(q) at p.
%%
%% Numbers, as act schemas allow them (GSC, Currencies' proposal of
%% 2026-10-20, Udi discussing it with GSC).  A numeric variable x is num(x),
%% and is listed in a schema's Vars in the order of its head.  A coin of u,
%% the paper's cent(u, bot), is coin(u); a bond of u maturing at d, the
%% paper's cent(u, d), is bond(u, num(d)); date(num(t)) at p is p's date.  A
%% schema whose maturity arguments range over coins and bonds is written
%% once for each kind: swap four times (cc, cb, bc, bb), redeem, deposit,
%% release and return twice (c, b), and mint twice (coin, bond).  A
%% multiplicity k on an atom A added or deleted is times(num(k), A).  A
%% schema with a constraint is nschema(Name, Vars, Constraint, Roles), the
%% constraint true, gt(X, Y), le(X, Y), succ(X, Y) (Y = X + 1) or
%% or(C1, C2).  A number names no person, so the three conditions concern
%% the persons a schema names; advance names none, and the issuer's role of
%% mature reads a date and neither guards nor changes its state.
%%
%% A role is rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i),
%% and is named by its index, role(1) the schema's first role; u, v, r and c
%% are agent variables, pvar; d, d1, k, k1, t, t1 are numeric variables.  Each
%% comment below names the clause a schema realises.  Written by Currencies
%% #11 Cowork, 2026-10-20.
%% ---------------------------------------------------------------------------

NameTerm   ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
             ; ext(NameTerm, Constant).
Arg        ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
             ; sgn(Constant, Integer) ; num(Constant).
Args       ::= [] ; [Arg | Args].
Atom       ::= atom(Constant, Args).
Atoms      ::= [] ; [Atom | Atoms].
Mult       ::= Atom ; times(Arg, Atom).
Mults      ::= [] ; [Mult | Mults].
Guard      ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind   ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec   ::= rs(Guard, Mults, Mults, Atoms, Atoms)
             ; crs(RoleKind, Guard, Mults, Mults, Atoms, Atoms).
RoleSpecs  ::= [] ; [RoleSpec | RoleSpecs].
Constraint ::= true ; gt(Arg, Arg) ; le(Arg, Arg) ; succ(Arg, Arg)
             ; or(Constraint, Constraint).
Reach      ::= reach(NameTerm, Constant, NameTerm).
Reaches    ::= [] ; [Reach | Reaches].
Schema     ::= schema(Constant, Args, RoleSpecs)
             ; nschema(Constant, Args, Constraint, RoleSpecs)
             ; cschema(Constant, Args, Reaches, RoleSpecs).
Contract   ::= [] ; [Schema | Contract].
Preds      ::= [] ; [Constant | Preds].
Declared   ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gb, C): the contract, GB (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gb,
%% GKK:1, Identity.
   [schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
%% GKK:2, Meeting.
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
%% GKK:3, Introduction: p, who knows q and c, introduces c to q, who knows p.
    schema(introduce, [pvar(c)],
       [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
        rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:1, Minting: p mints k coins.
    schema(mint_coin, [num(k)],
       [rs(guarded, [times(num(k), atom(coin, [role(1)]))], [], [atom(identity, [])], [])]),
%% GB:1, Minting: p mints k bonds maturing at d, later than p's date t.
    nschema(mint_bond, [num(d), num(k), num(t)], gt(num(d), num(t)),
       [rs(guarded, [times(num(k), atom(bond, [role(1), num(d)]))], [], [atom(identity, []), atom(date, [num(t)])], [])]),
%% GB:2, Date: p's date advances to the next day; no role guards it.
    nschema(advance, [num(t), num(t1)], succ(num(t), num(t1)),
       [rs(unguarded, [atom(date, [num(t1)])], [atom(date, [num(t)])], [atom(identity, [])], [])]),
%% GB:3, Swap: p and q, who know each other, swap k coins of u for k1 coins of v.
    schema(swap_cc, [pvar(u), num(k), pvar(v), num(k1)],
       [rs(guarded, [times(num(k1), atom(coin, [pvar(v)]))], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)]))], [times(num(k1), atom(coin, [pvar(v)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:3, Swap: k coins of u for k1 bonds of v maturing at d1.
    schema(swap_cb, [pvar(u), num(k), pvar(v), num(d1), num(k1)],
       [rs(guarded, [times(num(k1), atom(bond, [pvar(v), num(d1)]))], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)]))], [times(num(k1), atom(bond, [pvar(v), num(d1)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:3, Swap: k bonds of u maturing at d for k1 coins of v.
    schema(swap_bc, [pvar(u), num(d), num(k), pvar(v), num(k1)],
       [rs(guarded, [times(num(k1), atom(coin, [pvar(v)]))], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)]))], [times(num(k1), atom(coin, [pvar(v)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:3, Swap: k bonds of u maturing at d for k1 bonds of v maturing at d1.
    schema(swap_bb, [pvar(u), num(d), num(k), pvar(v), num(d1), num(k1)],
       [rs(guarded, [times(num(k1), atom(bond, [pvar(v), num(d1)]))], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)]))], [times(num(k1), atom(bond, [pvar(v), num(d1)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:4, Payment: p pays k coins of q to q, whom p knows.
    schema(pay, [num(k)],
       [rs(guarded,   [], [times(num(k), atom(coin, [role(2)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [times(num(k), atom(coin, [role(2)]))], [], [atom(identity, [])], [])]),
%% GB:5, Redemption: p redeems a q-coin against a coin of r held by q, whom p knows.
    schema(redeem_c, [pvar(r)],
       [rs(guarded,   [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [atom(identity, [])], [])]),
%% GB:5, Redemption: p redeems a q-coin against a bond of r maturing at d1 held by q.
    schema(redeem_b, [pvar(r), num(d1)],
       [rs(guarded,   [atom(bond, [pvar(r), num(d1)])], [atom(coin, [role(2)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(coin, [role(2)])], [atom(bond, [pvar(r), num(d1)])], [atom(identity, [])], [])]),
%% GB:5, Redemption: p takes a q-coin for a q-bond maturing at d, mature by q's date t; q's role reads the date and changes nothing.
    nschema(mature, [num(d), num(t)], le(num(d), num(t)),
       [rs(guarded,   [atom(coin, [role(2)])], [atom(bond, [role(2), num(d)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [], [], [atom(identity, []), atom(date, [num(t)])], [])]),
%% GB:7, Escrow: p deposits k coins of u with the escrow agent e; they know each other.
    schema(deposit_c, [pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:7, Escrow: p deposits k bonds of u maturing at d with e.
    schema(deposit_b, [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:7, Escrow: e releases k coins of u to q; they know each other.
    schema(release_c, [pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:7, Escrow: e releases k bonds of u maturing at d to q.
    schema(release_b, [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:7, Escrow: e returns k coins of u to the depositor p; they know each other.
    schema(return_c, [pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:7, Escrow: e returns k bonds of u maturing at d to p.
    schema(return_b, [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])])]).
