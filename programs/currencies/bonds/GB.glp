%% GB.glp --- printed by adopt.py from GB.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit GB.txt and run adopt.py GB.
% contract_named(gb, C): the contract, GB.
procedure contract_named(Constant?, SDeclared).
contract_named(gb, environment([today], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(issue, ['Alice'], ['Sum'], [times(num('Sum'), atom(coin, ['Alice', 'Alice']))], [atom(identity, ['Alice'])], true, ['Alice']),
 sas(swap, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Sum', 'Dave', 'Total'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol']))), times(num('Sum'), atom(coin, ['Bob', 'Carol'])), not(times(num('Total'), atom(coin, ['Bob', 'Dave']))), times(num('Total'), atom(coin, ['Alice', 'Dave'])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(coin, ['Alice', 'Carol'])), times(num('Total'), atom(coin, ['Bob', 'Dave']))], true, ['Alice', 'Bob']),
 sas(pay, ['Alice', 'Bob'], ['Sum'], [not(times(num('Sum'), atom(coin, ['Alice', 'Bob']))), times(num('Sum'), atom(coin, ['Bob', 'Bob']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Bob']))], true, ['Alice']),
 sas(redeem, ['Alice', 'Bob', 'Carol'], ['Carol'], [not(atom(coin, ['Alice', 'Bob'])), atom(coin, ['Bob', 'Bob']), not(atom(coin, ['Bob', 'Carol'])), atom(coin, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(coin, ['Alice', 'Bob']), atom(coin, ['Bob', 'Carol'])], true, ['Alice']),
 sas(issue_bond, ['Alice'], ['Day', 'Sum', 'Today'], [times(num('Sum'), atom(bond, ['Alice', 'Alice', num('Day')]))], [atom(identity, ['Alice']), atom(today, ['Alice', num('Today')])], gt(num('Day'), num('Today')), ['Alice']),
 sas(swap_coin_for_bond, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Sum', 'Dave', 'Day', 'Total'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol']))), times(num('Sum'), atom(coin, ['Bob', 'Carol'])), not(times(num('Total'), atom(bond, ['Bob', 'Dave', num('Day')]))), times(num('Total'), atom(bond, ['Alice', 'Dave', num('Day')])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(coin, ['Alice', 'Carol'])), times(num('Total'), atom(bond, ['Bob', 'Dave', num('Day')]))], true, ['Alice', 'Bob']),
 sas(swap_bonds, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Day', 'Sum', 'Dave', 'Term', 'Total'], [not(times(num('Sum'), atom(bond, ['Alice', 'Carol', num('Day')]))), times(num('Sum'), atom(bond, ['Bob', 'Carol', num('Day')])), not(times(num('Total'), atom(bond, ['Bob', 'Dave', num('Term')]))), times(num('Total'), atom(bond, ['Alice', 'Dave', num('Term')])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(bond, ['Alice', 'Carol', num('Day')])), times(num('Total'), atom(bond, ['Bob', 'Dave', num('Term')]))], true, ['Alice', 'Bob']),
 sas(redeem_coin_against_bond, ['Alice', 'Bob', 'Carol'], ['Carol', 'Day'], [not(atom(coin, ['Alice', 'Bob'])), atom(coin, ['Bob', 'Bob']), not(atom(bond, ['Bob', 'Carol', num('Day')])), atom(bond, ['Alice', 'Carol', num('Day')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(coin, ['Alice', 'Bob']), atom(bond, ['Bob', 'Carol', num('Day')])], true, ['Alice']),
 sas(redeem_bond, ['Alice', 'Bob', 'Carol'], ['Day', 'Carol', 'Today'], [not(atom(bond, ['Alice', 'Bob', num('Day')])), atom(bond, ['Bob', 'Bob', num('Day')]), not(atom(coin, ['Bob', 'Carol'])), atom(coin, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(today, ['Bob', num('Today')]), atom(bond, ['Alice', 'Bob', num('Day')]), atom(coin, ['Bob', 'Carol'])], le(num('Day'), num('Today')), ['Alice']),
 sas(redeem_bond_against_bond, ['Alice', 'Bob', 'Carol'], ['Day', 'Carol', 'Term', 'Today'], [not(atom(bond, ['Alice', 'Bob', num('Day')])), atom(bond, ['Bob', 'Bob', num('Day')]), not(atom(bond, ['Bob', 'Carol', num('Term')])), atom(bond, ['Alice', 'Carol', num('Term')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(today, ['Bob', num('Today')]), atom(bond, ['Alice', 'Bob', num('Day')]), atom(bond, ['Bob', 'Carol', num('Term')])], le(num('Day'), num('Today')), ['Alice']),
 sas(deposit, ['Alice', 'Carol', 'Dave', 'Bob'], ['Dave', 'Sum', 'Bob', 'Cond'], [not(times(num('Sum'), atom(coin, ['Alice', 'Dave']))), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Dave']))], true, ['Alice', 'Carol']),
 sas(deposit_bond, ['Alice', 'Carol', 'Dave', 'Bob'], ['Dave', 'Day', 'Sum', 'Bob', 'Cond'], [not(times(num('Sum'), atom(bond, ['Alice', 'Dave', num('Day')]))), times(num('Sum'), atom(escrow_bond, ['Carol', 'Dave', num('Day'), 'Alice', 'Bob', 'Cond']))], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(bond, ['Alice', 'Dave', num('Day')]))], true, ['Alice', 'Carol']),
 sas(release, ['Carol', 'Bob', 'Dave', 'Alice'], ['Dave', 'Alice', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(coin, ['Bob', 'Dave'])), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Bob']),
 sas(release_bond, ['Carol', 'Bob', 'Dave', 'Alice'], ['Dave', 'Day', 'Alice', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_bond, ['Carol', 'Dave', num('Day'), 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(bond, ['Bob', 'Dave', num('Day')])), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), times(num('Sum'), atom(escrow_bond, ['Carol', 'Dave', num('Day'), 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Bob']),
 sas(return, ['Carol', 'Alice', 'Dave', 'Bob'], ['Dave', 'Bob', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(coin, ['Alice', 'Dave'])), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Alice']),
 sas(return_bond, ['Carol', 'Alice', 'Dave', 'Bob'], ['Dave', 'Day', 'Bob', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_bond, ['Carol', 'Dave', num('Day'), 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(bond, ['Alice', 'Dave', num('Day')])), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), times(num('Sum'), atom(escrow_bond, ['Carol', 'Dave', num('Day'), 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Alice'])]))).
