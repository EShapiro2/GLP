%% ---------------------------------------------------------------------------
%% GB.glp --- the grassroots bonds contract, Currencies' (a contract is its
%% platform's paper's; Coordination Appendix C), in the term form
%% programs/gsc reads (its README, "Writing a contract"), with the numbers
%% act schemas allow (GSC, Section 3.2; GB, Appendix A).  The clauses are in
%% GB.txt beside this file.  GB extends GKK, Grassroots Keys and Knowledge,
%% GSC's (programs/gsc/GKK.glp), so the term holds GKK's three schemas,
%% establish, meet and introduce; establish forbids the identity it adds
%% (GKK:1, act once; Udi, 2026-10-23, to GSC #6), and every other role
%% requires identity.  The parties to a swap and to each escrow transfer
%% know each other, and pay and redeem require knows(q) at p.  A matured
%% bond is redeemed as a coin is (clause 5; Udi, 2026-10-20): redeem
%% presents a coin or a bond mature by its issuer's date, and the issuer's
%% role reads its own date and changes state.
%%
%% The predicates are GKK's identity and knows and two of GB's own.
%% cent(u, d) at p is an instrument issued by u, due at d and held by p, the
%% paper's cent(u, d): a bond due at the day d, and a coin due at 0, the
%% paper's bot, since a coin is due now and every date is at least 0, so a
%% coin satisfies redeem's constraint at every date and fails mint_bond's.
%% date(t) at p is p's date, and today(d) at p is the day, which the
%% platform writes from the device's calendar and no schema adds or deletes
%% (vGLP, Section 5.4; Udi, 2026-10-24): first_date gives p the day as their
%% date once, the mark dated forbidding a second, and advance takes the date
%% to the next day while the day is not past; so GB:2 is realised by two
%% unguarded schemas and the calendar.  A numeric variable x is num(x), listed in a
%% schema's Vars in the order of the paper's head, and num(0) is the number
%% 0.  A multiplicity k on an atom A added or deleted is times(num(k), A),
%% and a multiplicity is a positive whole number (GSC, 2026-10-23), so the
%% schemas carry no constraint on amounts.  A schema with a constraint is
%% nschema(Name, Vars, Constraint, Roles), the constraint a conjunction,
%% and(C1, C2), of gt(X, Y), le(X, Y) and succ(X, Y) (Y = X + 1) (GSC,
%% Definition Schema with values: a conjunction of linear equalities and
%% inequalities).  A number names no person, so the
%% three conditions concern the persons a schema names; advance names none.
%%
%% The ten schemas of GB are the eight of Appendix A, mint written once
%% for a coin and once for a bond, clause 1 describing the two acts, so
%% that each has its button (GB.txt, Pragmas), and first_date; a swap, a redemption and an
%% escrow transfer each take coins and bonds alike in one schema, the due
%% an argument.  This replaces the twenty-one terms of 2026-10-20, which
%% wrote a schema once for each kind of instrument it took.  A role is
%% rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i), and is
%% named by its index, role(1) the schema's first role; u, v, r and c are
%% agent variables, pvar; d, d1, k, k1, t, t1 are numeric variables.  Each
%% comment below names the clause a schema realises.  The beneficiary and
%% the condition of an escrow (clause 7) are the escrow agreement's, held
%% by the escrow agent, and name no role of a transfer (GB, Section 5).
%% Written by Currencies #11 Cowork, 2026-10-20; rewritten by Currencies
%% #12 Cowork, 2026-10-23, first_date and today added 2026-10-24.
%% ---------------------------------------------------------------------------

NameTerm   ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
             ; ext(NameTerm, Constant).
Arg        ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
             ; sgn(Constant, Integer) ; num(Constant).
Args       ::= [] ; [Arg | Args].
Atom       ::= atom(Constant, Args).
Atoms      ::= [] ; [Atom | Atoms].
Mult       ::= Atom ; times(Arg, Atom).
Mults      ::= [] ; [Mult | Mults].
Guard      ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind   ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec   ::= rs(Guard, Mults, Mults, Atoms, Atoms)
             ; crs(RoleKind, Guard, Mults, Mults, Atoms, Atoms).
RoleSpecs  ::= [] ; [RoleSpec | RoleSpecs].
Constraint ::= true ; and(Constraint, Constraint)
             ; gt(Arg, Arg) ; le(Arg, Arg) ; succ(Arg, Arg).
Reach      ::= reach(NameTerm, Constant, NameTerm).
Reaches    ::= [] ; [Reach | Reaches].
Schema     ::= schema(Constant, Args, RoleSpecs)
             ; nschema(Constant, Args, Constraint, RoleSpecs)
             ; cschema(Constant, Args, Reaches, RoleSpecs).
Contract   ::= [] ; [Schema | Contract].
Preds      ::= [] ; [Constant | Preds].
Declared   ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gb, C): the contract, GB (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gb,
%% GKK:1, Identity: act once, so establish forbids the identity it adds.
   [schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]),
%% GKK:2, Meeting.
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
%% GKK:3, Introduction: p, who knows q and c, introduces c to q, who knows p.
    schema(introduce, [pvar(c)],
       [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
        rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:1, Minting: p mints k p-coins.
    schema(mint_coin, [num(k)],
       [rs(guarded, [times(num(k), atom(cent, [role(1), num(0)]))], [], [atom(identity, [])], [])]),
%% GB:1, Minting: p mints k p-bonds maturing at d, later than p's date t.
    nschema(mint_bond, [num(d), num(k), num(t)], gt(num(d), num(t)),
       [rs(guarded, [times(num(k), atom(cent, [role(1), num(d)]))], [], [atom(identity, []), atom(date, [num(t)])], [])]),
%% GB:2, Date: p's first date is the day, once; no role guards it.
    schema(first_date, [num(d)],
       [rs(unguarded, [atom(date, [num(d)]), atom(dated, [])], [], [atom(identity, []), atom(today, [num(d)])], [atom(dated, [])])]),
%% GB:2, Date: p's date advances to the next day, not past the day; no role guards it.
    nschema(advance, [num(t), num(t1), num(d)], and(succ(num(t), num(t1)), le(num(t1), num(d))),
       [rs(unguarded, [atom(date, [num(t1)])], [atom(date, [num(t)])], [atom(identity, []), atom(today, [num(d)])], [])]),
%% GB:3, Swap: p and q, who know each other, swap k instruments of u due at d for k1 instruments of v due at d1.
    schema(swap, [pvar(u), num(d), num(k), pvar(v), num(d1), num(k1)],
       [rs(guarded, [times(num(k1), atom(cent, [pvar(v), num(d1)]))], [times(num(k), atom(cent, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(cent, [pvar(u), num(d)]))], [times(num(k1), atom(cent, [pvar(v), num(d1)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:4, Payment: p pays k q-coins to q, whom p knows.
    schema(pay, [num(k)],
       [rs(guarded,   [], [times(num(k), atom(cent, [role(2), num(0)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [times(num(k), atom(cent, [role(2), num(0)]))], [], [atom(identity, [])], [])]),
%% GB:5, Redemption: p redeems a q-coin, or a q-bond due at d and mature by q's date t, against an instrument of r due at d1 held by q, whom p knows.
    nschema(redeem, [num(d), pvar(r), num(d1), num(t)], le(num(d), num(t)),
       [rs(guarded,   [atom(cent, [pvar(r), num(d1)])], [atom(cent, [role(2), num(d)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(cent, [role(2), num(d)])], [atom(cent, [pvar(r), num(d1)])], [atom(identity, []), atom(date, [num(t)])], [])]),
%% GB:7, Escrow: p deposits k instruments of u due at d with the escrow agent e; they know each other.
    schema(deposit, [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(cent, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(cent, [pvar(u), num(d)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:7, Escrow: e releases k instruments of u due at d to q; they know each other.
    schema(release, [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(cent, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(cent, [pvar(u), num(d)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GB:7, Escrow: e returns k instruments of u due at d to the depositor p; they know each other.
    schema(return, [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(cent, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(cent, [pvar(u), num(d)]))], [], [atom(identity, []), atom(knows, [role(1)])], [])])]).
