%% collateral.glp --- collateral, item 1 of Appendix C of "Grassroots Bonds",
%% on the compiled bond agent, with both of its outcomes in one run.
%%
%% The construction is three transfers: the borrower deposits bonds with the
%% escrow agent; on default the agent releases them to the lender; on
%% fulfilment it returns them to the borrower.  Each is guarded by the escrow
%% agent and the counterparty, as every escrow transfer is.
%%
%% Lender Alice, borrower Bob, third party Carol whose coins are the security
%% --- personal coins acquired through bilateral mutual credit, which is what
%% Appendix E says serves as collateral --- and the escrow agent.
%%
%%   0. mutual credit    Carol gives Bob 6 carol-coins for 6 bob-coins, so Bob
%%                       holds coins that are not his own to post
%%   1. loan, repaid     Alice gives Bob 5 alice-coins for 6 bob-bonds maturing
%%                       day 20 --- 5 lent, 1 of interest
%%   2. collateral       Bob deposits 3 carol-coins with the escrow agent
%%   3. fulfilment       Bob redeems his 5 alice-coins from Alice, taking back
%%                       a bob-bond each time; Alice is left holding the one
%%                       coupon bond
%%   4. return           the escrow agent returns the 3 carol-coins to Bob
%%   5. loan, defaulted  Alice gives Bob 5 more alice-coins for 6 bob-bonds
%%                       maturing day 30
%%   6. collateral       Bob deposits his other 3 carol-coins
%%   7. release          Bob repays nothing and the escrow agent releases the
%%                       3 carol-coins to Alice
%%
%% WHERE THE JUDGEMENT COMES FROM, and why that is the specification rather
%% than a stopgap (Udi, 2026-09-15).  An attestation is not an act of the
%% contract.  The escrow agent judges from what it sees --- its own date and
%% the deposits it holds --- and an outside event reaches it outside the
%% contract, exactly as the payment of a fiat coin does.  Bob's default is such
%% an event, so the escrow agent's judgement of it enters the program from its
%% person: the order of the two outcomes here is the order of its script.  The
%% date-based escrows (village.glp), the credit line (credit_line.glp) and the
%% packaged exchange (loans.glp) need no script for their conditions, those
%% being the agent's own date and the deposits it receives.
%%
%% Entry point: run/0, exported by self.glp as collateral/0.

imported procedure village#villager(Key?, Script?, Stream(Conversation)?).

exported procedure run.
run :-
    village # villager(alice,
        [mint(5), swap(bob, alice, now, 5, bob, 20, 6),
         await(presented(bob, bob, 20)), await(presented(bob, bob, 20)),
         await(presented(bob, bob, 20)), await(presented(bob, bob, 20)),
         await(presented(bob, bob, 20)),
         mint(5), swap(bob, alice, now, 5, bob, 30, 6),
         accept_transfer(escrow)],
        [conversation(bob, ch(AB?, BA)), conversation(escrow, ch(AG?, GA))]),
    village # villager(bob,
        [mint(6), accept(carol),
         mint(6, 20), accept(alice),
         deposit(escrow, carol, now, 3),
         redeem(alice, bob, 20), redeem(alice, bob, 20),
         redeem(alice, bob, 20), redeem(alice, bob, 20),
         redeem(alice, bob, 20),
         accept_transfer(escrow),
         mint(6, 30), accept(alice),
         deposit(escrow, carol, now, 3)],
        [conversation(alice, ch(BA?, AB)), conversation(carol, ch(BC?, CB)), conversation(escrow, ch(BG?, GB))]),
    village # villager(carol,
        [mint(6), swap(bob, carol, now, 6, bob, now, 6)],
        [conversation(bob, ch(CB?, BC))]),
    village # villager(escrow,
        [accept_transfer(bob),
         return(bob, carol, now, 3),
         accept_transfer(bob),
         release(alice, carol, now, 3)],
        [conversation(bob, ch(GB?, BG)), conversation(alice, ch(GA?, AG))]).
