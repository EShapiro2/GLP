on_act(Med, payout(F, Coins, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(F?), ground(Coins?) | take_accepted(Med?, From?, From?, F?, Coins?, Resp, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?).
on_act(Med, spend(Q, F, Coins, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Q?), ground(F?), ground(Coins?) | own_coins(Id?, Coins?, Own), countersign(Med?, Own?, From?, Q?, F?, Coins?, Resp, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?).
on_act(Med, spent(P, F, Coins, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(P?), ground(F?), ground(Coins?) | take_accepted(Med?, P?, From?, F?, Coins?, Resp, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?).
on_act(Med, redeem(Coin, R, D1, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Coin?), ground(R?), ground(D1?) | fulfil(Med?, Coin?, R?, D1?, Resp, Id?, From?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?).
on_act(Med, mature(Bond, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Bond?) | grant(Med?, Bond?, Id?, Date?, Serial?, Resp, From?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Ws?, As?).
on_act(Med, swap(Want, Offered, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Want?), ground(Offered?) | med_split(Med?, Medb, Medr), respond_swap(Medb?, offer(From?, Want?, Offered?), Resp, Ans, none), merge(Ans?, UserIn?, UserIn1), agent(Medr?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).
on_act(Med, transfer(Kind, Given, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Kind?), ground(Given?) | med_split(Med?, Medb, Medr), respond_transfer(Medb?, offer_transfer(Kind?, From?, Given?), Resp, Ans, none), merge(Ans?, UserIn?, UserIn1), agent(Medr?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure take_payment(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Stream(Instrument)?, PayResponse, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
take_payment(Med, yes, Id, From, Coins, pay_taken, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Coins?) | append_instruments(Holdings?, Coins?, Holdings1), count_instruments(Coins?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As?, Serial?).
take_payment(Med, no, Id, From, Coins, pay_returned(Coins?), UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Coins?) | count_instruments(Coins?, 0, K), show(refused_payment(From?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure take_accepted(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Stream(Instrument)?, PayResponse, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
take_accepted(Med, P, U, F, Coins, Resp?, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Coins?), ground(As?) | issued_by(U?, F?, Coins?, Valid), count_instruments(Coins?, 0, K), count_acceptances(U?, F?, As?, 0, N), admit(Med?, Valid?, K?, N?, P?, U?, F?, Coins?, Resp, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?).

procedure admit(Channel(Closed, Stream(AgentMsg))?, Constant?, Integer?, Integer?, Constant?, Constant?, Constant?, Stream(Instrument)?, PayResponse, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
admit(Med, yes, K, N, P, U, F, Coins, pay_taken, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- (K? =< N?) | delete_acceptances(U?, F?, K?, As?, As1), append_instruments(Holdings?, Coins?, Holdings1), show(received_from(P?, U?, K?), Outs?, Outs1), after_accepting(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As1?, Serial?).
admit(Med, _, K, _, P, U, _, Coins, pay_returned(Coins?), Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- otherwise | show(refused_from(P?, U?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure countersign(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Stream(Instrument)?, PayResponse, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
countersign(Med, yes, P, Q, F, Coins, Resp?, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), forward_spend(Med?, Known?, P?, Q?, F?, Coins?, Resp, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?).
countersign(Med, no, P, _, _, Coins, pay_returned(Coins?), Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Coins?) | count_instruments(Coins?, 0, K), show(refused_payment(P?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure forward_spend(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Stream(Instrument)?, PayResponse, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
forward_spend(Med, yes, P, Q, F, Coins, Resp?, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Q?), ground(Coins?) | send_friend(Q?, msg(Id?, Q?, spent(P?, F?, Coins?, Resp1)), Outs?, Outs1), count_instruments(Coins?, 0, K), relay_spend(Resp1?, P?, Q?, K?, Resp, UserIn?, UserIn1), agent(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).
forward_spend(Med, no, _, Q, _, Coins, pay_returned(Coins?), Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure fulfil(Channel(Closed, Stream(AgentMsg))?, Instrument?, Constant?, Constant?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
fulfil(Med, coin(I, F, S), R, D1, Resp?, Id, From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- (I? =?= Id?) | take_instrument(R?, F?, D1?, Holdings?, Found, Rest), give(Med?, Found?, coin(I?, F?, S?), R?, D1?, Resp, Id?, From?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Rest?, Date?, Ws?, As?, Serial?).
fulfil(Med, X, _, _, redeem_declined(X?), Id, From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- otherwise | show(refused(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure give(Channel(Closed, Stream(AgentMsg))?, Found?, Instrument?, Constant?, Constant?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
give(Med, found(X), Mine, R, D1, redeem_give(X?), Id, From, UserIn, PeerIn, Convs, Cal, Outs, Rest, Date, Ws, As, Serial) :- append_instruments(Rest?, [Mine?], Holdings1), show(presented(From?, R?, D1?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As?, Serial?).
give(Med, not_found, Mine, R, D1, redeem_menu(Mine?, Menu?), Id, From, UserIn, PeerIn, Convs, Cal, Outs, Rest, Date, Ws, As, Serial) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?, D1?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure grant(Channel(Closed, Stream(AgentMsg))?, Instrument?, Constant?, Integer?, Integer?, MatureResponse, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Stream(Warranty)?, Stream(Acceptance)?).
grant(Med, bond(I, F, M, _), Id, Date, Serial, mature_give(coin(Id?, F?, Serial?), Date?), From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, As) :- (I? =?= Id?), (M? =< Date?) | Serial1 := (Serial? + 1), show(matured_for(From?, M?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial1?, none, none, none, none, none, none, none, none, none, none, none, none).
grant(Med, bond(I, F, M, S), Id, Date, Serial, mature_declined(bond(I?, F?, M?, S?)), From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, As) :- otherwise | show(not_mature_for(From?, M?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).
grant(Med, coin(I, F, S), Id, Date, Serial, mature_declined(coin(I?, F?, S?)), From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, As) :- show(refused(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure fill_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, SwapResponse, Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
fill_swap(Med, ok, Id, From, swap_accept(Give?), Give, Offered, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As?, Serial?).
fill_swap(Med, fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure do_accept(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Integer?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
do_accept(Med, yes, Id, U, F, L, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- add_acceptances(U?, F?, L?, As?, As1), show(accepted(U?, F?, L?), Outs?, Outs1), acceptances_changed(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As1?, Serial?).
do_accept(Med, no, Id, U, F, _, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- show(not_held(U?, F?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure propose_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Lot?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
propose_swap(Med, ok, Id, Q, _, Want, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?), ground(Want?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_swap(Med?, Known?, Id?, Q?, Want?, Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?).
propose_swap(Med, fail, Id, Q, lot(U, _, D, K), _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure send_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
send_swap(Med, yes, Id, Q, Want, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, UserIn?, UserIn1), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?).
send_swap(Med, no, Id, Q, _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure propose_transfer(Channel(Closed, Stream(AgentMsg))?, Constant?, Kind?, Constant?, Constant?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
propose_transfer(Med, ok, Kind, Id, Q, Lot, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Kind?), ground(Q?), ground(Lot?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_transfer(Med?, Known?, Kind?, Id?, Q?, Lot?, Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?).
propose_transfer(Med, fail, _, Id, _, lot(U, _, D, K), Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure send_transfer(Channel(Closed, Stream(AgentMsg))?, Constant?, Kind?, Constant?, Constant?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
send_transfer(Med, yes, Kind, Id, Q, Lot, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Kind?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, UserIn?, UserIn1), show(offered_transfer(Kind?, Q?, Lot?), Outs1?, Outs2), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Ws?, As?, Serial?).
send_transfer(Med, no, _, Id, Q, _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure do_pay(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
do_pay(Med, ok, Id, Q, _, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Med?, Known?, Id?, Q?, Q?, pay(Give?, Resp), Resp?, paying(Q?, K?), paid(Q?, K?), Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?).
do_pay(Med, fail, Id, Q, _, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(lacking(Q?, now, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure do_payout(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
do_payout(Med, ok, Id, Q, F, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Med?, Known?, Id?, Q?, Q?, payout(F?, Give?, Resp), Resp?, paying_out(Q?, K?), paid_out(Q?, K?), Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?).
do_payout(Med, fail, Id, _, _, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Id?) | append_instruments(Give?, Rest?, Orig), show(lacking(Id?, now, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure do_spend(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Constant?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
do_spend(Med, ok, Id, Q, S, F, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?), ground(S?), ground(Give?) | has_peer(S?, Outs?, Outs1, Known), send_pay(Med?, Known?, Id?, S?, Q?, spend(Q?, F?, Give?, Resp), Resp?, spending(Q?, S?, K?), spent_at(Q?, S?, K?), Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?).
do_spend(Med, fail, Id, _, S, _, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(lacking(S?, now, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure send_pay(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, PeerContent?, PayResponse?, ScreenContent?, ScreenContent?, Stream(Instrument)?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
send_pay(Med, yes, Id, To, Q, Act, Resp, Paying, Taken, _, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(To?) | send_friend(To?, msg(Id?, To?, Act?), Outs?, Outs1), inject_pay_result(Resp?, Q?, Taken?, UserIn?, UserIn1), show(Paying?, Outs1?, Outs2), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Ws?, As?, Serial?).
send_pay(Med, no, Id, To, _, _, _, _, _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(To?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure do_redeem(Channel(Closed, Stream(AgentMsg))?, Found?, Constant?, Constant?, Constant?, Constant?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
do_redeem(Med, found(Coin), Id, Q, R, D1, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_redeem(Med?, Known?, Id?, Q?, R?, D1?, Coin?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?).
do_redeem(Med, not_found, Id, Q, _, _, Holdings, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- show(lacking(Q?, now, 1), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure send_redeem(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Constant?, Instrument?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
send_redeem(Med, yes, Id, Q, R, D1, Coin, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, redeem(Coin?, R?, D1?, Resp)), Outs?, Outs1), inject_redeem_result(Resp?, Q?, R?, D1?, UserIn?, UserIn1), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?).
send_redeem(Med, no, Id, Q, _, _, Coin, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Rest?, [Coin?], Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure do_mature(Channel(Closed, Stream(AgentMsg))?, Found?, Constant?, Constant?, Integer?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
do_mature(Med, found(Bond), Id, Q, D, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_mature(Med?, Known?, Id?, Q?, D?, Bond?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?).
do_mature(Med, not_found, Id, Q, D, Holdings, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- show(lacking(Q?, D?, 1), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure send_mature(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Integer?, Instrument?, Stream(Instrument)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
send_mature(Med, yes, Id, Q, D, Bond, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, mature(Bond?, Resp)), Outs?, Outs1), inject_mature_result(Resp?, Q?, D?, UserIn?, UserIn1), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?).
send_mature(Med, no, Id, Q, _, Bond, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial) :- append_instruments(Rest?, [Bond?], Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure after_change(Channel(Closed, Stream(AgentMsg))?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
after_change(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

procedure after_accepting(Channel(Closed, Stream(AgentMsg))?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
after_accepting(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(As?) | tally_acceptances(As?, [], Tally), show(acceptances(Tally?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?).

procedure acceptances_changed(Channel(Closed, Stream(AgentMsg))?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?).
acceptances_changed(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial) :- ground(As?) | tally_acceptances(As?, [], Tally), show(acceptances(Tally?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, none, none, none, none, none, none, none, none, none, none, none, none).

%% --- the mediator, and the pending table with the program's clauses ahead of the search clauses ---
exported procedure med(Channel(Stream(UserAnswer), Stream(Card))?, Channel(Stream(AgentMsg), Closed)?, PendingList?, Integer?).
med(UserCh, AgentCh, Ps, N) :- receive(ask(C, Ctx, Esc, Id?), AgentCh?, AgentCh1), ground(C?), ground(Ctx?) | Id = req(N?), send(card(C?, Ctx?, req(N?)), UserCh?, UserCh1), N1 := (N? + 1), med(UserCh1?, AgentCh1?, [pending(req(N?), Esc?) | Ps?], N1?).
med(UserCh, AgentCh, Ps, N) :- receive(answer(ReqId, Vs), UserCh?, UserCh1), ground(ReqId?), ground(Vs?) | answer(ReqId?, Vs?, Ps?, Ps1), send(closed(ReqId?), UserCh1?, UserCh2), med(UserCh2?, AgentCh?, Ps1?, N?).
med(UserCh, AgentCh, Ps, N) :- receive(decline(ReqId), UserCh?, UserCh1), ground(ReqId?) | close(ReqId?, Ps?, Ps1), send(closed(ReqId?), UserCh1?, UserCh2), med(UserCh2?, AgentCh?, Ps1?, N?).
med(UserCh, AgentCh, Ps, N) :- receive(abort(ReqId), AgentCh?, AgentCh1), ground(ReqId?) | drop(ReqId?, Ps?, Ps1), send(aborted(ReqId?), UserCh?, UserCh1), med(UserCh1?, AgentCh1?, Ps1?, N?).

exported procedure answer(ReqId?, Answer?, PendingList?, PendingList).
answer(ReqId, xs_respond_swap_1(X1), [pending(Id, esc_respond_swap_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_swap_1(X1?)).
answer(ReqId, xs_respond_transfer_1(X1), [pending(Id, esc_respond_transfer_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_transfer_1(X1?)).
answer(ReqId, xs_agent_1(X1, X2), [pending(Id, esc_agent_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_1(X1?, X2?)).
answer(ReqId, xs_agent_2(X1, X2, X3), [pending(Id, esc_agent_2(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_2(X1?, X2?, X3?)).
answer(ReqId, xs_agent_3(X1, X2, X3, X4, X5, X6, X7, X8), [pending(Id, esc_agent_3(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_3(X1?, X2?, X3?, X4?, X5?, X6?, X7?, X8?)).
answer(ReqId, xs_agent_4(X1, X2, X3), [pending(Id, esc_agent_4(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_4(X1?, X2?, X3?)).
answer(ReqId, xs_agent_5(X1, X2, X3), [pending(Id, esc_agent_5(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_5(X1?, X2?, X3?)).
answer(ReqId, xs_agent_6(X1, X2, X3), [pending(Id, esc_agent_6(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_6(X1?, X2?, X3?)).
answer(ReqId, xs_agent_7(X1, X2, X3, X4), [pending(Id, esc_agent_7(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_7(X1?, X2?, X3?, X4?)).
answer(ReqId, xs_agent_8(X1, X2, X3, X4), [pending(Id, esc_agent_8(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_8(X1?, X2?, X3?, X4?)).
answer(ReqId, xs_agent_9(X1, X2, X3), [pending(Id, esc_agent_9(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_9(X1?, X2?, X3?)).
answer(ReqId, xs_agent_10(X1, X2, X3, X4, X5), [pending(Id, esc_agent_10(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_10(X1?, X2?, X3?, X4?, X5?)).
answer(ReqId, xs_agent_11(X1, X2, X3, X4, X5), [pending(Id, esc_agent_11(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_11(X1?, X2?, X3?, X4?, X5?)).
answer(ReqId, xs_agent_12(X1, X2, X3, X4, X5), [pending(Id, esc_agent_12(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_12(X1?, X2?, X3?, X4?, X5?)).
answer(ReqId, Vs, [P | Ps], [P? | Ps1?]) :- otherwise | answer(ReqId?, Vs?, Ps?, Ps1).
answer(_, _, [], []).

exported procedure close(ReqId?, PendingList?, PendingList).
close(ReqId, [pending(Id, esc_respond_swap_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = else.
close(ReqId, [pending(Id, esc_respond_transfer_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = else.
close(ReqId, [P | Ps], [P? | Ps1?]) :- otherwise | close(ReqId?, Ps?, Ps1).
close(_, [], []).

exported procedure drop(ReqId?, PendingList?, PendingList).
drop(ReqId, [pending(Id, _) | Ps], Ps?) :- (ReqId? =?= Id?) | true.
drop(ReqId, [P | Ps], [P? | Ps1?]) :- otherwise | drop(ReqId?, Ps?, Ps1).
drop(_, [], []).

exported procedure(R) abort(Slot(R)?, Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg))).
abort(none, Med, Med?).
abort(ask(_, Id), Med, Med1?) :- ground(Id?) | send(abort(Id?), Med?, Med1).

exported procedure med_split(Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg)), Channel(Closed, Stream(AgentMsg))).
med_split(ch(_, Out?), ch([], O1), ch([], O2)) :- merge(O1?, O2?, Out).

