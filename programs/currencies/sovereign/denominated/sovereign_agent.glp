on_act(mature(Bond, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Bond?) | grant(Bond?, Id?, Date?, Serial?, Resp, From?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Ws?, As?, D).
on_act(swap(Want, Offered, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Want?), ground(Offered?) | respond_swap(offer(From?, Want?, Offered?), Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, D2), merge(D1?, D2?, D).
on_act(transfer(Kind, Given, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Kind?), ground(Given?) | respond_transfer(offer_transfer(Kind?, From?, Given?), Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, D2), merge(D1?, D2?, D).

procedure take_payment(Decision?, Key?, Key?, Stream(Instrument)?, PayResponse, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
take_payment(yes, Id, From, Coins, pay_taken, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Coins?) | append_instruments(Holdings?, Coins?, Holdings1), count_instruments(Coins?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As?, Serial?, D).
take_payment(no, Id, From, Coins, pay_returned(Coins?), Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Coins?) | count_instruments(Coins?, 0, K), show(refused_payment(From?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure take_accepted(Key?, Key?, Constant?, Stream(Instrument)?, PayResponse, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
take_accepted(P, U, F, Coins, Resp?, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Coins?), ground(As?) | issued_by(U?, F?, Coins?, Valid), count_instruments(Coins?, 0, K), count_acceptances(U?, F?, As?, 0, N), admit(Valid?, K?, N?, P?, U?, F?, Coins?, Resp, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure admit(Constant?, Integer?, Integer?, Key?, Key?, Constant?, Stream(Instrument)?, PayResponse, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
admit(yes, K, N, P, U, F, Coins, pay_taken, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- (K? =< N?) | delete_acceptances(U?, F?, K?, As?, As1), append_instruments(Holdings?, Coins?, Holdings1), show(received_from(P?, U?, K?), Outs?, Outs1), after_accepting(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As1?, Serial?, D).
admit(_, K, _, P, U, _, Coins, pay_returned(Coins?), Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- otherwise | show(refused_from(P?, U?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure countersign(Decision?, Key?, Key?, Constant?, Stream(Instrument)?, PayResponse, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
countersign(yes, P, Q, F, Coins, Resp?, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), forward_spend(Known?, P?, Q?, F?, Coins?, Resp, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).
countersign(no, P, _, _, Coins, pay_returned(Coins?), Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Coins?) | count_instruments(Coins?, 0, K), show(refused_payment(P?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure forward_spend(Decision?, Key?, Key?, Constant?, Stream(Instrument)?, PayResponse, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
forward_spend(yes, P, Q, F, Coins, Resp?, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Q?), ground(Coins?) | send_friend(Q?, msg(Id?, Q?, spent(P?, F?, Coins?, Resp1)), Outs?, Outs1), count_instruments(Coins?, 0, K), relay_spend(Resp1?, P?, Q?, K?, Resp, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).
forward_spend(no, _, Q, _, Coins, pay_returned(Coins?), Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure fulfil(Instrument?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
fulfil(coin(I, F, S), R, D1, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- (I? =?= Id?) | take_instrument(R?, F?, D1?, Holdings?, Found, Rest), give(Found?, coin(I?, F?, S?), R?, D1?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Rest?, Date?, Ws?, As?, Serial?, D).
fulfil(X, _, _, redeem_declined(X?), Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- otherwise | show(refused(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure give(Found?, Instrument?, Key?, Constant?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
give(found(X), Mine, R, D1, redeem_give(X?), Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Rest, Date, Ws, As, Serial, D?) :- append_instruments(Rest?, [Mine?], Holdings1), show(presented(From?, R?, D1?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As?, Serial?, D).
give(not_found, Mine, R, D1, redeem_menu(Mine?, Menu?), Id, From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Rest, Date, Ws, As, Serial, D?) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?, D1?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?, D).

procedure grant(Instrument?, Key?, Integer?, Integer?, MatureResponse, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Stream(Warranty)?, Stream(Acceptance)?, Stream(Ask(Question))).
grant(bond(I, F, M, _), Id, Date, Serial, mature_give(coin(Id?, F?, Serial?), Date?), From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, As, D?) :- (I? =?= Id?), (M? =< Date?) | Serial1 := (Serial? + 1), show(matured_for(From?, M?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial1?, D).
grant(bond(I, F, M, S), Id, Date, Serial, mature_declined(bond(I?, F?, M?, S?)), From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, As, D?) :- otherwise | show(not_mature_for(From?, M?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).
grant(coin(I, F, S), Id, Date, Serial, mature_declined(coin(I?, F?, S?)), From, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, As, D?) :- show(refused(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure fill_swap(Status?, Key?, Key?, SwapResponse, Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
fill_swap(ok, Id, From, swap_accept(Give?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, As?, Serial?, D).
fill_swap(fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure do_accept(Decision?, Key?, Key?, Constant?, Integer?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
do_accept(yes, Id, U, F, L, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- add_acceptances(U?, F?, L?, As?, As1), show(accepted(U?, F?, L?), Outs?, Outs1), acceptances_changed(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As1?, Serial?, D).
do_accept(no, Id, U, F, _, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- show(not_held(U?, F?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure propose_swap(Status?, Key?, Key?, Lot?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
propose_swap(ok, Id, Q, _, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Q?), ground(Want?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_swap(Known?, Id?, Q?, Want?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?, D).
propose_swap(fail, Id, _, lot(U, _, D, K), _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D1?) :- append_instruments(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D1).

procedure send_swap(Decision?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
send_swap(yes, Id, Q, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?, D).
send_swap(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure propose_transfer(Status?, Kind?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
propose_transfer(ok, Kind, Id, Q, Lot, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Kind?), ground(Q?), ground(Lot?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_transfer(Known?, Kind?, Id?, Q?, Lot?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?, D).
propose_transfer(fail, _, Id, _, lot(U, _, D, K), Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D1?) :- append_instruments(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D1).

procedure send_transfer(Decision?, Kind?, Key?, Key?, Lot?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
send_transfer(yes, Kind, Id, Q, Lot, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Kind?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, UserIn?, UserIn1), show(offered_transfer(Kind?, Q?, Lot?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Ws?, As?, Serial?, D).
send_transfer(no, _, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure do_pay(Status?, Key?, Key?, Constant?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
do_pay(ok, Id, Q, _, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Q?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Known?, Id?, Q?, Q?, pay(Give?, Resp), Resp?, paying(Q?, K?), paid(Q?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?, D).
do_pay(fail, Id, Q, _, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(lacking(Q?, now, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure do_payout(Status?, Key?, Key?, Constant?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
do_payout(ok, Id, Q, F, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Q?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Known?, Id?, Q?, Q?, payout(F?, Give?, Resp), Resp?, paying_out(Q?, K?), paid_out(Q?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?, D).
do_payout(fail, Id, _, _, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Id?) | append_instruments(Give?, Rest?, Orig), show(lacking(Id?, now, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure do_spend(Status?, Key?, Key?, Key?, Constant?, Integer?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
do_spend(ok, Id, Q, S, F, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Q?), ground(S?), ground(Give?) | has_peer(S?, Outs?, Outs1, Known), send_pay(Known?, Id?, S?, Q?, spend(Q?, F?, Give?, Resp), Resp?, spending(Q?, S?, K?), spent_at(Q?, S?, K?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?, D).
do_spend(fail, Id, _, S, _, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(lacking(S?, now, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure send_pay(Decision?, Key?, Key?, Key?, PeerContent?, PayResponse?, ScreenContent?, ScreenContent?, Stream(Instrument)?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
send_pay(yes, Id, To, Q, Act, Resp, Paying, Taken, _, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(To?) | send_friend(To?, msg(Id?, To?, Act?), Outs?, Outs1), inject_pay_result(Resp?, Q?, Taken?, UserIn?, UserIn1), show(Paying?, Outs1?, Outs2), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Ws?, As?, Serial?, D).
send_pay(no, Id, To, _, _, _, _, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Give?, Rest?, Orig), show(no_conversation(To?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure do_redeem(Found?, Key?, Key?, Key?, Constant?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
do_redeem(found(Coin), Id, Q, R, D1, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_redeem(Known?, Id?, Q?, R?, D1?, Coin?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?, D).
do_redeem(not_found, Id, Q, _, _, Holdings, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- show(lacking(Q?, now, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure send_redeem(Decision?, Key?, Key?, Key?, Constant?, Instrument?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
send_redeem(yes, Id, Q, R, D1, Coin, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, redeem(Coin?, R?, D1?, Resp)), Outs?, Outs1), inject_redeem_result(Resp?, Q?, R?, D1?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?, D).
send_redeem(no, Id, Q, _, _, Coin, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Rest?, [Coin?], Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure do_mature(Found?, Key?, Key?, Integer?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
do_mature(found(Bond), Id, Q, D, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D1?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_mature(Known?, Id?, Q?, D?, Bond?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, As?, Serial?, D1).
do_mature(not_found, Id, Q, D, Holdings, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D1?) :- show(lacking(Q?, D?, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D1).

procedure send_mature(Decision?, Key?, Key?, Integer?, Instrument?, Stream(Instrument)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
send_mature(yes, Id, Q, D, Bond, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D1?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, mature(Bond?, Resp)), Outs?, Outs1), inject_mature_result(Resp?, Q?, D?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, As?, Serial?, D1).
send_mature(no, Id, Q, _, Bond, Rest, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, As, Serial, D?) :- append_instruments(Rest?, [Bond?], Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, As?, Serial?, D).

procedure after_change(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
after_change(Reqs, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure after_accepting(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
after_accepting(Reqs, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(As?) | tally_acceptances(As?, [], Tally), show(acceptances(Tally?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

procedure acceptances_changed(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
acceptances_changed(Reqs, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(As?) | tally_acceptances(As?, [], Tally), show(acceptances(Tally?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, As?, Serial?, D).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Draw ::= draw(Integer, _, _) ; withdraw(Integer).
PersonIn ::= [_ | PersonIn].
Input ::= input(_, _, _).
Path ::= [] ; [Integer | Path].
Inputs ::= [Input | Inputs].
Route ::= route(Integer, Inputs?).
Routes ::= [] ; [Route | Routes].
Deads ::= [] ; [Inputs? | Deads].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q) ::= spawn(Integer, Q, Inputs, Stream(Draw)?).

procedure(Q) dispatch(Stream(Ask(Q))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, MOut), Ss?) :- split_grants(PIn?, Inputs, MIn), merge(MOut?, DOut?, POut), serve_1(Asks?, Inputs?, COut?, COut, DOut, [], [], 0, Ss).

procedure split_grants(PersonIn?, Inputs, Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([G | Gs], Is?, [G? | Ms?]) :- otherwise | split_grants(Gs?, Is, Ms).

procedure(Q) serve_1(Stream(Ask(Q))?, Inputs?, Stream(Draw)?, Stream(Draw), Stream(_), Routes?, Deads?, Integer?, Stream(Spawn(Q))).
serve_1([ask(_, Q) | Asks], Is, COut, CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Asks?, Is?, COut?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1(Asks, [G | Is], COut, CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(G?, Rs?, Rs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1(Asks, Is, [draw(Id, W, V) | COut], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Asks?, Is?, COut?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1(Asks, Is, [withdraw(Id) | COut], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure route_grant(Input?, Routes?, Routes).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure remove_route(Integer?, Routes?, Routes, Deads?, Deads).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure run(Integer?, _?, Stream(_)?, Done?, Stream(Draw)).
run(Id, _, _, done, [withdraw(Id?)]).
run(Id, W, [V | Vs], Done, [draw(Id?, W?, V?) | Ds?]) :- ground(W?), ground(V?) | run(Id?, W?, Vs?, Done?, Ds).
run(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure run_end(Integer?, Done?, Stream(Draw)).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(Path?, _?, Stream(_)).
shown(_, X, [X?]) :- ground(X?) | true.
shown(P, X, [pending(P?) | Vs?]) :- shown_whole(X?, Vs).

procedure shown_whole(_?, Stream(_)).
shown_whole(X, [X?]) :- ground(X?) | true.

procedure thread(Path?, Stream(_)?, Stream(Stream(_))).
thread(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread(_, [], [[]]).
thread(P, Xs, [[] | Vs?]) :- thread_tail(P?, Xs?, Vs).

procedure thread_tail(Path?, Stream(_)?, Stream(Stream(_))).
thread_tail(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread_tail(_, [], []).

procedure thread_cell(Path?, _?, Stream(_)?, Stream(Stream(_))).
thread_cell(P, X, Xs, Vs?) :- ground(P?) | path(P?, 1, P1), path(P?, 2, P2), shown(P1?, X?, V1), thread(P2?, Xs?, V2), cons_views(V1?, V2?, Vs).

procedure cons_views(Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_views([E | Es], [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_views([], _, []).
cons_views(_, [], []).

procedure cons_more(_?, Stream(_)?, Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_more(_, T, [E | Es], Ts, [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(E, _, Es, [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(_, _, [], [], []).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

exported procedure dispatch(Stream(Ask(Question))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_))).
dispatch(Asks, PCh, MCh?) :- dispatch(Asks?, PCh?, MCh, Ss), constructs(Ss?).

procedure constructs(Stream(Spawn(Question))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs?, Stream(Draw)).
construct(Id, swapCard_w(X), Gs, Ds?) :- present_swapCard([], X?, Gs?, _, Vs, Done), run(Id?, form(card, [field('SwapOffer', shown), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, transferCard_w(X), Gs, Ds?) :- present_transferCard([], X?, Gs?, _, Vs, Done), run(Id?, form(card, [field('TransferOffer', shown), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs?, _, Done), run(Id?, input_box(menu([form(mint, [field('Constant', text), field('Integer', number)]), form(mint, [field('Constant', text), field('Integer', number), field('Integer', number)]), form(swap, [field('Key', peer), field('Constant', text), field('Key', peer), field('Constant', text), field('Integer', number), field('Key', peer), field('Constant', text), field('Integer', number)]), form(accept, [field('Constant', text), field('Key', peer), field('Integer', number)]), form(pay, [field('Key', peer), field('Constant', text), field('Integer', number)]), form(payout, [field('Key', peer), field('Constant', text), field('Integer', number)]), form(spend, [field('Key', peer), field('Key', peer), field('Constant', text), field('Integer', number)]), form(redeem, [field('Key', peer), field('Constant', text), field('Key', peer), field('Constant', text)]), form(mature, [field('Key', peer), field('Constant', text), field('Integer', number)]), form(deposit, [field('Key', peer), field('Constant', text), field('Key', peer), field('Constant', text), field('Integer', number)]), form(release, [field('Key', peer), field('Constant', text), field('Key', peer), field('Constant', text), field('Integer', number)]), form(return, [field('Key', peer), field('Constant', text), field('Key', peer), field('Constant', text), field('Integer', number)])])), [input([])], Done?, Ds).

procedure form_yesNo(_?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs?, Inputs, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input?, Inputs?, Inputs, Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

procedure start_swapCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_swapCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_swapCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_swapCard_card_2([], _, []).
start_swapCard_card_2(_, [], []).

procedure comb_swapCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_swapCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_swapCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_swapCard_card_2(_, _, [], [], []).

procedure present_swapCard(Path?, SwapCard?, Inputs?, Inputs, Stream(_), Done).
present_swapCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_swapCard_card_2(V1?, [input(M2?)], Vs).
present_swapCard(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_swapCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_swapCard_wait(Path?, SwapCard?, Inputs?, Inputs, Stream(_), Done).
present_swapCard_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_swapCard(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_swapCard_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_swapCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure start_transferCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_transferCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_transferCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_transferCard_card_2([], _, []).
start_transferCard_card_2(_, [], []).

procedure comb_transferCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_transferCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_transferCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_transferCard_card_2(_, _, [], [], []).

procedure present_transferCard(Path?, TransferCard?, Inputs?, Inputs, Stream(_), Done).
present_transferCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_transferCard_card_2(V1?, [input(M2?)], Vs).
present_transferCard(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_transferCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_transferCard_wait(Path?, TransferCard?, Inputs?, Inputs, Stream(_), Done).
present_transferCard_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_transferCard(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_transferCard_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_transferCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure join_request_mint_2(Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_mint_2(formed(X1), formed(X2), formed(mint(X1?, X2?))).
join_request_mint_2(refused, _, refused).
join_request_mint_2(_, refused, refused).

procedure join_request_mint_3(Formed(Constant)?, Formed(Integer)?, Formed(Integer)?, Formed(Request)).
join_request_mint_3(formed(X1), formed(X2), formed(X3), formed(mint(X1?, X2?, X3?))).
join_request_mint_3(refused, _, _, refused).
join_request_mint_3(_, refused, _, refused).
join_request_mint_3(_, _, refused, refused).

procedure join_request_swap_8(Formed(Key)?, Formed(Constant)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_swap_8(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(X7), formed(X8), formed(swap(X1?, X2?, X3?, X4?, X5?, X6?, X7?, X8?))).
join_request_swap_8(refused, _, _, _, _, _, _, _, refused).
join_request_swap_8(_, refused, _, _, _, _, _, _, refused).
join_request_swap_8(_, _, refused, _, _, _, _, _, refused).
join_request_swap_8(_, _, _, refused, _, _, _, _, refused).
join_request_swap_8(_, _, _, _, refused, _, _, _, refused).
join_request_swap_8(_, _, _, _, _, refused, _, _, refused).
join_request_swap_8(_, _, _, _, _, _, refused, _, refused).
join_request_swap_8(_, _, _, _, _, _, _, refused, refused).

procedure join_request_accept_3(Formed(Constant)?, Formed(Key)?, Formed(Integer)?, Formed(Request)).
join_request_accept_3(formed(X1), formed(X2), formed(X3), formed(accept(X1?, X2?, X3?))).
join_request_accept_3(refused, _, _, refused).
join_request_accept_3(_, refused, _, refused).
join_request_accept_3(_, _, refused, refused).

procedure join_request_pay_3(Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_pay_3(formed(X1), formed(X2), formed(X3), formed(pay(X1?, X2?, X3?))).
join_request_pay_3(refused, _, _, refused).
join_request_pay_3(_, refused, _, refused).
join_request_pay_3(_, _, refused, refused).

procedure join_request_payout_3(Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_payout_3(formed(X1), formed(X2), formed(X3), formed(payout(X1?, X2?, X3?))).
join_request_payout_3(refused, _, _, refused).
join_request_payout_3(_, refused, _, refused).
join_request_payout_3(_, _, refused, refused).

procedure join_request_spend_4(Formed(Key)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_spend_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(spend(X1?, X2?, X3?, X4?))).
join_request_spend_4(refused, _, _, _, refused).
join_request_spend_4(_, refused, _, _, refused).
join_request_spend_4(_, _, refused, _, refused).
join_request_spend_4(_, _, _, refused, refused).

procedure join_request_redeem_4(Formed(Key)?, Formed(Constant)?, Formed(Key)?, Formed(Constant)?, Formed(Request)).
join_request_redeem_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(redeem(X1?, X2?, X3?, X4?))).
join_request_redeem_4(refused, _, _, _, refused).
join_request_redeem_4(_, refused, _, _, refused).
join_request_redeem_4(_, _, refused, _, refused).
join_request_redeem_4(_, _, _, refused, refused).

procedure join_request_mature_3(Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_mature_3(formed(X1), formed(X2), formed(X3), formed(mature(X1?, X2?, X3?))).
join_request_mature_3(refused, _, _, refused).
join_request_mature_3(_, refused, _, refused).
join_request_mature_3(_, _, refused, refused).

procedure join_request_deposit_5(Formed(Key)?, Formed(Constant)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_deposit_5(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(deposit(X1?, X2?, X3?, X4?, X5?))).
join_request_deposit_5(refused, _, _, _, _, refused).
join_request_deposit_5(_, refused, _, _, _, refused).
join_request_deposit_5(_, _, refused, _, _, refused).
join_request_deposit_5(_, _, _, refused, _, refused).
join_request_deposit_5(_, _, _, _, refused, refused).

procedure join_request_release_5(Formed(Key)?, Formed(Constant)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_release_5(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(release(X1?, X2?, X3?, X4?, X5?))).
join_request_release_5(refused, _, _, _, _, refused).
join_request_release_5(_, refused, _, _, _, refused).
join_request_release_5(_, _, refused, _, _, refused).
join_request_release_5(_, _, _, refused, _, refused).
join_request_release_5(_, _, _, _, refused, refused).

procedure join_request_return_5(Formed(Key)?, Formed(Constant)?, Formed(Key)?, Formed(Constant)?, Formed(Integer)?, Formed(Request)).
join_request_return_5(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(return(X1?, X2?, X3?, X4?, X5?))).
join_request_return_5(refused, _, _, _, _, refused).
join_request_return_5(_, refused, _, _, _, refused).
join_request_return_5(_, _, refused, _, _, refused).
join_request_return_5(_, _, _, refused, _, refused).
join_request_return_5(_, _, _, _, refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(mint(R1, R2), F?) :- form_constant(R1?, F1), form_integer(R2?, F2), join_request_mint_2(F1?, F2?, F).
form_request(mint(R1, R2, R3), F?) :- form_constant(R1?, F1), form_integer(R2?, F2), form_integer(R3?, F3), join_request_mint_3(F1?, F2?, F3?, F).
form_request(swap(R1, R2, R3, R4, R5, R6, R7, R8), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_string(R3?, F3), form_constant(R4?, F4), form_integer(R5?, F5), form_string(R6?, F6), form_constant(R7?, F7), form_integer(R8?, F8), join_request_swap_8(F1?, F2?, F3?, F4?, F5?, F6?, F7?, F8?, F).
form_request(accept(R1, R2, R3), F?) :- form_constant(R1?, F1), form_string(R2?, F2), form_integer(R3?, F3), join_request_accept_3(F1?, F2?, F3?, F).
form_request(pay(R1, R2, R3), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_integer(R3?, F3), join_request_pay_3(F1?, F2?, F3?, F).
form_request(payout(R1, R2, R3), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_integer(R3?, F3), join_request_payout_3(F1?, F2?, F3?, F).
form_request(spend(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_constant(R3?, F3), form_integer(R4?, F4), join_request_spend_4(F1?, F2?, F3?, F4?, F).
form_request(redeem(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_string(R3?, F3), form_constant(R4?, F4), join_request_redeem_4(F1?, F2?, F3?, F4?, F).
form_request(mature(R1, R2, R3), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_integer(R3?, F3), join_request_mature_3(F1?, F2?, F3?, F).
form_request(deposit(R1, R2, R3, R4, R5), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_string(R3?, F3), form_constant(R4?, F4), form_integer(R5?, F5), join_request_deposit_5(F1?, F2?, F3?, F4?, F5?, F).
form_request(release(R1, R2, R3, R4, R5), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_string(R3?, F3), form_constant(R4?, F4), form_integer(R5?, F5), join_request_release_5(F1?, F2?, F3?, F4?, F5?, F).
form_request(return(R1, R2, R3, R4, R5), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_string(R3?, F3), form_constant(R4?, F4), form_integer(R5?, F5), join_request_return_5(F1?, F2?, F3?, F4?, F5?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs?, Inputs, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input?, Inputs?, Inputs, Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

