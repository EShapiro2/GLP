procedure on_act(PeerContent?, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Warranty)?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
on_act(pay(Coins, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Coins?) | own_coins(Id?, Coins?, Own), take_payment(Own?, Id?, From?, Coins?, Resp, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, D).
on_act(payout(F, Coins, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(F?), ground(Coins?) | take_accepted(From?, From?, F?, Coins?, Resp, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, D).
on_act(spend(Q, F, Coins, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(Q?), ground(F?), ground(Coins?) | own_coins(Id?, Coins?, Own), countersign(Own?, From?, Q?, F?, Coins?, Resp, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, D).
on_act(spent(P, F, Coins, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, As, Serial, D?) :- ground(P?), ground(F?), ground(Coins?) | take_accepted(P?, From?, F?, Coins?, Resp, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, As?, Serial?, D).
