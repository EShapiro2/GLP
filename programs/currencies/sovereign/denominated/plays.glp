%% plays.glp --- the mini-app activated as the super-app activates it
%% (Grassroots Social Graph paper, Section 3): by run/3, under the type
%% identity of its entry sovereign/3, with exactly its two channels; and, for
%% two executions, with the two ends of one root channel handed to them as
%% their conversation.  The certified mini-app is this program, whose module
%% value is the one the REPL can obtain; the persons are scripted (person.glp)
%% and under no escrow agreement, and each play returns their screens.  A run
%% does not end --- the agent's question, the stream of requests, stays open,
%% and the person channel never closes --- so a play's result is read off a
%% partial stream.

imported procedure person#person(Key?, _?, PersonIn(Drawn), Stream(Integer), Script?, Agreement?, Stream(ScreenContent)).

%% play_mint(Screen): alice, alone, mints 3 coins of her own.
%% Expected: Screen = [minted(3, now), holdings([lot(alice, usd, now, 3)]) | _].
exported procedure play_mint(Stream(ScreenContent)).
play_mint(Screen?) :-
    self_module(M),
    find_type(sovereign/3, T),
    run(sovereign(alice, ch(Grants?, Draws), []), T?, M?),
    person # person(alice, Draws?, Grants, _, [mint(usd, 3)], none, Screen).

%% play_swap(ScreenA, ScreenB): alice and bob with one conversation between
%% their two executions; each mints 2, alice offers her 2 for bob's 2, and bob
%% accepts.
%% Expected: ScreenA = [opened(bob), minted(2, now), holdings([lot(alice, usd, now, 2)]),
%%   holdings([]), swap_done(bob), holdings([lot(bob, usd, now, 2)]) | _],
%%   ScreenB = [opened(alice), minted(2, now), holdings([lot(bob, usd, now, 2)]),
%%   swap_done(alice), holdings([lot(alice, usd, now, 2)]) | _].
exported procedure play_swap(Stream(ScreenContent), Stream(ScreenContent)).
play_swap(ScreenA?, ScreenB?) :-
    self_module(M),
    find_type(sovereign/3, T),
    run(sovereign(alice, ch(GrantsA?, DrawsA), [conversation(bob, ch(AB?, BA))]), T?, M?),
    person # person(alice, DrawsA?, GrantsA, _, [mint(usd, 2), swap(bob, usd, alice, now, 2, bob, now, 2)], none, ScreenA),
    run(sovereign(bob, ch(GrantsB?, DrawsB), [conversation(alice, ch(BA?, AB))]), T?, M?),
    person # person(bob, DrawsB?, GrantsB, _, [mint(usd, 2), accept(alice)], none, ScreenB).

%% The scripted person the super-app's plays activate: the root's second
%% template miniapp_person/5 (programs/self.glp) at the mini-app's own Drawn,
%% what its dispatcher draws, and ScreenContent, the screen the person reports
%% (Currencies 2026-10-13 20:09 UTC, item 2, and 20:21 UTC, item 1; GSG
%% 2026-10-13 20:22 UTC, G; vGLP 2026-10-16 11:25 UTC, item 4).  The role
%% chooses the script, the person's acts on its end of the person channel,
%% each peer named by its key in the list of the keys the person knows, the
%% person's own key the first argument (alice knows bob, bob alice):
%%   alice  [mint(usd, 2), swap(bob, usd, alice, now, 2, bob, now, 2)]
%%   bob    [mint(usd, 2), accept(alice)]
%%   watch  []
%% watch grants nothing and reports the screen.
exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(ScreenContent)).
miniapp_person(Me, alice, [Bob], ch(Ds, Gs?), S?) :- ground(Me?), ground(Bob?) | person # person(Me?, Ds?, Gs, _, [await(opened(Bob?)), mint(usd, 2), swap(Bob?, usd, Me?, now, 2, Bob?, now, 2)], none, S).
miniapp_person(Me, bob, [Alice], ch(Ds, Gs?), S?) :- person # person(Me?, Ds?, Gs, _, [await(opened(Alice?)), mint(usd, 2), accept(Alice?)], none, S).
miniapp_person(Id, watch, _, ch(Ds, Gs?), S?) :- person # person(Id?, Ds?, Gs, _, [], none, S).
%% The roles of the other plays, for their boots on smartphones (programs/currencies/sovereign_*_boot.glp; Currencies #15, Code_inbox 2026-11-05 07:26 UTC): cb, diana and frank, the sovereign market of ../play_ui.glp, diana's and frank's scripts those of its market/4, with the keys the person knows in the order cb: diana, frank; diana: cb, frank; frank: diana, cb, and the central bank's the script play_sovereign_ui gives it, its taps scripted: it mints 30, proposes the mutual credit line to diana, waits for frank's payment of its coin, hands him the fiat unit outside the contract, and accepts diana's reverse swap.  Each person's calendar is the super-app's, the day the device gives (Currencies #15, Code_inbox 2026-11-05 07:26 UTC: under the boot every person's date advances alike with the day the device gives), so frank's advance(28), the single-engine play's stand-in for the day, is left out, no act of the market reading his date; each person's first steps wait for their conversations to open, which the handshakes open as the isolates run.
miniapp_person(Me, cb, [Diana, Frank], ch(Ds, Gs?), S?) :- ground(Me?), ground(Diana?), ground(Frank?) | person # person(Me?, Ds?, Gs, _, [await(opened(Diana?)), await(opened(Frank?)), mint(usd, 30), swap(Diana?, usd, Me?, now, 10, Diana?, now, 10), await(received(Frank?, 1)), fiat(Frank?, 1), accept(Diana?)], none, S).
miniapp_person(Me, diana, [Cb, Frank], ch(Ds, Gs?), S?) :- ground(Me?), ground(Cb?), ground(Frank?) | person # person(Me?, Ds?, Gs, _, [await(opened(Cb?)), await(opened(Frank?)), mint(usd, 10), accept(Cb?), mint(usd, 15), swap(Frank?, usd, Me?, now, 15, Frank?, 28, 18), await(presented(Frank?, Cb?, now)), swap(Cb?, usd, Cb?, now, 9, Me?, now, 9)], none, S).
miniapp_person(Me, frank, [Diana, Cb], ch(Ds, Gs?), S?) :- ground(Me?), ground(Diana?), ground(Cb?) | person # person(Me?, Ds?, Gs, _, [await(opened(Diana?)), await(opened(Cb?)), mint(usd, 18, 28), accept(Diana?), pay(Diana?, usd, 3), redeem(Diana?, usd, Me?, 28), redeem(Diana?, usd, Me?, 28), redeem(Diana?, usd, Me?, 28), redeem(Diana?, usd, Me?, 28), redeem(Diana?, usd, Me?, 28), redeem(Diana?, usd, Cb?, now), pay(Cb?, usd, 1)], none, S).
%% The role of play_mint, for its boot on a smartphone (programs/currencies/sovereign_mint_boot.glp): mint, the person alone, who activates the mini-app with no invitation and no peer (GSA paper, Section 3, "A grassroots program instance") and mints 3 usd, play_mint's script.
miniapp_person(Me, mint, _, ch(Ds, Gs?), S?) :- ground(Me?) | person # person(Me?, Ds?, Gs, _, [mint(usd, 3)], none, S).
