%% plays.glp --- the mini-app activated as the super-app activates it
%% (Grassroots Social Graph paper, Section 3): by run/3, under the type
%% identity of its entry sovereign/3, with exactly its two channels; and, for
%% two executions, with the two ends of one root channel handed to them as
%% their conversation.  The certified mini-app is this program, whose module
%% value is the one the REPL can obtain; the persons are scripted (person.glp)
%% and under no escrow agreement, and each play returns their screens.  A run
%% does not end --- the agent's question, the stream of requests, stays open,
%% and the person channel never closes --- so a play's result is read off a
%% partial stream.

imported procedure person#person(Key?, _?, PersonIn(Drawn), Stream(Integer), Script?, Agreement?, Stream(ScreenContent)).

%% play_mint(Screen): alice, alone, mints 3 coins of her own.
%% Expected: Screen = [minted(3, now), holdings([lot(alice, usd, now, 3)]) | _].
exported procedure play_mint(Stream(ScreenContent)).
play_mint(Screen?) :-
    self_module(M),
    find_type(sovereign/3, T),
    run(sovereign(alice, ch(Grants?, Draws), []), T?, M?),
    person # person(alice, Draws?, Grants, _, [mint(usd, 3)], none, Screen).

%% play_swap(ScreenA, ScreenB): alice and bob with one conversation between
%% their two executions; each mints 2, alice offers her 2 for bob's 2, and bob
%% accepts.
%% Expected: ScreenA = [opened(bob), minted(2, now), holdings([lot(alice, usd, now, 2)]),
%%   holdings([]), swap_done(bob), holdings([lot(bob, usd, now, 2)]) | _],
%%   ScreenB = [opened(alice), minted(2, now), holdings([lot(bob, usd, now, 2)]),
%%   swap_done(alice), holdings([lot(alice, usd, now, 2)]) | _].
exported procedure play_swap(Stream(ScreenContent), Stream(ScreenContent)).
play_swap(ScreenA?, ScreenB?) :-
    self_module(M),
    find_type(sovereign/3, T),
    run(sovereign(alice, ch(GrantsA?, DrawsA), [conversation(bob, ch(AB?, BA))]), T?, M?),
    person # person(alice, DrawsA?, GrantsA, _, [mint(usd, 2), swap(bob, usd, alice, now, 2, bob, now, 2)], none, ScreenA),
    run(sovereign(bob, ch(GrantsB?, DrawsB), [conversation(alice, ch(BA?, AB))]), T?, M?),
    person # person(bob, DrawsB?, GrantsB, _, [mint(usd, 2), accept(alice)], none, ScreenB).

%% The scripted person the super-app's plays activate: the root's second
%% template miniapp_person/4 (programs/self.glp) at the mini-app's own Drawn,
%% what its dispatcher draws, and ScreenContent, the screen the person reports
%% (Currencies 2026-10-13 20:09 UTC, item 2, and 20:21 UTC, item 1; GSG
%% 2026-10-13 20:22 UTC, G; vGLP 2026-10-16 11:25 UTC, item 4).  The role
%% chooses the script, the person's acts on its end of the person channel:
%%   alice  [mint(usd, 2), swap(bob, usd, alice, now, 2, bob, now, 2)]
%%   bob    [mint(usd, 2), accept(alice)]
%%   watch  []
%% watch grants nothing and reports the screen.
exported procedure miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(ScreenContent)).
miniapp_person(Id, alice, ch(Ds, Gs?), S?) :- person # person(Id?, Ds?, Gs, _, [mint(usd, 2), swap(bob, usd, alice, now, 2, bob, now, 2)], none, S).
miniapp_person(Id, bob, ch(Ds, Gs?), S?) :- person # person(Id?, Ds?, Gs, _, [mint(usd, 2), accept(alice)], none, S).
miniapp_person(Id, watch, ch(Ds, Gs?), S?) :- person # person(Id?, Ds?, Gs, _, [], none, S).
