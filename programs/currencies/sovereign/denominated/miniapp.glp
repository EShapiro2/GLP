%% miniapp.glp --- the denominated program as a mini-app of the Grassroots
%% Super-App (Grassroots Social Graph paper, Section 3).
%%
%% sovereign(Id, Ui, Convs) is the mini-app with two of its channels, which its
%% plays activate by run/3 and miniapp/3 below calls for the super-app.  Ui is the person channel (vGLP, Definition
%% "Person Channel, Person Writer, GLP with Persons, Grant"): on it the
%% mini-app receives the person's grants, input(Id, P, R), and shows the
%% constructs its dispatcher draws and withdraws and the screen of its agent.
%% Convs is the channel to the social graph, on which the social graph hands
%% the mini-app, at each invitation, one end of the root channel of a
%% conversation with the execution of this program at a friend.  The mini-app
%% holds nothing else --- no network entry, and no call to a predicate that
%% reaches the network or the person --- so the program is certified.
%%
%% sovereign/4 is the same with the agent's calendar, a stream of dates,
%% which the headless plays write themselves, and miniapp/3 gives today's date
%% (../village.glp, ../credit_line.glp, plays.glp).  sovereign/3 gives the
%% agent an empty calendar: its date stands at 0, so a bond it mints matures
%% on a date later than 0, and no bond of its own is mature by its date.  The
%% super-app activates miniapp/3 below, which reads today's date
%% from the phone (today/1).

imported procedure sovereign_agent#agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Instrument)?, Integer?, Stream(Acceptance)?, Integer?, Stream(Ask(Question))).
imported procedure sovereign_agent#dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

%% With no clock, no date ever advances.
exported procedure sovereign(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?).
sovereign(Id, Ui, Convs) :- sovereign(Id?, Ui?, Convs?, []).

%% The agent with its dispatcher, the calls of the canonical compilation
%% (vGLP, Definition "Canonical Compilation"): the agent starts with no
%% holdings, date 0, no acceptance, serial 1, no conversation and
%% its screen, and its asks go to the dispatcher, which reads the person
%% channel; the screen goes to the person on the dispatcher's channel to the
%% program, which merges it with the constructs' draws.
exported procedure sovereign(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?).
sovereign(Id, Ui, Convs, Cal) :-
    ground(Id?) |
    sovereign_agent # agent(Id?, [], [], Convs?, Cal?, [user_output(Screen)], [], 0, [], 1, Asks),
    sovereign_agent # dispatch(Asks?, Ui?, MCh),
    show_screen(MCh?, Screen?).

%% The screen, onto the program's output to the person, which the
%% dispatcher's channel to the program carries as any term; the person's
%% input other than grants is not read.
procedure show_screen(Channel(Stream(_), Stream(Output))?, Stream(ScreenMsg)?).
show_screen(ch(_, Out?), Screen) :- relay(Screen?, Out).

%% Each message as it comes, its content: the envelope msg(agent, person, C)
%% stripped (Currencies, 2026-10-14 08:48 UTC, item 2).
procedure relay(Stream(ScreenMsg)?, Stream(Output)).
relay([msg(_, _, C)|Ms], [C?|Out?]) :- relay(Ms?, Out).
relay([], []).

%% The entry the super-app activates: the root's entry template miniapp/3
%% (programs/self.glp) at the mini-app's own two types, Drawn, what its
%% dispatcher draws for its person, and PeerMsg, the messages of its root
%% channels, both opaque to the super-app (TGLP modules.tex, Dynamic
%% Activation, "Opaque types"; vGLP 2026-10-14 13:21 UTC, S2; Currencies
%% 2026-10-13 20:09 UTC, item 1).  Its grants: the person's key, the person
%% channel and the channel to the social graph (GLP paper, appendix-guards,
%% "Predefined types": the entry template miniapp/3).  The calendar is
%% today's date, which today/1 reads from the phone, and the agent's date is
%% initially that date (GB, "The Transactions": "their date d*_p, initially the day of p's
%% calendar", which SGC recalls), the agent passing over a date not past its
%% own.  The social graph's stream
%% gives each conversation to the agent; a held link is passed over, the
%% mini-app making no warm call, and its stream up to the social graph closes
%% when the social graph's closes.
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(PeerMsg)?).
miniapp(Id, Ui, ch(Down, Up?)) :-
    sg_conversations(Down?, Convs, Up),
    today(Cal),
    dated(Id?, Ui?, Convs?, Cal?).

%% dated(Id, Ui, Convs, Cal): the mini-app of sovereign/4, its agent's date
%% initially the first date of the calendar Cal; a calendar with no date is
%% sovereign/3's, the date at 0.
procedure dated(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?, Stream(Integer)?).
dated(Id, Ui, Convs, [D | Cal]) :-
    ground(Id?), ground(D?) |
    sovereign_agent # agent(Id?, [], [], Convs?, [D? | Cal?], [user_output(Screen)], [], D?, [], 1, Asks),
    sovereign_agent # dispatch(Asks?, Ui?, MCh),
    show_screen(MCh?, Screen?).
dated(Id, Ui, Convs, []) :-
    sovereign(Id?, Ui?, Convs?, []).

%% today(Cal): the calendar of one date, today's, the day of now/1, the
%% Unix time in milliseconds divided by 86400000: the phone has the correct
%% date (vGLP 609b630, Section 5.4).
procedure today(Stream(Integer)).
today([D?]) :- now(T), D := T? // 86400000.

procedure sg_conversations(Stream(SgToApp(PeerMsg))?, Stream(Conversation(PeerMsg)), Stream(AppToSg)).
sg_conversations([conversation(K, Ch) | Down], [conversation(K?, Ch?) | Convs?], Up?) :-
    sg_conversations(Down?, Convs, Up).
sg_conversations([held(_, _) | Down], Convs?, Up?) :-
    sg_conversations(Down?, Convs, Up).
%% A friend asked to be invited who declined: this program asks none, so nothing is held for it.
sg_conversations([declined(_) | Down], Convs?, Up?) :-
    sg_conversations(Down?, Convs, Up).
sg_conversations([], [], []).
