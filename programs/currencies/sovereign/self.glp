%% self.glp — sovereign grassroots currencies, the denominated program.
%%
%% The program every participant runs under the grassroots social contract of
%% "Sovereign Grassroots Currencies" (Appendix A), derived from the
%% transactions of its Section 2, Definition "The Transactions of Denominated
%% Grassroots Currencies": those of grassroots bonds (programs/currencies/bonds)
%% with the denomination added, and the acceptances.  It runs as a mini-app of
%% the Grassroots Super-App: denominated/ is the certified program --- the
%% agent (denominated/sovereign_agent.vglp, compiled by the vGLP canonical
%% compilation into denominated/sovereign_agent.glp beside it), the mini-app
%% entry sovereign/3 (denominated/miniapp.glp), a scripted person
%% (denominated/person.glp) with the escrow programs it answers by
%% (denominated/escrow.glp), and the plays that activate the mini-app by run/3
%% (denominated/plays.glp) --- and this directory adds the plays that stand in
%% for the super-app: the village market of the bonds paper denominated in one
%% fiat currency, the same market with the central bank (village.glp), the
%% term credit line (credit_line.glp), and the live-person harness, the
%% sovereign market with the central bank on the app's screen (play_ui.glp).
%% This file holds the types shared by all of them, and the helpers over
%% holdings, dates, acceptances and conversations that the agent calls.
%%
%% A coin and a bond are two instruments.  A coin is coin(Issuer,
%% Denomination, Serial), a debt of one unit of its denomination due now,
%% carrying no date: the atom cent(u, f, bot) of the act schemas.  A bond is
%% bond(Issuer, Denomination, Maturity, Serial), the same debt due at its
%% maturity date: the atom cent(u, f, d).  The serial is the one a practical
%% implementation gives each instrument.  A party's holdings are a multiset of
%% instruments, Stream(Instrument).  A lot is k instruments of one issuer,
%% denomination, kind and maturity, lot(Issuer, Denomination, Due, K), its due
%% `now` for coins and the maturity date for bonds: the cent^k_{f,u,*} of the
%% definition.  An acceptance accepts(Issuer, Denomination) is the
%% atom accepts(u, f) of the schemas: the holder's acceptance of one coin of
%% that issuer in that denomination in payment, the acceptances a multiset.

Instrument ::= coin(Issuer, Denomination, Serial) ; bond(Issuer, Denomination, Maturity, Serial).
Lot        ::= lot(Issuer, Denomination, Due, Amount).
Serial     ::= Integer.
Acceptance ::= accepts(Key, Constant).
Accepting  ::= accepting(Key, Constant, Integer).

%% The three escrow transfers of clause 9: a deposit by the depositor with the
%% escrow agent, a release by the escrow agent to the beneficiary, a return by
%% the escrow agent to the depositor.  Each is a transfer of one lot guarded by
%% both participants, and the kind is what the receiver's card shows.
Kind ::= deposit ; release ; return.

%% The counterparty's answer to a swap: the instruments it gives, or the
%% offered instruments returned.
SwapResponse ::= swap_accept(Stream(Instrument)) ; swap_decline(Stream(Instrument)).

%% The payee's answer to a payment, a payout or a spend: the coins taken, or
%% returned because they are not the coins the payee takes --- its own, for a
%% payment; those it has accepted as many of, for a payout or a spend.  No
%% date is read.
PayResponse ::= pay_taken ; pay_returned(Stream(Instrument)).

%% The issuer's answer to a presentation of its coin: the instrument taken in
%% exchange; the presented coin returned with the lots the issuer holds, its
%% own apart, for the bearer to choose among; or what was presented returned
%% because it is not the issuer's coin.  No date is read.
RedeemResponse ::= redeem_give(Instrument)
                 ; redeem_menu(Instrument, Stream(Lot))
                 ; redeem_declined(Instrument).

%% The issuer's answer to a matured bond presented to it: a coin of its own
%% for it, or the bond returned, because it is not mature by the issuer's date.
MatureResponse ::= mature_give(Instrument) ; mature_declined(Instrument).

%% The receiver's answer to an escrow transfer: taken, or the instruments
%% returned.
TransferResponse ::= transfer_accept ; transfer_decline(Stream(Instrument)).

%% What one agent sends another: the bilateral acts of the definition, and the
%% two legs of a spend --- the payer's to the issuer of the coins spent,
%% naming the payee, and the issuer's to the payee, naming the payer.  A
%% position that forwards a writer carries ? in the type (typed-glp-manual,
%% 15B).
PeerContent ::= pay(Stream(Instrument), PayResponse?)
              ; payout(Constant, Stream(Instrument), PayResponse?)
              ; spend(Key, Constant, Stream(Instrument), PayResponse?)
              ; spent(Key, Constant, Stream(Instrument), PayResponse?)
              ; swap(Lot, Stream(Instrument), SwapResponse?)
              ; redeem(Instrument, Key, Constant, RedeemResponse?)
              ; mature(Instrument, MatureResponse?)
              ; transfer(Kind, Stream(Instrument), TransferResponse?).
PeerMsg     ::= msg(Key, Key, PeerContent).
PeerChannel ::= ch(Stream(PeerMsg), Stream(PeerMsg)?).

%% What the social graph hands the mini-app on its channel to the social graph
%% (Grassroots Social Graph paper, Section 3): at each invitation, one end of
%% the root channel of a conversation with a friend's execution of this
%% program.  Two agents transact over that channel and over nothing else.
Conversation ::= conversation(Key, PeerChannel).

%% Whether an instrument was found in the holdings.
Found ::= found(Instrument) ; not_found.

%% The answer to a question the agent or the scripted person asks of its
%% state: whether every instrument of a payment or a spend is a coin of the
%% holder (own_coins), whether an instrument of an issuer in a denomination is
%% held (holds), whether a conversation with a counterparty is open
%% (has_peer), whether the screen shows a step's effect.  The name is the one
%% the social graph gives the same two constants.
Decision ::= yes ; no.

%% Whether k instruments of an issuer, denomination and due were selected out
%% of the holdings: ok, or fail --- the precondition cent^k_{f,u,*} in c_p
%% does not hold.
Status ::= ok ; fail.

%% The agent's outputs: the screen, and a channel per counterparty, keyed by
%% its name.  The routers send_user, send_friend and add_friend_output are
%% those of social/graph/routing, exposed from the root scope.
OutputEntry ::= user_output(Stream(ScreenMsg)?)
              ; friend_output(Key, Stream(PeerMsg)?).

%% The screen: the holdings, tallied by issuer, denomination and due, after
%% every change of them; the acceptances, tallied by issuer and denomination,
%% after every change of them; the date after every advance; and what each
%% act came to.  A due is `now` for coins and
%% the maturity date for bonds.  fiat_handed(Q, K) is not the agent's: it is
%% the record a person makes of handing K units of the fiat currency to Q,
%% outside the contract (Appendix A, clause 8).
ScreenContent ::= holdings(Stream(Lot))
                ; acceptances(Stream(Accepting))
                ; opened(Key)
                ; date_advanced(Integer)
                ; minted(Integer, Constant)
                ; accepted(Key, Constant, Integer)
                ; not_held(Key, Constant)
                ; paying(Key, Integer)
                ; paid(Key, Integer)
                ; paying_out(Key, Integer)
                ; paid_out(Key, Integer)
                ; spending(Key, Key, Integer)
                ; spent_at(Key, Key, Integer)
                ; not_accepted(Key, Integer)
                ; received(Key, Integer)
                ; refused_payment(Key, Integer)
                ; received_from(Key, Key, Integer)
                ; refused_from(Key, Key, Integer)
                ; countersigned(Key, Key, Integer)
                ; spend_returned(Key, Key, Integer)
                ; swap_done(Key)
                ; swap_declined(Key)
                ; swap_failed(Key)
                ; declined(Key)
                ; redeemed(Key, Key, Constant)
                ; menu(Key, Stream(Lot))
                ; refused(Key)
                ; presented(Key, Key, Constant)
                ; unfulfilled(Key, Key, Constant)
                ; matured(Key, Integer)
                ; not_mature(Key, Integer)
                ; matured_for(Key, Integer)
                ; not_mature_for(Key, Integer)
                ; offered_transfer(Kind, Key, Lot)
                ; transferred(Kind, Key)
                ; transfer_declined(Kind, Key)
                ; received_transfer(Kind, Key, Stream(Lot))
                ; declined_transfer(Kind, Key)
                ; lacking(Key, Constant, Integer)
                ; no_conversation(Key)
                ; fiat_handed(Key, Integer).
ScreenMsg ::= msg(Constant, Constant, ScreenContent).

%% The type of the agent's output to its person, the reserved name Output:
%% "A vGLP program declares the type of its output to its person by defining
%% the type Output, a reserved name; the dispatcher draws that output as a
%% thread whose elements are drawn by the widget of Output" (vGLP 169b008,
%% Definition "Canonical Compilation").  The agent writes its screen messages.
Output ::= ScreenMsg.

%% The agent's own input: the answers its responders inject, and the results
%% of the acts it proposed or countersigned.
UserInMsg ::= accept_swap(Key, Lot, Stream(Instrument), SwapResponse?)
            ; decline_swap(Key, Stream(Instrument), SwapResponse?)
            ; swap_accepted(Key, Stream(Instrument))
            ; swap_declined_by(Key, Stream(Instrument))
            ; pay_taken_by(ScreenContent)
            ; pay_returned_by(Key, Stream(Instrument))
            ; spend_settled(ScreenContent)
            ; redeem_given(Key, Key, Constant, Instrument)
            ; redeem_menu_from(Key, Instrument, Stream(Lot))
            ; redeem_declined_by(Key, Instrument)
            ; matured_by(Key, Integer, Instrument)
            ; not_matured_by(Key, Instrument)
            ; accept_transfer(Kind, Key, Stream(Instrument), TransferResponse?)
            ; decline_transfer(Kind, Key, Stream(Instrument), TransferResponse?)
            ; transfer_accepted(Kind, Key)
            ; transfer_declined_by(Kind, Key, Stream(Instrument)).

%% The offer a swap responder carries: the proposer, the lot it wants, the
%% instruments it offers.  The offer a transfer responder carries: the kind,
%% the giver, the instruments.  Each field is named by the variable its clause
%% gives it, as a request's are, so that vGLP labels it by that name on the
%% card (Definition "Widget Declaration, Default Widget"); so are the fields
%% of an instrument and of a lot, above, over the named types of the
%% requests below and Serial ::= Integer.
SwapOffer     ::= offer(From, Want, Offered).
TransferOffer ::= offer_transfer(Kind, From, Given).
From          ::= Key.
Want          ::= Lot.
Offered       ::= Stream(Instrument).
Given         ::= Stream(Instrument).

%% =============================================================================
%% The agent's questions (vGLP, Definition "Guarded Clause, Volitional
%% Procedure, Interactive Type, ..."): the person's requests, the agent's
%% interactive type in reader mode, and the responders' cards, in writer mode.
%% =============================================================================

%% A request: one alternative per request clause of the agent, each a
%% transaction of the definition at the party whose election it is ---
%% Mint_p(f, k), Mint_p(f, d, k), Swap, Accept, Pay, Payout, Spend, Redeem,
%% Mature, Deposit, Release and Return --- with the arguments its clause
%% reads.  A due is `now` for coins and the maturity date for bonds.
%% The fields of a request, one named type per meaning over its base type,
%% each named by the variable its clause gives it, so that vGLP labels the
%% field by it (Definition "Widget Declaration, Default Widget"): the
%% counterparty, a Friend, as in the coins; the issuer, due and amount of
%% the lot given and of the lot wanted; a maturity; and the parties of the
%% escrow transfers, the bonds' names; and the denomination, which follows
%% the counterparty, and the limit of an acceptance.  A due is `now` for coins and the maturity date for
%% bonds.
Amount      ::= Integer.
Maturity    ::= Integer.
Friend      ::= Key.
GiveIssuer  ::= Key.
GiveDue     ::= Constant.
GiveAmount  ::= Integer.
WantIssuer  ::= Key.
WantDue     ::= Constant.
WantAmount  ::= Integer.
EscrowAgent ::= Key.
Beneficiary ::= Key.
Depositor   ::= Key.
Issuer      ::= Key.
Due         ::= Constant.
Denomination ::= Constant.
Limit       ::= Integer.

Request ::= mint(Denomination, Amount)
          ; mint(Denomination, Amount, Maturity)
          ; swap(Friend, Denomination, GiveIssuer, GiveDue, GiveAmount, WantIssuer, WantDue, WantAmount)
          ; accept(Denomination, Issuer, Limit)
          ; pay(Friend, Denomination, Amount)
          ; payout(Friend, Denomination, Amount)
          ; spend(Friend, Issuer, Denomination, Amount)
          ; redeem(Friend, Denomination, WantIssuer, WantDue)
          ; mature(Friend, Denomination, Maturity)
          ; deposit(EscrowAgent, Denomination, Issuer, Due, Amount)
          ; release(Beneficiary, Denomination, Issuer, Due, Amount)
          ; return(Depositor, Denomination, Issuer, Due, Amount).

%% A responder's card: the offer, which the agent writes for the person to
%% see, and the person's answer, yes accepting and no declining.
YesNo        ::= yes ; no.
SwapCard     ::= card(SwapOffer, YesNo?).
TransferCard ::= card(TransferOffer, YesNo?).

%% =============================================================================
%% The vocabulary of the compiled agent's dispatcher, so that the mini-app
%% entry and the plays can type the goals they spawn: the union of the
%% agent's questions and the asks its goals send, as the canonical
%% compilation emits them into denominated/sovereign_agent.glp, and the person
%% channel's input, as programs/vglp/dispatcher.glp gives it.  The compiled
%% module's own definitions shadow these within it, and the two must agree.
%% =============================================================================

Question ::= swapCard_w(SwapCard) ; transferCard_w(TransferCard) ; stream_request_r(Stream(Request)?).
Ask(Q)   ::= ask(Constant, Q).
PersonIn ::= [_ | PersonIn].

%% =============================================================================
%% The plays' vocabulary: what a person sees, and the agreements the escrow
%% programs run.
%% =============================================================================

%% What a person sees on the mini-app's person channel: the constructs the
%% dispatcher draws and withdraws, draw(Id, W, V) and withdraw(Id), each a
%% term of any type the bridge would render, and the screen the agent writes,
%% which the dispatcher merges in.  The person channel never closes, and
%% neither do the events.
Event ::= draw(_, _, _)
        ; withdraw(_)
        ; msg(Constant, Constant, ScreenContent).
Events ::= [Event | Events].

%% A script: the person's acts, in order.  A step is a request, granted on
%% the agent's request form --- mint(F, K) for coins and mint(F, K, D) for
%% bonds, accept_coins(F, U, L) the request accept(F, U, L); an advance of
%% the calendar, which in a headless run the play drives; an acceptance of a
%% swap or of a transfer the named party proposes, granted on its card; a unit
%% of the fiat currency handed over, which is the person's act outside the
%% contract and no construct of the agent's; or a wait for a screen message.
%% A due is `now` for coins and the maturity date for bonds.
Step ::= mint(Constant, Integer)
       ; mint(Constant, Integer, Integer)
       ; advance(Integer)
       ; swap(Key, Constant, Key, Constant, Integer, Key, Constant, Integer)
       ; accept_coins(Constant, Key, Integer)
       ; pay(Key, Constant, Integer)
       ; payout(Key, Constant, Integer)
       ; spend(Key, Key, Constant, Integer)
       ; redeem(Key, Constant, Key, Constant)
       ; mature(Key, Constant, Integer)
       ; deposit(Key, Constant, Key, Constant, Integer)
       ; release(Key, Constant, Key, Constant, Integer)
       ; return(Key, Constant, Key, Constant, Integer)
       ; accept(Key)
       ; accept_transfer(Key)
       ; fiat(Key, Integer)
       ; await(ScreenContent).
Script ::= [] ; [Step | Script].

%% An escrow agreement, run by the escrow program of escrow.glp as the will of
%% the escrow agent, with its state: none, for a party under no agreement; a
%% date-based escrow --- the depositor, the beneficiary, the lot, the date of
%% the escrow agent at which it releases, its phase, and the escrow agent's
%% date; or a credit line --- the lender, the borrower, the denomination, the
%% limit, the expiry, the date of the coupon bonds, the drawn amount, the
%% principal of a draw deposited and awaiting its coupon lot (0 when none),
%% its phase, and the escrow agent's date.
Agreement ::= none
            ; dated_escrow(Key, Key, Lot, Integer, Phase, Integer)
            ; credit_line(Key, Key, Constant, Integer, Integer, Integer, Integer, Integer, Phase, Integer).
Phase ::= awaiting ; deposited ; released ; opening ; open ; closed.

%% =============================================================================
%% Holdings
%% =============================================================================

%% K fresh coins of Issuer in F, serials from Serial up.
procedure create_coins(Key?, Constant?, Integer?, Integer?, Stream(Instrument)).
create_coins(Issuer, F, K, Serial, [coin(Issuer?, F?, Serial?)|Rest?]) :-
    K? > 0 |
    K1 := K? - 1,
    S1 := Serial? + 1,
    create_coins(Issuer?, F?, K1?, S1?, Rest).
create_coins(_, _, 0, _, []).

%% K fresh bonds of Issuer in F maturing at D, serials from Serial up.
procedure create_bonds(Key?, Constant?, Integer?, Integer?, Integer?, Stream(Instrument)).
create_bonds(Issuer, F, D, K, Serial, [bond(Issuer?, F?, D?, Serial?)|Rest?]) :-
    K? > 0 |
    K1 := K? - 1,
    S1 := Serial? + 1,
    create_bonds(Issuer?, F?, D?, K1?, S1?, Rest).
create_bonds(_, _, _, 0, _, []).

procedure append_instruments(Stream(Instrument)?, Stream(Instrument)?, Stream(Instrument)).
append_instruments([X|Xs], Ys, [X?|Zs?]) :- append_instruments(Xs?, Ys?, Zs).
append_instruments([], Ys, Ys?).

%% K instruments of Issuer in F and due D out of the holdings --- coins where
%% D is `now`, bonds maturing at D otherwise: ok, with the instruments and
%% the rest; or fail --- the precondition cent^k_{f,u,*} in c_p does not hold
%% --- with the instruments found and the rest, which the caller puts back
%% together.
procedure select_instruments(Key?, Constant?, Constant?, Integer?, Stream(Instrument)?, Status, Stream(Instrument), Stream(Instrument)).
select_instruments(_, _, _, 0, Hs, ok, [], Hs?).
select_instruments(Issuer, F, D, K, [coin(I, F1, S)|Rest], Status?, [coin(I?, F1?, S?)|Sel?], Rem?) :-
    K? > 0, Issuer? =?= I?, F? =?= F1?, D? =?= now |
    K1 := K? - 1,
    select_instruments(Issuer?, F?, D?, K1?, Rest?, Status, Sel, Rem).
select_instruments(Issuer, F, D, K, [bond(I, F1, M, S)|Rest], Status?, [bond(I?, F1?, M?, S?)|Sel?], Rem?) :-
    K? > 0, Issuer? =?= I?, F? =?= F1?, D? =?= M? |
    K1 := K? - 1,
    select_instruments(Issuer?, F?, D?, K1?, Rest?, Status, Sel, Rem).
select_instruments(Issuer, F, D, K, [X|Rest], Status?, Sel?, [X?|Rem?]) :-
    otherwise |
    select_instruments(Issuer?, F?, D?, K?, Rest?, Status, Sel, Rem).
select_instruments(_, _, _, K, [], fail, [], []) :- K? > 0 | true.

%% One instrument of Issuer in F and due D out of the holdings, or not_found
%% with the holdings intact.
procedure take_instrument(Key?, Constant?, Constant?, Stream(Instrument)?, Found, Stream(Instrument)).
take_instrument(Issuer, F, D, [coin(I, F1, S)|Rest], found(coin(I?, F1?, S?)), Rest?) :-
    Issuer? =?= I?, F? =?= F1?, D? =?= now | true.
take_instrument(Issuer, F, D, [bond(I, F1, M, S)|Rest], found(bond(I?, F1?, M?, S?)), Rest?) :-
    Issuer? =?= I?, F? =?= F1?, D? =?= M? | true.
take_instrument(Issuer, F, D, [X|Rest], Found?, [X?|Rem?]) :-
    otherwise |
    take_instrument(Issuer?, F?, D?, Rest?, Found, Rem).
take_instrument(_, _, _, [], not_found, []).

%% One bond of Issuer in F maturing at D out of the holdings, or not_found
%% with the holdings intact.
procedure take_bond(Key?, Constant?, Integer?, Stream(Instrument)?, Found, Stream(Instrument)).
take_bond(Issuer, F, D, [bond(I, F1, M, S)|Rest], found(bond(I?, F1?, M?, S?)), Rest?) :-
    Issuer? =?= I?, F? =?= F1?, D? =:= M? | true.
take_bond(Issuer, F, D, [X|Rest], Found?, [X?|Rem?]) :-
    otherwise |
    take_bond(Issuer?, F?, D?, Rest?, Found, Rem).
take_bond(_, _, _, [], not_found, []).

%% Whether a coin or a bond of U in F is held --- the precondition
%% cent_{f,u,*} in c_p of Accept --- with the holdings passed on.
procedure holds(Key?, Constant?, Stream(Instrument)?, Decision, Stream(Instrument)).
holds(U, F, [coin(I, F1, S)|Rest], yes, [coin(I?, F1?, S?)|Rest?]) :-
    U? =?= I?, F? =?= F1? | true.
holds(U, F, [bond(I, F1, M, S)|Rest], yes, [bond(I?, F1?, M?, S?)|Rest?]) :-
    U? =?= I?, F? =?= F1? | true.
holds(U, F, [X|Rest], Held?, [X?|Rest1?]) :-
    otherwise |
    holds(U?, F?, Rest?, Held, Rest1).
holds(_, _, [], no, []).

%% Whether every instrument is a coin of the holder: what an issuer takes as a
%% payment of its own coins, and what it countersigns as a spend of them.
procedure own_coins(Key?, Stream(Instrument)?, Decision).
own_coins(Id, [coin(I, _, _)|Rest], R?) :-
    Id? =?= I? |
    own_coins(Id?, Rest?, R).
own_coins(_, [_|_], no) :- otherwise | true.
own_coins(_, [], yes).

%% Whether every instrument is a coin of U in F: what a payee takes in a
%% payout or a spend of U's coins.
procedure issued_by(Key?, Constant?, Stream(Instrument)?, Constant).
issued_by(U, F, [coin(I, F1, _)|Rest], R?) :-
    U? =?= I?, F? =?= F1? |
    issued_by(U?, F?, Rest?, R).
issued_by(_, _, [_|_], no) :- otherwise | true.
issued_by(_, _, [], yes).

procedure count_instruments(Stream(Instrument)?, Integer?, Integer).
count_instruments([_|Xs], N, M?) :- N1 := N? + 1, count_instruments(Xs?, N1?, M).
count_instruments([], N, N?).

%% The holdings tallied by issuer, denomination and due, in order of first
%% appearance.
procedure tally(Stream(Instrument)?, Stream(Lot)?, Stream(Lot)).
tally([coin(I, F, _)|Rest], Acc, Lots?) :-
    ground(I?), ground(F?) |
    tally_add(I?, F?, now, Acc?, Acc1),
    tally(Rest?, Acc1?, Lots).
tally([bond(I, F, M, _)|Rest], Acc, Lots?) :-
    ground(I?), ground(F?), integer(M?) |
    tally_add(I?, F?, M?, Acc?, Acc1),
    tally(Rest?, Acc1?, Lots).
tally([], Acc, Acc?).

procedure tally_add(Key?, Constant?, Constant?, Stream(Lot)?, Stream(Lot)).
tally_add(I, F, D, [lot(I2, F2, D2, N)|Rest], [lot(I2?, F2?, D2?, N1?)|Rest?]) :-
    I? =?= I2?, F? =?= F2?, D? =?= D2? |
    N1 := N? + 1.
tally_add(I, F, D, [L|Rest], [L?|Rest1?]) :- otherwise | tally_add(I?, F?, D?, Rest?, Rest1).
tally_add(I, F, D, [], [lot(I?, F?, D?, 1)]).

%% The lots held, the holder's own apart, coins and bonds: what an issuer
%% discloses to a bearer whose presentation it cannot fulfil as named.
procedure menu_of(Key?, Stream(Instrument)?, Stream(Lot)?, Stream(Lot)).
menu_of(Id, [coin(I, _, _)|Rest], Acc, Menu?) :-
    Id? =?= I? |
    menu_of(Id?, Rest?, Acc?, Menu).
menu_of(Id, [bond(I, _, _, _)|Rest], Acc, Menu?) :-
    Id? =?= I? |
    menu_of(Id?, Rest?, Acc?, Menu).
menu_of(Id, [coin(I, F, _)|Rest], Acc, Menu?) :-
    otherwise |
    tally_add(I?, F?, now, Acc?, Acc1),
    menu_of(Id?, Rest?, Acc1?, Menu).
menu_of(Id, [bond(I, F, M, _)|Rest], Acc, Menu?) :-
    otherwise |
    tally_add(I?, F?, M?, Acc?, Acc1),
    menu_of(Id?, Rest?, Acc1?, Menu).
menu_of(_, [], Acc, Acc?).

%% =============================================================================
%% Acceptances
%% =============================================================================

%% L atoms accepts(U, F) added to the multiset: A'_p = A_p + L.{(u, f)} of
%% accept.
procedure add_acceptances(Key?, Constant?, Integer?, Stream(Acceptance)?, Stream(Acceptance)).
add_acceptances(U, F, L, As, [accepts(U?, F?)|As1?]) :-
    L? > 0 |
    L1 := L? - 1,
    add_acceptances(U?, F?, L1?, As?, As1).
add_acceptances(_, _, 0, As, As?).

%% How many atoms accepts(U, F) the multiset holds.
procedure count_acceptances(Key?, Constant?, Stream(Acceptance)?, Integer?, Integer).
count_acceptances(U, F, [accepts(U1, F1)|As], N, M?) :-
    U? =?= U1?, F? =?= F1? |
    N1 := N? + 1,
    count_acceptances(U?, F?, As?, N1?, M).
count_acceptances(U, F, [_|As], N, M?) :-
    otherwise |
    count_acceptances(U?, F?, As?, N?, M).
count_acceptances(_, _, [], N, N?).

%% K atoms accepts(U, F) deleted from the multiset, which holds them:
%% A'_q = A_q - k.{(u, f)} of payout and spend.
procedure delete_acceptances(Key?, Constant?, Integer?, Stream(Acceptance)?, Stream(Acceptance)).
delete_acceptances(_, _, 0, As, As?).
delete_acceptances(U, F, K, [accepts(U1, F1)|As], As1?) :-
    K? > 0, U? =?= U1?, F? =?= F1? |
    K1 := K? - 1,
    delete_acceptances(U?, F?, K1?, As?, As1).
delete_acceptances(U, F, K, [A|As], [A?|As1?]) :-
    otherwise |
    delete_acceptances(U?, F?, K?, As?, As1).

%% The acceptances tallied by issuer and denomination, in order of first
%% appearance.
procedure tally_acceptances(Stream(Acceptance)?, Stream(Accepting)?, Stream(Accepting)).
tally_acceptances([accepts(U, F)|As], Acc, Tally?) :-
    ground(U?), ground(F?) |
    tally_accepting(U?, F?, Acc?, Acc1),
    tally_acceptances(As?, Acc1?, Tally).
tally_acceptances([], Acc, Acc?).

procedure tally_accepting(Key?, Constant?, Stream(Accepting)?, Stream(Accepting)).
tally_accepting(U, F, [accepting(U2, F2, N)|Rest], [accepting(U2?, F2?, N1?)|Rest?]) :-
    U? =?= U2?, F? =?= F2? |
    N1 := N? + 1.
tally_accepting(U, F, [A|Rest], [A?|Rest1?]) :- otherwise | tally_accepting(U?, F?, Rest?, Rest1).
tally_accepting(U, F, [], [accepting(U?, F?, 1)]).

%% =============================================================================
%% Conversations with counterparties
%% =============================================================================

%% Whether a conversation with Q is open: Q's output entry is among the outputs.
procedure has_peer(Key?, Stream(OutputEntry)?, Stream(OutputEntry), Decision).
has_peer(Q, [friend_output(K, Out?)|Rest], [friend_output(K?, Out)|Rest?], yes) :-
    Q? =?= K? | true.
has_peer(Q, [E|Rest], [E?|Rest1?], Known?) :-
    otherwise |
    has_peer(Q?, Rest?, Rest1, Known).
has_peer(_, [], [], no).

%% Adopt the channel of a conversation with Q: its write side becomes Q's
%% output entry and its read side joins the input from counterparties.
procedure adopt(Key?, PeerChannel?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(PeerMsg)?, Stream(PeerMsg)).
adopt(Q, ch(In, Out?), Outs, Outs1?, PeerIn, PeerIn1?) :-
    ground(Q?) |
    add_friend_output(Q?, Out, Outs?, Outs1),
    merge(PeerIn?, In?, PeerIn1).

%% =============================================================================
%% Results injected into the agent's input
%% =============================================================================

%% The counterparty's answer to a proposed swap, when it comes.
procedure inject_swap_result(SwapResponse?, Key?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_swap_result(swap_accept(Given), Q, Ys, [swap_accepted(Q?, Given?)|Ys?]) :-
    ground(Q?), ground(Given?) | true.
inject_swap_result(swap_decline(Given), Q, Ys, [swap_declined_by(Q?, Given?)|Ys?]) :-
    ground(Q?), ground(Given?) | true.
inject_swap_result(R, Q, [Y|Ys], [Y?|Ys1?]) :-
    inject_swap_result(R?, Q?, Ys?, Ys1).

%% The payee's answer to a payment, a payout or a spend to Q, when it comes:
%% Taken is what the screen shows if the coins were taken.
procedure inject_pay_result(PayResponse?, Key?, ScreenContent?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_pay_result(pay_taken, _, Taken, Ys, [pay_taken_by(Taken?)|Ys?]).
inject_pay_result(pay_returned(Coins), Q, _, Ys, [pay_returned_by(Q?, Coins?)|Ys?]) :-
    ground(Q?), ground(Coins?) | true.
inject_pay_result(R, Q, Taken, [Y|Ys], [Y?|Ys1?]) :-
    inject_pay_result(R?, Q?, Taken?, Ys?, Ys1).

%% The payee's answer to a spend the issuer countersigned and forwarded, when
%% it comes: relayed to the payer, and recorded in the issuer's log.
procedure relay_spend(PayResponse?, Key?, Key?, Integer?, PayResponse, Stream(UserInMsg)?, Stream(UserInMsg)).
relay_spend(pay_taken, P, Q, K, pay_taken, Ys, [spend_settled(countersigned(P?, Q?, K?))|Ys?]).
relay_spend(pay_returned(Coins), P, Q, K, pay_returned(Coins?), Ys, [spend_settled(spend_returned(P?, Q?, K?))|Ys?]).
relay_spend(R, P, Q, K, Resp?, [Y|Ys], [Y?|Ys1?]) :-
    relay_spend(R?, P?, Q?, K?, Resp, Ys?, Ys1).

%% The issuer's answer to a presentation for an instrument of R due D1, when
%% it comes.
procedure inject_redeem_result(RedeemResponse?, Key?, Key?, Constant?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_redeem_result(redeem_give(X), Q, R, D1, Ys, [redeem_given(Q?, R?, D1?, X?)|Ys?]) :-
    ground(Q?), ground(X?) | true.
inject_redeem_result(redeem_menu(Coin, Menu), Q, _, _, Ys, [redeem_menu_from(Q?, Coin?, Menu?)|Ys?]) :-
    ground(Q?), ground(Coin?), ground(Menu?) | true.
inject_redeem_result(redeem_declined(Coin), Q, _, _, Ys, [redeem_declined_by(Q?, Coin?)|Ys?]) :-
    ground(Q?), ground(Coin?) | true.
inject_redeem_result(Resp, Q, R, D1, [Y|Ys], [Y?|Ys1?]) :-
    inject_redeem_result(Resp?, Q?, R?, D1?, Ys?, Ys1).

%% The issuer's answer to a bond maturing at D presented to it, when it comes.
procedure inject_mature_result(MatureResponse?, Key?, Integer?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_mature_result(mature_give(Coin), Q, D, Ys, [matured_by(Q?, D?, Coin?)|Ys?]) :-
    ground(Q?), ground(Coin?) | true.
inject_mature_result(mature_declined(Bond), Q, _, Ys, [not_matured_by(Q?, Bond?)|Ys?]) :-
    ground(Q?), ground(Bond?) | true.
inject_mature_result(Resp, Q, D, [Y|Ys], [Y?|Ys1?]) :-
    inject_mature_result(Resp?, Q?, D?, Ys?, Ys1).

%% The receiver's answer to a proposed transfer, when it comes.
procedure inject_transfer_result(TransferResponse?, Kind?, Key?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_transfer_result(transfer_accept, Kind, Q, Ys, [transfer_accepted(Kind?, Q?)|Ys?]) :-
    ground(Kind?), ground(Q?) | true.
inject_transfer_result(transfer_decline(Given), Kind, Q, Ys, [transfer_declined_by(Kind?, Q?, Given?)|Ys?]) :-
    ground(Kind?), ground(Q?), ground(Given?) | true.
inject_transfer_result(R, Kind, Q, [Y|Ys], [Y?|Ys1?]) :-
    inject_transfer_result(R?, Kind?, Q?, Ys?, Ys1).

%% The bodies of the swap responder's two answers (decide_swap): the
%% acceptance, on yes, and the decline, on no.  Each hands the agent the offer
%% with the response writer.
procedure accept_answer(Key?, Lot?, Stream(Instrument)?, SwapResponse, Stream(UserInMsg)).
accept_answer(From, Want, Offered, Resp?, [accept_swap(From?, Want?, Offered?, Resp)]).

procedure decline_answer(Key?, Stream(Instrument)?, SwapResponse, Stream(UserInMsg)).
decline_answer(From, Offered, Resp?, [decline_swap(From?, Offered?, Resp)]).

%% The same for the transfer responder (decide_transfer).
procedure accept_transfer_answer(Kind?, Key?, Stream(Instrument)?, TransferResponse, Stream(UserInMsg)).
accept_transfer_answer(Kind, From, Given, Resp?, [accept_transfer(Kind?, From?, Given?, Resp)]).

procedure decline_transfer_answer(Kind?, Key?, Stream(Instrument)?, TransferResponse, Stream(UserInMsg)).
decline_transfer_answer(Kind, From, Given, Resp?, [decline_transfer(Kind?, From?, Given?, Resp)]).

%% Binding a declined swap's response: the offered instruments go back.
procedure decline(SwapResponse, Stream(Instrument)?).
decline(swap_decline(Given?), Given).

%% Binding a transfer's response: taken, or the instruments go back.
procedure take_transfer(TransferResponse).
take_transfer(transfer_accept).

procedure decline_transfer_resp(TransferResponse, Stream(Instrument)?).
decline_transfer_resp(transfer_decline(Given?), Given).

%% =============================================================================
%% The screen, and the outputs
%% =============================================================================

procedure show(ScreenContent?, Stream(OutputEntry)?, Stream(OutputEntry)).
show(C, Outs, Outs1?) :- send_user(msg(agent, person, C?), Outs?, Outs1).

%% =============================================================================
%% Entry points: the village market denominated in one fiat currency; the same
%% market with the central bank as an eighth party, exercising all twelve
%% transactions; and the term credit line
%% =============================================================================

imported procedure village#market.
exported procedure village.
village :- village # market.

imported procedure village#sovereign_market.
exported procedure sovereign_village.
sovereign_village :- village # sovereign_market.

imported procedure credit_line#run.
exported procedure credit_line.
credit_line :- credit_line # run.

%% =============================================================================
%% Entry point: the mini-app on a live person's screen (play_ui.glp) --- the
%% central bank's, over the sovereign market cut to the central bank, the
%% community bank and the household, the entry the Dart bridge runs, its
%% arguments the agent's identifier, the person's grants and the network
%% input; and the same run with its taps scripted, for the test suite
%% =============================================================================

imported procedure play_ui#sovereign_ui(Key?, PersonIn?, Stream(_)?).
exported procedure sovereign_ui(Key?, PersonIn?, Stream(_)?).
sovereign_ui(Id, Grants, NetIn) :- play_ui # sovereign_ui(Id?, Grants?, NetIn?).

imported procedure play_ui#play_sovereign_ui.
exported procedure play_sovereign_ui.
play_sovereign_ui :- play_ui # play_sovereign_ui.
