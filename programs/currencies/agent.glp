%% agent.glp — Currencies agent module (v2)
%%
%% Exports: agent/7
%% Types and shared helpers: from self.glp (ancestor scoping)
%% Local procedures (call merge or agent recursively): defined here
%%
%% State per agent is the spec pair (c_p, d*_p): Holdings (multiset of bonds)
%% and Clock (local current date, initially 0).  A coin is a bond mature by
%% this agent's own Clock; there is no global clock.
%%
%% The date is carried twice: as Clock, the scalar every maturity test reads,
%% and as an eighth argument, a WRITER of the stream of dates this agent has
%% advanced through.  An open escrow reads that stream and releases on it, so
%% escrow release is driven by Advance-date like maturity, and by nothing else.
%%
%% v2 changes:
%%   - Types and shared helpers moved to self.glp
%%   - Standalone stream types eliminated (use Stream(X))
%%   - Module structure with exported procedure
%%   - agent/6 -> agent/7: added the local Clock field (Def. 2 state (c_p,d*_p))
%%   - reusable transaction predicates factored out to txn.glp (imported below)
%%   - agent/7 -> agent/8 behind an agent/7 shim: added the date stream the
%%     escrow reads, replacing the wall clock (Def. 3.2 has no wall clock)


%% =============================================================================
%% IMPORTED — reusable transaction core (txn.glp)
%% =============================================================================

imported procedure txn#create_bonds(Constant?, Constant?, Constant?, Constant?, Stream(Bond)).
imported procedure txn#append(Stream(Bond)?, Stream(Bond)?, Stream(Bond)).
imported procedure txn#select_bonds_by_spec(Stream(Lot)?, Stream(Bond)?, Constant, Stream(Bond), Stream(Bond)).
imported procedure txn#classify_trade(Constant?, Constant?, Stream(Lot)?, Stream(Bond)?, Constant).
imported procedure txn#build_menu(Constant?, Stream(Bond)?, Stream(Bond)).

%% =============================================================================
%% MERGE — local copy (Stream(X) subtyping limitation)
%% =============================================================================

%% merge/3 is now defined once in the root programs/self.glp (A3 amendment).

%% =============================================================================
%% RESPONSE HANDLING — local (calls merge and add_friend_output)
%% =============================================================================

procedure bind_response(Decision?, Constant?, Response, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
bind_response(yes, From, accept(RetCh?), Outs, Outs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Outs?, Outs1, In?, In1).
bind_response(no, _, no, Outs, Outs1?, In, In?) :-
    send_user( msg(agent, person, rejected), Outs?, Outs1).

procedure handle_response(Response?, Constant?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
handle_response(accept(ch(FIn, FOut?)), From, Outs, Outs2?, In, In1?) :-
    ground(From?) |
    add_friend_output(From?, FOut, Outs?, Outs1),
    send_user( msg(agent, person, connected(From?)), Outs1?, Outs2),
    merge(In?, FIn?, In1).
handle_response(no, From, Outs, Outs1?, In, In?) :-
    ground(From?) |
    send_user( msg(agent, person, rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% DO_TRADE — Select bonds matching GiveSpec, then send or fail
%% =============================================================================

procedure do_trade(Constant?, Constant?, Stream(Lot)?, Stream(Lot)?, Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).
do_trade(Id, Target, GiveSpec, WantSpec, Holdings, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_trade_result(Status?, Id?, Target?, WantSpec?, Selected?, Remaining?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

procedure do_trade_result(Constant?, Constant?, Constant?, Stream(Lot)?, Stream(Bond)?, Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).
do_trade_result(ok, Id, Target, WantSpec, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    send_friend(Target?,
        msg(Id?, Target?, trade_propose(WantSpec?, Selected?, TradeResp)),
        Outs?, Outs1),
    inject_trade_result(TradeResp?, Target?, PersonIn?, PersonIn1),
    agent(Id?, PersonIn1?, NetIn?, Outs1?, Remaining?, NextSerial?, Clock?, DateW).
do_trade_result(fail, Id, Target, _, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # append(Selected?, Remaining?, OrigHoldings),
    send_user( msg(agent, person, trade_failed(Target?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?, Clock?, DateW).

%% =============================================================================
%% DO_REDEEM — Redeem (Def 3.2 item 5), guarded by the redeemer.
%% Offer the Target's bonds named by GiveSpec; whether they are coins is the
%% issuer's call, tested against the issuer's own date on receipt (classify_trade
%% -> redemption).  The redeemer does not test maturity; on a wrong-issuer or
%% missing spec the selection fails and holdings are restored.
%% =============================================================================

procedure do_redeem(Constant?, Constant?, Stream(Lot)?, Stream(Lot)?, Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).
do_redeem(Id, Target, GiveSpec, WantSpec, Holdings, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_redeem_result(Status?, Id?, Target?, WantSpec?, Selected?, Remaining?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

procedure do_redeem_result(Constant?, Constant?, Constant?, Stream(Lot)?, Stream(Bond)?, Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).
do_redeem_result(ok, Id, Target, WantSpec, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    send_friend(Target?,
        msg(Id?, Target?, trade_propose(WantSpec?, Selected?, TradeResp)),
        Outs?, Outs1),
    inject_trade_result(TradeResp?, Target?, PersonIn?, PersonIn1),
    agent(Id?, PersonIn1?, NetIn?, Outs1?, Remaining?, NextSerial?, Clock?, DateW).
do_redeem_result(fail, Id, Target, _, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # append(Selected?, Remaining?, OrigHoldings),
    send_user( msg(agent, person, trade_failed(Target?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?, Clock?, DateW).

%% =============================================================================
%% HANDLE_TRADE_FILL — Bind TradeResponse after selection attempt
%% =============================================================================

procedure handle_trade_fill(Constant?, Constant?, Constant?, TradeResponse, Stream(Bond)?, Stream(Bond)?, Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).
%% Can fill: bind accept(our bonds), take offered bonds, notify person
handle_trade_fill(ok, Id, From, trade_accept(Selected?), OfferedBonds, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # append(Remaining?, OfferedBonds?, NewHoldings),
    send_user( msg(agent, person, trade_completed(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).
%% Can't fill: bind decline(offered bonds back), reconstruct own holdings
handle_trade_fill(fail, Id, From, trade_decline(OfferedBonds?), OfferedBonds, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # append(Selected?, Remaining?, OrigHoldings),
    send_user( msg(agent, person, trade_failed(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?, Clock?, DateW).

%% =============================================================================
%% TRADE_DISPATCH — Branch on auto-accept vs. person decision
%% =============================================================================

procedure trade_dispatch(Constant?, Constant?, Constant?, Stream(Lot)?, Stream(Bond)?, TradeResponse,
    Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).

%% Payment — auto-accept (proposer gives coins, wants nothing)
trade_dispatch(payment, Id, From, _, OfferedBonds, trade_accept([]),
    Holdings, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # append(Holdings?, OfferedBonds?, NewHoldings),
    send_user( msg(agent, person, trade_completed(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).

%% Redemption — auto-accept with requested bond, or reject with menu
trade_dispatch(redemption, Id, From, WantSpec, OfferedBonds, TradeResp?,
    Holdings, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # select_bonds_by_spec(WantSpec?, Holdings?, Status, Selected, Remaining),
    redemption_result(Status?, Id?, From?, TradeResp, OfferedBonds?,
        Selected?, Remaining?,
        PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

%% Normal trade — present to person
trade_dispatch(normal, Id, From, WantSpec, OfferedBonds, TradeResp?,
    Holdings, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    send_user(
        msg(agent, person, trade_proposed(From?, WantSpec?, TradeResp, OfferedBonds?)),
        Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% =============================================================================
%% REDEMPTION_RESULT — Accept with requested bond or reject with menu
%% =============================================================================

procedure redemption_result(Constant?, Constant?, Constant?, TradeResponse, Stream(Bond)?,
    Stream(Bond)?, Stream(Bond)?,
    Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).

%% Can fill — accept with requested bonds
redemption_result(ok, Id, From, trade_accept(Selected?), OfferedBonds,
    Selected, Remaining,
    PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # append(Remaining?, OfferedBonds?, NewHoldings),
    send_user( msg(agent, person, trade_completed(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).

%% Can't fill — reject with menu
redemption_result(fail, Id, From, trade_decline_menu(OfferedBonds?, Menu?), OfferedBonds,
    Selected, Remaining,
    PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    txn # append(Selected?, Remaining?, OrigHoldings),
    redemption_reject(Id?, From?, OrigHoldings?, Menu,
        PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

procedure redemption_reject(Constant?, Constant?, Stream(Bond)?, Stream(Bond),
    Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?, Stream(Constant)).
redemption_reject(Id, From, OrigHoldings, Menu?, PersonIn, NetIn, Outs, NextSerial, Clock, DateW?) :-
    ground(OrigHoldings?) |
    txn # build_menu(Id?, OrigHoldings?, Menu),
    send_user( msg(agent, person, trade_failed(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?, Clock?, DateW).

%% =============================================================================
%% DO_DEPOSIT_ESCROW — Select bonds and create escrow or fail
%% =============================================================================
%%
%% The deposit path opens a FRESH date channel: EscrowDates is read by the escrow
%% and its writer becomes the agent's, so the dates the depositor advances through
%% from here on reach this escrow.  The agent clause closed the previous channel,
%% which is what keeps the stream single-reader.

procedure do_deposit_escrow(Constant?, Constant?, Stream(Lot)?, Constant?, Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?).
do_deposit_escrow(Id, Target, GiveSpec, ReleaseTime, Holdings, PersonIn, NetIn, Outs, NextSerial, Clock) :-
    txn # select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_deposit_escrow_result(Status?, Id?, Target?, ReleaseTime?, Selected?, Remaining?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?).

procedure do_deposit_escrow_result(Constant?, Constant?, Constant?, Constant?, Stream(Bond)?, Stream(Bond)?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Constant?, Constant?).
do_deposit_escrow_result(ok, Id, Target, ReleaseTime, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock) :-
    ground(Selected?) |
    escrow(ReleaseTime?, EscrowDates?, Selected?, CancelSignal?, BenResult, DepResult),
    inject_escrow_dep_result(DepResult?, Target?, PersonIn?, PersonIn1),
    send_friend(Target?,
        msg(Id?, Target?, escrow_offer(ReleaseTime?, BenResult?)),
        Outs?, Outs1),
    send_user(
        msg(agent, person, escrow_deposited(Target?, ReleaseTime?, CancelSignal)),
        Outs1?, Outs2),
    agent(Id?, PersonIn1?, NetIn?, Outs2?, Remaining?, NextSerial?, Clock?, EscrowDates).
do_deposit_escrow_result(fail, Id, Target, _, Selected, Remaining, PersonIn, NetIn, Outs, NextSerial, Clock) :-
    txn # append(Selected?, Remaining?, OrigHoldings),
    send_user( msg(agent, person, escrow_failed(Target?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?, Clock?, _).

%% =============================================================================
%% AGENT/7 — the interface the plays, the mediator and the boot modules call
%% =============================================================================
%%
%% agent(Id, PersonIn, NetIn, Outs, Holdings, NextSerial, Clock)
%%   Id         — agent identity (constant)
%%   PersonIn     — stream of messages from mediator (+ injected results)
%%   NetIn      — stream of messages from network
%%   Outs       — output list (person, '_net', friend(X), ...)
%%   Holdings   — list of bonds held by this agent (c_p)
%%   NextSerial — next serial number for minting
%%   Clock      — this agent's local current date (d*_p), initially 0
%%
%% It opens the date stream and discards its outward end: only an open escrow
%% consumes it, and an agent with no escrow open has no reader for it.

exported procedure agent(Constant?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Stream(Bond)?, Constant?, Constant?).
agent(Id, PersonIn, NetIn, Outs, Holdings, NextSerial, Clock) :-
    agent(Id?, PersonIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?, _).

%% =============================================================================
%% AGENT/8 — the main loop, carrying the agent's own date as a stream (arg 8)
%% so an open escrow can read it: advance_date writes it, and the deposit path
%% opens the fresh channel the escrow reads (see do_deposit_escrow).
%% =============================================================================

procedure agent(Constant?, Stream(PersonInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, Stream(Bond)?, Constant?, Constant?, Stream(Constant)).

%% --- Phase 1: Mint / Advance-date / Balance / Done ---

%% Person requests mint: create K bonds, add to holdings, notify person
agent(Id, [msg(person, Id1, mint(K, Maturity))|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(K?), ground(Maturity?) |
    NewNextSerial := NextSerial? + K?,
    txn # create_bonds(Id?, Maturity?, K?, NextSerial?, NewBonds),
    txn # append(Holdings?, NewBonds?, NewHoldings),
    send_user( msg(agent, person, minted(K?, Maturity?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NewNextSerial?, Clock?, DateW).

%% Person advances local date (Def. 2 item 2, unguarded): d*' > d*, holdings
%% unchanged.  Local time advances by the calendar; there is no global clock.
%% The new date is written to the date stream, where an open escrow reads it.
agent(Id, [msg(person, Id1, advance_date(D))|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, [D?|DateW1?]) :-
    Id? =?= Id1?, ground(D?), D? > Clock? |
    send_user( msg(agent, person, date_advanced(D?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, Holdings?, NextSerial?, D?, DateW1).

%% Person requests balance: report current holdings
agent(Id, [msg(person, Id1, balance)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(Holdings?) |
    send_user( msg(agent, person, balance_report(Holdings?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% Person sends done: terminate agent
agent(Id, [msg(person, Id1, done)|_], _, Outs, _, _, _, []) :-
    Id? =?= Id1? |
    close_outputs(Outs?).

%% --- Phase 2: Social graph (cold-call befriending) ---

%% Person initiates cold call
agent(Id, [msg(person, Id1, connect(Target))|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(Target?) |
    send_net( msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, PersonIn?, PersonIn1),
    agent(Id?, PersonIn1?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% Person decision on cold-call
agent(Id, [msg(person, Id1, decision(Dec, From, response(Resp?)))|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, PersonIn?, NetIn1?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% Response to cold-call (injected by inject_msg)
agent(Id, [msg(From, Id1, response(Resp))|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, PersonIn?, NetIn1?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% Cold-call from network
agent(Id, PersonIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1? |
    send_user( msg(agent, person, befriend(From?, Resp)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% --- Phase 7: Trade / Redeem ---

%% Proposer: trade command
agent(Id, [msg(person, Id1, trade(Target, GiveSpec, WantSpec))|PersonIn],
      NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    do_trade(Id?, Target?, GiveSpec?, WantSpec?, Holdings?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

%% Proposer: redeem command (Def 3.2 item 5, guarded by the redeemer).
%% GiveSpec names the Target's bonds we present; whether they are coins is the
%% issuer's call, tested against the issuer's own date (classify_trade -> redemption).
agent(Id, [msg(person, Id1, redeem(Target, GiveSpec, WantSpec))|PersonIn],
      NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    do_redeem(Id?, Target?, GiveSpec?, WantSpec?, Holdings?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

%% Proposer: trade_complete (injected — accept)
agent(Id, [trade_complete(From, TheirBonds)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    ground(Id?), ground(From?), ground(TheirBonds?) |
    txn # append(Holdings?, TheirBonds?, NewHoldings),
    send_user( msg(agent, person, trade_completed(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).

%% Proposer: trade_returned_bonds (injected — decline)
agent(Id, [trade_returned_bonds(From, OurBonds)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    ground(Id?), ground(From?), ground(OurBonds?) |
    txn # append(Holdings?, OurBonds?, NewHoldings),
    send_user( msg(agent, person, trade_returned(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).

%% Proposer: trade returned with menu (redemption rejected — menu of available bonds)
agent(Id, [trade_returned_bonds_menu(From, OurBonds, Menu)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    ground(Id?), ground(From?), ground(OurBonds?), ground(Menu?) |
    txn # append(Holdings?, OurBonds?, NewHoldings),
    send_user( msg(agent, person, trade_returned_menu(From?, Menu?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).

%% Responder: incoming trade_propose — auto-accept iff the offered bonds are
%% coins of Id at Id's own date (payment/redemption); else shown to the person.
agent(Id, PersonIn, [msg(From, Id1, trade_propose(WantSpec, OfferedBonds, TradeResp?))|NetIn],
      Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    txn # classify_trade(Id?, Clock?, WantSpec?, OfferedBonds?, TradeClass),
    trade_dispatch(TradeClass?, Id?, From?, WantSpec?, OfferedBonds?, TradeResp,
        Holdings?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

%% Responder: accept_trade (inlined — select bonds then fill)
agent(Id, [msg(person, Id1, accept_trade(From,
        trade_pending(TradeResp?, WantSpec, OfferedBonds)))|PersonIn],
      NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    txn # select_bonds_by_spec(WantSpec?, Holdings?, Status, Selected, Remaining),
    handle_trade_fill(Status?, Id?, From?, TradeResp, OfferedBonds?, Selected?, Remaining?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?, DateW).

%% Responder: reject_trade
agent(Id, [msg(person, Id1, reject_trade(From,
        trade_pending(TradeResp?, _, OfferedBonds)))|PersonIn],
      NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(From?), ground(OfferedBonds?) |
    bind_trade_decline(TradeResp, OfferedBonds?),
    agent(Id?, PersonIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?, DateW).

%% --- Phase 8: Escrow ---

%% Depositor: deposit_escrow command.  The current date channel is closed here
%% and do_deposit_escrow opens the fresh one the new escrow reads — one reader
%% per channel, which is what SRSW requires.
agent(Id, [msg(person, Id1, deposit_escrow(Target, GiveSpec, ReleaseTime))|PersonIn],
      NetIn, Outs, Holdings, NextSerial, Clock, []) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(ReleaseTime?) |
    do_deposit_escrow(Id?, Target?, GiveSpec?, ReleaseTime?, Holdings?, PersonIn?, NetIn?, Outs?, NextSerial?, Clock?).

%% Depositor: escrow expired (injected — the date reached T, bonds went to the beneficiary)
agent(Id, [escrow_dep_expired(Target)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    ground(Id?) |
    send_user( msg(agent, person, escrow_expired(Target?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% Depositor: escrow returned (injected — cancel succeeded, bonds back)
agent(Id, [escrow_dep_returned(Target, OurBonds)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    ground(Id?), ground(Target?), ground(OurBonds?) |
    txn # append(Holdings?, OurBonds?, NewHoldings),
    send_user( msg(agent, person, escrow_returned(Target?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).

%% Depositor: cancel_escrow — bind CancelSignal to cancel
agent(Id, [msg(person, Id1, cancel_escrow(Target,
        escrow_pending(CancelSignal?)))|PersonIn],
      NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(Target?) |
    bind_escrow_cancel(CancelSignal),
    agent(Id?, PersonIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?, DateW).

%% Beneficiary: incoming escrow_offer
agent(Id, PersonIn, [msg(From, Id1, escrow_offer(ReleaseTime, BenResult))|NetIn],
      Outs, Holdings, NextSerial, Clock, DateW?) :-
    Id? =?= Id1?, ground(From?), ground(ReleaseTime?) |
    inject_escrow_ben_result(BenResult?, From?, PersonIn?, PersonIn1),
    send_user( msg(agent, person, escrow_received(From?, ReleaseTime?)), Outs?, Outs1),
    agent(Id?, PersonIn1?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% Beneficiary: escrow released (injected — the holder's date reached T, bonds received)
agent(Id, [escrow_ben_released(From, Bonds)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    ground(Id?), ground(From?), ground(Bonds?) |
    txn # append(Holdings?, Bonds?, NewHoldings),
    send_user( msg(agent, person, escrow_released(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?, Clock?, DateW).

%% Beneficiary: escrow cancelled (injected — depositor cancelled)
agent(Id, [escrow_ben_cancelled(From)|PersonIn], NetIn, Outs, Holdings, NextSerial, Clock, DateW?) :-
    ground(Id?) |
    send_user( msg(agent, person, escrow_cancelled(From?)), Outs?, Outs1),
    agent(Id?, PersonIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?, DateW).

%% --- Termination ---
%%
%% Only terminate on PersonIn closure. NetIn closure is NOT used because
%% in single-agent plays NetIn is unbound, and an unbound variable
%% matches [] in GLP, causing premature termination.
%% Multi-agent plays terminate via explicit 'done' commands.

agent(_, [], _, Outs, _, _, _, []) :- close_outputs(Outs?).
