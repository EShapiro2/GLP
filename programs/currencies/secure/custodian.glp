
%% custodian.glp — Custodian mirror
%%
%% Reads the issuer's block stream and writes ack(TxId) for each block.
%% The custodian's ack stream serves as a recoverable copy of the log.

exported procedure custodian(Stream(IssuerBlock)?, Stream(AckMsg)).

custodian([block(tx(TxId, _), _)|Rest], [ack(TxId?)|AckTail?]) :-
    custodian(Rest?, AckTail).

custodian([], []).
