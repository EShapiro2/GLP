
%% issuer.glp — Issuer setup with custodian finality and recovery
%%
%% The issuer processes approval requests, producing an interlaced
%% issuer stream. A custodian mirrors the stream and acknowledges
%% each block. When the issuer observes a custodian's ack (via tips
%% in subsequent blocks), it binds the corresponding finality variables.
%%
%% Architecture (5 concurrent processes):
%%   request comes in → issuer_loop produces blocks with tips
%%                    → custodian reads blocks, produces acks
%%                    → tee splits acks into two copies
%%                    → one copy feeds back to issuer_loop (via collect_tips)
%%                    → other copy goes to finality_binder
%%                    → finality_binder binds reply variables
%%
%% The first block is produced with empty tips (no acks exist yet)
%% to break the circular dependency and bootstrap the system.

%% =============================================================================
%% IMPORTED PROCEDURES
%% =============================================================================

imported procedure interlace#collect_tips(AckStreams?, TipList, AckStreams).
imported procedure custodian#custodian(Stream(IssuerBlock)?, Stream(AckMsg)).

%% =============================================================================
%% TEE — Split a ground-element stream into two copies
%% =============================================================================
%%
%% Uses ground(X?) relaxation to allow two reader occurrences
%% of X? in the output streams.

procedure tee(Stream(X)?, Stream(X), Stream(X)).

tee([X|Xs], [X?|Ys?], [X?|Zs?]) :-
    ground(X?) |
    tee(Xs?, Ys, Zs).

tee([], [], []).

%% =============================================================================
%% BIND_FINALITY — Bind a finality reply variable to finalized
%% =============================================================================

procedure bind_finality(Finality).
bind_finality(finalized).

%% =============================================================================
%% FIRST_REQUEST — Process first approval request (empty tips)
%% =============================================================================
%%
%% The first block has no tips because no custodian acks exist yet.
%% Produces an IssuerBlock and a PendingFinality entry.

procedure first_request(ApprovalReq?, Constant?, IssuerBlock, PendingFinality).

first_request(approve_mint(K, Maturity, FinalityM?), Counter,
    block(tx(Counter?, tx_mint(K?, Maturity?)), []),
    pending_mint(Counter?, FinalityM)).

first_request(approve_pay(From, To, Coin, FinalityQ?, FinalityR?), Counter,
    block(tx(Counter?, tx_pay(From?, To?, Coin?)), []),
    pending_pay(Counter?, FinalityQ, FinalityR)).

%% =============================================================================
%% ISSUER_LOOP — Process subsequent requests with interlaced tips
%% =============================================================================
%%
%% Like interlace, but specialized: each payload comes from an approval
%% request, and finality reply variables are extracted into a parallel
%% pending stream for later binding.

procedure issuer_loop(Stream(ApprovalReq)?, Constant?, AckStreams?,
    Stream(IssuerBlock), Stream(PendingFinality)).

%% Mint request
issuer_loop(
    [approve_mint(K, Maturity, FinalityM?)|Reqs], Counter, Others,
    [block(tx(Counter?, tx_mint(K?, Maturity?)), Tips?)|IssuerTail?],
    [pending_mint(Counter?, FinalityM)|PendTail?]) :-
    interlace # collect_tips(Others?, Tips, Others1),
    Counter1 := Counter? + 1,
    issuer_loop(Reqs?, Counter1?, Others1?, IssuerTail, PendTail).

%% Pay request
issuer_loop(
    [approve_pay(From, To, Coin, FinalityQ?, FinalityR?)|Reqs], Counter, Others,
    [block(tx(Counter?, tx_pay(From?, To?, Coin?)), Tips?)|IssuerTail?],
    [pending_pay(Counter?, FinalityQ, FinalityR)|PendTail?]) :-
    interlace # collect_tips(Others?, Tips, Others1),
    Counter1 := Counter? + 1,
    issuer_loop(Reqs?, Counter1?, Others1?, IssuerTail, PendTail).

%% No more requests
issuer_loop([], _, _, [], []).

%% =============================================================================
%% FINALITY_BINDER — Bind finality variables when acks arrive
%% =============================================================================
%%
%% Reads acks and the parallel pending stream in lockstep.
%% Acks and pendings arrive in the same order (both follow block order).

procedure finality_binder(Stream(AckMsg)?, Stream(PendingFinality)?).

%% Mint: bind one finality variable
finality_binder([ack(N)|Acks], [pending_mint(Id, FinalityM?)|Pendings]) :-
    N? =?= Id? |
    bind_finality(FinalityM),
    finality_binder(Acks?, Pendings?).

%% Pay: bind two finality variables
finality_binder([ack(N)|Acks], [pending_pay(Id, FinalityQ?, FinalityR?)|Pendings]) :-
    N? =?= Id? |
    bind_finality(FinalityQ),
    bind_finality(FinalityR),
    finality_binder(Acks?, Pendings?).

%% Done
finality_binder([], []).

%% =============================================================================
%% SETUP — Wire everything together
%% =============================================================================

exported procedure setup(Stream(ApprovalReq)?).

setup([FirstReq|RestReqs]) :-
    first_request(FirstReq?, 1, FirstBlock, FirstPending),
    custodian # custodian([FirstBlock?|IssuerTail?], RawAcks),
    tee(RawAcks?, TipAcks, FinAcks),
    issuer_loop(RestReqs?, 2, [TipAcks?], IssuerTail, RestPendings),
    finality_binder(FinAcks?, [FirstPending?|RestPendings?]).

setup([]).

%% =============================================================================
%% SETUP_WITH_LOG — Setup with a log copy for recovery
%% =============================================================================
%%
%% Like setup, but tees the issuer stream so a copy is available.
%% The log copy can be used after a fault to recover the counter
%% and reconstruct holdings.

exported procedure setup_with_log(Stream(ApprovalReq)?, Stream(IssuerBlock)).

setup_with_log([FirstReq|RestReqs], LogCopy?) :-
    first_request(FirstReq?, 1, FirstBlock, FirstPending),
    tee([FirstBlock?|IssuerTail?], CustodianCopy, LogCopy),
    custodian # custodian(CustodianCopy?, RawAcks),
    tee(RawAcks?, TipAcks, FinAcks),
    issuer_loop(RestReqs?, 2, [TipAcks?], IssuerTail, RestPendings),
    finality_binder(FinAcks?, [FirstPending?|RestPendings?]).

setup_with_log([], []).

%% =============================================================================
%% RECOVER_COUNTER — Walk a log stream, return the last block counter
%% =============================================================================
%%
%% After a fault (major or minor), the recovered issuer reads
%% the custodian's copy of the log to determine where to resume.

exported procedure recover_counter(Stream(IssuerBlock)?, Constant).

recover_counter([block(tx(N, _), _)|Rest], Counter?) :-
    recover_counter_next(N?, Rest?, Counter).

recover_counter([], 0).

procedure recover_counter_next(Constant?, Stream(IssuerBlock)?, Constant).

recover_counter_next(_, [block(tx(N, _), _)|Rest], Counter?) :-
    recover_counter_next(N?, Rest?, Counter).

recover_counter_next(N, [], N?).
