%% play_ui.glp --- the currency mini-app with a LIVE person: the person on the
%% other end of the mini-app's channel is the app's user, not a script.
%%
%% coins_ui(Me, [Bob], Grants, NetIn) is the entry the agent's initial goal
%% starts on the person's first act, coins_ui(Me, [Bob]) (self.glp, agent/2):
%% Me is the agent's own key and Bob the key of the one peer the person knows,
%% each a variable standing for a key (IGLP, Remark "Agent Names").  The live
%% person's grants arrive on the third argument, input(Id, P, R) as the bridge
%% returns them from her acts on the mini-app's constructs, and the other half
%% of her person channel --- the constructs the dispatcher draws and
%% withdraws, and the screen --- leaves by send_to_user/1, one term to a line,
%% which is what the bridge reads (vGLP, sections/elicitation.tex, the
%% paragraph "The implementation").  Her screen is therefore derived from the
%% interactive types of currency/coins_agent.vglp and from nothing else.
%%
%% Bob is scripted (currency/person.glp) and shares one conversation with her,
%% as the villagers do in village.glp.  His script exercises both of her
%% constructs: he mints 2, accepts the swap she proposes as a request on her
%% request form, and then proposes the reverse swap himself --- the 2 coins of
%% hers he now holds for the 2 of his she now holds --- which arrives at her as
%% the approval question of the swap responder, its yes her Accept and its no
%% her Decline.  Both executions are in one heap and the network is not used.
%%
%% This file is the harness of the app, not part of the currency: the certified
%% program is currency/, which this directory is not (see self.glp).

imported procedure currency#coins(Key?, PersonChannel(currency#Drawn)?, Stream(Conversation(PeerMsg))?).
imported procedure currency#person(Key?, _?, PersonIn(currency#Drawn), Script?, Stream(ScreenContent)).

exported procedure coins_ui(Key?, CoinsPeers?, PersonIn(currency#Drawn)?, CoinsNet?).
coins_ui(Me, [Bob], Grants, _) :-
    ground(Me?), ground(Bob?) |
    currency # coins(Me?, ch(Grants?, Draws), [conversation(Bob?, ch(AB?, BA))]),
    send_to_user(Draws?),
    currency # coins(Bob?, ch(BobGrants?, BobDraws), [conversation(Me?, ch(BA?, AB))]),
    currency # person(Bob?, BobDraws?, BobGrants,
                    [mint(2), accept(Me?), swap(Me?, Me?, 2, Bob?, 2)],
                    BobScreen),
    log_peer(Bob?, BobScreen?).

%% Bob's screen, tagged, so the run is observable in the app's trace while
%% nothing of his reaches alice's own screen: her manifest views the messages
%% matching msg(agent, person, S) and nothing else.
procedure log_peer(Key?, Stream(ScreenContent)?).
log_peer(Id, [M|Ms]) :- ground(M?) | send_to_user([tagged(Id?, M?)]), log_peer(Id?, Ms?).
log_peer(_, []).
