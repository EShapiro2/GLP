%% self.glp — grassroots currencies, the coins program.
%%
%% The program every participant runs under the grassroots social contract of
%% "Grassroots Currencies: Turning Mutual Trust into Liquidity" (Section 3),
%% derived from the four transactions of its Definition 3.1.  It runs as a
%% mini-app of the Grassroots Super-App: currency/ is the certified program --- the
%% agent (currency/coins_agent.vglp, compiled by the vGLP canonical compilation
%% into currency/coins_agent.glp beside it), the mini-app entry coins/3
%% (currency/miniapp.glp), a scripted person (currency/person.glp) and the plays
%% that activate the mini-app by run/3 (currency/plays.glp) --- and this
%% directory adds the village play (village.glp), which stands in for the
%% super-app.  This file holds the types shared by all of them, and the helpers
%% over holdings and channels that the agent calls.
%%
%% A coin is coin(Issuer, Serial): the atom cent(u) of the act schemas, with the
%% serial a practical implementation gives each coin.  A party's holdings are a
%% multiset of coins, Stream(Coin).  A lot is k coins of one issuer,
%% lot(Issuer, K): the cent^k_u of Section 3.2.  Each field is a named type
%% over its base type, named by the variable its clause gives it, so that
%% vGLP labels the field by it where a coin or a lot is drawn (Definition
%% "Widget Declaration, Default Widget"): an issuer is an agent identifier, a
%% Key; a serial an Integer; the Amount is the request's.

Coin   ::= coin(Issuer, Serial).
Lot    ::= lot(Issuer, Amount).
Issuer ::= Key.
Serial ::= Integer.

%% The counterparty's answer to a swap: the coins it gives, or the offered coins
%% returned.
SwapResponse ::= swap_accept(Stream(Coin)) ; swap_decline(Stream(Coin)).

%% The issuer's answer to a presentation: the coin taken in exchange; the
%% presented coin returned with the issuers of the coins it holds, one per
%% issuer, for the bearer to choose among; or the coin returned because it is
%% not the issuer's.
RedeemResponse ::= redeem_give(Coin)
                 ; redeem_menu(Coin, Stream(Key))
                 ; redeem_declined(Coin).

%% What one agent sends another: the three bilateral acts of Definition 3.1, and
%% the return of coins that were not a payment, because they are not the
%% payee's own.  A position that forwards a writer carries ? in the type
%% (typed-glp-manual, 15B).
PeerContent ::= pay(Stream(Coin))
              ; swap(Lot, Stream(Coin), SwapResponse?)
              ; redeem(Coin, Key, RedeemResponse?)
              ; return(Stream(Coin)).
PeerMsg     ::= msg(Key, Key, PeerContent).

%% What the social graph hands the mini-app on its channel to the social graph
%% is the root's Conversation(T) at the mini-app's own type, PeerMsg, and the
%% root channel the root's RootChannel(PeerMsg) (programs/self.glp; GLP,
%% 2026-10-13 20:04 UTC, item 2: the root takes each name, every duplicate
%% deleted).  Two agents transact over that channel and over nothing else.

%% Whether a coin was found in the holdings.
Found ::= found(Coin) ; not_found.

%% The answer to a question the agent asks of its state: whether every coin of
%% a payment is the payee's own (own_coins), whether a conversation with a
%% counterparty is open (has_peer), whether the screen shows a step's effect
%% (the scripted person's done).  The name is the one the social graph gives
%% the same two constants.
Decision ::= yes ; no.

%% Whether k coins of an issuer were selected out of the holdings: ok, or fail
%% --- the precondition cent^k_u in c_p of Definition 3.1 does not hold.
Status ::= ok ; fail.

%% The agent's outputs: the screen, and a channel per counterparty, keyed by
%% its name.  The routers send_user, send_friend and add_friend_output are
%% those of social/graph/routing, exposed from the root scope.
OutputEntry ::= user_output(Stream(ScreenMsg)?)
              ; friend_output(Key, Stream(PeerMsg)?).

%% The screen: the holdings, tallied by issuer, after every change, and what
%% each act came to.
%% The holdings, each lot a field of its own (Udi, 2026-10-12: a field is
%% named by its type; Currencies, 2026-10-14 08:48 UTC, item 3).
Holdings ::= Stream(Lot).
%% The fields of the screen's messages, each named by what it is: a field is
%% labelled by the name of its declared type, and the type is named for what
%% the field is (Udi, 2026-10-12; Currencies, 2026-10-14 09:24 UTC,
%% SGC/docs/screen-field-names-2026-10-14.md).  The shapes are unchanged.
ScreenContent ::= holdings(Holdings)
                ; opened(Friend)
                ; minted(Amount)
                ; paid(Friend, Amount)
                ; received(From, Amount)
                ; returned(From, Amount)
                ; swap_done(Friend)
                ; swap_declined(Friend)
                ; swap_failed(From)
                ; declined(From)
                ; redeemed(Friend, WantCoin)
                ; menu(Friend, Issuers)
                ; presented(From, WantCoin)
                ; unfulfilled(From, WantCoin)
                ; refused(Friend)
                ; lacking(Issuer, Amount)
                ; no_conversation(Friend).
Issuers ::= Stream(Issuer).
ScreenMsg ::= msg(Constant, Constant, ScreenContent).

%% The type of the agent's output to its person, the reserved name Output:
%% "A vGLP program declares the type of its output to its person by defining
%% the type Output, a reserved name; the dispatcher draws that output as a
%% thread whose elements are drawn by the widget of Output" (vGLP 169b008,
%% Definition "Canonical Compilation").  The output is the content, not the
%% envelope: the relay strips msg(agent, person, C) to C (Currencies,
%% 2026-10-14 08:48 UTC, item 2).
Output ::= ScreenContent.

%% The agent's own input: the answers its swap responders inject, and the
%% results of the acts it proposed.
UserInMsg ::= accept_swap(Key, Lot, Stream(Coin), SwapResponse?)
            ; decline_swap(Key, Stream(Coin), SwapResponse?)
            ; swap_accepted(Key, Stream(Coin))
            ; swap_declined_by(Key, Stream(Coin))
            ; redeem_given(Key, Coin)
            ; redeem_menu_from(Key, Coin, Stream(Key))
            ; redeem_declined_by(Key, Coin).

%% The offer a swap responder carries: the proposer, the lot it wants, the
%% coins it offers, each field named by the variable its clause gives it, as
%% the request's are, so that the approval question labels it From, Want and Offered.
Offer   ::= offer(From, Want, Offered).
From    ::= Key.
Want    ::= Lot.
Offered ::= Stream(Coin).

%% =============================================================================
%% The agent's questions (vGLP, Definition "Guarded Clause, Volitional
%% Procedure, Interactive Type, ..."): the person's requests, the agent's
%% interactive type in reader mode, and the responder's approval question, in writer mode.
%% =============================================================================

%% The fields of a request, one named type per meaning over its base type,
%% each named by the variable its clause gives it, so that vGLP labels the
%% field by it (Definition "Widget Declaration, Default Widget"): the
%% counterparty, a Friend, and the amounts and issuers given and wanted.  An
%% issuer is an agent identifier, a person, and so a Key.
Amount     ::= Integer.
Friend     ::= Key.
GiveCoin   ::= Key.
GiveAmount ::= Integer.
WantCoin   ::= Key.
WantAmount ::= Integer.

%% A request: one alternative per request clause of the agent, each a
%% transaction of Definition 3.1 at the party whose election it is --- Mint,
%% Swap, Pay and Redeem --- with the arguments its clause reads.  A swap is
%% flat, the two lots its clause builds given field by field.
Request ::= mint(Amount)
          ; swap(Friend, GiveCoin, GiveAmount, WantCoin, WantAmount)
          ; pay(Friend, Amount)
          ; redeem(Friend, WantCoin).

%% The responder's approval question: the offer, which the agent writes for the person to
%% see, and the person's answer, yes accepting and no declining.
YesNo ::= yes ; no.
Approval ::= approval(Offer, YesNo?).

%% =============================================================================
%% The vocabulary of the compiled agent's dispatcher, so that the mini-app
%% entry and the plays can type the goals they spawn: the union of the agent's
%% questions and the asks its goals send, as the canonical compilation emits
%% them into currency/coins_agent.glp.  Drawn is the type its person channel carries, the
%% values the dispatcher draws under the functors of the asks and the grants'
%% raw inputs (vGLP, Definition "Construct Process"); the person channel's
%% types are the root's (programs/self.glp).  The compiled module's own
%% definitions shadow these within it, and the two must agree.
%% =============================================================================

Question ::= approval_w(Approval) ; stream_request_r(Stream(Request)?).
Drawn ::= approval_w(_) ; stream_request_r(_) ; output(List(Output)) ; YesNo ; Request.
Ask(Q)   ::= ask(Constant, Q).

%% What the person sees on the mini-app's person channel: the constructs the
%% dispatcher draws and withdraws, draw(Id, W, V) and withdraw(Id), each a
%% term of any type the bridge would render, and the screen the agent writes,
%% which the dispatcher draws as the thread of construct 0.  The person
%% channel never ends, and neither do the events.
Event ::= draw(Integer, _, _)
        ; withdraw(_)
        ; msg(Constant, Constant, ScreenContent).
Events ::= [Event | Events].

%% A person's script (currency/person.glp): its acts, in order.  A step is a
%% request, granted on the agent's request form; an acceptance of a swap the
%% named party proposes, granted on its approval question; or a wait for a screen message.
Step ::= mint(Integer)
       ; swap(Key, Key, Integer, Key, Integer)
       ; pay(Key, Integer)
       ; redeem(Key, Key)
       ; accept(Key)
       ; await(ScreenContent).
Script ::= [] ; [Step | Script].

%% =============================================================================
%% Holdings
%% =============================================================================

%% K fresh coins of Issuer, serials from Serial up.
procedure create_coins(Key?, Integer?, Integer?, Stream(Coin)).
create_coins(Issuer, K, Serial, [coin(Issuer?, Serial?)|Rest?]) :-
    K? > 0 |
    K1 := K? - 1,
    S1 := Serial? + 1,
    create_coins(Issuer?, K1?, S1?, Rest).
create_coins(_, 0, _, []).

procedure append_coins(Stream(Coin)?, Stream(Coin)?, Stream(Coin)).
append_coins([C|Cs], Ys, [C?|Zs?]) :- append_coins(Cs?, Ys?, Zs).
append_coins([], Ys, Ys?).

%% K coins of Issuer out of the holdings: ok, with the coins and the rest; or
%% fail --- the precondition cent^k_u in c_p of Definition 3.1 does not hold ---
%% with the coins found and the rest, which the caller puts back together.
procedure select_coins(Key?, Integer?, Stream(Coin)?, Status, Stream(Coin), Stream(Coin)).
select_coins(_, 0, Hs, ok, [], Hs?).
select_coins(Issuer, K, [coin(I, S)|Rest], Status?, [coin(I?, S?)|Sel?], Rem?) :-
    K? > 0, Issuer? =?= I? |
    K1 := K? - 1,
    select_coins(Issuer?, K1?, Rest?, Status, Sel, Rem).
select_coins(Issuer, K, [C|Rest], Status?, Sel?, [C?|Rem?]) :-
    otherwise |
    select_coins(Issuer?, K?, Rest?, Status, Sel, Rem).
select_coins(_, K, [], fail, [], []) :- K? > 0 | true.

%% One coin of Issuer out of the holdings, or not_found with the holdings intact.
procedure take_coin(Key?, Stream(Coin)?, Found, Stream(Coin)).
take_coin(Issuer, [coin(I, S)|Rest], found(coin(I?, S?)), Rest?) :-
    Issuer? =?= I? | true.
take_coin(Issuer, [C|Rest], Found?, [C?|Rem?]) :-
    otherwise |
    take_coin(Issuer?, Rest?, Found, Rem).
take_coin(_, [], not_found, []).

%% Whether every coin is the issuer's own.
procedure own_coins(Key?, Stream(Coin)?, Decision).
own_coins(Id, [coin(I, _)|Rest], R?) :- Id? =?= I? | own_coins(Id?, Rest?, R).
own_coins(_, [coin(_, _)|_], no) :- otherwise | true.
own_coins(_, [], yes).

procedure count_coins(Stream(Coin)?, Integer?, Integer).
count_coins([_|Cs], N, M?) :- N1 := N? + 1, count_coins(Cs?, N1?, M).
count_coins([], N, N?).

%% The holdings tallied by issuer, in order of first appearance.
procedure tally(Stream(Coin)?, Stream(Lot)?, Stream(Lot)).
tally([coin(I, _)|Rest], Acc, Lots?) :-
    ground(I?) |
    tally_add(I?, Acc?, Acc1),
    tally(Rest?, Acc1?, Lots).
tally([], Acc, Acc?).

procedure tally_add(Key?, Stream(Lot)?, Stream(Lot)).
tally_add(I, [lot(I2, N)|Rest], [lot(I2?, N1?)|Rest?]) :- I? =?= I2? | N1 := N? + 1.
tally_add(I, [L|Rest], [L?|Rest1?]) :- otherwise | tally_add(I?, Rest?, Rest1).
tally_add(I, [], [lot(I?, 1)]).

%% The issuers of the coins held, one each, the holder's own apart: what an
%% issuer discloses to a bearer whose presentation it cannot fulfil as named.
procedure menu_of(Key?, Stream(Coin)?, Stream(Key)?, Stream(Key)).
menu_of(Id, [coin(I, _)|Rest], Acc, Menu?) :-
    Id? =?= I? |
    menu_of(Id?, Rest?, Acc?, Menu).
menu_of(Id, [coin(I, _)|Rest], Acc, Menu?) :-
    otherwise |
    menu_add(I?, Acc?, Acc1),
    menu_of(Id?, Rest?, Acc1?, Menu).
menu_of(_, [], Acc, Acc?).

procedure menu_add(Key?, Stream(Key)?, Stream(Key)).
menu_add(I, [I2|Rest], [I2?|Rest?]) :- I? =?= I2? | true.
menu_add(I, [J|Rest], [J?|Rest1?]) :- otherwise | menu_add(I?, Rest?, Rest1).
menu_add(I, [], [I?]).

%% =============================================================================
%% Conversations with counterparties
%% =============================================================================

%% Whether a conversation with Q is open: Q's output entry is among the outputs.
procedure has_peer(Key?, Stream(OutputEntry)?, Stream(OutputEntry), Decision).
has_peer(Q, [friend_output(K, Out?)|Rest], [friend_output(K?, Out)|Rest?], yes) :-
    Q? =?= K? | true.
has_peer(Q, [E|Rest], [E?|Rest1?], Known?) :-
    otherwise |
    has_peer(Q?, Rest?, Rest1, Known).
has_peer(_, [], [], no).

%% Adopt the channel of a conversation with Q: its write side becomes Q's
%% output entry and its read side joins the input from counterparties.
procedure adopt(Key?, RootChannel(PeerMsg)?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(PeerMsg)?, Stream(PeerMsg)).
adopt(Q, ch(In, Out?), Outs, Outs1?, PeerIn, PeerIn1?) :-
    ground(Q?) |
    add_friend_output(Q?, Out, Outs?, Outs1),
    merge(PeerIn?, In?, PeerIn1).

%% =============================================================================
%% Results injected into the agent's input
%% =============================================================================

%% The counterparty's answer to a proposed swap, when it comes.
procedure inject_swap_result(SwapResponse?, Key?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_swap_result(swap_accept(Coins), Q, Ys, [swap_accepted(Q?, Coins?)|Ys?]) :-
    ground(Q?), ground(Coins?) | true.
inject_swap_result(swap_decline(Coins), Q, Ys, [swap_declined_by(Q?, Coins?)|Ys?]) :-
    ground(Q?), ground(Coins?) | true.
inject_swap_result(R, Q, [Y|Ys], [Y?|Ys1?]) :-
    inject_swap_result(R?, Q?, Ys?, Ys1).

%% The issuer's answer to a presentation, when it comes.
procedure inject_redeem_result(RedeemResponse?, Key?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_redeem_result(redeem_give(C), Q, Ys, [redeem_given(Q?, C?)|Ys?]) :-
    ground(Q?), ground(C?) | true.
inject_redeem_result(redeem_menu(C, Issuers), Q, Ys, [redeem_menu_from(Q?, C?, Issuers?)|Ys?]) :-
    ground(Q?), ground(C?), ground(Issuers?) | true.
inject_redeem_result(redeem_declined(C), Q, Ys, [redeem_declined_by(Q?, C?)|Ys?]) :-
    ground(Q?), ground(C?) | true.
inject_redeem_result(R, Q, [Y|Ys], [Y?|Ys1?]) :-
    inject_redeem_result(R?, Q?, Ys?, Ys1).

%% The bodies of the swap responder's two answers (decide_swap): the
%% acceptance, on yes, and the decline, on no.  Each hands the agent the offer
%% with the response writer.
procedure accept_answer(Key?, Lot?, Stream(Coin)?, SwapResponse, Stream(UserInMsg)).
accept_answer(From, Want, Offered, Resp?, [accept_swap(From?, Want?, Offered?, Resp)]).

procedure decline_answer(Key?, Stream(Coin)?, SwapResponse, Stream(UserInMsg)).
decline_answer(From, Offered, Resp?, [decline_swap(From?, Offered?, Resp)]).

%% Binding a declined swap's response: the offered coins go back.
procedure decline(SwapResponse, Stream(Coin)?).
decline(swap_decline(Coins?), Coins).

%% =============================================================================
%% The screen, and the outputs
%% =============================================================================

procedure show(ScreenContent?, Stream(OutputEntry)?, Stream(OutputEntry)).
show(C, Outs, Outs1?) :- send_user(msg(agent, person, C?), Outs?, Outs1).

procedure close_outputs(Stream(OutputEntry)?).
close_outputs([user_output([])|Outs]) :- close_outputs(Outs?).
close_outputs([friend_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([]).

%% =============================================================================
%% Entry point: the village market of Appendix C.2 of the paper
%% =============================================================================

imported procedure village#market.
exported procedure village.
village :- village # market.

%% =============================================================================
%% Entry point: the mini-app on a live person's screen (play_ui.glp), the
%% entry the Dart bridge runs: its arguments are the agent's identifier, the
%% person's grants and the network input.
%% =============================================================================

imported procedure play_ui#coins_ui(Key?, PersonIn(Drawn)?, Stream(_)?).
exported procedure coins_ui(Key?, PersonIn(Drawn)?, Stream(_)?).
coins_ui(Id, Grants, NetIn) :- play_ui # coins_ui(Id?, Grants?, NetIn?).

%% =============================================================================
%% Entry point: the village market with one villager's events on the user's
%% stream as well (village.glp, market_ui/1), a play a test runs: the six
%% balances views of the paper's Appendix C.2 are drawn from it, one villager
%% per run, by the app's interface code.  The host posts superapp/3 and nothing
%% of this program (GSG Section 5.1), so this is no host entry: the villager's
%% constructs are answered by its scripted person, as in village/0.
%% =============================================================================

imported procedure village#market_ui(Key?).
exported procedure market_ui(Key?).
market_ui(Id) :- village # market_ui(Id?).
