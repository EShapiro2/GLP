%% currency/self.glp --- the coins program as a certified program of its own:
%% the currency agent (coins_agent.vglp, its compilation coins_agent.glp), the
%% mini-app entry coins/3 and the super-app's entry template's instance
%% miniapp/4 (miniapp.glp), a scripted person (person.glp) and the
%% plays that activate the mini-app by run/3 (plays.glp); the types and the
%% helpers are the parent's (../self.glp, an ancestor scope).  It is a program
%% of its own because the certificate of a program is refused where any entry
%% point reaches the person or the network, and the parent's village play does
%% (send_to_user/1): loaded here, without it, the program is certified, and its
%% module value is the mini-app the super-app installs and activates by run/3.
%% The parent's plays (../village.glp, ../play_ui.glp) call coins/3 and the
%% scripted person/5 through this directory, which exports both (TGLP
%% modules.tex: a qualifier is a single child directory, entered through its
%% self.glp).

imported procedure miniapp#coins(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?).
exported procedure coins(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?).
coins(Id, Ui, Convs) :- miniapp # coins(Id?, Ui?, Convs?).

imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(PeerMsg)?, Stream(Integer)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(PeerMsg)?, Stream(Integer)?).
miniapp(Id, Ui, Sg, Cal) :- miniapp # miniapp(Id?, Ui?, Sg?, Cal?).

imported procedure person#person(Key?, _?, PersonIn(Drawn), Script?, Stream(ScreenContent)).
exported procedure person(Key?, _?, PersonIn(Drawn), Script?, Stream(ScreenContent)).
person(Id, Draws, Grants?, Script, Screen?) :- person # person(Id?, Draws?, Grants, Script?, Screen).

imported procedure plays#miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(ScreenContent)).
exported procedure miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(ScreenContent)).
miniapp_person(Id, Role, PEnd, Screen?) :- plays # miniapp_person(Id?, Role?, PEnd?, Screen).

imported procedure plays#play_mint(Stream(ScreenContent)).
exported procedure play_mint(Stream(ScreenContent)).
play_mint(S?) :- plays # play_mint(S).

imported procedure plays#play_swap(Stream(ScreenContent), Stream(ScreenContent)).
exported procedure play_swap(Stream(ScreenContent), Stream(ScreenContent)).
play_swap(A?, B?) :- plays # play_swap(A, B).

imported procedure plays#play_same(Stream(ScreenContent), Stream(ScreenContent)).
exported procedure play_same(Stream(ScreenContent), Stream(ScreenContent)).
play_same(A?, B?) :- plays # play_same(A, B).
