Question ::= approval_w(Approval) ; stream_request_r(Stream(Request)?).

procedure respond_swap(Offer?, SwapResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_swap(S1, S2?, S3?, [ask('Approval', approval_w(X?)) | D?]) :- respond_swap1(S1?, S2, S3, X, D).

procedure respond_swap1(Offer?, SwapResponse, Stream(UserInMsg), Approval, Stream(Ask(Question))).
respond_swap1(offer(From, Want, Offered), Resp?, Ans?, approval(offer(From?, Want?, Offered?), Answer), []) :- ground(From?), ground(Want?), ground(Offered?) | decide_swap(Answer?, From?, Want?, Offered?, Resp, Ans).

procedure decide_swap(YesNo?, Key?, Lot?, Stream(Coin)?, SwapResponse, Stream(UserInMsg)).
decide_swap(yes, From, Want, Offered, Resp?, Ans?) :- accept_answer(From?, Want?, Offered?, Resp, Ans).
decide_swap(no, From, _, Offered, Resp?, Ans?) :- decline_answer(From?, Offered?, Resp, Ans).

exported procedure agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
agent(S1, S2, S3, S4, S5, S6, S7, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- agent1(S1?, S2?, S3?, S4?, S5?, S6?, S7?, X?, D).

exported procedure agent1(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Request)?, Stream(Ask(Question))).
agent1(Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, Reqs, D?) :- serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).

procedure serve(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
serve(Reqs, Id, UserIn, [msg(From, Id1, Act) | PeerIn], Convs, Outs, Holdings, Serial, D?) :- (Id? =?= Id1?), ground(From?) | on_act(Act?, From?, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve(Reqs, Id, UserIn, [_ | PeerIn], Convs, Outs, Holdings, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve(Reqs, Id, UserIn, PeerIn, [conversation(Q, Ch) | Convs], Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?) | adopt(Q?, Ch?, Outs?, Outs1, PeerIn?, PeerIn1), show(opened(Q?), Outs1?, Outs2), serve(Reqs?, Id?, UserIn?, PeerIn1?, Convs?, Outs2?, Holdings?, Serial?, D).
serve(Reqs, Id, [accept_swap(From, lot(V, K), Offered, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(From?), ground(V?), integer(K?) | select_coins(V?, K?, Holdings?, Status, Give, Rest), fill_swap(Status?, Id?, From?, Resp, Give?, Offered?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve(Reqs, Id, [decline_swap(From, Offered, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(From?) | decline(Resp, Offered?), show(declined(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).
serve(Reqs, Id, [swap_accepted(Q, Coins) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), show(swap_done(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [swap_declined_by(Q, Coins) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), show(swap_declined(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_given(Q, coin(R, S)) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(R?), ground(S?) | append_coins(Holdings?, [coin(R?, S?)], Holdings1), show(redeemed(Q?, R?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_menu_from(Q, Coin, Issuers) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coin?), ground(Issuers?) | append_coins(Holdings?, [Coin?], Holdings1), show(menu(Q?, Issuers?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_declined_by(Q, Coin) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coin?) | append_coins(Holdings?, [Coin?], Holdings1), show(refused(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [_ | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve([mint(Amount) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), integer(Amount?), (Amount? >= 1) | create_coins(Id?, Amount?, Serial?, New), Serial1 := (Serial? + Amount?), append_coins(Holdings?, New?, Holdings1), show(minted(Amount?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial1?, D).
serve([swap(Friend, GiveCoin, GiveAmount, WantCoin, WantAmount) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), ground(GiveCoin?), integer(GiveAmount?), (GiveAmount? >= 1), ground(WantCoin?), integer(WantAmount?), (WantAmount? >= 1), (lot(GiveCoin?, GiveAmount?) =?\= lot(WantCoin?, WantAmount?)) | select_coins(GiveCoin?, GiveAmount?, Holdings?, Status, Give, Rest), propose_swap(Status?, Id?, Friend?, lot(GiveCoin?, GiveAmount?), lot(WantCoin?, WantAmount?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve([swap(Friend, GiveCoin, GiveAmount, WantCoin, WantAmount) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), ground(GiveCoin?), integer(GiveAmount?), (GiveAmount? >= 1), ground(WantCoin?), integer(WantAmount?), (WantAmount? >= 1), (lot(GiveCoin?, GiveAmount?) =?= lot(WantCoin?, WantAmount?)) | show(swap_same(Friend?, GiveCoin?, GiveAmount?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).
serve([pay(Friend, Amount) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), integer(Amount?), (Amount? >= 1) | select_coins(Friend?, Amount?, Holdings?, Status, Give, Rest), do_pay(Status?, Id?, Friend?, Amount?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve([redeem(Friend, WantCoin) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), ground(WantCoin?), (Friend? =?\= WantCoin?) | take_coin(Friend?, Holdings?, Found, Rest), do_redeem(Found?, Id?, Friend?, WantCoin?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve([redeem(Friend, WantCoin) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), ground(WantCoin?), (Friend? =?= WantCoin?) | show(redeem_same(Friend?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure on_act(PeerContent?, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
on_act(pay(Coins), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | own_coins(Id?, Coins?, Own), take_payment(Own?, Id?, From?, Coins?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
on_act(redeem(Coin, R, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coin?), ground(R?) | fulfil(Coin?, R?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
on_act(swap(Want, Offered, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Want?), ground(Offered?) | respond_swap(offer(From?, Want?, Offered?), Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D2), merge(D1?, D2?, D).
on_act(return(Coins), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), count_coins(Coins?, 0, K), show(returned(From?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).

procedure take_payment(Decision?, Key?, Key?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
take_payment(yes, Id, From, Coins, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), count_coins(Coins?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
take_payment(no, Id, From, Coins, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- send_friend(From?, msg(Id?, From?, return(Coins?)), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure fulfil(Coin?, Key?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
fulfil(coin(I, S), R, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- (I? =?= Id?) | take_coin(R?, Holdings?, Found, Rest), give(Found?, coin(I?, S?), R?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Rest?, Serial?, D).
fulfil(coin(I, S), _, redeem_declined(coin(I?, S?)), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- otherwise | show(refused(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure give(Found?, Coin?, Key?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
give(found(C), Mine, R, redeem_give(C?), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Rest, Serial, D?) :- append_coins(Rest?, [Mine?], Holdings1), show(presented(From?, R?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
give(not_found, Mine, R, redeem_menu(Mine?, Menu?), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Rest, Serial, D?) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).

procedure fill_swap(Status?, Key?, Key?, SwapResponse, Stream(Coin)?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
fill_swap(ok, Id, From, swap_accept(Give?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
fill_swap(fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure propose_swap(Status?, Key?, Key?, Lot?, Lot?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
propose_swap(ok, Id, Q, _, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?), ground(Want?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_swap(Known?, Id?, Q?, Want?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
propose_swap(fail, Id, _, lot(U, K), _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(lacking(U?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure send_swap(Decision?, Key?, Key?, Lot?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_swap(yes, Id, Q, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).
send_swap(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure do_pay(Status?, Key?, Key?, Integer?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
do_pay(ok, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Known?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
do_pay(fail, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(lacking(Q?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure send_pay(Decision?, Key?, Key?, Integer?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_pay(yes, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, pay(Give?)), Outs?, Outs1), show(paid(Q?, K?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs2?, Rest?, Serial?, D).
send_pay(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure do_redeem(Found?, Key?, Key?, Key?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
do_redeem(found(C), Id, Q, R, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_redeem(Known?, Id?, Q?, R?, C?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
do_redeem(not_found, Id, Q, _, Holdings, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- show(lacking(Q?, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure send_redeem(Decision?, Key?, Key?, Key?, Coin?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_redeem(yes, Id, Q, R, C, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, redeem(C?, R?, Resp)), Outs?, Outs1), inject_redeem_result(Resp?, Q?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).
send_redeem(no, Id, Q, _, C, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Rest?, [C?], Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure after_change(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
after_change(Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).
Event(Q, T) ::= Ask(Q) ; Input(T) ; Draw(T).
Events(Q, T) ::= [Event(Q, T) | Events(Q, T)].
Turn ::= ask ; grant ; draw.
Questioned(S) ::= S ; input(Path).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(Input(T)), Stream(Draw(T))), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), fair(ask, Asks?, Inputs?, COut?, Es), serve_1(Es?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(Input(T)), Stream(Draw(T))?, Inputs(T), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, G0s?, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), fair(ask, Asks?, Inputs?, COut?, Es), serve_1(Es?, COut, DOut, [route(0, G0s)], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(Input(T))).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([refresh | Gs], [refresh | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) fair(Turn?, Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Events(Q, T)).
fair(ask, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(grant, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(draw, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(ask, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(grant, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(draw, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(ask, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(grant, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(draw, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).

procedure(Q, T) serve_1(Events(Q, T)?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve_1([ask(_, Q) | Es], CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Es?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1([input(Id, P, R) | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(input(Id?, P?, R?), Rs?, Rs1), serve_1(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1([refresh | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- refresh_routes(Rs?, Rs1), serve_1(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1([draw(Id, W, V) | Es], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Es?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1([withdraw(Id) | Es], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Es?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) refresh_routes(Routes(T)?, Routes(T)).
refresh_routes([route(Id, [refresh | Gs1?]) | Rs], [route(Id?, Gs1) | Rs1?]) :- refresh_routes(Rs?, Rs1).
refresh_routes([], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure(T) form_string(T?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure(T) form_integer(T?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= approval_w(_) ; stream_request_r(_) ; output(List(Output)) ; YesNo ; Request.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, G0s, Ss), output(thread(menu([form(holdings, [field('Holdings', thread(form(lot, [field('Issuer', shown), field('Amount', shown)])))]), form(opened, [field('Friend', shown)]), form(minted, [field('Amount', shown)]), form(paid, [field('Friend', shown), field('Amount', shown)]), form(received, [field('From', shown), field('Amount', shown)]), form(returned, [field('From', shown), field('Amount', shown)]), form(swap_done, [field('Friend', shown)]), form(swap_declined, [field('Friend', shown)]), form(swap_failed, [field('From', shown)]), form(declined, [field('From', shown)]), form(swap_same, [field('Friend', shown), field('GiveCoin', shown), field('GiveAmount', shown)]), form(redeemed, [field('Friend', shown), field('WantCoin', shown)]), form(menu, [field('Friend', shown), field('Issuers', thread)]), form(presented, [field('From', shown), field('WantCoin', shown)]), form(unfulfilled, [field('From', shown), field('WantCoin', shown)]), form(refused, [field('Friend', shown)]), form(redeem_same, [field('Friend', shown)]), form(lacking, [field('Issuer', shown), field('Amount', shown)]), form(no_conversation, [field('Friend', shown)])])), MOut?, G0s?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, approval_w(X), Gs, Ds?) :- present_approval([], X?, Gs1?, _, Vs, Done), run_approval_w(Id?, form(approval, [field('Offer', form(offer, [field('From', shown), field('Want', form(lot, [field('Issuer', shown), field('Amount', shown)])), field('Offered', thread(form(coin, [field('Issuer', shown), field('Serial', shown)])))])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Gs?, Gs1, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs1?, _, Done), run_stream_request_r(Id?, input_box(menu([form(mint, [field('Amount', number)]), form(swap, [field('Friend', peer), field('GiveCoin', peer), field('GiveAmount', number), field('WantCoin', peer), field('WantAmount', number)]), form(pay, [field('Friend', peer), field('Amount', number)]), form(redeem, [field('Friend', peer), field('WantCoin', peer)])])), [input([])], Done?, Gs?, Gs1, Ds).

procedure output(Widget?, Stream(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output(W, Ms, Gs, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Gs?, Ds).

procedure output_more(Widget?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Gs, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Gs?, Ds).
output_more(W, Ms, Es, [refresh | Gs], Ds?) :- output_draw(W?, Ms?, Es?, Gs?, Ds).
output_more(W, Ms, Es, [input(_, _, _) | Gs], Ds?) :- output_more(W?, Ms?, Es?, Gs?, Ds).
output_more(W, [], Es, Gs, Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_draw(Widget?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, Gs, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Gs?, Ds).

procedure output_end(Widget?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_end(W, Es, [refresh | Gs], [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_end(W?, Es?, Gs?, Ds).
output_end(W, Es, [input(_, _, _) | Gs], Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure form_yesNo(Drawn?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

View_approval ::= approval(Offer, Questioned(YesNo)).
procedure present_approval(Path?, Approval?, Inputs(Drawn)?, Inputs(Drawn), Stream(View_approval), Done).
present_approval(P, approval(H1, H2?), Gs, Gs1?, [approval(H1?, input(M2?))], D2?) :- ground(P?), ground(H1?) | path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2).

procedure run_approval_w(Integer?, Widget?, Stream(View_approval)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_approval_w(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_approval_w_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_approval_w_more(Integer?, Widget?, View_approval?, Stream(View_approval)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_approval_w_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_approval_w_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_approval_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_approval_w_last(Integer?, Widget?, View_approval?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_approval_w_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_approval_w_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_approval_w_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_approval_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_approval_w_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_approval_w_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_approval_w_grants(Gs?, Gs1).
run_approval_w_grants([refresh | Gs], Gs1?) :- run_approval_w_grants(Gs?, Gs1).

procedure join_request_mint_1(Formed(Amount)?, Formed(Request)).
join_request_mint_1(formed(X1), formed(mint(X1?))).
join_request_mint_1(refused, refused).

procedure join_request_swap_5(Formed(Friend)?, Formed(GiveCoin)?, Formed(GiveAmount)?, Formed(WantCoin)?, Formed(WantAmount)?, Formed(Request)).
join_request_swap_5(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(swap(X1?, X2?, X3?, X4?, X5?))).
join_request_swap_5(refused, _, _, _, _, refused).
join_request_swap_5(_, refused, _, _, _, refused).
join_request_swap_5(_, _, refused, _, _, refused).
join_request_swap_5(_, _, _, refused, _, refused).
join_request_swap_5(_, _, _, _, refused, refused).

procedure join_request_pay_2(Formed(Friend)?, Formed(Amount)?, Formed(Request)).
join_request_pay_2(formed(X1), formed(X2), formed(pay(X1?, X2?))).
join_request_pay_2(refused, _, refused).
join_request_pay_2(_, refused, refused).

procedure join_request_redeem_2(Formed(Friend)?, Formed(WantCoin)?, Formed(Request)).
join_request_redeem_2(formed(X1), formed(X2), formed(redeem(X1?, X2?))).
join_request_redeem_2(refused, _, refused).
join_request_redeem_2(_, refused, refused).

procedure form_request(Drawn?, Formed(Request)).
form_request(mint(R1), F?) :- form_integer(R1?, F1), join_request_mint_1(F1?, F).
form_request(swap(R1, R2, R3, R4, R5), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_integer(R3?, F3), form_string(R4?, F4), form_integer(R5?, F5), join_request_swap_5(F1?, F2?, F3?, F4?, F5?, F).
form_request(pay(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_request_pay_2(F1?, F2?, F).
form_request(redeem(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_request_redeem_2(F1?, F2?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs(Drawn)?, Inputs(Drawn), Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

View_stream_request_r ::= Stream(Request) ; input(Path).
procedure run_stream_request_r(Integer?, Widget?, Stream(View_stream_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_stream_request_r_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_stream_request_r_more(Integer?, Widget?, View_stream_request_r?, Stream(View_stream_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_stream_request_r_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_stream_request_r_last(Integer?, Widget?, View_stream_request_r?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_stream_request_r_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_stream_request_r_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_stream_request_r_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_stream_request_r_grants(Gs?, Gs1).
run_stream_request_r_grants([refresh | Gs], Gs1?) :- run_stream_request_r_grants(Gs?, Gs1).

