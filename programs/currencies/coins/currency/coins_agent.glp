%% Compiled from vGLP by the canonical compilation
%% (vGLP, Definition "Canonical Compilation").  Do not edit: edit
%% the .vglp source and compile again.


Question ::= card_w(Card) ; stream_request_r(Stream(Request)?).

procedure respond_swap(Offer?, SwapResponse, Stream(UserInMsg), Stream(Ask(Question))).
respond_swap(S1, S2?, S3?, [ask('Card', card_w(X?)) | D?]) :- respond_swap1(S1?, S2, S3, X, D).

procedure respond_swap1(Offer?, SwapResponse, Stream(UserInMsg), Card, Stream(Ask(Question))).
respond_swap1(offer(From, Want, Offered), Resp?, Ans?, card(offer(From?, Want?, Offered?), Answer), []) :- ground(From?), ground(Want?), ground(Offered?) | decide_swap(Answer?, From?, Want?, Offered?, Resp, Ans).

procedure decide_swap(YesNo?, Key?, Lot?, Stream(Coin)?, SwapResponse, Stream(UserInMsg)).
decide_swap(yes, From, Want, Offered, Resp?, Ans?) :- accept_answer(From?, Want?, Offered?, Resp, Ans).
decide_swap(no, From, _, Offered, Resp?, Ans?) :- decline_answer(From?, Offered?, Resp, Ans).

exported procedure agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
agent(S1, S2, S3, S4, S5, S6, S7, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- agent1(S1?, S2?, S3?, S4?, S5?, S6?, S7?, X?, D).

exported procedure agent1(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Request)?, Stream(Ask(Question))).
agent1(Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, Reqs, D?) :- serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).

procedure serve(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
serve(Reqs, Id, UserIn, [msg(From, Id1, Act) | PeerIn], Convs, Outs, Holdings, Serial, D?) :- (Id? =?= Id1?), ground(From?) | on_act(Act?, From?, Id?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve(Reqs, Id, UserIn, [_ | PeerIn], Convs, Outs, Holdings, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve(Reqs, Id, UserIn, PeerIn, [conversation(Q, Ch) | Convs], Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?) | adopt(Q?, Ch?, Outs?, Outs1, PeerIn?, PeerIn1), show(opened(Q?), Outs1?, Outs2), serve(Reqs?, Id?, UserIn?, PeerIn1?, Convs?, Outs2?, Holdings?, Serial?, D).
serve(Reqs, Id, [accept_swap(From, lot(V, K), Offered, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(From?), ground(V?), integer(K?) | select_coins(V?, K?, Holdings?, Status, Give, Rest), fill_swap(Status?, Id?, From?, Resp, Give?, Offered?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve(Reqs, Id, [decline_swap(From, Offered, Resp?) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(From?) | decline(Resp, Offered?), show(declined(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).
serve(Reqs, Id, [swap_accepted(Q, Coins) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), show(swap_done(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [swap_declined_by(Q, Coins) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), show(swap_declined(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_given(Q, coin(R, S)) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(R?), ground(S?) | append_coins(Holdings?, [coin(R?, S?)], Holdings1), show(redeemed(Q?, R?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_menu_from(Q, Coin, Issuers) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coin?), ground(Issuers?) | append_coins(Holdings?, [Coin?], Holdings1), show(menu(Q?, Issuers?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [redeem_declined_by(Q, Coin) | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Q?), ground(Coin?) | append_coins(Holdings?, [Coin?], Holdings1), show(refused(Q?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
serve(Reqs, Id, [_ | UserIn], PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
serve([mint(Amount) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), integer(Amount?), (Amount? >= 1) | create_coins(Id?, Amount?, Serial?, New), Serial1 := (Serial? + Amount?), append_coins(Holdings?, New?, Holdings1), show(minted(Amount?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial1?, D).
serve([swap(Friend, lot(GiveCoin, GiveAmount), lot(WantCoin, WantAmount)) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), ground(GiveCoin?), integer(GiveAmount?), (GiveAmount? >= 1), ground(WantCoin?), integer(WantAmount?), (WantAmount? >= 1) | select_coins(GiveCoin?, GiveAmount?, Holdings?, Status, Give, Rest), propose_swap(Status?, Id?, Friend?, lot(GiveCoin?, GiveAmount?), lot(WantCoin?, WantAmount?), Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve([pay(Friend, Amount) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), integer(Amount?), (Amount? >= 1) | select_coins(Friend?, Amount?, Holdings?, Status, Give, Rest), do_pay(Status?, Id?, Friend?, Amount?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).
serve([redeem(Friend, WantCoin) | Reqs], Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Id?), ground(Friend?), ground(WantCoin?) | take_coin(Friend?, Holdings?, Found, Rest), do_redeem(Found?, Id?, Friend?, WantCoin?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Serial?, D).

procedure on_act(PeerContent?, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
on_act(pay(Coins), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | own_coins(Id?, Coins?, Own), take_payment(Own?, Id?, From?, Coins?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
on_act(redeem(Coin, R, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coin?), ground(R?) | fulfil(Coin?, R?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D).
on_act(swap(Want, Offered, Resp?), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Want?), ground(Offered?) | respond_swap(offer(From?, Want?, Offered?), Resp, Ans, D1), merge(Ans?, UserIn?, UserIn1), serve(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs?, Holdings?, Serial?, D2), merge(D1?, D2?, D).
on_act(return(Coins), From, Id, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), count_coins(Coins?, 0, K), show(returned(From?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).

procedure take_payment(Decision?, Key?, Key?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
take_payment(yes, Id, From, Coins, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Coins?) | append_coins(Holdings?, Coins?, Holdings1), count_coins(Coins?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
take_payment(no, Id, From, Coins, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- send_friend(From?, msg(Id?, From?, return(Coins?)), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure fulfil(Coin?, Key?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
fulfil(coin(I, S), R, Resp?, Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- (I? =?= Id?) | take_coin(R?, Holdings?, Found, Rest), give(Found?, coin(I?, S?), R?, Resp, Id?, From?, Reqs?, UserIn?, PeerIn?, Convs?, Outs?, Rest?, Serial?, D).
fulfil(coin(I, S), _, redeem_declined(coin(I?, S?)), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- otherwise | show(refused(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure give(Found?, Coin?, Key?, RedeemResponse, Key?, Key?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
give(found(C), Mine, R, redeem_give(C?), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Rest, Serial, D?) :- append_coins(Rest?, [Mine?], Holdings1), show(presented(From?, R?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
give(not_found, Mine, R, redeem_menu(Mine?, Menu?), Id, From, Reqs, UserIn, PeerIn, Convs, Outs, Rest, Serial, D?) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).

procedure fill_swap(Status?, Key?, Key?, SwapResponse, Stream(Coin)?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
fill_swap(ok, Id, From, swap_accept(Give?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs?, Outs1), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings1?, Serial?, D).
fill_swap(fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure propose_swap(Status?, Key?, Key?, Lot?, Lot?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
propose_swap(ok, Id, Q, _, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?), ground(Want?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_swap(Known?, Id?, Q?, Want?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
propose_swap(fail, Id, _, lot(U, K), _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(lacking(U?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure send_swap(Decision?, Key?, Key?, Lot?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_swap(yes, Id, Q, Want, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).
send_swap(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure do_pay(Status?, Key?, Key?, Integer?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
do_pay(ok, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Known?, Id?, Q?, K?, Give?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
do_pay(fail, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(lacking(Q?, K?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure send_pay(Decision?, Key?, Key?, Integer?, Stream(Coin)?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_pay(yes, Id, Q, K, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, pay(Give?)), Outs?, Outs1), show(paid(Q?, K?), Outs1?, Outs2), after_change(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs2?, Rest?, Serial?, D).
send_pay(no, Id, Q, _, Give, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure do_redeem(Found?, Key?, Key?, Key?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
do_redeem(found(C), Id, Q, R, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_redeem(Known?, Id?, Q?, R?, C?, Rest?, Reqs?, UserIn?, PeerIn?, Convs?, Outs1?, Serial?, D).
do_redeem(not_found, Id, Q, _, Holdings, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- show(lacking(Q?, 1), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

procedure send_redeem(Decision?, Key?, Key?, Key?, Coin?, Stream(Coin)?, Stream(Request)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Integer?, Stream(Ask(Question))).
send_redeem(yes, Id, Q, R, C, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, redeem(C?, R?, Resp)), Outs?, Outs1), inject_redeem_result(Resp?, Q?, UserIn?, UserIn1), after_change(Reqs?, Id?, UserIn1?, PeerIn?, Convs?, Outs1?, Rest?, Serial?, D).
send_redeem(no, Id, Q, _, C, Rest, Reqs, UserIn, PeerIn, Convs, Outs, Serial, D?) :- append_coins(Rest?, [C?], Orig), show(no_conversation(Q?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Orig?, Serial?, D).

procedure after_change(Stream(Request)?, Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
after_change(Reqs, Id, UserIn, PeerIn, Convs, Outs, Holdings, Serial, D?) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), serve(Reqs?, Id?, UserIn?, PeerIn?, Convs?, Outs1?, Holdings?, Serial?, D).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Draw ::= draw(Integer, _, _) ; withdraw(Integer).
PersonIn ::= [_ | PersonIn].
Input ::= input(_, _, _).
Path ::= [] ; [Integer | Path].
Inputs ::= [Input | Inputs].
Route ::= route(Integer, Inputs?).
Routes ::= [] ; [Route | Routes].
Deads ::= [] ; [Inputs? | Deads].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q) ::= spawn(Integer, Q, Inputs, Stream(Draw)?).

procedure(Q) dispatch(Stream(Ask(Q))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, MOut), Ss?) :- split_grants(PIn?, Inputs, MIn), merge(MOut?, DOut?, POut), serve_1(Asks?, Inputs?, COut?, COut, DOut, [], [], 0, Ss).

procedure split_grants(PersonIn?, Inputs, Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([G | Gs], Is?, [G? | Ms?]) :- otherwise | split_grants(Gs?, Is, Ms).

procedure(Q) serve_1(Stream(Ask(Q))?, Inputs?, Stream(Draw)?, Stream(Draw), Stream(_), Routes?, Deads?, Integer?, Stream(Spawn(Q))).
serve_1([ask(_, Q) | Asks], Is, COut, CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Asks?, Is?, COut?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1(Asks, [G | Is], COut, CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(G?, Rs?, Rs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1(Asks, Is, [draw(Id, W, V) | COut], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Asks?, Is?, COut?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1(Asks, Is, [withdraw(Id) | COut], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure route_grant(Input?, Routes?, Routes).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure remove_route(Integer?, Routes?, Routes, Deads?, Deads).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure run(Integer?, _?, Stream(_)?, Done?, Stream(Draw)).
run(Id, _, _, done, [withdraw(Id?)]).
run(Id, W, [V | Vs], Done, [draw(Id?, W?, V?) | Ds?]) :- ground(W?), ground(V?) | run(Id?, W?, Vs?, Done?, Ds).
run(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure run_end(Integer?, Done?, Stream(Draw)).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(Path?, _?, Stream(_)).
shown(_, X, [X?]) :- ground(X?) | true.
shown(P, X, [pending(P?) | Vs?]) :- shown_whole(X?, Vs).

procedure shown_whole(_?, Stream(_)).
shown_whole(X, [X?]) :- ground(X?) | true.

procedure thread(Path?, Stream(_)?, Stream(Stream(_))).
thread(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread(_, [], [[]]).
thread(P, Xs, [[] | Vs?]) :- thread_tail(P?, Xs?, Vs).

procedure thread_tail(Path?, Stream(_)?, Stream(Stream(_))).
thread_tail(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread_tail(_, [], []).

procedure thread_cell(Path?, _?, Stream(_)?, Stream(Stream(_))).
thread_cell(P, X, Xs, Vs?) :- ground(P?) | path(P?, 1, P1), path(P?, 2, P2), shown(P1?, X?, V1), thread(P2?, Xs?, V2), cons_views(V1?, V2?, Vs).

procedure cons_views(Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_views([E | Es], [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_views([], _, []).
cons_views(_, [], []).

procedure cons_more(_?, Stream(_)?, Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_more(_, T, [E | Es], Ts, [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(E, _, Es, [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(_, _, [], [], []).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

exported procedure dispatch(Stream(Ask(Question))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_))).
dispatch(Asks, PCh, MCh?) :- dispatch(Asks?, PCh?, MCh, Ss), constructs(Ss?).

procedure constructs(Stream(Spawn(Question))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs?, Stream(Draw)).
construct(Id, card_w(X), Gs, Ds?) :- present_card([], X?, Gs?, _, Vs, Done), run(Id?, form(card, [field('Offer', shown), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs?, _, Done), run(Id?, input_box(menu([form(mint, [field('Integer', number)]), form(swap, [field('Peer', peer), field('Lot', form(lot, [field('Key', peer), field('Integer', number)])), field('Lot', form(lot, [field('Key', peer), field('Integer', number)]))]), form(pay, [field('Peer', peer), field('Integer', number)]), form(redeem, [field('Peer', peer), field('Peer', peer)])])), [input([])], Done?, Ds).

procedure form_yesNo(_?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs?, Inputs, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input?, Inputs?, Inputs, Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

procedure start_card_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_card_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_card_card_2(V1?, V2?, S1?, S2?, Vs).
start_card_card_2([], _, []).
start_card_card_2(_, [], []).

procedure comb_card_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_card_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_card_card_2(V1?, V2?, S1?, S2?, Vs).
comb_card_card_2(_, _, [], [], []).

procedure present_card(Path?, Card?, Inputs?, Inputs, Stream(_), Done).
present_card(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_card_card_2(V1?, [input(M2?)], Vs).
present_card(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_card_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_card_wait(Path?, Card?, Inputs?, Inputs, Stream(_), Done).
present_card_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_card(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_card_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_card_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure join_request_mint_1(Formed(Integer)?, Formed(Request)).
join_request_mint_1(formed(X1), formed(mint(X1?))).
join_request_mint_1(refused, refused).

procedure join_lot_lot_2(Formed(Key)?, Formed(Integer)?, Formed(Lot)).
join_lot_lot_2(formed(X1), formed(X2), formed(lot(X1?, X2?))).
join_lot_lot_2(refused, _, refused).
join_lot_lot_2(_, refused, refused).

procedure form_lot(_?, Formed(Lot)).
form_lot(lot(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_lot_lot_2(F1?, F2?, F).
form_lot(_, refused) :- otherwise | true.

procedure join_request_swap_3(Formed(Peer)?, Formed(Lot)?, Formed(Lot)?, Formed(Request)).
join_request_swap_3(formed(X1), formed(X2), formed(X3), formed(swap(X1?, X2?, X3?))).
join_request_swap_3(refused, _, _, refused).
join_request_swap_3(_, refused, _, refused).
join_request_swap_3(_, _, refused, refused).

procedure join_request_pay_2(Formed(Peer)?, Formed(Integer)?, Formed(Request)).
join_request_pay_2(formed(X1), formed(X2), formed(pay(X1?, X2?))).
join_request_pay_2(refused, _, refused).
join_request_pay_2(_, refused, refused).

procedure join_request_redeem_2(Formed(Peer)?, Formed(Peer)?, Formed(Request)).
join_request_redeem_2(formed(X1), formed(X2), formed(redeem(X1?, X2?))).
join_request_redeem_2(refused, _, refused).
join_request_redeem_2(_, refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(mint(R1), F?) :- form_integer(R1?, F1), join_request_mint_1(F1?, F).
form_request(swap(R1, R2, R3), F?) :- form_string(R1?, F1), form_lot(R2?, F2), form_lot(R3?, F3), join_request_swap_3(F1?, F2?, F3?, F).
form_request(pay(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_request_pay_2(F1?, F2?, F).
form_request(redeem(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_request_redeem_2(F1?, F2?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs?, Inputs, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input?, Inputs?, Inputs, Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

