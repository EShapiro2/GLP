%% plays.glp --- the mini-app activated as the super-app activates it (SGSG
%% paper, Section 3): by run/3, under the type identity of its entry coins/3,
%% with exactly its two channels; and, for two executions, with the two ends
%% of one root channel handed to them as their conversation.  The certified
%% mini-app is this program, whose module value is the one the REPL can
%% obtain; the persons are scripted (person.glp), and each play returns their
%% screens.  A run does not end --- the agent's question, the stream of
%% requests, stays open, and the person channel never closes --- so a play's
%% result is read off a partial stream.

imported procedure person#person(Key?, _?, PersonIn(Drawn), Script?, Stream(ScreenContent)).

%% play_mint(Screen): alice, alone, mints 3.
%% Expected: Screen = [minted(3), holdings([lot(alice, 3)]) | _].
exported procedure play_mint(Stream(ScreenContent)).
play_mint(Screen?) :-
    self_module(M),
    find_type(coins/3, T),
    run(coins(alice, ch(Grants?, Draws), []), T?, M?),
    person # person(alice, Draws?, Grants, [mint(3)], Screen).

%% play_swap(ScreenA, ScreenB): alice and bob with one conversation between
%% their two executions; each mints 2, alice offers her 2 for bob's 2, and bob
%% accepts.
%% Expected: ScreenA = [opened(bob), minted(2), holdings([lot(alice, 2)]),
%%   holdings([]), swap_done(bob), holdings([lot(bob, 2)]) | _],
%%   ScreenB = [opened(alice), minted(2), holdings([lot(bob, 2)]),
%%   swap_done(alice), holdings([lot(alice, 2)]) | _].
exported procedure play_swap(Stream(ScreenContent), Stream(ScreenContent)).
play_swap(ScreenA?, ScreenB?) :-
    self_module(M),
    find_type(coins/3, T),
    run(coins(alice, ch(GrantsA?, DrawsA), [conversation(bob, ch(AB?, BA))]), T?, M?),
    person # person(alice, DrawsA?, GrantsA, [mint(2), swap(bob, alice, 2, bob, 2)], ScreenA),
    run(coins(bob, ch(GrantsB?, DrawsB), [conversation(alice, ch(BA?, AB))]), T?, M?),
    person # person(bob, DrawsB?, GrantsB, [mint(2), accept(alice)], ScreenB).

%% play_same(ScreenA, ScreenB): play_swap, after which alice holds bob's 2
%% coins and asks for two acts that change no state, each excluded by GC's
%% Definition 3.1: to redeem a bob-coin against a bob-coin (r != q), and to
%% swap her 2 bob-coins for 2 bob-coins (u != v or k != k').  Her agent
%% refuses each before anything is sent, the screen saying so, and her
%% holdings stay; bob's screen shows nothing of either.
%% Expected: ScreenA = [opened(bob), minted(2), holdings([lot(alice, 2)]),
%%   holdings([]), swap_done(bob), holdings([lot(bob, 2)]), redeem_same(bob),
%%   swap_same(bob, bob, 2) | _],
%%   ScreenB = [opened(alice), minted(2), holdings([lot(bob, 2)]),
%%   swap_done(alice), holdings([lot(alice, 2)]) | _].
exported procedure play_same(Stream(ScreenContent), Stream(ScreenContent)).
play_same(ScreenA?, ScreenB?) :-
    self_module(M),
    find_type(coins/3, T),
    run(coins(alice, ch(GrantsA?, DrawsA), [conversation(bob, ch(AB?, BA))]), T?, M?),
    person # person(alice, DrawsA?, GrantsA, [mint(2), swap(bob, alice, 2, bob, 2), redeem(bob, bob), swap(bob, bob, 2, bob, 2)], ScreenA),
    run(coins(bob, ch(GrantsB?, DrawsB), [conversation(alice, ch(BA?, AB))]), T?, M?),
    person # person(bob, DrawsB?, GrantsB, [mint(2), accept(alice)], ScreenB).

%% The scripted person the super-app's plays activate: the root's second
%% template miniapp_person/5 (programs/self.glp) at the mini-app's own Drawn,
%% what its dispatcher draws, and ScreenContent, the screen the person reports
%% (Currencies 2026-10-13 20:09 UTC, item 2, and 20:21 UTC, item 1; GSG
%% 2026-10-13 20:22 UTC, G; vGLP 2026-10-16 11:25 UTC, item 4).  The role
%% chooses the script, the person's acts on its end of the person channel,
%% each peer named by its key in the list of the keys the person knows, the
%% person's own key the first argument (alice knows bob, bob alice):
%%   alice  [mint(2), swap(bob, alice, 2, bob, 2)]
%%   bob    [mint(2), accept(alice)]
%% Any other role, or a person who knows other than the one key, has no
%% script: the person reports the screen and acts on nothing.
exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(ScreenContent)).
miniapp_person(Me, alice, [Bob], ch(Ds, Gs?), S?) :- ground(Me?), ground(Bob?) | person # person(Me?, Ds?, Gs, [await(opened(Bob?)), mint(2), swap(Bob?, Me?, 2, Bob?, 2)], S).
miniapp_person(Me, bob, [Alice], ch(Ds, Gs?), S?) :- person # person(Me?, Ds?, Gs, [await(opened(Alice?)), mint(2), accept(Alice?)], S).
%% The roles of the other plays, for their boots on smartphones (programs/currencies/coins_*_boot.glp; Currencies #15, Code_inbox 2026-11-05 07:26 UTC): same, alice's script of play_same, bob's being bob's above; ui_alice and ui_bob, the two of ../play_ui.glp, the live person's acts scripted as the harness describes them, her swap proposed and bob's reverse swap accepted.
miniapp_person(Me, same, [Bob], ch(Ds, Gs?), S?) :- ground(Me?), ground(Bob?) | person # person(Me?, Ds?, Gs, [await(opened(Bob?)), mint(2), swap(Bob?, Me?, 2, Bob?, 2), redeem(Bob?, Bob?), swap(Bob?, Bob?, 2, Bob?, 2)], S).
miniapp_person(Me, ui_alice, [Bob], ch(Ds, Gs?), S?) :- ground(Me?), ground(Bob?) | person # person(Me?, Ds?, Gs, [await(opened(Bob?)), mint(2), swap(Bob?, Me?, 2, Bob?, 2), accept(Bob?)], S).
miniapp_person(Me, ui_bob, [Alice], ch(Ds, Gs?), S?) :- ground(Me?), ground(Alice?) | person # person(Me?, Ds?, Gs, [await(opened(Alice?)), mint(2), accept(Alice?), swap(Alice?, Alice?, 2, Me?, 2)], S).
miniapp_person(Me, _, _, ch(Ds, Gs?), S?) :- otherwise | person # person(Me?, Ds?, Gs, [], S).
