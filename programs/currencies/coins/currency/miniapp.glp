%% miniapp.glp --- the coins program as a mini-app of the Grassroots Super-App
%% (Grassroots Social Graph paper, Section 3).
%%
%% coins(Id, Ui, Convs) is the mini-app with two of its channels, which its
%% plays activate by run/3 and miniapp/4 below calls for the super-app.  Ui is the person channel (vGLP, Definition
%% "Person Channel, Person Writer, GLP with Persons, Grant"): on it the
%% mini-app receives the person's grants, input(Id, P, R), and shows the
%% constructs its dispatcher draws and withdraws and the screen of its agent.
%% Convs is the channel to the social graph, on which the social graph hands
%% the mini-app, at each invitation, one end of the root channel of a
%% conversation with the execution of this program at a friend.  The mini-app
%% holds nothing else --- no network entry, and no call to a predicate that
%% reaches the network or the person --- so the program is certified.

imported procedure coins_agent#agent(Key?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation(PeerMsg))?, Stream(OutputEntry)?, Stream(Coin)?, Integer?, Stream(Ask(Question))).
imported procedure coins_agent#dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

%% The agent with its dispatcher, the calls of the canonical compilation
%% (vGLP, Definition "Canonical Compilation"): the agent starts with no
%% holdings, serial 1, no conversation and its screen, and its asks go to the
%% dispatcher, which reads the person channel; the screen goes to the person
%% on the dispatcher's channel to the program, which merges it with the
%% constructs' draws.
exported procedure coins(Key?, PersonChannel(Drawn)?, Stream(Conversation(PeerMsg))?).
coins(Id, Ui, Convs) :-
    ground(Id?) |
    coins_agent # agent(Id?, [], [], Convs?, [user_output(Screen)], [], 1, Asks),
    coins_agent # dispatch(Asks?, Ui?, MCh),
    show_screen(MCh?, Screen?).

%% The screen, onto the program's output to the person, which the
%% dispatcher's channel to the program carries as any term; the person's
%% input other than grants is not read.
procedure show_screen(Channel(Stream(_), Stream(Output))?, Stream(ScreenMsg)?).
show_screen(ch(_, Out?), Screen) :- relay(Screen?, Out).

%% Each message as it comes, its content: the envelope msg(agent, person, C)
%% stripped (Currencies, 2026-10-14 08:48 UTC, item 2).
procedure relay(Stream(ScreenMsg)?, Stream(Output)).
relay([msg(_, _, C)|Ms], [C?|Out?]) :- relay(Ms?, Out).
relay([], []).

%% The entry the super-app activates: the root's entry template miniapp/4
%% (programs/self.glp) at the mini-app's own two types, Drawn, what its
%% dispatcher draws for its person, and PeerMsg, the messages of its root
%% channels, both opaque to the super-app (TGLP modules.tex, Dynamic
%% Activation, "Opaque types"; vGLP 2026-10-14 13:21 UTC, S2; Currencies
%% 2026-10-13 20:09 UTC, item 1).  Its grants: the person's key, the person
%% channel, the channel to the social graph, and the calendar, which the currency keeps no dates for and ignores (Currencies
%% 2026-10-13 20:21 UTC; GSG 2026-10-13 20:59 UTC).  The social graph's stream
%% gives each conversation to the agent; a held link is passed over, the
%% mini-app making no warm call, and its stream up to the social graph closes
%% when the social graph's closes.
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(PeerMsg)?, Stream(Integer)?).
miniapp(Id, Ui, ch(Down, Up?), _) :-
    sg_conversations(Down?, Convs, Up),
    coins(Id?, Ui?, Convs?).

procedure sg_conversations(Stream(SgToApp(PeerMsg))?, Stream(Conversation(PeerMsg)), Stream(AppToSg)).
sg_conversations([conversation(K, Ch) | Down], [conversation(K?, Ch?) | Convs?], Up?) :-
    sg_conversations(Down?, Convs, Up).
sg_conversations([held(_, _) | Down], Convs?, Up?) :-
    sg_conversations(Down?, Convs, Up).
sg_conversations([], [], []).
