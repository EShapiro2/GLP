%% person.glp --- a scripted person on the other end of the mini-app's person
%% channel.  It reads what the channel carries --- the constructs the
%% dispatcher draws and withdraws, and the screen the agent writes --- and
%% grants its acts on the constructs, which are the person's taps and
%% submissions, in the order of its script, each step when the one before it
%% has taken effect on the screen.  The screen messages come out on its last
%% argument, for a play to read or a harness to print.  It calls nothing that
%% reaches the person or the network, so it stands in the certified program's
%% own plays (plays.glp) as well as in the village (../village.glp).
%%
%% The agent's request form is drawn once and stays on screen, and every
%% request of the script is granted on it, input(Id, P, R) with the request at
%% the position P the draw marks input; a card is drawn per proposed swap, and
%% withdrawn once answered.  A step is done when the screen shows its effect.
%% The person channel never closes, so the person holds its grant writer for
%% good.

%% The agent's request form, once drawn: its construct and the position of
%% its question, the stream of requests.  The open cards of proposed swaps, by
%% proposer, each with its construct and the position of its question.  What
%% the dispatcher draws is a term of any type.
Form ::= no_form ; form(_, _).
OpenOffer ::= open_offer(_, _, _).
OpenOffers ::= [] ; [OpenOffer | OpenOffers].

%% Whether a grant is out for the current step.
Pending ::= idle ; sent.

%% What a step can do now.
Choice ::= grant(_, _, _) ; wait.

%% person(Id, Draws, Grants, Script, Screen): the person's grants on the
%% channel, and the screen messages as they come.
exported procedure person(Key?, _?, PersonIn, Script?, Stream(ScreenContent)).
person(Id, Ds, Gs?, Script, Screen?) :-
    ground(Id?) |
    events(Ds?, Es),
    person(Id?, Es?, Gs, Script?, no_form, [], idle, Screen).

%% What the person channel carries, as one stream of events: the dispatcher's
%% draws and withdrawals, and the screen it merges in.  The channel's stream
%% never closes, and is read as any term.
procedure events(_?, Events).
events([draw(I, W, V)|Ds], [draw(I?, W?, V?)|Es?]) :- events(Ds?, Es).
events([withdraw(I)|Ds], [withdraw(I?)|Es?]) :- events(Ds?, Es).
events([msg(A, P, M)|Ds], [msg(A?, P?, M?)|Es?]) :- events(Ds?, Es).

procedure person(Key?, Events?, PersonIn, Script?, Form?, OpenOffers?, Pending?, Stream(ScreenContent)).

%% The request form: its question is the stream of requests, at position P.
person(Id, [draw(C, _, input(P))|Es], Gs?, Script, _, Swaps, Pending, Screen?) :-
    ground(C?), ground(P?) |
    try_step(Id?, Es?, Gs, Script?, form(C?, P?), Swaps?, Pending?, Screen).

%% The card of a proposed swap, kept until the script reaches it.
person(Id, [draw(C, _, card(offer(From, _, _), input(P)))|Es], Gs?, Script, Form, Swaps, Pending, Screen?) :-
    ground(C?), ground(From?), ground(P?) |
    try_step(Id?, Es?, Gs, Script?, Form?, [open_offer(From?, C?, P?)|Swaps?], Pending?, Screen).

%% Any other construct is left; the dispatcher draws none, every construct of
%% the agent being caught above.
person(Id, [draw(_, _, _)|Es], Gs?, Script, Form, Swaps, Pending, Screen?) :-
    otherwise |
    person(Id?, Es?, Gs, Script?, Form?, Swaps?, Pending?, Screen).

%% A card withdrawn: the person's answer to it took effect, and it is no
%% longer on screen.  A step in flight is left alone: it leaves sent when the
%% screen shows its effect.
person(Id, [withdraw(_)|Es], Gs?, Script, Form, Swaps, Pending, Screen?) :-
    try_step(Id?, Es?, Gs, Script?, Form?, Swaps?, Pending?, Screen).

%% The screen: passed on; the current step is done when it shows its effect.
person(Id, [msg(_, _, M)|Es], Gs?, [Step|Script], Form, Swaps, Pending, [M?|Screen?]) :-
    ground(M?), ground(Step?) |
    done(Step?, M?, Done),
    advance(Done?, Id?, Es?, Gs, Step?, Script?, Form?, Swaps?, Pending?, Screen).
person(Id, [msg(_, _, M)|Es], Gs?, [], Form, Swaps, Pending, [M?|Screen?]) :-
    ground(M?) |
    person(Id?, Es?, Gs, [], Form?, Swaps?, Pending?, Screen).

%% Whether the screen shows the step's effect.
procedure done(Step?, ScreenContent?, Decision).
done(mint(K), minted(K1), yes) :- K? =:= K1? | true.
done(swap(Q, _, _, _, _), swap_done(Q1), yes) :- Q? =?= Q1? | true.
done(pay(Q, K), paid(Q1, K1), yes) :- Q? =?= Q1?, K? =:= K1? | true.
done(redeem(Q, R), redeemed(Q1, R1), yes) :- Q? =?= Q1?, R? =?= R1? | true.
done(accept(Q), swap_done(Q1), yes) :- Q? =?= Q1? | true.
done(await(M), M1, yes) :- M? =?= M1? | true.
done(_, _, no) :- otherwise | true.

procedure advance(Decision?, Key?, Events?, PersonIn, Step?, Script?, Form?, OpenOffers?, Pending?, Stream(ScreenContent)).
advance(yes, Id, Es, Gs?, _, Script, Form, Swaps, _, Screen?) :-
    try_step(Id?, Es?, Gs, Script?, Form?, Swaps?, idle, Screen).
advance(no, Id, Es, Gs?, Step, Script, Form, Swaps, Pending, Screen?) :-
    person(Id?, Es?, Gs, [Step?|Script?], Form?, Swaps?, Pending?, Screen).

%% Grant the current step, if its construct is on screen and no grant is out.
procedure try_step(Key?, Events?, PersonIn, Script?, Form?, OpenOffers?, Pending?, Stream(ScreenContent)).
try_step(Id, Es, Gs?, [], Form, Swaps, Pending, Screen?) :-
    person(Id?, Es?, Gs, [], Form?, Swaps?, Pending?, Screen).
try_step(Id, Es, Gs?, [Step|Script], Form, Swaps, sent, Screen?) :-
    person(Id?, Es?, Gs, [Step?|Script?], Form?, Swaps?, sent, Screen).
try_step(Id, Es, Gs?, [Step|Script], Form, Swaps, idle, Screen?) :-
    ground(Step?), ground(Form?), ground(Swaps?) |
    pick(Step?, Form?, Swaps?, Choice, Swaps1),
    act(Choice?, Id?, Es?, Gs, [Step?|Script?], Form?, Swaps1?, Screen).

%% A request is granted on the request form, once it is drawn: the step's
%% term, the request; an acceptance on the proposer's card.
procedure pick(Step?, Form?, OpenOffers?, Choice, OpenOffers).
pick(mint(K), form(C, P), Swaps, grant(C?, P?, mint(K?)), Swaps?).
pick(swap(Q, U, K, V, K1), form(C, P), Swaps, grant(C?, P?, swap(Q?, lot(U?, K?), lot(V?, K1?))), Swaps?).
pick(pay(Q, K), form(C, P), Swaps, grant(C?, P?, pay(Q?, K?)), Swaps?).
pick(redeem(Q, R), form(C, P), Swaps, grant(C?, P?, redeem(Q?, R?)), Swaps?).
pick(accept(From), _, Swaps, Choice?, Swaps1?) :-
    ground(From?) |
    find_offer(From?, Swaps?, Choice, Swaps1).
pick(_, _, Swaps, wait, Swaps?) :- otherwise | true.

procedure find_offer(Key?, OpenOffers?, Choice, OpenOffers).
find_offer(From, [open_offer(F, C, P)|Rest], grant(C?, P?, yes), Rest?) :-
    From? =?= F? | true.
find_offer(From, [O|Rest], Ch?, [O?|Rest1?]) :-
    otherwise |
    find_offer(From?, Rest?, Ch, Rest1).
find_offer(_, [], wait, []).

procedure act(Choice?, Key?, Events?, PersonIn, Script?, Form?, OpenOffers?, Stream(ScreenContent)).
%% A grant, on the request form or on a card.
act(grant(C, P, X), Id, Es, [input(C?, P?, X?)|Gs?], Script, Form, Swaps, Screen?) :-
    person(Id?, Es?, Gs, Script?, Form?, Swaps?, sent, Screen).
act(wait, Id, Es, Gs?, Script, Form, Swaps, Screen?) :-
    person(Id?, Es?, Gs, Script?, Form?, Swaps?, idle, Screen).
