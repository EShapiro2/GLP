%% Test agent_init/3 pattern matching
%%
%% Testing if ch(Reader?, Writer) unifies with ch(Writer, Reader?)

procedure agent_init(_?, Channel?, Channel?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    Id? = alice,
    UserIn? = ui,
    UserOut? = uo,
    NetIn? = ni,
    NetOut? = no.
