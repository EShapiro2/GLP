%% Test agent_init/3 pattern matching
%%
%% Testing if ch(Reader?, Writer) unifies with ch(Writer, Reader?)

Msg ::= hello.
procedure agent_init(Constant?, Channel(Stream(Msg), Stream(Msg))?, Channel(Stream(Msg), Stream(Msg))?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    Id? = alice,
    UserIn? = ui,
    UserOut? = uo,
    NetIn? = ni,
    NetOut? = no.
