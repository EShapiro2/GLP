%% play_not_a_friend_headless.glp — headless two-agent play of GSG Section 5.1's
%% last sentence: a message the person addresses to someone who is not their
%% friend is not sent, and the agent tells the person so.
%%
%%   alice sends carol, not her friend, a message -> told not_a_friend(carol)
%%   told, she calls bob                         -> bob consents, they befriend
%%   connected, she sends bob a message          -> bob is told received(alice, hi_bob)
%%
%% Alice calls bob only once she is told, so bob's received follows alice's
%% not_a_friend by causality, not by scheduling: the notice stops no later
%% message.  Both agents run through the mediator, so what is logged is what
%% each person is shown (UserNotify).
%%
%% Entry point: play_not_a_friend/0.

imported procedure grassapp_agent # agent(Key?, UserInStream?, NetInStream?, OutputsList?, Stream(Bond)?, Integer?, Constant?).
imported procedure grassapp_mediator # ui_mediator(Key?,
                      Channel(Stream(AgentMsg), Stream(UserMsg))?,
                      Channel(Stream(UserCmd), Stream(UserNotify))?,
                      PendingList?, Integer?).


%% --- Two-way cold-call router ------------------------------------------------

procedure route2(NetOutStream?, NetInStream, NetInStream).
route2([msg(alice, C)|Rest], [msg(alice, C?)|A?], B?) :-
    route2(Rest?, A, B).
route2([msg(bob, C)|Rest], A?, [msg(bob, C?)|B?]) :-
    route2(Rest?, A, B).
route2([], [], []).

procedure net2(NetOutStream?, NetOutStream?, NetInStream, NetInStream).
net2(AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route2(All?, AIn, BIn).

%% --- Notification logger (so the headless run is observable) ------------------

procedure tee_notifies(Stream(UserNotify)?, Stream(UserNotify), Stream(UserNotify)).
tee_notifies([N|Ns], [N?|As?], [N?|Bs?]) :- ground(N?) | tee_notifies(Ns?, As, Bs).
tee_notifies([], [], []).

procedure log_notifies(Constant?, Stream(UserNotify)?).
log_notifies(Id, [N|Ns]) :-
    ground(Id?), ground(N?) |
    send_to_user([tagged(Id?, N?)]),
    log_notifies(Id?, Ns?).
log_notifies(_, []).

%% --- The play ----------------------------------------------------------------

exported procedure play_not_a_friend.
play_not_a_friend :-
    net2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),

    grassapp_agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [person_output(AliceA2U) | [net_output(AliceNetOut)]],
          [], 1, 0),
    grassapp_mediator # ui_mediator(alice, ch(AliceA2U?, AliceAgentIn), ch(AliceCmds?, AliceNotifies), [], 1),
    tee_notifies(AliceNotifies?, AliceActorIn, AliceLog),
    log_notifies(alice, AliceLog?),
    alice_naf(AliceActorIn?, AliceCmds),

    grassapp_agent # agent(bob, BobAgentIn?, BobNetIn?,
          [person_output(BobA2U) | [net_output(BobNetOut)]],
          [], 1, 0),
    grassapp_mediator # ui_mediator(bob, ch(BobA2U?, BobAgentIn), ch(BobCmds?, BobNotifies), [], 1),
    tee_notifies(BobNotifies?, BobActorIn, BobLog),
    log_notifies(bob, BobLog?),
    bob_naf(BobActorIn?, BobCmds).

%% --- Alice: sends carol, is told, befriends bob, sends bob ----------------------

procedure alice_naf(Stream(UserNotify)?, Stream(UserCmd)).
alice_naf(In, [send(carol, hello)|Out?]) :-
    alice_naf_wait_told(In?, Out).

procedure alice_naf_wait_told(Stream(UserNotify)?, Stream(UserCmd)).
alice_naf_wait_told([not_a_friend(carol)|In], [connect(bob)|Out?]) :-
    alice_naf_wait_connected(In?, Out).
alice_naf_wait_told([_|In], Out?) :-
    otherwise | alice_naf_wait_told(In?, Out).
alice_naf_wait_told([], []).

procedure alice_naf_wait_connected(Stream(UserNotify)?, Stream(UserCmd)).
alice_naf_wait_connected([connected(bob)|_], [send(bob, hi_bob)]).
alice_naf_wait_connected([_|In], Out?) :-
    otherwise | alice_naf_wait_connected(In?, Out).
alice_naf_wait_connected([], []).

%% --- Bob: consents to alice's call, and is told her message --------------------

procedure bob_naf(Stream(UserNotify)?, Stream(UserCmd)).
bob_naf([befriend(alice, ReqId)|In], [decision(yes, alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob_naf_wait_message(In?, Out).
bob_naf([_|In], Out?) :-
    otherwise | bob_naf(In?, Out).
bob_naf([], []).

procedure bob_naf_wait_message(Stream(UserNotify)?, Stream(UserCmd)).
bob_naf_wait_message([received(alice, _)|_], []).
bob_naf_wait_message([_|In], Out?) :-
    otherwise | bob_naf_wait_message(In?, Out).
bob_naf_wait_message([], []).
