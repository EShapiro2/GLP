%% play_grassapp_duo.glp — two-phone GrassApp scenario (madGLP, one isolate
%% per agent; cross-phone routing by the app's network router).
%%
%% Cast: phone 1 runs Bob (live UI) + Eve (actor); phone 2 runs Alice (live
%% UI) + Dana (actor). Each actor cold-calls its local human, greets, mints,
%% and pays — so each phone's wallet, chats, and inbox come alive; Bob and
%% Alice befriend, chat, and transact with each other across the phones.
%% `_net` output goes through send_to_net (madGLP); the app routes local
%% names between isolates and remote names over the network.
%%
%% Boot goals (entered per isolate by the app):
%%   agent_init/3  — interactive agent: (Id, UserIn, NetIn)
%%   actor_init/4  — scripted actor:    (Id, Role, Target, NetIn)
%% Id is the agent's name, over a real network its public key (IGLP, Remark
%% "Agent Names"); an actor's Role, eve or dana, is given apart from it and
%% chooses its opening line and its reply.
%%
%% Requires: self.glp, grassapp_agent.glp, grassapp_mediator.glp

imported procedure grassapp_agent # agent(Key?, UserInStream?, NetInStream?, OutputsList?, Stream(Bond)?, Integer?, Constant?).
imported procedure grassapp_mediator # ui_mediator(Key?,
                      Channel(Stream(AgentMsg), Stream(UserMsg))?,
                      Channel(Stream(UserCmd), Stream(UserNotify))?,
                      PendingList?, Integer?).

%% --- Interactive agent: live phone UI via send_to_user -----------------------
exported procedure agent_init(Key?, Stream(UserCmd)?, NetInStream?).
agent_init(Id, UserIn, NetIn) :-
    ground(Id?) |
    send_to_net(NetOut?),
    grassapp_agent # agent(Id?, AgentIn?, NetIn?,
          [person_output(A2U) | [net_output(NetOut)]],
          [], 1, 0),
    grassapp_mediator # ui_mediator(Id?, ch(A2U?, AgentIn), ch(UserIn?, UserOut), [], 1),
    send_to_user(UserOut?).

%% --- Scripted actor: same agent, a script instead of a live user -------------
exported procedure actor_init(Key?, DuoActor?, Key?, NetInStream?).
actor_init(Id, Role, Target, NetIn) :-
    ground(Id?), ground(Role?), ground(Target?) |
    send_to_net(NetOut?),
    grassapp_agent # agent(Id?, AgentIn?, NetIn?,
          [person_output(A2U) | [net_output(NetOut)]], [], 1, 0),
    grassapp_mediator # ui_mediator(Id?, ch(A2U?, AgentIn), ch(Cmds?, Notifies), [], 1),
    duo_actor(Id?, Role?, Target?, Notifies?, Cmds).

%% --- Actor script -------------------------------------------------------------

%% Cold-call the local human, then court them.
procedure duo_actor(Key?, DuoActor?, Key?, Stream(UserNotify)?, Stream(UserCmd)).
duo_actor(Me, Role, Target, Ns, [connect(Target?) | Cs?]) :-
    ground(Me?), ground(Role?), ground(Target?) |
    duo_courter(Me?, Role?, Target?, Ns?, Cs).

%% On becoming the human's friend: greet, mint, and pay them 2 coins, the
%% actor's own, named by its key.
procedure duo_courter(Key?, DuoActor?, Key?, Stream(UserNotify)?, Stream(UserCmd)).
duo_courter(Me, Role, Target, [connected(Who) | Ns],
    [send(Target?, Greeting?) | [mint(5, 0) | [pay(Target?, Me?, 0, 2) | Cs?]]]) :-
    ground(Me?), ground(Role?), ground(Target?), Who? =?= Target? |
    greeting_of(Role?, Greeting),
    duo_drain(Role?, Ns?, Cs).
duo_courter(Me, Role, Target, [_ | Ns], Cs?) :-
    ground(Me?), ground(Role?), ground(Target?), otherwise |
    duo_courter(Me?, Role?, Target?, Ns?, Cs).
duo_courter(_, _, _, [], []).

%% Each role's opening line and chat reply.
procedure greeting_of(DuoActor?, Constant).
greeting_of(eve, welcome_to_grassroots).
greeting_of(dana, hello_from_your_local_actor).

procedure reply_of(DuoActor?, Constant).
reply_of(eve, lovely_day_isnt_it).
reply_of(dana, happy_to_trade_anytime).

%% After courting: answer chat messages, accept any friend offer, swap, or
%% group invitation, greet a joined group, ignore the rest; the role chooses
%% the reply.
procedure duo_drain(DuoActor?, Stream(UserNotify)?, Stream(UserCmd)).
duo_drain(Role, [received(From, _) | Ns], [send(From?, R?) | Cs?]) :-
    ground(Role?), ground(From?) |
    reply_of(Role?, R),
    duo_drain(Role?, Ns?, Cs).
duo_drain(Role, [befriend(Who, Req) | Ns], [decision(yes, Who?, Req?) | Cs?]) :-
    ground(Role?), ground(Who?), ground(Req?) | duo_drain(Role?, Ns?, Cs).
duo_drain(Role, [trade_proposed(From, _, _, _, Req) | Ns], [accept_trade(From?, Req?) | Cs?]) :-
    ground(Role?), ground(From?), ground(Req?) | duo_drain(Role?, Ns?, Cs).
duo_drain(Role, [group_invite(G, Req) | Ns], [accept_group(G?, Req?) | Cs?]) :-
    ground(Role?), ground(G?), ground(Req?) | duo_drain(Role?, Ns?, Cs).
duo_drain(Role, [group_joined(G) | Ns], [send_group(G?, R?) | Cs?]) :-
    ground(Role?), ground(G?) | reply_of(Role?, R), duo_drain(Role?, Ns?, Cs).
duo_drain(Role, [_ | Ns], Cs?) :- ground(Role?), otherwise | duo_drain(Role?, Ns?, Cs).
duo_drain(_, [], []).
