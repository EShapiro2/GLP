%% play_not_a_friend_sends_headless.glp — headless play of GSG Section 5.1's last
%% sentence at grassapp's friend sends other than the plain message: a message
%% the person addresses to someone who is not their friend is not sent, and the
%% agent tells the person so.  The bonds the act selected stay in the holdings,
%% nothing having been conveyed.
%%
%%   alice mints 5 of her own coins                -> holdings: 5 alice coins
%%   she pays dave, not her friend, 2 of them      -> told not_a_friend(dave)
%%   she offers eve, not her friend, 2 in a trade  -> told not_a_friend(eve)
%%   she escrows 2 for frank, not her friend       -> told not_a_friend(frank)
%%   she opens a group and invites grace, not her friend
%%                                                 -> told not_a_friend(grace)
%%   she befriends carol and unfriends her; carol's payment, in flight when
%%   the unfriend reached her, arrives after it, and is not alice's coin, so
%%   alice's agent returns it to carol, who is no longer her friend
%%                                                 -> told not_a_friend(carol)
%%   she asks for her balance                      -> holdings: 5 alice coins
%%
%% Each act is made only once the one before it has been told, so the notices
%% follow one another by causality, not by scheduling.  Alice runs through the
%% mediator, so what is logged is what she is shown (UserNotify).
%%
%% Carol is not an agent but a scripted friend holding her end of the friend
%% channel: she accepts alice's call, and sends her payment once alice's
%% unfriend has reached her.  That is the order a slow network gives a payment
%% her agent sent before the unfriend reached it, and no scheduling of two
%% agents makes it deterministic; the payment arrives on the friend channel
%% itself, as it would.
%%
%% Entry points: play_not_a_friend_sends/0, and play_not_a_friend_escrow/0 below,
%% which shows that a deposit not sent leaves an escrow already open running.

imported procedure grassapp_agent # agent(Key?, UserInStream?, NetInStream?, OutputsList?, Stream(Bond)?, Integer?, Constant?).
imported procedure grassapp_mediator # ui_mediator(Key?,
                      Channel(Stream(AgentMsg), Stream(UserMsg))?,
                      Channel(Stream(UserCmd), Stream(UserNotify))?,
                      PendingList?, Integer?).


%% --- Cold-call router: alice's calls to carol reach carol ----------------------

procedure route_nafs(NetOutStream?, NetInStream, NetInStream).
route_nafs([msg(alice, C)|Rest], [msg(alice, C?)|A?], Cs?) :-
    route_nafs(Rest?, A, Cs).
route_nafs([msg(carol, C)|Rest], A?, [msg(carol, C?)|Cs?]) :-
    route_nafs(Rest?, A, Cs).
route_nafs([], [], []).

%% --- Notification logger (so the headless run is observable) ------------------

procedure tee_nafs(Stream(UserNotify)?, Stream(UserNotify), Stream(UserNotify)).
tee_nafs([N|Ns], [N?|As?], [N?|Bs?]) :- ground(N?) | tee_nafs(Ns?, As, Bs).
tee_nafs([], [], []).

procedure log_nafs(Constant?, Stream(UserNotify)?).
log_nafs(Id, [N|Ns]) :-
    ground(Id?), ground(N?) |
    send_to_user([tagged(Id?, N?)]),
    log_nafs(Id?, Ns?).
log_nafs(_, []).

%% --- The play ----------------------------------------------------------------

exported procedure play_not_a_friend_sends.
play_not_a_friend_sends :-
    route_nafs(AliceNetOut?, AliceNetIn, CarolNetIn),

    grassapp_agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [person_output(AliceA2U) | [net_output(AliceNetOut)]],
          [], 1, 0),
    grassapp_mediator # ui_mediator(alice, ch(AliceA2U?, AliceAgentIn), ch(AliceCmds?, AliceNotifies), [], 1),
    tee_nafs(AliceNotifies?, AliceActorIn, AliceLog),
    log_nafs(alice, AliceLog?),
    alice_nafs(AliceActorIn?, AliceCmds),

    carol_peer(CarolNetIn?).

%% --- Alice: mints, then addresses each act to someone not her friend -----------

procedure alice_nafs(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs(In, [mint(5, 0)|Out?]) :-
    alice_nafs_minted(In?, Out).

%% Holdings before: 5 of her own coins.  Pay dave 2 of them.
procedure alice_nafs_minted(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_minted([balance_report(alice, alice, 0, 5)|In], [pay(dave, alice, 0, 2)|Out?]) :-
    alice_nafs_paid(In?, Out).
alice_nafs_minted([_|In], Out?) :-
    otherwise | alice_nafs_minted(In?, Out).
alice_nafs_minted([], []).

%% Told; offer eve 2 of her coins for 1 of eve's.
procedure alice_nafs_paid(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_paid([not_a_friend(dave)|In], [trade(eve, alice, 0, 2, eve, 0, 1)|Out?]) :-
    alice_nafs_traded(In?, Out).
alice_nafs_paid([_|In], Out?) :-
    otherwise | alice_nafs_paid(In?, Out).
alice_nafs_paid([], []).

%% Told; escrow 2 of her coins for frank until 30.
procedure alice_nafs_traded(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_traded([not_a_friend(eve)|In], [deposit_escrow(frank, alice, 0, 2, 30)|Out?]) :-
    alice_nafs_escrowed(In?, Out).
alice_nafs_traded([_|In], Out?) :-
    otherwise | alice_nafs_traded(In?, Out).
alice_nafs_traded([], []).

%% Told; open a group.
procedure alice_nafs_escrowed(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_escrowed([not_a_friend(frank)|In], [create_group(chess)|Out?]) :-
    alice_nafs_grouped(In?, Out).
alice_nafs_escrowed([_|In], Out?) :-
    otherwise | alice_nafs_escrowed(In?, Out).
alice_nafs_escrowed([], []).

%% The group is open; invite grace to it.
procedure alice_nafs_grouped(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_grouped([group_joined(group_id(alice, chess))|In],
                   [invite_group(group_id(alice, chess), grace)|Out?]) :-
    alice_nafs_invited(In?, Out).
alice_nafs_grouped([_|In], Out?) :-
    otherwise | alice_nafs_grouped(In?, Out).
alice_nafs_grouped([], []).

%% Told; call carol.
procedure alice_nafs_invited(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_invited([not_a_friend(grace)|In], [connect(carol)|Out?]) :-
    alice_nafs_calling(In?, Out).
alice_nafs_invited([_|In], Out?) :-
    otherwise | alice_nafs_invited(In?, Out).
alice_nafs_invited([], []).

%% Connected; unfriend her.
procedure alice_nafs_calling(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_calling([connected(carol)|In], [unfriend(carol)|Out?]) :-
    alice_nafs_returning(In?, Out).
alice_nafs_calling([_|In], Out?) :-
    otherwise | alice_nafs_calling(In?, Out).
alice_nafs_calling([], []).

%% Carol's payment, returned to her, is not sent; told, alice asks for her
%% balance: holdings after.
procedure alice_nafs_returning(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafs_returning([not_a_friend(carol)|_], [balance]).
alice_nafs_returning([_|In], Out?) :-
    otherwise | alice_nafs_returning(In?, Out).
alice_nafs_returning([], []).

%% --- Carol: a friend whose payment was in flight when alice unfriended her -----

procedure carol_peer(NetInStream?).
carol_peer([msg(carol, friend_request(alice, Resp?))|_]) :-
    carol_accept(Resp).
carol_peer([_|In]) :-
    otherwise | carol_peer(In?).
carol_peer([]).

%% Accept the call, as the agent's bind_response does, and keep her end.
procedure carol_accept(Response).
carol_accept(accept(RetCh?)) :-
    new_channel(RetCh, LocalCh) |
    carol_pays_late(LocalCh?).

%% Once alice's unfriend has reached her, carol's payment of one of her own
%% coins arrives on the channel, and the channel closes.
procedure carol_pays_late(FriendChannel?).
carol_pays_late(ch([msg(alice, carol, unfriend)|_], [msg(carol, alice, coins([bond(carol, 0, 1)]))])).
carol_pays_late(ch([_|In], Out?)) :-
    otherwise | carol_pays_late(ch(In?, Out)).
carol_pays_late(ch([], [])).

%% =============================================================================
%% play_not_a_friend_escrow/0 — a deposit not sent leaves an open escrow running
%%
%%   alice befriends bob and mints 4 of her own coins
%%   she escrows 2 for bob until 30                 -> escrow_deposited(bob, ...)
%%   she escrows 2 for dave, not her friend         -> told not_a_friend(dave)
%%   she advances her date to 30                    -> the escrow for bob releases:
%%                                                     alice escrow_expired(bob),
%%                                                     bob escrow_released(alice)
%%   she asks for her balance                       -> 2 alice coins, the 2 for
%%                                                     dave never having left
%%
%% The open escrow reads alice's own date; the deposit not sent conveys nothing,
%% and leaves that date to the escrow.
%% =============================================================================

procedure route_nafe(NetOutStream?, NetInStream, NetInStream).
route_nafe([msg(alice, C)|Rest], [msg(alice, C?)|A?], B?) :-
    route_nafe(Rest?, A, B).
route_nafe([msg(bob, C)|Rest], A?, [msg(bob, C?)|B?]) :-
    route_nafe(Rest?, A, B).
route_nafe([], [], []).

procedure net_nafe(NetOutStream?, NetOutStream?, NetInStream, NetInStream).
net_nafe(AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route_nafe(All?, AIn, BIn).

exported procedure play_not_a_friend_escrow.
play_not_a_friend_escrow :-
    net_nafe(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),

    grassapp_agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [person_output(AliceA2U) | [net_output(AliceNetOut)]],
          [], 1, 0),
    grassapp_mediator # ui_mediator(alice, ch(AliceA2U?, AliceAgentIn), ch(AliceCmds?, AliceNotifies), [], 1),
    tee_nafs(AliceNotifies?, AliceActorIn, AliceLog),
    log_nafs(alice, AliceLog?),
    alice_nafe(AliceActorIn?, AliceCmds),

    grassapp_agent # agent(bob, BobAgentIn?, BobNetIn?,
          [person_output(BobA2U) | [net_output(BobNetOut)]],
          [], 1, 0),
    grassapp_mediator # ui_mediator(bob, ch(BobA2U?, BobAgentIn), ch(BobCmds?, BobNotifies), [], 1),
    tee_nafs(BobNotifies?, BobActorIn, BobLog),
    log_nafs(bob, BobLog?),
    bob_nafe(BobActorIn?, BobCmds).

%% --- Alice: escrows for bob, then for dave, then advances her date -------------

procedure alice_nafe(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafe(In, [connect(bob)|Out?]) :-
    alice_nafe_calling(In?, Out).

procedure alice_nafe_calling(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafe_calling([connected(bob)|In], [mint(4, 0)|Out?]) :-
    alice_nafe_minted(In?, Out).
alice_nafe_calling([_|In], Out?) :-
    otherwise | alice_nafe_calling(In?, Out).
alice_nafe_calling([], []).

procedure alice_nafe_minted(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafe_minted([balance_report(alice, alice, 0, 4)|In], [deposit_escrow(bob, alice, 0, 2, 30)|Out?]) :-
    alice_nafe_opened(In?, Out).
alice_nafe_minted([_|In], Out?) :-
    otherwise | alice_nafe_minted(In?, Out).
alice_nafe_minted([], []).

procedure alice_nafe_opened(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafe_opened([escrow_deposited(bob, _, _, _, _, _)|In], [deposit_escrow(dave, alice, 0, 2, 30)|Out?]) :-
    alice_nafe_told(In?, Out).
alice_nafe_opened([_|In], Out?) :-
    otherwise | alice_nafe_opened(In?, Out).
alice_nafe_opened([], []).

procedure alice_nafe_told(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafe_told([not_a_friend(dave)|In], [advance_date(30)|Out?]) :-
    alice_nafe_dated(In?, Out).
alice_nafe_told([_|In], Out?) :-
    otherwise | alice_nafe_told(In?, Out).
alice_nafe_told([], []).

procedure alice_nafe_dated(Stream(UserNotify)?, Stream(UserCmd)).
alice_nafe_dated([escrow_expired(bob)|_], [balance]).
alice_nafe_dated([_|In], Out?) :-
    otherwise | alice_nafe_dated(In?, Out).
alice_nafe_dated([], []).

%% --- Bob: consents to alice's call, and is released the escrow -----------------

procedure bob_nafe(Stream(UserNotify)?, Stream(UserCmd)).
bob_nafe([befriend(alice, ReqId)|In], [decision(yes, alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob_nafe_released(In?, Out).
bob_nafe([_|In], Out?) :-
    otherwise | bob_nafe(In?, Out).
bob_nafe([], []).

procedure bob_nafe_released(Stream(UserNotify)?, Stream(UserCmd)).
bob_nafe_released([escrow_released(alice)|_], [balance]).
bob_nafe_released([_|In], Out?) :-
    otherwise | bob_nafe_released(In?, Out).
bob_nafe_released([], []).
