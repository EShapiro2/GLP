%% bounded.glp --- the resource-bounded meta-interpreter bounded/3, the stream
%% counter as a mini-app, the residual program the compiler's partial
%% evaluation of bounded/3 against it yields, and the super-app's granting of
%% budgets.  SGSG paper, Section 6.3 and Appendix D, which follow this listing.
%%
%% OBJECT PROGRAMS.  GLP has no clause/2 and no meta-call, so a meta-interpreter
%% runs over a representation of the mini-app, the one programs/book/meta uses:
%% a clause  A :- G | S, B  of the mini-app, with S its system goals and B its
%% user goals, is the unit clause  reduce(A, B) :- G | S.  The reduce clause
%% executes the system goals itself, within the one reduction charged for the
%% clause; the meta-interpreter counts reductions of the mini-app's clauses and
%% nothing else.  Arithmetic assignment (:=) is a body predicate, not a guard,
%% so budgets are compared in guards and decremented in bodies.  Meta-interpreter typing is deferred (typed-glp-manual 18.3):
%% bounded/3 and reduce/2 range over any goal term, hence `_`.

%% =============================================================================
%% THE META-INTERPRETER: bounded(Goal, Budget, Requests)
%% =============================================================================
%% Reduces Goal with at most Budget reductions; when the budget is spent it
%% writes more(N1) on Requests, a stream the super-app reads, and proceeds with
%% whatever budget the super-app assigns to N1.  A conjunction splits its budget
%% between its conjuncts and merges their request streams.

procedure bounded(_?, Integer?, Stream(Request)).
bounded(true, _, []).
bounded((A, B), N, Rs?) :-
    N1 := N? // 2, N2 := N? - N1?,
    bounded(A?, N1?, Rs1), bounded(B?, N2?, Rs2), merge(Rs1?, Rs2?, Rs).
bounded(G, N, Rs?) :-
    otherwise, N? > 0 |
    N1 := N? - 1, reduce(G?, B), bounded(B?, N1?, Rs).
bounded(G, N, [more(N1)|Rs?]) :-
    otherwise, N? =?= 0 |
    bounded(G?, N1?, Rs).

%% The request streams of two conjuncts joined into one; when either closes the
%% merged stream continues as the other, so a chain of merges left by a
%% recursive goal shortens as its conjuncts terminate.
procedure merge(Stream(Request)?, Stream(Request)?, Stream(Request)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% THE MINI-APP: a stream counter, three ways
%% =============================================================================

%% (a) As the mini-app writes it.
procedure count(Stream(Integer)?, Integer?, Stream(Integer)).
count([_|Xs], N, [N1?|Out?]) :- N1 := N? + 1, count(Xs?, N1?, Out).
count([], _, []).

%% (b) As the meta-interpreter runs it: one reduce clause per clause of (a).
procedure reduce(_?, _).
reduce(count([_|Xs], N, [N1?|Out?]), count(Xs?, N1?, Out)) :- N1 := N? + 1.
reduce(count([], _, []), true).

%% (c) The residual program: bounded/3 partially evaluated against (a).  Each
%% predicate gains the budget and the request stream; each clause a test and a
%% decrement; each predicate one clause that requests a budget when it has
%% none.  The body of the first clause is a single user goal, so no merge
%% remains; a body of k user goals would keep k-1 merges.
procedure count(Stream(Integer)?, Integer?, Stream(Integer), Integer?, Stream(Request)).
count([_|Xs], N, [N1?|Out?], B, Rs?) :-
    B? > 0 |
    B1 := B? - 1, N1 := N? + 1, count(Xs?, N1?, Out, B1?, Rs).
count([], _, [], B, []) :- B? > 0 | true.
count(Xs, N, Out?, B, [more(B1)|Rs?]) :-
    B? =?= 0 |
    count(Xs?, N?, Out, B1?, Rs).

%% =============================================================================
%% THE SUPER-APP: granting budgets
%% =============================================================================
%% grant(Rs, K) assigns K to every request on Rs: a super-app granting a fixed
%% budget at the rate at which the mini-app asks.
procedure grant(Stream(Request)?, Integer?).
grant([more(K?)|Rs], K) :- grant(Rs?, K?).
grant([], _).

%% =============================================================================
%% PLAYS
%% =============================================================================

%% The counter under the meta-interpreter, budget 2, grants of 2: Out = [1,2,3,4,5].
exported procedure play_meta(Stream(Integer)).
play_meta(Out?) :-
    bounded(count([1,2,3,4,5], 0, Out), 2, Rs),
    grant(Rs?, 2).

%% The residual program, budget 2, grants of 2: the same Out.
exported procedure play_residual(Stream(Integer)).
play_residual(Out?) :-
    count([1,2,3,4,5], 0, Out, 2, Rs),
    grant(Rs?, 2).

%% bench(Which, N, K, Last): count a stream of N integers, Which = plain (the
%% mini-app unbudgeted), residual (the residual program under grants of K) or
%% meta (under bounded/3 with grants of K); Last is the last count, N.
exported procedure bench(Constant?, Integer?, Integer?, Integer).
bench(plain, N, _, Last?) :-
    iota(N?, Xs), count(Xs?, 0, Out), last(Out?, Last).
bench(residual, N, K, Last?) :-
    iota(N?, Xs), count(Xs?, 0, Out, K?, Rs), grant(Rs?, K?), last(Out?, Last).
bench(meta, N, K, Last?) :-
    iota(N?, Xs), bounded(count(Xs?, 0, Out), K?, Rs), grant(Rs?, K?), last(Out?, Last).

procedure iota(Integer?, Stream(Integer)).
iota(N, [N?|Xs?]) :- N? > 0 | N1 := N? - 1, iota(N1?, Xs).
iota(0, []).

procedure last(Stream(Integer)?, Integer).
last([X], X?).
last([_|Xs], L?) :- otherwise | last(Xs?, L).
last([], 0).

%% =============================================================================
%% CONTROL AS WELL AS RESOURCE BOUNDS: execute(Goal, Budget, Requests, Control)
%% (SGSG paper, Section 6.3 at GSG d51747f, after Logix's control mode)
%% =============================================================================
%% As bounded/3, and in addition a control stream the super-app writes,
%% distributed to both conjuncts of a conjunction, read by unknown/1 in the
%% guards, and an abort clause that ends a goal once abort is written on it.
%%
%% WHAT DOES NOT RUN OF THE PAPER'S INTENT, and why the residual program is the
%% one that gives control: reduce/2 is a body goal (a guard may call only what
%% the partial evaluator unfolds, never a multi-clause procedure), so execute/4
%% commits to its reduce clause before reduce/2 waits for the goal's data; a
%% goal waiting for data is then inside a suspended reduce/2, past the clause
%% that would abort it, and abort does not end it (play_abort_interpreted
%% suspends).  In the residual program the control test precedes each clause's
%% own guard, so the abort clause takes a waiting goal as it takes a running
%% one (play_abort_waiting succeeds).  Logix could put clause/2 in the guard;
%% GLP cannot, and the paper's listing should say that the meta-interpreter
%% states the semantics and the residual program realises it.

procedure execute(_?, Integer?, Stream(Request), Stream(Constant)?).
execute(true, _, [], _).
execute((A, B), N, Rs?, Cs) :-
    N1 := N? // 2, N2 := N? - N1?,
    distribute(Cs?, Cs1, Cs2),
    execute(A?, N1?, Rs1, Cs1?),
    execute(B?, N2?, Rs2, Cs2?),
    merge(Rs1?, Rs2?, Rs).
execute(G, N, Rs?, Cs) :-
    otherwise, unknown(Cs?), N? > 0 |
    N1 := N? - 1, reduce(G?, B),
    execute(B?, N1?, Rs, Cs?).
execute(G, N, [more(N1)|Rs?], Cs) :-
    otherwise, unknown(Cs?), N? =?= 0 |
    execute(G?, N1?, Rs, Cs?).
execute(_, _, [], [abort|_]).

%% The control stream given to both conjuncts; its messages are constants,
%% which is what lets one reader of it be written twice in a clause.
procedure distribute(Stream(Constant)?, Stream(Constant), Stream(Constant)).
distribute([X|Xs], [X?|Ys?], [X?|Zs?]) :- constant(X?) | distribute(Xs?, Ys, Zs).
distribute([], [], []).

%% (d) The residual program of execute/4 against count/3: each predicate gains
%% the budget, the request stream and the control stream; each clause gains,
%% before its own guard, the test that the control stream is unwritten and the
%% budget test; each predicate gains a request clause and an abort clause,
%% which takes a waiting goal as it takes a running one.  The abort clause
%% closes the goal's output stream: a head has no anonymous writer at an
%% output position, so the paper's `_` there is `[]` here.
procedure count(Stream(Integer)?, Integer?, Stream(Integer), Integer?, Stream(Request), Stream(Constant)?).
count([_|Xs], N, [N1?|Out?], B, Rs?, Cs) :-
    unknown(Cs?), B? > 0 |
    B1 := B? - 1, N1 := N? + 1,
    count(Xs?, N1?, Out, B1?, Rs, Cs?).
count([], _, [], B, [], _) :- B? > 0 | true.
count(Xs, N, Out?, B, [more(B1)|Rs?], Cs) :-
    unknown(Cs?), B? =?= 0 |
    count(Xs?, N?, Out, B1?, Rs, Cs?).
count(_, _, [], _, [], [abort|_]).

%% --- The super-app's control ---

%% abort_when(Trigger, Cs): write abort on the control stream once Trigger is
%% known --- here, once the counter has shown three counts.
procedure abort_when(Constant?, Stream(Constant)).
abort_when(T, [abort]) :- ground(T?) | true.

%% third(Out, T): T := ok at the third element of Out (none if it closes first).
procedure third(Stream(Integer)?, Constant).
third([_, _, _ | _], ok).
third([_, _], none).
third([_], none).
third([], none).

%% =============================================================================
%% PLAYS OF CONTROL
%% =============================================================================

%% play_abort_waiting(Out, Rs): the residual counter on a stream that never
%% closes, budget 10 (no request); after three counts the super-app writes
%% abort; the counter, waiting on its stream, ends and its request stream
%% closes.  Out = [1, 2, 3 | _], Rs = [], → succeeds.
exported procedure play_abort_waiting(Stream(Integer), Stream(Request)).
play_abort_waiting(Out?, Rs?) :-
    open_three(Xs),
    count(Xs?, 0, Out, 10, Rs, Cs?),
    third(Out?, T),
    abort_when(T?, Cs).

%% open_three(Xs): three elements and a tail that is never written.
procedure open_three(Stream(Integer)).
open_three([1, 2, 3 | Tail?]) :- hold(Tail).

%% hold(X): hold a writer and never bind it.
procedure hold(Stream(Integer)).
hold(X?) :- true.

%% play_clean(Out, Rs): the residual counter on a closed stream under grants of
%% 2, the control stream never written: clean termination, the request stream
%% closing with nothing on the control stream.  Out = [1,2,3,4,5], Rs = [],
%% → succeeds.
exported procedure play_clean(Stream(Integer), Stream(Request)).
play_clean(Out?, Rs?) :-
    count([1, 2, 3, 4, 5], 0, Out, 2, Rs0, Cs?),
    grant_seen(Rs0?, 2, Rs, Cs).

%% grant_seen(Rs0, K, Rs, Cs): the super-app grants K to every request; when
%% the request stream closes it closes its copy Rs, for the caller to see, and
%% the control stream Cs, on which it wrote nothing (Appendix D).
procedure grant_seen(Stream(Request)?, Integer?, Stream(Request), Stream(Constant)).
grant_seen([more(K?) | Rs0], K, Rs?, Cs?) :- grant_seen(Rs0?, K?, Rs, Cs).
grant_seen([], _, [], []).

%% play_abort_interpreted(Out, Rs): the same abort under execute/4, where
%% reduce/2 waits inside the committed reduce clause and abort cannot reach
%% the waiting goal: the play SUSPENDS (Out = [1, 2, 3 | _], Rs unbound).
exported procedure play_abort_interpreted(Stream(Integer), Stream(Request)).
play_abort_interpreted(Out?, Rs?) :-
    open_three(Xs),
    execute(count(Xs?, 0, Out), 10, Rs, Cs?),
    third(Out?, T),
    abort_when(T?, Cs).
