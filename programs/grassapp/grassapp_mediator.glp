%% grassapp_mediator.glp — the one mediator between the GrassApp agent (agent/7)
%% and the Dart UI; one machine for all platforms, parameterised by its message
%% vocabulary (UserCmd/UserNotify below).
%%
%% Same escrow discipline as the social mediator: agent output may carry unbound
%% variables (the cold-call Response writer, a trade TradeResponse writer); the
%% mediator replaces them with a ground req(N) for the UI and holds the writer in
%% the pending table until the user answers. All Dart-facing terms are ground.
%%
%% Currencies vocabulary (Milestone 1b): mint carries a maturity, the swap is the
%% maturity-carrying lot-spec trade (a loan is its instance), the local date
%% advances explicitly, redeem is the holder-gated presentation, and
%% balance_report is keyed by (owner, issuer, maturity) so the wallet can split
%% cash (mature) from loans (dated).  Escrow (paper §5) locks bonds until a
%% real-time release and is cancellable until then; its cancel-signal writer is
%% escrowed as req(N) exactly like a trade offer's response writer.
%%
%% Scalar boundary: the UI — and the scripted actors that stand in for people —
%% speak SCALAR single-lot commands (pay/4, trade/7, redeem/7, deposit_escrow/5),
%% because a compose
%% form carries only scalar fields.  This mediator builds the one Lot of each
%% spec the agent consumes, converting the amount the person answers, a
%% Constant, to the lot's count, an Integer (a lot is a quantity of a coin, GSG
%% Section 7); and it flattens the agent's trade_proposed back to scalars for
%% the offer card.  Multi-lot portfolios are Milestone 2.


exported procedure ui_mediator(Key?,
                      Channel(Stream(AgentMsg), Stream(UserMsg))?,
                      Channel(Stream(UserCmd), Stream(UserNotify))?,
                      PendingList?, Constant?).

%% --- Agent-to-user: non-ground (replace writer with req id) ---

ui_mediator(Id, ch([msg(agent, person, befriend(From, Resp?))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(From?) |
    send(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% Trade offer: agent sends trade_proposed(...,TradeResp); escrow the writer as
%% req(N) together with the want-spec and the bonds actually offered.
ui_mediator(Id, ch([msg(agent, person,
                        trade_proposed(From, WantSpec, Resp?, Offered))|AgentIn],
                   AgentOut?),
            UserCh, Ps, N) :-
    ground(From?), ground(WantSpec?), ground(Offered?) |
    first_lot(WantSpec?, WantIssuer, WantMaturity, WantAmount),
    send(trade_proposed(From?, WantIssuer?, WantMaturity?, WantAmount?, req(N?)),
         UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?,
        [pending(req(N?), trade_pending(Resp, WantSpec?, Offered?)) | Ps?], N1?).

%% Escrow opened: the agent hands over the cancel-signal writer.  Hold it in the
%% pending table as req(N) so the UI can cancel by id.
ui_mediator(Id, ch([msg(agent, person,
                        escrow_deposited(Target, ReleaseTime, Coin, Maturity,
                                         Amount, Cancel?))|AgentIn],
                   AgentOut?),
            UserCh, Ps, N) :-
    ground(Target?), ground(ReleaseTime?),
    ground(Coin?), ground(Maturity?), ground(Amount?) |
    send(escrow_deposited(Target?, ReleaseTime?, Coin?, Maturity?, Amount?, req(N?)),
         UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?,
        [pending(req(N?), escrow_pending(Cancel)) | Ps?], N1?).

%% --- Agent-to-user: ground (pass through) ---

ui_mediator(Id, ch([msg(agent, person, trade_completed(Who))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Who?) |
    send(trade_completed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, trade_failed(Who))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Who?) |
    send(trade_failed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, trade_returned(Who))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Who?) |
    send(trade_returned(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person,
                        trade_returned_menu(From, Menu))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(From?), ground(Menu?) |
    send(trade_returned_menu(From?, Menu?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, date_advanced(D))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(D?) |
    send(date_advanced(D?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, connected(Who))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Who?) |
    send(connected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, unfriended(Who))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Who?) |
    send(unfriended(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, rejected)|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    send(rejected, UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, rejected(Who))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Who?) |
    send(rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, received(From, Text))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(From?), ground(Text?) |
    send(received(From?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

%% Holdings are reported per (owner, issuer, maturity) so the wallet can show
%% cash (mature) and loans (dated) as distinct views.
ui_mediator(Id, ch([msg(agent, person,
                        balance_report(Owner, Issuer, Maturity, Count))|AgentIn],
                   AgentOut?),
            UserCh, Ps, N) :-
    ground(Owner?), ground(Issuer?), ground(Maturity?), ground(Count?) |
    send(balance_report(Owner?, Issuer?, Maturity?, Count?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

%% Balances snapshot boundary: the UI prunes holdings the snapshot omitted, so a
%% coin spent to zero leaves the wallet (nothing else reports it gone).
ui_mediator(Id, ch([msg(agent, person, balances_synced(Owner))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Owner?) |
    send(balances_synced(Owner?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow settlement (ground pass-through) ---

ui_mediator(Id, ch([msg(agent, person,
                        escrow_received(From, ReleaseTime, Coin, Maturity,
                                        Amount))|AgentIn],
                   AgentOut?),
            UserCh, Ps, N) :-
    ground(From?), ground(ReleaseTime?),
    ground(Coin?), ground(Maturity?), ground(Amount?) |
    send(escrow_received(From?, ReleaseTime?, Coin?, Maturity?, Amount?),
         UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, escrow_released(From))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(From?) |
    send(escrow_released(From?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, escrow_cancelled(From))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(From?) |
    send(escrow_cancelled(From?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, escrow_expired(Target))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Target?) |
    send(escrow_expired(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, escrow_returned(Target))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Target?) |
    send(escrow_returned(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, escrow_failed(Target))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(Target?) |
    send(escrow_failed(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

%% --- Agent-to-user: group invitation (escrow the setup channel as req(N)) ---

ui_mediator(Id, ch([msg(agent, person, group_invite(GroupId, Ch))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(GroupId?) |
    send(group_invite(GroupId?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?,
        [pending(req(N?), group_channel(Ch?)) | Ps?], N1?).

%% --- Agent-to-user: group notifications (ground pass-through) ---

ui_mediator(Id, ch([msg(agent, person, group_joined(GroupId))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(GroupId?) |
    send(group_joined(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person,
                        group_joined_member(GroupId, Member))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(GroupId?), ground(Member?) |
    send(group_joined_member(GroupId?, Member?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, group_left(GroupId))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(GroupId?) |
    send(group_left(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person, group_removed(GroupId))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(GroupId?) |
    send(group_removed(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

ui_mediator(Id, ch([msg(agent, person,
                        group_received(GroupId, Author, Text))|AgentIn], AgentOut?),
            UserCh, Ps, N) :-
    ground(GroupId?), ground(Author?), ground(Text?) |
    send(group_received(GroupId?, Author?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, ch(AgentIn?, AgentOut), UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (cold-call response) ---

ui_mediator(Id, AgentCh, ch([decision(Dec, From, ReqId)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(Dec?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Resp, Ps?, Ps1),
    send(msg(person, Id?, decision(Dec?, From?, Resp?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps1?, N?).

%% --- User-to-agent: pass-through commands ---

ui_mediator(Id, AgentCh, ch([connect(Target)|UserIn], UserOut?), Ps, N) :-
    ground(Id?), ground(Target?) |
    send(msg(person, Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([unfriend(Friend)|UserIn], UserOut?), Ps, N) :-
    ground(Id?), ground(Friend?) |
    send(msg(person, Id?, unfriend(Friend?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([send(Target, Text)|UserIn], UserOut?), Ps, N) :-
    ground(Id?), ground(Target?), ground(Text?) |
    send(msg(person, Id?, send(Target?, Text?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

%% Mint K bonds of my own at Maturity (Maturity 0 = cash).
ui_mediator(Id, AgentCh, ch([mint(K, Maturity)|UserIn], UserOut?), Ps, N) :-
    ground(Id?), ground(K?), ground(Maturity?) |
    send(msg(person, Id?, mint(K?, Maturity?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

%% Advance this agent's own local date.
ui_mediator(Id, AgentCh, ch([advance_date(D)|UserIn], UserOut?), Ps, N) :-
    ground(Id?), ground(D?) |
    send(msg(person, Id?, advance_date(D?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([balance|UserIn], UserOut?), Ps, N) :-
    ground(Id?) |
    send(msg(person, Id?, balance),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([pay(Friend, Coin, Maturity, Amount)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(Friend?), ground(Coin?), ground(Maturity?), number(Amount?) |
    Count := integer(Amount?),
    send(msg(person, Id?, pay(Friend?, lot(Coin?, Maturity?, Count?))),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

%% The maturity-carrying swap — a loan is its instance.  Scalar single-lot UI
%% form; the mediator builds the give and want lots.
ui_mediator(Id, AgentCh,
            ch([trade(Target, GiveCoin, GiveMat, GiveAmt,
                      WantCoin, WantMat, WantAmt)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(Target?),
    ground(GiveCoin?), ground(GiveMat?), number(GiveAmt?),
    ground(WantCoin?), ground(WantMat?), number(WantAmt?) |
    GiveCount := integer(GiveAmt?),
    WantCount := integer(WantAmt?),
    send(msg(person, Id?,
             trade(Target?, lot(GiveCoin?, GiveMat?, GiveCount?),
                            lot(WantCoin?, WantMat?, WantCount?))),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

%% Redeem: present the target's matured coins (holder-gated in the agent).
%% Scalar single-lot UI form; the mediator builds the give and want lots.
ui_mediator(Id, AgentCh,
            ch([redeem(Target, GiveCoin, GiveMat, GiveAmt,
                       WantCoin, WantMat, WantAmt)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(Target?),
    ground(GiveCoin?), ground(GiveMat?), number(GiveAmt?),
    ground(WantCoin?), ground(WantMat?), number(WantAmt?) |
    GiveCount := integer(GiveAmt?),
    WantCount := integer(WantAmt?),
    send(msg(person, Id?,
             redeem(Target?, lot(GiveCoin?, GiveMat?, GiveCount?),
                             lot(WantCoin?, WantMat?, WantCount?))),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([accept_trade(From, ReqId)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, accept_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps1?, N?).

ui_mediator(Id, AgentCh, ch([reject_trade(From, ReqId)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, reject_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps1?, N?).

%% Escrow deposit: scalar single-lot UI form; the mediator builds the lot.
ui_mediator(Id, AgentCh,
            ch([deposit_escrow(Target, Coin, Maturity, Amount, ReleaseTime)|UserIn],
               UserOut?),
            Ps, N) :-
    ground(Id?), ground(Target?),
    ground(Coin?), ground(Maturity?), number(Amount?), ground(ReleaseTime?) |
    Count := integer(Amount?),
    send(msg(person, Id?,
             deposit_escrow(Target?, lot(Coin?, Maturity?, Count?), ReleaseTime?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

%% Cancel an open escrow by its req id — the pending table returns the writer.
ui_mediator(Id, AgentCh, ch([cancel_escrow(Target, ReqId)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(Target?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, cancel_escrow(Target?, Pv?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps1?, N?).

%% --- User-to-agent: group commands ---

ui_mediator(Id, AgentCh, ch([create_group(Name)|UserIn], UserOut?), Ps, N) :-
    ground(Id?), ground(Name?) |
    send(msg(person, Id?, create_group(Name?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([invite_group(GroupId, Invitee)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    send(msg(person, Id?, invite_group(GroupId?, Invitee?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([send_group(GroupId, Text)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(GroupId?), ground(Text?) |
    send(msg(person, Id?, send_group(GroupId?, Text?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([leave_group(GroupId)|UserIn], UserOut?), Ps, N) :-
    ground(Id?), ground(GroupId?) |
    send(msg(person, Id?, leave_group(GroupId?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([remove_from_group(GroupId, Member)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(GroupId?), ground(Member?) |
    send(msg(person, Id?, remove_from_group(GroupId?, Member?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps?, N?).

ui_mediator(Id, AgentCh, ch([accept_group(GroupId, ReqId)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, accept_group(GroupId?, Pv?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps1?, N?).

ui_mediator(Id, AgentCh, ch([reject_group(GroupId, ReqId)|UserIn], UserOut?),
            Ps, N) :-
    ground(Id?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, reject_group(GroupId?, Pv?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, ch(UserIn?, UserOut), Ps1?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

%% Flatten the want-spec, one lot, to scalars for the offer card (multi-lot
%% display is Milestone 2).  The lot stays escrowed in the pending table, so
%% accept_trade replays it.
procedure first_lot(Lot?, Key, Constant, Integer).
first_lot(lot(I, M, A), I?, M?, A?).

procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).
