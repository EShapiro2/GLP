%% A term inside a term at a parameter position: refused, as
%% param_constructed_arg is (TGLP 8a58729, appendix-implementation-notes.tex,
%% "The instantiation of a call").  The call passes w(i(N?)), which names no
%% type, so no site supplies M, and send_user/3 is not parametrically
%% well-typed.  Negative fixture.
%%
%% From 2026-09-20 to 2026-10-02 the callee's own head pair (Msg, Msg?) fixed M
%% to Wrap, the element type of the stream Entry carries, and the program
%% loaded.

Inner ::= i(Constant).
Wrap  ::= w(Inner).
Entry ::= out(Stream(Wrap)?) ; log(Stream(Constant)?).

imported procedure code#emit(Constant?, Stream(Entry)?, Stream(Entry)).

exported procedure run(Constant?, Stream(Entry)?, Stream(Entry)).
run(N, Outs, Outs1?) :- code # emit(N?, Outs?, Outs1).
