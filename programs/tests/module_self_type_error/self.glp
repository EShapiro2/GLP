-module(typeerr).

procedure bad_proc(Integer?, Integer).
bad_proc(X, hello).

%% Entry point (modules.tex sec:static-linking step 5): root self.glp forwards
%% the ill-typed entry, so the whole-program check reaches and rejects it.
imported procedure worker#test(Integer?, Integer).
exported procedure test(Integer?, Integer).
test(X, Y?) :- worker # test(X?, Y).
