%% S6: walker parameterised over the entry type E.
%% The first clause still decomposes a specific functor output/2 of the type
%% parameter E.  (Pass-through clause variable named Ent to avoid clashing with
%% the type parameter E.)

procedure put(Constant?, Constant?, Stream(E)?, Stream(E)).
put(Key, Msg, [output(K, [Msg?|Out1?])|Rest], [output(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
put(Key, Msg, [Ent|Rest], [Ent?|Rest1?]) :-
    otherwise |
    put(Key?, Msg?, Rest?, Rest1).
put(_, _, [], []).

%% Entry point (modules.tex sec:static-linking step 5): root self.glp forwards.
%% MyEntry is lifted here so the entry signature is visible at the forwarder.
MyEntry ::= output(Constant, Stream(Constant)?) ; extra(Constant) ; more(Integer).
imported procedure param_client#run(Stream(MyEntry), Stream(Constant)).
exported procedure run(Stream(MyEntry), Stream(Constant)).
run(R?, S?) :- param_client # run(R, S).
