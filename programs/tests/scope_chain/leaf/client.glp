
%% S2: project load of a leaf whose utility (pmerge) lives in an ancestor
%% self.glp ABOVE the load point (scope_chain/self.glp).
exported procedure test_merge(Stream(Integer)).
test_merge(Z?) :- pmerge([1, 2, 3], [4, 5, 6], Z).

%% S3: two distinct instantiations of the parameterised utility in one module
%% (X = Integer and X = Constant).
exported procedure test_both(Stream(Integer), Stream(Constant)).
test_both(Zi?, Zc?) :-
    pmerge([1, 2, 3], [4, 5, 6], Zi),
    pmerge(["a", "b"], ["c", "d"], Zc).

%% S8: declaration instantiates a parameterised type from the intermediate
%% ancestor (scope_chain/self.glp) — a goal on wrap_all needs it in the REPL
%% goal-check environment (modules.tex §Scope construction).
exported procedure wrap_all(Stream(Integer)?, Stream(Wrap(Integer))).
wrap_all([], []).
wrap_all([X|Xs], [wrap(X?)|Ws?]) :- wrap_all(Xs?, Ws).
