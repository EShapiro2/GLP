%% The program's interface (TGLP modules.tex, External access): test_shadow/1,
%% forwarded to shadower.glp, which defines it.  A directory with no self.glp
%% is not a program ("Entry and the absence of a boot module"); until
%% 2026-10-02 this one had none and took shadower.glp's exported test_shadow/1
%% for its entry point.
imported procedure shadower#test_shadow(Stream(Integer)).
exported procedure test_shadow(Stream(Integer)).
test_shadow(Z?) :- shadower # test_shadow(Z).
