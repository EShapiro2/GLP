%% Test module with 3 exported procedures.
%% Used to verify _select/1 dispatch table generation.
-module(math_service).

exported procedure double(Integer?, Integer).
double(X, Y?) :- Y := X? * 2.

exported procedure triple(Integer?, Integer).
triple(X, Y?) :- Y := X? * 3.

exported procedure add_ten(Integer?, Integer).
add_ten(X, Y?) :- Y := X? + 10.
