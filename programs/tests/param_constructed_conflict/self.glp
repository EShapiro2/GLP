%% Two constructed arguments at one parameter M, neither naming a type: no site
%% supplies M, send2/4 is not parametrically well-typed, and the call is
%% refused, naming M (TGLP 8a58729, appendix-implementation-notes.tex, "The
%% instantiation of a call").  Negative fixture.
%%
%% From 2026-09-20 to 2026-10-02 the callee's own head pair (A, A?) fixed M to
%% Msg, and the call was refused for bad(N?), which Msg does not admit.  A
%% constructed argument the binding its sites supply does not admit is
%% programs/tests/call_instantiation/constructed_not_admitted.glp.

Msg   ::= m(Constant).
Entry ::= out(Stream(Msg)?) ; log(Stream(Constant)?).

imported procedure code#go(Constant?, Stream(Entry)?, Stream(Entry)).

exported procedure run(Constant?, Stream(Entry)?, Stream(Entry)).
run(N, Outs, Outs1?) :- code # go(N?, Outs?, Outs1).
