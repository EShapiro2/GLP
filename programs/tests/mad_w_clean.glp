%% mad_w_clean.glp — cross-isolate `_w` carried through a channel whose Out
%% position is closed.  It is mad_w_probe.glp with `ch(S?, closed)` in place of
%% `ch(S?, _)`, and that one line is the whole difference between them.
%%
%% No agent/4, no mediator, no UI. Alice MAD-sends a bare writer (wrapped in
%% w/1) to Bob. Bob's producer matches it against the nested READER pattern
%% w(W?) and forwards it onto a local channel stream; Bob's consumer pulls it
%% back with receive/3 into the nested reader pattern wrapped(Y?).
%%
%% What it reports, and what each report means:
%%
%%   bob_produced     => a `_w`-backed reader DID match a nested clause head.
%%                       This is the `_w` admissibility the file was built to
%%                       test, and it holds. The social-graph failure that
%%                       prompted the probe is elsewhere.
%%   bob_ch_matched   => receive/3 committed, because Out carries a constant.
%%
%% The second report is about the channel, not about `_w`. receive/3's unit
%% clause is receive(X?, ch([X|In], Out?), ch(In?, Out)): the Out position is a
%% READER there, so a constant at Out lets the guard succeed. mad_w_probe.glp
%% supplies an unassigned writer there instead and reports bob_ch_otherwise.
%% That is what these two fixtures distinguish.
%%
%% Run via glp_multiagent/test/mad_w_clean_test.dart (two isolates).


%% What crosses: a bare writer of Done wrapped in w/1, addressed as msg/2; what
%% bob forwards onto its channel: the same writer wrapped in wrapped/1.  A `?`
%% at a type position is where a writer travels inside a value.  Typed
%% concretely since 2026-09-18: over parameters, bob_producer/2 and
%% bob_consumer/1 inspected them and no call instantiated them, so their
%% clauses were checked by nothing (TGLP, sec:abstract-parameters).
Done     ::= done.
Probe    ::= w(Done?).
ProbeMsg ::= msg(Constant, Probe).
Carried  ::= wrapped(Done?).

procedure agent_init(Constant?, Stream(_)?, Stream(ProbeMsg)?).

%% Alice: transmit a fresh writer to bob, wrapped in w/1.
agent_init(alice, _, _) :-
    send_to_net([msg(bob, w(_))]).

%% Bob: receive w(W) from net; a "producer" process forwards W (writer) onto a
%% local channel stream; a concurrent "consumer" process pulls it back off with
%% the real receive/3 channel op into a nested reader pattern wrapped(Y?) — the
%% exact mechanism the mediator uses (receive(msg(..,befriend(From,Resp?)),..)).
agent_init(bob, _, NetIn) :-
    bob_producer(NetIn?, S),
    bob_consumer(ch(S?, closed)).

%% Capture the _w reader, forward it as a writer onto the channel stream S.
procedure bob_producer(Stream(ProbeMsg)?, Stream(Carried)).
bob_producer([msg(_, w(W?)) | _], [wrapped(W)]) :- send_to_user([bob_produced]).
bob_producer([], []) :- send_to_user([bob_empty]).

%% Pull it back with receive/3 into a nested reader pattern.
procedure bob_consumer(Channel(Stream(Carried), Constant)?).
bob_consumer(Ch) :- receive(wrapped(Y?), Ch?, Ch1) | send_to_user([bob_ch_matched]), fill(Y), drop(Ch1?).
bob_consumer(_) :- otherwise | send_to_user([bob_ch_otherwise]).

procedure drop(_?).
drop(_).

procedure fill(_).
fill(done).
