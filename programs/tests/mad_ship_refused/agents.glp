%% mad_ship_refused/agents.glp --- the two agents of ../mad_ship_refused_boot.glp.

%% alice ships bob her own module value, refused a certificate, then after.
exported procedure alice_init(_?, _?).
alice_init(_, _) :-
    self_module(M),
    send_to_net([msg(bob, ship(M?)), msg(bob, after)]).

%% bob reports each message he receives: a module, or the atom after.
exported procedure bob_init(_?, _?).
bob_init(_, In) :- report(In?).

procedure report(_?).
report([msg(_, ship(M)) | In]) :- module(M?) | send_to_user([got_module]), report(In?).
report([msg(_, after) | In]) :- send_to_user([after]), report(In?).
