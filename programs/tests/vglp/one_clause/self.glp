%% self.glp --- the one-clause program of programs/tests/vglp: the plays of
%% responder.vglp, its questions put to a scripted person through the
%% dispatcher and the construct processes, for Section VG of
%% test/run_all_tests.sh, and the entry by which the Dart bridge runs it, for
%% glp_multiagent/test/bridge_test.dart (vGLP, sections/elicitation.tex,
%% Definition "Canonical Compilation" and the paragraph before it).
%%
%% Each play spawns the compiled goal with its ask stream and the dispatcher
%% on that stream and on the person channel, as whatever spawns an agent's
%% initial goal does; none of these goals has a person channel of its own, so
%% the program's end of one, the dispatcher's third argument, is dropped.  On
%% each ask the dispatcher spawns the construct process of its question,
%% which draws its widget and the card the clause writes, draw(Id, W, V), the
%% person's position marked input(Q), and withdraws once the question is
%% answered, withdraw(Id).  The person grants input(Id, Q, R) only after the
%% draw that gives it Id and Q, and logs what it sees.  The person channel
%% never closes (Definition "Person Channel, Person Writer, GLP with Persons,
%% Grant"), so a person holds its writer for good, watching after the last
%% withdrawal, and its log stays open.
%%
%% Each play gives the decisions of its procedure, D, and the person's log,
%% Log: an answer reaches its clause (play_answer); a refusal is an answer,
%% no, which respond's clause takes as it takes yes (play_decline); a grant
%% that forms no term of the question's type answers nothing, and the next
%% that forms one answers it (play_mismatch); greet's card is written before
%% the person gives a name, its clause guarded only on what the program
%% writes (play_greet); and pick's one clause takes the person's choice
%% (play_pick).  Until 2026-10-12 a fourth play aborted pick's open ask by
%% its ordinary clause; the paper has no abort: "A reader the program drops
%% leaves its construct on screen, showing what the program writes into it,
%% until the person's input, which dismisses the question (Dismiss) and
%% withdraws it" (Definition "Canonical Compilation", the paragraph before
%% it), and pick has no ordinary clause (Definition "Volitional Procedure,
%% ...").
%%
%% The types of responder.vglp and those its compilation adds, written again
%% for the declarations of the procedures imported from its compiled module;
%% type identity is structural, and the module's own shadow these within it.


%% The program's output to its person, the reserved type Output (vGLP
%% 169b008, Definition "Canonical Compilation"): the decisions.
Output   ::= Decision.

imported procedure responder#respond(Offer?, Stream(Decision),
    Stream(Ask(Question))).
imported procedure responder#greet(Offer?, Stream(Decision),
    Stream(Ask(Question))).
imported procedure responder#pick(Offer?, Stream(Decision),
    Stream(Ask(Question))).
imported procedure responder#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

%% ---------------------------------------------------------------------------
%% The plays
%% ---------------------------------------------------------------------------

%% The person answers respond's card yes.
exported procedure play_answer(Stream(Decision), Stream(_)).
play_answer(D?, Log?) :-
    responder # respond(offer(bob), D, Asks),
    responder # dispatch(Asks?, ch(Gs?, Ds), _),
    person(Ds?, [yes], Gs, Log).

%% The person declines respond's card: the refusal is an answer, no.
exported procedure play_decline(Stream(Decision), Stream(_)).
play_decline(D?, Log?) :-
    responder # respond(offer(bob), D, Asks),
    responder # dispatch(Asks?, ch(Gs?, Ds), _),
    person(Ds?, [no], Gs, Log).

%% The person first grants nobody, which forms no YesNo and answers nothing,
%% and then yes.
exported procedure play_mismatch(Stream(Decision), Stream(_)).
play_mismatch(D?, Log?) :-
    responder # respond(offer(bob), D, Asks),
    responder # dispatch(Asks?, ch(Gs?, Ds), _),
    person(Ds?, [nobody, yes], Gs, Log).

%% The person sees greet's card, the offering peer shown, and gives a name.
exported procedure play_greet(Stream(Decision), Stream(_)).
play_greet(D?, Log?) :-
    responder # greet(offer(bob), D, Asks),
    responder # dispatch(Asks?, ch(Gs?, Ds), _),
    person(Ds?, [alice], Gs, Log).

%% The person sees pick's card and gives a choice.
exported procedure play_pick(Stream(Decision), Stream(_)).
play_pick(D?, Log?) :-
    responder # pick(offer(bob), D, Asks),
    responder # dispatch(Asks?, ch(Gs?, Ds), _),
    person(Ds?, [go], Gs, Log).

%% The person sees respond's card and grants refresh, an Input addressed to
%% no construct, on which the dispatcher has every construct, and construct 0,
%% draw again what it last drew (vGLP d433f71, Section 6.3: "Input(T) ::=
%% input(Integer, Path, T) ; refresh", "on refresh it has every construct
%% process, and construct 0, draw again what it last drew, so the screen is
%% redrawn whole"), and then answers it yes: the card and the output are each
%% drawn twice, the refresh answering nothing.
%% The log of play_refresh: each construct drawn, by its identifier, each
%% time it is drawn, and each withdrawn.
RLog ::= drawn(Integer) ; withdrawn(Integer).

exported procedure play_refresh(Stream(Decision), Stream(RLog)).
play_refresh(D?, Log?) :-
    responder # respond(offer(bob), D, Asks),
    responder # dispatch(Asks?, ch(Gs?, Ds), _),
    person_refresh(Ds?, Gs, Log).

%% person_refresh(Ds?, Gs, Log): at the first draw of a card with the
%% person's position marked input(Q), grant refresh and then yes at Q; log
%% every draw and withdrawal.
procedure person_refresh(PersonOut(Drawn)?, PersonIn(Drawn), Stream(RLog)).
person_refresh([draw(Id, _, card_w(card(_, input(Q)))) | Ds],
       [refresh, input(Id?, Q?, yes) | Gs?], [drawn(Id?) | Log?]) :-
    ground(Id?), ground(Q?) |
    watching_ids(Ds?, Gs, Log).
person_refresh([draw(Id, _, _) | Ds], Gs?, [drawn(Id?) | Log?]) :-
    otherwise |
    person_refresh(Ds?, Gs, Log).
person_refresh([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    person_refresh(Ds?, Gs, Log).

%% watching_ids(Ds?, Gs, Log): grant nothing more; log every draw and
%% withdrawal.
procedure watching_ids(PersonOut(Drawn)?, PersonIn(Drawn), Stream(RLog)).
watching_ids([draw(Id, _, _) | Ds], Gs?, [drawn(Id?) | Log?]) :-
    watching_ids(Ds?, Gs, Log).
watching_ids([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    watching_ids(Ds?, Gs, Log).

%% person(Ds?, Rs?, Gs, Log): at the first draw of a card with the person's
%% position marked input(Q), grant each of Rs in turn at Q, and log every
%% draw and withdrawal.
procedure person(_?, List(Drawn)?, PersonIn(Drawn), Stream(_)).
person([draw(Id, W, card_w(card(P, input(Q)))) | Ds], Rs, Gs?,
       [drawn(Id?, W?, card(P?, input(Q?))) | Log?]) :-
    ground(Id?), ground(Q?) |
    grant(Id?, Q?, Rs?, Gs, Gs1?),
    watching(Ds?, Gs1, Log).
person([draw(Id, W, greeting_w(greeting(P, input(Q)))) | Ds], Rs, Gs?,
       [drawn(Id?, W?, greeting(P?, input(Q?))) | Log?]) :-
    ground(Id?), ground(Q?) |
    grant(Id?, Q?, Rs?, Gs, Gs1?),
    watching(Ds?, Gs1, Log).
person([draw(Id, W, choice_w(choice(P, input(Q)))) | Ds], Rs, Gs?,
       [drawn(Id?, W?, choice(P?, input(Q?))) | Log?]) :-
    ground(Id?), ground(Q?) |
    grant(Id?, Q?, Rs?, Gs, Gs1?),
    watching(Ds?, Gs1, Log).
person([draw(Id, W, card_w(V)) | Ds], Rs, Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    otherwise |
    person(Ds?, Rs?, Gs, Log).
person([draw(Id, W, greeting_w(V)) | Ds], Rs, Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    otherwise |
    person(Ds?, Rs?, Gs, Log).
person([draw(Id, W, choice_w(V)) | Ds], Rs, Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    otherwise |
    person(Ds?, Rs?, Gs, Log).
person([draw(Id, W, output(V)) | Ds], Rs, Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    otherwise |
    person(Ds?, Rs?, Gs, Log).
person([withdraw(Id) | Ds], Rs, Gs?, [withdrawn(Id?) | Log?]) :-
    person(Ds?, Rs?, Gs, Log).

%% grant(Id?, Q?, Rs?, Gs, Gs1?): grant each of Rs at position Q of construct
%% Id, the person's grants going on as Gs1.
procedure grant(Integer?, Path?, List(Drawn)?, PersonIn(Drawn), PersonIn(Drawn)?).
grant(Id, Q, [R | Rs], [input(Id?, Q?, R?) | Gs?], Gs1) :-
    ground(Id?), ground(Q?) |
    grant(Id?, Q?, Rs?, Gs, Gs1?).
grant(_, _, [], Gs1?, Gs1).

%% watching(Ds?, Gs, Log): grant nothing more, and log every draw and
%% withdrawal.
procedure watching(_?, PersonIn(Drawn), Stream(_)).
watching([draw(Id, W, card_w(V)) | Ds], Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    watching(Ds?, Gs, Log).
watching([draw(Id, W, greeting_w(V)) | Ds], Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    watching(Ds?, Gs, Log).
watching([draw(Id, W, choice_w(V)) | Ds], Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    watching(Ds?, Gs, Log).
watching([draw(Id, W, output(V)) | Ds], Gs?, [drawn(Id?, W?, V?) | Log?]) :-
    watching(Ds?, Gs, Log).
watching([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    watching(Ds?, Gs, Log).

%% ---------------------------------------------------------------------------
%% The bridge's entry
%% ---------------------------------------------------------------------------

%% The host's entry (glp_runtime/lib/multiagent/agent_runtime.dart): the
%% agent's identifier, the person's input stream and the network input.  The
%% three questions are asked at once, of three peers; the person channel's
%% grants are the person's input, and its draws, merged by the dispatcher
%% with the program's own output to the person --- the decisions --- go to
%% the person by send_to_user/1.  The program reaches no network, and the
%% entry drops its input.
exported procedure responder_init(Constant?, PersonIn(Drawn)?, Stream(_)?).
responder_init(_, Gs, _) :-
    responder # respond(offer(bob), D1, A1),
    responder # greet(offer(carol), D2, A2),
    responder # pick(offer(dana), D3, A3),
    merge(A1?, A2?, A12),
    merge(A12?, A3?, Asks),
    answered(D1?, O1),
    answered(D2?, O2),
    answered(D3?, O3),
    merge(O1?, O2?, O12),
    merge(O12?, O3?, O),
    responder # dispatch(Asks?, ch(Gs?, Ds), MCh),
    to_person(MCh?, O?),
    send_to_user(Ds?).

%% answered(D?, O): each decision of D on O once the person's answer in it is
%% given.  A clause writes its decision when it writes the card, the answer
%% still to come, and send_to_user/1 emits the elements of its stream in
%% order, each once ground: a decision passed on unanswered would hold back
%% every draw and every other decision behind it.
procedure answered(Stream(Decision)?, Stream(Decision)).
answered([X | Xs], [X? | Ys?]) :-
    ground(X?) | answered(Xs?, Ys).
answered([], []).

%% to_person(MCh?, O?): the program's own output to the person, O, on its end
%% of the person channel.
procedure to_person(Channel(Stream(_), Stream(Output))?, Stream(Decision)?).
to_person(ch(_, O?), O).

%% The agent's initial goal, every agent's, agent(ch(_?,_),ch(_?,_)) (GLP-Spec
%% maglp.tex, Definition "Multiagent GLP"; IGLP, Implementation Notes, "Boot":
%% "a deployed agent is spawned by its application with the same initial
%% goal"): the person's first act names the entry the agent runs, and the
%% person's acts after it are that entry's input.
Selected ::= [Constant | PersonIn(Drawn)].

exported procedure agent(Channel(Selected, Stream(Constant))?, Channel(Stream(NetMsg(Constant)), Stream(NetMsg(Constant)))?).
agent(ch([E | Gs], []), ch(N, [])) :- start(E?, Gs?, N?).

procedure start(Constant?, PersonIn(Drawn)?, Stream(NetMsg(Constant))?).
start(responder_init, Gs, N) :- responder_init(bob, Gs?, N?).
