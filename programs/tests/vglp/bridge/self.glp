%% self.glp --- the entries by which the Dart bridge runs widgets.vglp, for
%% its Flutter tests, glp_multiagent/test/bridge_test.dart.
%%
%% vGLP, sections/elicitation.tex, the paragraph "The implementation": the
%% engine runs the compiled program unchanged, "and the bridge draws each
%% construct's widget and returns the person's raw input as grants"; Section
%% "The Grassroots App": "A compiled module M is run by the goals
%%     M # agent(MCh?, NetCh?, Asks), M # dispatch(Asks?, PersonCh?, MCh)
%% with the person channel PersonCh = ch(Grants?, Draws)".  The calls are the
%% compiled module's, as the canonical compilation emits them.
%%
%% Each entry is the host's (glp_runtime/lib/multiagent/agent_runtime.dart):
%% the agent's identifier, the person's input stream and the network input.
%% The person's input is the person channel's grants, Gs, whose writer the
%% host holds and extends with each grant the bridge returns,
%% input(Id, P, R); the person channel's other half, Ds, carries the
%% constructs' draws merged with the program's own output to the person, and
%% goes to the person by send_to_user/1, which hands the host each term as it
%% is ground.  The person channel never closes (Definition "Person Channel,
%% Person Writer, GLP with Persons, Grant"), and neither does the host's
%% person input.  The agents of widgets.vglp reach no network, and the entry
%% drops its input.
%%
%% The types of widgets.vglp and those its compilation adds, written again
%% for the declarations of the procedures imported from its compiled module.


%% The program's output to its person, the reserved type Output (vGLP
%% 169b008, Definition "Canonical Compilation"): each answer, got(Q, X), Q the
%% question's name and X the term the person's answer formed, of the
%% question's type: a constant (Ok, YesNo, String, Integer, Real, Date and
%% Peer, all of them Constant), a Pay or a Request.
Answer   ::= Constant ; Pay ; Request.
Output   ::= got(Constant, Answer).

imported procedure widgets#inputs(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure widgets#forms(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure widgets#cards(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure widgets#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

%% The primitive and constant questions.
exported procedure inputs_init(Constant?, PersonIn(Drawn)?, Stream(_)?).
inputs_init(_, Gs, _) :-
    widgets # inputs(MCh?, Asks),
    widgets # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% The structured questions.
exported procedure forms_init(Constant?, PersonIn(Drawn)?, Stream(_)?).
forms_init(_, Gs, _) :-
    widgets # forms(MCh?, Asks),
    widgets # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% Two cards open at once.
exported procedure cards_init(Constant?, PersonIn(Drawn)?, Stream(_)?).
cards_init(_, Gs, _) :-
    widgets # cards(MCh?, Asks),
    widgets # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% The agent's initial goal, every agent's, agent(ch(_?,_),ch(_?,_)) (GLP-Spec
%% maglp.tex, Definition "Multiagent GLP"; IGLP, Implementation Notes, "Boot":
%% "a deployed agent is spawned by its application with the same initial
%% goal"): the person's first act names the entry the agent runs, and the
%% person's acts after it are that entry's input.
Selected ::= [Constant | PersonIn(Drawn)].

exported procedure agent(Channel(Selected, Stream(Constant))?, Channel(Stream(NetMsg(Constant)), Stream(NetMsg(Constant)))?).
agent(ch([E | Gs], []), ch(N, [])) :- start(E?, Gs?, N?).

procedure start(Constant?, PersonIn(Drawn)?, Stream(NetMsg(Constant))?).
start(inputs_init, Gs, N) :- inputs_init(bob, Gs?, N?).
start(forms_init, Gs, N) :- forms_init(bob, Gs?, N?).
start(cards_init, Gs, N) :- cards_init(bob, Gs?, N?).
