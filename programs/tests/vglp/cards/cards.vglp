%% cards.vglp --- a stream or a list the program writes whose elements hold
%% questions, for the Dart bridge (glp_multiagent/test/bridge_test.dart) and
%% the construct processes (glp_runtime/test/vglp/elicitation_test.dart):
%% vGLP's Task D of 2026-10-11 15:47 UTC (vGLP #8 Cowork, item 2).  Present
%% hands the person each element with the writers inside it (vGLP,
%% sections/vglp.tex, Definition "vmaGLP Transition System"), each such writer
%% a question (Definition "Question"), drawn by Definition "Widget
%% Declaration, Default Widget" (sections/elicitation.tex): the stream as a
%% thread, each element by the widget of its type, each question by the field
%% of its position.  The module is compiled by the canonical compilation as
%% the program loads, and self.glp runs it by the calls of the compiled
%% module.
%%
%% Each agent reads the program's own end of the person channel, MCh, and
%% writes each answer, once the person has given it, on the program's output
%% to the person, got(N, X), N the card's number, which the dispatcher merges
%% with the draws.
%%
%%   Panel           two cards in a list the program writes at once, each
%%                   answered as its own question
%%   Stream(Card)    a stream of cards, its third written once the first two
%%                   are answered
%%   Stream(YesNo?)  a stream the program writes whose elements are
%%                   themselves questions

YesNo   ::= yes ; no.
Card    ::= card(Integer, YesNo?).
Panel   ::= panel(List(Card)).

%% ---------------------------------------------------------------------------
%% The agents
%% ---------------------------------------------------------------------------

%% A panel of two cards.
exported procedure panel(Channel(Stream(_), Stream(_))?).
panel(ch(_, Out?)) :- show(Out).

%% A stream of three cards.
exported procedure deal(Channel(Stream(_), Stream(_))?).
deal(ch(_, Out?)) :- cards(Out).

%% A stream of two yes-or-no questions.
exported procedure votes(Channel(Stream(_), Stream(_))?).
votes(ch(_, Out?)) :- ballot(Out).

%% ---------------------------------------------------------------------------
%% The questions
%% ---------------------------------------------------------------------------

%% The panel shows both cards at once, and the program reads each answer as
%% the person gives it.
procedure (Panel)*show(Stream(_)).
(panel([card(1, A1), card(2, A2)]))*show(Out?) :-
    answered(1, A1?, O1), answered(2, A2?, O2), merge(O1?, O2?, Out).

%% The stream shows two cards, and a third once both are answered; then it
%% ends.
procedure (Stream(Card))*cards(Stream(_)).
([card(1, A1), card(2, A2) | Cs?])*cards(Out?) :-
    third(A1?, A2?, Cs, Out).

procedure third(YesNo?, YesNo?, Stream(Card), Stream(_)).
third(A1, A2, [card(3, A3)], [got(1, A1?), got(2, A2?) | Out?]) :-
    ground(A1?), ground(A2?) | answered(3, A3?, Out).

%% The stream of two questions, each element the person's to write.
procedure (Stream(YesNo?))*ballot(Stream(_)).
([A1, A2])*ballot(Out?) :-
    answered(1, A1?, O1), answered(2, A2?, O2), merge(O1?, O2?, Out).

%% answered(N?, X?, Out): once the person has answered X, write got(N, X) on
%% the program's output to the person, which then closes.
procedure answered(Integer?, YesNo?, Stream(_)).
answered(N, X, [got(N?, X?)]) :- ground(X?) | true.
