%% self.glp --- the entries by which the Dart bridge runs cards.vglp, for its
%% Flutter tests, glp_multiagent/test/bridge_test.dart, and the plays by which
%% a scripted person answers it, for glp_runtime/test/vglp/elicitation_test.dart:
%% vGLP's Task D of 2026-10-11 15:47 UTC (vGLP #8 Cowork, item 2), a stream or
%% a list the program writes whose elements hold questions.
%%
%% Each entry is the host's (glp_runtime/lib/multiagent/agent_runtime.dart),
%% as bridge/self.glp's are: the agent's identifier, the person's input
%% stream and the network input; the person channel's draws, merged with the
%% program's own output to the person, go to the person by send_to_user/1.
%% Each play spawns the compiled goal with the dispatcher on its ask stream
%% and on a person channel whose grants a scripted person writes from the
%% draws it reads, and logs what it reads.  The person channel never closes
%% (vGLP, Definition "Person Channel, Person Writer, GLP with Persons,
%% Grant"), so neither does a log.
%%
%% A grant is input(Id, P, R), P the path of argument indices from the root
%% of the interactive variable's term, the element of a list cell at P with 1
%% at its end and its tail at P with 2 at its end: in the panel the cards'
%% answers are at [1, 1, 2] and [1, 2, 1, 2]; in the stream at [1, 2],
%% [2, 1, 2] and [2, 2, 1, 2].  The scripted person sends back the P it reads
%% in the view.
%%
%% The types of cards.vglp and those its compilation adds, written again for
%% the declarations of the procedures imported from its compiled module.

YesNo    ::= yes ; no.
Card     ::= card(Integer, YesNo?).
Panel    ::= panel(List(Card)).
Question ::= panel_w(Panel) ; stream_card_w(Stream(Card))
           ; stream_yesNo_w(Stream(YesNo?)).
Ask(Q)   ::= ask(Constant, Q).
PersonIn ::= [_ | PersonIn].

imported procedure cards#panel(Channel(Stream(_), Stream(_))?,
    Stream(Ask(Question))).
imported procedure cards#deal(Channel(Stream(_), Stream(_))?,
    Stream(Ask(Question))).
imported procedure cards#votes(Channel(Stream(_), Stream(_))?,
    Stream(Ask(Question))).
imported procedure cards#dispatch(Stream(Ask(Question))?,
    Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_))).

%% ---------------------------------------------------------------------------
%% The bridge's entries
%% ---------------------------------------------------------------------------

%% The panel of two cards.
exported procedure panel_init(Constant?, PersonIn?, Stream(_)?).
panel_init(_, Gs, _) :-
    cards # panel(MCh?, Asks),
    cards # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% The stream of three cards.
exported procedure deal_init(Constant?, PersonIn?, Stream(_)?).
deal_init(_, Gs, _) :-
    cards # deal(MCh?, Asks),
    cards # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% The stream of two yes-or-no questions.
exported procedure votes_init(Constant?, PersonIn?, Stream(_)?).
votes_init(_, Gs, _) :-
    cards # votes(MCh?, Asks),
    cards # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% ---------------------------------------------------------------------------
%% The plays
%% ---------------------------------------------------------------------------

%% The panel: once both cards are drawn, the person answers the second no and
%% then the first yes.
exported procedure play_panel(Stream(_)).
play_panel(Log?) :-
    cards # panel(MCh?, Asks),
    cards # dispatch(Asks?, ch(Gs?, Ds), MCh),
    panel_person(Ds?, Gs, Log).

procedure panel_person(_?, PersonIn, Stream(_)).
panel_person([draw(Id, _, panel([card(1, input(Q1)), card(2, input(Q2))])) | Ds],
             [input(Id?, Q2?, no), input(Id?, Q1?, yes) | Gs?],
             [both(Id?, Q1?, Q2?) | Log?]) :-
    ground(Id?), ground(Q1?), ground(Q2?) |
    panel_person(Ds?, Gs, Log).
panel_person([draw(_, _, V) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    panel_person(Ds?, Gs, Log).
panel_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    panel_person(Ds?, Gs, Log).
panel_person([got(N, X) | Ds], Gs?, [got(N?, X?) | Log?]) :-
    panel_person(Ds?, Gs, Log).

%% The stream: once the first two cards are drawn, the person answers both
%% yes; once the third is drawn, no.
exported procedure play_deal(Stream(_)).
play_deal(Log?) :-
    cards # deal(MCh?, Asks),
    cards # dispatch(Asks?, ch(Gs?, Ds), MCh),
    deal_person(Ds?, Gs, Log).

procedure deal_person(_?, PersonIn, Stream(_)).
deal_person([draw(Id, _, [card(1, input(Q1)), card(2, input(Q2))]) | Ds],
            [input(Id?, Q1?, yes), input(Id?, Q2?, yes) | Gs?],
            [two(Q1?, Q2?) | Log?]) :-
    ground(Id?), ground(Q1?), ground(Q2?) |
    deal_person(Ds?, Gs, Log).
deal_person([draw(Id, _, [card(1, _), card(2, _), card(3, input(Q3))]) | Ds],
            [input(Id?, Q3?, no) | Gs?],
            [three(Q3?) | Log?]) :-
    ground(Id?), ground(Q3?) |
    deal_person(Ds?, Gs, Log).
deal_person([draw(_, _, V) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    deal_person(Ds?, Gs, Log).
deal_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    deal_person(Ds?, Gs, Log).
deal_person([got(N, X) | Ds], Gs?, [got(N?, X?) | Log?]) :-
    deal_person(Ds?, Gs, Log).
