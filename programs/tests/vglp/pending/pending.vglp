%% pending.vglp --- positions the program writes after the ask, for the
%% construct processes (glp_runtime/test/vglp/elicitation_test.dart) and the
%% Dart bridge (glp_multiagent/test/bridge_test.dart).  The output of a
%% question is drawn once written whole: "A construct process has the bridge
%% draw the widget of T once every reader in the output it holds is assigned,
%% with that output and its questions"; and a question is answered only once
%% drawn: "On a grant input(Id, Pos, R) for a question W it holds and has
%% drawn" (vGLP, Section 6.3, "The construct process"; vGLP #24 Cowork,
%% Code_inbox.md, 2026-11-07 17:19 UTC, 6(i)).  From vGLP 118e04d until then
%% each position not yet written whole was drawn pending, the questions
%% beside it offered at once, which this module tested; the directory keeps
%% its name, which the bridge's tests use.
%%
%% Each agent reads its own end of the person channel, MCh, on which the
%% dispatcher passes it every grant that is not input(Id, P, R), and takes
%% from it the person's word that writes what it has left unwritten: peer(P)
%% a peer, word(W) a note.  It writes each answer, once the person has given
%% it, on its output to the person, got(N, X), N the card's number, which the
%% dispatcher merges with the draws.
%%
%%   late    a card whose Peer the program writes after the ask: the peer
%%           the person's word names
%%   deal    a list of three cards, the second's Peer the person's word
%%   board   a list of notes beside a question, its second note's argument
%%           the person's word

Peer  ::= Constant.
YesNo ::= yes ; no.
Card  ::= card(Peer, YesNo?).
Note  ::= note(Constant).
Board ::= board(List(Note), YesNo?).

%% ---------------------------------------------------------------------------
%% The agents
%% ---------------------------------------------------------------------------

%% A card whose Peer the person's word names.
exported procedure late(Channel(Stream(_), Stream(Output))?).
late(ch(In, Out?)) :- peer_of(In?, Peer), respond(Peer?, Out).

%% A list of three cards, the second's Peer the person's word.
exported procedure deal(Channel(Stream(_), Stream(Output))?).
deal(ch(In, Out?)) :- peer_of(In?, Peer), cards(Peer?, Out).

%% A list of notes beside a question, the second note's argument the
%% person's word.
exported procedure board(Channel(Stream(_), Stream(Output))?).
board(ch(In, Out?)) :- word_of(In?, W), notes(W?, Out).

%% ---------------------------------------------------------------------------
%% The questions
%% ---------------------------------------------------------------------------

%% The card is written at once, its Peer whenever the person's word comes.
procedure (Card)*respond(Peer?, Stream(Output)).
(card(Peer?, A))*respond(Peer, Out?) :- answered(0, A?, Out).

%% The list: its first and third cards whole, its second with the Peer still
%% to come.
procedure (List(Card))*cards(Peer?, Stream(Output)).
([card(carol, A1), card(Peer?, A2), card(bob, A3)])*cards(Peer, Out?) :-
    answered(1, A1?, O1),
    answered(2, A2?, O2),
    answered(3, A3?, O3),
    merge(O3?, O2?, O32),
    merge(O32?, O1?, Out).

%% The board: its first note whole, its second written before its argument
%% is.
procedure (Board)*notes(Constant?, Stream(Output)).
(board([note(first), note(W?)], A))*notes(W, Out?) :-
    answered(0, A?, Out).

%% ---------------------------------------------------------------------------
%% Helpers
%% ---------------------------------------------------------------------------

%% peer_of(In?, P): P the peer of the first peer(P) the person sends.  The
%% dispatcher never closes In, the person channel never closing; its type,
%% the dispatcher's, has [], for which no peer comes: nobody.
procedure peer_of(Stream(_)?, Peer).
peer_of([peer(P) | _], P1?) :- constant(P?) | P1 = P?.
peer_of([_ | In], P?) :- otherwise | peer_of(In?, P).
peer_of([], nobody).

%% word_of(In?, W): W the word of the first word(W) the person sends; none,
%% where In closes, as peer_of/2.
procedure word_of(Stream(_)?, Constant).
word_of([word(W) | _], W1?) :- constant(W?) | W1 = W?.
word_of([_ | In], W?) :- otherwise | word_of(In?, W).
word_of([], none).

%% answered(N?, X?, Out): once the person has answered X, got(N, X) on the
%% program's output to the person, which then closes.
procedure answered(Integer?, YesNo?, Stream(Output)).
answered(N, X, [got(N?, X?)]) :- ground(X?) | true.
