%% self.glp --- the entries by which the Dart bridge runs pending.vglp, for its
%% Flutter tests, glp_multiagent/test/bridge_test.dart, and the plays by which
%% a scripted person answers it, for glp_runtime/test/vglp/elicitation_test.dart:
%% the output of a question drawn once written whole (vGLP, Section 6.3, "The
%% construct process"; vGLP #24 Cowork, Code_inbox.md, 2026-11-07 17:19 UTC,
%% 6(i)).
%%
%% Each entry is the host's (glp_runtime/lib/multiagent/agent_runtime.dart),
%% as cards/self.glp's are.  Each play spawns the compiled goal with the
%% dispatcher on its ask stream and on a person channel whose grants a
%% scripted person writes from the draws it reads, and logs what it reads.
%% The person channel never closes (vGLP, Definition "Person Channel, Person
%% Writer, GLP with Persons, Grant"), so neither does a log.  The person
%% grants input(Id, P, R), P the path the view marks input(P), and sends the
%% program its word, peer(P) or word(W).  The person channel carries the
%% grants alone, PersonIn(T) ::= [Input(T) | PersonIn(T)] (vGLP, Section 6.3,
%% Definition "Person Channel, Person Writer, GLP with Persons, Grant"), so
%% the word is not on it: each entry and each play splits what the person
%% sends, the grants onto the person channel and the words onto the program's
%% own input, split_words/3, and gives the program its end, program_end/3.
%% Nothing is drawn of a question before the program has written its output
%% whole, so each person sends the program its word before any draw.
%%
%% The types of pending.vglp and those its compilation adds, written again
%% for the declarations of the procedures imported from its compiled module.

Peer     ::= Constant.
YesNo    ::= yes ; no.
Card     ::= card(Peer, YesNo?).
Note     ::= note(Constant).
Board    ::= board(List(Note), YesNo?).
Question ::= card_w(Card) ; list_card_w(List(Card)) ; board_w(Board).
Ask(Q)   ::= ask(Constant, Q).
Drawn    ::= card_w(_) ; list_card_w(_) ; board_w(_) ; output(List(Output)) ; YesNo.

%% The program's output to its person, the reserved type Output (vGLP
%% 169b008, Definition "Canonical Compilation"): each answer, got(N, X).
Output ::= got(Integer, YesNo).

imported procedure pending#late(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure pending#deal(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure pending#board(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure pending#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

%% ---------------------------------------------------------------------------
%% The bridge's entries
%% ---------------------------------------------------------------------------

%% The card whose Peer the person's word names.
exported procedure late_init(Constant?, Stream(_)?, Stream(_)?).
late_init(_, Us, _) :-
    split_words(Us?, Gs, Ws),
    pending # late(PCh?, Asks),
    pending # dispatch(Asks?, ch(Gs?, Ds), MCh),
    program_end(MCh?, Ws?, PCh),
    send_to_user(Ds?).

%% The list of three cards.
exported procedure deal_init(Constant?, Stream(_)?, Stream(_)?).
deal_init(_, Us, _) :-
    split_words(Us?, Gs, Ws),
    pending # deal(PCh?, Asks),
    pending # dispatch(Asks?, ch(Gs?, Ds), MCh),
    program_end(MCh?, Ws?, PCh),
    send_to_user(Ds?).

%% The list of notes beside a question.
exported procedure board_init(Constant?, Stream(_)?, Stream(_)?).
board_init(_, Us, _) :-
    split_words(Us?, Gs, Ws),
    pending # board(PCh?, Asks),
    pending # dispatch(Asks?, ch(Gs?, Ds), MCh),
    program_end(MCh?, Ws?, PCh),
    send_to_user(Ds?).

%% ---------------------------------------------------------------------------
%% The plays
%% ---------------------------------------------------------------------------

%% The card: the person sends the peer, bob, before anything is drawn of
%% it, and once the card is drawn, whole, with bob in it, answers yes.
exported procedure play_late(Stream(_)).
play_late(Log?) :-
    pending # late(PCh?, Asks),
    pending # dispatch(Asks?, ch(Gs?, Ds), MCh),
    program_end(MCh?, Ws?, PCh),
    outputs(Ds?, Es),
    split_words([peer(bob) | Us?], Gs, Ws),
    late_person(Es?, Us, Log).

procedure late_person(_?, Stream(_), Stream(_)).
late_person([draw(Id, _, card_w(card(bob, input(Q)))) | Ds],
            [input(Id?, Q?, yes) | Gs?], [whole(Id?, Q?) | Log?]) :-
    ground(Id?), ground(Q?) |
    late_person(Ds?, Gs, Log).
late_person([draw(_, _, card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    late_person(Ds?, Gs, Log).
late_person([draw(_, _, list_card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    late_person(Ds?, Gs, Log).
late_person([draw(_, _, board_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    late_person(Ds?, Gs, Log).
late_person([draw(_, _, output(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    late_person(Ds?, Gs, Log).
late_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    late_person(Ds?, Gs, Log).
late_person([got(N, X) | Ds], Gs?, [got(N?, X?) | Log?]) :-
    late_person(Ds?, Gs, Log).

%% The same card, declined: the person sends the peer, bob, before anything
%% is drawn of it, and once the card is drawn, whole, answers no.  (Until
%% vGLP #24 6(i) the person answered it while its Peer was pending.)
exported procedure play_late_answered(Stream(_)).
play_late_answered(Log?) :-
    pending # late(PCh?, Asks),
    pending # dispatch(Asks?, ch(Gs?, Ds), MCh),
    program_end(MCh?, Ws?, PCh),
    outputs(Ds?, Es),
    split_words([peer(bob) | Us?], Gs, Ws),
    early_person(Es?, Us, Log).

procedure early_person(_?, Stream(_), Stream(_)).
early_person([draw(Id, _, card_w(card(bob, input(Q)))) | Ds],
             [input(Id?, Q?, no) | Gs?], [whole(Id?, Q?) | Log?]) :-
    ground(Id?), ground(Q?) |
    early_person(Ds?, Gs, Log).
early_person([draw(_, _, card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    early_person(Ds?, Gs, Log).
early_person([draw(_, _, list_card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    early_person(Ds?, Gs, Log).
early_person([draw(_, _, board_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    early_person(Ds?, Gs, Log).
early_person([draw(_, _, output(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    early_person(Ds?, Gs, Log).
early_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    early_person(Ds?, Gs, Log).
early_person([got(N, X) | Ds], Gs?, [got(N?, X?) | Log?]) :-
    early_person(Ds?, Gs, Log).

%% The list of cards: the person sends the peer, dave, before anything is
%% drawn of it; once the list is drawn, whole, with dave in its second card,
%% answers the third yes, the second no and the first yes.
exported procedure play_deal(Stream(_)).
play_deal(Log?) :-
    pending # deal(PCh?, Asks),
    pending # dispatch(Asks?, ch(Gs?, Ds), MCh),
    program_end(MCh?, Ws?, PCh),
    outputs(Ds?, Es),
    split_words([peer(dave) | Us?], Gs, Ws),
    deal_person(Es?, Us, Log).

procedure deal_person(_?, Stream(_), Stream(_)).
deal_person([draw(Id, _, list_card_w([card(carol, input(Q1)), card(dave, input(Q2)),
                         card(bob, input(Q3))])) | Ds],
            [input(Id?, Q3?, yes), input(Id?, Q2?, no), input(Id?, Q1?, yes) | Gs?],
            [all(Q1?, Q2?, Q3?) | Log?]) :-
    ground(Id?), ground(Q1?), ground(Q2?), ground(Q3?) |
    deal_person(Ds?, Gs, Log).
deal_person([draw(_, _, card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    deal_person(Ds?, Gs, Log).
deal_person([draw(_, _, list_card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    deal_person(Ds?, Gs, Log).
deal_person([draw(_, _, board_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    deal_person(Ds?, Gs, Log).
deal_person([draw(_, _, output(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    deal_person(Ds?, Gs, Log).
deal_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    deal_person(Ds?, Gs, Log).
deal_person([got(N, X) | Ds], Gs?, [got(N?, X?) | Log?]) :-
    deal_person(Ds?, Gs, Log).

%% The board: the person sends the word, second, before anything is drawn of
%% it; once the board is drawn, whole, with its second note in it, answers
%% yes.
exported procedure play_board(Stream(_)).
play_board(Log?) :-
    pending # board(PCh?, Asks),
    pending # dispatch(Asks?, ch(Gs?, Ds), MCh),
    program_end(MCh?, Ws?, PCh),
    outputs(Ds?, Es),
    split_words([word(second) | Us?], Gs, Ws),
    board_person(Es?, Us, Log).

procedure board_person(_?, Stream(_), Stream(_)).
board_person([draw(Id, _, board_w(board([note(first), note(second)], input(Q)))) | Ds],
             [input(Id?, Q?, yes) | Gs?], [whole(Id?, Q?) | Log?]) :-
    ground(Id?), ground(Q?) |
    board_person(Ds?, Gs, Log).
board_person([draw(_, _, card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    board_person(Ds?, Gs, Log).
board_person([draw(_, _, list_card_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    board_person(Ds?, Gs, Log).
board_person([draw(_, _, board_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    board_person(Ds?, Gs, Log).
board_person([draw(_, _, output(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    board_person(Ds?, Gs, Log).
board_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    board_person(Ds?, Gs, Log).
board_person([got(N, X) | Ds], Gs?, [got(N?, X?) | Log?]) :-
    board_person(Ds?, Gs, Log).

%% ---------------------------------------------------------------------------
%% The program's output, read off the thread of construct 0
%% ---------------------------------------------------------------------------

%% outputs(Ds?, Es): what the person channel carries, with the program's
%% output to the person read off the thread the dispatcher draws it as,
%% construct 0, drawn again with every element so far as each arrives: its
%% newest element is the one that came, and the draw with none is no event
%% (vGLP 169b008, Definition "Canonical Compilation"; vGLP, 2026-10-13 19:25
%% UTC, items 2 and 3).  Every other draw and withdrawal passes as it came.
procedure outputs(_?, Stream(_)).
outputs([draw(0, thread(_), output(Ms)) | Ds], Es?) :- newest(Ms?, Ds?, Es).
outputs([E | Ds], [E? | Es?]) :- otherwise | outputs(Ds?, Es).

procedure newest(_?, _?, Stream(_)).
newest([], Ds, Es?) :- outputs(Ds?, Es).
newest([M], Ds, [M? | Es?]) :- outputs(Ds?, Es).
newest([_, M1 | Ms], Ds, Es?) :- newest([M1? | Ms?], Ds?, Es).

%% ---------------------------------------------------------------------------
%% What the person sends: its grants, and its word to the program
%% ---------------------------------------------------------------------------

%% split_words(Us?, Gs, Ws): what the person sends, its grants input(Id, P,
%% R) onto the person channel, Gs, and every other term, its word, onto the
%% program's own input, Ws.
procedure split_words(_?, PersonIn(Drawn), Stream(_)).
split_words([input(Id, P, R) | Us], [input(Id?, P?, R?) | Gs?], Ws?) :-
    split_words(Us?, Gs, Ws).
split_words([W | Us], Gs?, [W? | Ws?]) :-
    otherwise |
    split_words(Us?, Gs, Ws).

%% program_end(MCh?, Ws?, PCh): the program's end of the person channel, as
%% the dispatcher gives it, with the person's words for its input: its output
%% to the person goes to the dispatcher, which draws it as the thread of
%% construct 0.
procedure program_end(Channel(Stream(_), Stream(Output))?, Stream(_)?,
    Channel(Stream(_), Stream(Output))).
program_end(ch(_, Out?), Ws, ch(Ws?, Out)).

%% The agent's initial goal, every agent's, agent(ch(_?,_),ch(_?,_)) (GLP-Spec
%% maglp.tex, Definition "Multiagent GLP"; IGLP, Implementation Notes, "Boot":
%% "a deployed agent is spawned by its application with the same initial
%% goal"): the person's first act names the entry the agent runs, and the
%% person's acts after it are that entry's input: its grants and its words.
Said     ::= Input(Drawn) ; peer(Constant) ; word(Constant).
Saids    ::= [Said | Saids].
Selected ::= [Constant | Saids].

exported procedure agent(Channel(Selected, Stream(Constant))?, Channel(Stream(NetMsg(Constant)), Stream(NetMsg(Constant)))?).
agent(ch([E | Gs], []), ch(N, [])) :- start(E?, Gs?, N?).

procedure start(Constant?, Saids?, Stream(NetMsg(Constant))?).
start(late_init, Gs, N) :- late_init(bob, Gs?, N?).
start(deal_init, Gs, N) :- deal_init(bob, Gs?, N?).
start(board_init, Gs, N) :- board_init(bob, Gs?, N?).
