%% self.glp --- the plays of speech.vglp, its questions put to a scripted
%% person through the dispatcher and the construct processes, for
%% glp_runtime/test/vglp/elicitation_test.dart and Section VG of
%% test/run_all_tests.sh, and the entries by which the Dart bridge runs it,
%% for glp_multiagent/test/bridge_test.dart: recursive interactive types
%% with no mode inversion (vGLP 092c9fe, Definition "Volitional Procedure,
%% Interactive Type"; vGLP #14 Cowork, 2026-10-18 11:50 UTC).
%%
%% Each entry is the host's (glp_runtime/lib/multiagent/agent_runtime.dart),
%% as bridge/self.glp's are: the agent's identifier, the person's input
%% stream and the network input; the person channel's draws, merged with the
%% program's own output to the person, go to the person by send_to_user/1.
%% Each play spawns the compiled goal with the dispatcher on its ask stream
%% and on a person channel whose grants a scripted person writes from the
%% draws it reads, and logs what it reads.  The person channel never closes
%% (vGLP, Definition "Person Channel, Person Writer, GLP with Persons,
%% Grant"), so neither does a log.
%%
%% The types of speech.vglp and those its compilation adds, written again for
%% the declarations of the procedures imported from its compiled module.

YesNo     ::= yes ; no.
SpeechAct ::= speech(Utterance, Key).
Utterance ::= text(String) ; SpeechAct.
Forward   ::= forward(SpeechAct, YesNo?).
Question  ::= speechAct_r(SpeechAct?) ; forward_w(Forward).
Ask(Q)    ::= ask(Constant, Q).
Drawn     ::= speechAct_r(_) ; forward_w(_) ; output(List(Output)) ; SpeechAct ; YesNo.

%% The program's output to its person, the reserved type Output (vGLP
%% 169b008, Definition "Canonical Compilation"): the speech act the person
%% wrote, and their answer on the one the program showed.
Output    ::= said(SpeechAct) ; forwarded(YesNo).

imported procedure speech#say(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure speech#ask(Channel(Stream(_), Stream(Output))?,
    Stream(Ask(Question))).
imported procedure speech#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

%% ---------------------------------------------------------------------------
%% The bridge's entries
%% ---------------------------------------------------------------------------

%% The person writes a speech act.
exported procedure say_init(Constant?, PersonIn(Drawn)?, Stream(_)?).
say_init(_, Gs, _) :-
    speech # say(MCh?, Asks),
    speech # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% The program shows a speech act, and asks whether to forward it.
exported procedure ask_init(Constant?, PersonIn(Drawn)?, Stream(_)?).
ask_init(_, Gs, _) :-
    speech # ask(MCh?, Asks),
    speech # dispatch(Asks?, ch(Gs?, Ds), MCh),
    send_to_user(Ds?).

%% ---------------------------------------------------------------------------
%% The plays
%% ---------------------------------------------------------------------------

%% The person writes a speech act signed twice, hi by alice forwarded by
%% bob, whole, in one grant; the construct process forms it by recursion on
%% the type's definition, and the program receives it.
exported procedure play_say(Stream(_)).
play_say(Log?) :-
    speech # say(MCh?, Asks),
    speech # dispatch(Asks?, ch(Gs?, Ds), MCh),
    outputs(Ds?, Es),
    saying_person(Es?, Gs, Log).

procedure saying_person(_?, PersonIn(Drawn), Stream(_)).
saying_person([draw(Id, W, speechAct_r(input(Q))) | Ds],
              [input(Id?, Q?, speech(speech(text("hi"), alice), bob)) | Gs?],
              [drawn(Id?, W?, input(Q?)) | Log?]) :-
    ground(Id?), ground(W?), ground(Q?) |
    saying_person(Ds?, Gs, Log).
saying_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    ground(Id?) |
    saying_person(Ds?, Gs, Log).
saying_person([said(S) | Ds], Gs?, [said(S?) | Log?]) :-
    ground(S?) |
    saying_person(Ds?, Gs, Log).

%% The person's first grant, a term of the person channel's type that forms
%% no speech act, answers nothing; the second, a speech act, answers the
%% question.
exported procedure play_say_refused(Stream(_)).
play_say_refused(Log?) :-
    speech # say(MCh?, Asks),
    speech # dispatch(Asks?, ch(Gs?, Ds), MCh),
    outputs(Ds?, Es),
    retrying_person(Es?, Gs, Log).

procedure retrying_person(_?, PersonIn(Drawn), Stream(_)).
retrying_person([draw(Id, W, speechAct_r(input(Q))) | Ds],
                [input(Id?, Q?, no),
                 input(Id?, Q?, speech(text("hi"), carol)) | Gs?],
                [drawn(Id?, W?, input(Q?)) | Log?]) :-
    ground(Id?), ground(W?), ground(Q?) |
    retrying_person(Ds?, Gs, Log).
retrying_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    ground(Id?) |
    retrying_person(Ds?, Gs, Log).
retrying_person([said(S) | Ds], Gs?, [said(S?) | Log?]) :-
    ground(S?) |
    retrying_person(Ds?, Gs, Log).

%% The program shows a speech act signed twice, drawn whole --- pending until
%% the asking clause's argument reaches the construct, then whole, never a
%% part of it --- and the person answers yes beside it.
exported procedure play_forward(Stream(_)).
play_forward(Log?) :-
    speech # ask(MCh?, Asks),
    speech # dispatch(Asks?, ch(Gs?, Ds), MCh),
    outputs(Ds?, Es),
    forwarding_person(Es?, Gs, Log).

procedure forwarding_person(_?, PersonIn(Drawn), Stream(_)).
forwarding_person([draw(Id, W, forward_w(forward(S, input(Q)))) | Ds],
                  [input(Id?, Q?, yes) | Gs?],
                  [drawn(Id?, W?, S?, input(Q?)) | Log?]) :-
    ground(Id?), ground(W?), ground(S?), ground(Q?) |
    forwarding_person(Ds?, Gs, Log).
forwarding_person([draw(_, _, forward_w(V)) | Ds], Gs?, [view(V?) | Log?]) :-
    otherwise |
    forwarding_person(Ds?, Gs, Log).
forwarding_person([withdraw(Id) | Ds], Gs?, [withdrawn(Id?) | Log?]) :-
    ground(Id?) |
    forwarding_person(Ds?, Gs, Log).
forwarding_person([forwarded(A) | Ds], Gs?, [forwarded(A?) | Log?]) :-
    ground(A?) |
    forwarding_person(Ds?, Gs, Log).

%% ---------------------------------------------------------------------------
%% The program's output, read off the thread of construct 0
%% ---------------------------------------------------------------------------

%% outputs(Ds?, Es): what the person channel carries, with the program's
%% output to the person read off the thread the dispatcher draws it as,
%% construct 0, drawn again with every element so far as each arrives: its
%% newest element is the one that came, and the draw with none is no event
%% (vGLP 169b008, Definition "Canonical Compilation"; cards/self.glp).  Every
%% other draw and withdrawal passes as it came.
procedure outputs(_?, Stream(_)).
outputs([draw(0, thread(_), output(Ms)) | Ds], Es?) :- newest(Ms?, Ds?, Es).
outputs([E | Ds], [E? | Es?]) :- otherwise | outputs(Ds?, Es).

procedure newest(_?, _?, Stream(_)).
newest([], Ds, Es?) :- outputs(Ds?, Es).
newest([M], Ds, [M? | Es?]) :- outputs(Ds?, Es).
newest([_, M1 | Ms], Ds, Es?) :- newest([M1? | Ms?], Ds?, Es).
