%% Questions in both modes outside a population (vGLP at 16b3b54,
%% sections/vglp.tex, the fragments of the currency agent after Definition
%% "Guarded Clause, Volitional Procedure, ..."; sections/elicitation.tex,
%% Definition "Canonical Compilation").  The program declares no population,
%% so each asking clause calls construct(T, X), the construct process: the
%% agent's question is Request in reader mode, the responder's Card in writer
%% mode, and the agent's message clause, whose interactive term is `_`, closes
%% the question it drops.
%%
%% The paper elides the agent's other arguments and its other requests; here
%% the agent carries its identifier, its network input and a stream of the
%% texts it posts, and a request is to post a text or to quit.  The construct
%% process is the interactive runtime's, not yet on disc, so the compiled
%% program is not run.

Peer     ::= Constant.
Request  ::= post(String) ; quit.
Offer    ::= offer(Peer).
Response ::= accept(Peer) ; refuse(Peer).
YesNo    ::= yes ; no.
Card     ::= card(Peer, YesNo?).
Content  ::= friend_request(Peer, Response?).
Msg      ::= msg(Peer, Content).

procedure (Request?)*agent(Peer?, Stream(Msg)?, Stream(String)).

%% Post a text.
(post(Text))*agent(Id, NetIn, [Text?|Outs?]) :-
    ground(Id?) | agent(Id?, NetIn?, Outs).

%% Quit.
(quit)*agent(_, _, []).

%% A peer offers friendship: spawn a responder, which asks the person, and go
%% on without the agent's answer.
(_)*agent(Id, [msg(Id1, friend_request(From, Resp?))|NetIn], Outs?) :-
    Id? =?= Id1?, ground(From?) |
    respond_coldcall(offer(From?), Resp),
    agent(Id?, NetIn?, Outs).

procedure (Card)*respond_coldcall(Offer?, Response).

%% Show the person who offers, and pass their answer on.
(card(From?, Answer))*respond_coldcall(offer(From), Resp?) :-
    ground(From?) | decide(Answer?, From?, Resp).

%% yes accepts, no refuses.
procedure decide(YesNo?, Peer?, Response).
decide(yes, From, accept(From?)).
decide(no, From, refuse(From?)).
