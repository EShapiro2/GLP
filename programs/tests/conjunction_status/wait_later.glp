%% A posted conjunction whose early conjunct waits on a later one: p(X?)
%% suspends until q(X) binds X, and the run then completes, so the
%% conjunction's status is success --- the status of the whole run at
%% quiescence, as madGLP reports it for an agent (IGLP, madglp.tex), not an
%% aggregate of per-conjunct drains.  GLP's task of 2026-09-27 19:48 UTC.
%% Fixture of glp_runtime/test/engine/conjunction_status_test.dart.

Choice ::= yes ; no.

procedure p(Choice?).
p(yes).
p(no).

procedure q(Choice).
q(yes).

