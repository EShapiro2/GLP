%% programs/tests/neg_srsw_boot/agent_boot.glp
%%
%% Negative fixture: an SRSW violation in the agent program of a multi-isolate
%% boot with no program directory --- REPL :boot, IsolateManager on a
%% BootConfig alone --- the agent program being what follows the boot clause.
%% GLP-Spec glp.tex, Definition "GLP Program, Goals": "A clause C satisfies the
%% single-reader/single-writer (SRSW) restriction if it satisfies SO", and
%% Definition "Single-Occurrence (SO) Invariant": "every variable occurs in it
%% at most once".  Id? occurs twice in the body, under no guard that implies
%% it ground (Remark "Guards and SRSW"), and _ is no ground type, so the
%% agent's load is refused and the boot fails.  agent.glp beside it is the
%% same agent program as a module file, the one program an AgentRuntime runs.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, ch(_?, _))@alice.
procedure agent_init(_?, _?).
agent_init(Id, _) :- send_to_user([hello(Id?), again(Id?)]).

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)) (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/2, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name, by which agent/2 starts the agent's program on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network.
exported procedure(X) agent(Channel(Stream(Constant), Stream(Constant))?, Channel(Stream(NetMsg(X)), Stream(NetMsg(X)))?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The agent's program, by the name its person tells it.
procedure(X) start(Stream(Constant)?, Stream(NetMsg(X))?).
start([alice | _], N) :- agent_init(alice, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name, and reads nothing.
exported procedure say(Constant?, Channel(Stream(Constant), Stream(Constant))?).
say(P, ch(_, [P?])).
