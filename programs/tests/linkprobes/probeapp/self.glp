%% probeapp/self.glp --- the smallest certified mini-app: given one end of a
%% channel, it writes a greeting and a fresh probe on it and hands its holder
%% the probe's reader.  It calls nothing reaching the network or the person, so
%% it is certified and can be activated by run/3 (../runprobe).

Inner ::= probe(String?) ; hello.
InnerStream ::= [] ; [Inner | InnerStream].
InnerChannel ::= ch(InnerStream, InnerStream?).

exported procedure pa(InnerChannel?, String).
pa(ch(_, Out?), W?) :- fill(Out, W).

procedure fill(InnerStream, String).
fill([hello, probe(W) | []], W?).
