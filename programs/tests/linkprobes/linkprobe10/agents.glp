%% linkprobe10/agents.glp --- TWO CROSSINGS, the write split: this was the
%% warm call's stop (SGSG item 9 / 17 (c)), and it works since the repair of
%% 2026-09-08.  linkprobe7's two crossings with linkprobe9's later write:
%% alice greets on the second channel, and in a LATER reduction puts probe(W)
%% on the tail.  Before the repair bob saw the greeting and nothing after it,
%% so he never assigned and alice never got the value: the later element was
%% produced and never sent (glp_runtime/lib/runtime/heap_fcp.dart,
%% fireBoundCallbacks).  Expected, and what happens: [bob] saw(hello),
%% saw(probe), [alice] got(hi).  linkprobe11 shows the later element need not
%% carry a writer, linkprobe12 that the closing of the stream is not it.
%% See ../linkprobes.md.

Inner ::= probe(String?) ; hello.
InnerStream ::= [] ; [Inner | InnerStream].
InnerChannel ::= ch(InnerStream, InnerStream?).

Mid ::= root(InnerChannel) ; midping.
MidStream ::= [] ; [Mid | MidStream].
MidChannel ::= ch(MidStream, MidStream?).

Outer ::= chan(MidChannel) ; ping.
OuterStream ::= [] ; [Outer | OuterStream].

exported procedure alice_init(_?, _?).
alice_init(_, _) :-
    send_to_net([msg(bob, stream(S?))]),
    new_channel(MidMine, MidTheirs),
    fill_outer(S, MidTheirs?),
    new_channel(RootMine, RootTheirs),
    send_root(MidMine?, RootTheirs?),
    write_end(RootMine?, W),
    wait_value(W?).

procedure fill_outer(OuterStream, MidChannel?).
fill_outer([ping, chan(T?) | []], T).

%% send_root(Mid, Root): the root channel's end on the friend channel.
procedure send_root(MidChannel?, InnerChannel?).
send_root(ch(_, Out?), R) :- fill_mid(Out, R?).

procedure fill_mid(MidStream, InnerChannel?).
fill_mid([midping, root(R?) | []], R).


%% write_end(Ch, W): hello and a fresh probe on the root channel.
procedure write_end(InnerChannel?, String).
write_end(ch(_, Out?), W?) :-
    greet(Out, Out2?),
    probe_later(Out2, W).

%% The greeting, the caller keeping the writer of the rest.
procedure greet(InnerStream, InnerStream?).
greet([hello | Out2?], Out2).

%% The probe, in a later reduction, on the tail.
procedure probe_later(InnerStream, String).
probe_later([probe(W) | []], W?).

procedure wait_value(String?).
wait_value(V) :- ground(V?) | send_to_user([got(V?)]).

exported procedure bob_init(_?, _?).
bob_init(_, [msg(_, stream(S)) | _]) :-
    read_outer(S?).

procedure read_outer(OuterStream?).
read_outer([ping | S]) :- send_to_user([saw(ping)]), read_outer(S?).
read_outer([chan(C) | S]) :- send_to_user([saw(chan)]), read_mid(C?), read_outer(S?).
read_outer([]).

procedure read_mid(MidChannel?).
read_mid(ch(In, _?)) :- read_mid_stream(In?).

procedure read_mid_stream(MidStream?).
read_mid_stream([midping | S]) :- send_to_user([saw(midping)]), read_mid_stream(S?).
read_mid_stream([root(C) | S]) :- send_to_user([saw(root)]), read_end(C?), read_mid_stream(S?).
read_mid_stream([]).

procedure read_end(InnerChannel?).
read_end(ch(In, _?)) :- read_inner(In?).

procedure read_inner(InnerStream?).
read_inner([hello | S]) :- send_to_user([saw(hello)]), read_inner(S?).
read_inner([probe(W?) | S]) :- send_to_user([saw(probe)]), answer(W), read_inner(S?).
read_inner([]).

procedure answer(String).
answer(hi).
