%% linkprobe9/self.glp --- program interface for
%% ../linkprobe9_boot.glp.

%% The channel and network types, here and not in agents.glp: alice_init/2
%% reads the network stream at this interface too, and a type two modules use
%% is defined at their lowest common ancestor (TGLP modules.tex, Scope
%% construction).
Inner ::= probe(String?) ; hello.
InnerStream ::= [] ; [Inner | InnerStream].
InnerChannel ::= ch(InnerStream, InnerStream?).
NetContent ::= call ; chan(InnerChannel).
NetStream ::= [] ; [NetMsg | NetStream].
NetMsg ::= msg(Constant, NetContent).

imported procedure agents#alice_init(_?, NetStream?).
imported procedure agents#bob_init(_?, _?).

exported procedure alice_init(_?, NetStream?).
alice_init(Id, In) :- agents # alice_init(Id?, In?).

exported procedure bob_init(_?, _?).
bob_init(Id, In) :- agents # bob_init(Id?, In?).
