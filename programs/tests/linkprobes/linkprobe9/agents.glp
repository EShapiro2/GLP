%% linkprobe9/agents.glp --- ONE CROSSING, the write split: WORKS.  bob makes
%% the channel and sends alice its end in a network message (one crossing);
%% alice keeps the end's write stream in a list, greets on it, and puts the
%% probe on the tail in a LATER reduction by matching that list at an input
%% position, which is what the mini-app does with its conversations; bob reads
%% and assigns.  Expected: [bob] saw(hello), saw(probe), [alice] got(hi).
%% See docs/linkprobes.md.

Inner ::= probe(String?) ; hello.
InnerStream ::= [] ; [Inner | InnerStream].
InnerChannel ::= ch(InnerStream, InnerStream?).
NetContent ::= call ; chan(InnerChannel).
NetStream ::= [] ; [NetMsg | NetStream].
NetMsg ::= msg(Constant, NetContent).
Conv ::= conv(InnerStream?).
ConvList ::= [] ; [Conv | ConvList].

exported procedure alice_init(_?, _?).
alice_init(_, In) :-
    send_to_net([msg(bob, call)]),
    alice_wait(In?).

procedure alice_wait(NetStream?).
alice_wait([msg(_, chan(C)) | _]) :-
    keep_end(C?, Convs),
    probe_on(Convs?, Convs1, W),
    hold_convs(Convs1?),
    wait_value(W?).
alice_wait([msg(_, call) | In]) :- alice_wait(In?).
alice_wait([]).

%% keep_end(Ch, Convs): the arrived end's write stream kept in a list, the
%% greeting on it first, as the mini-app's open_out does.
procedure keep_end(InnerChannel?, ConvList).
keep_end(ch(In, Out?), [conv(Out2)]) :- hold_in(In?), greet(Out, Out2?).

procedure greet(InnerStream, InnerStream?).
greet([hello | Out2?], Out2).

%% probe_on(Convs, Convs1, W): the probe put on the kept write stream by
%% matching the list at an input position --- the mini-app's idiom.
procedure probe_on(ConvList?, ConvList, String).
probe_on([conv([probe(W) | Out1?]) | Rest], [conv(Out1) | Rest?], W?).
probe_on([], [], V?) :- hold_v(V).

procedure hold_v(String).
hold_v(X?) :- true.

procedure hold_convs(ConvList?).
hold_convs(X) :- true.

procedure hold_in(InnerStream?).
hold_in(X) :- true.

procedure wait_value(String?).
wait_value(V) :- ground(V?) | send_to_user([got(V?)]).

exported procedure bob_init(_?, _?).
bob_init(_, [msg(_, call) | _]) :-
    new_channel(Mine, Theirs),
    send_chan(Theirs?),
    read_end(Mine?).

procedure send_chan(InnerChannel?).
send_chan(C) :- send_to_net([msg(alice, chan(C?))]).

procedure read_end(InnerChannel?).
read_end(ch(In, Out?)) :- read_inner(In?), hold_out(Out).

procedure hold_out(InnerStream).
hold_out(X?) :- true.

procedure read_inner(InnerStream?).
read_inner([hello | S]) :- send_to_user([saw(hello)]), read_inner(S?).
read_inner([probe(W?) | S]) :- send_to_user([saw(probe)]), answer(W), read_inner(S?).
read_inner([]).

procedure answer(String).
answer(hi).
