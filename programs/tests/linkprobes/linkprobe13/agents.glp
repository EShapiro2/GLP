%% linkprobe13/agents.glp --- A CHANNEL WHOSE TWO ENDS BOTH CROSS, to different agents.  carol first gives alice and bob a stream each, as a cold call does, and then sends one end of a fresh channel to each ON THOSE STREAMS, as the social graph sends an introduction over two friend channels; neither of them made the channel, and no goal of carol's holds either end.  Each of them greets the other on the end it was given and reports what it reads.  This is the introduction of the social graph: the introducer makes the channel and hands an end to each of the two it introduces (core/agent.glp, "User introduces P to Q").
%% carol made the channel, so she anchors every link it is sent on and exchanged each name with the agent she sent it to: no link is held (IGLP madglp-spec.tex, Held Links), and each greeting flows through carol's local pair (IGLP, Lemma "Both Ends Exported").  What happens: alice sees hello_from(bob), bob sees hello_from(alice), and the boot settles with three agents.  Until 2026-10-21 nothing passed: the runtime sent the greeting hello(Me?) with Me's value on a link of its own, which carol forwarded and its holder held (the global_send callback, glp_runtime/lib/multiagent/mad_context.dart).  See ../linkprobes.md.

Greeting ::= hello(Constant).
GreetStream ::= [] ; [Greeting | GreetStream].
GreetChannel ::= ch(GreetStream, GreetStream?).
Outer ::= chan(GreetChannel).
OuterStream ::= [] ; [Outer | OuterStream].
NetContent ::= stream(OuterStream).
NetMsg ::= msg(Constant, NetContent).
NetStream ::= [] ; [NetMsg | NetStream].

exported procedure carol_init(_?, _?).
carol_init(_, _) :-
    send_to_net([msg(alice, stream(SA?))]),
    send_to_net([msg(bob, stream(SB?))]),
    new_channel(ForAlice, ForBob),
    put(SA, ForAlice?),
    put(SB, ForBob?).

%% put(S, C): the channel's end on the stream the friend already holds.
procedure put(OuterStream, GreetChannel?).
put([chan(C?)], C).

exported procedure alice_init(_?, _?).
alice_init(_, [msg(_, stream(S)) | _]) :- await(alice, S?).

exported procedure bob_init(_?, _?).
bob_init(_, [msg(_, stream(S)) | _]) :- await(bob, S?).

procedure await(Constant?, OuterStream?).
await(Me, [chan(C) | _]) :- ground(Me?) | greet(Me?, C?).
await(_, []).

%% greet(Me, Ch): a greeting on the end I was given, and what arrives on it.
procedure greet(Constant?, GreetChannel?).
greet(Me, ch(In, Out?)) :-
    ground(Me?) |
    say(Me?, Out),
    listen(In?).

procedure say(Constant?, GreetStream).
say(Me, [hello(Me?)]).

procedure listen(GreetStream?).
listen([hello(Who) | In]) :- ground(Who?) | send_to_user([saw(hello_from(Who?))]), listen(In?).
listen([]).
