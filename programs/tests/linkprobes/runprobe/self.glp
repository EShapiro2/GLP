%% runprobe/self.glp --- program interface for ../runprobe_boot.glp.

%% The channel and network types, here and not in host.glp: alice_init/2 reads
%% the network stream at this interface too, and a type two modules use is
%% defined at their lowest common ancestor (TGLP modules.tex, Scope
%% construction).
Inner ::= probe(String?) ; hello.
InnerStream ::= [] ; [Inner | InnerStream].
InnerChannel ::= ch(InnerStream, InnerStream?).
NetContent ::= call ; chan(InnerChannel).
NetStream ::= [] ; [NetMsg(NetContent) | NetStream].

imported procedure host#alice_init(_?, NetStream?).
imported procedure host#bob_init(_?, _?).
exported procedure alice_init(_?, NetStream?).
alice_init(Id, In) :- host # alice_init(Id?, In?).
exported procedure bob_init(_?, _?).
bob_init(Id, In) :- host # bob_init(Id?, In?).

%% Every agent's initial goal, agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), is answered by this program: "A boot defines no agent/2: the program it loads answers the initial goal, in a simulation as on a phone, and the person goal's first act names the entry the program starts" (IGLP 30c04c5, Implementation Notes, "Boot").  The person's first act, init(Entry, Me, Ps), names the entry, with the agent's own key and the keys of the peers its person knows.
PersonSays ::= init(Constant, Key, List(Key)).

exported procedure agent(Channel(Stream(PersonSays), Stream(Constant))?, Channel(NetStream, Stream(NetMsg(NetContent)))?).
agent(ch(In, []), ch(N, [])) :- start(In?, N?).

%% The agent's program, by the role its person tells it, with its own key and its peers' keys, keys(Me, Ps).
procedure start(Stream(PersonSays)?, NetStream?).
start([init(alice_init, Me, Ps) | _], N) :- alice_init(keys(Me?, Ps?), N?).
start([init(bob_init, Me, Ps) | _], N) :- bob_init(keys(Me?, Ps?), N?).
start(_, _) :- otherwise | true.
