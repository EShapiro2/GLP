%% The activating goal at a template of two type parameters, X and Y, both in
%% the type of one position, Pair(X, Y) ::= pair(X, Y, Integer): a variable of
%% type Bad, with Opaque also where Pair has Integer, stands there.  Bad is
%% not T° for T = Pair(h_1, h_2), whose T° has Integer at that place, so the
%% goal is refused (TGLP modules.tex, "Opaque types": "a variable of type T°
%% may stand at a position typed T, for a type T whose opaque types are
%% labelled among h_1, ..., h_k").

Pair(X, Y) ::= pair(X, Y, Integer).
Bad ::= pair(Opaque, Opaque, Opaque).

procedure(X, Y) entry(Pair(X, Y)?).
entry(_).

Inv ::= inv(Module, Bad).

procedure host(Inv?).
host(inv(M, P)) :-
    opaque_type(entry/1, M?, Hs),
    find_type(entry/1, Hs?, T),
    run(entry(P?), T?, M?).
