%% INVALID: Mode error - reader at output position
%%
%% Mode trace:
%%   Arg 1 (CounterStream?, ↓):
%%     - Stream element CounterMsg at ↓
%%     - show(Number?) at ↓: combine(↓, ↓) = ↑ (output)
%%     - At ↑, expects writer. State is writer → CORRECT ✓
%%
%%   Arg 2 (Number, ↑):
%%     - At ↑, expects writer
%%     - State? is reader → MODE ERROR (should be State)
%%
%% SRSW: State (writer) and State? (reader) both appear → satisfied ✓
%% But mode is wrong at arg 2.

CounterMsg ::= clear ; show(Number?).
CounterStream ::= [] ; [CounterMsg | CounterStream].

procedure counter(CounterStream?, Number).

%% ERROR: State? at arg 2 is reader but output position expects writer
counter([show(State)|S], State?) :- number(State?) | counter(S?, State?).
counter([], _).
