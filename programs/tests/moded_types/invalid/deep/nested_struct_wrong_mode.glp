%% INVALID: SRSW violation - Value? has no corresponding writer
%%
%% Inner = get(Number) - no embedded ?
%% Outer = wrap(Inner) - no embedded ?
%% At Stream? (input ↓):
%%   - wrap position at ↓
%%   - get position at ↓
%%   - Number position at ↓ (no ? flips)
%%   - At ↓, expects reader → Value? is reader ✓
%%
%% SRSW: Value? is reader but Value never appears → SRSW violation

Inner ::= get(Number).
Outer ::= wrap(Inner).
Stream ::= [] ; [Outer | Stream].

procedure process(Stream?).

%% ERROR: Value? is reader but Value never appears → SRSW violation
process([wrap(get(Value?))|S]) :- process(S?).
process([]).
