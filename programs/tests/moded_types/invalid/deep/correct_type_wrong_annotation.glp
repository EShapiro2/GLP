%% INVALID: SRSW violation - Val has no corresponding reader
%%
%% Mode analysis for query(Number?) at INPUT (↓):
%%   - Number? at ↓: combine(↓, ↓) = ↑ (output), expects writer
%%   - Val is writer at ↑ position → mode CORRECT ✓
%%
%% SRSW analysis:
%%   - Val is writer but Val? never appears → SRSW violation

Request ::= query(Number?).
Stream ::= [] ; [Request | Stream].

procedure answer(Stream?).

%% ERROR: Val is writer but Val? never appears → SRSW violation
answer([query(Val)|S]) :- answer(S?).
answer([]).
