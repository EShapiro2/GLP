%% INVALID: Embedded mode error - tests involution property
%% Expected: Mode error due to writer at involution output position
%%
%% Msg? (↓) + Number? (↓) = ↑ (output via involution)
%% At involution output (response slot), head expects READER
%% But X is writer = MODE ERROR (should be X?)
%% SRSW is fine: X in head, X? in body

Msg ::= request(Number?).

procedure handle(Msg?).
procedure produce(Number).

%% ERROR: X is writer at response slot position (should be X?)
%% Compare to valid test that would have handle(request(X?)) :- produce(X).
handle(request(X)) :- produce(X?).

produce(0).
