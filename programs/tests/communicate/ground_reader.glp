%% vGLP #13's case (2026-10-15 10:42 UTC): a ground-guarded reader occurring
%% twice in a clause, each occurrence to receive the writer's value, since
%% Communicate keeps the assignment (GLP-Spec 555552c, glp.tex, Remark "Guards
%% and SRSW"; maglp.tex, Communicate; IGLP 84b36fe).  q/1 and r/1 show their
%% person what they receive.  The goal p(a, Y), r(Y?) shows q(a) and r(f(a)).
%% Read by glp_runtime/test/multiagent/communicate_keeps_assignment_test.dart,
%% which runs the same clauses at one agent and at two.  GLP, 2026-10-15 11:00
%% UTC, item 3.
F ::= f(Constant).

procedure p(Constant?, F).
p(X, f(X?)) :- ground(X?) | q(X?).

procedure q(Constant?).
q(V) :- send_to_user([q(V?)]).

procedure r(F?).
r(Y) :- send_to_user([r(Y?)]).
