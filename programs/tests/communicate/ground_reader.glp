%% Read by glp_runtime/test/multiagent/ground_reader_at_reduction_test.dart, which runs the same clauses at one agent and at two.  GLP, 2026-10-15 11:00 UTC, item 3.
F ::= f(Constant).

procedure p(Constant?, F).
p(X, f(X?)) :- ground(X?) | q(X?).

procedure q(Constant?).
q(V) :- send_to_user([q(V?)]).

procedure r(F?).
r(Y) :- send_to_user([r(Y?)]).
