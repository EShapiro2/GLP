% Channel Operations (Program 9 from GLP 2025 paper)
% Channel type is defined in root self.glp as: Channel ::= ch(Stream, Stream?).

procedure(X, Y) send(_?, Channel(X, Y)?, Channel(X, Y)).
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

procedure(X, Y) receive(_, Channel(X, Y)?, Channel(X, Y)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).

procedure(X, Y) new_channel(Channel(X, Y), Channel(X, Y)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).
