%% play_single_heap_roundtrip.glp — discriminator harness (single isolate).
%%
%% Runs the REAL agent/4 (typed_social_agent.glp) and ui_mediator/5
%% (typed_ui_mediator.glp) clauses UNCHANGED. Only the transport is swapped:
%% instead of send_to_net/MAD (cross-isolate), alice's and bob's `_net` output
%% streams are piped directly into each other's `_net` input — one shared heap.
%%
%% Same heap => the cold-call response variable is an ORDINARY local writer,
%% never a `_w` remote reference. So:
%%   - completes (connected on both sides)  => UI .glp correct; the cross-isolate
%%     `_w` writer-return is the fault (madGLP runtime).
%%   - strands the same way (decision eaten by catch-all) => the escrow holds a
%%     reader not a writer; the bug is escrow polarity in the UI .glp.
%%
%% Requires (load order): self.glp, typed_social_agent.glp, typed_ui_mediator.glp
%%
%% Run from glp_runtime/:
%%   printf '/Users/udi/Grassroots/GLP/programs/tests/agent_roundtrip/\ngo.\n:quit\n' | dart run bin/glp_repl.dart


%% In-heap transport: forward every msg on one agent's `_net` output stream to
%% the peer's `_net` input stream. (alice only addresses bob and vice versa.)
procedure pipe(Stream(X)?, Stream(X)).
pipe([M|In], [M?|Out?]) :- pipe(In?, Out).
pipe([], []).

%% Bob's scripted user: bob's FIRST notify is the befriend inbox card; accept it
%% (emit exactly one decision — a closed command list), then collect the rest
%% (connected(alice)) via _output. Ground guards relax the forwarded readers.
procedure bob_user(Stream(UserNotify)?, Stream(UserCmd)).
bob_user([befriend(Who, Req)|Ns], [decision(yes, Who?, Req?)]) :-
    ground(Who?), ground(Req?) |
    send_to_user([bob_got(befriend(Who?, Req?))]),
    collect(bob, Ns?).
bob_user([], []).

%% Alice's scripted user: surface notifies (connected(bob) is the goal).
procedure alice_user(Stream(UserNotify)?).
alice_user(Ns) :- collect(alice, Ns?).

%% Surface every notify on a stream via _output, producing no commands.
procedure collect(Constant?, Stream(UserNotify)?).
collect(Who, [N|Ns]) :- ground(Who?) | send_to_user([got(Who?, N?)]), collect(Who?, Ns?).
collect(_, []).

%% Seed alice's command stream with a single cold call.
procedure alice_cmds(Stream(UserCmd)).
alice_cmds([connect(bob)]).

procedure go.
go :-
    %% Alice node: real agent + real mediator.
    agent(alice, AAgentIn?, ANetIn?,
          [output(person, AA2U) | [output('_net', ANetOut)]]),
    ui_mediator(alice, ch(AA2U?, AAgentIn), ch(ACmds?, AUserOut), [], 1),
    alice_cmds(ACmds),
    alice_user(AUserOut?),
    %% Bob node: real agent + real mediator.
    agent(bob, BAgentIn?, BNetIn?,
          [output(person, BA2U) | [output('_net', BNetOut)]]),
    ui_mediator(bob, ch(BA2U?, BAgentIn), ch(BCmds?, BUserOut), [], 1),
    bob_user(BUserOut?, BCmds),
    %% In-heap network crossbar (replaces send_to_net/MAD).
    pipe(ANetOut?, BNetIn),
    pipe(BNetOut?, ANetIn).
