%% play_madglp_boot.glp - madGLP entry point
%%
%% This is the thin wrapper for madGLP (isolate) testing.
%%
%% Date: 2026-02-13


%% =============================================================================
%% BOOT - Spawns agents on separate isolates
%% =============================================================================
%%
%% The agent code is the program directory play_madglp/, which this boot spawns
%% into; BootConfig.programDir loads it and this boot clause on top.  agent/4
%% and the three actor scripts are reached from there through the -expose
%% directives in this directory's self.glp.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, ch(_?, _))@bob,
    agent(ch(_?, _), ch(_?, _))@charlie,
    say(charlie, ch(_?, _))@charlie.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)) (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/2, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name, by which agent/2 starts the agent's program on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network.
exported procedure agent(Channel(Stream(Constant), Stream(Constant))?, Channel(NetInStream, Stream(NetMsg(NetColdCall)))?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The agent's program, by the name its person tells it.
procedure start(Stream(Constant)?, NetInStream?).
start([alice | _], N) :- agent_init(alice, N?).
start([bob | _], N) :- agent_init(bob, N?).
start([charlie | _], N) :- agent_init(charlie, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name, and reads nothing.
exported procedure say(Constant?, Channel(Stream(Constant), Stream(Constant))?).
say(P, ch(_, [P?])).
