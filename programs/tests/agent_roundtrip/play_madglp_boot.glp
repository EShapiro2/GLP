%% play_madglp_boot.glp - madGLP entry point
%%
%% This is the thin wrapper for madGLP (isolate) testing.
%%
%% Date: 2026-02-13


%% =============================================================================
%% BOOT - Spawns agents on separate isolates
%% =============================================================================
%%
%% The agent code is the program directory play_madglp/, which this boot spawns
%% into; BootConfig.programDir loads it and this boot clause on top.  agent/4
%% and the three actor scripts are reached from there through the -expose
%% directives in this directory's self.glp.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(agent_init(alice), ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(agent_init(bob), ch(_?, _))@bob,
    agent(ch(_?, _), ch(_?, _))@charlie,
    say(agent_init(charlie), ch(_?, _))@charlie.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), which the program, play_madglp/, answers: a boot defines no agent/2, and the person goal's first act names the entry the program starts (IGLP 30c04c5, Implementation Notes, "Boot").  The person scripted at each agent, say/2, run on its person channel in the person's place, tells the agent the entry, agent_init/1, with the agent's name, its ground argument, the agent's key having been made at its spawn, and reads nothing.
SayAct ::= agent_init(Key).

exported procedure say(SayAct?, Channel(Stream(Constant), Stream(SayAct))?).
say(A, ch(_, [A?])).
