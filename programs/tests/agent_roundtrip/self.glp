%% self.glp — shared agent<->mediator protocol types (single source of truth).
%%
%% Imported (as ancestor type scope) by every module in this directory:
%% typed_social_agent.glp and typed_ui_mediator.glp both refer to these types
%% without redefining them. This is what makes §7's "the mediator's types are
%% the boundary, and the boundary is type-safe" claim hold: there is exactly one
%% definition of each shared type, so producer and consumer cannot drift.
%%
%% Polarity convention (typed-glp-manual §15B): a position that FORWARDS a
%% writer through a structure carries `?` in the type. The cold-call response
%% variable's writer flows agent -> mediator (escrow) -> agent (bind_response),
%% so every type position that carries it is `?`-typed.
%%
%% The four exposures below put this directory's agent, actors and mediator in
%% scope for every program beneath it.  A boot converted to a program directory
%% (play_madglp/, play_ui_madglp/) needs them: the ten alternative plays in this
%% directory cannot be one program --- five boot/0, fifteen social_graph/3 over
%% three message protocols --- so each converted boot is its own subdirectory,
%% and its code is reached through these rather than copied into it.

-expose(typed_social_agent).
-expose(typed_actors).
-expose(typed_ui_mediator).
-expose(typed_ui_actors).


Decision ::= yes ; no.
Response ::= accept(FriendChannel) ; no.

%% An argument that holds an agent is a Key --- an agent is named by the
%% public key of a self-chosen key pair (GSG, Sections 3 and 4), and the send
%% kernel is '_send'(_?, GlobalName?, Key?) (GLP-Spec, appendix-guards) --- and
%% every other argument stays Constant: text(Constant) is a message body,
%% req(Constant) a request counter, received(Key, Constant) an agent and a body.
%% This file mirrors social/graph/self.glp, and is narrowed site for site with
%% it (2026-09-18).

%% Friend-to-friend channel (the opaque value escrowed on accept).
%% msg(From, To, Content): two agents; intro(Other, Ch): the agent introduced.
FriendContent ::= response(Response) ; text(Constant) ; intro(Key, FriendChannel).
FriendMsg     ::= msg(Key, Key, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

%% Escrowed opaque values held in the mediator's pending table.  ONLY the
%% response arm forwards a writer, so only it is `?`-typed; a channel is passed
%% as a value, like canonical social/graph, whose PendingValue is
%% `response(Response?) ; channel(IntroChannel) ; error`.  Until 2026-08-03 all
%% three channel positions here carried a `?` they had no use for.
PendingValue ::= response(Response?) ; channel(FriendChannel) ; error.

%% agent -> mediator  (carried on the agent's person output stream).
%% befriend forwards the response WRITER, so its Response slot is `?`-typed;
%% befriend_intro carries a channel as a value and its slot is plain.
AgentContent ::= befriend(Key, Response?)
               ; befriend_intro(Key, Key, FriendChannel)
               ; connected(Key)
               ; rejected
               ; rejected(Key)
               ; received(Key, Constant).

%% mediator -> agent  (mediator's reply to a user action).
%% decision/accept_intro forward the escrowed writer back: PendingValue carries it.
UserContent ::= connect(Key)
              ; decision(Decision, Key, PendingValue)
              ; send(Key, Constant)
              ; introduce(Key, Key)
              ; accept_intro(Key, PendingValue)
              ; reject_intro(Key)
              ; response(Response).

%% agent <-> network cold-call (2-arg msg(Dest, Content)): forwards the writer.
%% intro(From, Resp): the calling agent, which the callee's befriend/2 carries.
NetColdCall ::= intro(Key, Response?).

%% Wrappers for the agent<->mediator channel (gives ui_mediator's agent-facing
%% channel a CONCRETE element type instead of polymorphic Channel(X,Y), so the
%% checker enforces the agent/mediator polarity duality — §5(1)).
AgentMsg ::= msg(Constant, Constant, AgentContent).   %% agent -> mediator
UserMsg  ::= msg(Constant, Constant, UserContent).    %% mediator -> agent

%% The actor's two streams.  Here rather than in typed_actors.glp because a
%% caller in another module has to be able to NAME them: an actor declared
%% Channel(X, Y)? is a parameterised procedure that inspects its parameter, and
%% nothing instantiated X and Y, so until 2026-08-03 not one actor clause was
%% ever type-checked (known-issues Issue 20).
ActorIn  ::= [] ; [AgentMsg|ActorIn].    %% the actor reads
ActorOut ::= [] ; [UserMsg|ActorOut].    %% the actor writes

%% The agent's network side.  OUT carries only the two-argument cold call, the
%% shape send_to_net/1 transports; IN carries that plus every friend message,
%% because accepting a friend merges that friend's stream into it (agent/4's
%% accept_intro and handle_response clauses).  Same split as canonical
%% social/graph/self.glp, which these are named after.
NetOutMsg    ::= msg(Key, NetColdCall).
NetOutStream ::= [] ; [NetOutMsg|NetOutStream].
NetInMsg     ::= msg(Key, NetColdCall)
               ; msg(Key, Key, FriendContent).
NetInStream  ::= [] ; [NetInMsg|NetInStream].

%% The ground Dart-facing protocol between the mediator and whoever plays the
%% user --- the UI actors here, a human in the Flutter app.  Shared, and here
%% rather than in typed_ui_mediator.glp, because the actors are its other end and
%% have to be able to name it: while they could not, every ui_actor procedure was
%% declared over a bare Stream(X) and so was checked by nothing (Issue 20).
ReqId ::= req(Constant).

%% user -> mediator
UserCmd    ::= decision(Decision, Key, ReqId)
             ; accept_intro(Key, ReqId)
             ; reject_intro(Key)
             ; connect(Key)
             ; send(Key, Constant)
             ; introduce(Key, Key).

%% mediator -> user
UserNotify ::= befriend(Key, ReqId)
             ; befriend_intro(Key, Key, ReqId)
             ; connected(Key)
             ; rejected
             ; rejected(Key)
             ; received(Key, Constant).

%% One constructor per output kind, each typed at exactly what it carries.
%% Replaces output(Constant, OutputStream?), whose element type had to be the
%% union of the person, network and friend messages because one list carries one
%% type --- so every consumer got the union and none could be given the arm it
%% actually handles.  Canonical social/graph retired that shape for the same
%% reason (its self.glp: "broke duality"); this directory was the last holdout,
%% and it is why agent/4 could not be declared concretely and so was checked by
%% nothing (known-issues Issue 20).
OutputEntry ::= user_output(ActorIn?)
              ; net_output(NetOutStream?)
              ; friend_output(Key, FriendStream?).
OutputsList ::= [] ; [OutputEntry|OutputsList].
