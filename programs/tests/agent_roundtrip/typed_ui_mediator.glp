%% typed_ui_mediator.glp - Fully typed mediator between agent/4 and Dart UI
%%
%% All I/O between GLP and Dart is ground terms.
%% Agent output may contain unbound variables (e.g., befriend(alice, Resp)).
%% The mediator replaces these with request IDs for the user,
%% stores them in a pending list, and retrieves them when the user responds.
%%
%% Pending entries store opaque variables (Response writers, Channel writers)
%% keyed by request ID. The mediator holds them in escrow until the user
%% responds, then retrieves and forwards them to the agent.
%%
%% Requires: load typed_social_agent.glp first
%%
%% Date: 2026-02-14


%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Every type this protocol uses is shared and defined once in this directory's
%% self.glp: Response, Decision, PendingValue, the Friend* types, the
%% agent<->mediator wrappers (AgentMsg, UserMsg), and the ground Dart-facing
%% protocol (ReqId, UserCmd, UserNotify).  The last three moved there on
%% 2026-08-03: the UI actors are the other end of that protocol and have to be
%% able to NAME them, and while they could not, every ui_actor procedure was
%% declared over a bare Stream(X) and so was checked by nothing (known-issues
%% Issue 20).  Only the pending table stays mediator-local.

%% --- Pending entries (PendingValue is shared, in self.glp) ---
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% UI MEDIATOR - Main loop
%% =============================================================================

%% Agent-facing channel is now CONCRETE (§5(1)): reads AgentMsg, writes UserMsg.
%% User-facing channel reads ground UserCmd, writes ground UserNotify.
exported procedure ui_mediator(Constant?,
                      Channel(Stream(AgentMsg), Stream(UserMsg))?,
                      Channel(Stream(UserCmd), Stream(UserNotify))?,
                      PendingList?, Constant?).

%% --- Agent-to-user: non-ground (replace variable with req ID) ---

%% Cold-call befriend: agent sends befriend(From, Resp)
%% Resp is received from agent, stored in pending as writer.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% Introduction befriend_intro: agent sends befriend_intro(From, Other, Ch)
%% Ch is a Channel (already known, created by introducer).
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person,
                befriend_intro(From, Other, Ch)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Other?) |
    send(befriend_intro(From?, Other?, req(N?)),
         UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), channel(Ch?)) | Ps?], N1?).

%% --- Agent-to-user: ground (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(connected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, rejected),
            AgentCh?, AgentCh1) |
    send(rejected, UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, received(From, Text)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Text?) |
    send(received(From?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (cold-call response) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Dec?), ground(From?),
    ground(ReqId?) |
    lookup_pending(ReqId?, Resp, Ps?, Ps1),
    send(msg(person, Id?, decision(Dec?, From?, Resp?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: accept/reject intro ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_intro(Other, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Ch, Ps?, Ps1),
    send(msg(person, Id?, accept_intro(Other?, Ch?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_intro(Other), UserCh?, UserCh1),
    ground(Id?), ground(Other?) |
    send(msg(person, Id?, reject_intro(Other?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: pass-through commands ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(connect(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg(person, Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(send(Target, Text), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(Text?) |
    send(msg(person, Id?, send(Target?, Text?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(introduce(P, Q), UserCh?, UserCh1),
    ground(Id?), ground(P?), ground(Q?) |
    send(msg(person, Id?, introduce(P?, Q?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

%% lookup_pending: retrieve a stored opaque value by request ID
procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).
