%% typed_actors.glp - Typed actor scripts for the social graph protocol
%%
%% Self-contained actor procedures with procedure declarations (typechecked).
%% Shared by both boot files:
%% - play_dglp_boot.glp (single-isolate REPL)
%% - play_madglp_boot.glp (multi-isolate headless)
%%
%% Requires: load typed_social_agent.glp first
%%
%% Date: 2026-02-13


%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================
%% Duplicated from typed_social_agent.glp because cross-file type
%% references are not supported.

Response ::= accept(FriendChannel) ; no.
Decision ::= yes ; no.
PendingValue ::= response(Response?) ; channel(FriendChannel?) ; error.

%% Friend channel types (duplicated from typed_social_agent.glp)
FriendContent ::= response(Response) ; text(Constant) ; intro(Constant, FriendChannel).
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

AgentContent ::= befriend(Constant, Response)
               ; befriend_intro(Constant, Constant, FriendChannel)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; received(Constant, Constant).

UserContent ::= connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; send(Constant, Constant)
              ; introduce(Constant, Constant)
              ; accept_intro(Constant, PendingValue)
              ; reject_intro(Constant)
              ; response(Response).

%% Messages from agent to user (actor reads these)
AgentMsg ::= msg(Constant, Constant, AgentContent).

%% Messages from user to agent (actor writes these)
UserMsg ::= msg(Constant, Constant, UserContent).

%% Actor input stream (reads AgentMsg)
ActorIn ::= [] ; [AgentMsg|ActorIn].

%% Actor output stream (writes UserMsg)
ActorOut ::= [] ; [UserMsg|ActorOut].

%% =============================================================================
%% ALICE
%% =============================================================================

exported procedure alice_actor(Channel(X, Y)?).
alice_actor(ch(In, [msg(person, alice, connect(bob))|Out?])) :-
    alice_wait_bob_connected(In?, Out).

procedure alice_wait_bob_connected(ActorIn?, ActorOut).
alice_wait_bob_connected([msg(agent, person, connected(bob))|In],
                         [msg(person, alice, send(bob, 'Hi Bob, this is Alice'))|Out?]) :-
    alice_wait_intro(In?, Out).
alice_wait_bob_connected([_|In], Out?) :-
    otherwise | alice_wait_bob_connected(In?, Out).
alice_wait_bob_connected([], []).

procedure alice_wait_intro(ActorIn?, ActorOut).
alice_wait_intro([msg(agent, person, befriend_intro(_, Other, Ch))|In],
                 [msg(person, alice, accept_intro(Other?, Ch?))|Out?]) :-
    ground(Other?) |
    alice_send_to_charlie(In?, Out).
alice_wait_intro([_|In], Out?) :-
    otherwise | alice_wait_intro(In?, Out).
alice_wait_intro([], []).

procedure alice_send_to_charlie(ActorIn?, ActorOut).
alice_send_to_charlie(In, [msg(person, alice, send(charlie, 'Hi Charlie, this is Alice'))|Out?]) :-
    alice_wait_charlie_reply(In?, Out).

procedure alice_wait_charlie_reply(ActorIn?, ActorOut).
alice_wait_charlie_reply([msg(agent, person, received(charlie, _))|_], []).
alice_wait_charlie_reply([_|In], Out?) :-
    otherwise | alice_wait_charlie_reply(In?, Out).
alice_wait_charlie_reply([], []).

%% =============================================================================
%% BOB
%% =============================================================================

exported procedure bob_actor(Channel(X, Y)?).
bob_actor(ch([msg(agent, person, befriend(From, Resp))|In],
             [msg(person, bob, decision(yes, From?, Resp?))|Out?])) :-
    ground(From?) |
    bob_wait_alice_msg(In?, Out).
bob_actor(ch([_|In], Out?)) :-
    otherwise | bob_actor(ch(In?, Out)).

procedure bob_wait_alice_msg(ActorIn?, ActorOut).
bob_wait_alice_msg([msg(agent, person, connected(_))|In], Out?) :-
    bob_wait_alice_msg(In?, Out).
bob_wait_alice_msg([msg(agent, person, received(alice, _))|In],
                   [msg(person, bob, connect(charlie))|Out?]) :-
    bob_wait_charlie_connected(In?, Out).
bob_wait_alice_msg([_|In], Out?) :-
    otherwise | bob_wait_alice_msg(In?, Out).
bob_wait_alice_msg([], []).

procedure bob_wait_charlie_connected(ActorIn?, ActorOut).
bob_wait_charlie_connected([msg(agent, person, connected(charlie))|In], Out?) :-
    bob_wait_charlie_msg(In?, Out).
bob_wait_charlie_connected([_|In], Out?) :-
    otherwise | bob_wait_charlie_connected(In?, Out).
bob_wait_charlie_connected([], []).

procedure bob_wait_charlie_msg(ActorIn?, ActorOut).
bob_wait_charlie_msg([msg(agent, person, received(charlie, _))|_],
                     [msg(person, bob, introduce(alice, charlie))]).
bob_wait_charlie_msg([_|In], Out?) :-
    otherwise | bob_wait_charlie_msg(In?, Out).
bob_wait_charlie_msg([], []).

%% =============================================================================
%% CHARLIE
%% =============================================================================

exported procedure charlie_actor(Channel(X, Y)?).
charlie_actor(ch([msg(agent, person, befriend(From, Resp))|In],
                 [msg(person, charlie, decision(yes, From?, Resp?)),
                  msg(person, charlie, send(bob, 'Hi Bob, this is Charlie'))|Out?])) :-
    ground(From?) |
    charlie_wait_intro(In?, Out).
charlie_actor(ch([_|In], Out?)) :-
    otherwise | charlie_actor(ch(In?, Out)).

procedure charlie_wait_intro(ActorIn?, ActorOut).
charlie_wait_intro([msg(agent, person, befriend_intro(_, Other, Ch))|In],
                   [msg(person, charlie, accept_intro(Other?, Ch?))|Out?]) :-
    ground(Other?) |
    charlie_wait_alice_msg(In?, Out).
charlie_wait_intro([_|In], Out?) :-
    otherwise | charlie_wait_intro(In?, Out).
charlie_wait_intro([], []).

procedure charlie_wait_alice_msg(ActorIn?, ActorOut).
charlie_wait_alice_msg([msg(agent, person, received(alice, _))|_],
                       [msg(person, charlie, send(alice, 'Hi Alice, this is Charlie'))]).
charlie_wait_alice_msg([_|In], Out?) :-
    otherwise | charlie_wait_alice_msg(In?, Out).
charlie_wait_alice_msg([], []).
