%% play_madglp/ — program interface.
%%
%% The entry point named in ../play_madglp_boot.glp is exported here and
%% forwarded to agents.glp.  The boot clause is NOT in this directory:
%% BootLoader strips it on the boot path, but a directory load does not, and its
%% @ atoms would then meet the type checker.
%%
%% agent/4 and the three actor scripts come from the parent directory's
%% -expose, not from copies.

imported procedure agents#agent_init(Key?, NetInStream?).

exported procedure agent_init(Key?, NetInStream?).
agent_init(Id, In) :- agents # agent_init(Id?, In?).

%% Every agent's initial goal, agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), is answered by this program: "A boot defines no agent/2: the program it loads answers the initial goal, in a simulation as on a phone, and the person goal's first act names the entry the program starts" (IGLP 30c04c5, Implementation Notes, "Boot").  The person's first act, agent_init(Name), names the entry, with the agent's name.
StartAct ::= agent_init(Key).

exported procedure agent(Channel(Stream(StartAct), Stream(Constant))?, Channel(NetInStream, Stream(NetMsg(NetColdCall)))?).
%% The agent opens its PAN at its start: the boot harness sets no trust level
%% at spawn (IGLP 45fabfc, "Simulation realisation"), and the agents of the
%% boot contact one another by cold call.
agent(ch(In, []), ch(N, [])) :- declare(trust(pan, open)), start(In?, N?).

%% The entry the person's first act names, on the network input.
procedure start(Stream(StartAct)?, NetInStream?).
start([agent_init(P) | _], N) :- agent_init(P?, N?).
start(_, _) :- otherwise | true.
