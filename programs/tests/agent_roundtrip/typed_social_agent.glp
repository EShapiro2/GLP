%% typed_social_agent.glp - Fully typed social agent
%%
%% Typed version of social_agent.glp with precise message types.
%% Channel operations use root self.glp Channel ::= ch(Stream, Stream?).
%%
%% Date: 2026-02-13


%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Stream and Channel are predefined in root self.glp:
%%   Stream ::= [] ; [_|Stream].
%%   Channel ::= ch(Stream, Stream?).

%% Shared protocol types (Response, Decision, PendingValue, UserContent,
%% AgentContent, NetColdCall, Friend* and FriendChannel) live in this
%% directory's self.glp and are imported as ancestor type scope. Only the
%% agent-internal Output* union is defined here.

%% Output content (union of AgentContent and FriendContent). befriend forwards
%% the response writer, so its Response slot is `?`-typed (manual §15B), matching
%% AgentContent in self.glp.
OutputContent ::= befriend(Constant, Response?)
                ; befriend_intro(Constant, Constant, FriendChannel?)
                ; connected(Constant)
                ; rejected
                ; rejected(Constant)
                ; received(Constant, Constant)
                ; response(Response)
                ; text(Constant)
                ; intro(Constant, FriendChannel).
OutputMsg     ::= msg(Constant, Constant, OutputContent)
                ; msg(Constant, NetColdCall).
OutputStream  ::= [] ; [OutputMsg | OutputStream].

%% Output list
OutputEntry ::= output(Constant, OutputStream?).
OutputsList ::= [] ; [OutputEntry|OutputsList].

%% =============================================================================
%% CHANNEL OPERATIONS (Defined Guards)
%% =============================================================================

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% LOOKUP_SEND
%% =============================================================================

procedure lookup_send(Constant?, OutputMsg?, OutputsList?, OutputsList).
lookup_send(Key, Msg, Outs, Outs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Outs?, Outs1).

procedure lookup_send_step(Constant?, OutputMsg?, OutputsList?, OutputsList).
lookup_send_step(Key, Msg, [output(K, [Msg?|Out1?])|Rest], [output(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [output(K, Out?)|Rest], [output(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG
%% =============================================================================

procedure inject_msg(Response?, Constant?, Constant?, Stream(X)?, Stream(X)).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% ADD_OUTPUT
%% =============================================================================

procedure add_output(Constant?, OutputStream, OutputsList?, OutputsList).
add_output(Name, Out?, Outs, [output(Name?, Out)|Outs?]).

%% =============================================================================
%% CLOSE_OUTPUTS
%% =============================================================================

procedure close_outputs(OutputsList?).
close_outputs([output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([]).

%% =============================================================================
%% RESPONSE HANDLING
%% =============================================================================

procedure bind_response(Decision?, Constant?, Response, OutputsList?, OutputsList, Stream(X)?, Stream(X)).
bind_response(yes, From, accept(RetCh?), Outs, Outs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Outs?, Outs1, In?, In1).
bind_response(no, _, no, Outs, Outs1?, In, In?) :-
    lookup_send(person, msg(agent, person, rejected), Outs?, Outs1).

procedure handle_response(Response?, Constant?, OutputsList?, OutputsList, Stream(X)?, Stream(X)).
handle_response(accept(ch(FIn, FOut?)), From, Outs, Outs2?, In, In1?) :-
    ground(From?) |
    add_output(From?, FOut, Outs?, Outs1),
    lookup_send(person, msg(agent, person, connected(From?)), Outs1?, Outs2),
    merge(In?, FIn?, In1).
handle_response(no, From, Outs, Outs1?, In, In?) :-
    ground(From?) |
    lookup_send(person, msg(agent, person, rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% AGENT/4
%% =============================================================================

exported procedure agent(Constant?, Stream(X)?, Stream(X)?, OutputsList?).

%% --- User messages ---

%% User initiates cold call
agent(Id, [msg(person, Id1, connect(Target))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send('_net', msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User decision on cold-call
agent(Id, [msg(person, Id1, decision(Dec, From, response(Resp?)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% User sends text message
agent(Id, [msg(person, Id1, send(Target, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% User introduces P to Q
agent(Id, [msg(person, Id1, introduce(P, Q))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    lookup_send(P?, msg(Id?, P?, intro(Q?, QPCh?)), Outs?, Outs1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, PQCh?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% User accepts friend introduction
agent(Id, [msg(person, Id1, accept_intro(Other, channel(ch(FIn, FOut?))))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Other?) |
    add_output(Other?, FOut, Outs?, Outs1),
    lookup_send(person, msg(agent, person, connected(Other?)), Outs1?, Outs2),
    merge(NetIn?, FIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs2?).

%% User rejects friend introduction
agent(Id, [msg(person, Id1, reject_intro(_))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Response to cold-call (injected by inject_msg)
agent(Id, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% User catch-all
agent(Id, [_|UserIn], NetIn, Outs) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Network messages ---

%% Cold-call from network
agent(Id, UserIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs) :-
    Id? =?= Id1? |
    lookup_send(person, msg(agent, person, befriend(From?, Resp)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Response to cold-call from network
agent(Id, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% Text from friend
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs) :-
    Id? =?= Id1? |
    lookup_send(person, msg(agent, person, received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Introduction from friend
agent(Id, UserIn, [msg(From, Id1, intro(Other, Ch?))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send(person, msg(agent, person, befriend_intro(From?, Other?, Ch)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Network catch-all
agent(Id, UserIn, [_|NetIn], Outs) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Termination ---

agent(_, [], _, Outs) :- close_outputs(Outs?).
agent(_, _, [], Outs) :- close_outputs(Outs?).
