%% play_alice_bob_typed.glp - 2-agent cold-call play (typed version)
%% Alice initiates connection to Bob, Bob accepts
%%
%% Based on: programs/tests/agent_roundtrip/play_alice_bob.glp
%% Date: 2026-01-24

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Friend channel for established connections
FriendChannel ::= ch(MsgList, MsgList?).

%% Response to connection request
Response ::= accept(FriendChannel) ; no.

%% Message operations
MsgOp ::= connect(Constant) ; intro(Constant, Constant, Response?) ; befriend(Constant, Response?)
        ; decision(Constant, Constant, Response?) ; response(Response).

%% Social message with sender, receiver, operation
SocialMsg ::= msg(Constant, Constant, MsgOp).
MsgList ::= [] ; [SocialMsg | MsgList].

%% Friend list - pairs of (name, output_stream)
FriendEntry ::= (Constant, MsgList).
FriendList ::= [] ; [FriendEntry | FriendList].

%% Agent entry for network
AgentEntry ::= (Constant, Channel(MsgList, MsgList)?).

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(MsgList?, MsgList?, MsgList).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, MsgList?, MsgList).
tag_stream(Name, [M|In], [msg(Name?, M?)|Out?]) :-
    ground(Name?) | tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% =============================================================================
%% LOOKUP
%% =============================================================================

procedure lookup(_?, FriendList?, MsgList).
lookup(Key, [(K, Value)|_], Value?) :- Key? =?= K? | true.
lookup(Key, [_|Rest], Value?) :- otherwise | lookup(Key?, Rest?, Value).

procedure lookup_send(_?, SocialMsg?, FriendList?, FriendList).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(_?, SocialMsg?, FriendList?, FriendList).
lookup_send_step(Key, Msg, [(K, Out)|Rest], [(K?, Out1?)|Rest?]) :-
    Key? =?= K? |
    Out? = [Msg?|Out1].
lookup_send_step(Key, Msg, [Pair|Rest], [Pair?|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, _?, MsgList?, MsgList).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% RESPONSE HANDLING
%% =============================================================================

procedure bind_response(_?, _?, Response, FriendList?, FriendList, MsgList?, MsgList).
bind_response(yes, From, accept(ch(FOut?, FIn)), Fs, Fs1?, In, In1?) :-
    handle_response(accept(ch(FIn?, FOut)), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

procedure handle_response(Response?, _?, FriendList?, FriendList, MsgList?, MsgList).
handle_response(accept(ch(FIn, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

%% =============================================================================
%% SOCIAL GRAPH - Main agent loop
%% =============================================================================

procedure social_graph(_?, MsgList?, FriendList?).

%% User initiates connection
social_graph(Id, [msg(user, Id1, connect(Target))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Received self-introduction
social_graph(Id, [msg(From, Id1, intro(From1, From2, Resp))|In], Fs) :-
    ground(Id?), ground(From?), Id? =?= Id1?, From? =?= From1?, From? =?= From2? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    social_graph(Id?, In?, Fs1?).

%% User decision on received introduction
social_graph(Id, [msg(user, Id1, decision(Dec, From, Resp?))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Response to sent introduction
social_graph(Id, [msg(From, Id1, response(Resp))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Catch-all for other messages
social_graph(Id, [msg(_, _, _)|In], Fs) :-
    ground(Id?), otherwise |
    social_graph(Id?, In?, Fs?).

%% Termination
social_graph(_, [], _).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure build_friends(Stream(X)?, Stream(X)?, FriendList).
build_friends(UserOut, NetOut, [(user, UserOut?), (net, NetOut?)]).

procedure agent(_?, Channel(X, Y)?, Channel(X, Y)?).
agent(Id, ch(UserIn, UserOut), ch(NetIn, NetOut)) :-
    merge(UserIn?, NetIn?, In),
    build_friends(UserOut?, NetOut?, Fs),
    social_graph(Id?, In?, Fs?).

%% =============================================================================
%% NETWORK SWITCH
%% =============================================================================

procedure network2(AgentEntry?, AgentEntry?).

network2((alice, ch([msg(alice, bob, X)|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [msg(alice, bob, X?)|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((alice, ch(AliceIn, [msg(bob, alice, X?)|AliceOut?])),
         (bob, ch([msg(bob, alice, X)|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

network2((_, ch([], _)), (_, ch([], _))).

%% =============================================================================
%% ACTORS (simulate user behavior)
%% =============================================================================

%% Alice's actor: sends connect, ignores agent output
procedure alice_actor(MsgList?, MsgList).
alice_actor(_, [msg(user, alice, connect(bob))]).

%% Bob's actor: waits for befriend, sends acceptance
procedure bob_actor(MsgList?, MsgList).
bob_actor([msg(agent, user, befriend(From, Resp))|_],
          [msg(user, bob, decision(yes, From?, Resp?))|_]).

%% =============================================================================
%% THE PLAY
%% =============================================================================

procedure play_alice_bob.
play_alice_bob :-
    %% Network switch (holds inverse of agents' network channels)
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),

    %% Alice's agent
    agent(alice, ch(AliceUserIn?, AliceUserOut), ch(AliceNetIn?, AliceNetOut)),

    %% Bob's agent
    agent(bob, ch(BobUserIn?, BobUserOut), ch(BobNetIn?, BobNetOut)),

    %% Alice's script: initiate connection to Bob, ignore output
    alice_actor(AliceUserOut?, AliceUserIn),

    %% Bob's script: receive befriend request, accept
    bob_actor(BobUserOut?, BobUserIn).
