%% The program's interface (TGLP modules.tex, External access): run/0, its one
%% entry point, forwarded to boot.glp, which defines it.  A directory with no
%% self.glp is not a program ("Entry and the absence of a boot module"); until
%% 2026-10-02 this one had none and took boot.glp's exported run/0 for its entry
%% point.
imported procedure boot#run.
exported procedure run.
run :- boot # run.
