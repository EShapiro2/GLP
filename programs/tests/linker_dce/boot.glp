%% Dead-code-elimination fixture (modules.tex sec:static-linking, step 5).
%% Root export `run` calls `helper`; `dead` is never called. After linking, DCE
%% keeps the reachable run/helper (and the bare `run` entry alias) and prunes the
%% unreachable `dead`.

exported procedure run.
run :- helper.

procedure helper.
helper :- send_to_user([helper_ran]).

procedure dead.
dead :- send_to_user([never_ran]).
