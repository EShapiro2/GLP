%% param_instantiated_coverage_gap.glp — NEGATIVE regression guard for the TGLP
%% paper's "Programs and Modules" rule (parameterized-types.tex
%% sec:programs-and-modules; spec: docs/type system/typed-program.md).
%%
%% Same pdrop/1 as param_free_not_checked.glp (a parameterized procedure with a
%% coverage gap: no clause for the empty stream []), here additionally INSTANTIATED
%% at X := Msg by go/1.  pdrop does not inspect its parameter, so the abstract
%% route is tried first: the abstract-instance check (def:parametrically-well-typed)
%% runs contravariance on pdrop(Stream<$abstract_X>?) and finds [] uncovered, so
%% pdrop is not parametrically well-typed and "is checked per instantiation"
%% (sec:abstract-parameters).  At X := Msg the gap is the same --- [] of
%% Stream<Msg> is uncovered --- so the file is REJECTED there.
%%
%% Paired with param_free_not_checked.glp (same pdrop, never instantiated, also
%% rejected): this file confirms that an instantiation present alongside the gap
%% does not mask it.
%%
%% Run (from /Users/udi/Grassroots/GLP/glp_runtime/):
%%   printf 'load ../programs/tests/param_instantiated_coverage_gap.glp\n:quit\n' | bin/glpc

Msg ::= a ; b.

procedure pdrop(Stream(X)?).
pdrop([_|Xs]) :- pdrop(Xs?).

procedure go(Stream(Msg)?).
go(S) :- pdrop(S?).
