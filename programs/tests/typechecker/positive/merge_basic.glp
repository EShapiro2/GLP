% test: merge_basic
% expected: pass
% description: Basic merge program from paper (Example 3.3, lines 170-174)
% Paper reference: Definition 4.8 well-typed clause example

MyStream ::= [] ; [_|MyStream].

procedure merge(MyStream?, MyStream?, MyStream).

merge([], Ys, Ys?).
merge(Xs, [], Xs?).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
