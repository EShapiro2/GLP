% A list of role names, the root's Names, each a name or one(Name, Others),
% Others one name, the list of names, or '_' (programs/self.glp, RName and
% OneOf): count/2 counts the names marked possibly one with others.
procedure count(Names?, Integer).
count(Ns, N?) :- count(Ns?, 0, N).

procedure count(Names?, Integer?, Integer).
count([], N, N?).
count([one(_, Os) | Ns], N0, N?) :- others(Os?, K), N1 := N0? + K?, count(Ns?, N1?, N).
count([R | Ns], N0, N?) :- constant(R?) | count(Ns?, N0?, N).

procedure others(OneOf?, Integer).
others(O, 1) :- constant(O?) | true.
others([_ | Os], K?) :- length(Os?, K0), K := K0? + 1.

procedure length(List(Constant)?, Integer).
length([], 0).
length([_ | Os], K?) :- length(Os?, K0), K := K0? + 1.
