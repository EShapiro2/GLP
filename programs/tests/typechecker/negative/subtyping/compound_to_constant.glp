% test: compound_to_constant
% expected: fail (even with subtyping)
% description: Constant ::= Number ; String ; Module. has no compound
%   alternative, so Wrap — whose values are compound terms — is not below it.
%   Positive twin: positive/subtyping/constant_union_to_constant.glp, where
%   every alternative is a constant.

Wrap ::= wrap(Integer).

procedure wrap_source(Wrap).
wrap_source(wrap(1)).

procedure constant_sink(Constant?).
constant_sink(_).

procedure connect.
connect :- wrap_source(X), constant_sink(X?).
