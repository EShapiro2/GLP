%% A type reference resolves to the renamed type of the nearest scope defining
%% it (TGLP modules.tex, Compilation, fourth step).  This self.glp defines
%% Peers, never empty, and names Stream(Peers) in a declaration, so its scope
%% holds the expansion instance Stream<Peers> at its own Peers.  m.glp, below
%% it, defines a Peers of its own, which may be empty, and calls its
%% parameterised app/3 at that Peers: the call is checked at m.glp's Peers,
%% not at this one's (glp_runtime/test/compiler/nearest_type_test.dart).
Peers ::= [Integer | List(Integer)].

exported procedure count(Stream(Peers)?, Integer).
count([], 0).
count([_ | Xs], N?) :- count(Xs?, M), N := M? + 1.

imported procedure m#size(Integer).
exported procedure run(Integer).
run(N?) :- m # size(N).
