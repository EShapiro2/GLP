%% tracing_meta.glp - Combined tracing meta-interpreter
%%
%% Records execution for both replay (clause indices) and inspection (observed goals).
%% Tree format: reduction(Goal, ClauseId, Timestamp, BodyTree) | fork(T1, T2) | true

run(M, true, true).                              % halt
run(M, (A,B), fork(TA?, TB?)) :-                 % fork
    run(M?, A?, TA),
    run(M?, B?, TB).
run(M, M1 # G, Tree?) :- run(M1?, G?, Tree).     % cross-module
run(M, A, reduction(A_obs?, I?, Time?, TB?)) :-  % reduce
    tuple(A?), time(Time) |
    observe # observe(A?, A_exec, A_obs),
    M # reduce(A_exec?, B, I),
    run(M?, B?, TB).
