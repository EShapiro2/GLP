% An anonymous variable is a fresh writer with no paired reader (GLP-Spec
% glp.tex, Remark "Anonymous Variables"; TGLP "Anonymous variables"), and an
% anonymous reader is not permitted in a clause: a clause writes every writer it
% holds, closing a stream it does not extend.  `unknown/1` on a genuinely
% unbound tail reports it, and on a closed list does not; a `_` inside a term
% the body constructs completes that term.  Expected, one goal per driver:
% unbound_tail(G?, A) gives A = open (and suspends), closed_tail(A) gives
% A = other, anon_body(A) gives A = other.  Until 2026-10-14 a driver
% anon_head had `_?` at a produced head position leave a stream open;
% unify_void_test.dart now holds that clause refused.
Elem ::= hello(Constant).
Stream ::= [] ; [Elem | Stream].
Chan ::= ch(Stream, Stream?).
Answer ::= open ; other.

% probe(S, A): is the tail of S unbound?
procedure probe(Stream?, Answer).
probe([], other).
probe([hello(_) | T], open) :- unknown(T?) | true.
probe([hello(_) | _], other) :- otherwise | true.

% A control: the tail is a writer whose producer is suspended, so it is
% genuinely unbound.
procedure more(String?, Stream).
more(go, []).

procedure emit(String?, Stream).
emit(Go, [hello(me) | T?]) :- more(Go?, T).

exported procedure unbound_tail(String?, Answer).
unbound_tail(Go, A?) :- emit(Go?, S), probe(S?, A).

% A control: a closed list, whose tail is bound to [].
procedure closed(Stream).
closed([hello(me) | []]).

exported procedure closed_tail(Answer).
closed_tail(A?) :- closed(S), probe(S?, A).

% `_` at a produced position inside a term the body constructs; look/2 closes
% the stream it does not extend.
procedure look(Chan?, Answer).
look(ch(In, []), A?) :- probe(In?, A).

exported procedure anon_body(Answer).
anon_body(A?) :- closed(S), look(ch(S?, _), A).
