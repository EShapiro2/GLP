%% A call whose argument at a parameter is a constructed term, the callee's
%% clauses relating that parameter to another: loads, by the type the callee's
%% clauses fix (TGLP cc4a891, appendix-implementation-notes.tex, "The
%% instantiation of a call": "For each parameter it tries the types the sites
%% supply and the types the callee's clauses fix for it").
%%
%% The shape is programs/currencies/coins/self.glp's show/3:
%% `send_user(msg(agent, person, bye(N?)), Outs?, Outs1)` against
%% `procedure(M, Ent) send_user(M?, Stream(Ent)?, Stream(Ent))`.  The variable
%% Outs supplies Ent = Entry; the constructed term names no type, so no site
%% supplies M; and send_user/3's first clause relates Msg, at M?, to Msg?, at
%% the element of the stream out/1 carries, which condition 3(a) requires to be
%% dual: M = Msg.  send_user/3 inspects Ent (its clauses match out/1), so it is
%% not parametrically well-typed, and the call loads only by that type.
%% run(x, [out(S)], O) gives S = [msg(agent, person, bye(x)) | _].
%%
%% From 2026-09-20 (TGLP e56c303) to 2026-10-02 the checker read M off the same
%% head pair and the program loaded; on 2026-10-02 (TGLP 8a58729) a type no site
%% supplied was not tried and the call was refused, naming M; before 2026-09-20
%% it was rejected as carrying a parameter-inspecting procedure nothing
%% instantiates.

Content ::= hello ; bye(Constant).
Msg     ::= msg(Constant, Constant, Content).
Entry   ::= out(Stream(Msg)?) ; log(Stream(Constant)?).

imported procedure code#show(Constant?, Stream(Entry)?, Stream(Entry)).

exported procedure run(Constant?, Stream(Entry)?, Stream(Entry)).
run(N, Outs, Outs1?) :- code # show(N?, Outs?, Outs1).
