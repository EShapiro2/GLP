%% A call whose argument at a parameter is a constructed term, the callee's
%% clauses relating that parameter to another: refused (TGLP 8a58729,
%% appendix-implementation-notes.tex, "The instantiation of a call": "A type no
%% site supplies is not tried ... A call for which no instantiation is found is
%% refused unless its callee is parametrically well-typed").
%%
%% The shape is programs/currencies/coins/self.glp's show/3:
%% `send_user(msg(agent, person, bye(N?)), Outs?, Outs1)` against
%% `procedure(M, Ent) send_user(M?, Stream(Ent)?, Stream(Ent))`.  The variable
%% Outs supplies Ent = Entry; the constructed term names no type, so no site
%% supplies M; and send_user/3 inspects Ent (its clauses match out/1), so it is
%% not parametrically well-typed.  The call is refused, naming M.  Negative
%% fixture.
%%
%% From 2026-09-20 (TGLP e56c303) to 2026-10-02 the checker read M off the
%% callee's own head pair (Msg, Msg?), which condition 3(a) requires to be dual,
%% and the program loaded; before 2026-09-20 it was rejected as carrying a
%% parameter-inspecting procedure nothing instantiates.

Content ::= hello ; bye(Constant).
Msg     ::= msg(Constant, Constant, Content).
Entry   ::= out(Stream(Msg)?) ; log(Stream(Constant)?).

imported procedure code#show(Constant?, Stream(Entry)?, Stream(Entry)).

exported procedure run(Constant?, Stream(Entry)?, Stream(Entry)).
run(N, Outs, Outs1?) :- code # show(N?, Outs?, Outs1).
