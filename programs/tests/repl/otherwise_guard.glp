% otherwise_guard.glp - Test the otherwise guard
% otherwise succeeds when all previous clauses failed

% Simple otherwise as default case
classify(X, positive) :- X? > 0 | true.
classify(X, negative) :- X? < 0 | true.
classify(_, zero) :- otherwise | true.

% Otherwise with multiple clauses
grade(N, a) :- N? >= 90 | true.
grade(N, b) :- N? >= 80 | true.
grade(N, c) :- N? >= 70 | true.
grade(N, d) :- N? >= 60 | true.
grade(_, f) :- otherwise | true.

% Otherwise with type guards
type_of(X, integer) :- integer(X?) | true.
type_of(X, atom) :- atom(X?) | true.
type_of(X, list) :- list(X?) | true.
type_of(_, other) :- otherwise | true.
