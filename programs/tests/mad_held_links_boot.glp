%% mad_held_links_boot.glp — a forwarded link is held at both of its ends, two
%% reports, two answers, and the value is delivered (IGLP madglp-spec \S Held
%% Links; the Implementation Notes' "Held links").
%%
%% alice, the anchor, sends the writer end of a variable to bob and waits on its
%% reader; bob forwards the end to carol, who binds it.  carol's runtime holds
%% her assignment --- the end reached her from bob, not from alice --- and
%% reports pending_link(Name, bob) on her network input; her program authorises,
%% and the value goes to alice.  alice's runtime holds it --- it came from carol,
%% to whom alice exported nothing --- and reports pending_link(Name, carol); her
%% program authorises, the assignment is applied, and alice's reader delivers.
%% The agent code is the program directory mad_held_links/, which the boot
%% harness loads in every isolate with this boot clause on top.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, ch(_?, _))@bob,
    agent(ch(_?, _), ch(_?, _))@carol,
    say(carol, ch(_?, _))@carol.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)) (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/2, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name, by which agent/2 starts the agent's program on the network input, the agent's key having been made at its spawn.
exported procedure(X) agent(Channel(Stream(Constant), Stream(Constant))?, Channel(Stream(NetMsg(X)), Stream(NetMsg(X)))?).
agent(ch(In, []), ch(N, [])) :- start(In?, N?).

%% The agent's program, by the name its person tells it.
procedure(X) start(Stream(Constant)?, Stream(NetMsg(X))?).
start([alice | _], N) :- alice_init(alice, N?).
start([bob | _], N) :- bob_init(bob, N?).
start([carol | _], N) :- carol_init(carol, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name, and reads nothing.
exported procedure say(Constant?, Channel(Stream(Constant), Stream(Constant))?).
say(P, ch(_, [P?])).
