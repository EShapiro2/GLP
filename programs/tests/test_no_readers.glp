%% Test no_readers guard
%%
%% Semantics:
%% - Succeeds if term contains no readers (ground terms and/or writers only)
%% - Suspends if term contains readers
%% - Never fails

% Test 1: Ground value - should succeed immediately
procedure test_ground_succeeds(_).
test_ground_succeeds(Result) :-
    X = 42,
    no_readers(X?) |
    Result = ok.

% Test 2: Compound with ground - should succeed
procedure test_compound_ground(_).
test_compound_ground(Result) :-
    X = foo(1, bar(2)),
    no_readers(X?) |
    Result = ok.

% Test 3: List with ground - should succeed
procedure test_list_ground(_).
test_list_ground(Result) :-
    X = [1, 2, 3],
    no_readers(X?) |
    Result = ok.

% Note: Tests for suspension (term with readers) are harder to test
% since the guard will just suspend waiting for the readers to be bound

?- test_ground_succeeds(R1).
?- test_compound_ground(R2).
?- test_list_ground(R3).
