%% Positive SRSW fixture.  glp.tex Remark "Guards and SRSW" (GLP-Spec
%% 831f315; TGLP glp.tex, the same Remark): "if the success of a guard implies
%% that X? is bound to a ground term, then both X and X? may occur multiple
%% times in the clause."
%%
%% So the writer X in the head and again in the body loads under integer/1,
%% and R twice in the head under ground/1; the goal reduces only where the two
%% occurrences meet one term, the writer mgu of the goal and the head
%% (Definitions "Writer MGU", "GLP Goal/Clause Reduction").  From 2026-10-02
%% to 2026-10-12 (GLP-Spec bbff21d, undone by 831f315) this file was the
%% negative fixture ground_writer_once.glp.  Its negative counterpart, the
%% same writers without a groundness-implying guard, is
%% srsw/writer_twice_no_ground.glp.
procedure w(Integer?, _).
w(X, Y?) :- integer(X?) | Y = s(X).

procedure two(_?, _?).
two(R, R) :- ground(R?) | true.

Same ::= yes ; no.
procedure same_ground(_?, _?, Same).
same_ground(R, R, yes) :- ground(R?) | true.
same_ground(_, _, no) :- otherwise | true.
