%% Negative SRSW fixture.  glp.tex Remark "Guards and SRSW" (GLP-Spec
%% bbff21d): a guard whose success implies its argument is ground lets X? occur
%% multiple times, X occurring once, as ever.  "However, known and compound do
%% not imply groundness."
%%
%% So known/1 licenses no multiple occurrence, and X? occurring twice in the
%% body under it is an SRSW violation.  The positive counterpart, where the
%% guard IS groundness-implying, is srsw/ground_guard_multi_ok.glp.
procedure k(_?, _).
k(X, Y?) :- known(X?) | pair(X?, X?, Y).

procedure pair(_?, _?, _).
pair(_, _, done).
