%% Positive SRSW fixture.  glp.tex Remark "Guards and SRSW" (GLP-Spec
%% 831f315): "if the success of a guard implies that X? is bound to a ground
%% term, then both X and X? may occur multiple times in the clause"; TGLP
%% glp.tex, the same Remark: "Groundness-implying guards include ground,
%% integer, number, string, constant, arithmetic comparisons (<, >, =<, >=,
%% =:=, =\=), and ground equality (=?=)."
%%
%% integer/1 is one of them, so X? twice in the body is accepted here.  Its
%% negative counterpart is srsw/known_not_ground.glp, under the
%% non-groundness-implying known/1; the writer X twice under integer/1 is
%% srsw/ground_writer_multi_ok.glp.
procedure sq(Integer?, Integer).
sq(X, Y?) :- integer(X?) | Y := X? * X?.
