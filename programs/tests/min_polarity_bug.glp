%% min_polarity_bug.glp — minimal repro for the producer/consumer polarity gap
%%
%% ONE file, ONE module, compiled together (NOT separate compilation).
%% The functor befriend/2 is declared at OPPOSITE Response polarity in two
%% types, mirroring typed_social_agent.glp:
%%   OutputContent.befriend(Constant, Response)   %% writer  -> producer side
%%   AgentContent.befriend(Constant, Response?)   %% reader  -> consumer side
%%
%% go/1 wires a producer (output Stream(ProdMsg)) to a consumer
%% (input Stream(ConsMsg)?) through the SAME stream variable S.
%% ProdMsg =/= ConsMsg  (Response vs Response?).
%%
%% If producer/consumer (endpoint) duality were enforced, the shared S forces
%% Stream(ProdMsg) = Stream(ConsMsg) and this is a TYPE ERROR at go.
%% Claim to verify: it LOADS and PASSES typechecking with no error reported.
%%
%% Run (from /Users/udi/Grassroots/GLP/glp_runtime/):
%%   echo -e 'load ../programs/tests/min_polarity_bug.glp\n:quit' | dart run bin/glp_repl.dart

-mode(system).

Response ::= accept ; no.

ProdMsg ::= befriend(Constant, Response).    %% slot 2 = writer
ConsMsg ::= befriend(Constant, Response?).   %% slot 2 = reader

procedure producer(Stream(ProdMsg)).
producer([befriend(alice, _R)]).

procedure consumer(Stream(ConsMsg)?).
consumer([befriend(From, Resp?)|Rest]) :- known(From?) | bind(Resp), consumer(Rest?).
consumer([]).

procedure bind(Response).
bind(accept).

procedure go(Stream(Response)).
go([]) :- producer(S), consumer(S?).
