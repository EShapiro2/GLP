%% run/1's declaration says `_?`, so the call below hands tagger/1 no element
%% type and no instantiation of tagger/1 arises.  tagger/1 inspects its stream
%% element (it matches m/1 and builds o/1), so it has no well-typing of its own
%% and acquires one only per instantiation --- of which there is none.  Nothing
%% can check the clause, so compilation rejects the program (TGLP
%% parameterized-types.tex sec:abstract-parameters); the untagged R sitting at
%% o/1's tagged-union position is what would otherwise go unnoticed: declared
%% concretely, the checker rejects it at once, which is
%% programs/tests/typed/tagged_union_untagged_neg.glp.

exported procedure run(_?).
run(Ch) :- tagger(Ch?).

procedure(X, Y) tagger(Channel(X, Y)?).
tagger(ch([m(R?)|In], [o(R)|Out?])) :- tagger(ch(In?, Out)).
