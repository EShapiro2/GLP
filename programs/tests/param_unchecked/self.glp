%% A program whose entry declaration leaves a callee's type parameters free, so
%% no call instantiates the callee; the callee inspects its parameter, so it is
%% not parametrically well-typed.  The call is refused, no site of it
%% supplying a type for the parameters and the callee's clauses fixing none
%% (TGLP appendix-implementation-notes.tex, "The instantiation of a call",
%% cc4a891), and until 2026-10-02 compilation rejected
%% the program at the linked check instead, as carrying a procedure no call
%% instantiates (parameterized-types.tex sec:abstract-parameters).  Negative
%% fixture since 2026-09-18.  From 2026-08-03 it loaded with a `[TYPE] ... unchecked in this
%% program` line, the regression test for the silence found that day:
%% typed_actors.glp had carried an untagged value at a tagged-union position for
%% months, and the checker's verdict on the program that contained it was clean.
%% Until 2026-10-02 run/1 was declared `_?`, which no expansion of tagger/1's
%% Channel(X, Y)? accepts, so that call had no instantiation either (TGLP
%% parameterized-types.tex, Definition "Instantiation") and was refused for it
%% first; `Channel(_, _)?` supplies no element type and leaves this fixture its
%% one refusal.

Inner ::= a ; b.
Outer ::= wrap(Inner?) ; err.

InMsg  ::= m(Inner?).
OutMsg ::= o(Outer).

imported procedure code#run(Channel(_, _)?).

exported procedure run(Channel(_, _)?).
run(Ch) :- code # run(Ch?).
