%% A program whose entry declaration leaves a callee's type parameters free, so
%% no call instantiates the callee; the callee inspects its parameter, so it is
%% not parametrically well-typed, and compilation rejects the program (TGLP
%% parameterized-types.tex sec:abstract-parameters).  Negative fixture since
%% 2026-09-18.  From 2026-08-03 it loaded with a `[TYPE] ... unchecked in this
%% program` line, the regression test for the silence found that day:
%% typed_actors.glp had carried an untagged value at a tagged-union position for
%% months, and the checker's verdict on the program that contained it was clean.

Inner ::= a ; b.
Outer ::= wrap(Inner?) ; err.

InMsg  ::= m(Inner?).
OutMsg ::= o(Outer).

imported procedure code#run(_?).

exported procedure run(_?).
run(Ch) :- code # run(Ch?).
