%% gkk_maglp_boot.glp --- GKK's app as maGLP: two agents, alice and bob, each in an isolate of its own, each started from the GLP paper's initial local state, agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"); each runs the GKK mini-app of programs/apps/gkk, the program this boot is loaded on top of (:boot <this file> <GLP>/programs/apps/gkk).
%%
%% The boot clause names, at each agent, the person scripted in GLP, a second goal P@p, which the runtime runs on p's person channel in the person's place, its writes being the person's input (IGLP, Implementation Notes, "Boot").  Alice's person writes call(bob): what the person writes may name any agent, and this is how an agent learns of an agent it has not met (GLP-Spec maglp.tex, after Definition "Multiagent GLP").  Alice's agent then makes a conversation and cold-calls bob with it, msg(bob, conv(Ka, Kb, Ch)) on its network output (the Cold-call transaction): Ka its key, Kb a writer for bob's key, and Ch bob's end of the conversation's root channel.  Bob's agent reads it on its network input, assigns Kb its key, and each agent runs the mini-app with its key and the conversation with the other, as the social graph hands a mini-app its conversations (programs/apps/gkk/miniapp.glp).
%%
%% Each agent's key pair is made when the runtime spawns the agent, before anything is compiled or sent (GLP-Spec appendix-guards.tex, "Identity and signature"), and self_key/1 assigns its public key.  Each person establishes their identity by the key the request question shows (GKK:1, Identity); alice asks to know the person her agent knows over the conversation, bob, by his key (GKK:2, Acquaintance), and bob answers yes; each person then reports the person the agent knows, knows(Key).

MaIn     ::= call(Key) ; input(Integer, Path, Drawn).
MaIns    ::= [MaIn | MaIns].
MaConv   ::= conv(Key, Key?, RootChannel(Net)).
MaPending ::= pending(Key, Key, RootChannel(Net)).
MaOut    ::= Draw(Drawn) ; called(Key, Key).
MaOuts   ::= [MaOut | MaOuts].
MaPeer   ::= nopeer ; peer(Key).
MaRole   ::= caller(Key) ; callee.
MaWho    ::= caller ; callee.
MaSess   ::= nosess ; sess(Integer, Path, Key).
MaView   ::= noview ; pview(YesNo, List(Atom), List(Key)).
MaStep   ::= establish ; acquaint ; await ; done.
MaState  ::= pst(MaWho, MaSess, MaView, MaPeer, MaStep).
MaFound  ::= found(Key) ; none.
MaReport ::= key(Key) ; knows(Key).

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    ma_person(caller(bob), ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    ma_person(callee, ch(_?, _))@bob.

%% =============================================================================
%% The agent
%% =============================================================================

%% The agent: its key, which self_key/1 assigns; the person's input split into the agents the person names and the grants on the mini-app's questions; a conversation for each agent the person names, which the agent cold-calls with it, and, once that agent's key comes back, the conversation opened and the person told the key, called(Q, Kq); a conversation for each cold call that reaches it; and the mini-app over the person channel and the conversations, what it draws for the person merged with what the agent tells the person.
exported procedure agent(Channel(MaIns, MaOuts)?, Channel(Stream(NetMsg(MaConv)), Stream(NetMsg(MaConv)))?).
agent(ch(PIn, POut?), ch(NIn, NOut?)) :-
    self_key(K),
    run_agent(K?, PIn?, POut, NIn?, NOut).

procedure run_agent(Key?, MaIns?, MaOuts, Stream(NetMsg(MaConv))?, Stream(NetMsg(MaConv))).
run_agent(K, PIn, POut?, NIn, NOut?) :-
    ground(K?) |
    split_in(PIn?, Calls, Grants),
    call_out(Calls?, K?, NOut, Pending),
    opened(Pending?, Mine, Notices),
    answer_in(NIn?, K?, Theirs),
    merge(Mine?, Theirs?, Down),
    miniapp(K?, ch(Grants?, MOut), ch(Down?, Up), []),
    mix(MOut?, Notices?, POut),
    sink(Up?).

%% The person's input: each agent the person names, and each grant on a question of the mini-app.
procedure split_in(MaIns?, Stream(Key), PersonIn(Drawn)).
split_in([call(Q) | Xs], [Q? | Cs?], Gs?) :- split_in(Xs?, Cs, Gs).
split_in([input(I, P, D) | Xs], Cs?, [input(I?, P?, D?) | Gs?]) :- split_in(Xs?, Cs, Gs).

%% The cold call to each agent Q the person names: msg(Q, conv(K, Kq, Ch)), Ch Q's end of a new conversation, and this agent's end of it, pending until Q's agent assigns its key Kq.
procedure call_out(Stream(Key)?, Key?, Stream(NetMsg(MaConv)), Stream(MaPending)).
call_out([Q | Qs], K, [msg(Q?, conv(K?, Kq, ch(AB?, BA))) | Ms?], [pending(Q?, Kq?, ch(BA?, AB)) | Ps?]) :-
    ground(K?) | call_out(Qs?, K?, Ms, Ps).
call_out([], _, [], []).

%% A conversation the agent called, opened once the called agent's key has come back, and the person told the key.
procedure opened(Stream(MaPending)?, Stream(SgToApp(Net)), Stream(MaOut)).
opened([pending(Q, Kq, Ch) | Ps], [conversation(Kq?, Ch?) | Cs?], [called(Q?, Kq?) | Ns?]) :-
    ground(Kq?) | opened(Ps?, Cs, Ns).
opened([], [], []).

%% What the mini-app draws for the person, merged with what the agent tells the person.
procedure mix(PersonOut(Drawn)?, Stream(MaOut)?, MaOuts).
mix([D | Ds], Ns, [D? | Os?]) :- mix(Ds?, Ns?, Os).
mix(Ds, [N | Ns], [N? | Os?]) :- mix(Ds?, Ns?, Os).
mix(Ds, [], Os?) :- lift(Ds?, Os).

procedure lift(PersonOut(Drawn)?, MaOuts).
lift([D | Ds], [D? | Os?]) :- lift(Ds?, Os).

%% Each cold call that reaches the agent: its key assigned to the caller's writer, and the conversation with the caller.
procedure answer_in(Stream(NetMsg(MaConv))?, Key?, Stream(SgToApp(Net))).
answer_in([msg(_, conv(P, Me?, Ch)) | Ms], K, [conversation(P?, Ch?) | Cs?]) :-
    ground(K?) | give(K?, Me), answer_in(Ms?, K?, Cs).
answer_in([], _, []).

procedure give(Key?, Key).
give(K, K?).

%% What the mini-app writes to the social graph, read and dropped: the conversations are not the social graph's here.
procedure sink(Stream(AppToSg)?).
sink([_ | Xs]) :- sink(Xs?).
sink([]).

%% =============================================================================
%% The scripted person
%% =============================================================================

%% The person at the agent's person channel: the caller names the agent Q to call, and each person then reads what the mini-app draws and acts on it.
exported procedure ma_person(MaRole?, Channel(MaOuts, MaIns)?).
ma_person(caller(Q), ch(Ds, [call(Q?) | Gs?])) :-
    see(Ds?, Gs, pst(caller, nosess, noview, nopeer, establish)).
ma_person(callee, ch(Ds, Gs?)) :-
    see(Ds?, Gs, pst(callee, nosess, noview, nopeer, establish)).

%% What the mini-app draws: the program's output, construct 0, its views; a request question, showing the agent's own key; an approval question; and anything else, passed over.  And what the agent tells the person: the key of the agent the person named.
procedure see(MaOuts?, MaIns, MaState?).
see([draw(0, _, output(T)) | Ds], Gs?, pst(W, Se, _, Pe, St)) :-
    ground(T?) |
    last_view(T?, noview, V),
    act(pst(W?, Se?, V?, Pe?, St?), Gs, Gs1?, S1),
    see(Ds?, Gs1, S1?).
see([draw(Id, _, menu_w(menu(Me, _, input(P)))) | Ds], Gs?, pst(W, _, V, Pe, St)) :-
    ground(Id?), ground(P?), ground(Me?) |
    act(pst(W?, sess(Id?, P?, Me?), V?, Pe?, St?), Gs, Gs1?, S1),
    see(Ds?, Gs1, S1?).
see([called(_, Kq) | Ds], Gs?, pst(W, Se, V, _, St)) :-
    ground(Kq?) |
    act(pst(W?, Se?, V?, peer(Kq?), St?), Gs, Gs1?, S1),
    see(Ds?, Gs1, S1?).
see([draw(Id, _, approval_w(approval(_, _, input(P)))) | Ds], Gs?, S) :-
    ground(Id?), ground(P?) |
    approve(S?, Id?, P?, Gs, Gs1?, S1),
    see(Ds?, Gs1, S1?).
see([_ | Ds], Gs?, S) :-
    otherwise | see(Ds?, Gs, S?).


%% The callee answers yes to every approval question; the caller is asked none.
procedure approve(MaState?, Integer?, Path?, MaIns, MaIns?, MaState).
approve(pst(callee, Se, V, Pe, St), Id, P, [input(Id?, P?, yes) | Gs1?], Gs1, pst(callee, Se?, V?, Pe?, St?)).
approve(pst(caller, Se, V, Pe, St), _, _, Gs1?, Gs1, pst(caller, Se?, V?, Pe?, St?)).

%% The person's next act: establish their identity by the key a request question shows; the caller then, once the view shows the identity and the agent has told them the key of the agent they named, asks to know that person, by that key; each then waits until the view shows a person known, and reports it.
procedure act(MaState?, MaIns, MaIns?, MaState).
act(pst(caller, sess(Id, P, Me), V, Pe, establish), [input(Id?, P?, propose(establish(Me?))) | Gs1?], Gs1, pst(caller, nosess, V?, Pe?, acquaint)) :-
    ground(Me?) | send_to_user([key(Me?)]).
act(pst(callee, sess(Id, P, Me), V, Pe, establish), [input(Id?, P?, propose(establish(Me?))) | Gs1?], Gs1, pst(callee, nosess, V?, Pe?, await)) :-
    ground(Me?) | send_to_user([key(Me?)]).
act(pst(caller, sess(Id, P, Me), pview(yes, S, K), peer(Q), acquaint), [input(Id?, P?, propose(acquaint(Me?, Q?))) | Gs1?], Gs1, pst(caller, nosess, pview(yes, S?, K?), peer(Q?), await)) :-
    ground(Q?) | true.
act(pst(W, Se, pview(I, S, K), Pe, await), Gs?, Gs1, S1?) :-
    ground(S?) |
    known_peer(S?, F),
    awaited(F?, pst(W?, Se?, pview(I?, S?, K?), Pe?, await), Gs, Gs1?, S1).
act(S, Gs1?, Gs1, S?) :- otherwise | true.

procedure awaited(MaFound?, MaState?, MaIns, MaIns?, MaState).
awaited(found(Q), pst(W, Se, V, Pe, _), Gs1?, Gs1, pst(W?, Se?, V?, Pe?, done)) :-
    send_to_user([knows(Q?)]).
awaited(none, S, Gs1?, Gs1, S?).

%% The last view the agent wrote: whether its machine state holds the identity, the state, and the persons the agent knows.
procedure last_view(List(Output)?, MaView?, MaView).
last_view([], V, V?).
last_view([view(S, K, _, _) | Xs], _, V?) :-
    ground(S?) |
    has_atom(identity, S?, I),
    last_view(Xs?, pview(I?, S?, K?), V).
last_view([_ | Xs], V0, V?) :- otherwise | last_view(Xs?, V0?, V).

procedure has_atom(Atom?, List(Atom)?, YesNo).
has_atom(_, [], no).
has_atom(A, [B | _], yes) :- A? =?= B? | true.
has_atom(A, [_ | Bs], R?) :- otherwise | has_atom(A?, Bs?, R).

procedure known_peer(List(Atom)?, MaFound).
known_peer([], none).
known_peer([knows(Q) | _], found(Q?)).
known_peer([_ | As], F?) :- otherwise | known_peer(As?, F).
