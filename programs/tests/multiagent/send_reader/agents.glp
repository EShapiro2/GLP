%% send_reader/agents.glp — the agent code of send_reader_boot.glp.
%% The entry points the boot clause spawns are exported here and
%% forwarded from self.glp; every other procedure is local to this module.
exported procedure sender_init(Keys?, Stream(NetMsg(Msg))?).
sender_init(keys(_, [Agent2]), _) :-
    send_to_net([msg(Agent2?, data(X?))]),
    bind_later(X).
sender_init(_, _) :- otherwise | true.

procedure bind_later(Ack).
bind_later(Done?) :- wait(1000) | done(Done).


procedure done(Ack).
done(done).

exported procedure receiver_init(Keys?, Stream(NetMsg(Msg))?).
receiver_init(_, [msg(_, data(Y))|_]) :-
    got_it(Y?).
receiver_init(_, _) :- otherwise | true.

procedure got_it(Ack?).
got_it(done).
