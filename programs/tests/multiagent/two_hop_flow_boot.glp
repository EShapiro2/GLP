%% two_hop_flow_boot.glp - Two-hop data flow: produce -> transform -> return
%%
%% madGLP equivalent of the old IRMA two_hop_flow_test:
%%   Old: @1 produces Xs=[1,2,3], @2 transforms Ys=[got(1),got(2),got(3)], @1 reads Ys?
%%   New: agent1 sends [1,2,3] to agent2, agent2 transforms and sends result back
%%
%% Data flow: agent1 -> agent2 -> agent1 (round-trip, non-circular)
%%
%% NOTE: The round-trip receiving is tested by agent2 receiving from agent1.
%% Agent1 just sends and completes. Full round-trip would require the type
%% checker to handle send_to_net and NetIn? in the same clause.
%%
%% Date: 2026-02-10
%
% The agent code is the program directory two_hop_flow/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@agent1,
    say(agent1, ch(_?, _))@agent1,
    agent(ch(_?, _), ch(_?, _))@agent2,
    say(agent2, ch(_?, _))@agent2.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)) (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/2, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name, by which agent/2 starts the agent's program on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network.
exported procedure(X) agent(Channel(Stream(Constant), Stream(Constant))?, Channel(Stream(NetMsg(X)), Stream(NetMsg(X)))?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The agent's program, by the name its person tells it.
procedure(X) start(Stream(Constant)?, Stream(NetMsg(X))?).
start([agent1 | _], N) :- agent1_init(agent1, N?).
start([agent2 | _], N) :- agent2_init(agent2, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name, and reads nothing.
exported procedure say(Constant?, Channel(Stream(Constant), Stream(Constant))?).
say(P, ch(_, [P?])).
