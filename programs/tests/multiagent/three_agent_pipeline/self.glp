%% three_agent_pipeline/self.glp — program interface.
%%
% The entry points named in ../three_agent_pipeline_boot.glp are exported here and forwarded
%% to agents.glp, which defines them.  The boot clause itself is NOT in this
%% directory: BootLoader strips it on the boot path, but a directory load does
%% not, and its @ atoms would then meet the type checker.

imported procedure agents#producer_init(_?, _?).
imported procedure agents#transformer_init(_?, _?).
imported procedure agents#consumer_init(_?, _?).

exported procedure producer_init(_?, _?).
producer_init(Id, In) :- agents # producer_init(Id?, In?).

exported procedure transformer_init(_?, _?).
transformer_init(Id, In) :- agents # transformer_init(Id?, In?).

exported procedure consumer_init(_?, _?).
consumer_init(Id, In) :- agents # consumer_init(Id?, In?).
