%% three_agent_pipeline_boot.glp - Three-agent pipeline: produce -> transform -> consume
%%
%% madGLP equivalent of the old IRMA three_agent_pipeline_test:
%%   Old: @1 produces [1,2,3], @2 transforms to [got(1),got(2),got(3)], @3 wraps as done(List)
%%   New: agent1 sends [1,2,3] to agent2, agent2 transforms and sends to agent3,
%%        agent3 wraps result
%%
%% Data flow: agent1 -> agent2 -> agent3
%%
%% Date: 2026-02-10
%
% The agent code is the program directory three_agent_pipeline/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@agent1,
    say(producer_init, agent1, [agent2], ch(_?, _))@agent1,
    agent(ch(_?, _), ch(_?, _))@agent2,
    say(transformer_init, agent2, [agent3], ch(_?, _))@agent2,
    agent(ch(_?, _), ch(_?, _))@agent3,
    say(consumer_init, agent3, [], ch(_?, _))@agent3.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), which the program, three_agent_pipeline/, answers: a boot defines no agent/2, and the person goal's first act names the entry the program starts (IGLP 30c04c5, Implementation Notes, "Boot").  The person scripted at each agent, say/4, run on its person channel in the person's place, tells the agent the entry, with its own key and the keys of the peers its person knows, its ground arguments; an agent is its public key, and a readable name here is a variable standing for one (Remark "Agent Names"), the agent's key having been made at its spawn.

%% The person at each agent: it tells the agent its role, its key and the keys of the peers it knows, its ground arguments, and reads nothing.
PersonSays ::= init(Constant, Key, List(Key)).

exported procedure say(Constant?, Key?, List(Key)?, Channel(Stream(Constant), Stream(PersonSays))?).
say(R, Me, Ps, ch(_, [init(R?, Me?, Ps?)])).
