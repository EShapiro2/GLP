%% reversed_flow_boot.glp - Reversed one-way flow: agent2 sends to agent1
%%
%% madGLP equivalent of the old IRMA reversed_flow_test:
%%   Old: @2 has writer X, runs p(X) binding X=[a,b]; @1 has reader X?, runs q(X?)
%%   New: agent2 sends [a,b] to agent1 via network, agent1 processes received list
%%
%% Data flow: agent2 -> agent1 (reversed direction from shared_variable)
%%
%% Date: 2026-02-10
%
% The agent code is the program directory reversed_flow/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@agent1,
    say(agent1_init, agent1, [], ch(_?, _))@agent1,
    agent(ch(_?, _), ch(_?, _))@agent2,
    say(agent2_init, agent2, [agent1], ch(_?, _))@agent2.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), which the program, reversed_flow/, answers: a boot defines no agent/2, and the person goal's first act names the entry the program starts (IGLP 30c04c5, Implementation Notes, "Boot").  The person scripted at each agent, say/4, run on its person channel in the person's place, tells the agent the entry, with its own key and the keys of the peers its person knows, its ground arguments; an agent is its public key, and a readable name here is a variable standing for one (Remark "Agent Names"), the agent's key having been made at its spawn.

%% The person at each agent: it tells the agent its role, its key and the keys of the peers it knows, its ground arguments, and reads nothing.
PersonSays ::= init(Constant, Key, List(Key)).

exported procedure say(Constant?, Key?, List(Key)?, Channel(Stream(Constant), Stream(PersonSays))?).
say(R, Me, Ps, ch(_, [init(R?, Me?, Ps?)])).
