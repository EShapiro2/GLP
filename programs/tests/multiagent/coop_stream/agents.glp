%% coop_stream/agents.glp — the agent code of coop_stream_boot.glp.
%% The entry points the boot clause spawns are exported here and
%% forwarded from self.glp; every other procedure is local to this module.
%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream(Constant)?, Stream(Constant)?, Stream(Constant)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% AGENT1: Sends list to agent2
%% =============================================================================

exported procedure agent1_init(Keys?, Stream(NetMsg(Msg))?).
agent1_init(keys(_, [Agent2]), _) :-
    send_to_net([msg(Agent2?, data([1,2,3]))]).
agent1_init(_, _) :- otherwise | true.

%% =============================================================================
%% AGENT2: Receives list, merges with local production
%% =============================================================================

exported procedure agent2_init(Keys?, Stream(NetMsg(Msg))?).
agent2_init(_, [msg(_, data(Xs))|_]) :-
    ground(Xs?) |
    merge(Xs?, [a,b,c], Zs),
    consume(Zs?).
agent2_init(_, _) :- otherwise | true.

procedure consume(Stream(Constant)?).
consume([_|Rest]) :- consume(Rest?).
consume([]).
