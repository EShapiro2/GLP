%% three_agent_merge_boot.glp - Two producers feed into one merger
%%
%% madGLP equivalent of the old IRMA three_agent_merge_test:
%%   Old: @1 produces Xs=[1,2,3], @2 produces Ys=[a,b,c], @3 merges
%%   New: agent1 sends [1,2,3] to merger, agent2 sends [a,b,c] to merger,
%%        merger receives both and merges
%%
%% Data flow: agent1 -> merger <- agent2
%%
%% NOTE: Since both messages arrive on the same NetIn stream, the merger
%% reads the first message and passes the stream rest plus the extracted
%% data to a wait procedure that reads the second message.
%% To work around the type checker's limitation with deep pattern matching
%% on reader parameters, we keep the merger simple: it just receives one
%% message and merges with a local list (demonstrating the merge logic).
%%
%% Date: 2026-02-10
%
% The agent code is the program directory three_agent_merge/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@agent1,
    say(producer1_init, agent1, [merger], ch(_?, _))@agent1,
    agent(ch(_?, _), ch(_?, _))@agent2,
    say(producer2_init, agent2, [merger], ch(_?, _))@agent2,
    agent(ch(_?, _), ch(_?, _))@merger,
    say(merger_init, merger, [], ch(_?, _))@merger.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), which the program, three_agent_merge/, answers: a boot defines no agent/2, and the person goal's first act names the entry the program starts (IGLP 30c04c5, Implementation Notes, "Boot").  The person scripted at each agent, say/4, run on its person channel in the person's place, tells the agent the entry, with its own key and the keys of the peers its person knows, its ground arguments; an agent is its public key, and a readable name here is a variable standing for one (Remark "Agent Names"), the agent's key having been made at its spawn.

%% The person at each agent: it tells the agent its role, its key and the keys of the peers it knows, its ground arguments, and reads nothing.
PersonSays ::= init(Constant, Key, List(Key)).

exported procedure say(Constant?, Key?, List(Key)?, Channel(Stream(Constant), Stream(PersonSays))?).
say(R, Me, Ps, ch(_, [init(R?, Me?, Ps?)])).
