%% three_agent_merge_boot.glp - Two producers feed into one merger
%%
%% madGLP equivalent of the old IRMA three_agent_merge_test:
%%   Old: @1 produces Xs=[1,2,3], @2 produces Ys=[a,b,c], @3 merges
%%   New: agent1 sends [1,2,3] to merger, agent2 sends [a,b,c] to merger,
%%        merger receives both and merges
%%
%% Data flow: agent1 -> merger <- agent2
%%
%% NOTE: Since both messages arrive on the same NetIn stream, the merger
%% reads the first message and passes the stream rest plus the extracted
%% data to a wait procedure that reads the second message.
%% To work around the type checker's limitation with deep pattern matching
%% on reader parameters, we keep the merger simple: it just receives one
%% message and merges with a local list (demonstrating the merge logic).
%%
%% Date: 2026-02-10
%
% The agent code is the program directory three_agent_merge/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@agent1,
    say(agent1, ch(_?, _))@agent1,
    agent(ch(_?, _), ch(_?, _))@agent2,
    say(agent2, ch(_?, _))@agent2,
    agent(ch(_?, _), ch(_?, _))@merger,
    say(merger, ch(_?, _))@merger.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)) (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/2, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name, by which agent/2 starts the agent's program on the network input, the agent's key having been made at its spawn.
exported procedure(X) agent(Channel(Stream(Constant), Stream(Constant))?, Channel(Stream(NetMsg(X)), Stream(NetMsg(X)))?).
agent(ch(In, []), ch(N, [])) :- start(In?, N?).

%% The agent's program, by the name its person tells it.
procedure(X) start(Stream(Constant)?, Stream(NetMsg(X))?).
start([agent1 | _], N) :- producer1_init(agent1, N?).
start([agent2 | _], N) :- producer2_init(agent2, N?).
start([merger | _], N) :- merger_init(merger, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name, and reads nothing.
exported procedure say(Constant?, Channel(Stream(Constant), Stream(Constant))?).
say(P, ch(_, [P?])).
