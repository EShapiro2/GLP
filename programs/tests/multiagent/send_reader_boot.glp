%% send_reader_boot.glp - Send unbound reader, instantiate later
%%
%% Agent1 sends data(X?) with unbound reader X? to agent2.
%% Agent1 then binds X = done.
%% Agent2 receives data(Y), waits for Y? to become ground, completes.
%%
%% Tests globalize-reader path: X? is unbound at send time, so
%% globalize creates _r(agent1, i) and spawns global_send(X?, ...).
%% When agent1 binds X=done, the global_send fires and sends to agent2.
%
% The agent code is the program directory send_reader/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.
%
% Each agent's second argument is `_`, as in every other boot here: until
% 2026-10-14 the receiver's was `_?`, an anonymous reader, which a clause may
% not hold (GLP-Spec glp.tex, Remark "Anonymous Variables"); what the test
% exercises is the sender's unbound reader X?, not that argument.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@agent1,
    say(sender_init, agent1, [agent2], ch(_?, _))@agent1,
    agent(ch(_?, _), ch(_?, _))@agent2,
    say(receiver_init, agent2, [], ch(_?, _))@agent2.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)) (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/4, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its role, its own key and the keys of the peers its person knows, its ground arguments, by which agent/2 starts the agent's program on the network input; an agent is its public key, and alice or bob here is a variable standing for one (IGLP 670d36a, Remark "Agent Names"), the agent's key having been made at its spawn.
exported procedure(X) agent(Channel(Stream(PersonSays), Stream(Constant))?, Channel(Stream(NetMsg(X)), Stream(NetMsg(X)))?).
agent(ch(In, []), ch(N, [])) :- start(In?, N?).

%% The agent's program, by the role its person tells it, with its own key and its peers' keys, keys(Me, Ps).
procedure(X) start(Stream(PersonSays)?, Stream(NetMsg(X))?).
start([init(sender_init, Me, Ps) | _], N) :- sender_init(keys(Me?, Ps?), N?).
start([init(receiver_init, Me, Ps) | _], N) :- receiver_init(keys(Me?, Ps?), N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its role, its key and the keys of the peers it knows, its ground arguments, and reads nothing.
PersonSays ::= init(Constant, Key, List(Key)).

exported procedure say(Constant?, Key?, List(Key)?, Channel(Stream(Constant), Stream(PersonSays))?).
say(R, Me, Ps, ch(_, [init(R?, Me?, Ps?)])).
