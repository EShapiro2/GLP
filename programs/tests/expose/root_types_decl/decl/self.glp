%% IGLP probe: a self.glp declaration naming a type an ancestor exposes.  The
%% self.glp one directory up lifts NetStream from lib/nets.glp into every scope
%% below it (TGLP modules.tex, "The -expose directive"), so the named-parameter
%% declarations below resolve it, and the unnamed ones take it as the type it
%% is and not as a parameter.  Run by test/compiler/exposed_root_types_test.dart.

imported procedure(Z) app#pass(NetStream?, Z?).
imported procedure app#count(NetStream?, Integer).

exported procedure(Z) pass(NetStream?, Z?).
pass(S, Z) :- app # pass(S?, Z?).

exported procedure count(NetStream?, Integer).
count(S, N?) :- app # count(S?, N).
