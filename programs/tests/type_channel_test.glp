%% Test case for Channel type checking
%% The issue: When Channel appears at Channel? position,
%% recursive complementation flips internal modes incorrectly

%% Type definitions
Msg ::= hello ; goodbye.
MsgChannel ::= Channel(Stream(Msg), Stream(Msg)).
Response ::= accept(MsgChannel) ; no.

%% Handler receives Response? (consumed)
%% Inside Response?, we have MsgChannel? which has:
%%   - With recursive complementation: ch(Stream, Stream?) - WRONG
%%   - With explicit dual: ch(Stream?, Stream) - CORRECT (fixed semantics)

procedure handle_response(Response?, Stream(Msg)?, Stream(Msg)).
handle_response(accept(ch(FIn, FOut)), In, In1) :-
    merge(In?, FIn?, In1).
handle_response(no, In, In?).

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).
