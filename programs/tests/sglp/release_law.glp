%% sGLP test (iv): the law of Proposition "Time to the Next Release" (svGLP,
%% sections/sglp.tex).  Three goals of rates 1, 2 and 5 per second each spawn
%% themselves again, rated, when released, so at every quiescent
%% configuration exactly three goals are pending, of rates 1, 2 and 5 and
%% nothing else.  The times between Releases are exponential with rate 8, and
%% each Release is of the goal of rate r with probability r/8.

procedure run.
run :- a(1000000) @ 1/second, b(1000000) @ 2/second, c(1000000) @ 5/second.

procedure a(Integer?).
a(0).
a(K) :- K? > 0 | K1 := K? - 1, a(K1?) @ 1/second.

procedure b(Integer?).
b(0).
b(K) :- K? > 0 | K1 := K? - 1, b(K1?) @ 2/second.

procedure c(Integer?).
c(0).
c(K) :- K? > 0 | K1 := K? - 1, c(K1?) @ 5/second.
