%% sGLP person/2 with interactive types in writer mode: svGLP's Coins Among
%% Friends, sections/sglp.tex, Section "Example: Coins Among Friends", at svGLP
%% 115ed79.  Menu and Offer are in writer mode, so the asking clause of the
%% canonical compilation (vGLP, sections/elicitation.tex, Definition
%% "Canonical Compilation") passes the reader of the interactive variable,
%% person('Menu', X?) and person('Offer', X?), before the call that writes it.
%%
%% The compilation is written by hand; vGLP's compiler is not run.  What this
%% file supplies that the paper does not: add, take and held, which the paper
%% describes and elides; the declarations of settle, receive and issuer, and
%% Msg's definition, which the paper takes from Section "Example: The
%% Grassroots Social Graph"; the agent's clauses made contiguous, settle and
%% receive after them; `:- true |` written `:-`, true not being a guard;
%% one_of's parameter list; length and nth, nth over OpenStream(X); paid/5,
%% since the paper's pay clause reads W1? twice without a ground guard, which
%% SRSW refuses; start/4, the initial goal; and a run of 2 agents for four
%% weeks where the paper has 1000 for five years.

Peer    ::= Constant.
YesNo   ::= yes ; no.
Peers   ::= [] ; [Peer | Peers].
Holding ::= holding(Peer, Integer).
Wallet  ::= [] ; [Holding | Wallet].
Request ::= pay(Peer, Integer) ; swap(Peer, Integer).
Menu    ::= menu(Peers, Wallet, Request?).
Offer   ::= offer(Peer, Integer, Integer, YesNo?).
Content ::= coins(Peer, Integer) ; propose(Peer, Integer) ; declined.
Msg     ::= msg(Peer, Content).

%% (Menu)*ask(Peers?, Wallet?, Request): the asking clause and the clause.
procedure ask(Peers?, Wallet?, Request).
ask(Fs, W, R?) :- person('Menu', X?), ask1(Fs?, W?, R, X).
procedure ask1(Peers?, Wallet?, Request, Menu).
ask1(Fs, W, R?, menu(Fs?, W?, R)).

%% (Offer)*respond(Peer?, Integer?, Integer?, YesNo): likewise.
procedure respond(Peer?, Integer?, Integer?, YesNo).
respond(From, K, Held, A?) :-
    person('Offer', X?), respond1(From?, K?, Held?, A, X).
procedure respond1(Peer?, Integer?, Integer?, YesNo, Offer).
respond1(From, K, Held, A?, offer(From?, K?, Held?, A)).

procedure agent(Peer?, Peers?, Wallet?, Request?,
                Stream(Msg)?, Stream(Msg)).
%% Pay: send the friend their coins, up to K of them, and ask again.
agent(Id, Fs, W, pay(F, K), NetIn, [msg(F?, coins(F?, N?))|Outs?]) :-
    ground(Id?), ground(Fs?), ground(W?), ground(F?), ground(K?) |
    take(W?, F?, K?, W1, N), paid(Id?, Fs?, W1?, NetIn?, Outs).
%% Swap: propose K of my coins for K of the friend's, and ask again.
agent(Id, Fs, W, swap(F, K), NetIn,
      [msg(F?, propose(Id?, K?))|Outs?]) :-
    ground(Id?), ground(Fs?), ground(W?), ground(F?), ground(K?) |
    ask(Fs?, W?, R),
    agent(Id?, Fs?, W?, R?, NetIn?, Outs).
%% A proposal arrives: put it to the person, and settle on their answer.
agent(Id, Fs, W, R, [msg(_, propose(From, K))|NetIn],
      [msg(From?, C?)|Outs?]) :-
    ground(Id?), ground(W?), ground(From?), ground(K?) |
    held(W?, From?, Held), respond(From?, K?, Held?, A),
    settle(A?, Id?, From?, K?, W?, W1, C),
    agent(Id?, Fs?, W1?, R?, NetIn?, Outs).
%% Coins arrive: my own are redeemed, a friend's are held.
agent(Id, Fs, W, R, [msg(_, coins(Issuer, N))|NetIn], Outs?) :-
    ground(Id?), ground(W?), ground(Issuer?), ground(N?) |
    receive(Id?, Issuer?, N?, W?, W1),
    agent(Id?, Fs?, W1?, R?, NetIn?, Outs).
%% A proposal declined.
agent(Id, Fs, W, R, [msg(_, declined)|NetIn], Outs?) :-
    agent(Id?, Fs?, W?, R?, NetIn?, Outs).

%% Not the paper's: its pay clause reads W1? twice, in ask and in agent,
%% with no ground guard, which SRSW refuses; the guard waits for take's wallet.
procedure paid(Peer?, Peers?, Wallet?, Stream(Msg)?, Stream(Msg)).
paid(Id, Fs, W, NetIn, Outs?) :- ground(Fs?), ground(W?) |
    ask(Fs?, W?, R), agent(Id?, Fs?, W?, R?, NetIn?, Outs).

%% Yes: hold K of the friend's coins, and send them K of mine.
procedure settle(YesNo?, Peer?, Peer?, Integer?, Wallet?, Wallet, Content).
settle(yes, Id, From, K, W, W1?, coins(Id?, K?)) :-
    ground(From?), ground(K?) | add(W?, From?, K?, W1).
settle(no, _, _, _, W, W?, declined).

procedure receive(Peer?, Peer?, Integer?, Wallet?, Wallet).
receive(Id, Id1, _, W, W?) :- Id? =?= Id1? | true.
receive(_, Issuer, N, W, W1?) :- otherwise | add(W?, Issuer?, N?, W1).

%% add adds N coins of an issuer.
procedure add(Wallet?, Peer?, Integer?, Wallet).
add([], I, N, [holding(I?, N?)]).
add([holding(I, M)|W], J, N, [holding(I?, M1?)|W?]) :-
    I? =?= J? | M1 := M? + N?.
add([holding(I, M)|W], J, N, [holding(I?, M?)|W1?]) :-
    otherwise | add(W?, J?, N?, W1).

%% take removes up to K of an issuer's coins, removes a holding that reaches
%% zero, and returns how many it removed.
procedure take(Wallet?, Peer?, Integer?, Wallet, Integer).
take([], _, _, [], 0).
take([holding(I, M)|W], F, K, W?, M?) :- I? =?= F?, M? =< K? | true.
take([holding(I, M)|W], F, K, [holding(I?, M1?)|W?], K?) :-
    I? =?= F?, M? > K? | M1 := M? - K?.
take([holding(I, M)|W], F, K, [holding(I?, M?)|W1?], N?) :-
    otherwise | take(W?, F?, K?, W1, N).

%% held returns how many of an issuer's coins are held.
procedure held(Wallet?, Peer?, Integer).
held([], _, 0).
held([holding(I, M)|_], F, M?) :- I? =?= F? | true.
held([holding(_, _)|W], F, N?) :- otherwise | held(W?, F?, N).

%% The initial goal of an agent: an empty wallet, and the first menu.
procedure start(Peer?, Peers?, Stream(Msg)?, Stream(Msg)).
start(Id, Fs, NetIn, Outs?) :- ground(Id?), ground(Fs?) |
    ask(Fs?, [], R), agent(Id?, Fs?, [], R?, NetIn?, Outs).

%% One of a list, drawn uniformly (Section "Example: The Kinds of the Social
%% Graph", which writes the declaration without its parameter list).
procedure(X) one_of(Stream(X)?, Integer?, X).
one_of(Xs, S, X?) :- ground(Xs?) |
    length(Xs?, N), random(S?, N?, K, _), nth(K?, Xs?, X).

procedure(X) length(Stream(X)?, Integer).
length([], 0).
length([_|Xs], N?) :- length(Xs?, N1), N := N1? + 1.

procedure(X) nth(Integer?, OpenStream(X)?, X).
nth(1, [X|_], X?).
nth(K, [_|Xs], X?) :- K? > 1 | K1 := K? - 1, nth(K1?, Xs?, X).

%% Pay a friend whose coins I hold one to five; holding none,
%% propose a swap of ten to a friend.
procedure request(Integer?, Menu?).
request(S, menu(Fs, [], swap(F?, 10))) :-
    ground(Fs?) | one_of(Fs?, S?, F).
request(S, menu(_, [H|Hs], pay(F?, K?))) :-
    ground(H?), ground(Hs?) |
    random(S?, 5, K, S1), one_of([H?|Hs?], S1?, Hd), issuer(Hd?, F).
procedure issuer(Holding?, Peer).
issuer(holding(F, _), F?).

person spender.
Menu =::= spender_menu.
procedure spender_menu(Menu?, Integer?).
spender_menu(M, S) :- request(S?, M?) @ 1/day.

person saver.
Menu =::= saver_menu.
procedure saver_menu(Menu?, Integer?).
saver_menu(M, S) :- request(S?, M?) @ 1/week.

person generous.
Offer =::= generous_offer.
procedure generous_offer(Offer?, Integer?).
generous_offer(O, _) :- accept(O?) @ 1/hour.
procedure accept(Offer?).
accept(offer(_, _, _, yes)).

person cautious.
Offer =::= cautious_offer.
procedure cautious_offer(Offer?, Integer?).
cautious_offer(O, _) :- weigh(O?) @ 1/hour.
procedure weigh(Offer?).
weigh(offer(_, _, Held, yes)) :- Held? =< 20 | true.
weigh(offer(_, _, Held, no))  :- Held? > 20  | true.

run 2 agents [ spending ~ (spender : 0.5 ; saver : 0.5),
               credit ~ (generous : 0.5 ; cautious : 0.5) ]
    until 4 weeks seed 20260927.
