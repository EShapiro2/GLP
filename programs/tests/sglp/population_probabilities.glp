%% sGLP population check, negative: a dimension whose probabilities do not
%% sum to one (0.6 + 0.3).

Menu ::= menu(Choice?).
Choice ::= left ; right.

person lefty.
Menu =::= lefty_menu.
procedure lefty_menu(Menu?, Integer?).
lefty_menu(menu(left), _).

person righty.
Menu =::= righty_menu.
procedure righty_menu(Menu?, Integer?).
righty_menu(menu(right), _).

run 10 agents [ approach ~ (lefty : 0.6 ; righty : 0.3) ] until 1 day seed 1.
