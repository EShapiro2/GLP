%% sGLP test (i), second half: a released goal whose input is not there
%% suspends, and reduces when the input arrives, with no further delay
%% (svGLP, sections/sglp.tex, "a released goal is an ordinary goal").
%% wait_for(X?, Y) is released first (rate 1000/second against 1/second) and
%% suspends on X; supply(X) is released later and binds X; wait_for then
%% reduces at supply's release time, the clock having not moved.

procedure run(Integer).
run(Y?) :- wait_for(X?, Y) @ 1000/second, supply(X) @ 1/second.

procedure wait_for(Integer?, Integer).
wait_for(1, 2).

procedure supply(Integer).
supply(1).
