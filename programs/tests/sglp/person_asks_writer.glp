%% sGLP person/2 with interactive types in writer mode: svGLP's Grassroots
%% Social Graph, sections/example.tex (the vGLP program) and sections/sglp.tex,
%% Section "Example: The Kinds of the Social Graph" (the kinds), at svGLP
%% 115ed79.  Menu and Card are in writer mode, so the asking clause of the
%% canonical compilation (vGLP, sections/elicitation.tex, Definition
%% "Canonical Compilation") passes the reader of the interactive variable,
%% person('Menu', X?), X and X? exchanged, before the call that writes it.
%% person/2 binds its parameter to the input type Menu? there (TGLP,
%% parameterized-types.tex, Definition "Instantiation").
%%
%% The compilation is written by hand; vGLP's compiler is not run.  What this
%% file supplies that the paper does not: the procedure declaration of agent
%% placed immediately before its clauses; `:- true |` written `:-`, true not
%% being a guard; one_of's parameter list, which TGLP's "Declaration
%% parameters" requires; length and nth, which the paper calls GLP and does
%% not give, nth over OpenStream(X) since Stream(X) leaves [] uncovered;
%% start/5, the initial goal; and a run of 2 agents for a week where the paper
%% has 1000 for five years.

Peer    ::= Constant.
YesNo   ::= yes ; no.
Peers   ::= [] ; [Peer | Peers].
Choice  ::= same(Peer) ; other(Peer).
Menu    ::= menu(Peers, Peers, Choice?).
Card    ::= card(Peer, YesNo?).
Content ::= offer(Peer) ; reply(Peer, YesNo).
Msg     ::= msg(Peer, Content).

%% (Menu)*ask(Peers?, Peers?, Choice): the asking clause and the clause.
procedure ask(Peers?, Peers?, Choice).
ask(Ss, Os, C?) :- person('Menu', X?), ask1(Ss?, Os?, C, X).
procedure ask1(Peers?, Peers?, Choice, Menu).
ask1(Ss, Os, C?, menu(Ss?, Os?, C)).

%% (Card)*respond(Peer?, YesNo): the asking clause and the clause.
procedure respond(Peer?, YesNo).
respond(From, A?) :- person('Card', X?), respond1(From?, A, X).
procedure respond1(Peer?, YesNo, Card).
respond1(From, A?, card(From?, A)).

%% The person picked a peer: offer, and ask again.
procedure agent(Peer?, Peers?, Peers?, Choice?,
                Stream(Msg)?, Stream(Msg)).
agent(Id, Ss, Os, same(To), NetIn, [msg(To?, offer(Id?))|Outs?]) :-
    ground(Id?), ground(Ss?), ground(Os?), ground(To?) |
    ask(Ss?, Os?, Pick),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).
agent(Id, Ss, Os, other(To), NetIn, [msg(To?, offer(Id?))|Outs?]) :-
    ground(Id?), ground(Ss?), ground(Os?), ground(To?) |
    ask(Ss?, Os?, Pick),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).

%% An offer arrives: put it to the person, and reply.
agent(Id, Ss, Os, Pick, [msg(_, offer(From))|NetIn],
      [msg(From?, reply(Id?, A?))|Outs?]) :-
    ground(Id?), ground(From?) |
    respond(From?, A),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).

%% A reply to my offer arrives.
agent(Id, Ss, Os, Pick, [msg(_, reply(_, _))|NetIn], Outs?) :-
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).

%% The initial goal of an agent: ask the first menu.
procedure start(Peer?, Peers?, Peers?, Stream(Msg)?, Stream(Msg)).
start(Id, Ss, Os, NetIn, Outs?) :- ground(Ss?), ground(Os?) |
    ask(Ss?, Os?, P), agent(Id?, Ss?, Os?, P?, NetIn?, Outs).

%% One of a list, drawn uniformly (sglp.tex, which writes the declaration
%% without its parameter list; TGLP, "Declaration parameters", requires it).
procedure(X) one_of(Stream(X)?, Integer?, X).
one_of(Xs, S, X?) :- ground(Xs?) |
    length(Xs?, N), random(S?, N?, K, _), nth(K?, Xs?, X).

%% length and nth, which the paper calls GLP and does not give.
procedure(X) length(Stream(X)?, Integer).
length([], 0).
length([_|Xs], N?) :- length(Xs?, N1), N := N1? + 1.

procedure(X) nth(Integer?, OpenStream(X)?, X).
nth(1, [X|_], X?).
nth(K, [_|Xs], X?) :- K? > 1 | K1 := K? - 1, nth(K1?, Xs?, X).

person homophile.
Menu =::= homophile_menu.
procedure homophile_menu(Menu?, Integer?).
homophile_menu(M, S) :-
    random(S?, 100, K, S1), homophile_pick(K?, S1?, M?) @ 1/week.
procedure homophile_pick(Integer?, Integer?, Menu?).
homophile_pick(K, S, menu(Ss, _, same(P?))) :-
    K? =< 98, ground(Ss?) | one_of(Ss?, S?, P).
homophile_pick(K, S, menu(_, Os, other(P?))) :-
    K? > 98, ground(Os?) | one_of(Os?, S?, P).

person indifferent.
Menu =::= indifferent_menu.
procedure indifferent_menu(Menu?, Integer?).
indifferent_menu(M, S) :-
    random(S?, 100, K, S1), indifferent_pick(K?, S1?, M?) @ 2/week.
procedure indifferent_pick(Integer?, Integer?, Menu?).
indifferent_pick(K, S, menu(Ss, _, same(P?))) :-
    K? =< 50, ground(Ss?) | one_of(Ss?, S?, P).
indifferent_pick(K, S, menu(_, Os, other(P?))) :-
    K? > 50, ground(Os?) | one_of(Os?, S?, P).

person wary.
Card =::= wary_card.
procedure wary_card(Card?, Integer?).
wary_card(C, S) :-
    random(S?, 100, K, _), wary_answer(K?, C?) @ 1/day.
procedure wary_answer(Integer?, Card?).
wary_answer(K, card(_, yes)) :- K? =< 20 | true.
wary_answer(K, card(_, no))  :- K? > 20  | true.

person sociable.
Card =::= sociable_card.
procedure sociable_card(Card?, Integer?).
sociable_card(C, S) :-
    random(S?, 100, K, _), sociable_answer(K?, C?) @ 1/hour.
procedure sociable_answer(Integer?, Card?).
sociable_answer(K, card(_, yes)) :- K? =< 90 | true.
sociable_answer(K, card(_, no))  :- K? > 90  | true.

run 2 agents [ approach ~ (homophile : 0.6 ; indifferent : 0.4),
               response ~ (wary : 0.7 ; sociable : 0.3) ]
    until 1 week seed 20260927.
