%% IGLP's linker fixture, programs/tests/linker_tree, for program_linker_test.dart and program_compilation_test.dart: the child agent, a vGLP module beside its compiled child.glp, programs/cssn/childsafe/child.vglp as it stood at GLP d2495778, its comments removed and three names changed: the directory childsafe to agents, the module and procedure superapp to host, and the procedures cssn and cssn_child to app and app_child.

ConsentAsk ::= none ; ask(GroupId, YesNo?).

imported procedure adult#adult(Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

exported procedure (Stream(Request)?)*child_agent(Key?, ParentEnds?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

(Reqs)*child_agent(Id, Es, AgentIn, NetIn, Convs, Outs, St) :-
    enter_child_side(Es?, Ps, Outs?, Outs1, NetIn?, NetIn1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).

exported procedure child(Stream(Request)?, Key?, Stream(Key)?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

child(Reqs, Id, Ps, [outcome(consented(Peer, C?))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Peer?) |
    already_friend(Peer?, Outs?, Outs1, Known),
    convey(Known?, Peer?, C, Outs1?, Outs2, NetIn?, NetIn1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

child(Reqs, Id, Ps, [outcome(adopt(Peer, Ch))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Peer?) |
    adopt(Peer?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).

child(Reqs, Id, Ps, [outcome(declined(Peer))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Peer?) |
    show(declined(Peer?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child(Reqs, Id, Ps, [group_reply(G, M, yes(X?))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(G?), ground(M?) |
    setup_group_hub_side(G?, M?, St?, St1, Outs?, Outs1, NetIn?, NetIn1, X),
    show(member_joined(G?, M?), Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St1?).
child(Reqs, Id, Ps, [group_reply(_, M, no)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(M?) |
    show(declined(M?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child(Reqs, Id, Ps, [group_joined(G, Ch)|AgentIn], NetIn, Convs, Outs, St) :-
    join_commit(G?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).

child(Reqs, Id, Ps, [invite_now(G, M)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?), ground(M?) |
    send_friend(M?, msg(Id?, M?, group_invite(G?, R)), Outs?, Outs1),
    inject_group_reply(G?, M?, R?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

child(Reqs, Id, Ps, AgentIn, NetIn, [conversation(Q, ch(_, []))|Convs], Outs, St) :-
    ground(Q?) |
    show(refused(Q?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child(Reqs, Id, Ps, AgentIn, [msg(_, To, item(X))|NetIn], Convs, Outs, St) :-
    Id? =?= To? |
    receive_item(X?, St?, St1, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

child(Reqs, Id, Ps, AgentIn, [msg(From, To, unfriend)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    show(unfriended(From?), Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

child(Reqs, Id, Ps, AgentIn, [msg(From, To, child_intro(I, Cs))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?), ground(I?), ground(Ps?) |
    member_of(From?, Ps?, FromParent),
    on_intro(FromParent?, I?, Cs?, Id?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

child(Reqs, Id, Ps, AgentIn, [msg(_, To, unfriend_child(F))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(F?) |
    send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1),
    close_friend(F?, Outs1?, Outs2),
    show(unfriended(F?), Outs2?, Outs3),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs3?, St?).

child(Reqs, Id, Ps, AgentIn, [msg(_, To, leave_group(G))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?) |
    leave_group_commit(Id?, G?, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child(Reqs, Id, [P|Ps], AgentIn, [msg(From, To, group_invite(G, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?), ground(G?), ground(P?), ground(Ps?) |
    member_of(From?, [P?|Ps?], FromParent),
    on_group_invite(FromParent?, G?, R, Out, Ask),
    send_consent_req(Ask?, P?, Id?, Outs?, Outs1),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, [P?|Ps?], AgentIn1?, NetIn?, Convs?, Outs1?, St?).

child(Reqs, Id, Ps, AgentIn, [msg(_, _, group_msg(group_id(L, N), Y))|NetIn], Convs, Outs, St) :-
    L? =?= Id?, ground(L?), ground(N?) |
    hold_post(group_id(L?, N?), Y?, St?, St1, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

child(Reqs, Id, Ps, AgentIn, [msg(_, _, group_msg(group_id(L, N), Z))|NetIn], Convs, Outs, St) :-
    L? =?\= Id?, ground(L?), ground(N?) |
    receive_delivery(group_id(L?, N?), Z?, St?, St1, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

child(Reqs, Id, Ps, AgentIn, [msg(M, _, group_leave(G, M1))|NetIn], Convs, Outs, St) :-
    ground(G?), ground(M?), M? =?= M1? |
    close_output(group_member(G?, M?), Outs?, Outs1),
    show(member_left(G?, M?), Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

child(Reqs, Id, Ps, AgentIn, [msg(P, To, of_age)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(P?), ground(Ps?) |
    of_age_all(P?, Id?, Ps?, Outs?, Outs1),
    show(of_age, Outs1?, Outs2),
    adult # adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

child([introduce(R, _, _)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).
child([declare_of_age(R)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child([sign(T)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    sign_item(Id?, T?, St?, St1, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

child([forward(F, X)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    forward_item(Id?, F?, X?, St?, St1, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

child([unfriend(F)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?) |
    send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1),
    close_friend(F?, Outs1?, Outs2),
    show(unfriended(F?), Outs2?, Outs3),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs3?, St?).

child([unfriend_child(R, _)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child([create_group(N)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?) |
    setup_group_leader(group_id(Id?, N?), Outs?, Outs1, NetIn?, NetIn1),
    show(group_joined(group_id(Id?, N?)), Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

child([invite(N, F)|Reqs], Id, [P|Ps], AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(F?), ground(P?) |
    send_parent(P?, msg(Id?, P?, invite_consent_req(group_id(Id?, N?), F?, Consent)), Outs?, Outs1),
    invite_after(Consent?, group_id(Id?, N?), F?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, [P?|Ps?], AgentIn1?, NetIn?, Convs?, Outs1?, St?).

child([invite_child(N, C, Q)|Reqs], Id, [P|Ps], AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(C?), ground(Q?), ground(P?) |
    send_parent(P?, msg(Id?, P?, invite_consent_req(group_id(Id?, N?), C?, Consent)), Outs?, Outs1),
    invite_child_after(Consent?, group_id(Id?, N?), C?, Q?, Id?, Outs1?, Outs2, AgentIn?, AgentIn1),
    child(Reqs?, Id?, [P?|Ps?], AgentIn1?, NetIn?, Convs?, Outs2?, St?).

child([post(G, X)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    post_item(Id?, G?, X?, St?, St1, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

child([leave(G)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?) |
    leave_group_commit(Id?, G?, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child([leave_child(R, _)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

procedure on_intro(Decision?, Intro?, Consents?, Key?, Stream(AgentIn)).
on_intro(yes, intro(P0, R, S), Cs, Id, Out?) :-
    ground(Id?), ground(R?), ground(S?), ground(P0?) |
    peer_of(Id?, R?, S?, Peer),
    accept(intro(P0?, R?, S?), A),
    accepted(A?, Peer?, Cs?, Out).
on_intro(no, _, Cs, _, Out?) :-
    accepted(no, none, Cs?, Out).

procedure peer_of(Key?, Key?, Key?, Key).
peer_of(Id, R, S, S?) :- Id? =?= R? | true.
peer_of(Id, R, _, R?) :- Id? =?\= R? | true.

procedure on_group_invite(Decision?, GroupId?, GroupReply, Stream(AgentIn), ConsentAsk).
on_group_invite(yes, G, R?, Out?, none) :-
    ground(G?) |
    join_group(group(G?), A),
    joined(A?, G?, R, Out).
on_group_invite(no, G, R?, Out?, ask(G?, Consent)) :-
    ground(G?) |
    consented_join(Consent?, G?, R, Out).

procedure send_consent_req(ConsentAsk?, Key?, Key?, Stream(OutputEntry)?, Stream(OutputEntry)).
send_consent_req(none, _, _, Outs, Outs?).
send_consent_req(ask(G, Consent?), P, Id, Outs, Outs1?) :-
    ground(P?), ground(Id?) |
    send_parent(P?, msg(Id?, P?, group_consent_req(G?, Consent)), Outs?, Outs1).

procedure consented_join(YesNo?, GroupId?, GroupReply, Stream(AgentIn)).
consented_join(yes, G, R?, Out?) :-
    ground(G?) |
    join_group(group(G?), A),
    joined(A?, G?, R, Out).
consented_join(no, _, no, []).

procedure invite_after(YesNo?, GroupId?, Key?, Stream(AgentIn)).
invite_after(yes, G, M, [invite_now(G?, M?)]).
invite_after(no, _, _, []).

procedure invite_child_after(YesNo?, GroupId?, Key?, Key?, Key?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(AgentIn)?, Stream(AgentIn)).
invite_child_after(yes, G, C, Q, Id, Outs, Outs1?, AgentIn, AgentIn1?) :-
    ground(Q?), ground(Id?), ground(G?), ground(C?) |
    send_friend(Q?, msg(Id?, Q?, group_invite_child(G?, C?, R)), Outs?, Outs1),
    inject_group_reply(G?, C?, R?, AgentIn?, AgentIn1).
invite_child_after(no, _, _, _, _, Outs, Outs?, AgentIn, AgentIn?).

procedure of_age_all(Key?, Key?, Stream(Key)?, Stream(OutputEntry)?, Stream(OutputEntry)).
of_age_all(P, Id, [Q|Qs], Outs, Outs2?) :-
    P? =?= Q?, ground(P?) |
    close_parent(Q?, Outs?, Outs1),
    of_age_all(P?, Id?, Qs?, Outs1?, Outs2).
of_age_all(P, Id, [Q|Qs], Outs, Outs3?) :-
    P? =?\= Q?, ground(Q?), ground(Id?) |
    send_parent(Q?, msg(Id?, Q?, of_age_notice), Outs?, Outs1),
    close_parent(Q?, Outs1?, Outs2),
    of_age_all(P?, Id?, Qs?, Outs2?, Outs3).
of_age_all(_, _, [], Outs, Outs?).
