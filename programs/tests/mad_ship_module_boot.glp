%% mad_ship_module_boot.glp — a module value shipped from one agent to another
%% and activated there by run/3 (GLP-Spec appendix-guards, "Compilation and
%% file reading" and "Dynamic activation").
%%
%% alice reads a certified mini-app, hello/1 alone, from the artefact
%% mad_ship_hello.glpw beside her program with load_file/2, and sends its
%% module value to bob in a message; bob receives it as a value of type
%% Module, obtains the type identity of hello/1 in his own scope with
%% find_type/2, and activates the shipped module with run/3 under that
%% identity, posting hello(Z) to it.  The machine activates no program whose
%% certificate does not verify (GSG s6-security.tex, G1), so what is shipped is
%% a certified mini-app and not alice's own program.  The agent code is the
%% program directory mad_ship_module/; the mini-app is mad_ship_hello/, whose
%% artefact the REPL's :artefact writes into mad_ship_module/ before the boot
%% (harness Section MB, MB2).

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice_init, alice, [bob], ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob_init, bob, [], ch(_?, _))@bob.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), which the program, mad_ship_module/, answers: a boot defines no agent/2, and the person goal's first act names the entry the program starts (IGLP 30c04c5, Implementation Notes, "Boot").  The person scripted at each agent, say/4, run on its person channel in the person's place, tells the agent the entry, with its own key and the keys of the peers its person knows, its ground arguments; an agent is its public key, and a readable name here is a variable standing for one (Remark "Agent Names"), the agent's key having been made at its spawn.

%% The person at each agent: it tells the agent its role, its key and the keys of the peers it knows, its ground arguments, and reads nothing.
PersonSays ::= init(Constant, Key, List(Key)).

exported procedure say(Constant?, Key?, List(Key)?, Channel(Stream(Constant), Stream(PersonSays))?).
say(R, Me, Ps, ch(_, [init(R?, Me?, Ps?)])).
