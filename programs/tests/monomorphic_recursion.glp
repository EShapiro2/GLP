%% monomorphic_recursion.glp — regression guard: recursion is monomorphic.
%%
%% wrap threads Stream(X) -> Stream(Box(X)): the element type goes one Box
%% deeper from input to output. ploop calls itself on wrap's output, so the
%% recursive call is at a STRICTLY DIFFERENT instantiation than the enclosing
%% clause. The typed-program rule (Parameterised Procedure Declarations) makes
%% recursion monomorphic: the recursive ploop(W?) is checked at the enclosing
%% instantiation ploop(Stream(Msg)?), and W : Stream(Box(Msg)) is not that — a
%% type error. This is what keeps the reachable-type set finite for the
%% procedure closure (no need for any size bound).
%%
%% Behaviour:
%%   - Rejected: "No instantiation of wrap/2 for the call wrap(S?, W): argument
%%     2, W, is to hold Stream<Msg>, and no expansion of Stream(Box(X)) is
%%     within it" — W is consumed (by the recursive ploop, checked
%%     monomorphically) at Stream(Msg), and wrap produces a Stream(Box(X))
%%     whatever X its sites supply (TGLP appendix-implementation-notes.tex, "The
%%     instantiation of a call").  Until 2026-10-02 wrap was checked at the
%%     X = Msg its first argument supplies, and the refusal was "(W, W?) not
%%     dual ... Stream<Box<Msg>> is not a subtype of Stream<Msg>".
%%
%% Run (from /Users/udi/Grassroots/GLP/glp_runtime/):
%%   printf 'load ../programs/tests/monomorphic_recursion.glp\n:quit\n' | bin/glpc


Msg ::= m.
Box(X) ::= box(X).

%% Type-changing: input element X, output element box(X) — one Box deeper.
procedure(X) wrap(Stream(X)?, Stream(Box(X))).
wrap([E|In], [box(E?)|Out?]) :- wrap(In?, Out).
wrap([], []).

%% Recursive driver: ploop@Msg would call ploop@Box(Msg) — polymorphic recursion.
procedure(X) ploop(Stream(X)?).
ploop(S) :- wrap(S?, W), ploop(W?).
ploop([]).

procedure go(Stream(Msg)?).
go(S) :- ploop(S?).
