%% Invalid-guard fixture.  GLP has no guard negation: a guard is a conjunction
%% of guard predicates (GLP-Spec glp.tex, Definition "Guarded Clause"), and
%% guard negation left the language on 2026-10-01 (GLP-Spec 98913b4).  So
%% ~d(X?) below is refused by the parser, as a syntax error, before the defined
%% guard d/1 is ever looked at.
Res ::= yes ; no.

procedure d(Integer?).
d(1).

procedure use(Integer?, Res).
use(X, R?) :- ~d(X?) | R = no.
