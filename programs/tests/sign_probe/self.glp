%% IGLP probe: the signature kernels behind self_key/1, sign/3 and signature/2
%% (GLP-Spec appendix-guards, "Identity and signature"; Secure GLP, §The
%% Seam), and decompose_module/4 (ibid., "Module as a value").
%% roundtrip/2 signs a ground term under this person's key and takes the signed
%% term apart again; the signer's key is self_key's answer, the module identity
%% is this program's source identity, and the term comes back as it went.
%% signer/2 takes a signed term from the caller and reports its signer, or
%% unsigned where it is not a signed term whose signature verifies.

imported procedure probe#roundtrip(_?, _).
imported procedure probe#signer(_?, _).
imported procedure probe#identities(Key, Hash, Hash).

exported procedure roundtrip(_?, _).
roundtrip(T, R?) :- probe # roundtrip(T?, R).

exported procedure signer(_?, _).
signer(S, K?) :- probe # signer(S?, K).

exported procedure identities(Key, Hash, Hash).
identities(K?, S?, C?) :- probe # identities(K, S, C).
