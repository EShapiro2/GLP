%% Provenance: salvaged from programs/misc/ — A5 Stage A slice 5 (2026-06-13). Regression seed; not in any suite.
% Minimal test case for structures-in-lists bug

% Works: atom in list
test_atom(X?) :-
    bar([foo], X).

% Fails: structure with args in list
test_struct(X?) :-
    bar([foo(a)], X).

bar(L, X?) :-
    X = L?.
