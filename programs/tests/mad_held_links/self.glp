%% mad_held_links/self.glp — program interface.  The entry points named in
%% ../mad_held_links_boot.glp are exported here and forwarded to agents.glp,
%% which defines them.  The boot clause stays out of the directory: the boot
%% harness strips it, a directory load does not.

imported procedure agents#alice_init(Keys?, Stream(NetIn)?).
imported procedure agents#bob_init(Keys?, Stream(NetIn)?).
imported procedure agents#carol_init(Keys?, Stream(NetIn)?).

exported procedure alice_init(Keys?, Stream(NetIn)?).
alice_init(Id, In) :- agents # alice_init(Id?, In?).

exported procedure bob_init(Keys?, Stream(NetIn)?).
bob_init(Id, In) :- agents # bob_init(Id?, In?).

exported procedure carol_init(Keys?, Stream(NetIn)?).
carol_init(Id, In) :- agents # carol_init(Id?, In?).

%% Every agent's initial goal, agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), is answered by this program: "A boot defines no agent/2: the program it loads answers the initial goal, in a simulation as on a phone, and the person goal's first act names the entry the program starts" (IGLP 30c04c5, Implementation Notes, "Boot").  The person's first act, init(Entry, Me, Ps), names the entry, with the agent's own key and the keys of the peers its person knows.
PersonSays ::= init(Constant, Key, List(Key)).

%% An agent's own key with the keys of the peers its person knows, and what
%% the agents of this program send one another.
Keys ::= keys(Key, List(Key)).
Msg ::= w(String?).

%% The network input: a message, or the runtime's report of a link it holds
%% (IGLP, Held links: the report is pending_link(G, S), appended to the
%% agent's network input stream).
NetIn ::= msg(Key, Msg) ; pending_link(GlobalName, Key).

exported procedure agent(Channel(Stream(PersonSays), Stream(Constant))?, Channel(Stream(NetIn), Stream(NetMsg(Msg)))?).
%% The agent opens its PAN at its start: the boot harness sets no trust level
%% at spawn (IGLP 45fabfc, "Simulation realisation"), and the agents of the
%% boot contact one another by cold call.
agent(ch(In, []), ch(N, [])) :- declare(trust(pan, open)), start(In?, N?).

%% The agent's program, by the role its person tells it, with its own key and its peers' keys, keys(Me, Ps).
procedure start(Stream(PersonSays)?, Stream(NetIn)?).
start([init(alice_init, Me, Ps) | _], N) :- alice_init(keys(Me?, Ps?), N?).
start([init(bob_init, Me, Ps) | _], N) :- bob_init(keys(Me?, Ps?), N?).
start([init(carol_init, Me, Ps) | _], N) :- carol_init(keys(Me?, Ps?), N?).
start(_, _) :- otherwise | true.
