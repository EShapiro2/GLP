%% cons.glp — instantiates lib#relay at Stream(Item) with Item = a ; b. The
%% constant `extra` lib inserts is not a valid Item, so relay's clauses are
%% ill-typed at X = Item. The per-module check verifies cons's call against the
%% imported declaration only; the linked-program check (project_linker:
%% _seedCrossModuleInstantiations) must check lib's clauses at this instantiation
%% and reject — otherwise the type error leaks across the `#` seam (the bug this
%% guards against). Loading the project must FAIL type checking.
Item ::= a ; b.
imported procedure lib#relay(Stream(Item)?, Stream(Item)).
exported procedure go(Stream(Item)?, Stream(Item)).
go(In, Out?) :- lib # relay(In?, Out).
