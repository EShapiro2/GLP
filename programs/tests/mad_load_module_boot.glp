%% mad_load_module_boot.glp — under the boot harness, an agent reads a
%% certified artefact from its program's own directory with load_file/2 and
%% activates it by run/3 (GLP-Spec appendix-guards, "Compilation and file
%% reading" and "Dynamic activation"): the super-app's installation of a
%% mini-app it did not compile itself.  The artefact, run_module_probe.glpw, is
%% written into mad_load_module/ by the REPL's :artefact before the boot.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, ch(_?, _))@alice.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)) (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/2, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name, by which agent/2 starts the agent's program on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network.
exported procedure(X) agent(Channel(Stream(Constant), Stream(Constant))?, Channel(Stream(NetMsg(X)), Stream(NetMsg(X)))?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The agent's program, by the name its person tells it.
procedure(X) start(Stream(Constant)?, Stream(NetMsg(X))?).
start([alice | _], N) :- alice_init(alice, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name, and reads nothing.
exported procedure say(Constant?, Channel(Stream(Constant), Stream(Constant))?).
say(P, ch(_, [P?])).
