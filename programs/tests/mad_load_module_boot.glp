%% mad_load_module_boot.glp — under the boot harness, an agent reads a
%% certified artefact from its program's own directory with load_file/2 and
%% activates it by run/3 (GLP-Spec appendix-guards, "Compilation and file
%% reading" and "Dynamic activation"): the super-app's installation of a
%% mini-app it did not compile itself.  The artefact, run_module_probe.glpw, is
%% written into mad_load_module/ by the REPL's :artefact before the boot.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice_init(alice), ch(_?, _))@alice.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), which the program, mad_load_module/, answers: a boot defines no agent/2, and the person goal's first act names the entry the program starts (IGLP 30c04c5, Implementation Notes, "Boot").  The person scripted at each agent, say/2, run on its person channel in the person's place, tells the agent the entry, alice_init/1, with the agent's name, its ground argument, the agent's key having been made at its spawn, and reads nothing.
SayAct ::= alice_init(Key).

exported procedure say(SayAct?, Channel(Stream(Constant), Stream(SayAct))?).
say(A, ch(_, [A?])).
