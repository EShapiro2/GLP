%% The person process (sGLP's paper, Section 4, "The person process").
exported procedure person(Integer?, Profiles?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, profiles(agreeable), Mon, Seed, Log, [ask('Poll', poll_w(E)) | As])
:-
random(Seed?, 2147483646, K, S)
,
profiles
#
agreeable_poll(Y?, K?, Mon?)
,
relay_1(A?, 'Poll', E?, Y, Mon?, Log?)
,
person(A?, profiles(agreeable), Mon?, S?, Log?, As?)
.
person(_, _, _, _, _, []).

%% The relay of an interactive type (Definition "Copy, Relay").
procedure
relay_1
(
Integer?
,
Constant?
,
Poll
?
,
Poll
,
MutualRef?
,
MutualRef?
)
.
relay_1(A, Type, poll(X1, X2?), poll(X1?, Y2), Mon, Log)
:-
ground(X1?)
|
answer_1(A?, Type?, X1?, Y2?, X2, Mon?, Log?)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
Integer?
,
YesNo
?
,
YesNo
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, X1, Y2, Y2?, Mon, Log)
:-
ground(Y2?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, poll(X1?, Y2?)), Log?, _)
.

