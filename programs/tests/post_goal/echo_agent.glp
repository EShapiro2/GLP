%% echo_agent.glp --- the one program of an agent its host runs
%% (multiagent/agent_runtime.dart; glp_runtime/test/engine/post_goal_test.dart):
%% the host posts agent(ch(UserIn?, UserOut), ch(NetIn?, NetOut)), every
%% agent's initial goal (GLP-Spec maglp.tex, Definition "Multiagent GLP"; IGLP,
%% Implementation Notes, "Boot"), checked, and each of the person's acts it
%% injects into UserIn is sent back to the person.

Echoed ::= heard(Constant).

exported procedure agent(Channel(Stream(Constant), Stream(Echoed))?, Channel(Stream(NetMsg(Constant)), Stream(NetMsg(Constant)))?).
agent(ch(Acts, Out?), ch(_, [])) :- echo(Acts?, Out).

procedure echo(Stream(Constant)?, Stream(Echoed)).
echo([A|As], [heard(A?)|Out?]) :- echo(As?, Out).
echo([], []).
