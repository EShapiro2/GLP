% arithmetic_fixed.glp - Arithmetic operations with := assignment

exported procedure add(Number?, Number?, Number).
add(X, Y, Z?) :- Z := X? + Y?.

exported procedure multiply(Number?, Number?, Number).
multiply(X, Y, Z?) :- Z := X? * Y?.

exported procedure subtract(Number?, Number?, Number).
subtract(X, Y, Z?) :- Z := X? - Y?.

exported procedure divide(Number?, Number?, Number).
divide(X, Y, Z?) :- Z := X? / Y?.

exported procedure modulo(Number?, Number?, Number).
modulo(X, Y, Z?) :- Z := X? mod Y?.

exported procedure compute(Number).
compute(X?) :- X := (2 * 3) + 4.
