carol4_wait_connected([connected(dave)|In],
                      [send(dave, 'Hi Dave')|Out?]) :-
    carol4_wait_reply(In?, Out).
carol4_wait_connected([_|In], Out?) :-
    otherwise | carol4_wait_connected(In?, Out).
carol4_wait_connected([], []).

procedure carol4_wait_reply(UserNotifyStream?, UserCmdStream).
carol4_wait_reply([received(dave, _)|_], []).
carol4_wait_reply([_|In], Out?) :-
    otherwise | carol4_wait_reply(In?, Out).
carol4_wait_reply([], []).

%% --- Dave (play4) ---

procedure dave4(ActorChannel?).
dave4(ch([child_befriend(bob, carol, ReqId)|In],
         [accept_child_intro(carol, ReqId?)|Out?])) :-
    ground(ReqId?) |
    dave4_wait_msg(In?, Out).
dave4(ch([_|In], Out?)) :-
    otherwise | dave4(ch(In?, Out)).

procedure dave4_wait_msg(UserNotifyStream?, UserCmdStream).
dave4_wait_msg([connected(_)|In], Out?) :-
    dave4_wait_msg(In?, Out).
dave4_wait_msg([received(carol, _)|_],
               [send(carol, 'Hi Carol')]).
dave4_wait_msg([_|In], Out?) :-
    otherwise | dave4_wait_msg(In?, Out).
dave4_wait_msg([], []).

