carol5_wait_rejected([_|In], Out?) :-
    otherwise | carol5_wait_rejected(In?, Out).
carol5_wait_rejected([], []).

%% --- Dave (play5) — never receives proposal, idle ---

procedure dave5(ActorChannel?).
dave5(ch(_, [])).

