%% typed_ui_mediator.glp - Precisely typed mediator between agent/4 and Dart UI
%%
%% Copy of book/cssg/typed_ui_mediator.glp with precise types.
%%
%% Changes from original:
%%   - FriendChannel in Response (instead of generic Channel)
%%   - AgentChannel: precise agent-mediator channel
%%   - PersonChannel: precise mediator-person channel
%%   - Code logic unchanged; only type/proc declarations revised
%%
%% Date: 2026-02-21


%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% --- Friend channel (precise, replaces generic Channel in Response) ---
FriendContent ::= response(Response)
                ; text(Constant)
                ; intro(Constant, IntroChannel)
                ; child_intro(Constant, IntroChannel).
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

Response ::= accept(FriendChannel) ; no.
Decision ::= yes ; no.
ReqId    ::= req(Constant).
IntroContent ::= ack(Constant) ; nack.
IntroStream  ::= [] ; [IntroContent | IntroStream].
IntroChannel ::= ch(IntroStream, IntroStream?).

%% --- Agent-side content types ---

AgentContent ::= befriend(Constant, Response)
               ; befriend_intro(Constant, Constant, IntroChannel)
               ; child_befriend(Constant, Constant, IntroChannel)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; received(Constant, Constant).

AgentToPersonMsg    ::= msg(Constant, Constant, AgentContent).
AgentToPersonStream ::= [] ; [AgentToPersonMsg | AgentToPersonStream].

PersonContent ::= connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; send(Constant, Constant)
              ; introduce(Constant, Constant)
              ; accept_intro(Constant, PendingValue)
              ; reject_intro(Constant, PendingValue)
              ; child_introduce(Constant, Constant, Constant)
              ; accept_child_intro(Constant, PendingValue)
              ; reject_child_intro(Constant, PendingValue)
              ; approve_child_intro(Constant, Constant, PendingValue)
              ; response(Response).

MediatorToAgentMsg    ::= msg(Constant, Constant, PersonContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].

%% Precise agent-mediator channel
AgentChannel ::= ch(AgentToPersonStream, MediatorToAgentStream?).

%% --- Person channel messages (all ground, mediator-specific) ---

%% Person -> Mediator
PersonCmd     ::= decision(Decision, Constant, ReqId)
              ; accept_intro(Constant, ReqId)
              ; reject_intro(Constant, ReqId)
              ; accept_child_intro(Constant, ReqId)
              ; reject_child_intro(Constant, ReqId)
              ; approve_child_intro(Constant, Constant, ReqId)
              ; child_introduce(Constant, Constant, Constant)
              ; connect(Constant)
              ; send(Constant, Constant)
              ; introduce(Constant, Constant).

%% Mediator -> Person
PersonNotify  ::= befriend(Constant, ReqId)
              ; befriend_intro(Constant, Constant, ReqId)
              ; child_befriend(Constant, Constant, ReqId)
              ; connected(Constant)
              ; rejected
              ; rejected(Constant)
              ; received(Constant, Constant).

PersonCmdStream    ::= [] ; [PersonCmd | PersonCmdStream].
PersonNotifyStream ::= [] ; [PersonNotify | PersonNotifyStream].
PersonChannel      ::= ch(PersonCmdStream, PersonNotifyStream?).

%% --- Pending entries ---
PendingValue ::= response(Response) ; channel(IntroChannel) ; error.
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% CHANNEL OPERATIONS (Defined Guards)
%% =============================================================================

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% UI MEDIATOR - Main loop
%% =============================================================================

procedure ui_mediator(Constant?, AgentChannel?, PersonChannel?, PendingList?, Constant?).

%% --- Agent-to-person: non-ground (replace variable with req ID) ---

%% Cold-call befriend: agent sends befriend(From, Resp)
%% Resp is received from agent, stored in pending as writer.
ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), PersonCh?, PersonCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, PersonCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% Introduction befriend_intro: agent sends befriend_intro(From, Other, Ch)
%% Ch is the intro channel; stored in pending for accept/reject.
ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person,
                befriend_intro(From, Other, Ch?)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Other?) |
    send(befriend_intro(From?, Other?, req(N?)),
         PersonCh?, PersonCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, PersonCh1?,
        [pending(req(N?), channel(Ch)) | Ps?], N1?).

%% CSSG: child_befriend — agent sends child_befriend(From, Other, Ch)
%% Ch is the intro channel; stored in pending for accept/reject/approve.
ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person,
                child_befriend(From, Other, Ch?)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Other?) |
    send(child_befriend(From?, Other?, req(N?)),
         PersonCh?, PersonCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, PersonCh1?,
        [pending(req(N?), channel(Ch)) | Ps?], N1?).

%% --- Agent-to-person: ground (pass through) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(connected(Who?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, rejected),
            AgentCh?, AgentCh1) |
    send(rejected, PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(rejected(Who?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(msg(agent, person, received(From, Text)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Text?) |
    send(received(From?, Text?), PersonCh?, PersonCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Person-to-agent: decision (cold-call response) ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(Dec?), ground(From?),
    ground(ReqId?) |
    lookup_pending(ReqId?, Resp, Ps?, Ps1),
    send(msg(person, Id?, decision(Dec?, From?, Resp?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% --- Person-to-agent: accept/reject intro ---
%% Retrieve the channel(Ch) PendingValue and forward it to the agent.
%% The agent sends ack/nack on the channel.

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(accept_intro(Other, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, accept_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(reject_intro(Other, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, reject_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% --- Person-to-agent: CSSG accept/reject/approve child_intro ---

%% Child accepts child_intro
ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(accept_child_intro(Other, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, accept_child_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% Child or parent rejects child_intro
ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(reject_child_intro(Other, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, reject_child_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% Parent approves child_intro — forward to own child
ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(approve_child_intro(OtherChild, MyChild, ReqId), PersonCh?, PersonCh1),
    ground(Id?), ground(OtherChild?), ground(MyChild?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, approve_child_intro(OtherChild?, MyChild?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps1?, N?).

%% --- Person-to-agent: pass-through commands ---

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(connect(Target), PersonCh?, PersonCh1),
    ground(Id?), ground(Target?) |
    send(msg(person, Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(send(Target, Text), PersonCh?, PersonCh1),
    ground(Id?), ground(Target?), ground(Text?) |
    send(msg(person, Id?, send(Target?, Text?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(introduce(P, Q), PersonCh?, PersonCh1),
    ground(Id?), ground(P?), ground(Q?) |
    send(msg(person, Id?, introduce(P?, Q?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, PersonCh, Ps, N) :-
    receive(child_introduce(MyChild, Friend, FriendChild), PersonCh?, PersonCh1),
    ground(Id?), ground(MyChild?), ground(Friend?), ground(FriendChild?) |
    send(msg(person, Id?, child_introduce(MyChild?, Friend?, FriendChild?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, PersonCh1?, Ps?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

%% lookup_pending: retrieve a stored opaque value by request ID
procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).
