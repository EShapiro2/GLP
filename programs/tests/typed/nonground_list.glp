% nonground_list.glp - Non-ground list in body goal argument

exported procedure(X) test_list_in_body(Stream(X)?, Stream(X)).
test_list_in_body(L, L?).

exported procedure(X) process_list(Stream(X)?, Stream(X)).
process_list(L, L?).

exported procedure(X) build_list(X?, X?, Stream(X)).
build_list(X, Y, [X?,Y?]).
