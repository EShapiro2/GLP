% test_guards_comprehensive.glp - Comprehensive guard tests

exported procedure test_list_ok(_?, Constant).
test_list_ok(X, ok) :- list(X?) | true.

exported procedure test_string_ok(_?, Constant).
test_string_ok(X, ok) :- string(X?) | true.

exported procedure test_constant_ok(_?, Constant).
test_constant_ok(X, ok) :- constant(X?) | true.
