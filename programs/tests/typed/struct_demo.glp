% struct_demo.glp - Structure demonstration

Age ::= age(Constant).
City ::= city(Constant).
Person ::= person(Constant, Age, City).

exported procedure make_person(Constant?, Constant?, Constant?, Person).
make_person(Name, Age, City, person(Name?, age(Age?), city(City?))).

exported procedure get_age(Person?, Constant).
get_age(person(_, age(Age), _), Age?).

exported procedure get_city(Person?, Constant).
get_city(person(_, _, city(City)), City?).

exported procedure build_person(Person).
build_person(person(alice, age(thirty), city(seattle))).
