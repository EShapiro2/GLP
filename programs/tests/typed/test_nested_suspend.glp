% test_nested_suspend.glp - Suspension at different structure nesting levels

exported procedure level1(_?).
level1(foo(A, B)) :- string(A?) | done(B?).

exported procedure level2(Stream(X)?).
level2([msg(A, B) | Rest]) :- string(A?) | process(B?, Rest?).
level2([]).

exported procedure level3(Stream(X)?).
level3([wrapper(inner(A)) | Rest]) :- string(A?) | finish(Rest?).
level3([]).

exported procedure done(_?).
done(_).

exported procedure process(_?, Stream(X)?).
process(_, _).

exported procedure finish(Stream(X)?).
finish(_).
