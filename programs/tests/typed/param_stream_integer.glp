%% Test: basic parameterized type expansion — Stream(Integer)
Stream(X) ::= [] ; [X | Stream(X)].

procedure merge(Stream(Integer)?, Stream(Integer)?, Stream(Integer)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).
