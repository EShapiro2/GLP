%% Test: parameterized procedure declaration with type parameter inference
Stream(X) ::= [] ; [X | Stream(X)].

procedure merge(Stream(Integer)?, Stream(Integer)?, Stream(Integer)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).

CounterCall ::= inc ; dec ; read(Integer?).

procedure monitor(Integer?, Stream(CounterCall)?).
monitor(_, []).
monitor(N, [inc|In]) :- N1 := N? + 1, monitor(N1?, In?).
monitor(N, [dec|In]) :- N1 := N? - 1, monitor(N1?, In?).
monitor(N, [read(N?)|In]) :- monitor(N?, In?).
