% diff_list.glp - Difference list operations with H\T syntax
% Note: dl_append and dl_to_list are already in the root self.glp.
% This file tests using them from user code.

exported procedure test_dl_append(DiffList(X)?, DiffList(X)?, DiffList(X)).
test_dl_append(A, B, C?) :- dl_append(A?, B?, C) | true.

exported procedure test_dl_to_list(DiffList(X)?, Stream(X)).
test_dl_to_list(D, L?) :- dl_to_list(D?, L) | true.
