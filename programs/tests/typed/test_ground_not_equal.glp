% test_ground_not_equal.glp - the guard =?\= (GLP-Spec appendix-guards.tex,
% 30e382c): "=?\= succeeds where =?= fails, fails where it succeeds, and
% suspends where it suspends", =?= failing "as soon as the two differ at a pair
% of ground subterms".  Ground: yes (both), the catalogue's column.

% Both operands variables: the generic guard call as well, the ground equality
% instruction having no negated operand (IGLP, 9b45225).
exported procedure test_neq(_?, _?, Constant).
test_neq(X, Y, not_equal) :- X? =?\= Y? | true.
test_neq(_, _, equal) :- otherwise | true.

% An operand that is not a variable: the generic guard call.
exported procedure test_neq_stop(_?, Constant).
test_neq_stop(X, go_on) :- X? =?\= stop | true.
test_neq_stop(_, stopped) :- otherwise | true.

% =?\= alone, so that its failure fails the call and its suspension suspends it.
exported procedure neq_only(_?, _?, Constant).
neq_only(X, Y, not_equal) :- X? =?\= Y? | true.

% Ground: yes (both) --- each reader may occur more than once in the clause.
exported procedure neq_pair(_?, _?, _).
neq_pair(X, Y, pair(X?, X?, Y?, Y?)) :- X? =?\= Y? | true.
