
%% Declarations from use.  The agent's input never closes in this fixture, so
%% its stream type has no [] alternative; the third argument of an incoming
%% befriend_intro is the slot the mediator fills, a reader in the head, which
%% is what the ? on _? in AgentIntro says.
AgentMsg ::= msg(String, String, AgentIntro).
AgentIntro ::= befriend_intro(String, String, _?).
AgentIn ::= [AgentMsg | AgentIn].
PersonMsg ::= befriend_intro(String, String, Req).
Req ::= req(Integer).
Pending ::= pending(Req, Slot).
Slot ::= channel(_?).

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).

procedure med(String?, Channel(AgentIn, _)?, Channel(_, Stream(PersonMsg))?, Stream(Pending)?, Integer?).
med(Id, ch([msg(agent, person, befriend_intro(From, Other, Ch?))|In], Out?),
    PersonCh, Ps, N) :-
    ground(From?), ground(Other?), ground(N?) |
    send(befriend_intro(From?, Other?, req(N?)),
         PersonCh?, PersonCh1),
    N1 := N? + 1,
    med(Id?, ch(In?, Out), PersonCh1?,
        [pending(req(N?), channel(Ch)) | Ps?], N1?).
