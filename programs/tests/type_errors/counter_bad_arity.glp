%% counter_bad_arity.glp - Test error detection: wrong arity

%% Type definitions
CounterMsg ::= clear ; up ; down ; show(Number).
CounterStream ::= [] ; [CounterMsg | CounterStream].

%% Procedure type declaration
procedure counter(CounterStream, Number).

% ERROR: 'show' expects show(Number), not just 'show'
counter([show|S], State) :-
    counter(S?, State?).

counter([clear|S], _) :-
    counter(S?, 0).
counter([up|S], State) :-
    NewState := State? + 1,
    counter(S?, NewState?).
counter([down|S], State) :-
    NewState := State? - 1,
    counter(S?, NewState?).
counter([show(State?)|S], State) :-
    number(State?) |
    counter(S?, State?).
counter([], _).
