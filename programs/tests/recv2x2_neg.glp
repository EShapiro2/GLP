%% recv2x2 — disambiguation probe for Issue 13's receive/3 otherwise-strand.
%% 2x2: channel Out bound (closed) vs unbound (_); the continuation discarded
%% (_ and _? in the head) vs named-and-used (ch(In?, Out)).  Single heap, plain
%% local writer, late-feed (consumer's head runs first on an unbound stream,
%% feeder binds it later) — the shape that mirrors mad_w_probe / boot_anon_late.

Resp       ::= ok ; no.
Item       ::= it(Constant, Resp?).
ItemStream ::= [] ; [Item | ItemStream].
Closed     ::= closed.
PendList   ::= [] ; [Pend | PendList].
Pend       ::= keep(Resp?).
%% The directory programs/tests/recv2x2 reduced to one file: its self.glp types above,
%% its probe.glp below, bodies and declarations unchanged but for each receive/3
%% guard, written as the channel structure in its clause head, the form the guard
%% unfolds to (GLP, 2026-10-02).  A negative fixture:
%% boot_b_outfed and boot_d_outfed hand-build ch(S?, OutW?), a reader at the
%% Out position, and the checker rejects both (probe.glp:59,63 in the directory).

procedure feeder(ItemStream).
feeder([it(bob, _)]).

procedure stash(PendList?).
stash(_).

procedure(W) dropch(Channel(Stream(Item), W)?).
dropch(_).

%% A: Out=closed (bound), continuation discarded
procedure cons_a(Channel(Stream(Item), Closed)?).
cons_a(ch([it(_, R?)|_], _?)) :- stash([keep(R)]), send_to_user([a_matched]).
cons_a(_)  :- otherwise | send_to_user([a_otherwise]).

%% B: Out=_ (unbound), continuation discarded
procedure(W) cons_b(Channel(Stream(Item), W)?).
cons_b(ch([it(_, R?)|_], _?)) :- stash([keep(R)]), send_to_user([b_matched]).
cons_b(_)  :- otherwise | send_to_user([b_otherwise]).

%% C: Out=closed (bound), continuation named-and-used
procedure cons_c(Channel(Stream(Item), Closed)?).
cons_c(ch([it(_, R?)|In], Out?)) :- stash([keep(R)]), dropch(ch(In?, Out)), send_to_user([c_matched]).
cons_c(_)  :- otherwise | send_to_user([c_otherwise]).

%% D: Out=_ (unbound), continuation named-and-used  == boot_anon_late
procedure(W) cons_d(Channel(Stream(Item), W)?).
cons_d(ch([it(_, R?)|In], Out?)) :- stash([keep(R)]), dropch(ch(In?, Out)), send_to_user([d_matched]).
cons_d(_)  :- otherwise | send_to_user([d_otherwise]).

exported procedure boot_a.
boot_a :- cons_a(ch(S?, closed)), feeder(S).

exported procedure boot_b.
boot_b :- cons_b(ch(S?, _)), feeder(S).

exported procedure boot_c.
boot_c :- cons_c(ch(S?, closed)), feeder(S).

exported procedure boot_d.
boot_d :- cons_d(ch(S?, _)), feeder(S).

%% present-element variants: the In stream is fed by a unit producer.
%% Separates suspend-vs-fail from pure head-unification of the Out field.
exported procedure boot_a_ready.
boot_a_ready :- feeder(S), cons_a(ch(S?, closed)).

exported procedure boot_b_ready.
boot_b_ready :- feeder(S), cons_b(ch(S?, _)).

%% MISSING CONTROL: Out unbound at receive time, element present, but a feeder
%% assigns the Out continuation afterward.  Distinguishes "bare writer fails
%% unification" (would still be otherwise) from "Out never written" (matches).
procedure out_feeder(Closed).
out_feeder(closed).

%% C1: Out is a reader OutW? whose writer OutW is assigned closed by out_feeder.
exported procedure boot_b_outfed.
boot_b_outfed :- feeder(S), out_feeder(OutW), cons_b(ch(S?, OutW?)).

%% C2: same, with the named-and-used continuation (mirrors case D).
exported procedure boot_d_outfed.
boot_d_outfed :- feeder(S), out_feeder(OutW), cons_d(ch(S?, OutW?)).

%% REFERENCE: a well-formed channel built by the designed API (new_channel +
%% send, and the receiving end read in the head).  The receiving end's Out is a
%% real PAIRED unbound writer.
%% If this matches, the hand-built ch(S?, _) above is the malformation, not the
%% engine; if it falls to otherwise, the designed receive genuinely fails.
procedure(Z) feed_chan(Channel(Z, Stream(Item))?).
feed_chan(Ch) :- send(it(bob, _), Ch?, _).

procedure(W) drain_chan(Channel(Stream(Item), W)?).
drain_chan(ch([it(_, R?)|_], _?)) :- stash([keep(R)]), send_to_user([real_matched]).
drain_chan(_)  :- otherwise | send_to_user([real_otherwise]).

exported procedure boot_real.
boot_real :- new_channel(P, C), feed_chan(P?), drain_chan(C?).
