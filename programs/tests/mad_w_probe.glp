%% mad_w_probe.glp — cross-isolate `_w` carried through a channel whose Out
%% position is an unassigned writer.
%%
%% No agent/4, no mediator, no UI. Alice MAD-sends a bare writer (wrapped in
%% w/1) to Bob. Bob's producer matches it against the nested READER pattern
%% w(W?) and forwards it onto a local channel stream; Bob's consumer pulls it
%% back with receive/3 into the nested reader pattern wrapped(Y?).
%%
%% What it reports, and what each report means:
%%
%%   bob_produced      => a `_w`-backed reader DID match a nested clause head.
%%                        This is the `_w` admissibility the file was built to
%%                        test, and it holds. The social-graph failure that
%%                        prompted the probe is elsewhere.
%%   bob_ch_otherwise  => receive/3 did not commit, so the second clause fired.
%%
%% The second report is about the channel, not about `_w`. receive/3 is a
%% defined guard whose unit clause is receive(X?, ch([X|In], Out?), ch(In?, Out)):
%% the Out position is a READER there. This file supplies an unassigned writer
%% at Out — ch(S?, _) — and the guard does not succeed. mad_w_clean.glp is this
%% file with ch(S?, closed) at that one line, and it reports bob_ch_matched.
%% That single line is the whole difference between them, and it is what these
%% two fixtures distinguish.
%%
%% Whether receive/3 should suspend or fail on an unassigned writer at Out, and
%% whether otherwise firing behind it is the specified outcome, is GLP-Spec's
%% (receive/3's unit clause and otherwise's semantics). Nothing here waits on it.
%%
%% Run via glp_multiagent/test/mad_w_probe_test.dart (two isolates).


procedure agent_init(Constant?, Stream(X)?, Stream(X)?).

%% Alice: transmit a fresh writer to bob, wrapped in w/1.
agent_init(alice, _, _) :-
    send_to_net([msg(bob, w(_))]).

%% Bob: receive w(W) from net; a "producer" process forwards W (writer) onto a
%% local channel stream; a concurrent "consumer" process pulls it back off with
%% the real receive/3 channel op into a nested reader pattern wrapped(Y?) — the
%% exact mechanism the mediator uses (receive(msg(..,befriend(From,Resp?)),..)).
agent_init(bob, _, NetIn) :-
    bob_producer(NetIn?, S),
    bob_consumer(ch(S?, _)).

%% Capture the _w reader, forward it as a writer onto the channel stream S.
procedure bob_producer(Stream(X)?, Stream(Y)).
bob_producer([msg(_, w(W?)) | _], [wrapped(W)]) :- send_to_user([bob_produced]).
bob_producer([], []) :- send_to_user([bob_empty]).

%% Pull it back with receive/3 into a nested reader pattern.
procedure bob_consumer(Channel(Stream(Z), W)?).
bob_consumer(Ch) :- receive(wrapped(Y?), Ch?, Ch1) | send_to_user([bob_ch_matched]), fill(Y), drop(Ch1?).
bob_consumer(_) :- otherwise | send_to_user([bob_ch_otherwise]).

procedure drop(_?).
drop(_).

procedure fill(_).
fill(done).
