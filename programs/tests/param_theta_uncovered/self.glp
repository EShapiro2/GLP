%% param_theta_covered with pick/3's r and [] clauses gone: refused at the
%% call, as param_theta_covered is, no site supplying R (TGLP 8a58729,
%% appendix-implementation-notes.tex, "The instantiation of a call").  Negative
%% fixture.
%%
%% From 2026-09-20 to 2026-10-02 the map the heads built for R, a(Constant),
%% left the input paths of Stream(Kind)? through r and [] unaccepted, so it was
%% not an instantiation (TGLP dddf684) and the program was rejected as carrying
%% a parameter-inspecting procedure nothing instantiates: the shape
%% social/graph/routing/intro.glp shows, where intro_await_peer's clauses accept
%% ack and nack and leave friend_channel and [] unaccepted.

Kind ::= p ; q ; r.

imported procedure code#go(Stream(Kind)?, Constant).

exported procedure run(Stream(Kind)?, Constant).
run(Xs, N?) :- code # go(Xs?, N).
