%% =============================================================================
%% PLAY 4 — CSSG: All four accept child introduction
%% =============================================================================

exported procedure alice4(Channel(Stream(UserNotify), Stream(UserCmd))?).
alice4(ch(In, [connect(bob)|Out?])) :-
    alice4_wait_connected(In?, Out).

procedure alice4_wait_connected(Stream(UserNotify)?, Stream(UserCmd)).
alice4_wait_connected([connected(bob)|_],
                      [child_introduce(carol, bob, dave)]).
alice4_wait_connected([_|In], Out?) :-
    otherwise | alice4_wait_connected(In?, Out).
alice4_wait_connected([], []).

