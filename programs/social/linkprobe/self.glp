%% linkprobe/self.glp --- SGSG probe of the runtime: does a stream element that
%% carries an unbound writer end cross a link between two isolates, and does
%% the holder's assignment come back?  alice sends bob a stream in a cold
%% call, then writes probe(W) on it, W a fresh writer whose reader she keeps;
%% bob reads the stream, reports what he sees, and assigns W; alice reports
%% the value.  Expected: [bob] saw(probe), [alice] got(hi).
imported procedure agents#alice_init(_?, _?).
imported procedure agents#bob_init(_?, _?).
exported procedure alice_init(_?, _?).
alice_init(Id, In) :- agents # alice_init(Id?, In?).
exported procedure bob_init(_?, _?).
bob_init(Id, In) :- agents # bob_init(Id?, In?).
