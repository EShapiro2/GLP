%% superapp_boot.glp --- the super-app on two smartphones (SGSG paper, Section 3):
%% under the boot harness, one isolate per person, each with its own key pair,
%% running the social graph of core/ as its super-app.  Each reads the
%% certified mini-app's artefact, pingapp.glpw, from core/ with load_file/2
%% and installs it under the compiler's key its person trusts; alice
%% cold-calls bob, they befriend across the isolates, alice invites bob to the
%% mini-app, bob consents, the handshake runs over their friend channel, and
%% the two executions greet each other over the root channel.  The program is
%% graph/core, named as :boot's second argument (this file stands outside
%% graph/, which is a program and would compile it as a module):
%%   :artefact programs/social/graph/pingapp programs/social/graph/core
%%   :boot programs/social/superapp_boot.glp programs/social/graph/core
%% Expected on the persons' screens: [alice] opened(bob), [alice] greeted(bob),
%% [bob] opened(alice), [bob] greeted(alice).

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, invite, [bob], ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, consent, [alice], ch(_?, _))@bob.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel
%% first and the network channel second (GLP-Spec maglp.tex, Definition
%% "Multiagent GLP"), which the program, graph/core, answers: a boot defines
%% no agent/2, and the person goal's first act names the entry the program
%% starts (IGLP 0e1c9e0, Implementation Notes, "Boot").  The person scripted
%% at each agent, say/4, run on its person channel in the person's place,
%% tells the agent the entry, sg_init/4, with its own key, its mode and the
%% keys of the peers it knows, its ground arguments, alice and bob being the
%% atoms that stand for the keys in a simulation ("An agent learns the keys of
%% its peers from its person"; Remark "Agent Names"), and reads nothing.
SayAct ::= sg_init(Key, Constant, List(Key)).
SayIn  ::= [SayAct | SayEnd].
SayEnd ::= [].

exported procedure say(Key?, Constant?, List(Key)?, Channel(Stream(Constant), SayIn)?).
say(P, M, Qs, ch(_, [sg_init(P?, M?, Qs?)])).
