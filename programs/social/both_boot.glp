%% both_boot.glp --- BOTH mini-apps under one super-app, on two smartphones
%% (SGSG paper, Section 7, and Theorem 6.5): under the boot harness, one
%% isolate per person, each with its own key pair, running the social graph of
%% graph/core as its super-app and hosting the currency (programs/currencies/coins/
%% currency) and the child-safe platform (programs/cssn/childsafe) at the same
%% time.  Each person trusts the bundled compiler's key, reads both certified
%% artefacts from graph/core with load_file/2 and installs both, each with its
%% own user-interface grant --- the currency's channel of cards and answers,
%% the platform's channel of commands and notifications.  alice cold-calls bob,
%% they befriend across the isolates, alice invites him to both mini-apps, bob
%% consents to both, and each handshake opens a root channel of that platform's
%% own protocol; each super-app activates both entries by run/3, each with its
%% own conversations.  Then both platforms run at once over the one friendship:
%% alice and bob mint and swap under the currency's contract, and alice greets
%% bob under the child-safe platform's.  The program is graph/core, named as
%% :boot's second argument:
%%   :artefact programs/currencies/coins/currency programs/social/graph/core
%%   :artefact programs/cssn/childsafe programs/social/graph/core
%%   :boot programs/social/both_boot.glp programs/social/graph/core
%% Expected on the persons' screens: [alice] opened(bob), minted(2),
%% swap_done(bob), connected(bob); [bob] opened(alice), minted(2),
%% swap_done(alice), connected(alice), received(alice, hello).

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, both, ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, both, ch(_?, _))@bob.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/3, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name and its mode, by which agent/2 starts the super-app's play sg_init/3 on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network (GLP-Spec appendix-guards.tex, "Identity and signature").
BootSays ::= sg(Key, Constant).

exported procedure agent(Channel(Stream(BootSays), Stream(BootSays))?, Channel(NetInStream, NetOutStream)?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The super-app's play, by the name and the mode the person tells the agent.
procedure start(Stream(BootSays)?, NetInStream?).
start([sg(P, M) | _], N) :- sg_init(P?, M?, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name and its mode, and reads nothing.
exported procedure say(Key?, Constant?, Channel(Stream(BootSays), Stream(BootSays))?).
say(P, M, ch(_, [sg(P?, M?)])).
