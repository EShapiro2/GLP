%% spm/self.glp -- the SPM programs as one program (SGSG paper, Section 5.3).
%%
%% cva/ is the CVA substrate (types and the network mediator), shared by the
%% two platforms beside it, gsg/ (the social graph) and secure_gsg/ (its
%% secure version).  A play reaches the mediator as `cva # network(...)`,
%% which resolves only where cva/ is a module of the loaded program: so the
%% program is this directory, entered through this file, and its entry points
%% are the plays of the two platforms, forwarded here through each platform's
%% own self.glp (modules.tex, External access).  Each platform directory still
%% loads on its own (suite Section X10), with its plays dropped as dead code.

%% The agent and the identity record are common to cva/, gsg/ and secure_gsg/,
%% and are defined once, here, at the lowest common ancestor of the modules
%% that use them (TGLP modules.tex, Scope construction); until 2026-09-30 each
%% of the three carried a copy.  IR_p = (K_p, sigma_p), intrinsic and immutable
%% per agent and surviving a crash: K the identity custodians, sigma the
%% supermajority threshold as an integer percentage in 51..100 --- what a
%% supermajority of custodians authorises a replacement against (SGSG paper,
%% Section 5.3).  play_secure_restore/4 and play_secure_unfriend/3 below carry
%% it.
Agent ::= Constant.
IdentityRecord ::= ir(Stream(Agent), Integer).

imported procedure gsg # play_befriend(Integer, Integer).
exported procedure play_befriend(Integer, Integer).
play_befriend(A?, B?) :- gsg # play_befriend(A, B).

imported procedure gsg # play_befriend_simultaneous(Integer, Integer).
exported procedure play_befriend_simultaneous(Integer, Integer).
play_befriend_simultaneous(A?, B?) :- gsg # play_befriend_simultaneous(A, B).

imported procedure gsg # play_three_agents.
exported procedure play_three_agents.
play_three_agents :- gsg # play_three_agents.

imported procedure secure_gsg # play_secure_befriend(Integer, Integer).
exported procedure play_secure_befriend(Integer, Integer).
play_secure_befriend(A?, B?) :- secure_gsg # play_secure_befriend(A, B).

imported procedure secure_gsg # play_secure_rebroadcast(Integer, Integer).
exported procedure play_secure_rebroadcast(Integer, Integer).
play_secure_rebroadcast(A?, B?) :- secure_gsg # play_secure_rebroadcast(A, B).

imported procedure secure_gsg # play_secure_restore(Integer, Integer, Integer, IdentityRecord).
exported procedure play_secure_restore(Integer, Integer, Integer, IdentityRecord).
play_secure_restore(A?, Z?, B?, IR?) :- secure_gsg # play_secure_restore(A, Z, B, IR).

imported procedure secure_gsg # play_secure_unfriend(Integer, Integer, IdentityRecord).
exported procedure play_secure_unfriend(Integer, Integer, IdentityRecord).
play_secure_unfriend(A?, B?, IR?) :- secure_gsg # play_secure_unfriend(A, B, IR).

imported procedure secure_gsg # play_secure_replace(Constant, Integer, Integer, Integer, Integer).
exported procedure play_secure_replace(Constant, Integer, Integer, Integer, Integer).
play_secure_replace(R?, A?, B?, C?, D?) :- secure_gsg # play_secure_replace(R, A, B, C, D).
