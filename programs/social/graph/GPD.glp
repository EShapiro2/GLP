%% ---------------------------------------------------------------------------
%% GPD.glp --- the Grassroots Programs Dissemination contract, GSA's, extending GFP, in the clause
%% syntax of GSC's paper, Section 3.2 (the form is described in GKK.glp).  The clauses are in
%% GPD.txt beside this file: publish is GPD:1, Program Publication; trust and distrust GPD:2,
%% Developer Trust; offer GPD:3, Program Offering, GFP's forward of a program; install_own and
%% install GPD:4, Program Installation; invite_new and invite_installed GPD:5, Program Invitation,
%% one clause in two schemas, by whether Bob has the program installed; leave GPD:6, Leaving a
%% Program.  GKK's, GSG's and GFP's schemas come first; every role but establish's requires
%% identity.  A program is an item (GFP:1), x as its developer created and signed it; a held copy
%% y carries the signatures of those who passed it on, sgn(..sgn(x, Carol).., Dave) (GFP:2), and
%% the recipient sees the list (Udi, 2026-11-07): author_of(y) is the first signer, the developer,
%% and item_of(y) the item under the forwarding signatures, by which installed and participant
%% name the program alike at every participant; program(item_of(x)) says that x is compiled code signed by its
%% compiler that gives the grassroots contract it is compiled from (Udi, 2026-11-07).  The three are decidable conditions on the values (GSC, Definition
%% Schema with values), added to the term form here and asked of GSC's checker, 2026-11-07.
%% published(Carol, x) says that Carol published x, trusts(Alice, Carol) that Alice trusts Carol as
%% a developer, installed(Alice, p) that Alice installed the program p, and participant(Alice, p,
%% Bob) that Alice converses with Bob in p.  Written by GSA #1 Cowork, 2026-11-07.
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant)
              ; sgn(Constant, Constant) ; item_of(Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SQLit       ::= SMult ; not(SMult).
SQLits      ::= [] ; [SQLit | SQLits].
SLit        ::= SQLit ; forall(Constant, SAtom, SQLits).
SLits       ::= [] ; [SLit | SLits].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr)
              ; author_of(Constant) ; item_of(Constant).
SConstraint ::= true ; and(SConstraint, SConstraint)
              ; eq(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; or(SConstraint, SConstraint)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg) ; program(SExpr).
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SLits, SLits, SConstraint, PNames).
Contract    ::= [] ; [Schema | Contract].

% contract_named(gpd, C): the contract, GPD (Coordination Appendix C).
procedure contract_named(Constant?, Contract).
contract_named(gpd,
   [sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice']))],
       true, ['Alice', 'Bob']),
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']), not(atom(item, ['Alice', x]))], true, ['Alice']),
    sas(forward, ['Alice', 'Bob'], [x],
       [atom(item, ['Bob', sgn(x, 'Alice')])],
       [atom(identity, ['Alice']), atom(item, ['Alice', x]), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob'])], true, ['Alice']),
    sas(publish, ['Carol'], [x],
       [atom(item, ['Carol', x]), atom(published, ['Carol', x])],
       [atom(identity, ['Carol']), not(atom(item, ['Carol', x]))],
       program(item_of(x)), ['Carol']),
    sas(trust, ['Alice', 'Carol'], ['Carol'],
       [atom(trusts, ['Alice', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), not(atom(trusts, ['Alice', 'Carol']))],
       true, ['Alice']),
    sas(distrust, ['Alice', 'Carol'], ['Carol'],
       [not(atom(trusts, ['Alice', 'Carol']))],
       [atom(identity, ['Alice']), atom(trusts, ['Alice', 'Carol'])],
       true, ['Alice']),
    sas(offer, ['Carol', 'Alice'], [y],
       [atom(item, ['Alice', sgn(y, 'Carol')])],
       [atom(identity, ['Carol']), atom(item, ['Carol', y]), atom(friend, ['Carol', 'Alice']),
        atom(identity, ['Alice'])],
       program(item_of(y)), ['Carol']),
    sas(install_own, ['Alice'], [x],
       [atom(installed, ['Alice', x])],
       [atom(identity, ['Alice']), atom(published, ['Alice', x]), not(atom(installed, ['Alice', x]))],
       true, ['Alice']),
    sas(install, ['Alice', 'Bob'], ['Bob', y],
       [atom(installed, ['Alice', item_of(y)])],
       [atom(identity, ['Alice']), atom(item, ['Alice', y]), atom(trusts, ['Alice', 'Bob']),
        not(atom(installed, ['Alice', item_of(y)]))],
       and(program(item_of(y)), eq(author_of(y), 'Bob')), ['Alice']),
    sas(invite_new, ['Alice', 'Bob', 'Carol'], ['Carol', y],
       [atom(participant, ['Alice', item_of(y), 'Bob']),
        atom(participant, ['Bob', item_of(y), 'Alice']), atom(item, ['Bob', sgn(y, 'Alice')]),
        atom(installed, ['Bob', item_of(y)])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(item, ['Alice', y]),
        atom(installed, ['Alice', item_of(y)]), not(atom(participant, ['Alice', item_of(y), 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice']), atom(trusts, ['Bob', 'Carol']),
        not(atom(installed, ['Bob', item_of(y)]))],
       eq(author_of(y), 'Carol'), ['Alice', 'Bob']),
    sas(invite_installed, ['Alice', 'Bob', 'Carol'], ['Carol', y],
       [atom(participant, ['Alice', item_of(y), 'Bob']),
        atom(participant, ['Bob', item_of(y), 'Alice'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(item, ['Alice', y]),
        atom(installed, ['Alice', item_of(y)]), not(atom(participant, ['Alice', item_of(y), 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice']), atom(trusts, ['Bob', 'Carol']),
        atom(installed, ['Bob', item_of(y)]), not(atom(participant, ['Bob', item_of(y), 'Alice']))],
       eq(author_of(y), 'Carol'), ['Alice', 'Bob']),
    sas(leave, ['Alice', 'Bob'], [p],
       [not(atom(installed, ['Alice', p])), not(atom(participant, ['Alice', p, '_'])),
        forall('Bob', atom(participant, ['Alice', p, 'Bob']),
               [not(atom(participant, ['Bob', p, 'Alice']))])],
       [atom(identity, ['Alice']), atom(installed, ['Alice', p]),
        forall('Bob', atom(participant, ['Alice', p, 'Bob']),
               [atom(identity, ['Bob']), atom(participant, ['Bob', p, 'Alice'])])],
       true, ['Alice'])]).
