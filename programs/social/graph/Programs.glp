%% Programs.glp --- printed by adopt.py from Programs.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Programs.txt and run adopt.py Programs.
% contract_named(programs, C): the contract, Programs.
procedure contract_named(Constant?, SDeclared).
contract_named(programs, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(sign, ['Alice'], ['Item'], [atom(item, ['Alice', 'Item'])], [atom(identity, ['Alice']), not(atom(item, ['Alice', 'Item']))], true, ['Alice']),
 sas(forward, ['Bob', 'Alice'], ['Item'], [atom(item, ['Bob', sgn('Item', 'Alice')])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(item, ['Alice', 'Item']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(publish, ['Carol'], ['Prog'], [atom(program, ['Carol', 'Prog', 'Carol'])], [atom(identity, ['Carol']), not(atom(program, ['Carol', 'Prog', 'Carol']))], true, ['Carol']),
 sas(trust, ['Alice', one('Carol', 'Alice')], ['Carol'], [atom(trusts_developer, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), not(atom(trusts_developer, ['Alice', 'Carol']))], true, ['Alice']),
 sas(untrust, ['Alice', one('Carol', 'Alice')], ['Carol'], [not(atom(trusts_developer, ['Alice', 'Carol']))], [atom(identity, ['Alice']), atom(trusts_developer, ['Alice', 'Carol'])], true, ['Alice']),
 sas(offer, ['Alice', one('Carol', 'Alice'), one('Erin', ['Alice', 'Carol'])], ['Prog', 'Erin'], [atom(program, ['Alice', sgn('Prog', 'Carol'), 'Erin'])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(program, ['Carol', 'Prog', 'Erin']), atom(friend, ['Carol', 'Alice']), atom(friend, ['Alice', 'Carol'])], true, ['Carol']),
 sas(install_own, ['Alice'], ['Prog'], [atom(installed, ['Alice', 'Prog', 'Alice'])], [atom(identity, ['Alice']), atom(program, ['Alice', 'Prog', 'Alice']), not(atom(installed, ['Alice', 'Prog', 'Alice']))], true, ['Alice']),
 sas(install, ['Alice', one('Carol', 'Alice')], ['Prog', 'Carol'], [atom(installed, ['Alice', 'Prog', 'Carol'])], [atom(identity, ['Alice']), atom(program, ['Alice', 'Prog', 'Carol']), atom(trusts_developer, ['Alice', 'Carol']), not(atom(installed, ['Alice', 'Prog', 'Carol']))], true, ['Alice']),
 sas(invite, ['Bob', 'Alice', one('Carol', ['Bob', 'Alice'])], ['Prog', 'Carol'], [atom(program, ['Bob', sgn('Prog', 'Alice'), 'Carol']), atom(installed, ['Bob', sgn('Prog', 'Alice'), 'Carol']), atom(participant, ['Alice', 'Prog', 'Carol', 'Bob']), atom(participant, ['Bob', 'Prog', 'Carol', 'Alice'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(installed, ['Alice', 'Prog', 'Carol']), atom(trusts_developer, ['Bob', 'Carol'])], true, ['Alice', 'Bob']),
 sas(leave, ['Alice', one('Carol', 'Alice')], ['Prog', 'Carol'], [not(atom(installed, ['Alice', 'Prog', 'Carol'])), not(atom(participant, ['Alice', 'Prog', 'Carol', '_'])), forall(['E1'], atom(participant, ['Alice', 'Prog', 'Carol', 'E1']), true, [not(atom(participant, ['E1', 'Prog', 'Carol', 'Alice']))])], [atom(identity, ['Alice']), atom(installed, ['Alice', 'Prog', 'Carol']), forall(['E1'], atom(participant, ['Alice', 'Prog', 'Carol', 'E1']), true, [atom(identity, ['E1']), atom(participant, ['E1', 'Prog', 'Carol', 'Alice'])])], true, ['Alice'])])).
