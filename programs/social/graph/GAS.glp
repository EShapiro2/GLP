%% ---------------------------------------------------------------------------
%% GAS.glp --- the Grassroots App Store contract, GSA's, extending GPD and GnW, in the clause syntax of
%% GSC's paper, Section 3.2 (the form is described in GKK.glp).  The clauses are in GAS.txt beside
%% this file: open_store is GAS:1, Store, GnW:1's creation of a ward, the store Dave; list and delist
%% GAS:2, Listing; trust_store and distrust_store GAS:3, Store Trust; install_from_store GAS:4,
%% Installation from a Store.  GPD's schemas come first.  guardian_of(Carol, Dave) and
%% guarded_by(Dave, Carol) say that Carol created the store Dave and is its guardian (GnW:1, as
%% GAI.glp writes a creation); store(Dave) that Dave is a store; listed(Dave, sgn(y, Carol)) that
%% Carol listed in Dave the program she holds as y, signing it; trusts_store(Alice, Dave) that Alice
%% trusts the store.  author_of, item_of and program are GFP's and GSC's values appendix's.  Written by
%% GSA #1 Cowork, 2026-11-07; the store a ward by GSA #2, 2026-11-09 (Udi, 2026-11-08 09:24 UTC).
%% ---------------------------------------------------------------------------

% contract_named(gas, C): the contract, GAS (Coordination Appendix C).
procedure contract_named(Constant?, SContract).
contract_named(gas,
   [sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice']))],
       true, ['Alice', 'Bob']),
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']), not(atom(item, ['Alice', x]))], true, ['Alice']),
    sas(forward, ['Alice', 'Bob'], [x],
       [atom(item, ['Bob', sgn(x, 'Alice')])],
       [atom(identity, ['Alice']), atom(item, ['Alice', x]), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob'])], true, ['Alice']),
    sas(publish, ['Carol'], [x],
       [atom(item, ['Carol', x]), atom(published, ['Carol', x])],
       [atom(identity, ['Carol']), not(atom(item, ['Carol', x]))],
       program(item_of(x)), ['Carol']),
    sas(trust, ['Alice', 'Carol'], ['Carol'],
       [atom(trusts, ['Alice', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), not(atom(trusts, ['Alice', 'Carol']))],
       true, ['Alice']),
    sas(distrust, ['Alice', 'Carol'], ['Carol'],
       [not(atom(trusts, ['Alice', 'Carol']))],
       [atom(identity, ['Alice']), atom(trusts, ['Alice', 'Carol'])],
       true, ['Alice']),
    sas(offer, ['Carol', 'Alice'], [y],
       [atom(item, ['Alice', sgn(y, 'Carol')])],
       [atom(identity, ['Carol']), atom(item, ['Carol', y]), atom(friend, ['Carol', 'Alice']),
        atom(identity, ['Alice'])],
       program(item_of(y)), ['Carol']),
    sas(install_own, ['Alice'], [x],
       [atom(installed, ['Alice', x])],
       [atom(identity, ['Alice']), atom(published, ['Alice', x]), not(atom(installed, ['Alice', x]))],
       true, ['Alice']),
    sas(install, ['Alice', 'Bob'], ['Bob', y],
       [atom(installed, ['Alice', item_of(y)])],
       [atom(identity, ['Alice']), atom(item, ['Alice', y]), atom(trusts, ['Alice', 'Bob']),
        not(atom(installed, ['Alice', item_of(y)]))],
       and(program(item_of(y)), eq(author_of(y), 'Bob')), ['Alice']),
    sas(invite_new, ['Alice', 'Bob', 'Carol'], ['Carol', y],
       [atom(participant, ['Alice', item_of(y), 'Bob']),
        atom(participant, ['Bob', item_of(y), 'Alice']), atom(item, ['Bob', sgn(y, 'Alice')]),
        atom(installed, ['Bob', item_of(y)])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(item, ['Alice', y]),
        atom(installed, ['Alice', item_of(y)]), not(atom(participant, ['Alice', item_of(y), 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice']), atom(trusts, ['Bob', 'Carol']),
        not(atom(installed, ['Bob', item_of(y)]))],
       eq(author_of(y), 'Carol'), ['Alice', 'Bob']),
    sas(invite_installed, ['Alice', 'Bob', 'Carol'], ['Carol', y],
       [atom(participant, ['Alice', item_of(y), 'Bob']),
        atom(participant, ['Bob', item_of(y), 'Alice'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(item, ['Alice', y]),
        atom(installed, ['Alice', item_of(y)]), not(atom(participant, ['Alice', item_of(y), 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice']), atom(trusts, ['Bob', 'Carol']),
        atom(installed, ['Bob', item_of(y)]), not(atom(participant, ['Bob', item_of(y), 'Alice']))],
       eq(author_of(y), 'Carol'), ['Alice', 'Bob']),
    sas(leave, ['Alice', 'Bob'], [p],
       [not(atom(installed, ['Alice', p])), not(atom(participant, ['Alice', p, '_'])),
        forall('Bob', atom(participant, ['Alice', p, 'Bob']),
               [not(atom(participant, ['Bob', p, 'Alice']))])],
       [atom(identity, ['Alice']), atom(installed, ['Alice', p]),
        forall('Bob', atom(participant, ['Alice', p, 'Bob']),
               [atom(identity, ['Bob']), atom(participant, ['Bob', p, 'Alice'])])],
       true, ['Alice']),
    sas(open_store, ['Carol', 'Dave'], [],
       [atom(guardian_of, ['Carol', 'Dave']), atom(friend, ['Carol', 'Dave']), atom(knows, ['Carol', 'Dave']),
        atom(identity, ['Dave']), atom(store, ['Dave']), atom(guarded_by, ['Dave', 'Carol']),
        atom(friend, ['Dave', 'Carol']), atom(knows, ['Dave', 'Carol'])],
       [atom(identity, ['Carol']), not(atom(identity, ['Dave']))],
       true, ['Carol', 'Dave']),
    sas(list, ['Carol', 'Dave', 'Bob'], ['Bob', y],
       [atom(listed, ['Dave', sgn(y, 'Carol')])],
       [atom(identity, ['Carol']), atom(guardian_of, ['Carol', 'Dave']), atom(item, ['Carol', y]),
        atom(trusts, ['Carol', 'Bob']),
        atom(store, ['Dave']), atom(guarded_by, ['Dave', 'Carol'])],
       and(program(item_of(y)), eq(author_of(y), 'Bob')), ['Carol', 'Dave']),
    sas(delist, ['Carol', 'Dave'], [z],
       [not(atom(listed, ['Dave', z]))],
       [atom(identity, ['Carol']), atom(guardian_of, ['Carol', 'Dave']),
        atom(store, ['Dave']), atom(guarded_by, ['Dave', 'Carol']), atom(listed, ['Dave', z])],
       true, ['Carol', 'Dave']),
    sas(trust_store, ['Alice', 'Dave', 'Carol'], [],
       [atom(trusts_store, ['Alice', 'Dave'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Alice', 'Dave']),
        not(atom(trusts_store, ['Alice', 'Dave'])),
        atom(store, ['Dave']), atom(guarded_by, ['Dave', 'Carol']),
        atom(guardian_of, ['Carol', 'Dave'])],
       true, ['Alice']),
    sas(distrust_store, ['Alice', 'Dave'], ['Dave'],
       [not(atom(trusts_store, ['Alice', 'Dave']))],
       [atom(identity, ['Alice']), atom(trusts_store, ['Alice', 'Dave'])],
       true, ['Alice']),
    sas(install_from_store, ['Alice', 'Dave'], [z],
       [atom(item, ['Alice', z]), atom(installed, ['Alice', item_of(z)])],
       [atom(identity, ['Alice']), atom(trusts_store, ['Alice', 'Dave']),
        not(atom(installed, ['Alice', item_of(z)])),
        atom(store, ['Dave']), atom(listed, ['Dave', z])],
       true, ['Alice'])]).
