%% boot.glp — Social graph (simulated UI) play orchestrator
%%
%% Wires together: network ↔ agent ↔ ui_mediator ↔ actor
%% Types: from self.glp (ancestor scoping)
%%
%% Cross-module dependencies declared via imported procedures.


%% Exported entry points (project-compilation spec §3.4: only exported
%% root-level procedures alias). Each `exported procedure` declaration sits
%% immediately above its clause, as the parser requires.

%% =============================================================================
%% IMPORTED PROCEDURES — Cross-module dependencies
%% =============================================================================

%% From core/, its self.glp forwarding to core/agent.glp (TGLP, Section
%% "Module System": a qualifier names a child directory of the caller's,
%% entered through its self.glp)
imported procedure core#agent(Key?, UserInStream?, NetInStream?, OutputsList?).

%% From ui/, its self.glp forwarding to ui/mediator.glp
imported procedure ui#ui_mediator(Key?, AgentChannel?, UserChannel?, PendingList?, Integer?).

%% From ui/, its self.glp forwarding to ui/actors.glp — plays 1-3
imported procedure ui#alice1(ActorChannel?).
imported procedure ui#bob1(ActorChannel?).
imported procedure ui#charlie1(ActorChannel?).
imported procedure ui#alice2(ActorChannel?).
imported procedure ui#bob2(ActorChannel?).
imported procedure ui#charlie2(ActorChannel?).
imported procedure ui#alice3(ActorChannel?).
imported procedure ui#bob3(ActorChannel?).
imported procedure ui#charlie3(ActorChannel?).

%% =============================================================================
%% LOCAL UTILITIES
%% =============================================================================

procedure(X) tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

procedure(X) sink(Stream(X)?).
sink([_|Xs]) :- sink(Xs?).
sink([]).

%% _output/1 is a kernel predicate (untyped). send_to_user_tagged itself is
%% declared so the play bodies that call it type-check.
procedure send_to_user_tagged(Constant?, UserCmdStream?, UserNotifyStream?).
send_to_user_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, cmd(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    send_to_user([tagged(Id?, notify(T?))]),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(_, [], []).
send_to_user_tagged(_, Cmds, []) :- sink(Cmds?).

%% =============================================================================
%% NETWORK SWITCH (3-way)
%% =============================================================================

%% --- Cold-call routing (2-arg msg) ---

%% The simulated network switch carries the full transport union NetInStream
%% (cold calls + friend messages). This wiring exercises only the 2-arg
%% subset; the switch stays general. Writer NetOutStream ⊆ reader NetInStream.
procedure network3(Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?,
                   Channel(NetInStream, NetInStream)?).
network3(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch([msg(bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% --- Friend-to-friend routing (3-arg msg) ---

network3(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(alice, charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(alice, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(bob, charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(bob, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(charlie, alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(charlie, alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(charlie, bob, X?)|BobOut?]),
         ch([msg(charlie, bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Termination
network3(ch([], []), ch([], []), ch([], [])).

%% =============================================================================
%% PLAY1 — Both accept introduction (with tee + sink display)
%% =============================================================================

exported procedure play1.
play1 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    ui # alice1(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    core # agent(alice, AliceAgentIn?, AliceNetIn?,
          [user_output(AliceAgentToUser), net_output(AliceNetOut)]),
    ui # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob
    ui # bob1(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    core # agent(bob, BobAgentIn?, BobNetIn?,
          [user_output(BobAgentToUser), net_output(BobNetOut)]),
    ui # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    %% Charlie
    ui # charlie1(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    core # agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [user_output(CharlieAgentToUser), net_output(CharlieNetOut)]),
    ui # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    sink(CharlieDispCmd?), sink(CharlieDispNotify?).

%% =============================================================================
%% PLAY2 — Alice accepts, Charlie rejects
%% =============================================================================

exported procedure play2.
play2 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    ui # alice2(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    core # agent(alice, AliceAgentIn?, AliceNetIn?,
          [user_output(AliceAgentToUser), net_output(AliceNetOut)]),
    ui # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob
    ui # bob2(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    core # agent(bob, BobAgentIn?, BobNetIn?,
          [user_output(BobAgentToUser), net_output(BobNetOut)]),
    ui # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    %% Charlie
    ui # charlie2(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    core # agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [user_output(CharlieAgentToUser), net_output(CharlieNetOut)]),
    ui # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    sink(CharlieDispCmd?), sink(CharlieDispNotify?).

