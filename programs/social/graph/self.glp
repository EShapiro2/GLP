%% self.glp — Social Graph (simulated UI) shared type vocabulary
%%
%% All protocol types for the Social Graph application with UI mediator.
%% Defined once here, visible to all modules via ancestor scoping.


%% =============================================================================
%% CORE PROTOCOL TYPES
%% =============================================================================

%% Stream and Channel are predefined in root self.glp:
%%   Stream ::= [] ; [_|Stream].
%%   Channel ::= ch(Stream, Stream?).

%% A cold-call accept conveys a SETUP channel (IntroChannel), not the friend
%% channel directly; the fresh friend channel is conveyed on the setup channel at
%% commit by the shared lib befriend_commit (CSSN Issue 16).
Response ::= accept(IntroChannel) ; no.
Decision ::= yes ; no.
Handshake ::= ack(Constant) ; nack.
PendingValue ::= response(Response?) ; channel(IntroChannel) ; error.

%% --- Content types for messages ---

%% Content carried inside user-to-agent messages (msg('_user', Id, Content))
UserContent ::= connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; send(Constant, Constant)
              ; introduce(Constant, Constant)
              ; accept_intro(Constant, PendingValue)
              ; reject_intro(Constant, PendingValue)
              ; unfriend(Constant)
              ; response(Response).

%% Content carried inside agent-to-user messages (msg(agent, '_user', Content))
AgentContent ::= befriend(Constant, Response?)
               ; befriend_intro(Constant, Constant, IntroChannel)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; unfriended(Constant)
               ; received(Constant, Constant).

%% Network content (2-arg cold-call: msg(Dest, Content))
NetColdCall ::= intro(Constant, Response?).

%% Friend-to-friend content (3-arg: msg(From, To, Content))
FriendContent ::= response(Response)
                ; text(Constant)
                ; unfriend
                ; intro(Constant, IntroChannel).

%% Setup channel content: ack/nack handshake plus the fresh-friend-channel
%% conveyance the shared lib befriend_commit uses to install the friend channel.
IntroContent ::= ack(Constant) ; nack ; friend_channel(FriendChannel).

%% Intro channel (handshake protocol)
IntroStream  ::= [] ; [IntroContent | IntroStream].
IntroChannel ::= ch(IntroStream, IntroStream?).

%% Friend messages and channels
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

%% Network output stream — cold calls the agent emits on its '_net' entry.
NetOutMsg    ::= msg(Constant, NetColdCall).
NetOutStream ::= [] ; [NetOutMsg | NetOutStream].

%% Intro result — written by intro_await_peer, injected into UserIn
IntroResult ::= intro_result(Constant, IntroChannel) ; intro_rejected(Constant).

%% Output list — one constructor per output kind, each typed at exactly what it
%% carries. Replaces the former output(Constant, OutputStream?) whose union
%% OutputMsg joined the user/net/friend message types and so broke duality
%% against the mediator's AgentToUserStream channel.
OutputEntry ::= user_output(AgentToUserStream?)
              ; net_output(NetOutStream?)
              ; friend_output(Constant, FriendStream?).
OutputsList ::= [] ; [OutputEntry | OutputsList].

%% =============================================================================
%% MEDIATOR TYPES
%% =============================================================================

ReqId ::= req(Constant).

%% User -> Mediator
UserCmd ::= decision(Decision, Constant, ReqId)
          ; accept_intro(Constant, ReqId)
          ; reject_intro(Constant, ReqId)
          ; connect(Constant)
          ; send(Constant, Constant)
          ; introduce(Constant, Constant)
          ; unfriend(Constant).

%% Mediator -> User
UserNotify ::= befriend(Constant, ReqId)
             ; befriend_intro(Constant, Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; received(Constant, Constant)
             ; unfriended(Constant).

%% User ↔ mediator streams and channels
UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].
UserChannel      ::= ch(UserCmdStream, UserNotifyStream?).

%% Actor's view of the user channel (reversed)
ActorChannel ::= ch(UserNotifyStream, UserCmdStream?).

%% Agent ↔ mediator precise streams
AgentToUserMsg        ::= msg(Constant, Constant, AgentContent).
AgentToUserStream     ::= [] ; [AgentToUserMsg | AgentToUserStream].
MediatorToAgentMsg    ::= msg(Constant, Constant, UserContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].
AgentChannel          ::= ch(AgentToUserStream, MediatorToAgentStream?).

%% Agent input types
UserInMsg    ::= msg(Constant, Constant, UserContent)
               ; intro_result(Constant, IntroChannel)
               ; intro_rejected(Constant).
UserInStream ::= [] ; [UserInMsg | UserInStream].

NetInMsg     ::= msg(Constant, NetColdCall)
               ; msg(Constant, Constant, FriendContent).
NetInStream  ::= [] ; [NetInMsg | NetInStream].

%% Pending entries
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% ENTRY POINTS (modules.tex sec:static-linking step 5, §External access)
%% The root self.glp exports each program entry by forwarding to boot, so an
%% external goal calls it by plain name. boot.glp is unchanged.
%% =============================================================================
imported procedure boot#play1.
exported procedure play1.
play1 :- boot # play1.

imported procedure boot#play2.
exported procedure play2.
play2 :- boot # play2.

imported procedure boot#play3.
exported procedure play3.
play3 :- boot # play3.

imported procedure boot#fplay1.
exported procedure fplay1.
fplay1 :- boot # fplay1.

imported procedure boot#fplay2.
exported procedure fplay2.
fplay2 :- boot # fplay2.

imported procedure boot#fplay3.
exported procedure fplay3.
fplay3 :- boot # fplay3.

imported procedure boot#play_unfriend_send.
exported procedure play_unfriend_send.
play_unfriend_send :- boot # play_unfriend_send.

imported procedure boot#play_unfriend_recv.
exported procedure play_unfriend_recv.
play_unfriend_recv :- boot # play_unfriend_recv.

imported procedure boot#play_unfriend_absent.
exported procedure play_unfriend_absent.
play_unfriend_absent :- boot # play_unfriend_absent.
