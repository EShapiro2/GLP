%% self.glp — Social Graph (simulated UI) shared type vocabulary
%%
%% All protocol types for the Social Graph application with UI mediator.
%% Defined once here, visible to all modules via ancestor scoping.


%% =============================================================================
%% CORE PROTOCOL TYPES
%% =============================================================================

%% Stream and Channel are predefined in root self.glp:
%%   Stream ::= [] ; [_|Stream].
%%   Channel ::= ch(Stream, Stream?).

%% Befriending (GSG paper, Sections 5.1 and 5.2, app:code): each of the two
%% consents by binding a variable the other reads, and no setup channel is
%% made.  The agent with the smaller identity proposes: its consent carries the
%% reader of the conveyance it will write, the friend channel's end or, where
%% the other is already a friend, already_friends, or, where the other
%% declines, declined, which nobody reads (Section 5.1).  The agent with the
%% larger identity accepts: its consent is yes or no.  The duality marks are
%% TGLP's (Definition "Moded Head", "Well-Typed Clause with Subtyping"): a
%% position marked ? is written by the term's receiver, so the sender places a
%% writer there and keeps its reader.
%% The two are generic in the friend channel's type F, so that a mini-app
%% befriending its own parties through the routing below (CSSN Section 8.4)
%% mints a channel of its own type; this program's is FriendChannel.
Conveyance(F) ::= friend(F) ; already_friends ; declined.
ProposerConsent(F) ::= yes(Conveyance(F)) ; no.
AcceptorConsent ::= yes ; no.
Decision ::= yes ; no.
%% The two ends an agent holds for a befriending its person has not yet
%% answered, by role: its own consent, to write, and the other's, to read.
PendingValue ::= propose(ProposerConsent(FriendChannel)?, AcceptorConsent)
               ; accept(AcceptorConsent?, ProposerConsent(FriendChannel))
               ; error.

%% --- Content types for messages ---

%% Content carried inside user-to-agent messages (msg(person, Id, Content))
UserContent ::= connect(Key)
              ; decision(Decision, Key, PendingValue)
              ; send(Key, Constant)
              ; introduce(Key, Key)
              ; accept_intro(Key, PendingValue)
              ; reject_intro(Key, PendingValue)
              ; unfriend(Key)
              %% The super-app (GSG paper, Section 3).  install: the person
              %% installs a certified mini-app --- its module value, its
              %% creator's certification, the mini-app's end of its person
              %% channel (the super-app user interface holds the other end; in
              %% a play, the play does), and its calendar, a stream of dates
              %% (the super-app writes it from the device's clock, a play from
              %% its script; GSG, 2026-10-13 20:59 UTC).  The person channel is
              %% at the template's parameter, opaque to the super-app, which
              %% holds it at Opaque (TGLP modules.tex, "Opaque types").
              %% invite: offer a friend the mini-app.  accept_invite /
              %% decline_invite: the invitee's volition.  attestation: read
              %% back the attestation minted at the befriending (Section 5.5).
              ; install(Constant, Content, String, PersonChannel(Opaque), Stream(Integer))
              ; invite(Constant, Key)
              ; accept_invite(Constant, Key)
              ; decline_invite(Constant, Key)
              ; attestation(Constant, String?)
              %% trust: the person trusts a compiler's key (Section 6.4); the
              %% bundled compiler's, trusted by installing the super-app.
              ; trust(String)
              %% installed: the names of the mini-apps installed, for a play.
              ; installed(Stream(Constant)?)
              %% The warm call's volitions (Section 5.2): the person consents to
              %% a warm call with an agent (as holder, or as its anchor); the
              %% person consents to introduce a requester to an anchor.
              ; accept_warm_call(Key)
              ; allow_intro(Key, Key).

%% Content carried inside agent-to-user messages (msg(agent, person, Content)).
%% befriend and befriend_intro carry the pending value, which the person's
%% answer passes back as it came.
AgentContent ::= befriend(Key, PendingValue)
               ; befriend_intro(Key, Key, PendingValue)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; unfriended(Constant)
               ; received(Key, Constant)
               %% A message the person addressed to someone who is not their
               %% friend is not sent, and the agent tells the person so
               %% (Section 5.1).
               ; not_a_friend(Key).

%% Network content (2-arg cold-call: msg(Dest, Content)): the caller, the
%% caller's consent, bound before sending, and the callee's consent, for the
%% callee to write --- by the callee's role, the smaller identity proposing.
NetColdCall ::= befriend_propose(Key, AcceptorConsent, ProposerConsent(FriendChannel)?)
              ; befriend_accept(Key, ProposerConsent(FriendChannel), AcceptorConsent?).

%% Friend-to-friend content (3-arg: msg(From, To, Content)).  An introduction
%% from a mutual friend carries the other party, the recipient's own consent,
%% for it to write, and the reader of the other's, by the recipient's role.
FriendContent ::= text(Constant)
                ; unfriend
                ; introduce_propose(Key, ProposerConsent(FriendChannel)?, AcceptorConsent)
                ; introduce_accept(Key, AcceptorConsent?, ProposerConsent(FriendChannel))
                %% Distribution with an invitation and the handshake (GSG
                %% paper, Sections 3 and 6): the offer carries the mini-app's
                %% source identity and one end of the root channel, at
                %% Opaque, and nothing else, with the social graph's
                %% invitation signed over the source identity and the
                %% invitee; join carries the source identity, the type
                %% identity of the entry template's opaque instance at the
                %% mini-app's type, and the invitee's signed undertaking;
                %% root, the inviter's answer, the same with its own; decline
                %% the source identity.  Each super-app hands its end to its
                %% execution only after the handshake succeeds.
                ; invite(String, String, RootChannel(Opaque))
                ; join(String, Constant, String)
                ; decline(String)
                ; root(String, Constant, String)
                %% The warm call (Section 5.2): the holder asks the forwarding
                %% friend for an introduction to the anchor; over the friend
                %% channel that results, warm_call(App) to the anchor.  The
                %% call carries the mini-app and not the held link's name: a
                %% global name is encoded as a variable in a message and does
                %% not cross as data (IGLP, madglp-spec, Global Variable
                %% Names), and the anchor identifies the call by the friend it
                %% comes from, which is who its person consented to.
                ; request_intro(Key)
                ; warm_call(Constant).

%% Friend messages and channels
FriendMsg     ::= msg(Key, Key, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

%% Network output stream — cold calls the agent emits on its '_net' entry.
NetOutMsg    ::= msg(Key, NetColdCall).
NetOutStream ::= [] ; [NetOutMsg | NetOutStream].

%% =============================================================================
%% THE SUPER-APP (SGSG paper, Section 3): what a mini-app is granted, and the
%% host state the social graph keeps for it.
%% =============================================================================

%% The warm call's bookkeeping (core/agent.glp): a warm call waiting for the
%% person's consent, and a friend found among the outputs.
WarmWait  ::= none ; wait(Constant, GlobalName, Key).
AnchorFriend ::= none ; found(Key).

%% Answers of the host's lookups and checks: an installed mini-app's module;
%% a handshake's verdict; the type identity a join sends; an offer that has
%% arrived, with the end of the root channel it carried; the person's consent
%% given before the offer, with the name the mini-app is installed under; and
%% an end kept for a conversation until its handshake, with that name.
AppLookup ::= found(Module) ; missing.
Verdict   ::= ok(Module) ; refused.
Joined    ::= ok(Constant) ; refused.
Offer     ::= none ; offer(RootChannel(Opaque)).
Consent   ::= none ; app(Constant).
Kept      ::= none ; kept(Constant, RootChannel(Opaque)).

%% The creator's certification, signed over the source identity together with
%% the contract's act schemas and the checker's verdict (Sections 3 and 6.4).
CreatorCert ::= creator_cert(String, Stream(Constant), Constant).

%% Host state: the installed mini-apps, the attestations minted at the
%% befriending, the invitations pending a volition, and the keys of the
%% compilers the person trusts (the bundled compilers' by installation).
%%   app(Name, Content, CreatorSig, Status), Content the module value load_file/2
%%   gave (a Module where the certificate verified): Status is idle(Ui, Cal),
%%   holding the mini-app's end of its person channel and its calendar until
%%   activation, or running(SgEnd, Cal) once run/3 has activated it, SgEnd the
%%   super-app's writer of the mini-app's social-graph stream and Cal the
%%   calendar kept for its next activation.  Every mini-app is held alike, at
%%   Opaque: the super-app holds no declaration of a mini-app's types (GSG
%%   paper, Section 3, "Activation and joining").
AppStatus ::= idle(PersonChannel(Opaque), Stream(Integer))
            ; running(Stream(SgToApp(Opaque))?, Stream(Integer)).
App       ::= app(Constant, Module, String, AppStatus).
AppList   ::= [] ; [App | AppList].
Attest     ::= att(Key, String).
AttestList ::= [] ; [Attest | AttestList].
%% A pending invitation, at the inviter: the mini-app's name here, the
%% friend invited, its source identity and the end of the root channel kept
%% for this side's execution until the handshake; at the invitee: the offer
%% --- from whom, the source identity, the signed invitation and the end it
%% carried --- or the person's consent given before the offer arrived, by the
%% source identity of the mini-app it names, or, joined, the end kept until
%% the inviter's answer.
Pending      ::= invited(Constant, Key, String, RootChannel(Opaque))
               ; offered(Key, String, String, RootChannel(Opaque))
               ; consented(String, Key, Constant)
               ; joining(Constant, Key, String, RootChannel(Opaque))
               %% The warm call (Section 5.2), at the holder: the warm call
               %% under way (mini-app, held name), or waiting for the person's
               %% consent (mini-app, name, forwarding friend); the person's
               %% consent to a warm call with an agent; at the anchor: a warm
               %% call accepted, its handshake pending (name, caller); at the
               %% forwarding friend: the person's consent to introduce a
               %% requester to an anchor, or a request (requester, name)
               %% waiting for it.  A name is never taken apart into an agent:
               %% its anchor is only ever compared with an agent at hand.
               ; warm(Constant, GlobalName)
               ; warm_wait(Constant, GlobalName, Key)
               ; warm_consent(Key)
               ; warm_ok(Key)
               ; intro_consent(Constant, Constant)
               ; intro_wait(Constant, Constant)
               ; intro_ok(Key)
               ; intro_via(Key, Key)
               ; held(GlobalName, Constant).
PendingInv   ::= [] ; [Pending | PendingInv].
Host ::= host(AppList, AttestList, PendingInv, Stream(String)).

%% The vocabulary of the super-app's own person interface (core/home.vglp, its
%% compilation home.glp): an ask on its ask stream, and the person's grants on
%% its person channel, which never close.
Ask(Q)   ::= ask(Constant, Q).

%% The person's consent to a warm call, and the anchor it names.
WarmConsent ::= no ; yes(Key).

%% Output list — one constructor per output kind, each typed at exactly what it
%% carries. Replaces the former output(Constant, OutputStream?) whose union
%% OutputMsg joined the user/net/friend message types and so broke duality
%% against the mediator's AgentToUserStream channel.
OutputEntry ::= user_output(AgentToUserStream?)
              ; net_output(NetOutStream?)
              ; friend_output(Key, FriendStream?).
OutputsList ::= [] ; [OutputEntry | OutputsList].

%% =============================================================================
%% MEDIATOR TYPES
%% =============================================================================

ReqId ::= req(Integer).

%% User -> Mediator
UserCmd ::= decision(Decision, Key, ReqId)
          ; accept_intro(Key, ReqId)
          ; reject_intro(Key, ReqId)
          ; connect(Key)
          ; send(Key, Constant)
          ; introduce(Key, Key)
          ; unfriend(Key).

%% Mediator -> User
UserNotify ::= befriend(Key, ReqId)
             ; befriend_intro(Key, Key, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; received(Key, Constant)
             ; unfriended(Constant)
             ; not_a_friend(Key).

%% User ↔ mediator streams and channels
UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].
UserChannel      ::= ch(UserCmdStream, UserNotifyStream?).

%% Agent ↔ mediator precise streams
AgentToUserMsg        ::= msg(Constant, Constant, AgentContent).
AgentToUserStream     ::= [] ; [AgentToUserMsg | AgentToUserStream].
MediatorToAgentMsg    ::= msg(Constant, Key, UserContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].
AgentChannel          ::= ch(AgentToUserStream, MediatorToAgentStream?).

%% Agent input types
UserInMsg    ::= msg(Constant, Key, UserContent)
               %% A befriending's outcome, injected by await_consent and
               %% await_conveyance (routing/intro.glp): the other consented,
               %% with the conveyance this agent, the proposer, is to write;
               %% the friend channel conveyed to this agent, the acceptor;
               %% the other declined.
               ; consented(Key, Conveyance(FriendChannel)?)
               ; adopt(Key, FriendChannel)
               ; declined(Key)
               %% A running mini-app's request up its social-graph channel.
               ; app_request(Constant, AppToSg)
               %% A mini-app's execution has ended: the stream it writes up to
               %% the social graph closed with it, which is the one signal of
               %% its end the super-app holds a reader of.
               ; app_ended(Constant).
UserInStream ::= [] ; [UserInMsg | UserInStream].

NetInMsg     ::= msg(Key, NetColdCall)
               ; msg(Key, Key, FriendContent)
               %% The runtime's report of a held link (Section 5.2; madGLP).
               ; pending_link(GlobalName, Key).
NetInStream  ::= [] ; [NetInMsg | NetInStream].

%% Pending entries
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% ENTRY POINTS (modules.tex sec:static-linking step 5, §External access)
%% The root self.glp exports each program entry by forwarding to boot, so an
%% external goal calls it by plain name. boot.glp is unchanged.
%% =============================================================================
imported procedure boot#play_unfriend_send.
exported procedure play_unfriend_send.
play_unfriend_send :- boot # play_unfriend_send.

imported procedure boot#play_unfriend_recv.
exported procedure play_unfriend_recv.
play_unfriend_recv :- boot # play_unfriend_recv.

imported procedure boot#play_unfriend_absent.
exported procedure play_unfriend_absent.
play_unfriend_absent :- boot # play_unfriend_absent.

imported procedure boot#play_introduce_both.
exported procedure play_introduce_both.
play_introduce_both :- boot # play_introduce_both.

imported procedure boot#play_introduce_one.
exported procedure play_introduce_one.
play_introduce_one :- boot # play_introduce_one.

imported procedure boot#play_introduce_other.
exported procedure play_introduce_other.
play_introduce_other :- boot # play_introduce_other.

imported procedure boot#play_introduce_neither.
exported procedure play_introduce_neither.
play_introduce_neither :- boot # play_introduce_neither.

imported procedure boot#play_request_intro_both.
exported procedure play_request_intro_both.
play_request_intro_both :- boot # play_request_intro_both.

imported procedure boot#play_request_intro_stranger.
exported procedure play_request_intro_stranger.
play_request_intro_stranger :- boot # play_request_intro_stranger.

imported procedure boot#play_request_intro_no_anchor.
exported procedure play_request_intro_no_anchor.
play_request_intro_no_anchor :- boot # play_request_intro_no_anchor.

%% Live-UI boot (play_ui_boot.glp, a UIVE UI module): the Dart bridge enters
%% the program at agent_init/3.
imported procedure play_ui_boot#agent_init(Constant?, UserCmdStream?, NetInStream?).
exported procedure agent_init(Constant?, UserCmdStream?, NetInStream?).
agent_init(Id, UserIn, NetIn) :- play_ui_boot # agent_init(Id?, UserIn?, NetIn?).
