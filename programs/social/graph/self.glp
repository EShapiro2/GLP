%% self.glp — Social Graph (simulated UI) shared type vocabulary
%%
%% All protocol types for the Social Graph application with UI mediator.
%% Defined once here, visible to all modules via ancestor scoping.


%% =============================================================================
%% CORE PROTOCOL TYPES
%% =============================================================================

%% Stream and Channel are predefined in root self.glp:
%%   Stream ::= [] ; [_|Stream].
%%   Channel ::= ch(Stream, Stream?).

%% A cold-call accept conveys a SETUP channel (IntroChannel), not the friend
%% channel directly; the fresh friend channel is conveyed on the setup channel at
%% commit by the shared lib befriend_commit (CSSN Issue 16).
Response ::= accept(IntroChannel) ; no.
Decision ::= yes ; no.
Handshake ::= ack(Key) ; nack.
PendingValue ::= response(Response?) ; channel(IntroChannel) ; error.

%% --- Content types for messages ---

%% Content carried inside user-to-agent messages (msg(person, Id, Content))
UserContent ::= connect(Key)
              ; decision(Decision, Key, PendingValue)
              ; send(Key, Constant)
              ; introduce(Key, Key)
              ; accept_intro(Key, PendingValue)
              ; reject_intro(Constant, PendingValue)
              ; unfriend(Key)
              ; response(Response)
              %% The super-app (SGSG paper, Section 3).  install: the person
              %% installs a certified mini-app --- its module value, its
              %% creator's certification, and the mini-app's user-interface
              %% channel (the super-app user interface holds the other end; in
              %% a play, the play does).  invite: offer a friend the mini-app.
              %% accept_invite / decline_invite: the invitee's volition.
              %% attestation: read back the attestation minted at
              %% befriend_commit (Section 5.5).
              ; install(Constant, Content, String, AppUiStream?)
              ; install_coins(Constant, Content, String, Channel(Stream(UserAnswer), Stream(Event)))
              ; install_cssn(Constant, Content, String, Channel(Stream(CsAppCmd), Stream(CsAppNotify)))
              ; install_sovereign(Constant, Content, String, Channel(Stream(SvUserAnswer), Stream(SvEvent)))
              ; invite(Constant, Key)
              ; accept_invite(Constant, Key)
              ; decline_invite(Constant, Key)
              ; attestation(Constant, String?)
              %% trust: the person trusts a compiler's key (Section 6.4); the
              %% bundled compiler's, trusted by installing the super-app.
              ; trust(String)
              %% installed: the names of the mini-apps installed, for a play.
              ; installed(Stream(Constant)?)
              %% The warm call's volitions (Section 5.2): the person consents to
              %% a warm call with an agent (as holder, or as its anchor); the
              %% person consents to introduce a requester to an anchor.
              ; accept_warm_call(Key)
              ; allow_intro(Key, Key).

%% Content carried inside agent-to-user messages (msg(agent, person, Content))
AgentContent ::= befriend(Key, Response?)
               ; befriend_intro(Constant, Key, IntroChannel)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; unfriended(Constant)
               ; received(Key, Constant).

%% Network content (2-arg cold-call: msg(Dest, Content))
NetColdCall ::= intro(Key, Response?).

%% Friend-to-friend content (3-arg: msg(From, To, Content))
FriendContent ::= response(Response)
                ; text(Constant)
                ; unfriend
                ; intro(Key, IntroChannel)
                %% Distribution with an invitation and the handshake (SGSG
                %% paper, Section 3): the offer carries the mini-app's source
                %% identity, the root channel's type identity and the social
                %% graph's signed invitation; join carries the invitee's signed
                %% undertaking; root carries the inviter's undertaking and one
                %% end of the root channel, which the invitee's super-app hands
                %% to its mini-app only after the handshake succeeds.
                ; invite(Constant, String, Constant, String)
                ; join(Constant, String, Constant, String)
                ; decline(Constant)
                ; root(Constant, String, Constant, String, RootEnd)
                %% The warm call (Section 5.2): the holder asks the forwarding
                %% friend for an introduction to the anchor; over the friend
                %% channel that results, warm_call(App) to the anchor.  The
                %% call carries the mini-app and not the held link's name: a
                %% global name is encoded as a variable in a message and does
                %% not cross as data (IGLP, madglp-spec, Global Variable
                %% Names), and the anchor identifies the call by the friend it
                %% comes from, which is who its person consented to.
                ; request_intro(Key)
                ; warm_call(Constant).

%% Setup channel content: ack/nack handshake plus the fresh-friend-channel
%% conveyance the shared lib befriend_commit uses to install the friend channel.
IntroContent ::= ack(Key) ; nack ; friend_channel(FriendChannel).

%% Intro channel (handshake protocol)
IntroStream  ::= [] ; [IntroContent | IntroStream].
IntroChannel ::= ch(IntroStream, IntroStream?).

%% Friend messages and channels
FriendMsg     ::= msg(Key, Key, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

%% Network output stream — cold calls the agent emits on its '_net' entry.
NetOutMsg    ::= msg(Key, NetColdCall).
NetOutStream ::= [] ; [NetOutMsg | NetOutStream].

%% Intro result — written by intro_await_peer, injected into UserIn
IntroResult ::= intro_result(Constant, IntroChannel) ; intro_rejected(Constant).

%% NOTE (SGSG Code, 2026-09-08): the catalogue's Key, SignedTerm and Hash are
%% root-scope aliases of String; they resolve in procedure declarations but
%% not inside a descendant's type definitions ("Unresolved type: SignedTerm"),
%% reported to IGLP.  The definitions below therefore say String where the
%% catalogue says Key, SignedTerm or Hash; the declarations keep the names.

%% =============================================================================
%% THE SUPER-APP (SGSG paper, Section 3): what a mini-app is granted, and the
%% host state the social graph keeps for it.
%% =============================================================================

%% The test mini-app, ping/3 (miniapp.glp): two executions greet each other
%% over the root channel of their conversation and report to their persons.
%% The root channel's message type is the mini-app's; the friend-channel
%% message that conveys an end names it, this program being both the super-app
%% and the mini-app in the plays.
PingMsg     ::= hello(Constant) ; probe(String?).
PingStream  ::= [] ; [PingMsg | PingStream].
RootChannel ::= ch(PingStream, PingStream?).

%% (i) The channel to the social graph: down it the social graph hands the
%% mini-app, at each invitation and each warm call, one end of a root channel
%% to the execution of the same mini-app at a friend, and reports a held link
%% (Section 5.2: an end that reached this agent under another anchor, named,
%% and the friend that forwarded it); up it the mini-app asks for a warm call
%% to the link's anchor through that friend.
SgToApp       ::= conversation(Constant, RootChannel) ; pending_link(GlobalName, Key).
SgToAppStream ::= [] ; [SgToApp | SgToAppStream].
AppToSg       ::= warm_call(GlobalName, Key).
AppToSgStream ::= [] ; [AppToSg | AppToSgStream].
SgChannel     ::= ch(SgToAppStream, AppToSgStream?).

%% The relay's bookkeeping (pingapp/miniapp.glp): the events of its
%% conversations, their write ends, and probes held for a conversation.
EvMsg    ::= greeted(Constant, Constant) ; probe_from(Constant, String?) ; got(String).
EvStream ::= [] ; [EvMsg | EvStream].
ConvEnd  ::= conv(Constant, PingStream?).
ConvList ::= [] ; [ConvEnd | ConvList].
HeldProbe ::= held(String?).
HeldList  ::= [] ; [HeldProbe | HeldList].
WarmWait  ::= none ; wait(Constant, GlobalName, Key).
AnchorFriend ::= none ; found(Key).

%% (ii) The channel to the super-app user interface: what the mini-app shows
%% its person.
AppUi       ::= opened(Constant) ; greeted(Constant) ; got(String)
              ; probed(Constant) ; forwarded(Constant) ; answered ; held_link(Key)
              ; no_conv(Constant).
AppUiStream ::= [] ; [AppUi | AppUiStream].

%% Answers of the host's lookups and checks.
AppLookup ::= found(Module) ; missing.
Verdict   ::= ok(Module) ; refused.
Offer     ::= none ; offer(String, Constant, String).

%% The creator's certification, signed over the source identity together with
%% the contract's act schemas and the checker's verdict (Sections 3 and 6.4).
CreatorCert ::= creator_cert(String, Stream(Constant), Constant).

%% Host state: the installed mini-apps, the attestations minted at
%% befriend_commit, the invitations pending a volition, and the keys of the
%% compilers the person trusts (the bundled compilers' by installation).
%%   app(Name, Content, CreatorSig, Status), Content the module value load_file/2
%%   gave (a Module where the certificate verified): Status is idle(Ui), holding the
%%   mini-app's user-interface writer until activation, or running(SgEnd) once
%%   run/3 has activated it, SgEnd the super-app's writer of the mini-app's
%%   social-graph stream.
AppStatus ::= idle(AppUiStream?) ; running(SgToAppStream?)
            ; idle_coins(Channel(Stream(UserAnswer), Stream(Event))) ; running_coins(Stream(Conversation)?)
            ; idle_cssn(Channel(Stream(CsAppCmd), Stream(CsAppNotify))) ; running_cssn(Stream(CsConversation)?)
            ; idle_sovereign(Channel(Stream(SvUserAnswer), Stream(SvEvent))) ; running_sovereign(Stream(SvConversation)?).
App       ::= app(Constant, Module, String, AppStatus).
AppList   ::= [] ; [App | AppList].
Attest     ::= att(Key, String).
AttestList ::= [] ; [Attest | AttestList].
%% A pending invitation at the invitee: from whom, which mini-app, the offered
%% identities and the signed invitation; or the person's consent given before
%% the offer arrived.
Pending      ::= offered(Constant, Constant, String, Constant, String)
               ; consented(Constant, Constant)
               %% The warm call (Section 5.2), at the holder: the warm call
               %% under way (mini-app, held name), or waiting for the person's
               %% consent (mini-app, name, forwarding friend); the person's
               %% consent to a warm call with an agent; at the anchor: a warm
               %% call accepted, its handshake pending (name, caller); at the
               %% forwarding friend: the person's consent to introduce a
               %% requester to an anchor, or a request (requester, name)
               %% waiting for it.  A name is never taken apart into an agent:
               %% its anchor is only ever compared with an agent at hand.
               ; warm(Constant, GlobalName)
               ; warm_wait(Constant, GlobalName, Key)
               ; warm_consent(Key)
               ; warm_ok(Key)
               ; intro_consent(Constant, Constant)
               ; intro_wait(Constant, Constant)
               ; intro_ok(Key)
               ; intro_via(Key, Key)
               ; held(GlobalName, Constant).
PendingInv   ::= [] ; [Pending | PendingInv].
Host ::= host(AppList, AttestList, PendingInv, Stream(String)).

%% =============================================================================
%% THE INTERFACE OF THE CURRENCY MINI-APP (programs/currencies/coins/currency), as the
%% super-app declares it: coins(Id, Ui, Convs), Ui the mini-app's end of a
%% channel of the mediator's cards and the person's answers, Convs the stream
%% on which the social graph hands it its conversations, each a root channel
%% of the currency protocol.  The definitions are Currencies' own
%% (programs/currencies/coins/self.glp) written here again, since find_type/2 resolves a
%% declaration in the caller's scope and the identity is structural: the
%% super-app carries the interface of every mini-app it hosts.  The names are
%% the super-app's where they clash with the mediator's (CReqId).
%% =============================================================================
Coin ::= coin(Key, Integer).
Lot  ::= lot(Key, Integer).
SwapResponse ::= swap_accept(Stream(Coin)) ; swap_decline(Stream(Coin)).
RedeemResponse ::= redeem_give(Coin)
                 ; redeem_menu(Coin, Stream(Key))
                 ; redeem_declined(Coin).
PeerContent ::= pay(Stream(Coin))
              ; swap(Lot, Stream(Coin), SwapResponse?)
              ; redeem(Coin, Key, RedeemResponse?)
              ; return(Stream(Coin)).
PeerMsg     ::= msg(Key, Key, PeerContent).
PeerChannel ::= ch(Stream(PeerMsg), Stream(PeerMsg)?).
Conversation ::= conversation(Key, PeerChannel).
ScreenContent ::= holdings(Stream(Lot))
                ; opened(Key)
                ; minted(Integer)
                ; paid(Key, Integer)
                ; received(Key, Integer)
                ; returned(Key, Integer)
                ; swap_done(Key)
                ; swap_declined(Key)
                ; swap_failed(Key)
                ; declined(Key)
                ; redeemed(Key, Key)
                ; menu(Key, Stream(Key))
                ; presented(Key, Key)
                ; unfulfilled(Key, Key)
                ; refused(Key)
                ; lacking(Key, Integer)
                ; no_conversation(Key).
CReqId ::= req(Integer).
Answer ::= xs_respond_swap_1(Constant) ; xs_agent_1(Integer) ; xs_agent_2(Key, Key, Integer, Key, Integer) ; xs_agent_3(Key, Integer) ; xs_agent_4(Key, Key).
Context ::= ctx_respond_swap_1(Key, Lot, Stream(Coin)) ; ctx_agent_1 ; ctx_agent_2 ; ctx_agent_3 ; ctx_agent_4.
UserAnswer ::= answer(CReqId, Answer) ; decline(CReqId).
Event ::= card(Constant, Context, CReqId)
        ; closed(CReqId)
        ; aborted(CReqId)
        ; msg(Constant, Constant, ScreenContent).

%% A person's script for the currency (core/superapp_plays.glp): its acts in
%% order; a step is answered on the mediator's latest open card for its
%% clause and is done when the screen shows its effect.
CoinStep   ::= mint(Integer) ; swap(Key, Key, Integer, Key, Integer) ; accept(Key).
CoinScript ::= [] ; [CoinStep | CoinScript].
OpenReq    ::= no_card ; req(Integer).
OpenCards  ::= open(OpenReq, OpenReq).
SwapCard   ::= swap_card(Key, CReqId).
SwapCards  ::= [] ; [SwapCard | SwapCards].
Sent       ::= idle ; sent(CReqId).
Choice     ::= answer(CReqId, Answer) ; wait.

%% =============================================================================
%% THE INTERFACE OF THE DENOMINATED CURRENCIES MINI-APP
%% (programs/currencies/sovereign/denominated), as the super-app declares it:
%% sovereign(Id, Ui, Convs), the two granted channels its second and third
%% arguments, as coins/3 has them.  The definitions are Currencies' own
%% (programs/currencies/sovereign/self.glp), written here again for the reason the
%% currency's are above and taken from that file rather than from their letter.
%% The names are the super-app's, prefixed Sv throughout: EVERY one of them
%% clashes with the currency's, the two mini-apps being hosted side by side and
%% an instrument not being the currency's coin.  Structurally the channel is the
%% currency's with a different payload and more acts --- an instrument, a coin
%% or a bond, in place of the currency's coin; pay carrying a response writer;
%% payout new, and spend and spent, the two legs of a spend through the issuer
%% of the coins spent; redeem carrying the issuer and due of the instrument
%% wanted; mature new, a bond presented to its issuer; transfer, the deposit,
%% release and return of the contract's clause 9; and the currency's return
%% gone.
%% =============================================================================
SvInstrument ::= coin(Key, Constant, Integer) ; bond(Key, Constant, Integer, Integer).
SvLot        ::= lot(Key, Constant, Constant, Integer).
SvAccepting  ::= accepting(Key, Constant, Integer).
SvKind ::= deposit ; release ; return.
SvSwapResponse ::= swap_accept(Stream(SvInstrument)) ; swap_decline(Stream(SvInstrument)).
SvPayResponse ::= pay_taken ; pay_returned(Stream(SvInstrument)).
SvRedeemResponse ::= redeem_give(SvInstrument)
                   ; redeem_menu(SvInstrument, Stream(SvLot))
                   ; redeem_declined(SvInstrument).
SvMatureResponse ::= mature_give(SvInstrument, Integer) ; mature_declined(SvInstrument).
SvTransferResponse ::= transfer_accept ; transfer_decline(Stream(SvInstrument)).
SvContent ::= pay(Stream(SvInstrument), SvPayResponse?)
            ; payout(Constant, Stream(SvInstrument), SvPayResponse?)
            ; spend(Key, Constant, Stream(SvInstrument), SvPayResponse?)
            ; spent(Key, Constant, Stream(SvInstrument), SvPayResponse?)
            ; swap(SvLot, Stream(SvInstrument), SvSwapResponse?)
            ; redeem(SvInstrument, Key, Constant, SvRedeemResponse?)
            ; mature(SvInstrument, SvMatureResponse?)
            ; transfer(SvKind, Stream(SvInstrument), SvTransferResponse?).
SvMsg     ::= msg(Key, Key, SvContent).
SvChannel ::= ch(Stream(SvMsg), Stream(SvMsg)?).
SvConversation ::= conversation(Key, SvChannel).
SvScreenContent ::= holdings(Stream(SvLot))
                  ; acceptances(Stream(SvAccepting))
                  ; opened(Key)
                  ; date_advanced(Integer)
                  ; warranty(Key, Integer)
                  ; minted(Integer, Constant)
                  ; accepted(Key, Constant, Integer)
                  ; not_held(Key, Constant)
                  ; paying(Key, Integer)
                  ; paid(Key, Integer)
                  ; paying_out(Key, Integer)
                  ; paid_out(Key, Integer)
                  ; spending(Key, Key, Integer)
                  ; spent_at(Key, Key, Integer)
                  ; not_accepted(Key, Integer)
                  ; received(Key, Integer)
                  ; refused_payment(Key, Integer)
                  ; received_from(Key, Key, Integer)
                  ; refused_from(Key, Key, Integer)
                  ; countersigned(Key, Key, Integer)
                  ; spend_returned(Key, Key, Integer)
                  ; swap_done(Key)
                  ; swap_declined(Key)
                  ; swap_failed(Key)
                  ; declined(Key)
                  ; redeemed(Key, Key, Constant)
                  ; menu(Key, Stream(SvLot))
                  ; refused(Key)
                  ; presented(Key, Key, Constant)
                  ; unfulfilled(Key, Key, Constant)
                  ; matured(Key, Integer)
                  ; not_mature(Key, Integer)
                  ; matured_for(Key, Integer)
                  ; not_mature_for(Key, Integer)
                  ; offered_transfer(SvKind, Key, SvLot)
                  ; transferred(SvKind, Key)
                  ; transfer_declined(SvKind, Key)
                  ; received_transfer(SvKind, Key, Stream(SvLot))
                  ; declined_transfer(SvKind, Key)
                  ; lacking(Key, Constant, Integer)
                  ; no_conversation(Key)
                  ; fiat_handed(Key, Integer).
SvReqId ::= req(Integer).
SvAnswer ::= xs_respond_swap_1(Constant) ; xs_respond_transfer_1(Constant) ; xs_agent_1(Constant, Integer) ; xs_agent_2(Constant, Integer, Integer) ; xs_agent_3(Key, Constant, Key, Constant, Integer, Key, Constant, Integer) ; xs_agent_4(Constant, Key, Integer) ; xs_agent_5(Key, Constant, Integer) ; xs_agent_6(Key, Constant, Integer) ; xs_agent_7(Key, Key, Constant, Integer) ; xs_agent_8(Key, Constant, Key, Constant) ; xs_agent_9(Key, Constant, Integer) ; xs_agent_10(Key, Constant, Key, Constant, Integer) ; xs_agent_11(Key, Constant, Key, Constant, Integer) ; xs_agent_12(Key, Constant, Key, Constant, Integer).
SvContext ::= ctx_respond_swap_1(Key, SvLot, Stream(SvInstrument)) ; ctx_respond_transfer_1(SvKind, Key, Stream(SvInstrument)) ; ctx_agent_1 ; ctx_agent_2 ; ctx_agent_3 ; ctx_agent_4 ; ctx_agent_5 ; ctx_agent_6 ; ctx_agent_7 ; ctx_agent_8 ; ctx_agent_9 ; ctx_agent_10 ; ctx_agent_11 ; ctx_agent_12.
SvUserAnswer ::= answer(SvReqId, SvAnswer) ; decline(SvReqId).
SvEvent ::= card(Constant, SvContext, SvReqId)
          ; closed(SvReqId)
          ; aborted(SvReqId)
          ; msg(Constant, Constant, SvScreenContent).

%% =============================================================================
%% THE CHILD-SAFE PLATFORM'S INTERFACE, copied from programs/cssn/self.glp for
%% the same reason as the currency's above: find_type/2 resolves the entry's
%% type identity in the caller's scope, and the goal that activates cssn/3 is
%% written here.  Type identity is structural, so the names are the super-app's
%% --- prefixed Cs where they clash with the social graph's own FriendMsg,
%% FriendContent, IntroContent and Conversation, which are different types.
%% Decision and ReqId are shared: theirs and ours are the same type.
%% =============================================================================
CsGroupId   ::= group_id(Constant, Constant).
CsGroupContent ::= group_msg(CsGroupId, Constant, Constant)
                 ; group_leave(CsGroupId, Constant)
                 ; group_removed(CsGroupId).
CsGroupMsg  ::= msg(Constant, Constant, CsGroupContent).
CsGroupSetupResponse ::= group_channel(Channel(Stream(CsGroupMsg), Stream(CsGroupMsg))).
CsIntroContent ::= ack(Constant) ; nack
                 ; friend_channel(Channel(Stream(CsFriendMsg), Stream(CsFriendMsg))).
CsGroupNotifyContent ::= group_invite(CsGroupId, Channel(Stream(CsGroupSetupResponse), Stream(CsIntroContent)))
                       ; group_invite_child(CsGroupId, Constant, Channel(Stream(CsGroupSetupResponse), Stream(CsIntroContent)))
                       ; group_removed(CsGroupId).
CsFriendOnlyContent ::= text(Constant)
                      ; intro(Constant, Channel(Stream(CsIntroContent), Stream(CsIntroContent)))
                      ; child_intro(Constant, Channel(Stream(CsIntroContent), Stream(CsIntroContent)))
                      ; group_msg(CsGroupId, Constant, Constant)
                      ; group_consent_req(CsGroupId, Decision?)
                      ; group_leave(CsGroupId, Constant)
                      ; leave_group(CsGroupId)
                      ; remove_member(CsGroupId, Constant)
                      ; unfriend
                      ; unfriend_child(Constant)
                      ; enrol(Constant, CsEnrolResponse?)
                      ; release_request
                      ; release_grant
                      ; approval
                      ; withdrawal.
CsFriendContent ::= CsFriendOnlyContent ; CsGroupNotifyContent.
CsFriendMsg ::= msg(Constant, Constant, CsFriendContent).
CsEnrolResponse ::= enrol_accept(Channel(Stream(CsFriendMsg), Stream(CsFriendMsg)))
                  ; enrol_no.

%% One end of a conversation of the child-safe platform, and the conversations
%% stream the mini-app is granted.
CsChannel ::= ch(Stream(CsFriendMsg), Stream(CsFriendMsg)?).
CsConversation ::= conversation(Constant, Channel(Stream(CsFriendMsg), Stream(CsFriendMsg))).

%% Person -> mini-app commands, and mini-app -> person notifications: the
%% cards-and-answers channel of this platform, as the currency's Event and
%% UserAnswer are of that one.
CsAppCmd ::= accept_intro(Constant, ReqId)
           ; reject_intro(Constant, ReqId)
           ; accept_child_intro(Constant, ReqId)
           ; reject_child_intro(Constant, ReqId)
           ; approve_child_intro(Constant, Constant, ReqId)
           ; child_introduce(Constant, Constant, Constant)
           ; send(Constant, Constant)
           ; introduce(Constant, Constant)
           ; create_group(Constant)
           ; invite_group(CsGroupId, Constant)
           ; invite_group(CsGroupId, Constant, Constant)
           ; accept_group(CsGroupId, ReqId)
           ; reject_group(CsGroupId, ReqId)
           ; approve_group(Constant, CsGroupId, ReqId)
           ; send_group(CsGroupId, Constant)
           ; leave_group(CsGroupId)
           ; leave_child_group(Constant, CsGroupId)
           ; remove_from_group(CsGroupId, Constant)
           ; approve_child_group(Constant, CsGroupId, ReqId)
           ; reject_child_group(Constant, CsGroupId, ReqId)
           ; unfriend_child(Constant)
           ; unfriend_child_of(Constant, Constant)
           ; remove_child_member(Constant, CsGroupId, Constant)
           ; enrol_child(Constant)
           ; enrol_decision(Decision, Constant, ReqId)
           ; request_release
           ; approve_release(Constant).
CsAppNotify ::= befriend_intro(Constant, Constant, ReqId)
              ; child_befriend(Constant, Constant, ReqId)
              ; connected(Constant)
              ; rejected(Constant)
              ; no_conversation(Constant)
              ; received(Constant, Constant)
              ; group_invite(CsGroupId, ReqId)
              ; group_invite_child(CsGroupId, Constant, ReqId)
              ; group_joined(CsGroupId)
              ; group_joined_member(CsGroupId, Constant)
              ; group_left(CsGroupId)
              ; group_removed(CsGroupId)
              ; group_received(CsGroupId, Constant, Constant)
              ; child_group_consent(Constant, CsGroupId, ReqId)
              ; unfriended(Constant)
              ; enrol_offer(Constant, ReqId)
              ; enrolled(Constant)
              ; release_asked(Constant)
              ; released(Constant).
%% The person's consent to a warm call, and the anchor it names.
WarmConsent ::= no ; yes(Key).

%% One end of a root channel, of the test mini-app's protocol, of the
%% currency's or of the child-safe platform's, as the friend channel conveys it
%% at the handshake.
RootEnd ::= ping_end(RootChannel) ; coins_end(PeerChannel) ; cssn_end(CsChannel)
          ; sovereign_end(SvChannel).

%% Output list — one constructor per output kind, each typed at exactly what it
%% carries. Replaces the former output(Constant, OutputStream?) whose union
%% OutputMsg joined the user/net/friend message types and so broke duality
%% against the mediator's AgentToUserStream channel.
OutputEntry ::= user_output(AgentToUserStream?)
              ; net_output(NetOutStream?)
              ; friend_output(Key, FriendStream?).
OutputsList ::= [] ; [OutputEntry | OutputsList].

%% =============================================================================
%% MEDIATOR TYPES
%% =============================================================================

ReqId ::= req(Constant).

%% User -> Mediator
UserCmd ::= decision(Decision, Key, ReqId)
          ; accept_intro(Key, ReqId)
          ; reject_intro(Constant, ReqId)
          ; connect(Key)
          ; send(Key, Constant)
          ; introduce(Key, Key)
          ; unfriend(Key).

%% Mediator -> User
UserNotify ::= befriend(Key, ReqId)
             ; befriend_intro(Constant, Key, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; received(Key, Constant)
             ; unfriended(Constant).

%% User ↔ mediator streams and channels
UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].
UserChannel      ::= ch(UserCmdStream, UserNotifyStream?).

%% Actor's view of the user channel (reversed)
ActorChannel ::= ch(UserNotifyStream, UserCmdStream?).

%% Agent ↔ mediator precise streams
AgentToUserMsg        ::= msg(Constant, Constant, AgentContent).
AgentToUserStream     ::= [] ; [AgentToUserMsg | AgentToUserStream].
MediatorToAgentMsg    ::= msg(Constant, Key, UserContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].
AgentChannel          ::= ch(AgentToUserStream, MediatorToAgentStream?).

%% Agent input types
UserInMsg    ::= msg(Constant, Key, UserContent)
               ; intro_result(Key, IntroChannel)
               ; intro_rejected(Constant)
               %% A running mini-app's request up its social-graph channel.
               ; app_request(Constant, AppToSg)
               %% A mini-app's execution has ended: the stream it writes up to
               %% the social graph closed with it, which is the one signal of
               %% its end the super-app holds a reader of.
               ; app_ended(Constant).
UserInStream ::= [] ; [UserInMsg | UserInStream].

NetInMsg     ::= msg(Key, NetColdCall)
               ; msg(Key, Key, FriendContent)
               %% The runtime's report of a held link (Section 5.2; madGLP).
               ; pending_link(GlobalName, Key).
NetInStream  ::= [] ; [NetInMsg | NetInStream].

%% Pending entries
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% ENTRY POINTS (modules.tex sec:static-linking step 5, §External access)
%% The root self.glp exports each program entry by forwarding to boot, so an
%% external goal calls it by plain name. boot.glp is unchanged.
%% =============================================================================
imported procedure boot#play1.
exported procedure play1.
play1 :- boot # play1.

imported procedure boot#play2.
exported procedure play2.
play2 :- boot # play2.

imported procedure boot#play3.
exported procedure play3.
play3 :- boot # play3.

imported procedure boot#fplay1.
exported procedure fplay1.
fplay1 :- boot # fplay1.

imported procedure boot#fplay2.
exported procedure fplay2.
fplay2 :- boot # fplay2.

imported procedure boot#fplay3.
exported procedure fplay3.
fplay3 :- boot # fplay3.

