%% self.glp — Social Graph (simulated UI) shared type vocabulary
%%
%% All protocol types for the Social Graph application with UI mediator.
%% Defined once here, visible to all modules via ancestor scoping.


%% =============================================================================
%% CORE PROTOCOL TYPES
%% =============================================================================

%% Stream and Channel are predefined in root self.glp:
%%   Stream ::= [] ; [_|Stream].
%%   Channel ::= ch(Stream, Stream?).

%% A cold-call accept conveys a SETUP channel (IntroChannel), not the friend
%% channel directly; the fresh friend channel is conveyed on the setup channel at
%% commit by the shared lib befriend_commit (CSSN Issue 16).
Response ::= accept(IntroChannel) ; no.
Decision ::= yes ; no.
Handshake ::= ack(Constant) ; nack.
PendingValue ::= response(Response?) ; channel(IntroChannel) ; error.

%% --- Content types for messages ---

%% Content carried inside user-to-agent messages (msg(person, Id, Content))
UserContent ::= connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; send(Constant, Constant)
              ; introduce(Constant, Constant)
              ; accept_intro(Constant, PendingValue)
              ; reject_intro(Constant, PendingValue)
              ; unfriend(Constant)
              ; response(Response)
              %% The super-app (SGSG paper, Section 3).  install: the person
              %% installs a certified mini-app --- its module value, its
              %% creator's certification, and the mini-app's user-interface
              %% channel (the super-app user interface holds the other end; in
              %% a play, the play does).  invite: offer a friend the mini-app.
              %% accept_invite / decline_invite: the invitee's volition.
              %% attestation: read back the attestation minted at
              %% befriend_commit (Section 5.5).
              ; install(Constant, Content, String, AppUiStream?)
              ; invite(Constant, Constant)
              ; accept_invite(Constant, Constant)
              ; decline_invite(Constant, Constant)
              ; attestation(Constant, String?)
              %% trust: the person trusts a compiler's key (Section 6.4); the
              %% bundled compiler's, trusted by installing the super-app.
              ; trust(String)
              %% installed: the names of the mini-apps installed, for a play.
              ; installed(Stream(Constant)?).

%% Content carried inside agent-to-user messages (msg(agent, person, Content))
AgentContent ::= befriend(Constant, Response?)
               ; befriend_intro(Constant, Constant, IntroChannel)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; unfriended(Constant)
               ; received(Constant, Constant).

%% Network content (2-arg cold-call: msg(Dest, Content))
NetColdCall ::= intro(Constant, Response?).

%% Friend-to-friend content (3-arg: msg(From, To, Content))
FriendContent ::= response(Response)
                ; text(Constant)
                ; unfriend
                ; intro(Constant, IntroChannel)
                %% Distribution with an invitation and the handshake (SGSG
                %% paper, Section 3): the offer carries the mini-app's source
                %% identity, the root channel's type identity and the social
                %% graph's signed invitation; join carries the invitee's signed
                %% undertaking; root carries the inviter's undertaking and one
                %% end of the root channel, which the invitee's super-app hands
                %% to its mini-app only after the handshake succeeds.
                ; invite(Constant, String, Constant, String)
                ; join(Constant, String, Constant, String)
                ; decline(Constant)
                ; root(Constant, String, Constant, String, RootChannel).

%% Setup channel content: ack/nack handshake plus the fresh-friend-channel
%% conveyance the shared lib befriend_commit uses to install the friend channel.
IntroContent ::= ack(Constant) ; nack ; friend_channel(FriendChannel).

%% Intro channel (handshake protocol)
IntroStream  ::= [] ; [IntroContent | IntroStream].
IntroChannel ::= ch(IntroStream, IntroStream?).

%% Friend messages and channels
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

%% Network output stream — cold calls the agent emits on its '_net' entry.
NetOutMsg    ::= msg(Constant, NetColdCall).
NetOutStream ::= [] ; [NetOutMsg | NetOutStream].

%% Intro result — written by intro_await_peer, injected into UserIn
IntroResult ::= intro_result(Constant, IntroChannel) ; intro_rejected(Constant).

%% NOTE (SGSG Code, 2026-09-08): the catalogue's Key, SignedTerm and Hash are
%% root-scope aliases of String; they resolve in procedure declarations but
%% not inside a descendant's type definitions ("Unresolved type: SignedTerm"),
%% reported to IGLP.  The definitions below therefore say String where the
%% catalogue says Key, SignedTerm or Hash; the declarations keep the names.

%% =============================================================================
%% THE SUPER-APP (SGSG paper, Section 3): what a mini-app is granted, and the
%% host state the social graph keeps for it.
%% =============================================================================

%% The test mini-app, ping/3 (miniapp.glp): two executions greet each other
%% over the root channel of their conversation and report to their persons.
%% The root channel's message type is the mini-app's; the friend-channel
%% message that conveys an end names it, this program being both the super-app
%% and the mini-app in the plays.
PingMsg     ::= hello(Constant).
PingStream  ::= [] ; [PingMsg | PingStream].
RootChannel ::= ch(PingStream, PingStream?).

%% (i) The channel to the social graph: the social graph hands the mini-app,
%% at each invitation, one end of a root channel to the execution of the same
%% mini-app at a friend.
SgToApp       ::= conversation(Constant, RootChannel).
SgToAppStream ::= [] ; [SgToApp | SgToAppStream].

%% (ii) The channel to the super-app user interface: what the mini-app shows
%% its person.
AppUi       ::= opened(Constant) ; greeted(Constant).
AppUiStream ::= [] ; [AppUi | AppUiStream].

%% Answers of the host's lookups and checks.
AppLookup ::= found(Content) ; missing.
Verdict   ::= ok(Content) ; refused.
Offer     ::= none ; offer(String, Constant, String).

%% The creator's certification, signed over the source identity together with
%% the contract's act schemas and the checker's verdict (Sections 3 and 6.4).
CreatorCert ::= creator_cert(String, Stream(Constant), Constant).

%% Host state: the installed mini-apps, the attestations minted at
%% befriend_commit, the invitations pending a volition, and the keys of the
%% compilers the person trusts (the bundled compilers' by installation).
%%   app(Name, Content, CreatorSig, Status), Content the module value load_file/2
%%   gave (a Module where the certificate verified): Status is idle(Ui), holding the
%%   mini-app's user-interface writer until activation, or running(SgEnd) once
%%   run/3 has activated it, SgEnd the super-app's writer of the mini-app's
%%   social-graph stream.
AppStatus ::= idle(AppUiStream?) ; running(SgToAppStream?).
App       ::= app(Constant, Content, String, AppStatus).
AppList   ::= [] ; [App | AppList].
Attest     ::= att(Constant, String).
AttestList ::= [] ; [Attest | AttestList].
%% A pending invitation at the invitee: from whom, which mini-app, the offered
%% identities and the signed invitation; or the person's consent given before
%% the offer arrived.
Pending      ::= offered(Constant, Constant, String, Constant, String)
               ; consented(Constant, Constant).
PendingInv   ::= [] ; [Pending | PendingInv].
Host ::= host(AppList, AttestList, PendingInv, Stream(String)).

%% Output list — one constructor per output kind, each typed at exactly what it
%% carries. Replaces the former output(Constant, OutputStream?) whose union
%% OutputMsg joined the user/net/friend message types and so broke duality
%% against the mediator's AgentToUserStream channel.
OutputEntry ::= user_output(AgentToUserStream?)
              ; net_output(NetOutStream?)
              ; friend_output(Constant, FriendStream?).
OutputsList ::= [] ; [OutputEntry | OutputsList].

%% =============================================================================
%% MEDIATOR TYPES
%% =============================================================================

ReqId ::= req(Constant).

%% User -> Mediator
UserCmd ::= decision(Decision, Constant, ReqId)
          ; accept_intro(Constant, ReqId)
          ; reject_intro(Constant, ReqId)
          ; connect(Constant)
          ; send(Constant, Constant)
          ; introduce(Constant, Constant)
          ; unfriend(Constant).

%% Mediator -> User
UserNotify ::= befriend(Constant, ReqId)
             ; befriend_intro(Constant, Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; received(Constant, Constant)
             ; unfriended(Constant).

%% User ↔ mediator streams and channels
UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].
UserChannel      ::= ch(UserCmdStream, UserNotifyStream?).

%% Actor's view of the user channel (reversed)
ActorChannel ::= ch(UserNotifyStream, UserCmdStream?).

%% Agent ↔ mediator precise streams
AgentToUserMsg        ::= msg(Constant, Constant, AgentContent).
AgentToUserStream     ::= [] ; [AgentToUserMsg | AgentToUserStream].
MediatorToAgentMsg    ::= msg(Constant, Constant, UserContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].
AgentChannel          ::= ch(AgentToUserStream, MediatorToAgentStream?).

%% Agent input types
UserInMsg    ::= msg(Constant, Constant, UserContent)
               ; intro_result(Constant, IntroChannel)
               ; intro_rejected(Constant).
UserInStream ::= [] ; [UserInMsg | UserInStream].

NetInMsg     ::= msg(Constant, NetColdCall)
               ; msg(Constant, Constant, FriendContent).
NetInStream  ::= [] ; [NetInMsg | NetInStream].

%% Pending entries
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% ENTRY POINTS (modules.tex sec:static-linking step 5, §External access)
%% The root self.glp exports each program entry by forwarding to boot, so an
%% external goal calls it by plain name. boot.glp is unchanged.
%% =============================================================================
imported procedure boot#play1.
exported procedure play1.
play1 :- boot # play1.

imported procedure boot#play2.
exported procedure play2.
play2 :- boot # play2.

imported procedure boot#play3.
exported procedure play3.
play3 :- boot # play3.

imported procedure boot#fplay1.
exported procedure fplay1.
fplay1 :- boot # fplay1.

imported procedure boot#fplay2.
exported procedure fplay2.
fplay2 :- boot # fplay2.

imported procedure boot#fplay3.
exported procedure fplay3.
fplay3 :- boot # fplay3.

imported procedure boot#play_unfriend_send.
exported procedure play_unfriend_send.
play_unfriend_send :- boot # play_unfriend_send.

imported procedure boot#play_unfriend_recv.
exported procedure play_unfriend_recv.
play_unfriend_recv :- boot # play_unfriend_recv.

imported procedure boot#play_unfriend_absent.
exported procedure play_unfriend_absent.
play_unfriend_absent :- boot # play_unfriend_absent.

%% Live-UI boot (play_ui_boot.glp, a UIVE UI module): the Dart bridge enters
%% the program at agent_init/3.
imported procedure play_ui_boot#agent_init(Constant?, UserCmdStream?, NetInStream?).
exported procedure agent_init(Constant?, UserCmdStream?, NetInStream?).
agent_init(Id, UserIn, NetIn) :- play_ui_boot # agent_init(Id?, UserIn?, NetIn?).
