%% person.glp --- the self-ending mini-app's scripted person: miniapp_person/4,
%% the super-app's second template at the mini-app's own type End (self.glp;
%% GSG, 2026-10-13 18:52 UTC, O5, and 20:22 UTC, H).  The super-app's plays
%% activate it from the mini-app's module value, as they activate the entry,
%% and hold the screen it reports at Opaque.
%%
%% It reads what the mini-app draws on the person-side end of its person
%% channel and reports on its screen each item of the output thread, construct
%% 0, as it arrives: the newest item of each draw.  The mini-app asks its
%% person nothing, so the person grants nothing, and closes its grants at
%% once.  Its one script, under any role, reports every item until the draws
%% close: at alice when her execution ends of its own accord, which is what
%% the play of the registry's return to idle reads
%% (../core/superapp_plays.glp, play_reinvite).

exported procedure miniapp_person(Key?, Constant?, Channel(Stream(Draw(End)), Stream(Input(End)))?, Stream(End)).
miniapp_person(_, _, ch(Ds, []), Screen?) :- watch(Ds?, Screen).

%% watch(Ds, Screen): each draw of the output thread read for its newest
%% item; any other draw passed over.
procedure watch(Stream(Draw(End))?, Stream(End)).
watch([draw(0, _, output(Es)) | Ds], Screen?) :- newest(Es?, Ds?, Screen).
watch([_ | Ds], Screen?) :- otherwise | watch(Ds?, Screen).
watch([], []).

%% newest(Es, Ds, Screen): the newest item of the thread drawn, Es, onto the
%% screen; the draw with no item is none.
procedure newest(Stream(End)?, Stream(Draw(End))?, Stream(End)).
newest([], Ds, Screen?) :- watch(Ds?, Screen).
newest([U], Ds, [U? | Screen?]) :- watch(Ds?, Screen).
newest([_, U1 | Us], Ds, Screen?) :- newest([U1? | Us?], Ds?, Screen).
