%% endapp/self.glp --- the test mini-app that ends of its own accord, as a
%% certified program of its own.  The REPL's :artefact writes its certified
%% artefact, endapp.glpw, into ../core, where the super-app's agent reads it
%% with load_file/2, verifies its two certifications, installs it, and
%% activates it by run/3 (GSG paper, Section 3).
%%
%% It exists because ../pingapp cannot fence the registry's return from
%% running to idle: see miniapp.glp.  Its entry is the super-app's entry
%% template miniapp/4, declared once in the root programs/self.glp, at its own
%% two types, EndShown what it draws for its person and EndMsg its root
%% channels' messages (vGLP, 2026-10-14 13:21 UTC, S2), and its scripted person
%% the second template miniapp_person/4 at EndShown and its screen's type
%% EndUi (vGLP 2026-10-16 11:25 UTC, item 4; TGLP modules.tex, Dynamic Activation, "Opaque types"; GSG,
%% 2026-10-13 18:52 UTC, O5, and 20:22 UTC, H).

%% The root channel's one message between two executions: a greeting.
EndMsg ::= hello(Key).

%% What the mini-app shows its person, one item at a time.
EndUi       ::= opened(Key) ; greeted(Key).

%% What the mini-app draws for its person, the template's first parameter:
%% its output thread, construct 0, wrapped in output(...) (vGLP, 2026-10-14
%% 11:36 UTC); the items of that thread, EndUi, are what its scripted person
%% reports it sees.  Its root channels' messages, EndMsg, are the second.
EndShown ::= output(Stream(EndUi)).

%% The events of its conversations' readers, and their write ends.
EndEv     ::= greeted(Key, Key).
EndEvs    ::= [] ; [EndEv | EndEvs].
EndConv   ::= conv(Key, Stream(EndMsg)?).
EndConvs  ::= [] ; [EndConv | EndConvs].

imported procedure miniapp#miniapp(Key?, PersonChannel(EndShown)?, SgChannel(EndMsg)?, Stream(Integer)?).
exported procedure miniapp(Key?, PersonChannel(EndShown)?, SgChannel(EndMsg)?, Stream(Integer)?).
miniapp(Id, Ui, Sg, Cal) :- miniapp # miniapp(Id?, Ui?, Sg?, Cal?).

imported procedure person#miniapp_person(Key?, Constant?, Channel(PersonOut(EndShown), PersonIn(EndShown))?, Stream(EndUi)).
exported procedure miniapp_person(Key?, Constant?, Channel(PersonOut(EndShown), PersonIn(EndShown))?, Stream(EndUi)).
miniapp_person(Id, Role, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, PEnd?, Screen).
