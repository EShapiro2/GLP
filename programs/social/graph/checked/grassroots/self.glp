%% checked/grassroots --- a test program of GSA's that gives a contract and does
%% nothing else: its exported contract/2, at the type the owners agreed on
%% 2026-11-20 (../../self.glp, GivenContract), gives the contract below, whose
%% verdict by GSC's checker (programs/gsc/checker, check/2) is syntactically_grassroots.  The
%% super-app's plays install it to show the third check of GPD's
%% Implementation pragma, "that its schemas pass the checker" (../../Programs.txt;
%% core/agent.glp, schemas_check/3; core/superapp_plays.glp, play_install/4).
exported procedure contract(String, GivenContract).
contract("Establish and acquaint: Alice may establish an identity once; Alice and Bob may jointly come to know each other.", with([schema(establish, ['Alice'], [], [rs(guarded, [atom(identity, []), atom(person, [])], [], [], [atom(identity, [])])]), schema(acquaint, ['Alice', 'Bob'], [], [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []), rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])], pragmas([], [], [], nolook, version(1, 1)))).
