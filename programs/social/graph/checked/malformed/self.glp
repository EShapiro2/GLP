%% checked/malformed --- a test program of GSA's that gives a contract and does
%% nothing else: its exported contract/2, at the type the owners agreed on
%% 2026-11-20 (../../self.glp, GivenContract), gives the contract below, whose
%% verdict by GSC's checker (programs/gsc/checker, check/2) is malformed([not_in_head(s, svar(x))]).  The
%% super-app's plays install it to show the third check of GPD's
%% Implementation pragma, "that its schemas pass the checker" (../../Programs.txt;
%% core/agent.glp, schemas_check/3; core/superapp_plays.glp, play_install/4).
exported procedure contract(String, GivenContract).
contract("S: a schema whose atom names a variable not in its head.", with([schema(s, ['Alice'], [], [rs(guarded, [atom(p, [svar(x)])], [], [], [])])], pragmas([], [], [], nolook, version(1, 1)))).
