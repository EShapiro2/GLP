%% Encounters.glp --- printed by adopt.py from Encounters.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Encounters.txt and run adopt.py Encounters.
% contract_named(encounters, C): the contract, Encounters.
procedure contract_named(Constant?, SDeclared).
contract_named(encounters, environment([nearby], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(open_place, ['Alice'], [], [atom(open_place, ['Alice'])], [atom(identity, ['Alice']), not(atom(open_place, ['Alice']))], true, ['Alice']),
 sas(close_place, ['Alice'], [], [not(atom(open_place, ['Alice']))], [atom(identity, ['Alice']), atom(open_place, ['Alice'])], true, ['Alice']),
 sas(encounter, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), not(atom(knows, ['Alice', 'Bob'])), not(atom(knows, ['Bob', 'Alice'])), atom(nearby, ['Alice', 'Bob']), atom(nearby, ['Bob', 'Alice']), atom(open_place, ['Alice']), atom(open_place, ['Bob'])], true, ['Alice', 'Bob'])]))).
