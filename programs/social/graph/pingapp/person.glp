%% person.glp --- the test mini-app's scripted person: miniapp_person/4, the
%% super-app's second template at the mini-app's own type Ping (self.glp;
%% GSG, 2026-10-13 18:52 UTC, O5, and 20:22 UTC, H).  The super-app's plays
%% activate it from the mini-app's module value, as they activate the entry,
%% and hold the screen it reports at Opaque.
%%
%% It reads what the mini-app draws on the person-side end of its person
%% channel and reports on its screen each item of the output thread, construct
%% 0, as it arrives: the newest item of each draw.  The mini-app asks its
%% person nothing, so the person grants nothing, and closes its grants at
%% once.  The role chooses the script:
%%   greet  reports until the execution reports a greeting, and then stops,
%%          its screen closing: the plays that wait for the greeting read the
%%          screen's close (../core/superapp_plays.glp);
%%   watch  reports every item until the draws close, the execution having
%%          ended or the super-app having closed it.

exported procedure miniapp_person(Key?, Constant?, Channel(Stream(Draw(Ping)), Stream(Input(Ping)))?, Stream(Ping)).
miniapp_person(_, Role, ch(Ds, []), Screen?) :- watch(Role?, Ds?, Screen).

%% watch(Role, Ds, Screen): each draw of the output thread read for its newest
%% item; any other draw passed over.
procedure watch(Constant?, Stream(Draw(Ping))?, Stream(Ping)).
watch(Role, [draw(0, _, output(Es)) | Ds], Screen?) :- newest(Role?, Es?, Ds?, Screen).
watch(Role, [_ | Ds], Screen?) :- otherwise | watch(Role?, Ds?, Screen).
watch(_, [], []).

%% newest(Role, Es, Ds, Screen): the newest item of the thread drawn, Es, onto
%% the screen; the draw with no item is none.  Under the role greet, a
%% greeting is the last item reported.
procedure newest(Constant?, Stream(Ping)?, Stream(Draw(Ping))?, Stream(Ping)).
newest(Role, [], Ds, Screen?) :- watch(Role?, Ds?, Screen).
newest(greet, [greeted(W)], _, [greeted(W?)]).
newest(Role, [U], Ds, [U? | Screen?]) :- otherwise | watch(Role?, Ds?, Screen).
newest(Role, [_, U1 | Us], Ds, Screen?) :- newest(Role?, [U1? | Us?], Ds?, Screen).
