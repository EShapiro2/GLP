%% =============================================================================
%% THE AGENT'S INITIAL GOAL
%% =============================================================================

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel
%% first and the network channel second (GLP-Spec maglp.tex, Definition
%% "Multiagent GLP"), on a phone as in a simulation: "A boot defines no
%% agent/2: the program it loads answers the initial goal, in a simulation as
%% on a phone, and the person goal's first act names the entry the program
%% starts" (IGLP 0e1c9e0, Implementation Notes, "Boot").  self_key/1 first
%% makes the agent's key, before which nothing is sent on the network (GLP-Spec
%% appendix-guards.tex, "Identity and signature").  The first act carries the
%% entry's arguments: the person's key and the keys of the peers the person
%% knows ("An agent learns the keys of its peers from its person"), on a
%% phone the rendezvous servers the app is configured with (GSA paper,
%% Appendix "The Operating System", "Boot"), and, for a boot's phone, the
%% person's part in its script: superapp/5 (the super-app on a phone, its
%% person live and its network the layer's), superapp_ui/4 (the super-app
%% with a live person and its peers scripted in one heap, for demonstration),
%% link_phone/5 (the operating system on the layer with a scripted person,
%% for the tests of invitation links over the WAN), sg_init/4 (the boots of
%% programs/social), and the smartphone of each app's boot (programs/apps).
%% The person's acts after the first are the grants of the super-app's
%% person channel, which superapp/5, superapp_ui/4 and link_phone/5 read; a
%% boot's person closes the stream after the first act.
CoreAct ::= superapp(Key, List(Key), List(Service))
          ; superapp_ui(Key, List(Key))
          ; link_phone(Key, List(Key), List(Service))
          ; sg_init(Key, Constant, List(Key))
          ; gsg_phone(Constant, Key, List(Key))
          ; gsn_phone(Constant, Key, List(Key))
          ; gkk_phone(Constant, Key, List(Key))
          ; gsnp_phone(Constant, Key, List(Key))
          ; gai_phone(Constant, Key, List(Key))
          ; gc_phone(Constant, Key, List(Key))
          ; gb_phone(Constant, Key, List(Key))
          ; coins_phone(Constant, Key, List(Key))
          ; dated_phone(Constant, Key, List(Key))
          ; sovereign_phone(Constant, Key, List(Key)).
CoreIn  ::= [] ; [CoreAct | Grants].
Grants  ::= [] ; [Input(HomeDrawn) | Grants].

%% The smartphones of the apps' boots (programs/apps/<app>_boot.glp) and of
%% the currencies' plays' boots (programs/currencies/<program>_<play>_boot.glp),
%% each a module of this directory, <app>_phone.glp or <program>_phone.glp.
imported procedure gsg_phone#gsg_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure gsn_phone#gsn_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure gkk_phone#gkk_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure gsnp_phone#gsnp_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure gai_phone#gai_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure gc_phone#gc_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure gb_phone#gb_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure coins_phone#coins_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure dated_phone#dated_phone(Constant?, Key?, List(Key)?, NetInStream?).
imported procedure sovereign_phone#sovereign_phone(Constant?, Key?, List(Key)?, NetInStream?).

exported procedure agent(Channel(CoreIn, Stream(Constant))?, Channel(NetInStream, NetOutStream)?).
agent(ch(In, []), ch(N, [])) :- self_key(_), core_start(In?, N?).

%% The entry the person's first act names, on the network input.
procedure core_start(CoreIn?, NetInStream?).
core_start([superapp(P, Qs, Ss) | Gs], N) :-
    person_grants(Gs?, Grants), superapp(P?, Qs?, Ss?, Grants?, N?).
core_start([link_phone(P, Qs, Ss) | Gs], N) :-
    link_phone(P?, Qs?, Ss?, Gs?, N?).
core_start([superapp_ui(P, Qs) | Gs], N) :-
    person_grants(Gs?, Grants), superapp_ui(P?, Qs?, Grants?, N?).
core_start([sg_init(P, M, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), sg_init(P?, M?, Qs?, N?).
core_start([gsg_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), gsg_phone # gsg_phone(R?, P?, Qs?, N?).
core_start([gsn_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), gsn_phone # gsn_phone(R?, P?, Qs?, N?).
core_start([gkk_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), gkk_phone # gkk_phone(R?, P?, Qs?, N?).
core_start([gsnp_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), gsnp_phone # gsnp_phone(R?, P?, Qs?, N?).
core_start([gai_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), gai_phone # gai_phone(R?, P?, Qs?, N?).
core_start([gc_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), gc_phone # gc_phone(R?, P?, Qs?, N?).
core_start([gb_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), gb_phone # gb_phone(R?, P?, Qs?, N?).
core_start([coins_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), coins_phone # coins_phone(R?, P?, Qs?, N?).
core_start([dated_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), dated_phone # dated_phone(R?, P?, Qs?, N?).
core_start([sovereign_phone(R, P, Qs) | _], N) :-
    ground(Qs?) | known_peers(Qs?), sovereign_phone # sovereign_phone(R?, P?, Qs?, N?).
core_start([], _).

%% known_peers(Qs): each person the person knows, named by the first act,
%% declared to the layer as a known peer, declare(peer(Q)), so that the layer
%% recognises them wherever they are (GSA paper, Appendix "The Operating
%% System", "Nearby": "The operating system declares to the layer, as a known
%% peer, every person its person knows"; GLP-Spec appendix-guards,
%% "Networking seam": "peer(P) gives the networking layer the public key P of
%% a peer the program knows").  The boots' smartphones run the agent without
%% the place (os_phone/6, which declares them itself), and from 2026-11-08 the
%% boot harness opens no trust at spawn (IGLP 45fabfc, "Simulation
%% realisation"), so a person known is answered by being declared.
procedure known_peers(List(Key)?).
known_peers([Q | Qs]) :- ground(Q?) | declare(peer(Q?)), known_peers(Qs?).
known_peers([]).

%% The person's grants after the first act, onto the super-app's person
%% channel, which never closes (vGLP, Section 6.3): where the person's stream
%% closes, no grant comes again, and the channel's grants are held for good,
%% on a fresh channel nothing writes, as hold_person/1 holds a person channel.
procedure person_grants(Grants?, PersonIn(HomeDrawn)).
person_grants([G | Gs], [G? | Ps?]) :- person_grants(Gs?, Ps).
person_grants([], Ps?) :- new_channel(A, B), hold_grants(A?, B?, Ps).

procedure hold_grants(Channel(PersonOut(HomeDrawn), PersonIn(HomeDrawn))?, Channel(PersonIn(HomeDrawn), PersonOut(HomeDrawn))?, PersonIn(HomeDrawn)).
hold_grants(ch([_ | Ds], Gs?), B, Ps?) :- hold_grants(ch(Ds?, Gs), B?, Ps).
