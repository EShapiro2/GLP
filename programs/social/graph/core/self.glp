%% The plays of the operating system's invitation links (links.glp) under
%% the plain REPL, one key the inviter and the recipient both, and no layer
%% bound, the seam doing nothing (IGLP, "One interface"): play_links/6 runs
%% the links process on the person's acts Acts with the servers Ss and the
%% directory D;
%% play_link_open/2 makes a link by Invite by link and opens it, the
%% redemption sent; play_link_expired/1 opens a link whose expiry has passed.
imported procedure links#links(Key?, List(RvServer)?, Directory?, Integer?, Stream(LinkAct)?, AgentToUserStream, NetOutStream, UserInStream).
exported procedure play_links(List(RvServer)?, Directory?, Stream(LinkAct)?, AgentToUserStream, NetOutStream, UserInStream).
play_links(Ss, D, Acts, Out?, Net?, Cmds?) :-
    self_key(K),
    links # links(K?, Ss?, D?, 0, Acts?, Out, Net, Cmds).

exported procedure play_link_open(AgentToUserStream, NetOutStream).
play_link_open(Out?, Net?) :-
    self_key(K),
    links # links(K?, [rendezvous(rv, rv_addr)], none, 0, [invite_link], O1, _, _),
    link_told(O1?, L),
    open_made(L?, Out, Net).

exported procedure play_link_expired(AgentToUserStream).
play_link_expired(Out?) :-
    self_key(K),
    now(T),
    E := T? - 1,
    expired_link(K?, E?, L),
    open_made(L?, Out, _).

%% The link the person is told, invitation(L); where the person is told none,
%% the empty text, which signature/2 reports unsigned.
procedure link_told(AgentToUserStream?, SignedTerm).
link_told([msg(_, _, invitation(L)) | _], L?).
link_told([_ | Ms], L?) :- otherwise | link_told(Ms?, L).
link_told([], "").

%% The link L opened by the person of this REPL's key, no server named.
procedure open_made(SignedTerm?, AgentToUserStream, NetOutStream).
open_made(L, Out?, Net?) :-
    ground(L?) |
    self_key(K),
    links # links(K?, [], none, 0, [open_link(L?)], Out, Net, _).

%% A link of serial 1 to the server rv, signed by K, expiring at E.
procedure expired_link(Key?, Integer?, SignedTerm).
expired_link(K, E, L?) :-
    ground(K?), integer(E?) |
    sign(invitation(K?, rv, rv_addr, 1, E?), K?, L).

imported procedure superapp_plays#play_invite_timed(Key?, Key?, Integer).
exported procedure play_invite_timed(Key?, Key?, Integer).
play_invite_timed(P, Q, Ms?) :- superapp_plays # play_invite_timed(P?, Q?, Ms).

