%% core/self.glp --- the social graph as the super-app, as a program of its own.
%%
%% The directory holds the agent (agent.glp) and the super-app plays
%% (superapp_plays.glp); the types are the parent's (../self.glp, an ancestor
%% scope).  The certified mini-apps it hosts are programs of their own
%% (../pingapp, ../endapp; programs/currencies/coins/currency, ...), whose
%% artefacts the REPL's :artefact writes here, the one place the agent's
%% load_file/2 resolves a name.  The super-app holds no declaration of a
%% mini-app's types: each mini-app's entry is the instance of the entry
%% template miniapp/4, declared once in the root programs/self.glp, at the
%% mini-app's own type, and the super-app activates it by the template's
%% opaque instance at that type (GSG paper, Sections 3 and 4).  Loaded as part
%% of ../ (the UI boot plays), the agent is called as core # agent, through
%% the forwarder below; under :boot (../../superapp_boot.glp) sg_init/4 runs
%% one super-app per isolate.  No clause here names a peer by an atom: an
%% agent is its public key, and a readable name such as alice is a variable
%% standing for a key (IGLP, Remark "Agent Names"); an agent learns its peers'
%% keys from its person (IGLP, Implementation Notes, "Boot"), and a play or a
%% boot is given them by the goal that starts it.

%% The questions of the super-app's own person interface (home.vglp), as its
%% compilation home.glp carries them (vGLP, Definition "Canonical
%% Compilation"): the union of home's questions, of which the asks on its ask
%% stream are made, written here again under core's own names, since
%% ../self.glp's Question and Request are the currency's.  Types are not
%% exported: a caller declares what it passes in its own scope, and the
%% imported declarations below carry exactly the types of home.glp's exports,
%% structurally (TGLP, "Cross-module type checking").  HomeDrawn is home.glp's
%% Drawn, the type its person channel carries.  Ask(Q) is ../self.glp's, as
%% home.glp's own, and the person channel's types the root's.
HomeRequest       ::= trust(Key) ; install(String, String) ; invite(String, Key) ; open_place ; close_place ; invite_link ; open_link(String) ; list(String, String) ; list_unlisted(String, String) ; unlist.
HomeFriendRequest ::= from(Key, Decision?).
HomeWord          ::= text(String) ; person(Key).
HomeIntroRequest  ::= approval(HomeIntroParties, List(HomeWord), Decision?).
HomeIntroParties  ::= intro(Key, Key).
HomeIntroduce     ::= introduce.
HomeIntroduction  ::= introduction(Key, Key, HomeIntroduce?).
HomeNearbyPerson  ::= nearby(Key, HomeBefriend?).
HomeBefriend      ::= befriend.
HomeQuestion      ::= friendRequest_w(HomeFriendRequest) ; introRequest_w(HomeIntroRequest) ; nearbyPerson_w(HomeNearbyPerson) ; introduction_w(HomeIntroduction) ; stream_request_r(Stream(HomeRequest)?).
HomeDrawn         ::= friendRequest_w(_) ; introRequest_w(_) ; nearbyPerson_w(_) ; introduction_w(_) ; stream_request_r(_) ; output(List(Output)) ; Decision ; HomeBefriend ; HomeIntroduce ; HomeRequest.

%% A rendezvous server the person's first act names, by its key and its
%% address (GSA paper, Appendix "The Operating System", "Boot"), and the
%% person's acts on invitation links, which the operating system takes
%% (links.glp): Invite by link, and the opening of a link the person was
%% sent, its text.
RvServer ::= rendezvous(Key, String).

%% A service the app is configured with, which the person's first act names
%% (GSA paper, Appendix "The Operating System", "Boot", 1d430b6: "the
%% services the app is configured with, its rendezvous servers and its
%% directory, each by key and address"): a rendezvous server, or the
%% directory.
Service ::= rendezvous(Key, String) ; directory(Key, String).
LinkAct  ::= invite_link ; open_link(SignedTerm)
           ; list(String, String, Visibility) ; unlist ; more(Integer).

%% A directory the operating system lists its person with, by its key and its
%% address, or none (GNA Section 7; core/links.glp); a listing's visibility
%% and the name it carries, a string or none (GNA Section 7: "Name a string
%% or none and Visibility listed or unlisted").
Directory  ::= directory(Key, String) ; none.
Visibility ::= listed ; unlisted.
DirName    ::= String ; none.

%% The super-app (GSA paper, Section 4.1 and Appendix "The Operating System"),
%% the entry the person's first act names (Appendix, "Boot": "the person's
%% first act names the entry, with the person's key, the keys of the persons
%% the person knows, none at a first start, and the rendezvous servers the
%% app is configured with, each by key and address"), superapp(Key, Known,
%% Services) below: with the person's public key, the keys of the persons
%% the person knows, the services the app is configured with, each
%% rendezvous(Key, Address) or directory(Key, Address) (Appendix, "Boot",
%% 1d430b6), the stream of the person's acts and the stream from the
%% network, and nothing else.  It runs agent/4 with the
%% operating system's Nearby and its invitation links around it (place.glp,
%% os_phone/8: the place, GPE, and the agents nearby the layer reports;
%% links.glp, Invite by link and the opening of a link, and List, List
%% unlisted and Unlist with the directory the services name), with the
%% super-app's own person interface (home/3) and its dispatcher between the
%% person and the agent, and sends what the agent tells the person to the
%% person and its messages to the network.  The person's acts are the grants of the person
%% channel (vGLP, Definition "Person Channel, Person Writer, GLP with Persons,
%% Grant"), ch(Grants?, Draws), which the dispatcher reads: home's asks go to
%% it, and it draws the constructs of home's questions.  What the agent tells
%% the person goes to her on the dispatcher's channel to the program, which
%% merges it with the draws, as miniapp.glp of programs/currencies/coins/
%% currency does with its screen; home reads the same stream, each message
%% whole, for a friend's request to connect and an introduction.  The draws leave by send_to_user/1, and the network
%% stream by send_to_net/1.
imported procedure home#home(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(HomeQuestion))).
imported procedure home#dispatch(Stream(Ask(HomeQuestion))?, PersonChannel(HomeDrawn)?, Channel(Stream(Input(HomeDrawn)), Stream(Output))).
imported procedure agent#agent(Key?, UserInStream?, NetInStream?, OutputsList?).
imported procedure place#os_phone(Key?, List(Key)?, List(RvServer)?, Directory?, UserInStream?, NetInStream?, AgentToUserStream, NetOutStream).
exported procedure superapp(Key?, List(Key)?, List(Service)?, PersonIn(HomeDrawn)?, NetInStream?).
superapp(Id, Known, Services, Grants, NetIn) :-
    ground(Id?), ground(Known?), ground(Services?) |
    servers_of(Services?, Servers),
    directory_of(Services?, Dir),
    place # os_phone(Id?, Known?, Servers?, Dir?, In?, NetIn?, Outs, NetOut),
    calendar(Dates),
    date_msgs(Id?, Dates?, DateMsgs),
    merge(Cmds?, DateMsgs?, In),
    send_to_net(NetOut?),
    split_out(Outs?, Shown, Seen),
    home # home(Id?, Seen?, Cmds, Asks),
    home # dispatch(Asks?, ch(Grants?, Draws), MCh),
    show_notices(MCh?, Shown?),
    send_to_user(Draws?).

%% link_phone(Id, Known, Services, Grants, NetIn): the operating system on
%% the layer (place.glp, os_phone/8), with the services Services, as the
%% super-app's first act names them, and a
%% scripted person on home (picking_home/6, picking none): yes on each card
%% of a request to connect or an introduction, and, as the person's acts,
%% the requests Invite by link, the opening of a link, List, List unlisted
%% and Unlist as they come on the person's grants, input(_, _, Request);
%% every notice goes to the person, the link made among them,
%% invitation(Link).  It is the play of GRV:2 and GRV:3 over the WAN
%% (networking/glue/test/rendezvous_server_test.dart): one phone invites by
%% link, the person reading the link off the notice, and another opens it.
procedure link_phone(Key?, List(Key)?, List(Service)?, Grants?, NetInStream?).
link_phone(Id, Known, Services, Grants, NetIn) :-
    ground(Id?), ground(Known?), ground(Services?) |
    servers_of(Services?, Servers),
    directory_of(Services?, Dir),
    place # os_phone(Id?, Known?, Servers?, Dir?, In?, NetIn?, Out, NetOut),
    send_to_net(NetOut?),
    picking_home(Id?, none, Out?, Notices, Script?, In),
    send_to_user(Notices?),
    link_acts(Id?, Grants?, Script).

%% link_acts(Id, Grants, Acts): the person's requests on invitation links,
%% each the act it puts on the person's stream; any other grant is not read.
procedure link_acts(Key?, Grants?, UserInStream).
link_acts(Id, [input(_, _, invite_link) | Gs], [msg(person, Id?, invite_link) | As?]) :-
    ground(Id?) | link_acts(Id?, Gs?, As).
link_acts(Id, [input(_, _, open_link(L)) | Gs], [msg(person, Id?, open_link(L?)) | As?]) :-
    ground(Id?), ground(L?) | link_acts(Id?, Gs?, As).
link_acts(Id, [input(_, _, list(E, N)) | Gs], [msg(person, Id?, list(E?, N?)) | As?]) :-
    ground(Id?), ground(E?), ground(N?) | link_acts(Id?, Gs?, As).
link_acts(Id, [input(_, _, list_unlisted(E, N)) | Gs], [msg(person, Id?, list_unlisted(E?, N?)) | As?]) :-
    ground(Id?), ground(E?), ground(N?) | link_acts(Id?, Gs?, As).
link_acts(Id, [input(_, _, unlist) | Gs], [msg(person, Id?, unlist) | As?]) :-
    ground(Id?) | link_acts(Id?, Gs?, As).
link_acts(Id, [_ | Gs], As?) :- otherwise | link_acts(Id?, Gs?, As).
link_acts(_, [], []).

%% servers_of(Services, Servers): the rendezvous servers the services name, in
%% their order.
procedure servers_of(List(Service)?, List(RvServer)).
servers_of([rendezvous(K, A) | Ss], [rendezvous(K?, A?) | Rs?]) :- servers_of(Ss?, Rs).
servers_of([directory(_, _) | Ss], Rs?) :- servers_of(Ss?, Rs).
servers_of([], []).

%% directory_of(Services, Dir): the directory the services name, the first
%% where they name several, or none.
procedure directory_of(List(Service)?, Directory).
directory_of([directory(K, A) | _], directory(K?, A?)).
directory_of([rendezvous(_, _) | Ss], D?) :- directory_of(Ss?, D).
directory_of([], none).

%% What the agent tells the person, split: each message whole to the person
%% interface, and its notice to the person.  A message is never copied whole:
%% the pending value of a befriending or an introduction holds the agent's
%% consent writer, which home's card answers, and which one reader alone may
%% hold; until it is answered the message is not ground, so a copy of it
%% would wait for the very answer it carries the card for.  superapp/4 above
%% and superapp_ui/4 (home_ui.glp) reach it by scope.
procedure split_out(AgentToUserStream?, Stream(Output), AgentToUserStream).
split_out([M | Ms], [N? | Ns?], [M1? | Seen?]) :- notice(M?, N, M1), split_out(Ms?, Ns, Seen).
split_out([], [], []).

%% A scripted person on the super-app's person interface (home.vglp), for
%% the plays (superapp_plays.glp, home_ui.glp, ../play_ui_boot.glp): what the
%% agent tells the person is split by split_out/3, each message whole to home,
%% which raises the card of a friend's request to connect and of an
%% introduction, and its notice to the person's script; the script's commands
%% and home's reach the agent merged; and the person, scripted on what the
%% dispatcher draws, answers yes on each card.  A notice informs; a consent is
%% asked by home's card only, and no play answers off a notice (GSG,
%% 2026-10-14 09:24 UTC, item 1, and 11:38 UTC).
exported procedure scripted_home(Key?, AgentToUserStream?, Stream(Output), UserInStream?, UserInStream).
scripted_home(Id, Out, Notices?, ScriptCmds, In?) :-
    ground(Id?) |
    split_out(Out?, Notices, Seen),
    home # home(Id?, Seen?, Home, Asks),
    home # dispatch(Asks?, ch(Grants?, Draws), MCh),
    hold_output(MCh?),
    yes_person(Draws?, Grants),
    merge(ScriptCmds?, Home?, In).

%% The program's output to the person: the notices go to the script instead.
procedure hold_output(Channel(Stream(_), Stream(Output))?).
hold_output(ch(_, [])).

%% The person: yes on each card, a friend's request to connect or an
%% introduction, at the path of its decision, once the card is drawn with it.
%% The person channel never closes, so the person holds its grant writer for
%% good.
procedure yes_person(_?, PersonIn(HomeDrawn)).
yes_person([draw(N, _, friendRequest_w(from(_, input(Q)))) | Ds], [input(N?, Q?, yes) | Gs?]) :-
    ground(N?), ground(Q?) | yes_person(Ds?, Gs).
yes_person([draw(N, _, introRequest_w(approval(_, _, input(Q)))) | Ds], [input(N?, Q?, yes) | Gs?]) :-
    ground(N?), ground(Q?) | yes_person(Ds?, Gs).
yes_person([_ | Ds], Gs?) :- otherwise | yes_person(Ds?, Gs).

%% scripted_home/5 with a person who also befriends by picking a person in
%% Nearby (GSA paper, Appendix "The Operating System", "Nearby": "the person
%% befriends one by picking them there"; home.vglp, befriend_card/3), for the
%% plays of physical encounters (superapp_plays.glp, nearby_phone/4): under
%% Pick first the person picks befriend on the first card of a person nearby
%% that home draws, and on none after it; under none on none.  The person
%% answers yes on each card of a friend's request to connect and of an
%% introduction, as yes_person/2 does.  Under Pick introduce the person picks
%% introduce on the first card of two friends that home draws (GKK's pragma
%% Introduction, "Alice [Introduce]"), and on none after it.
PickMode ::= first ; none ; introduce.
exported procedure picking_home(Key?, PickMode?, AgentToUserStream?, Stream(Output), UserInStream?, UserInStream).
picking_home(Id, Pick, Out, Notices?, ScriptCmds, In?) :-
    ground(Id?) |
    split_out(Out?, Notices, Seen),
    home # home(Id?, Seen?, Home, Asks),
    home # dispatch(Asks?, ch(Grants?, Draws), MCh),
    hold_output(MCh?),
    picking_person(Pick?, Draws?, Grants),
    merge(ScriptCmds?, Home?, In).

%% The person: yes on each card of a friend's request or an introduction;
%% befriend on the first card of a person nearby, under first.  The person
%% channel never closes, so the person holds its grant writer for good.
procedure picking_person(PickMode?, PersonOut(HomeDrawn)?, PersonIn(HomeDrawn)).
picking_person(P, [draw(N, _, friendRequest_w(from(_, input(Q)))) | Ds], [input(N?, Q?, yes) | Gs?]) :-
    ground(N?), ground(Q?) | picking_person(P?, Ds?, Gs).
picking_person(P, [draw(N, _, introRequest_w(approval(_, _, input(Q)))) | Ds], [input(N?, Q?, yes) | Gs?]) :-
    ground(N?), ground(Q?) | picking_person(P?, Ds?, Gs).
picking_person(first, [draw(N, _, nearbyPerson_w(nearby(_, input(Q)))) | Ds], [input(N?, Q?, befriend) | Gs?]) :-
    ground(N?), ground(Q?) | picking_person(none, Ds?, Gs).
picking_person(introduce, [draw(N, _, introduction_w(introduction(_, _, input(Q)))) | Ds], [input(N?, Q?, introduce) | Gs?]) :-
    ground(N?), ground(Q?) | picking_person(none, Ds?, Gs).
picking_person(P, [_ | Ds], Gs?) :- otherwise | picking_person(P?, Ds?, Gs).

%% play_home(Id?, Answer?, Notices?, Cmds, Log): home/4 on the agent's notices,
%% with its dispatcher, and a person who answers each card, a friend's request
%% to connect or an introduction, with Answer once it is drawn, or, where
%% Answer is befriend, picks befriend on each card of a person nearby, or,
%% where Answer is introduce, introduce on each card of two friends, logging
%% the card it answered; the commands home writes to the agent come out on Cmds.
%% The person grants only on a card drawn: the dispatcher takes the asks, the
%% grants and the draws in turn (programs/vglp/dispatcher.glp, fair/5), and a
%% grant for a construct not yet asked reaches none.
exported procedure play_home(Key?, HomeDrawn?, AgentToUserStream?, Stream(UserInMsg), Stream(_)).
play_home(Id, Ans, Notices, Cmds?, Log?) :-
    ground(Id?) |
    home # home(Id?, Notices?, Cmds, Asks),
    home # dispatch(Asks?, ch(Grants?, Draws), _),
    answering(Ans?, Draws?, Grants, Log).

procedure answering(HomeDrawn?, _?, PersonIn(HomeDrawn), Stream(_)).
answering(A, [draw(N, _, friendRequest_w(from(F, input(Q)))) | Ds], [input(N?, Q?, A?) | Gs?], [card(F?) | Log?]) :-
    ground(A?), ground(N?), ground(F?), ground(Q?) | answering(A?, Ds?, Gs, Log).
answering(A, [draw(N, _, introRequest_w(approval(intro(I, F), _, input(Q)))) | Ds], [input(N?, Q?, A?) | Gs?], [card(I?, F?) | Log?]) :-
    ground(A?), ground(N?), ground(I?), ground(F?), ground(Q?) | answering(A?, Ds?, Gs, Log).
answering(befriend, [draw(N, _, nearbyPerson_w(nearby(F, input(Q)))) | Ds], [input(N?, Q?, befriend) | Gs?], [nearby(F?) | Log?]) :-
    ground(N?), ground(F?), ground(Q?) | answering(befriend, Ds?, Gs, Log).
answering(introduce, [draw(N, _, introduction_w(introduction(P, K, input(Q)))) | Ds], [input(N?, Q?, introduce) | Gs?], [introduction(P?, K?) | Log?]) :-
    ground(N?), ground(P?), ground(K?), ground(Q?) | answering(introduce, Ds?, Gs, Log).
answering(A, [_ | Ds], Gs?, Log?) :- otherwise | answering(A?, Ds?, Gs, Log).

%% The super-app's output to its person, of the reserved type Output: "A
%% vGLP program declares the type of its output to its person by defining
%% the type Output, a reserved name; the dispatcher draws that output as a
%% thread whose elements are drawn by the widget of Output" (vGLP 169b008,
%% Definition "Canonical Compilation").  A notice informs: it is what the
%% agent tells the person, AgentContent, with the pending value of a
%% befriending dropped, its consent asked by home's own card,
%% FriendRequest ::= from(Friend, Decision?), and nowhere else (GSG,
%% 2026-10-13 20:16 UTC, Udi: yes); befriend_intro likewise, its consent
%% asked by home's card IntroRequest ::= approval(intro(Introducer, Other), Words, Decision?)
%% (GSG, 2026-10-14 09:24 UTC, item 1).
Notice ::= msg(Constant, Constant, NoticeContent).
NoticeContent ::= befriend(Key)
                ; befriend_intro(Key, Key)
                ; invitation(SignedTerm)
                ; verify(String)
                ; listed(String)
                ; connected(Key)
                ; rejected
                ; rejected(Constant)
                ; unfriended(Constant)
                ; received(Key, Constant)
                ; not_a_friend(Key)
                ; nearby(List(Key)).
Output ::= Notice.

%% The notices, onto the program's output to the person; the person's input
%% other than grants is not read.  superapp_ui/4 reaches it by scope.
procedure show_notices(Channel(Stream(_), Stream(Output))?, Stream(Output)?).
show_notices(ch(_, Out?), Shown) :- relay(Shown?, Out).

%% Each notice as it comes.
procedure relay(Stream(Output)?, Stream(Output)).
relay([N | Ns], [N? | Out?]) :- relay(Ns?, Out).
relay([], []).

%% The notice of a message the agent tells the person, and the message, whole,
%% for the person interface: the pending value goes with the message alone.
procedure notice(AgentToUserMsg?, Notice, AgentToUserMsg).
notice(msg(A, P, befriend(K, V)), msg(A?, P?, befriend(K?)), msg(A?, P?, befriend(K?, V?))) :-
    ground(A?), ground(P?), ground(K?) | true.
notice(msg(A, P, befriend_intro(C, K, V)), msg(A?, P?, befriend_intro(C?, K?)), msg(A?, P?, befriend_intro(C?, K?, V?))) :-
    ground(A?), ground(P?), ground(C?), ground(K?) | true.
notice(msg(A, P, connected(C)), msg(A?, P?, connected(C?)), msg(A?, P?, connected(C?))) :-
    ground(A?), ground(P?), ground(C?) | true.
notice(msg(A, P, rejected), msg(A?, P?, rejected), msg(A?, P?, rejected)) :-
    ground(A?), ground(P?) | true.
notice(msg(A, P, rejected(C)), msg(A?, P?, rejected(C?)), msg(A?, P?, rejected(C?))) :-
    ground(A?), ground(P?), ground(C?) | true.
notice(msg(A, P, unfriended(C)), msg(A?, P?, unfriended(C?)), msg(A?, P?, unfriended(C?))) :-
    ground(A?), ground(P?), ground(C?) | true.
notice(msg(A, P, received(K, C)), msg(A?, P?, received(K?, C?)), msg(A?, P?, received(K?, C?))) :-
    ground(A?), ground(P?), ground(K?), ground(C?) | true.
notice(msg(A, P, not_a_friend(K)), msg(A?, P?, not_a_friend(K?)), msg(A?, P?, not_a_friend(K?))) :-
    ground(A?), ground(P?), ground(K?) | true.
notice(msg(A, P, nearby(Ks)), msg(A?, P?, nearby(Ks?)), msg(A?, P?, nearby(Ks?))) :-
    ground(A?), ground(P?), ground(Ks?) | true.
notice(msg(A, P, invitation(L)), msg(A?, P?, invitation(L?)), msg(A?, P?, invitation(L?))) :-
    ground(A?), ground(P?), ground(L?) | true.
notice(msg(A, P, verify(E)), msg(A?, P?, verify(E?)), msg(A?, P?, verify(E?))) :-
    ground(A?), ground(P?), ground(E?) | true.
notice(msg(A, P, listed(E)), msg(A?, P?, listed(E?)), msg(A?, P?, listed(E?))) :-
    ground(A?), ground(P?), ground(E?) | true.

%% The person's end of a mini-app's person channel that no screen shows ---
%% a re-idled mini-app's fresh one (agent.glp, app_idle/3), or one a play
%% installs a mini-app with and does not watch.  The person channel never
%% ends in either direction (vGLP, Section 6.3; vGLP 2026-10-14 21:48 UTC):
%% the draws are read for good, the grant writer passed on, no person
%% granting on it, and the goal suspends when no draw comes.  agent.glp and
%% superapp_plays.glp reach it by scope.
procedure hold_person(Channel(PersonOut(Opaque), PersonIn(Opaque))?).
hold_person(ch([_ | Ds], Gs?)) :- hold_person(ch(Ds?, Gs)).

%% calendar(Dates): the dates of the device's clock, one a day: today's, the
%% day since the Unix epoch the runtime's clock now/1 reads, at once, and each
%% next one at the start of its day (GSG paper, Section 3, "What the super-app
%% grants a mini-app": "a calendar, a stream of dates the super-app writes
%% from the smartphone's clock, one a day"; GB appendix-derivation.tex: "on a
%% device the clock writes it").  superapp/4 gives each to the agent, which
%% writes it on the calendar of every mini-app installed; a play gives the
%% agent its dates from its script instead.
procedure calendar(Stream(Integer)).
calendar(Cal?) :- now(T), D := T? // 86400000, dates(D?, Cal).

procedure dates(Integer?, Stream(Integer)).
dates(D, [D? | Cal?]) :- N := (D? + 1) * 86400000, next_date(N?, D?, Cal).

procedure next_date(Integer?, Integer?, Stream(Integer)).
next_date(N, D, Cal?) :- wait_until(N?) | D1 := D? + 1, dates(D1?, Cal).

%% date_msgs(Id, Dates, Msgs): each date the person's act date(D) to the agent.
procedure date_msgs(Key?, Stream(Integer)?, UserInStream).
date_msgs(Id, [D | Ds], [msg(person, Id?, date(D?)) | Ms?]) :-
    ground(Id?), integer(D?) | date_msgs(Id?, Ds?, Ms).
date_msgs(_, [], []).

%% The agent, exported for the parent's UI boot plays (../boot.glp,
%% ../play_ui_boot.glp), which call it as core # agent: a call into this
%% directory resolves only to what this file exports (TGLP, Section "Module
%% System", External access).
exported procedure agent(Key?, UserInStream?, NetInStream?, OutputsList?).
agent(Id, UserIn, NetIn, Outs) :- agent # agent(Id?, UserIn?, NetIn?, Outs?).

%% The term an attestation signs, attest(Id, Other) (agent.glp, the
%% attestation of Section 5.5), as play_attest/6 takes it apart, or the
%% constant unsigned where the attestation is not a signed term.
Attestation ::= attest(Key, Key) ; unsigned.

%% route_to(K, Net, Mine, Rest): the network messages Net of the agents of a
%% play in one heap, those addressed to the agent K on Mine, its network
%% input, and the rest on Rest, for the next agent's route_to/4; the network
%% of a play is a chain of them, one for each agent, by its key.
procedure route_to(Key?, NetOutStream?, NetInStream, NetOutStream).
route_to(K, [msg(D, C) | Ms], [msg(D?, C?) | Mine?], Rest?) :-
    D? =?= K? | route_to(K?, Ms?, Mine, Rest).
route_to(K, [msg(D, C) | Ms], Mine?, [msg(D?, C?) | Rest?]) :-
    otherwise | route_to(K?, Ms?, Mine, Rest).
route_to(_, [], [], []).

%% The super-app as a play, the person with a scripted peer for each key the
%% person knows: what the Flutter agent runtime starts (home_ui.glp).
imported procedure home_ui#superapp_ui(Key?, List(Key)?, PersonIn(HomeDrawn)?, NetInStream?).
exported procedure superapp_ui(Key?, List(Key)?, PersonIn(HomeDrawn)?, NetInStream?).
superapp_ui(Id, Peers, Grants, NetIn) :- home_ui # superapp_ui(Id?, Peers?, Grants?, NetIn?).

%% The plays of superapp_plays.glp, each given the keys of its two agents,
%% the first the inviter's or the caller's and the second the other's.
imported procedure superapp_plays#play_invite(Key?, Key?, Stream(Opaque), Stream(Opaque)).
exported procedure play_invite(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_invite(P, Q, A?, B?) :- superapp_plays # play_invite(P?, Q?, A, B).

