exported procedure play_attest(Key?, Key?, String, String, String, Attestation).
play_attest(P, Q, S?, K?, H?, T?) :- superapp_plays # play_attest(P?, Q?, S, K, H, T).

imported procedure superapp_plays#play_both_ways(Key?, Key?, Stream(AgentContent), Stream(AgentContent)).
exported procedure play_both_ways(Key?, Key?, Stream(AgentContent), Stream(AgentContent)).
