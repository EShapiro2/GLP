%% superapp_plays.glp --- distribution with an invitation, the handshake,
%% activation by run/3 with the three grants, and the attestation (GSG paper,
%% Sections 3, 4, 5.5 and 6), played by two social-graph agents in one heap,
%% the network a two-way crossbar for cold calls, and under :boot
%% (../../superapp_boot.glp) by two isolates with their own keys.  The
%% certified mini-apps are GSG's ../pingapp and ../endapp, Currencies'
%% currency and denominated, and CSSN's childsafe; the super-app reads their
%% artefacts with load_file/2.  The persons are scripted on the agents'
%% person streams.
%%
%% The super-app holds no declaration of a mini-app's types.  A play mints a
%% mini-app's person channel at Opaque, installs the mini-app with one end and
%% hands the other to the mini-app's own scripted person, the instance at the
%% mini-app's type of the second template miniapp_person/4, activated from the
%% same module value as the entry (miniapp_person_run/5); the screen it reports
%% comes back to the caller at Opaque, or, under :boot, goes to the person
%% (GSG, 2026-10-13 18:52 UTC, O5, Udi: approved).  A play never inspects
%% what a screen carries: it passes it on, and reads only that an item came
%% or that the screen closed.

imported procedure agent#agent(Key?, UserInStream?, NetInStream?, OutputsList?).
imported procedure home#home(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(HomeQuestion))).
imported procedure home#dispatch(Stream(Ask(HomeQuestion))?, PersonChannel(HomeDrawn)?, Channel(Stream(_), Stream(Output))).

procedure crossbar2(NetOutStream?, NetOutStream?, NetInStream, NetInStream).
crossbar2(AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route2(All?, AIn, BIn).

procedure route2(NetOutStream?, NetInStream, NetInStream).
route2([msg(alice, C) | Rest], [msg(alice, C?) | A?], B?) :- route2(Rest?, A, B).
route2([msg(bob, C) | Rest], A?, [msg(bob, C?) | B?]) :- route2(Rest?, A, B).
route2([], [], []).

procedure(X) tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

%% miniapp_person_run(M, Id, Role, PEnd, Screen): the mini-app M's scripted
%% person activated, from the module value, by run/3 at the type identity of
%% the second template's opaque instance at the type its exports record for
%% miniapp_person/4, as the agent activates the entry (agent.glp,
%% activate/6), on the person's end PEnd of the person channel whose other end
%% the play installs the mini-app with; Screen the screen it reports, at
%% Opaque.  The play mints the channel and hands its two ends to two
%% activations of one module value, so it checks that the module records the
%% entry's person-channel type and the person's at one type, the first of the
%% entry's two identities and the person's one (TGLP modules.tex, "The
%% invitation discipline": "opaque_type yields one identity for the two
%% entries, which the host checks"; GLP, 2026-10-13 20:22 UTC, C; vGLP
%% 2026-10-14 13:21 UTC, S2).  Where they are not, no person runs: its end of
%% the person channel is held for good (hold_person/1) and its screen is empty.
procedure miniapp_person_run(Content?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/4, M?, H0),
    opaque_type(miniapp_person/4, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D], M, Id, Role, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/4, [D?], T),
    run(miniapp_person(Id?, Role?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

%% The certified mini-app: pingapp.glpw beside this program, written by the
%% REPL's :artefact from ../pingapp and read with load_file/2 --- a Module
%% where its certificate verifies, its text otherwise.  certified/4 gives the
%% module, the compiler's key its certificate carries, and the creator's
%% certification, signed here over its source identity, the contract's two act
%% schemas and the checker's verdict.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], grassroots), K?, CSig).

%% =============================================================================
%% play_invite: alice installs the mini-app, befriends bob and invites him;
%% bob installs it and consents; the handshake opens the root channel and the
%% two executions greet each other.  Each person's screen is the mini-app's
%% scripted person's, under its role greet, which stops at the greeting.
%% Expected: AliceUi = [opened(bob), greeted(bob)], BobUi = [opened(alice),
%% greeted(alice)], → succeeds.
%% =============================================================================
exported procedure play_invite(Stream(Opaque), Stream(Opaque)).
play_invite(AliceUi?, BobUi?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, alice, greet, AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_person(C?, CSig?, yes, AliceApp?, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, bob, greet, BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(C?, CSig?, yes, BobApp?, BobOut?, BobSeen?, BobIn).

%% =============================================================================
%% play_invite_declined: as above, but bob's person declines; no conversation
%% opens and neither execution is activated, so neither person's screen
%% shows an item; the person channel never ends (vGLP, Section 6.3), so
%% neither screen closes either.
%% Expected: AliceUi and BobUi unbound, → suspended.
%% =============================================================================
exported procedure play_invite_declined(Stream(Opaque), Stream(Opaque)).
play_invite_declined(AliceUi?, BobUi?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, alice, greet, AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_person(C?, CSig?, no, AliceApp?, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, bob, greet, BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(C?, CSig?, no, BobApp?, BobOut?, BobSeen?, BobIn).

%% Alice's person: install the mini-app, with its end of the person channel,
%% cold-call bob, and once connected invite him.  Wait = yes: keep the person stream open until
%% the mini-app's person has seen her execution greeted, its screen closing;
%% no: close it after inviting.
procedure alice_person(Content?, String?, Decision?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_person(M, CSig, Wait, Ui, Outs, Seen,
             [msg(person, alice, install(ping, M?, CSig?, Ui?)),
              msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_wait(Wait?, Outs?, Seen?, Cmds).

procedure alice_wait(Decision?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_wait(yes, [msg(agent, person, connected(bob)) | _], Seen,
           [msg(person, alice, invite(ping, bob)) | Cmds?]) :-
    person_done(Seen?, Cmds).
alice_wait(no, [msg(agent, person, connected(bob)) | _], _,
           [msg(person, alice, invite(ping, bob))]).
alice_wait(W, [_ | Outs], Seen, Cmds?) :- otherwise | alice_wait(W?, Outs?, Seen?, Cmds).
alice_wait(_, [], _, []).

%% Close the person stream once the mini-app's screen has closed: under the
%% role greet its person stops at the greeting (../pingapp/person.glp), and
%% the screen closes too where the mini-app ends.  The screen's items are
%% passed over, never inspected.
procedure person_done(Stream(Opaque)?, UserInStream).
person_done([_ | Seen], Cmds?) :- person_done(Seen?, Cmds).
person_done([], []).

%% Bob's person: install the mini-app and give (or refuse) consent before the
%% offer arrives; answer alice's cold call; then wait for the mini-app's
%% screen to close, or close.
procedure bob_person(Content?, String?, Decision?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_person(M, CSig, yes, Ui, Outs, Seen,
           [msg(person, bob, install(ping, M?, CSig?, Ui?)),
            msg(person, bob, accept_invite(ping, alice)) | Cmds?]) :-
    bob_wait(yes, Outs?, Seen?, Cmds).
bob_person(M, CSig, no, Ui, Outs, Seen,
           [msg(person, bob, install(ping, M?, CSig?, Ui?)),
            msg(person, bob, decline_invite(ping, alice)) | Cmds?]) :-
    bob_wait(no, Outs?, Seen?, Cmds).

procedure bob_wait(Decision?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_wait(yes, [msg(agent, person, befriend(alice, P)) | _], Seen,
         [msg(person, bob, decision(yes, alice, P?)) | Cmds?]) :-
    person_done(Seen?, Cmds).
bob_wait(no, [msg(agent, person, befriend(alice, P)) | _], _,
         [msg(person, bob, decision(yes, alice, P?))]).
bob_wait(W, [_ | Outs], Seen, Cmds?) :- otherwise | bob_wait(W?, Outs?, Seen?, Cmds).
bob_wait(_, [], _, []).

%% =============================================================================
%% play_attest: alice and bob befriend; alice reads back the attestation her
%% social graph minted at the commit, and the play takes it apart.
%% Expected: T = attest(alice, bob), K the person's key, H this program's
%% source identity, → succeeds.
%% =============================================================================
exported procedure play_attest(String, String, String, _).
play_attest(S?, K?, H?, T?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_attest(AliceOut?, S, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_answer(BobOut?, BobIn),
    signature(S?, Sg),
    attested(Sg?, K, H, T).

%% attested(Sg, K, H, T): the attestation taken apart, the play matching
%% signed(K, H, T) and exercising no refusal; the unsigned clause, which the
%% checker requires of every alternative of Signature, assigns the three the
%% constant unsigned, and the play's checks never reach it.
procedure attested(Signature?, String, String, _).
attested(signed(K, H, T), K?, H?, T?).
attested(unsigned, unsigned, unsigned, unsigned).

procedure alice_attest(AgentToUserStream?, String, UserInStream).
alice_attest(Outs, S?, [msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_attest_wait(Outs?, S, Cmds).

procedure alice_attest_wait(AgentToUserStream?, String, UserInStream).
alice_attest_wait([msg(agent, person, connected(bob)) | _], S?,
                  [msg(person, alice, attestation(bob, S))]).
alice_attest_wait([_ | Outs], S?, Cmds?) :- otherwise | alice_attest_wait(Outs?, S, Cmds).
alice_attest_wait([], none, []).

procedure bob_answer(AgentToUserStream?, UserInStream).
bob_answer([msg(agent, person, befriend(alice, P)) | _],
           [msg(person, bob, decision(yes, alice, P?))]).
bob_answer([_ | Outs], Cmds?) :- otherwise | bob_answer(Outs?, Cmds).
bob_answer([], []).

%% =============================================================================
%% play_both_ways: alice and bob cold-call each other at once, and each person
%% consents to the other's call (GSG Section 5.1; 2026-10-02 task, item 5).
%% Two befriendings of the same two people are under way at once, and alice,
%% the smaller identity, proposes in both: she mints the friend channel for
%% the first whose consent she reads and conveys already_friends for the
%% other, so each agent ends with one friend channel --- and each person is
%% told connected once, which convey/7 and adopt/6 tell where they install
%% one.  The persons stand at the end, their streams open, so what each was
%% told is the whole of it at quiescence.
%% Expected: A = [connected(bob) | _], B = [connected(alice) | _],
%% → suspended.
%% =============================================================================
exported procedure play_both_ways(Stream(AgentContent), Stream(AgentContent)).
play_both_ways(A?, B?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    both_ways_person(alice, bob, AliceOut?, A, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    both_ways_person(bob, alice, BobOut?, B, BobIn).

%% A person who cold-calls the other and consents to the other's call, the
%% pending value passed back as it came; what the agent tells it of a
%% befriending's outcome, connected or rejected, is what it saw.
procedure both_ways_person(Key?, Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
both_ways_person(Me, Other, Outs, Seen?, [msg(person, Me?, connect(Other?)) | Cmds?]) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).

procedure both_ways_answer(Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
both_ways_answer(Me, [msg(agent, person, befriend(From, P)) | Outs], Seen?,
                 [msg(person, Me?, decision(yes, From?, P?)) | Cmds?]) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?], Cmds?) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [msg(agent, person, rejected(F)) | Outs], [rejected(F?) | Seen?], Cmds?) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [_ | Outs], Seen?, Cmds?) :-
    otherwise | both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(_, [], [], []).

%% =============================================================================
%% play_not_a_friend: a message the person addresses to someone who is not
%% their friend is not sent, and the agent tells the person so (GSG Section
%% 5.1; GSG 2026-10-09 18:48 UTC).  Alice's person sends bob a message before
%% either has called the other, and is told not_a_friend(bob).  Bob's person
%% calls alice --- bob, the larger identity, accepts, his call his consent ---
%% and sends her a message at once, between his acceptance and the
%% conveyance, and is told not_a_friend(alice).  Alice's person consents to
%% bob's call only once bob was told, so his send precedes the conveyance by
%% causality and not by scheduling.  Alice, the proposer, mints the friend
%% channel and conveys it; each person is told connected, and bob's person,
%% told connected(alice), sends her a message again, which reaches her.  The
%% persons stand at the end, their streams open.
%% Expected: A = [not_a_friend(bob), connected(bob), received(bob, hello) | _],
%% B = [not_a_friend(alice), connected(alice) | _], → suspended.
%% =============================================================================
exported procedure play_not_a_friend(Stream(AgentContent), Stream(AgentContent)).
play_not_a_friend(A?, B?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    naf_alice(AliceOut?, Told?, A, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    naf_bob(BobOut?, B, Told, BobIn).

%% Alice's person sends bob a message, and consents to bob's call once bob
%% was told not_a_friend(alice), the pending value passed back as it came.
procedure naf_alice(AgentToUserStream?, Constant?, Stream(AgentContent), UserInStream).
naf_alice(Outs, Told, Seen?, [msg(person, alice, send(bob, hi)) | Cmds?]) :-
    naf_alice_wait(Outs?, Told?, Seen, Cmds).

procedure naf_alice_wait(AgentToUserStream?, Constant?, Stream(AgentContent), UserInStream).
naf_alice_wait([msg(agent, person, not_a_friend(F)) | Outs], Told, [not_a_friend(F?) | Seen?], Cmds?) :-
    naf_alice_wait(Outs?, Told?, Seen, Cmds).
naf_alice_wait([msg(agent, person, befriend(From, P)) | Outs], told, Seen?,
               [msg(person, alice, decision(yes, From?, P?)) | Cmds?]) :-
    naf_record(Outs?, Seen, Cmds).
naf_alice_wait([_ | Outs], Told, Seen?, Cmds?) :-
    otherwise | naf_alice_wait(Outs?, Told?, Seen, Cmds).
naf_alice_wait([], _, [], []).

%% Bob's person calls alice and sends her a message at once; told
%% not_a_friend(alice), it lets alice's person consent, and told
%% connected(alice), it sends her a message again.
procedure naf_bob(AgentToUserStream?, Stream(AgentContent), Constant, UserInStream).
naf_bob(Outs, Seen?, Told?,
        [msg(person, bob, connect(alice)), msg(person, bob, send(alice, hi)) | Cmds?]) :-
    naf_bob_wait(Outs?, Seen, Told, Cmds).

procedure naf_bob_wait(AgentToUserStream?, Stream(AgentContent), Constant, UserInStream).
naf_bob_wait([msg(agent, person, not_a_friend(F)) | Outs], [not_a_friend(F?) | Seen?], told, Cmds?) :-
    naf_bob_friend(Outs?, Seen, Cmds).
naf_bob_wait([_ | Outs], Seen?, Told?, Cmds?) :-
    otherwise | naf_bob_wait(Outs?, Seen, Told, Cmds).
naf_bob_wait([], [], untold, []).

procedure naf_bob_friend(AgentToUserStream?, Stream(AgentContent), UserInStream).
naf_bob_friend([msg(agent, person, connected(alice)) | Outs], [connected(alice) | Seen?],
               [msg(person, bob, send(alice, hello)) | Cmds?]) :-
    naf_record(Outs?, Seen, Cmds).
naf_bob_friend([_ | Outs], Seen?, Cmds?) :-
    otherwise | naf_bob_friend(Outs?, Seen, Cmds).
naf_bob_friend([], [], []).

%% What a person is told of a send and of a befriending, recorded.
procedure naf_record(AgentToUserStream?, Stream(AgentContent), UserInStream).
naf_record([msg(agent, person, not_a_friend(F)) | Outs], [not_a_friend(F?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([msg(agent, person, received(F, T)) | Outs], [received(F?, T?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([_ | Outs], Seen?, Cmds?) :-
    otherwise | naf_record(Outs?, Seen, Cmds).
naf_record([], [], []).

%% =============================================================================
%% play_invite_timed(Ms): play_invite, timed --- the milliseconds from the
%% moment alice's person sends the invitation to the moment the root
%% channel's end reaches bob's execution of the mini-app: the first item on
%% its screen, its opened/1 (../pingapp/miniapp.glp), read as an item come and
%% not inspected; the clock is now/1, in milliseconds.
%% =============================================================================
exported procedure play_invite_timed(Integer).
play_invite_timed(Ms?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, alice, greet, AlicePerson?, AliceSeen),
    alice_person_timed(C?, CSig?, AliceApp?, AliceOut?, AliceSeen?, T0, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, bob, greet, BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(C?, CSig?, yes, BobApp?, BobOut?, BobSeen?, BobIn),
    opened_at(BobUi?, T0?, Ms).

procedure(X) sink(Stream(X)?).
sink([_ | Xs]) :- sink(Xs?).
sink([]).

%% Alice's person as in play_invite, reading the clock as she sends the
%% invitation.
procedure alice_person_timed(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Integer, UserInStream).
alice_person_timed(M, CSig, Ui, Outs, Seen, T0?,
                   [msg(person, alice, install(ping, M?, CSig?, Ui?)),
                    msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_wait_timed(Outs?, Seen?, T0, Cmds).

procedure alice_wait_timed(AgentToUserStream?, Stream(Opaque)?, Integer, UserInStream).
alice_wait_timed([msg(agent, person, connected(bob)) | _], Seen, T0?,
                 [msg(person, alice, invite(ping, bob)) | Cmds?]) :-
    now(T0),
    person_done(Seen?, Cmds).
alice_wait_timed([_ | Outs], Seen, T0?, Cmds?) :- otherwise | alice_wait_timed(Outs?, Seen?, T0, Cmds).
alice_wait_timed([], _, 0, []).

%% opened_at(Ui, T0, Ms): the clock at the first item on bob's screen, his
%% opened/1, less T0.
procedure opened_at(Stream(Opaque)?, Integer?, Integer).
opened_at([_ | _], T0, Ms?) :- now(T1), Ms := T1? - T0?.
opened_at([], _, 0).

%% =============================================================================
%% sg_init(Id, Role, NetIn): one super-app per isolate under :boot
%% (../../superapp_boot.glp): the social graph's agent on the isolate's network, the
%% mini-app read from the artefact beside this program and installed under the
%% compiler's key the person trusts, and the person's script by Role --- alice
%% invites, bob consents.  What the mini-app shows its person goes to the
%% person (send_to_user/1), printed by the harness as [agent] term.
%% =============================================================================
procedure alice_person_boot(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_person_boot(M, CK, CSig, Ui, Outs, Seen,
                  [msg(person, alice, trust(CK?)),
                   msg(person, alice, install(ping, M?, CSig?, Ui?)),
                   msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_wait(yes, Outs?, Seen?, Cmds).

procedure bob_person_boot(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_person_boot(M, CK, CSig, Ui, Outs, Seen,
                [msg(person, bob, trust(CK?)),
                 msg(person, bob, install(ping, M?, CSig?, Ui?)),
                 msg(person, bob, accept_invite(ping, alice)) | Cmds?]) :-
    bob_wait(yes, Outs?, Seen?, Cmds).

%% =============================================================================
%% play_load(Name, Kind, Key): what load_file/2 makes of an artefact beside
%% this program --- module, with the compiler's key its certificate carries,
%% or text, with none (the artefact of a program refused a certificate).
%% =============================================================================
exported procedure play_load(String?, Constant, String).
play_load(N, Kind?, K?) :-
    load_file(N?, C),
    loaded(C?, Kind, K).

procedure loaded(Content?, Constant, String).
loaded(M, module, K?) :- module(M?) | decompose_module(M?, K, _, _).
loaded(S, text, none) :- string(S?) | true.

%% =============================================================================
%% play_install(Name, App, Installed): the super-app installs, as mini-app App,
%% the artefact Name beside this program --- what load_file/2 gave, the
%% creator's certification the play signs over its source identity where it is
%% a Module --- and reports which mini-apps are installed afterwards: [App]
%% for a certified artefact, [] for one refused a certificate (load_file/2
%% gives its text, and the super-app installs no text).
%% =============================================================================
exported procedure play_install(String?, Constant?, Stream(Constant)).
play_install(N, App, Installed?) :-
    load_file(N?, C),
    certified_or_not(C?, CSig),
    new_channel(Ui, Person),
    agent # agent(alice, [msg(person, alice, install(App?, C?, CSig?, Ui?)),
                          msg(person, alice, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

procedure certified_or_not(Content?, String).
certified_or_not(M, CSig?) :- module(M?) | certified(M?, _, CSig).
certified_or_not(S, none) :- string(S?) | true.

%% =============================================================================
%% The super-app's refusal of a forgery (SGSG paper, Section 6.1): at each of
%% the four sites that take a signed term apart --- the creator's
%% certification at installation, the invitation, the invitee's undertaking
%% and the inviter's undertaking with the root channel --- a term that is not
%% a signed term is presented, the constant forged, which signature/2 reports
%% as unsigned, and the play shows the refusal taken: nothing is delivered for
%% it and the super-app carries on with the next message.  Each site is fed
%% directly, the person's or the friend's stream standing in for the channel
%% the term would have crossed; a forgery is refused before the friend or the
%% mini-app is looked up, so no friendship and no installation is set up.
%%
%% play_forged_cert(Installed): alice installs pingapp's certified artefact
%% under a creator's certification that is not a signed term.
%% Expected: Installed = [] --- against play_install("pingapp.glpw", ping, I),
%% I = [ping], the same artefact under the play's own certification;
%% → succeeds.
%% =============================================================================
exported procedure play_forged_cert(Stream(Constant)).
play_forged_cert(Installed?) :-
    load_file("pingapp.glpw", C),
    new_channel(Ui, Person),
    agent # agent(alice, [msg(person, alice, install(ping, C?, forged, Ui?)),
                          msg(person, alice, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

%% play_forged_invite(Out): bob's super-app receives from alice an invitation
%% that is not a signed term, with one end of a root channel, and then a
%% text.
%% Expected: Out = [msg(agent, person, received(alice, hello))] --- the offer
%% was refused, nothing was delivered for it, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_invite(AgentToUserStream).
play_forged_invite(Out?) :-
    root_end(End),
    agent # agent(bob, BobIn?,
                  [msg(alice, bob, invite(src, forged, End?)),
                   msg(alice, bob, text(hello))],
                  [user_output(BobOut), net_output(NetOut)]),
    until_received(BobOut?, Out, BobIn),
    sink(NetOut?).

%% play_forged_join(Out): alice's super-app, the inviter, receives from bob an
%% undertaking that is not a signed term, and then a text.
%% Expected: Out = [msg(agent, person, received(bob, hello))] --- the join
%% was refused, no root channel was created, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_join(AgentToUserStream).
play_forged_join(Out?) :-
    agent # agent(alice, AliceIn?,
                  [msg(bob, alice, join(src, t, forged)),
                   msg(bob, alice, text(hello))],
                  [user_output(AliceOut), net_output(NetOut)]),
    until_received(AliceOut?, Out, AliceIn),
    sink(NetOut?).

%% play_forged_root(Out): bob's super-app, the invitee, receives from alice
%% her answer to a join under an undertaking that is not a signed term, and
%% then a text.
%% Expected: Out = [msg(agent, person, received(alice, hello))] --- the end
%% was not accepted, nothing was delivered, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_root(AgentToUserStream).
play_forged_root(Out?) :-
    agent # agent(bob, BobIn?,
                  [msg(alice, bob, root(src, t, forged)),
                   msg(alice, bob, text(hello))],
                  [user_output(BobOut), net_output(NetOut)]),
    until_received(BobOut?, Out, BobIn),
    sink(NetOut?).

%% until_received(Outs, Seen, Cmds): the person watching the super-app's
%% stream copies everything delivered up to the first text received, at which
%% the person's stream closes.
procedure until_received(AgentToUserStream?, AgentToUserStream, UserInStream).
until_received([msg(agent, person, received(F, Text)) | _],
               [msg(agent, person, received(F?, Text?))], []).
until_received([M | Outs], [M? | Seen?], Cmds?) :-
    otherwise | until_received(Outs?, Seen, Cmds).
until_received([], [], []).

%% root_end(End): one end of a fresh root channel, at Opaque, as root_step/13
%% makes it, the other end dropped.
procedure root_end(RootChannel(Opaque)).
root_end(E?) :- new_channel(E, _) | true.

%% =============================================================================
%% The warm call on three smartphones (../../superapp3_boot.glp): alice, bob
%% and carol, carol a friend of both, alice and bob not friends.  alice
%% invites carol to the mini-app and carol invites bob; alice's execution,
%% greeted by carol, sends her probe(W), the end of a fresh variable, which
%% carol's execution forwards to bob's; bob's execution assigns it, bob's
%% runtime holds the assignment --- the end reached bob under alice's name from
%% carol --- and reports the held link; bob's mini-app asks for a warm call;
%% bob's social graph asks carol for an introduction to alice, which carol's
%% person allows; alice's and bob's persons accept it and befriend; bob's
%% social graph sends alice warm_call(ping, Name); alice's person having
%% consented, alice invites bob, bob joins, the handshake opens their root
%% channel, bob's social graph releases the held end, and the value reaches
%% alice, whose execution reports got(hello_from_bob).  Every volition is the
%% person's, given here in advance.  Nothing closes: the harness settles.
%% =============================================================================
exported procedure sg_init(Key?, Constant?, NetInStream?).
sg_init(alice, invite, NetIn) :-
    agent # agent(alice, AliceIn?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, alice, greet, Person?, Screen),
    tee(Screen?, Show, Seen),
    send_to_user(Show?),
    alice_person_boot(C?, CK?, CSig?, App?, Out?, Seen?, AliceIn).
sg_init(bob, consent, NetIn) :-
    agent # agent(bob, BobIn?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, bob, greet, Person?, Screen),
    tee(Screen?, Show, Seen),
    send_to_user(Show?),
    bob_person_boot(C?, CK?, CSig?, App?, Out?, Seen?, BobIn).

%% The currency on two smartphones (../../coins_boot.glp): each person trusts
%% the compiler's key, installs the certified currency with its own end of a
%% person channel, and its scripted person, Currencies' own, plays the swap of
%% play_coins under its role; what the currency shows a person goes to the
%% person, printed by the harness.
sg_init(alice, coins, NetIn) :-
    agent # agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_coins_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, alice, alice, PersonEnd?, Screen),
    send_to_user(Screen?).
sg_init(bob, coins, NetIn) :-
    agent # agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_coins_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, bob, bob, PersonEnd?, Screen),
    send_to_user(Screen?).

%% The child-safe platform on two smartphones (../../cssn_boot.glp), as the
%% currency's clauses above: each person trusts the compiler's key, installs
%% the certified platform with its own end of a person channel, and its
%% scripted person, CSSN's own, greets bob under the role greeter once the
%% conversation is adopted, or watches under the role onlooker.
sg_init(alice, cssn, NetIn) :-
    agent # agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("childsafe.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_cssn_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, alice, greeter, PersonEnd?, Seen),
    send_to_user(Seen?).
sg_init(bob, cssn, NetIn) :-
    agent # agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("childsafe.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_cssn_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, bob, onlooker, PersonEnd?, Seen),
    send_to_user(Seen?).

%% Both mini-apps on two smartphones (../../both_boot.glp): each person trusts
%% the compiler's key, installs both certified mini-apps with their own
%% person channels, and runs both platforms over the one friendship.
sg_init(alice, both, NetIn) :-
    agent # agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", CC),
    certified(CC?, CK, CCSig),
    load_file("childsafe.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEnd, CoinsPerson),
    new_channel(CssnEnd, CssnPerson),
    alice_both_boot(CK?, CC?, CCSig?, CoinsEnd?, CS?, CSSig?, CssnEnd?, Out?, In),
    miniapp_person_run(CC?, alice, alice, CoinsPerson?, Screen),
    send_to_user(Screen?),
    miniapp_person_run(CS?, alice, greeter, CssnPerson?, Seen),
    send_to_user(Seen?).
sg_init(bob, both, NetIn) :-
    agent # agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", CC),
    certified(CC?, CK, CCSig),
    load_file("childsafe.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEnd, CoinsPerson),
    new_channel(CssnEnd, CssnPerson),
    bob_both_boot(CK?, CC?, CCSig?, CoinsEnd?, CS?, CSSig?, CssnEnd?, Out?, In),
    miniapp_person_run(CC?, bob, bob, CoinsPerson?, Screen),
    send_to_user(Screen?),
    miniapp_person_run(CS?, bob, onlooker, CssnPerson?, Seen),
    send_to_user(Seen?).

%% The warm call: each person's screen is the mini-app's scripted person's,
%% under its role watch, every item to the person.
sg_init(alice, warm, NetIn) :-
    agent # agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, alice, watch, Person?, Screen),
    send_to_user(Screen?),
    scripted_home(alice, Out?, Script, ScriptCmds?, In),
    alice_warm(C?, CK?, CSig?, App?, Script?, ScriptCmds).
sg_init(bob, warm, NetIn) :-
    agent # agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, bob, watch, Person?, Screen),
    send_to_user(Screen?),
    scripted_home(bob, Out?, Script, ScriptCmds?, In),
    bob_warm(C?, CK?, CSig?, App?, Script?, ScriptCmds).
sg_init(carol, warm, NetIn) :-
    agent # agent(carol, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, carol, watch, Person?, Screen),
    send_to_user(Screen?),
    scripted_home(carol, Out?, Script, ScriptCmds?, In),
    carol_warm(C?, CK?, CSig?, App?, Script?, ScriptCmds).

%% alice's person: install; consent in advance to a warm call from bob;
%% cold-call carol, invite her once connected; consent on its card to carol's
%% introduction to bob.
procedure alice_warm(Content?, String?, String?, PersonChannel(Opaque)?, Stream(Output)?, UserInStream).
alice_warm(C, CK, CSig, Ui, Outs,
           [msg(person, alice, trust(CK?)),
            msg(person, alice, install(ping, C?, CSig?, Ui?)),
            msg(person, alice, accept_warm_call(bob)),
            msg(person, alice, connect(carol)) | Cmds?]) :-
    alice_warm_run(Outs?, Cmds).

procedure alice_warm_run(Stream(Output)?, UserInStream).
alice_warm_run([msg(agent, person, connected(carol)) | Outs],
               [msg(person, alice, invite(ping, carol)) | Cmds?]) :-
    send_to_user([sg(connected(carol))]),
    alice_warm_run(Outs?, Cmds).
alice_warm_run([msg(agent, person, connected(bob)) | Outs], Cmds?) :-
    send_to_user([sg(connected(bob))]),
    alice_warm_run(Outs?, Cmds).
alice_warm_run([msg(agent, person, befriend_intro(carol, bob)) | Outs], Cmds?) :-
    send_to_user([sg(intro_from(carol, bob))]),
    alice_warm_run(Outs?, Cmds).
alice_warm_run([_ | Outs], Cmds?) :- otherwise | alice_warm_run(Outs?, Cmds).
alice_warm_run([], []).

%% bob's person: install; consent in advance to carol's and alice's
%% invitations and to a warm call with alice; cold-call carol; consent on its
%% card to carol's introduction to alice.
procedure bob_warm(Content?, String?, String?, PersonChannel(Opaque)?, Stream(Output)?, UserInStream).
bob_warm(C, CK, CSig, Ui, Outs,
         [msg(person, bob, trust(CK?)),
          msg(person, bob, install(ping, C?, CSig?, Ui?)),
          msg(person, bob, accept_invite(ping, carol)),
          msg(person, bob, accept_invite(ping, alice)),
          msg(person, bob, accept_warm_call(alice)),
          msg(person, bob, connect(carol)) | Cmds?]) :-
    bob_warm_run(Outs?, Cmds).

procedure bob_warm_run(Stream(Output)?, UserInStream).
bob_warm_run([msg(agent, person, befriend_intro(carol, alice)) | Outs], Cmds?) :-
    send_to_user([sg(intro_from(carol, alice))]),
    bob_warm_run(Outs?, Cmds).
bob_warm_run([msg(agent, person, connected(Who)) | Outs], Cmds?) :-
    ground(Who?) |
    send_to_user([sg(connected(Who?))]),
    bob_warm_run(Outs?, Cmds).
bob_warm_run([_ | Outs], Cmds?) :- otherwise | bob_warm_run(Outs?, Cmds).
bob_warm_run([], []).

%% carol's person: install; consent in advance to alice's invitation and allow
%% the introduction of bob to alice; consent on their cards to both cold
%% calls; invite bob once connected.
procedure carol_warm(Content?, String?, String?, PersonChannel(Opaque)?, Stream(Output)?, UserInStream).
carol_warm(C, CK, CSig, Ui, Outs,
           [msg(person, carol, trust(CK?)),
            msg(person, carol, install(ping, C?, CSig?, Ui?)),
            msg(person, carol, accept_invite(ping, alice)),
            msg(person, carol, allow_intro(bob, alice)) | Cmds?]) :-
    carol_warm_run(Outs?, Cmds).

procedure carol_warm_run(Stream(Output)?, UserInStream).
carol_warm_run([msg(agent, person, befriend(Who)) | Outs], Cmds?) :-
    ground(Who?) |
    send_to_user([sg(cold_call(Who?))]),
    carol_warm_run(Outs?, Cmds).
carol_warm_run([msg(agent, person, connected(bob)) | Outs],
               [msg(person, carol, invite(ping, bob)) | Cmds?]) :-
    send_to_user([sg(connected(bob))]),
    carol_warm_run(Outs?, Cmds).
carol_warm_run([msg(agent, person, connected(alice)) | Outs], Cmds?) :-
    send_to_user([sg(connected(alice))]),
    carol_warm_run(Outs?, Cmds).
carol_warm_run([_ | Outs], Cmds?) :- otherwise | carol_warm_run(Outs?, Cmds).
carol_warm_run([], []).

%% =============================================================================
%% play_coins(ScreenA, ScreenB): the currency mini-app (Currencies'
%% programs/currencies/coins/currency, its artefact currency.glpw beside this
%% program) hosted by the super-app: alice and bob install it with its two
%% certifications, alice befriends bob and invites him, and the handshake
%% opens a root channel of the currency's protocol between their two
%% executions, each activated by run/3 with its three grants.  The persons
%% hold the other ends of the person channels: each is the currency's own
%% scripted person, activated from the same module value under its role ---
%% alice mints 2 and offers her 2 for bob's 2, bob mints 2 and accepts ---
%% the currency's own swap over the conversation the social graph delivered.
%% Expected: ScreenA = [opened(bob), minted(2), holdings([lot(alice, 2)]),
%% holdings([]), swap_done(bob), holdings([lot(bob, 2)]) | _], ScreenB =
%% [opened(alice), minted(2), holdings([lot(bob, 2)]), swap_done(alice),
%% holdings([lot(alice, 2)]) | _], → suspended (the agents' request forms
%% stay open and the person channels never close).
%% ../../coins_boot.glp runs the same swap on two smartphones.
%% =============================================================================
exported procedure play_coins(Stream(Opaque), Stream(Opaque)).
play_coins(ScreenA?, ScreenB?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("currency.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_coins_person(C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, alice, alice, PersonEndA?, ScreenA),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_coins_person(C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, bob, bob, PersonEndB?, ScreenB).

%% The installers of play_coins: each installs the currency with its end of
%% its person channel; the play writes no date, the currency keeping none.
procedure alice_coins_person(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_coins_person(C, CSig, AppEnd, Outs,
                   [msg(person, alice, install(currency, C?, CSig?, AppEnd?)),
                    msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_coins_run(Outs?, Cmds).

procedure alice_coins_run(AgentToUserStream?, UserInStream).
alice_coins_run([msg(agent, person, connected(bob)) | Outs],
                [msg(person, alice, invite(currency, bob)) | Cmds?]) :-
    alice_coins_run(Outs?, Cmds).
alice_coins_run([_ | Outs], Cmds?) :- otherwise | alice_coins_run(Outs?, Cmds).
alice_coins_run([], []).

procedure bob_coins_person(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_coins_person(C, CSig, AppEnd, Outs,
                 [msg(person, bob, install(currency, C?, CSig?, AppEnd?)),
                  msg(person, bob, accept_invite(currency, alice)) | Cmds?]) :-
    bob_coins_run(Outs?, Cmds).

procedure bob_coins_run(AgentToUserStream?, UserInStream).
bob_coins_run([msg(agent, person, befriend(alice, P)) | Outs],
              [msg(person, bob, decision(yes, alice, P?)) | Cmds?]) :-
    bob_coins_run(Outs?, Cmds).
bob_coins_run([_ | Outs], Cmds?) :- otherwise | bob_coins_run(Outs?, Cmds).
bob_coins_run([], []).


%% The two persons of both platforms under :boot, each trusting the compiler's
%% key once for the two artefacts it signed.
procedure alice_both_boot(String?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_both_boot(CK, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                [msg(person, alice, trust(CK?)),
                 msg(person, alice, install(currency, CC?, CCSig?, CoinsEnd?)),
                 msg(person, alice, install(childsafe, CS?, CSSig?, CssnEnd?)),
                 msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_both_run(Outs?, Cmds).

procedure bob_both_boot(String?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_both_boot(CK, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
              [msg(person, bob, trust(CK?)),
               msg(person, bob, install(currency, CC?, CCSig?, CoinsEnd?)),
               msg(person, bob, install(childsafe, CS?, CSSig?, CssnEnd?)),
               msg(person, bob, accept_invite(currency, alice)),
               msg(person, bob, accept_invite(childsafe, alice)) | Cmds?]) :-
    bob_both_run(Outs?, Cmds).

%% The child-safe platform's two persons under :boot.
procedure alice_cssn_boot(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_cssn_boot(C, CK, CSig, AppEnd, Outs,
                [msg(person, alice, trust(CK?)),
                 msg(person, alice, install(childsafe, C?, CSig?, AppEnd?)),
                 msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_cssn_run(Outs?, Cmds).

procedure bob_cssn_boot(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_cssn_boot(C, CK, CSig, AppEnd, Outs,
              [msg(person, bob, trust(CK?)),
               msg(person, bob, install(childsafe, C?, CSig?, AppEnd?)),
               msg(person, bob, accept_invite(childsafe, alice)) | Cmds?]) :-
    bob_cssn_run(Outs?, Cmds).

%% The same two persons under :boot, each trusting the compiler's key first.
procedure alice_coins_boot(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_coins_boot(C, CK, CSig, AppEnd, Outs,
                 [msg(person, alice, trust(CK?)),
                  msg(person, alice, install(currency, C?, CSig?, AppEnd?)),
                  msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_coins_run(Outs?, Cmds).

procedure bob_coins_boot(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_coins_boot(C, CK, CSig, AppEnd, Outs,
               [msg(person, bob, trust(CK?)),
                msg(person, bob, install(currency, C?, CSig?, AppEnd?)),
                msg(person, bob, accept_invite(currency, alice)) | Cmds?]) :-
    bob_coins_run(Outs?, Cmds).

%% =============================================================================
%% play_cssn(SeenA, SeenB): the child-safe platform (CSSN's
%% programs/cssn/childsafe, its artefact childsafe.glpw beside this program)
%% hosted by the super-app, as play_coins hosts the currency.  alice and bob
%% install it with its two certifications, alice befriends bob and invites
%% him, and the handshake opens a root channel of that platform's protocol
%% between their two executions, each activated by run/3 with its three
%% grants.  Adopting a conversation IS befriending under that contract, so
%% each execution tells its person it is connected; alice's person, CSSN's
%% scripted person under the role greeter, then sends bob one message of the
%% platform, and bob's, under the role onlooker, shows it.
%% Expected: SeenA = [connected(bob) | _], SeenB = [connected(alice),
%% received(alice, hello) | _], → suspended (the executions pend on their
%% persons and their friends).  ../../cssn_boot.glp runs the same on two
%% smartphones.
%% =============================================================================
exported procedure play_cssn(Stream(Opaque), Stream(Opaque)).
play_cssn(SeenA?, SeenB?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("childsafe.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_cssn_person(C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, alice, greeter, PersonEndA?, SeenA),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_cssn_person(C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, bob, onlooker, PersonEndB?, SeenB).

procedure alice_cssn_person(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_cssn_person(C, CSig, AppEnd, Outs,
                  [msg(person, alice, install(childsafe, C?, CSig?, AppEnd?)),
                   msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_cssn_run(Outs?, Cmds).

procedure alice_cssn_run(AgentToUserStream?, UserInStream).
alice_cssn_run([msg(agent, person, connected(bob)) | Outs],
               [msg(person, alice, invite(childsafe, bob)) | Cmds?]) :-
    alice_cssn_run(Outs?, Cmds).
alice_cssn_run([_ | Outs], Cmds?) :- otherwise | alice_cssn_run(Outs?, Cmds).
alice_cssn_run([], []).

procedure bob_cssn_person(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_cssn_person(C, CSig, AppEnd, Outs,
                [msg(person, bob, install(childsafe, C?, CSig?, AppEnd?)),
                 msg(person, bob, accept_invite(childsafe, alice)) | Cmds?]) :-
    bob_cssn_run(Outs?, Cmds).

procedure bob_cssn_run(AgentToUserStream?, UserInStream).
bob_cssn_run([msg(agent, person, befriend(alice, P)) | Outs],
             [msg(person, bob, decision(yes, alice, P?)) | Cmds?]) :-
    bob_cssn_run(Outs?, Cmds).
bob_cssn_run([_ | Outs], Cmds?) :- otherwise | bob_cssn_run(Outs?, Cmds).
bob_cssn_run([], []).

%% =============================================================================
%% play_both(ScreenA, ScreenB, SeenA, SeenB): ONE super-app hosting BOTH
%% mini-apps at once (GSG paper, Section 7).  alice and bob each install the
%% currency and the child-safe platform, each with its own person channel;
%% alice invites bob to both; the two handshakes open a root channel of each
%% platform's own protocol, and each super-app activates both entries by
%% run/3, each at its own opaque instance and with its own conversations.
%% Then both platforms run at once over the one friendship: alice and bob
%% mint and swap under the currency's contract, and alice greets bob under
%% the child-safe platform's, each person the mini-app's own.  Expected:
%% ScreenA and ScreenB as in play_coins, SeenA = [connected(bob) | _], SeenB =
%% [connected(alice), received(alice, hello) | _], → suspended.
%% =============================================================================
exported procedure play_both(Stream(Opaque), Stream(Opaque), Stream(Opaque), Stream(Opaque)).
play_both(ScreenA?, ScreenB?, SeenA?, SeenB?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("currency.glpw", CC),
    certified(CC?, _, CCSig),
    load_file("childsafe.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEndA, CoinsPersonA),
    new_channel(CssnEndA, CssnPersonA),
    new_channel(CoinsEndB, CoinsPersonB),
    new_channel(CssnEndB, CssnPersonB),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_both_person(CC?, CCSig?, CoinsEndA?, CS?, CSSig?, CssnEndA?, AliceOut?, AliceIn),
    miniapp_person_run(CC?, alice, alice, CoinsPersonA?, ScreenA),
    miniapp_person_run(CS?, alice, greeter, CssnPersonA?, SeenA),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_both_person(CC?, CCSig?, CoinsEndB?, CS?, CSSig?, CssnEndB?, BobOut?, BobIn),
    miniapp_person_run(CC?, bob, bob, CoinsPersonB?, ScreenB),
    miniapp_person_run(CS?, bob, onlooker, CssnPersonB?, SeenB).

%% alice's person: install both, cold-call bob, and invite him to both once
%% they are friends.
procedure alice_both_person(Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_both_person(CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                  [msg(person, alice, install(currency, CC?, CCSig?, CoinsEnd?)),
                   msg(person, alice, install(childsafe, CS?, CSSig?, CssnEnd?)),
                   msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_both_run(Outs?, Cmds).

procedure alice_both_run(AgentToUserStream?, UserInStream).
alice_both_run([msg(agent, person, connected(bob)) | Outs],
               [msg(person, alice, invite(currency, bob)),
                msg(person, alice, invite(childsafe, bob)) | Cmds?]) :-
    alice_both_run(Outs?, Cmds).
alice_both_run([_ | Outs], Cmds?) :- otherwise | alice_both_run(Outs?, Cmds).
alice_both_run([], []).

%% bob's person: install both, consent to the friendship, and accept both
%% invitations.
procedure bob_both_person(Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_both_person(CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                [msg(person, bob, install(currency, CC?, CCSig?, CoinsEnd?)),
                 msg(person, bob, install(childsafe, CS?, CSSig?, CssnEnd?)),
                 msg(person, bob, accept_invite(currency, alice)),
                 msg(person, bob, accept_invite(childsafe, alice)) | Cmds?]) :-
    bob_both_run(Outs?, Cmds).

procedure bob_both_run(AgentToUserStream?, UserInStream).
bob_both_run([msg(agent, person, befriend(alice, P)) | Outs],
             [msg(person, bob, decision(yes, alice, P?)) | Cmds?]) :-
    bob_both_run(Outs?, Cmds).
bob_both_run([_ | Outs], Cmds?) :- otherwise | bob_both_run(Outs?, Cmds).
bob_both_run([], []).

%% =============================================================================
%% play_reinvite: the registry's return from running to idle (Section 3,
%% "Activation and joining").  alice installs the self-ending mini-app
%% (../endapp, its artefact endapp.glpw beside this program), befriends bob and
%% invites him; the two executions greet each other and ALICE'S ENDS of its own
%% accord.  Her stream up to the social graph closes with it, her super-app
%% returns her entry to idle, and she invites bob a second time: the mini-app
%% is activated afresh by run/3, and the new conversation reaches bob's
%% execution, which never ended.  Her person stream closes after the play's
%% last observation, bob's second opened(alice), greeted(alice), and her
%% super-app ends with it (GSG Section 5.1); his closes when his agent's
%% stream to him closes.
%%
%% What the second pair of entries on bob's stream fences: without the return
%% alice's entry would still say running, and the root channel of the second
%% conversation would go to the execution that is gone.  Bob would still see it
%% open --- his own entry is running and his execution is live --- but nothing
%% would greet him, so the discriminating check is his SECOND greeted(alice).
%%
%% Expected: A = [opened(bob), greeted(bob)], closed, her execution having
%% ended; B = [opened(alice), greeted(alice), opened(alice), greeted(alice) | _],
%% → suspended (bob's execution and his person stand).
%% =============================================================================
exported procedure play_reinvite(Stream(Opaque), Stream(Opaque)).
play_reinvite(AliceUi?, BobUi?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("endapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, alice, greet, AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_reinvite(C?, CSig?, AliceApp?, AliceOut?, AliceSeen?, BobSeen?, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, bob, watch, BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_reinvite(C?, CSig?, BobApp?, BobOut?, BobIn).

%% Alice's person: install the mini-app and cold-call bob.
procedure alice_reinvite(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Stream(Opaque)?, UserInStream).
alice_reinvite(M, CSig, Ui, Outs, Seen, BobSeen,
               [msg(person, alice, install(ping, M?, CSig?, Ui?)),
                msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_reinvite_wait(Outs?, Seen?, BobSeen?, Cmds).

%% Once connected, invite bob.
procedure alice_reinvite_wait(AgentToUserStream?, Stream(Opaque)?, Stream(Opaque)?, UserInStream).
alice_reinvite_wait([msg(agent, person, connected(bob)) | _], Seen, BobSeen,
                    [msg(person, alice, invite(ping, bob)) | Cmds?]) :-
    alice_after_end(Seen?, BobSeen?, Cmds).
alice_reinvite_wait([_ | Outs], Seen, BobSeen, Cmds?) :-
    otherwise | alice_reinvite_wait(Outs?, Seen?, BobSeen?, Cmds).
alice_reinvite_wait([], _, _, []).

%% Her mini-app's screen has closed: her scripted person, under its role
%% greet, stops reporting at the greeting, with which her execution ends of its
%% own accord, so her entry has returned to idle.  Invite bob again, and keep her own
%% stream open until the play's last observation.
procedure alice_after_end(Stream(Opaque)?, Stream(Opaque)?, UserInStream).
alice_after_end([], BobSeen, [msg(person, alice, invite(ping, bob)) | Cmds?]) :-
    alice_after_last(BobSeen?, Cmds).
alice_after_end([_ | Seen], BobSeen, Cmds?) :-
    otherwise | alice_after_end(Seen?, BobSeen?, Cmds).

%% The play's last observation, bob's fourth item, his second greeted(alice)
%% after his second opened(alice) (../endapp/miniapp.glp): the second root
%% channel has reached bob.  The play counts his screen's items and inspects
%% none.  Her stream then closes and her super-app ends (GSG Section 5.1), her
%% agent closing its friend channels and the channels of every mini-app it
%% hosts, whose peers see a crash (agent.glp's termination clause,
%% close_outputs/1, close_host/1); where his screen closes first, the
%% observation cannot come, and her stream closes all the same.
procedure alice_after_last(Stream(Opaque)?, UserInStream).
alice_after_last(Seen, Cmds?) :- after_items(4, Seen?, Cmds).

%% after_items(N, Seen, Cmds): Cmds closed once N items of Seen have come, or
%% Seen has closed first.
procedure after_items(Integer?, Stream(Opaque)?, UserInStream).
after_items(0, _, []).
after_items(N, [_ | Seen], Cmds?) :- N? > 0 | N1 := N? - 1, after_items(N1?, Seen?, Cmds).
after_items(N, [], []) :- N? > 0 | true.

%% Bob's person: install the mini-app and consent to BOTH invitations before
%% either offer arrives, as bob_person consents once --- the two consents
%% stack in the pending list and each offer takes one.
procedure bob_reinvite(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_reinvite(M, CSig, Ui, Outs,
             [msg(person, bob, install(ping, M?, CSig?, Ui?)),
              msg(person, bob, accept_invite(ping, alice)),
              msg(person, bob, accept_invite(ping, alice)) | Cmds?]) :-
    bob_reinvite_wait(Outs?, Cmds).

%% Answer alice's cold call, and then leave his stream open: his execution is
%% the one that must still be there when her second invitation arrives, and
%% closing the stream would close his super-app and the execution with it.
procedure bob_reinvite_wait(AgentToUserStream?, UserInStream).
bob_reinvite_wait([msg(agent, person, befriend(alice, P)) | Outs],
                  [msg(person, bob, decision(yes, alice, P?)) | Cmds?]) :-
    bob_until_closed(Outs?, Cmds).
bob_reinvite_wait([_ | Outs], Cmds?) :-
    otherwise | bob_reinvite_wait(Outs?, Cmds).
bob_reinvite_wait([], []).

%% His person stream closes when his agent's stream to him closes, his agent
%% having ended.
procedure bob_until_closed(AgentToUserStream?, UserInStream).
bob_until_closed([_ | Outs], Cmds?) :- bob_until_closed(Outs?, Cmds).
bob_until_closed([], []).

%% =============================================================================
%% play_sovereign: the denominated currencies mini-app (Currencies'
%% programs/currencies/sovereign/denominated, its artefact denominated.glpw
%% beside this program) hosted by the super-app.  alice and bob install it
%% with its two certifications, alice befriends bob and invites him, the
%% handshake opens a root channel of the denominated protocol between their
%% two executions, and each is activated by run/3 with its three grants.
%%
%% What this play is for is the ACTIVATION, not the acts: run/3 admits the
%% mini-app only if the type identity of the entry template's opaque instance
%% at the type its exports record is the one find_type/3 gives at it, and the
%% super-app holds no copy of the denominated currencies' types.  The acts
%% over the conversation are the mini-app's own and are exercised in its
%% Section N4, so nothing is granted here: each person is the mini-app's own
%% scripted person under its role watch, which reads the screen off what its
%% dispatcher draws (GSG, 2026-10-13 20:22 UTC, G).
%% Expected: ScreenA = [opened(bob) | _], ScreenB = [opened(alice) | _],
%% → suspended (the agents' request forms stay open and the person channels
%% never close).
%% =============================================================================
exported procedure play_sovereign(Stream(Opaque), Stream(Opaque)).
play_sovereign(ScreenA?, ScreenB?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("denominated.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_sv_person(C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, alice, watch, PersonEndA?, ScreenA),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_sv_person(C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, bob, watch, PersonEndB?, ScreenB).

procedure alice_sv_person(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_sv_person(C, CSig, AppEnd, Outs,
                [msg(person, alice, install(denominated, C?, CSig?, AppEnd?)),
                 msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_sv_run(Outs?, Cmds).

procedure alice_sv_run(AgentToUserStream?, UserInStream).
alice_sv_run([msg(agent, person, connected(bob)) | Outs],
             [msg(person, alice, invite(denominated, bob)) | Cmds?]) :-
    alice_sv_run(Outs?, Cmds).
alice_sv_run([_ | Outs], Cmds?) :- otherwise | alice_sv_run(Outs?, Cmds).
alice_sv_run([], []).

procedure bob_sv_person(Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_sv_person(C, CSig, AppEnd, Outs,
              [msg(person, bob, install(denominated, C?, CSig?, AppEnd?)),
               msg(person, bob, accept_invite(denominated, alice)) | Cmds?]) :-
    bob_sv_run(Outs?, Cmds).

procedure bob_sv_run(AgentToUserStream?, UserInStream).
bob_sv_run([msg(agent, person, befriend(alice, P)) | Outs],
           [msg(person, bob, decision(yes, alice, P?)) | Cmds?]) :-
    bob_sv_run(Outs?, Cmds).
bob_sv_run([_ | Outs], Cmds?) :- otherwise | bob_sv_run(Outs?, Cmds).
bob_sv_run([], []).
