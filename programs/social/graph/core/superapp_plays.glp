%% =============================================================================
%% play_cssn(A, B, SeenA, SeenB): the child-safe platform (CSSN's
%% programs/cssn/childsafe, its artefact childsafe.glpw beside this program)
%% hosted by the super-app, as play_coins hosts the currency.  alice and bob
%% install it with its two certifications, alice befriends bob and invites
%% him, and the handshake opens a root channel of that platform's protocol
%% between their two executions, each activated by run/3 with its three
%% grants.  Adopting a conversation IS befriending under that contract, so
%% each execution tells its person it is connected; alice's person, CSSN's
%% scripted person under the role greeter, then sends bob one message of the
%% platform, and bob's, under the role onlooker, shows it.
%% Expected: SeenA = [connected(bob) | _], SeenB = [connected(alice),
%% received(alice, hello) | _], → suspended (the executions pend on their
%% persons and their friends).  ../../cssn_boot.glp runs the same on two
%% smartphones.
%% =============================================================================
exported procedure play_cssn(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_cssn(A, B, SeenA?, SeenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("childsafe.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_cssn_person(A?, B?, C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, A?, greeter, [B?], PersonEndA?, SeenA),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_cssn_person(B?, A?, C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, B?, onlooker, [A?], PersonEndB?, SeenB).

procedure alice_cssn_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_cssn_person(Me, Q, C, CSig, AppEnd, Outs,
                  [msg(person, Me?, install(childsafe, C?, CSig?, AppEnd?)),
                   msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_cssn_run(Me?, Q?, Outs?, Cmds).

procedure alice_cssn_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_cssn_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
               [msg(person, Me?, invite(childsafe, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_cssn_run(Me?, Q?, Outs?, Cmds).
alice_cssn_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_cssn_run(Me?, Q?, Outs?, Cmds).
alice_cssn_run(_, _, [], []).

procedure bob_cssn_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_cssn_person(Me, Q, C, CSig, AppEnd, Outs,
                [msg(person, Me?, install(childsafe, C?, CSig?, AppEnd?)),
                 msg(person, Me?, accept_invite(childsafe, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_cssn_run(Me?, Q?, Outs?, Cmds).

procedure bob_cssn_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_cssn_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
             [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_cssn_run(Me?, Q?, Outs?, Cmds).
bob_cssn_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_cssn_run(Me?, Q?, Outs?, Cmds).
bob_cssn_run(_, _, [], []).

%% =============================================================================
%% play_both(A, B, ScreenA, ScreenB, SeenA, SeenB): ONE super-app hosting BOTH
%% mini-apps at once (GSG paper, Section 7).  alice and bob each install the
%% currency and the child-safe platform, each with its own person channel;
%% alice invites bob to both; the two handshakes open a root channel of each
%% platform's own protocol, and each super-app activates both entries by
%% run/3, each at its own opaque instance and with its own conversations.
%% Then both platforms run at once over the one friendship: alice and bob
%% mint and swap under the currency's contract, and alice greets bob under
%% the child-safe platform's, each person the mini-app's own.  Expected:
%% ScreenA and ScreenB as in play_coins, SeenA = [connected(bob) | _], SeenB =
%% [connected(alice), received(alice, hello) | _], → suspended.
%% =============================================================================
exported procedure play_both(Key?, Key?, Stream(Opaque), Stream(Opaque), Stream(Opaque), Stream(Opaque)).
play_both(A, B, ScreenA?, ScreenB?, SeenA?, SeenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("currency.glpw", CC),
    certified(CC?, _, CCSig),
    load_file("childsafe.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEndA, CoinsPersonA),
    new_channel(CssnEndA, CssnPersonA),
    new_channel(CoinsEndB, CoinsPersonB),
    new_channel(CssnEndB, CssnPersonB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_both_person(A?, B?, CC?, CCSig?, CoinsEndA?, CS?, CSSig?, CssnEndA?, AliceOut?, AliceIn),
    miniapp_person_run(CC?, A?, alice, [B?], CoinsPersonA?, ScreenA),
    miniapp_person_run(CS?, A?, greeter, [B?], CssnPersonA?, SeenA),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_both_person(B?, A?, CC?, CCSig?, CoinsEndB?, CS?, CSSig?, CssnEndB?, BobOut?, BobIn),
    miniapp_person_run(CC?, B?, bob, [A?], CoinsPersonB?, ScreenB),
    miniapp_person_run(CS?, B?, onlooker, [A?], CssnPersonB?, SeenB).

%% alice's person: install both, cold-call bob, and invite him to both once
%% they are friends.
procedure alice_both_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_both_person(Me, Q, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                  [msg(person, Me?, install(currency, CC?, CCSig?, CoinsEnd?)),
                   msg(person, Me?, install(childsafe, CS?, CSSig?, CssnEnd?)),
                   msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_both_run(Me?, Q?, Outs?, Cmds).

procedure alice_both_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_both_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
               [msg(person, Me?, invite(currency, Q?)),
                msg(person, Me?, invite(childsafe, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_both_run(Me?, Q?, Outs?, Cmds).
alice_both_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_both_run(Me?, Q?, Outs?, Cmds).
alice_both_run(_, _, [], []).

%% bob's person: install both, consent to the friendship, and accept both
%% invitations.
procedure bob_both_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_both_person(Me, Q, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                [msg(person, Me?, install(currency, CC?, CCSig?, CoinsEnd?)),
                 msg(person, Me?, install(childsafe, CS?, CSSig?, CssnEnd?)),
                 msg(person, Me?, accept_invite(currency, Q?)),
                 msg(person, Me?, accept_invite(childsafe, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_both_run(Me?, Q?, Outs?, Cmds).

procedure bob_both_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_both_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
             [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_both_run(Me?, Q?, Outs?, Cmds).
bob_both_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_both_run(Me?, Q?, Outs?, Cmds).
bob_both_run(_, _, [], []).

%% =============================================================================
%% play_reinvite(A, B, AliceUi, BobUi): the registry's return from running to idle (Section 3,
%% "Activation and joining").  alice installs the self-ending mini-app
%% (../endapp, its artefact endapp.glpw beside this program), befriends bob and
%% invites him; the two executions greet each other and ALICE'S ENDS of its own
%% accord.  Her stream up to the social graph closes with it, her super-app
%% returns her entry to idle, and she invites bob a second time: the mini-app
%% is activated afresh by run/3, and the new conversation reaches bob's
%% execution, which never ended.  Her person stream closes after the play's
%% last observation, bob's second opened(alice), greeted(alice), and her
%% super-app ends with it (GSG Section 5.1); his closes when his agent's
%% stream to him closes.
%%
%% What the second pair of entries on bob's stream fences: without the return
%% alice's entry would still say running, and the root channel of the second
%% conversation would go to the execution that is gone.  Bob would still see it
%% open --- his own entry is running and his execution is live --- but nothing
%% would greet him, so the discriminating check is his SECOND greeted(alice).
%%
%% Expected: A = [opened(bob), greeted(bob)], closed, her execution having
%% ended; B = [opened(alice), greeted(alice), opened(alice), greeted(alice) | _],
%% → suspended (bob's execution and his person stand).
%% =============================================================================
exported procedure play_reinvite(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_reinvite(A, B, AliceUi?, BobUi?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("endapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, greet, [B?], AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_reinvite(A?, B?, C?, CSig?, AliceApp?, AliceOut?, AliceSeen?, BobSeen?, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, watch, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_reinvite(B?, A?, C?, CSig?, BobApp?, BobOut?, BobIn).

%% Alice's person, Me: install the mini-app and cold-call bob, Q.
procedure alice_reinvite(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Stream(Opaque)?, UserInStream).
alice_reinvite(Me, Q, M, CSig, Ui, Outs, Seen, BobSeen,
               [msg(person, Me?, install(ping, M?, CSig?, Ui?)),
                msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_reinvite_wait(Me?, Q?, Outs?, Seen?, BobSeen?, Cmds).

%% Once connected, invite Q.
procedure alice_reinvite_wait(Key?, Key?, AgentToUserStream?, Stream(Opaque)?, Stream(Opaque)?, UserInStream).
alice_reinvite_wait(Me, Q, [msg(agent, person, connected(F)) | _], Seen, BobSeen,
                    [msg(person, Me?, invite(ping, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_after_end(Me?, Q?, Seen?, BobSeen?, Cmds).
alice_reinvite_wait(Me, Q, [_ | Outs], Seen, BobSeen, Cmds?) :-
    otherwise | alice_reinvite_wait(Me?, Q?, Outs?, Seen?, BobSeen?, Cmds).
alice_reinvite_wait(_, _, [], _, _, []).

%% Her mini-app's screen has closed: her scripted person, under its role
%% greet, stops reporting at the greeting, with which her execution ends of its
%% own accord, so her entry has returned to idle.  Invite Q again, and keep her own
%% stream open until the play's last observation.
procedure alice_after_end(Key?, Key?, Stream(Opaque)?, Stream(Opaque)?, UserInStream).
alice_after_end(Me, Q, [], BobSeen, [msg(person, Me?, invite(ping, Q?)) | Cmds?]) :-
    alice_after_last(BobSeen?, Cmds).
alice_after_end(Me, Q, [_ | Seen], BobSeen, Cmds?) :-
    otherwise | alice_after_end(Me?, Q?, Seen?, BobSeen?, Cmds).

%% The play's last observation, bob's fourth item, his second greeted(alice)
%% after his second opened(alice) (../endapp/miniapp.glp): the second root
%% channel has reached bob.  The play counts his screen's items and inspects
%% none.  Her stream then closes and her super-app ends (GSG Section 5.1), her
%% agent closing its friend channels and the channels of every mini-app it
%% hosts, whose peers see a crash (agent.glp's termination clause,
%% close_outputs/1, close_host/1); where his screen closes first, the
%% observation cannot come, and her stream closes all the same.
procedure alice_after_last(Stream(Opaque)?, UserInStream).
alice_after_last(Seen, Cmds?) :- after_items(4, Seen?, Cmds).

%% after_items(N, Seen, Cmds): Cmds closed once N items of Seen have come, or
%% Seen has closed first.
procedure after_items(Integer?, Stream(Opaque)?, UserInStream).
after_items(0, _, []).
after_items(N, [_ | Seen], Cmds?) :- N? > 0 | N1 := N? - 1, after_items(N1?, Seen?, Cmds).
after_items(N, [], []) :- N? > 0 | true.

%% Bob's person: install the mini-app and consent to BOTH invitations before
%% either offer arrives, as bob_person consents once --- the two consents
%% stack in the pending list and each offer takes one.
procedure bob_reinvite(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_reinvite(Me, Q, M, CSig, Ui, Outs,
             [msg(person, Me?, install(ping, M?, CSig?, Ui?)),
              msg(person, Me?, accept_invite(ping, Q?)),
              msg(person, Me?, accept_invite(ping, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_reinvite_wait(Me?, Q?, Outs?, Cmds).

%% Answer alice's cold call, and then leave his stream open: his execution is
%% the one that must still be there when her second invitation arrives, and
%% closing the stream would close his super-app and the execution with it.
procedure bob_reinvite_wait(Key?, Key?, AgentToUserStream?, UserInStream).
bob_reinvite_wait(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
                  [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_until_closed(Outs?, Cmds).
bob_reinvite_wait(Me, Q, [_ | Outs], Cmds?) :-
    otherwise | bob_reinvite_wait(Me?, Q?, Outs?, Cmds).
bob_reinvite_wait(_, _, [], []).

%% His person stream closes when his agent's stream to him closes, his agent
%% having ended.
procedure bob_until_closed(AgentToUserStream?, UserInStream).
bob_until_closed([_ | Outs], Cmds?) :- bob_until_closed(Outs?, Cmds).
bob_until_closed([], []).

%% =============================================================================
%% play_sovereign(A, B, ScreenA, ScreenB): the denominated currencies mini-app (Currencies'
%% programs/currencies/sovereign/denominated, its artefact denominated.glpw
%% beside this program) hosted by the super-app.  alice and bob install it
%% with its two certifications, alice befriends bob and invites him, the
%% handshake opens a root channel of the denominated protocol between their
%% two executions, and each is activated by run/3 with its three grants.
%%
%% What this play is for is the ACTIVATION, not the acts: run/3 admits the
%% mini-app only if the type identity of the entry template's opaque instance
%% at the type its exports record is the one find_type/3 gives at it, and the
%% super-app holds no copy of the denominated currencies' types.  The acts
%% over the conversation are the mini-app's own and are exercised in its
%% Section N4, so nothing is granted here: each person is the mini-app's own
%% scripted person under its role watch, which reads the screen off what its
%% dispatcher draws (GSG, 2026-10-13 20:22 UTC, G).
%% Expected: ScreenA = [opened(bob) | _], ScreenB = [opened(alice) | _],
%% → suspended (the agents' request forms stay open and the person channels
%% never close).
%% =============================================================================
exported procedure play_sovereign(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_sovereign(A, B, ScreenA?, ScreenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("denominated.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_sv_person(A?, B?, C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, A?, watch, [B?], PersonEndA?, ScreenA),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_sv_person(B?, A?, C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, B?, watch, [A?], PersonEndB?, ScreenB).

procedure alice_sv_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_sv_person(Me, Q, C, CSig, AppEnd, Outs,
                [msg(person, Me?, install(denominated, C?, CSig?, AppEnd?)),
                 msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_sv_run(Me?, Q?, Outs?, Cmds).

procedure alice_sv_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_sv_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
             [msg(person, Me?, invite(denominated, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_sv_run(Me?, Q?, Outs?, Cmds).
alice_sv_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_sv_run(Me?, Q?, Outs?, Cmds).
alice_sv_run(_, _, [], []).

procedure bob_sv_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_sv_person(Me, Q, C, CSig, AppEnd, Outs,
              [msg(person, Me?, install(denominated, C?, CSig?, AppEnd?)),
               msg(person, Me?, accept_invite(denominated, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_sv_run(Me?, Q?, Outs?, Cmds).

procedure bob_sv_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_sv_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
           [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_sv_run(Me?, Q?, Outs?, Cmds).
bob_sv_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_sv_run(Me?, Q?, Outs?, Cmds).
bob_sv_run(_, _, [], []).
