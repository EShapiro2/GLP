%% superapp_plays.glp --- distribution with an invitation, the handshake,
%% activation by run/3 with the three grants, and the attestation (GSG paper,
%% Sections 3, 4, 5.5 and 6), played by two social-graph agents in one heap,
%% the network a two-way crossbar for cold calls, and under :boot
%% (../../superapp_boot.glp) by two isolates with their own keys.  The
%% certified mini-apps are GSG's ../pingapp and ../endapp, Currencies'
%% currency and denominated, and CSSN's childsafe; the super-app reads their
%% artefacts with load_file/2.  The persons are scripted on the agents'
%% person streams.
%%
%% The super-app holds no declaration of a mini-app's types.  A play mints a
%% mini-app's person channel at Opaque, installs the mini-app with one end and
%% hands the other to the mini-app's own scripted person, the instance at the
%% mini-app's type of the second template miniapp_person/5, activated from the
%% same module value as the entry (miniapp_person_run/6); the screen it reports
%% comes back to the caller at Opaque, or, under :boot, goes to the person
%% (GSG, 2026-10-13 18:52 UTC, O5, Udi: approved).  A play never inspects
%% what a screen carries: it passes it on, and reads only that an item came
%% or that the screen closed.
%%
%% No clause here names a peer by an atom: an agent is its public key, and a
%% readable name such as alice is a variable standing for a key (IGLP, Remark
%% "Agent Names").  Each play is given the keys of its agents by the goal that
%% starts it, and sg_init/4 the keys of the peers the person knows, which an
%% agent learns from its person (IGLP, Implementation Notes, "Boot"); the
%% persons' scripts take them as arguments.

imported procedure agent#agent(Key?, UserInStream?, NetInStream?, OutputsList?).
imported procedure home#home(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(HomeQuestion))).
imported procedure home#dispatch(Stream(Ask(HomeQuestion))?, PersonChannel(HomeDrawn)?, Channel(Stream(Input(HomeDrawn)), Stream(Output))).

%% The network between the two agents of a play, A and B: their network
%% outputs merged, and each message delivered to the agent its destination
%% names, by route_to/4 (self.glp's).
procedure crossbar2(Key?, Key?, NetOutStream?, NetOutStream?, NetInStream, NetInStream).
crossbar2(A, B, AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route_to(A?, All?, AIn, Rest),
    route_to(B?, Rest?, BIn, _).

procedure(X) tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

%% miniapp_person_run(M, Id, Role, Ps, PEnd, Screen): the mini-app M's scripted
%% person, under the role Role and with the keys Ps the person knows, the
%% readable names of the play's other persons standing for them, activated,
%% from the module value, by run/3 at the type identity of
%% the second template's opaque instance at the type its exports record for
%% miniapp_person/5, as the agent activates the entry (agent.glp,
%% activate/6), on the person's end PEnd of the person channel whose other end
%% the play installs the mini-app with; Screen the screen it reports, at
%% Opaque.  The play mints the channel and hands its two ends to two
%% activations of one module value, so it checks that the module records the
%% entry's person-channel type and the person's at one type, the first of the
%% entry's two identities and the first of the person's two, its second the
%% screen's type, the mini-app's own (vGLP 2026-10-16 11:25 UTC, item 4; TGLP modules.tex, "The
%% invitation discipline": "opaque_type yields one identity for the two
%% entries, which the host checks"; GLP, 2026-10-13 20:22 UTC, C; vGLP
%% 2026-10-14 13:21 UTC, S2).  Where they are not, no person runs: its end of
%% the person channel is held for good (hold_person/1) and its screen is empty.
procedure miniapp_person_run(Content?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, Ps, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/4, M?, H0),
    opaque_type(miniapp_person/5, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, Ps?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D, S], M, Id, Role, Ps, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/5, [D?, S?], T),
    run(miniapp_person(Id?, Role?, Ps?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

%% The certified mini-app: pingapp.glpw beside this program, written by the
%% REPL's :artefact from ../pingapp and read with load_file/2 --- a Module
%% where its certificate verifies, its text otherwise.  certified/4 gives the
%% module, the compiler's key its certificate carries, and the creator's
%% certification, signed here over its source identity, the contract's two act
%% schemas and the checker's verdict.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], grassroots), K?, CSig).

%% =============================================================================
%% play_invite(A, B, AliceUi, BobUi): alice, A, installs the mini-app, befriends bob and invites him;
%% bob installs it and consents; the handshake opens the root channel and the
%% two executions greet each other.  Each person's screen is the mini-app's
%% scripted person's, under its role greet, which stops at the greeting.
%% Expected: AliceUi = [opened(bob), greeted(bob)], BobUi = [opened(alice),
%% greeted(alice)], → succeeds.
%% =============================================================================
exported procedure play_invite(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_invite(A, B, AliceUi?, BobUi?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, greet, [B?], AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_person(A?, B?, C?, CSig?, yes, AliceApp?, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, greet, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(B?, A?, C?, CSig?, yes, BobApp?, BobOut?, BobSeen?, BobIn).

%% =============================================================================
%% play_invite_declined(A, B, AliceUi, BobUi): as above, but bob's person declines; no conversation
%% opens and neither execution is activated, so neither person's screen
%% shows an item; the person channel never ends (vGLP, Section 6.3), so
%% neither screen closes either.
%% Expected: AliceUi and BobUi unbound, → suspended.
%% =============================================================================
exported procedure play_invite_declined(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_invite_declined(A, B, AliceUi?, BobUi?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, greet, [B?], AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_person(A?, B?, C?, CSig?, no, AliceApp?, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, greet, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(B?, A?, C?, CSig?, no, BobApp?, BobOut?, BobSeen?, BobIn).

%% Alice's person, Me, inviting Q: install the mini-app, with its end of the
%% person channel, cold-call Q, and once connected invite Q.  Wait = yes:
%% keep the person stream open until the mini-app's person has seen her
%% execution greeted, its screen closing; no: close it after inviting.
procedure alice_person(Key?, Key?, Content?, String?, Decision?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_person(Me, Q, M, CSig, Wait, Ui, Outs, Seen,
             [msg(person, Me?, install(ping, M?, CSig?, Ui?)),
              msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_wait(Me?, Q?, Wait?, Outs?, Seen?, Cmds).

procedure alice_wait(Key?, Key?, Decision?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_wait(Me, Q, yes, [msg(agent, person, connected(F)) | _], Seen,
           [msg(person, Me?, invite(ping, Q?)) | Cmds?]) :-
    F? =?= Q? | person_done(Seen?, Cmds).
alice_wait(Me, Q, no, [msg(agent, person, connected(F)) | _], _,
           [msg(person, Me?, invite(ping, Q?))]) :-
    F? =?= Q? | true.
alice_wait(Me, Q, W, [_ | Outs], Seen, Cmds?) :- otherwise | alice_wait(Me?, Q?, W?, Outs?, Seen?, Cmds).
alice_wait(_, _, _, [], _, []).

%% Close the person stream once the mini-app's screen has closed: under the
%% role greet its person stops at the greeting (../pingapp/person.glp), and
%% the screen closes too where the mini-app ends.  The screen's items are
%% passed over, never inspected.
procedure person_done(Stream(Opaque)?, UserInStream).
person_done([_ | Seen], Cmds?) :- person_done(Seen?, Cmds).
person_done([], []).

%% Bob's person, Me, invited by Q: install the mini-app and give (or refuse)
%% consent before the offer arrives; answer Q's cold call; then wait for the
%% mini-app's screen to close, or close.
procedure bob_person(Key?, Key?, Content?, String?, Decision?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_person(Me, Q, M, CSig, yes, Ui, Outs, Seen,
           [msg(person, Me?, install(ping, M?, CSig?, Ui?)),
            msg(person, Me?, accept_invite(ping, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_wait(Me?, Q?, yes, Outs?, Seen?, Cmds).
bob_person(Me, Q, M, CSig, no, Ui, Outs, Seen,
           [msg(person, Me?, install(ping, M?, CSig?, Ui?)),
            msg(person, Me?, decline_invite(ping, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_wait(Me?, Q?, no, Outs?, Seen?, Cmds).

procedure bob_wait(Key?, Key?, Decision?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_wait(Me, Q, yes, [msg(agent, person, befriend(F, P)) | _], Seen,
         [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? | person_done(Seen?, Cmds).
bob_wait(Me, Q, no, [msg(agent, person, befriend(F, P)) | _], _,
         [msg(person, Me?, decision(yes, F?, P?))]) :-
    F? =?= Q? | true.
bob_wait(Me, Q, W, [_ | Outs], Seen, Cmds?) :- otherwise | bob_wait(Me?, Q?, W?, Outs?, Seen?, Cmds).
bob_wait(_, _, _, [], _, []).

%% =============================================================================
%% play_attest(A, B, S, K, H, T): alice, A, and bob, B, befriend; alice reads back the attestation her
%% social graph minted at the commit, and the play takes it apart.
%% Expected: T = attest(alice, bob), K the person's key, H this program's
%% source identity, → succeeds.
%% =============================================================================
exported procedure play_attest(Key?, Key?, String, String, String, Attestation).
play_attest(A, B, S?, K?, H?, T?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_attest(A?, B?, AliceOut?, S, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_answer(B?, A?, BobOut?, BobIn),
    signature(S?, Sg),
    attested(Sg?, K, H, T).

%% attested(Sg, K, H, T): the attestation taken apart, the play matching
%% signed(K, H, attest(I, O)), the two keys strings, and exercising no
%% refusal; the other clauses, which the checker requires of every
%% alternative of Signature, assign the three the constant unsigned, and the
%% play's checks never reach them.
procedure attested(Signature?, String, String, Attestation).
attested(signed(K, H, attest(I, O)), K?, H?, attest(I?, O?)) :- string(I?), string(O?) | true.
attested(signed(_, _, _), unsigned, unsigned, unsigned) :- otherwise | true.
attested(unsigned, unsigned, unsigned, unsigned).

procedure alice_attest(Key?, Key?, AgentToUserStream?, String, UserInStream).
alice_attest(Me, Q, Outs, S?, [msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_attest_wait(Me?, Q?, Outs?, S, Cmds).

procedure alice_attest_wait(Key?, Key?, AgentToUserStream?, String, UserInStream).
alice_attest_wait(Me, Q, [msg(agent, person, connected(F)) | _], S?,
                  [msg(person, Me?, attestation(Q?, S))]) :-
    F? =?= Q? | true.
alice_attest_wait(Me, Q, [_ | Outs], S?, Cmds?) :- otherwise | alice_attest_wait(Me?, Q?, Outs?, S, Cmds).
alice_attest_wait(_, _, [], none, []).

procedure bob_answer(Key?, Key?, AgentToUserStream?, UserInStream).
bob_answer(Me, Q, [msg(agent, person, befriend(F, P)) | _],
           [msg(person, Me?, decision(yes, F?, P?))]) :-
    F? =?= Q? | true.
bob_answer(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_answer(Me?, Q?, Outs?, Cmds).
bob_answer(_, _, [], []).

%% =============================================================================
%% play_both_ways(P, Q, A, B): alice, P, and bob, Q, cold-call each other at once, and each person
%% consents to the other's call (GSG Section 5.1; 2026-10-02 task, item 5).
%% Two befriendings of the same two people are under way at once, and alice,
%% the smaller identity, proposes in both: she mints the friend channel for
%% the first whose consent she reads and conveys already_friends for the
%% other, so each agent ends with one friend channel --- and each person is
%% told connected once, which convey/7 and adopt/6 tell where they install
%% one.  The persons stand at the end, their streams open, so what each was
%% told is the whole of it at quiescence.
%% Expected: A = [connected(bob) | _], B = [connected(alice) | _],
%% → suspended.
%% =============================================================================
exported procedure play_both_ways(Key?, Key?, Stream(AgentContent), Stream(AgentContent)).
play_both_ways(P, Q, A?, B?) :-
    ground(P?), ground(Q?) |
    crossbar2(P?, Q?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(P?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    both_ways_person(P?, Q?, AliceOut?, A, AliceIn),
    agent # agent(Q?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    both_ways_person(Q?, P?, BobOut?, B, BobIn).

%% A person who cold-calls the other and consents to the other's call, the
%% pending value passed back as it came; what the agent tells it of a
%% befriending's outcome, connected or rejected, is what it saw.
procedure both_ways_person(Key?, Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
both_ways_person(Me, Other, Outs, Seen?, [msg(person, Me?, connect(Other?)) | Cmds?]) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).

procedure both_ways_answer(Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
both_ways_answer(Me, [msg(agent, person, befriend(From, P)) | Outs], Seen?,
                 [msg(person, Me?, decision(yes, From?, P?)) | Cmds?]) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?], Cmds?) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [msg(agent, person, rejected(F)) | Outs], [rejected(F?) | Seen?], Cmds?) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [_ | Outs], Seen?, Cmds?) :-
    otherwise | both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(_, [], [], []).

%% =============================================================================
%% play_not_a_friend(P, Q, A, B): a message the person addresses to someone who is not
%% their friend is not sent, and the agent tells the person so (GSG Section
%% 5.1; GSG 2026-10-09 18:48 UTC).  Alice's person sends bob a message before
%% either has called the other, and is told not_a_friend(bob).  Bob's person
%% calls alice --- bob, the larger identity, accepts, his call his consent ---
%% and sends her a message at once, between his acceptance and the
%% conveyance, and is told not_a_friend(alice).  Alice's person consents to
%% bob's call only once bob was told, so his send precedes the conveyance by
%% causality and not by scheduling.  Alice, the proposer, mints the friend
%% channel and conveys it; each person is told connected, and bob's person,
%% told connected(alice), sends her a message again, which reaches her.  The
%% persons stand at the end, their streams open.
%% Expected: A = [not_a_friend(bob), connected(bob), received(bob, hello) | _],
%% B = [not_a_friend(alice), connected(alice) | _], → suspended.
%% =============================================================================
exported procedure play_not_a_friend(Key?, Key?, Stream(AgentContent), Stream(AgentContent)).
play_not_a_friend(P, Q, A?, B?) :-
    ground(P?), ground(Q?) |
    crossbar2(P?, Q?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(P?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    naf_alice(P?, Q?, AliceOut?, Told?, A, AliceIn),
    agent # agent(Q?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    naf_bob(Q?, P?, BobOut?, B, Told, BobIn).

%% Alice's person, Me, sends Q a message, and consents to Q's call once Q
%% was told not_a_friend(Me), the pending value passed back as it came.
procedure naf_alice(Key?, Key?, AgentToUserStream?, Constant?, Stream(AgentContent), UserInStream).
naf_alice(Me, Q, Outs, Told, Seen?, [msg(person, Me?, send(Q?, hi)) | Cmds?]) :-
    ground(Me?) |
    naf_alice_wait(Me?, Outs?, Told?, Seen, Cmds).

procedure naf_alice_wait(Key?, AgentToUserStream?, Constant?, Stream(AgentContent), UserInStream).
naf_alice_wait(Me, [msg(agent, person, not_a_friend(F)) | Outs], Told, [not_a_friend(F?) | Seen?], Cmds?) :-
    naf_alice_wait(Me?, Outs?, Told?, Seen, Cmds).
naf_alice_wait(Me, [msg(agent, person, befriend(From, P)) | Outs], told, Seen?,
               [msg(person, Me?, decision(yes, From?, P?)) | Cmds?]) :-
    naf_record(Outs?, Seen, Cmds).
naf_alice_wait(Me, [_ | Outs], Told, Seen?, Cmds?) :-
    otherwise | naf_alice_wait(Me?, Outs?, Told?, Seen, Cmds).
naf_alice_wait(_, [], _, [], []).

%% Bob's person, Me, calls Q and sends Q a message at once; told
%% not_a_friend(Q), it lets Q's person consent, and told connected(Q), it
%% sends Q a message again.
procedure naf_bob(Key?, Key?, AgentToUserStream?, Stream(AgentContent), Constant, UserInStream).
naf_bob(Me, Q, Outs, Seen?, Told?,
        [msg(person, Me?, connect(Q?)), msg(person, Me?, send(Q?, hi)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    naf_bob_wait(Me?, Q?, Outs?, Seen, Told, Cmds).

procedure naf_bob_wait(Key?, Key?, AgentToUserStream?, Stream(AgentContent), Constant, UserInStream).
naf_bob_wait(Me, Q, [msg(agent, person, not_a_friend(F)) | Outs], [not_a_friend(F?) | Seen?], told, Cmds?) :-
    naf_bob_friend(Me?, Q?, Outs?, Seen, Cmds).
naf_bob_wait(Me, Q, [_ | Outs], Seen?, Told?, Cmds?) :-
    otherwise | naf_bob_wait(Me?, Q?, Outs?, Seen, Told, Cmds).
naf_bob_wait(_, _, [], [], untold, []).

procedure naf_bob_friend(Key?, Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
naf_bob_friend(Me, Q, [msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?],
               [msg(person, Me?, send(Q?, hello)) | Cmds?]) :-
    F? =?= Q? | naf_record(Outs?, Seen, Cmds).
naf_bob_friend(Me, Q, [_ | Outs], Seen?, Cmds?) :-
    otherwise | naf_bob_friend(Me?, Q?, Outs?, Seen, Cmds).
naf_bob_friend(_, _, [], [], []).

%% What a person is told of a send and of a befriending, recorded.
procedure naf_record(AgentToUserStream?, Stream(AgentContent), UserInStream).
naf_record([msg(agent, person, not_a_friend(F)) | Outs], [not_a_friend(F?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([msg(agent, person, received(F, T)) | Outs], [received(F?, T?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([_ | Outs], Seen?, Cmds?) :-
    otherwise | naf_record(Outs?, Seen, Cmds).
naf_record([], [], []).

%% =============================================================================
%% play_invite_timed(A, B, Ms): play_invite, timed --- the milliseconds from the
%% moment alice's person sends the invitation to the moment the root
%% channel's end reaches bob's execution of the mini-app: the first item on
%% its screen, its opened/1 (../pingapp/miniapp.glp), read as an item come and
%% not inspected; the clock is now/1, in milliseconds.
%% =============================================================================
exported procedure play_invite_timed(Key?, Key?, Integer).
play_invite_timed(A, B, Ms?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, greet, [B?], AlicePerson?, AliceSeen),
    alice_person_timed(A?, B?, C?, CSig?, AliceApp?, AliceOut?, AliceSeen?, T0, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, greet, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(B?, A?, C?, CSig?, yes, BobApp?, BobOut?, BobSeen?, BobIn),
    opened_at(BobUi?, T0?, Ms).

procedure(X) sink(Stream(X)?).
sink([_ | Xs]) :- sink(Xs?).
sink([]).

%% Alice's person as in play_invite, reading the clock as she sends the
%% invitation.
procedure alice_person_timed(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Integer, UserInStream).
alice_person_timed(Me, Q, M, CSig, Ui, Outs, Seen, T0?,
                   [msg(person, Me?, install(ping, M?, CSig?, Ui?)),
                    msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_wait_timed(Me?, Q?, Outs?, Seen?, T0, Cmds).

procedure alice_wait_timed(Key?, Key?, AgentToUserStream?, Stream(Opaque)?, Integer, UserInStream).
alice_wait_timed(Me, Q, [msg(agent, person, connected(F)) | _], Seen, T0?,
                 [msg(person, Me?, invite(ping, Q?)) | Cmds?]) :-
    F? =?= Q? |
    now(T0),
    person_done(Seen?, Cmds).
alice_wait_timed(Me, Q, [_ | Outs], Seen, T0?, Cmds?) :- otherwise | alice_wait_timed(Me?, Q?, Outs?, Seen?, T0, Cmds).
alice_wait_timed(_, _, [], _, 0, []).

%% opened_at(Ui, T0, Ms): the clock at the first item on bob's screen, his
%% opened/1, less T0.
procedure opened_at(Stream(Opaque)?, Integer?, Integer).
opened_at([_ | _], T0, Ms?) :- now(T1), Ms := T1? - T0?.
opened_at([], _, 0).

%% =============================================================================
%% sg_init(Id, Mode, Peers, NetIn): one super-app per isolate under :boot
%% (../../superapp_boot.glp): the social graph's agent on the isolate's network, the
%% mini-app read from the artefact beside this program and installed under the
%% compiler's key the person trusts, and the person's script by Mode, toward
%% the peers Peers whose keys the person told the agent --- under invite the
%% person invites the one peer, under consent the person consents to the one
%% peer's invitation.  What the mini-app shows its person goes to the person
%% (send_to_user/1), printed by the harness as [agent] term.
%% =============================================================================
procedure alice_person_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_person_boot(Me, Q, M, CK, CSig, Ui, Outs, Seen,
                  [msg(person, Me?, trust(CK?)),
                   msg(person, Me?, install(ping, M?, CSig?, Ui?)),
                   msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_wait(Me?, Q?, yes, Outs?, Seen?, Cmds).

procedure bob_person_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_person_boot(Me, Q, M, CK, CSig, Ui, Outs, Seen,
                [msg(person, Me?, trust(CK?)),
                 msg(person, Me?, install(ping, M?, CSig?, Ui?)),
                 msg(person, Me?, accept_invite(ping, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_wait(Me?, Q?, yes, Outs?, Seen?, Cmds).

%% =============================================================================
%% play_load(Name, Kind, Key): what load_file/2 makes of an artefact beside
%% this program --- module, with the compiler's key its certificate carries,
%% or text, with none (the artefact of a program refused a certificate).
%% =============================================================================
exported procedure play_load(String?, Constant, String).
play_load(N, Kind?, K?) :-
    load_file(N?, C),
    loaded(C?, Kind, K).

procedure loaded(Content?, Constant, String).
loaded(M, module, K?) :- module(M?) | decompose_module(M?, K, _, _).
loaded(S, text, none) :- string(S?) | true.

%% =============================================================================
%% play_install(Me, Name, App, Installed): Me's super-app installs, as mini-app App,
%% the artefact Name beside this program --- what load_file/2 gave, the
%% creator's certification the play signs over its source identity where it is
%% a Module --- and reports which mini-apps are installed afterwards: [App]
%% for a certified artefact, [] for one refused a certificate (load_file/2
%% gives its text, and the super-app installs no text).
%% =============================================================================
exported procedure play_install(Key?, String?, Constant?, Stream(Constant)).
play_install(Me, N, App, Installed?) :-
    ground(Me?) |
    load_file(N?, C),
    certified_or_not(C?, CSig),
    new_channel(Ui, Person),
    agent # agent(Me?, [msg(person, Me?, install(App?, C?, CSig?, Ui?)),
                        msg(person, Me?, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

procedure certified_or_not(Content?, String).
certified_or_not(M, CSig?) :- module(M?) | certified(M?, _, CSig).
certified_or_not(S, none) :- string(S?) | true.

%% =============================================================================
%% The super-app's refusal of a forgery (SGSG paper, Section 6.1): at each of
%% the four sites that take a signed term apart --- the creator's
%% certification at installation, the invitation, the invitee's undertaking
%% and the inviter's undertaking with the root channel --- a term that is not
%% a signed term is presented, the constant forged, which signature/2 reports
%% as unsigned, and the play shows the refusal taken: nothing is delivered for
%% it and the super-app carries on with the next message.  Each site is fed
%% directly, the person's or the friend's stream standing in for the channel
%% the term would have crossed; a forgery is refused before the friend or the
%% mini-app is looked up, so no friendship and no installation is set up.
%%
%% play_forged_cert(Me, Installed): Me installs pingapp's certified artefact
%% under a creator's certification that is not a signed term.
%% Expected: Installed = [] --- against play_install(Me, "pingapp.glpw", ping, I),
%% I = [ping], the same artefact under the play's own certification;
%% → succeeds.
%% =============================================================================
exported procedure play_forged_cert(Key?, Stream(Constant)).
play_forged_cert(Me, Installed?) :-
    ground(Me?) |
    load_file("pingapp.glpw", C),
    new_channel(Ui, Person),
    agent # agent(Me?, [msg(person, Me?, install(ping, C?, forged, Ui?)),
                        msg(person, Me?, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

%% play_forged_invite(A, B, Out): bob's super-app, B, receives from alice, A, an invitation
%% that is not a signed term, with one end of a root channel, and then a
%% text.
%% Expected: Out = [msg(agent, person, received(alice, hello))] --- the offer
%% was refused, nothing was delivered for it, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_invite(Key?, Key?, AgentToUserStream).
play_forged_invite(A, B, Out?) :-
    ground(A?), ground(B?) |
    root_end(End),
    agent # agent(B?, BobIn?,
                  [msg(A?, B?, invite(src, forged, End?)),
                   msg(A?, B?, text(hello))],
                  [user_output(BobOut), net_output(NetOut)]),
    until_received(BobOut?, Out, BobIn),
    sink(NetOut?).

%% play_forged_join(A, B, Out): alice's super-app, A, the inviter, receives from bob, B, an
%% undertaking that is not a signed term, and then a text.
%% Expected: Out = [msg(agent, person, received(bob, hello))] --- the join
%% was refused, no root channel was created, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_join(Key?, Key?, AgentToUserStream).
play_forged_join(A, B, Out?) :-
    ground(A?), ground(B?) |
    agent # agent(A?, AliceIn?,
                  [msg(B?, A?, join(src, t, forged)),
                   msg(B?, A?, text(hello))],
                  [user_output(AliceOut), net_output(NetOut)]),
    until_received(AliceOut?, Out, AliceIn),
    sink(NetOut?).

%% play_forged_root(A, B, Out): bob's super-app, B, the invitee, receives from alice, A,
%% her answer to a join under an undertaking that is not a signed term, and
%% then a text.
%% Expected: Out = [msg(agent, person, received(alice, hello))] --- the end
%% was not accepted, nothing was delivered, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_root(Key?, Key?, AgentToUserStream).
play_forged_root(A, B, Out?) :-
    ground(A?), ground(B?) |
    agent # agent(B?, BobIn?,
                  [msg(A?, B?, root(src, t, forged)),
                   msg(A?, B?, text(hello))],
                  [user_output(BobOut), net_output(NetOut)]),
    until_received(BobOut?, Out, BobIn),
    sink(NetOut?).

%% until_received(Outs, Seen, Cmds): the person watching the super-app's
%% stream copies everything delivered up to the first text received, at which
%% the person's stream closes.
procedure until_received(AgentToUserStream?, AgentToUserStream, UserInStream).
until_received([msg(agent, person, received(F, Text)) | _],
               [msg(agent, person, received(F?, Text?))], []).
until_received([M | Outs], [M? | Seen?], Cmds?) :-
    otherwise | until_received(Outs?, Seen, Cmds).
until_received([], [], []).

%% root_end(End): one end of a fresh root channel, at Opaque, as root_step/13
%% makes it, the other end dropped.
procedure root_end(RootChannel(Opaque)).
root_end(E?) :- new_channel(E, _) | true.

%% =============================================================================
%% The warm call on three smartphones (../../superapp3_boot.glp): alice, bob
%% and carol, carol a friend of both, alice and bob not friends.  alice
%% invites carol to the mini-app and carol invites bob; alice's execution,
%% greeted by carol, sends her probe(W), the end of a fresh variable, which
%% carol's execution forwards to bob's; bob's execution assigns it, bob's
%% runtime holds the assignment --- the end reached bob under alice's name from
%% carol --- and reports the held link; bob's mini-app asks for a warm call;
%% bob's social graph asks carol for an introduction to alice, which carol's
%% person allows; alice's and bob's persons accept it and befriend; bob's
%% social graph sends alice warm_call(ping, Name); alice's person having
%% consented, alice invites bob, bob joins, the handshake opens their root
%% channel, bob's social graph releases the held end, and the value reaches
%% alice, whose execution reports got(hello_from_bob).  Every volition is the
%% person's, given here in advance.  Nothing closes: the harness settles.
%% =============================================================================
exported procedure sg_init(Key?, Constant?, List(Key)?, NetInStream?).
sg_init(Me, invite, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, Me?, greet, [Q?], Person?, Screen),
    tee(Screen?, Show, Seen),
    send_to_user(Show?),
    alice_person_boot(Me?, Q?, C?, CK?, CSig?, App?, Out?, Seen?, In).
sg_init(Me, consent, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, Me?, greet, [Q?], Person?, Screen),
    tee(Screen?, Show, Seen),
    send_to_user(Show?),
    bob_person_boot(Me?, Q?, C?, CK?, CSig?, App?, Out?, Seen?, In).

%% The currency on two smartphones (../../coins_boot.glp): each person trusts
%% the compiler's key, installs the certified currency with its own end of a
%% person channel, and its scripted person, Currencies' own, plays the swap of
%% play_coins under its role, alice for the inviter and bob for the invitee,
%% the roles of Currencies' script; what the currency shows a person goes to
%% the person, printed by the harness.
sg_init(Me, coins_invite, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_coins_boot(Me?, Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, alice, [Q?], PersonEnd?, Screen),
    send_to_user(Screen?).
sg_init(Me, coins_consent, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_coins_boot(Me?, Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, bob, [Q?], PersonEnd?, Screen),
    send_to_user(Screen?).

%% The child-safe platform on two smartphones (../../cssn_boot.glp), as the
%% currency's clauses above: each person trusts the compiler's key, installs
%% the certified platform with its own end of a person channel, and its
%% scripted person, CSSN's own, greets the peer under the role greeter once
%% the conversation is adopted, or watches under the role onlooker.
sg_init(Me, cssn_invite, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("childsafe.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_cssn_boot(Me?, Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, greeter, [Q?], PersonEnd?, Seen),
    send_to_user(Seen?).
sg_init(Me, cssn_consent, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("childsafe.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_cssn_boot(Me?, Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, onlooker, [Q?], PersonEnd?, Seen),
    send_to_user(Seen?).

%% Both mini-apps on two smartphones (../../both_boot.glp): each person trusts
%% the compiler's key, installs both certified mini-apps with their own
%% person channels, and runs both platforms over the one friendship.
sg_init(Me, both_invite, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", CC),
    certified(CC?, CK, CCSig),
    load_file("childsafe.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEnd, CoinsPerson),
    new_channel(CssnEnd, CssnPerson),
    alice_both_boot(Me?, Q?, CK?, CC?, CCSig?, CoinsEnd?, CS?, CSSig?, CssnEnd?, Out?, In),
    miniapp_person_run(CC?, Me?, alice, [Q?], CoinsPerson?, Screen),
    send_to_user(Screen?),
    miniapp_person_run(CS?, Me?, greeter, [Q?], CssnPerson?, Seen),
    send_to_user(Seen?).
sg_init(Me, both_consent, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", CC),
    certified(CC?, CK, CCSig),
    load_file("childsafe.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEnd, CoinsPerson),
    new_channel(CssnEnd, CssnPerson),
    bob_both_boot(Me?, Q?, CK?, CC?, CCSig?, CoinsEnd?, CS?, CSSig?, CssnEnd?, Out?, In),
    miniapp_person_run(CC?, Me?, bob, [Q?], CoinsPerson?, Screen),
    send_to_user(Screen?),
    miniapp_person_run(CS?, Me?, onlooker, [Q?], CssnPerson?, Seen),
    send_to_user(Seen?).

%% The warm call: each person's screen is the mini-app's scripted person's,
%% under its role watch, every item to the person.  The anchor's peers are
%% the friend she invites and the holder whose warm call she accepts; the
%% holder's, the friend he connects to and the anchor; the friend's, the
%% anchor who invites her and the holder she invites.
sg_init(Me, warm_anchor, [F, H], NetIn) :-
    ground(Me?), ground(F?), ground(H?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, Me?, watch, [F?, H?], Person?, Screen),
    send_to_user(Screen?),
    scripted_home(Me?, Out?, Script, ScriptCmds?, In),
    alice_warm(Me?, F?, H?, C?, CK?, CSig?, App?, Script?, ScriptCmds).
sg_init(Me, warm_holder, [F, A], NetIn) :-
    ground(Me?), ground(F?), ground(A?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, Me?, watch, [F?, A?], Person?, Screen),
    send_to_user(Screen?),
    scripted_home(Me?, Out?, Script, ScriptCmds?, In),
    bob_warm(Me?, F?, A?, C?, CK?, CSig?, App?, Script?, ScriptCmds).
sg_init(Me, warm_friend, [A, H], NetIn) :-
    ground(Me?), ground(A?), ground(H?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, Me?, watch, [A?, H?], Person?, Screen),
    send_to_user(Screen?),
    scripted_home(Me?, Out?, Script, ScriptCmds?, In),
    carol_warm(Me?, A?, H?, C?, CK?, CSig?, App?, Script?, ScriptCmds).
%% A mode or a list of peers no clause above takes starts nothing.
sg_init(_, _, _, _) :- otherwise | true.

%% The anchor's person, Me: install; consent in advance to a warm call from
%% the holder H; cold-call the friend F, invite F once connected; consent on
%% its card to F's introduction to H.
procedure alice_warm(Key?, Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, Stream(Output)?, UserInStream).
alice_warm(Me, F, H, C, CK, CSig, Ui, Outs,
           [msg(person, Me?, trust(CK?)),
            msg(person, Me?, install(ping, C?, CSig?, Ui?)),
            msg(person, Me?, accept_warm_call(H?)),
            msg(person, Me?, connect(F?)) | Cmds?]) :-
    ground(Me?), ground(F?), ground(H?) |
    alice_warm_run(Me?, F?, H?, Outs?, Cmds).

procedure alice_warm_run(Key?, Key?, Key?, Stream(Output)?, UserInStream).
alice_warm_run(Me, F, H, [msg(agent, person, connected(X)) | Outs],
               [msg(person, Me?, invite(ping, F?)) | Cmds?]) :-
    X? =?= F? |
    send_to_user([sg(connected(X?))]),
    alice_warm_run(Me?, F?, H?, Outs?, Cmds).
alice_warm_run(Me, F, H, [msg(agent, person, connected(X)) | Outs], Cmds?) :-
    X? =?= H? |
    send_to_user([sg(connected(X?))]),
    alice_warm_run(Me?, F?, H?, Outs?, Cmds).
alice_warm_run(Me, F, H, [msg(agent, person, befriend_intro(I, O)) | Outs], Cmds?) :-
    I? =?= F?, O? =?= H? |
    send_to_user([sg(intro_from(I?, O?))]),
    alice_warm_run(Me?, F?, H?, Outs?, Cmds).
alice_warm_run(Me, F, H, [_ | Outs], Cmds?) :- otherwise | alice_warm_run(Me?, F?, H?, Outs?, Cmds).
alice_warm_run(_, _, _, [], []).

%% The holder's person, Me: install; consent in advance to the friend F's and
%% the anchor A's invitations and to a warm call with A; cold-call F; consent
%% on its card to F's introduction to A.
procedure bob_warm(Key?, Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, Stream(Output)?, UserInStream).
bob_warm(Me, F, A, C, CK, CSig, Ui, Outs,
         [msg(person, Me?, trust(CK?)),
          msg(person, Me?, install(ping, C?, CSig?, Ui?)),
          msg(person, Me?, accept_invite(ping, F?)),
          msg(person, Me?, accept_invite(ping, A?)),
          msg(person, Me?, accept_warm_call(A?)),
          msg(person, Me?, connect(F?)) | Cmds?]) :-
    ground(Me?), ground(F?), ground(A?) |
    bob_warm_run(F?, A?, Outs?, Cmds).

procedure bob_warm_run(Key?, Key?, Stream(Output)?, UserInStream).
bob_warm_run(F, A, [msg(agent, person, befriend_intro(I, O)) | Outs], Cmds?) :-
    I? =?= F?, O? =?= A? |
    send_to_user([sg(intro_from(I?, O?))]),
    bob_warm_run(F?, A?, Outs?, Cmds).
bob_warm_run(F, A, [msg(agent, person, connected(Who)) | Outs], Cmds?) :-
    ground(Who?) |
    send_to_user([sg(connected(Who?))]),
    bob_warm_run(F?, A?, Outs?, Cmds).
bob_warm_run(F, A, [_ | Outs], Cmds?) :- otherwise | bob_warm_run(F?, A?, Outs?, Cmds).
bob_warm_run(_, _, [], []).

%% The friend's person, Me: install; consent in advance to the anchor A's
%% invitation and allow the introduction of the holder H to A; consent on
%% their cards to both cold calls; invite H once connected.
procedure carol_warm(Key?, Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, Stream(Output)?, UserInStream).
carol_warm(Me, A, H, C, CK, CSig, Ui, Outs,
           [msg(person, Me?, trust(CK?)),
            msg(person, Me?, install(ping, C?, CSig?, Ui?)),
            msg(person, Me?, accept_invite(ping, A?)),
            msg(person, Me?, allow_intro(H?, A?)) | Cmds?]) :-
    ground(Me?), ground(A?), ground(H?) |
    carol_warm_run(Me?, A?, H?, Outs?, Cmds).

procedure carol_warm_run(Key?, Key?, Key?, Stream(Output)?, UserInStream).
carol_warm_run(Me, A, H, [msg(agent, person, befriend(Who)) | Outs], Cmds?) :-
    ground(Who?) |
    send_to_user([sg(cold_call(Who?))]),
    carol_warm_run(Me?, A?, H?, Outs?, Cmds).
carol_warm_run(Me, A, H, [msg(agent, person, connected(X)) | Outs],
               [msg(person, Me?, invite(ping, H?)) | Cmds?]) :-
    X? =?= H? |
    send_to_user([sg(connected(X?))]),
    carol_warm_run(Me?, A?, H?, Outs?, Cmds).
carol_warm_run(Me, A, H, [msg(agent, person, connected(X)) | Outs], Cmds?) :-
    X? =?= A? |
    send_to_user([sg(connected(X?))]),
    carol_warm_run(Me?, A?, H?, Outs?, Cmds).
carol_warm_run(Me, A, H, [_ | Outs], Cmds?) :- otherwise | carol_warm_run(Me?, A?, H?, Outs?, Cmds).
carol_warm_run(_, _, _, [], []).

%% =============================================================================
%% play_coins(A, B, ScreenA, ScreenB): the currency mini-app (Currencies'
%% programs/currencies/coins/currency, its artefact currency.glpw beside this
%% program) hosted by the super-app: alice and bob install it with its two
%% certifications, alice befriends bob and invites him, and the handshake
%% opens a root channel of the currency's protocol between their two
%% executions, each activated by run/3 with its three grants.  The persons
%% hold the other ends of the person channels: each is the currency's own
%% scripted person, activated from the same module value under its role ---
%% alice mints 2 and offers her 2 for bob's 2, bob mints 2 and accepts ---
%% the currency's own swap over the conversation the social graph delivered.
%% Expected: ScreenA = [opened(bob), minted(2), holdings([lot(alice, 2)]),
%% holdings([]), swap_done(bob), holdings([lot(bob, 2)]) | _], ScreenB =
%% [opened(alice), minted(2), holdings([lot(bob, 2)]), swap_done(alice),
%% holdings([lot(alice, 2)]) | _], → suspended (the agents' request forms
%% stay open and the person channels never close).
%% ../../coins_boot.glp runs the same swap on two smartphones.
%% =============================================================================
exported procedure play_coins(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_coins(A, B, ScreenA?, ScreenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("currency.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_coins_person(A?, B?, C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, A?, alice, [B?], PersonEndA?, ScreenA),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_coins_person(B?, A?, C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, B?, bob, [A?], PersonEndB?, ScreenB).

%% The installers of play_coins: each installs the currency with its end of
%% its person channel; the play writes no date, the currency keeping none.
procedure alice_coins_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_coins_person(Me, Q, C, CSig, AppEnd, Outs,
                   [msg(person, Me?, install(currency, C?, CSig?, AppEnd?)),
                    msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_coins_run(Me?, Q?, Outs?, Cmds).

procedure alice_coins_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_coins_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
                [msg(person, Me?, invite(currency, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_coins_run(Me?, Q?, Outs?, Cmds).
alice_coins_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_coins_run(Me?, Q?, Outs?, Cmds).
alice_coins_run(_, _, [], []).

procedure bob_coins_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_coins_person(Me, Q, C, CSig, AppEnd, Outs,
                 [msg(person, Me?, install(currency, C?, CSig?, AppEnd?)),
                  msg(person, Me?, accept_invite(currency, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_coins_run(Me?, Q?, Outs?, Cmds).

procedure bob_coins_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_coins_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
              [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_coins_run(Me?, Q?, Outs?, Cmds).
bob_coins_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_coins_run(Me?, Q?, Outs?, Cmds).
bob_coins_run(_, _, [], []).


%% The two persons of both platforms under :boot, each trusting the compiler's
%% key once for the two artefacts it signed.
procedure alice_both_boot(Key?, Key?, String?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_both_boot(Me, Q, CK, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                [msg(person, Me?, trust(CK?)),
                 msg(person, Me?, install(currency, CC?, CCSig?, CoinsEnd?)),
                 msg(person, Me?, install(childsafe, CS?, CSSig?, CssnEnd?)),
                 msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_both_run(Me?, Q?, Outs?, Cmds).

procedure bob_both_boot(Key?, Key?, String?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_both_boot(Me, Q, CK, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
              [msg(person, Me?, trust(CK?)),
               msg(person, Me?, install(currency, CC?, CCSig?, CoinsEnd?)),
               msg(person, Me?, install(childsafe, CS?, CSSig?, CssnEnd?)),
               msg(person, Me?, accept_invite(currency, Q?)),
               msg(person, Me?, accept_invite(childsafe, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_both_run(Me?, Q?, Outs?, Cmds).

%% The child-safe platform's two persons under :boot.
procedure alice_cssn_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_cssn_boot(Me, Q, C, CK, CSig, AppEnd, Outs,
                [msg(person, Me?, trust(CK?)),
                 msg(person, Me?, install(childsafe, C?, CSig?, AppEnd?)),
                 msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_cssn_run(Me?, Q?, Outs?, Cmds).

procedure bob_cssn_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_cssn_boot(Me, Q, C, CK, CSig, AppEnd, Outs,
              [msg(person, Me?, trust(CK?)),
               msg(person, Me?, install(childsafe, C?, CSig?, AppEnd?)),
               msg(person, Me?, accept_invite(childsafe, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_cssn_run(Me?, Q?, Outs?, Cmds).

%% The same two persons under :boot, each trusting the compiler's key first.
procedure alice_coins_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_coins_boot(Me, Q, C, CK, CSig, AppEnd, Outs,
                 [msg(person, Me?, trust(CK?)),
                  msg(person, Me?, install(currency, C?, CSig?, AppEnd?)),
                  msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_coins_run(Me?, Q?, Outs?, Cmds).

procedure bob_coins_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_coins_boot(Me, Q, C, CK, CSig, AppEnd, Outs,
               [msg(person, Me?, trust(CK?)),
                msg(person, Me?, install(currency, C?, CSig?, AppEnd?)),
