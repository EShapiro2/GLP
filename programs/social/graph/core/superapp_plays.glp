%% superapp_plays.glp --- distribution with an invitation, the handshake,
%% activation by run/3 with the three grants, and the attestation (GSG paper,
%% Sections 3, 4, 5.5 and 6), played by two social-graph agents in one heap,
%% the network a two-way crossbar for cold calls, and under :boot
%% (../../superapp_boot.glp) by two isolates with their own keys.  The
%% programs the plays install, distribute and activate are compiled apps of
%% programs/apps, GKK's, GSN's and GC's, and CSSN's programs/cssn, each compiled
%% from its contract (GPD's definition of a program, ../Programs.txt); the
%% other certified mini-app is Currencies' denominated; the super-app reads their artefacts with load_file/2.  The
%% persons are scripted on the agents' person streams.
%%
%% The super-app holds no declaration of a mini-app's types.  A play mints a
%% mini-app's person channel at Opaque, installs the mini-app with one end and
%% hands the other to the mini-app's own scripted person, the instance at the
%% mini-app's type of the second template miniapp_person/5, activated from the
%% same module value as the entry (miniapp_person_run/6); the screen it reports
%% comes back to the caller at Opaque, or, under :boot, goes to the person
%% (GSG, 2026-10-13 18:52 UTC, O5, Udi: approved).  A play never inspects
%% what a screen carries: it passes it on, and reads only that an item came
%% or that the screen closed.
%%
%% No clause here names a peer by an atom: an agent is its public key, and a
%% readable name such as alice is a variable standing for a key (IGLP, Remark
%% "Agent Names").  Each play is given the keys of its agents by the goal that
%% starts it, and sg_init/4 the keys of the peers the person knows, which an
%% agent learns from its person (IGLP, Implementation Notes, "Boot"); the
%% persons' scripts take them as arguments.

imported procedure agent#agent(Key?, UserInStream?, NetInStream?, OutputsList?).
imported procedure home#home(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
imported procedure home#dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).
imported procedure place#os_phone(Key?, List(Key)?, List(RvServer)?, Directory?, UserInStream?, NetInStream?, AgentToUserStream, NetOutStream).

%% The network between the two agents of a play, A and B: their network
%% outputs merged, and each message delivered to the agent its destination
%% names, by route_to/4 (self.glp's).
procedure crossbar2(Key?, Key?, NetOutStream?, NetOutStream?, NetInStream, NetInStream).
crossbar2(A, B, AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route_to(A?, All?, AIn, Rest),
    route_to(B?, Rest?, BIn, _).

procedure(X) tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

%% miniapp_person_run(M, Id, Role, Ps, PEnd, Screen): the mini-app M's scripted
%% person, under the role Role and with the keys Ps the person knows, the
%% readable names of the play's other persons standing for them, activated,
%% from the module value, by run/3 at the type identity of
%% the second template's opaque instance at the type its exports record for
%% miniapp_person/5, as the agent activates the entry (agent.glp,
%% activate/6), on the person's end PEnd of the person channel whose other end
%% the play installs the mini-app with; Screen the screen it reports, at
%% Opaque.  The play mints the channel and hands its two ends to two
%% activations of one module value, so it checks that the module records the
%% entry's person-channel type and the person's at one type, the first of the
%% entry's two identities and the first of the person's two, its second the
%% screen's type, the mini-app's own (vGLP 2026-10-16 11:25 UTC, item 4; TGLP modules.tex, "The
%% invitation discipline": "opaque_type yields one identity for the two
%% entries, which the host checks"; GLP, 2026-10-13 20:22 UTC, C; vGLP
%% 2026-10-14 13:21 UTC, S2).  Where they are not, no person runs: its end of
%% the person channel is held for good (hold_person/1) and its screen is empty.
procedure miniapp_person_run(Content?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, Ps, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/3, M?, H0),
    opaque_type(miniapp_person/5, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, Ps?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D, S], M, Id, Role, Ps, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/5, [D?, S?], T),
    run(miniapp_person(Id?, Role?, Ps?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

%% A certified mini-app: its artefact beside this program, written by the
%% REPL's :artefact from its directory and read with load_file/2 --- a Module
%% where its certificate verifies, its text otherwise.  certified/4 gives the
%% module, the compiler's key its certificate carries, and the developer's
%% warranty: the person publishes the program, GPD:1, signing publish(Src, Cmp),
%% its source and compiled identities, under the person's key, and installs it
%% as their own, GPD:4.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, Cmp),
    self_key(K),
    sign(publish(Src?, Cmp?), K?, CSig).

%% =============================================================================
%% play_invite(A, B, AliceUi, BobUi): alice, A, installs GSN's app, the
%% program compiled from GSN's contract (programs/apps/gsn), befriends bob and
%% invites him; bob installs it and consents; the handshake opens the root
%% channel and the two executions converse over it.  Each person's screen is
%% the app's scripted person's, under its roles alice and bob (../../../apps/gsn/person.glp),
%% the views its agent writes: the first written when the execution is
%% activated, and the later ones as the two agents come to know each other and
%% befriend in the app, which only the conversation carries.  The screens do
%% not close, the app's execution never ending.
%% Expected: AliceUi = [view(alice, [], [], [], _), ... view(alice, [friend(bob),
%% knows(bob), identity, person], [bob], [], _) ... | _], BobUi likewise,
%% → suspended.
%% =============================================================================
exported procedure play_invite(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_invite(A, B, AliceUi?, BobUi?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("gsn.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, alice, [B?], AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_person(A?, B?, C?, CSig?, yes, AliceApp?, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, bob, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(B?, A?, C?, CSig?, yes, BobApp?, BobOut?, BobSeen?, BobIn).

%% =============================================================================
%% play_invite_declined(A, B, AliceUi, BobUi): as above, but bob's person declines; no conversation
%% opens and neither execution is activated, so neither person's screen
%% shows an item; the person channel never ends (vGLP, Section 6.3), so
%% neither screen closes either.
%% Expected: AliceUi and BobUi unbound, → suspended.
%% =============================================================================
exported procedure play_invite_declined(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_invite_declined(A, B, AliceUi?, BobUi?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("gsn.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, alice, [B?], AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_person(A?, B?, C?, CSig?, no, AliceApp?, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, bob, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(B?, A?, C?, CSig?, no, BobApp?, BobOut?, BobSeen?, BobIn).

%% Alice's person, Me, inviting Q: install the mini-app, with its end of the
%% person channel, cold-call Q, and once connected invite Q.  Wait = yes:
%% keep the person stream open until the mini-app's screen closes, which GSN's
%% app's never does; no: close it after inviting.
procedure alice_person(Key?, Key?, Content?, String?, Decision?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_person(Me, Q, M, CSig, Wait, Ui, Outs, Seen,
             [msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
              msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_wait(Me?, Q?, Wait?, Outs?, Seen?, Cmds).

procedure alice_wait(Key?, Key?, Decision?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_wait(Me, Q, yes, [msg(agent, person, connected(F)) | _], Seen,
           [msg(person, Me?, invite(gsn, Q?)) | Cmds?]) :-
    F? =?= Q? | person_done(Seen?, Cmds).
alice_wait(Me, Q, no, [msg(agent, person, connected(F)) | _], _,
           [msg(person, Me?, invite(gsn, Q?))]) :-
    F? =?= Q? | true.
alice_wait(Me, Q, W, [_ | Outs], Seen, Cmds?) :- otherwise | alice_wait(Me?, Q?, W?, Outs?, Seen?, Cmds).
alice_wait(_, _, _, [], _, []).

%% Close the person stream once the mini-app's screen has closed, which it
%% does where the mini-app's person stops or the mini-app ends.  The screen's
%% items are passed over, never inspected.
procedure person_done(Stream(Opaque)?, UserInStream).
person_done([_ | Seen], Cmds?) :- person_done(Seen?, Cmds).
person_done([], []).

%% Bob's person, Me, invited by Q: install the mini-app and give (or refuse)
%% consent before the offer arrives; answer Q's cold call; then wait for the
%% mini-app's screen to close, or close.
procedure bob_person(Key?, Key?, Content?, String?, Decision?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_person(Me, Q, M, CSig, yes, Ui, Outs, Seen,
           [msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
            msg(person, Me?, accept_invite(gsn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_wait(Me?, Q?, yes, Outs?, Seen?, Cmds).
bob_person(Me, Q, M, CSig, no, Ui, Outs, Seen,
           [msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
            msg(person, Me?, decline_invite(gsn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_wait(Me?, Q?, no, Outs?, Seen?, Cmds).

procedure bob_wait(Key?, Key?, Decision?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_wait(Me, Q, yes, [msg(agent, person, befriend(F, P)) | _], Seen,
         [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? | person_done(Seen?, Cmds).
bob_wait(Me, Q, no, [msg(agent, person, befriend(F, P)) | _], _,
         [msg(person, Me?, decision(yes, F?, P?))]) :-
    F? =?= Q? | true.
bob_wait(Me, Q, W, [_ | Outs], Seen, Cmds?) :- otherwise | bob_wait(Me?, Q?, W?, Outs?, Seen?, Cmds).
bob_wait(_, _, _, [], _, []).

%% =============================================================================
%% play_attest(A, B, S, K, H, T): alice, A, and bob, B, befriend; alice reads back the attestation her
%% social graph minted at the commit, and the play takes it apart.
%% Expected: T = attest(alice, bob), K the person's key, H this program's
%% source identity, → succeeds.
%% =============================================================================
exported procedure play_attest(Key?, Key?, String, String, String, Attestation).
play_attest(A, B, S?, K?, H?, T?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_attest(A?, B?, AliceOut?, S, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_answer(B?, A?, BobOut?, BobIn),
    signature(S?, Sg),
    attested(Sg?, K, H, T).

%% attested(Sg, K, H, T): the attestation taken apart, the play matching
%% signed(K, H, attest(I, O)), the two keys strings, and exercising no
%% refusal; the other clauses, which the checker requires of every
%% alternative of Signature, assign the three the constant unsigned, and the
%% play's checks never reach them.
procedure attested(Signature?, String, String, Attestation).
attested(signed(K, H, attest(I, O)), K?, H?, At?) :- string(I?), string(O?) | attest_of(I?, O?, At).

attested(signed(_, _, _), unsigned, unsigned, unsigned) :- otherwise | true.
attested(unsigned, unsigned, unsigned, unsigned).

%% attest_of(I, O, At): the attestation of the two keys, which attested/4 read from inside the signed term and typed by their guards, so built in the body (TGLP, Type checking of guards).
procedure attest_of(Key?, Key?, Attestation).
attest_of(I, O, attest(I?, O?)).

procedure alice_attest(Key?, Key?, AgentToUserStream?, String, UserInStream).
alice_attest(Me, Q, Outs, S?, [msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_attest_wait(Me?, Q?, Outs?, S, Cmds).

procedure alice_attest_wait(Key?, Key?, AgentToUserStream?, String, UserInStream).
alice_attest_wait(Me, Q, [msg(agent, person, connected(F)) | _], S?,
                  [msg(person, Me?, attestation(Q?, S))]) :-
    F? =?= Q? | true.
alice_attest_wait(Me, Q, [_ | Outs], S?, Cmds?) :- otherwise | alice_attest_wait(Me?, Q?, Outs?, S, Cmds).
alice_attest_wait(_, _, [], none, []).

procedure bob_answer(Key?, Key?, AgentToUserStream?, UserInStream).
bob_answer(Me, Q, [msg(agent, person, befriend(F, P)) | _],
           [msg(person, Me?, decision(yes, F?, P?))]) :-
    F? =?= Q? | true.
bob_answer(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_answer(Me?, Q?, Outs?, Cmds).
bob_answer(_, _, [], []).

%% =============================================================================
%% play_both_ways(P, Q, A, B): alice, P, and bob, Q, cold-call each other at once, and each person
%% consents to the other's call (GSG Section 5.1; 2026-10-02 task, item 5).
%% Two befriendings of the same two people are under way at once, and alice,
%% the smaller identity, proposes in both: she mints the friend channel for
%% the first whose consent she reads and conveys already_friends for the
%% other, so each agent ends with one friend channel --- and each person is
%% told connected once, which convey/7 and adopt/6 tell where they install
%% one.  The persons stand at the end, their streams open, so what each was
%% told is the whole of it at quiescence.
%% Expected: A = [connected(bob) | _], B = [connected(alice) | _],
%% → suspended.
%% =============================================================================
exported procedure play_both_ways(Key?, Key?, Stream(AgentContent), Stream(AgentContent)).
play_both_ways(P, Q, A?, B?) :-
    ground(P?), ground(Q?) |
    crossbar2(P?, Q?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(P?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    both_ways_person(P?, Q?, AliceOut?, A, AliceIn),
    agent # agent(Q?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    both_ways_person(Q?, P?, BobOut?, B, BobIn).

%% A person who cold-calls the other and consents to the other's call, the
%% pending value passed back as it came; what the agent tells it of a
%% befriending's outcome, connected or rejected, is what it saw.
procedure both_ways_person(Key?, Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
both_ways_person(Me, Other, Outs, Seen?, [msg(person, Me?, connect(Other?)) | Cmds?]) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).

procedure both_ways_answer(Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
both_ways_answer(Me, [msg(agent, person, befriend(From, P)) | Outs], Seen?,
                 [msg(person, Me?, decision(yes, From?, P?)) | Cmds?]) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?], Cmds?) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [msg(agent, person, rejected(F)) | Outs], [rejected(F?) | Seen?], Cmds?) :-
    both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(Me, [_ | Outs], Seen?, Cmds?) :-
    otherwise | both_ways_answer(Me?, Outs?, Seen, Cmds).
both_ways_answer(_, [], [], []).

%% =============================================================================
%% play_not_a_friend(P, Q, A, B): a message the person addresses to someone who is not
%% their friend is not sent, and the agent tells the person so (GSG Section
%% 5.1; GSG 2026-10-09 18:48 UTC).  Alice's person sends bob a message before
%% either has called the other, and is told not_a_friend(bob).  Bob's person
%% calls alice --- bob, the larger identity, accepts, his call his consent ---
%% and sends her a message at once, between his acceptance and the
%% conveyance, and is told not_a_friend(alice).  Alice's person consents to
%% bob's call only once bob was told, so his send precedes the conveyance by
%% causality and not by scheduling.  Alice, the proposer, mints the friend
%% channel and conveys it; each person is told connected, and bob's person,
%% told connected(alice), sends her a message again, which reaches her.  The
%% persons stand at the end, their streams open.
%% Expected: A = [not_a_friend(bob), connected(bob), received(bob, hello) | _],
%% B = [not_a_friend(alice), connected(alice) | _], → suspended.
%% =============================================================================
exported procedure play_not_a_friend(Key?, Key?, Stream(AgentContent), Stream(AgentContent)).
play_not_a_friend(P, Q, A?, B?) :-
    ground(P?), ground(Q?) |
    crossbar2(P?, Q?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(P?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    naf_alice(P?, Q?, AliceOut?, Told?, A, AliceIn),
    agent # agent(Q?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    naf_bob(Q?, P?, BobOut?, B, Told, BobIn).

%% Alice's person, Me, sends Q a message, and consents to Q's call once Q
%% was told not_a_friend(Me), the pending value passed back as it came.
procedure naf_alice(Key?, Key?, AgentToUserStream?, Constant?, Stream(AgentContent), UserInStream).
naf_alice(Me, Q, Outs, Told, Seen?, [msg(person, Me?, send(Q?, hi)) | Cmds?]) :-
    ground(Me?) |
    naf_alice_wait(Me?, Outs?, Told?, Seen, Cmds).

procedure naf_alice_wait(Key?, AgentToUserStream?, Constant?, Stream(AgentContent), UserInStream).
naf_alice_wait(Me, [msg(agent, person, not_a_friend(F)) | Outs], Told, [not_a_friend(F?) | Seen?], Cmds?) :-
    naf_alice_wait(Me?, Outs?, Told?, Seen, Cmds).
naf_alice_wait(Me, [msg(agent, person, befriend(From, P)) | Outs], told, Seen?,
               [msg(person, Me?, decision(yes, From?, P?)) | Cmds?]) :-
    naf_record(Outs?, Seen, Cmds).
naf_alice_wait(Me, [_ | Outs], Told, Seen?, Cmds?) :-
    otherwise | naf_alice_wait(Me?, Outs?, Told?, Seen, Cmds).
naf_alice_wait(_, [], _, [], []).

%% Bob's person, Me, calls Q and sends Q a message at once; told
%% not_a_friend(Q), it lets Q's person consent, and told connected(Q), it
%% sends Q a message again.
procedure naf_bob(Key?, Key?, AgentToUserStream?, Stream(AgentContent), Constant, UserInStream).
naf_bob(Me, Q, Outs, Seen?, Told?,
        [msg(person, Me?, connect(Q?)), msg(person, Me?, send(Q?, hi)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    naf_bob_wait(Me?, Q?, Outs?, Seen, Told, Cmds).

procedure naf_bob_wait(Key?, Key?, AgentToUserStream?, Stream(AgentContent), Constant, UserInStream).
naf_bob_wait(Me, Q, [msg(agent, person, not_a_friend(F)) | Outs], [not_a_friend(F?) | Seen?], told, Cmds?) :-
    naf_bob_friend(Me?, Q?, Outs?, Seen, Cmds).
naf_bob_wait(Me, Q, [_ | Outs], Seen?, Told?, Cmds?) :-
    otherwise | naf_bob_wait(Me?, Q?, Outs?, Seen, Told, Cmds).
naf_bob_wait(_, _, [], [], untold, []).

procedure naf_bob_friend(Key?, Key?, AgentToUserStream?, Stream(AgentContent), UserInStream).
naf_bob_friend(Me, Q, [msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?],
               [msg(person, Me?, send(Q?, hello)) | Cmds?]) :-
    F? =?= Q? | naf_record(Outs?, Seen, Cmds).
naf_bob_friend(Me, Q, [_ | Outs], Seen?, Cmds?) :-
    otherwise | naf_bob_friend(Me?, Q?, Outs?, Seen, Cmds).
naf_bob_friend(_, _, [], [], []).

%% What a person is told of a send and of a befriending, recorded.
procedure naf_record(AgentToUserStream?, Stream(AgentContent), UserInStream).
naf_record([msg(agent, person, not_a_friend(F)) | Outs], [not_a_friend(F?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([msg(agent, person, connected(F)) | Outs], [connected(F?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([msg(agent, person, received(F, T)) | Outs], [received(F?, T?) | Seen?], Cmds?) :-
    naf_record(Outs?, Seen, Cmds).
naf_record([_ | Outs], Seen?, Cmds?) :-
    otherwise | naf_record(Outs?, Seen, Cmds).
naf_record([], [], []).

%% =============================================================================
%% play_invite_timed(A, B, Ms): play_invite, timed --- the milliseconds from the
%% moment alice's person sends the invitation to the moment the root
%% channel's end reaches bob's execution of the mini-app: the first item on
%% its screen, the first view its agent writes when it is activated
%% (../../../apps/gsn/person.glp), read as an item come and not inspected; the clock is
%% now/1, in milliseconds.
%% =============================================================================
exported procedure play_invite_timed(Key?, Key?, Integer).
play_invite_timed(A, B, Ms?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("gsn.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, alice, [B?], AlicePerson?, AliceSeen),
    alice_person_timed(A?, B?, C?, CSig?, AliceApp?, AliceOut?, AliceSeen?, T0, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, bob, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_person(B?, A?, C?, CSig?, yes, BobApp?, BobOut?, BobSeen?, BobIn),
    opened_at(BobUi?, T0?, Ms).

procedure(X) sink(Stream(X)?).
sink([_ | Xs]) :- sink(Xs?).
sink([]).

%% Alice's person as in play_invite, reading the clock as she sends the
%% invitation.
procedure alice_person_timed(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Integer, UserInStream).
alice_person_timed(Me, Q, M, CSig, Ui, Outs, Seen, T0?,
                   [msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
                    msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_wait_timed(Me?, Q?, Outs?, Seen?, T0, Cmds).

procedure alice_wait_timed(Key?, Key?, AgentToUserStream?, Stream(Opaque)?, Integer, UserInStream).
alice_wait_timed(Me, Q, [msg(agent, person, connected(F)) | _], Seen, T0?,
                 [msg(person, Me?, invite(gsn, Q?)) | Cmds?]) :-
    F? =?= Q? |
    now(T0),
    person_done(Seen?, Cmds).
alice_wait_timed(Me, Q, [_ | Outs], Seen, T0?, Cmds?) :- otherwise | alice_wait_timed(Me?, Q?, Outs?, Seen?, T0, Cmds).
alice_wait_timed(_, _, [], _, 0, []).

%% opened_at(Ui, T0, Ms): the clock at the first item on bob's screen, the
%% first view of his execution, less T0.
procedure opened_at(Stream(Opaque)?, Integer?, Integer).
opened_at([_ | _], T0, Ms?) :- now(T1), Ms := T1? - T0?.
opened_at([], _, 0).

%% =============================================================================
%% sg_init(Id, Mode, Peers, NetIn): one super-app per isolate under :boot
%% (../../superapp_boot.glp): the social graph's agent on the isolate's network, GSN's
%% app read from its artefact beside this program and installed under the
%% compiler's key the person trusts, and the person's script by Mode, toward
%% the peers Peers whose keys the person told the agent --- under invite the
%% person invites the one peer, under consent the person consents to the one
%% peer's invitation.  What the mini-app shows its person goes to the person
%% (send_to_user/1), printed by the harness as [agent] term.
%% =============================================================================
procedure alice_person_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_person_boot(Me, Q, M, CK, CSig, Ui, Outs, Seen,
                  [msg(person, Me?, trust(CK?)),
                   msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
                   msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_wait(Me?, Q?, yes, Outs?, Seen?, Cmds).

procedure bob_person_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_person_boot(Me, Q, M, CK, CSig, Ui, Outs, Seen,
                [msg(person, Me?, trust(CK?)),
                 msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
                 msg(person, Me?, accept_invite(gsn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_wait(Me?, Q?, yes, Outs?, Seen?, Cmds).

%% =============================================================================
%% play_load(Name, Kind, Key): what load_file/2 makes of an artefact beside
%% this program --- module, with the compiler's key its certificate carries,
%% or text, with none (the artefact of a program refused a certificate).
%% =============================================================================
exported procedure play_load(String?, Constant, String).
play_load(N, Kind?, K?) :-
    load_file(N?, C),
    loaded(C?, Kind, K).

procedure loaded(Content?, Constant, String).
loaded(M, module, K?) :- module(M?) | decompose_module(M?, K, _, _).
loaded(S, text, none) :- string(S?) | true.

%% =============================================================================
%% play_install(Me, Name, App, Installed): Me's super-app installs, as mini-app App,
%% the artefact Name beside this program --- what load_file/2 gave, the
%% creator's certification the play signs over its source identity where it is
%% a Module --- and reports which mini-apps are installed afterwards: [App]
%% for a certified artefact, [] for one refused a certificate (load_file/2
%% gives its text, and the super-app installs no text).
%% =============================================================================
exported procedure play_install(Key?, String?, Constant?, Stream(Constant)).
play_install(Me, N, App, Installed?) :-
    ground(Me?) |
    load_file(N?, C),
    certified_or_not(C?, CSig),
    new_channel(Ui, Person),
    agent # agent(Me?, [msg(person, Me?, install(App?, C?, CSig?, Ui?)),
                        msg(person, Me?, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

procedure certified_or_not(Content?, String).
certified_or_not(M, CSig?) :- module(M?) | certified(M?, _, CSig).
certified_or_not(S, none) :- string(S?) | true.

%% =============================================================================
%% The super-app's refusal of a forgery (SGSG paper, Section 6.1): at each of
%% the four sites that take a signed term apart --- the creator's
%% certification at installation, the invitation, the invitee's undertaking
%% and the inviter's undertaking with the root channel --- a term that is not
%% a signed term is presented, the constant forged, which signature/2 reports
%% as unsigned, and the play shows the refusal taken: nothing is delivered for
%% it and the super-app carries on with the next message.  Each site is fed
%% directly, the person's or the friend's stream standing in for the channel
%% the term would have crossed; a forgery is refused before the friend or the
%% mini-app is looked up, so no friendship and no installation is set up.
%%
%% play_forged_cert(Me, Installed): Me installs the certified artefact of GKK's
%% app, the program compiled from GKK's contract (programs/apps/gkk), under a
%% developer's warranty that is not a signed term.
%% Expected: Installed = [] --- against play_install(Me, "gkk.glpw", gkk, I),
%% I = [gkk], the same artefact under the play's own warranty;
%% → succeeds.
%% =============================================================================
exported procedure play_forged_cert(Key?, Stream(Constant)).
play_forged_cert(Me, Installed?) :-
    ground(Me?) |
    load_file("gkk.glpw", C),
    new_channel(Ui, Person),
    agent # agent(Me?, [msg(person, Me?, install(gkk, C?, forged, Ui?)),
                        msg(person, Me?, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

%% =============================================================================
%% play_verdict(Me, Kind, Installed): Me installs GKK's app's certified artefact
%% under a signed term of the form the super-app took before the audit's
%% Finding 1, creator_cert(Src, Acts, Verdict), signed by the person over the
%% source identity, whose verdict is the one Kind names, each as the checker
%% prints it (programs/gsc/check.glp): with_wards,
%% syntactically_grassroots_with_wards, cascade/Agents's verdict; wards,
%% grassroots_with_wards, of the same terms; not_grassroots, the verdict on a
%% contract with no introductory act; malformed, the verdict on a contract with
%% a schema not formed as a schema is; and word, the word grassroots, which the
%% checker never prints.  None is the developer's warranty, publish(Src, Cmp):
%% a verdict is the app's to compute from the program's schemas by GPD's
%% Implementation pragma, never a signer's to assert (udi-shapiro/
%% Grassroots-Audit, programs/social/graph/core/agent.glp.md, Finding 1;
%% docs/compiled-home.md in GSA's repository, Section 4).
%% Expected: Installed = [] for each Kind; → succeeds.
%% =============================================================================
exported procedure play_verdict(Key?, Constant?, Stream(Constant)).
play_verdict(Me, Kind, Installed?) :-
    ground(Me?) |
    load_file("gkk.glpw", C),
    verdict_cert(Kind?, C?, CSig),
    new_channel(Ui, Person),
    agent # agent(Me?, [msg(person, Me?, install(gkk, C?, CSig?, Ui?)),
                        msg(person, Me?, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

procedure verdict_cert(Constant?, Content?, String).
verdict_cert(with_wards, M, CSig?) :-
    module(M?) |
    decompose_module(M?, _, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], syntactically_grassroots_with_wards(acquaint, [agent], [guardianship(agent, identity, principal, principal_of, guardian_of)], [relay(agent_acquaint, ward(1, agent, 3), free(2)), relay(agents_acquaint, ward(1, agent, 3), ward(2, agent, 4))], [retired])), K?, CSig).
verdict_cert(wards, M, CSig?) :-
    module(M?) |
    decompose_module(M?, _, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], grassroots_with_wards(acquaint, [agent], [guardianship(agent, identity, principal, principal_of, guardian_of)], [relay(agent_acquaint, ward(1, agent, 3), free(2)), relay(agents_acquaint, ward(1, agent, 3), ward(2, agent, 4))], [retired])), K?, CSig).
verdict_cert(not_grassroots, M, CSig?) :-
    module(M?) |
    decompose_module(M?, _, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], not_grassroots([no_introductory_act])), K?, CSig).
verdict_cert(malformed, M, CSig?) :-
    module(M?) |
    decompose_module(M?, _, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], malformed([not_in_head(s, svar(x))])), K?, CSig).
verdict_cert(word, M, CSig?) :-
    module(M?) |
    decompose_module(M?, _, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], grassroots), K?, CSig).

%% =============================================================================
%% play_warranty(Me, Kind, Installed): Me installs GKK's app's certified
%% artefact under a developer's warranty signed by Me that does not bind its
%% two identities: other, publish(Src, Cmp) of GSN's app's artefact; source,
%% GKK's app's source identity with a compiled identity not its own.  The
%% warranty binds the exact program, its source and its compiled code (GPD:1;
%% docs/compiled-home.md in GSA's repository, Section 4.3, check 1).
%% Expected: Installed = [] for each Kind --- against
%% play_install(Me, "gkk.glpw", gkk, I), I = [gkk]; → succeeds.
%% =============================================================================
exported procedure play_warranty(Key?, Constant?, Stream(Constant)).
play_warranty(Me, Kind, Installed?) :-
    ground(Me?) |
    load_file("gkk.glpw", C),
    load_file("gsn.glpw", O),
    warranty_of(Kind?, C?, O?, M, W),
    new_channel(Ui, Person),
    agent # agent(Me?, [msg(person, Me?, install(gkk, M?, W?, Ui?)),
                        msg(person, Me?, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    hold_person(Person?), sink(Out?), sink(NetOut?).

procedure warranty_of(Constant?, Content?, Content?, Content, String).
warranty_of(other, M, O, M?, W?) :-
    module(M?), module(O?) |
    decompose_module(O?, _, Src, Cmp),
    self_key(K),
    sign(publish(Src?, Cmp?), K?, W).
warranty_of(source, M, O, M?, W?) :-
    module(M?), module(O?) |
    decompose_module(M?, _, Src, _),
    decompose_module(O?, _, _, Cmp),
    self_key(K),
    sign(publish(Src?, Cmp?), K?, W).

%% play_forged_invite(A, B, Out): bob's super-app, B, receives from alice, A, an invitation
%% that is not a signed term, with one end of a root channel, and then a
%% text.
%% Expected: Out = [msg(agent, person, received(alice, hello))] --- the offer
%% was refused, nothing was delivered for it, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_invite(Key?, Key?, AgentToUserStream).
play_forged_invite(A, B, Out?) :-
    ground(A?), ground(B?) |
    root_end(End),
    agent # agent(B?, BobIn?,
                  [msg(A?, B?, invite(src, forged, End?)),
                   msg(A?, B?, text(hello))],
                  [user_output(BobOut), net_output(NetOut)]),
    until_received(BobOut?, Out, BobIn),
    sink(NetOut?).

%% play_forged_join(A, B, Out): alice's super-app, A, the inviter, receives from bob, B, an
%% undertaking that is not a signed term, and then a text.
%% Expected: Out = [msg(agent, person, received(bob, hello))] --- the join
%% was refused, no root channel was created, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_join(Key?, Key?, AgentToUserStream).
play_forged_join(A, B, Out?) :-
    ground(A?), ground(B?) |
    agent # agent(A?, AliceIn?,
                  [msg(B?, A?, join(src, t, forged)),
                   msg(B?, A?, text(hello))],
                  [user_output(AliceOut), net_output(NetOut)]),
    until_received(AliceOut?, Out, AliceIn),
    sink(NetOut?).

%% play_forged_root(A, B, Out): bob's super-app, B, the invitee, receives from alice, A,
%% her answer to a join under an undertaking that is not a signed term, and
%% then a text.
%% Expected: Out = [msg(agent, person, received(alice, hello))] --- the end
%% was not accepted, nothing was delivered, and the text that followed
%% arrived; → succeeds.
exported procedure play_forged_root(Key?, Key?, AgentToUserStream).
play_forged_root(A, B, Out?) :-
    ground(A?), ground(B?) |
    agent # agent(B?, BobIn?,
                  [msg(A?, B?, root(src, t, forged)),
                   msg(A?, B?, text(hello))],
                  [user_output(BobOut), net_output(NetOut)]),
    until_received(BobOut?, Out, BobIn),
    sink(NetOut?).

%% until_received(Outs, Seen, Cmds): the person watching the super-app's
%% stream copies everything delivered up to the first text received, at which
%% the person's stream closes.
procedure until_received(AgentToUserStream?, AgentToUserStream, UserInStream).
until_received([msg(agent, person, received(F, Text)) | _],
               [msg(agent, person, received(F?, Text?))], []).
until_received([M | Outs], [M? | Seen?], Cmds?) :-
    otherwise | until_received(Outs?, Seen, Cmds).
until_received([], [], []).

%% root_end(End): one end of a fresh root channel, at Opaque, as root_step/13
%% makes it, the other end dropped.
procedure root_end(RootChannel(Opaque)).
root_end(E?) :- new_channel(E, _) | true.

%% =============================================================================
%% sg_init(Id, Mode, Peers, NetIn): the person's part, by Mode, in a boot of
%% programs/social (../../*_boot.glp), toward the peers Peers whose keys the
%% person told the agent: the clauses below, each with its boot.  Every
%% volition is the person's, given here in advance.  Nothing closes: the
%% harness settles.
%% =============================================================================
exported procedure sg_init(Key?, Constant?, List(Key)?, NetInStream?).
sg_init(Me, invite, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsn.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, Me?, alice, [Q?], Person?, Screen),
    tee(Screen?, Show, Seen),
    send_to_user(Show?),
    alice_person_boot(Me?, Q?, C?, CK?, CSig?, App?, Out?, Seen?, In).
sg_init(Me, consent, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsn.glpw", C),
    certified(C?, CK, CSig),
    new_channel(App, Person),
    miniapp_person_run(C?, Me?, bob, [Q?], Person?, Screen),
    tee(Screen?, Show, Seen),
    send_to_user(Show?),
    bob_person_boot(Me?, Q?, C?, CK?, CSig?, App?, Out?, Seen?, In).

%% CSSN's app on two smartphones (../../cssn_boot.glp): each person trusts the compiler's key, installs the
%% certified app with its own end of a person channel, and its scripted
%% person, CSSN's own, plays under its role alice for the inviter and bob for
%% the invitee, as GSN's app's in play_invite; its screen goes to the person.
sg_init(Me, cssn_invite, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("cssn.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_cssn_boot(Me?, Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, alice, [Q?], PersonEnd?, Seen),
    send_to_user(Seen?).
sg_init(Me, cssn_consent, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("cssn.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_cssn_boot(Me?, Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, bob, [Q?], PersonEnd?, Seen),
    send_to_user(Seen?).

%% Both mini-apps on two smartphones (../../both_boot.glp): each person trusts
%% the compiler's key, installs both certified mini-apps with their own
%% person channels, and runs both platforms over the one friendship.
sg_init(Me, both_invite, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gc.glpw", CC),
    certified(CC?, CK, CCSig),
    load_file("cssn.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEnd, CoinsPerson),
    new_channel(CssnEnd, CssnPerson),
    alice_both_boot(Me?, Q?, CK?, CC?, CCSig?, CoinsEnd?, CS?, CSSig?, CssnEnd?, Out?, In),
    miniapp_person_run(CC?, Me?, alice, [Q?], CoinsPerson?, Screen),
    send_to_user(Screen?),
    miniapp_person_run(CS?, Me?, alice, [Q?], CssnPerson?, Seen),
    send_to_user(Seen?).
sg_init(Me, both_consent, [Q], NetIn) :-
    ground(Me?), ground(Q?) |
    agent # agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gc.glpw", CC),
    certified(CC?, CK, CCSig),
    load_file("cssn.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEnd, CoinsPerson),
    new_channel(CssnEnd, CssnPerson),
    bob_both_boot(Me?, Q?, CK?, CC?, CCSig?, CoinsEnd?, CS?, CSSig?, CssnEnd?, Out?, In),
    miniapp_person_run(CC?, Me?, bob, [Q?], CoinsPerson?, Screen),
    send_to_user(Screen?),
    miniapp_person_run(CS?, Me?, bob, [Q?], CssnPerson?, Seen),
    send_to_user(Seen?).

%% The held end of an introduction on three smartphones (GSA paper, Appendix
%% "The Operating System", "Whom the Grassroots App knows"; G3;
%% ../../intro_held_boot.glp and ../../intro_refused_boot.glp), with no
%% program installed: the social graph's agent with the operating system
%% around it, os_phone/8 (place.glp), which declares to the layer every person
%% its person knows, with no rendezvous server and no directory.  The
%% introducer, Me, friends with P and Q, who each connect to Me, introduces
%% them once friends with both (Knowledge:3); P, the smaller key, proposes, and
%% Q accepts.  An introduction's consent variables are the introducer's, so
%% P's consent, which carries the end of the variable P conveys the friend
%% channel on, reaches Q from the introducer, an end of a variable from an
%% agent Q does not know: Q's runtime holds it and reports it to Q's operating
%% system.  Every notice goes to the person, printed by the harness as
%% [agent] term.
sg_init(Me, intro_friend, [P, Q], NetIn) :-
    ground(Me?), ground(P?), ground(Q?) |
    place # os_phone(Me?, [P?, Q?], [], none, In?, NetIn?, Out, NetOut),
    send_to_net(NetOut?),
    scripted_home(Me?, Out?, Notices, Cmds?, In),
    tee(Notices?, Shown, Seen),
    send_to_user(Shown?),
    introducer(Me?, P?, Q?, 0, Seen?, Cmds).
%% P: connect to the introducer, and answer yes on each card.
sg_init(Me, intro_proposer, [F], NetIn) :-
    ground(Me?), ground(F?) |
    place # os_phone(Me?, [F?], [], none, In?, NetIn?, Out, NetOut),
    send_to_net(NetOut?),
    scripted_home(Me?, Out?, Notices, [msg(person, Me?, connect(F?)) | Cmds?], In),
    tee(Notices?, Shown, Seen),
    send_to_user(Shown?),
    idle_person(Seen?, Cmds).
%% Q: connect to the introducer, and answer the introduction's card only
%% once the proposer's consent, which carries the held end, has arrived
%% (late_phone/4): yes under intro_late_yes, no under intro_late_no.
sg_init(Me, intro_late_yes, [F], NetIn) :- late_phone(Me?, F?, yes, NetIn?).
sg_init(Me, intro_late_no, [F], NetIn) :- late_phone(Me?, F?, no, NetIn?).
%% Physical encounters (GSA paper, Section 4, the box GPE; Appendix "The
%% Operating System", "Nearby"; ../../nearby_boot.glp, ../../nearby3_boot.glp):
%% the social graph's agent with the operating system's Nearby around it,
%% os_phone/8 (place.glp), with no rendezvous server and no directory, the layer's agents nearby declared on the PAN and
%% the LAN, Ks the persons the person knows at the start; home on the agent's
%% notices, answering yes on every card of a request and an introduction,
%% and befriending by picking a person on home's card of a person nearby,
%% the first, or none, by Mode (picking_home/6); and the person's script by
%% Mode on the notices; every notice goes to the person, printed by the
%% harness as [agent] term.  No key is typed: a person is befriended only by
%% picking them in Nearby (GSA paper, Appendix "The Operating System",
%% "Nearby").  Under encounter_befriend the person opens the place, picks the
%% first person nearby she comes to know, and closes the place once they are
%% friends; under encounter the person opens the place and answers the cards;
%% under befriend_known the person picks the one person she knows, nearby, and
%% never opens the place; under encounter_introduce the
%% person opens the place and, friends with the person she knew and with a
%% newcomer, introduces the newcomer to her (GKK:3) by picking introduce on
%% home's card of the two (GKK's pragma Introduction, "Alice [Introduce]";
%% picking_home/6 under Pick introduce).
sg_init(Me, encounter_befriend, Ks, NetIn) :- nearby_phone(Me?, encounter_befriend, Ks?, NetIn?).
sg_init(Me, encounter, Ks, NetIn) :- nearby_phone(Me?, encounter, Ks?, NetIn?).
sg_init(Me, befriend_known, Ks, NetIn) :- nearby_phone(Me?, befriend_known, Ks?, NetIn?).
sg_init(Me, encounter_introduce, Ks, NetIn) :- nearby_phone(Me?, encounter_introduce, Ks?, NetIn?).
%% A mode or a list of peers no clause above takes starts nothing.
sg_init(_, _, _, _) :- otherwise | true.

procedure nearby_phone(Key?, Constant?, List(Key)?, NetInStream?).
nearby_phone(Me, Mode, Ks, NetIn) :-
    ground(Me?), ground(Ks?) |
    place # os_phone(Me?, Ks?, [], none, In?, NetIn?, Out, NetOut),
    send_to_net(NetOut?),
    pick_mode(Mode?, Pick),
    picking_home(Me?, Pick?, Out?, Notices, Script?, In),
    tee(Notices?, Shown, Seen),
    send_to_user(Shown?),
    nearby_person(Mode?, Me?, Ks?, Seen?, Script).

%% Who picks a person in Nearby to befriend: the first card, under
%% encounter_befriend and befriend_known; none otherwise.
procedure pick_mode(Constant?, PickMode).
pick_mode(encounter_befriend, first).
pick_mode(befriend_known, first).
pick_mode(encounter_introduce, introduce).
pick_mode(_, none) :- otherwise | true.

%% nearby_person(Mode, Me, Ks, Notices, Cmds): the person's script by Mode,
%% on what the agent tells the person.
procedure nearby_person(Constant?, Key?, List(Key)?, Stream(Output)?, UserInStream).
nearby_person(encounter_befriend, Me, _, Ns, [msg(person, Me?, open_place) | Cs?]) :-
    ground(Me?) | close_on_friend(Me?, Ns?, Cs).
nearby_person(encounter, Me, _, Ns, [msg(person, Me?, open_place) | Cs?]) :-
    ground(Me?) | idle_person(Ns?, Cs).
nearby_person(befriend_known, Me, _, Ns, Cs?) :-
    ground(Me?) | idle_person(Ns?, Cs).
nearby_person(encounter_introduce, Me, _, Ns, [msg(person, Me?, open_place) | Cs?]) :-
    ground(Me?) | idle_person(Ns?, Cs).
nearby_person(_, _, _, Ns, Cs?) :- otherwise | idle_person(Ns?, Cs).

%% The place closed once the person she picked is a friend, the first friend
%% she makes.
procedure close_on_friend(Key?, Stream(Output)?, UserInStream).
close_on_friend(Me, [msg(agent, person, connected(_)) | Ns], [msg(person, Me?, close_place) | Cs?]) :-
    ground(Me?) | idle_person(Ns?, Cs).
close_on_friend(Me, [_ | Ns], Cs?) :- otherwise | close_on_friend(Me?, Ns?, Cs).
close_on_friend(_, [], []).

%% Nothing more to will: the notices read to their end.
procedure idle_person(Stream(Output)?, UserInStream).
idle_person([_ | Ns], Cs?) :- idle_person(Ns?, Cs).
idle_person([], []).

%% The introducer's person: once friends with both, the second connected(_)
%% notice, introduce P and Q (Knowledge:3), and nothing more.
procedure introducer(Key?, Key?, Key?, Integer?, Stream(Output)?, UserInStream).
introducer(Me, P, Q, 2, Ns, [msg(person, Me?, introduce(P?, Q?)) | Cs?]) :-
    ground(Me?), ground(P?), ground(Q?) | idle_person(Ns?, Cs).
introducer(Me, P, Q, N, [msg(agent, person, connected(_)) | Ns], Cs?) :-
    N? < 2 | N1 := N? + 1, introducer(Me?, P?, Q?, N1?, Ns?, Cs).
introducer(Me, P, Q, N, [_ | Ns], Cs?) :-
    otherwise | introducer(Me?, P?, Q?, N?, Ns?, Cs).
introducer(_, _, _, _, [], []).

%% late_phone(Me, F, A, NetIn): the acceptor's smartphone: the agent with the
%% operating system around it, its person connecting to F, and home on the agent's messages, each whole to
%% home after late_intro/2, which passes an introduction on only once the
%% proposer's consent has arrived, so that the person is asked after the
%% held end is reported; the person answers A on the introduction's card
%% (answering/4, core/self.glp), and what the person answered goes to the
%% person, beside the notices.
procedure late_phone(Key?, Key?, Drawn?, NetInStream?).
late_phone(Me, F, A, NetIn) :-
    ground(Me?), ground(F?) |
    place # os_phone(Me?, [F?], [], none, In?, NetIn?, Out, NetOut),
    send_to_net(NetOut?),
    split_out(Out?, Notices, Seen),
    late_intro(Seen?, Late),
    home # home(Me?, Late?, Home, Asks),
    home # dispatch(Asks?, ch(Grants?, Draws), MCh),
    hold_output(MCh?),
    answering(A?, Draws?, Grants, Log),
    merge([msg(person, Me?, connect(F?))], Home?, In),
    send_to_user(Notices?),
    send_to_user(Log?).

%% late_intro(Ms, Ms1): the agent's messages to home, each as it comes, but
%% an introduction this agent accepts only once the proposer's consent, the
%% pending value's second end, is yes, which carries the held end; a consent
%% of no passes at once.
procedure late_intro(AgentToUserStream?, AgentToUserStream).
late_intro([msg(A, P, befriend_intro(F, O, accept(M?, yes(C)))) | Ms],
           [msg(A?, P?, befriend_intro(F?, O?, accept(M, yes(C?)))) | Ms1?]) :-
    late_intro(Ms?, Ms1).
late_intro([M | Ms], [M? | Ms1?]) :- otherwise | late_intro(Ms?, Ms1).
late_intro([], []).

%% =============================================================================
%% play_coins(A, B, ScreenA, ScreenB): GC's app, the mini-app compiled from
%% GC's contract (programs/apps/gc, its artefact gc.glpw beside this
%% program), hosted by the super-app: alice and bob install it with its two
%% certifications, alice befriends bob and invites him, and the handshake
%% opens a root channel of GC's platform between their two executions, each
%% activated by run/3 with its three grants.  The persons hold the other ends
%% of the person channels: each is GC's app's own scripted person
%% (programs/apps/gc/person.glp), activated from the same module value under
%% its role, alice or bob, as play_coins of programs/apps/gc runs them --- each
%% establishes their identity (GKK:1), bob issues three Bob-coins (GC:1), they
%% come to know each other (GKK:2), alice issues two Alice-coins and swaps them
%% for bob's three (GC:2), and pays two Bob-coins to bob --- over the
%% conversation the social graph delivered.  Expected: ScreenA ends at
%% view(alice, [coin(bob), knows(bob), knows(bob), identity, person], [bob],
%% [], _), ScreenB has gave(swap(alice, bob, alice, 2, bob, 3), yes) and ends at
%% view(bob, [coin(bob), coin(bob), coin(alice), coin(alice), knows(alice),
%% knows(alice), identity, person], [alice], [], _), → suspended (the agents'
%% request forms stay open and the person channels never close).
%% ../../../apps/gc_boot.glp runs the same on two smartphones.
%% =============================================================================
exported procedure play_coins(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_coins(A, B, ScreenA?, ScreenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("gc.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_coins_person(A?, B?, C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, A?, alice, [B?], PersonEndA?, ScreenA),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_coins_person(B?, A?, C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, B?, bob, [A?], PersonEndB?, ScreenB).

%% =============================================================================
%% play_activate(A, B, ScreenA, ScreenB): activation without an invitation,
%% and a later invitation to the running execution (GSA paper, Section 3, "A
%% grassroots program instance" and "Activation and joining"), on GC's app.
%% alice, A, installs it and activates it, with no invitation and no peer; her
%% execution's scripted person, under GC's role bob, whose acts before any
%% answer are her own, establishes her identity (GKK:1) and issues three
%% Alice-coins (GC:1), and once her screen has shown five items she connects
%% to bob, B, and invites him.  bob installs the app and consents in advance,
%% and the handshake opens their conversation; at alice the registry records
%% the app running, so the root channel goes to the execution she activated
%% alone.  bob's scripted person, under GC's role alice, asks over it that
%% they come to know each other (GKK:2), and alice's execution, on the person
%% channel it holds since her activation, answers yes; then bob swaps two
%% Bob-coins for her three Alice-coins, and pays two Alice-coins to her.
%% Expected: ScreenA = [view(alice, [], [], [], _), ..., view(alice,
%% [coin(alice), coin(alice), coin(alice), identity, person], [], [], _),
%% gave(acquaint(bob, alice), yes) | _], ScreenB ends at view(bob,
%% [coin(alice), knows(alice), knows(alice), identity, person], [alice], [], _),
%% → suspended.
%% =============================================================================
exported procedure play_activate(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_activate(A, B, ScreenA?, ScreenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("gc.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    miniapp_person_run(C?, A?, bob, [B?], PersonEndA?, ShownA),
    tee(ShownA?, ScreenA, SeenA),
    alice_alone_person(A?, B?, C?, CSig?, AppEndA?, AliceOut?, SeenA?, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_coins_person(B?, A?, C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, B?, alice, [A?], PersonEndB?, ScreenB).

%% alice's person in play_activate: install GC's app and activate it,
%% alone; then, once her execution's screen has shown five items, connect to
%% Q and, once connected, invite Q.  The screen's items are counted, never
%% inspected.
procedure alice_alone_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_alone_person(Me, Q, C, CSig, AppEnd, Outs, Seen,
                   [msg(person, Me?, install(gc, C?, CSig?, AppEnd?)),
                    msg(person, Me?, activate(gc)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_after_five(Me?, Q?, Outs?, Seen?, Cmds).

%% Her five items, under GC's role bob: the first view, her request to
%% establish her identity pending, her identity, her request to issue
%% pending, and her three coins.
procedure alice_after_five(Key?, Key?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_after_five(Me, Q, Outs, [_, _, _, _, _ | Seen], [msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Q?) |
    sink(Seen?),
    alice_coins_run(Me?, Q?, Outs?, Cmds).
%% The screen closed before five items: her person stream closes.
alice_after_five(_, _, _, [_, _, _, _], []).
alice_after_five(_, _, _, [_, _, _], []).
alice_after_five(_, _, _, [_, _], []).
alice_after_five(_, _, _, [_], []).
alice_after_five(_, _, _, [], []).

%% The installers of play_coins: each installs GC's app with its end of
%% its person channel.
procedure alice_coins_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_coins_person(Me, Q, C, CSig, AppEnd, Outs,
                   [msg(person, Me?, install(gc, C?, CSig?, AppEnd?)),
                    msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_coins_run(Me?, Q?, Outs?, Cmds).

procedure alice_coins_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_coins_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
                [msg(person, Me?, invite(gc, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_coins_run(Me?, Q?, Outs?, Cmds).
alice_coins_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_coins_run(Me?, Q?, Outs?, Cmds).
alice_coins_run(_, _, [], []).

procedure bob_coins_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_coins_person(Me, Q, C, CSig, AppEnd, Outs,
                 [msg(person, Me?, install(gc, C?, CSig?, AppEnd?)),
                  msg(person, Me?, accept_invite(gc, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_coins_run(Me?, Q?, Outs?, Cmds).

procedure bob_coins_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_coins_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
              [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_coins_run(Me?, Q?, Outs?, Cmds).
bob_coins_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_coins_run(Me?, Q?, Outs?, Cmds).
bob_coins_run(_, _, [], []).


%% The two persons of both platforms under :boot, each trusting the compiler's
%% key once for the two artefacts it signed.
procedure alice_both_boot(Key?, Key?, String?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_both_boot(Me, Q, CK, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                [msg(person, Me?, trust(CK?)),
                 msg(person, Me?, install(gc, CC?, CCSig?, CoinsEnd?)),
                 msg(person, Me?, install(cssn, CS?, CSSig?, CssnEnd?)),
                 msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_both_run(Me?, Q?, Outs?, Cmds).

procedure bob_both_boot(Key?, Key?, String?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_both_boot(Me, Q, CK, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
              [msg(person, Me?, trust(CK?)),
               msg(person, Me?, install(gc, CC?, CCSig?, CoinsEnd?)),
               msg(person, Me?, install(cssn, CS?, CSSig?, CssnEnd?)),
               msg(person, Me?, accept_invite(gc, Q?)),
               msg(person, Me?, accept_invite(cssn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_both_run(Me?, Q?, Outs?, Cmds).

%% CSSN's app's two persons under :boot.
procedure alice_cssn_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_cssn_boot(Me, Q, C, CK, CSig, AppEnd, Outs,
                [msg(person, Me?, trust(CK?)),
                 msg(person, Me?, install(cssn, C?, CSig?, AppEnd?)),
                 msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_cssn_run(Me?, Q?, Outs?, Cmds).

procedure bob_cssn_boot(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_cssn_boot(Me, Q, C, CK, CSig, AppEnd, Outs,
              [msg(person, Me?, trust(CK?)),
               msg(person, Me?, install(cssn, C?, CSig?, AppEnd?)),
               msg(person, Me?, accept_invite(cssn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_cssn_run(Me?, Q?, Outs?, Cmds).

%% =============================================================================
%% play_cssn(A, B, AliceUi, BobUi): play_invite for CSSN's app, the program
%% compiled from CSSN's contract (programs/cssn), its artefact cssn.glpw
%% beside this program.  alice, A, installs it, befriends bob and invites
%% him; bob installs it and consents; the handshake opens the root channel
%% and the two executions converse over it.  Each person's screen is the
%% app's scripted person's, under its roles alice and bob
%% (../../../cssn/person.glp), the views its agent writes, as GSN's app's in
%% play_invite.  ../../cssn_boot.glp runs the same on two smartphones.
%% Expected: AliceUi = [view(alice, [], [], [], _), ... view(alice, [friend(bob),
%% knows(bob), identity, person], [bob], [], _) ... | _], BobUi likewise,
%% → suspended.
%% =============================================================================
exported procedure play_cssn(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_cssn(A, B, AliceUi?, BobUi?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("cssn.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, alice, [B?], AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    alice_cssn_person(A?, B?, C?, CSig?, AliceApp?, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, bob, [A?], BobPerson?, BobScreen),
    tee(BobScreen?, BobUi, BobSeen),
    bob_cssn_person(B?, A?, C?, CSig?, BobApp?, BobOut?, BobSeen?, BobIn).

%% alice_person and alice_wait of play_invite, for CSSN's app, keeping the
%% person stream open until the mini-app's screen closes.
procedure alice_cssn_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_cssn_person(Me, Q, M, CSig, Ui, Outs, Seen,
                  [msg(person, Me?, install(cssn, M?, CSig?, Ui?)),
                   msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_cssn_wait(Me?, Q?, Outs?, Seen?, Cmds).

procedure alice_cssn_wait(Key?, Key?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
alice_cssn_wait(Me, Q, [msg(agent, person, connected(F)) | _], Seen,
                [msg(person, Me?, invite(cssn, Q?)) | Cmds?]) :-
    F? =?= Q? | person_done(Seen?, Cmds).
alice_cssn_wait(Me, Q, [_ | Outs], Seen, Cmds?) :- otherwise | alice_cssn_wait(Me?, Q?, Outs?, Seen?, Cmds).
alice_cssn_wait(_, _, [], _, []).

%% bob_person and bob_wait of play_invite, for CSSN's app, consenting.
procedure bob_cssn_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_cssn_person(Me, Q, M, CSig, Ui, Outs, Seen,
                [msg(person, Me?, install(cssn, M?, CSig?, Ui?)),
                 msg(person, Me?, accept_invite(cssn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_cssn_wait(Me?, Q?, Outs?, Seen?, Cmds).

procedure bob_cssn_wait(Key?, Key?, AgentToUserStream?, Stream(Opaque)?, UserInStream).
bob_cssn_wait(Me, Q, [msg(agent, person, befriend(F, P)) | _], Seen,
              [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? | person_done(Seen?, Cmds).
bob_cssn_wait(Me, Q, [_ | Outs], Seen, Cmds?) :- otherwise | bob_cssn_wait(Me?, Q?, Outs?, Seen?, Cmds).
bob_cssn_wait(_, _, [], _, []).

procedure alice_cssn_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_cssn_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
               [msg(person, Me?, invite(cssn, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_cssn_run(Me?, Q?, Outs?, Cmds).
alice_cssn_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_cssn_run(Me?, Q?, Outs?, Cmds).
alice_cssn_run(_, _, [], []).

procedure bob_cssn_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_cssn_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
             [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_cssn_run(Me?, Q?, Outs?, Cmds).
bob_cssn_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_cssn_run(Me?, Q?, Outs?, Cmds).
bob_cssn_run(_, _, [], []).

%% =============================================================================
%% play_both(A, B, ScreenA, ScreenB, SeenA, SeenB): ONE super-app hosting BOTH
%% mini-apps at once (GSG paper, Section 7).  alice and bob each install GC's
%% app and CSSN's app, each with its own person channel;
%% alice invites bob to both; the two handshakes open a root channel of each
%% platform's own protocol, and each super-app activates both entries by
%% run/3, each at its own opaque instance and with its own conversations.
%% Then both platforms run at once over the one friendship: alice and bob
%% issue, swap and pay under GC's contract, and alice and bob befriend
%% under CSSN's, each person the mini-app's own.  Expected: ScreenA and
%% ScreenB as in play_coins, SeenA and SeenB as AliceUi and BobUi of
%% play_cssn, → suspended.
%% =============================================================================
exported procedure play_both(Key?, Key?, Stream(Opaque), Stream(Opaque), Stream(Opaque), Stream(Opaque)).
play_both(A, B, ScreenA?, ScreenB?, SeenA?, SeenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("gc.glpw", CC),
    certified(CC?, _, CCSig),
    load_file("cssn.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEndA, CoinsPersonA),
    new_channel(CssnEndA, CssnPersonA),
    new_channel(CoinsEndB, CoinsPersonB),
    new_channel(CssnEndB, CssnPersonB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_both_person(A?, B?, CC?, CCSig?, CoinsEndA?, CS?, CSSig?, CssnEndA?, AliceOut?, AliceIn),
    miniapp_person_run(CC?, A?, alice, [B?], CoinsPersonA?, ScreenA),
    miniapp_person_run(CS?, A?, alice, [B?], CssnPersonA?, SeenA),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_both_person(B?, A?, CC?, CCSig?, CoinsEndB?, CS?, CSSig?, CssnEndB?, BobOut?, BobIn),
    miniapp_person_run(CC?, B?, bob, [A?], CoinsPersonB?, ScreenB),
    miniapp_person_run(CS?, B?, bob, [A?], CssnPersonB?, SeenB).

%% alice's person: install both, cold-call bob, and invite him to both once
%% they are friends.
procedure alice_both_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_both_person(Me, Q, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                  [msg(person, Me?, install(gc, CC?, CCSig?, CoinsEnd?)),
                   msg(person, Me?, install(cssn, CS?, CSSig?, CssnEnd?)),
                   msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_both_run(Me?, Q?, Outs?, Cmds).

procedure alice_both_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_both_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
               [msg(person, Me?, invite(gc, Q?)),
                msg(person, Me?, invite(cssn, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_both_run(Me?, Q?, Outs?, Cmds).
alice_both_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_both_run(Me?, Q?, Outs?, Cmds).
alice_both_run(_, _, [], []).

%% bob's person: install both, consent to the friendship, and accept both
%% invitations.
procedure bob_both_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_both_person(Me, Q, CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                [msg(person, Me?, install(gc, CC?, CCSig?, CoinsEnd?)),
                 msg(person, Me?, install(cssn, CS?, CSSig?, CssnEnd?)),
                 msg(person, Me?, accept_invite(gc, Q?)),
                 msg(person, Me?, accept_invite(cssn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_both_run(Me?, Q?, Outs?, Cmds).

procedure bob_both_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_both_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
             [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_both_run(Me?, Q?, Outs?, Cmds).
bob_both_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_both_run(Me?, Q?, Outs?, Cmds).
bob_both_run(_, _, [], []).

%% =============================================================================
%% play_leave(A, B, AliceUi, Names, AliceUi2, BobUi): Programs:6, Leave (GSA
%% paper, Appendix "The Operating System", "Leaving").  alice, A, installs
%% GSN's app, befriends bob, B, and invites him; bob installs it and consents
%% to two invitations before either offer arrives, the two consents stacking
%% as at play_invite's one; the handshake opens the root channel and both
%% executions run, alice's screen AliceUi.  Once her execution has shown its
%% first view she leaves the app, and reads back the names installed, Names;
%% then installs it again, Programs:4, with a fresh person channel, its
%% screen AliceUi2, and invites bob again, Programs:5: her second execution is
%% activated afresh by run/3, the program not being installed when she left,
%% and the new conversation goes to bob's running execution.  The screens
%% are the app's scripted persons', counted, never inspected.
%% Expected: Names = [], AliceUi2 = [view(alice, [], [], [], _) | _],
%% → suspended.
%% =============================================================================
exported procedure play_leave(Key?, Key?, Stream(Opaque), Stream(Constant), Stream(Opaque), Stream(Opaque)).
play_leave(A, B, AliceUi?, Names?, AliceUi2?, BobUi?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("gsn.glpw", C),
    certified(C?, _, CSig),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    new_channel(AliceApp, AlicePerson),
    miniapp_person_run(C?, A?, alice, [B?], AlicePerson?, AliceScreen),
    tee(AliceScreen?, AliceUi, AliceSeen),
    new_channel(AliceApp2, AlicePerson2),
    miniapp_person_run(C?, A?, alice, [B?], AlicePerson2?, AliceUi2),
    alice_leave(A?, B?, C?, CSig?, AliceApp?, AliceApp2?, AliceOut?, AliceSeen?, Names, AliceIn),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    new_channel(BobApp, BobPerson),
    miniapp_person_run(C?, B?, bob, [A?], BobPerson?, BobUi),
    bob_twice(B?, A?, C?, CSig?, BobApp?, BobOut?, BobIn).

%% Alice's person, Me: install the app and cold-call Q; once connected invite
%% Q (alice_leave_wait/9).
procedure alice_leave(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Stream(Constant), UserInStream).
alice_leave(Me, Q, M, CSig, Ui, Ui2, Outs, Seen, Names?,
            [msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
             msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_leave_wait(Me?, Q?, M?, CSig?, Ui2?, Outs?, Seen?, Names, Cmds).

procedure alice_leave_wait(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Stream(Constant), UserInStream).
alice_leave_wait(Me, Q, M, CSig, Ui2, [msg(agent, person, connected(F)) | Outs], Seen, Names?,
                 [msg(person, Me?, invite(gsn, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_left(Me?, Q?, M?, CSig?, Ui2?, Outs?, Seen?, Names, Cmds).
alice_leave_wait(Me, Q, M, CSig, Ui2, [_ | Outs], Seen, Names?, Cmds?) :-
    otherwise | alice_leave_wait(Me?, Q?, M?, CSig?, Ui2?, Outs?, Seen?, Names, Cmds).
alice_leave_wait(Me, _, _, _, Ui2, [], _, Names?, [msg(person, Me?, installed(Names))]) :-
    ground(Me?) | hold_person_end(Ui2?).

%% Her execution's first view shown: leave the app, read back the names
%% installed, install it again with the fresh person channel and invite Q
%% again; then keep her person stream open while the agent writes to her.
procedure alice_left(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, Stream(Opaque)?, Stream(Constant), UserInStream).
alice_left(Me, Q, M, CSig, Ui2, Outs, [_ | Seen], Names?,
           [msg(person, Me?, leave(gsn)),
            msg(person, Me?, installed(Names)),
            msg(person, Me?, install(gsn, M?, CSig?, Ui2?)),
            msg(person, Me?, invite(gsn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    sink(Seen?),
    outs_done(Outs?, Cmds).
alice_left(Me, _, _, _, Ui2, _, [], Names?, [msg(person, Me?, installed(Names))]) :-
    ground(Me?) | hold_person_end(Ui2?).

%% A person channel's app end that no installation takes, read for good.
procedure hold_person_end(PersonChannel(Opaque)?).
hold_person_end(ch([_ | Gs], Ds?)) :- hold_person_end(ch(Gs?, Ds)).

%% The person stream closes when the agent's stream to the person closes.
procedure outs_done(AgentToUserStream?, UserInStream).
outs_done([_ | Outs], Cmds?) :- outs_done(Outs?, Cmds).
outs_done([], []).

%% Bob's person: install the app and consent to two invitations of Q before
%% either offer arrives; answer Q's cold call on his card; then keep his
%% person stream open while his agent writes to him.
procedure bob_twice(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_twice(Me, Q, M, CSig, Ui, Outs,
          [msg(person, Me?, install(gsn, M?, CSig?, Ui?)),
           msg(person, Me?, accept_invite(gsn, Q?)),
           msg(person, Me?, accept_invite(gsn, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_twice_wait(Me?, Q?, Outs?, Cmds).

procedure bob_twice_wait(Key?, Key?, AgentToUserStream?, UserInStream).
bob_twice_wait(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
               [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    outs_done(Outs?, Cmds).
bob_twice_wait(Me, Q, [_ | Outs], Cmds?) :-
    otherwise | bob_twice_wait(Me?, Q?, Outs?, Cmds).
bob_twice_wait(_, _, [], []).

%% =============================================================================
%% play_sovereign(A, B, ScreenA, ScreenB): DGC's app, the program compiled
%% from Currencies' contract Denominated Currencies (programs/apps/dgc, its
%% artefact dgc.glpw beside this program), hosted by the super-app.  alice and
%% bob install it with its certification, alice befriends bob and invites him,
%% the handshake opens a root channel between their two executions, and each
%% is activated by run/3 with its grants.  run/3 admits the mini-app only if
%% the type identity of the entry template's opaque instance at the type its
%% exports record is the one find_type/3 gives at it, and the super-app holds
%% no copy of DGC's types.  Each person is the app's own scripted person,
%% under its roles alice and bob (../../../apps/dgc/person.glp), whose steps
%% are those of play_denominated (../../../apps/dgc/plays.glp): each
%% establishes their identity and issues two usd-denominated coins of their
%% own, they come to know each other, alice issues three usd-denominated
%% Alice-bonds due day 10, alice swaps her two Alice-coins for bob's two
%% Bob-coins, bob accepts an Alice-coin in payment and pays alice one of her
%% own, and alice pays it to bob.
%% Expected: ScreenA and ScreenB the screens of play_denominated, → suspended
%% (the agents' request forms stay open and the person channels never close).
%% =============================================================================
exported procedure play_sovereign(Key?, Key?, Stream(Opaque), Stream(Opaque)).
play_sovereign(A, B, ScreenA?, ScreenB?) :-
    ground(A?), ground(B?) |
    crossbar2(A?, B?, AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("dgc.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(A?, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_sv_person(A?, B?, C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    miniapp_person_run(C?, A?, alice, [B?], PersonEndA?, ScreenA),
    agent # agent(B?, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_sv_person(B?, A?, C?, CSig?, AppEndB?, BobOut?, BobIn),
    miniapp_person_run(C?, B?, bob, [A?], PersonEndB?, ScreenB).

procedure alice_sv_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_sv_person(Me, Q, C, CSig, AppEnd, Outs,
                [msg(person, Me?, install(dgc, C?, CSig?, AppEnd?)),
                 msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_sv_run(Me?, Q?, Outs?, Cmds).

procedure alice_sv_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_sv_run(Me, Q, [msg(agent, person, connected(F)) | Outs],
             [msg(person, Me?, invite(dgc, Q?)) | Cmds?]) :-
    F? =?= Q? |
    alice_sv_run(Me?, Q?, Outs?, Cmds).
alice_sv_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_sv_run(Me?, Q?, Outs?, Cmds).
alice_sv_run(_, _, [], []).

procedure bob_sv_person(Key?, Key?, Content?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_sv_person(Me, Q, C, CSig, AppEnd, Outs,
              [msg(person, Me?, install(dgc, C?, CSig?, AppEnd?)),
               msg(person, Me?, accept_invite(dgc, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    bob_sv_run(Me?, Q?, Outs?, Cmds).

procedure bob_sv_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_sv_run(Me, Q, [msg(agent, person, befriend(F, P)) | Outs],
           [msg(person, Me?, decision(yes, F?, P?)) | Cmds?]) :-
    F? =?= Q? |
    bob_sv_run(Me?, Q?, Outs?, Cmds).
bob_sv_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | bob_sv_run(Me?, Q?, Outs?, Cmds).
bob_sv_run(_, _, [], []).
