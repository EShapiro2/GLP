%% superapp_plays.glp --- distribution with an invitation, the handshake,
%% activation by run/3 with the two grants, and the attestation (SGSG paper,
%% Sections 3 and 5.5), played by two social-graph agents in one heap, the
%% network a two-way crossbar for cold calls, and under :boot (../../superapp_boot.glp)
%% by two isolates with their own keys.  The certified mini-apps are ../pingapp,
%% of the one-way user-interface stream, and Currencies' ../../../coins/currency,
%% of the cards-and-answers channel (play_coins); the super-app reads their
%% artefacts with load_file/2.  The persons are scripted on the agents' person
%% streams --- the mediator's cards for an invitation are vGLP's to add --- and
%% the mini-apps' user-interface streams come back to the caller, or, under
%% :boot, go to the person.

imported procedure agent#agent(Constant?, UserInStream?, NetInStream?, OutputsList?).

procedure crossbar2(NetOutStream?, NetOutStream?, NetInStream, NetInStream).
crossbar2(AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route2(All?, AIn, BIn).

procedure route2(NetOutStream?, NetInStream, NetInStream).
route2([msg(alice, C) | Rest], [msg(alice, C?) | A?], B?) :- route2(Rest?, A, B).
route2([msg(bob, C) | Rest], A?, [msg(bob, C?) | B?]) :- route2(Rest?, A, B).
route2([], [], []).

procedure tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

%% The certified mini-app: pingapp.glpw beside this program, written by the
%% REPL's :artefact from ../pingapp and read with load_file/2 --- a Module
%% where its certificate verifies, its text otherwise.  certified/4 gives the
%% module, the compiler's key its certificate carries, and the creator's
%% certification, signed here over its source identity, the contract's two act
%% schemas and the checker's verdict.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], grassroots), K?, CSig).

%% =============================================================================
%% play_invite: alice installs the mini-app, befriends bob and invites him;
%% bob installs it and consents; the handshake opens the root channel and the
%% two executions greet each other.
%% Expected: AliceUi = [greeted(bob)], BobUi = [greeted(alice)], → succeeds.
%% =============================================================================
exported procedure play_invite(AppUiStream, AppUiStream).
play_invite(AliceUi?, BobUi?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    tee(AliceUiRaw?, AliceUi, AliceSeen),
    alice_person(C?, CSig?, yes, AliceUiRaw, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    tee(BobUiRaw?, BobUi, BobSeen),
    bob_person(C?, CSig?, yes, BobUiRaw, BobOut?, BobSeen?, BobIn).

%% =============================================================================
%% play_invite_declined: as above, but bob's person declines; no conversation
%% opens and neither execution is activated.
%% Expected: AliceUi = [], BobUi = [], → succeeds.
%% =============================================================================
exported procedure play_invite_declined(AppUiStream, AppUiStream).
play_invite_declined(AliceUi?, BobUi?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    tee(AliceUiRaw?, AliceUi, AliceSeen),
    alice_person(C?, CSig?, no, AliceUiRaw, AliceOut?, AliceSeen?, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    tee(BobUiRaw?, BobUi, BobSeen),
    bob_person(C?, CSig?, no, BobUiRaw, BobOut?, BobSeen?, BobIn).

%% Alice's person: install the mini-app, cold-call bob, and once connected
%% invite him.  Wait = yes: keep the person stream open until her execution
%% has been greeted; no: close it after inviting.
procedure alice_person(Content?, String?, Decision?, AppUiStream, AgentToUserStream?, AppUiStream?, UserInStream).
alice_person(M, CSig, Wait, Ui?, Outs, Seen,
             [msg(person, alice, install(ping, M?, CSig?, Ui)),
              msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_wait(Wait?, Outs?, Seen?, Cmds).

procedure alice_wait(Decision?, AgentToUserStream?, AppUiStream?, UserInStream).
alice_wait(yes, [msg(agent, person, connected(bob)) | _], Seen,
           [msg(person, alice, invite(ping, bob)) | Cmds?]) :-
    person_done(Seen?, Cmds).
alice_wait(no, [msg(agent, person, connected(bob)) | _], _,
           [msg(person, alice, invite(ping, bob))]).
alice_wait(W, [_ | Outs], Seen, Cmds?) :- otherwise | alice_wait(W?, Outs?, Seen?, Cmds).
alice_wait(_, [], _, []).

%% Close the person stream once the mini-app has been greeted, or closed.
procedure person_done(AppUiStream?, UserInStream).
person_done([greeted(_) | _], []).
person_done([_ | Seen], Cmds?) :- otherwise | person_done(Seen?, Cmds).
person_done([], []).

%% Bob's person: install the mini-app and give (or refuse) consent before the
%% offer arrives; answer alice's cold call; then wait to be greeted, or close.
procedure bob_person(Content?, String?, Decision?, AppUiStream, AgentToUserStream?, AppUiStream?, UserInStream).
bob_person(M, CSig, yes, Ui?, Outs, Seen,
           [msg(person, bob, install(ping, M?, CSig?, Ui)),
            msg(person, bob, accept_invite(ping, alice)) | Cmds?]) :-
    bob_wait(yes, Outs?, Seen?, Cmds).
bob_person(M, CSig, no, Ui?, Outs, Seen,
           [msg(person, bob, install(ping, M?, CSig?, Ui)),
            msg(person, bob, decline_invite(ping, alice)) | Cmds?]) :-
    bob_wait(no, Outs?, Seen?, Cmds).

procedure bob_wait(Decision?, AgentToUserStream?, AppUiStream?, UserInStream).
bob_wait(yes, [msg(agent, person, befriend(alice, Resp?)) | _], Seen,
         [msg(person, bob, decision(yes, alice, response(Resp))) | Cmds?]) :-
    person_done(Seen?, Cmds).
bob_wait(no, [msg(agent, person, befriend(alice, Resp?)) | _], _,
         [msg(person, bob, decision(yes, alice, response(Resp)))]).
bob_wait(W, [_ | Outs], Seen, Cmds?) :- otherwise | bob_wait(W?, Outs?, Seen?, Cmds).
bob_wait(_, [], _, []).

%% =============================================================================
%% play_attest: alice and bob befriend; alice reads back the attestation her
%% social graph minted at the commit, and the play takes it apart.
%% Expected: T = attest(alice, bob), K the person's key, H this program's
%% source identity, → succeeds.
%% =============================================================================
exported procedure play_attest(String, String, String, _).
play_attest(S?, K?, H?, T?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_attest(AliceOut?, S, AliceIn),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_answer(BobOut?, BobIn),
    signed(S?, K, H, T).

procedure alice_attest(AgentToUserStream?, String, UserInStream).
alice_attest(Outs, S?, [msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_attest_wait(Outs?, S, Cmds).

procedure alice_attest_wait(AgentToUserStream?, String, UserInStream).
alice_attest_wait([msg(agent, person, connected(bob)) | _], S?,
                  [msg(person, alice, attestation(bob, S))]).
alice_attest_wait([_ | Outs], S?, Cmds?) :- otherwise | alice_attest_wait(Outs?, S, Cmds).
alice_attest_wait([], none, []).

procedure bob_answer(AgentToUserStream?, UserInStream).
bob_answer([msg(agent, person, befriend(alice, Resp?)) | _],
           [msg(person, bob, decision(yes, alice, response(Resp)))]).
bob_answer([_ | Outs], Cmds?) :- otherwise | bob_answer(Outs?, Cmds).
bob_answer([], []).

%% =============================================================================
%% play_invite_timed(Ms): play_invite, timed --- the milliseconds from the
%% moment alice's person sends the invitation to the moment the root
%% channel's end reaches bob's execution of the mini-app (its opened/1 on the
%% user-interface stream); the clock is now/1, in milliseconds.
%% =============================================================================
exported procedure play_invite_timed(Integer).
play_invite_timed(Ms?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("pingapp.glpw", C),
    certified(C?, _, CSig),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    tee(AliceUiRaw?, AliceUi, AliceSeen),
    alice_person_timed(C?, CSig?, AliceUiRaw, AliceOut?, AliceSeen?, T0, AliceIn),
    sink(AliceUi?),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    tee(BobUiRaw?, BobUi, BobSeen),
    bob_person(C?, CSig?, yes, BobUiRaw, BobOut?, BobSeen?, BobIn),
    opened_at(BobUi?, T0?, Ms).

procedure sink(Stream(X)?).
sink([_ | Xs]) :- sink(Xs?).
sink([]).

%% Alice's person as in play_invite, reading the clock as she sends the
%% invitation.
procedure alice_person_timed(Content?, String?, AppUiStream, AgentToUserStream?, AppUiStream?, Integer, UserInStream).
alice_person_timed(M, CSig, Ui?, Outs, Seen, T0?,
                   [msg(person, alice, install(ping, M?, CSig?, Ui)),
                    msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_wait_timed(Outs?, Seen?, T0, Cmds).

procedure alice_wait_timed(AgentToUserStream?, AppUiStream?, Integer, UserInStream).
alice_wait_timed([msg(agent, person, connected(bob)) | _], Seen, T0?,
                 [msg(person, alice, invite(ping, bob)) | Cmds?]) :-
    now(T0),
    person_done(Seen?, Cmds).
alice_wait_timed([_ | Outs], Seen, T0?, Cmds?) :- otherwise | alice_wait_timed(Outs?, Seen?, T0, Cmds).
alice_wait_timed([], _, 0, []).

%% opened_at(Ui, T0, Ms): the clock at bob's opened/1, less T0.
procedure opened_at(AppUiStream?, Integer?, Integer).
opened_at([opened(_) | _], T0, Ms?) :- now(T1), Ms := T1? - T0?.
opened_at([_ | Ui], T0, Ms?) :- otherwise | opened_at(Ui?, T0?, Ms).
opened_at([], _, 0).

%% =============================================================================
%% sg_init(Id, Role, NetIn): one super-app per isolate under :boot
%% (../../superapp_boot.glp): the social graph's agent on the isolate's network, the
%% mini-app read from the artefact beside this program and installed under the
%% compiler's key the person trusts, and the person's script by Role --- alice
%% invites, bob consents.  What the mini-app shows its person goes to the
%% person (send_to_user/1), printed by the harness as [agent] term.
%% =============================================================================
procedure alice_person_boot(Content?, String?, String?, AppUiStream, AgentToUserStream?, AppUiStream?, UserInStream).
alice_person_boot(M, CK, CSig, Ui?, Outs, Seen,
                  [msg(person, alice, trust(CK?)),
                   msg(person, alice, install(ping, M?, CSig?, Ui)),
                   msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_wait(yes, Outs?, Seen?, Cmds).

procedure bob_person_boot(Content?, String?, String?, AppUiStream, AgentToUserStream?, AppUiStream?, UserInStream).
bob_person_boot(M, CK, CSig, Ui?, Outs, Seen,
                [msg(person, bob, trust(CK?)),
                 msg(person, bob, install(ping, M?, CSig?, Ui)),
                 msg(person, bob, accept_invite(ping, alice)) | Cmds?]) :-
    bob_wait(yes, Outs?, Seen?, Cmds).

%% =============================================================================
%% play_load(Name, Kind, Key): what load_file/2 makes of an artefact beside
%% this program --- module, with the compiler's key its certificate carries,
%% or text, with none (the artefact of a program refused a certificate).
%% =============================================================================
exported procedure play_load(String?, Constant, String).
play_load(N, Kind?, K?) :-
    load_file(N?, C),
    loaded(C?, Kind, K).

procedure loaded(Content?, Constant, String).
loaded(M, module, K?) :- module(M?) | decompose_module(M?, K, _, _).
loaded(S, text, none) :- string(S?) | true.

%% =============================================================================
%% play_install(Name, App, Installed): the super-app installs, as mini-app App,
%% the artefact Name beside this program --- what load_file/2 gave, the
%% creator's certification the play signs over its source identity where it is
%% a Module --- and reports which mini-apps are installed afterwards: [App]
%% for a certified artefact, [] for one refused a certificate (load_file/2
%% gives its text, and the super-app installs no text).
%% =============================================================================
exported procedure play_install(String?, Constant?, Stream(Constant)).
play_install(N, App, Installed?) :-
    load_file(N?, C),
    certified_or_not(C?, CSig),
    agent # agent(alice, [msg(person, alice, install(App?, C?, CSig?, Ui)),
                          msg(person, alice, installed(Installed))],
                  [], [user_output(Out), net_output(NetOut)]),
    sink(Ui?), sink(Out?), sink(NetOut?).

procedure certified_or_not(Content?, String).
certified_or_not(M, CSig?) :- module(M?) | certified(M?, _, CSig).
certified_or_not(S, none) :- string(S?) | true.

%% =============================================================================
%% The warm call on three smartphones (../../superapp3_boot.glp): alice, bob
%% and carol, carol a friend of both, alice and bob not friends.  alice
%% invites carol to the mini-app and carol invites bob; alice's execution,
%% greeted by carol, sends her probe(W), the end of a fresh variable, which
%% carol's execution forwards to bob's; bob's execution assigns it, bob's
%% runtime holds the assignment --- the end reached bob under alice's name from
%% carol --- and reports the held link; bob's mini-app asks for a warm call;
%% bob's social graph asks carol for an introduction to alice, which carol's
%% person allows; alice's and bob's persons accept it and befriend; bob's
%% social graph sends alice warm_call(ping, Name); alice's person having
%% consented, alice invites bob, bob joins, the handshake opens their root
%% channel, bob's social graph releases the held end, and the value reaches
%% alice, whose execution reports got(hello_from_bob).  Every volition is the
%% person's, given here in advance.  Nothing closes: the harness settles.
%% =============================================================================
exported procedure sg_init(Constant?, Constant?, NetInStream?).
sg_init(alice, invite, NetIn) :-
    agent # agent(alice, AliceIn?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    tee(Ui?, Show, Seen),
    send_to_user(Show?),
    alice_person_boot(C?, CK?, CSig?, Ui, Out?, Seen?, AliceIn).
sg_init(bob, consent, NetIn) :-
    agent # agent(bob, BobIn?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    tee(Ui?, Show, Seen),
    send_to_user(Show?),
    bob_person_boot(C?, CK?, CSig?, Ui, Out?, Seen?, BobIn).

%% The currency on two smartphones (../../coins_boot.glp): each person trusts
%% the compiler's key, installs the certified currency with its own end of a
%% cards-and-answers channel, and scripts the swap of play_coins; what the
%% currency shows a person goes to the person, printed by the harness.
sg_init(alice, coins, NetIn) :-
    agent # agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_coins_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    coin_person(alice, PersonEnd?, [mint(2), swap(bob, alice, 2, bob, 2)], Screen),
    send_to_user(Screen?).
sg_init(bob, coins, NetIn) :-
    agent # agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("currency.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_coins_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    coin_person(bob, PersonEnd?, [mint(2), accept(alice)], Screen),
    send_to_user(Screen?).

%% The child-safe platform on two smartphones (../../cssn_boot.glp), as the
%% currency's clauses above: each person trusts the compiler's key, installs
%% the certified platform with its own end of a commands-and-notifications
%% channel, and alice's greets bob once the conversation is adopted.
sg_init(alice, cssn, NetIn) :-
    agent # agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("childsafe.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_cssn_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    cssn_greeter(bob, PersonEnd?, Seen),
    send_to_user(Seen?).
sg_init(bob, cssn, NetIn) :-
    agent # agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("childsafe.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_cssn_boot(C?, CK?, CSig?, AppEnd?, Out?, In),
    cssn_onlooker(PersonEnd?, Seen),
    send_to_user(Seen?).

sg_init(alice, warm, NetIn) :-
    agent # agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    send_to_user(Ui?),
    alice_warm(C?, CK?, CSig?, Ui, Out?, In).
sg_init(bob, warm, NetIn) :-
    agent # agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    send_to_user(Ui?),
    bob_warm(C?, CK?, CSig?, Ui, Out?, In).
sg_init(carol, warm, NetIn) :-
    agent # agent(carol, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("pingapp.glpw", C),
    certified(C?, CK, CSig),
    send_to_user(Ui?),
    carol_warm(C?, CK?, CSig?, Ui, Out?, In).

%% alice's person: install; consent in advance to a warm call from bob;
%% cold-call carol, invite her once connected; accept carol's introduction to
%% bob.
procedure alice_warm(Content?, String?, String?, AppUiStream, AgentToUserStream?, UserInStream).
alice_warm(C, CK, CSig, Ui?, Outs,
           [msg(person, alice, trust(CK?)),
            msg(person, alice, install(ping, C?, CSig?, Ui)),
            msg(person, alice, accept_warm_call(bob)),
            msg(person, alice, connect(carol)) | Cmds?]) :-
    alice_warm_run(Outs?, Cmds).

procedure alice_warm_run(AgentToUserStream?, UserInStream).
alice_warm_run([msg(agent, person, connected(carol)) | Outs],
               [msg(person, alice, invite(ping, carol)) | Cmds?]) :-
    send_to_user([sg(connected(carol))]),
    alice_warm_run(Outs?, Cmds).
alice_warm_run([msg(agent, person, connected(bob)) | Outs], Cmds?) :-
    send_to_user([sg(connected(bob))]),
    alice_warm_run(Outs?, Cmds).
alice_warm_run([msg(agent, person, befriend_intro(carol, bob, Ch)) | Outs],
               [msg(person, alice, accept_intro(bob, channel(Ch?))) | Cmds?]) :-
    send_to_user([sg(intro_from(carol, bob))]),
    alice_warm_run(Outs?, Cmds).
alice_warm_run([_ | Outs], Cmds?) :- otherwise | alice_warm_run(Outs?, Cmds).
alice_warm_run([], []).

%% bob's person: install; consent in advance to carol's and alice's
%% invitations and to a warm call with alice; cold-call carol; accept carol's
%% introduction to alice.
procedure bob_warm(Content?, String?, String?, AppUiStream, AgentToUserStream?, UserInStream).
bob_warm(C, CK, CSig, Ui?, Outs,
         [msg(person, bob, trust(CK?)),
          msg(person, bob, install(ping, C?, CSig?, Ui)),
          msg(person, bob, accept_invite(ping, carol)),
          msg(person, bob, accept_invite(ping, alice)),
          msg(person, bob, accept_warm_call(alice)),
          msg(person, bob, connect(carol)) | Cmds?]) :-
    bob_warm_run(Outs?, Cmds).

procedure bob_warm_run(AgentToUserStream?, UserInStream).
bob_warm_run([msg(agent, person, befriend_intro(carol, alice, Ch)) | Outs],
             [msg(person, bob, accept_intro(alice, channel(Ch?))) | Cmds?]) :-
    send_to_user([sg(intro_from(carol, alice))]),
    bob_warm_run(Outs?, Cmds).
bob_warm_run([msg(agent, person, connected(Who)) | Outs], Cmds?) :-
    ground(Who?) |
    send_to_user([sg(connected(Who?))]),
    bob_warm_run(Outs?, Cmds).
bob_warm_run([_ | Outs], Cmds?) :- otherwise | bob_warm_run(Outs?, Cmds).
bob_warm_run([], []).

%% carol's person: install; consent in advance to alice's invitation and allow
%% the introduction of bob to alice; accept both cold calls; invite bob once
%% connected.
procedure carol_warm(Content?, String?, String?, AppUiStream, AgentToUserStream?, UserInStream).
carol_warm(C, CK, CSig, Ui?, Outs,
           [msg(person, carol, trust(CK?)),
            msg(person, carol, install(ping, C?, CSig?, Ui)),
            msg(person, carol, accept_invite(ping, alice)),
            msg(person, carol, allow_intro(bob, alice)) | Cmds?]) :-
    carol_warm_run(Outs?, Cmds).

procedure carol_warm_run(AgentToUserStream?, UserInStream).
carol_warm_run([msg(agent, person, befriend(Who, Resp?)) | Outs],
               [msg(person, carol, decision(yes, Who?, response(Resp))) | Cmds?]) :-
    ground(Who?) |
    send_to_user([sg(cold_call(Who?))]),
    carol_warm_run(Outs?, Cmds).
carol_warm_run([msg(agent, person, connected(bob)) | Outs],
               [msg(person, carol, invite(ping, bob)) | Cmds?]) :-
    send_to_user([sg(connected(bob))]),
    carol_warm_run(Outs?, Cmds).
carol_warm_run([msg(agent, person, connected(alice)) | Outs], Cmds?) :-
    send_to_user([sg(connected(alice))]),
    carol_warm_run(Outs?, Cmds).
carol_warm_run([_ | Outs], Cmds?) :- otherwise | carol_warm_run(Outs?, Cmds).
carol_warm_run([], []).

%% =============================================================================
%% play_coins(ScreenA, ScreenB): the currency mini-app (programs/coins/currency,
%% its artefact currency.glpw beside this program) hosted by the super-app:
%% alice and bob install it with its two certifications, alice befriends bob
%% and invites him, and the handshake opens a root channel of the currency
%% protocol between their two executions, each activated by run/3 with its
%% cards-and-answers channel and its conversations.  The persons hold the
%% other ends of the cards-and-answers channels: each mints 2, alice offers her
%% 2 for bob's 2 and bob accepts --- the currency's own swap (its play_swap)
%% over the conversation the social graph delivered.  Expected: ScreenA =
%% [opened(bob), minted(2), holdings([lot(alice, 2)]), holdings([]),
%% swap_done(bob), holdings([lot(bob, 2)]) | _], ScreenB = [opened(alice),
%% minted(2), holdings([lot(bob, 2)]), swap_done(alice), holdings([lot(alice,
%% 2)]) | _], → suspended (the executions pend on their remaining cards).
%% ../../coins_boot.glp runs the same swap on two smartphones.
%% =============================================================================
exported procedure play_coins(Stream(ScreenContent), Stream(ScreenContent)).
play_coins(ScreenA?, ScreenB?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("currency.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_coins_person(C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    coin_person(alice, PersonEndA?, [mint(2), swap(bob, alice, 2, bob, 2)], ScreenA),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_coins_person(C?, CSig?, AppEndB?, BobOut?, BobIn),
    coin_person(bob, PersonEndB?, [mint(2), accept(alice)], ScreenB).

%% The person's end of the cards-and-answers channel: the screen messages,
%% read off the events; no card is answered here.
procedure screen_of(Channel(Stream(Event), Stream(UserAnswer))?, Stream(ScreenContent)).
screen_of(ch(Events, Answers?), Screen?) :- hold_answers(Answers), screen_events(Events?, Screen).

procedure hold_answers(Stream(UserAnswer)).
hold_answers(X?) :- true.

procedure screen_events(Stream(Event)?, Stream(ScreenContent)).
screen_events([msg(_, _, X) | Es], [X? | Screen?]) :- ground(X?) | screen_events(Es?, Screen).
screen_events([card(_, _, _) | Es], Screen?) :- screen_events(Es?, Screen).
screen_events([closed(_) | Es], Screen?) :- screen_events(Es?, Screen).
screen_events([], []).

procedure alice_coins_person(Content?, String?, Channel(Stream(UserAnswer), Stream(Event))?, AgentToUserStream?, UserInStream).
alice_coins_person(C, CSig, AppEnd, Outs,
                   [msg(person, alice, install_coins(currency, C?, CSig?, AppEnd?)),
                    msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_coins_run(Outs?, Cmds).

procedure alice_coins_run(AgentToUserStream?, UserInStream).
alice_coins_run([msg(agent, person, connected(bob)) | Outs],
                [msg(person, alice, invite(currency, bob)) | Cmds?]) :-
    alice_coins_run(Outs?, Cmds).
alice_coins_run([_ | Outs], Cmds?) :- otherwise | alice_coins_run(Outs?, Cmds).
alice_coins_run([], []).

procedure bob_coins_person(Content?, String?, Channel(Stream(UserAnswer), Stream(Event))?, AgentToUserStream?, UserInStream).
bob_coins_person(C, CSig, AppEnd, Outs,
                 [msg(person, bob, install_coins(currency, C?, CSig?, AppEnd?)),
                  msg(person, bob, accept_invite(currency, alice)) | Cmds?]) :-
    bob_coins_run(Outs?, Cmds).

procedure bob_coins_run(AgentToUserStream?, UserInStream).
bob_coins_run([msg(agent, person, befriend(alice, Resp?)) | Outs],
              [msg(person, bob, decision(yes, alice, response(Resp))) | Cmds?]) :-
    bob_coins_run(Outs?, Cmds).
bob_coins_run([_ | Outs], Cmds?) :- otherwise | bob_coins_run(Outs?, Cmds).
bob_coins_run([], []).


%% The child-safe platform's two persons under :boot.
procedure alice_cssn_boot(Content?, String?, String?, Channel(Stream(CsAppCmd), Stream(CsAppNotify))?, AgentToUserStream?, UserInStream).
alice_cssn_boot(C, CK, CSig, AppEnd, Outs,
                [msg(person, alice, trust(CK?)),
                 msg(person, alice, install_cssn(childsafe, C?, CSig?, AppEnd?)),
                 msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_cssn_run(Outs?, Cmds).

procedure bob_cssn_boot(Content?, String?, String?, Channel(Stream(CsAppCmd), Stream(CsAppNotify))?, AgentToUserStream?, UserInStream).
bob_cssn_boot(C, CK, CSig, AppEnd, Outs,
              [msg(person, bob, trust(CK?)),
               msg(person, bob, install_cssn(childsafe, C?, CSig?, AppEnd?)),
               msg(person, bob, accept_invite(childsafe, alice)) | Cmds?]) :-
    bob_cssn_run(Outs?, Cmds).

%% The same two persons under :boot, each trusting the compiler's key first.
procedure alice_coins_boot(Content?, String?, String?, Channel(Stream(UserAnswer), Stream(Event))?, AgentToUserStream?, UserInStream).
alice_coins_boot(C, CK, CSig, AppEnd, Outs,
                 [msg(person, alice, trust(CK?)),
                  msg(person, alice, install_coins(currency, C?, CSig?, AppEnd?)),
                  msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_coins_run(Outs?, Cmds).

procedure bob_coins_boot(Content?, String?, String?, Channel(Stream(UserAnswer), Stream(Event))?, AgentToUserStream?, UserInStream).
bob_coins_boot(C, CK, CSig, AppEnd, Outs,
               [msg(person, bob, trust(CK?)),
                msg(person, bob, install_coins(currency, C?, CSig?, AppEnd?)),
                msg(person, bob, accept_invite(currency, alice)) | Cmds?]) :-
    bob_coins_run(Outs?, Cmds).

%% =============================================================================
%% play_cssn(SeenA, SeenB): the child-safe platform (programs/cssn/childsafe,
%% its artefact childsafe.glpw beside this program) hosted by the super-app,
%% as play_coins hosts the currency.  alice and bob install it with its two
%% certifications, alice befriends bob and invites him, and the handshake opens
%% a root channel of that platform's protocol between their two executions,
%% each activated by run/3 with its commands-and-notifications channel and its
%% conversations.  Adopting a conversation IS befriending under that contract,
%% so each execution tells its person it is connected; alice's person then
%% sends bob one message of the platform, and bob's execution shows it.
%% Expected: SeenA = [connected(bob) | _], SeenB = [connected(alice),
%% received(alice, hello) | _], → suspended (the executions pend on their
%% persons and their friends).  ../../cssn_boot.glp runs the same on two
%% smartphones.
%% =============================================================================
exported procedure play_cssn(Stream(CsAppNotify), Stream(CsAppNotify)).
play_cssn(SeenA?, SeenB?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("childsafe.glpw", C),
    certified(C?, _, CSig),
    new_channel(AppEndA, PersonEndA),
    new_channel(AppEndB, PersonEndB),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_cssn_person(C?, CSig?, AppEndA?, AliceOut?, AliceIn),
    cssn_greeter(bob, PersonEndA?, SeenA),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_cssn_person(C?, CSig?, AppEndB?, BobOut?, BobIn),
    cssn_onlooker(PersonEndB?, SeenB).

procedure alice_cssn_person(Content?, String?, Channel(Stream(CsAppCmd), Stream(CsAppNotify))?, AgentToUserStream?, UserInStream).
alice_cssn_person(C, CSig, AppEnd, Outs,
                  [msg(person, alice, install_cssn(childsafe, C?, CSig?, AppEnd?)),
                   msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_cssn_run(Outs?, Cmds).

procedure alice_cssn_run(AgentToUserStream?, UserInStream).
alice_cssn_run([msg(agent, person, connected(bob)) | Outs],
               [msg(person, alice, invite(childsafe, bob)) | Cmds?]) :-
    alice_cssn_run(Outs?, Cmds).
alice_cssn_run([_ | Outs], Cmds?) :- otherwise | alice_cssn_run(Outs?, Cmds).
alice_cssn_run([], []).

procedure bob_cssn_person(Content?, String?, Channel(Stream(CsAppCmd), Stream(CsAppNotify))?, AgentToUserStream?, UserInStream).
bob_cssn_person(C, CSig, AppEnd, Outs,
                [msg(person, bob, install_cssn(childsafe, C?, CSig?, AppEnd?)),
                 msg(person, bob, accept_invite(childsafe, alice)) | Cmds?]) :-
    bob_cssn_run(Outs?, Cmds).

procedure bob_cssn_run(AgentToUserStream?, UserInStream).
bob_cssn_run([msg(agent, person, befriend(alice, Resp?)) | Outs],
             [msg(person, bob, decision(yes, alice, response(Resp))) | Cmds?]) :-
    bob_cssn_run(Outs?, Cmds).
bob_cssn_run([_ | Outs], Cmds?) :- otherwise | bob_cssn_run(Outs?, Cmds).
bob_cssn_run([], []).

%% The person on the mini-app's own channel: told it is connected to the
%% friend, it sends that friend one message of the platform.
procedure cssn_greeter(Constant?, Channel(Stream(CsAppNotify), Stream(CsAppCmd))?, Stream(CsAppNotify)).
cssn_greeter(F, ch(Notify, Cmds?), Seen?) :-
    ground(F?) |
    cg(F?, Notify?, Cmds, Seen).

procedure cg(Constant?, Stream(CsAppNotify)?, Stream(CsAppCmd), Stream(CsAppNotify)).
cg(F, [connected(F1) | Ns], [send(F1?, hello) | Cmds?], [connected(F1?) | Seen?]) :-
    F? =?= F1? |
    cg_rest(Ns?, Cmds, Seen).
cg(F, [N | Ns], Cmds?, [N? | Seen?]) :- otherwise | cg(F?, Ns?, Cmds, Seen).
cg(_, [], [], []).

procedure cg_rest(Stream(CsAppNotify)?, Stream(CsAppCmd), Stream(CsAppNotify)).
cg_rest([N | Ns], Cmds?, [N? | Seen?]) :- ground(N?) | cg_rest(Ns?, Cmds, Seen).
cg_rest([], [], []).

%% The person who only watches, and commands nothing.
procedure cssn_onlooker(Channel(Stream(CsAppNotify), Stream(CsAppCmd))?, Stream(CsAppNotify)).
cssn_onlooker(ch(Notify, Cmds?), Seen?) :- hold_cmds(Cmds), pass_notify(Notify?, Seen).

procedure hold_cmds(Stream(CsAppCmd)).
hold_cmds(X?) :- true.

procedure pass_notify(Stream(CsAppNotify)?, Stream(CsAppNotify)).
pass_notify([N | Ns], [N? | Seen?]) :- ground(N?) | pass_notify(Ns?, Seen).
pass_notify([], []).

%% =============================================================================
%% play_both(ScreenA, ScreenB, SeenA, SeenB): ONE super-app hosting BOTH
%% mini-apps at once (SGSG paper, Section 7, and Theorem 6.5, which is about
%% two mini-apps on one smartphone).  alice and bob each install the currency
%% and the child-safe platform, each with its own user-interface grant; alice
%% invites bob to both; the two handshakes open a root channel of each
%% platform's own protocol, and each super-app activates both entries by run/3,
%% each with its own conversations.  Then both platforms run at once over the
%% one friendship: alice and bob mint and swap under the currency's contract,
%% and alice greets bob under the child-safe platform's.  Expected: ScreenA and
%% ScreenB as in play_coins, SeenA = [connected(bob) | _], SeenB =
%% [connected(alice), received(alice, hello) | _], → suspended.
%% =============================================================================
exported procedure play_both(Stream(ScreenContent), Stream(ScreenContent), Stream(CsAppNotify), Stream(CsAppNotify)).
play_both(ScreenA?, ScreenB?, SeenA?, SeenB?) :-
    crossbar2(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    load_file("currency.glpw", CC),
    certified(CC?, _, CCSig),
    load_file("childsafe.glpw", CS),
    certified(CS?, _, CSSig),
    new_channel(CoinsEndA, CoinsPersonA),
    new_channel(CssnEndA, CssnPersonA),
    new_channel(CoinsEndB, CoinsPersonB),
    new_channel(CssnEndB, CssnPersonB),
    agent # agent(alice, AliceIn?, AliceNetIn?, [user_output(AliceOut), net_output(AliceNetOut)]),
    alice_both_person(CC?, CCSig?, CoinsEndA?, CS?, CSSig?, CssnEndA?, AliceOut?, AliceIn),
    coin_person(alice, CoinsPersonA?, [mint(2), swap(bob, alice, 2, bob, 2)], ScreenA),
    cssn_greeter(bob, CssnPersonA?, SeenA),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_both_person(CC?, CCSig?, CoinsEndB?, CS?, CSSig?, CssnEndB?, BobOut?, BobIn),
    coin_person(bob, CoinsPersonB?, [mint(2), accept(alice)], ScreenB),
    cssn_onlooker(CssnPersonB?, SeenB).

%% alice's person: install both, cold-call bob, and invite him to both once
%% they are friends.
procedure alice_both_person(Content?, String?, Channel(Stream(UserAnswer), Stream(Event))?, Content?, String?, Channel(Stream(CsAppCmd), Stream(CsAppNotify))?, AgentToUserStream?, UserInStream).
alice_both_person(CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                  [msg(person, alice, install_coins(currency, CC?, CCSig?, CoinsEnd?)),
                   msg(person, alice, install_cssn(childsafe, CS?, CSSig?, CssnEnd?)),
                   msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_both_run(Outs?, Cmds).

procedure alice_both_run(AgentToUserStream?, UserInStream).
alice_both_run([msg(agent, person, connected(bob)) | Outs],
               [msg(person, alice, invite(currency, bob)),
                msg(person, alice, invite(childsafe, bob)) | Cmds?]) :-
    alice_both_run(Outs?, Cmds).
alice_both_run([_ | Outs], Cmds?) :- otherwise | alice_both_run(Outs?, Cmds).
alice_both_run([], []).

%% bob's person: install both, consent to the friendship, and accept both
%% invitations.
procedure bob_both_person(Content?, String?, Channel(Stream(UserAnswer), Stream(Event))?, Content?, String?, Channel(Stream(CsAppCmd), Stream(CsAppNotify))?, AgentToUserStream?, UserInStream).
bob_both_person(CC, CCSig, CoinsEnd, CS, CSSig, CssnEnd, Outs,
                [msg(person, bob, install_coins(currency, CC?, CCSig?, CoinsEnd?)),
                 msg(person, bob, install_cssn(childsafe, CS?, CSSig?, CssnEnd?)),
                 msg(person, bob, accept_invite(currency, alice)),
                 msg(person, bob, accept_invite(childsafe, alice)) | Cmds?]) :-
    bob_both_run(Outs?, Cmds).

procedure bob_both_run(AgentToUserStream?, UserInStream).
bob_both_run([msg(agent, person, befriend(alice, Resp?)) | Outs],
             [msg(person, bob, decision(yes, alice, response(Resp))) | Cmds?]) :-
    bob_both_run(Outs?, Cmds).
bob_both_run([_ | Outs], Cmds?) :- otherwise | bob_both_run(Outs?, Cmds).
bob_both_run([], []).

%% =============================================================================
%% coin_person(Id, PersonEnd, Script, Screen): a scripted person on the
%% super-app's end of the currency's cards-and-answers channel, after
%% Currencies' person.glp: the mediator reissues the request cards after every
%% reduction, so a step is answered on the latest open card of its clause
%% (mint on agent_1, swap on agent_2, accept on the respond_swap_2 card of the
%% proposer) and is done when the screen shows its effect.
%% =============================================================================
procedure coin_person(Constant?, Channel(Stream(Event), Stream(UserAnswer))?, CoinScript?, Stream(ScreenContent)).
coin_person(Id, ch(Events, Answers?), Script, Screen?) :-
    ground(Id?) |
    cp(Id?, Events?, Answers, Script?, open(no_card, no_card), [], idle, Screen).

procedure cp(Constant?, Stream(Event)?, Stream(UserAnswer), CoinScript?, OpenCards?, SwapCards?, Sent?, Stream(ScreenContent)).
cp(Id, [card(agent_1, _, R) | Es], As?, Script, open(_, S), Swaps, P, Screen?) :-
    ground(R?) |
    try_step(Id?, Es?, As, Script?, open(R?, S?), Swaps?, P?, Screen).
cp(Id, [card(agent_2, _, R) | Es], As?, Script, open(M, _), Swaps, P, Screen?) :-
    ground(R?) |
    try_step(Id?, Es?, As, Script?, open(M?, R?), Swaps?, P?, Screen).
cp(Id, [card(respond_swap_2, ctx_respond_swap_2(From, _, _), R) | Es], As?, Script, Open, Swaps, P, Screen?) :-
    ground(From?), ground(R?) |
    try_step(Id?, Es?, As, Script?, Open?, [swap_card(From?, R?) | Swaps?], P?, Screen).
cp(Id, [card(L, _, _) | Es], As?, Script, Open, Swaps, P, Screen?) :-
    ~(L? =?= agent_1), ~(L? =?= agent_2), ~(L? =?= respond_swap_2) |
    cp(Id?, Es?, As, Script?, Open?, Swaps?, P?, Screen).
cp(Id, [closed(R) | Es], As?, Script, open(M, S), Swaps, P, Screen?) :-
    ground(R?) |
    close_req(R?, M?, M1),
    close_req(R?, S?, S1),
    close_swap(R?, Swaps?, Swaps1),
    close_sent(R?, P?, P1),
    try_step(Id?, Es?, As, Script?, open(M1?, S1?), Swaps1?, P1?, Screen).
cp(Id, [msg(_, _, X) | Es], As?, [Step | Script], Open, Swaps, P, [X? | Screen?]) :-
    ground(X?), ground(Step?) |
    done(Step?, X?, D),
    advance(D?, Id?, Es?, As, Step?, Script?, Open?, Swaps?, P?, Screen).
cp(Id, [msg(_, _, X) | Es], As?, [], Open, Swaps, P, [X? | Screen?]) :-
    ground(X?) |
    cp(Id?, Es?, As, [], Open?, Swaps?, P?, Screen).
cp(_, [], [], _, _, _, _, []).

procedure close_req(CReqId?, OpenReq?, OpenReq).
close_req(R, R1, no_card) :- R? =?= R1? | true.
close_req(_, R1, R1?) :- otherwise | true.

procedure close_swap(CReqId?, SwapCards?, SwapCards).
close_swap(R, [swap_card(_, R1) | Rest], Rest?) :- R? =?= R1? | true.
close_swap(R, [S | Rest], [S? | Rest1?]) :- otherwise | close_swap(R?, Rest?, Rest1).
close_swap(_, [], []).

procedure close_sent(CReqId?, Sent?, Sent).
close_sent(R, sent(R1), idle) :- R? =?= R1? | true.
close_sent(_, P, P?) :- otherwise | true.

procedure done(CoinStep?, ScreenContent?, Constant).
done(mint(K), minted(K1), yes) :- K? =:= K1? | true.
done(swap(Q, _, _, _, _), swap_done(Q1), yes) :- Q? =?= Q1? | true.
done(accept(Q), swap_done(Q1), yes) :- Q? =?= Q1? | true.
done(_, _, no) :- otherwise | true.

procedure advance(Constant?, Constant?, Stream(Event)?, Stream(UserAnswer), CoinStep?, CoinScript?, OpenCards?, SwapCards?, Sent?, Stream(ScreenContent)).
advance(yes, Id, Es, As?, _, Script, Open, Swaps, _, Screen?) :-
    try_step(Id?, Es?, As, Script?, Open?, Swaps?, idle, Screen).
advance(no, Id, Es, As?, Step, Script, Open, Swaps, P, Screen?) :-
    cp(Id?, Es?, As, [Step? | Script?], Open?, Swaps?, P?, Screen).

procedure try_step(Constant?, Stream(Event)?, Stream(UserAnswer), CoinScript?, OpenCards?, SwapCards?, Sent?, Stream(ScreenContent)).
try_step(Id, Es, As?, [], Open, Swaps, P, Screen?) :-
    cp(Id?, Es?, As, [], Open?, Swaps?, P?, Screen).
try_step(Id, Es, As?, [Step | Script], Open, Swaps, sent(R), Screen?) :-
    cp(Id?, Es?, As, [Step? | Script?], Open?, Swaps?, sent(R?), Screen).
try_step(Id, Es, As?, [Step | Script], Open, Swaps, idle, Screen?) :-
    ground(Step?), ground(Open?), ground(Swaps?) |
    pick(Step?, Open?, Swaps?, Choice, Swaps1),
    act(Choice?, Id?, Es?, As, [Step? | Script?], Open?, Swaps1?, Screen).

procedure pick(CoinStep?, OpenCards?, SwapCards?, Choice, SwapCards).
pick(mint(K), open(req(N), _), Swaps, answer(req(N?), xs_agent_1(K?)), Swaps?).
pick(swap(Q, U, K, V, K1), open(_, req(N)), Swaps, answer(req(N?), xs_agent_2(Q?, U?, K?, V?, K1?)), Swaps?).
pick(accept(From), _, Swaps, C?, Swaps1?) :-
    ground(From?) | find_swap(From?, Swaps?, C, Swaps1).
pick(_, _, Swaps, wait, Swaps?) :- otherwise | true.

procedure find_swap(Constant?, SwapCards?, Choice, SwapCards).
find_swap(From, [swap_card(F, R) | Rest], answer(R?, xs_respond_swap_2(yes)), Rest?) :-
    From? =?= F? | true.
find_swap(From, [S | Rest], C?, [S? | Rest1?]) :- otherwise | find_swap(From?, Rest?, C, Rest1).
find_swap(_, [], wait, []).

procedure act(Choice?, Constant?, Stream(Event)?, Stream(UserAnswer), CoinScript?, OpenCards?, SwapCards?, Stream(ScreenContent)).
act(answer(R, A), Id, Es, [answer(R?, A?) | As1?], Script, Open, Swaps, Screen?) :-
    ground(R?) |
    cp(Id?, Es?, As1, Script?, Open?, Swaps?, sent(R?), Screen).
act(wait, Id, Es, As?, Script, Open, Swaps, Screen?) :-
    cp(Id?, Es?, As, Script?, Open?, Swaps?, idle, Screen).
