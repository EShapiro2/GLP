%% home.vglp --- the super-app's person interface, in vGLP: the acts a person
%% wills of their own super-app, and their answer to a friend who asks to
%% connect.  Its canonical compilation (vGLP, Definition "Canonical
%% Compilation") --- home/3 with its ask stream, the construct processes of
%% its questions and the dispatcher --- is home.glp beside this file (glpc
%% :emit); the compiled module is not edited.
%%
%% The four acts are those of GSG paper Section 3: trusting a compiler's key,
%% installing a certified mini-app, inviting a friend to it, and connecting
%% with a person.  What the acts produce is the very command stream the
%% super-app's agent reads (agent.glp, agent/4's person input), so the
%% person's volitions reach the same agent whether they are willed through
%% the constructs of these questions or written by a play's script.
%%
%% The syntax is vGLP's (Definition "Volitional Procedure, Interactive Type,
%% Interactive Term, Ordinary Clause, vGLP Program").  home/3 is a volitional
%% procedure whose question is the stream of the person's requests,
%% Stream(Request)?, of a union type with one alternative per act; its one
%% clause asks it, once, and passes it to serve, ordinary GLP, which has one
%% clause per alternative, each reading its request at the head of the
%% stream, and carries the rest of the stream, Reqs?, through every helper
%% that continues it.  The person writes a stream of a union of tuples, whose
%% default widget is a menu of forms kept open, one request per submission
%% (Definition "Widget Declaration, Default Widget"; Remark "Persistence"):
%% no widget declaration is needed.  Each argument of a request is a named
%% type over Key or String, so that the default form labels its field by it,
%% a Key's field being a peer field.
%%
%% respond_friend is a volitional procedure whose interactive type, a card,
%% is in writer mode: one goal per friend who asks to connect, so several
%% pend at once and are answered in any order; its clause writes the card at
%% once, the friend for the person to see, and hands the person the writer of
%% their answer, which decide_friend reads with a clause per answer.  The
%% card goes when it is answered (Remark "Persistence").
%%
%% respond_intro is the same for an introduction (GSG paper, Section 5.2:
%% each agent presents the introduction to its person; the friendship forms
%% on mutual consent): one goal per introduction, its card showing the
%% introducer and the other party, and decide_intro reads the person's
%% answer with a clause per answer.  The agent's notice of the introduction
%% informs; the consent is asked by this card only (GSG, 2026-10-14 09:24
%% UTC, item 1).
%%
%% What the super-app tells the person is not a question: superapp/3
%% (self.glp) sends it to the person on the program's own end of the person
%% channel, which the dispatcher merges with the constructs' draws.
%%
%% Clause order follows the paper's remark "Ordering with otherwise": the
%% request clauses follow every otherwise clause of serve.
%%
%% The types not declared here --- Decision, PendingValue, UserInMsg,
%% AgentToUserStream, Content --- are those of ../self.glp, and the person
%% channel's, PersonChannel(T), the root's.

%% =============================================================================
%% The questions (vGLP, Definition "Volitional Procedure, Interactive Type,
%% ..."): the person's requests, home's interactive type in reader mode, and
%% the cards of a friend who asks to connect and of an introduction, in writer
%% mode.
%% =============================================================================

%% The fields of the requests, each a named type so that the form labels it.
CompilerKey ::= Key.
Friend      ::= Key.
AppName     ::= String.
Artefact    ::= String.

%% A request: one alternative per request clause of serve --- trust, install,
%% invite and connect --- with the arguments its clause reads.
Request ::= trust(CompilerKey)
          ; install(AppName, Artefact)
          ; invite(AppName, Friend)
          ; connect(Friend).

%% The card of a friend who asks to connect: the friend, which the program
%% writes for the person to see, and the person's answer, yes or no.
FriendRequest ::= from(Friend, Decision?).

%% The card of an introduction: the introducer and the other party, which the
%% program writes for the person to see, and the person's answer, yes or no.
%% Each is an agent's name, its key (GSG, 2026-10-14 11:38 UTC, (a)).
Introducer ::= Key.
Other      ::= Key.
IntroRequest ::= from(Introducer, Other, Decision?).

%% =============================================================================
%% The person's answer to a friend who asks to connect.
%% =============================================================================

%% The pending value of the befriending is passed back as it came.
procedure (FriendRequest)*respond_friend(Key?, Key?, PendingValue?, Stream(UserInMsg)).

%% Show the person the friend who asks to connect, and pass their answer on.
(from(From?, Answer))*respond_friend(Id, From, P, Cmds?) :-
    ground(Id?), ground(From?) |
    decide_friend(Answer?, Id?, From?, P?, Cmds).

%% yes consents and no refuses: the person's decision, with the pending value
%% passed back as it came.
procedure decide_friend(Decision?, Key?, Key?, PendingValue?, Stream(UserInMsg)).
decide_friend(yes, Id, From, P, [msg(person, Id?, decision(yes, From?, P?))]).
decide_friend(no, Id, From, P, [msg(person, Id?, decision(no, From?, P?))]).

%% =============================================================================
%% The person's answer to an introduction.
%% =============================================================================

%% The pending value of the introduction is passed back as it came.
procedure (IntroRequest)*respond_intro(Key?, Key?, Key?, PendingValue?, Stream(UserInMsg)).

%% Show the person the introducer and the other party, and pass their answer
%% on.
(from(From?, Other?, Answer))*respond_intro(Id, From, Other, P, Cmds?) :-
    ground(Id?), ground(From?), ground(Other?) |
    decide_intro(Answer?, Id?, Other?, P?, Cmds).

%% yes consents and no refuses: the agent binds its consent variable to
%% yes(...) or no by the pending value passed back as it came.
procedure decide_intro(Decision?, Key?, Key?, PendingValue?, Stream(UserInMsg)).
decide_intro(yes, Id, Other, P, [msg(person, Id?, accept_intro(Other?, P?))]).
decide_intro(no, Id, Other, P, [msg(person, Id?, reject_intro(Other?, P?))]).

%% =============================================================================
%% The person's own acts on their super-app
%% =============================================================================

%% home(Id, Outs, Cmds): the person's commands to their super-app, willed as
%% the requests of its question; Outs is what the super-app tells the person,
%% on which a friend's request to connect and an introduction raise their
%% cards.
exported procedure (Stream(Request)?)*home(Key?, AgentToUserStream?, Stream(UserInMsg)).

%% Ask the person for their requests, once, and serve them.
(Reqs)*home(Id, Outs, Cmds?) :-
    serve(Reqs?, Id?, Outs?, Cmds).

%% serve(Reqs, Id, Outs, Cmds): home, with the rest of the person's requests.
procedure serve(Stream(Request)?, Key?, AgentToUserStream?, Stream(UserInMsg)).

%% A friend asks to connect: the person answers on a card of their own.
serve(Reqs, Id, [msg(agent, person, befriend(From, P)) | Outs], Cmds?) :-
    ground(Id?), ground(From?) |
    respond_friend(Id?, From?, P?, Answer),
    merge(Answer?, Cmds1?, Cmds),
    serve(Reqs?, Id?, Outs?, Cmds1).

%% A friend introduces the person to another: the person answers on a card of
%% their own.
serve(Reqs, Id, [msg(agent, person, befriend_intro(From, Other, P)) | Outs], Cmds?) :-
    ground(Id?), ground(From?), ground(Other?) |
    respond_intro(Id?, From?, Other?, P?, Answer),
    merge(Answer?, Cmds1?, Cmds),
    serve(Reqs?, Id?, Outs?, Cmds1).

%% Anything else the super-app says is the person's to see, not an ask.
serve(Reqs, Id, [_ | Outs], Cmds?) :-
    ground(Id?), otherwise |
    serve(Reqs?, Id?, Outs?, Cmds).

serve(_, _, [], []).

%% Trust a compiler's key: what its certificate signs is then installable.
serve([trust(Key) | Reqs], Id, Outs, Cmds?) :-
    ground(Id?), ground(Key?) |
    trust_act(Key?, Id?, Reqs?, Outs?, Cmds).

%% Install a certified mini-app: the artefact beside this program is read, its
%% creator's certification signed over its source identity, and the mini-app
%% installed under the name the person gives it, with its end of the person
%% channel on which it will show its person its own screen.
serve([install(App, Name) | Reqs], Id, Outs, Cmds?) :-
    ground(Id?), ground(App?), ground(Name?) |
    load_file(Name?, C),
    install_act(C?, App?, Id?, Reqs?, Outs?, Cmds).

%% Invite a friend to a mini-app installed here.
serve([invite(App, Friend) | Reqs], Id, Outs, Cmds?) :-
    ground(Id?), ground(App?), ground(Friend?) |
    invite_act(App?, Friend?, Id?, Reqs?, Outs?, Cmds).

%% Ask a person to connect: the cold call of the social graph.
serve([connect(Friend) | Reqs], Id, Outs, Cmds?) :-
    ground(Id?), ground(Friend?) |
    connect_act(Friend?, Id?, Reqs?, Outs?, Cmds).

%% The willed acts, each the command it puts on the person's stream.
procedure trust_act(String?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg)).
trust_act(Key, Id, Reqs, Outs, [msg(person, Id?, trust(Key?)) | Cmds?]) :-
    ground(Key?) | serve(Reqs?, Id?, Outs?, Cmds).

procedure invite_act(Constant?, Key?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg)).
invite_act(App, Friend, Id, Reqs, Outs, [msg(person, Id?, invite(App?, Friend?)) | Cmds?]) :-
    ground(App?), ground(Friend?) | serve(Reqs?, Id?, Outs?, Cmds).

procedure connect_act(Key?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg)).
connect_act(Friend, Id, Reqs, Outs, [msg(person, Id?, connect(Friend?)) | Cmds?]) :-
    ground(Friend?) | serve(Reqs?, Id?, Outs?, Cmds).

%% install_act(Content, App, Id, Reqs, Outs, Cmds): a certified artefact is
%% installed under the person's name for it, with the mini-app's end of a
%% fresh person channel, at Opaque, the super-app holding no declaration of a
%% mini-app's types (GSG paper, Section 3, "What the super-app grants a
%% mini-app"); anything else is not installed, and the person's stream
%% carries on.
procedure install_act(Content?, Constant?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg)).
install_act(M, App, Id, Reqs, Outs, [msg(person, Id?, install(App?, M?, CSig?, Ui?)) | Cmds?]) :-
    module(M?) |
    creator_certification(M?, CSig),
    new_channel(Ui, Person),
    hold_person(Person?),
    serve(Reqs?, Id?, Outs?, Cmds).
install_act(S, _, Id, Reqs, Outs, Cmds?) :-
    string(S?) |
    serve(Reqs?, Id?, Outs?, Cmds).

%% The creator's certification, signed here over the mini-app's source identity
%% and the acts of its contract, as the super-app's plays sign it.
procedure creator_certification(Module?, String).
creator_certification(M, CSig?) :-
    decompose_module(M?, _, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [friendship, ending_a_friendship], grassroots), K?, CSig).

%% The person's end of the mini-app's person channel is held by hold_person/1
%% (self.glp) until there is a screen to show it on, its draws read to their
%% close, which the mini-app's execution writes, or the super-app's
%% close_apps/1 where the mini-app is never activated.
