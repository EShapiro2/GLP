%% agent.vglp — the social-graph agent as a vGLP program.
%%
%% vGLP source of the tested GLP program agent.glp + ui/mediator.glp (this
%% directory): the agent authored with volition-guarded clauses, the mediator
%% and its UserCmd/UserNotify vocabulary absent — they belong to the
%% implementation, which maps the volition-guarded clauses into concrete UI
%% constructs.  Exhibit for the paper "Volition Elicitation: Operational
%% Semantics for People and Their Machines", which defines vGLP.
%%
%% NOTATION (defined in the paper):
%%   *                          marks a volition-guarded clause: reducing a goal with
%%                              it requires, besides its guards, the person willing
%%                              this reduction. Among volition-guarded clauses for
%%                              the same goal, the person's answer selects the clause.
%%   *(X1,...,Xk)               a volition-guarded clause with person-supplied inputs:
%%                              the person's answer binds the writers X1..Xk; the clause
%%                              carries their readers Xi?.
%%
%% RESPONDERS. An arriving offer spawns a responder goal — respond_coldcall,
%% respond_intro — one goal per offer, so offers pend concurrently and are
%% answered in any order.  The responder carries the offer and the pending
%% value, the two consents of the befriending by this agent's role (GSG paper,
%% Sections 5.1 and 5.2); its one volition-guarded clause is the acceptance,
%% its else-branch the refusal, taken when the person wills no answer, and the
%% branch taken injects the person's decision, with the pending value passed
%% back as it came, through a merge, into the agent's UserIn.
%%
%% Correspondence to the implementation (clause for clause):
%%   - a *(X1..Xk) Request clause  ->  a UserCmd constructor over X1..Xk, a mediator
%%     pass-through, and the agent clause matching msg(person, Id, cmd(X1..Xk)):
%%     connect/1, unfriend/1, send/2, introduce/2;
%%   - a responder goal, spawned per arriving offer  ->  a pending-table entry
%%     req(N) in the mediator, rendered as an inbox card;
%%   - a responder's then-branch and else-branch  ->  the UserCmds decision/3
%%     (cold call, yes and no) and accept_intro/2, reject_intro/2 (introduction)
%%     routing the pending value back to the agent; the agent's decision clauses
%%     below match the deployed clauses modulo the msg(person, Id, ...) wrapper,
%%     and the deployed accept_intro and reject_intro are the same by role, with
%%     the held links' bookkeeping, which this exhibit leaves out.
%% The escrow vocabulary — befriend/2, befriend_intro/3, and the pending table —
%% does not appear here: the machine's question to the person is not a message
%% but a pending volition-guarded reduction.
%%
%% Clause order follows the paper's remark "Ordering with otherwise":
%% Request clauses (perpetually pending) follow every otherwise clause of the
%% procedure — the compose clauses come last, after the catch-alls — and
%% between volition-guarded siblings otherwise is not used.
%%
%% This file is vGLP, not GLP: the REPL does not load it (hence .vglp).  Its
%% correctness argument is the clause-for-clause correspondence to the tested,
%% deployed implementation in this directory.
%%
%% Shared types (Decision, Conveyance, ProposerConsent, AcceptorConsent,
%% PendingValue, FriendContent, FriendMsg, FriendStream, FriendChannel,
%% NetColdCall, NetOutMsg, NetOutStream, NetInMsg, NetInStream) are those of
%% self.glp.  Helper procedures — channel ops, merge, the lib/routing routers
%% (send_user, send_net, send_friend), await_consent, await_conveyance,
%% already_friend, convey, adopt, close_friend, and the local cold_call,
%% anchor_friend, send_step and close_outputs — are those of agent.glp and
%% lib/routing/, unchanged; this file gives the agent procedure and its
%% responders.


%% Screen vocabulary — self.glp's AgentContent minus the escrow vocabulary
%% (befriend/2, befriend_intro/3): under vGLP the machine asks the person by a
%% pending reduction, not by a message.
AgentContent ::= connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; unfriended(Constant)
               ; received(Key, Constant)
               ; not_a_friend(Key).
AgentToUserMsg    ::= msg(Constant, Constant, AgentContent).
AgentToUserStream ::= [] ; [AgentToUserMsg | AgentToUserStream].

OutputEntry ::= user_output(AgentToUserStream?)
              ; net_output(NetOutStream?)
              ; friend_output(Key, FriendStream?).
OutputsList ::= [] ; [OutputEntry | OutputsList].

%% UserIn — under vGLP the person's commands are grants, not messages; UserIn
%% carries the decisions the responders inject and the outcomes the awaits
%% inject (await_consent, await_conveyance).
UserInMsg      ::= decision(Decision, Key, PendingValue)
                 ; consented(Key, Conveyance?)
                 ; adopt(Key, FriendChannel)
                 ; declined(Key).
UserInStream   ::= [] ; [UserInMsg | UserInStream].

%% The offers the responders carry: the question the pending reduction poses.
ColdCallOffer ::= offer(Key).
IntroOffer    ::= offer(Key).

%% =============================================================================
%% RESPONDERS — one goal per arriving offer; the volition-guarded clauses live
%% here, so offers pend concurrently and are answered in any order.
%% =============================================================================

procedure respond_coldcall(ColdCallOffer?, PendingValue?, UserInStream).

%% Answer a friend offer.  The else-branch is the refusal, taken when the
%% person wills no answer: the decision no, on which the agent binds its
%% consent to no.
*(Answer=yes, From?)
respond_coldcall(offer(From), P, [decision(Answer?, From?, P?)]) :-
    ground(From?) | true
 *(no) true.

procedure respond_intro(IntroOffer?, PendingValue?, UserInStream).

%% Answer an introduction, as a friend offer is answered: the pending value
%% carries this agent's consent and the other's, by role.
*(Answer=yes, Other?)
respond_intro(offer(Other), P, [decision(Answer?, Other?, P?)]) :-
    ground(Other?) | true
 *(no) true.

%% =============================================================================
%% AGENT/4
%% =============================================================================

procedure agent(Key?, UserInStream?, NetInStream?, OutputsList?).

%% --- Reactive: network messages ---

%% A peer cold-calls me: spawn a responder with the pending value by my role,
%% the opposite of the message's name; the answer is merged into UserIn.
agent(Id, UserIn, [msg(Id1, befriend_propose(From, yes, Mine?))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_coldcall(offer(From?), propose(Mine, yes), Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).
agent(Id, UserIn, [msg(Id1, befriend_accept(From, yes(C), Mine?))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_coldcall(offer(From?), accept(Mine, yes(C?)), Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).

%% A common friend offers an introduction: spawn a responder likewise.
agent(Id, UserIn, [msg(_From, Id1, introduce_propose(Other, Mine?, Theirs))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_intro(offer(Other?), propose(Mine, Theirs?), Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).
agent(Id, UserIn, [msg(_From, Id1, introduce_accept(Other, Mine?, Theirs))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_intro(offer(Other?), accept(Mine, Theirs?), Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).

%% A friend messages me.
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% A friend unfriended me (Integrate unfriend): comply — tear down my side and
%% tell the person the friend is gone.
agent(Id, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs) :-
    Id? =?= Id1?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    send_user(msg(agent, person, unfriended(From?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% Network catch-all (drop unrecognised network message).
agent(Id, UserIn, [_|NetIn], Outs) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Reactive: responder answers and injected outcomes on UserIn ---

%% The person answered a befriending (injected by a responder), by my role:
%% the proposer binds its consent to yes(Conveyance?) and awaits the other's;
%% the acceptor binds its consent to yes and awaits the proposer's; a refusal
%% binds the consent to no and tells the person.
agent(Id, [decision(yes, From, propose(yes(C?), Theirs))|UserIn], NetIn, Outs) :-
    ground(Id?) |
    await_consent(From?, Theirs?, C, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).
agent(Id, [decision(yes, From, accept(yes, Theirs))|UserIn], NetIn, Outs) :-
    ground(Id?) |
    await_conveyance(From?, Theirs?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).
agent(Id, [decision(no, _, propose(no, _))|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user(msg(agent, person, rejected), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).
agent(Id, [decision(no, _, accept(no, _))|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user(msg(agent, person, rejected), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% The other consented (injected by await_consent): test already_friend and
%% convey — already_friends, or a fresh friend channel installed at once.
agent(Id, [consented(Other, Conv?)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Other?) |
    already_friend(Other?, Outs?, Outs1, D),
    convey(D?, Other?, Conv, Outs1?, Outs2, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs2?).

%% The friend channel conveyed (injected by await_conveyance): install it.
agent(Id, [adopt(Other, Ch)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Other?) |
    adopt(Other?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% The other declined (injected by either await): tell the person.
agent(Id, [declined(Other)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user(msg(agent, person, rejected(Other?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Injection catch-all (drop unrecognised injected message).
agent(Id, [_|UserIn], NetIn, Outs) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Volitional: social transactions the person originates ---
%% Request clauses, perpetually pending, placed after every otherwise clause
%% (remark "Ordering with otherwise"); each willing supplies the parameters.
%% Compiled form: UserCmds connect/1, unfriend/1, send/2, introduce/2.

%% Offer friendship by cold call (cold_call/6, agent.glp, as app:code prints
%% it).
*(Target)
agent(Id, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Target?) |
    cold_call(Id?, Target?, UserIn?, UserIn1, Outs?, Outs1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% Unfriend (End friend): notify the peer on the friend channel, tear down,
%% and tell the person the friend is gone.  Guarded by either party, so
%% one-way: no ack, no decline.
%% Idempotent: if Target is not a friend, send_friend and close_friend are
%% no-ops.
*(Target)
agent(Id, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Target?) |
    send_friend(Target?, msg(Id?, Target?, unfriend), Outs?, Outs1),
    close_friend(Target?, Outs1?, Outs2),
    send_user(msg(agent, person, unfriended(Target?)), Outs2?, Outs3),
    agent(Id?, UserIn?, NetIn?, Outs3?).

%% Message a friend: a message the person addresses to someone who is not
%% their friend is not sent, and the agent tells the person so (GSG Section
%% 5.1): the lookup of the outputs list and the dispatch on its answer
%% (send_step/6, agent.glp).
*(Target, Text)
agent(Id, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Target?) |
    anchor_friend(Target?, Outs?, Outs1, F),
    send_step(F?, Id?, Target?, Text?, Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% Offer an introduction of friend P to friend Q: the two consent variables,
%% each party's own to write and the other's to read, by role.
*(P, Q)
agent(Id, UserIn, NetIn, Outs) :-
    ground(Id?), ground(P?), ground(Q?), P? =?\= Q? |
    introduce_pair(Id?, P?, Q?, Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- Termination ---

agent(_, [], _, Outs) :- close_outputs(Outs?).
agent(_, _, [], Outs) :- close_outputs(Outs?).

%% The introduction's two messages by role, the smaller identity proposing
%% (introduce_step/9, agent.glp, as app:code prints it).
procedure introduce_pair(Key?, Key?, Key?, OutputsList?, OutputsList).
introduce_pair(Id, P, Q, Outs, Outs2?) :-
    P? @< Q? |
    send_friend(P?, msg(Id?, P?, introduce_propose(Q?, PSay, QSay?)), Outs?, Outs1),
    send_friend(Q?, msg(Id?, Q?, introduce_accept(P?, QSay, PSay?)), Outs1?, Outs2).
introduce_pair(Id, P, Q, Outs, Outs2?) :-
    otherwise |
    send_friend(Q?, msg(Id?, Q?, introduce_propose(P?, QSay, PSay?)), Outs?, Outs1),
    send_friend(P?, msg(Id?, P?, introduce_accept(Q?, PSay, QSay?)), Outs1?, Outs2).
