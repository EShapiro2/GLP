%% agent.glp — Social agent module
%%
%% Exports: agent/4
%% Types: from self.glp (ancestor scoping)
%% No cross-module imports — all helpers are local.


%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

%% send/3, receive/3 and new_channel/2 are the root's (programs/self.glp),
%% reached by scope.

%% =============================================================================
%% MERGE
%% =============================================================================

%% merge/3 is now defined once in the root programs/self.glp (A3 amendment).

%% =============================================================================
%% OUTPUT ROUTING, ADD_FRIEND_OUTPUT — provided by lib/routing/ (output.glp),
%% exposed from the root self.glp and resolved here unqualified.  Local copies
%% deleted in the 4-of-4 dedup; alias-aware inference binds the lib routers'
%% type parameters from graph's OutputsList/UserInStream/FriendStream aliases.
%% =============================================================================

%% =============================================================================
%% CLOSE_OUTPUTS
%% =============================================================================

procedure close_outputs(OutputsList?).
close_outputs([user_output([])|Outs]) :- close_outputs(Outs?).
close_outputs([net_output([])|Outs]) :- close_outputs(Outs?).
close_outputs([friend_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([]).

%% =============================================================================
%% BEFRIENDING (GSG paper, Sections 5.1 and 5.2, app:code) --- the awaits
%% await_consent and await_conveyance are lib/routing/intro.glp's, and
%% already_friend, convey and adopt lib/routing/befriend.glp's, exposed from
%% the root self.glp and resolved here unqualified.
%% =============================================================================

%% The cold call (app:code): the person's connect(Target) is the person's
%% consent, so the agent sends the target its consent and a fresh variable for
%% the target's, and awaits the target's consent on its own input stream.  The
%% agent with the smaller identity proposes: its consent carries the reader of
%% the conveyance variable it will write, and it awaits the other's consent;
%% the agent with the larger identity accepts, and awaits the proposer's
%% consent and then the conveyance.
procedure cold_call(Key?, Key?, UserInStream?, UserInStream, OutputsList?, OutputsList).
cold_call(Id, Target, UserIn, UserIn1?, Outs, Outs1?) :-
    Id? @< Target? |
    send_net(msg(Target?,
        befriend_accept(Id?, yes(Conveyance?), Theirs)),
        Outs?, Outs1),
    await_consent(Target?, Theirs?, Conveyance,
                  UserIn?, UserIn1).
cold_call(Id, Target, UserIn, UserIn1?, Outs, Outs1?) :-
    otherwise |
    send_net(msg(Target?,
        befriend_propose(Id?, yes, Theirs)),
        Outs?, Outs1),
    await_conveyance(Target?, Theirs?, UserIn?, UserIn1).

%% consented(Other, Conveyance), at the proposer: the other has consented.
%% Already a friend, the conveyance is already_friends; otherwise convey/7
%% mints the friend channel, and the befriending mints the reconnection
%% attestation of Section 5.5, the signature of attest(Id, Other) under the
%% person's key, into which the runtime puts this program's source identity,
%% so no mini-app can mint one, and sends a warm call under way to Other.
procedure consented_step(Decision?, Key?, Key?, Conveyance(FriendChannel), OutputsList?, OutputsList, NetInStream?, NetInStream, AttestList?, AttestList, PendingInv?, PendingInv).
consented_step(yes, _, Other, Conv?, Outs, Outs1?, NetIn, NetIn1?, Atts, Atts?, Pend, Pend?) :-
    convey(yes, Other?, Conv, Outs?, Outs1, NetIn?, NetIn1).
consented_step(no, Id, Other, Conv?, Outs, Outs2?, NetIn, NetIn1?, Atts, [att(Other?, S?) | Atts?], Pend, Pend1?) :-
    ground(Id?), ground(Other?) |
    convey(no, Other?, Conv, Outs?, Outs1, NetIn?, NetIn1),
    self_key(K),
    sign(attest(Id?, Other?), K?, S),
    warm_after_commit(Id?, Other?, Pend?, Pend1, Outs1?, Outs2).

%% =============================================================================
%% AGENT/4
%% =============================================================================

exported procedure agent(Key?, UserInStream?, NetInStream?, OutputsList?).

%% The social graph as the super-app (SGSG paper, Section 3): agent/4 enters
%% agent/5 with the host state --- no mini-app, no attestation, no pending
%% invitation, and the person's own key as the one trusted compiler key, the
%% compiler bundled with the super-app being trusted by installing it.
agent(Id, UserIn, NetIn, Outs) :-
    self_key(K),
    agent(Id?, UserIn?, NetIn?, Outs?, host([], [], [], [K?])).

procedure agent(Key?, UserInStream?, NetInStream?, OutputsList?, Host?).

%% --- User messages ---

%% The person's request to connect: the cold call (app:code).
agent(Id, [msg(person, Id1, connect(Target))|UserIn],
      NetIn, Outs, Host) :-
    Id? =?= Id1?, ground(Target?) |
    cold_call(Id?, Target?, UserIn?, UserIn1, Outs?, Outs1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Host?).

%% The person's answer to a befriending, the pending value passed back as it
%% came, by this agent's role.  On consent, the proposer binds its consent to
%% yes(Conveyance?) and awaits the other's; the acceptor binds its consent to
%% yes and awaits the proposer's.  Declining is not an act but the absence of
%% the will to befriend (Section 5.2): the agent binds its consent to no all
%% the same, so that nobody waits on an answer that will not come.
agent(Id, [msg(person, Id1, decision(yes, From, propose(yes(C?), Theirs)))|UserIn],
      NetIn, Outs, Host) :-
    Id? =?= Id1? |
    await_consent(From?, Theirs?, C, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?, Host?).
agent(Id, [msg(person, Id1, decision(yes, From, accept(yes, Theirs)))|UserIn],
      NetIn, Outs, Host) :-
    Id? =?= Id1? |
    await_conveyance(From?, Theirs?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?, Host?).
agent(Id, [msg(person, Id1, decision(no, _, propose(no, _)))|UserIn],
      NetIn, Outs, Host) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, rejected), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).
agent(Id, [msg(person, Id1, decision(no, _, accept(no, _)))|UserIn],
      NetIn, Outs, Host) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, rejected), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).

%% The person sends a message (Section 5.1): a message the person addresses to
%% someone who is not their friend is not sent, and the agent tells the person
%% so.  Whether Target has a friend output entry is a procedure over the
%% outputs list, which no guard admits, so it is a body goal and send_step/6
%% dispatches on its answer, as introduce_step/9 does (app:code).
agent(Id, [msg(person, Id1, send(Target, Text))|UserIn], NetIn, Outs, Host) :-
    Id? =?= Id1?, ground(Target?) |
    anchor_friend(Target?, Outs?, Outs1, F),
    send_step(F?, Id?, Target?, Text?, Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Host?).

%% User unfriends Target — notify the peer on the friend channel, tear down,
%% and tell the person the friend is gone.
%% Guarded by either party (SGSG Section 3, "The Grassroots Social Graph as a
%% Grassroots Social Contract": befriending is guarded by both parties and
%% unfriending by either), so one-way: no ack, no decline.
%% Idempotent: if Target is not a friend, send_friend and close_friend are no-ops.
agent(Id, [msg(person, Id1, unfriend(Target))|UserIn], NetIn, Outs, Host) :-
    Id? =?= Id1?, ground(Target?) |
    send_friend(Target?, msg(Id?, Target?, unfriend), Outs?, Outs1),
    close_friend(Target?, Outs1?, Outs2),
    send_user(msg(agent, person, unfriended(Target?)), Outs2?, Outs3),
    agent(Id?, UserIn?, NetIn?, Outs3?, Host?).

%% The introduction via a mutual friend (app:code): the mutual friend
%% introduces only where each party has a friend output entry, having a friend
%% channel to each (Section 5.2); that test is a procedure over the outputs
%% list, which no guard admits, so it is two body goals and introduce_step/9
%% dispatches on their answers, minting the two consent variables and sending
%% each party an introduction to the other by its role, the smaller identity
%% proposing.
agent(Id, [msg(person, Id1, introduce(P, Q))|UserIn],
      NetIn, Outs, Host) :-
    Id? =?= Id1?, ground(P?), ground(Q?), P? =?\= Q? |
    anchor_friend(P?, Outs?, Outs1, FP),
    anchor_friend(Q?, Outs1?, Outs2, FQ),
    introduce_step(FP?, FQ?, Id?, P?, Q?, UserIn?, NetIn?,
                   Outs2?, Host?).

%% The person accepts an introduction, by this agent's role, as it answers a
%% cold call.  The consent is kept: the consent variables are the
%% introducer's, so the links of the befriending reach this agent through the
%% introducer and are held at both ends until each end's own person's volition
%% is found (IGLP, madglp-spec, Held Links), and this is that volition.
agent(Id, [msg(person, Id1, accept_intro(Other, propose(yes(C?), Theirs)))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(Other?) |
    await_consent(Other?, Theirs?, C, UserIn?, UserIn1),
    take_intro_via(Other?, Pend?, Pend1, Via),
    release_by_sender(Via?, Pend1?, Pend2, Via1),
    accepted_intro(Via1?, Other?, Pend2?, Pend3),
    agent(Id?, UserIn1?, NetIn?, Outs?,
          host(Apps?, Atts?, Pend3?, Trusted?)).
agent(Id, [msg(person, Id1, accept_intro(Other, accept(yes, Theirs)))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(Other?) |
    await_conveyance(Other?, Theirs?, UserIn?, UserIn1),
    take_intro_via(Other?, Pend?, Pend1, Via),
    release_by_sender(Via?, Pend1?, Pend2, Via1),
    accepted_intro(Via1?, Other?, Pend2?, Pend3),
    agent(Id?, UserIn1?, NetIn?, Outs?,
          host(Apps?, Atts?, Pend3?, Trusted?)).

%% The person declines an introduction: the consent bound to no, by role, and
%% the person told, as for a cold call.
agent(Id, [msg(person, Id1, reject_intro(_, propose(no, _)))|UserIn], NetIn, Outs, Host) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, rejected), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).
agent(Id, [msg(person, Id1, reject_intro(_, accept(no, _)))|UserIn], NetIn, Outs, Host) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, rejected), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).

%% The other consented (injected by await_consent), at the proposer: test
%% already_friend and convey (consented_step/12), the pending list passed
%% through: it holds the ends of root channels kept for a handshake, so it is
%% not ground, and is read once.
agent(Id, [consented(Other, Conv?)|UserIn], NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    ground(Id?), ground(Other?) |
    already_friend(Other?, Outs?, Outs1, D),
    consented_step(D?, Id?, Other?, Conv, Outs1?, Outs2, NetIn?, NetIn1, Atts?, Atts1, Pend?, Pend1),
    agent(Id?, UserIn?, NetIn1?, Outs2?, host(Apps?, Atts1?, Pend1?, Trusted?)).

%% The friend channel conveyed (injected by await_conveyance), at the
%% acceptor: install it, mint the attestation and send a warm call under way,
%% as the proposer does.
agent(Id, [adopt(Other, Ch)|UserIn], NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    ground(Id?), ground(Other?) |
    adopt(Other?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    self_key(K),
    sign(attest(Id?, Other?), K?, S),
    warm_after_commit(Id?, Other?, Pend?, Pend1, Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, host(Apps?, [att(Other?, S?) | Atts?], Pend1?, Trusted?)).

%% The other declined (injected by either await): tell the person.
agent(Id, [declined(Other)|UserIn], NetIn, Outs, Host) :-
    ground(Id?) |
    send_user(msg(agent, person, rejected(Other?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).

%% --- The super-app (SGSG paper, Section 3): install, invite, consent,
%% reconnect ---

%% Install a certified mini-app.  The compiler's certificate is accepted when
%% its key is one the person trusts (Section 6.4), and the creator's
%% certification must be signed over this source identity with the checker's
%% verdict that the contract is grassroots.  signature/2 assigns unsigned on a
%% forged certification, and the super-app refuses to install it (Section 6.1).
%% Every mini-app is installed alike: its grants are its end of its person
%% channel, at Opaque, and its calendar (Section 3, "What the super-app grants
%% a mini-app"), held until its activation.
agent(Id, [msg(person, Id1, install(App, M, CSig, Ui, Cal))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(App?), ground(Trusted?) |
    verify_install(M?, CSig?, Trusted?, V),
    install_step(V?, App?, CSig?, Ui?, Cal?, Apps?, Apps1),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps1?, Atts?, Pend?, Trusted?)).

%% Invite a friend to the instance of a mini-app (Section 3, "Distribution
%% with an invitation"): over the friend channel, two things and nothing else,
%% the mini-app's source identity and one end of a fresh root channel, at
%% Opaque, with the social graph's invitation signed over the source identity
%% and the friend.  The other end is kept until the handshake succeeds.
agent(Id, [msg(person, Id1, invite(App, Friend))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(App?), ground(Friend?) |
    app_module(App?, Apps?, Apps1, L),
    invite_step(L?, Id?, App?, Friend?, UserIn?, NetIn?, Outs?,
                host(Apps1?, Atts?, Pend?, Trusted?)).

%% The person's consent to an offer of the mini-app installed here as App: the
%% volitional guard of joining.  Where the offer of its source identity has
%% arrived, join; where it has not, the consent waits for it.
agent(Id, [msg(person, Id1, accept_invite(App, From))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(App?), ground(From?) |
    app_module(App?, Apps?, Apps1, L),
    consent_lookup(L?, Id?, App?, From?, UserIn?, NetIn?, Outs?,
                   host(Apps1?, Atts?, Pend?, Trusted?)).

%% The person declines an offer that has arrived; a decline before the offer
%% is nothing.
agent(Id, [msg(person, Id1, decline_invite(App, From))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(App?), ground(From?) |
    app_module(App?, Apps?, Apps1, L),
    decline_lookup(L?, Id?, From?, UserIn?, NetIn?, Outs?,
                   host(Apps1?, Atts?, Pend?, Trusted?)).

%% Reconnection (Section 5.5) is not here: the social graph would call the
%% layer's peer_address/2 and punch_udp/1 under the attestation minted at
%% commit, but the seam takes no attestation --- presenting it at the
%% rendezvous server is the layer's --- and a program that calls the seam is
%% refused a certificate, which this program must hold to serve, in the plays,
%% as its own certified mini-app.

%% The person trusts a compiler's key: a certificate under it is accepted.
agent(Id, [msg(person, Id1, trust(K))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(K?) |
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, Pend?, [K? | Trusted?])).

%% The names of the installed mini-apps, for a play to read back.
agent(Id, [msg(person, Id1, installed(Names?))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1? |
    app_names(Apps?, Apps1, Names),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps1?, Atts?, Pend?, Trusted?)).

%% The attestation held for a friend, for a play to read back.
agent(Id, [msg(person, Id1, attestation(Friend, S?))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(Friend?) |
    lookup_att(Friend?, Atts?, Atts1, S),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts1?, Pend?, Trusted?)).

%% --- The warm call (Section 5.2, "Encounters among participants of the same
%% mini-app") ---

%% A mini-app asks for a warm call: an end reached it under an anchor other
%% than the friend that passed it; the name carries the anchor.  With the
%% person's consent to a warm call with that anchor the social graph asks the
%% forwarding friend for an introduction to it; without it the request waits.
agent(Id, [app_request(App, warm_call(Name, Via))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    ground(Id?), ground(App?), ground(Via?), ground(Name?) |
    Parts ..= Name?,
    take_warm_consent_for(Parts?, Pend?, Pend1, C),
    warm_step(C?, Id?, App?, Name?, Via?, UserIn?, NetIn?, Outs?,
              host(Apps?, Atts?, Pend1?, Trusted?)).

%% A mini-app's execution has ended.  Its entry in the registry returns from
%% running to idle, so that the next invitation activates the mini-app afresh
%% by run/3 instead of handing the new conversation's root channel to an
%% execution that is gone (SGSG paper, Section 3, "Activation and joining":
%% the registry records whether the mini-app is running, and an invitation is
%% looked up in it).
agent(Id, [app_ended(App)|UserIn], NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    ground(Id?), ground(App?) |
    app_idle(App?, Apps?, Apps1),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps1?, Atts?, Pend?, Trusted?)).

%% The person consents to a warm call with Who: as holder, the request waiting
%% for it proceeds; as anchor, the call from Who is accepted when it comes.
agent(Id, [msg(person, Id1, accept_warm_call(Who))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(Who?) |
    take_warm_wait(Who?, Pend?, Pend1, Wait),
    warm_consent_step(Wait?, Id?, Who?, UserIn?, NetIn?, Outs?,
                      host(Apps?, Atts?, Pend1?, Trusted?)).

%% The person consents to introduce Requester to Anchor: a request waiting for
%% it proceeds; otherwise the consent waits for the request.
agent(Id, [msg(person, Id1, allow_intro(Requester, Anchor))|UserIn], NetIn, Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(Requester?), ground(Anchor?) |
    take_intro_wait(Requester?, Anchor?, Pend?, Pend1, W),
    intro_consent_step(W?, Id?, Requester?, Anchor?, UserIn?, NetIn?, Outs?,
                       host(Apps?, Atts?, Pend1?, Trusted?)).

%% User catch-all
agent(Id, [_|UserIn], NetIn, Outs, Host) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).

%% --- Network messages ---

%% A cold call from the network: the call is presented to the person with the
%% pending value by this agent's role, which is the opposite of the message's
%% name --- befriend_propose asks this agent to propose, befriend_accept to
%% accept.
agent(Id, UserIn, [msg(Id1, befriend_propose(From, yes, Mine?))|NetIn], Outs, Host) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, befriend(From?, propose(Mine, yes))), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).
agent(Id, UserIn, [msg(Id1, befriend_accept(From, yes(C), Mine?))|NetIn], Outs, Host) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, befriend(From?, accept(Mine, yes(C?)))), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).

%% Text from friend
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs, Host) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).

%% Unfriended by From — comply (SGSG Section 3, "The Grassroots Social Graph as
%% a Grassroots Social Contract": unfriending is guarded by either): tear down my
%% side and notify the user.  close_friend is a no-op if From is already gone,
%% so a simultaneous unfriend from both sides cannot error or double-tear.
agent(Id, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs, Host) :-
    Id? =?= Id1?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    send_user(msg(agent, person, unfriended(From?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Host?).

%% Introduction from a friend --- the two consents go to the person by this
%% agent's role, and who introduced whom is remembered: the consent variables
%% are the introducer's, so the links they bring are anchored at the
%% introducer, and it is the introducer that the person's consent must be
%% matched against when they are released.
agent(Id, UserIn, [msg(From, Id1, introduce_propose(Other, Mine?, Theirs))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(Other?), ground(From?) |
    send_user(msg(agent, person, befriend_intro(From?, Other?, propose(Mine, Theirs?))), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?,
          host(Apps?, Atts?, [intro_via(Other?, From?) | Pend?], Trusted?)).
agent(Id, UserIn, [msg(From, Id1, introduce_accept(Other, Mine?, Theirs))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(Other?), ground(From?) |
    send_user(msg(agent, person, befriend_intro(From?, Other?, accept(Mine, Theirs?))), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?,
          host(Apps?, Atts?, [intro_via(Other?, From?) | Pend?], Trusted?)).

%% --- The invitation and the handshake over the friend channel (Section 3,
%% "Distribution with an invitation" and "Activation and joining"; Section 6,
%% Mechanisms) ---

%% An offer from a friend: the mini-app's source identity and one end of the
%% root channel, the invitation the social graph's signature over the offered
%% source identity and this agent.  Where the person has consented already,
%% join; otherwise the offer waits for the person.  A term that is not a
%% signed term is refused (Section 6.1; invite_signed/9), and its end closed.
agent(Id, UserIn, [msg(From, Id1, invite(Src, InvSig, End))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(From?), ground(Src?) |
    signature(InvSig?, Sg),
    invite_signed(Sg?, Id?, From?, Src?, InvSig?, End?, UserIn?, NetIn?, Outs?,
                  host(Apps?, Atts?, Pend?, Trusted?)).

%% The handshake, at the inviter: the invitee joins with its undertaking,
%% which must be signed over the source identity, and the type identity of the
%% entry template's opaque instance at the mini-app's type, as its super-app
%% computes it; the mini-app this agent invited it to must have that source
%% identity and that type identity.  Then this side's undertaking and type
%% identity go to the invitee, and the end kept at the invitation goes to this
%% side's execution of the mini-app.
agent(Id, UserIn, [msg(From, Id1, join(Src, T, U))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(From?), ground(Src?) |
    signature(U?, Sg),
    join_signed(Sg?, Id?, From?, Src?, T?, UserIn?, NetIn?, Outs?,
                Apps?, Atts?, Pend?, Trusted?).

%% The invitee declined, or could not join: the end kept at the invitation is
%% closed.
agent(Id, UserIn, [msg(From, Id1, decline(Src))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(From?), ground(Src?) |
    take_invited(From?, Src?, Pend?, Pend1, I),
    close_kept(I?),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, Pend1?, Trusted?)).

%% The handshake, at the invitee: the inviter's undertaking and type identity
%% arrive; verify them against the mini-app this agent joined; on success hand
%% the end the invitation carried to this side's execution, on mismatch
%% deliver nothing --- to the mini-app an aborted conversation is silent.
agent(Id, UserIn, [msg(From, Id1, root(Src, T, Up))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(From?), ground(Src?) |
    signature(Up?, Sg),
    root_signed(Sg?, Id?, From?, Src?, T?, UserIn?, NetIn?, Outs?,
                Apps?, Atts?, Pend?, Trusted?).

%% The runtime reports a held link: an end that reached this agent under an
%% anchor other than the sender, or, at the anchor, a value that came from the
%% holder of a warm call already accepted.  The latter is released; the
%% former is reported to every running mini-app, which knows its
%% conversations.
agent(Id, UserIn, [pending_link(Name, S)|NetIn], Outs, host(Apps, Atts, Pend, Trusted)) :-
    ground(Id?), ground(S?), ground(Name?) |
    Parts ..= Name?,
    may_release(Parts?, S?, Pend?, Pend1, Found),
    pending_step(Found?, Name?, S?, Id?, UserIn?, NetIn?, Outs?, Apps?, Atts?, Pend1?, Trusted?).

%% A friend asks to be introduced to the anchor of a held name (the holder
%% of a warm call): the requester and the anchor are both looked up among this
%% agent's own friends --- the mutual friend has a friend channel to each
%% (Section 5.2) --- and with the person's consent the two are introduced;
%% otherwise the request waits for it.
agent(Id, UserIn, [msg(From, Id1, request_intro(Anchor))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(From?), ground(Anchor?) |
    anchor_friend(From?, Outs?, Outs1, Requester),
    anchor_friend(Anchor?, Outs1?, Outs2, Found),
    intro_request(Requester?, Found?, Id?, From?, Anchor?, UserIn?, NetIn?, Outs2?,
                  host(Apps?, Atts?, Pend?, Trusted?)).

%% The warm call itself, from a new friend: the person must have consented to
%% a warm call with the caller, which is what identifies the call --- the held
%% link's name stays at the holder and never crosses.  Then the exchange
%% proceeds as an invitation of the caller to the mini-app, and the held value,
%% once the caller releases it, is accepted at this end in its turn.
agent(Id, UserIn, [msg(From, Id1, warm_call(App))|NetIn], Outs,
      host(Apps, Atts, Pend, Trusted)) :-
    Id? =?= Id1?, ground(From?), ground(App?) |
    take_warm_consent(From?, Pend?, Pend1, C),
    warm_call_step(C?, Id?, From?, App?, UserIn?, NetIn?, Outs?,
                   host(Apps?, Atts?, Pend1?, Trusted?)).

%% Network catch-all
agent(Id, UserIn, [_|NetIn], Outs, Host) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).

%% --- Termination ---

agent(_, [], _, Outs, Host) :- close_outputs(Outs?), close_host(Host?).
agent(_, _, [], Outs, Host) :- close_outputs(Outs?), close_host(Host?).

%% =============================================================================
%% THE SUPER-APP'S HOST: installation, invitation, handshake, activation
%% =============================================================================

%% --- Installation and the certifications (Sections 3 and 6.4) ---

%% verify_install(M, CSig, Trusted, V): what load_file/2 gave must be a Module
%% (a forged artefact is its text), the compiler's key must be trusted, and the
%% creator's certification signed over the module's source identity with the
%% verdict grassroots.
procedure verify_install(Content?, String?, Stream(String)?, Verdict).
verify_install(M, CSig, Trusted, V?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    key_trusted(CK?, Trusted?, T),
    creator_check(T?, CSig?, Src?, M?, V).
verify_install(_, _, _, refused) :- otherwise | true.

procedure key_trusted(String?, Stream(String)?, Constant).
key_trusted(K, [K1 | _], true) :- K? =?= K1? | true.
key_trusted(K, [_ | Ks], T?) :- otherwise | key_trusted(K?, Ks?, T).
key_trusted(_, [], false).

procedure creator_check(Constant?, String?, String?, Module?, Verdict).
creator_check(true, CSig, Src, M, V?) :-
    signature(CSig?, Sg),
    cert_signed(Sg?, Src?, M?, V).
creator_check(false, _, _, _, refused).

%% cert_signed(Sg, Src, V): the certification taken apart.  Where it verifies
%% it is read by its shape; where it is unsigned --- a forgery --- the
%% installation is refused, as under a key the person does not trust.
procedure cert_signed(Signature?, String?, Module?, Verdict).
cert_signed(signed(_, _, Cert), Src, M, V?) :- cert_check(Cert?, Src?, M?, V).
cert_signed(unsigned, _, _, refused).

%% The signed term is untyped; the certification is read by its shape.
procedure cert_check(_?, String?, Module?, Verdict).
cert_check(creator_cert(Src1, _, grassroots), Src, M, ok(M?)) :- Src? =?= Src1? | true.
cert_check(_, _, _, refused) :- otherwise | true.

%% install_step(V, App, CSig, Ui, Cal, Apps, Apps1): a mini-app installed is
%% held idle with its two grants; one refused has its person channel read for
%% good, the channel never ending (idle_channel/1).
procedure install_step(Verdict?, Constant?, String?, PersonChannel(Opaque)?, Stream(Integer)?, AppList?, AppList).
install_step(ok(M), App, CSig, Ui, Cal, Apps, [app(App?, M?, CSig?, idle(Ui?, Cal?)) | Apps?]).
install_step(refused, _, _, Ui, _, Apps, Apps?) :- idle_channel(Ui?).

%% app_idle(App, Apps, Apps1): the mini-app's entry returns from running to
%% idle.  The end of the person channel the entry held at installation went
%% to the execution that has now ended, so the entry takes a fresh one, as it
%% did at installation, and the calendar kept for its next activation; the
%% next activation posts the two with the entry goal.  An entry that is not
%% running is left as it is, so a report that arrives twice, or for a mini-app
%% never activated, changes nothing.
procedure app_idle(Constant?, AppList?, AppList).
app_idle(App, [app(A, M, C, running([], Cal)) | Rest], [app(A?, M?, C?, idle(Ui?, Cal?)) | Rest?]) :-
    App? =?= A? |
    new_channel(Ui, Person),
    hold_person(Person?).
app_idle(App, [E | Rest], [E? | Rest1?]) :-
    otherwise | app_idle(App?, Rest?, Rest1).
app_idle(_, [], []).


%% app_module(App, Apps, Apps1, L): the installed mini-app's module value, the
%% list passed through.
procedure app_module(Constant?, AppList?, AppList, AppLookup).
app_module(App, [app(A, M, C, St) | Rest], [app(A?, M?, C?, St?) | Rest?], found(M?)) :-
    App? =?= A? | true.
app_module(App, [E | Rest], [E? | Rest1?], L?) :-
    otherwise | app_module(App?, Rest?, Rest1, L).
app_module(_, [], [], missing).

%% identities(M, Src, T): the mini-app's source identity, from its
%% certificate, and the root channel's type identity: that of the entry
%% template's opaque instance at the type at which the mini-app's exports
%% record its entry miniapp/4 as the template's instance (GSG paper, Sections
%% 4 and 6; TGLP modules.tex, Definition "Type Identity of a Type, Opaque
%% Instance").  The super-app holds no declaration of the mini-app's types:
%% the template miniapp/4 is the root's, and opaque_type/3 reads the type's
%% identity off the module value.
procedure identities(Module?, String, Constant).
identities(M, Src?, T?) :-
    decompose_module(M?, _, Src, _),
    opaque_type(miniapp/4, M?, H),
    find_type(miniapp/4, H?, T).

%% --- The inviter ---

%% invite_step(L, Id, App, Friend, ...): the invitation, where the mini-app is
%% installed: its source identity and one end of a fresh root channel, signed;
%% the other end kept, with the friend and the source identity, until the
%% handshake.
procedure invite_step(AppLookup?, Key?, Constant?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
invite_step(found(M), Id, App, Friend, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    decompose_module(M?, _, Src, _),
    new_channel(Mine, Theirs),
    self_key(K),
    sign(invitation(Src?, Friend?), K?, InvSig),
    send_friend(Friend?, msg(Id?, Friend?, invite(Src?, InvSig?, Theirs?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?,
          host(Apps?, Atts?, [invited(App?, Friend?, Src?, Mine?) | Pend?], Trusted?)).
invite_step(missing, Id, _, _, UserIn, NetIn, Outs, Host) :-
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).

%% take_invited(From, Src, Pend, Pend1, I): the invitation of From to the
%% mini-app of source identity Src, removed: the mini-app's name here and the
%% end kept, or none.
procedure take_invited(Key?, String?, PendingInv?, PendingInv, Kept).
take_invited(From, Src, [invited(A, F, S, Mine) | Rest], Rest?, kept(A?, Mine?)) :-
    From? =?= F?, Src? =?= S? | true.
take_invited(From, Src, [P | Rest], [P? | Rest1?], I?) :-
    otherwise | take_invited(From?, Src?, Rest?, Rest1, I).
take_invited(_, _, [], [], none).

%% close_kept(I): an end kept that no execution will take, closed: what this
%% side would have written on it, nothing.
procedure close_kept(Kept?).
close_kept(kept(_, ch(_, []))).
close_kept(none).

%% --- The invitee ---

%% consent_lookup(L, Id, App, From, ...): the person's consent, for the
%% mini-app installed here as App, by its source identity: where the offer of
%% it from From has arrived, join; where it has not, the consent waits for it.
%% A mini-app not installed here is nothing to consent to.
procedure consent_lookup(AppLookup?, Key?, Constant?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
consent_lookup(found(M), Id, App, From, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    decompose_module(M?, _, Src, _),
    take_offer(Src?, From?, Pend?, Pend1, Offer),
    consent_step(Offer?, Id?, App?, From?, Src?, UserIn?, NetIn?, Outs?,
                 host(Apps?, Atts?, Pend1?, Trusted?)).
consent_lookup(missing, Id, _, _, UserIn, NetIn, Outs, Host) :-
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).

%% decline_lookup(L, Id, From, ...): the person declines the offer from From
%% of the mini-app installed here, by its source identity.
procedure decline_lookup(AppLookup?, Key?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
decline_lookup(found(M), Id, From, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    decompose_module(M?, _, Src, _),
    take_offer(Src?, From?, Pend?, Pend1, Offer),
    decline_step(Offer?, Id?, From?, Src?, UserIn?, NetIn?, Outs?,
                 host(Apps?, Atts?, Pend1?, Trusted?)).
decline_lookup(missing, Id, _, UserIn, NetIn, Outs, Host) :-
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).

%% take_offer(Src, From, Pend, Pend1, Offer): the offer from From of the
%% mini-app of source identity Src, removed, with the end it carried; none
%% where there is none.
procedure take_offer(String?, Key?, PendingInv?, PendingInv, Offer).
take_offer(Src, From, [offered(F, S, _, End) | Rest], Rest?, offer(End?)) :-
    Src? =?= S?, From? =?= F? | true.
take_offer(Src, From, [P | Rest], [P? | Rest1?], O?) :-
    otherwise | take_offer(Src?, From?, Rest?, Rest1, O).
take_offer(_, _, [], [], none).

%% take_consent(Src, From, Pend, Pend1, C): the person's consent given
%% already to an offer from From of the mini-app of source identity Src,
%% removed: the name it is installed under here, or none.
procedure take_consent(String?, Key?, PendingInv?, PendingInv, Consent).
take_consent(Src, From, [consented(S, F, A) | Rest], Rest?, app(A?)) :-
    Src? =?= S?, From? =?= F? | true.
take_consent(Src, From, [P | Rest], [P? | Rest1?], C?) :-
    otherwise | take_consent(Src?, From?, Rest?, Rest1, C).
take_consent(_, _, [], [], none).

procedure consent_step(Offer?, Key?, Constant?, Key?, String?, UserInStream?, NetInStream?, OutputsList?, Host?).
consent_step(none, Id, App, From, Src, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, [consented(Src?, From?, App?) | Pend?], Trusted?)).
consent_step(offer(End), Id, App, From, Src, UserIn, NetIn, Outs, Host) :-
    do_join(Id?, App?, From?, Src?, End?, UserIn?, NetIn?, Outs?, Host?).

procedure decline_step(Offer?, Key?, Key?, String?, UserInStream?, NetInStream?, OutputsList?, Host?).
decline_step(none, Id, _, _, UserIn, NetIn, Outs, Host) :-
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).
decline_step(offer(ch(_, [])), Id, From, Src, UserIn, NetIn, Outs, Host) :-
    send_friend(From?, msg(Id?, From?, decline(Src?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).

%% invite_signed(Sg, ...): the invitation taken apart.  Where it verifies it
%% is checked and the offer proceeds; where it is unsigned --- a forgery ---
%% the offer is refused by the path an invitation that does not check takes,
%% its end closed, and nothing is delivered (Section 6.1).
procedure invite_signed(Signature?, Key?, Key?, String?, String?, RootChannel(Opaque)?, UserInStream?, NetInStream?, OutputsList?, Host?).
invite_signed(signed(_, _, Inv), Id, From, Src, InvSig, End, UserIn, NetIn, Outs, Host) :-
    invite_check(Inv?, Src?, Id?, Ok),
    offer_step(Ok?, Id?, From?, Src?, InvSig?, End?, UserIn?, NetIn?, Outs?, Host?).
invite_signed(unsigned, Id, From, Src, InvSig, End, UserIn, NetIn, Outs, Host) :-
    offer_step(false, Id?, From?, Src?, InvSig?, End?, UserIn?, NetIn?, Outs?, Host?).

%% The signed invitation is untyped; it must name the offered source identity
%% and this agent.
procedure invite_check(_?, String?, Constant?, Constant).
invite_check(invitation(Src1, Me), Src, Id, true) :- Src? =?= Src1?, Me? =?= Id? | true.
invite_check(_, _, _, false) :- otherwise | true.

procedure offer_step(Constant?, Key?, Key?, String?, String?, RootChannel(Opaque)?, UserInStream?, NetInStream?, OutputsList?, Host?).
offer_step(true, Id, From, Src, InvSig, End, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    take_consent(Src?, From?, Pend?, Pend1, C),
    offer_consent(C?, Id?, From?, Src?, InvSig?, End?, UserIn?, NetIn?, Outs?,
                  host(Apps?, Atts?, Pend1?, Trusted?)).
offer_step(false, Id, _, _, _, ch(_, []), UserIn, NetIn, Outs, Host) :-
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).

procedure offer_consent(Consent?, Key?, Key?, String?, String?, RootChannel(Opaque)?, UserInStream?, NetInStream?, OutputsList?, Host?).
offer_consent(app(App), Id, From, Src, _, End, UserIn, NetIn, Outs, Host) :-
    do_join(Id?, App?, From?, Src?, End?, UserIn?, NetIn?, Outs?, Host?).
offer_consent(none, Id, From, Src, InvSig, End, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    agent(Id?, UserIn?, NetIn?, Outs?,
          host(Apps?, Atts?, [offered(From?, Src?, InvSig?, End?) | Pend?], Trusted?)).

%% do_join: the person having consented, where the mini-app is installed here
%% with the offered source identity, sign the undertaking to keep its contract
%% and run its certified code, and send it with the type identity of the entry
%% template's opaque instance at the mini-app's type, the end the invitation
%% carried kept until the inviter answers; otherwise decline, the end closed.
%% (Shipping the certified program to an invitee that lacks it is not
%% implemented: such an invitee declines.)
procedure do_join(Key?, Constant?, Key?, String?, RootChannel(Opaque)?, UserInStream?, NetInStream?, OutputsList?, Host?).
do_join(Id, App, From, Src, End, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    app_module(App?, Apps?, Apps1, L),
    join_verify(L?, Src?, Ok),
    join_step(Ok?, Id?, App?, From?, Src?, End?, UserIn?, NetIn?, Outs?,
              host(Apps1?, Atts?, Pend?, Trusted?)).

procedure join_step(Joined?, Key?, Constant?, Key?, String?, RootChannel(Opaque)?, UserInStream?, NetInStream?, OutputsList?, Host?).
join_step(ok(T), Id, App, From, Src, End, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    self_key(K),
    sign(undertaking(Src?), K?, U),
    send_friend(From?, msg(Id?, From?, join(Src?, T?, U?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?,
          host(Apps?, Atts?, [joining(App?, From?, Src?, End?) | Pend?], Trusted?)).
join_step(refused, Id, _, From, Src, ch(_, []), UserIn, NetIn, Outs, Host) :-
    send_friend(From?, msg(Id?, From?, decline(Src?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Host?).

%% join_verify(L, Src, Ok): the mini-app installed here, of source identity
%% Src: the type identity of the entry template's opaque instance at its type.
procedure join_verify(AppLookup?, String?, Joined).
join_verify(found(M), Src, Ok?) :-
    identities(M?, Src1, T1),
    source_match(Src?, Src1?, T1?, Ok).
join_verify(missing, _, refused).

procedure source_match(String?, String?, Constant?, Joined).
source_match(Src, Src1, T, ok(T?)) :- Src? =?= Src1? | true.
source_match(_, _, _, refused) :- otherwise | true.

%% take_joining(From, Src, Pend, Pend1, I): the join of this agent to From's
%% mini-app of source identity Src, removed: its name here and the end the
%% invitation carried, or none.
procedure take_joining(Key?, String?, PendingInv?, PendingInv, Kept).
take_joining(From, Src, [joining(A, F, S, End) | Rest], Rest?, kept(A?, End?)) :-
    From? =?= F?, Src? =?= S? | true.
take_joining(From, Src, [P | Rest], [P? | Rest1?], I?) :-
    otherwise | take_joining(From?, Src?, Rest?, Rest1, I).
take_joining(_, _, [], [], none).

%% --- The handshake's checks (Section 6, Mechanisms: "the two super-apps
%% exchange and compare the mini-app's source identity and the root channel's
%% type identity, the type identity of the entry template's opaque instance at
%% the mini-app's type, which must be equal at both ends") ---

%% The signed undertaking is untyped; it must name the source identity.
procedure undertaking_check(_?, String?, Constant).
undertaking_check(undertaking(Src1), Src, true) :- Src? =?= Src1? | true.
undertaking_check(_, _, false) :- otherwise | true.

%% handshake(Ok0, I, Apps, Apps1, Src, T, Ok, I1): the peer's undertaking
%% checked, an end kept for the conversation, the mini-app it was kept for
%% installed here, and its two identities equal to the peer's; the kept end
%% handed on as I1, a reader of a type that is not constant being read once.
procedure handshake(Constant?, Kept?, AppList?, AppList, String?, Constant?, Verdict, Kept).
handshake(true, kept(App, End), Apps, Apps1?, Src, T, Ok?, kept(App?, End?)) :-
    ground(App?) |
    app_module(App?, Apps?, Apps1, L),
    identity_check(L?, Src?, T?, Ok).
handshake(_, I, Apps, Apps?, _, _, refused, I?) :- otherwise | true.

procedure identity_check(AppLookup?, String?, Constant?, Verdict).
identity_check(found(M), Src, T, Ok?) :-
    identities(M?, Src1, T1),
    identity_match(Src?, Src1?, T?, T1?, M?, Ok).
identity_check(missing, _, _, refused).

procedure identity_match(String?, String?, Constant?, Constant?, Module?, Verdict).
identity_match(Src, Src1, T, T1, M, ok(M?)) :- Src? =?= Src1?, T? =?= T1? | true.
identity_match(_, _, _, _, _, refused) :- otherwise | true.

%% --- The inviter, on the invitee's undertaking ---

%% join_signed(Sg, ...): the invitee's undertaking taken apart.  Where it
%% verifies it is checked, with the invitee's type identity, against the
%% mini-app installed here, and the conversation opens; where it is unsigned
%% --- a forgery --- the join is refused, the end kept closed, and no
%% conversation opens (Section 6.1).
procedure join_signed(Signature?, Key?, Key?, String?, Constant?, UserInStream?, NetInStream?, OutputsList?, AppList?, AttestList?, PendingInv?, Stream(String)?).
join_signed(signed(_, _, Und), Id, From, Src, T, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    undertaking_check(Und?, Src?, Ok0),
    take_invited(From?, Src?, Pend?, Pend1, I),
    handshake(Ok0?, I?, Apps?, Apps1, Src?, T?, Ok, I1),
    root_step(Ok?, I1?, Id?, From?, Src?, T?, UserIn?, NetIn?, Outs?,
              Apps1?, Atts?, Pend1?, Trusted?).
join_signed(unsigned, Id, From, Src, T, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    take_invited(From?, Src?, Pend?, Pend1, I),
    root_step(refused, I?, Id?, From?, Src?, T?, UserIn?, NetIn?, Outs?,
              Apps?, Atts?, Pend1?, Trusted?).

procedure root_step(Verdict?, Kept?, Key?, Key?, String?, Constant?, UserInStream?, NetInStream?, OutputsList?, AppList?, AttestList?, PendingInv?, Stream(String)?).
root_step(ok(M), kept(App, Mine), Id, From, Src, T, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    self_key(K),
    sign(undertaking(Src?), K?, Up),
    send_friend(From?, msg(Id?, From?, root(Src?, T?, Up?)), Outs?, Outs1),
    deliver(App?, From?, Mine?, Id?, M?, Apps?, Apps1, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, host(Apps1?, Atts?, Pend?, Trusted?)).
%% A handshake that failed closes the end kept for it.
root_step(_, I, Id, _, _, _, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    otherwise |
    close_kept(I?),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, Pend?, Trusted?)).

%% --- The invitee, on the inviter's undertaking ---

%% root_signed(Sg, ...): the inviter's undertaking taken apart.  Where it
%% verifies it is checked, with the inviter's type identity, against the
%% mini-app installed here and the end the invitation carried is accepted;
%% where it is unsigned --- a forgery --- no end is accepted, the end is
%% closed, and nothing is delivered (Section 6.1).
procedure root_signed(Signature?, Key?, Key?, String?, Constant?, UserInStream?, NetInStream?, OutputsList?, AppList?, AttestList?, PendingInv?, Stream(String)?).
root_signed(signed(_, _, Und), Id, From, Src, T, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    undertaking_check(Und?, Src?, Ok0),
    take_joining(From?, Src?, Pend?, Pend1, I),
    handshake(Ok0?, I?, Apps?, Apps1, Src?, T?, Ok, I1),
    accept_root_step(Ok?, I1?, Id?, From?, UserIn?, NetIn?, Outs?,
                     Apps1?, Atts?, Pend1?, Trusted?).
root_signed(unsigned, Id, From, Src, _, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    take_joining(From?, Src?, Pend?, Pend1, I),
    accept_root_step(refused, I?, Id?, From?, UserIn?, NetIn?, Outs?,
                     Apps?, Atts?, Pend1?, Trusted?).

procedure accept_root_step(Verdict?, Kept?, Key?, Key?, UserInStream?, NetInStream?, OutputsList?, AppList?, AttestList?, PendingInv?, Stream(String)?).
accept_root_step(ok(M), kept(App, End), Id, From, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    ground(App?) |
    deliver(App?, From?, End?, Id?, M?, Apps?, Apps1, UserIn?, UserIn1),
    release_held(App?, From?, Pend?, Pend1),
    agent(Id?, UserIn1?, NetIn?, Outs?, host(Apps1?, Atts?, Pend1?, Trusted?)).
accept_root_step(_, I, Id, _, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    otherwise |
    close_kept(I?),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, Pend?, Trusted?)).

%% --- Activation and the grants (Section 3, "What the super-app grants a
%% mini-app") ---

%% deliver(App, Friend, End, Id, M, Apps, Apps1, UserIn, UserIn1): hand the
%% mini-app one end of the root channel of its conversation with Friend, on its
%% social-graph channel.  An idle mini-app is activated first, with exactly its
%% three grants: the end of its person channel and the calendar held since
%% installation, and the social-graph channel; the calendar is copied, the
%% copy kept for its next activation should this execution end.  Where it
%% runs already the new conversation goes to that execution (Section 3,
%% "Activation and joining").
procedure deliver(Constant?, Key?, RootChannel(Opaque)?, Key?, Module?, AppList?, AppList, UserInStream?, UserInStream).
deliver(App, Friend, End, Id, M, [app(A, M1, C, idle(Ui, Cal)) | Rest],
        [app(A?, M1?, C?, running(Sg1, Kept?)) | Rest?], UserIn, UserIn1?) :-
    App? =?= A? |
    copy_calendar(Cal?, Given, Kept),
    activate(M?, Id?, Ui?, Sg?, Up, Given?),
    open_conv(Friend?, End?, Sg, Sg1?),
    inject_requests(App?, Up?, UserIn?, UserIn1).
deliver(App, Friend, End, _, _, [app(A, M1, C, running(Sg?, Cal)) | Rest],
        [app(A?, M1?, C?, running(Sg1, Cal?)) | Rest?], UserIn, UserIn?) :-
    App? =?= A? |
    open_conv(Friend?, End?, Sg, Sg1?).
deliver(App, Friend, End, Id, M, [E | Rest], [E? | Rest1?], UserIn, UserIn1?) :-
    otherwise | deliver(App?, Friend?, End?, Id?, M?, Rest?, Rest1, UserIn?, UserIn1).
deliver(_, _, _, _, _, [], [], UserIn, UserIn?).

%% activate(M, Id, Ui, Sg, Up, Cal): the mini-app activated by run/3 at the
%% type identity of the entry template's opaque instance at the type its
%% exports record (GSG paper, Section 4, "Compiled programs as values"; TGLP
%% modules.tex, Dynamic Activation, "Opaque types"): opaque_type/3 reads that
%% type's identity off the module value, find_type/3 gives the opaque
%% instance's, and run/3 posts the one goal shape every mini-app is activated
%% by, its grants held at Opaque standing at the positions of the template's
%% parameter (the one step back).
procedure activate(Module?, Key?, PersonChannel(Opaque)?, Stream(SgToApp(Opaque))?, Stream(AppToSg), Stream(Integer)?).
activate(M, Id, Ui, Sg, Up?, Cal) :-
    opaque_type(miniapp/4, M?, H),
    find_type(miniapp/4, H?, T),
    run(miniapp(Id?, Ui?, ch(Sg?, Up), Cal?), T?, M?).

%% copy_calendar(Cal, Given, Kept): each date, as it comes, to the execution
%% activated and to the copy the entry keeps.
procedure copy_calendar(Stream(Integer)?, Stream(Integer), Stream(Integer)).
copy_calendar([D | Ds], [D? | Gs?], [D? | Ks?]) :-
    integer(D?) | copy_calendar(Ds?, Gs, Ks).
copy_calendar([], [], []).

%% inject_requests(App, Up, UserIn, UserIn1): the mini-app's requests up its
%% social-graph channel, tagged with its name, injected into the agent's person
%% stream as they come (as inject_msg does a response); the stream closes when
%% the person's does, whatever the mini-app still asks.
procedure inject_requests(Constant?, Stream(AppToSg)?, UserInStream?, UserInStream).
inject_requests(App, [warm_call(N, V) | Up], Ys, [app_request(App?, warm_call(N?, V?)) | Ys1?]) :-
    ground(V?) | inject_requests(App?, Up?, Ys?, Ys1).
inject_requests(App, Up, [Y | Ys], [Y? | Ys1?]) :-
    inject_requests(App?, Up?, Ys?, Ys1).
inject_requests(_, _, [], []).
%% The mini-app's stream up to the social graph closed: its execution has
%% ended.  Report it on the agent's own person stream, ahead of the rest of
%% that stream, and stop --- this goal has nothing further to splice.
inject_requests(App, [], Ys, [app_ended(App?) | Ys?]) :- ground(App?) | true.

%% open_conv(Friend, End, Sg, Sg1): Sg := [conversation(Friend, End) | Sg1].
procedure open_conv(Key?, RootChannel(Opaque)?, Stream(SgToApp(Opaque)), Stream(SgToApp(Opaque))?).
open_conv(Friend, End, [conversation(Friend?, End?) | Sg1?], Sg1).

%% --- Attestations (Section 5.5) ---

procedure lookup_att(Constant?, AttestList?, AttestList, String).
lookup_att(F, [att(F1, S) | Rest], [att(F1?, S?) | Rest?], S?) :- F? =?= F1? | true.
lookup_att(F, [E | Rest], [E? | Rest1?], S?) :- otherwise | lookup_att(F?, Rest?, Rest1, S).
lookup_att(_, [], [], none).

%% --- Termination: the mini-apps' streams close with the agent's ---

procedure close_host(Host?).
close_host(host(Apps, _, Pend, _)) :- close_apps(Apps?), close_pending(Pend?).

%% close_pending(Pend): the ends kept for an invitation or a join that has not
%% reached its handshake, closed with the agent; every other entry dropped.
procedure close_pending(PendingInv?).
close_pending([invited(_, _, _, ch(_, [])) | Rest]) :- close_pending(Rest?).
close_pending([offered(_, _, _, ch(_, [])) | Rest]) :- close_pending(Rest?).
close_pending([joining(_, _, _, ch(_, [])) | Rest]) :- close_pending(Rest?).
close_pending([_ | Rest]) :- otherwise | close_pending(Rest?).
close_pending([]).

procedure close_apps(AppList?).
close_apps([app(_, _, _, idle(Ui, _)) | Rest]) :- idle_channel(Ui?), close_apps(Rest?).
close_apps([app(_, _, _, running([], _)) | Rest]) :- close_apps(Rest?).
close_apps([]).

%% idle_channel(Ui?): the person channel of a mini-app never activated, which
%% never ends in either direction (vGLP, Section 6.3, Definition "Person
%% Channel, Person Writer, GLP with Persons, Grant"; vGLP 2026-10-14 21:48
%% UTC): read the person's grants for good, passing the draws' writer on,
%% and suspend when none comes.
procedure(T) idle_channel(PersonChannel(T)?).
idle_channel(ch([_ | Gs], Ds?)) :- idle_channel(ch(Gs?, Ds)).

procedure app_names(AppList?, AppList, Stream(Constant)).
app_names([app(A, M, C, St) | Rest], [app(A?, M?, C?, St?) | Rest1?], [A? | Names?]) :-
    app_names(Rest?, Rest1, Names).
app_names([], [], []).

%% =============================================================================
%% THE WARM CALL'S STEPS AND BOOKKEEPING (Section 5.2)
%% =============================================================================

%% anchor_is(Parts, X, B, Parts1): whether the anchor a global name carries ---
%% the name taken apart into a list, '_w'(Anchor, I) or '_r'(Anchor, I) --- is
%% X, the parts handed on as Parts1 to a caller that reads them again: a reader
%% of a type that is not constant is read once.  A name's parts are untyped,
%% so the anchor is only ever compared, never produced as an agent.
procedure anchor_is(Stream(_)?, Constant?, Constant, Stream(_)).
anchor_is([F, A | R], X, true, [F?, A? | R?]) :- A? =?= X? | true.
anchor_is(Parts, _, false, Parts?) :- otherwise | true.

%% --- at the holder ---

%% take_warm_consent_for(Parts, Pend, Pend1, C): the person's consent to a warm
%% call with the name's anchor, removed.
procedure take_warm_consent_for(Stream(_)?, PendingInv?, PendingInv, WarmConsent).
take_warm_consent_for(Parts, [warm_consent(W) | Rest], Pend1?, C?) :-
    ground(Parts?) |
    anchor_is(Parts?, W?, B, _),
    twc_step(B?, Parts?, W?, Rest?, Pend1, C).
take_warm_consent_for(Parts, [P | Rest], [P? | Rest1?], C?) :-
    otherwise | take_warm_consent_for(Parts?, Rest?, Rest1, C).
take_warm_consent_for(_, [], [], no).

procedure twc_step(Constant?, Stream(_)?, Key?, PendingInv?, PendingInv, WarmConsent).
twc_step(true, _, W, Rest, Rest?, yes(W?)).
twc_step(false, Parts, W, Rest, [warm_consent(W?) | Rest1?], C?) :-
    take_warm_consent_for(Parts?, Rest?, Rest1, C).

%% warm_step(C, ...): with the person's consent, the social graph asks the
%% forwarding friend to introduce it to the ANCHOR, named by the constant the
%% person consented to --- never by the held link's global name, which is a
%% name of a variable and is not a term at the friend that receives it.  The
%% name stays here, where authorise_link/2 will take it.
procedure warm_step(WarmConsent?, Key?, Constant?, GlobalName?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
warm_step(yes(Anchor), Id, App, Name, Via, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    send_friend(Via?, msg(Id?, Via?, request_intro(Anchor?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?,
          host(Apps?, Atts?, [warm(App?, Name?) | Pend?], Trusted?)).
warm_step(no, Id, App, Name, Via, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    agent(Id?, UserIn?, NetIn?, Outs?,
          host(Apps?, Atts?, [warm_wait(App?, Name?, Via?) | Pend?], Trusted?)).

%% take_warm_wait(Who, Pend, Pend1, Wait): a warm call waiting for the person's
%% consent whose anchor is Who, removed: wait(App, Name, Via), or none.
procedure take_warm_wait(Constant?, PendingInv?, PendingInv, WarmWait).
take_warm_wait(Who, [warm_wait(App, Name, Via) | Rest], Pend1?, W?) :-
    ground(Name?) |
    Parts ..= Name?,
    anchor_is(Parts?, Who?, B, _),
    tww_step(B?, Who?, App?, Name?, Via?, Rest?, Pend1, W).
take_warm_wait(Who, [P | Rest], [P? | Rest1?], W?) :- otherwise | take_warm_wait(Who?, Rest?, Rest1, W).
take_warm_wait(_, [], [], none).

procedure tww_step(Constant?, Constant?, Constant?, GlobalName?, Key?, PendingInv?, PendingInv, WarmWait).
tww_step(true, _, App, Name, Via, Rest, Rest?, wait(App?, Name?, Via?)).
tww_step(false, Who, App, Name, Via, Rest, [warm_wait(App?, Name?, Via?) | Rest1?], W?) :-
    take_warm_wait(Who?, Rest?, Rest1, W).

procedure warm_consent_step(WarmWait?, Key?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
warm_consent_step(none, Id, Who, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, [warm_consent(Who?) | Pend?], Trusted?)).
warm_consent_step(wait(App, Name, Via), Id, Who, UserIn, NetIn, Outs, Host) :-
    warm_step(yes(Who?), Id?, App?, Name?, Via?, UserIn?, NetIn?, Outs?, Host?).

%% warm_after_commit(Id, Friend, Pend, Pend1, Outs, Outs1): a friendship just
%% made with the anchor of a warm call under way: send the warm call.  The
%% pending list is passed through unchanged.
procedure warm_after_commit(Key?, Key?, PendingInv?, PendingInv, OutputsList?, OutputsList).
warm_after_commit(Id, Friend, [warm(App, Name) | Rest], [warm(App?, Name?) | Rest1?], Outs, Outs1?) :-
    ground(App?), ground(Name?) |
    Parts ..= Name?,
    anchor_is(Parts?, Friend?, B, _),
    wac_step(B?, Id?, Friend?, App?, Rest?, Rest1, Outs?, Outs1).
warm_after_commit(Id, Friend, [P | Rest], [P? | Rest1?], Outs, Outs1?) :-
    otherwise | warm_after_commit(Id?, Friend?, Rest?, Rest1, Outs?, Outs1).
warm_after_commit(_, _, [], [], Outs, Outs?).

procedure wac_step(Constant?, Key?, Key?, Constant?, PendingInv?, PendingInv, OutputsList?, OutputsList).
wac_step(true, Id, Friend, App, Rest, Rest?, Outs, Outs1?) :-
    send_friend(Friend?, msg(Id?, Friend?, warm_call(App?)), Outs?, Outs1).
wac_step(false, Id, Friend, _, Rest, Rest1?, Outs, Outs1?) :-
    warm_after_commit(Id?, Friend?, Rest?, Rest1, Outs?, Outs1).

%% release_held(App, From, Pend, Pend1): the handshake with the anchor done,
%% the held end is released, and the value goes to the anchor.
procedure release_held(Constant?, Constant?, PendingInv?, PendingInv).
release_held(App, From, [warm(A, Name) | Rest], Pend1?) :-
    App? =?= A?, ground(Name?) |
    Parts ..= Name?,
    anchor_is(Parts?, From?, B, _),
    rh_step(B?, App?, From?, Name?, Rest?, Pend1).
release_held(App, From, [P | Rest], [P? | Rest1?]) :-
    otherwise | release_held(App?, From?, Rest?, Rest1).
release_held(_, _, [], []).

procedure rh_step(Constant?, Constant?, Constant?, GlobalName?, PendingInv?, PendingInv).
rh_step(true, _, _, Name, Rest, Rest?) :- authorise_link(Name?, authorise).
rh_step(false, App, From, Name, Rest, [warm(App?, Name?) | Rest1?]) :-
    release_held(App?, From?, Rest?, Rest1).

%% --- at the anchor ---

procedure take_warm_consent(Constant?, PendingInv?, PendingInv, Constant).
take_warm_consent(Who, [warm_consent(W) | Rest], Rest?, true) :- Who? =?= W? | true.
take_warm_consent(Who, [P | Rest], [P? | Rest1?], C?) :- otherwise | take_warm_consent(Who?, Rest?, Rest1, C).
take_warm_consent(_, [], [], false).

%% warm_release(Mine, S, Pend, Pend1, B): a held link is authorised at BOTH of
%% its ends and each end decides for itself (IGLP, madglp-spec, Held Links).
%% This end is the ANCHOR when the name is anchored here --- the value is
%% coming home, and it is released where the person accepted a warm call from
%% the friend that sends it.  Otherwise this end is the HOLDER, and the report
%% goes to the mini-app, which asks for the warm call.  The two ends of one
%% link have different names and neither crosses, so they are never compared:
%% the friend it comes from is what identifies the link to a program.
%% may_release(Parts, S, Pend, Pend1, B): whether this end authorises the link
%% the runtime is asking about --- the person's volition for it.  Both ends of
%% a held link are asked, each about its own end, and the traffic one
%% authorisation lets through is itself held at the other end, so the reports
%% come in ROUNDS and every one of them must be answered (IGLP, 2026-09-09):
%% a program that answers only the first round stops with the acknowledgement
%% it is waiting for sitting held at its own end.  The volitions are: a warm
%% call accepted from the friend the traffic comes from, and an introduction
%% accepted with or from that friend --- an introduction's consent variables
%% are the introducer's, so the links they bring are anchored at the
%% introducer, while what the other party writes into them is anchored at
%% that party.  The entries are KEPT: one volition releases every link and
%% every round it brings.
procedure may_release(Stream(_)?, Constant?, PendingInv?, PendingInv, Constant).
may_release(Parts, S, [warm_ok(F) | Rest], [warm_ok(F?) | Rest1?], B?) :-
    ground(Parts?), ground(S?) |
    mr_warm(S?, F?, Parts?, Rest?, Rest1, B).
may_release(Parts, S, [intro_ok(W) | Rest], [intro_ok(W?) | Rest1?], B?) :-
    ground(Parts?), ground(S?) |
    mr_intro(Parts?, S?, W?, Rest?, Rest1, B).
may_release(Parts, S, [P | Rest], [P? | Rest1?], B?) :-
    otherwise | may_release(Parts?, S?, Rest?, Rest1, B).
may_release(_, _, [], [], false).

procedure mr_warm(Constant?, Constant?, Stream(_)?, PendingInv?, PendingInv, Constant).
mr_warm(S, F, _, Rest, Rest?, true) :- S? =?= F? | true.
mr_warm(S, F, Parts, Rest, Rest1?, B?) :-
    S? =?\= F? | may_release(Parts?, S?, Rest?, Rest1, B).

procedure mr_intro(Stream(_)?, Constant?, Constant?, PendingInv?, PendingInv, Constant).
mr_intro(_, S, W, Rest, Rest?, true) :- S? =?= W? | true.
mr_intro(Parts, S, W, Rest, Rest1?, B?) :-
    S? =?\= W? |
    anchor_is(Parts?, W?, Hit, Parts1),
    mr_anchor(Hit?, Parts1?, S?, Rest?, Rest1, B).

procedure mr_anchor(Constant?, Stream(_)?, Constant?, PendingInv?, PendingInv, Constant).
mr_anchor(true, _, _, Rest, Rest?, true).
mr_anchor(false, Parts, S, Rest, Rest1?, B?) :- may_release(Parts?, S?, Rest?, Rest1, B).

%% take_intro_via(Other, Pend, Pend1, Via): who introduced Other, removed.
procedure take_intro_via(Constant?, PendingInv?, PendingInv, AnchorFriend).
take_intro_via(Other, [intro_via(O, V) | Rest], Rest?, found(V?)) :-
    Other? =?= O? | true.
take_intro_via(Other, [P | Rest], [P? | Rest1?], V?) :-
    otherwise | take_intro_via(Other?, Rest?, Rest1, V).
take_intro_via(_, [], [], none).

%% accepted_intro(Via, Other, Pend, Pend1): the consent kept, so that a link of
%% this introduction reported later is released in its turn.
procedure accepted_intro(AnchorFriend?, Key?, PendingInv?, PendingInv).
accepted_intro(found(Via), Other, Pend, [intro_ok(Via?), intro_ok(Other?) | Pend?]).
accepted_intro(none, Other, Pend, [intro_ok(Other?) | Pend?]).

%% release_by_sender(Via, Pend, Pend1, Via1): every link already reported and
%% held that came FROM Via, authorised now that the person has consented to the
%% introduction Via made.  The introducer's consent variables are the
%% introducer's own, so these links are anchored at the introducer and not at
%% the friend being introduced.  Via is read here and handed on, as Via1, to
%% accepted_intro: a reader of a type that is not constant is read once.
procedure release_by_sender(AnchorFriend?, PendingInv?, PendingInv, AnchorFriend).
release_by_sender(found(Via), Pend, Pend1?, found(Via?)) :- rbs(Via?, Pend?, Pend1).
release_by_sender(none, Pend, Pend?, none).

procedure rbs(Constant?, PendingInv?, PendingInv).
rbs(Via, [held(Name, S) | Rest], Pend1?) :-
    ground(Name?), Via? =?= S? |
    authorise_link(Name?, authorise),
    rbs(Via?, Rest?, Pend1).
rbs(Via, [P | Rest], [P? | Rest1?]) :- otherwise | rbs(Via?, Rest?, Rest1).
rbs(_, [], []).

%% intro_ok_for(Parts, Pend, Pend1, B): whether the person has accepted an
%% introduction with the anchor of this held name.  The introducer mints the
%% consent variables and each of the two it introduces receives them FROM the
%% introducer, so both ends are held; the consent to the introduction is what
%% releases them, and it is kept, since one introduction holds several links.
procedure pending_step(Constant?, GlobalName?, Key?, Key?, UserInStream?, NetInStream?, OutputsList?, AppList?, AttestList?, PendingInv?, Stream(String)?).
pending_step(true, Name, _, Id, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    authorise_link(Name?, authorise),
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, Pend?, Trusted?)).
%% No volition for it yet: the report goes to the mini-apps, which know their
%% conversations, AND the link is remembered, so that a consent given after the
%% report --- the person accepting the introduction the link came with ---
%% releases it in its turn.  A link reported before its volition and then
%% forgotten is a link nothing can ever release.
pending_step(false, Name, S, Id, UserIn, NetIn, Outs, Apps, Atts, Pend, Trusted) :-
    forward_pending(Name?, S?, Apps?, Apps1, Name1),
    agent(Id?, UserIn?, NetIn?, Outs?,
          host(Apps1?, Atts?, [held(Name1?, S?) | Pend?], Trusted?)).

%% forward_pending(Name, S, Apps, Apps1, Name1): the report to every running
%% mini-app, the name handed on as Name1 to be remembered: a reader of a type
%% that is not constant is read once.
procedure forward_pending(GlobalName?, Key?, AppList?, AppList, GlobalName).
forward_pending(Name, S, [app(A, M, C, running(Sg?, Cal)) | Rest], [app(A?, M?, C?, running(Sg1, Cal?)) | Rest1?], Name1?) :-
    ground(Name?) |
    push_down(held(Name?, S?), Sg, Sg1?),
    forward_pending(Name?, S?, Rest?, Rest1, Name1).
forward_pending(Name, S, [E | Rest], [E? | Rest1?], Name1?) :-
    otherwise | forward_pending(Name?, S?, Rest?, Rest1, Name1).
forward_pending(Name, _, [], [], Name?).

procedure push_down(SgToApp(Opaque)?, Stream(SgToApp(Opaque)), Stream(SgToApp(Opaque))?).
push_down(Msg, [Msg? | Sg1?], Sg1).

procedure warm_call_step(Constant?, Key?, Key?, Constant?, UserInStream?, NetInStream?, OutputsList?, Host?).
warm_call_step(true, Id, From, App, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    agent(Id?, [msg(person, Id?, invite(App?, From?)) | UserIn?], NetIn?, Outs?,
          host(Apps?, Atts?, [warm_ok(From?) | Pend?], Trusted?)).
warm_call_step(false, Id, _, _, UserIn, NetIn, Outs, Host) :-
    agent(Id?, UserIn?, NetIn?, Outs?, Host?).

%% --- at the forwarding friend ---

%% anchor_friend(Parts, Outs, Outs1, F): the friend whose identity the name's
%% anchor is, the outputs passed through.
procedure anchor_friend(Constant?, OutputsList?, OutputsList, AnchorFriend).
anchor_friend(Anchor, [friend_output(K, Out?) | Rest], [friend_output(K?, Out) | Rest?], found(K?)) :-
    Anchor? =?= K? | true.
anchor_friend(Anchor, [E | Rest], [E? | Rest1?], F?) :-
    otherwise | anchor_friend(Anchor?, Rest?, Rest1, F).
anchor_friend(_, [], [], none).

%% intro_request(Requester, Found, ...): the request proceeds only where the
%% requester and the anchor are both friends of this agent (Section 5.2); where
%% either is not, nothing is done beyond not introducing.
procedure intro_request(AnchorFriend?, AnchorFriend?, Key?, Key?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
intro_request(found(_), found(Anchor), Id, From, Anchor1, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    take_intro_consent(From?, Anchor?, Pend?, Pend1, C),
    intro_request_step(C?, Id?, From?, Anchor?, Anchor1?, UserIn?, NetIn?, Outs?,
                       host(Apps?, Atts?, Pend1?, Trusted?)).
intro_request(_, _, Id, _, _, UserIn, NetIn, Outs, Host) :-
    otherwise | agent(Id?, UserIn?, NetIn?, Outs?, Host?).

procedure take_intro_consent(Constant?, Constant?, PendingInv?, PendingInv, Constant).
take_intro_consent(R, A, [intro_consent(R1, A1) | Rest], Rest?, true) :-
    R? =?= R1?, A? =?= A1? | true.
take_intro_consent(R, A, [P | Rest], [P? | Rest1?], C?) :- otherwise | take_intro_consent(R?, A?, Rest?, Rest1, C).
take_intro_consent(_, _, [], [], false).

procedure intro_request_step(Constant?, Key?, Key?, Key?, Constant?, UserInStream?, NetInStream?, OutputsList?, Host?).
intro_request_step(true, Id, From, Anchor, _, UserIn, NetIn, Outs, Host) :-
    agent(Id?, [msg(person, Id?, introduce(From?, Anchor?)) | UserIn?], NetIn?, Outs?, Host?).
intro_request_step(false, Id, From, _, Anchor1, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, [intro_wait(From?, Anchor1?) | Pend?], Trusted?)).

%% take_intro_wait(Requester, Anchor, Pend, Pend1, W): a request from Requester
%% waiting for consent whose name is anchored at Anchor, removed.
procedure take_intro_wait(Constant?, Constant?, PendingInv?, PendingInv, Constant).
take_intro_wait(R, A, [intro_wait(R1, A1) | Rest], Rest?, true) :-
    R? =?= R1?, A? =?= A1? | true.
take_intro_wait(R, A, [P | Rest], [P? | Rest1?], W?) :- otherwise | take_intro_wait(R?, A?, Rest?, Rest1, W).
take_intro_wait(_, _, [], [], false).

procedure intro_consent_step(Constant?, Key?, Key?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
intro_consent_step(true, Id, From, Anchor, UserIn, NetIn, Outs, Host) :-
    agent(Id?, [msg(person, Id?, introduce(From?, Anchor?)) | UserIn?], NetIn?, Outs?, Host?).
intro_consent_step(false, Id, From, Anchor, UserIn, NetIn, Outs, host(Apps, Atts, Pend, Trusted)) :-
    agent(Id?, UserIn?, NetIn?, Outs?, host(Apps?, Atts?, [intro_consent(From?, Anchor?) | Pend?], Trusted?)).

%% =============================================================================
%% THE INTRODUCTION VIA A MUTUAL FRIEND (Section 5.2)
%% =============================================================================

%% introduce_step(FP, FQ, ...): the person-posted introduction, dispatched on
%% the two lookups of the outputs list (app:code).  Where P and Q each have a
%% friend output entry the mutual friend mints the two consent variables and
%% sends each party an introduction to the other, carrying its own consent
%% variable to write and the other's to read, by its role, the smaller
%% identity proposing; where either does not, it does nothing beyond not
%% introducing.
procedure introduce_step(AnchorFriend?, AnchorFriend?, Key?, Key?, Key?, UserInStream?, NetInStream?, OutputsList?, Host?).
introduce_step(found(_), found(_), Id, P, Q, UserIn, NetIn,
               Outs, Host) :-
    P? @< Q? |
    send_friend(P?,
        msg(Id?, P?, introduce_propose(Q?, PSay, QSay?)),
        Outs?, Outs1),
    send_friend(Q?,
        msg(Id?, Q?, introduce_accept(P?, QSay, PSay?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Host?).
introduce_step(found(_), found(_), Id, P, Q, UserIn, NetIn,
               Outs, Host) :-
    otherwise |
    send_friend(Q?,
        msg(Id?, Q?, introduce_propose(P?, QSay, PSay?)),
        Outs?, Outs1),
    send_friend(P?,
        msg(Id?, P?, introduce_accept(Q?, PSay, QSay?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Host?).
introduce_step(_, _, Id, _, _, UserIn, NetIn, Outs, Host) :-
    otherwise | agent(Id?, UserIn?, NetIn?, Outs?, Host?).

%% =============================================================================
%% A MESSAGE TO A FRIEND (Section 5.1)
%% =============================================================================

%% send_step(F, ...): the person's message, dispatched on the lookup of the
%% outputs list.  Where Target has a friend output entry the message is sent
%% on the friend channel; where it has none the message is not sent, and the
%% person is told not_a_friend(Target) --- a send between the person's
%% acceptance and the conveyance being such a message.
procedure send_step(AnchorFriend?, Key?, Key?, Constant?, OutputsList?, OutputsList).
send_step(found(_), Id, Target, Text, Outs, Outs1?) :-
    send_friend(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1).
send_step(none, _, Target, _, Outs, Outs1?) :-
    send_user(msg(agent, person, not_a_friend(Target?)), Outs?, Outs1).
