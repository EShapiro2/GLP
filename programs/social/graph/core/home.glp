%% Compiled from vGLP by the canonical compilation
%% (vGLP, Definition "Canonical Compilation").  Do not edit: edit
%% the .vglp source and compile again.

CompilerKey ::= Key.
Friend ::= Key.
AppName ::= String.
Artefact ::= String.
Request ::= trust(CompilerKey) ; install(AppName, Artefact) ; invite(AppName, Friend) ; open_place ; close_place.
FriendRequest ::= from(Friend, Decision?).
Introducer ::= Key.
Other ::= Key.
IntroRequest ::= from(Introducer, Other, Decision?).
Befriend ::= befriend.
NearbyPerson ::= nearby(Friend, Befriend?).

Question ::= friendRequest_w(FriendRequest) ; introRequest_w(IntroRequest) ; nearbyPerson_w(NearbyPerson) ; stream_request_r(Stream(Request)?).

procedure respond_friend(Key?, Key?, PendingValue?, Stream(UserInMsg), Stream(Ask(Question))).
respond_friend(S1, S2, S3, S4?, [ask('FriendRequest', friendRequest_w(X?)) | D?]) :- respond_friend1(S1?, S2?, S3?, S4, X, D).

procedure respond_friend1(Key?, Key?, PendingValue?, Stream(UserInMsg), FriendRequest, Stream(Ask(Question))).
respond_friend1(Id, From, P, Cmds?, from(From?, Answer), []) :- ground(Id?), ground(From?) | decide_friend(Answer?, Id?, From?, P?, Cmds).

procedure decide_friend(Decision?, Key?, Key?, PendingValue?, Stream(UserInMsg)).
decide_friend(yes, Id, From, P, [msg(person, Id?, decision(yes, From?, P?))]).
decide_friend(no, Id, From, P, [msg(person, Id?, decision(no, From?, P?))]).

procedure respond_intro(Key?, Key?, Key?, PendingValue?, Stream(UserInMsg), Stream(Ask(Question))).
respond_intro(S1, S2, S3, S4, S5?, [ask('IntroRequest', introRequest_w(X?)) | D?]) :- respond_intro1(S1?, S2?, S3?, S4?, S5, X, D).

procedure respond_intro1(Key?, Key?, Key?, PendingValue?, Stream(UserInMsg), IntroRequest, Stream(Ask(Question))).
respond_intro1(Id, From, Other, P, Cmds?, from(From?, Other?, Answer), []) :- ground(Id?), ground(From?), ground(Other?) | decide_intro(Answer?, Id?, Other?, P?, Cmds).

procedure decide_intro(Decision?, Key?, Key?, PendingValue?, Stream(UserInMsg)).
decide_intro(yes, Id, Other, P, [msg(person, Id?, accept_intro(Other?, P?))]).
decide_intro(no, Id, Other, P, [msg(person, Id?, reject_intro(Other?, P?))]).

procedure befriend_card(Key?, Key?, Stream(UserInMsg), Stream(Ask(Question))).
befriend_card(S1, S2, S3?, [ask('NearbyPerson', nearbyPerson_w(X?)) | D?]) :- befriend_card1(S1?, S2?, S3, X, D).

procedure befriend_card1(Key?, Key?, Stream(UserInMsg), NearbyPerson, Stream(Ask(Question))).
befriend_card1(Id, K, Cmds?, nearby(K?, B), []) :- ground(Id?), ground(K?) | befriend_pick(B?, Id?, K?, Cmds).

procedure befriend_pick(Befriend?, Key?, Key?, Stream(UserInMsg)).
befriend_pick(befriend, Id, K, [msg(person, Id?, connect(K?))]).

procedure offer(List(Key)?, Key?, List(Key)?, List(Key), Stream(UserInMsg), Stream(Ask(Question))).
offer([K | Ks], Id, Cd, Cd1?, Cmds?, D1?) :- ground(K?), ground(Cd?) | in_keys(K?, Cd?, D), offer_one(D?, K?, Ks?, Id?, Cd?, Cd1, Cmds, D1).
offer([], _, Cd, Cd?, [], []).

procedure offer_one(Decision?, Key?, List(Key)?, Key?, List(Key)?, List(Key), Stream(UserInMsg), Stream(Ask(Question))).
offer_one(yes, _, Ks, Id, Cd, Cd1?, Cmds?, D?) :- offer(Ks?, Id?, Cd?, Cd1, Cmds, D).
offer_one(no, K, Ks, Id, Cd, Cd1?, Cmds?, D?) :- ground(K?), ground(Id?) | befriend_card(Id?, K?, C1, D1), offer(Ks?, Id?, [K? | Cd?], Cd1, C2, D2), merge(C1?, C2?, Cmds), merge(D1?, D2?, D).

procedure in_keys(Key?, List(Key)?, Decision).
in_keys(K, [K1 | _], yes) :- (K? =?= K1?) | true.
in_keys(K, [_ | Ks], D?) :- otherwise | in_keys(K?, Ks?, D).
in_keys(_, [], no).

exported procedure home(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
home(S1, S2, S3?, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- home1(S1?, S2?, S3, X?, D).

exported procedure home1(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Request)?, Stream(Ask(Question))).
home1(Id, Outs, Cmds?, Reqs, D?) :- serve(Reqs?, Id?, [], Outs?, Cmds, D).

procedure serve(Stream(Request)?, Key?, List(Key)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
serve(Reqs, Id, Cd, [msg(agent, person, befriend(From, P)) | Outs], Cmds?, D?) :- ground(Id?), ground(From?) | respond_friend(Id?, From?, P?, Answer, D1), merge(Answer?, Cmds1?, Cmds), serve(Reqs?, Id?, Cd?, Outs?, Cmds1, D2), merge(D1?, D2?, D).
serve(Reqs, Id, Cd, [msg(agent, person, befriend_intro(From, Other, P)) | Outs], Cmds?, D?) :- ground(Id?), ground(From?), ground(Other?) | respond_intro(Id?, From?, Other?, P?, Answer, D1), merge(Answer?, Cmds1?, Cmds), serve(Reqs?, Id?, Cd?, Outs?, Cmds1, D2), merge(D1?, D2?, D).
serve(Reqs, Id, Cd, [msg(agent, person, nearby(Ks)) | Outs], Cmds?, D?) :- ground(Id?), ground(Ks?), ground(Cd?) | offer(Ks?, Id?, Cd?, Cd1, Picks, D1), merge(Picks?, Cmds1?, Cmds), serve(Reqs?, Id?, Cd1?, Outs?, Cmds1, D2), merge(D1?, D2?, D).
serve(Reqs, Id, Cd, [msg(agent, person, connected(K)) | Outs], Cmds?, D?) :- ground(Id?), ground(K?), ground(Cd?) | serve(Reqs?, Id?, [K? | Cd?], Outs?, Cmds, D).
serve(Reqs, Id, Cd, [_ | Outs], Cmds?, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, Cd?, Outs?, Cmds, D).
serve(_, _, _, [], [], []).
serve([trust(Key) | Reqs], Id, Cd, Outs, Cmds?, D?) :- ground(Id?), ground(Key?) | trust_act(Key?, Id?, Cd?, Reqs?, Outs?, Cmds, D).
serve([install(App, Name) | Reqs], Id, Cd, Outs, Cmds?, D?) :- ground(Id?), ground(App?), ground(Name?) | load_file(Name?, C), install_act(C?, App?, Id?, Cd?, Reqs?, Outs?, Cmds, D).
serve([invite(App, Friend) | Reqs], Id, Cd, Outs, Cmds?, D?) :- ground(Id?), ground(App?), ground(Friend?) | invite_act(App?, Friend?, Id?, Cd?, Reqs?, Outs?, Cmds, D).
serve([open_place | Reqs], Id, Cd, Outs, Cmds?, D?) :- ground(Id?) | place_act(open_place, Id?, Cd?, Reqs?, Outs?, Cmds, D).
serve([close_place | Reqs], Id, Cd, Outs, Cmds?, D?) :- ground(Id?) | place_act(close_place, Id?, Cd?, Reqs?, Outs?, Cmds, D).

procedure trust_act(String?, Key?, List(Key)?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
trust_act(Key, Id, Cd, Reqs, Outs, [msg(person, Id?, trust(Key?)) | Cmds?], D?) :- ground(Key?) | serve(Reqs?, Id?, Cd?, Outs?, Cmds, D).

procedure invite_act(Constant?, Key?, Key?, List(Key)?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
invite_act(App, Friend, Id, Cd, Reqs, Outs, [msg(person, Id?, invite(App?, Friend?)) | Cmds?], D?) :- ground(App?), ground(Friend?) | serve(Reqs?, Id?, Cd?, Outs?, Cmds, D).

procedure place_act(UserContent?, Key?, List(Key)?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
place_act(A, Id, Cd, Reqs, Outs, [msg(person, Id?, A?) | Cmds?], D?) :- ground(Id?) | serve(Reqs?, Id?, Cd?, Outs?, Cmds, D).

procedure install_act(Content?, Constant?, Key?, List(Key)?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
install_act(M, App, Id, Cd, Reqs, Outs, [msg(person, Id?, install(App?, M?, CSig?, Ui?)) | Cmds?], D?) :- module(M?) | creator_certification(M?, CSig), new_channel(Ui, Person), hold_person(Person?), serve(Reqs?, Id?, Cd?, Outs?, Cmds, D).
install_act(S, _, Id, Cd, Reqs, Outs, Cmds?, D?) :- string(S?) | serve(Reqs?, Id?, Cd?, Outs?, Cmds, D).

procedure creator_certification(Module?, String).
creator_certification(M, CSig?) :- decompose_module(M?, _, Src, _), self_key(K), sign(creator_cert(Src?, [friendship, ending_a_friendship], syntactically_grassroots), K?, CSig).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).
Event(Q, T) ::= Ask(Q) ; Input(T) ; Draw(T).
Events(Q, T) ::= [Event(Q, T) | Events(Q, T)].
Turn ::= ask ; grant ; draw.
Questioned(S) ::= S ; input(Path).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(Input(T)), Stream(Draw(T))), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), fair(ask, Asks?, Inputs?, COut?, Es), serve_1(Es?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(Input(T)), Stream(Draw(T))?, Inputs(T), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, G0s?, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), fair(ask, Asks?, Inputs?, COut?, Es), serve_1(Es?, COut, DOut, [route(0, G0s)], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(Input(T))).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([refresh | Gs], [refresh | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) fair(Turn?, Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Events(Q, T)).
fair(ask, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(grant, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(draw, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(ask, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(grant, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(draw, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(ask, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(grant, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(draw, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).

procedure(Q, T) serve_1(Events(Q, T)?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve_1([ask(_, Q) | Es], CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Es?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1([input(Id, P, R) | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(input(Id?, P?, R?), Rs?, Rs1), serve_1(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1([refresh | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- refresh_routes(Rs?, Rs1), serve_1(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1([draw(Id, W, V) | Es], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Es?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1([withdraw(Id) | Es], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Es?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) refresh_routes(Routes(T)?, Routes(T)).
refresh_routes([route(Id, [refresh | Gs1?]) | Rs], [route(Id?, Gs1) | Rs1?]) :- refresh_routes(Rs?, Rs1).
refresh_routes([], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure(T) form_string(T?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= friendRequest_w(_) ; introRequest_w(_) ; nearbyPerson_w(_) ; stream_request_r(_) ; output(List(Output)) ; Decision ; Befriend ; Request.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, G0s, Ss), output(thread(form(msg, [field('Constant', shown), field('Constant', shown), field('NoticeContent', menu([form(befriend, [field('Key', shown)]), form(befriend_intro, [field('Key', shown), field('Key', shown)]), form(connected, [field('Key', shown)]), shown, form(rejected, [field('Constant', shown)]), form(unfriended, [field('Constant', shown)]), form(received, [field('Key', shown), field('Constant', shown)]), form(not_a_friend, [field('Key', shown)]), form(nearby, [field('List(Key)', thread)])]))])), MOut?, G0s?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, friendRequest_w(X), Gs, Ds?) :- present_friendRequest([], X?, Gs1?, _, Vs, Done), run_friendRequest_w(Id?, form(from, [field('Friend', shown), field('Decision', buttons([yes, no]))]), Vs?, Done?, Gs?, Gs1, Ds).
construct(Id, introRequest_w(X), Gs, Ds?) :- present_introRequest([], X?, Gs1?, _, Vs, Done), run_introRequest_w(Id?, form(from, [field('Introducer', shown), field('Other', shown), field('Decision', buttons([yes, no]))]), Vs?, Done?, Gs?, Gs1, Ds).
construct(Id, nearbyPerson_w(X), Gs, Ds?) :- present_nearbyPerson([], X?, Gs1?, _, Vs, Done), run_nearbyPerson_w(Id?, form(nearby, [field('Friend', shown), field('Befriend', button(befriend))]), Vs?, Done?, Gs?, Gs1, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs1?, _, Done), run_stream_request_r(Id?, input_box(menu([form(trust, [field('CompilerKey', peer)]), form(install, [field('AppName', text), field('Artefact', text)]), form(invite, [field('AppName', text), field('Friend', peer)]), button(open_place), button(close_place)])), [input([])], Done?, Gs?, Gs1, Ds).

procedure output(Widget?, Stream(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output(W, Ms, Gs, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Gs?, Ds).

procedure output_more(Widget?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Gs, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Gs?, Ds).
output_more(W, Ms, Es, [refresh | Gs], Ds?) :- output_draw(W?, Ms?, Es?, Gs?, Ds).
output_more(W, Ms, Es, [input(_, _, _) | Gs], Ds?) :- output_more(W?, Ms?, Es?, Gs?, Ds).
output_more(W, [], Es, Gs, Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_draw(Widget?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, Gs, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Gs?, Ds).

procedure output_end(Widget?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_end(W, Es, [refresh | Gs], [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_end(W?, Es?, Gs?, Ds).
output_end(W, Es, [input(_, _, _) | Gs], Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure form_decision(Drawn?, Formed(Decision)).
form_decision(yes, formed(yes)).
form_decision(no, formed(no)).
form_decision(_, refused) :- otherwise | true.

procedure answer_decision(Path?, Decision, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_decision(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_decision(R?, F), take_decision(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_decision(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_decision(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_decision(Formed(Decision)?, Path?, Decision, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_decision(formed(V), _, V?, _, Gs, Gs?, done).
take_decision(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_decision(P?, X, Gs?, Gs1, Done).

View_friendRequest ::= from(Friend, Questioned(Decision)).
procedure present_friendRequest(Path?, FriendRequest?, Inputs(Drawn)?, Inputs(Drawn), Stream(View_friendRequest), Done).
present_friendRequest(P, from(H1, H2?), Gs, Gs1?, [from(H1?, input(M2?))], D2?) :- ground(P?), ground(H1?) | path(P?, 2, M2), path(P?, 2, Q2), answer_decision(Q2?, H2, Gs?, Gs1, D2).

procedure run_friendRequest_w(Integer?, Widget?, Stream(View_friendRequest)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_friendRequest_w(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, friendRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_friendRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_friendRequest_w(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_friendRequest_w_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_friendRequest_w_more(Integer?, Widget?, View_friendRequest?, Stream(View_friendRequest)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_friendRequest_w_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_friendRequest_w_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, friendRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_friendRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_friendRequest_w_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, friendRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_friendRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_friendRequest_w_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_friendRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_friendRequest_w_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_friendRequest_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_friendRequest_w_last(Integer?, Widget?, View_friendRequest?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_friendRequest_w_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_friendRequest_w_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, friendRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_friendRequest_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_friendRequest_w_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_friendRequest_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_friendRequest_w_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_friendRequest_w_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_friendRequest_w_grants(Gs?, Gs1).
run_friendRequest_w_grants([refresh | Gs], Gs1?) :- run_friendRequest_w_grants(Gs?, Gs1).

View_introRequest ::= from(Introducer, Other, Questioned(Decision)).
procedure present_introRequest(Path?, IntroRequest?, Inputs(Drawn)?, Inputs(Drawn), Stream(View_introRequest), Done).
present_introRequest(P, from(H1, H2, H3?), Gs, Gs1?, [from(H1?, H2?, input(M3?))], D3?) :- ground(P?), ground(H1?), ground(H2?) | path(P?, 3, M3), path(P?, 3, Q3), answer_decision(Q3?, H3, Gs?, Gs1, D3).

procedure run_introRequest_w(Integer?, Widget?, Stream(View_introRequest)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_introRequest_w(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, introRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_introRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_introRequest_w(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_introRequest_w_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_introRequest_w_more(Integer?, Widget?, View_introRequest?, Stream(View_introRequest)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_introRequest_w_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_introRequest_w_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, introRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_introRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_introRequest_w_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, introRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_introRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_introRequest_w_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_introRequest_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_introRequest_w_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_introRequest_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_introRequest_w_last(Integer?, Widget?, View_introRequest?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_introRequest_w_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_introRequest_w_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, introRequest_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_introRequest_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_introRequest_w_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_introRequest_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_introRequest_w_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_introRequest_w_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_introRequest_w_grants(Gs?, Gs1).
run_introRequest_w_grants([refresh | Gs], Gs1?) :- run_introRequest_w_grants(Gs?, Gs1).

procedure form_befriend(Drawn?, Formed(Befriend)).
form_befriend(befriend, formed(befriend)).
form_befriend(_, refused) :- otherwise | true.

procedure answer_befriend(Path?, Befriend, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_befriend(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_befriend(R?, F), take_befriend(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_befriend(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_befriend(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_befriend(Formed(Befriend)?, Path?, Befriend, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_befriend(formed(V), _, V?, _, Gs, Gs?, done).
take_befriend(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_befriend(P?, X, Gs?, Gs1, Done).

View_nearbyPerson ::= nearby(Friend, Questioned(Befriend)).
procedure present_nearbyPerson(Path?, NearbyPerson?, Inputs(Drawn)?, Inputs(Drawn), Stream(View_nearbyPerson), Done).
present_nearbyPerson(P, nearby(H1, H2?), Gs, Gs1?, [nearby(H1?, input(M2?))], D2?) :- ground(P?), ground(H1?) | path(P?, 2, M2), path(P?, 2, Q2), answer_befriend(Q2?, H2, Gs?, Gs1, D2).

procedure run_nearbyPerson_w(Integer?, Widget?, Stream(View_nearbyPerson)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_nearbyPerson_w(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, nearbyPerson_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_nearbyPerson_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_nearbyPerson_w(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_nearbyPerson_w_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_nearbyPerson_w_more(Integer?, Widget?, View_nearbyPerson?, Stream(View_nearbyPerson)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_nearbyPerson_w_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_nearbyPerson_w_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, nearbyPerson_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_nearbyPerson_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_nearbyPerson_w_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, nearbyPerson_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_nearbyPerson_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_nearbyPerson_w_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_nearbyPerson_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_nearbyPerson_w_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_nearbyPerson_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_nearbyPerson_w_last(Integer?, Widget?, View_nearbyPerson?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_nearbyPerson_w_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_nearbyPerson_w_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, nearbyPerson_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_nearbyPerson_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_nearbyPerson_w_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_nearbyPerson_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_nearbyPerson_w_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_nearbyPerson_w_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_nearbyPerson_w_grants(Gs?, Gs1).
run_nearbyPerson_w_grants([refresh | Gs], Gs1?) :- run_nearbyPerson_w_grants(Gs?, Gs1).

procedure join_request_trust_1(Formed(CompilerKey)?, Formed(Request)).
join_request_trust_1(formed(X1), formed(trust(X1?))).
join_request_trust_1(refused, refused).

procedure join_request_install_2(Formed(AppName)?, Formed(Artefact)?, Formed(Request)).
join_request_install_2(formed(X1), formed(X2), formed(install(X1?, X2?))).
join_request_install_2(refused, _, refused).
join_request_install_2(_, refused, refused).

procedure join_request_invite_2(Formed(AppName)?, Formed(Friend)?, Formed(Request)).
join_request_invite_2(formed(X1), formed(X2), formed(invite(X1?, X2?))).
join_request_invite_2(refused, _, refused).
join_request_invite_2(_, refused, refused).

procedure form_request(Drawn?, Formed(Request)).
form_request(trust(R1), F?) :- form_string(R1?, F1), join_request_trust_1(F1?, F).
form_request(install(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_request_install_2(F1?, F2?, F).
form_request(invite(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_request_invite_2(F1?, F2?, F).
form_request(open_place, formed(open_place)).
form_request(close_place, formed(close_place)).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs(Drawn)?, Inputs(Drawn), Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

View_stream_request_r ::= Stream(Request) ; input(Path).
procedure run_stream_request_r(Integer?, Widget?, Stream(View_stream_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_stream_request_r_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_stream_request_r_more(Integer?, Widget?, View_stream_request_r?, Stream(View_stream_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_stream_request_r_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_stream_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_stream_request_r_last(Integer?, Widget?, View_stream_request_r?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_stream_request_r_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_stream_request_r_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_stream_request_r_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_stream_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_stream_request_r_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_stream_request_r_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_stream_request_r_grants(Gs?, Gs1).
run_stream_request_r_grants([refresh | Gs], Gs1?) :- run_stream_request_r_grants(Gs?, Gs1).

