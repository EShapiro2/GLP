%% Compiled from vGLP by the canonical compilation
%% (vGLP, Definition "Canonical Compilation").  Do not edit: edit
%% the .vglp source and compile again.

CompilerKey ::= Key.
Friend ::= Key.
AppName ::= String.
Artefact ::= String.
Request ::= trust(CompilerKey) ; install(AppName, Artefact) ; invite(AppName, Friend) ; connect(Friend).
FriendRequest ::= from(Friend, Decision?).
Introducer ::= Key.
Other ::= Key.
IntroRequest ::= from(Introducer, Other, Decision?).

Question ::= friendRequest_w(FriendRequest) ; introRequest_w(IntroRequest) ; stream_request_r(Stream(Request)?).

procedure respond_friend(Key?, Key?, PendingValue?, Stream(UserInMsg), Stream(Ask(Question))).
respond_friend(S1, S2, S3, S4?, [ask('FriendRequest', friendRequest_w(X?)) | D?]) :- respond_friend1(S1?, S2?, S3?, S4, X, D).

procedure respond_friend1(Key?, Key?, PendingValue?, Stream(UserInMsg), FriendRequest, Stream(Ask(Question))).
respond_friend1(Id, From, P, Cmds?, from(From?, Answer), []) :- ground(Id?), ground(From?) | decide_friend(Answer?, Id?, From?, P?, Cmds).

procedure decide_friend(Decision?, Key?, Key?, PendingValue?, Stream(UserInMsg)).
decide_friend(yes, Id, From, P, [msg(person, Id?, decision(yes, From?, P?))]).
decide_friend(no, Id, From, P, [msg(person, Id?, decision(no, From?, P?))]).

procedure respond_intro(Key?, Key?, Key?, PendingValue?, Stream(UserInMsg), Stream(Ask(Question))).
respond_intro(S1, S2, S3, S4, S5?, [ask('IntroRequest', introRequest_w(X?)) | D?]) :- respond_intro1(S1?, S2?, S3?, S4?, S5, X, D).

procedure respond_intro1(Key?, Key?, Key?, PendingValue?, Stream(UserInMsg), IntroRequest, Stream(Ask(Question))).
respond_intro1(Id, From, Other, P, Cmds?, from(From?, Other?, Answer), []) :- ground(Id?), ground(From?), ground(Other?) | decide_intro(Answer?, Id?, Other?, P?, Cmds).

procedure decide_intro(Decision?, Key?, Key?, PendingValue?, Stream(UserInMsg)).
decide_intro(yes, Id, Other, P, [msg(person, Id?, accept_intro(Other?, P?))]).
decide_intro(no, Id, Other, P, [msg(person, Id?, reject_intro(Other?, P?))]).

exported procedure home(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
home(S1, S2, S3?, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- home1(S1?, S2?, S3, X?, D).

exported procedure home1(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Request)?, Stream(Ask(Question))).
home1(Id, Outs, Cmds?, Reqs, D?) :- serve(Reqs?, Id?, Outs?, Cmds, D).

procedure serve(Stream(Request)?, Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
serve(Reqs, Id, [msg(agent, person, befriend(From, P)) | Outs], Cmds?, D?) :- ground(Id?), ground(From?) | respond_friend(Id?, From?, P?, Answer, D1), merge(Answer?, Cmds1?, Cmds), serve(Reqs?, Id?, Outs?, Cmds1, D2), merge(D1?, D2?, D).
serve(Reqs, Id, [msg(agent, person, befriend_intro(From, Other, P)) | Outs], Cmds?, D?) :- ground(Id?), ground(From?), ground(Other?) | respond_intro(Id?, From?, Other?, P?, Answer, D1), merge(Answer?, Cmds1?, Cmds), serve(Reqs?, Id?, Outs?, Cmds1, D2), merge(D1?, D2?, D).
serve(Reqs, Id, [_ | Outs], Cmds?, D?) :- ground(Id?), otherwise | serve(Reqs?, Id?, Outs?, Cmds, D).
serve(_, _, [], [], []).
serve([trust(Key) | Reqs], Id, Outs, Cmds?, D?) :- ground(Id?), ground(Key?) | trust_act(Key?, Id?, Reqs?, Outs?, Cmds, D).
serve([install(App, Name) | Reqs], Id, Outs, Cmds?, D?) :- ground(Id?), ground(App?), ground(Name?) | load_file(Name?, C), install_act(C?, App?, Id?, Reqs?, Outs?, Cmds, D).
serve([invite(App, Friend) | Reqs], Id, Outs, Cmds?, D?) :- ground(Id?), ground(App?), ground(Friend?) | invite_act(App?, Friend?, Id?, Reqs?, Outs?, Cmds, D).
serve([connect(Friend) | Reqs], Id, Outs, Cmds?, D?) :- ground(Id?), ground(Friend?) | connect_act(Friend?, Id?, Reqs?, Outs?, Cmds, D).

procedure trust_act(String?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
trust_act(Key, Id, Reqs, Outs, [msg(person, Id?, trust(Key?)) | Cmds?], D?) :- ground(Key?) | serve(Reqs?, Id?, Outs?, Cmds, D).

procedure invite_act(Constant?, Key?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
invite_act(App, Friend, Id, Reqs, Outs, [msg(person, Id?, invite(App?, Friend?)) | Cmds?], D?) :- ground(App?), ground(Friend?) | serve(Reqs?, Id?, Outs?, Cmds, D).

procedure connect_act(Key?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
connect_act(Friend, Id, Reqs, Outs, [msg(person, Id?, connect(Friend?)) | Cmds?], D?) :- ground(Friend?) | serve(Reqs?, Id?, Outs?, Cmds, D).

procedure install_act(Content?, Constant?, Key?, Stream(Request)?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(Question))).
install_act(M, App, Id, Reqs, Outs, [msg(person, Id?, install(App?, M?, CSig?, Ui)) | Cmds?], D?) :- module(M?) | creator_certification(M?, CSig), hold_ui(Ui?), serve(Reqs?, Id?, Outs?, Cmds, D).
install_act(S, _, Id, Reqs, Outs, Cmds?, D?) :- string(S?) | serve(Reqs?, Id?, Outs?, Cmds, D).

procedure creator_certification(Module?, String).
creator_certification(M, CSig?) :- decompose_module(M?, _, Src, _), self_key(K), sign(creator_cert(Src?, [friendship, ending_a_friendship], grassroots), K?, CSig).

procedure hold_ui(AppUiStream?).
hold_ui([_ | Xs]) :- hold_ui(Xs?).
hold_ui([]).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Draw ::= draw(Integer, _, _) ; withdraw(Integer).
PersonIn ::= [_ | PersonIn].
Input ::= input(_, _, _).
Path ::= [] ; [Integer | Path].
Inputs ::= [Input | Inputs].
Route ::= route(Integer, Inputs?).
Routes ::= [] ; [Route | Routes].
Deads ::= [] ; [Inputs? | Deads].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q) ::= spawn(Integer, Q, Inputs, Stream(Draw)?).

procedure(Q) dispatch(Stream(Ask(Q))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), serve_1(Asks?, Inputs?, COut?, COut, POut, [], [], 1, Ss).

procedure(Q) dispatch(Stream(Ask(Q))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_)), _?, Stream(Spawn(Q))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, MOut), W, Ss?) :- split_grants(PIn?, Inputs, MIn), output(W?, MOut?, ODs), merge(ODs?, DOut?, POut), serve_1(Asks?, Inputs?, COut?, COut, DOut, [], [], 1, Ss).

procedure output(_?, Stream(_)?, Stream(_)).
output(W, Ms, [draw(0, W?, []) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Ds).

procedure output_more(_?, Stream(_)?, _?, Stream(_)).
output_more(W, [M | Ms], Es, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Ds).
output_more(_, [], _, []).

procedure output_draw(_?, Stream(_)?, _?, Stream(_)).
output_draw(W, Ms, Es, [draw(0, W?, Es?) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Ds).

procedure output_add(_?, _?, _).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure split_grants(PersonIn?, Inputs, Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([G | Gs], Is?, [G? | Ms?]) :- otherwise | split_grants(Gs?, Is, Ms).

procedure(Q) serve_1(Stream(Ask(Q))?, Inputs?, Stream(Draw)?, Stream(Draw), Stream(_), Routes?, Deads?, Integer?, Stream(Spawn(Q))).
serve_1([ask(_, Q) | Asks], Is, COut, CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve_1(Asks?, Is?, COut?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve_1(Asks, [G | Is], COut, CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(G?, Rs?, Rs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve_1(Asks, Is, [draw(Id, W, V) | COut], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve_1(Asks?, Is?, COut?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve_1(Asks, Is, [withdraw(Id) | COut], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve_1(Asks?, Is?, COut?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure route_grant(Input?, Routes?, Routes).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure remove_route(Integer?, Routes?, Routes, Deads?, Deads).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure run(Integer?, _?, Stream(_)?, Done?, Stream(Draw)).
run(Id, _, _, done, [withdraw(Id?)]).
run(Id, W, [V | Vs], Done, [draw(Id?, W?, V?) | Ds?]) :- ground(W?), ground(V?) | run(Id?, W?, Vs?, Done?, Ds).
run(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure run_end(Integer?, Done?, Stream(Draw)).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(Path?, _?, Stream(_)).
shown(_, X, [X?]) :- ground(X?) | true.
shown(P, X, [pending(P?) | Vs?]) :- shown_whole(X?, Vs).

procedure shown_whole(_?, Stream(_)).
shown_whole(X, [X?]) :- ground(X?) | true.

procedure thread(Path?, Stream(_)?, Stream(Stream(_))).
thread(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread(_, [], [[]]).
thread(P, Xs, [[] | Vs?]) :- thread_tail(P?, Xs?, Vs).

procedure thread_tail(Path?, Stream(_)?, Stream(Stream(_))).
thread_tail(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread_tail(_, [], []).

procedure thread_cell(Path?, _?, Stream(_)?, Stream(Stream(_))).
thread_cell(P, X, Xs, Vs?) :- ground(P?) | path(P?, 1, P1), path(P?, 2, P2), shown(P1?, X?, V1), thread(P2?, Xs?, V2), cons_views(V1?, V2?, Vs).

procedure cons_views(Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_views([E | Es], [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_views([], _, []).
cons_views(_, [], []).

procedure cons_more(_?, Stream(_)?, Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_more(_, T, [E | Es], Ts, [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(E, _, Es, [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(_, _, [], [], []).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

exported procedure dispatch(Stream(Ask(Question))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(Output))).
dispatch(Asks, PCh, MCh?) :- dispatch(Asks?, PCh?, MCh, thread(form(msg, [field('Constant', shown), field('Constant', shown), field('NoticeContent', menu([form(befriend, [field('Key', shown)]), form(befriend_intro, [field('Key', shown), field('Key', shown)]), form(connected, [field('Constant', shown)]), shown, form(rejected, [field('Constant', shown)]), form(unfriended, [field('Constant', shown)]), form(received, [field('Key', shown), field('Constant', shown)]), form(not_a_friend, [field('Key', shown)])]))])), Ss), constructs(Ss?).

procedure constructs(Stream(Spawn(Question))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs?, Stream(Draw)).
construct(Id, friendRequest_w(X), Gs, Ds?) :- present_friendRequest([], X?, Gs?, _, Vs, Done), run(Id?, form(from, [field('Friend', shown), field('Decision', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, introRequest_w(X), Gs, Ds?) :- present_introRequest([], X?, Gs?, _, Vs, Done), run(Id?, form(from, [field('Introducer', shown), field('Other', shown), field('Decision', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs?, _, Done), run(Id?, input_box(menu([form(trust, [field('CompilerKey', peer)]), form(install, [field('AppName', text), field('Artefact', text)]), form(invite, [field('AppName', text), field('Friend', peer)]), form(connect, [field('Friend', peer)])])), [input([])], Done?, Ds).

procedure form_decision(_?, Formed(Decision)).
form_decision(yes, formed(yes)).
form_decision(no, formed(no)).
form_decision(_, refused) :- otherwise | true.

procedure answer_decision(Path?, Decision, Inputs?, Inputs, Done).
answer_decision(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_decision(R?, F), take_decision(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_decision(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_decision(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_decision(Formed(Decision)?, Path?, Decision, Input?, Inputs?, Inputs, Done).
take_decision(formed(V), _, V?, _, Gs, Gs?, done).
take_decision(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_decision(P?, X, Gs?, Gs1, Done).

procedure start_friendRequest_from_2(Stream(_)?, Stream(_)?, Stream(_)).
start_friendRequest_from_2([V1 | S1], [V2 | S2], [from(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_friendRequest_from_2(V1?, V2?, S1?, S2?, Vs).
start_friendRequest_from_2([], _, []).
start_friendRequest_from_2(_, [], []).

procedure comb_friendRequest_from_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_friendRequest_from_2(_, V2, [V1 | S1], S2, [from(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_friendRequest_from_2(V1?, V2?, S1?, S2?, Vs).
comb_friendRequest_from_2(_, _, [], [], []).

procedure present_friendRequest(Path?, FriendRequest?, Inputs?, Inputs, Stream(_), Done).
present_friendRequest(P, from(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_decision(Q2?, H2, Gs?, Gs1, D2), start_friendRequest_from_2(V1?, [input(M2?)], Vs).
present_friendRequest(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_friendRequest_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_friendRequest_wait(Path?, FriendRequest?, Inputs?, Inputs, Stream(_), Done).
present_friendRequest_wait(P, from(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_friendRequest(P?, from(H1?, H2), Gs?, Gs1, Vs, Done).
present_friendRequest_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_friendRequest_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure start_introRequest_from_3(Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
start_introRequest_from_3([V1 | S1], [V2 | S2], [V3 | S3], [from(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_introRequest_from_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
start_introRequest_from_3([], _, _, []).
start_introRequest_from_3(_, [], _, []).
start_introRequest_from_3(_, _, [], []).

procedure comb_introRequest_from_3(_?, _?, _?, Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
comb_introRequest_from_3(_, V2, V3, [V1 | S1], S2, S3, [from(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_introRequest_from_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_introRequest_from_3(V1, _, V3, S1, [V2 | S2], S3, [from(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_introRequest_from_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_introRequest_from_3(_, _, _, [], [], [], []).

procedure present_introRequest(Path?, IntroRequest?, Inputs?, Inputs, Stream(_), Done).
present_introRequest(P, from(H1, H2, H3?), Gs, Gs1?, Vs?, D3?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, Q2), shown(Q2?, H2?, V2), path(P?, 3, M3), path(P?, 3, Q3), answer_decision(Q3?, H3, Gs?, Gs1, D3), start_introRequest_from_3(V1?, V2?, [input(M3?)], Vs).
present_introRequest(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_introRequest_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_introRequest_wait(Path?, IntroRequest?, Inputs?, Inputs, Stream(_), Done).
present_introRequest_wait(P, from(H1, H2, H3?), Gs, Gs1?, Vs?, Done?) :- present_introRequest(P?, from(H1?, H2?, H3), Gs?, Gs1, Vs, Done).
present_introRequest_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_introRequest_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure join_request_trust_1(Formed(CompilerKey)?, Formed(Request)).
join_request_trust_1(formed(X1), formed(trust(X1?))).
join_request_trust_1(refused, refused).

procedure join_request_install_2(Formed(AppName)?, Formed(Artefact)?, Formed(Request)).
join_request_install_2(formed(X1), formed(X2), formed(install(X1?, X2?))).
join_request_install_2(refused, _, refused).
join_request_install_2(_, refused, refused).

procedure join_request_invite_2(Formed(AppName)?, Formed(Friend)?, Formed(Request)).
join_request_invite_2(formed(X1), formed(X2), formed(invite(X1?, X2?))).
join_request_invite_2(refused, _, refused).
join_request_invite_2(_, refused, refused).

procedure join_request_connect_1(Formed(Friend)?, Formed(Request)).
join_request_connect_1(formed(X1), formed(connect(X1?))).
join_request_connect_1(refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(trust(R1), F?) :- form_string(R1?, F1), join_request_trust_1(F1?, F).
form_request(install(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_request_install_2(F1?, F2?, F).
form_request(invite(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_request_invite_2(F1?, F2?, F).
form_request(connect(R1), F?) :- form_string(R1?, F1), join_request_connect_1(F1?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs?, Inputs, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input?, Inputs?, Inputs, Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

