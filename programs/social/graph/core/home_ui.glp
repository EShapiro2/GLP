%% home_ui.glp --- the super-app with a LIVE person.
%%
%% superapp(Id, Answers, NetIn) is the super-app (GSG paper, Section 5.1), the
%% one goal the runtime posts, with the person's public key, the stream of the
%% person's acts and the stream from the network, and nothing else: it runs
%% agent/4, with the super-app's own person interface (home/8) and its
%% mediator (med/4) between the person and the agent, and sends the two
%% streams of the outputs list to the person by send_to_user/1 and to the
%% network by send_to_net/1.  The person is sent, as by superapp_ui/3 below,
%% what the agent tells her and the mediator's cards.
%%
%% superapp_ui(alice, Answers, NetIn) is the same super-app as a play: the
%% harness the Flutter agent runtime starts, as
%% programs/currencies/coins/play_ui.glp is the currency's.  It has the three
%% arguments that runtime expects (Id, UserIn, NetIn): alice's answers arrive
%% on the second, injected
%% as ground terms by her taps on the constructs of home.vglp, and what her
%% super-app shows her --- the mediator's cards and their closing, and what the
%% super-app tells her --- leaves by send_to_user/1, one term to a line.  Her
%% screen is therefore derived from the display declarations of home.vglp and
%% from nothing else.
%%
%% Behind the screen is the real super-app: her commands go to agent/5, which
%% installs, invites and befriends as it does in every play.  Bob is scripted
%% and shares the network with her through a crossbar, so her Connect and
%% Invite have someone to reach.  The mediator's vocabulary is the compiled
%% module's own: the person's answers are typed by core's copy of it under
%% its own names (self.glp, HomeUserAnswer), and the imported declarations
%% leave the other positions untyped, since this harness only passes them
%% along.
%%
%% superapp_ui/3 is the harness of the app, not part of the super-app's
%% contract; superapp/3 is the super-app.

imported procedure home#home(_?, Key?, AgentToUserStream?, Stream(UserInMsg), _?, _?, _?, _?).
imported procedure home#med(_?, _?, _?, Integer?).
imported procedure agent#agent(Key?, UserInStream?, NetInStream?, OutputsList?).

exported procedure superapp(Key?, Stream(HomeUserAnswer)?, NetInStream?).
superapp(Id, Answers, NetIn) :-
    ground(Id?) |
    agent # agent(Id?, Cmds?, NetIn?, [user_output(Outs), net_output(NetOut)]),
    send_to_net(NetOut?),
    tee_out(Outs?, Shown, Seen),
    send_to_user(Shown?),
    home # home(ch([], Asks), Id?, Seen?, Cmds, none, none, none, none),
    home # med(ch(Answers?, Cards), ch(Asks?, _), [], 0),
    send_to_user(Cards?).

exported procedure superapp_ui(Key?, Stream(HomeUserAnswer)?, NetInStream?).
superapp_ui(alice, Answers, _) :-
    crossbar(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(alice, Cmds?, AliceNetIn?, [user_output(Outs), net_output(AliceNetOut)]),
    tee_out(Outs?, Shown, Seen),
    send_to_user(Shown?),
    home # home(ch([], Asks), alice, Seen?, Cmds, none, none, none, none),
    home # med(ch(Answers?, Cards), ch(Asks?, _), [], 0),
    send_to_user(Cards?),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_answers(BobOut?, BobIn).

%% Bob, scripted: he consents to alice's request to connect and accepts
%% whatever mini-app she invites him to, so her Connect and Invite have
%% someone to reach.
procedure bob_answers(AgentToUserStream?, UserInStream).
bob_answers([msg(agent, person, befriend(From, Resp?)) | Outs],
            [msg(person, bob, decision(yes, From?, response(Resp))),
             msg(person, bob, accept_invite(ping, From?)) | Cmds?]) :-
    ground(From?) |
    bob_answers(Outs?, Cmds).
bob_answers([_ | Outs], Cmds?) :- otherwise | bob_answers(Outs?, Cmds).
bob_answers([], []).

%% The network between the two, and the person's stream shown as well as read.
procedure crossbar(NetOutStream?, NetOutStream?, NetInStream, NetInStream).
crossbar(AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route(All?, AIn, BIn).

procedure route(NetOutStream?, NetInStream, NetInStream).
route([msg(alice, C) | Rest], [msg(alice, C?) | A?], B?) :- route(Rest?, A, B).
route([msg(bob, C) | Rest], A?, [msg(bob, C?) | B?]) :- route(Rest?, A, B).
route([], [], []).

procedure tee_out(AgentToUserStream?, AgentToUserStream, AgentToUserStream).
tee_out([X | Xs], [X? | Ys?], [X? | Zs?]) :- ground(X?) | tee_out(Xs?, Ys, Zs).
tee_out([], [], []).
