%% home_ui.glp --- the super-app with a LIVE person.
%%
%% superapp(Id, Grants, NetIn), the super-app (GSG paper, Section 5.1), is
%% defined in self.glp, the entry of the super-app's contract.
%%
%% superapp_ui(alice, Grants, NetIn) is the same super-app as a play: the
%% harness the Flutter agent runtime starts, as
%% programs/currencies/coins/play_ui.glp is the currency's.  It has the three
%% arguments that runtime expects (Id, UserIn, NetIn): alice's grants arrive
%% on the second, input(Id, P, R) as the bridge returns them from her acts on
%% the constructs of home.vglp's questions (vGLP, sections/elicitation.tex,
%% the paragraph "The implementation"), and the other half of her person
%% channel --- the constructs the dispatcher draws and withdraws, and what her
%% super-app tells her, merged with them --- leaves by send_to_user/1, one
%% term to a line, which is what the bridge reads.  Her screen is therefore
%% derived from the interactive types of home.vglp and from what the agent
%% tells her, and from nothing else.
%%
%% Behind the screen is the real super-app: her commands go to agent/4, which
%% installs, invites and befriends as it does in every play.  Bob is scripted
%% and shares the network with her through a crossbar, so her Connect and
%% Invite have someone to reach.  home/3 and its dispatcher are imported at
%% the types of home.glp's exports, as superapp/3 imports them (self.glp,
%% HomeQuestion).
%%
%% superapp_ui/3 is the harness of the app, not part of the super-app's
%% contract; superapp/3 is the super-app.

imported procedure home#home(Key?, AgentToUserStream?, Stream(UserInMsg), Stream(Ask(HomeQuestion))).
imported procedure home#dispatch(Stream(Ask(HomeQuestion))?, Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(Output))).
imported procedure agent#agent(Key?, UserInStream?, NetInStream?, OutputsList?).

exported procedure superapp_ui(Key?, PersonIn?, NetInStream?).
superapp_ui(alice, Grants, _) :-
    crossbar(AliceNetOut?, BobNetOut?, AliceNetIn, BobNetIn),
    agent # agent(alice, Cmds?, AliceNetIn?, [user_output(Outs), net_output(AliceNetOut)]),
    tee_out(Outs?, Shown, Seen),
    home # home(alice, Seen?, Cmds, Asks),
    home # dispatch(Asks?, ch(Grants?, Draws), MCh),
    show_notices(MCh?, Shown?),
    send_to_user(Draws?),
    agent # agent(bob, BobIn?, BobNetIn?, [user_output(BobOut), net_output(BobNetOut)]),
    bob_answers(BobOut?, BobIn).

%% Bob, scripted: he consents to alice's request to connect, passing the
%% pending value back as it came, and accepts whatever mini-app she invites
%% him to, so her Connect and Invite have someone to reach.
procedure bob_answers(AgentToUserStream?, UserInStream).
bob_answers([msg(agent, person, befriend(From, P)) | Outs],
            [msg(person, bob, decision(yes, From?, P?)),
             msg(person, bob, accept_invite(ping, From?)) | Cmds?]) :-
    ground(From?) |
    bob_answers(Outs?, Cmds).
bob_answers([_ | Outs], Cmds?) :- otherwise | bob_answers(Outs?, Cmds).
bob_answers([], []).

%% The network between the two.  The person's stream is shown as well as read
%% by tee_out/3, and sent onto the person channel by show_notices/2, both
%% self.glp's.
procedure crossbar(NetOutStream?, NetOutStream?, NetInStream, NetInStream).
crossbar(AOut, BOut, AIn?, BIn?) :-
    merge(AOut?, BOut?, All),
    route(All?, AIn, BIn).

procedure route(NetOutStream?, NetInStream, NetInStream).
route([msg(alice, C) | Rest], [msg(alice, C?) | A?], B?) :- route(Rest?, A, B).
route([msg(bob, C) | Rest], A?, [msg(bob, C?) | B?]) :- route(Rest?, A, B).
route([], [], []).
