%% ---------------------------------------------------------------------------
%% contract.glp --- the grassroots social network's contract, GSG's (a
%% contract is its platform's paper's; Coordination Appendix C), as Jurix
%% prints it (Section 3.3, the table there, which Section 7 certifies by
%% hand), in the term form programs/jurix reads (its README, "Writing a
%% contract").  The one copy: Jurix's checker (programs/jurix/test_jurix.sh)
%% and vGLP's compiler to the canonical CVA platform
%% (programs/vglp/cva/compile.sh) read it from here, contract_named/2
%% printing the term.  Each schema is in Jurix's notation above its term,
%% at each role in turn: what the role requires, what it forbids (not), what
%% it adds (+) and what it deletes (-); a role marked ? is a guarding role.
%%
%% A role is rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i),
%% and is named by its index, role(1) the schema's first role; a and f are
%% party variables, pvar, and x a speech-act variable, svar.
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Schema    ::= schema(Constant, RoleSpecs) ; cschema(Constant, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(social_graph, C): the contract.
procedure contract_named(Constant?, Declared).
contract_named(social_graph,
%%   befriend(p?, q?) :
%%       at p:  not friend(q), +friend(q)
%%       at q:  not friend(p), +friend(p)
   [schema(befriend,
       [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
%%   unfriend(p?, q) :
%%       at p:  -friend(q)
%%       at q:  -friend(p)
    schema(unfriend,
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
%%   sign(p? ; x) :
%%       at p:  +item(x, p, p)
    schema(sign,
       [rs(guarded, [atom(item, [svar(x), role(1), role(1)])], [], [], [])]),
%%   forward(p?, q ; x, a, f) :
%%       at p:  item(x, a, f), +sent(x, q)
%%       at q:  friend(p), +item(x, a, p)
    schema(forward,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(a), pvar(f)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(a), role(1)])], [],
                      [atom(friend, [role(1)])], [])])]).
