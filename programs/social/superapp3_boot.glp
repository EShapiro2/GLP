%% superapp3_boot.glp --- the warm call on three smartphones (SGSG paper,
%% Section 5.2, "Encounters among participants of the same mini-app"): under
%% the boot harness, alice, bob and carol, each with its own key pair, running
%% the social graph of graph/core as its super-app and the test mini-app read
%% from pingapp.glpw beside it.  carol befriends both; alice and bob, not
%% friends, come to communicate through the mini-app when carol's execution
%% forwards to bob's an end alice's execution gave it; bob's runtime holds
%% bob's assignment and reports it; the warm call befriends alice and bob by
%% carol's introduction, the handshake opens their root channel, the held end
%% is released, and alice's execution reads the value.  The persons' scripts
%% are in core/superapp_plays.glp (sg_init/4, modes warm_anchor, warm_holder and warm_friend).
%%   :artefact programs/social/graph/pingapp programs/social/graph/core
%%   :boot programs/social/superapp3_boot.glp programs/social/graph/core
%% Expected: [alice] got(hello_from_bob) after [bob] opened(alice).

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, warm_anchor, [carol, bob], ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, warm_holder, [carol, alice], ch(_?, _))@bob,
    agent(ch(_?, _), ch(_?, _))@carol,
    say(carol, warm_friend, [alice, bob], ch(_?, _))@carol.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/4, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name, its mode and the keys of the peers the person knows, its ground arguments, alice, bob and carol being the atoms that stand for the keys in a simulation (IGLP, Implementation Notes, "Boot": "An agent learns the keys of its peers from its person"; Remark "Agent Names"); by these agent/2 starts the super-app's play sg_init/4 on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network (GLP-Spec appendix-guards.tex, "Identity and signature").
BootSays ::= sg(Key, Constant, List(Key)).

exported procedure agent(Channel(Stream(BootSays), Stream(BootSays))?, Channel(NetInStream, NetOutStream)?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The super-app's play, by the name, the mode and the peers the person tells the agent.
procedure start(Stream(BootSays)?, NetInStream?).
start([sg(P, M, Qs) | _], N) :- sg_init(P?, M?, Qs?, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name, its mode and the keys of the peers it knows, and reads nothing.
exported procedure say(Key?, Constant?, List(Key)?, Channel(Stream(BootSays), Stream(BootSays))?).
say(P, M, Qs, ch(_, [sg(P?, M?, Qs?)])).
