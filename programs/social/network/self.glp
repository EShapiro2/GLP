%% self.glp — CSSN shared type vocabulary
%%
%% All protocol types for the Child-Safe Social Network application.
%% Extends CSSG types with group support (GroupId, group messaging).
%% Defined once here, visible to all modules via ancestor scoping.

-module(cssn).

%% =============================================================================
%% CORE PROTOCOL TYPES
%% =============================================================================

%% Stream(X) and Channel(In, Out) are predefined in root self.glp:
%%   Stream(X) ::= [] ; [X | Stream(X)].
%%   Channel(In, Out) ::= ch(In, Out?).

%% Group notifications shared between agent and friend content
GroupNotifyContent ::= group_invite(GroupId, Channel(Stream(GroupSetupResponse), Stream(IntroContent)))
                     ; group_invite_child(GroupId, Constant, Channel(Stream(GroupSetupResponse), Stream(IntroContent)))
                     ; group_removed(GroupId).

%% Friend-only message content (excludes shared GroupNotifyContent)
FriendOnlyContent ::= response(Response)
                    ; text(Constant)
                    ; intro(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                    ; child_intro(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                    ; group_msg(GroupId, Constant, Constant)
                    ; group_consent_req(GroupId, Decision?)
                    ; group_leave(GroupId, Constant)
                    ; leave_group(GroupId)
                    ; unfriend
                    ; unfriend_child(Constant).

%% Friend messages (after connection established)
FriendContent ::= FriendOnlyContent ; GroupNotifyContent.
%% Friend channel content — friend messages only, canonical-free.
%% Stream(FriendMsg) is therefore a subtype of Stream(NetInMsg), so merging a
%% friend channel's read end into NetIn is sound.
FriendMsg     ::= msg(Constant, Constant, FriendContent).

%% A cold-call accept conveys a SETUP channel (IntroContent), not the friend
%% channel directly; the fresh friend channel is conveyed on the setup channel
%% at commit (see befriend_commit).
Response ::= accept(Channel(Stream(IntroContent), Stream(IntroContent))) ; no.
Decision ::= yes ; no.
Handshake ::= ack(Constant) ; nack.

%% Setup channel content — the befriend handshake (ack/nack) plus the
%% fresh-friend-channel conveyance that the smaller-named side uses to select
%% the canonical friend channel.  The setup channel is consumed at commit and
%% never merged into NetIn, so it may carry the friend-channel value.
IntroContent ::= ack(Constant) ; nack
               ; friend_channel(Channel(Stream(FriendMsg), Stream(FriendMsg))).

%% Group identifier
GroupId   ::= group_id(Constant, Constant).

%% Pending values — opaque values stored by mediator, forwarded to agent
PendingValue ::= response(Response?) ; channel(Channel(Stream(IntroContent), Stream(IntroContent)))
               ; group_channel(Channel(Stream(GroupSetupResponse), Stream(IntroContent)))
               ; consent(Decision?) ; error.

%% =============================================================================
%% AGENT <-> MEDIATOR INTERFACE
%% =============================================================================

%% Content carried inside user-to-agent messages (msg('_user', Id, Content))
UserContent ::= connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; send(Constant, Constant)
              ; introduce(Constant, Constant)
              ; accept_intro(Constant, PendingValue)
              ; reject_intro(Constant, PendingValue)
              ; child_introduce(Constant, Constant, Constant)
              ; accept_child_intro(Constant, PendingValue)
              ; reject_child_intro(Constant, PendingValue)
              ; approve_child_intro(Constant, Constant, PendingValue)
              ; response(Response)
              ; create_group(Constant)
              ; invite_group(GroupId, Constant)
              ; invite_group(GroupId, Constant, Constant)
              ; accept_group(GroupId, PendingValue)
              ; reject_group(GroupId, PendingValue)
              ; approve_group(Constant, GroupId, PendingValue)
              ; send_group(GroupId, Constant)
              ; leave_group(GroupId)
              ; leave_child_group(Constant, GroupId)
              ; remove_from_group(GroupId, Constant)
              ; approve_child_group(Constant, GroupId, PendingValue)
              ; reject_child_group(Constant, GroupId, PendingValue)
              ; unfriend_child(Constant)
              ; unfriend_child_of(Constant, Constant).

%% Content carried inside agent-to-user messages (msg(agent, '_user', Content))
%% Agent-only message content (excludes shared GroupNotifyContent)
AgentOnlyContent ::= befriend(Constant, Response?)
                   ; befriend_intro(Constant, Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                   ; child_befriend(Constant, Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                   ; connected(Constant)
                   ; rejected
                   ; rejected(Constant)
                   ; received(Constant, Constant)
                   ; group_joined(GroupId)
                   ; group_joined_member(GroupId, Constant)
                   ; group_left(GroupId)
                   ; group_received(GroupId, Constant, Constant)
                   ; child_group_consent(Constant, GroupId, Decision?)
                   ; unfriended(Constant).

%% Content carried inside agent-to-user messages (msg(agent, '_user', Content))
AgentContent ::= AgentOnlyContent ; GroupNotifyContent.

%% Precise message types for agent <-> mediator channel
AgentToUserMsg        ::= msg(Constant, Constant, AgentContent).
MediatorToAgentMsg    ::= msg(Constant, Constant, UserContent).

%% =============================================================================
%% AGENT INPUT TYPES
%% =============================================================================

%% Network content (2-arg cold-call: msg(Dest, Content))
NetColdCall ::= intro(Constant, Response?).

%% Network input message (cold calls + friend messages)
NetInMsg    ::= msg(Constant, NetColdCall)
              ; msg(Constant, Constant, FriendContent).

%% Transport union carried by the simulated network switches (network3/network2).
%% Producers write the narrower NetOutStream; NetOutStream ⊆ NetInStream is sound.
NetInStream ::= [] ; [NetInMsg | NetInStream].

%% Intro result — written by intro_await_peer, injected into UserIn
IntroResult ::= intro_result(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
              ; intro_rejected(Constant).

%% Group join result — written by group_await_join, injected into UserIn
GroupJoinResult ::= group_join_ack(GroupId, Constant, Channel(Stream(IntroContent), Stream(GroupSetupResponse)))
                  ; group_join_nack(GroupId, Constant).

%% Agent input message (user messages + injected intro results + group results)
UserInMsg ::= msg(Constant, Constant, UserContent)
            ; intro_result(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
            ; intro_rejected(Constant)
            ; group_join_ack(GroupId, Constant, Channel(Stream(IntroContent), Stream(GroupSetupResponse)))
            ; group_join_nack(GroupId, Constant).

%% =============================================================================
%% AGENT OUTPUT TYPES
%% =============================================================================

%% Group channel message content
GroupContent ::= group_msg(GroupId, Constant, Constant)
               ; group_leave(GroupId, Constant)
               ; group_removed(GroupId).
GroupMsg     ::= msg(Constant, Constant, GroupContent).

%% Group invite setup protocol (asymmetric channel)
%% Creator→Invitee stream carries the group channel after handshake
GroupSetupResponse ::= group_channel(Channel(Stream(GroupMsg), Stream(GroupMsg))).

%% Network output stream — cold calls the agent emits on its net entry.
NetOutMsg    ::= msg(Constant, NetColdCall).
NetOutStream ::= [] ; [NetOutMsg | NetOutStream].

%% Output list — one constructor per output kind, each carrying its own stream
%% type.  Replaces the former output(OutputKey, Stream(OutputMsg)?) whose union
%% OutputMsg typed every entry at the join of all kinds and so broke duality
%% against narrower readers (mediator AgentToUserMsg, peer NetInStream).
%% group_entry keeps an OutputKey: group routing is genuinely keyed (dynamic
%% groups and members) and its GroupMsg stream is already precise.
OutputKey   ::= group(GroupId) ; group_member(GroupId, Constant).
OutputEntry ::= user_output(Stream(AgentToUserMsg)?)
              ; net_output(NetOutStream?)
              ; friend_output(Constant, Stream(FriendMsg)?)
              ; child_output(Constant, Stream(FriendMsg)?)
              ; parent_output(Constant, Stream(FriendMsg)?)
              ; group_entry(OutputKey, Stream(GroupMsg)?).
OutputsList ::= [] ; [OutputEntry|OutputsList].

%% =============================================================================
%% MEDIATOR <-> USER (UI) INTERFACE
%% =============================================================================

ReqId ::= req(Constant).

%% User -> Mediator commands
UserCmd ::= decision(Decision, Constant, ReqId)
          ; accept_intro(Constant, ReqId)
          ; reject_intro(Constant, ReqId)
          ; accept_child_intro(Constant, ReqId)
          ; reject_child_intro(Constant, ReqId)
          ; approve_child_intro(Constant, Constant, ReqId)
          ; child_introduce(Constant, Constant, Constant)
          ; connect(Constant)
          ; send(Constant, Constant)
          ; introduce(Constant, Constant)
          ; create_group(Constant)
          ; invite_group(GroupId, Constant)
          ; invite_group(GroupId, Constant, Constant)
          ; accept_group(GroupId, ReqId)
          ; reject_group(GroupId, ReqId)
          ; approve_group(Constant, GroupId, ReqId)
          ; send_group(GroupId, Constant)
          ; leave_group(GroupId)
          ; leave_child_group(Constant, GroupId)
          ; remove_from_group(GroupId, Constant)
          ; approve_child_group(Constant, GroupId, ReqId)
          ; reject_child_group(Constant, GroupId, ReqId)
          ; unfriend_child(Constant)
          ; unfriend_child_of(Constant, Constant).

%% Mediator -> User notifications
UserNotify ::= befriend(Constant, ReqId)
             ; befriend_intro(Constant, Constant, ReqId)
             ; child_befriend(Constant, Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; received(Constant, Constant)
             ; group_invite(GroupId, ReqId)
             ; group_invite_child(GroupId, Constant, ReqId)
             ; group_joined(GroupId)
             ; group_joined_member(GroupId, Constant)
             ; group_left(GroupId)
             ; group_removed(GroupId)
             ; group_received(GroupId, Constant, Constant)
             ; child_group_consent(Constant, GroupId, ReqId)
             ; unfriended(Constant).


%% =============================================================================
%% MEDIATOR PENDING LIST
%% =============================================================================

PendingEntry ::= pending(ReqId, PendingValue).

%% =============================================================================
%% NARRATIVE TYPES (for village scenario actors)
%% =============================================================================

NarrativeItem   ::= friend(Constant)
                  ; say(Constant)
                  ; act(Constant)
                  ; event(Constant).

%% =============================================================================
%% SHARED HELPER PROCEDURES
%% =============================================================================
%% Defined here, visible to all sibling modules via ancestor scoping.
%% The linker resolves calls in agent.glp/child_agent.glp to these procedures.
%%
%% Note: bind_response, handle_response, await_group_channel remain in each
%% module because they call agent/child_agent (recursive tail calls).

%% =============================================================================
%% MERGE
%% =============================================================================

%% merge/3 is now defined once in the root programs/self.glp (A3 amendment).

%% =============================================================================
%% SETUP_GROUP_HUB_SIDE
%% =============================================================================

procedure setup_group_hub_side(GroupId?, Constant?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg), Channel(Stream(GroupMsg), Stream(GroupMsg))).
setup_group_hub_side(GroupId, Member, Outs, Outs1?, NetIn, NetIn1?,
    ch(HubToMember?, MemberToHub)) :-
    ground(GroupId?), ground(Member?) |
    add_group_output(group_member(GroupId?, Member?), HubToMember, Outs?, Outs1),
    merge(NetIn?, MemberToHub?, NetIn1).

%% =============================================================================
%% SETUP_GROUP_CREATOR
%% =============================================================================

procedure setup_group_creator(GroupId?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
setup_group_creator(GroupId, Outs, Outs1?, NetIn, NetIn1?) :-
    ground(GroupId?) |
    add_group_output(group(GroupId?), MemberToHub, Outs?, Outs1),
    merge(NetIn?, MemberToHub?, NetIn1).

%% Per-kind output routers send_user/send_net/send_friend/send_child/send_parent
%% are now provided by lib/routing/, exposed from the root self.glp (A5 Stage B);
%% resolved here unqualified.

%% =============================================================================
%% LOOKUP_SEND_GROUP
%% =============================================================================

procedure lookup_send_group(OutputKey?, GroupMsg?, Stream(OutputEntry)?, Stream(OutputEntry)).
lookup_send_group(Key, Msg, Outs, Outs1?) :-
    ground(Key?) |
    lookup_send_group_step(Key?, Msg?, Outs?, Outs1).

procedure lookup_send_group_step(OutputKey?, GroupMsg?, Stream(OutputEntry)?, Stream(OutputEntry)).
lookup_send_group_step(Key, Msg, [group_entry(K, [Msg?|Out1?])|Rest], [group_entry(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_group_step(Key, Msg, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    lookup_send_group_step(Key?, Msg?, Rest?, Rest1).
lookup_send_group_step(_, _, [], []).

%% =============================================================================
%% DISTRIBUTE_GROUP_MSG
%% =============================================================================

procedure distribute_group_msg(GroupId?, GroupMsg?, Stream(OutputEntry)?, Stream(OutputEntry)).
distribute_group_msg(GroupId, Msg,
    [group_entry(group_member(GId, M), [Msg?|Out1?])|Rest],
    [group_entry(group_member(GId?, M?), Out1)|Rest1?]) :-
    GroupId? =?= GId?, ground(Msg?) |
    distribute_group_msg(GroupId?, Msg?, Rest?, Rest1).
distribute_group_msg(GroupId, Msg, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    distribute_group_msg(GroupId?, Msg?, Rest?, Rest1).
distribute_group_msg(_, _, [], []).

%% inject_msg and add_friend_output are now provided by lib/routing/, exposed
%% from the root self.glp (A5 Stage B); resolved here unqualified.

%% =============================================================================
%% ADD_GROUP_OUTPUT / CLOSE_OUTPUTS
%% =============================================================================

procedure add_group_output(OutputKey?, Stream(GroupMsg), Stream(OutputEntry)?, Stream(OutputEntry)).
add_group_output(Key, Out?, Outs, [group_entry(Key?, Out)|Outs?]).

procedure close_outputs(Stream(OutputEntry)?).
close_outputs([user_output([])|Outs]) :- close_outputs(Outs?).
close_outputs([net_output([])|Outs]) :- close_outputs(Outs?).
close_outputs([friend_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([child_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([parent_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([group_entry(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([]).

%% intro_await_peer and inject_intro_result are now provided by lib/routing/,
%% exposed from the root self.glp (A5 Stage B); resolved here unqualified.

%% =============================================================================
%% GROUP_AWAIT_JOIN
%% =============================================================================

procedure group_await_join(GroupId?, Constant?, Channel(Stream(IntroContent), Stream(GroupSetupResponse))?, GroupJoinResult).

group_await_join(GroupId, Invitee, ch([ack(_)|ChIn], ChOut?),
                 group_join_ack(GroupId?, Invitee?, ch(ChIn?, ChOut))).

group_await_join(GroupId, Invitee, ch([nack|_], []),
                 group_join_nack(GroupId?, Invitee?)).

%% =============================================================================
%% INJECT_GROUP_RESULT
%% =============================================================================

procedure inject_group_result(GroupJoinResult?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_group_result(group_join_ack(G, I, Ch), Ys,
    [group_join_ack(G?, I?, Ch?)|Ys?]) :-
    ground(I?) | true.
inject_group_result(group_join_nack(G, I), Ys,
    [group_join_nack(G?, I?)|Ys?]) :-
    ground(I?) | true.
inject_group_result(Res, [Y|Ys], [Y?|Ys1?]) :-
    inject_group_result(Res?, Ys?, Ys1).

%% =============================================================================
%% CLOSE_OUTPUT — close a stream and remove its entry from the outputs list
%% =============================================================================

%% close_output removes a group_entry by its (group / group_member) key.
procedure close_output(OutputKey?, Stream(OutputEntry)?, Stream(OutputEntry)).
close_output(_, [], []).
close_output(Key, [group_entry(K, [])|Rest], Rest?) :-
    Key? =?= K? | true.
close_output(Key, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    close_output(Key?, Rest?, Rest1).

%% close_friend removes a friend_output by friend id.
procedure close_friend(Constant?, Stream(OutputEntry)?, Stream(OutputEntry)).
close_friend(_, [], []).
close_friend(Name, [friend_output(K, [])|Rest], Rest?) :-
    Name? =?= K? | true.
close_friend(Name, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    close_friend(Name?, Rest?, Rest1).

%% =============================================================================
%% IDEMPOTENT BEFRIEND COMMIT WITH SMALLER-NAME TIE-BREAK
%% =============================================================================
%% Enforces the not-yet-friends precondition (Definition 1 / Definition 3 in
%% CSSN paper) at commit time: add_output(friend(...)) is realized as set union,
%% and concurrent bilateral offers converge to a single channel via lex order
%% on the two befriended people's ids.
%%
%% See docs/cssn-glp-implementation-spec.md §"Idempotent Befriend Commit with
%% Smaller-Name Tie-Break".

%% Walk Outs threading it through, binding Decision to yes if friend(Other) is
%% already present, no otherwise.
procedure already_friend(Constant?, Stream(OutputEntry)?, Stream(OutputEntry), Decision).
already_friend(Other, [friend_output(O, Out?)|Rest], [friend_output(O?, Out)|Rest?], yes) :-
    Other? =?= O? | true.
already_friend(Other, [E|Rest], [E?|Rest1?], Decision?) :-
    otherwise | already_friend(Other?, Rest?, Rest1, Decision).
already_friend(_, [], [], no).

%% Top-level befriend commit dispatch.  The channel is the SETUP channel
%% (IntroContent); the fresh friend channel is allocated inside the commit and
%% conveyed on the setup channel.  Called from the cold-call response handler
%% and the intro_result handlers (adult and child).
procedure befriend_commit(Constant?, Constant?, Channel(Stream(IntroContent), Stream(IntroContent))?,
                          Stream(OutputEntry)?, Stream(OutputEntry),
                          Stream(NetInMsg)?, Stream(NetInMsg)).

%% Smaller-name side: I decide.  Test already_friend then dispatch.
befriend_commit(Id, Other, Ch, Outs, Outs1?, NetIn, NetIn1?) :-
    Id? @< Other? |
    already_friend(Other?, Outs?, Outs2, Decision),
    smaller_dispatch(Decision?, Other?, Ch?, Outs2?, Outs1, NetIn?, NetIn1).

%% Larger-name side: I adopt the friend channel the smaller-name side conveys.
befriend_commit(_, Other, Ch, Outs, Outs1?, NetIn, NetIn1?) :-
    otherwise |
    await_friend_channel(Other?, Ch?, Outs?, Outs1, NetIn?, NetIn1).

%% Smaller-name dispatch on whether friend(Other) is already present.
procedure smaller_dispatch(Decision?, Constant?, Channel(Stream(IntroContent), Stream(IntroContent))?,
                           Stream(OutputEntry)?, Stream(OutputEntry),
                           Stream(NetInMsg)?, Stream(NetInMsg)).

%% Already friend: suppress.  Close the setup write end to []; the larger-name
%% side reads [] and drops.  Allocate no friend channel, merge nothing.
smaller_dispatch(yes, _, ch(_, []), Outs, Outs?, NetIn, NetIn?).

%% Not yet friend: allocate a fresh friend channel; convey its peer end on the
%% setup write end (this conveyance is the smaller-name marker); install the
%% local end (add_friend_output) and merge its read side into NetIn.
smaller_dispatch(no, Other, ch(_, [friend_channel(PeerEnd?)|[]]), Outs, Outs2?, NetIn, NetIn1?) :-
    ground(Other?), new_channel(PeerEnd, ch(FIn, FOut?)) |
    add_friend_output(Other?, FOut, Outs?, Outs1),
    send_user(msg(agent, '_user', connected(Other?)), Outs1?, Outs2),
    merge(NetIn?, FIn?, NetIn1).

%% Larger-name side: read the setup channel's read end.
procedure await_friend_channel(Constant?, Channel(Stream(IntroContent), Stream(IntroContent))?,
                          Stream(OutputEntry)?, Stream(OutputEntry),
                          Stream(NetInMsg)?, Stream(NetInMsg)).

%% Friend channel conveyed: adopt it — install its write end and merge its read
%% side into NetIn.  close_friend handles the rare case where an earlier adoption
%% for a different channel already installed friend(Other); a no-op if absent.
await_friend_channel(Other, ch([friend_channel(ch(FIn, FOut?))|_], []), Outs, Outs3?, NetIn, NetIn1?) :-
    ground(Other?) |
    close_friend(Other?, Outs?, Outs1),
    add_friend_output(Other?, FOut, Outs1?, Outs2),
    send_user(msg(agent, '_user', connected(Other?)), Outs2?, Outs3),
    merge(NetIn?, FIn?, NetIn1).

%% Setup closed ([]): smaller-name side suppressed this offer.  Drop it.
await_friend_channel(_, ch([], []), Outs, Outs?, NetIn, NetIn?).
