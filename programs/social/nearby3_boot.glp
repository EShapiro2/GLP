%% nearby3_boot.glp --- a third smartphone comes to know one of two friends by a physical encounter, befriends him, and is introduced by him to the other (GSA paper, Section 4, the box GPE and "Introductions via a mutual friend"; GKK:3): under the boot harness, one isolate per person, each running the social graph of graph/core with the operating system's Nearby around it (graph/core/place.glp, os_phone/6).  alice and bob know each other at the start, and alice befriends bob (GSG:1); alice never opens the place.  bob and carol open it (GPE:1), so the two come to know each other by the encounter (GPE:2), each operating system giving its person's consent, asking nothing; carol's encounter put to alice is refused, alice's place being closed.  carol befriends bob, the first person nearby she knows, and closes the place; bob, friends with alice and with carol, introduces carol to alice, the two consent on their cards, and they are friends.  The program is graph/core, named as :boot's second argument:
%%   :boot programs/social/nearby3_boot.glp programs/social/graph/core
%% Expected on the persons' screens: [alice] nearby([bob]), [alice] connected(bob), [alice] befriend_intro(bob, carol), [alice] connected(carol), [alice] nearby([bob, carol]); [bob] nearby([alice]), [bob] befriend(alice), [bob] connected(alice), [bob] nearby([alice, carol]), [bob] befriend(carol), [bob] connected(carol); [carol] nearby([bob]), [carol] connected(bob), [carol] befriend_intro(bob, alice), [carol] connected(alice), [carol] nearby([alice, bob]).

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, befriend_known, [bob], ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, encounter_introduce, [alice], ch(_?, _))@bob,
    agent(ch(_?, _), ch(_?, _))@carol,
    say(carol, encounter_befriend, [], ch(_?, _))@carol.

%% The person scripted at each agent tells it the entry, sg_init/4, with its own key, its mode and the keys of the persons it knows (IGLP, Implementation Notes, "Boot"; Remark "Agent Names"), and reads nothing.
SayAct ::= sg_init(Key, Constant, List(Key)).
SayIn  ::= [SayAct | SayEnd].
SayEnd ::= [].

exported procedure say(Key?, Constant?, List(Key)?, Channel(Stream(Constant), SayIn)?).
say(P, M, Qs, ch(_, [sg_init(P?, M?, Qs?)])).
