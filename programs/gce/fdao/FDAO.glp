        rs(unguarded, [atom(bond, [role(2), num(d)])], [atom(bond, [pvar(r), num(d1)])], [atom(identity, []), atom(date, [num(t)])], [])]),
    schema(deposit_c, ['Alice', 'Carol'], [pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
    schema(deposit_b, ['Alice', 'Carol'], [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
    schema(release_c, ['Carol', 'Bob'], [pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
    schema(release_b, ['Carol', 'Bob'], [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
    schema(return_c, ['Carol', 'Alice'], [pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
    schema(return_b, ['Carol', 'Alice'], [pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% FDAO:1, Funding: Bob gives k coins of u to the DAO, kept by its steward Alice.
    schema(fund, ['Bob', 'Alice'], [pvar(u), num(k), svar(n)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(member, [nterm(ext(own(2), n))])], []),
        rs(unguarded, [times(num(k), atom(dao_coin, [pvar(u), svar(n)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(member, [nterm(ext(own(2), n))]), atom(listed, [role(2), svar(n)]), atom(listed, [role(1), svar(n)])], [])]),
%% FDAO:1, the steward gives coins of its own.
    schema(fund_own, ['Alice'], [pvar(u), num(k), svar(n)],
       [rs(guarded, [times(num(k), atom(dao_coin, [pvar(u), svar(n)]))], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(listed, [role(1), svar(n)])], [])]),
%% FDAO:2, Granting: the steward pays the proposer of a passed proposal, once.
    schema(grant, ['Alice', 'Bob'], [svar(x), pvar(u), num(k), svar(n)],
       [rs(guarded, [atom(granted, [svar(x), role(2), svar(n)])], [times(num(k), atom(dao_coin, [pvar(u), svar(n)]))], [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(listed, [role(1), svar(n)]), atom(passed_proposal, [svar(x), role(2), nterm(ext(own(1), n))])], [atom(granted, [svar(x), role(2), svar(n)])]),
        rs(unguarded, [times(num(k), atom(coin, [pvar(u)])), atom(knows, [pvar(u)])], [], [atom(identity, [])], [])]),
%% FDAO:2, a grant to a passed proposal of the steward's own.
    schema(grant_own, ['Alice'], [svar(x), pvar(u), num(k), svar(n)],
       [rs(guarded, [atom(granted, [svar(x), role(1), svar(n)]), times(num(k), atom(coin, [pvar(u)]))], [times(num(k), atom(dao_coin, [pvar(u), svar(n)]))], [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(listed, [role(1), svar(n)]), atom(passed_proposal, [svar(x), role(1), nterm(ext(own(1), n))])], [atom(granted, [svar(x), role(1), svar(n)])])])])).
