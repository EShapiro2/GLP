 sas(start, ['Alice', 'Bob'], ['Game', 'Board'], [atom(started, ['Alice', const('Game')]), atom(started, ['Bob', const('Game')]), atom(at, ['Alice', const('Game'), 'Bob', const('Board')]), atom(at, ['Bob', const('Game'), 'Alice', const('Board')]), atom(color, ['Alice', const('Game'), num(1)]), atom(color, ['Bob', const('Game'), num(2)])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(started, ['Alice', const('Game')])), not(atom(started, ['Bob', const('Game')]))], eq(const('Board'), fn(first, [])), ['Alice', 'Bob']),
 sas(move, ['Alice', 'Bob'], ['Game', 'Board', 'Next', 'Move', 'Side'], [not(atom(at, ['Alice', const('Game'), 'Bob', const('Board')])), not(atom(at, ['Bob', const('Game'), 'Alice', const('Board')])), atom(at, ['Alice', const('Game'), 'Bob', const('Next')]), atom(at, ['Bob', const('Game'), 'Alice', const('Next')]), atom(made, ['Alice', const('Game'), const('Move'), const('Board')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(at, ['Alice', const('Game'), 'Bob', const('Board')]), atom(at, ['Bob', const('Game'), 'Alice', const('Board')]), atom(color, ['Alice', const('Game'), num('Side')])], and(eq(num('Side'), fn(side, [const('Board')])), and(eq(num(1), fn(legal, [const('Move'), const('Board')])), eq(const('Next'), fn(after, [const('Move'), const('Board')])))), ['Alice']),
 sas(win, ['Alice', 'Bob'], ['Game', 'Board', 'Side'], [not(atom(at, ['Alice', const('Game'), 'Bob', const('Board')])), not(atom(at, ['Bob', const('Game'), 'Alice', const('Board')])), atom(won, ['Alice', const('Game'), 'Bob'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(at, ['Alice', const('Game'), 'Bob', const('Board')]), atom(at, ['Bob', const('Game'), 'Alice', const('Board')]), atom(color, ['Bob', const('Game'), num('Side')])], and(eq(num('Side'), fn(side, [const('Board')])), eq(num(1), fn(mate, [const('Board')]))), ['Alice']),
 sas(resign, ['Alice', 'Bob'], ['Game', 'Board'], [not(atom(at, ['Alice', const('Game'), 'Bob', const('Board')])), not(atom(at, ['Bob', const('Game'), 'Alice', const('Board')])), atom(won, ['Bob', const('Game'), 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(at, ['Alice', const('Game'), 'Bob', const('Board')]), atom(at, ['Bob', const('Game'), 'Alice', const('Board')])], true, ['Alice']),
 sas(draw, ['Alice', 'Bob'], ['Game', 'Board'], [not(atom(at, ['Alice', const('Game'), 'Bob', const('Board')])), not(atom(at, ['Bob', const('Game'), 'Alice', const('Board')])), atom(drawn, ['Alice', const('Game'), 'Bob']), atom(drawn, ['Bob', const('Game'), 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(at, ['Alice', const('Game'), 'Bob', const('Board')]), atom(at, ['Bob', const('Game'), 'Alice', const('Board')])], true, ['Alice', 'Bob'])])).
