%% STAY.glp --- printed by adopt.py from STAY.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit STAY.txt and run adopt.py STAY.
% contract_named(stay, C): the contract, STAY.
procedure contract_named(Constant?, SDeclared).
contract_named(stay, environment([today, hosts], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(issue, ['Alice'], ['Sum'], [times(num('Sum'), atom(coin, ['Alice', 'Alice']))], [atom(identity, ['Alice'])], true, ['Alice']),
 sas(swap, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Sum', 'Dave', 'Total'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol']))), times(num('Sum'), atom(coin, ['Bob', 'Carol'])), not(times(num('Total'), atom(coin, ['Bob', 'Dave']))), times(num('Total'), atom(coin, ['Alice', 'Dave'])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(coin, ['Alice', 'Carol'])), times(num('Total'), atom(coin, ['Bob', 'Dave']))], true, ['Alice', 'Bob']),
 sas(pay, ['Alice', 'Bob'], ['Sum'], [not(times(num('Sum'), atom(coin, ['Alice', 'Bob']))), times(num('Sum'), atom(coin, ['Bob', 'Bob']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Bob']))], true, ['Alice']),
 sas(redeem, ['Alice', 'Bob', 'Carol'], ['Carol'], [not(atom(coin, ['Alice', 'Bob'])), atom(coin, ['Bob', 'Bob']), not(atom(coin, ['Bob', 'Carol'])), atom(coin, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(coin, ['Alice', 'Bob']), atom(coin, ['Bob', 'Carol'])], true, ['Alice']),
 sas(list_place, ['Alice'], ['Place'], [atom(listed, ['Alice', 'Place'])], [atom(identity, ['Alice']), atom(hosts, ['Alice']), not(atom(listed, ['Alice', 'Place']))], true, ['Alice']),
 sas(book, ['Bob', 'Alice'], ['Place', 'Night', 'Sum', 'Today'], [atom(stay, ['Bob', 'Alice', 'Place', num('Night'), num('Sum')]), atom(booked, ['Alice', 'Place', num('Night')]), not(times(num('Sum'), atom(coin, ['Bob', 'Alice']))), times(num('Sum'), atom(coin, ['Alice', 'Alice']))], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Bob', 'Alice']), atom(listed, ['Alice', 'Place']), atom(today, ['Bob', num('Today')]), not(atom(booked, ['Alice', 'Place', num('Night')])), times(num('Sum'), atom(coin, ['Bob', 'Alice']))], gt(num('Night'), num('Today')), ['Bob', 'Alice']),
 sas(cancel, ['Bob', 'Alice'], ['Place', 'Night', 'Sum', 'Today'], [not(atom(stay, ['Bob', 'Alice', 'Place', num('Night'), num('Sum')])), not(atom(booked, ['Alice', 'Place', num('Night')])), not(times(num('Sum'), atom(coin, ['Alice', 'Alice']))), times(num('Sum'), atom(coin, ['Bob', 'Alice']))], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(today, ['Alice', num('Today')]), atom(stay, ['Bob', 'Alice', 'Place', num('Night'), num('Sum')]), atom(booked, ['Alice', 'Place', num('Night')]), times(num('Sum'), atom(coin, ['Alice', 'Alice']))], gt(num('Night'), num('Today')), ['Alice']),
 sas(review, ['Alice', 'Bob'], ['Place', 'Night', 'Sum', 'Today'], [atom(review, ['Alice', 'Bob', 'Place', num('Night')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(stay, ['Bob', 'Alice', 'Place', num('Night'), num('Sum')]), atom(today, ['Bob', num('Today')]), not(atom(review, ['Alice', 'Bob', 'Place', num('Night')]))], le(num('Night'), num('Today')), ['Bob'])]))).
