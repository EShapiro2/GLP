agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, none, S3, S4, S5, S6, S7) :- ground(Id?) | send(ask(agent_2, ctx_agent_2, esc_agent_2(R), Id1, no_deadline), Med?, Med1), agent(Med1?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, S1?, ask(R?, Id1?), S3?, S4?, S5?, S6?, S7?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, ask(then(xs_agent_3(Q, F, D, K)), _), S4, S5, S6, S7) :- ground(Id?), ground(Q?), ground(F?), integer(D?), integer(K?), (K? >= 1) | abort(S1?, Med?, M1), abort(S2?, M1?, M2), abort(S4?, M2?, M3), abort(S5?, M3?, M4), abort(S6?, M4?, M5), abort(S7?, M5?, Med1), select_bonds(Q?, F?, D?, K?, Holdings?, Status, Give, Rest), do_pay(Med1?, Status?, Id?, Q?, D?, K?, Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Ws?, Serial?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, none, S4, S5, S6, S7) :- ground(Id?) | send(ask(agent_3, ctx_agent_3, esc_agent_3(R), Id1, no_deadline), Med?, Med1), agent(Med1?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, S1?, S2?, ask(R?, Id1?), S4?, S5?, S6?, S7?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, ask(then(xs_agent_4(Q, F, D, R, D1)), _), S5, S6, S7) :- ground(Id?), ground(Q?), ground(F?), integer(D?), ground(R?), integer(D1?) | abort(S1?, Med?, M1), abort(S2?, M1?, M2), abort(S3?, M2?, M3), abort(S5?, M3?, M4), abort(S6?, M4?, M5), abort(S7?, M5?, Med1), take_bond(Q?, F?, D?, Holdings?, Found, Rest), do_redeem(Med1?, Found?, Id?, Q?, R?, D1?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Ws?, Serial?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, none, S5, S6, S7) :- ground(Id?) | send(ask(agent_4, ctx_agent_4, esc_agent_4(R1), Id1, no_deadline), Med?, Med1), agent(Med1?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, S1?, S2?, S3?, ask(R1?, Id1?), S5?, S6?, S7?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, S4, ask(then(xs_agent_5(E, F, U, D, K)), _), S6, S7) :- ground(Id?), ground(E?), ground(F?), ground(U?), integer(D?), integer(K?), (K? >= 1) | abort(S1?, Med?, M1), abort(S2?, M1?, M2), abort(S3?, M2?, M3), abort(S4?, M3?, M4), abort(S6?, M4?, M5), abort(S7?, M5?, Med1), select_bonds(U?, F?, D?, K?, Holdings?, Status, Give, Rest), propose_transfer(Med1?, Status?, deposit, Id?, E?, lot(U?, F?, D?, K?), Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Ws?, Serial?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, S4, none, S6, S7) :- ground(Id?) | send(ask(agent_5, ctx_agent_5, esc_agent_5(R), Id1, no_deadline), Med?, Med1), agent(Med1?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, S1?, S2?, S3?, S4?, ask(R?, Id1?), S6?, S7?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, S4, S5, ask(then(xs_agent_6(Q, F, U, D, K)), _), S7) :- ground(Id?), ground(Q?), ground(F?), ground(U?), integer(D?), integer(K?), (K? >= 1) | abort(S1?, Med?, M1), abort(S2?, M1?, M2), abort(S3?, M2?, M3), abort(S4?, M3?, M4), abort(S5?, M4?, M5), abort(S7?, M5?, Med1), select_bonds(U?, F?, D?, K?, Holdings?, Status, Give, Rest), propose_transfer(Med1?, Status?, release, Id?, Q?, lot(U?, F?, D?, K?), Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Ws?, Serial?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, S4, S5, none, S7) :- ground(Id?) | send(ask(agent_6, ctx_agent_6, esc_agent_6(R), Id1, no_deadline), Med?, Med1), agent(Med1?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, S1?, S2?, S3?, S4?, S5?, ask(R?, Id1?), S7?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, S4, S5, S6, ask(then(xs_agent_7(P, F, U, D, K)), _)) :- ground(Id?), ground(P?), ground(F?), ground(U?), integer(D?), integer(K?), (K? >= 1) | abort(S1?, Med?, M1), abort(S2?, M1?, M2), abort(S3?, M2?, M3), abort(S4?, M3?, M4), abort(S5?, M4?, M5), abort(S6?, M5?, Med1), select_bonds(U?, F?, D?, K?, Holdings?, Status, Give, Rest), propose_transfer(Med1?, Status?, return, Id?, P?, lot(U?, F?, D?, K?), Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Date?, Ws?, Serial?).
agent(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, S4, S5, S6, none) :- ground(Id?) | send(ask(agent_7, ctx_agent_7, esc_agent_7(R), Id1, no_deadline), Med?, Med1), agent(Med1?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, S1?, S2?, S3?, S4?, S5?, S6?, ask(R?, Id1?)).

procedure on_act(Channel(Closed, Stream(AgentMsg))?, PeerContent?, Constant?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Integer?, Stream(Warranty)?, Integer?).
on_act(Med, pay(Bonds, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Bonds?) | own_coins(Id?, Date?, Bonds?, Own), take_payment(Med?, Own?, Id?, From?, Bonds?, Date?, Resp, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Ws?, Serial?).
on_act(Med, redeem(Bond, R, D1, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Bond?), ground(R?), integer(D1?) | fulfil(Med?, Bond?, R?, D1?, Resp, Id?, From?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?).
on_act(Med, swap(Want, Offered, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Want?), ground(Offered?) | med_split(Med?, Medb, Medr), respond_swap(Medb?, offer(From?, Want?, Offered?), Resp, Ans, none, none), merge(Ans?, UserIn?, UserIn1), agent(Medr?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).
on_act(Med, transfer(Kind, Bonds, Resp?), From, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Kind?), ground(Bonds?) | med_split(Med?, Medb, Medr), respond_transfer(Medb?, offer_transfer(Kind?, From?, Bonds?), Resp, Ans, none, none), merge(Ans?, UserIn?, UserIn1), agent(Medr?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure take_payment(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Stream(Bond)?, Integer?, PayResponse, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Stream(Warranty)?, Integer?).
take_payment(Med, yes, Id, From, Bonds, Date, pay_taken(Date?), UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, Serial) :- ground(Bonds?) | append_bonds(Holdings?, Bonds?, Holdings1), count_bonds(Bonds?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?).
take_payment(Med, no, Id, From, Bonds, Date, pay_returned(Bonds?), UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, Serial) :- ground(Bonds?) | count_bonds(Bonds?, 0, K), show(refused_payment(From?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure fulfil(Channel(Closed, Stream(AgentMsg))?, Bond?, Constant?, Integer?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Integer?, Stream(Warranty)?, Integer?).
fulfil(Med, bond(I, F, M, S), R, D1, Resp?, Id, From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial) :- (I? =?= Id?), (M? =< Date?) | med_split(Med?, Medb, Medr), wanted(Medb?, R?, W), settle(Medr?, W?, bond(I?, F?, M?, S?), R?, D1?, Date?, Resp, Id?, From?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Holdings?, Ws?, Serial?).
fulfil(Med, bond(I, F, M, S), _, _, redeem_declined(bond(I?, F?, M?, S?)), Id, From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial) :- otherwise | show(refused(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure wanted(Channel(Closed, Stream(AgentMsg))?, Constant?, Wanted).
wanted(Med, fiat, in_fiat) :- true.
wanted(Med, _, in_kind) :- otherwise | true.

procedure settle(Channel(Closed, Stream(AgentMsg))?, Wanted?, Bond?, Constant?, Integer?, Integer?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Stream(Warranty)?, Integer?).
settle(Med, in_kind, bond(I, F, M, S), R, D1, Date, Resp?, Id, From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, Serial) :- take_bond(R?, F?, D1?, Holdings?, Found, Rest), give(Med?, Found?, bond(I?, F?, M?, S?), R?, D1?, Date?, Resp, Id?, From?, UserIn?, PeerIn?, Convs?, Cal?, Outs?, Rest?, Ws?, Serial?).
settle(Med, in_fiat, bond(I, F, M, S), _, _, Date, redeem_fiat(1), Id, From, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Ws, Serial) :- append_bonds(Holdings?, [bond(I?, F?, M?, S?)], Holdings1), show(fiat_paid(From?, 1), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?).

procedure give(Channel(Closed, Stream(AgentMsg))?, Found?, Bond?, Constant?, Integer?, Integer?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Stream(Warranty)?, Integer?).
give(Med, found(B), Mine, R, D1, Date, redeem_give(B?, Date?), Id, From, UserIn, PeerIn, Convs, Cal, Outs, Rest, Ws, Serial) :- append_bonds(Rest?, [Mine?], Holdings1), show(presented(From?, R?, D1?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?).
give(Med, not_found, Mine, R, D1, Date, redeem_menu(Mine?, Menu?), Id, From, UserIn, PeerIn, Convs, Cal, Outs, Rest, Ws, Serial) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?, D1?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure fill_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, SwapResponse, Stream(Bond)?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
fill_swap(Med, ok, Id, From, swap_accept(Give?), Give, Offered, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?).
fill_swap(Med, fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure propose_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Lot?, Lot?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
propose_swap(Med, ok, Id, Q, _, Want, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Q?), ground(Want?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_swap(Med?, Known?, Id?, Q?, Want?, Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, Serial?).
propose_swap(Med, fail, Id, Q, lot(U, _, D, K), _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure send_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Lot?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
send_swap(Med, yes, Id, Q, Want, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, UserIn?, UserIn1), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, Serial?).
send_swap(Med, no, Id, Q, _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure propose_transfer(Channel(Closed, Stream(AgentMsg))?, Constant?, Kind?, Constant?, Constant?, Lot?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
propose_transfer(Med, ok, Kind, Id, Q, Lot, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Kind?), ground(Q?), ground(Lot?), ground(Give?) | has_peer(Q?, Outs?, Outs1, Known), send_transfer(Med?, Known?, Kind?, Id?, Q?, Lot?, Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, Serial?).
propose_transfer(Med, fail, _, Id, _, lot(U, _, D, K), Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure send_transfer(Channel(Closed, Stream(AgentMsg))?, Constant?, Kind?, Constant?, Constant?, Lot?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
send_transfer(Med, yes, Kind, Id, Q, Lot, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Kind?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, UserIn?, UserIn1), show(offered_transfer(Kind?, Q?, Lot?), Outs1?, Outs2), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?).
send_transfer(Med, no, _, Id, Q, _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure do_pay(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Integer?, Integer?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
do_pay(Med, ok, Id, Q, D, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_pay(Med?, Known?, Id?, Q?, D?, K?, Give?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, Serial?).
do_pay(Med, fail, Id, Q, D, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(lacking(Q?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure send_pay(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Integer?, Integer?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
send_pay(Med, yes, Id, Q, D, K, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, pay(Give?, Resp)), Outs?, Outs1), inject_pay_result(Resp?, Q?, K?, UserIn?, UserIn1), show(paying(Q?, D?, K?), Outs1?, Outs2), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?).
send_pay(Med, no, Id, Q, _, _, Give, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure do_redeem(Channel(Closed, Stream(AgentMsg))?, Found?, Constant?, Constant?, Constant?, Integer?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
do_redeem(Med, found(B), Id, Q, R, D1, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | has_peer(Q?, Outs?, Outs1, Known), send_redeem(Med?, Known?, Id?, Q?, R?, D1?, B?, Rest?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Date?, Ws?, Serial?).
do_redeem(Med, not_found, Id, Q, _, D, Holdings, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- show(lacking(Q?, D?, 1), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure send_redeem(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Constant?, Integer?, Bond?, Stream(Bond)?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
send_redeem(Med, yes, Id, Q, R, D1, B, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, redeem(B?, R?, D1?, Resp)), Outs?, Outs1), inject_redeem_result(Resp?, Q?, UserIn?, UserIn1), after_change(Med?, Id?, UserIn1?, PeerIn?, Convs?, Cal?, Outs1?, Rest?, Date?, Ws?, Serial?).
send_redeem(Med, no, Id, Q, _, _, B, Rest, UserIn, PeerIn, Convs, Cal, Outs, Date, Ws, Serial) :- append_bonds(Rest?, [B?], Orig), show(no_conversation(Q?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure after_change(Channel(Closed, Stream(AgentMsg))?, Constant?, Stream(UserInMsg)?, Stream(PeerMsg)?, Stream(Conversation)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Integer?, Stream(Warranty)?, Integer?).
after_change(Med, Id, UserIn, PeerIn, Convs, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), agent(Med?, Id?, UserIn?, PeerIn?, Convs?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

%% --- the mediator, and the pending table with the program's clauses ahead of the search clauses ---
exported procedure med(Channel(Stream(UserAnswer), Stream(Card))?, Channel(Stream(AgentMsg), Closed)?, TimerStream?, PendingList?, Integer?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(ask(C, Ctx, Esc, Id?, deadline), AgentCh?, AgentCh1), ground(C?), ground(Ctx?) | Id = req(N?), send(card(C?, Ctx?, req(N?)), UserCh?, UserCh1), N1 := (N? + 1), deadline(D), timer(req(N?), D?, T), merge(T?, Ts?, Ts1), med(UserCh1?, AgentCh1?, Ts1?, [pending(req(N?), Esc?) | Ps?], N1?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(ask(C, Ctx, Esc, Id?, no_deadline), AgentCh?, AgentCh1), ground(C?), ground(Ctx?) | Id = req(N?), send(card(C?, Ctx?, req(N?)), UserCh?, UserCh1), N1 := (N? + 1), med(UserCh1?, AgentCh1?, Ts?, [pending(req(N?), Esc?) | Ps?], N1?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(answer(ReqId, Vs), UserCh?, UserCh1), ground(ReqId?), ground(Vs?) | answer(ReqId?, Vs?, Ps?, Ps1), med(UserCh1?, AgentCh?, Ts?, Ps1?, N?).
med(UserCh, AgentCh, [timeout(ReqId) | Ts], Ps, N) :- ground(ReqId?) | close(ReqId?, Ps?, Ps1), send(closed(ReqId?), UserCh?, UserCh1), med(UserCh1?, AgentCh?, Ts?, Ps1?, N?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(abort(ReqId), AgentCh?, AgentCh1), ground(ReqId?) | drop(ReqId?, Ps?, Ps1), send(closed(ReqId?), UserCh?, UserCh1), med(UserCh1?, AgentCh1?, Ts?, Ps1?, N?).

exported procedure timer(ReqId?, Number?, TimerStream).
timer(ReqId, D, [timeout(ReqId?)]) :- wait_until(D?) | true.

exported procedure deadline(Number).
deadline(D?) :- now(T), D := (T? + 60000).

exported procedure answer(ReqId?, Answer?, PendingList?, PendingList).
answer(ReqId, xs_respond_swap_1(X1), [pending(Id, esc_respond_swap_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_swap_1(X1?)).
answer(ReqId, xs_respond_swap_2(X1), [pending(Id, esc_respond_swap_2(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_swap_2(X1?)).
answer(ReqId, xs_respond_transfer_1(X1), [pending(Id, esc_respond_transfer_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_transfer_1(X1?)).
answer(ReqId, xs_respond_transfer_2(X1), [pending(Id, esc_respond_transfer_2(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_respond_transfer_2(X1?)).
answer(ReqId, xs_agent_1(X1, X2, X3), [pending(Id, esc_agent_1(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_1(X1?, X2?, X3?)).
answer(ReqId, xs_agent_2(X1, X2, X3, X4, X5, X6, X7, X8), [pending(Id, esc_agent_2(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_2(X1?, X2?, X3?, X4?, X5?, X6?, X7?, X8?)).
answer(ReqId, xs_agent_3(X1, X2, X3, X4), [pending(Id, esc_agent_3(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_3(X1?, X2?, X3?, X4?)).
answer(ReqId, xs_agent_4(X1, X2, X3, X4, X5), [pending(Id, esc_agent_4(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_4(X1?, X2?, X3?, X4?, X5?)).
answer(ReqId, xs_agent_5(X1, X2, X3, X4, X5), [pending(Id, esc_agent_5(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_5(X1?, X2?, X3?, X4?, X5?)).
answer(ReqId, xs_agent_6(X1, X2, X3, X4, X5), [pending(Id, esc_agent_6(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_6(X1?, X2?, X3?, X4?, X5?)).
answer(ReqId, xs_agent_7(X1, X2, X3, X4, X5), [pending(Id, esc_agent_7(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(xs_agent_7(X1?, X2?, X3?, X4?, X5?)).
answer(ReqId, Vs, [P | Ps], [P? | Ps1?]) :- otherwise | answer(ReqId?, Vs?, Ps?, Ps1).
answer(_, _, [], []).

exported procedure close(ReqId?, PendingList?, PendingList).
close(ReqId, [pending(Id, esc_respond_swap_2(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = else.
close(ReqId, [pending(Id, esc_respond_transfer_2(R?)) | Ps], Ps?) :- (ReqId? =?= Id?) | R = else.
close(ReqId, [P | Ps], [P? | Ps1?]) :- otherwise | close(ReqId?, Ps?, Ps1).
close(_, [], []).

exported procedure drop(ReqId?, PendingList?, PendingList).
drop(ReqId, [pending(Id, _) | Ps], Ps?) :- (ReqId? =?= Id?) | true.
drop(ReqId, [P | Ps], [P? | Ps1?]) :- otherwise | drop(ReqId?, Ps?, Ps1).
drop(_, [], []).

exported procedure(R) abort(Slot(R)?, Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg))).
abort(none, Med, Med?).
abort(ask(_, Id), Med, Med1?) :- ground(Id?) | send(abort(Id?), Med?, Med1).

exported procedure med_split(Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg)), Channel(Closed, Stream(AgentMsg))).
med_split(ch(_, Out?), ch([], O1), ch([], O2)) :- merge(O1?, O2?, Out).

