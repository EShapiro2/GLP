%% quicksort.glp - Quicksort using difference lists
%% Efficient O(n log n) average case without append overhead.

quicksort(Xs, Sorted?) :- quicksort_dl(Xs?, Sorted\[]).

quicksort_dl([], T\T?).
quicksort_dl([X|Xs], H?\T?) :-
    ground(X?) |
    partition(X?, Xs?, Smalls, Bigs),
    quicksort_dl(Smalls?, H\[X?|M]),
    quicksort_dl(Bigs?, M?\T).

partition(_, [], [], []).
partition(Pivot, [X|Xs], [X?|Smalls?], Bigs?) :-
    X? =< Pivot? |
    partition(Pivot?, Xs?, Smalls, Bigs).
partition(Pivot, [X|Xs], Smalls?, [X?|Bigs?]) :-
    X? > Pivot? |
    partition(Pivot?, Xs?, Smalls, Bigs).
