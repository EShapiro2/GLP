%% currency_txn.glp — GrassApp's top-level lift of the currencies transaction core.
%%
%% A plain-`procedure` copy of programs/currencies/txn.glp (Grassroots-Bonds
%% owned, and still the canonical owner of this logic).  The ONLY change is
%% `exported procedure` -> `procedure`.  GrassApp loads its modules top-level via
%% loadSource (no module scoping), so the agent calls these predicates BARE — the
%% same way it calls agent/ui_mediator.  An `exported`/`txn#` module cannot be
%% reused in-isolate: a co-loaded module's `#` call compiles to a cross-isolate
%% `Distribute` (see the IGLP relay).  Once IGLP supports in-isolate module reuse
%% this lift can be replaced by importing currencies/txn.glp directly.
%%
%% KEEP IN SYNC with programs/currencies/txn.glp (same author owns both).
%%
%% The pure, UI-agnostic bond-transaction predicates: maturity-aware holdings
%% (bonds), lot selection, the redeem-side maturity gate, trade classification,
%% and the redemption menu.  Data transforms over Stream(Bond) / Stream(Lot).
%%
%% Representation (Bond/Lot types come from grassapp self.glp):
%%   Bond ::= bond(Issuer, Maturity, Serial).   Lot ::= lot(Issuer, Maturity, Count).
%% A bond of maturity d is a coin of its ISSUER q iff d =< d*_q, q's own date
%% (Def 3.2); the holders' dates play no part, and a maturity-0 bond is a coin
%% at once.
%%
%% Top-level (called bare by the agent): create_bonds, append,
%% select_bonds_by_spec, classify_trade (with classify_payment, classify_redemption),
%% build_menu, and their helpers.


%% =============================================================================
%% CREATE_BONDS — Create K bonds with given issuer and maturity (Mint)
%% =============================================================================

procedure create_bonds(Constant?, Constant?, Constant?, Constant?, Stream(Bond)).
create_bonds(Issuer, Maturity, K, Serial,
             [bond(Issuer?, Maturity?, Serial?)|Rest?]) :-
    K? > 0 |
    K1 := K? - 1,
    S1 := Serial? + 1,
    create_bonds(Issuer?, Maturity?, K1?, S1?, Rest).
create_bonds(_, _, 0, _, []).

%% =============================================================================
%% APPEND — Append two bond lists (self-contained here so the module lifts
%% without a hidden self.glp dependency)
%% =============================================================================

procedure append(Stream(Bond)?, Stream(Bond)?, Stream(Bond)).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).
append([], Ys, Ys?).

%% =============================================================================
%% SELECT_BONDS_EXACT — Select K bonds with exact Issuer+Maturity
%% =============================================================================

procedure select_bonds_exact(Constant?, Constant?, Constant?, Stream(Bond)?, Constant, Stream(Bond), Stream(Bond)).
select_bonds_exact(_, _, 0, Hs, ok, [], Hs?).
select_bonds_exact(Issuer, Maturity, K, [bond(I, M, S)|Rest], Status?, [bond(I?, M?, S?)|Sel?], Rem?) :-
    K? > 0, Issuer? =?= I?, Maturity? =?= M? |
    K1 := K? - 1,
    select_bonds_exact(Issuer?, Maturity?, K1?, Rest?, Status, Sel, Rem).
select_bonds_exact(Issuer, Maturity, K, [B|Rest], Status?, Sel?, [B?|Rem?]) :-
    otherwise |
    select_bonds_exact(Issuer?, Maturity?, K?, Rest?, Status, Sel, Rem).
select_bonds_exact(_, _, K, [], fail, [], []) :- K? > 0 | true.

%% =============================================================================
%% SELECT_BONDS_BY_SPEC — Fold over a lot list (exact issuer+maturity match)
%% =============================================================================

procedure select_bonds_by_spec(Stream(Lot)?, Stream(Bond)?, Constant, Stream(Bond), Stream(Bond)).
select_bonds_by_spec([lot(Issuer, Maturity, Count)|Rest], Holdings, Status?, AllSel?, FinalRem?) :-
    ground(Issuer?), ground(Maturity?), ground(Count?) |
    select_bonds_exact(Issuer?, Maturity?, Count?, Holdings?, LotStatus, LotSel, LotRem),
    select_by_spec_continue(LotStatus?, Rest?, LotSel?, LotRem?, Status, AllSel, FinalRem).
select_bonds_by_spec([], Holdings, ok, [], Holdings?).

procedure select_by_spec_continue(Constant?, Stream(Lot)?, Stream(Bond)?, Stream(Bond)?, Constant, Stream(Bond), Stream(Bond)).
select_by_spec_continue(ok, Rest, LotSel, LotRem, Status?, AllSel?, FinalRem?) :-
    select_bonds_by_spec(Rest?, LotRem?, Status, RestSel, FinalRem),
    append(LotSel?, RestSel?, AllSel).
select_by_spec_continue(fail, _, LotSel, LotRem, fail, LotSel?, LotRem?).

%% =============================================================================
%% CLASSIFY_TRADE — Classify an incoming proposal for the accepter Id, judged
%% at Id's own local date Clock.  A bond cent_{q,d} is a q-coin iff d =< d*_q
%% (Def 3.2): maturity is decided by the ISSUER's date, so Id tests the offered
%% bonds against its OWN Clock; the holders' dates play no part.
%%   * empty want-list, offered are coins         -> payment    (Def 3.2, Pay)
%%   * wanting Id's bonds, offered are Id's coins  -> redemption (Def 3.2, Redeem)
%%   * otherwise                                   -> normal (a swap, shown to the user)
%% =============================================================================

procedure classify_trade(Constant?, Constant?, Stream(Lot)?, Stream(Bond)?, Constant).
classify_trade(Id, Clock, [], OfferedBonds, Class?) :-
    classify_payment(Id?, Clock?, OfferedBonds?, Class).
classify_trade(Id, Clock, [_|_], OfferedBonds, Class?) :-
    classify_redemption(Id?, Clock?, OfferedBonds?, Class).

%% Pay: take the coins unless one of Id's OWN bonds is offered before maturity
%% (not yet a coin, so not a valid payment); others' bonds Id takes as delivered.
procedure classify_payment(Constant?, Constant?, Stream(Bond)?, Constant).
classify_payment(Id, Clock, [bond(I, M, _)|_], normal) :-
    Id? =?= I?, M? > Clock? | true.
classify_payment(Id, Clock, [bond(_, _, _)|Rest], Class?) :-
    otherwise | classify_payment(Id?, Clock?, Rest?, Class).
classify_payment(_, _, [], payment).

%% Redeem: every offered bond must be a coin of Id — issued by Id (I =?= Id)
%% and mature at Id's own date (M =< Clock); the issuer must then fulfil.
procedure classify_redemption(Constant?, Constant?, Stream(Bond)?, Constant).
classify_redemption(Id, Clock, [bond(I, M, _)|Rest], Class?) :-
    Id? =?= I?, M? =< Clock? | classify_redemption(Id?, Clock?, Rest?, Class).
classify_redemption(_, _, [bond(_, _, _)|_], normal) :-
    otherwise | true.
classify_redemption(_, _, [], redemption).

%% =============================================================================
%% BUILD_MENU — One bond per issuer, earliest maturity (redemption menu)
%% =============================================================================

procedure build_menu(Constant?, Stream(Bond)?, Stream(Bond)).
build_menu(Id, Holdings, Menu?) :-
    build_menu_acc(Id?, Holdings?, [], Menu).

procedure build_menu_acc(Constant?, Stream(Bond)?, Stream(Bond)?, Stream(Bond)).
build_menu_acc(Id, [bond(I, _, _)|Rest], Acc, Menu?) :-
    Id? =?= I? |
    build_menu_acc(Id?, Rest?, Acc?, Menu).
build_menu_acc(Id, [bond(I, M, S)|Rest], Acc, Menu?) :-
    otherwise |
    menu_update(I?, M?, S?, Acc?, Acc1),
    build_menu_acc(Id?, Rest?, Acc1?, Menu).
build_menu_acc(_, [], Acc, Acc?).

procedure menu_update(Constant?, Constant?, Constant?, Stream(Bond)?, Stream(Bond)).
menu_update(I, M, S, [bond(I2, M2, _)|Rest],
    [bond(I2?, M?, S?)|Rest?]) :-
    I? =?= I2?, M? < M2? | true.
menu_update(I, _, _, [bond(I2, M2, S2)|Rest],
    [bond(I2?, M2?, S2?)|Rest?]) :-
    I? =?= I2? | true.
menu_update(I, M, S, [B|Rest], [B?|Rest1?]) :-
    otherwise |
    menu_update(I?, M?, S?, Rest?, Rest1).
menu_update(I, M, S, [], [bond(I?, M?, S?)]).
