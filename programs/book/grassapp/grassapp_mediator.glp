%% grassapp_mediator.glp — the one mediator between the GrassApp agent (agent/7)
%% and the Dart UI; one machine for all platforms, parameterised by its message
%% vocabulary (UserCmd/UserNotify below).
%%
%% Same escrow discipline as the social mediator: agent output may carry unbound
%% variables (the cold-call Response writer, a trade TradeResponse writer); the
%% mediator replaces them with a ground req(N) for the UI and holds the writer in
%% the pending table until the user answers. All Dart-facing terms are ground.
%%
%% Currencies vocabulary (Milestone 1b): mint carries a maturity, the swap is the
%% maturity-carrying lot-spec trade (a loan is its instance), the local date
%% advances explicitly, redeem is the holder-gated presentation, and
%% balance_report is keyed by (owner, issuer, maturity) so the wallet can split
%% cash (mature) from loans (dated).  Escrow (paper §5) locks bonds until a
%% real-time release and is cancellable until then; its cancel-signal writer is
%% escrowed as req(N) exactly like a trade offer's response writer.
%%
%% Scalar boundary: the UI — and the scripted actors that stand in for people —
%% speak SCALAR single-lot commands (pay/4, trade/7, redeem/7, deposit_escrow/5),
%% because a compose
%% form carries only scalar fields.  This mediator builds the Stream(Lot) the
%% agent consumes, and flattens the agent's single-lot trade_proposed back to
%% scalars for the offer card.  Multi-lot portfolios are Milestone 2.


ReqId ::= req(Constant).

%% User -> Mediator (ground commands from Dart).
UserCmd     ::= connect(Constant)
              ; unfriend(Constant)
              ; decision(Decision, Constant, ReqId)
              ; send(Constant, Constant)
              ; mint(Constant, Constant)
              ; advance_date(Constant)
              ; balance
              ; pay(Constant, Constant, Constant, Constant)
              ; trade(Constant, Constant, Constant, Constant, Constant, Constant, Constant)
              ; redeem(Constant, Constant, Constant, Constant, Constant, Constant, Constant)
              ; accept_trade(Constant, ReqId)
              ; reject_trade(Constant, ReqId)
              ; deposit_escrow(Constant, Constant, Constant, Constant, Constant)
              ; cancel_escrow(Constant, ReqId)
              ; create_group(Constant)
              ; invite_group(GroupId, Constant)
              ; accept_group(GroupId, ReqId)
              ; reject_group(GroupId, ReqId)
              ; send_group(GroupId, Constant)
              ; leave_group(GroupId)
              ; remove_from_group(GroupId, Constant).

%% Mediator -> User (ground notifications to Dart).
UserNotify  ::= befriend(Constant, ReqId)
              ; connected(Constant)
              ; unfriended(Constant)
              ; rejected
              ; rejected(Constant)
              ; received(Constant, Constant)
              ; balance_report(Constant, Constant, Constant, Integer)
              ; balances_synced(Constant)
              ; date_advanced(Constant)
              ; trade_proposed(Constant, Constant, Constant, Constant, ReqId)
              ; trade_completed(Constant)
              ; trade_failed(Constant)
              ; trade_returned(Constant)
              ; trade_returned_menu(Constant, Stream(Bond))
              ; escrow_deposited(Constant, Constant, Constant, Constant, Constant, ReqId)
              ; escrow_received(Constant, Constant, Constant, Constant, Constant)
              ; escrow_released(Constant)
              ; escrow_cancelled(Constant)
              ; escrow_expired(Constant)
              ; escrow_returned(Constant)
              ; escrow_failed(Constant)
              ; group_invite(GroupId, ReqId)
              ; group_joined(GroupId)
              ; group_joined_member(GroupId, Constant)
              ; group_left(GroupId)
              ; group_removed(GroupId)
              ; group_received(GroupId, Constant, Constant).

PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

procedure ui_mediator(Constant?,
                      Channel(Stream(AgentMsg), Stream(UserMsg))?,
                      Channel(Stream(UserCmd), Stream(UserNotify))?,
                      PendingList?, Constant?).

%% --- Agent-to-user: non-ground (replace writer with req id) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% Trade offer: agent sends trade_proposed(...,TradeResp); escrow the writer as
%% req(N) together with the want-spec and the bonds actually offered.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, trade_proposed(From, WantSpec, Resp?, Offered)),
            AgentCh?, AgentCh1),
    ground(From?), ground(WantSpec?), ground(Offered?) |
    first_lot(WantSpec?, WantIssuer, WantMaturity, WantAmount),
    send(trade_proposed(From?, WantIssuer?, WantMaturity?, WantAmount?, req(N?)),
         UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), trade_pending(Resp, WantSpec?, Offered?)) | Ps?], N1?).

%% Escrow opened: the agent hands over the cancel-signal writer.  Hold it in the
%% pending table as req(N) so the UI can cancel by id.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, escrow_deposited(Target, ReleaseTime, Coin, Maturity, Amount, Cancel?)),
            AgentCh?, AgentCh1),
    ground(Target?), ground(ReleaseTime?),
    ground(Coin?), ground(Maturity?), ground(Amount?) |
    send(escrow_deposited(Target?, ReleaseTime?, Coin?, Maturity?, Amount?, req(N?)),
         UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), escrow_pending(Cancel)) | Ps?], N1?).

%% --- Agent-to-user: ground (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, trade_completed(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_completed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, trade_failed(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_failed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, trade_returned(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_returned(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, trade_returned_menu(From, Menu)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Menu?) |
    send(trade_returned_menu(From?, Menu?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, date_advanced(D)),
            AgentCh?, AgentCh1),
    ground(D?) |
    send(date_advanced(D?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(connected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, unfriended(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(unfriended(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, rejected),
            AgentCh?, AgentCh1) |
    send(rejected, UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, received(From, Text)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Text?) |
    send(received(From?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% Holdings are reported per (owner, issuer, maturity) so the wallet can show
%% cash (mature) and loans (dated) as distinct views.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, balance_report(Owner, Issuer, Maturity, Count)),
            AgentCh?, AgentCh1),
    ground(Owner?), ground(Issuer?), ground(Maturity?), ground(Count?) |
    send(balance_report(Owner?, Issuer?, Maturity?, Count?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% Balances snapshot boundary: the UI prunes holdings the snapshot omitted, so a
%% coin spent to zero leaves the wallet (nothing else reports it gone).
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, balances_synced(Owner)), AgentCh?, AgentCh1),
    ground(Owner?) |
    send(balances_synced(Owner?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow settlement (ground pass-through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, escrow_received(From, ReleaseTime, Coin, Maturity, Amount)),
            AgentCh?, AgentCh1),
    ground(From?), ground(ReleaseTime?),
    ground(Coin?), ground(Maturity?), ground(Amount?) |
    send(escrow_received(From?, ReleaseTime?, Coin?, Maturity?, Amount?),
         UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, escrow_released(From)), AgentCh?, AgentCh1),
    ground(From?) |
    send(escrow_released(From?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, escrow_cancelled(From)), AgentCh?, AgentCh1),
    ground(From?) |
    send(escrow_cancelled(From?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, escrow_expired(Target)), AgentCh?, AgentCh1),
    ground(Target?) |
    send(escrow_expired(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, escrow_returned(Target)), AgentCh?, AgentCh1),
    ground(Target?) |
    send(escrow_returned(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, escrow_failed(Target)), AgentCh?, AgentCh1),
    ground(Target?) |
    send(escrow_failed(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: group invitation (escrow the setup channel as req(N)) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, group_invite(GroupId, Ch)),
            AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_invite(GroupId?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), group_channel(Ch?)) | Ps?], N1?).

%% --- Agent-to-user: group notifications (ground pass-through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, group_joined(GroupId)), AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_joined(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, group_joined_member(GroupId, Member)),
            AgentCh?, AgentCh1),
    ground(GroupId?), ground(Member?) |
    send(group_joined_member(GroupId?, Member?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, group_left(GroupId)), AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_left(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, group_removed(GroupId)), AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_removed(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, person, group_received(GroupId, Author, Text)),
            AgentCh?, AgentCh1),
    ground(GroupId?), ground(Author?), ground(Text?) |
    send(group_received(GroupId?, Author?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (cold-call response) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Dec?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Resp, Ps?, Ps1),
    send(msg(person, Id?, decision(Dec?, From?, Resp?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: pass-through commands ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(connect(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg(person, Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(unfriend(Friend), UserCh?, UserCh1),
    ground(Id?), ground(Friend?) |
    send(msg(person, Id?, unfriend(Friend?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(send(Target, Text), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(Text?) |
    send(msg(person, Id?, send(Target?, Text?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% Mint K bonds of my own at Maturity (Maturity 0 = cash).
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(mint(K, Maturity), UserCh?, UserCh1),
    ground(Id?), ground(K?), ground(Maturity?) |
    send(msg(person, Id?, mint(K?, Maturity?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% Advance this agent's own local date.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(advance_date(D), UserCh?, UserCh1),
    ground(Id?), ground(D?) |
    send(msg(person, Id?, advance_date(D?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(balance, UserCh?, UserCh1),
    ground(Id?) |
    send(msg(person, Id?, balance),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(pay(Friend, Coin, Maturity, Amount), UserCh?, UserCh1),
    ground(Id?), ground(Friend?), ground(Coin?), ground(Maturity?), ground(Amount?) |
    send(msg(person, Id?, pay(Friend?, [lot(Coin?, Maturity?, Amount?)])),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% The maturity-carrying swap — a loan is its instance.  Scalar single-lot UI
%% form; the mediator builds the give and want lots.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(trade(Target, GiveCoin, GiveMat, GiveAmt, WantCoin, WantMat, WantAmt),
            UserCh?, UserCh1),
    ground(Id?), ground(Target?),
    ground(GiveCoin?), ground(GiveMat?), ground(GiveAmt?),
    ground(WantCoin?), ground(WantMat?), ground(WantAmt?) |
    send(msg(person, Id?,
             trade(Target?, [lot(GiveCoin?, GiveMat?, GiveAmt?)],
                            [lot(WantCoin?, WantMat?, WantAmt?)])),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% Redeem: present the target's matured coins (holder-gated in the agent).
%% Scalar single-lot UI form; the mediator builds the give and want lots.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(redeem(Target, GiveCoin, GiveMat, GiveAmt, WantCoin, WantMat, WantAmt),
            UserCh?, UserCh1),
    ground(Id?), ground(Target?),
    ground(GiveCoin?), ground(GiveMat?), ground(GiveAmt?),
    ground(WantCoin?), ground(WantMat?), ground(WantAmt?) |
    send(msg(person, Id?,
             redeem(Target?, [lot(GiveCoin?, GiveMat?, GiveAmt?)],
                             [lot(WantCoin?, WantMat?, WantAmt?)])),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_trade(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, accept_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_trade(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, reject_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% Escrow deposit: scalar single-lot UI form; the mediator builds the lot.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(deposit_escrow(Target, Coin, Maturity, Amount, ReleaseTime),
            UserCh?, UserCh1),
    ground(Id?), ground(Target?),
    ground(Coin?), ground(Maturity?), ground(Amount?), ground(ReleaseTime?) |
    send(msg(person, Id?,
             deposit_escrow(Target?, [lot(Coin?, Maturity?, Amount?)], ReleaseTime?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% Cancel an open escrow by its req id — the pending table returns the writer.
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(cancel_escrow(Target, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, cancel_escrow(Target?, Pv?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: group commands ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(create_group(Name), UserCh?, UserCh1),
    ground(Id?), ground(Name?) |
    send(msg(person, Id?, create_group(Name?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(invite_group(GroupId, Invitee), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    send(msg(person, Id?, invite_group(GroupId?, Invitee?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(send_group(GroupId, Text), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(Text?) |
    send(msg(person, Id?, send_group(GroupId?, Text?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(leave_group(GroupId), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?) |
    send(msg(person, Id?, leave_group(GroupId?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(remove_from_group(GroupId, Member), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(Member?) |
    send(msg(person, Id?, remove_from_group(GroupId?, Member?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_group(GroupId, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, accept_group(GroupId?, Pv?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_group(GroupId, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg(person, Id?, reject_group(GroupId?, Pv?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

%% Flatten a single-lot want-spec to scalars for the offer card (M1b single-lot;
%% multi-lot display is Milestone 2).  The whole Stream(Lot) stays escrowed in the
%% pending table, so accept_trade still replays the real lots.
procedure first_lot(Stream(Lot)?, Constant, Constant, Constant).
first_lot([lot(I, M, A) | _], I?, M?, A?).

procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).
