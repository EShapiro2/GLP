%% grassapp_mediator.glp — the one mediator between the GrassApp agent (agent/5)
%% and the Dart UI; one machine for all platforms, parameterised by its message
%% vocabulary (UserCmd/UserNotify below).
%%
%% Same escrow discipline as the social mediator: agent output may carry unbound
%% variables (the cold-call Response writer, a swap SwapResponse writer); the
%% mediator replaces them with a ground req(N) for the UI and holds the writer in
%% the pending table until the user answers. All Dart-facing terms are ground.
%%
%% Stage 1: social befriending + mint + balance + balance_report. The swap
%% pending path (propose/accept/decline) is added with the swap stage.


ReqId ::= req(Constant).

%% User -> Mediator (ground commands from Dart).
UserCmd     ::= connect(Constant)
              ; unfriend(Constant)
              ; decision(Decision, Constant, ReqId)
              ; send(Constant, Constant)
              ; mint(Integer)
              ; balance
              ; pay(Constant, Constant, Integer)
              ; redeem(Constant, Integer)
              ; propose_swap(Constant, Constant, Integer, Constant, Integer)
              ; accept_swap(Constant, ReqId)
              ; decline_swap(Constant, ReqId).

%% Mediator -> User (ground notifications to Dart).
UserNotify  ::= befriend(Constant, ReqId)
              ; connected(Constant)
              ; unfriended(Constant)
              ; rejected
              ; rejected(Constant)
              ; received(Constant, Constant)
              ; balance_report(Constant, Constant, Integer)
              ; swap_offer(Constant, Constant, Integer, Constant, Integer, ReqId)
              ; swap_done(Constant)
              ; swap_failed(Constant).

PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

procedure ui_mediator(Constant?,
                      Channel(Stream(AgentMsg), Stream(UserMsg))?,
                      Channel(Stream(UserCmd), Stream(UserNotify))?,
                      PendingList?, Constant?).

%% --- Agent-to-user: non-ground (replace writer with req id) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% Swap offer: agent sends swap_offer(...,SwapResp); escrow the writer as req(N).
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', swap_offer(From, GC, GA, WC, WA, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?), ground(GC?), ground(GA?), ground(WC?), ground(WA?) |
    send(swap_offer(From?, GC?, GA?, WC?, WA?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), swap_pending(Resp, GC?, GA?, WC?, WA?)) | Ps?], N1?).

%% --- Agent-to-user: ground (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', swap_done(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(swap_done(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', swap_failed(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(swap_failed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(connected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', unfriended(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(unfriended(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected),
            AgentCh?, AgentCh1) |
    send(rejected, UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', received(From, Text)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Text?) |
    send(received(From?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', balance_report(Owner, Coin, Amount)),
            AgentCh?, AgentCh1),
    ground(Owner?), ground(Coin?), ground(Amount?) |
    send(balance_report(Owner?, Coin?, Amount?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (cold-call response) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Dec?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Resp, Ps?, Ps1),
    send(msg('_user', Id?, decision(Dec?, From?, Resp?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: pass-through commands ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(connect(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg('_user', Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(unfriend(Friend), UserCh?, UserCh1),
    ground(Id?), ground(Friend?) |
    send(msg('_user', Id?, unfriend(Friend?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(send(Target, Text), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(Text?) |
    send(msg('_user', Id?, send(Target?, Text?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(mint(K), UserCh?, UserCh1),
    ground(Id?), integer(K?) |
    send(msg('_user', Id?, mint(K?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(balance, UserCh?, UserCh1),
    ground(Id?) |
    send(msg('_user', Id?, balance),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(pay(Friend, Coin, Amount), UserCh?, UserCh1),
    ground(Id?), ground(Friend?), ground(Coin?), integer(Amount?) |
    send(msg('_user', Id?, pay(Friend?, Coin?, Amount?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(redeem(Friend, Amount), UserCh?, UserCh1),
    ground(Id?), ground(Friend?), integer(Amount?) |
    send(msg('_user', Id?, redeem(Friend?, Amount?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(propose_swap(Friend, GC, GA, WC, WA), UserCh?, UserCh1),
    ground(Id?), ground(Friend?), ground(GC?), integer(GA?), ground(WC?), integer(WA?) |
    send(msg('_user', Id?, propose_swap(Friend?, GC?, GA?, WC?, WA?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_swap(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, accept_swap(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decline_swap(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, decline_swap(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).
