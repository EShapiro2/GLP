%% grassapp_agent.vglp — the GrassApp agent as a vGLP program.
%%
%% vGLP source of the tested GLP program grassapp_agent.glp + grassapp_mediator.glp
%% (this directory): the agent authored with volition-guarded clauses, the mediator and
%% its UserCmd/UserNotify vocabulary absent — they belong to the implementation,
%% which maps the volition-guarded clauses into concrete UI constructs.
%% Exhibit for the paper "Volition Elicitation: Operational
%% Semantics for People and Their Machines", which defines vGLP.
%%
%% NOTATION (defined in the paper):
%%   *                          marks a volition-guarded clause: reducing a goal with
%%                              it requires, besides its guards, the person willing
%%                              this reduction. Among volition-guarded clauses for
%%                              the same goal, the person's answer selects the clause.
%%   *(X1,...,Xk)               a volition-guarded clause with person-supplied inputs:
%%                              the person's answer binds the writers X1..Xk; the clause
%%                              carries their readers Xi?.
%%
%% RESPONDERS. An arriving offer spawns a responder goal — respond_coldcall,
%% respond_swap, respond_group_invite — one goal per offer, so offers pend
%% concurrently and are answered in any order. The responder carries the offer
%% and the response writer (or, for a group invitation, the setup channel); its
%% volition-guarded sibling clauses (accept/decline) are the person's choice,
%% and the chosen clause injects its answer, through a merge, into the agent's
%% UserIn, where an ordinary agent clause carries it out on the agent's current
%% state.
%%
%% Correspondence to the implementation (clause for clause):
%%   - a *(X1..Xk) Request clause  ->  a UserCmd constructor over X1..Xk, a mediator
%%     pass-through, and the agent clause matching msg(person, Id, cmd(X1..Xk));
%%   - a responder goal, spawned per arriving offer  ->  a pending-table entry
%%     req(N) in the mediator, rendered as an inbox card;
%%   - a responder's volition-guarded clause, injecting its answer through the
%%     merge into UserIn  ->  the UserCmds decision/3, accept_swap/2,
%%     decline_swap/2 routing the escrowed writer back to the agent; the agent's
%%     answer clauses below match the deployed ones modulo the msg(person, Id,
%%     ...) wrapper and the mediator's swap_pending packing of the escrowed fields.
%% The escrow vocabulary — befriend/2, swap_offer/6, and the pending table — does
%% not appear here: the machine's question to the person is not a message but a
%% pending volition-guarded reduction.
%%
%% Clause order follows the paper's remark "Ordering with otherwise":
%% Request clauses (perpetually pending) follow every otherwise clause of the
%% procedure — the compose clauses come last, after the catch-alls — and
%% between volition-guarded siblings otherwise is not used.
%%
%% This file is vGLP, not GLP: the REPL does not load it (hence .vglp). Its
%% correctness argument is the clause-for-clause correspondence to the tested,
%% deployed implementation in this directory.
%%
%% Shared types (Response, FriendContent, Holding, SwapResponse, NetColdCall,
%% GroupId, GroupContent, GroupMsg, GroupKey, GroupSetupResponse, Handshake) are
%% those of self.glp. Helper procedures — channel ops, merge, lookup_send,
%% inject_msg, bind_response, handle_response, end_friend, drop_friend, the
%% holdings helpers, do_pay, do_redeem, do_redeem_back, bind_swap_decline,
%% inject_swap_result, do_propose_swap, do_accept_swap, add_output,
%% close_outputs, after_change, and the group helpers (setup_group_creator,
%% setup_group_hub_side, add_group_output, lookup_send_group,
%% distribute_group_msg, close_output, group_await_join, inject_group_result,
%% await_group_channel) — are those of grassapp_agent.glp, unchanged; this file
%% gives the agent procedure and its responders.


%% Output content — grassapp_agent.glp's union minus the escrow vocabulary
%% (befriend/2, swap_offer/6, group_invite/2): under vGLP the machine asks the
%% person by a pending reduction, not by a message.  Group content — GroupId,
%% GroupContent, GroupMsg, GroupKey, GroupSetupResponse, Handshake — is that of
%% self.glp.
OutputContent ::= connected(Constant)
                ; unfriended(Constant)
                ; rejected
                ; rejected(Constant)
                ; received(Constant, Constant)
                ; response(Response)
                ; text(Constant)
                ; intro(Constant, FriendChannel)
                ; balance_report(Constant, Constant, Integer)
                ; swap_done(Constant)
                ; swap_failed(Constant)
                ; coins(Constant, Integer)
                ; balances(Stream(Holding))
                ; swap_propose(Constant, Integer, Constant, Integer, SwapResponse?)
                ; redeem_coins(Constant, Integer)
                ; group_joined(GroupId)
                ; group_joined_member(GroupId, Constant)
                ; group_left(GroupId)
                ; group_removed(GroupId)
                ; group_received(GroupId, Constant, Constant)
                ; unfriend.
OutputMsg     ::= msg(Constant, Constant, OutputContent)
                ; msg(Constant, NetColdCall).
OutputStream  ::= [] ; [OutputMsg | OutputStream].

%% Output entries: the keyed friend/user/net streams, plus group channels keyed
%% by GroupKey (the member's own hub link, or a member entry the creator
%% distributes to).
OutputEntry ::= output(Constant, OutputStream?)
              ; group_entry(GroupKey, Stream(GroupMsg)?).
OutputsList ::= [] ; [OutputEntry|OutputsList].

%% The offers the responders carry: the question the pending reduction poses.
ColdCallOffer    ::= offer(Constant).
SwapOffer        ::= offer(Constant, Constant, Integer, Constant, Integer).
GroupInviteOffer ::= offer(GroupId).

%% =============================================================================
%% RESPONDERS — one goal per arriving offer; the volition-guarded clauses live
%% here, so offers pend concurrently and are answered in any order.
%% =============================================================================

procedure respond_coldcall(ColdCallOffer?, Response, Stream(X)).

%% Accept a friend offer.
*(Answer=yes, From?)
respond_coldcall(offer(From), Resp?, [decision(Answer?, From?, response(Resp))]) :-
    ground(From?) | true.

%% Decline.
*(Answer=no, From?)
respond_coldcall(offer(From), Resp?, [decision(Answer?, From?, response(Resp))]) :-
    ground(From?) | true.

procedure respond_swap(SwapOffer?, SwapResponse, Stream(X)).

%% Accept a swap offer: the agent's answer clause gives the want-coins and
%% takes the give-coins (declining itself if the want-coins are not held).
*(Answer=yes, From?, GiveCoin?, GiveAmt?, WantCoin?, WantAmt?)
respond_swap(offer(From, GiveCoin, GiveAmt, WantCoin, WantAmt), SwapResp?,
    [accept_swap(From?, GiveCoin?, GiveAmt?, WantCoin?, WantAmt?, SwapResp)]) :-
    ground(From?), ground(GiveCoin?), integer(GiveAmt?), ground(WantCoin?), integer(WantAmt?) | true.

%% Decline.
*(Answer=no, From?, GiveCoin?, GiveAmt?, WantCoin?, WantAmt?)
respond_swap(offer(From, GiveCoin, GiveAmt, WantCoin, WantAmt), SwapResp?,
    [decline_swap(From?, SwapResp)]) :-
    ground(From?) | true.

procedure respond_group_invite(Constant?, GroupInviteOffer?, Channel(Stream(GroupSetupResponse), Stream(Handshake))?, Stream(X)).

%% Accept a group invitation: ack on the setup channel, hand the read side to
%% the agent to await the group channel from the hub.
*(Answer=yes, GroupId?)
respond_group_invite(Id, offer(GroupId), ch(ChRead, [ack(Id?)|[]]),
    [accept_group(GroupId?, ChRead?)]) :-
    ground(Id?), ground(GroupId?) | true.

%% Decline: nack on the setup channel, closing it.
*(Answer=no, GroupId?)
respond_group_invite(_, offer(GroupId), ch(_ChRead, [nack|[]]), []) :-
    ground(GroupId?) | true.

%% =============================================================================
%% AGENT/5
%% =============================================================================

procedure agent(Constant?, Stream(X)?, Stream(X)?, OutputsList?, Stream(Holding)?).

%% --- Reactive: network messages ---

%% A peer cold-calls me: spawn a responder — the offer pends until the person
%% answers; the answer is merged into UserIn.
agent(Id, UserIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs, Holdings) :-
    Id? =?= Id1? |
    respond_coldcall(offer(From?), Resp, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?, Holdings?).

%% A friend proposes a swap: spawn a responder likewise.
agent(Id, UserIn, [msg(From, Id1, swap_propose(GiveCoin, GiveAmt, WantCoin, WantAmt, SwapResp?))|NetIn], Outs, Holdings) :-
    Id? =?= Id1?, ground(From?), ground(GiveCoin?), integer(GiveAmt?), ground(WantCoin?), integer(WantAmt?) |
    respond_swap(offer(From?, GiveCoin?, GiveAmt?, WantCoin?, WantAmt?), SwapResp, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?, Holdings?).

%% A peer answered my cold call.
agent(Id, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs, Holdings) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?).

%% A friend messages me.
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs, Holdings) :-
    Id? =?= Id1? |
    lookup_send(person, msg(agent, person, received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?).

%% A friend pays me: add the coins, re-report.
agent(Id, UserIn, [msg(_, Id1, coins(Coin, Amt))|NetIn], Outs, Holdings) :-
    Id? =?= Id1?, ground(Coin?), integer(Amt?) |
    add_coin(Coin?, Amt?, Holdings?, Holdings1),
    after_change(Id?, Holdings1?, UserIn?, NetIn?, Outs?).

%% A friend redeems my coins: take back my own (x), fill them with up to Amount
%% of the returner's coins I hold (y).
agent(Id, UserIn, [msg(_, Id1, redeem_coins(Returner, Amount))|NetIn], Outs, Holdings) :-
    Id? =?= Id1?, ground(Returner?), integer(Amount?) |
    add_coin(Id?, Amount?, Holdings?, Holdings1),
    take_up_to(Returner?, Amount?, Holdings1?, GaveBack, Holdings2),
    do_redeem_back(Id?, Returner?, GaveBack?, Holdings2?, UserIn?, NetIn?, Outs?).

%% A friend unfriended me (Integrate unfriend): drop the channel and tell the
%% person the friend is gone.
agent(Id, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs, Holdings) :-
    Id? =?= Id1?, ground(From?) |
    drop_friend(From?, Outs?, Outs1),
    lookup_send(person, msg(agent, person, unfriended(From?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?).

%% A friend publishes their holdings: report them as that friend's balances.
agent(Id, UserIn, [msg(From, Id1, balances(FH))|NetIn], Outs, Holdings) :-
    Id? =?= Id1?, ground(From?), ground(FH?) |
    emit_balances(From?, FH?, Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?).

%% A friend invites me to a group: spawn a responder — the invite pends until
%% the person answers; the answer is merged into UserIn.
agent(Id, UserIn, [msg(_, Id1, group_invite(GroupId, Ch))|NetIn], Outs, Holdings) :-
    Id? =?= Id1?, ground(GroupId?) |
    respond_group_invite(Id?, offer(GroupId?), Ch?, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?, Holdings?).

%% A group message arrives on a group channel — distribute to members (hub side)
%% and show it to the person.
agent(Id, UserIn, [msg(_, _, group_msg(GroupId, Author, Text))|NetIn], Outs, Holdings) :-
    ground(Id?), ground(GroupId?), ground(Author?), ground(Text?) |
    distribute_group_msg(GroupId?, msg(Author?, Author?, group_msg(GroupId?, Author?, Text?)), Outs?, Outs1),
    lookup_send(person, msg(agent, person, group_received(GroupId?, Author?, Text?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?).

%% A member left my group — close their hub-side entry.
agent(Id, UserIn, [msg(Member, _, group_leave(GroupId, Member1))|NetIn], Outs, Holdings) :-
    ground(Id?), ground(GroupId?), ground(Member?), Member? =?= Member1? |
    close_output(group_member(GroupId?, Member?), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?).

%% The creator removed me from a group — close my member entry, tell the person.
agent(Id, UserIn, [msg(_, _, group_removed(GroupId))|NetIn], Outs, Holdings) :-
    ground(Id?), ground(GroupId?) |
    close_output(group(GroupId?), Outs?, Outs1),
    lookup_send(person, msg(agent, person, group_removed(GroupId?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?).

%% Network catch-all (drop unrecognised network message).
agent(Id, UserIn, [_|NetIn], Outs, Holdings) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?).

%% --- Reactive: responder answers and injected results on UserIn (UserIn does
%% not carry the person's commands — those are grants; it carries the answers
%% the responders inject and the results injected by inject_msg and
%% inject_swap_result) ---

%% The person answered a friend offer (injected by respond_coldcall).
agent(Id, [decision(Dec, From, response(Resp?))|UserIn], NetIn, Outs, Holdings) :-
    bind_response(Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?).

%% The person accepted a swap offer (injected by respond_swap): give the
%% want-coins, take the give-coins.
agent(Id, [accept_swap(From, GiveCoin, GiveAmt, WantCoin, WantAmt, SwapResp?)|UserIn], NetIn, Outs, Holdings) :-
    ground(From?), ground(GiveCoin?), integer(GiveAmt?), ground(WantCoin?), integer(WantAmt?) |
    sub_coin(WantCoin?, WantAmt?, Holdings?, Status, Holdings1),
    do_accept_swap(Status?, Id?, From?, GiveCoin?, GiveAmt?, Holdings1?, SwapResp, UserIn?, NetIn?, Outs?).

%% The person declined a swap offer.
agent(Id, [decline_swap(From, SwapResp?)|UserIn], NetIn, Outs, Holdings) :-
    ground(From?) |
    bind_swap_decline(SwapResp),
    lookup_send(person, msg(agent, person, swap_failed(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?).

%% My cold call was answered (injected by inject_msg).
agent(Id, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs, Holdings) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?).

%% Proposer: my swap was accepted — take the want-coins.
agent(Id, [swap_accepted(From, WantCoin, WantAmt)|UserIn], NetIn, Outs, Holdings) :-
    ground(Id?), ground(From?), ground(WantCoin?), integer(WantAmt?) |
    add_coin(WantCoin?, WantAmt?, Holdings?, Holdings1),
    lookup_send(person, msg(agent, person, swap_done(From?)), Outs?, Outs1),
    after_change(Id?, Holdings1?, UserIn?, NetIn?, Outs1?).

%% Proposer: my swap was declined — refund the give-coins.
agent(Id, [swap_declined(From, GiveCoin, GiveAmt)|UserIn], NetIn, Outs, Holdings) :-
    ground(Id?), ground(From?), ground(GiveCoin?), integer(GiveAmt?) |
    add_coin(GiveCoin?, GiveAmt?, Holdings?, Holdings1),
    lookup_send(person, msg(agent, person, swap_failed(From?)), Outs?, Outs1),
    after_change(Id?, Holdings1?, UserIn?, NetIn?, Outs1?).

%% The person accepted a group invitation (injected by respond_group_invite):
%% await the group channel from the hub.
agent(Id, [accept_group(GroupId, ChRead)|UserIn], NetIn, Outs, Holdings) :-
    ground(Id?), ground(GroupId?) |
    await_group_channel(Id?, GroupId?, ChRead?, UserIn?, NetIn?, Outs?, Holdings?).

%% Injected group_join_ack (by inject_group_result): creator wires the member's
%% hub side and hands over the member's group channel.
agent(Id, [group_join_ack(GroupId, Invitee, ch(_, [group_channel(MemberEnd?)|[]]))|UserIn], NetIn, Outs, Holdings) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    setup_group_hub_side(GroupId?, Invitee?, Outs?, Outs1, NetIn?, NetIn1, MemberEnd),
    lookup_send(person, msg(agent, person, group_joined_member(GroupId?, Invitee?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, Holdings?).

%% Injected group_join_nack — nothing to do.
agent(Id, [group_join_nack(_, _)|UserIn], NetIn, Outs, Holdings) :-
    ground(Id?) |
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?).

%% Injection catch-all (drop unrecognised injected message).
agent(Id, [_|UserIn], NetIn, Outs, Holdings) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?).

%% --- Volitional: coin transactions the person originates ---
%% Request clauses, perpetually pending, placed after every otherwise clause
%% (remark "Ordering with otherwise"); each willing supplies the parameters.
%% Compiled form: UserCmds mint/1, balance/0, pay/3, redeem/2, propose_swap/5.

%% Mint K of my own coins.
*(K)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), integer(K?) |
    add_coin(Id?, K?, Holdings?, Holdings1),
    after_change(Id?, Holdings1?, UserIn?, NetIn?, Outs?).

%% Report current balances on demand.
*
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(Holdings?) |
    emit_balances(Id?, Holdings?, Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?).

%% Pay Amt of Coin to a friend.
*(Friend, Coin, Amt)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Friend?), ground(Coin?), integer(Amt?) |
    sub_coin(Coin?, Amt?, Holdings?, Status, Holdings1),
    do_pay(Status?, Id?, Friend?, Coin?, Amt?, Holdings1?, UserIn?, NetIn?, Outs?).

%% Redeem: return Amount of a friend's coins to them; the issuer fills back.
*(Friend, Amount)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Friend?), integer(Amount?) |
    sub_coin(Friend?, Amount?, Holdings?, Status, Holdings1),
    do_redeem(Status?, Id?, Friend?, Amount?, Holdings1?, UserIn?, NetIn?, Outs?).

%% Propose a swap: remove the give-coins, offer the swap to the friend.
*(Friend, GiveCoin, GiveAmt, WantCoin, WantAmt)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Friend?), ground(GiveCoin?), integer(GiveAmt?), ground(WantCoin?), integer(WantAmt?) |
    sub_coin(GiveCoin?, GiveAmt?, Holdings?, Status, Holdings1),
    do_propose_swap(Status?, Id?, Friend?, GiveCoin?, GiveAmt?, WantCoin?, WantAmt?, Holdings1?, UserIn?, NetIn?, Outs?).

%% --- Volitional: social transactions the person originates ---
%% Request clauses, placed after every otherwise clause likewise.
%% Compiled form: UserCmds connect/1, unfriend/1, send/2.

%% Offer friendship by cold call.
*(Target)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(Target?) |
    lookup_send('_net', msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?).

%% Unfriend (End friend): tear down the friend channel, sending a final
%% `unfriend` over it, and tell the person the friend is gone.
*(Friend)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(Friend?) |
    end_friend(Friend?, Id?, Outs?, Outs1),
    lookup_send(person, msg(agent, person, unfriended(Friend?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?).

%% Message a friend.
*(Target, Text)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(Target?) |
    lookup_send(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?).

%% --- Volitional: group transactions the person originates ---
%% Request clauses, placed after every otherwise clause likewise.
%% Compiled form: UserCmds create_group/1, invite_group/2, send_group/2,
%% leave_group/1, remove_from_group/2.

%% Create a group — set up the creator's hub-side link.
*(Name)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(Name?) |
    setup_group_creator(group_id(Id?, Name?), Outs?, Outs1, NetIn?, NetIn1),
    lookup_send(person, msg(agent, person, group_joined(group_id(Id?, Name?))), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, Holdings?).

%% Invite a friend to a group.
*(GroupId, Invitee)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(GroupId?), ground(Invitee?), new_channel(InviteeCh, CreatorCh) |
    lookup_send(Invitee?, msg(Id?, Invitee?, group_invite(GroupId?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Invitee?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?).

%% Post to a group — send on the member-to-hub channel.
*(GroupId, Text)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(GroupId?), ground(Text?) |
    lookup_send_group(group(GroupId?), msg(Id?, Id?, group_msg(GroupId?, Id?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?).

%% Leave a group.
*(GroupId)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(GroupId?) |
    lookup_send_group(group(GroupId?), msg(Id?, Id?, group_leave(GroupId?, Id?)), Outs?, Outs1),
    close_output(group(GroupId?), Outs1?, Outs2),
    lookup_send(person, msg(agent, person, group_left(GroupId?)), Outs2?, Outs3),
    agent(Id?, UserIn?, NetIn?, Outs3?, Holdings?).

%% Remove a member from an owned group.
*(GroupId, Member)
agent(Id, UserIn, NetIn, Outs, Holdings) :-
    ground(Id?), ground(GroupId?), ground(Member?) |
    lookup_send_group(group_member(GroupId?, Member?), msg(Id?, Member?, group_removed(GroupId?)), Outs?, Outs1),
    close_output(group_member(GroupId?, Member?), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?).

%% --- Termination ---

agent(_, [], _, Outs, _) :- close_outputs(Outs?).
agent(_, _, [], Outs, _) :- close_outputs(Outs?).
