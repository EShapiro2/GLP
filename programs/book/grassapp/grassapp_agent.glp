%% grassapp_agent.glp — GrassApp agent (agent/7): currencies among friends, with
%% the social graph (befriend) and one-to-one messaging.
%%
%% The typed social agent (cold-call befriending, friend channels, one-to-one
%% messaging) extended with MATURITY-AWARE holdings and the currency
%% transactions. Self contained: carries its own copies of the social helpers
%% (merge, lookup_send, inject_msg, bind_response, handle_response) so the
%% scenario loads without the social-graph modules.
%%
%% State is the spec pair (c_p, d*_p) plus a mint counter:
%%   Holdings   — multiset of bonds, Stream(Bond)   (c_p)
%%   NextSerial — next serial for minting
%%   Clock      — this agent's local current date   (d*_p), initially 0
%% A coin is a bond mature by THIS agent's own Clock; there is no global clock.
%%
%% The transaction predicates (create_bonds, append, select_bonds_by_spec,
%% select_matured_by_spec, classify_trade, build_menu) come from
%% currency_txn.glp and are called BARE (top-level, no module qualifier).


%% Output content: union of agent->mediator, friend-channel, and net contents.
OutputContent ::= befriend(Constant, Response?)
                ; connected(Constant)
                ; unfriended(Constant)
                ; rejected
                ; rejected(Constant)
                ; received(Constant, Constant)
                ; response(Response)
                ; text(Constant)
                ; intro(Constant, FriendChannel)
                ; balance_report(Constant, Constant, Constant, Integer)
                ; date_advanced(Constant)
                ; trade_proposed(Constant, Stream(Lot), TradeResponse?, Stream(Bond))
                ; trade_completed(Constant)
                ; trade_failed(Constant)
                ; trade_returned(Constant)
                ; trade_returned_menu(Constant, Stream(Bond))
                ; trade_propose(Stream(Lot), Stream(Bond), TradeResponse?)
                ; escrow_offer(Constant, Constant, Constant, Constant, EscrowBenResult)
                ; escrow_deposited(Constant, Constant, Constant, Constant, Constant, EscrowCancel?)
                ; escrow_received(Constant, Constant, Constant, Constant, Constant)
                ; escrow_released(Constant)
                ; escrow_cancelled(Constant)
                ; escrow_expired(Constant)
                ; escrow_returned(Constant)
                ; escrow_failed(Constant)
                ; coins(Stream(Bond))
                ; balances(Stream(Bond))
                ; group_invite(GroupId, Channel(Stream(GroupSetupResponse), Stream(Handshake)))
                ; group_joined(GroupId)
                ; group_joined_member(GroupId, Constant)
                ; group_left(GroupId)
                ; group_removed(GroupId)
                ; group_received(GroupId, Constant, Constant)
                ; unfriend.
OutputMsg     ::= msg(Constant, Constant, OutputContent)
                ; msg(Constant, NetColdCall).
OutputStream  ::= [] ; [OutputMsg | OutputStream].

%% Output entries: the keyed one-to-one/friend/user/net streams, plus group
%% channels keyed by GroupKey (the member's own hub link, or a member entry the
%% creator distributes to), carrying GroupMsg.
OutputEntry ::= output(Constant, OutputStream?)
              ; group_entry(GroupKey, Stream(GroupMsg)?).
OutputsList ::= [] ; [OutputEntry|OutputsList].

%% =============================================================================
%% CHANNEL OPERATIONS / MERGE / ROUTING (holdings-agnostic)
%% =============================================================================

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

procedure lookup_send(Constant?, OutputMsg?, OutputsList?, OutputsList).
lookup_send(Key, Msg, Outs, Outs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Outs?, Outs1).

procedure lookup_send_step(Constant?, OutputMsg?, OutputsList?, OutputsList).
lookup_send_step(Key, Msg, [output(K, [Msg?|Out1?])|Rest], [output(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [group_entry(GK, Out?)|Rest], [group_entry(GK?, Out)|Rest1?]) :-
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(Key, Msg, [output(K, Out?)|Rest], [output(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

procedure inject_msg(Response?, Constant?, Constant?, Stream(X)?, Stream(X)).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

procedure add_output(Constant?, OutputStream, OutputsList?, OutputsList).
add_output(Name, Out?, Outs, [output(Name?, Out)|Outs?]).

procedure close_outputs(OutputsList?).
close_outputs([output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([group_entry(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([]).

%% =============================================================================
%% RESPONSE HANDLING (holdings-agnostic; does not call agent)
%% =============================================================================

procedure bind_response(Decision?, Constant?, Response, OutputsList?, OutputsList, Stream(X)?, Stream(X)).
bind_response(yes, From, accept(RetCh?), Outs, Outs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Outs?, Outs1, In?, In1).
bind_response(no, _, no, Outs, Outs1?, In, In?) :-
    lookup_send('_user', msg(agent, '_user', rejected), Outs?, Outs1).

procedure handle_response(Response?, Constant?, OutputsList?, OutputsList, Stream(X)?, Stream(X)).
handle_response(accept(ch(FIn, FOut?)), From, Outs, Outs2?, In, In1?) :-
    ground(From?) |
    add_output(From?, FOut, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', connected(From?)), Outs1?, Outs2),
    merge(In?, FIn?, In1).
handle_response(no, From, Outs, Outs1?, In, In?) :-
    ground(From?) |
    lookup_send('_user', msg(agent, '_user', rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% UNFRIEND (paper §4: End friend / Integrate unfriend)
%% =============================================================================

procedure end_friend(Constant?, Constant?, OutputsList?, OutputsList).
end_friend(Key, Id, [output(K, [msg(Id?, Key?, unfriend)])|Rest], Rest?) :-
    Key? =?= K? | true.
end_friend(Key, Id, [group_entry(GK, Out?)|Rest], [group_entry(GK?, Out)|Rest1?]) :-
    end_friend(Key?, Id?, Rest?, Rest1).
end_friend(Key, Id, [output(K, Out?)|Rest], [output(K?, Out)|Rest1?]) :-
    otherwise |
    end_friend(Key?, Id?, Rest?, Rest1).
end_friend(_, _, [], []).

procedure drop_friend(Constant?, OutputsList?, OutputsList).
drop_friend(Key, [output(K, [])|Rest], Rest?) :-
    Key? =?= K? | true.
drop_friend(Key, [group_entry(GK, Out?)|Rest], [group_entry(GK?, Out)|Rest1?]) :-
    drop_friend(Key?, Rest?, Rest1).
drop_friend(Key, [output(K, Out?)|Rest], [output(K?, Out)|Rest1?]) :-
    otherwise |
    drop_friend(Key?, Rest?, Rest1).
drop_friend(_, [], []).

%% =============================================================================
%% BALANCES — tally the bond multiset by (issuer, maturity)
%% =============================================================================

%% Count holdings per (Issuer, Maturity) as a Lot list, so the wallet can split
%% cash (mature by this agent's Clock) from loans (still dated).
procedure tally_bonds(Stream(Bond)?, Stream(Lot)?, Stream(Lot)).
tally_bonds([bond(I, M, _)|Rest], Acc, Tally?) :-
    ground(I?), ground(M?) |
    tally_add(I?, M?, Acc?, Acc1),
    tally_bonds(Rest?, Acc1?, Tally).
tally_bonds([], Acc, Acc?).

procedure tally_add(Constant?, Constant?, Stream(Lot)?, Stream(Lot)).
tally_add(I, M, [lot(I2, M2, N)|Rest], [lot(I2?, M2?, N1?)|Rest?]) :-
    I? =?= I2?, M? =?= M2? | N1 := N? + 1.
tally_add(I, M, [L|Rest], [L?|Rest1?]) :-
    otherwise |
    tally_add(I?, M?, Rest?, Rest1).
tally_add(I, M, [], [lot(I?, M?, 1)]).

procedure emit_tally(Constant?, Stream(Lot)?, OutputsList?, OutputsList).
emit_tally(Self, [lot(I, M, N)|Rest], Outs, Outs2?) :-
    ground(Self?), ground(I?), ground(M?), ground(N?) |
    lookup_send('_user', msg(agent, '_user', balance_report(Self?, I?, M?, N?)), Outs?, Outs1),
    emit_tally(Self?, Rest?, Outs1?, Outs2).
emit_tally(_, [], Outs, Outs?).

%% Emit one balance_report(Owner, Issuer, Maturity, Count) per held position.
procedure emit_balances(Constant?, Stream(Bond)?, OutputsList?, OutputsList).
emit_balances(Self, Holdings, Outs, Outs1?) :-
    ground(Self?), ground(Holdings?) |
    tally_bonds(Holdings?, [], Tally),
    emit_tally(Self?, Tally?, Outs?, Outs1).

%% Publish my holdings to every friend (so their wallet shows my currency).
%% '_user'/'_net' outputs pass through untouched; any other key is a friend.
procedure publish_balances(Constant?, Stream(Bond)?, OutputsList?, OutputsList).
publish_balances(Self, Holdings, [output('_user', S?)|Rest], [output('_user', S)|Rest1?]) :-
    ground(Self?), ground(Holdings?) |
    publish_balances(Self?, Holdings?, Rest?, Rest1).
publish_balances(Self, Holdings, [output('_net', S?)|Rest], [output('_net', S)|Rest1?]) :-
    ground(Self?), ground(Holdings?) |
    publish_balances(Self?, Holdings?, Rest?, Rest1).
publish_balances(Self, Holdings, [group_entry(GK, S?)|Rest], [group_entry(GK?, S)|Rest1?]) :-
    ground(Self?), ground(Holdings?) |
    publish_balances(Self?, Holdings?, Rest?, Rest1).
publish_balances(Self, Holdings,
    [output(K, [msg(Self?, K?, balances(Holdings?))|S1?])|Rest],
    [output(K?, S1)|Rest1?]) :-
    ground(Self?), ground(Holdings?), ground(K?), otherwise |
    publish_balances(Self?, Holdings?, Rest?, Rest1).
publish_balances(_, _, [], []).

%% After a holdings change: report balances to the user, publish to friends,
%% then continue.
procedure after_change(Constant?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
after_change(Id, Holdings, NextSerial, Clock, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Holdings?) |
    emit_balances(Id?, Holdings?, Outs?, Outs1),
    publish_balances(Id?, Holdings?, Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?, NextSerial?, Clock?).

%% =============================================================================
%% TRADE / REDEEM / PAY — the transaction two-phase (currency_txn called bare)
%% =============================================================================

procedure bind_trade_decline(TradeResponse, Stream(Bond)?).
bind_trade_decline(trade_decline(Bonds?), Bonds).

%% Watch the proposer's trade-response writer; inject the settlement into UserIn.
procedure inject_trade_result(TradeResponse?, Constant?, Stream(X)?, Stream(X)).
inject_trade_result(trade_accept(TheirBonds), From, Ys,
    [trade_complete(From?, TheirBonds?)|Ys?]) :-
    ground(From?), ground(TheirBonds?) | true.
inject_trade_result(trade_decline(OurBonds), From, Ys,
    [trade_returned_bonds(From?, OurBonds?)|Ys?]) :-
    ground(From?), ground(OurBonds?) | true.
inject_trade_result(trade_decline_menu(OurBonds, Menu), From, Ys,
    [trade_returned_bonds_menu(From?, OurBonds?, Menu?)|Ys?]) :-
    ground(From?), ground(OurBonds?), ground(Menu?) | true.
inject_trade_result(R, From, [Y|Ys], [Y?|Ys1?]) :-
    inject_trade_result(R?, From?, Ys?, Ys1).

%% --- Proposer: trade (the maturity-carrying swap; a loan is its instance) ---

procedure do_trade(Constant?, Constant?, Stream(Lot)?, Stream(Lot)?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
do_trade(Id, Target, GiveSpec, WantSpec, Holdings, NextSerial, Clock, UserIn, NetIn, Outs) :-
    select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_trade_result(Status?, Id?, Target?, WantSpec?, Selected?, Remaining?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

procedure do_trade_result(Constant?, Constant?, Constant?, Stream(Lot)?, Stream(Bond)?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
do_trade_result(ok, Id, Target, WantSpec, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    lookup_send(Target?, msg(Id?, Target?, trade_propose(WantSpec?, Selected?, TradeResp)), Outs?, Outs1),
    inject_trade_result(TradeResp?, Target?, UserIn?, UserIn1),
    after_change(Id?, Remaining?, NextSerial?, Clock?, UserIn1?, NetIn?, Outs1?).
do_trade_result(fail, Id, Target, _, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', trade_failed(Target?)), Outs?, Outs1),
    after_change(Id?, OrigHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% --- Proposer: redeem (Def. 2.5, guarded by the HOLDER) ---
%% Present the Target's coins mature by our own Clock (d' =< d*_p); the issuer
%% must fulfil and auto-accepts (classify_trade -> redemption).

procedure do_redeem(Constant?, Constant?, Stream(Lot)?, Stream(Lot)?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
do_redeem(Id, Target, GiveSpec, WantSpec, Holdings, NextSerial, Clock, UserIn, NetIn, Outs) :-
    select_matured_by_spec(GiveSpec?, Target?, Clock?, Holdings?, Status, Selected, Remaining),
    do_trade_result(Status?, Id?, Target?, WantSpec?, Selected?, Remaining?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% --- Proposer: pay (mature coins of the payee, handed over unilaterally) ---

procedure do_pay(Constant?, Constant?, Constant?, Stream(Bond)?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
do_pay(ok, Id, Friend, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    lookup_send(Friend?, msg(Id?, Friend?, coins(Selected?)), Outs?, Outs1),
    after_change(Id?, Remaining?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).
do_pay(fail, Id, Friend, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', trade_failed(Friend?)), Outs?, Outs1),
    after_change(Id?, OrigHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% --- Responder: fill an accepted trade ---

procedure handle_trade_fill(Constant?, Constant?, Constant?, TradeResponse, Stream(Bond)?, Stream(Bond)?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
handle_trade_fill(ok, Id, From, trade_accept(Selected?), OfferedBonds, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Remaining?, OfferedBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_completed(From?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).
handle_trade_fill(fail, Id, From, trade_decline(OfferedBonds?), OfferedBonds, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', trade_failed(From?)), Outs?, Outs1),
    after_change(Id?, OrigHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% --- Responder: classify an incoming proposal ---

procedure trade_dispatch(Constant?, Constant?, Constant?, Stream(Lot)?, Stream(Bond)?, TradeResponse,
    Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).

%% Payment — auto-accept (proposer gives, wants nothing).
trade_dispatch(payment, Id, From, _, OfferedBonds, trade_accept([]),
    Holdings, NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Holdings?, OfferedBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_completed(From?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% Redemption — the issuer must fulfil: auto-accept with the requested bonds,
%% or decline with a menu of what it does hold.
trade_dispatch(redemption, Id, From, WantSpec, OfferedBonds, TradeResp?,
    Holdings, NextSerial, Clock, UserIn, NetIn, Outs) :-
    select_bonds_by_spec(WantSpec?, Holdings?, Status, Selected, Remaining),
    redemption_result(Status?, Id?, From?, TradeResp, OfferedBonds?, Selected?, Remaining?,
        NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% Normal trade — present to the user as an inbox offer (forwarding the writer).
trade_dispatch(normal, Id, From, WantSpec, OfferedBonds, TradeResp?,
    Holdings, NextSerial, Clock, UserIn, NetIn, Outs) :-
    lookup_send('_user',
        msg(agent, '_user', trade_proposed(From?, WantSpec?, TradeResp, OfferedBonds?)),
        Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

procedure redemption_result(Constant?, Constant?, Constant?, TradeResponse, Stream(Bond)?,
    Stream(Bond)?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
redemption_result(ok, Id, From, trade_accept(Selected?), OfferedBonds, Selected, Remaining,
    NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Remaining?, OfferedBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_completed(From?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).
redemption_result(fail, Id, From, trade_decline_menu(OfferedBonds?, Menu?), OfferedBonds,
    Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Selected?, Remaining?, OrigHoldings),
    redemption_reject(Id?, From?, OrigHoldings?, Menu, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

procedure redemption_reject(Constant?, Constant?, Stream(Bond)?, Stream(Bond),
    Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
redemption_reject(Id, From, OrigHoldings, Menu?, NextSerial, Clock, UserIn, NetIn, Outs) :-
    ground(OrigHoldings?) |
    build_menu(Id?, OrigHoldings?, Menu),
    lookup_send('_user', msg(agent, '_user', trade_failed(From?)), Outs?, Outs1),
    after_change(Id?, OrigHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% =============================================================================
%% ESCROW (paper §5) — a race between the release timer and the cancel signal
%% =============================================================================

%% Whichever guard commits first decides: the timer releases the bonds to the
%% beneficiary and reports expiry to the depositor; the cancel returns them to
%% the depositor and reports cancellation to the beneficiary.  wait_until is REAL
%% time — the agent's local date (advance_date) governs maturity, not escrow.
procedure escrow(Constant?, Stream(Bond)?, EscrowCancel?, EscrowBenResult, EscrowDepResult).
escrow(T, Bonds, _, escrow_bonds(Bonds?), escrow_expired) :-
    wait_until(T?) | true.
escrow(_, Bonds, cancel, escrow_cancelled, escrow_bonds(Bonds?)).

procedure bind_escrow_cancel(EscrowCancel).
bind_escrow_cancel(cancel).

%% Watch the beneficiary's outcome writer; inject the settlement into UserIn.
procedure inject_escrow_ben_result(EscrowBenResult?, Constant?, Stream(X)?, Stream(X)).
inject_escrow_ben_result(escrow_bonds(Bonds), From, Ys,
    [escrow_ben_released(From?, Bonds?)|Ys?]) :-
    ground(From?), ground(Bonds?) | true.
inject_escrow_ben_result(escrow_cancelled, From, Ys,
    [escrow_ben_cancelled(From?)|Ys?]) :-
    ground(From?) | true.
inject_escrow_ben_result(R, From, [Y|Ys], [Y?|Ys1?]) :-
    inject_escrow_ben_result(R?, From?, Ys?, Ys1).

%% Watch the depositor's outcome writer; inject the settlement into UserIn.
procedure inject_escrow_dep_result(EscrowDepResult?, Constant?, Stream(X)?, Stream(X)).
inject_escrow_dep_result(escrow_bonds(Bonds), Target, Ys,
    [escrow_dep_returned(Target?, Bonds?)|Ys?]) :-
    ground(Target?), ground(Bonds?) | true.
inject_escrow_dep_result(escrow_expired, Target, Ys,
    [escrow_dep_expired(Target?)|Ys?]) :-
    ground(Target?) | true.
inject_escrow_dep_result(R, Target, [Y|Ys], [Y?|Ys1?]) :-
    inject_escrow_dep_result(R?, Target?, Ys?, Ys1).

%% The escrowed bonds leave Holdings, so no balance_report can describe them.
%% Both sides therefore carry the lot scalars, and the wallet can show what is
%% locked (Grassroots-Bonds §5; the Escrow section of the Currencies panel).
procedure lot_scalars(Stream(Lot)?, Constant, Constant, Constant).
lot_scalars([lot(I, M, A) | _], I?, M?, A?).

%% Depositor: select the bonds, then open the escrow (or report failure).
procedure do_deposit_escrow(Constant?, Constant?, Stream(Lot)?, Constant?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
do_deposit_escrow(Id, Target, GiveSpec, ReleaseTime, Holdings, NextSerial, Clock, UserIn, NetIn, Outs) :-
    ground(GiveSpec?) |
    lot_scalars(GiveSpec?, Coin, Maturity, Amount),
    select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_deposit_escrow_result(Status?, Id?, Target?, ReleaseTime?, Coin?, Maturity?, Amount?, Selected?, Remaining?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

procedure do_deposit_escrow_result(Constant?, Constant?, Constant?, Constant?, Constant?, Constant?, Constant?, Stream(Bond)?, Stream(Bond)?, Constant?, Constant?, Stream(X)?, Stream(X)?, OutputsList?).
do_deposit_escrow_result(ok, Id, Target, ReleaseTime, Coin, Maturity, Amount, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    ground(Coin?), ground(Maturity?), ground(Amount?) |
    escrow(ReleaseTime?, Selected?, CancelSignal?, BenResult, DepResult),
    inject_escrow_dep_result(DepResult?, Target?, UserIn?, UserIn1),
    lookup_send(Target?,
        msg(Id?, Target?, escrow_offer(ReleaseTime?, Coin?, Maturity?, Amount?, BenResult?)),
        Outs?, Outs1),
    lookup_send('_user',
        msg(agent, '_user', escrow_deposited(Target?, ReleaseTime?, Coin?, Maturity?, Amount?, CancelSignal)),
        Outs1?, Outs2),
    after_change(Id?, Remaining?, NextSerial?, Clock?, UserIn1?, NetIn?, Outs2?).
do_deposit_escrow_result(fail, Id, Target, _, _, _, _, Selected, Remaining, NextSerial, Clock, UserIn, NetIn, Outs) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', escrow_failed(Target?)), Outs?, Outs1),
    after_change(Id?, OrigHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% =============================================================================
%% GROUP HELPERS (paper §7.2 Social Network) — grassapp output model
%% =============================================================================

procedure add_group_output(GroupKey?, Stream(GroupMsg), OutputsList?, OutputsList).
add_group_output(Key, Out?, Outs, [group_entry(Key?, Out)|Outs?]).

procedure setup_group_creator(GroupId?, OutputsList?, OutputsList, Stream(X)?, Stream(X)).
setup_group_creator(GroupId, Outs, Outs1?, NetIn, NetIn1?) :-
    ground(GroupId?) |
    add_group_output(group(GroupId?), MemberToHub, Outs?, Outs1),
    merge(NetIn?, MemberToHub?, NetIn1).

procedure setup_group_hub_side(GroupId?, Constant?, OutputsList?, OutputsList, Stream(X)?, Stream(X), Channel(Stream(GroupMsg), Stream(GroupMsg))).
setup_group_hub_side(GroupId, Member, Outs, Outs1?, NetIn, NetIn1?,
        ch(HubToMember?, MemberToHub)) :-
    ground(GroupId?), ground(Member?) |
    add_group_output(group_member(GroupId?, Member?), HubToMember, Outs?, Outs1),
    merge(NetIn?, MemberToHub?, NetIn1).

procedure lookup_send_group(GroupKey?, GroupMsg?, OutputsList?, OutputsList).
lookup_send_group(Key, Msg, Outs, Outs1?) :-
    ground(Key?) |
    lookup_send_group_step(Key?, Msg?, Outs?, Outs1).

procedure lookup_send_group_step(GroupKey?, GroupMsg?, OutputsList?, OutputsList).
lookup_send_group_step(Key, Msg, [group_entry(K, [Msg?|Out1?])|Rest], [group_entry(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_group_step(Key, Msg, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    lookup_send_group_step(Key?, Msg?, Rest?, Rest1).
lookup_send_group_step(_, _, [], []).

procedure distribute_group_msg(GroupId?, GroupMsg?, OutputsList?, OutputsList).
distribute_group_msg(GroupId, Msg,
    [group_entry(group_member(GId, M), [Msg?|Out1?])|Rest],
    [group_entry(group_member(GId?, M?), Out1)|Rest1?]) :-
    GroupId? =?= GId?, ground(Msg?) |
    distribute_group_msg(GroupId?, Msg?, Rest?, Rest1).
distribute_group_msg(GroupId, Msg, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    distribute_group_msg(GroupId?, Msg?, Rest?, Rest1).
distribute_group_msg(_, _, [], []).

procedure close_output(GroupKey?, OutputsList?, OutputsList).
close_output(_, [], []).
close_output(Key, [group_entry(K, [])|Rest], Rest?) :-
    Key? =?= K? | true.
close_output(Key, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    close_output(Key?, Rest?, Rest1).

procedure group_await_join(GroupId?, Constant?, Channel(Stream(Handshake), Stream(GroupSetupResponse))?, GroupJoinResult).
group_await_join(GroupId, Invitee, ch([ack(_)|ChIn], ChOut?),
                 group_join_ack(GroupId?, Invitee?, ch(ChIn?, ChOut))).
group_await_join(GroupId, Invitee, ch([nack|_], []),
                 group_join_nack(GroupId?, Invitee?)).

procedure inject_group_result(GroupJoinResult?, Stream(X)?, Stream(X)).
inject_group_result(group_join_ack(G, I, Ch), Ys,
    [group_join_ack(G?, I?, Ch?)|Ys?]) :-
    ground(I?) | true.
inject_group_result(group_join_nack(G, I), Ys,
    [group_join_nack(G?, I?)|Ys?]) :-
    ground(I?) | true.
inject_group_result(Res, [Y|Ys], [Y?|Ys1?]) :-
    inject_group_result(Res?, Ys?, Ys1).

procedure await_group_channel(Constant?, GroupId?, Stream(GroupSetupResponse)?, Stream(X)?, Stream(X)?, OutputsList?, Stream(Bond)?, Constant?, Constant?).
await_group_channel(Id, GroupId, [group_channel(ch(FromHub, ToHub?))|_],
        UserIn, NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(GroupId?) |
    add_group_output(group(GroupId?), ToHub, Outs?, Outs1),
    merge(NetIn?, FromHub?, NetIn1),
    lookup_send('_user', msg(agent, '_user', group_joined(GroupId?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, Holdings?, NextSerial?, Clock?).
await_group_channel(_, _, [], _, _, _, _, _, _) :- true.

%% =============================================================================
%% AGENT/7
%% =============================================================================

procedure agent(Constant?, Stream(X)?, Stream(X)?, OutputsList?, Stream(Bond)?, Constant?, Constant?).

%% --- Currency transactions ---

%% Mint K bonds of my own at Maturity (Maturity 0 = cash).
agent(Id, [msg('_user', Id1, mint(K, Maturity))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(K?), ground(Maturity?) |
    NewNextSerial := NextSerial? + K?,
    create_bonds(Id?, Maturity?, K?, NextSerial?, NewBonds),
    append(Holdings?, NewBonds?, NewHoldings),
    after_change(Id?, NewHoldings?, NewNextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% Advance my local date (Def. 2 item 2, unguarded): d*' > d*, holdings
%% unchanged.  Local time advances by the calendar; there is no global clock.
agent(Id, [msg('_user', Id1, advance_date(D))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(D?), D? > Clock? |
    lookup_send('_user', msg(agent, '_user', date_advanced(D?)), Outs?, Outs1),
    after_change(Id?, Holdings?, NextSerial?, D?, UserIn?, NetIn?, Outs1?).

%% Report current balances on demand.
agent(Id, [msg('_user', Id1, balance)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Holdings?) |
    emit_balances(Id?, Holdings?, Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

%% Pay: hand a friend bonds of any issuer (the general GrassApp transfer).
%%
%% DEVIATION (recorded): Def. 2 item 4 restricts Pay to *coins* — bonds mature by
%% the payer's own clock.  select_matured_by_spec cannot express that here: it
%% also pins the issuer to the counterparty, which is right for Redeem (you
%% present the issuer's own coins back) but wrong for Pay, whose spec is
%% "give a friend coins of any issuer".  Maturity-gating Pay needs a
%% maturity-only, issuer-free selection in the transaction core; that is an M2
%% item.  Until then Pay behaves exactly as it did before the bond rebuild
%% (no maturity condition), so this is not a regression — only an un-tightened
%% guard.
agent(Id, [msg('_user', Id1, pay(Friend, GiveSpec))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Friend?), ground(GiveSpec?) |
    select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_pay(Status?, Id?, Friend?, Selected?, Remaining?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% Trade: the maturity-carrying swap (a loan is its instance).
agent(Id, [msg('_user', Id1, trade(Target, GiveSpec, WantSpec))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    do_trade(Id?, Target?, GiveSpec?, WantSpec?, Holdings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% Redeem: present the Target's matured coins; the issuer must fulfil.
agent(Id, [msg('_user', Id1, redeem(Target, GiveSpec, WantSpec))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    do_redeem(Id?, Target?, GiveSpec?, WantSpec?, Holdings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% Accept a trade a friend proposed: give the want-bonds, take the offered ones.
agent(Id, [msg('_user', Id1, accept_trade(From, trade_pending(TradeResp?, WantSpec, OfferedBonds)))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    select_bonds_by_spec(WantSpec?, Holdings?, Status, Selected, Remaining),
    handle_trade_fill(Status?, Id?, From?, TradeResp, OfferedBonds?, Selected?, Remaining?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% Reject a trade a friend proposed.
agent(Id, [msg('_user', Id1, reject_trade(From, trade_pending(TradeResp?, _, OfferedBonds)))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(From?), ground(OfferedBonds?) |
    bind_trade_decline(TradeResp, OfferedBonds?),
    lookup_send('_user', msg(agent, '_user', trade_failed(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

%% Proposer: my trade was accepted — take the bonds they gave.
agent(Id, [trade_complete(From, TheirBonds)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(From?), ground(TheirBonds?) |
    append(Holdings?, TheirBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_completed(From?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% Proposer: my trade was declined — take my bonds back.
agent(Id, [trade_returned_bonds(From, OurBonds)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(From?), ground(OurBonds?) |
    append(Holdings?, OurBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_returned(From?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% Proposer: redemption declined with a menu of what the issuer holds.
agent(Id, [trade_returned_bonds_menu(From, OurBonds, Menu)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(From?), ground(OurBonds?), ground(Menu?) |
    append(Holdings?, OurBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_returned_menu(From?, Menu?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% --- Escrow: depositor side (paper §5) ---

%% Lock bonds for Target until ReleaseTime; cancellable until then.
agent(Id, [msg('_user', Id1, deposit_escrow(Target, GiveSpec, ReleaseTime))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(ReleaseTime?) |
    do_deposit_escrow(Id?, Target?, GiveSpec?, ReleaseTime?, Holdings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% Cancel before the release time — binding the signal wins the race.
agent(Id, [msg('_user', Id1, cancel_escrow(_, escrow_pending(CancelSignal?)))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1? |
    bind_escrow_cancel(CancelSignal),
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?).

%% The timer won: the bonds went to the beneficiary.
agent(Id, [escrow_dep_expired(Target)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(Target?) |
    lookup_send('_user', msg(agent, '_user', escrow_expired(Target?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

%% The cancel won: the bonds come home.
agent(Id, [escrow_dep_returned(Target, OurBonds)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(Target?), ground(OurBonds?) |
    append(Holdings?, OurBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', escrow_returned(Target?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% --- Escrow: beneficiary side (paper §5) ---

%% Released: take the bonds.
agent(Id, [escrow_ben_released(From, Bonds)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(From?), ground(Bonds?) |
    append(Holdings?, Bonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', escrow_released(From?)), Outs?, Outs1),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs1?).

%% The depositor cancelled.
agent(Id, [escrow_ben_cancelled(From)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(From?) |
    lookup_send('_user', msg(agent, '_user', escrow_cancelled(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

%% --- Social: user messages ---

agent(Id, [msg('_user', Id1, connect(Target))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send('_net', msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, unfriend(Friend))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Friend?) |
    end_friend(Friend?, Id?, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', unfriended(Friend?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, decision(Dec, From, response(Resp?)))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, send(Target, Text))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?, NextSerial?, Clock?).

%% --- Groups: user-originated (paper §7.2) ---

agent(Id, [msg('_user', Id1, create_group(Name))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Name?) |
    setup_group_creator(group_id(Id?, Name?), Outs?, Outs1, NetIn?, NetIn1),
    lookup_send('_user', msg(agent, '_user', group_joined(group_id(Id?, Name?))), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, invite_group(GroupId, Invitee))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(GroupId?), ground(Invitee?), new_channel(InviteeCh, CreatorCh) |
    lookup_send(Invitee?, msg(Id?, Invitee?, group_invite(GroupId?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Invitee?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, accept_group(GroupId, group_channel(ch(ChRead, [ack(Id?)|[]]))))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(GroupId?) |
    await_group_channel(Id?, GroupId?, ChRead?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, reject_group(_, group_channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?).

agent(Id, [group_join_ack(GroupId, Invitee, ch(_, [group_channel(MemberEnd?)|[]]))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    setup_group_hub_side(GroupId?, Invitee?, Outs?, Outs1, NetIn?, NetIn1, MemberEnd),
    lookup_send('_user', msg(agent, '_user', group_joined_member(GroupId?, Invitee?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, Holdings?, NextSerial?, Clock?).

agent(Id, [group_join_nack(_, _)|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?) |
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, send_group(GroupId, Text))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(GroupId?), ground(Text?) |
    lookup_send_group(group(GroupId?), msg(Id?, Id?, group_msg(GroupId?, Id?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, leave_group(GroupId))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(GroupId?) |
    lookup_send_group(group(GroupId?), msg(Id?, Id?, group_leave(GroupId?, Id?)), Outs?, Outs1),
    close_output(group(GroupId?), Outs1?, Outs2),
    lookup_send('_user', msg(agent, '_user', group_left(GroupId?)), Outs2?, Outs3),
    agent(Id?, UserIn?, NetIn?, Outs3?, Holdings?, NextSerial?, Clock?).

agent(Id, [msg('_user', Id1, remove_from_group(GroupId, Member))|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(GroupId?), ground(Member?) |
    lookup_send_group(group_member(GroupId?, Member?), msg(Id?, Member?, group_removed(GroupId?)), Outs?, Outs1),
    close_output(group_member(GroupId?, Member?), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?, NextSerial?, Clock?).

%% User catch-all (drop unrecognised user message).
agent(Id, [_|UserIn], NetIn, Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?).

%% --- Social: network messages ---

agent(Id, UserIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', befriend(From?, Resp)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

%% A friend pays me: take the coins, re-report.
agent(Id, UserIn, [msg(_, Id1, coins(Bonds))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(Bonds?) |
    append(Holdings?, Bonds?, NewHoldings),
    after_change(Id?, NewHoldings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% A friend proposes a trade (or presents my own bonds for redemption).
agent(Id, UserIn, [msg(From, Id1, trade_propose(WantSpec, OfferedBonds, TradeResp?))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    classify_trade(Id?, WantSpec?, OfferedBonds?, TradeClass),
    trade_dispatch(TradeClass?, Id?, From?, WantSpec?, OfferedBonds?, TradeResp,
        Holdings?, NextSerial?, Clock?, UserIn?, NetIn?, Outs?).

%% A friend opened an escrow for me: watch its outcome, tell the user.
agent(Id, UserIn, [msg(From, Id1, escrow_offer(ReleaseTime, Coin, Maturity, Amount, BenResult))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(From?), ground(ReleaseTime?),
    ground(Coin?), ground(Maturity?), ground(Amount?) |
    inject_escrow_ben_result(BenResult?, From?, UserIn?, UserIn1),
    lookup_send('_user',
        msg(agent, '_user', escrow_received(From?, ReleaseTime?, Coin?, Maturity?, Amount?)),
        Outs?, Outs1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

%% A friend unfriended me (paper §4 Integrate unfriend).
agent(Id, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(From?) |
    drop_friend(From?, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', unfriended(From?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?, NextSerial?, Clock?).

%% A friend publishes their holdings: surface them as that friend's balances.
agent(Id, UserIn, [msg(From, Id1, balances(FH))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(From?), ground(FH?) |
    emit_balances(From?, FH?, Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

%% --- Groups: network-arriving (paper §7.2) ---

agent(Id, UserIn, [msg(_, Id1, group_invite(GroupId, Ch))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    Id? =?= Id1?, ground(GroupId?) |
    lookup_send('_user', msg(agent, '_user', group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, UserIn, [msg(_, _, group_msg(GroupId, Author, Text))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(GroupId?), ground(Author?), ground(Text?) |
    distribute_group_msg(GroupId?, msg(Author?, Author?, group_msg(GroupId?, Author?, Text?)), Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', group_received(GroupId?, Author?, Text?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?, NextSerial?, Clock?).

agent(Id, UserIn, [msg(Member, _, group_leave(GroupId, Member1))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(GroupId?), ground(Member?), Member? =?= Member1? |
    close_output(group_member(GroupId?, Member?), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?, Clock?).

agent(Id, UserIn, [msg(_, _, group_removed(GroupId))|NetIn], Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), ground(GroupId?) |
    close_output(group(GroupId?), Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', group_removed(GroupId?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, Holdings?, NextSerial?, Clock?).

%% Network catch-all (drop unrecognised network message).
agent(Id, UserIn, [_|NetIn], Outs, Holdings, NextSerial, Clock) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?, Clock?).

%% --- Termination ---

agent(_, [], _, Outs, _, _, _) :- close_outputs(Outs?).
agent(_, _, [], Outs, _, _, _) :- close_outputs(Outs?).
