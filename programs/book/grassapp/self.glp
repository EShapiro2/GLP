%% self.glp — shared agent<->mediator protocol types for the Currencies app.
%%
%% Currencies among friends: the social-graph protocol (cold-call befriending,
%% friend channels, one-to-one messaging) EXTENDED with maturity-aware holdings
%% and the guarded transactions — mint, advance-date, pay, trade (the maturity-
%% carrying swap: a loan), redeem, and escrow — confined to the social graph.
%%
%% A currency unit is a BOND: bond(Issuer, Maturity, Serial).  A coin is a bond
%% mature by the HOLDER's own local clock (Def. 2: a bond of maturity d is a coin
%% at date t iff d =< t); a maturity-0 bond is a coin from the outset.  Holdings
%% are a multiset Stream(Bond).  Each agent carries its own local date — there is
%% no global clock.
%%
%% The transaction predicates over these types live in currency_txn.glp (the
%% top-level lift of the canonical programs/currencies/txn.glp).
%%
%% Polarity convention (typed-glp-manual §15B): a position that FORWARDS a
%% writer through a structure carries `?` in the type (cold-call Response, the
%% trade TradeResponse).


Decision ::= yes ; no.
Response ::= accept(FriendChannel) ; no.

%% A currency unit: a bond issued by Issuer, maturing at Maturity, serial Serial.
Bond ::= bond(Constant, Constant, Constant).

%% A trade line item: Count bonds of Issuer at Maturity.
Lot ::= lot(Constant, Constant, Constant).

%% A trade counterparty's answer (writer flows proposer -> responder -> proposer).
%% decline_menu returns the offered bonds plus the issuer's redemption menu.
TradeResponse ::= trade_accept(Stream(Bond))
                ; trade_decline(Stream(Bond))
                ; trade_decline_menu(Stream(Bond), Stream(Bond)).

%% Escrow (paper §5).  The depositor locks bonds until a release time and may
%% cancel until then; escrow/5 races the timer against the cancel signal and
%% whichever commits first decides the outcome.  The release is REAL time
%% (wait_until) — only bond maturity uses the agent's local date.
EscrowCancel    ::= cancel.
EscrowBenResult ::= escrow_bonds(Stream(Bond)) ; escrow_cancelled.
EscrowDepResult ::= escrow_bonds(Stream(Bond)) ; escrow_expired.

%% Friend-to-friend channel content. Beyond the social text/intro, friends carry
%% currency: a payment (mature coins), a holdings publish (so a friend's wallet
%% is visible), and the trade proposal that carries maturity per lot.  Redemption
%% reuses trade_propose — presenting the issuer's own bonds back to it.
FriendContent ::= response(Response)
                ; text(Constant)
                ; intro(Constant, FriendChannel?)
                ; coins(Stream(Bond))
                ; balances(Stream(Bond))
                ; trade_propose(Stream(Lot), Stream(Bond), TradeResponse?)
                ; escrow_offer(Constant, Constant, Constant, Constant, EscrowBenResult)
                ; group_invite(GroupId, Channel(Stream(GroupSetupResponse), Stream(Handshake)))
                ; group_msg(GroupId, Constant, Constant)
                ; group_leave(GroupId, Constant)
                ; group_removed(GroupId)
                ; unfriend.
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

%% --- Groups (paper §7.2 Social Network) -------------------------------------
%% A group is hosted by its creator; a group identifier is (creator, name).  The
%% invite conveys a fresh setup channel; the invitee acks and receives the group
%% channel on it (the same handshake shape as befriending).
GroupId   ::= group_id(Constant, Constant).
Handshake ::= ack(Constant) ; nack.

%% Group channel content — messages, a member leaving, a member removed.
GroupContent ::= group_msg(GroupId, Constant, Constant)
               ; group_leave(GroupId, Constant)
               ; group_removed(GroupId).
GroupMsg     ::= msg(Constant, Constant, GroupContent).

%% The setup channel conveys the group channel to a joining member.
GroupSetupResponse ::= group_channel(Channel(Stream(GroupMsg), Stream(GroupMsg))).

%% Group join result — written by group_await_join, injected into UserIn.
GroupJoinResult ::= group_join_ack(GroupId, Constant, Channel(Stream(Handshake), Stream(GroupSetupResponse)))
                  ; group_join_nack(GroupId, Constant).

%% Group output routing key: the member's own hub channel, or a member entry the
%% creator keeps to distribute to.
GroupKey ::= group(GroupId) ; group_member(GroupId, Constant).

%% Escrowed opaque values in the mediator's pending table — one constructor per
%% ask.  `?` inside the constructor: the table forwards the writer back to the
%% agent on response.
PendingValue ::= response(Response?)
               ; trade_pending(TradeResponse?, Stream(Lot), Stream(Bond))
               ; escrow_pending(EscrowCancel?)
               ; group_channel(Channel(Stream(GroupSetupResponse), Stream(Handshake)))
               ; error.

%% agent -> mediator (carried on the agent's '_user' output stream).
%% balance_report is keyed by (Owner, Issuer, Maturity) so the wallet can split
%% cash (mature coins) from loans (dated bonds).
AgentContent ::= befriend(Constant, Response?)
               ; connected(Constant)
               ; unfriended(Constant)
               ; rejected
               ; rejected(Constant)
               ; received(Constant, Constant)
               ; balance_report(Constant, Constant, Constant, Integer)
               ; date_advanced(Constant)
               ; trade_proposed(Constant, Stream(Lot), TradeResponse?, Stream(Bond))
               ; trade_completed(Constant)
               ; trade_failed(Constant)
               ; trade_returned(Constant)
               ; trade_returned_menu(Constant, Stream(Bond))
               ; escrow_deposited(Constant, Constant, Constant, Constant, Constant, EscrowCancel?)
               ; escrow_received(Constant, Constant, Constant, Constant, Constant)
               ; escrow_released(Constant)
               ; escrow_cancelled(Constant)
               ; escrow_expired(Constant)
               ; escrow_returned(Constant)
               ; escrow_failed(Constant)
               ; group_invite(GroupId, Channel(Stream(GroupSetupResponse), Stream(Handshake)))
               ; group_joined(GroupId)
               ; group_joined_member(GroupId, Constant)
               ; group_left(GroupId)
               ; group_removed(GroupId)
               ; group_received(GroupId, Constant, Constant).

%% mediator -> agent (mediator's reply to a user action): the compose commands
%% and the sibling choices, plus response(Response) — the injected-result
%% vocabulary (inject_msg), which the mediator itself never sends.
UserContent ::= connect(Constant)
              ; unfriend(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; send(Constant, Constant)
              ; response(Response)
              ; balance
              ; mint(Constant, Constant)
              ; advance_date(Constant)
              ; pay(Constant, Stream(Lot))
              ; trade(Constant, Stream(Lot), Stream(Lot))
              ; redeem(Constant, Stream(Lot), Stream(Lot))
              ; accept_trade(Constant, PendingValue)
              ; reject_trade(Constant, PendingValue)
              ; deposit_escrow(Constant, Stream(Lot), Constant)
              ; cancel_escrow(Constant, PendingValue)
              ; create_group(Constant)
              ; invite_group(GroupId, Constant)
              ; accept_group(GroupId, PendingValue)
              ; reject_group(GroupId, PendingValue)
              ; send_group(GroupId, Constant)
              ; leave_group(GroupId)
              ; remove_from_group(GroupId, Constant).

%% agent <-> network cold-call (2-arg msg(Dest, Content)): forwards the writer.
NetColdCall ::= intro(Constant, Response?).

%% Wrappers for the agent<->mediator channel (CONCRETE element types).
AgentMsg ::= msg(Constant, Constant, AgentContent).   %% agent -> mediator
UserMsg  ::= msg(Constant, Constant, UserContent).    %% mediator -> agent
