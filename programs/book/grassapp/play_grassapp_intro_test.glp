%% play_grassapp_intro_test.glp — runtime test for friend introductions.
%%
%% bob cold-call-befriends alice and charlie, then (once friends with both)
%% introduces them. Each of alice and charlie should receive befriend_intro and,
%% on accept_intro, connect to the other. Each agent's user-notify stream is
%% echoed into a Log the goal returns, so a run shows the protocol end to end.
%%
%% Run:  load this file (after self.glp, grassapp_agent.glp, grassapp_mediator.glp)
%%       test_intro(ALog, BLog, CLog).
%% Expect: ALog has befriend_intro(bob, charlie, _) then connected(charlie);
%%         CLog has befriend_intro(bob, alice, _) then connected(alice);
%%         BLog has the two cold-call befriends and two connecteds.
%%
%% Requires: self.glp, grassapp_agent.glp, grassapp_mediator.glp

-mode(system).

%% --- In-heap crossbar (routes '_net' output by addressee) ---
procedure crossbar(Stream(M)?, Stream(M)?, Stream(M)?,
                   Stream(M), Stream(M), Stream(M)).
crossbar(AOut, BOut, COut, AIn?, BIn?, CIn?) :-
    merge(AOut?, BOut?, AB),
    merge(AB?, COut?, All),
    route(All?, AIn, BIn, CIn).

procedure route(Stream(M)?, Stream(M), Stream(M), Stream(M)).
route([msg(alice, C) | Rest], [msg(alice, C?) | A?], B?, Ch?) :-
    route(Rest?, A, B, Ch).
route([msg(bob, C) | Rest], A?, [msg(bob, C?) | B?], Ch?) :-
    route(Rest?, A, B, Ch).
route([msg(charlie, C) | Rest], A?, B?, [msg(charlie, C?) | Ch?]) :-
    route(Rest?, A, B, Ch).
route([], [], [], []).

%% --- alice / charlie: cold-call bob, then observe-and-respond ---
procedure alice_actor(Stream(UserNotify)?, Stream(UserCmd), Stream(UserNotify)).
alice_actor(Ns, [connect(bob) | Cs?], Log?) :- obs(alice, Ns?, Cs, Log).

procedure charlie_actor(Stream(UserNotify)?, Stream(UserCmd), Stream(UserNotify)).
charlie_actor(Ns, [connect(bob) | Cs?], Log?) :- obs(charlie, Ns?, Cs, Log).

%% Observe-and-respond: accept befriend offers and introductions; log everything.
procedure obs(Constant?, Stream(UserNotify)?, Stream(UserCmd), Stream(UserNotify)).
obs(Me, [befriend(Who, Req) | Ns], [decision(yes, Who?, Req?) | Cs?],
    [befriend(Who?, Req?) | Log?]) :-
    ground(Me?), ground(Who?), ground(Req?) | obs(Me?, Ns?, Cs, Log).
obs(Me, [befriend_intro(From, Other, Req) | Ns], [accept_intro(Other?, Req?) | Cs?],
    [befriend_intro(From?, Other?, Req?) | Log?]) :-
    ground(Me?), ground(From?), ground(Other?), ground(Req?) | obs(Me?, Ns?, Cs, Log).
obs(Me, [N | Ns], Cs?, [N? | Log?]) :-
    ground(Me?), otherwise | obs(Me?, Ns?, Cs, Log).
obs(_, [], [], []).

%% --- bob: accept cold-calls; once friends with both, introduce them ---
%% State tracks which of alice/charlie has connected so the introduction fires
%% exactly once, in either arrival order.
procedure bob_actor(Constant?, Stream(UserNotify)?, Stream(UserCmd), Stream(UserNotify)).
bob_actor(S, [befriend(Who, Req) | Ns], [decision(yes, Who?, Req?) | Cs?],
    [befriend(Who?, Req?) | Log?]) :-
    ground(S?), ground(Who?), ground(Req?) | bob_actor(S?, Ns?, Cs, Log).
bob_actor(waiting, [connected(alice) | Ns], Cs?, [connected(alice) | Log?]) :-
    bob_actor(got_alice, Ns?, Cs, Log).
bob_actor(waiting, [connected(charlie) | Ns], Cs?, [connected(charlie) | Log?]) :-
    bob_actor(got_charlie, Ns?, Cs, Log).
bob_actor(got_alice, [connected(charlie) | Ns], [introduce(alice, charlie) | Cs?],
    [connected(charlie) | Log?]) :-
    bob_actor(done, Ns?, Cs, Log).
bob_actor(got_charlie, [connected(alice) | Ns], [introduce(alice, charlie) | Cs?],
    [connected(alice) | Log?]) :-
    bob_actor(done, Ns?, Cs, Log).
bob_actor(S, [N | Ns], Cs?, [N? | Log?]) :-
    ground(S?), otherwise | bob_actor(S?, Ns?, Cs, Log).
bob_actor(_, [], [], []).

%% --- Test entry: spawn the trio, return each one's notify log ---
procedure test_intro(Stream(UserNotify), Stream(UserNotify), Stream(UserNotify)).
test_intro(ALog?, BLog?, CLog?) :-
    agent(bob, BAgentIn?, BNetIn?,
          [output('_user', BA2U) | [output('_net', BNetOut)]], []),
    ui_mediator(bob, ch(BA2U?, BAgentIn), ch(BCmds?, BUserOut), [], 1),
    bob_actor(waiting, BUserOut?, BCmds, BLog),
    agent(alice, AAgentIn?, ANetIn?,
          [output('_user', AA2U) | [output('_net', ANetOut)]], []),
    ui_mediator(alice, ch(AA2U?, AAgentIn), ch(ACmds?, AUserOut), [], 1),
    alice_actor(AUserOut?, ACmds, ALog),
    agent(charlie, CAgentIn?, CNetIn?,
          [output('_user', CA2U) | [output('_net', CNetOut)]], []),
    ui_mediator(charlie, ch(CA2U?, CAgentIn), ch(CCmds?, CUserOut), [], 1),
    charlie_actor(CUserOut?, CCmds, CLog),
    crossbar(ANetOut?, BNetOut?, CNetOut?, ANetIn, BNetIn, CNetIn).
