%% coop_stream_boot.glp - Cooperative stream: producer on one agent, merge on another
%%
%% madGLP equivalent of the old IRMA coop_stream_test:
%%   Old: @1 produces Xs=[1,2,3], @2 produces Ys=[a,b,c] and merges
%%   New: agent1 sends list [1,2,3] to agent2, agent2 merges with local [a,b,c]
%%
%% Scenario:
%%   agent1: sends list [1,2,3] element-by-element to agent2
%%   agent2: receives from NetIn, produces local [a,b,c], merges both
%%
%% Date: 2026-02-10

procedure boot.
boot :-
    agent1_init(agent1, _)@agent1,
    agent2_init(agent2, _)@agent2.

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(_?, _?, _).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% AGENT1: Sends list to agent2
%% =============================================================================

procedure agent1_init(_?, _?).
agent1_init(_, _) :-
    send_to_net([msg(agent2, data([1,2,3]))]).

%% =============================================================================
%% AGENT2: Receives list, merges with local production
%% =============================================================================

procedure agent2_init(_?, _?).
agent2_init(_, [msg(_, data(Xs))|_]) :-
    ground(Xs?) |
    merge(Xs?, [a,b,c], Zs),
    consume(Zs?).

procedure consume(_?).
consume([_|Rest]) :- consume(Rest?).
consume([]).
