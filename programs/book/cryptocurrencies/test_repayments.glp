%% test_repayments.glp - Unit tests for repayment computation

%% Type definitions (test/play file - minimal declarations needed)


%% ============================================
%% Repayment Computation Tests
%% ============================================

%% Test: nothing to repay
test_repay_zero :-
    compute_repayments(0, [carol], [(carol, 100)], Repayments, Balances1),
    Repayments? = [],
    Balances1? = [(carol, 100)].

%% Test: have enough of first preference
test_repay_enough :-
    compute_repayments(30, [carol], [(carol, 100)], Repayments, Balances1),
    Repayments? = [(carol, 30)],
    get_balance(carol, Balances1?, CarolBal),
    CarolBal? = 70.

%% Test: exactly enough of first preference
test_repay_exact :-
    compute_repayments(100, [carol], [(carol, 100)], Repayments, Balances1),
    Repayments? = [(carol, 100)],
    get_balance(carol, Balances1?, CarolBal),
    CarolBal? = 0.

%% Test: need to use fallback to self
test_repay_fallback :-
    compute_repayments(50, [carol], [(carol, 20)], Repayments, _),
    %% Should be [(carol, 20), (self, 30)]
    Repayments? = [(carol, 20), (self, 30)].

%% Test: multiple preferences, partial from each
test_repay_multi :-
    compute_repayments(50, [carol, dave], [(carol, 20), (dave, 15)], Repayments, _),
    %% Should be [(carol, 20), (dave, 15), (self, 15)]
    Repayments? = [(carol, 20), (dave, 15), (self, 15)].

%% Test: first preference has zero
test_repay_skip_zero :-
    compute_repayments(30, [carol, dave], [(carol, 0), (dave, 50)], Repayments, _),
    %% Should skip carol, use dave
    Repayments? = [(dave, 30)].

%% Run all repayment tests
test_repayments :-
    test_repay_zero,
    test_repay_enough,
    test_repay_exact,
    test_repay_fallback,
    test_repay_multi,
    test_repay_skip_zero.
