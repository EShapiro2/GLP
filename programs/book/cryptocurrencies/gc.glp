%% Type definitions
BalanceList ::= [] ; [Any | BalanceList].
RequestList ::= [] ; [Any | RequestList].
BlockStream ::= [] ; [Any | BlockStream].

%% Procedure type declarations
procedure get_balance(Any?, BalanceList?, Number).
procedure set_balance(Any?, Number?, BalanceList?, BalanceList).
procedure agent(RequestList?, BalanceList?, BlockStream?).
procedure handle(Any?, BalanceList?, BalanceList, Any).
procedure prepend_blocks(Any?, BlockStream?, BlockStream).

%% gc.glp - Grassroots Cryptocurrencies
%% Implementation of Grassroots Flash payment system
%% Reference: lewis2023grassroots, shapiro2024gc

%% ============================================
%% Balance Management
%% ============================================

%% Get balance in a currency (0 if not found)
get_balance(Currency, [(K, Bal)|_], Bal?) :- Currency? =?= K? | true.
get_balance(Currency, [_|Balances], Bal?) :-
    otherwise | get_balance(Currency?, Balances?, Bal).
get_balance(_, [], 0).

%% Update balance in a currency
set_balance(Currency, NewBal, [], [(Currency?, NewBal?)]).
set_balance(Currency, NewBal, [(K, _)|Bs], [(K?, NewBal?)|Bs?]) :-
    Currency? =?= K? | true.
set_balance(Currency, NewBal, [B|Bs], [B?|Bs1?]) :-
    otherwise |
    set_balance(Currency?, NewBal?, Bs?, Bs1).

%% ============================================
%% Agent Process
%% ============================================

%% Agent processes request stream, maintains balances, produces block stream
agent([], _, []).
agent([Request|Requests], Balances, Stream) :-
    handle(Request?, Balances?, Balances1, BlockOrBlocks),
    prepend_blocks(BlockOrBlocks?, Stream?, Stream1),
    agent(Requests?, Balances1?, Stream1?).

prepend_blocks(block(A,B,C), Stream, [block(A?,B?,C?) | Stream?]).
prepend_blocks([], Stream, Stream?).
prepend_blocks([B|Bs], Stream, [B? | Stream1?]) :- prepend_blocks(Bs?, Stream?, Stream1).

%% ============================================
%% Request Handlers
%% ============================================

%% Issue: pay someone in a given currency
handle(issue(To, Amount, Currency), Balances, BalancesOut?, Block?) :-
    ground(Currency?), ground(Amount?), ground(To?), ground(Balances?),
    get_balance(Currency?, Balances?, OldBal),
    Amount? =< OldBal? |
    NewBal := OldBal? - Amount?,
    set_balance(Currency?, NewBal?, Balances?, BalancesOut),
    make_issue_block(Currency?, To?, Amount?, NewBal?, Block).

make_issue_block(Currency, To, Amount, NewBal,
                 block(tx(Currency?, [payment(To?, Amount?), payment(self, NewBal?)]), issue, [])).

%% Accept: accept an incoming payment
handle(accept(Amount, Currency, PaymentBlock, ApprovalBlock),
       Balances, BalancesOut?, Block?) :-
    ground(Amount?), ground(Currency?), ground(Balances?) |
    get_balance(Currency?, Balances?, OldBal),
    NewBal := OldBal? + Amount?,
    set_balance(Currency?, NewBal?, Balances?, BalancesOut),
    make_accept_block(Currency?, NewBal?, PaymentBlock?, ApprovalBlock?, Block).

make_accept_block(Currency, NewBal, PaymentBlock, ApprovalBlock,
                  block(tx(Currency?, [payment(self, NewBal?)]), accept, [PaymentBlock?, ApprovalBlock?])).

%% Approve: sovereign approves a payment in their currency
handle(approve(PaymentBlock), Balances, Balances?,
       block(tx(self, []), approve, [PaymentBlock?])).

%% Mint: sovereign creates new coins (only unbalanced operation)
handle(mint(Amount), Balances, BalancesOut?, Block?) :-
    ground(Amount?), ground(Balances?) |
    get_balance(self, Balances?, OldBal),
    NewBal := OldBal? + Amount?,
    set_balance(self, NewBal?, Balances?, BalancesOut),
    make_mint_block(NewBal?, Block).

make_mint_block(NewBal, block(tx(self, [payment(self, NewBal?)]), mint, [])).

%% ============================================
%% Redemption
%% ============================================

%% Redeem: claimer returns sovereign's coins, requests repayment
handle(redeem(Sovereign, Amount, Preferences),
       Balances, BalancesOut?, Block?) :-
    ground(Sovereign?), ground(Amount?), ground(Balances?),
    get_balance(Sovereign?, Balances?, OldBal),
    Amount? =< OldBal? |
    NewBal := OldBal? - Amount?,
    set_balance(Sovereign?, NewBal?, Balances?, BalancesOut),
    make_redeem_block(Sovereign?, Amount?, Preferences?, Block).

make_redeem_block(Sovereign, Amount, Preferences,
                  block(tx(Sovereign?, [payment(Sovereign?, Amount?)]), (redeem, Preferences?), [])).

%% Repay: sovereign repays a redemption claim
handle(repay(Claimer, Amount, Preferences, ClaimHash),
       Balances, BalancesOut?, Blocks?) :-
    ground(Claimer?), ground(Amount?), ground(ClaimHash?), ground(Balances?) |
    compute_repayments(Amount?, Preferences?, Balances?, Repayments, BalancesOut),
    make_repay_blocks(Claimer?, Repayments?, ClaimHash?, Blocks).

%% ============================================
%% Repayment Computation
%% ============================================

%% Base case: nothing to repay
compute_repayments(0, _, Balances, [], Balances?).

%% Preference list exhausted: pay remainder in own coins
compute_repayments(Amount, [], Balances, [(self, Amount?)], Balances?) :-
    Amount? > 0 | true.

%% Try next currency in preference list
compute_repayments(Amount, [Currency|Rest], Balances, Repayments?, Balances1?) :-
    Amount? > 0 |
    get_balance(Currency?, Balances?, Available),
    take_from_currency(Amount?, Currency?, Available?, Rest?, 
                       Balances?, Repayments, Balances1).

%% No coins of this currency available
take_from_currency(Amount, _, 0, Rest, Balances, Repayments?, Balances1?) :-
    compute_repayments(Amount?, Rest?, Balances?, Repayments, Balances1).

%% Have enough: pay full amount in this currency
take_from_currency(Amount, Currency, Available, _, Balances,
                   [(Currency?, Amount?)], Balances1?) :-
    Available? >= Amount? |
    NewBal := Available? - Amount?,
    set_balance(Currency?, NewBal?, Balances?, Balances1).

%% Not enough: pay what we have, continue with remainder
take_from_currency(Amount, Currency, Available, Rest, Balances,
                   [(Currency?, Available?)|Repayments?], Balances1?) :-
    Available? > 0, Available? < Amount? |
    Remainder := Amount? - Available?,
    set_balance(Currency?, 0, Balances?, Balances2),
    compute_repayments(Remainder?, Rest?, Balances2?, Repayments, Balances1).

%% ============================================
%% Repayment Block Construction
%% ============================================

make_repay_blocks(_, [], _, []).

%% Pay in sovereign's own currency
make_repay_blocks(Claimer, [(self, Amount)|Rest], ClaimHash, [Block | Blocks]) :-
    ground(Claimer?), ground(Amount?), ground(ClaimHash?) |
    make_self_repay_block(Claimer?, Amount?, ClaimHash?, Block),
    make_repay_blocks(Claimer?, Rest?, ClaimHash?, Blocks).

make_self_repay_block(Claimer, Amount, ClaimHash,
                      block(tx(self, [payment(Claimer?, Amount?)]), (repay, ClaimHash?), [])).

%% Pay in foreign currency
make_repay_blocks(Claimer, [(Currency, Amount)|Rest], ClaimHash, [Block | Blocks]) :-
    ground(Claimer?), ground(Currency?), ground(Amount?), ground(ClaimHash?),
    ~(Currency? =?= self) |
    make_foreign_repay_block(Currency?, Claimer?, Amount?, ClaimHash?, Block),
    make_repay_blocks(Claimer?, Rest?, ClaimHash?, Blocks).

make_foreign_repay_block(Currency, Claimer, Amount, ClaimHash,
                         block(tx(Currency?, [payment(Claimer?, Amount?)]), (repay, ClaimHash?), [])).

%% ============================================
%% Block Search Helpers
%% ============================================

%% Find a payment block to a specific recipient
find_payment_to(Recipient, [Block|_], Block?) :-
    Block = block(tx(_, Payments), issue, _),
    has_payment_to(Recipient?, Payments?) | true.
find_payment_to(Recipient?, [_|Blocks], Block?) :-
    find_payment_to(Recipient, Blocks?, Block).

has_payment_to(Recipient, [payment(Recipient?, _)|_]).
has_payment_to(Recipient?, [_|Payments]) :-
    has_payment_to(Recipient, Payments?).

%% Find an approval block
find_approval([Block|_], Block?) :-
    Block = block(_, approve, _) | true.
find_approval([_|Blocks], Block?) :-
    find_approval(Blocks?, Block).

%% Find a redemption claim block
find_claim([Block|_], Block?) :-
    Block = block(tx(_, _), (redeem, _), _) | true.
find_claim([_|Blocks], Block?) :-
    find_claim(Blocks?, Block).
