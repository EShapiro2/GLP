%% multiply.glp - Scalar multiply stream (stream map)
%% multiply(N, Xs, Ys) :- Ys is Xs with each element multiplied by N

multiply(_, [], []).
multiply(N, [X|Xs], [Y?|Ys?]) :-
    ground(N?) |
    Y := N? * X?,
    multiply(N?, Xs?, Ys).

%% Example goal: multiply(3, [1,2,3,4], Ys).
%% Expected: Ys = [3,6,9,12]
