%% dynamic_merger.glp - Dynamic stream merger
%% Source: GLP Papers (Program: Dynamic Stream Merger)
%%
%% Allows dynamic addition of new streams via merge(Ws) messages.
%% Creates a self-organizing merge tree.
%% A merge(Ws) message is taken by the first two clauses, ahead of the forwarding ones.

%% Type definitions: a message is a merge(Ws) request, Ws a further stream
%% of messages, or a string or a number, the items the clauses below forward.
Msg ::= merge(Stream(Msg)) ; String ; Number.

procedure merger(Stream(Msg)?, Stream(Msg)?, Stream(Msg)).
merger(Ws, Xs, Out?) :- merge(Ws?, Xs?, Out).

procedure merge(Stream(Msg)?, Stream(Msg)?, Stream(Msg)).
merge([merge(Ws)|Xs], Ys, Zs?) :-
   merger(Ws?, Xs?, Xs1), merge(Xs1?, Ys?, Zs).
merge(Xs, [merge(Ws)|Ys], Zs?) :-
   merger(Ws?, Ys?, Ys1), merge(Xs?, Ys1?, Zs).
merge([X|Xs], Ys, [X?|Zs?]) :-
    compound(X?) | merge(Ys?, Xs?, Zs).
merge([X|Xs], Ys, [X?|Zs?]) :-
    string(X?) | merge(Ys?, Xs?, Zs).
merge([X|Xs], Ys, [X?|Zs?]) :-
    number(X?) | merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :-
    compound(Y?) | merge(Xs?, Ys?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :-
    string(Y?) | merge(Xs?, Ys?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :-
    number(Y?) | merge(Xs?, Ys?, Zs).
merge([], [], []).

%% Any client can send merge(NewStream) to dynamically add another stream.
%% The spawned merger process handles integration, creating a
%% self-organizing merge tree.
