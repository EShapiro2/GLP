% Topic: Dynamic merge
% Section: Streams - Dynamic Merge
%
% Test goals:
% dmerge([a, merge([x,y]), b], [1, 2], Out).

procedure(X) merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

% Dynamic merge: merge(Ws) messages add new streams; a message is such a
% request, Ws a further stream of messages, or a string or a number.
Msg ::= merge(Stream(Msg)) ; String ; Number.

procedure dmerge(Stream(Msg)?, Stream(Msg)?, Stream(Msg)).
dmerge([merge(Ws)|Xs], Ys, Zs?) :-
    dmerger(Ws?, Xs?, Xs1), dmerge(Xs1?, Ys?, Zs).
dmerge(Xs, [merge(Ws)|Ys], Zs?) :-
    dmerger(Ws?, Ys?, Ys1), dmerge(Xs?, Ys1?, Zs).
dmerge([X|Xs], Ys, [X?|Zs?]) :-
    otherwise | dmerge(Ys?, Xs?, Zs).
dmerge(Xs, [Y|Ys], [Y?|Zs?]) :-
    otherwise | dmerge(Xs?, Ys?, Zs).
dmerge([], [], []).

procedure dmerger(Stream(Msg)?, Stream(Msg)?, Stream(Msg)).
dmerger(Ws, Xs, Out?) :- dmerge(Ws?, Xs?, Out).
