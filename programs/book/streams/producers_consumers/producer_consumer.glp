%% Type definitions
NumList ::= [] ; [Number | NumList].

%% Procedure type declarations
procedure producer(NumList, Number?).
procedure consumer(NumList?, Number?, Number?).

% Topic: Producer and consumer
% Section: Streams - Producers and Consumers
%
% Test goals:
% producer(H, 5), consumer(H?, 0, R).

producer([], 0).
producer([N?|Xs?], N) :- integer(N?), N? > 0 | N1 := N? - 1, producer(Xs, N1?).

consumer([], Sum, Sum?).
consumer([X|Xs], Sum, Result?) :- ground(X?) |
    Sum1 := Sum? + X?,
    consumer(Xs?, Sum1?, Result).
