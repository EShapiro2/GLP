% mwm/2 - Multiway merge with constant delay
% In: stream of stream(Xs) terms, may include merge(NewStream)
% Out: merged output stream
%
% Uses MutualRef for O(1) stream append.
% Uses short-circuit L/R pairs for termination detection.
% Reaches the mutual-reference kernels through the system wrappers in the root
% self.glp (allocate_mutual_reference/2, stream_append/3,
% close_mutual_reference/1); it names no reserved kernel itself.

%% Type definitions
Done ::= done.
StreamCmd ::= stream(Stream(_)) ; merge(StreamOfStreams).
StreamOfStreams ::= [] ; [StreamCmd | StreamOfStreams].

procedure mwm(StreamOfStreams?, Stream(X)).
mwm(In, Out?) :-
    allocate_mutual_reference(Ref, Out),
    mwm_main(In?, Ref?).

% Intermediate predicate with guard to allow multiple Ref? occurrences
procedure mwm_main(StreamOfStreams?, _?).
mwm_main(In, Ref) :-
    is_mutual_ref(Ref?) |
    mwm1(In?, Ref?, done, Done),
    close_when_done(Done?, Ref?).

procedure mwm1(StreamOfStreams?, _?, Done?, Done).
mwm1([stream(Xs)|Streams], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    mwm_copy(Xs?, Ref?, L?, M),
    mwm1(Streams?, Ref?, M?, R).

mwm1([merge(NewIn)|Streams], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    mwm1(NewIn?, Ref?, L?, M),
    mwm1(Streams?, Ref?, M?, R).

mwm1([], _, L, L?).

procedure mwm_copy(Stream(X)?, _?, Done?, Done).
mwm_copy([X|Xs], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    stream_append(X?, Ref?, Ref1),
    mwm_copy(Xs?, Ref1?, L?, R).

mwm_copy([], _, L, L?).

procedure close_when_done(Done?, _?).
close_when_done(done, Ref) :-
    is_mutual_ref(Ref?) |
    close_mutual_reference(Ref?).

% stream_append/3 and close_mutual_reference/1 are provided by the root self.glp
% (they wrap the '_stream_append' / '_close_mutual_reference' kernels); this
% module calls them directly and defines no local copy.
