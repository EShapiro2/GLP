% Topic: Stream observers
% Section: Streams - Stream Observers
%
% Test goals:
% test_obs1(Sum, Copy).
% test_obs2(Copy, Done).

%% Type definitions
NumList ::= [] ; [Number | NumList].
Done ::= done.

% Producer and consumer for testing
procedure producer(NumList, Number?).
producer([], 0).
producer([N?|Xs?], N) :- N? > 0 | N1 := N? - 1, producer(Xs, N1?).

procedure consumer(NumList?, Number?, Number).
consumer([], Sum, Sum?).
consumer([X|Xs], Sum, Result?) :- ground(X?) |
    Sum1 := Sum? + X?,
    consumer(Xs?, Sum1?, Result).

% Forwarding observer
procedure observer1(NumList?, NumList, NumList).
observer1([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | observer1(Xs?, Ys, Zs).
observer1([], [], []).

% Test forwarding observer
procedure test_obs1(Number, NumList).
test_obs1(Sum?, Copy?) :-
    producer(H, 5),
    observer1(H?, Fwd, Copy),
    consumer(Fwd?, 0, Sum).

% Cooperative producers
procedure(X) bob(Stream(X), Done).
bob([a,a|Tail?], Result?) :- alice(Tail, Result).

procedure(X) alice(Stream(X), Done).
alice([b,b,b|Tail?], Result?) :- bob_finish(Tail, Result).

procedure(X) bob_finish(Stream(X), Done).
bob_finish([a,a], done).

% Cooperative observer (handles direction changes)
procedure(X) observe(Stream(X)?, Stream(X), Stream(X)).
observe([X|Xs], Ys?, [X?|Zs?]) :- ground(X?) |
    Ys = [X?|Ys1?], observe(Xs?, Ys1, Zs).
observe([X|Xs?], Ys, [X?|Zs?]) :- ground(X?) |
    Ys = [X?|Ys1?], observe(Ys1?, Xs, Zs).
observe([], [], []).

% Test cooperative observer
procedure(X) test_obs2(Stream(X), Done).
test_obs2(Copy?, Done?) :-
    bob(Stream, Done),
    observe(Stream?, _, Copy).
