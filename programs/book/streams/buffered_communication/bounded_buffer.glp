%% bounded_buffer.glp - Bounded buffer stream communication
%% Source: CP Collected Papers, Ch 18 (Takeuchi & Furukawa)
%%
%% Buffer represented as difference list H\T where H is message queue head,
%% T is the hole for new messages. Bounded size creates backpressure.

%% Type definitions
Buffer ::= Stream(_) \ Stream(_)?.

%% Unbounded buffer send/receive (standard stream communication)
procedure(X) send_unbounded(_?, Stream(X), Stream(X)?).
send_unbounded(Msg, [Msg?|NStrm], NStrm?).

procedure(X) receive_unbounded(_, Stream(X)?, Stream(X)).
receive_unbounded(Msg?, [Msg|NStrm], NStrm?).

%% Bounded buffer send/receive using difference list H\T
procedure send(_?, Buffer?, Buffer).
send(Msg, [Msg?|Buf?]\Tail?, Buf\Tail).

procedure receive(_, Buffer?, Buffer).
receive(Msg?, [Msg|Buf]\[_|Tail?], Buf?\Tail).

%% Close and test closure
procedure(X) close(Stream(X)?).
close([end_of_stream|_]\_).

procedure closed(_?).
closed(end_of_stream).

%% Open a buffer of given size
procedure open(Number?, Buffer).
open(0, X\X?).
open(N, [_|H?]\T?) :- N? > 0 | N1 := N? - 1, open(N1?, H\T).

%% Example: Buffered stream of squares
procedure(X) sq_num_buffered(Number?, Stream(X), Number?).
sq_num_buffered(N, Ss?, Size) :-
    open(Size?, Buf\Tail),
    integers(1, N?, Buf?\Tail),
    square(Buf\Tail?, Ss).

procedure integers(Number?, Number?, Buffer?).
integers(I, N, Buf\Tail) :-
    I? =< N? |
    J := I? + 1,
    send(I?, Buf?\Tail?, NBuf\NTail),
    integers(J?, N?, NBuf?\NTail).
integers(I, N, Buf\_) :-
    I? > N? |
    close(Buf?).

procedure(X) square(Buffer?, Stream(X)).
square(Buf\Tail, Ss?) :-
    receive(I, Buf?\Tail?, NBuf\NTail),
    square2(I?, NBuf?\NTail?, Ss).

procedure(X) square2(_?, Buffer?, Stream(X)).
square2(I, _\_, []) :- closed(I?) | true.
square2(I, Buf\Tail, [I2?|Ss?]) :-
    number(I?) |
    I2 := I? * I?,
    square(Buf?\Tail?, Ss).
