%% counter_monitor.glp - Counter Monitor
%% Owner: GLP-ICLP (Moded-Types paper, Appendix A.2)
%%
%% Message-driven counter with add/clear/read operations.
%% Demonstrates an embedded output type (Integer? in the read message).

CounterCall ::= add ; clear ; read(Integer?).

procedure monitor(Stream(CounterCall)?).
monitor(In) :- monitor(0, In?).

procedure monitor(Integer?, Stream(CounterCall)?).
monitor(N, [add|In]) :- N1 := N? + 1, monitor(N1?, In?).
monitor(_, [clear|In]) :- monitor(0, In?).
monitor(N, [read(N?)|In]) :- integer(N?) | monitor(N?, In?).
monitor(_, []).
