%% play_absolute.glp - Four-actor play with absolute time targets
%% Each actor waits for its absolute target with the catalogue's time guard
%% wait_until/1 (guard_sub/3, which computed the wait's delta, is in no catalogue)

%% Type definitions: a request carries its value, or a hollow value(V) the
%% monitor fills; the log records each request with the value it carried.
AccReq ::= add(Number) ; subtract(Number) ; value(Number?).
LogEntry ::= add(Number) ; subtract(Number) ; value(Number).

procedure play_absolute(Number, Number, Number, Number, Stream(LogEntry)).
play_absolute(VA?, VB?, VC?, VD?, Log?) :-
    now(T0),
    T50 := T0? + 50,
    T100 := T0? + 100,
    T150 := T0? + 150,
    alice(VA, As),
    bob_at(T0?, T50?, VB, Bs),
    carol_at(T0?, T100?, VC, Cs),
    diana_at(T0?, T150?, VD, Ds),
    merge(As?, Bs?, AB),
    merge(Cs?, Ds?, CD),
    merge(AB?, CD?, All),
    observe_accum(All?, Reqs, Log),
    monitor(Reqs?).

procedure alice(Number, Stream(AccReq)).
alice(V?, [add(10), add(5), value(V)|Xs?]) :- alice_done(Xs).

procedure alice_done(Stream(AccReq)).
alice_done([]).

procedure bob_at(Number?, Number?, Number, Stream(AccReq)).
bob_at(_, TTarget, V?, Ys?) :-
    wait_until(TTarget?) |
    Ys = [subtract(3), value(V)|Ys1?],
    bob_done(Ys1).

procedure bob_done(Stream(AccReq)).
bob_done([]).

procedure carol_at(Number?, Number?, Number, Stream(AccReq)).
carol_at(_, TTarget, V?, Zs?) :-
    wait_until(TTarget?) |
    Zs = [add(20), value(V)|Zs1?],
    carol_done(Zs1).

procedure carol_done(Stream(AccReq)).
carol_done([]).

procedure diana_at(Number?, Number?, Number, Stream(AccReq)).
diana_at(_, TTarget, V?, Ws?) :-
    wait_until(TTarget?) |
    Ws = [value(V)|Ws1?],
    diana_done(Ws1).

procedure diana_done(Stream(AccReq)).
diana_done([]).

%% Supporting predicates (from observed_monitor.glp)

% Accumulator monitor
procedure monitor(Stream(AccReq)?).
monitor(Reqs) :- monitor_loop(Reqs?, 0).

procedure monitor_loop(Stream(AccReq)?, Number?).
monitor_loop([add(N)|Reqs], Sum) :-
    Sum1 := Sum? + N?, monitor_loop(Reqs?, Sum1?).
monitor_loop([subtract(N)|Reqs], Sum) :-
    Sum1 := Sum? - N?, monitor_loop(Reqs?, Sum1?).
monitor_loop([value(V?)|Reqs], Sum) :-
    ground(Sum?) | V = Sum?, monitor_loop(Reqs?, Sum?).
monitor_loop([], _).

% Type/mode-aware observer
procedure observe_accum(Stream(AccReq)?, Stream(AccReq), Stream(LogEntry)).
observe_accum([add(N)|In], [add(N?)|Out?], [add(N?)|Log?]) :-
    ground(N?) | observe_accum(In?, Out, Log).
observe_accum([subtract(N)|In], [subtract(N?)|Out?], [subtract(N?)|Log?]) :-
    ground(N?) | observe_accum(In?, Out, Log).
observe_accum([value(V1?)|In], [value(V)|Out?], [value(V2?)|Log?]) :-
    duplicate(V?, V1, V2),
    observe_accum(In?, Out, Log).
observe_accum([], [], []).

procedure duplicate(Number?, Number, Number).
duplicate(X, X?, X?) :- ground(X?) | true.

% Fair merge
procedure merge(Stream(AccReq)?, Stream(AccReq)?, Stream(AccReq)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], [], []).
