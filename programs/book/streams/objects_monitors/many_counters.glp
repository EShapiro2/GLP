%% many_counters.glp - Managing multiple counter instances
%% Source: CP Collected Papers, Ch 29 (Shapiro & Takeuchi)
%%
%% Dynamic object creation and management.
%% Creates counter instances and routes messages by name.

%% Type definitions
CounterMsg ::= clear ; up ; down ; show(Number).
CounterEntry ::= (Constant, Stream(CounterMsg)).
CounterList ::= [] ; [CounterEntry | CounterList].
Command ::= create(Constant) ; (Constant, CounterMsg).
CommandStream ::= [] ; [Command | CommandStream].

procedure use_many_counters(CommandStream?, CounterList).
use_many_counters([create(Name)|Input?], Stream_of_counters) :-
    counter(Com?, 0),
    use_many_counters(Input?, [(Name?, Com)|Stream_of_counters?]).

use_many_counters([(Name, show(Val))|Input?], Stream_of_counters) :-
    send(Stream_of_counters?, Name?, show(Val), NewList) |
    use_many_counters(Input?, NewList?),
    wait_write(Val?).

use_many_counters([X|Input?], Stream_of_counters) :-
    ~(X =?= create(_)), ~(X =?= (_, show(_))),
    X = (Name, Cmd),
    send(Stream_of_counters?, Name?, Cmd?, NewList) |
    use_many_counters(Input?, NewList?).

%% Send message to named counter
procedure send(CounterList?, Constant?, CounterMsg?, CounterList).
send([(Name, [Message|Y?])|Stream?], Name, Message, [(Name?, Y)|Stream]).
send([C|Stream?], Name, Message, [C?|L1?]) :-
    send(Stream?, Name?, Message?, L1).

%% Counter from counter.glp
procedure counter(Stream(CounterMsg)?, Number?).
counter([clear|S?], _) :-
    counter(S?, 0).
counter([up|S?], State) :-
    NewState := State? + 1,
    counter(S?, NewState?).
counter([down|S?], State) :-
    NewState := State? - 1,
    counter(S?, NewState?).
counter([show(State?)|S?], State) :-
    counter(S?, State?).
counter([], _).

procedure wait_write(_?).
wait_write(X) :- known(X?) | write(X?).
