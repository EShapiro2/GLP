%% observe.glp - Concurrent stream observer
%% Owner: GLP-ICLP (Program: Concurrent Observer)
%%
%% Observes a stream of incrementally-constructed data without consuming it:
%% forwards each element and produces a replicable audit log. Ground values
%% are shared; a list is observed elementwise, suspending on an unbound head
%% or tail and resuming as the producer binds it.
%%
%% Note: a single observe process is one-directional (values flow from the
%% observed argument to the copy and the log). Observing bidirectional
%% communication takes one observer per direction, one on each stream of the
%% channel.

procedure observe(_?, _, _).
%% Ground value: forward and log (ground terms can be shared)
observe(X, X?, X?) :- ground(X?) | true.
%% List: observe elementwise
observe([X|Xs], [Y?|Ys?], [L?|Ls?]) :-
    observe(X?, Y, L),
    observe(Xs?, Ys, Ls).

%% Example initial goal:
%% observe([m(1,[x]), m(2,[y])], Copy, Log).
