%% member.glp - Stream Membership
%% Source: Standard GLP list operations
%% Note: Uses ground guard to allow comparison

%% Procedure type declarations
procedure(X) member(X?, OpenStream(X)?).
member(X, [H|_]) :- ground(X?), ground(H?), X? =?= H? | true.
member(X, [_, Y|Ys]) :- member(X?, [Y?|Ys?]).

%% Metainterpreter support
procedure reduce(_?, _).
reduce(member(X, [H|_]), true) :- X? =?= H? | true.
reduce(member(X, [_, Y|Ys]), member(X?, [Y?|Ys?])).
