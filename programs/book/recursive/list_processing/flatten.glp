%% flatten.glp - Flattening nested lists
%% Source: AofGLP Book Chapter 6

%% Type definitions - NestedList allows nested structure
NestedList ::= [] ; [_ | NestedList].

%% Procedure type declarations
procedure flatten(NestedList?, Stream(X)).
flatten(Xs, Ys?) :- flatten_dl(Xs?, Ys, []).

procedure flatten_dl(NestedList?, Stream(X), Stream(X)?).
flatten_dl([], Front?, Front).
flatten_dl([X|Xs], Front?, Back) :-
    ground(X?), list(X?) |
    flatten_dl(X?, Front, Mid?),
    flatten_dl(Xs?, Mid, Back?).
flatten_dl([X|Xs], [X?|Front?], Back) :-
    otherwise |
    flatten_dl(Xs?, Front, Back?).

%% Metainterpreter support
procedure reduce(_?, _).
reduce(flatten(Xs, Ys?), flatten_dl(Xs?, Ys, [])).
reduce(flatten_dl([], Front?, Front), true).
reduce(flatten_dl([X|Xs], Front?, Back),
    (flatten_dl(X?, Front, Mid?), flatten_dl(Xs?, Mid, Back?))) :-
    ground(X?), list(X?) | true.
reduce(flatten_dl([X|Xs], [X?|Front?], Back), flatten_dl(Xs?, Front, Back?)) :-
    otherwise | true.
