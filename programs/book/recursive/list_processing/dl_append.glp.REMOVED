%% This file has been removed because it duplicates prelude definitions.
%% The prelude already defines DiffList type and dl_append, dl_to_list procedures.
%% Original content moved to .REMOVED for reference.

%% dl_append.glp - Difference list operations
%% Demonstrates O(1) append using difference list representation.

%% Type definitions
DiffList ::= List \ List?.

%% Procedure type declarations
procedure dl_append(DiffList?, DiffList?, DiffList).
procedure list_to_dl(List?, DiffList).
procedure dl_to_list(DiffList?, List).

%% dl_append(DL1, DL2, DL3) :- DL3 is concatenation of DL1 and DL2.
dl_append(H1\Xs?, Xs\T2?, H1?\T2).

%% Convert ordinary list to difference list
list_to_dl([], T\T?).
list_to_dl([X|Xs], [X?|H?]\T?) :- list_to_dl(Xs?, H\T).

%% Convert difference list to ordinary list (close the hole)
dl_to_list(H\[], H?).
