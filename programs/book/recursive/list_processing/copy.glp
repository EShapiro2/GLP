%% Type definitions
List ::= [] ; [Any | List].

%% Procedure type declarations
procedure copy(List?, List).
procedure reduce(Any?, Any).

%% copy.glp - List copying
%% Source: Standard GLP list operations

copy([], []).
copy([X|Xs], [X?|Ys?]) :- copy(Xs?, Ys).

%% Metainterpreter support
reduce(copy([], []), true).
reduce(copy([X|Xs], [X?|Ys?]), copy(Xs?, Ys)).
