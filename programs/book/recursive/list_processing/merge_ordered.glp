%% merge_ordered.glp - Merging ordered lists (AoP 7.2)
%% merge(Xs,Ys,Zs) :- Zs is an ordered list obtained from merging ordered lists Xs and Ys.

merge([X|Xs], [Y|Ys], Out) :- X? < Y? | Out = [X?|Zs?], merge(Xs?, [Y?|Ys?], Zs).
merge([X|Xs], [Y|Ys], Out) :- X? =:= Y? | Out = [X?,Y?|Zs?], merge(Xs?, Ys?, Zs).
merge([X|Xs], [Y|Ys], Out) :- X? > Y? | Out = [Y?|Zs?], merge([X?|Xs?], Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% reduce clauses for metainterpreter
reduce(merge([X|Xs], [Y|Ys], Out), (Out = [X?|Zs?], merge(Xs?, [Y?|Ys?], Zs))) :- X? < Y?.
reduce(merge([X|Xs], [Y|Ys], Out), (Out = [X?,Y?|Zs?], merge(Xs?, Ys?, Zs))) :- X? =:= Y?.
reduce(merge([X|Xs], [Y|Ys], Out), (Out = [Y?|Zs?], merge([X?|Xs?], Ys?, Zs))) :- X? > Y?.
reduce(merge([], Ys, Ys?), true).
reduce(merge(Xs, [], Xs?), true).
