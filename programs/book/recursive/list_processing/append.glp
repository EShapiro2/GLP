%% Type definitions
List ::= [] ; [Any | List].

%% Procedure type declarations
procedure append(List, List, List).
procedure reduce(Any, Any).

%% append.glp - List append
%% append(Xs, Ys, Zs) :- Zs is Xs followed by Ys

append([], Ys, Ys?).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).

%% Example goal: append([a,b], [c,d], Zs).
