%% dl_append.glp - Difference list append
%% O(1) concatenation using difference lists.

%% With \ operator: A\B appended to B\C gives A\C
dl_append(A\B, B?\C, A?\C?).

%% Convert difference list to regular list (close the hole)
dl_to_list(L\[], L?).

