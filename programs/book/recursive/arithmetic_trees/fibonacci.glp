%% Procedure type declarations
procedure fib(Number?, Number).
procedure fib_linear(Number?, Number).
procedure fib_acc(Number?, Number?, Number?, Number).
procedure reduce(Any?, Any).

%% fibonacci.glp - Fibonacci with concurrent recursive calls
%% Demonstrates true concurrent recursion.

fib(0, 0).
fib(1, 1).
fib(N, F?) :-
    N? > 1 |
    N1 := N? - 1,
    N2 := N? - 2,
    fib(N1?, F1),
    fib(N2?, F2),
    F := F1? + F2?.

%% Example goal: fib(10, F).
%% Expected: F = 55
