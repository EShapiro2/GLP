%% Type definitions
NumList ::= [] ; [Number | NumList].

%% Procedure type declarations
procedure sum(NumList, Number).
procedure sum(NumList, Number, Number).
procedure reduce(Any, Any).

%% sum_list.glp - Sum elements of a list with accumulator

sum(Xs, S?) :- sum(Xs?, 0, S).

sum([], Acc, Acc?).
sum([X|Xs], Acc, S?) :- ground(X?) | Acc1 := Acc? + X?, sum(Xs?, Acc1?, S).

%% Example goal: sum([1,2,3,4,5], S).
%% Expected: S = 15
