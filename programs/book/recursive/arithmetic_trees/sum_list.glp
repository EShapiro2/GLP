%% sum_list.glp - Sum of list elements in GLP
%% Source: Standard GLP arithmetic

%% Type definitions
NumList ::= [] ; [Number | NumList].

procedure sum(NumList?, Number).
sum(Xs, S?) :- sum(Xs?, 0, S).

procedure sum(NumList?, Number?, Number).
sum([], Acc, Acc?).
sum([X|Xs], Acc, S?) :- Acc1 := Acc? + X?, sum(Xs?, Acc1?, S).
