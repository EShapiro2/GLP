%% hanoi.glp - Tower of Hanoi in GLP
%% Source: Standard GLP examples

%% Type definitions
Move ::= move(_, _).
MoveList ::= [] ; [Move | MoveList].

exported procedure hanoi(Number?, _?, _?, MoveList).
hanoi(0, _, _, []).
hanoi(N, From, To, Moves?) :-
    number(N?), N? > 0, string(From?), string(To?) |
    N1 := N? - 1,
    other(From?, To?, Via),
    hanoi_two(N1?, From?, To?, Via?, M1, M2),
    append(M1?, [move(From?,To?)|M2?], Moves).

%% Helper to make two recursive hanoi calls
exported procedure hanoi_two(Number?, _?, _?, _?, MoveList, MoveList).
hanoi_two(N, From, To, Via, M1?, M2?) :-
    number(N?), string(From?), string(To?), string(Via?) |
    hanoi(N?, From?, Via?, M1),
    hanoi(N?, Via?, To?, M2).

exported procedure other(_?, _?, _).
other(a, b, c). other(a, c, b).
other(b, a, c). other(b, c, a).
other(c, a, b). other(c, b, a).

exported procedure append(MoveList?, MoveList?, MoveList).
append([], Ys, Ys?).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).
