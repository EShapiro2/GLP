%% bond_mediator.glp - UI mediator for Bond agent
%%
%% Translates between agent messages (msg/3 with non-ground channels)
%% and user/actor messages (ground terms with req IDs).
%%
%% Phase 1: mint, balance, done (all ground, pass-through)
%% Phase 2: befriend (non-ground Response in pending)
%% Phase 7: trade (non-ground TradeResp + data in pending)
%%
%% Date: 2026-03-03


%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Bond     ::= bond(Constant, Constant, Constant).
BondList ::= [] ; [Bond | BondList].

Lot     ::= lot(Constant, Constant, Constant).
LotList ::= [] ; [Lot | LotList].
TradeResponse ::= trade_accept(BondList)
               ; trade_decline(BondList)
               ; trade_decline_menu(BondList, BondList).

EscrowCancel    ::= cancel.
EscrowBenResult ::= escrow_bonds(BondList) ; escrow_cancelled.
EscrowDepResult ::= escrow_bonds(BondList) ; escrow_expired.

FriendContent ::= response(Response)
                ; text(Constant)
                ; trade_propose(LotList, BondList, TradeResponse?)
                ; escrow_offer(Constant, EscrowBenResult).
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

Response ::= accept(FriendChannel) ; no.
Decision ::= yes ; no.
ReqId    ::= req(Constant).

%% --- Agent-side content types ---

AgentContent ::= minted(Constant, Constant)
               ; balance_report(BondList)
               ; befriend(Constant, Response?)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; trade_proposed(Constant, LotList, TradeResponse?, BondList)
               ; trade_completed(Constant)
               ; trade_failed(Constant)
               ; trade_returned(Constant)
               ; escrow_deposited(Constant, Constant, EscrowCancel?)
               ; escrow_received(Constant, Constant)
               ; escrow_released(Constant)
               ; escrow_cancelled(Constant)
               ; escrow_expired(Constant)
               ; escrow_returned(Constant)
               ; escrow_failed(Constant)
               ; trade_returned_menu(Constant, BondList).

AgentToUserMsg    ::= msg(Constant, Constant, AgentContent).
AgentToUserStream ::= [] ; [AgentToUserMsg | AgentToUserStream].

PendingValue ::= response(Response?)
               ; trade_pending(TradeResponse?, LotList, BondList)
               ; escrow_pending(EscrowCancel?)
               ; error.

UserContent ::= mint(Constant, Constant)
              ; balance
              ; done
              ; connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; response(Response)
              ; trade(Constant, LotList, LotList)
              ; accept_trade(Constant, PendingValue)
              ; reject_trade(Constant, PendingValue)
              ; deposit_escrow(Constant, LotList, Constant)
              ; cancel_escrow(Constant, PendingValue).

MediatorToAgentMsg    ::= msg(Constant, Constant, UserContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].

AgentChannel ::= ch(AgentToUserStream, MediatorToAgentStream?).

%% --- User-side message types ---

UserCmd ::= mint(Constant, Constant)
          ; balance
          ; done
          ; connect(Constant)
          ; decision(Decision, Constant, ReqId)
          ; trade(Constant, LotList, LotList)
          ; accept_trade(Constant, ReqId)
          ; reject_trade(Constant, ReqId)
          ; deposit_escrow(Constant, LotList, Constant)
          ; cancel_escrow(Constant, ReqId).

UserNotify ::= minted(Constant, Constant)
             ; balance_report(BondList)
             ; befriend(Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; trade_proposed(Constant, LotList, ReqId)
             ; trade_completed(Constant)
             ; trade_failed(Constant)
             ; trade_returned(Constant)
             ; escrow_deposited(Constant, Constant, ReqId)
             ; escrow_received(Constant, Constant)
             ; escrow_released(Constant)
             ; escrow_cancelled(Constant)
             ; escrow_expired(Constant)
             ; escrow_returned(Constant)
             ; escrow_failed(Constant)
             ; trade_returned_menu(Constant, BondList).

UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].
UserChannel      ::= ch(UserCmdStream, UserNotifyStream?).

%% Pending entries
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).

%% =============================================================================
%% UI MEDIATOR - Main loop
%% =============================================================================

procedure ui_mediator(Constant?, AgentChannel?, UserChannel?, PendingList?, Constant?).

%% --- Agent-to-user: Phase 1 ground pass-through ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', minted(K, Maturity)),
            AgentCh?, AgentCh1),
    ground(K?), ground(Maturity?) |
    send(minted(K?, Maturity?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', balance_report(Holdings)),
            AgentCh?, AgentCh1),
    ground(Holdings?) |
    send(balance_report(Holdings?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: befriend (non-ground — store Response in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% --- Agent-to-user: connected (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(connected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected),
            AgentCh?, AgentCh1) |
    send(rejected, UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: Phase 1 pass-through ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(mint(K, Maturity), UserCh?, UserCh1),
    ground(Id?), ground(K?), ground(Maturity?) |
    send(msg('_user', Id?, mint(K?, Maturity?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(balance, UserCh?, UserCh1),
    ground(Id?) |
    send(msg('_user', Id?, balance),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(done, UserCh?, UserCh1),
    ground(Id?) |
    send(msg('_user', Id?, done),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: connect (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(connect(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg('_user', Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Dec?), ground(From?),
    ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, decision(Dec?, From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Agent-to-user: trade_proposed (non-ground — store TradeResp + data in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_proposed(From, WantSpec, TradeResp?, OfferedBonds)),
            AgentCh?, AgentCh1),
    ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    send(trade_proposed(From?, WantSpec?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), trade_pending(TradeResp, WantSpec?, OfferedBonds?)) | Ps?], N1?).

%% --- Agent-to-user: trade_completed (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_completed(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_completed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: trade_failed (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_failed(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_failed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: trade_returned (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_returned(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send(trade_returned(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: trade_returned_menu (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_returned_menu(From, Menu)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Menu?) |
    send(trade_returned_menu(From?, Menu?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: trade (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(trade(Target, GiveSpec, WantSpec), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    send(msg('_user', Id?, trade(Target?, GiveSpec?, WantSpec?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: accept_trade (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_trade(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, accept_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: reject_trade (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_trade(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, reject_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Agent-to-user: escrow_deposited (non-ground — store CancelSignal in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_deposited(Target, ReleaseTime, CancelSignal?)),
            AgentCh?, AgentCh1),
    ground(Target?), ground(ReleaseTime?) |
    send(escrow_deposited(Target?, ReleaseTime?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), escrow_pending(CancelSignal)) | Ps?], N1?).

%% --- Agent-to-user: escrow_received (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_received(From, ReleaseTime)),
            AgentCh?, AgentCh1),
    ground(From?), ground(ReleaseTime?) |
    send(escrow_received(From?, ReleaseTime?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_released (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_released(From)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(escrow_released(From?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_cancelled (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_cancelled(From)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(escrow_cancelled(From?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_expired (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_expired(Target)),
            AgentCh?, AgentCh1),
    ground(Target?) |
    send(escrow_expired(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_returned (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_returned(Target)),
            AgentCh?, AgentCh1),
    ground(Target?) |
    send(escrow_returned(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_failed (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_failed(Target)),
            AgentCh?, AgentCh1),
    ground(Target?) |
    send(escrow_failed(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: deposit_escrow (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(deposit_escrow(Target, GiveSpec, ReleaseTime), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(GiveSpec?), ground(ReleaseTime?) |
    send(msg('_user', Id?, deposit_escrow(Target?, GiveSpec?, ReleaseTime?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: cancel_escrow (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(cancel_escrow(Target, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, cancel_escrow(Target?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).
