%% math_module.glp - Simple math module
%% Module name defaults to: math_module

procedure factorial(Number?, Number).
factorial(0, 1).
factorial(N, F?) :-
    N? > 0 |
    N1 := N? - 1,
    factorial(N1?, F1),
    F := N? * F1?.

procedure gcd(Number?, Number?, Number).
gcd(A, 0, A?).
gcd(A, B, G?) :-
    B? > 0 |
    R := A? mod B?,
    gcd(B?, R?, G).

procedure reduce(_?, _).
