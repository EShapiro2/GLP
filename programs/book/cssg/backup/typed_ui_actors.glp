%% --- Dave (play7) — rejects ---

procedure dave7(Channel(X, Y)?).
dave7(ch([child_befriend(bob, carol, ReqId)|_],
         [reject_child_intro(carol, ReqId?)])) :-
    ground(ReqId?) | true.
dave7(ch([_|In], Out?)) :-
    otherwise | dave7(ch(In?, Out)).
