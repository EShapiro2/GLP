procedure alice10_wait_unfriended(UserNotifyStream?, UserCmdStream).
alice10_wait_unfriended([unfriended(bob)|In], Out?) :-
    alice10_wait_befriend(In?, Out).
alice10_wait_unfriended([_|In], Out?) :-
    otherwise | alice10_wait_unfriended(In?, Out).
