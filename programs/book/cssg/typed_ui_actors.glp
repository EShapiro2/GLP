%% =============================================================================
%% PLAY 8 — Unfriend: Alice connects Bob, then unfriends, Bob tries to send
%% =============================================================================

%% --- Alice (play8) ---
%% 1. connect(bob)
%% 2. Wait connected(bob) → unfriend(bob)
%% 3. Wait unfriended(bob) → done

procedure alice8(ActorChannel?).
alice8(ch(In, [connect(bob)|Out?])) :-
    alice8_wait_connected(In?, Out).

procedure alice8_wait_connected(UserNotifyStream?, UserCmdStream).
alice8_wait_connected([connected(bob)|In],
                      [unfriend(bob)|Out?]) :-
    alice8_wait_unfriended(In?, Out).
alice8_wait_connected([_|In], Out?) :-
    otherwise | alice8_wait_connected(In?, Out).
alice8_wait_connected([], []).

procedure alice8_wait_unfriended(UserNotifyStream?, UserCmdStream).
alice8_wait_unfriended([unfriended(bob)|_], []).
alice8_wait_unfriended([_|In], Out?) :-
    otherwise | alice8_wait_unfriended(In?, Out).
alice8_wait_unfriended([], []).

%% --- Bob (play8) ---
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait unfriended(alice) → send(alice, hello) (silently dropped)
%% 4. Done

procedure bob8(ActorChannel?).
bob8(ch([befriend(alice, ReqId)|In],
        [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob8_wait_connected(In?, Out).
bob8(ch([_|In], Out?)) :-
    otherwise | bob8(ch(In?, Out)).

procedure bob8_wait_connected(UserNotifyStream?, UserCmdStream).
bob8_wait_connected([connected(alice)|In], Out?) :-
    bob8_wait_unfriended(In?, Out).
bob8_wait_connected([_|In], Out?) :-
    otherwise | bob8_wait_connected(In?, Out).
bob8_wait_connected([], []).

procedure bob8_wait_unfriended(UserNotifyStream?, UserCmdStream).
bob8_wait_unfriended([unfriended(alice)|_],
                     [send(alice, hello)]).
bob8_wait_unfriended([_|In], Out?) :-
    otherwise | bob8_wait_unfriended(In?, Out).
bob8_wait_unfriended([], []).

%% =============================================================================
%% PLAY 9 — Re-friend after unfriend (unfriender re-initiates)
%% Alice connects Bob, Bob accepts, Alice unfriends Bob,
%% Alice re-connects Bob, Bob accepts again, Bob sends hi to Alice
%% =============================================================================

%% --- Alice (play9) ---
%% 1. connect(bob)
%% 2. Wait connected(bob) → unfriend(bob)
%% 3. Wait unfriended(bob) → connect(bob) again
%% 4. Wait connected(bob) → done

procedure alice9(ActorChannel?).
alice9(ch(In, [connect(bob)|Out?])) :-
    alice9_wait_connected1(In?, Out).

procedure alice9_wait_connected1(UserNotifyStream?, UserCmdStream).
alice9_wait_connected1([connected(bob)|In],
                       [unfriend(bob)|Out?]) :-
    alice9_wait_unfriended(In?, Out).
alice9_wait_connected1([_|In], Out?) :-
    otherwise | alice9_wait_connected1(In?, Out).
alice9_wait_connected1([], []).

procedure alice9_wait_unfriended(UserNotifyStream?, UserCmdStream).
alice9_wait_unfriended([unfriended(bob)|In],
                       [connect(bob)|Out?]) :-
    alice9_wait_connected2(In?, Out).
alice9_wait_unfriended([_|In], Out?) :-
    otherwise | alice9_wait_unfriended(In?, Out).
alice9_wait_unfriended([], []).

procedure alice9_wait_connected2(UserNotifyStream?, UserCmdStream).
alice9_wait_connected2([connected(bob)|_], []).
alice9_wait_connected2([_|In], Out?) :-
    otherwise | alice9_wait_connected2(In?, Out).
alice9_wait_connected2([], []).

%% --- Bob (play9) ---
%% 1. Wait befriend(alice) → accept
%% 2. Wait connected(alice)
%% 3. Wait unfriended(alice)
%% 4. Wait befriend(alice) again → accept
%% 5. Wait connected(alice) → send(alice, hi)
%% 6. Done

procedure bob9(ActorChannel?).
bob9(ch([befriend(alice, ReqId)|In],
        [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob9_wait_connected1(In?, Out).
bob9(ch([_|In], Out?)) :-
    otherwise | bob9(ch(In?, Out)).

procedure bob9_wait_connected1(UserNotifyStream?, UserCmdStream).
bob9_wait_connected1([connected(alice)|In], Out?) :-
    bob9_wait_unfriended(In?, Out).
bob9_wait_connected1([_|In], Out?) :-
    otherwise | bob9_wait_connected1(In?, Out).
bob9_wait_connected1([], []).

procedure bob9_wait_unfriended(UserNotifyStream?, UserCmdStream).
bob9_wait_unfriended([unfriended(alice)|In], Out?) :-
    bob9_wait_befriend2(In?, Out).
bob9_wait_unfriended([_|In], Out?) :-
    otherwise | bob9_wait_unfriended(In?, Out).
bob9_wait_unfriended([], []).

procedure bob9_wait_befriend2(UserNotifyStream?, UserCmdStream).
bob9_wait_befriend2([befriend(alice, ReqId)|In],
                    [decision(yes, alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob9_wait_connected2(In?, Out).
bob9_wait_befriend2([_|In], Out?) :-
    otherwise | bob9_wait_befriend2(In?, Out).
bob9_wait_befriend2([], []).

procedure bob9_wait_connected2(UserNotifyStream?, UserCmdStream).
bob9_wait_connected2([connected(alice)|_],
                     [send(alice, hi)]).
bob9_wait_connected2([_|In], Out?) :-
    otherwise | bob9_wait_connected2(In?, Out).
bob9_wait_connected2([], []).

%% =============================================================================
%% PLAY 10 — Re-friend after unfriend (unfriended party initiates)
%% Alice connects Bob, Bob accepts, Alice unfriends Bob,
%% Bob connects Alice, Alice accepts, Alice sends hi to Bob
%% =============================================================================

%% --- Alice (play10) ---
%% 1. connect(bob)
%% 2. Wait connected(bob) → unfriend(bob)
%% 3. Wait unfriended(bob)
%% 4. Wait befriend(bob) → accept
%% 5. Wait connected(bob) → send(bob, hi)
%% 6. Done

procedure alice10(ActorChannel?).
alice10(ch(In, [connect(bob)|Out?])) :-
    alice10_wait_connected1(In?, Out).

procedure alice10_wait_connected1(UserNotifyStream?, UserCmdStream).
alice10_wait_connected1([connected(bob)|In],
                        [unfriend(bob)|Out?]) :-
    alice10_wait_unfriended(In?, Out).
