    ground(ReqId?) |
    alice10_wait_connected2(In?, Out).
alice10_wait_befriend([_|In], Out?) :-
    otherwise | alice10_wait_befriend(In?, Out).
alice10_wait_befriend([], []).

procedure alice10_wait_connected2(UserNotifyStream?, UserCmdStream).
alice10_wait_connected2([connected(bob)|_],
                        [send(bob, hi)]).
alice10_wait_connected2([_|In], Out?) :-
    otherwise | alice10_wait_connected2(In?, Out).
alice10_wait_connected2([], []).

%% --- Bob (play10) ---
%% 1. Wait befriend(alice) → accept
%% 2. Wait connected(alice)
%% 3. Wait unfriended(alice) → connect(alice)
%% 4. Wait connected(alice)
%% 5. Done

procedure bob10(ActorChannel?).
bob10(ch([befriend(alice, ReqId)|In],
         [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob10_wait_connected1(In?, Out).
bob10(ch([_|In], Out?)) :-
    otherwise | bob10(ch(In?, Out)).

procedure bob10_wait_connected1(UserNotifyStream?, UserCmdStream).
bob10_wait_connected1([connected(alice)|In], Out?) :-
    bob10_wait_unfriended(In?, Out).
bob10_wait_connected1([_|In], Out?) :-
    otherwise | bob10_wait_connected1(In?, Out).
