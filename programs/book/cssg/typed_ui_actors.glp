procedure bob10_wait_unfriended(UserNotifyStream?, UserCmdStream).
bob10_wait_unfriended([unfriended(alice)|In],
                      [connect(alice)|Out?]) :-
    bob10_wait_connected2(In?, Out).
bob10_wait_unfriended([_|In], Out?) :-
    otherwise | bob10_wait_unfriended(In?, Out).
