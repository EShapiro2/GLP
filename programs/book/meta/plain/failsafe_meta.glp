%% failsafe_meta.glp - Fail-safe GLP metainterpreter
%% Owner: GLP-ICLP (Program: GLP fail-safe metainterpreter)
%%
%% A run is normally aborted once a goal fails. This metainterpreter instead
%% reports failures on a stream: the object program's reduce encoding ends
%% with the catch-all clause
%%     reduce(A, failed(A?)) :- otherwise | true.
%% which returns the failed goal as the term failed(A) for further processing.
%% Each fork merges the failure streams of its two branches.

procedure run(_?, Stream(_)).
run(true, []).                                                 % halt
run((A, B), Zs?) :-                                            % fork
    run(A?, Xs), run(B?, Ys), merge(Xs?, Ys?, Zs).
run(failed(A), [failed(A?)]).                                  % report failure
run(A, Xs?) :- known(A?) | reduce(A?, B), run(B?, Xs).         % reduce

%% Object program: merge, with the fail-safe catch-all
procedure reduce(_?, _).
reduce(merge([X|Xs], Ys, [X?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge(Xs, [Y|Ys], [Y?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge([], [], []), true).
reduce(A, failed(A?)) :- otherwise | true.

%% Example initial goal (nogood fails; the run reports it and completes):
%% run((merge([1],[],Xs), nogood), Fs).
