%% metainterpreter.glp - Basic GLP metainterpreter

run(true).
run((A, B)) :- run(A?), run(B?).
run(A) :- otherwise | clause(A?, B), run(B?).

%% clause/2 must be defined for the object program.
%% Example:
%% clause(append([], Ys, Ys?), true).
%% clause(append([X|Xs], Ys, [X?|Zs?]), append(Xs?, Ys?, Zs)).
