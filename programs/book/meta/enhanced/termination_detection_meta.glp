%% termination_detection_meta.glp - Termination detecting metainterpreter
%% Source: CP Collected Papers, Ch 25 (Safra & Shapiro)
%%
%% Uses short-circuit technique to detect distributed termination.

run(_, true, L, L?).                             % halt - close circuit
run(M, (A, B), L, R?) :-                         % fork - split chain
    run(M?, A?, L?, Mid),
    run(M?, B?, Mid?, R).
run(M, M1 # G, L, R?) :- run(M1?, G?, L?, R).    % cross-module
run(M, A, L, R?) :-                              % reduce
    tuple(A?) |
    M? # reduce(A?, B),
    run(M?, B?, L?, R).

%% Termination detected when Result? becomes known(done)
%% Example: run(module, Goal, done, Result), known(Result?) | ...
