%% control_meta.glp - GLP metainterpreter with run control
%% Owner: GLP-ICLP (Program: GLP metainterpreter with run control)
%%
%% A run can be suspended, resumed, and aborted via a control stream.
%% Control messages are ground, so the control stream is distributed to all
%% metainterpreter instances that participate in the run.

procedure run(_?, Stream(Constant)?).
run(true, _).                                                  % halt
run((A, B), Cs) :-                                             % fork
    distribute(Cs?, Cs1, Cs2),
    run(A?, Cs1?), run(B?, Cs2?).
run(A, [suspend|Cs]) :- suspended_run(A?, Cs?).                % suspend
run(A, Cs) :- known(A?), unknown(Cs?) |                        % reduce
    reduce(A?, B), run(B?, Cs?).
run(A, []) :- known(A?) |                                      % control closed: run freely
    reduce(A?, B), run(B?, []).

procedure suspended_run(_?, Stream(Constant)?).
suspended_run(A, [resume|Cs]) :- run(A?, Cs?).                 % resume
suspended_run(_, [abort|_]).                                   % abort
suspended_run(_, []).                                          % control closed: drop goal

%% Ground-stream distribution (control messages are ground)
procedure distribute(Stream(Constant)?, Stream(Constant), Stream(Constant)).
distribute([X|Xs], [X?|Ys1?], [X?|Ys2?]) :- ground(X?) | distribute(Xs?, Ys1, Ys2).
distribute([], [], []).

%% Object program: merge
procedure reduce(_?, _).
reduce(merge([X|Xs], Ys, [X?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge(Xs, [Y|Ys], [Y?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge([], [], []), true).

%% Example initial goals:
%% run(merge([1,2],[3],Xs), [suspend,resume]).   %% suspends, resumes, completes
%% run(merge([1,2],[3],Xs), [suspend,abort]).    %% suspends, aborts (Xs left unbound)
