%% control_meta.glp - GLP metainterpreter with run control
%% Source: GLP Papers (Program: GLP metainterpreter with run control)
%%
%% TYPE CHECKER NOTE: This program requires parameterized types and a typed
%% module system (cross-module calls via #). Will be supported in a future version.
%%
%% Supports suspend, resume, and abort via control stream.
%% Uses short-circuit L--R for state dump on abort.

%% Type definitions
ControlCmd ::= suspend ; resume ; abort.
ControlList ::= [] ; [ControlCmd | ControlList].
DumpList ::= [] ; [_ | DumpList].

%% External procedure declarations (no clauses in this file)
procedure reduce(_?, _).

procedure run(_?, _?, ControlList?, DumpList?, DumpList).
run(_, true, _, L, L?).                          % halt
run(M, (A, B), Cs, L, R?) :-                     % fork
    ground(M?), ground(Cs?) |
    run(M?, A?, Cs?, L?, Mid),
    run(M?, B?, Cs?, Mid?, R).
run(_, M1 # G, Cs, L, R?) :-                     % cross-module
    run(M1?, G?, Cs?, L?, R).
run(M, A, [suspend|Cs], L, R?) :-                % suspend
    suspended_run(M?, A?, Cs?, L?, R).
run(M, A, Cs, L, R?) :-                          % reduce
    compound(A?), ground(M?) |
    M? # reduce(A?, B),
    run(M?, B?, Cs?, L?, R).

procedure suspended_run(_?, _?, ControlList?, DumpList?, DumpList).
suspended_run(M, A, [resume|Cs], L, R?) :-       % resume
    run(M?, A?, Cs?, L?, R).
suspended_run(_, A, [abort|_], L, [A?|L?]).      % abort + dump

%% Example usage:
%% ?- run(merge_module, Goal, [suspend, resume, abort|_], done, Dump).
