%% tracing_meta.glp - Tracing GLP metainterpreter
%% Owner: GLP-ICLP (Program: GLP tracing metainterpreter)
%%
%% Produces a trace of the run, which a retracing metainterpreter can use to
%% single-step through the very same run, repeating its nondeterministic
%% scheduling choices. Each program clause A :- G | B is represented by a unit
%% clause reduce(A, B, I) :- G | true, with I the serial number of the clause
%% in the program. Each reduction is recorded as the trace node
%% t(I, Time, SubTrace).

procedure run(_?, _).
run(true, true).                                               % halt
run((A, B), (TA?, TB?)) :- run(A?, TA), run(B?, TB).           % fork
run(A, t(I?, Time?, TB?)) :- known(A?) |                       % reduce
    now(Time), reduce(A?, B, I), run(B?, TB).

%% Object program: merge, with clause serial numbers
procedure reduce(_?, _, Integer).
reduce(merge([X|Xs], Ys, [X?|Zs?]), merge(Xs?, Ys?, Zs), 1).
reduce(merge(Xs, [Y|Ys], [Y?|Zs?]), merge(Xs?, Ys?, Zs), 2).
reduce(merge([], [], []), true, 3).

%% Example initial goal:
%% run(merge([1],[],Xs), T).   %% T = t(1, T1, t(3, T2, true)), T1/T2 timestamps
