%% friend_mediated_rendezvous.glp - Friend-Mediated Rendezvous
%%
%% A social-graph extension for cascade reconnection: when A loses
%% connectivity to C, but both are connected to a common friend B,
%% B mediates the reconnection by sending punch instructions to both.
%%
%% This is a self-contained illustration for the paper — not a production
%% integration into the full social graph protocol.
%%
%% Protocol:
%%   1. A sends B: msg(A, B, mediate(C))
%%   2. B looks up A's and C's addresses in its friends list
%%   3. B sends C: msg(B, C, punch_to(addr_A))   — via B's existing link to C
%%   4. B sends A: msg(B, A, punch_to(addr_C))   — via B's existing link to A
%%   5. A and C each receive punch_to and call punch_udp(Addr)
%%
%% Address updates: when an agent's address changes, it notifies its friends
%% via msg(_, _, addr_update(NewAddr)).  Recipients update their friends list.
%%
%% System predicates assumed:
%%   punch_udp(Addr?) — body predicate, initiates UDP hole-punch to Addr

-module(fmrv).

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Friend-mediated rendezvous message operations
MsgOp ::= mediate(Constant)       %% mediate(C_pk) — A asks B to help reconnect to C
        ; punch_to(Constant)      %% punch_to(Addr) — instruction to hole-punch to Addr
        ; addr_update(Constant).  %% addr_update(NewAddr) — notify friends of address change

%% Protocol message: msg(From, To, Op)
Msg ::= msg(Constant, Constant, MsgOp).

%% Input stream to the agent
MsgStream ::= [] ; [Msg | MsgStream].

%% Per-friend output stream
FriendStream ::= [] ; [Msg | FriendStream].

%% Extended friends list: fe(Name, OutputStream, Addr)
%% The `?` on FriendStream indicates the data carries a reader reference
%% to the friend's output stream; the agent holds the paired writer and
%% prepends messages by binding the writer.
FriendEntry ::= fe(Constant, FriendStream?, Constant).
FriendList ::= [] ; [FriendEntry | FriendList].

%% =============================================================================
%% MAIN LOOP
%% =============================================================================

exported procedure fmrv(Constant?, MsgStream?, FriendList?).

%% Address update: a friend tells us its new address — update friends list
fmrv(Id, [msg(From, To, addr_update(Addr))|In], Fs) :-
    ground(Id?), Id? =?= To? |
    update_addr(From?, Addr?, Fs?, Fs1),
    fmrv(Id?, In?, Fs1?).

%% Mediation request: A asks us (B=Id) to help reconnect to C.
%% We use fused lookup-and-send: each call looks up a friend by key,
%% binds that friend's address, and prepends a punch_to message to
%% the friend's output stream in a single traversal.
%%
%% The two punch_to messages contain each other's addresses.  The
%% second call (for C) binds AddrC; the first call's body already
%% prepended msg(_, From, punch_to(AddrC?)) where AddrC? is still
%% unbound — the stream writer fills in as soon as AddrC is bound.
fmrv(Id, [msg(From, To, mediate(C))|In], Fs) :-
    ground(Id?), ground(From?), ground(C?), Id? =?= To? |
    lookup_and_send(From?, Id?, AddrC?, AddrFrom, Fs?, Fs1),
    lookup_and_send(C?, Id?, AddrFrom?, AddrC, Fs1?, Fs2),
    fmrv(Id?, In?, Fs2?).

%% Punch instruction received: do UDP hole punch
fmrv(Id, [msg(_, To, punch_to(Addr))|In], Fs) :-
    ground(Id?), Id? =?= To? |
    punch_udp(Addr?),
    fmrv(Id?, In?, Fs?).

fmrv(_, [], _).

%% =============================================================================
%% lookup_and_send: fused lookup + send in a single traversal
%% =============================================================================
%%
%% Args: Key, Id, OtherAddr, KeyAddr, FsIn, FsOut
%%
%% Finds Key's entry in Fs.  When found:
%%   (a) Prepends msg(Id, Key, punch_to(OtherAddr)) to Key's output stream
%%   (b) Binds KeyAddr to Key's own address from the entry
%% Otherwise passes the entry through unchanged and recurses.

procedure lookup_and_send(Constant?, Constant?, Constant?, Constant,
                          FriendList?, FriendList).

%% Match: this is Key's entry.  The output stream at fe field 2 is
%% `FriendStream?`, so the `?` flips the mode at that position.  In the
%% input head, field 2 is at ↑ → we use the reader form and deconstruct
%% the stream as `[msg(...)|Out1?]`.  In the output head, field 2 is at
%% ↓ → we pass `Out1` (writer) which will carry the remaining tail.
lookup_and_send(Key, Id, OtherAddr, Addr?,
    [fe(K, [msg(Id?, K?, punch_to(OtherAddr?))|Out1?], Addr)|Rest],
    [fe(K?, Out1, Addr?)|Rest?]) :-
    Key? =?= K? | true.

%% No match: pass entry through, continue searching
lookup_and_send(Key, Id, OtherAddr, KeyAddr?,
    [F|Rest], [F?|Rest1?]) :-
    otherwise |
    lookup_and_send(Key?, Id?, OtherAddr?, KeyAddr, Rest?, Rest1).

%% End of list: Key not found; KeyAddr gets a sentinel
lookup_and_send(_, _, _, 'unknown', [], []).

%% =============================================================================
%% update_addr: replace a friend's address in the friends list
%% =============================================================================

procedure update_addr(Constant?, Constant?, FriendList?, FriendList).
update_addr(Key, NewAddr, [fe(K, Out?, _)|Fs], [fe(K?, Out, NewAddr?)|Fs?]) :-
    Key? =?= K? | true.
update_addr(Key, NewAddr, [F|Fs], [F?|Fs1?]) :-
    otherwise | update_addr(Key?, NewAddr?, Fs?, Fs1).
update_addr(_, _, [], []).

%% =============================================================================
%% STUB for system predicate
%% =============================================================================
%%
%% punch_udp(Addr?) — body predicate
%%   Real: initiates UDP hole-punch to Addr.
%%   Stub: always succeeds.

procedure punch_udp(Constant?).
punch_udp(_).
