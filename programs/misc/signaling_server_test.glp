%% signaling_server_test.glp — test suite for signaling_server.glp
%%
%% Load signaling_server.glp first, then this file, then invoke test goals.

%% Local type redeclarations (structural identity allows sharing across modules)
SignalReply ::= punch(Constant) ; initiated.

PendingEntry ::= needs(Constant, Constant, Constant, SignalReply?)
               ; ready(Constant, Constant, SignalReply?).
PendingList ::= [] ; [PendingEntry | PendingList].

SignalMsg ::= reconnect(Constant, Constant, Constant, SignalReply?)
            ; available(Constant, Constant, SignalReply?).

imported procedure signaling_server#find_ready(Constant?, Constant?, Constant?,
                                                SignalReply,
                                                PendingList?, PendingList).
imported procedure signaling_server#find_needs(Constant?, Constant?, SignalReply,
                                                PendingList?, PendingList).
imported procedure signaling_server#signal_server(Stream(SignalMsg)?,
                                                   PendingList?).

%% =============================================================================
%% Test 1: A arrives first, no B waiting → entry stored in pending
%% =============================================================================

procedure test1_needs_stored(PendingList).
test1_needs_stored(Pending1?) :-
    signaling_server # find_ready(alice, bob, addr_a, _, [], Pending1).

%% Expected: Pending1 = [needs(alice, bob, addr_a, _)]

%% =============================================================================
%% Test 2: B arrives first, no A waiting → entry stored in pending
%% =============================================================================

procedure test2_ready_stored(PendingList).
test2_ready_stored(Pending1?) :-
    signaling_server # find_needs(alice, bob, _, [], Pending1).

%% Expected: Pending1 = [ready(bob, alice, _)]

%% =============================================================================
%% Test 3: A arrives after B is waiting → match, replies get bound
%% =============================================================================
%% Set up pending = [ready(bob, alice, RB)] then call find_ready.
%% Expect: RA is bound to punch(addr_a), RB is bound to initiated.

procedure test3_match_find_ready(SignalReply, SignalReply, PendingList).
test3_match_find_ready(ReplyA?, ReplyB?, Pending1?) :-
    signaling_server # find_ready(alice, bob, addr_a, ReplyA,
                                   [ready(bob, alice, ReplyB)], Pending1).

%% Expected: ReplyA = punch(addr_a), ReplyB = initiated, Pending1 = []

%% =============================================================================
%% Test 4: B arrives after A is waiting → match, replies get bound
%% =============================================================================
%% Set up pending = [needs(alice, bob, addr_a, RA)] then call find_needs.
%% Expect: RA is bound to punch(addr_a), RB is bound to initiated.

procedure test4_match_find_needs(SignalReply, SignalReply, PendingList).
test4_match_find_needs(ReplyA?, ReplyB?, Pending1?) :-
    signaling_server # find_needs(alice, bob, ReplyB,
                                   [needs(alice, bob, addr_a, ReplyA)], Pending1).

%% Expected: ReplyA = punch(addr_a), ReplyB = initiated, Pending1 = []

%% =============================================================================
%% Test 5: find_ready with non-matching ready entry → pass-through, store needs
%% =============================================================================
%% Pending = [ready(carol, dave, _)], A=alice wants bob → no match, store.

procedure test5_find_ready_no_match(PendingList).
test5_find_ready_no_match(Pending1?) :-
    signaling_server # find_ready(alice, bob, addr_a, _,
                                   [ready(carol, dave, _)], Pending1).

%% Expected: Pending1 = [ready(carol, dave, _), needs(alice, bob, addr_a, _)]

%% =============================================================================
%% Test 6: find_ready with multiple entries, one matches
%% =============================================================================
%% Pending = [ready(carol, dave, _), ready(bob, alice, RB)] — second matches.

procedure test6_find_ready_skip_then_match(SignalReply, SignalReply, PendingList).
test6_find_ready_skip_then_match(ReplyA?, ReplyB?, Pending1?) :-
    signaling_server # find_ready(alice, bob, addr_a, ReplyA,
                                   [ready(carol, dave, _),
                                    ready(bob, alice, ReplyB)], Pending1).

%% Expected: ReplyA = initiated, ReplyB = punch(addr_a),
%%           Pending1 = [ready(carol, dave, _)]

%% =============================================================================
%% Test 7: Run signal_server on a single reconnect message
%% =============================================================================
%% Stream = [reconnect(alice, bob, proof, ReplyA)], expect server to store
%% needs entry and terminate. ReplyA remains unbound (nobody is there to match).

procedure test7_server_single_reconnect(SignalReply).
test7_server_single_reconnect(ReplyA?) :-
    signaling_server # signal_server(
        [reconnect(alice, bob, proof, ReplyA)], []).

%% Expected: ReplyA unbound (suspended), server terminates on empty stream

%% =============================================================================
%% Test 8: Run signal_server with available then reconnect (B first, A second)
%% =============================================================================
%% Stream = [available(bob, alice, ReplyB), reconnect(alice, bob, proof, ReplyA)]
%% Expect both reply variables to get bound.

procedure test8_server_full_rendezvous(SignalReply, SignalReply).
test8_server_full_rendezvous(ReplyA?, ReplyB?) :-
    signaling_server # signal_server(
        [available(bob, alice, ReplyB),
         reconnect(alice, bob, proof, ReplyA)], []).

%% Expected: ReplyA = initiated, ReplyB = punch(stub_addr)

%% =============================================================================
%% Test 9: Two reconnect messages for unrelated pairs → both stored
%% =============================================================================

procedure test9_two_reconnects_no_match(SignalReply, SignalReply).
test9_two_reconnects_no_match(RA1?, RA2?) :-
    signaling_server # signal_server(
        [reconnect(alice, bob, proof1, RA1),
         reconnect(carol, dave, proof2, RA2)], []).

%% Expected: RA1 and RA2 both unbound (both stored as needs entries)

%% =============================================================================
%% Test 10: reconnect, then available for same pair → match on second msg
%% =============================================================================

procedure test10_reconnect_then_available(SignalReply, SignalReply).
test10_reconnect_then_available(RA?, RB?) :-
    signaling_server # signal_server(
        [reconnect(alice, bob, proof, RA),
         available(bob, alice, RB)], []).

%% Expected: RA = punch(stub_addr), RB = initiated
