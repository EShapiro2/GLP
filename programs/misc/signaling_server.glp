%% signaling_server.glp - Lightweight Reconnection Signaling Server
%%
%% A minimal GLP agent that coordinates reconnection between agents
%% that lost connectivity due to IP address changes.
%%
%% - Accepts cold-calls from any agent (no friends list, no social graph)
%% - Verifies friendship proofs cryptographically
%% - Relays addresses to coordinate hole-punching
%%
%% Protocol:
%%   1. A detects IP change, cold-calls S: reconnect(A_pk, B_pk, Proof, Reply)
%%   2. B detects A went silent, cold-calls S: available(B_pk, A_pk, Reply)
%%   3. S matches the requests, tells B to punch to A's address via Reply
%%
%% System predicates assumed:
%%   verify_friendship(Proof?, A?, B?) — guard, verifies A is B's friend
%%   peer_address(A?, Addr) — guard, unifies Addr with A's observed public address

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Reply sent back to agents via their reply variable
SignalReply ::= punch(Constant) ; initiated.

%% Messages arriving via cold-call on the server's input stream
SignalMsg ::= reconnect(Constant, Constant, Constant, SignalReply?)
              %% reconnect(A_pk, B_pk, Proof, Reply)
            ; available(Constant, Constant, SignalReply?).
              %% available(B_pk, A_pk, Reply)

%% Pending entries awaiting a match
PendingEntry ::= needs(Constant, Constant, Constant, SignalReply?)
                 %% needs(A_pk, B_pk, AddrA, ReplyA?) — A wants to reconnect to B
               ; ready(Constant, Constant, SignalReply?).
                 %% ready(B_pk, A_pk, ReplyB?) — B is available for A
PendingList ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% MAIN LOOP
%% =============================================================================

exported procedure signal_server(Stream(SignalMsg)?, PendingList?).

%% A requests reconnection to B with friendship proof
signal_server([reconnect(A, B, Proof, ReplyA?)|In], Pending) :-
    verify_friendship(Proof?, A?, B?),
    peer_address(A?, AddrA) |
    find_ready(A?, B?, AddrA?, ReplyA, Pending?, Pending1),
    signal_server(In?, Pending1?).

%% B is available for reconnection from A
signal_server([available(B, A, ReplyB?)|In], Pending) :-
    find_needs(A?, B?, ReplyB, Pending?, Pending1),
    signal_server(In?, Pending1?).

signal_server([], _).

%% =============================================================================
%% find_ready: A arrived, search pending for a matching ready(B, A, ReplyB)
%% =============================================================================

exported procedure find_ready(Constant?, Constant?, Constant?, SignalReply,
                              PendingList?, PendingList).

%% Match found: B was waiting — assign replies
find_ready(A, B, AddrA, ReplyA?, [ready(B2, A2, ReplyB?)|Ps], Ps?) :-
    A? =?= A2?, B? =?= B2? |
    complete_rendezvous(AddrA?, ReplyA, ReplyB).

%% No match at this entry, keep searching
find_ready(A, B, AddrA, ReplyA?, [P|Ps], [P?|Ps1?]) :-
    otherwise |
    find_ready(A?, B?, AddrA?, ReplyA, Ps?, Ps1).

%% End of list, no match: store A's request in pending
find_ready(A, B, AddrA, ReplyA?, [], [needs(A?, B?, AddrA?, ReplyA)]).

%% =============================================================================
%% find_needs: B arrived, search pending for a matching needs(A, B, AddrA, ReplyA)
%% =============================================================================

exported procedure find_needs(Constant?, Constant?, SignalReply,
                              PendingList?, PendingList).

%% Match found: A was waiting — assign replies
find_needs(A, B, ReplyB?, [needs(A2, B2, AddrA, ReplyA?)|Ps], Ps?) :-
    A? =?= A2?, B? =?= B2? |
    complete_rendezvous(AddrA?, ReplyA, ReplyB).

%% No match at this entry, keep searching
find_needs(A, B, ReplyB?, [P|Ps], [P?|Ps1?]) :-
    otherwise |
    find_needs(A?, B?, ReplyB, Ps?, Ps1).

%% End of list, no match: store B's availability in pending
find_needs(A, B, ReplyB?, [], [ready(B?, A?, ReplyB)]).

%% =============================================================================
%% complete_rendezvous: Both sides matched — assign reply variables
%% =============================================================================
%%
%% AddrA is A's public address (Constant, from peer_address)
%% ReplyA? and ReplyB? are readers chained from the original reply writers
%%   in the cold-call messages. Assigning the paired writers here propagates
%%   punch(AddrA) back to B and initiated back to A.
%%
%% NOTE: This is the part I'm least sure about.  The reply variables have been
%% passed through as reader references.  I believe assignment via the writers
%% (constructed in head) propagates back to the original agents, but this
%% needs verification.

procedure complete_rendezvous(Constant?, SignalReply, SignalReply).
complete_rendezvous(AddrA, initiated, punch(AddrA?)).

%% =============================================================================
%% STUBS for system predicates (testing only)
%% =============================================================================
%%
%% verify_friendship(Proof?, A_pk?, B_pk?) — guard
%%   Succeeds if Proof cryptographically proves that A is B's friend.
%%   Stub: always succeeds.
%%
%% peer_address(PubKey?, Addr) — guard
%%   Suspends until peer PubKey is connected.
%%   Stub: always returns 'stub_addr'.

procedure verify_friendship(Constant?, Constant?, Constant?).
verify_friendship(_, _, _).

procedure peer_address(Constant?, Constant).
peer_address(_, 'stub_addr').
