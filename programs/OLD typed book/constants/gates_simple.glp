%% Procedure type declarations
procedure and(Number, Number, Number).
procedure or(Number, Number, Number).
procedure not(Number, Number).
procedure xor(Number, Number, Number).

%% gates_simple.glp - Simple logic gates as facts
%% Source: AofGLP Book Chapter 4
%%
%% Basic gates for teaching constant unification.
%% Each gate is defined by exhaustive enumeration.

%% AND gate
and(1, 1, 1).
and(1, 0, 0).
and(0, 1, 0).
and(0, 0, 0).

%% OR gate
or(1, 1, 1).
or(1, 0, 1).
or(0, 1, 1).
or(0, 0, 0).

%% NOT gate
not(1, 0).
not(0, 1).

%% XOR gate
xor(1, 1, 0).
xor(1, 0, 1).
xor(0, 1, 1).
xor(0, 0, 0).
