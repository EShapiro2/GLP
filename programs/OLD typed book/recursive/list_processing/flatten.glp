%% Type definitions
List ::= [] ; [Any | List].

%% Procedure type declarations
procedure flatten(List, List).
procedure flatten_dl(List, List, List).
procedure is_list(Any).
procedure reduce(Any, Any).

%% flatten.glp - Flatten nested lists using difference lists
%% Efficient single-pass flattening.

flatten(Xs, Flat?) :- flatten_dl(Xs?, Flat\[]).

flatten_dl([], T\T?).
flatten_dl([X|Xs], H?\T?) :-
    flatten_dl(X?, H\M?),
    flatten_dl(Xs?, M\T).
flatten_dl(X, [X?|T]\T?) :- ground(X?), atomic(X?) | true.
