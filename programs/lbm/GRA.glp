%% ---------------------------------------------------------------------------
%% GRA.glp --- the grassroots ride auction's contract, GRH's (Coordination Appendix C; Udi, 2026-11-05; LBM's until then), in the clause syntax of GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint, Guards), as programs/gsc/README.md reads it.  GRA extends GDO (GDO.glp beside this file), so the term holds GDO's eight schemas, GKK's and GSG's written as GSG.glp writes them; the clauses are in GRA.txt.
%%
%% Environment predicates (GSC, Appendix Values in Speech-Act Schemas), which the platform keeps current and no schema adds or deletes: now(t), the time; location(x), the person's location; and rider and driver, of arity zero, the person's kind, from the declaration "Alice is a rider, Bob a driver and Carol a person.  A person can be either a rider or a driver but not both.", which the platform holds from the person's start, one of the two.
%%
%% Values: x the pickup point, y the destination, e the end of the bidding period, mx the maximum pickup delay, m the terms, p and d a bid's fare and pickup delay, t the time, t0 the time of the award, f the fare, k the deposit, a1 and c1 the parts of the fare and of the deposit released to Alice, a2 and c2 those released to Bob.  r is a speech-act variable, the call.  The terms are a value, so that a contract that restricts GRA, as GRA-SS does, can read them.
%%
%% GRA:1, Call, is call_open, Alice's call, recorded at Alice as open(r, x, y, e, mx, m) and calling; call, its delivery to Bob, whom Alice points to; and forward_call, its delivery by Bob to Carol, whom Bob points to, which is not forwarded again.  GRA:2, Bid, is bid and bid_fwd, by a driver, on a call and on a forwarded call, before the bidding period ends; Alice holds bid(Bob, r, p, d), Bob bidded(Alice, r, p, d).  GRA:3, Award, is award, at or after the end of the period, to a bidder who has no ride, at a fare f and a deposit k, the terms' choice, which GRA does not read, locking f at Alice and k at Bob and giving each the ride, ride(q, r, x, y, mx, t0, d, f, k, m), and busy; and close, the call closed.  GRA:4, Pickup, replaces the ride at both by the ride under way, riding(q, r, y, t0, d, f, k, m, t), t the time of the pickup.  GRA:5, Arriving, ends it and releases the fare and the deposit, released(r, a, c) at each, in any parts, the terms' choice, which GRA does not read.  GRA:6, Cancelling, the same of a ride awarded and not picked up, Alice's, after the maximum pickup delay.  GRA:7, Withdrawing, Alice's, before the end of the period.  "Alice may not open a bid before then" is the realisation's, the bid held sealed in Alice's state until the award.  Every role but establish's requires identity.
%%
%% Written by LBM #4 Cowork, 2026-11-03, in the form of roles; rewritten in the clause syntax by GRH #1 Cowork, 2026-11-06, with GRA as Udi revised it that day: a rider and a driver, the deposit the terms set, the fare and the deposit released to Alice and to Bob, and the terms a value.
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant)
              ; sgn(Constant, Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SQLit       ::= SMult ; not(SMult).
SQLits      ::= [] ; [SQLit | SQLits].
SLit        ::= SQLit ; forall(Constant, SAtom, SQLits).
SLits       ::= [] ; [SLit | SLits].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr).
SConstraint ::= true ; and(SConstraint, SConstraint)
              ; eq(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; or(SConstraint, SConstraint)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg).
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SLits, SLits, SConstraint, PNames).
Contract    ::= [] ; [Schema | Contract].
Preds       ::= [] ; [Constant | Preds].
Declared    ::= Contract ; environment(Preds, Contract).

%% contract_named(gra, C): the contract, GRA (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gra, environment([now, location, rider, driver],
   [
%% GKK:1, Identity.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))],
       true,
       ['Alice']),
%% GKK:2, Acquaintance.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(identity, ['Bob'])],
       true,
       ['Alice', 'Bob']),
%% GKK:3, Introduction.
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% GSG:1, Friendship.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']),
        atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        not(atom(friend, ['Bob', 'Alice']))],
       true,
       ['Alice', 'Bob']),
%% GSG:2, Ending a friendship.
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])),
        not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']),
        atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']),
        atom(friend, ['Bob', 'Alice'])],
       true,
       ['Alice']),
%% GDO:1, Pointing to friend; Bob a reading role.
    sas(point_friend, ['Alice', 'Bob'], [],
       [atom(points_to, ['Alice', 'Bob'])],
       [atom(identity, ['Alice']),
        atom(friend, ['Alice', 'Bob']),
        not(atom(points_to, ['Alice', 'Bob'])),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDO:2, Transitive pointing; Bob a reading role, Carol an agent variable.
    sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(points_to, ['Alice', 'Carol'])],
       [atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Carol']),
        atom(points_to, ['Alice', 'Bob']),
        not(atom(points_to, ['Alice', 'Carol'])),
        atom(identity, ['Bob']),
        atom(points_to, ['Bob', 'Carol'])],
       true,
       ['Alice']),
%% GDO:3, Ceasing to point; Bob a reading role.
    sas(unpoint, ['Alice', 'Bob'], [],
       [not(atom(points_to, ['Alice', 'Bob']))],
       [atom(identity, ['Alice']),
        atom(points_to, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GRA:1, Call: Alice, a rider who has no open call and no ride, calls for bids on ride r.
    sas(call_open, ['Alice'], [r, x, y, e, mx, m],
       [atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(calling, ['Alice'])],
       [atom(identity, ['Alice']),
        atom(rider, ['Alice']),
        not(atom(calling, ['Alice'])),
        not(atom(busy, ['Alice']))],
       true,
       ['Alice']),
%% GRA:1, Call: the call reaches Bob, whom Alice points to.
    sas(call, ['Alice', 'Bob'], [r, x, y, e, mx, m],
       [atom(call, ['Bob', 'Alice', r, num(x), num(y), num(e), num(mx), num(m)])],
       [atom(identity, ['Alice']),
        atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(points_to, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GRA:1, Call: Bob, who received Alice's call, forwards it to Carol, whom Bob points to; no one guards it, and Alice is an agent variable.
    sas(forward_call, ['Bob', 'Carol', 'Alice'], ['Alice', r, x, y, e, mx, m],
       [atom(forwarded, ['Bob', 'Alice', r, 'Carol']),
        atom(call_fwd, ['Carol', 'Alice', r, num(x), num(y), num(e), num(mx), num(m)])],
       [atom(identity, ['Bob']),
        atom(call, ['Bob', 'Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(points_to, ['Bob', 'Carol']),
        not(atom(forwarded, ['Bob', 'Alice', r, 'Carol'])),
        atom(identity, ['Carol'])],
       true,
       []),
%% GRA:2, Bid: Bob, a driver who received Alice's call, bids fare p and pickup delay d before the bidding period ends.
    sas(bid, ['Bob', 'Alice'], [r, x, y, e, mx, m, p, d, t],
       [atom(bidded, ['Bob', 'Alice', r, num(p), num(d)]),
        atom(bid, ['Alice', 'Bob', r, num(p), num(d)])],
       [atom(identity, ['Bob']),
        atom(driver, ['Bob']),
        atom(call, ['Bob', 'Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(now, ['Bob', num(t)]),
        atom(identity, ['Alice'])],
       lt(num(t), num(e)),
       ['Bob']),
%% GRA:2, Bid: the same on a forwarded call of Alice's.
    sas(bid_fwd, ['Bob', 'Alice'], [r, x, y, e, mx, m, p, d, t],
       [atom(bidded, ['Bob', 'Alice', r, num(p), num(d)]),
        atom(bid, ['Alice', 'Bob', r, num(p), num(d)])],
       [atom(identity, ['Bob']),
        atom(driver, ['Bob']),
        atom(call_fwd, ['Bob', 'Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(now, ['Bob', num(t)]),
        atom(identity, ['Alice'])],
       lt(num(t), num(e)),
       ['Bob']),
%% GRA:3, Award: when the bidding period has ended, Alice awards ride r to Bob, who has no ride, at the fare f and the deposit k the terms set, which GRA does not read; Alice's fare and Bob's deposit are locked.
    sas(award, ['Alice', 'Bob'], [r, x, y, e, mx, m, p, d, t0, f, k],
       [not(atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)])),
        not(atom(calling, ['Alice'])),
        atom(ride, ['Alice', 'Bob', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)]),
        atom(fare_locked, ['Alice', r, num(f)]),
        atom(busy, ['Alice']),
        not(atom(bidded, ['Bob', 'Alice', r, num(p), num(d)])),
        atom(ride, ['Bob', 'Alice', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)]),
        atom(deposit_locked, ['Bob', r, num(k)]),
        atom(busy, ['Bob'])],
       [atom(identity, ['Alice']),
        atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(calling, ['Alice']),
        atom(bid, ['Alice', 'Bob', r, num(p), num(d)]),
        atom(now, ['Alice', num(t0)]),
        atom(identity, ['Bob']),
        atom(bidded, ['Bob', 'Alice', r, num(p), num(d)]),
        not(atom(busy, ['Bob']))],
       le(num(e), num(t0)),
       ['Alice']),
%% GRA:3, Award: when the bidding period has ended and the terms select no bidder, Alice's call is closed.
    sas(close, ['Alice'], [r, x, y, e, mx, m, t],
       [not(atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)])),
        not(atom(calling, ['Alice']))],
       [atom(identity, ['Alice']),
        atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(calling, ['Alice']),
        atom(now, ['Alice', num(t)])],
       le(num(e), num(t)),
       ['Alice']),
%% GRA:4, Pickup: recorded when Alice and Bob are both at the pickup point, at Alice's time t; the ride awarded becomes the ride under way; no one guards it.
    sas(pickup, ['Alice', 'Bob'], [r, x, y, mx, t0, d, f, k, m, t],
       [not(atom(ride, ['Alice', 'Bob', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)])),
        atom(riding, ['Alice', 'Bob', r, num(y), num(t0), num(d), num(f), num(k), num(m), num(t)]),
        not(atom(ride, ['Bob', 'Alice', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)])),
        atom(riding, ['Bob', 'Alice', r, num(y), num(t0), num(d), num(f), num(k), num(m), num(t)])],
       [atom(identity, ['Alice']),
        atom(ride, ['Alice', 'Bob', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)]),
        atom(location, ['Alice', num(x)]),
        atom(now, ['Alice', num(t)]),
        atom(identity, ['Bob']),
        atom(ride, ['Bob', 'Alice', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)]),
        atom(location, ['Bob', num(x)])],
       true,
       []),
%% GRA:5, Arriving: when Alice and Bob are both at the destination, the ride ends, and the fare and the deposit are released to Alice and to Bob, a1 and c1 to Alice and a2 and c2 to Bob, as the terms say, which GRA does not read; no one guards it.
    sas(arrive, ['Alice', 'Bob'], [r, y, t0, d, f, k, m, t, a1, c1, a2, c2],
       [not(atom(riding, ['Alice', 'Bob', r, num(y), num(t0), num(d), num(f), num(k), num(m), num(t)])),
        not(atom(fare_locked, ['Alice', r, num(f)])),
        not(atom(busy, ['Alice'])),
        atom(released, ['Alice', r, num(a1), num(c1)]),
        not(atom(riding, ['Bob', 'Alice', r, num(y), num(t0), num(d), num(f), num(k), num(m), num(t)])),
        not(atom(deposit_locked, ['Bob', r, num(k)])),
        not(atom(busy, ['Bob'])),
        atom(released, ['Bob', r, num(a2), num(c2)])],
       [atom(identity, ['Alice']),
        atom(riding, ['Alice', 'Bob', r, num(y), num(t0), num(d), num(f), num(k), num(m), num(t)]),
        atom(fare_locked, ['Alice', r, num(f)]),
        atom(busy, ['Alice']),
        atom(location, ['Alice', num(y)]),
        atom(identity, ['Bob']),
        atom(riding, ['Bob', 'Alice', r, num(y), num(t0), num(d), num(f), num(k), num(m), num(t)]),
        atom(deposit_locked, ['Bob', r, num(k)]),
        atom(busy, ['Bob']),
        atom(location, ['Bob', num(y)])],
       and(eq(plus(num(a1), num(a2)), num(f)), and(eq(plus(num(c1), num(c2)), num(k)), and(ge(num(a1), num(0)), and(ge(num(a2), num(0)), and(ge(num(c1), num(0)), ge(num(c2), num(0))))))),
       []),
%% GRA:6, Cancelling: with no pickup recorded within the maximum pickup delay, Alice cancels; the ride ends, and the fare and the deposit are released to Alice and to Bob as the terms say.
    sas(cancel, ['Alice', 'Bob'], [r, x, y, mx, t0, d, f, k, m, t, a1, c1, a2, c2],
       [not(atom(ride, ['Alice', 'Bob', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)])),
        not(atom(fare_locked, ['Alice', r, num(f)])),
        not(atom(busy, ['Alice'])),
        atom(released, ['Alice', r, num(a1), num(c1)]),
        not(atom(ride, ['Bob', 'Alice', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)])),
        not(atom(deposit_locked, ['Bob', r, num(k)])),
        not(atom(busy, ['Bob'])),
        atom(released, ['Bob', r, num(a2), num(c2)])],
       [atom(identity, ['Alice']),
        atom(ride, ['Alice', 'Bob', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)]),
        atom(fare_locked, ['Alice', r, num(f)]),
        atom(busy, ['Alice']),
        atom(now, ['Alice', num(t)]),
        atom(identity, ['Bob']),
        atom(ride, ['Bob', 'Alice', r, num(x), num(y), num(mx), num(t0), num(d), num(f), num(k), num(m)]),
        atom(deposit_locked, ['Bob', r, num(k)]),
        atom(busy, ['Bob'])],
       and(gt(num(t), plus(num(t0), num(mx))), and(eq(plus(num(a1), num(a2)), num(f)), and(eq(plus(num(c1), num(c2)), num(k)), and(ge(num(a1), num(0)), and(ge(num(a2), num(0)), and(ge(num(c1), num(0)), ge(num(c2), num(0)))))))),
       ['Alice']),
%% GRA:7, Withdrawing: Alice withdraws their open call before the bidding period ends.
    sas(withdraw, ['Alice'], [r, x, y, e, mx, m, t],
       [not(atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)])),
        not(atom(calling, ['Alice']))],
       [atom(identity, ['Alice']),
        atom(open, ['Alice', r, num(x), num(y), num(e), num(mx), num(m)]),
        atom(calling, ['Alice']),
        atom(now, ['Alice', num(t)])],
       lt(num(t), num(e)),
       ['Alice'])])).
