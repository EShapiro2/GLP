% P10: run-length encoding of a list, via packing (P09).

imported procedure p09#pack(CList?, GroupList).

exported procedure encode(CList?, RList).
encode(L, R?) :- p09 # pack(L?, G), map_rl(G?, R).

procedure map_rl(GroupList?, RList).
map_rl([], []).
map_rl([[X|G]|Gs], [rl(N?, X?)|R?]) :- glen(G?, 1, N), map_rl(Gs?, R).

procedure glen(CList?, Integer?, Integer).
glen([], A, A?).
glen([_|Xs], A, N?) :- A1 := A? + 1, glen(Xs?, A1?, N).

