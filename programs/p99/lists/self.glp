pack(L, R?) :- p09 # pack(L?, R).

imported procedure p10#encode(CList?, RList).
exported procedure encode(CList?, RList).
encode(L, R?) :- p10 # encode(L?, R).

imported procedure p11#encode_modified(CList?, MList).
exported procedure encode_modified(CList?, MList).
encode_modified(L, R?) :- p11 # encode_modified(L?, R).

imported procedure p12#decode(MList?, CList).
exported procedure decode(MList?, CList).
decode(L, R?) :- p12 # decode(L?, R).

imported procedure p13#encode_direct(CList?, MList).
exported procedure encode_direct(CList?, MList).
encode_direct(L, R?) :- p13 # encode_direct(L?, R).

imported procedure p14#dupli(CList?, CList).
exported procedure dupli(CList?, CList).
dupli(L, R?) :- p14 # dupli(L?, R).

imported procedure p15#repli(CList?, Integer?, CList).
