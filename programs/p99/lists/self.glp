% P99 section: Lists (P01-P28).  Section-shared types and the section
% interface: every problem's entry point, forwarded to its module.
% Shared cross-section types (CList, OpenCList, GroupList, IntList, Maybe(R),
% Ans, the search-library types) are in the parent p99/self.glp.

% Run-length formats (P10-P13).
RItem ::= rl(Integer, Constant).
RList ::= [] ; [RItem | RList].
MItem ::= one(Constant) ; many(Integer, Constant).
MList ::= [] ; [MItem | MList].

% Nested lists (P07): an element is a constant or a sublist.
Nest ::= [] ; [NItem | Nest].
NItem ::= e(Constant) ; s(Nest).

% Lists of lists (P28).
LList ::= [] ; [CList | LList].

imported procedure p01#last(OpenCList?, Constant).
exported procedure last(OpenCList?, Constant).
last(L, R?) :- p01 # last(L?, R).

imported procedure p02#last_but_one(Open2CList?, Constant).
exported procedure last_but_one(Open2CList?, Constant).
last_but_one(L, R?) :- p02 # last_but_one(L?, R).

imported procedure p03#element_at(CList?, Integer?, Maybe(Constant)).
exported procedure element_at(CList?, Integer?, Maybe(Constant)).
element_at(L, K, R?) :- p03 # element_at(L?, K?, R).

imported procedure p04#len(CList?, Integer).
exported procedure len(CList?, Integer).
len(L, N?) :- p04 # len(L?, N).

imported procedure p05#reverse(CList?, CList).
exported procedure reverse(CList?, CList).
reverse(L, R?) :- p05 # reverse(L?, R).

imported procedure p06#palindrome(CList?, Ans).
exported procedure palindrome(CList?, Ans).
palindrome(L, R?) :- p06 # palindrome(L?, R).

imported procedure p07#flatten(Nest?, CList).
exported procedure flatten(Nest?, CList).
flatten(N, R?) :- p07 # flatten(N?, R).

