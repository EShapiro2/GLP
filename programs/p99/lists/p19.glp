% P19: rotate a list N places to the left; N may be negative or exceed the
% length (GLP's mod is non-negative for positive modulus).

imported procedure p17#split(CList?, Integer?, CList, CList).

exported procedure rotate(CList?, Integer?, CList).
rotate(L, N, R?) :-
    ground(L?) |
    llen(L?, 0, Len),
    norm(N?, Len?, K),
    p17 # split(L?, K?, F, B),
    app(B?, F?, R).

procedure norm(Integer?, Integer?, Integer).
norm(_, 0, 0).
norm(N, Len, K?) :- Len? > 0 | K := N? mod Len?.

procedure llen(CList?, Integer?, Integer).
llen([], A, A?).
llen([_|Xs], A, N?) :- A1 := A? + 1, llen(Xs?, A1?, N).


procedure app(CList?, CList?, CList).
app([], Ys, Ys?).
app([X|Xs], Ys, [X?|R?]) :- app(Xs?, Ys?, R).
