% P08: eliminate consecutive duplicates of list elements.

exported procedure compress(CList?, CList).
compress([], []).
compress([X|Xs], [X?|R?]) :- ground(X?) | comp(Xs?, X?, R).

% comp(Rest, Prev, R): copy Rest dropping elements equal to their predecessor.
procedure comp(CList?, Constant?, CList).
comp([], _, []).
comp([Y|Ys], P, R?) :- Y? =?= P? | comp(Ys?, P?, R).
comp([Y|Ys], _, [Y?|R?]) :- otherwise, ground(Y?) | comp(Ys?, Y?, R).
