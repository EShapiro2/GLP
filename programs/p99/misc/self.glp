% P99 section: Miscellaneous (P90-P99).

imported procedure p90#queens(Integer?, Stream(IntList)).
exported procedure queens(Integer?, Stream(IntList)).
queens(N, S?) :- p90 # queens(N?, S).

imported procedure p95#full_words(Integer?, CList).
exported procedure full_words(Integer?, CList).
full_words(N, W?) :- p95 # full_words(N?, W).

imported procedure p96#identifier(CList?, Ans).
exported procedure identifier(CList?, Ans).
identifier(S, R?) :- p96 # identifier(S?, R).

KP ::= k(Integer, Integer).
KPList ::= [] ; [KP | KPList].

imported procedure p91#knights_tour(Integer?, Integer?, Integer?, Maybe(KPList)).
exported procedure knights_tour(Integer?, Integer?, Integer?, Maybe(KPList)).
knights_tour(N, X, Y, R?) :- p91 # knights_tour(N?, X?, Y?, R).

imported procedure p97#sudoku(IntList?, Maybe(IntList)).
exported procedure sudoku(IntList?, Maybe(IntList)).
sudoku(P, R?) :- p97 # sudoku(P?, R).

VkEdge ::= e(Constant, Constant).
VkEdges ::= [] ; [VkEdge | VkEdges].
NN ::= nn(Constant, Integer).
NumList ::= [] ; [NN | NumList].

imported procedure p92#von_koch(CList?, VkEdges?, Maybe(NumList)).
exported procedure von_koch(CList?, VkEdges?, Maybe(NumList)).
von_koch(Ns, Es, R?) :- p92 # von_koch(Ns?, Es?, R).

RE ::= re(Integer, Integer).
REList ::= [] ; [RE | REList].
REListList ::= [] ; [REList | REListList].

imported procedure p94#regular(Integer?, Integer?, REListList).
exported procedure regular(Integer?, Integer?, REListList).
regular(N, K, Gs?) :- p94 # regular(N?, K?, Gs).

imported procedure p94#regular_labeled(Integer?, Integer?, Stream(REList)).
exported procedure regular_labeled(Integer?, Integer?, Stream(REList)).
regular_labeled(N, K, Gs?) :- p94 # regular_labeled(N?, K?, Gs).

% Nonogram (P98).  Bits z (empty) / o (filled); clues are lists of run lengths.
IntListList ::= [] ; [IntList | IntListList].
Bit ::= z ; o.
BitLine ::= [] ; [Bit | BitLine].
Grid ::= [] ; [BitLine | Grid].
CState ::= ready ; mustgap ; inrun(Integer).
ColCol ::= cc(IntList, CState).
ColCols ::= [] ; [ColCol | ColCols].

imported procedure p98#nonogram(IntListList?, IntListList?, Maybe(Grid)).
exported procedure nonogram(IntListList?, IntListList?, Maybe(Grid)).
nonogram(RowClues, ColClues, R?) :- p98 # nonogram(RowClues?, ColClues?, R).

% Crossword (P99).  A site is site(Length, CellIds); crossing sites share a cell
% id.  Words are lists of characters; the answer assigns one word per site.
Site ::= site(Integer, IntList).
Sites ::= [] ; [Site | Sites].
CM ::= cm(Integer, Constant).
CMap ::= [] ; [CM | CMap].
CListList ::= [] ; [CList | CListList].

imported procedure p99x#crossword(Sites?, CListList?, Maybe(CListList)).
exported procedure crossword(Sites?, CListList?, Maybe(CListList)).
crossword(Ss, Ws, R?) :- p99x # crossword(Ss?, Ws?, R).

AExp ::= num(Integer) ; plus(AExp, AExp) ; minus(AExp, AExp)
       ; times(AExp, AExp) ; div(AExp, AExp).
Eq ::= eq(AExp, AExp).
EqList ::= [] ; [Eq | EqList].

imported procedure p93#puzzle(IntList?, EqList).
exported procedure puzzle(IntList?, EqList).
puzzle(L, R?) :- p93 # puzzle(L?, R).
