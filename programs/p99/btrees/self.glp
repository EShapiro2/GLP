% P99 section: Binary Trees (P54-P69).  Section-shared types and interface.
% A binary tree is nil or t(Label, Left, Right).  The shift-reduce search
% state (agenda of build/make tasks + stack of completed subtrees) drives the
% search-all problems P55, P58, P59, P60.

BTree ::= nil ; t(Constant, BTree, BTree).
BTList ::= [] ; [BTree | BTList].
PTree ::= nil ; pt(Constant, Integer, Integer, PTree, PTree).
Task ::= build(Integer) ; make.
TaskList ::= [] ; [Task | TaskList].
TState ::= st(TaskList, BTList).
Sp ::= s(Integer, Integer).
SpList ::= [] ; [Sp | SpList].

imported procedure p54#istree(BTree?, Ans).
exported procedure istree(BTree?, Ans).
istree(T, R?) :- p54 # istree(T?, R).

