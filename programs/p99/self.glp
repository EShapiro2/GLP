% P99 shared scope: the parallel-search library.
% Design: /Grassroots/P99/docs/search-library-design.md (migrates into the P99 paper).
%
% A search problem supplies a determinate expander from a ground state to the
% list of its successors (solutions and child states), served as a process:
%
%   procedure expand(State?, Items(State, Solution)).
%   procedure expand_server(Stream(Req(State, Solution))?).
%   expand_server([]).
%   expand_server([expand(St, Items?)|Rs]) :- expand(St?, Items), expand_server(Rs?).
%
% The library runs one searcher process per search-tree node: solutions and
% expansion requests flow up through constant-delay multiway merges; stop flows
% down through a distributor tree of stop_fork nodes mirroring the searcher tree.

% ---------------------------------------------------------------------------
% Types
% ---------------------------------------------------------------------------

Item(S, R)  ::= sol(R) ; node(S).
Items(S, R) ::= [] ; [Item(S, R) | Items(S, R)].
Req(S, R)   ::= expand(S, Items(S, R)?).
StopMsg     ::= stop.
Maybe(R)    ::= found(R) ; none.

Cmd(X)  ::= stream(Stream(X)) ; merge(Cmds(X)).
Cmds(X) ::= [] ; [Cmd(X) | Cmds(X)].
MergeDone ::= done.

IntList ::= [] ; [Integer | IntList].

% Shared problem types: lists of constants, their nonempty forms, groupings,
% and the yes/no answer type of test predicates.
CList ::= [] ; [Constant | CList].
OpenCList ::= [Constant | CList].
Open2CList ::= [Constant | OpenCList].
GroupList ::= [] ; [OpenCList | GroupList].
Ans ::= yes ; no.

% ---------------------------------------------------------------------------
% Entry points
% ---------------------------------------------------------------------------

% All solutions: closed stop stream; Sols closes when the search is exhausted.
procedure solve_all(S?, Stream(Req(S, R)), Stream(R)).
solve_all(St, Reqs?, Sols?) :-
    searcher([], St?, SolC, ReqC),
    mwm(SolC?, Sols),
    mwm(ReqC?, Reqs).

% First solution: stop is written on the first merged solution.
procedure solve_first(S?, Stream(Req(S, R)), Maybe(R)).
solve_first(St, Reqs?, Res?) :-
    searcher(Stop?, St?, SolC, ReqC),
    mwm(SolC?, Sols),
    mwm(ReqC?, Reqs),
    first(Sols?, Stop, Res).

procedure first(Stream(R)?, Stream(StopMsg), Maybe(R)).
first([Sol|_], [stop], found(Sol?)).
first([], [], none).

% ---------------------------------------------------------------------------
% Searcher tree
% ---------------------------------------------------------------------------

% searcher(Stop, State, SolCmds, ReqCmds): polls Stop; otherwise emits its
% expansion request and continues in spawn over the reply.
procedure searcher(Stream(StopMsg)?, S?, Cmds(R), Cmds(Req(S, R))).
searcher([stop|_], _, [], []).
searcher(S, St, SolC?, [stream([expand(St?, Items)])|ReqC?]) :-
    spawn(Items?, S?, SolC, ReqC).

% spawn walks the expansion reply: solutions subscribe as one-element streams;
% child states fork a searcher, a merge subscription in each merge, and a
% stop_fork distributor node.
procedure spawn(Items(S, R)?, Stream(StopMsg)?, Cmds(R), Cmds(Req(S, R))).
spawn([], _, [], []).
spawn([sol(Sol)|Is], Stop, [stream([Sol?])|SolC?], ReqC?) :-
    spawn(Is?, Stop?, SolC, ReqC).
spawn([node(St)|Is], Stop, [merge(CSol?)|SolC?], [merge(CReq?)|ReqC?]) :-
    stop_fork(Stop?, S1, S2),
    searcher(S1?, St?, CSol, CReq),
    spawn(Is?, S2?, SolC, ReqC).

% Distributor node: propagates stop (or closure) to both subtrees.
procedure stop_fork(Stream(StopMsg)?, Stream(StopMsg), Stream(StopMsg)).
stop_fork([stop|_], [stop], [stop]).
stop_fork([], [], []).

% ---------------------------------------------------------------------------
% Typed multiway merge (parameterized; shadows the untyped root mwm/2)
% ---------------------------------------------------------------------------
% Cmds elements: stream(Xs) subscribes a stream; merge(Cs) subscribes another
% command stream.  Constant-delay via mutual references; short-circuit L/R
% chain detects termination.  Per the book module
% programs/book/streams/producers_consumers/mwm.glp.

procedure mwm(Cmds(X)?, Stream(X)).
mwm(In, Out?) :-
    allocate_mutual_reference(Ref, Out),
    mm_start(In?, Ref?).

procedure mm_start(Cmds(X)?, _?).
mm_start(In, Ref) :-
    is_mutual_ref(Ref?) |
    mm_subs(In?, Ref?, done, Done),
    mm_close(Done?, Ref?).

procedure mm_subs(Cmds(X)?, _?, MergeDone?, MergeDone).
mm_subs([stream(Xs)|Cs], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    mm_copy(Xs?, Ref?, L?, M),
    mm_subs(Cs?, Ref?, M?, R).
mm_subs([merge(New)|Cs], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    mm_subs(New?, Ref?, L?, M),
    mm_subs(Cs?, Ref?, M?, R).
mm_subs([], _, L, L?).

procedure mm_copy(Stream(X)?, _?, MergeDone?, MergeDone).
mm_copy([X|Xs], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    stream_append(X?, Ref?, Ref1),
    mm_copy(Xs?, Ref1?, L?, R).
mm_copy([], _, L, L?).

procedure mm_close(MergeDone?, _?).
mm_close(done, Ref) :-
    is_mutual_ref(Ref?) |
    close_mutual_reference(Ref?).

% ---------------------------------------------------------------------------
% Shared graph isomorphism (parameterized over the node type X)
% ---------------------------------------------------------------------------
% First-solution search over node bijections: map the first unmapped node of
% graph 1 to each unused node of graph 2 whose adjacency to every mapped pair
% agrees.  Used by P85 (atom nodes, X = Constant) and P94's K-regular dedup
% (integer nodes, X = Integer).  Node identity is =?=, valid for any X.  Edges
% are ge(X, X); the two edge sets ride as one ges tuple to keep arity low.

GEdge(X) ::= ge(X, X).
GEdgeList(X) ::= [] ; [GEdge(X) | GEdgeList(X)].
GMap(X) ::= gmap(X, X).
GMapList(X) ::= [] ; [GMap(X) | GMapList(X)].
GEs(X) ::= ges(GEdgeList(X), GEdgeList(X)).
GIso(X) ::= giso(Stream(X), Stream(X), GMapList(X), GEs(X)).

procedure graph_iso(Stream(X)?, Stream(X)?, GEdgeList(X)?, GEdgeList(X)?, Maybe(GMapList(X))).
graph_iso(N1, N2, E1, E2, R?) :- ground(N1?), ground(N2?), ground(E1?), ground(E2?) |
    solve_first(giso(N1?, N2?, [], ges(E1?, E2?)), Reqs, R),
    gi_server(Reqs?).

procedure gi_server(Stream(Req(GIso(X), GMapList(X)))?).
gi_server([]).
gi_server([expand(St, Items?)|Rs]) :- gi_expand(St?, Items), gi_server(Rs?).

procedure gi_expand(GIso(X)?, Items(GIso(X), GMapList(X))).
gi_expand(giso([], _, Map, _), [sol(Map?)]).
gi_expand(giso([N|Ns], Unused, Map, Es), Items?) :-
    ground(N?), ground(Ns?), ground(Unused?), ground(Map?), ground(Es?) |
    gi_cands(Unused?, N?, Ns?, Unused?, Map?, Es?, Items).

procedure gi_cands(Stream(X)?, X?, Stream(X)?, Stream(X)?, GMapList(X)?, GEs(X)?, Items(GIso(X), GMapList(X))).
gi_cands([], _, _, _, _, _, []).
gi_cands([M|Ms], N, Ns, Unused, Map, Es, Out?) :-
    ground(M?), ground(N?), ground(Ns?), ground(Unused?), ground(Map?), ground(Es?) |
    gi_consistent(Map?, N?, M?, Es?, Ok),
    gi_cd1(Ok?, M?, Ms?, N?, Ns?, Unused?, Map?, Es?, Out).

procedure gi_cd1(Ans?, X?, Stream(X)?, X?, Stream(X)?, Stream(X)?, GMapList(X)?, GEs(X)?, Items(GIso(X), GMapList(X))).
gi_cd1(yes, M, Ms, N, Ns, Unused, Map, Es, [node(giso(Ns?, U1?, [gmap(N?, M?)|Map?], Es?))|Out?]) :-
    ground(M?), ground(Ms?), ground(N?), ground(Ns?), ground(Unused?), ground(Map?), ground(Es?) |
    gi_del(Unused?, M?, U1),
    gi_cands(Ms?, N?, Ns?, Unused?, Map?, Es?, Out).
gi_cd1(no, _, Ms, N, Ns, Unused, Map, Es, Out?) :-
    ground(Ms?), ground(N?), ground(Ns?), ground(Unused?), ground(Map?), ground(Es?) |
    gi_cands(Ms?, N?, Ns?, Unused?, Map?, Es?, Out).

procedure gi_consistent(GMapList(X)?, X?, X?, GEs(X)?, Ans).
gi_consistent([], _, _, _, yes).
gi_consistent([gmap(A, B)|Map], N, M, ges(E1, E2), Ok?) :-
    ground(A?), ground(B?), ground(N?), ground(M?), ground(E1?), ground(E2?), ground(Map?) |
    gi_hasedge(E1?, N?, A?, H1),
    gi_hasedge(E2?, M?, B?, H2),
    gi_cons1(H1?, H2?, Map?, N?, M?, ges(E1?, E2?), Ok).

procedure gi_cons1(Ans?, Ans?, GMapList(X)?, X?, X?, GEs(X)?, Ans).
gi_cons1(yes, yes, Map, N, M, Es, Ok?) :- ground(Map?), ground(N?), ground(M?), ground(Es?) | gi_consistent(Map?, N?, M?, Es?, Ok).
gi_cons1(no, no, Map, N, M, Es, Ok?) :- ground(Map?), ground(N?), ground(M?), ground(Es?) | gi_consistent(Map?, N?, M?, Es?, Ok).
gi_cons1(yes, no, _, _, _, _, no).
gi_cons1(no, yes, _, _, _, _, no).

procedure gi_hasedge(GEdgeList(X)?, X?, X?, Ans).
gi_hasedge([], _, _, no).
gi_hasedge([ge(X, Y)|_], A, B, yes) :- X? =?= A?, Y? =?= B? | true.
gi_hasedge([ge(X, Y)|_], A, B, yes) :- otherwise, X? =?= B?, Y? =?= A? | true.
gi_hasedge([ge(_, _)|Es], A, B, R?) :- otherwise | gi_hasedge(Es?, A?, B?, R).

procedure gi_del(Stream(X)?, X?, Stream(X)).
gi_del([], _, []).
gi_del([Z|Zs], Y, Zs?) :- Z? =?= Y? | true.
gi_del([Z|Zs], Y, [Z?|R?]) :- otherwise | gi_del(Zs?, Y?, R).
