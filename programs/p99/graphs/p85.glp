% P85: graph isomorphism.  Delegates to the shared graph_iso (root self.glp,
% parameterized over the node type), instantiated here at Constant.  The edges
% are copied e(...) -> ge(...) (a functor swap, Constant to Constant) and the
% resulting node bijection copied back gmap(...) -> m(...), so the public result
% keeps its NPairList form.

exported procedure isomorphic(Graph?, Graph?, Maybe(NPairList)).
isomorphic(graph(N1, E1), graph(N2, E2), R?) :-
    ground(N1?), ground(N2?), ground(E1?), ground(E2?) |
    e2ge(E1?, G1), e2ge(E2?, G2),
    graph_iso(N1?, N2?, G1?, G2?, M),
    iso_out(M?, R).

procedure e2ge(EList?, GEdgeList(Constant)).
e2ge([], []).
e2ge([e(A, B)|Es], [ge(A?, B?)|Out?]) :- ground(A?), ground(B?) | e2ge(Es?, Out).

procedure iso_out(Maybe(GMapList(Constant))?, Maybe(NPairList)).
iso_out(none, none).
iso_out(found(GM), found(M?)) :- ground(GM?) | gm2m(GM?, M).

procedure gm2m(GMapList(Constant)?, NPairList).
gm2m([], []).
gm2m([gmap(A, B)|Rest], [m(A?, B?)|Out?]) :- ground(A?), ground(B?) | gm2m(Rest?, Out).
