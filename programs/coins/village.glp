%% village.glp --- the village market of Section 5 of "Grassroots Currencies:
%% Turning Mutual Trust into Liquidity", on the compiled coins agent.
%%
%% Six villagers --- Alice (baker), Bob (farmer), Charlie (carpenter), Diana
%% (doctor), Eve (teacher), Frank (fisherman) --- perform the six operations of
%% Section 5.1, each an act of the contract:
%%
%%   1. symmetric mutual credit   Alice-Bob 15, Alice-Charlie 15, Charlie-Eve 10,
%%                                Eve-Frank 10
%%   2. asymmetric mutual credit  Diana gives Bob 20 diana-coins for 24 bob-coins,
%%                                and Frank 15 for 18 frank-coins
%%   3. pay                       Bob pays Alice 5, Eve pays Charlie 6, Frank pays
%%                                Diana 3, Eve pays Alice 3
%%   4. portfolio swap            Eve gives Charlie 5 frank-coins for 5 alice-coins
%%   5. redeem                    Frank redeems 5 diana-coins from Diana, one at a
%%                                time, taking back his own
%%   6. sale of debt              Alice sells 10 bob-coins to Eve for 4 frank-coins
%%
%% Each villager runs the mini-app (currency/miniapp.glp): the compiled agent with
%% its mediator, activated with its two channels.  The play stands in for the
%% super-app: it opens, before the market, the conversation between every two
%% villagers who transact --- one root channel each, an end to each of the two
%% --- and hands each villager its conversations on its channel to the social
%% graph.  A scripted person (currency/person.glp) stands in for the super-app
%% user interface: it reads the cards the mediator shows and the screen the
%% agent writes, and answers the cards --- the person's taps --- in the order
%% of its script, each step when the one before it has taken effect.  The
%% screen messages are logged as tagged(Villager, Message), so the run is
%% observable and the final holdings can be read off it.
%%
%% Entry point: market/0, exported by self.glp as village/0.

imported procedure miniapp#coins(Constant?, Channel(Stream(UserAnswer), Stream(Event))?, Stream(Conversation)?).
imported procedure person#person(Constant?, Stream(Event)?, Stream(UserAnswer), Script?, Stream(ScreenContent)).

%% =============================================================================
%% The scripts
%% =============================================================================

procedure script(Constant?, Script).
script(alice, [mint(15), swap(bob, alice, 15, bob, 15),
               mint(15), swap(charlie, alice, 15, charlie, 15),
               swap(eve, bob, 10, frank, 4)]).
script(bob, [mint(15), accept(alice), mint(24), accept(diana), pay(alice, 5)]).
script(charlie, [mint(15), accept(alice), mint(10), swap(eve, charlie, 10, eve, 10),
                 accept(eve)]).
script(diana, [mint(20), swap(bob, diana, 20, bob, 24),
               mint(15), swap(frank, diana, 15, frank, 18)]).
script(eve, [mint(10), accept(charlie), mint(10), swap(frank, eve, 10, frank, 10),
             pay(charlie, 6), swap(charlie, frank, 5, alice, 5), pay(alice, 3),
             accept(alice)]).
script(frank, [mint(18), accept(diana), mint(10), accept(eve), pay(diana, 3),
               redeem(diana, frank), redeem(diana, frank), redeem(diana, frank),
               redeem(diana, frank), redeem(diana, frank)]).

%% =============================================================================
%% The village
%% =============================================================================

exported procedure market.
market :-
    script(alice, SA),
    villager(alice, SA?, [conversation(bob, ch(AB?, BA)), conversation(charlie, ch(AC?, CA)),
                          conversation(eve, ch(AE?, EA))]),
    script(bob, SB),
    villager(bob, SB?, [conversation(alice, ch(BA?, AB)), conversation(diana, ch(BD?, DB))]),
    script(charlie, SC),
    villager(charlie, SC?, [conversation(alice, ch(CA?, AC)), conversation(eve, ch(CE?, EC))]),
    script(diana, SD),
    villager(diana, SD?, [conversation(bob, ch(DB?, BD)), conversation(frank, ch(DF?, FD))]),
    script(eve, SE),
    villager(eve, SE?, [conversation(alice, ch(EA?, AE)), conversation(charlie, ch(EC?, CE)),
                        conversation(frank, ch(EF?, FE))]),
    script(frank, SF),
    villager(frank, SF?, [conversation(diana, ch(FD?, DF)), conversation(eve, ch(FE?, EF))]).

%% One villager: the mini-app, activated with its channel to the person and its
%% conversations, the scripted person on the other end of the channel, and its
%% screen logged.
exported procedure villager(Constant?, Script?, Stream(Conversation)?).
villager(Id, Script, Convs) :-
    ground(Id?) |
    miniapp # coins(Id?, ch(Answers?, Events), Convs?),
    person # person(Id?, Events?, Answers, Script?, Screen),
    log(Id?, Screen?).

%% The screen messages, logged as tagged(Villager, Message).
procedure log(Constant?, Stream(ScreenContent)?).
log(Id, [M|Ms]) :- ground(M?) | send_to_user([tagged(Id?, M?)]), log(Id?, Ms?).
log(_, []).
