%% self.glp — CSSN shared type vocabulary
%%
%% All protocol types for the Child-Safe Social Network application.
%% Extends CSSG types with group support (GroupId, group messaging).
%% Defined once here, visible to all modules via ancestor scoping.


%% =============================================================================
%% CORE PROTOCOL TYPES
%% =============================================================================

%% Stream(X) and Channel(In, Out) are predefined in root self.glp:
%%   Stream(X) ::= [] ; [X | Stream(X)].
%%   Channel(In, Out) ::= ch(In, Out?).

%% Group notifications shared between agent and friend content
GroupNotifyContent ::= group_invite(GroupId, Channel(Stream(GroupSetupResponse), Stream(IntroContent)))
                     ; group_invite_child(GroupId, Constant, Channel(Stream(GroupSetupResponse), Stream(IntroContent)))
                     ; group_removed(GroupId).

%% Friend-only message content (excludes shared GroupNotifyContent)
FriendOnlyContent ::= response(Response)
                    ; text(Constant)
                    ; intro(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                    ; child_intro(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                    ; group_msg(GroupId, Constant, Constant)
                    ; group_consent_req(GroupId, Decision?)
                    ; group_leave(GroupId, Constant)
                    ; leave_group(GroupId)
                    ; unfriend
                    ; unfriend_child(Constant)
                    ; release_request
                    ; release_grant
                    ; approval
                    ; withdrawal.

%% Friend messages (after connection established)
FriendContent ::= FriendOnlyContent ; GroupNotifyContent.
%% Friend channel content — friend messages only, canonical-free.
%% Stream(FriendMsg) is therefore a subtype of Stream(NetInMsg), so merging a
%% friend channel's read end into NetIn is sound.
FriendMsg     ::= msg(Constant, Constant, FriendContent).

%% A cold-call accept conveys a SETUP channel (IntroContent), not the friend
%% channel directly; the fresh friend channel is conveyed on the setup channel
%% at commit (see befriend_commit).
Response ::= accept(Channel(Stream(IntroContent), Stream(IntroContent))) ; no.
Decision ::= yes ; no.
Handshake ::= ack(Constant) ; nack.

%% An enrolment offer is answered by conveying the parent-child channel itself.
%% Enrol is directional --- p enrols r, and r is not simultaneously enrolling p ---
%% so there is no bilateral case to tie-break and no setup channel is needed: the
%% child allocates the channel and returns the parent's end.  This is the one act
%% whose parties have no channel between them when it starts, which is why it
%% travels the cold-call path.
EnrolResponse ::= enrol_accept(Channel(Stream(FriendMsg), Stream(FriendMsg)))
                ; enrol_no.

%% Setup channel content — the befriend handshake (ack/nack) plus the
%% fresh-friend-channel conveyance that the smaller-named side uses to select
%% the canonical friend channel.  The setup channel is consumed at commit and
%% never merged into NetIn, so it may carry the friend-channel value.
IntroContent ::= ack(Constant) ; nack
               ; friend_channel(Channel(Stream(FriendMsg), Stream(FriendMsg))).

%% Group identifier
GroupId   ::= group_id(Constant, Constant).

%% Pending values — opaque values stored by mediator, forwarded to agent
PendingValue ::= response(Response?) ; channel(Channel(Stream(IntroContent), Stream(IntroContent)))
               ; group_channel(Channel(Stream(GroupSetupResponse), Stream(IntroContent)))
               ; consent(Decision?) ; enrol_response(EnrolResponse?) ; error.

%% =============================================================================
%% AGENT RECORDS
%% =============================================================================

%% The local state Definition "Child-Safe Social Graph Guarded Transactions"
%% names, less what the outputs list already holds.  The friend set c_p is the
%% friend_output entries, the parents rho_p the parent_output entries and the
%% children kappa_p the child_output entries: those three records ARE the
%% channels, created and torn down by the acts that establish and end them.
%% What is left has no channel to stand for it — alpha_p and omega_p, the
%% numbers of approvals this party has given for a child of its own and of
%% withdrawals it has taken.  They name nobody, which is what makes any parent
%% of a child able to end any friendship or membership of that child.
%%
%% The other two are the posts this party holds and its record of what it has
%% sent in a group and to whom.  Against Definition "Grassroots Social Network
%% Guarded Transactions" as it now stands, those are pi_p^g and delta_p^g: the
%% items posted to g, and the pairs delivered in g.  They are NOT t_p, which is
%% what this party has sent to a FRIEND, and which the code holds nowhere --- a
%% direct send writes to the friend channel and records nothing.
%%
%% Delivery to a member is owed while the member is on the creator's list and the
%% creator has not already sent it that item, so the creator has to hold BOTH:
%% pi_p^g, because a member that joins late is owed what was posted before it
%% joined, and delta_p^g, because what keeps a member from receiving an item
%% twice is that record and nothing else.  A member that leaves and rejoins is
%% the case that needs it --- its stream is gone and remade, and only delta_p^g
%% remembers what it has already had.
%%
%% This is not a delivery index.  An index is a position in a queue that decides
%% what a member may ever receive; sent(g, q, n) says only that the first n posts
%% of g have gone to q, and the posts of g are appended in order and sent in
%% order, so n is delta_p^g written compactly --- a count where the Definition
%% has a set of pairs, sound exactly because posting and sending are both in
%% order.
GroupPost  ::= post(GroupId, Constant, Constant).
SentEntry  ::= sent(GroupId, Constant, Integer).
AgentState ::= state(Integer, Integer, Stream(GroupPost), Stream(SentEntry)).

%% =============================================================================
%% AGENT <-> MEDIATOR INTERFACE
%% =============================================================================

%% Content carried inside user-to-agent messages (msg(person, Id, Content))
UserContent ::= connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; send(Constant, Constant)
              ; introduce(Constant, Constant)
              ; accept_intro(Constant, PendingValue)
              ; reject_intro(Constant, PendingValue)
              ; child_introduce(Constant, Constant, Constant)
              ; accept_child_intro(Constant, PendingValue)
              ; reject_child_intro(Constant, PendingValue)
              ; approve_child_intro(Constant, Constant, PendingValue)
              ; response(Response)
              ; create_group(Constant)
              ; invite_group(GroupId, Constant)
              ; invite_group(GroupId, Constant, Constant)
              ; accept_group(GroupId, PendingValue)
              ; reject_group(GroupId, PendingValue)
              ; approve_group(Constant, GroupId, PendingValue)
              ; send_group(GroupId, Constant)
              ; leave_group(GroupId)
              ; leave_child_group(Constant, GroupId)
              ; remove_from_group(GroupId, Constant)
              ; approve_child_group(Constant, GroupId, PendingValue)
              ; reject_child_group(Constant, GroupId, PendingValue)
              ; unfriend_child(Constant)
              ; unfriend_child_of(Constant, Constant)
              ; remove_child_member(Constant, GroupId, Constant)
              ; enrol_child(Constant)
              ; enrol_decision(Decision, Constant, PendingValue)
              ; request_release
              ; approve_release(Constant).

%% Content carried inside agent-to-user messages (msg(agent, person, Content))
%% Agent-only message content (excludes shared GroupNotifyContent)
AgentOnlyContent ::= befriend(Constant, Response?)
                   ; befriend_intro(Constant, Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                   ; child_befriend(Constant, Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
                   ; connected(Constant)
                   ; rejected
                   ; rejected(Constant)
                   ; received(Constant, Constant)
                   ; group_joined(GroupId)
                   ; group_joined_member(GroupId, Constant)
                   ; group_left(GroupId)
                   ; group_received(GroupId, Constant, Constant)
                   ; child_group_consent(Constant, GroupId, Decision?)
                   ; unfriended(Constant)
                   ; enrol_offer(Constant, EnrolResponse?)
                   ; enrolled(Constant)
                   ; release_asked(Constant)
                   ; released(Constant).

%% Content carried inside agent-to-user messages (msg(agent, person, Content))
AgentContent ::= AgentOnlyContent ; GroupNotifyContent.

%% Precise message types for agent <-> mediator channel
AgentToUserMsg        ::= msg(Constant, Constant, AgentContent).
MediatorToAgentMsg    ::= msg(Constant, Constant, UserContent).

%% =============================================================================
%% AGENT INPUT TYPES
%% =============================================================================

%% Network content (2-arg cold-call: msg(Dest, Content))
%% Enrol joins intro here because the parent and the child it enrols have no
%% channel between them until the act creates one.
NetColdCall ::= intro(Constant, Response?)
              ; enrol(Constant, EnrolResponse?).

%% Network input message (cold calls + friend messages)
NetInMsg    ::= msg(Constant, NetColdCall)
              ; msg(Constant, Constant, FriendContent).

%% Transport union carried by the simulated network switches (network3/network2).
%% Producers write the narrower NetOutStream; NetOutStream ⊆ NetInStream is sound.
NetInStream ::= [] ; [NetInMsg | NetInStream].

%% Intro result — written by intro_await_peer, injected into UserIn
IntroResult ::= intro_result(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
              ; intro_rejected(Constant).

%% Group join result — written by group_await_join, injected into UserIn
GroupJoinResult ::= group_join_ack(GroupId, Constant, Channel(Stream(IntroContent), Stream(GroupSetupResponse)))
                  ; group_join_nack(GroupId, Constant).

%% Agent input message (user messages + injected intro results + group results)
UserInMsg ::= msg(Constant, Constant, UserContent)
            ; intro_result(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
            ; intro_rejected(Constant)
            ; group_join_ack(GroupId, Constant, Channel(Stream(IntroContent), Stream(GroupSetupResponse)))
            ; group_join_nack(GroupId, Constant)
            ; enrol_response(Constant, EnrolResponse).

%% =============================================================================
%% AGENT OUTPUT TYPES
%% =============================================================================

%% Group channel message content
GroupContent ::= group_msg(GroupId, Constant, Constant)
               ; group_leave(GroupId, Constant)
               ; group_removed(GroupId).
GroupMsg     ::= msg(Constant, Constant, GroupContent).

%% Group invite setup protocol (asymmetric channel)
%% Creator→Invitee stream carries the group channel after handshake
GroupSetupResponse ::= group_channel(Channel(Stream(GroupMsg), Stream(GroupMsg))).

%% Network output stream — cold calls the agent emits on its net entry.
NetOutMsg    ::= msg(Constant, NetColdCall).
NetOutStream ::= [] ; [NetOutMsg | NetOutStream].

%% Output list — one constructor per output kind, each carrying its own stream
%% type.  Replaces the former output(OutputKey, Stream(OutputMsg)?) whose union
%% OutputMsg typed every entry at the join of all kinds and so broke duality
%% against narrower readers (mediator AgentToUserMsg, peer NetInStream).
%% group_entry keeps an OutputKey: group routing is genuinely keyed (dynamic
%% groups and members) and its GroupMsg stream is already precise.
OutputKey   ::= group(GroupId) ; group_member(GroupId, Constant).
OutputEntry ::= user_output(Stream(AgentToUserMsg)?)
              ; net_output(NetOutStream?)
              ; friend_output(Constant, Stream(FriendMsg)?)
              ; child_output(Constant, Stream(FriendMsg)?)
              ; parent_output(Constant, Stream(FriendMsg)?)
              ; group_entry(OutputKey, Stream(GroupMsg)?).
OutputsList ::= [] ; [OutputEntry|OutputsList].

%% =============================================================================
%% MEDIATOR <-> USER (UI) INTERFACE
%% =============================================================================

ReqId ::= req(Constant).

%% User -> Mediator commands
UserCmd ::= decision(Decision, Constant, ReqId)
          ; accept_intro(Constant, ReqId)
          ; reject_intro(Constant, ReqId)
          ; accept_child_intro(Constant, ReqId)
          ; reject_child_intro(Constant, ReqId)
          ; approve_child_intro(Constant, Constant, ReqId)
          ; child_introduce(Constant, Constant, Constant)
          ; connect(Constant)
          ; send(Constant, Constant)
          ; introduce(Constant, Constant)
          ; create_group(Constant)
          ; invite_group(GroupId, Constant)
          ; invite_group(GroupId, Constant, Constant)
          ; accept_group(GroupId, ReqId)
          ; reject_group(GroupId, ReqId)
          ; approve_group(Constant, GroupId, ReqId)
          ; send_group(GroupId, Constant)
          ; leave_group(GroupId)
          ; leave_child_group(Constant, GroupId)
          ; remove_from_group(GroupId, Constant)
          ; approve_child_group(Constant, GroupId, ReqId)
          ; reject_child_group(Constant, GroupId, ReqId)
          ; unfriend_child(Constant)
          ; unfriend_child_of(Constant, Constant)
          ; remove_child_member(Constant, GroupId, Constant)
          ; enrol_child(Constant)
          ; enrol_decision(Decision, Constant, ReqId)
          ; request_release
          ; approve_release(Constant).

%% Mediator -> User notifications
UserNotify ::= befriend(Constant, ReqId)
             ; befriend_intro(Constant, Constant, ReqId)
             ; child_befriend(Constant, Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; received(Constant, Constant)
             ; group_invite(GroupId, ReqId)
             ; group_invite_child(GroupId, Constant, ReqId)
             ; group_joined(GroupId)
             ; group_joined_member(GroupId, Constant)
             ; group_left(GroupId)
             ; group_removed(GroupId)
             ; group_received(GroupId, Constant, Constant)
             ; child_group_consent(Constant, GroupId, ReqId)
             ; unfriended(Constant)
             ; enrol_offer(Constant, ReqId)
             ; enrolled(Constant)
             ; release_asked(Constant)
             ; released(Constant).


%% =============================================================================
%% MEDIATOR PENDING LIST
%% =============================================================================

PendingEntry ::= pending(ReqId, PendingValue).

%% =============================================================================
%% NARRATIVE TYPES (for village scenario actors)
%% =============================================================================

NarrativeItem   ::= friend(Constant)
                  ; say(Constant)
                  ; act(Constant)
                  ; event(Constant).

%% =============================================================================
%% SHARED HELPER PROCEDURES
%% =============================================================================
%% Defined here, visible to all sibling modules via ancestor scoping.
%% The linker resolves calls in agent.glp/child_agent.glp to these procedures.
%%
%% Note: bind_response, handle_response, await_group_channel remain in each
%% module because they call agent/child_agent (recursive tail calls).

%% =============================================================================
%% MERGE
%% =============================================================================

%% merge/3 is now defined once in the root programs/self.glp (A3 amendment).

%% =============================================================================
%% SETUP_GROUP_HUB_SIDE
%% =============================================================================

%% The joining member's stream is opened and then every post of this group the
%% creator holds that it has not already sent to this member is written on it, in
%% the order the posts were made.  That is the whole of "a member is owed a post
%% while it is on the member list and the creator has not already sent it that
%% item".  A first-time joiner has been sent none and is owed all of them; one
%% that left and rejoined is owed only what arrived while it was away.
procedure setup_group_hub_side(GroupId?, Constant?, Stream(GroupPost)?, Stream(GroupPost), Stream(SentEntry)?, Stream(SentEntry), Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg), Channel(Stream(GroupMsg), Stream(GroupMsg))).
setup_group_hub_side(GroupId, Member, Posts, Posts2?, Sent, Sent1?, Outs, Outs2?, NetIn, NetIn1?,
    ch(HubToMember?, MemberToHub)) :-
    ground(GroupId?), ground(Member?) |
    add_group_output(group_member(GroupId?, Member?), HubToMember, Outs?, Outs1),
    sent_count(GroupId?, Member?, Sent?, SentA, C),
    send_from(GroupId?, Member?, C?, Posts?, Posts1, Outs1?, Outs2),
    count_posts(GroupId?, Posts1?, Posts2, N),
    set_sent(GroupId?, Member?, N?, SentA?, Sent1),
    merge(NetIn?, MemberToHub?, NetIn1).

%% =============================================================================
%% HELD POSTS AND THE SENT RECORD — h_p and t_p
%% =============================================================================

%% A post joins the holding at its end, so the holding is in the order the posts
%% were made and the n already sent to a member are always its first n.
procedure add_post(GroupPost?, Stream(GroupPost)?, Stream(GroupPost)).
add_post(P, [], [P?|[]]).
add_post(P, [Q|Rest], [Q?|Rest1?]) :-
    add_post(P?, Rest?, Rest1).

procedure count_posts(GroupId?, Stream(GroupPost)?, Stream(GroupPost), Integer).
count_posts(G, [post(G1, A, T)|Rest], [post(G1?, A?, T?)|Rest1?], N?) :-
    G? =?= G1?, ground(G?) |
    count_posts(G?, Rest?, Rest1, N1),
    N := N1? + 1.
count_posts(G, [P|Rest], [P?|Rest1?], N?) :-
    otherwise |
    count_posts(G?, Rest?, Rest1, N).
count_posts(_, [], [], 0).

%% Send this group's posts past the first Skip of them onto the member's stream,
%% through the ordinary group router.
procedure send_from(GroupId?, Constant?, Integer?, Stream(GroupPost)?, Stream(GroupPost),
                    Stream(OutputEntry)?, Stream(OutputEntry)).
send_from(G, M, Skip, [post(G1, A, T)|Rest], [post(G1?, A?, T?)|Rest1?], Outs, Outs1?) :-
    G? =?= G1?, ground(G?), ground(M?), Skip? > 0 |
    Skip1 := Skip? - 1,
    send_from(G?, M?, Skip1?, Rest?, Rest1, Outs?, Outs1).
send_from(G, M, Skip, [post(G1, A, T)|Rest], [post(G1?, A?, T?)|Rest1?], Outs, Outs2?) :-
    G? =?= G1?, ground(G?), ground(M?), Skip? < 1 |
    lookup_send_group(group_member(G?, M?),
        msg(A?, A?, group_msg(G1?, A?, T?)), Outs?, Outs1),
    send_from(G?, M?, 0, Rest?, Rest1, Outs1?, Outs2).
send_from(G, M, Skip, [P|Rest], [P?|Rest1?], Outs, Outs1?) :-
    otherwise |
    send_from(G?, M?, Skip?, Rest?, Rest1, Outs?, Outs1).
send_from(_, _, _, [], [], Outs, Outs?).

%% t_p: how many of a group's posts have gone to a member.
procedure sent_count(GroupId?, Constant?, Stream(SentEntry)?, Stream(SentEntry), Integer).
sent_count(G, M, [sent(G1, M1, N)|Rest], [sent(G1?, M1?, N?)|Rest?], N?) :-
    G? =?= G1?, M? =?= M1? | true.
sent_count(G, M, [E|Rest], [E?|Rest1?], C?) :-
    otherwise |
    sent_count(G?, M?, Rest?, Rest1, C).
sent_count(_, _, [], [], 0).

procedure set_sent(GroupId?, Constant?, Integer?, Stream(SentEntry)?, Stream(SentEntry)).
set_sent(G, M, N, [sent(G1, M1, _)|Rest], [sent(G1?, M1?, N?)|Rest?]) :-
    G? =?= G1?, M? =?= M1? | true.
set_sent(G, M, N, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    set_sent(G?, M?, N?, Rest?, Rest1).
set_sent(G, M, N, [], [sent(G?, M?, N?)|[]]).

procedure bump_sent(GroupId?, Constant?, Stream(SentEntry)?, Stream(SentEntry)).
bump_sent(G, M, [sent(G1, M1, N)|Rest], [sent(G1?, M1?, N1?)|Rest?]) :-
    G? =?= G1?, M? =?= M1? |
    N1 := N? + 1.
bump_sent(G, M, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    bump_sent(G?, M?, Rest?, Rest1).
bump_sent(G, M, [], [sent(G?, M?, 1)|[]]).

%% =============================================================================
%% SETUP_GROUP_CREATOR
%% =============================================================================

procedure setup_group_creator(GroupId?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
setup_group_creator(GroupId, Outs, Outs1?, NetIn, NetIn1?) :-
    ground(GroupId?) |
    add_group_output(group(GroupId?), MemberToHub, Outs?, Outs1),
    merge(NetIn?, MemberToHub?, NetIn1).

%% Per-kind output routers send_user/send_net/send_friend/send_child/send_parent
%% are now provided by lib/routing/, exposed from the root self.glp (A5 Stage B);
%% resolved here unqualified.

%% =============================================================================
%% LOOKUP_SEND_GROUP
%% =============================================================================

procedure lookup_send_group(OutputKey?, GroupMsg?, Stream(OutputEntry)?, Stream(OutputEntry)).
lookup_send_group(Key, Msg, Outs, Outs1?) :-
    ground(Key?) |
    lookup_send_group_step(Key?, Msg?, Outs?, Outs1).

procedure lookup_send_group_step(OutputKey?, GroupMsg?, Stream(OutputEntry)?, Stream(OutputEntry)).
lookup_send_group_step(Key, Msg, [group_entry(K, [Msg?|Out1?])|Rest], [group_entry(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_group_step(Key, Msg, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    lookup_send_group_step(Key?, Msg?, Rest?, Rest1).
lookup_send_group_step(_, _, [], []).

%% =============================================================================
%% DISTRIBUTE_GROUP_MSG
%% =============================================================================

%% Write the post onto the stream of every member on the list now, and advance
%% the creator's record of what it has sent to each of them.
procedure distribute_group_msg(GroupId?, GroupMsg?, Stream(SentEntry)?, Stream(SentEntry), Stream(OutputEntry)?, Stream(OutputEntry)).
distribute_group_msg(GroupId, Msg, Sent, Sent2?,
    [group_entry(group_member(GId, M), [Msg?|Out1?])|Rest],
    [group_entry(group_member(GId?, M?), Out1)|Rest1?]) :-
    GroupId? =?= GId?, ground(GroupId?), ground(Msg?) |
    bump_sent(GroupId?, M?, Sent?, Sent1),
    distribute_group_msg(GroupId?, Msg?, Sent1?, Sent2, Rest?, Rest1).
distribute_group_msg(GroupId, Msg, Sent, Sent1?, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    distribute_group_msg(GroupId?, Msg?, Sent?, Sent1, Rest?, Rest1).
distribute_group_msg(_, _, Sent, Sent?, [], []).

%% inject_msg and add_friend_output are now provided by lib/routing/, exposed
%% from the root self.glp (A5 Stage B); resolved here unqualified.

%% =============================================================================
%% ADD_GROUP_OUTPUT / CLOSE_OUTPUTS
%% =============================================================================

procedure add_group_output(OutputKey?, Stream(GroupMsg), Stream(OutputEntry)?, Stream(OutputEntry)).
add_group_output(Key, Out?, Outs, [group_entry(Key?, Out)|Outs?]).

%% =============================================================================
%% ENROLMENT AND RELEASE — the parent-child channel and the records it stands for
%% =============================================================================
%% kappa_p and rho_p are the child_output and parent_output entries of the
%% outputs list, so enrol adds one and release removes it.  These mirror
%% add_friend_output and close_friend of lib/routing, which do the same for c_p.

procedure add_child_output(Constant?, Stream(FriendMsg), Stream(OutputEntry)?, Stream(OutputEntry)).
add_child_output(Name, Out?, Outs, [child_output(Name?, Out)|Outs?]).

procedure add_parent_output(Constant?, Stream(FriendMsg), Stream(OutputEntry)?, Stream(OutputEntry)).
add_parent_output(Name, Out?, Outs, [parent_output(Name?, Out)|Outs?]).

procedure close_child(Constant?, Stream(OutputEntry)?, Stream(OutputEntry)).
close_child(_, [], []).
close_child(Name, [child_output(K, [])|Rest], Rest?) :-
    Name? =?= K? | true.
close_child(Name, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    close_child(Name?, Rest?, Rest1).

procedure close_parent(Constant?, Stream(OutputEntry)?, Stream(OutputEntry)).
close_parent(_, [], []).
close_parent(Name, [parent_output(K, [])|Rest], Rest?) :-
    Name? =?= K? | true.
close_parent(Name, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    close_parent(Name?, Rest?, Rest1).

%% Parent side of enrol: adopt the channel the child allocated and conveyed, and
%% merge its read end into the parent's network input.
procedure enrol_commit(Constant?, Channel(Stream(FriendMsg), Stream(FriendMsg))?,
                       Stream(OutputEntry)?, Stream(OutputEntry),
                       Stream(NetInMsg)?, Stream(NetInMsg)).
enrol_commit(Child, ch(FromChild, ToChild?), Outs, Outs2?, NetIn, NetIn1?) :-
    ground(Child?) |
    add_child_output(Child?, ToChild, Outs?, Outs1),
    send_user( msg(agent, person, enrolled(Child?)), Outs1?, Outs2),
    merge(NetIn?, FromChild?, NetIn1).

%% The enrolling parent waits on the writer it sent with the cold call, exactly
%% as inject_msg does for a cold-call response.
procedure inject_enrol_response(EnrolResponse?, Constant?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_enrol_response(Resp, Child, Ys, [enrol_response(Child?, Resp?)|Ys?]) :-
    known(Resp?) | true.
inject_enrol_response(Resp, Child, [Y|Ys], [Y?|Ys1?]) :-
    inject_enrol_response(Resp?, Child?, Ys?, Ys1).

%% =============================================================================
%% APPROVALS AND WITHDRAWALS — alpha_p and omega_p, the two records with no
%% channel to stand for them
%% =============================================================================
%% Both are counts and name nobody, so there is nothing to look up: a child
%% friendship or membership that commits advances alpha_p at each named parent,
%% and one that ends advances omega_p.  A parent therefore holds no record of
%% whom its child befriended, and any parent of either child may end any
%% friendship or membership of that child.  The child carries the message that
%% advances the count, at the commit rather than at the parent's own step, so no
%% approval stands for an act that was never carried out.

procedure close_outputs(Stream(OutputEntry)?).
close_outputs([user_output([])|Outs]) :- close_outputs(Outs?).
close_outputs([net_output([])|Outs]) :- close_outputs(Outs?).
close_outputs([friend_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([child_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([parent_output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([group_entry(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([]).

%% intro_await_peer and inject_intro_result are now provided by lib/routing/,
%% exposed from the root self.glp (A5 Stage B); resolved here unqualified.

%% =============================================================================
%% GROUP_AWAIT_JOIN
%% =============================================================================

procedure group_await_join(GroupId?, Constant?, Channel(Stream(IntroContent), Stream(GroupSetupResponse))?, GroupJoinResult).

group_await_join(GroupId, Invitee, ch([ack(_)|ChIn], ChOut?),
                 group_join_ack(GroupId?, Invitee?, ch(ChIn?, ChOut))).

group_await_join(GroupId, Invitee, ch([nack|_], []),
                 group_join_nack(GroupId?, Invitee?)).

%% Skip any other message while awaiting the ack/nack response.
group_await_join(GroupId, Invitee, ch([_|ChIn], ChOut?), Result?) :-
    otherwise |
    group_await_join(GroupId?, Invitee?, ch(ChIn?, ChOut), Result).

%% Channel closed before a response arrives: treat as a failed (nack) join.
group_await_join(GroupId, Invitee, ch([], []),
                 group_join_nack(GroupId?, Invitee?)).

%% =============================================================================
%% INJECT_GROUP_RESULT
%% =============================================================================

procedure inject_group_result(GroupJoinResult?, Stream(UserInMsg)?, Stream(UserInMsg)).
inject_group_result(group_join_ack(G, I, Ch), Ys,
    [group_join_ack(G?, I?, Ch?)|Ys?]) :-
    ground(I?) | true.
inject_group_result(group_join_nack(G, I), Ys,
    [group_join_nack(G?, I?)|Ys?]) :-
    ground(I?) | true.
inject_group_result(Res, [Y|Ys], [Y?|Ys1?]) :-
    inject_group_result(Res?, Ys?, Ys1).

%% =============================================================================
%% CLOSE_OUTPUT — close a stream and remove its entry from the outputs list
%% =============================================================================

%% close_output removes a group_entry by its (group / group_member) key.
procedure close_output(OutputKey?, Stream(OutputEntry)?, Stream(OutputEntry)).
close_output(_, [], []).
close_output(Key, [group_entry(K, [])|Rest], Rest?) :-
    Key? =?= K? | true.
close_output(Key, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    close_output(Key?, Rest?, Rest1).

%% =============================================================================
%% BEFRIEND COMMIT + close_friend — provided by lib/routing/befriend.glp, exposed
%% from the root self.glp and resolved here unqualified (4-of-4 dedup).  The
%% idempotent commit with smaller-name tie-break and fresh-friend-channel
%% conveyance (CSSN Issue 16) is shared across all platforms; this platform's
%% IntroContent supplies the friend_channel alternative and NetInMsg ⊇ FriendMsg.
%% See docs/cssn-glp-implementation-spec.md §"Befriend Commit: Separate Setup
%% Channel and Canonical Friend Channel".
%% =============================================================================

