%% ---------------------------------------------------------------------------
%% programs/cssn --- the child-safe social network (CSSN, Section 4): its program is the canonical CVA platform of its contract, Children.glp (Appendix B.2), compiled by vGLP's compiler with knows its introduction predicate and with the contract's pragmas, Children.txt's lines after Pragmas and those of the contracts it extends (CSSN, Section 4.6, "The program"; vGLP, Section 5.4, "The compilation", "Act schemas as local specifications" and "The contract's words"), platform.vglp, which compile.sh prints and the canonical compilation compiles to GLP when the directory loads; the mini-app entry miniapp/3 that wraps it (miniapp.glp, the same file as programs/apps/gsg/miniapp.glp); its scripted person (person.glp); and the plays, the village of Section 4.6, "Village Demonstration" (plays.glp).  It calls nothing that reaches the network or the person, so the REPL's :artefact certifies it.  The person's questions are drawn by the two widget declarations the compiler prints into the platform, approval_sentence for Approval and social_menu for the request question, Request?, carrying the contract's words, and the program's output by last_state (vGLP, Section 6.2, "The words a platform shows"), so every word the app shows is the contract's and the app writes no self.vglp.
%%
%% Children.txt, the contract's clauses and pragmas, is CSSN's text (claude.md, "Sessions"), and Children.glp, its act schemas, is printed from it by calculus/tools/adopt.py; Children.glp is a module of this program, its types its own and none of its procedures exported.
%%
%% The types of platform.vglp, written again for the declarations of this directory's modules, but for those the compilation forms --- Question, Drawn and Ask(Q) --- which the linker writes into every module that imports a compiled procedure, the dispatcher, or a procedure whose declaration names them (vGLP, Section 6.3, "The canonical compilation"; programs/apps/gsg/self.glp likewise).  The compiled module's own definitions shadow these within it, and the two must agree.
%% ---------------------------------------------------------------------------

Peer      ::= Key.
Speech    ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
Class     ::= establish(Peer) ; acquaint(Peer, Peer) ; introduce(Peer, Peer, Peer)
            ; befriend(Peer, Peer) ; unfriend(Peer, Peer)
            ; message(Peer, Peer, Speech)
            ; create(Peer, Constant) ; join(Peer, Peer, Constant)
            ; leave(Peer, Peer, Constant) ; remove(Peer, Peer, Constant) ; close(Peer, List(Peer), Constant)
            ; post_own(Peer, Speech, Constant) ; post(Peer, Peer, Speech, Constant)
            ; deliver(Peer, Peer, Speech, Constant)
            ; enter(Peer, Peer) ; make_parent(Peer, Peer, Peer) ; end_parent(Peer, Peer, Peer)
            ; resign(Peer, Peer) ; parent_unfriend(Peer, Peer)
            ; of_age(Peer, Peer, List(Peer)) ; retire(Peer, Peer, List(Peer), List(Peer))
            ; child_acquaint(Peer, Peer, Peer) ; child_acquaint_2(Peer, Peer, Peer, Peer)
            ; child_befriend(Peer, Peer, Peer, Peer) ; child_adult_befriend(Peer, Peer, Peer)
            ; child_unfriend(Peer, Peer, Peer)
            ; child_join(Peer, Peer, Peer, Constant) ; child_join_2(Peer, Peer, Peer, Peer, Constant)
            ; child_leave(Peer, Peer, Peer, Constant) ; child_close(Peer, Peer, List(Peer), Constant)
            ; child_create(Peer, Peer, Constant).
Proposal  ::= establish(Peer) ; acquaint(Peer, Peer) ; introduce(Peer, Peer, Peer)
            ; befriend(Peer, Peer) ; unfriend(Peer, Peer)
            ; message(Peer, Peer, Speech)
            ; create(Peer, Constant) ; join(Peer, Peer, Constant)
            ; leave(Peer, Peer, Constant) ; remove(Peer, Peer, Constant) ; close(Peer, Constant)
            ; post_own(Peer, Speech, Constant) ; post(Peer, Peer, Speech, Constant)
            ; enter(Peer, Peer) ; make_parent(Peer, Peer, Peer) ; end_parent(Peer, Peer, Peer)
            ; resign(Peer, Peer) ; parent_unfriend(Peer, Peer)
            ; of_age(Peer, Peer) ; retire(Peer, Peer)
            ; child_acquaint(Peer, Peer, Peer) ; child_acquaint_2(Peer, Peer, Peer, Peer)
            ; child_befriend(Peer, Peer, Peer, Peer) ; child_adult_befriend(Peer, Peer, Peer)
            ; child_unfriend(Peer, Peer, Peer)
            ; child_join(Peer, Peer, Peer, Constant) ; child_join_2(Peer, Peer, Peer, Peer, Constant)
            ; child_leave(Peer, Peer, Peer, Constant) ; child_close(Peer, Peer, Constant)
            ; child_create(Peer, Peer, Constant).
Request   ::= propose(Proposal).
YesNo     ::= yes ; no.
Reason    ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote      ::= yes ; no(Reason).
Decision  ::= commit ; abort(Peer, Reason) ; yield.
Rho       ::= one(Class) ; rho(Proposal).
Names     ::= none ; request(Rho, Integer).
Attempt   ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo     ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
            ; yield(Attempt) ; ready(Attempt) ; request(Rho, Integer).
Content   ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net       ::= msg(Peer, Content).
Atom      ::= identity ; retired ; knows(Peer) ; child ; friend(Peer) ; creator(Peer) ; parenting(Peer)
            ; received(Speech, Peer) ; member(CName) ; listed(Peer, Constant)
            ; closed(Constant) ; posted(Speech, Constant) ; delivered(Speech, Peer, Constant)
            ; received_in(Speech, Peer, Constant) ; created(Peer) ; guarded_by(Peer).
%% A community name, the value of a name term <u>.y_1...y_n: community(P) of the person P, dot(N, S), N followed by the speech act S, as dot(community(a), n) names the group n led by a, and dot_any(N), N followed by the wildcard of a cleared atom, the image of N.* under a binding (vGLP, Section 5.4, "Act schemas as local specifications"; GSC, Definition "Binding").
CName     ::= community(Peer) ; dot(CName, Constant) ; dot_any(CName).
Output    ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab       ::= tab(String, Constant) ; tab(String, Constant, Constant).
Asking    ::= Attempt ; hello(Peer, Proposal).
Approved  ::= Proposal.
Approval  ::= approval(Asking, List(Word), YesNo?).
Word      ::= text(String) ; person(Peer) ; named(String, Peer) ; valued(String, Number) ; held(Atom, Integer).

%% What the scripted person reports, its screen (person.glp): each view the program writes, once, view(Id, S, K, A, Ts), the agent's own key, the machine state, the persons the agent knows, the approvals its person made that are pending and the tabs (vGLP 12f629d, Section 5.4, "The compilation"), and each notice, refused(N, Q, D), N the request name of the refused attempt's part (vGLP e286276, Section 5.4, "The compilation"); the agent's own key and the persons it knows, as the last view drawn shows them, where the script looks; each request it makes, did(R); and each answer it gives an approval question, of the attempt or of an attempt of the class its script names.
Asked     ::= Class ; Attempt.
Seen      ::= Output ; menu(Key, List(Key)) ; gave(Asked, YesNo) ; did(Request).
%% A line of a child's screen, which a parent's scripted person reads as the parent looking at the child's phone (person.glp, the step at(K, C); plays.glp).
Watch     ::= seen(Key, Seen).

%% The network of the platform over the conversations (miniapp.glp), as in programs/apps/gsg/self.glp.
NetEvent  ::= opened(Key, RootChannel(Net)) ; sent(Net) ; declined(Key).
Route     ::= route(Key, Stream(Net)?).
Routes    ::= [] ; [Route | Routes].
Sending   ::= went ; held(Net).

%% The mini-app's entry, the instance of the root's entry template miniapp/3 (programs/self.glp) at the mini-app's two types, Drawn and Net.
imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?).
miniapp(Id, Ui, Sg) :- miniapp # miniapp(Id?, Ui?, Sg?).

%% The scripted person, the instance of the root's second template miniapp_person/5 at Drawn and at Seen.
imported procedure person#miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Id, Role, Ps, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, Ps?, PEnd?, Screen).

%% The scripted person looking also at the phones of the person's children, each line of a child's screen seen(K, S) (person.glp, the step at(K, C)): a parent's state does not change by the child's acts (CSSN, Section 4), so a scripted parent waits on the child's phone, in the village (plays.glp) and in the scenario of the app (glp_multiagent/test/apps_screens_test.dart), where the child's screen is handed to it by the harness.
imported procedure person#village_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Watch)?, Stream(Seen)).
exported procedure village_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Watch)?, Stream(Seen)).
village_person(Id, Role, Ps, PEnd, Ws, Screen?) :- person # village_person(Id?, Role?, Ps?, PEnd?, Ws?, Screen).

%% The village of CSSN, Section 4.6, "Village Demonstration", with no super-app (plays.glp): the screens of alice, bob, grace, frank, carol, dave and eve.
imported procedure plays#play_village(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_village(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_village(A?, B?, G?, F?, C?, D?, E?) :- plays # play_village(A, B, G, F, C, D, E).
imported procedure plays#play_figure(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_figure(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_figure(A?, B?, C?, D?) :- plays # play_figure(A, B, C, D).
imported procedure plays#play_resigned(Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_resigned(Stream(Seen), Stream(Seen), Stream(Seen)).
play_resigned(A?, B?, C?) :- plays # play_resigned(A, B, C).
