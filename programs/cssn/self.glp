%% ---------------------------------------------------------------------------
%% programs/cssn --- the child-safe social network (CSSN, Section 4): its program is the canonical CVA platform of its contract, CSSN.glp (Appendix B.2), compiled by vGLP's compiler with knows its introduction predicate and with the contract's pragmas, CSSN.txt's lines after Pragmas and those of the contracts it extends (CSSN, Section 4.6, "The program"; vGLP, Section 5.4, "The compilation", "Act schemas as local specifications" and "The contract's words"), platform.vglp, which compile.sh prints and the canonical compilation compiles to GLP when the directory loads; the mini-app entry miniapp/4 that wraps it (miniapp.glp, the same file as programs/apps/gsg/miniapp.glp); its scripted person (person.glp); and the plays, the village of Section 4.6, "Village Demonstration" (plays.glp).  It calls nothing that reaches the network or the person, so the REPL's :artefact certifies it.  The person's questions are drawn by the two widget declarations the compiler prints into the platform, approval_sentence for Approval and social_menu for Menu, carrying the contract's words, and the program's output by last_state (vGLP, Section 6.2, "The words a platform shows"), so every word the app shows is the contract's and the app writes no self.vglp.
%%
%% CSSN.txt and CSSN.glp, the contract's clauses and act schemas, are CSSN's Cowork's text (claude.md, "Sessions"); CSSN.glp is a module of this program, its types its own and none of its procedures exported.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module, as every hand-written module importing a compiled procedure restates them today (programs/apps/gsnp/self.glp likewise).  The compiled module's own definitions shadow these within it, and the two must agree.
%% ---------------------------------------------------------------------------

Peer      ::= Key.
Speech    ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
Class     ::= establish(Peer) ; meet(Peer, Peer) ; introduce(Peer, Peer, Peer)
            ; befriend(Peer, Peer) ; unfriend(Peer, Peer)
            ; message(Peer, Peer, Speech)
            ; create(Peer, Speech) ; join(Peer, Peer, Speech)
            ; leave(Peer, Peer, Speech) ; close(Peer, List(Peer), Speech) ; drop(Peer, Peer, Speech)
            ; post_own(Peer, Speech, Speech) ; post(Peer, Peer, Speech, Speech)
            ; deliver(Peer, Peer, Speech, Speech)
            ; enter(Peer, Peer) ; make_parent(Peer, Peer, Peer) ; end_parent(Peer, Peer, Peer)
            ; of_age(Peer, Peer, List(Peer)) ; retire(Peer, Peer, List(Peer))
            ; child_meet(Peer, Peer, Peer) ; child_meet_2(Peer, Peer, Peer, Peer)
            ; child_befriend(Peer, Peer, Peer, Peer) ; child_adult_befriend(Peer, Peer, Peer)
            ; child_unfriend(Peer, Peer, Peer)
            ; child_join(Peer, Peer, Peer, Speech) ; child_join_2(Peer, Peer, Peer, Peer, Speech)
            ; child_leave(Peer, Peer, Peer, Speech) ; child_close(Peer, Peer, List(Peer), Speech).
Proposal  ::= establish(Peer) ; meet(Peer, Peer) ; introduce(Peer, Peer, Peer)
            ; befriend(Peer, Peer) ; unfriend(Peer, Peer)
            ; message(Peer, Peer, Speech)
            ; create(Peer, Speech) ; join(Peer, Peer, Speech)
            ; leave(Peer, Peer, Speech) ; close(Peer, Speech)
            ; post_own(Peer, Speech, Speech) ; post(Peer, Peer, Speech, Speech)
            ; enter(Peer, Peer) ; make_parent(Peer, Peer, Peer) ; end_parent(Peer, Peer, Peer)
            ; of_age(Peer, Peer) ; retire(Peer, Peer)
            ; child_meet(Peer, Peer, Peer) ; child_meet_2(Peer, Peer, Peer, Peer)
            ; child_befriend(Peer, Peer, Peer, Peer) ; child_adult_befriend(Peer, Peer, Peer)
            ; child_unfriend(Peer, Peer, Peer)
            ; child_join(Peer, Peer, Peer, Speech) ; child_join_2(Peer, Peer, Peer, Peer, Speech)
            ; child_leave(Peer, Peer, Peer, Speech) ; child_close(Peer, Peer, Speech).
Request   ::= propose(Proposal).
YesNo     ::= yes ; no.
Reason    ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote      ::= yes ; no(Reason).
Decision  ::= commit ; abort(Peer, Reason) ; yield.
Rho       ::= one(Class) ; rho(Proposal).
Names     ::= none ; request(Rho, Integer).
Attempt   ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo     ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
            ; yield(Attempt) ; request(Rho, Integer).
Content   ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net       ::= msg(Peer, Content).
Atom      ::= identity ; retired ; knows(Peer) ; child ; friend(Peer) ; creator(Peer) ; parenting(Peer)
            ; received(Speech, Peer) ; member(CName) ; listed(Peer, Speech)
            ; closed(Speech) ; posted(Speech, Speech) ; delivered(Speech, Peer, Speech)
            ; received_in(Speech, Peer, Speech) ; created(Peer) ; made(Peer, Peer).
%% A community name, the value of a name term <u>.y_1...y_n: community(P) of the person P, and dot(N, S), N followed by the speech act S, as dot(community(a), n) names the group n led by a (vGLP, Section 5.4, "Act schemas as local specifications").
CName     ::= community(Peer) ; dot(CName, Speech).
Output    ::= view(List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab       ::= tab(String, Constant) ; tab(String, Constant, Constant).
Asking    ::= Attempt ; hello(Peer, Proposal).
Approved  ::= Proposal.
Approval  ::= approval(Asking, List(Word), YesNo?).
Word      ::= text(String) ; person(Peer) ; named(String, Peer) ; valued(String, Integer).
Menu      ::= menu(Key, List(Key), Request?).
Question  ::= menu_w(Menu) ; approval_w(Approval).
Drawn     ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)    ::= ask(Constant, Q).

%% What the scripted person reports, its screen (person.glp): each view the program writes, once, the machine state, the persons the agent knows, the approvals its person made that are pending and the tabs, and each notice, refused(N, Q, D), N the request name of the refused attempt's part (vGLP e286276, Section 5.4, "The compilation"); the agent's own key and the persons a request question shows, where the script looks; each request it makes, did(R); and each answer it gives an approval question, of the attempt or of an attempt of the class its script names.
Asked     ::= Class ; Attempt.
Seen      ::= Output ; menu(Key, List(Key)) ; gave(Asked, YesNo) ; did(Request).
%% A line of a child's screen, which a parent's scripted person reads as the parent looking at the child's phone (person.glp, the step at(K, C); plays.glp).
Watch     ::= seen(Key, Seen).

%% The network of the platform over the conversations (miniapp.glp), as in programs/apps/gsg/self.glp.
NetEvent  ::= opened(Key, RootChannel(Net)) ; sent(Net).
Route     ::= route(Key, Stream(Net)?).
Routes    ::= [] ; [Route | Routes].
Sending   ::= went ; held(Net).

%% The mini-app's entry, the instance of the root's entry template miniapp/4 (programs/self.glp) at the mini-app's two types, Drawn and Net.
imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
miniapp(Id, Ui, Sg, Cal) :- miniapp # miniapp(Id?, Ui?, Sg?, Cal?).

%% The scripted person, the instance of the root's second template miniapp_person/4 at Drawn and at Seen.
imported procedure person#miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
exported procedure miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Id, Role, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, PEnd?, Screen).

%% The scripted person looking also at the phones of the person's children, each line of a child's screen seen(K, S) (person.glp, the step at(K, C)): a parent's state does not change by the child's acts (CSSN, Section 4), so a scripted parent waits on the child's phone, in the village (plays.glp) and in the scenario of the app (glp_multiagent/test/apps_screens_test.dart), where the child's screen is handed to it by the harness.
imported procedure person#village_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Watch)?, Stream(Seen)).
exported procedure village_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Watch)?, Stream(Seen)).
village_person(Id, Role, PEnd, Ws, Screen?) :- person # village_person(Id?, Role?, PEnd?, Ws?, Screen).

%% The village of CSSN, Section 4.6, "Village Demonstration", with no super-app (plays.glp): the screens of alice, bob, grace, frank, carol, dave and eve.
imported procedure plays#play_village(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_village(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_village(A?, B?, G?, F?, C?, D?, E?) :- plays # play_village(A, B, G, F, C, D, E).
