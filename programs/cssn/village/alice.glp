%% alice.glp — Alice actor for the Village scenario
%%
%% ORDER-INDEPENDENT.  The actor is one loop with one state, not a chain of
%% states each waiting for one notification.  A chained actor drops whatever its
%% current state did not expect --- its skip clause cannot put a message back ---
%% so it works only for the interleaving it was written against, and changing
%% the boot changed that interleaving.  Here every notification the actor ever
%% acts on has a clause of its own, so none can arrive "too early".  Where order
%% genuinely matters it is carried in the loop's own counters, never in which
%% clause is currently waiting.
%% Types: from village/self.glp (ancestor scoping)

%% Act 1: coming into the contract.  Alice starts an adult, as every agent does,
%% so the act is the parenting alone.  The offer to become Carol's parent travels
%% the conversation the super-app opens between them: this platform is a mini-app
%% and holds no network entry, so the friendship comes first and the act follows.
exported procedure alice13(Constant?, Channel(Stream(UserNotify), Stream(UserCmd))?, Stream(NarrativeItem)).
alice13(_, ch(In, [connect(carol), connect(bob)|Out?]), Narr?) :-
    alice13_loop(In?, Out, Narr).

procedure alice13_loop(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).

alice13_loop([connected(carol)|In], [enrol_child(carol)|Out?],
    [act('Becoming the parent of Carol')|Narr?]) :-
    alice13_loop(In?, Out, Narr).

alice13_loop([enrolled(carol)|In], Out?, [event('Carol is my child')|Narr?]) :-
    alice13_loop(In?, Out, Narr).

%% Act 2: adult friendships.
alice13_loop([connected(bob)|In], [send(bob, 'Hello Bob'), connect(frank)|Out?],
    [friend(bob), say('Hello Bob')|Narr?]) :-
    alice13_loop(In?, Out, Narr).

%% Act 3: both child introductions, once Frank is a friend.
alice13_loop([connected(frank)|In],
    [child_introduce(carol, bob, dave), child_introduce(carol, bob, eve)|Out?],
    [friend(frank), act('Introducing Carol to Dave via Bob'),
     act('Introducing Carol to Eve via Bob')|Narr?]) :-
    alice13_loop(In?, Out, Narr).

%% Act 5: approve Carol joining Frank's study group.
alice13_loop([group_invite_child(group_id(frank, study), carol, ReqId)|In],
    [approve_group(carol, group_id(frank, study), ReqId?)|Out?],
    [act('Approved Carol joining study group')|Narr?]) :-
    ground(ReqId?) |
    alice13_loop(In?, Out, Narr).

%% Everything else: acted on nowhere in this scenario.  With one state there is
%% no notification this actor acts on that can reach here.
alice13_loop([_|In], Out?, Narr?) :-
    otherwise | alice13_loop(In?, Out, Narr).
alice13_loop([], [], []).
