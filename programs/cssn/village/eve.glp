%% eve.glp — Eve (Bob's child) actor for the Village scenario
%%
%% ORDER-INDEPENDENT.  The actor is one loop with one state, not a chain of
%% states each waiting for one notification.  A chained actor drops whatever its
%% current state did not expect --- its skip clause cannot put a message back ---
%% so it works only for the interleaving it was written against, and changing
%% the boot changed that interleaving.  Here every notification the actor ever
%% acts on has a clause of its own, so none can arrive "too early".  Where order
%% genuinely matters it is carried in the loop's own counters, never in which
%% clause is currently waiting.
%% Types: from village/self.glp (ancestor scoping)

%% Act 1: a party becomes a child by accepting an enrolment.  Before this it is
%% of no age and has no parent; accepting creates the parent-child channel.
exported procedure eve13(Constant?, Channel(Stream(UserNotify), Stream(UserCmd))?, Stream(NarrativeItem)).
eve13(_, ch([enrol_offer(bob, ReqId)|In],
    [enrol_decision(yes, bob, ReqId?)|Out?]),
    [act('Accepting Bob as my parent')|Narr?]) :-
    ground(ReqId?) |
    eve13_loop(In?, Out, Narr).
eve13(Id, ch([_|In], Out?), Narr?) :-
    otherwise | eve13(Id?, ch(In?, Out), Narr).
eve13(_, ch([], []), []).

procedure eve13_loop(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).

eve13_loop([enrolled(bob)|In], Out?, [event('Bob is my parent')|Narr?]) :-
    eve13_loop(In?, Out, Narr).

%% Act 3: accept either introduction, in either order.
eve13_loop([child_befriend(bob, dave, ReqId)|In],
    [accept_child_intro(dave, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | eve13_loop(In?, Out, Narr).
eve13_loop([child_befriend(bob, carol, ReqId)|In],
    [accept_child_intro(carol, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | eve13_loop(In?, Out, Narr).
eve13_loop([connected(dave)|In], Out?, [friend(dave)|Narr?]) :-
    eve13_loop(In?, Out, Narr).
eve13_loop([connected(carol)|In], Out?, [friend(carol)|Narr?]) :-
    eve13_loop(In?, Out, Narr).

%% Act 4: join kids_chat, reply, and leave.
eve13_loop([group_invite(group_id(carol, kids_chat), ReqId)|In],
    [accept_group(group_id(carol, kids_chat), ReqId?)|Out?],
    [act('Accepting kids_chat invite')|Narr?]) :-
    ground(ReqId?) | eve13_loop(In?, Out, Narr).
eve13_loop([group_joined(group_id(carol, kids_chat))|In], Out?,
    [event('Joined kids_chat')|Narr?]) :-
    eve13_loop(In?, Out, Narr).
eve13_loop([group_received(group_id(carol, kids_chat), carol, _)|In],
    [send_group(group_id(carol, kids_chat), 'Hi all!'),
     leave_group(group_id(carol, kids_chat))|Out?],
    [say('Hi all!'), act('Leaving kids_chat')|Narr?]) :-
    eve13_loop(In?, Out, Narr).

%% Act 7: coming of age.  Eve asks Bob to end the parenting; once it is ended she
%% holds no parent, which IS being an adult,
%% and she befriends Frank with no parent among the guards.
eve13_loop([group_left(group_id(carol, kids_chat))|In], [request_release|Out?],
    [event('Left kids_chat'), act('Asking Bob to end the parenting')|Narr?]) :-
    eve13_loop(In?, Out, Narr).
eve13_loop([released(bob)|In], [connect(frank)|Out?],
    [event('No parent on record, so an adult'),
     act('Befriending Frank directly')|Narr?]) :-
    eve13_loop(In?, Out, Narr).
eve13_loop([connected(frank)|In], Out?, [friend(frank)|Narr?]) :-
    eve13_loop(In?, Out, Narr).

eve13_loop([_|In], Out?, Narr?) :-
    otherwise | eve13_loop(In?, Out, Narr).
eve13_loop([], [], []).
