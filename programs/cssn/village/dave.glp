%% dave.glp — Dave (Bob's child) actor for the Village scenario
%%
%% ORDER-INDEPENDENT.  The actor is one loop with one state, not a chain of
%% states each waiting for one notification.  A chained actor drops whatever its
%% current state did not expect --- its skip clause cannot put a message back ---
%% so it works only for the interleaving it was written against, and changing
%% the boot changed that interleaving.  Here every notification the actor ever
%% acts on has a clause of its own, so none can arrive "too early".  Where order
%% genuinely matters it is carried in the loop's own counters, never in which
%% clause is currently waiting.
%% Types: from village/self.glp (ancestor scoping)

%% Act 1: a party becomes a child by accepting an enrolment.  Before this it is
%% of no age and has no parent; accepting creates the parent-child channel.
exported procedure dave13(Constant?, Channel(Stream(UserNotify), Stream(UserCmd))?, Stream(NarrativeItem)).
dave13(_, ch([enrol_offer(bob, ReqId)|In],
    [enrol_decision(yes, bob, ReqId?)|Out?]),
    [act('Accepting Bob as my parent')|Narr?]) :-
    ground(ReqId?) |
    dave13_loop(In?, Out, Narr).
dave13(Id, ch([_|In], Out?), Narr?) :-
    otherwise | dave13(Id?, ch(In?, Out), Narr).
dave13(_, ch([], []), []).

procedure dave13_loop(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).

dave13_loop([enrolled(bob)|In], Out?, [event('Bob is my parent')|Narr?]) :-
    dave13_loop(In?, Out, Narr).

%% Act 3: accept either introduction, in either order.
dave13_loop([child_befriend(bob, carol, ReqId)|In],
    [accept_child_intro(carol, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | dave13_loop(In?, Out, Narr).
dave13_loop([child_befriend(bob, eve, ReqId)|In],
    [accept_child_intro(eve, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | dave13_loop(In?, Out, Narr).
dave13_loop([connected(carol)|In], Out?, [friend(carol)|Narr?]) :-
    dave13_loop(In?, Out, Narr).
dave13_loop([connected(eve)|In], Out?, [friend(eve)|Narr?]) :-
    dave13_loop(In?, Out, Narr).
dave13_loop([received(carol, _)|In], Out?, [event('Received Hi from Carol')|Narr?]) :-
    dave13_loop(In?, Out, Narr).

%% Act 4: Carol's kids_chat, joined with Bob's consent.
dave13_loop([group_invite(group_id(carol, kids_chat), ReqId)|In],
    [accept_group(group_id(carol, kids_chat), ReqId?)|Out?],
    [act('Accepting kids_chat invite')|Narr?]) :-
    ground(ReqId?) | dave13_loop(In?, Out, Narr).
dave13_loop([group_joined(group_id(carol, kids_chat))|In],
    [send_group(group_id(carol, kids_chat), 'Thanks Carol!')|Out?],
    [event('Joined kids_chat'), say('Thanks Carol!')|Narr?]) :-
    dave13_loop(In?, Out, Narr).

%% Act 5: Frank's study group, joined through Bob.
dave13_loop([group_invite(group_id(frank, study), ReqId)|In],
    [accept_group(group_id(frank, study), ReqId?)|Out?],
    [act('Accepting study group invite')|Narr?]) :-
    ground(ReqId?) | dave13_loop(In?, Out, Narr).
dave13_loop([group_joined(group_id(frank, study))|In],
    [send_group(group_id(frank, study), 'Hi from Dave!')|Out?],
    [event('Joined study group'), say('Hi from Dave!')|Narr?]) :-
    dave13_loop(In?, Out, Narr).

%% Act 6: what the others do to Dave.
dave13_loop([unfriended(carol)|In], Out?, [event('Unfriended by Carol')|Narr?]) :-
    dave13_loop(In?, Out, Narr).
%% A parent-initiated removal reaches the child as group_left, not group_removed:
%% Bob tells Dave to leave, and Dave's own agent leaves.  group_removed is what
%% the creator's removal would send, and Frank did not remove him.
dave13_loop([group_left(group_id(frank, study))|In], Out?,
    [event('Removed from study group')|Narr?]) :-
    dave13_loop(In?, Out, Narr).

dave13_loop([_|In], Out?, Narr?) :-
    otherwise | dave13_loop(In?, Out, Narr).
dave13_loop([], [], []).
