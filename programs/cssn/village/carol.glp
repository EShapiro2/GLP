%% carol.glp — Carol (Alice's child) actor for the Village scenario
%%
%% ORDER-INDEPENDENT.  The actor is one loop with one state, not a chain of
%% states each waiting for one notification.  A chained actor drops whatever its
%% current state did not expect --- its skip clause cannot put a message back ---
%% so it works only for the interleaving it was written against, and changing
%% the boot changed that interleaving.  Here every notification the actor ever
%% acts on has a clause of its own, so none can arrive "too early".  Where order
%% genuinely matters it is carried in the loop's own counters, never in which
%% clause is currently waiting.
%% Types: from village/self.glp (ancestor scoping)

%% Act 1: a party becomes a child by accepting an enrolment.  Before this it is
%% of no age and has no parent; accepting creates the parent-child channel.
exported procedure carol13(Constant?, Channel(Stream(UserNotify), Stream(UserCmd))?, Stream(NarrativeItem)).
carol13(_, ch([enrol_offer(alice, ReqId)|In],
    [enrol_decision(yes, alice, ReqId?)|Out?]),
    [act('Accepting Alice as my parent')|Narr?]) :-
    ground(ReqId?) |
    carol13_loop(0, In?, Out, Narr).
carol13(Id, ch([_|In], Out?), Narr?) :-
    otherwise | carol13(Id?, ch(In?, Out), Narr).
carol13(_, ch([], []), []).

%% Conns counts Carol's two child friendships; the group she opens waits on both,
%% and which of the two lands first is not hers to control.
procedure carol13_loop(Integer?, Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).

carol13_loop(N, [enrolled(alice)|In], Out?, [event('Alice is my parent')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).

%% Act 3: accept either introduction, in either order.
carol13_loop(N, [child_befriend(alice, dave, ReqId)|In],
    [accept_child_intro(dave, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | carol13_loop(N?, In?, Out, Narr).
carol13_loop(N, [child_befriend(alice, eve, ReqId)|In],
    [accept_child_intro(eve, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | carol13_loop(N?, In?, Out, Narr).

%% The second connection, whichever it is, opens kids_chat.
carol13_loop(N, [connected(dave)|In], Out?, [friend(dave)|Narr?]) :-
    N? < 1 | carol13_loop(1, In?, Out, Narr).
carol13_loop(N, [connected(dave)|In],
    [send(dave, 'Hi Dave!'), create_group(kids_chat)|Out?],
    [friend(dave), say('Hi Dave!'), act('Creating kids_chat group')|Narr?]) :-
    N? > 0 | carol13_loop(2, In?, Out, Narr).
carol13_loop(N, [connected(eve)|In], Out?, [friend(eve)|Narr?]) :-
    N? < 1 | carol13_loop(1, In?, Out, Narr).
carol13_loop(N, [connected(eve)|In],
    [send(dave, 'Hi Dave!'), create_group(kids_chat)|Out?],
    [friend(eve), say('Hi Dave!'), act('Creating kids_chat group')|Narr?]) :-
    N? > 0 | carol13_loop(2, In?, Out, Narr).

%% Act 4: the child-managed group, one invitation at a time.
carol13_loop(N, [group_joined(group_id(carol, kids_chat))|In],
    [invite_group(group_id(carol, kids_chat), dave)|Out?],
    [event('Kids chat created'), act('Inviting Dave to kids_chat')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).
carol13_loop(N, [group_joined_member(group_id(carol, kids_chat), dave)|In],
    [invite_group(group_id(carol, kids_chat), eve)|Out?],
    [event('Dave joined kids_chat'), act('Inviting Eve to kids_chat')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).
carol13_loop(N, [group_joined_member(group_id(carol, kids_chat), eve)|In],
    [send_group(group_id(carol, kids_chat), 'Welcome everyone!')|Out?],
    [event('Eve joined kids_chat'), say('Welcome everyone!')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).
carol13_loop(N, [group_received(group_id(carol, kids_chat), eve, _)|In], Out?,
    [event('Eve replied in kids_chat')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).
carol13_loop(N, [group_received(group_id(carol, kids_chat), dave, _)|In], Out?,
    [event('Dave replied in kids_chat')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).

%% Act 5: Frank's study group, joined through Alice.
carol13_loop(N, [group_invite(group_id(frank, study), ReqId)|In],
    [accept_group(group_id(frank, study), ReqId?)|Out?],
    [act('Accepting study group invite')|Narr?]) :-
    ground(ReqId?) | carol13_loop(N?, In?, Out, Narr).
carol13_loop(N, [group_joined(group_id(frank, study))|In],
    [send_group(group_id(frank, study), 'Hi from Carol!')|Out?],
    [event('Joined study group'), say('Hi from Carol!')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).

%% Act 6: Dave has spoken in the study group; Carol ends the friendship.  She
%% joined after he posted and receives it anyway: the delivery index is gone
%% (941196c1), and a member is owed a post while it is on the member list and the
%% creator has not already sent it that item.  This is the one panel of the
%% figure where that is visible.
carol13_loop(N, [group_received(group_id(frank, study), dave, _)|In],
    [unfriend_child(dave)|Out?],
    [event('Dave replied in study group'), act('Unfriending Dave')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).
carol13_loop(N, [unfriended(dave)|In], Out?, [event('Unfriended Dave')|Narr?]) :-
    carol13_loop(N?, In?, Out, Narr).

carol13_loop(N, [_|In], Out?, Narr?) :-
    otherwise | carol13_loop(N?, In?, Out, Narr).
carol13_loop(_, [], [], []).
