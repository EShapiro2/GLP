%% bob.glp — Bob actor for the Village scenario
%%
%% ORDER-INDEPENDENT.  The actor is one loop with one state, not a chain of
%% states each waiting for one notification.  A chained actor drops whatever its
%% current state did not expect --- its skip clause cannot put a message back ---
%% so it works only for the interleaving it was written against, and changing
%% the boot changed that interleaving.  Here every notification the actor ever
%% acts on has a clause of its own, so none can arrive "too early".  Where order
%% genuinely matters it is carried in the loop's own counters, never in which
%% clause is currently waiting.
%% Types: from village/self.glp (ancestor scoping)

%% Act 1: coming into the contract.  Bob starts an adult, as every agent does,
%% and becomes the parent of both his children.
exported procedure bob13(Constant?, Channel(Stream(UserNotify), Stream(UserCmd))?, Stream(NarrativeItem)).
bob13(_, ch(In, [enrol_child(dave), enrol_child(eve)|Out?]),
    [act('Becoming the parent of Dave'), act('Becoming the parent of Eve')|Narr?]) :-
    bob13_loop(0, 0, In?, Out, Narr).

%% Intros counts the child introductions Alice has sent (the first is Carol to
%% Dave, the second Carol to Eve); Consents counts the kids_chat approvals, and
%% the second of them is where Bob turns to Frank.  Both were positions in a
%% chain before, which is exactly what made the actor order-dependent.
procedure bob13_loop(Integer?, Integer?, Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).

bob13_loop(I, C, [enrolled(dave)|In], Out?, [event('Dave is my child')|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).
bob13_loop(I, C, [enrolled(eve)|In], Out?, [event('Eve is my child')|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).

bob13_loop(I, C, [befriend(alice, ReqId)|In], [decision(yes, alice, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | bob13_loop(I?, C?, In?, Out, Narr).
bob13_loop(I, C, [connected(alice)|In], Out?, [friend(alice)|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).
bob13_loop(I, C, [received(alice, _)|In], Out?,
    [event('Received Hello from Alice')|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).

%% Act 3: the first introduction is Carol to Dave, and Bob adds the sibling one.
bob13_loop(I, C, [child_befriend(alice, carol, ReqId)|In],
    [approve_child_intro(carol, dave, ReqId?), child_introduce(dave, bob, eve)|Out?],
    [act('Approved Carol-Dave introduction'), act('Introducing Dave to Eve (siblings)')|Narr?]) :-
    I? < 1, ground(ReqId?) |
    bob13_loop(1, C?, In?, Out, Narr).
%% The second is Carol to Eve.
bob13_loop(I, C, [child_befriend(alice, carol, ReqId)|In],
    [approve_child_intro(carol, eve, ReqId?)|Out?],
    [act('Approved Carol-Eve introduction')|Narr?]) :-
    I? > 0, ground(ReqId?) |
    bob13_loop(2, C?, In?, Out, Narr).

%% Act 4: parental consent for kids_chat, once for each child.
bob13_loop(I, C, [child_group_consent(dave, group_id(carol, kids_chat), ReqId)|In],
    [approve_child_group(dave, group_id(carol, kids_chat), ReqId?)|Out?],
    [act('Approved Dave joining kids_chat')|Narr?]) :-
    C? < 1, ground(ReqId?) |
    bob13_loop(I?, 1, In?, Out, Narr).
bob13_loop(I, C, [child_group_consent(dave, group_id(carol, kids_chat), ReqId)|In],
    [approve_child_group(dave, group_id(carol, kids_chat), ReqId?), connect(frank)|Out?],
    [act('Approved Dave joining kids_chat')|Narr?]) :-
    C? > 0, ground(ReqId?) |
    bob13_loop(I?, 2, In?, Out, Narr).
bob13_loop(I, C, [child_group_consent(eve, group_id(carol, kids_chat), ReqId)|In],
    [approve_child_group(eve, group_id(carol, kids_chat), ReqId?)|Out?],
    [act('Approved Eve joining kids_chat')|Narr?]) :-
    C? < 1, ground(ReqId?) |
    bob13_loop(I?, 1, In?, Out, Narr).
bob13_loop(I, C, [child_group_consent(eve, group_id(carol, kids_chat), ReqId)|In],
    [approve_child_group(eve, group_id(carol, kids_chat), ReqId?), connect(frank)|Out?],
    [act('Approved Eve joining kids_chat')|Narr?]) :-
    C? > 0, ground(ReqId?) |
    bob13_loop(I?, 2, In?, Out, Narr).

bob13_loop(I, C, [connected(frank)|In], [send(frank, 'ready')|Out?],
    [friend(frank), say('ready')|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).

%% Act 5: approve Dave into Frank's study group.
bob13_loop(I, C, [group_invite_child(group_id(frank, study), dave, ReqId)|In],
    [approve_group(dave, group_id(frank, study), ReqId?)|Out?],
    [act('Approved Dave joining study group')|Narr?]) :-
    ground(ReqId?) |
    bob13_loop(I?, C?, In?, Out, Narr).

%% Act 6: Frank signals done; remove Dave from the study group.
bob13_loop(I, C, [received(frank, _)|In],
    [leave_child_group(dave, group_id(frank, study))|Out?],
    [act('Removing Dave from study group')|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).

%% Act 7: ending the parenting is owed to Eve, whenever she asks for it.
bob13_loop(I, C, [release_asked(eve)|In], [approve_release(eve)|Out?],
    [act('Ending the parenting of Eve')|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).
bob13_loop(I, C, [released(eve)|In], Out?,
    [event('Eve is no longer my child')|Narr?]) :-
    bob13_loop(I?, C?, In?, Out, Narr).

bob13_loop(I, C, [_|In], Out?, Narr?) :-
    otherwise | bob13_loop(I?, C?, In?, Out, Narr).
bob13_loop(_, _, [], [], []).
