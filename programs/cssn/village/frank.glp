%% frank.glp — Frank actor for the Village scenario
%%
%% ORDER-INDEPENDENT.  The actor is one loop with one state, not a chain of
%% states each waiting for one notification.  A chained actor drops whatever its
%% current state did not expect --- its skip clause cannot put a message back ---
%% so it works only for the interleaving it was written against, and changing
%% the boot changed that interleaving.  Here every notification the actor ever
%% acts on has a clause of its own, so none can arrive "too early".  Where order
%% genuinely matters it is carried in the loop's own counters, never in which
%% clause is currently waiting.
%% Types: from village/self.glp (ancestor scoping)

%% Act 1: Frank has no children; he only declares himself of age.
exported procedure frank13(Constant?, Channel(Stream(UserNotify), Stream(UserCmd))?, Stream(NarrativeItem)).
frank13(_, ch(In, [declare_age|Out?]),
    [act('Declaring myself of age')|Narr?]) :-
    frank13_loop(In?, Out, Narr).

procedure frank13_loop(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).

frank13_loop([befriend(alice, ReqId)|In], [decision(yes, alice, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | frank13_loop(In?, Out, Narr).
frank13_loop([connected(alice)|In], Out?, [friend(alice)|Narr?]) :-
    frank13_loop(In?, Out, Narr).
frank13_loop([befriend(bob, ReqId)|In], [decision(yes, bob, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) | frank13_loop(In?, Out, Narr).
frank13_loop([connected(bob)|In], Out?, [friend(bob)|Narr?]) :-
    frank13_loop(In?, Out, Narr).

%% Act 5: Bob signals ready; open the study group.
frank13_loop([received(bob, _)|In], [create_group(study)|Out?],
    [event('Bob ready'), act('Creating study group')|Narr?]) :-
    frank13_loop(In?, Out, Narr).
frank13_loop([group_joined(group_id(frank, study))|In],
    [invite_group(group_id(frank, study), dave, bob)|Out?],
    [event('Study group created'), act('Inviting Dave to study group via Bob')|Narr?]) :-
    frank13_loop(In?, Out, Narr).
frank13_loop([group_joined_member(group_id(frank, study), dave)|In],
    [invite_group(group_id(frank, study), carol, alice)|Out?],
    [event('Dave joined study group'), act('Inviting Carol to study group via Alice')|Narr?]) :-
    frank13_loop(In?, Out, Narr).
frank13_loop([group_joined_member(group_id(frank, study), carol)|In],
    [send_group(group_id(frank, study), 'Welcome to the study group')|Out?],
    [event('Carol joined study group'), say('Welcome to the study group')|Narr?]) :-
    frank13_loop(In?, Out, Narr).
frank13_loop([group_received(group_id(frank, study), carol, _)|In], Out?,
    [event('Carol replied in study group')|Narr?]) :-
    frank13_loop(In?, Out, Narr).

%% Act 6: both children have spoken; tell Bob, whose removal of Dave follows.
frank13_loop([group_received(group_id(frank, study), dave, _)|In],
    [send(bob, 'done')|Out?],
    [event('Dave replied in study group')|Narr?]) :-
    frank13_loop(In?, Out, Narr).

%% Act 7: Eve, released and thereby of age, cold-calls Frank.
frank13_loop([befriend(eve, ReqId)|In], [decision(yes, eve, ReqId?)|Out?],
    [act('Accepting Eve, now of age')|Narr?]) :-
    ground(ReqId?) | frank13_loop(In?, Out, Narr).
frank13_loop([connected(eve)|In], Out?, [friend(eve)|Narr?]) :-
    frank13_loop(In?, Out, Narr).

frank13_loop([_|In], Out?, Narr?) :-
    otherwise | frank13_loop(In?, Out, Narr).
frank13_loop([], [], []).
