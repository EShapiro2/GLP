%% person.glp --- a scripted person at the other end of the mini-app's person
%% channel, and of the super-app stand-in (superapp.glp).
%%
%% It reads what the person channel carries --- the constructs the dispatcher
%% draws and withdraws, and the screen the agent writes, drawn as the thread of
%% construct 0 --- and what the super-app shows it, and takes the steps of its
%% script in order: a request granted on the request form, input(Id, P, R)
%% with the request at the position P the draw marks input; an answer granted
%% on the card showing an offer; a wait until the screen shows a message; and,
%% at the super-app, asking a party to befriend and accepting a party's offer.
%% A step waits until what it needs is on screen.  It logs every screen
%% message, tagged(Id, M), and every step it takes, tagged(Id, did(Step)).
%% The person channel never closes, so the person reads it for good.

%% A construct on screen that the script may answer: its offer, its
%% identifier and the position of its question.
OpenCard  ::= open(_, Integer, Path) ; none.
OpenCards ::= [] ; [OpenCard | OpenCards].
Form      ::= no_form ; form(Integer, Path).
SgOffer   ::= sg_offer(Key, ReqId).
SgOffers  ::= [] ; [SgOffer | SgOffers].
Choice    ::= grant(Integer, Path, Drawn) ; sg(SgCmd) ; next ; wait.

%% person(Id, Draws, Grants, Notes, Cmds, Script, Log): the person's grants on
%% the person channel, its commands to the super-app, and its log.
exported procedure person(Key?, _?, PersonIn(Drawn), Stream(SgNotify)?, Stream(SgCmd), Script?, Stream(_)).
person(Id, Ds, Gs?, Ns, Cs?, Script, Log?) :-
    ground(Id?) |
    person(Id?, Ds?, Gs, Ns?, Cs, Script?, no_form, [], [], [], Log).

procedure person(Key?, _?, PersonIn(Drawn), Stream(SgNotify)?, Stream(SgCmd), Script?, Form?, OpenCards?, SgOffers?, Stream(_)?, Stream(_)).

%% The screen: the thread of construct 0, drawn again with every message so
%% far as messages arrive; those not drawn before are logged, and the whole is
%% what the person has seen.
person(Id, [draw(0, _, output(Ms))|Ds], Gs?, Ns, Cs?, Script, Form, Cards, Offers, Seen, Log?) :-
    ground(Id?), ground(Ms?), ground(Seen?) |
    newer(Seen?, Ms?, Log, Log1?),
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards?, Offers?, Ms?, Log1).

%% The request form: its question is the stream of requests, at position P.
person(Id, [draw(C, _, stream_request_r(input(P)))|Ds], Gs?, Ns, Cs?, Script, _, Cards, Offers, Seen, Log?) :-
    ground(C?), ground(P?), C? > 0 |
    path_of(P?, P1),
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, form(C?, P1?), Cards?, Offers?, Seen?, Log).

%% A card, kept until the script answers it.
person(Id, [draw(C, _, V)|Ds], Gs?, Ns, Cs?, Script, Form, Cards, Offers, Seen, Log?) :-
    ground(C?), ground(V?), C? > 0 |
    card_of(V?, Card),
    add_card(Card?, C?, Cards?, Cards1),
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards1?, Offers?, Seen?, Log).

%% A construct withdrawn.
person(Id, [withdraw(C)|Ds], Gs?, Ns, Cs?, Script, Form, Cards, Offers, Seen, Log?) :-
    ground(C?) |
    drop_card(C?, Cards?, Cards1),
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards1?, Offers?, Seen?, Log).

%% A friend's offer, at the super-app.
person(Id, Ds, Gs?, [befriend(Q, R)|Ns], Cs?, Script, Form, Cards, Offers, Seen, Log?) :-
    ground(Q?), ground(R?) |
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards?, [sg_offer(Q?, R?)|Offers?], Seen?, Log).

%% A friend declined an offer of the person's.
person(Id, Ds, Gs?, [declined(Q)|Ns], Cs?, Script, Form, Cards, Offers, Seen, [declined(Q?)|Log?]) :-
    ground(Q?) |
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards?, Offers?, Seen?, Log).

%% Take the next step, if what it needs is on screen.
procedure step(Key?, _?, PersonIn(Drawn), Stream(SgNotify)?, Stream(SgCmd), Script?, Form?, OpenCards?, SgOffers?, Stream(_)?, Stream(_)).
step(Id, Ds, Gs?, Ns, Cs?, [], Form, Cards, Offers, Seen, Log?) :-
    person(Id?, Ds?, Gs, Ns?, Cs, [], Form?, Cards?, Offers?, Seen?, Log).
step(Id, Ds, Gs?, Ns, Cs?, [S|Script], Form, Cards, Offers, Seen, Log?) :-
    ground(S?), ground(Form?), ground(Cards?), ground(Offers?), ground(Seen?) |
    choose(S?, Form?, Cards?, Offers?, Seen?, Choice, Cards1, Offers1),
    act(Choice?, Id?, Ds?, Gs, Ns?, Cs, [S?|Script?], Form?, Cards1?, Offers1?, Seen?, Log).

%% What the step can do now.
procedure choose(Step?, Form?, OpenCards?, SgOffers?, Stream(_)?, Choice, OpenCards, SgOffers).
choose(req(R), form(C, P), Cards, Offers, _, grant(C?, P?, R?), Cards?, Offers?).
choose(answer(O, A), _, Cards, Offers, _, Ch?, Cards1?, Offers?) :-
    ground(O?), ground(A?) |
    find_card(O?, A?, Cards?, Ch, Cards1).
choose(await(M), _, Cards, Offers, Seen, Ch?, Cards?, Offers?) :-
    ground(M?) |
    seen(M?, Seen?, Ch).
choose(befriend(Q), _, Cards, Offers, _, sg(connect(Q?)), Cards?, Offers?).
choose(accept_friend(Q), _, Cards, Offers, _, Ch?, Cards?, Offers1?) :-
    ground(Q?) |
    find_offer(Q?, Offers?, Ch, Offers1).
choose(_, _, Cards, Offers, _, wait, Cards?, Offers?) :- otherwise | true.

procedure act(Choice?, Key?, _?, PersonIn(Drawn), Stream(SgNotify)?, Stream(SgCmd), Script?, Form?, OpenCards?, SgOffers?, Stream(_)?, Stream(_)).
act(grant(C, P, X), Id, Ds, [input(C?, P?, X?)|Gs?], Ns, Cs?, [S|Script], Form, Cards, Offers, Seen, [did(S?)|Log?]) :-
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards?, Offers?, Seen?, Log).
act(sg(Cmd), Id, Ds, Gs?, Ns, [Cmd?|Cs?], [S|Script], Form, Cards, Offers, Seen, [did(S?)|Log?]) :-
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards?, Offers?, Seen?, Log).
act(next, Id, Ds, Gs?, Ns, Cs?, [S|Script], Form, Cards, Offers, Seen, [did(S?)|Log?]) :-
    step(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards?, Offers?, Seen?, Log).
act(wait, Id, Ds, Gs?, Ns, Cs?, Script, Form, Cards, Offers, Seen, Log?) :-
    person(Id?, Ds?, Gs, Ns?, Cs, Script?, Form?, Cards?, Offers?, Seen?, Log).

%% The messages of the screen past those drawn before, logged.
procedure newer(_?, _?, Stream(_), Stream(_)?).
newer([_|Ss], [_|Ms], Log?, Log1) :- newer(Ss?, Ms?, Log, Log1?).
newer([], [M|Ms], [M?|Log?], Log1) :- newer([], Ms?, Log, Log1?).
newer(_, [], Log?, Log).

%% Whether the screen has shown M.
procedure seen(_?, _?, Choice).
seen(M, [M1|_], next) :- M? =?= M1? | true.
seen(M, [_|Ms], Ch?) :- otherwise | seen(M?, Ms?, Ch).
seen(_, [], wait).

%% A card's offer and the position of its answer, from what the dispatcher
%% draws under the functor of its ask.
procedure card_of(_?, OpenCard).
card_of(card_w(V), O?) :- open_of(V?, O).
card_of(parentCard_w(V), O?) :- open_of(V?, O).
card_of(releaseCard_w(V), O?) :- open_of(V?, O).
card_of(groupCard_w(V), O?) :- open_of(V?, O).
card_of(joinCard_w(V), O?) :- open_of(V?, O).
card_of(inviteCard_w(V), O?) :- open_of(V?, O).
card_of(_, none) :- otherwise | true.

procedure open_of(_?, OpenCard).
open_of(card(O, input(P)), open(O?, 0, P1?)) :- ground(O?), ground(P?) | path_of(P?, P1).

%% The card, under its construct's identifier: a card drawn again replaces
%% the one drawn before.
procedure add_card(OpenCard?, Integer?, OpenCards?, OpenCards).
add_card(none, _, Cards, Cards?).
add_card(open(O, _, P), C, Cards, [open(O?, C?, P?)|Cards1?]) :-
    ground(C?) | drop_card(C?, Cards?, Cards1).

procedure drop_card(Integer?, OpenCards?, OpenCards).
drop_card(C, [open(_, C1, _)|Cards], Cards?) :- C? =:= C1? | true.
drop_card(C, [K|Cards], [K?|Cards1?]) :- otherwise | drop_card(C?, Cards?, Cards1).
drop_card(_, [], []).

procedure find_card(_?, YesNo?, OpenCards?, Choice, OpenCards).
find_card(O, A, [open(O1, C, P)|Cards], grant(C?, P?, A?), Cards?) :- O? =?= O1? | true.
find_card(O, A, [K|Cards], Ch?, [K?|Cards1?]) :- otherwise | find_card(O?, A?, Cards?, Ch, Cards1).
find_card(_, _, [], wait, []).

procedure find_offer(Key?, SgOffers?, Choice, SgOffers).
find_offer(Q, [sg_offer(Q1, R)|Offers], sg(decision(yes, Q1?, R?)), Offers?) :- Q? =?= Q1? | true.
find_offer(Q, [O|Offers], Ch?, [O?|Offers1?]) :- otherwise | find_offer(Q?, Offers?, Ch, Offers1).
find_offer(_, [], wait, []).

%% The path a draw marks, a list of argument indices.
procedure path_of(_?, Path).
path_of([I|Is], P?) :- integer(I?) | P = [I?|P1?], path_of(Is?, P1).
path_of([], []).
