   %% The policy: strict or permissive.  Asked to approve the entering of their child with the other
   %% parent, a parent approves at once.  Every other approval is answered after a day on average: an
   %% offer of friendship approved 90 times in 100; a child's befriending, a child's joining a group and
   %% a child's befriending an adult, approved 20 times in 100 by a strict parent and 80 by a permissive
   %% one; anything else approved.
   %%   person strict.  Approval =::= strict_approval.
   %%   strict_approval(approval(attempt(_, _, _, enter_2(_, _, _)), A?), _, _) :- cs_say(slot(A), yes).
   %%   strict_approval(approval(attempt(_, _, _, C), A?), _, S) :- otherwise | cs_parent_answer(20, C?, S?, slot(A)) @ 1/day.
   %%   person permissive.  (the same at 80)

   person(strict),
   binds('Approval', strict_approval),
   decl(strict_approval(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(strict_approval(approval(attempt(var('_'), var('_'), var('_'), enter_2(var('_'), var('_'), var('_'))), var('A?')), var('_'), var('_')), [], [cs_say(slot(var('A')), yes)]),
   clause(strict_approval(approval(attempt(var('_'), var('_'), var('_'), var('C')), var('A?')), var('_'), var('S')), [otherwise], [rated(cs_parent_answer(20, var('C?'), var('S?'), slot(var('A'))), rate(1, day))]),

   person(permissive),
   binds('Approval', permissive_approval),
   decl(permissive_approval(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(permissive_approval(approval(attempt(var('_'), var('_'), var('_'), enter_2(var('_'), var('_'), var('_'))), var('A?')), var('_'), var('_')), [], [cs_say(slot(var('A')), yes)]),
   clause(permissive_approval(approval(attempt(var('_'), var('_'), var('_'), var('C')), var('A?')), var('_'), var('S')), [otherwise], [rated(cs_parent_answer(80, var('C?'), var('S?'), slot(var('A'))), rate(1, day))]),
   decl(cs_say(dual('Slot'('YesNo')), dual('YesNo'))),
   clause(cs_say(slot(var('V?')), var('V')), [], []),
   decl(cs_parent_answer(dual('Integer'), dual('Class'), dual('Integer'), dual('Slot'('YesNo')))),
   clause(cs_parent_answer(var('_'), befriend(var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), 90, var('A'))]),
   clause(cs_parent_answer(var('P'), child_befriend(var('_'), var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_parent_answer(var('P'), child_adult_befriend(var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_parent_answer(var('P'), child_join(var('_'), var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_parent_answer(var('P'), child_join_2(var('_'), var('_'), var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_parent_answer(var('_'), var('_'), var('_'), slot(yes)), [otherwise], [true]),
   decl(cs_yes_if(dual('Integer'), dual('Integer'), 'YesNo')),
   clause(cs_yes_if(var('K'), var('P'), yes), ['=<'(var('K?'), var('P?'))], [true]),
   clause(cs_yes_if(var('K'), var('P'), no), ['>'(var('K?'), var('P?'))], [true]),

   %% THE CHILDREN'S PROFILES.  A child has one dimension, the response, choosy or keen, which answers both
   %% questions.  A child first makes known their parents, at once; then the child answers the menu once a
   %% year on average, ending a friendship with a friend who is not a parent, and where there is none makes
   %% known a person known already.  Asked to approve their entering, a child approves at once; asked to
   %% approve a friendship or a joining, a choosy child approves 50 times in 100 and a keen one 90, after a
   %% day on average; anything else they approve.
   %%   person choosy.  Menu =::= child_menu.  Approval =::= choosy_approval.
   %%   child_menu(menu(Me, Ks, R?), person(_, _, As), S) :- seen(L), cs_child_menu(Me?, Ks?, As?, L?, S?, slot(R)).
   %%   choosy_approval(approval(attempt(_, _, _, enter(_, _)), A?), _, _) :- cs_say(slot(A), yes).
   %%   choosy_approval(approval(attempt(_, _, _, enter_2(_, _, _)), A?), _, _) :- cs_say(slot(A), yes).
   %%   choosy_approval(approval(attempt(_, _, _, C), A?), _, S) :- otherwise | cs_child_answer(50, C?, S?, slot(A)) @ 1/day.
   %%   person keen.  (the same menu; the approval at 90)

   person(choosy),
   binds('Menu', child_menu),
   binds('Approval', choosy_approval),
   decl(child_menu(dual('Menu'), dual('Person'), dual('Integer'))),
   clause(child_menu(menu(var('Me'), var('Ks'), var('R?')), person(var('_'), var('_'), var('As')), var('S')), [], [seen(var('L')), cs_child_menu(var('Me?'), var('Ks?'), var('As?'), var('L?'), var('S?'), slot(var('R')))]),
   decl(cs_child_menu(dual('Key'), dual('List'('Key')), dual('List'('CsAttr')), dual('List'('Output')), dual('Integer'), dual('Slot'('Request')))),
   clause(cs_child_menu(var('Me'), var('Ks'), var('As'), var('L'), var('S'), var('Slot')), [ground(var('Ks?')), ground(var('As?'))], [cs_attr_parents(var('As?'), var('Pa')), cs_first_missing(var('Pa?'), var('Ks?'), var('Miss')), cs_last_view(var('L?'), var('Atoms')), cs_child_do(var('Miss?'), var('Me?'), var('Ks?'), var('Atoms?'), var('S?'), var('Slot?'))]),
   decl(cs_child_do(dual('CsPick'), dual('Key'), dual('List'('Key')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(cs_child_do(pick(var('Q')), var('_'), var('_'), var('_'), var('_'), slot(known(var('Q?')))), [], []),
   clause(cs_child_do(nothing, var('Me'), var('Ks'), var('Atoms'), var('S'), var('Slot')), [], [rated(cs_child_act(var('Me?'), var('Ks?'), var('Atoms?'), var('S?'), var('Slot?')), rate(1, year))]),
   decl(cs_child_act(dual('Key'), dual('List'('Key')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(cs_child_act(var('Me'), var('Ks'), var('Atoms'), var('S'), var('Slot')), [ground(var('Atoms?'))], [cs_friends(var('Atoms?'), var('Fr')), cs_parents_in(var('Atoms?'), var('Pa')), cs_minus(var('Fr?'), var('Pa?'), var('Fq')), cs_pick_or_nothing(var('Fq?'), var('S?'), var('Qp')), cs_child_act1(var('Qp?'), var('Me?'), var('Ks?'), var('Slot?'))]),
   decl(cs_child_act1(dual('CsPick'), dual('Key'), dual('List'('Key')), dual('Slot'('Request')))),
   clause(cs_child_act1(pick(var('Q')), var('Me'), var('_'), slot(propose(unfriend(var('Me?'), var('Q?'))))), [], []),
   clause(cs_child_act1(nothing, var('_'), [var('Q0') | var('_')], slot(known(var('Q0?')))), [], []),
   decl(choosy_approval(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(choosy_approval(approval(attempt(var('_'), var('_'), var('_'), enter(var('_'), var('_'))), var('A?')), var('_'), var('_')), [], [cs_say(slot(var('A')), yes)]),
   clause(choosy_approval(approval(attempt(var('_'), var('_'), var('_'), enter_2(var('_'), var('_'), var('_'))), var('A?')), var('_'), var('_')), [], [cs_say(slot(var('A')), yes)]),
   clause(choosy_approval(approval(attempt(var('_'), var('_'), var('_'), var('C')), var('A?')), var('_'), var('S')), [otherwise], [rated(cs_child_answer(50, var('C?'), var('S?'), slot(var('A'))), rate(1, day))]),

   person(keen),
   binds('Menu', child_menu),
   binds('Approval', keen_approval),
   decl(keen_approval(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(keen_approval(approval(attempt(var('_'), var('_'), var('_'), enter(var('_'), var('_'))), var('A?')), var('_'), var('_')), [], [cs_say(slot(var('A')), yes)]),
   clause(keen_approval(approval(attempt(var('_'), var('_'), var('_'), enter_2(var('_'), var('_'), var('_'))), var('A?')), var('_'), var('_')), [], [cs_say(slot(var('A')), yes)]),
   clause(keen_approval(approval(attempt(var('_'), var('_'), var('_'), var('C')), var('A?')), var('_'), var('S')), [otherwise], [rated(cs_child_answer(90, var('C?'), var('S?'), slot(var('A'))), rate(1, day))]),
   decl(cs_child_answer(dual('Integer'), dual('Class'), dual('Integer'), dual('Slot'('YesNo')))),
   clause(cs_child_answer(var('P'), child_befriend(var('_'), var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_child_answer(var('P'), child_adult_befriend(var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_child_answer(var('P'), child_join(var('_'), var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_child_answer(var('P'), child_join_2(var('_'), var('_'), var('_'), var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), cs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(cs_child_answer(var('_'), var('_'), var('_'), slot(yes)), [otherwise], [true]),

   %% THE RUN.  Four villages for one simulated year, the parents half local and half open, all strict,
   %% the children all choosy; the three other mixes are all permissive, all keen, and both (Section 5,
   %% "The runs"), run with the shares exchanged, and the cost run names cs_villages40.
   %%   run cs_villages [ approach of parent ~ (local : 0.5 ; open : 0.5),
   %%                     policy of parent ~ (strict : 1.0),
   %%                     response of child ~ (choosy : 1.0) ]
   %%       until 1 year seed 1.
   run(cs_villages,
       [mix(approach, parent, [share(local, 0.5), share(open, 0.5)]),
        mix(policy, parent, [share(strict, 1.0)]),
        mix(response, child, [share(choosy, 1.0)])],
       1, year, 1),

