   clause(cs_offer_to([], [var('X') | var('Xs')], var('Me'), var('_'), var('S'), slot(propose(befriend(var('Me?'), var('Q?'))))), [], [cs_pick([var('X?') | var('Xs?')], var('S?'), var('Q'), var('_'))]),
