%% ---------------------------------------------------------------------------
%% CSSN_sglp.glp --- CSSN's sGLP source: the simulation of the child-safe social
%% network under sGLP (CSSN, Section 5, "Simulating the Child-Safe Social
%% Graph"), in the term form the transformation reads (programs/sglp/README.md,
%% "The term form"), over the canonical CVA platform of CSSN.glp beside it, whose
%% interface the cascade prints as cascade/CSSN/interface.glp:
%%   programs/sglp/transform.sh --interface cascade/CSSN/interface.glp --source programs/cssn/CSSN_sglp.glp --out <dir>
%% The census, the profiles and the run declaration are sGLP's paper's, Section 3
%% at 0270ac6 (a census draws the persons, person(Key, Role, Attributes); a
%% dimension of profiles is of one role; a person procedure takes a copy of the
%% question, the person and a seed, and reads what the person has seen by
%% seen(L)).  Written by CSSN #8 Cowork, 2026-10-20 (claude.md, "Code": the
%% owner writes programs/<owner>/<NAME>_sglp.glp); the surface form of each
%% part is in the comment above it.  The questions are the platform's two:
%% Menu, menu(Me, Known, Request?), and Approval, approval(Attempt, YesNo?); its
%% output, Output, is view(Atoms, Known), refused(Class, Key) or yielded(Class).
%% The roles are parent and child; a parent has two dimensions, approach and
%% policy, a child one, response.  A rated goal takes inputs and a slot
%% (sGLP, Section 4); every name here starts with cs, or is a profile's.
%% ---------------------------------------------------------------------------

exported procedure source(SglpTerms).
source([
   %% The types of the census and the profiles.  Person is person(Key, Role, Attributes), the
   %% role parent or child; CsAttr the attributes: the village, the parents and the children of the
   %% family, the persons the person knows at the start, and, for a parent, the table of all the
   %% families.  Every name of the source starts with cs, apart from the platform's own.
   type('CsFam', [fam('Integer', 'List'('Key'), 'List'('Key'))]),
   type('CsAttr', [village('Integer'), parents('List'('Key')), children('List'('Key')), knows('List'('Key')), families('List'('CsFam'))]),
   type('Person', [person('Key', 'Constant', 'List'('CsAttr'))]),
   type('CsKeys', [ks('Key', 'Key', 'Key', 'Key', 'Key')]),
   type('CsPick', [pick('Key'), nothing]),
   type('CsTodo', [know('Key'), enter1('Key', 'Key'), enter2('Key', 'Key', 'Key'), steady]),

   %% THE CENSUS.  cs_villages draws four villages of ten families, cs_villages40 forty, for the cost
   %% run.  A family has two parents 70 times in 100 and one otherwise, and one, two or three children,
   %% equally likely.  A parent knows at the start the parents of their own village, two parents of
   %% other villages, their acquaintances, and their children; a child knows their parents.
   %%   cs_villages(S, Ps) :- cs_keys4(Ks), cs_census(Ks?, S?, Ps).
   decl(cs_villages(dual('Integer'), 'List'('Person'))),
   clause(cs_villages(var('S'), var('Ps?')), [], [cs_keys4(var('Ks')), cs_census(var('Ks?'), var('S?'), var('Ps'))]),
   decl(cs_villages40(dual('Integer'), 'List'('Person'))),
   clause(cs_villages40(var('S'), var('Ps?')), [], [cs_keys40(var('Ks')), cs_census(var('Ks?'), var('S?'), var('Ps'))]),
   decl(cs_census(dual('List'('CsKeys')), dual('Integer'), 'List'('Person'))),
   clause(cs_census(var('Ks'), var('S'), var('Ps?')), [], [cs_draw(var('Ks?'), 1, 1, var('S?'), var('Fs'), var('S1')), cs_persons_all(var('Fs?'), var('S1?'), var('Ps'))]),
   decl(cs_persons_all(dual('List'('CsFam')), dual('Integer'), 'List'('Person'))),
   clause(cs_persons_all(var('Fs'), var('S'), var('Ps?')), [ground(var('Fs?'))], [cs_persons(var('Fs?'), var('Fs?'), var('S?'), var('Ps'))]),
   %% cs_draw(Ks?, V?, F?, S?, Fs, S1): the families, from the key table, ten to a village.
   decl(cs_draw(dual('List'('CsKeys')), dual('Integer'), dual('Integer'), dual('Integer'), 'List'('CsFam'), 'Integer')),
   clause(cs_draw([], var('_'), var('_'), var('S'), [], var('S?')), [], []),
   clause(cs_draw([ks(var('P1'), var('P2'), var('C1'), var('C2'), var('C3')) | var('Ks')], var('V'), var('F'), var('S'), [fam(var('V?'), var('Pa?'), var('Ch?')) | var('Fs?')], var('S3?')), [ground(var('V?'))], [random(var('S?'), 100, var('K1'), var('S1')), cs_parents(var('K1?'), var('P1?'), var('P2?'), var('Pa')), random(var('S1?'), 3, var('K2'), var('S2')), cs_children(var('K2?'), var('C1?'), var('C2?'), var('C3?'), var('Ch')), cs_next(var('V?'), var('F?'), var('V1'), var('F1')), cs_draw(var('Ks?'), var('V1?'), var('F1?'), var('S2?'), var('Fs'), var('S3'))]),
   decl(cs_parents(dual('Integer'), dual('Key'), dual('Key'), 'List'('Key'))),
   clause(cs_parents(var('K'), var('P1'), var('P2'), [var('P1?'), var('P2?')]), ['=<'(var('K?'), 70)], [true]),
   clause(cs_parents(var('K'), var('P1'), var('_'), [var('P1?')]), ['>'(var('K?'), 70)], [true]),
   decl(cs_children(dual('Integer'), dual('Key'), dual('Key'), dual('Key'), 'List'('Key'))),
   clause(cs_children(1, var('C1'), var('_'), var('_'), [var('C1?')]), [], []),
   clause(cs_children(2, var('C1'), var('C2'), var('_'), [var('C1?'), var('C2?')]), [], []),
   clause(cs_children(3, var('C1'), var('C2'), var('C3'), [var('C1?'), var('C2?'), var('C3?')]), [], []),
   decl(cs_next(dual('Integer'), dual('Integer'), 'Integer', 'Integer')),
   clause(cs_next(var('V'), 10, var('V1?'), 1), [], [':='(var('V1'), '+'(var('V?'), 1))]),
   clause(cs_next(var('V'), var('F'), var('V?'), var('F1?')), ['<'(var('F?'), 10)], [':='(var('F1'), '+'(var('F?'), 1))]),
   %% cs_persons(Fs?, All?, S?, Ps): the persons of the families Fs, All the table of all of them.
   decl(cs_persons(dual('List'('CsFam')), dual('List'('CsFam')), dual('Integer'), 'List'('Person'))),
   clause(cs_persons([], var('_'), var('_'), []), [], []),
   clause(cs_persons([fam(var('V'), var('Pa'), var('Ch')) | var('Fs')], var('All'), var('S'), var('Ps?')), [ground(var('V?')), ground(var('Pa?')), ground(var('Ch?')), ground(var('All?'))], [cs_parent_persons(var('Pa?'), var('V?'), var('Pa?'), var('Ch?'), var('All?'), var('S?'), var('Ps1'), var('S1')), cs_child_persons(var('Ch?'), var('V?'), var('Pa?'), var('Ps2')), cs_persons(var('Fs?'), var('All?'), var('S1?'), var('Ps3')), cs_app(var('Ps1?'), var('Ps2?'), var('Ps12')), cs_app(var('Ps12?'), var('Ps3?'), var('Ps'))]),
   decl(cs_parent_persons(dual('List'('Key')), dual('Integer'), dual('List'('Key')), dual('List'('Key')), dual('List'('CsFam')), dual('Integer'), 'List'('Person'), 'Integer')),
   clause(cs_parent_persons([], var('_'), var('_'), var('_'), var('_'), var('S'), [], var('S?')), [], []),
   clause(cs_parent_persons([var('P') | var('Pa')], var('V'), var('Pa0'), var('Ch'), var('All'), var('S'), [person(var('P?'), parent, [village(var('V?')), parents(var('Pa0?')), children(var('Ch?')), knows(var('Kn?')), families(var('All?'))]) | var('Ps?')], var('S2?')), [ground(var('P?')), ground(var('V?')), ground(var('Pa0?')), ground(var('Ch?')), ground(var('All?'))], [cs_village_parents(var('All?'), var('V?'), var('P?'), var('Vp')), cs_other_parents(var('All?'), var('V?'), var('Op')), cs_two(var('Op?'), var('S?'), var('Ac'), var('S1')), cs_app(var('Vp?'), var('Ac?'), var('Kn1')), cs_app(var('Kn1?'), var('Ch?'), var('Kn')), cs_parent_persons(var('Pa?'), var('V?'), var('Pa0?'), var('Ch?'), var('All?'), var('S1?'), var('Ps'), var('S2'))]),
   decl(cs_child_persons(dual('List'('Key')), dual('Integer'), dual('List'('Key')), 'List'('Person'))),
   clause(cs_child_persons([], var('_'), var('_'), []), [], []),
   clause(cs_child_persons([var('C') | var('Ch')], var('V'), var('Pa'), [person(var('C?'), child, [village(var('V?')), parents(var('Pa?')), knows(var('Pa?'))]) | var('Ps?')]), [ground(var('V?')), ground(var('Pa?'))], [cs_child_persons(var('Ch?'), var('V?'), var('Pa?'), var('Ps'))]),
   %% cs_village_parents(All?, V?, Me?, Vp): the parents of village V other than Me; cs_other_parents(All?, V?, Op): those of the other villages.
   decl(cs_village_parents(dual('List'('CsFam')), dual('Integer'), dual('Key'), 'List'('Key'))),
   clause(cs_village_parents([], var('_'), var('_'), []), [], []),
   clause(cs_village_parents([fam(var('V'), var('Pa'), var('_')) | var('Fs')], var('V0'), var('Me'), var('Vp?')), ['=?='(var('V?'), var('V0?')), ground(var('V0?')), ground(var('Me?'))], [cs_without(var('Pa?'), var('Me?'), var('Pa1')), cs_village_parents(var('Fs?'), var('V0?'), var('Me?'), var('Vp1')), cs_app(var('Pa1?'), var('Vp1?'), var('Vp'))]),
   clause(cs_village_parents([fam(var('_'), var('_'), var('_')) | var('Fs')], var('V0'), var('Me'), var('Vp?')), [otherwise], [cs_village_parents(var('Fs?'), var('V0?'), var('Me?'), var('Vp'))]),
   decl(cs_other_parents(dual('List'('CsFam')), dual('Integer'), 'List'('Key'))),
   clause(cs_other_parents([], var('_'), []), [], []),
   clause(cs_other_parents([fam(var('V'), var('_'), var('_')) | var('Fs')], var('V0'), var('Op?')), ['=?='(var('V?'), var('V0?')), ground(var('V0?'))], [cs_other_parents(var('Fs?'), var('V0?'), var('Op'))]),
   clause(cs_other_parents([fam(var('_'), var('Pa'), var('_')) | var('Fs')], var('V0'), var('Op?')), [otherwise], [cs_other_parents(var('Fs?'), var('V0?'), var('Op1')), cs_app(var('Pa?'), var('Op1?'), var('Op'))]),
   %% The list helpers: cs_app appends; cs_two draws two distinct keys, fewer where the list has fewer;
   %% cs_pick draws one uniformly from a non-empty list; cs_without removes a key; cs_minus removes a list;
   %% cs_inter keeps those also in a list; cs_mem tests membership.
   decl(cs_app(dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(cs_app([], var('Ys'), var('Ys?')), [], []),
   clause(cs_app([var('X') | var('Xs')], var('Ys'), [var('X?') | var('Zs?')]), [], [cs_app(var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(cs_two(dual('List'('Key')), dual('Integer'), 'List'('Key'), 'Integer')),
   clause(cs_two([], var('S'), [], var('S?')), [], []),
   clause(cs_two([var('X')], var('S'), [var('X?')], var('S?')), [], []),
   clause(cs_two([var('X'), var('Y') | var('Xs')], var('S'), var('Two?'), var('S2?')), [ground(var('X?')), ground(var('Y?')), ground(var('Xs?'))], [cs_pick([var('X?'), var('Y?') | var('Xs?')], var('S?'), var('A'), var('S1')), cs_two1(var('A?'), [var('X?'), var('Y?') | var('Xs?')], var('S1?'), var('Two'), var('S2'))]),
   decl(cs_two1(dual('Key'), dual('List'('Key')), dual('Integer'), 'List'('Key'), 'Integer')),
   clause(cs_two1(var('A'), var('Xs'), var('S'), [var('A?'), var('B?')], var('S1?')), [ground(var('A?'))], [cs_without(var('Xs?'), var('A?'), var('Rest')), cs_pick(var('Rest?'), var('S?'), var('B'), var('S1'))]),
   decl(cs_pick(dual('List'('Key')), dual('Integer'), 'Key', 'Integer')),
   clause(cs_pick(var('Xs'), var('S'), var('X?'), var('S1?')), [ground(var('Xs?'))], [length(var('Xs?'), var('N')), random(var('S?'), var('N?'), var('K'), var('S1')), cs_nth(var('K?'), var('Xs?'), var('X'))]),
   decl(cs_nth(dual('Integer'), dual('List'('Key')), 'Key')),
   clause(cs_nth(1, [var('X') | var('_')], var('X?')), [], []),
   clause(cs_nth(var('K'), [var('_') | var('Xs')], var('X?')), ['>'(var('K?'), 1)], [':='(var('K1'), '-'(var('K?'), 1)), cs_nth(var('K1?'), var('Xs?'), var('X'))]),
   decl(cs_without(dual('List'('Key')), dual('Key'), 'List'('Key'))),
   clause(cs_without([], var('_'), []), [], []),
   clause(cs_without([var('X') | var('Xs')], var('Y'), var('Zs?')), ['=?='(var('X?'), var('Y?')), ground(var('Y?'))], [cs_without(var('Xs?'), var('Y?'), var('Zs'))]),
   clause(cs_without([var('X') | var('Xs')], var('Y'), [var('X?') | var('Zs?')]), [otherwise, ground(var('Y?'))], [cs_without(var('Xs?'), var('Y?'), var('Zs'))]),
   decl(cs_minus(dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(cs_minus(var('Xs'), [], var('Xs?')), [], []),
   clause(cs_minus(var('Xs'), [var('Y') | var('Ys')], var('Zs?')), [], [cs_without(var('Xs?'), var('Y?'), var('Xs1')), cs_minus(var('Xs1?'), var('Ys?'), var('Zs'))]),
   decl(cs_inter(dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(cs_inter([], var('_'), []), [], []),
   clause(cs_inter([var('X') | var('Xs')], var('Ys'), var('Zs?')), [ground(var('X?')), ground(var('Ys?'))], [cs_mem(var('X?'), var('Ys?'), var('In')), cs_inter1(var('In?'), var('X?'), var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(cs_inter1(dual('YesNo'), dual('Key'), dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(cs_inter1(yes, var('X'), var('Xs'), var('Ys'), [var('X?') | var('Zs?')]), [], [cs_inter(var('Xs?'), var('Ys?'), var('Zs'))]),
   clause(cs_inter1(no, var('_'), var('Xs'), var('Ys'), var('Zs?')), [], [cs_inter(var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(cs_mem(dual('Key'), dual('List'('Key')), 'YesNo')),
   clause(cs_mem(var('_'), [], no), [], []),
   clause(cs_mem(var('X'), [var('Y') | var('_')], yes), ['=?='(var('X?'), var('Y?'))], [true]),
   clause(cs_mem(var('X'), [var('_') | var('Ys')], var('R?')), [otherwise], [cs_mem(var('X?'), var('Ys?'), var('R'))]),
   %% The attributes of a person, and what the person's screen shows: cs_last_view(L?, Atoms) is the
   %% atoms of the last view among the elements seen, L the last first, and [] where none was shown;
   %% cs_friends, cs_parenting and cs_parents_in read the friends, the children and the parents recorded
   %% in them; cs_pick_or_nothing draws from a list that may be empty.
   decl(cs_attr_knows(dual('List'('CsAttr')), 'List'('Key'))),
   clause(cs_attr_knows([knows(var('Kn')) | var('_')], var('Kn?')), [], []),
   clause(cs_attr_knows([var('_') | var('As')], var('Kn?')), [otherwise], [cs_attr_knows(var('As?'), var('Kn'))]),
   decl(cs_attr_children(dual('List'('CsAttr')), 'List'('Key'))),
   clause(cs_attr_children([children(var('Ch')) | var('_')], var('Ch?')), [], []),
   clause(cs_attr_children([var('_') | var('As')], var('Ch?')), [otherwise], [cs_attr_children(var('As?'), var('Ch'))]),
   decl(cs_attr_parents(dual('List'('CsAttr')), 'List'('Key'))),
   clause(cs_attr_parents([parents(var('Pa')) | var('_')], var('Pa?')), [], []),
   clause(cs_attr_parents([var('_') | var('As')], var('Pa?')), [otherwise], [cs_attr_parents(var('As?'), var('Pa'))]),
   decl(cs_attr_village(dual('List'('CsAttr')), 'Integer')),
   clause(cs_attr_village([village(var('V')) | var('_')], var('V?')), [], []),
   clause(cs_attr_village([var('_') | var('As')], var('V?')), [otherwise], [cs_attr_village(var('As?'), var('V'))]),
   decl(cs_attr_families(dual('List'('CsAttr')), 'List'('CsFam'))),
   clause(cs_attr_families([families(var('Fs')) | var('_')], var('Fs?')), [], []),
   clause(cs_attr_families([var('_') | var('As')], var('Fs?')), [otherwise], [cs_attr_families(var('As?'), var('Fs'))]),
   decl(cs_last_view(dual('List'('Output')), 'List'('Atom'))),
   clause(cs_last_view([], []), [], []),
   clause(cs_last_view([view(var('As'), var('_')) | var('_')], var('As?')), [], []),
   clause(cs_last_view([var('_') | var('L')], var('As?')), [otherwise], [cs_last_view(var('L?'), var('As'))]),
   decl(cs_friends(dual('List'('Atom')), 'List'('Key'))),
   clause(cs_friends([], []), [], []),
   clause(cs_friends([friend(var('Q')) | var('As')], [var('Q?') | var('Fs?')]), [], [cs_friends(var('As?'), var('Fs'))]),
   clause(cs_friends([var('_') | var('As')], var('Fs?')), [otherwise], [cs_friends(var('As?'), var('Fs'))]),
   decl(cs_parenting(dual('List'('Atom')), 'List'('Key'))),
   clause(cs_parenting([], []), [], []),
   clause(cs_parenting([parenting(var('C')) | var('As')], [var('C?') | var('Cs?')]), [], [cs_parenting(var('As?'), var('Cs'))]),
   clause(cs_parenting([var('_') | var('As')], var('Cs?')), [otherwise], [cs_parenting(var('As?'), var('Cs'))]),
   decl(cs_parents_in(dual('List'('Atom')), 'List'('Key'))),
   clause(cs_parents_in([], []), [], []),
   clause(cs_parents_in([parent(var('P')) | var('As')], [var('P?') | var('Ps?')]), [], [cs_parents_in(var('As?'), var('Ps'))]),
   clause(cs_parents_in([var('_') | var('As')], var('Ps?')), [otherwise], [cs_parents_in(var('As?'), var('Ps'))]),
   decl(cs_all_parents(dual('List'('CsFam')), 'List'('Key'))),
   clause(cs_all_parents([], []), [], []),
   clause(cs_all_parents([fam(var('_'), var('Pa'), var('_')) | var('Fs')], var('Ps?')), [], [cs_all_parents(var('Fs?'), var('Ps1')), cs_app(var('Pa?'), var('Ps1?'), var('Ps'))]),
   decl(cs_children_of(dual('List'('CsFam')), dual('Key'), 'List'('Key'))),
   %% cs_children_of(All?, Q?, Ch): the children of the family Q is a parent of, [] where Q is no parent.
   clause(cs_children_of([], var('_'), []), [], []),
   clause(cs_children_of([fam(var('_'), var('Pa'), var('Ch')) | var('Fs')], var('Q'), var('Cs?')), [ground(var('Pa?')), ground(var('Q?'))], [cs_mem(var('Q?'), var('Pa?'), var('In')), cs_children_of1(var('In?'), var('Ch?'), var('Fs?'), var('Q?'), var('Cs'))]),
   decl(cs_children_of1(dual('YesNo'), dual('List'('Key')), dual('List'('CsFam')), dual('Key'), 'List'('Key'))),
   clause(cs_children_of1(yes, var('Ch'), var('_'), var('_'), var('Ch?')), [], []),
   clause(cs_children_of1(no, var('_'), var('Fs'), var('Q'), var('Cs?')), [], [cs_children_of(var('Fs?'), var('Q?'), var('Cs'))]),
   decl(cs_first_missing(dual('List'('Key')), dual('List'('Key')), 'CsPick')),
   %% cs_first_missing(Kn?, Ks?, P): the first of Kn not in Ks, or nothing.
   clause(cs_first_missing([], var('_'), nothing), [], []),
   clause(cs_first_missing([var('X') | var('Xs')], var('Ks'), var('P?')), [ground(var('X?')), ground(var('Ks?'))], [cs_mem(var('X?'), var('Ks?'), var('In')), cs_first_missing1(var('In?'), var('X?'), var('Xs?'), var('Ks?'), var('P'))]),
   decl(cs_first_missing1(dual('YesNo'), dual('Key'), dual('List'('Key')), dual('List'('Key')), 'CsPick')),
   clause(cs_first_missing1(no, var('X'), var('_'), var('_'), pick(var('X?'))), [], []),
   clause(cs_first_missing1(yes, var('_'), var('Xs'), var('Ks'), var('P?')), [], [cs_first_missing(var('Xs?'), var('Ks?'), var('P'))]),
   decl(cs_pick_or_nothing(dual('List'('Key')), dual('Integer'), 'CsPick')),
   clause(cs_pick_or_nothing([], var('_'), nothing), [], []),
   clause(cs_pick_or_nothing([var('X') | var('Xs')], var('S'), pick(var('Q?'))), [], [cs_pick([var('X?') | var('Xs?')], var('S?'), var('Q'), var('_'))]),

   %% THE PARENTS' PROFILES.  A parent has two dimensions: the approach, local or open, which answers the
   %% menu, and the policy, strict or permissive, which answers an approval.
   %%   person local.  Menu =::= local_menu.
   %%   local_menu(menu(Me, Ks, R?), person(_, _, As), S) :- seen(L), cs_parent_menu(95, Me?, Ks?, As?, L?, S?, slot(R)).
   %%   person open.   Menu =::= open_menu.   (the same at 60)
   %% A parent first makes known the persons they know from outside the app, one per menu, and enters each
   %% of their children not yet entered, the first parent of the family proposing the entering with the
   %% second; these answers take no time.  Then the parent answers the menu 65 times a year on average:
   %% 52 in 65 an offer of friendship to a parent the agent knows who is not yet a friend --- a local parent
   %% to a parent of their own village 95 times in 100, an open parent 60 times in 100; 12 in 65 a request
   %% that a child of theirs and a child of a friend befriend; and 1 in 65 the ending of a friendship with a
   %% friend who is not their child.  Where the act drawn has no candidate the parent offers friendship
   %% instead, and where nothing can be done the menu is answered by making known a person known already.

   person(local),
   binds('Menu', local_menu),
   decl(local_menu(dual('Menu'), dual('Person'), dual('Integer'))),
   clause(local_menu(menu(var('Me'), var('Ks'), var('R?')), person(var('_'), var('_'), var('As')), var('S')), [], [seen(var('L')), cs_parent_menu(95, var('Me?'), var('Ks?'), var('As?'), var('L?'), var('S?'), slot(var('R')))]),

   person(open),
   binds('Menu', open_menu),
   decl(open_menu(dual('Menu'), dual('Person'), dual('Integer'))),
   clause(open_menu(menu(var('Me'), var('Ks'), var('R?')), person(var('_'), var('_'), var('As')), var('S')), [], [seen(var('L')), cs_parent_menu(60, var('Me?'), var('Ks?'), var('As?'), var('L?'), var('S?'), slot(var('R')))]),
   decl(cs_parent_menu(dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('CsAttr')), dual('List'('Output')), dual('Integer'), dual('Slot'('Request')))),
   clause(cs_parent_menu(var('Local'), var('Me'), var('Ks'), var('As'), var('L'), var('S'), var('Slot')), [], [cs_last_view(var('L?'), var('Atoms')), cs_parent_menu1(var('Atoms?'), var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('S?'), var('Slot?'))]),
   decl(cs_parent_menu1(dual('List'('Atom')), dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('CsAttr')), dual('Integer'), dual('Slot'('Request')))),
