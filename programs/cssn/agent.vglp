%% agent.vglp — the CSSN social-network agent as a vGLP program.
%%
%% vGLP source of the tested GLP program agent.glp + ui/mediator.glp (this
%% directory): the agent authored with volition-guarded clauses, the mediator
%% and its UserCmd/UserNotify vocabulary absent — they belong to the
%% implementation, which maps the volition-guarded clauses into concrete UI
%% constructs.  Exhibit for the paper "Volition Elicitation: Operational
%% Semantics for People and Their Machines", which defines vGLP.
%% This is the adult agent; the child agent (child_agent.glp) is a separate
%% program, not part of this exhibit.
%%
%% NOTATION (defined in the paper):
%%   *                          marks a volition-guarded clause: reducing a goal with
%%                              it requires, besides its guards, the person willing
%%                              this reduction. Among volition-guarded clauses for
%%                              the same goal, the person's answer selects the clause.
%%   *(X1,...,Xk)               a volition-guarded clause with person-supplied inputs:
%%                              the person's answer binds the writers X1..Xk; the clause
%%                              carries their readers Xi?.
%%
%% RESPONDERS. An arriving offer spawns a responder goal — respond_coldcall,
%% respond_intro, respond_child_intro, respond_group_invite,
%% respond_group_invite_child, respond_child_consent, respond_enrol,
%% respond_release — one goal per offer, so
%% offers pend concurrently and are answered in any order.  The responder
%% carries the offer and the escrowed writer or channel; its volition-guarded
%% sibling clauses are the person's choice, and the chosen clause acts —
%% directly on the escrowed channel, or by injecting its answer, through a
%% merge, into the agent's UserIn, where an ordinary agent clause carries it
%% out on the agent's current state.
%%
%% Correspondence to the implementation (clause for clause):
%%   - a *(X1..Xk) Request clause  ->  a UserCmd constructor over X1..Xk, a mediator
%%     pass-through, and the agent clause matching msg(person, Id, cmd(X1..Xk)):
%%     connect/1, send/2, introduce/2, child_introduce/3, create_group/1,
%%     invite_group/2, invite_group/3, send_group/2, leave_group/1,
%%     leave_child_group/2, remove_from_group/2, unfriend_child_of/2 and
%%     enrol_child/1;
%%   - a responder goal, spawned per arriving offer  ->  a pending-table entry
%%     req(N) in the mediator, rendered as an inbox card;
%%   - a responder's volition-guarded clause  ->  the UserCmds decision/3
%%     (cold call), accept_intro/2 and reject_intro/2 (introduction),
%%     accept_child_intro/2, reject_child_intro/2 and approve_child_intro/3
%%     (child introduction), accept_group/2 and reject_group/2 (group invite),
%%     approve_group/3 and reject_group/2 (child's group invite),
%%     approve_child_group/3 and reject_child_group/3 (child's consent request)
%%     routing the escrowed writer or channel back to the agent; the agent's
%%     answer clauses below, and the accept/reject bodies of the responders,
%%     match the deployed clauses modulo the msg(person, Id, ...) wrapper and
%%     the channel(...)/group_channel(...)/consent(...) escrow packing.
%% The escrow vocabulary — befriend/2, befriend_intro/3, child_befriend/3,
%% the agent-to-user group_invite/2 and group_invite_child/3,
%% child_group_consent/3, and the pending table — does not appear here: the
%% machine's question to the person is not a message but a pending
%% volition-guarded reduction.
%%
%% This file is vGLP, not GLP: the REPL does not load it (hence .vglp).  Its
%% correctness argument is the clause-for-clause correspondence to the tested,
%% deployed implementation in this directory.
%%
%% Shared types (AgentState, EnrolResponse, Response, Decision, Handshake, IntroContent, FriendContent,
%% FriendMsg, GroupId, GroupContent, GroupMsg, GroupSetupResponse, OutputKey,
%% NetColdCall, NetInMsg, NetInStream, NetOutMsg, NetOutStream, IntroResult,
%% GroupJoinResult) are those of self.glp.  Helper procedures — channel ops,
%% merge, the lib/routing routers (send_user, send_net, send_friend,
%% send_child), inject_msg, intro_await_peer, inject_intro_result,
%% befriend_commit, close_friend, the self.glp group helpers
%% (setup_group_creator, setup_group_hub_side, lookup_send_group,
%% distribute_group_msg, add_group_output, group_await_join,
%% inject_group_result, close_output, close_outputs), the enrolment and approval
%% helpers (add_parent_output, close_child, enrol_commit,
%% inject_enrol_response, add_post, replay_posts), and the
%% local await_group_channel, bind_response, handle_response,
%% — are those of agent.glp, self.glp, and
%% lib/routing/, unchanged; this file gives the agent procedure and its
%% responders.


%% Screen vocabulary — self.glp's AgentContent minus the ask vocabulary
%% (of AgentOnlyContent: befriend/2, befriend_intro/3, child_befriend/3,
%% child_group_consent/3; of GroupNotifyContent: group_invite/2,
%% group_invite_child/3 — group_removed/1 stays): under vGLP the machine asks
%% the person by a pending reduction, not by a message.
AgentContent ::= connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; received(Constant, Constant)
               ; group_joined(GroupId)
               ; group_joined_member(GroupId, Constant)
               ; group_left(GroupId)
               ; group_received(GroupId, Constant, Constant)
               ; group_removed(GroupId)
               ; unfriended(Constant)
               ; enrolled(Constant)
               ; released(Constant).
AgentToUserMsg ::= msg(Constant, Constant, AgentContent).

%% UserIn — under vGLP the person's commands are grants, not messages; UserIn
%% carries the answers the responders inject and the results injected by
%% inject_msg, inject_intro_result, and inject_group_result.
UserContent    ::= response(Response).
ColdCallAnswer ::= response(Response?).
UserInMsg   ::= msg(Constant, Constant, UserContent)
              ; decision(Decision, Constant, ColdCallAnswer)
              ; approve_child_intro(Constant, Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
              ; accept_group(GroupId, Stream(GroupSetupResponse))
              ; approve_group(Constant, GroupId, Channel(Stream(IntroContent), Stream(GroupSetupResponse)))
              ; intro_result(Constant, Channel(Stream(IntroContent), Stream(IntroContent)))
              ; intro_rejected(Constant)
              ; group_join_ack(GroupId, Constant, Channel(Stream(IntroContent), Stream(GroupSetupResponse)))
              ; group_join_nack(GroupId, Constant)
              ; enrol_accepted(Constant, Channel(Stream(FriendMsg), Stream(FriendMsg)))
              ; enrol_response(Constant, EnrolResponse)
              ; approve_release(Constant).

OutputEntry ::= user_output(Stream(AgentToUserMsg)?)
              ; net_output(NetOutStream?)
              ; friend_output(Constant, Stream(FriendMsg)?)
              ; child_output(Constant, Stream(FriendMsg)?)
              ; parent_output(Constant, Stream(FriendMsg)?)
              ; group_entry(OutputKey, Stream(GroupMsg)?).

%% The offers the responders carry: the question the pending reduction poses.
ColdCallOffer         ::= offer(Constant).
IntroOffer            ::= offer(Constant).
ChildIntroOffer       ::= offer(Constant).
GroupInviteOffer      ::= offer(GroupId).
GroupInviteChildOffer ::= offer(GroupId, Constant).
ConsentOffer          ::= offer(Constant, GroupId).
EnrolOffer            ::= offer(Constant).
ReleaseOffer          ::= offer(Constant).

%% =============================================================================
%% RESPONDERS — one goal per arriving offer; the volition-guarded clauses live
%% here, so offers pend concurrently and are answered in any order.
%% =============================================================================

procedure respond_coldcall(ColdCallOffer?, Response, Stream(UserInMsg)).

%% Accept a friend offer.
*(Answer=yes, From?)
respond_coldcall(offer(From), Resp?, [decision(Answer?, From?, response(Resp))]) :-
    ground(From?) | true.

%% Decline.
*(Answer=no, From?)
respond_coldcall(offer(From), Resp?, [decision(Answer?, From?, response(Resp))]) :-
    ground(From?) | true.

procedure respond_intro(Constant?, IntroOffer?, Channel(Stream(IntroContent), Stream(IntroContent))?, Stream(UserInMsg)).

%% Accept an introduction: ack on the setup channel, await the peer, inject
%% the result.
*(Answer=yes, Other?)
respond_intro(Id, offer(Other), Ch, Ans?) :-
    ground(Id?), ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, [], Ans).

%% Reject: nack on the setup channel, closing it.
*(Answer=no, Other?)
respond_intro(_, offer(Other), ch(_ChIn, [nack|[]]), []) :-
    ground(Other?) | true.

procedure respond_child_intro(Constant?, ChildIntroOffer?, Channel(Stream(IntroContent), Stream(IntroContent))?, Stream(UserInMsg)).

%% Accept (as the introduced child's counterpart): ack on the setup channel,
%% await the peer, inject the result.
*(Answer=yes, Other?)
respond_child_intro(Id, offer(Other), Ch, Ans?) :-
    ground(Id?), ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, [], Ans).

%% Reject: nack on the setup channel, closing it.
*(Answer=no, Other?)
respond_child_intro(_, offer(Other), ch(_ChIn, [nack|[]]), []) :-
    ground(Other?) | true.

%% Approve (as a parent): forward the introduction to the named own child.
*(MyChild, OtherChild?)
respond_child_intro(_, offer(OtherChild), Ch,
    [approve_child_intro(OtherChild?, MyChild?, Ch?)]) :-
    ground(OtherChild?), ground(MyChild?) | true.

procedure respond_group_invite(Constant?, GroupInviteOffer?, Channel(Stream(GroupSetupResponse), Stream(Handshake))?, Stream(UserInMsg)).

%% Accept: ack on the setup channel, hand the read side to the agent to await
%% the group channel from the hub.
*(Answer=yes, GroupId?)
respond_group_invite(Id, offer(GroupId), ch(ChRead, [ack(Id?)|[]]),
    [accept_group(GroupId?, ChRead?)]) :-
    ground(Id?), ground(GroupId?) | true.

%% Reject: nack on the setup channel, closing it.
*(Answer=no, GroupId?)
respond_group_invite(_, offer(GroupId), ch(_ChRead, [nack|[]]), []) :-
    ground(GroupId?) | true.

procedure respond_group_invite_child(GroupInviteChildOffer?, Channel(Stream(IntroContent), Stream(GroupSetupResponse))?, Stream(UserInMsg)).

%% Approve: forward the invite to the child.
*(Answer=yes, GroupId?, Child?)
respond_group_invite_child(offer(GroupId, Child), Ch,
    [approve_group(Child?, GroupId?, Ch?)]) :-
    ground(GroupId?), ground(Child?) | true.

%% Reject: nack on the setup channel, closing it.
*(Answer=no, GroupId?, Child?)
respond_group_invite_child(offer(GroupId, Child), ch(_ChRead, [nack|[]]), []) :-
    ground(GroupId?) | true.

procedure respond_child_consent(ConsentOffer?, Decision).

%% Grant the child's consent request.
*(Answer=yes, Child?, GroupId?)
respond_child_consent(offer(Child, GroupId), Answer?) :-
    ground(Child?), ground(GroupId?) | true.

%% Refuse.
*(Answer=no, Child?, GroupId?)
respond_child_consent(offer(Child, GroupId), Answer?) :-
    ground(Child?), ground(GroupId?) | true.

%% =============================================================================
%% AGENT/4
%% =============================================================================

%% An enrolment offered to this person.  Accepting allocates the parent-child
%% channel and conveys the parent's end; the escrowed writer is the answer the
%% enrolling parent is waiting on.  Compiled form: the mediator's enrol_offer
%% card and the UserCmd enrol_decision/3.
procedure respond_enrol(Constant?, EnrolOffer?, EnrolResponse, Stream(UserInMsg)).

%% Accept: become this person's child.  The reduction that follows is the
%% child agent's, which is a separate program and not part of this exhibit.
*(Answer=yes, Parent?)
respond_enrol(Id, offer(Parent), enrol_accept(ParentEnd?),
              [enrol_accepted(Parent?, ch(FromParent, ToParent?))]) :-
    ground(Id?), ground(Parent?), new_channel(ParentEnd, ch(FromParent, ToParent?)) | true.

%% Decline.
*(Answer=no, Parent?)
respond_enrol(_, offer(Parent), enrol_no, []) :-
    ground(Parent?) | true.

%% A child of this person's asking to be released.  The parent owes the answer,
%% and a refusal is an act not taken: the declining clause has no body, so
%% nothing records it.  Compiled form: the mediator's release_asked card and the
%% UserCmd approve_release/1.
procedure respond_release(ReleaseOffer?, Stream(UserInMsg)).

%% Grant the release.
*(Answer=yes, Child?)
respond_release(offer(Child), [approve_release(Child?)]) :-
    ground(Child?) | true.

%% Withhold it.
*(Answer=no, Child?)
respond_release(offer(Child), []) :-
    ground(Child?) | true.

procedure agent(Constant?, AgentState?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?).

%% --- Volitional: becoming a parent ---

%% Offer to become a parent of another party.  The act asks nothing of either
%% beyond the first not being a parent of the second already, so the clause has
%% no precondition on my own state: a party that is itself a child may will it.
%% The two have no channel between them yet — creating it is what the act does —
%% so the offer goes by cold call.
*(Child)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Child?) |
    send_net(msg(Child?, enrol(Id?, Resp)), Outs?, Outs1),
    inject_enrol_response(Resp?, Child?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs1?).

%% --- Volitional: social transactions the person originates ---
%% Request clauses, perpetually pending; each willing supplies the parameters.
%% Compiled form: UserCmds connect/1, send/2, introduce/2, child_introduce/3,
%% unfriend_child_of/2.

%% Offer friendship by cold call.  Befriending requires both parties to hold no
%% parent, and a party holding none is exactly a party running this program, so
%% the clause needs no test of my own state.
*(Target)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Target?) |
    send_net(msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs1?).

%% Message a friend.
*(Target, Text)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Target?) |
    send_friend(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% Offer an introduction of friend P to friend Q: a fresh setup-channel pair,
%% one half to each.
*(P, Q)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    send_friend(P?, msg(Id?, P?, intro(Q?, QPCh?)), Outs?, Outs1),
    send_friend(Q?, msg(Id?, Q?, intro(P?, PQCh?)), Outs1?, Outs2),
    agent(Id?, St?, UserIn?, NetIn?, Outs2?).

%% Introduce own children to each other (sibling case: Friend is myself).
*(Child1, Friend, Child2)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), Friend? =?= Id?, ground(Child1?), ground(Child2?),
    new_channel(C1Ch, C2Ch) |
    send_child(Child1?, msg(Id?, Child1?, child_intro(Child2?, C1Ch?)), Outs?, Outs1),
    send_child(Child2?, msg(Id?, Child2?, child_intro(Child1?, C2Ch?)), Outs1?, Outs2),
    agent(Id?, St?, UserIn?, NetIn?, Outs2?).

%% Introduce own child to a friend's child (non-sibling case; the deployed
%% dispatch uses `otherwise`, here the explicit negation — remark "Ordering
%% with otherwise": between volition-guarded siblings, otherwise is replaced
%% by explicit complementary guards).
*(MyChild, Friend, FriendChild)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(MyChild?), ground(Friend?), ground(FriendChild?),
    ~(Friend? =?= Id?), new_channel(C1Ch, C2Ch) |
    send_child(MyChild?, msg(Id?, MyChild?, child_intro(FriendChild?, C1Ch?)), Outs?, Outs1),
    send_friend(Friend?, msg(Id?, Friend?, child_intro(MyChild?, C2Ch?)), Outs1?, Outs2),
    agent(Id?, St?, UserIn?, NetIn?, Outs2?).

%% End a friendship of a child of mine: tell the child to unfriend Target.  My
%% approvals name nobody, so I hold no record of whom my child befriended and
%% there is nothing to look up: any parent of either child may end any friendship
%% of that child, whether or not it approved it.
*(MyChild, Target)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(MyChild?), ground(Target?) |
    send_child(MyChild?, msg(Id?, MyChild?, unfriend_child(Target?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% --- Volitional: group transactions the person originates ---
%% Request clauses, perpetually pending; each willing supplies the parameters.
%% Compiled form: UserCmds create_group/1, invite_group/2, invite_group/3,
%% send_group/2, leave_group/1, leave_child_group/2, remove_from_group/2.

%% Create a group — creator sets up the member-side write (no hub self-loop).
*(Name)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Name?) |
    setup_group_creator(group_id(Id?, Name?),
        Outs?, Outs1, NetIn?, NetIn1),
    send_user(msg(agent, person, group_joined(group_id(Id?, Name?))),
        Outs1?, Outs2),
    agent(Id?, St?, UserIn?, NetIn1?, Outs2?).

%% Offer group membership to a friend.
*(GroupId, Invitee)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Invitee?),
    new_channel(InviteeCh, CreatorCh) |
    send_friend(Invitee?,
        msg(Id?, Invitee?, group_invite(GroupId?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Invitee?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs1?).

%% Offer group membership to a friend's child, via the parent.
*(GroupId, Child, Parent)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Child?), ground(Parent?),
    new_channel(InviteeCh, CreatorCh) |
    send_friend(Parent?,
        msg(Id?, Parent?, group_invite_child(GroupId?, Child?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Child?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs1?).

%% Post to a group — send on the member-to-hub channel.
*(GroupId, Text)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Text?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_msg(GroupId?, Id?, Text?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% Leave a group (member's own choice).
*(GroupId)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_leave(GroupId?, Id?)), Outs?, Outs1),
    close_output(group(GroupId?), Outs1?, Outs2),
    send_user(msg(agent, person, group_left(GroupId?)), Outs2?, Outs3),
    agent(Id?, St?, UserIn?, NetIn?, Outs3?).

%% Tell own child to leave a group.
*(Child, GroupId)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(Child?), ground(GroupId?) |
    send_child(Child?, msg(Id?, Child?, leave_group(GroupId?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% Remove a member from an owned group.
*(GroupId, Member)
agent(Id, St, UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Member?) |
    lookup_send_group(group_member(GroupId?, Member?),
        msg(Id?, Member?, group_removed(GroupId?)), Outs?, Outs1),
    close_output(group_member(GroupId?, Member?), Outs1?, Outs2),
    agent(Id?, St?, UserIn?, NetIn?, Outs2?).

%% --- Reactive: network messages — arriving offers spawn responders ---

%% A peer cold-calls me: spawn a responder — the offer pends until the person
%% answers; the answer is merged into UserIn.
agent(Id, St, UserIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_coldcall(offer(From?), Resp, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs?).

%% Another party offers to become my parent: spawn a responder likewise.
agent(Id, St, UserIn, [msg(Id1, enrol(Parent, Resp?))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_enrol(Id?, offer(Parent?), Resp, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs?).

%% A child of mine asks to be released: spawn a responder.  The obligation to
%% answer it is the parent's, not the protocol's.
agent(Id, St, UserIn, [msg(Child, Id1, release_request)|NetIn], Outs) :-
    Id? =?= Id1?, ground(Child?) |
    respond_release(offer(Child?), Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs?).

%% A friendship or membership of a child of mine has been established: alpha_p
%% advances.  The count arrives at the commit rather than at my own step, so no
%% approval of mine stands for an act that was never carried out, and it names
%% nobody.  Unguarded: my will was given when I approved.
agent(Id, state(Al, Om, Ps, Sn), UserIn, [msg(_, Id1, approval)|NetIn], Outs) :-
    Id? =?= Id1? |
    Al1 := Al? + 1,
    agent(Id?, state(Al1?, Om?, Ps?, Sn?), UserIn?, NetIn?, Outs?).

%% One has ended: omega_p advances.
agent(Id, state(Al, Om, Ps, Sn), UserIn, [msg(_, Id1, withdrawal)|NetIn], Outs) :-
    Id? =?= Id1? |
    Om1 := Om? + 1,
    agent(Id?, state(Al?, Om1?, Ps?, Sn?), UserIn?, NetIn?, Outs?).

%% A common friend offers an introduction: spawn a responder likewise.
agent(Id, St, UserIn, [msg(_From, Id1, intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_intro(Id?, offer(Other?), Ch?, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs?).

%% A child introduction arrives: spawn a responder — accept, reject, or, as a
%% parent, approve by naming the own child.
agent(Id, St, UserIn, [msg(_From, Id1, child_intro(OtherChild, Ch))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_child_intro(Id?, offer(OtherChild?), Ch?, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs?).

%% A group invite arrives: spawn a responder.
agent(Id, St, UserIn, [msg(_From, Id1, group_invite(GroupId, Ch))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_group_invite(Id?, offer(GroupId?), Ch?, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs?).

%% A group invite for my child arrives: spawn a responder.
agent(Id, St, UserIn, [msg(_From, Id1, group_invite_child(GroupId, Child, Ch))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_group_invite_child(offer(GroupId?, Child?), Ch?, Ans),
    merge(Ans?, UserIn?, UserIn1),
    agent(Id?, St?, UserIn1?, NetIn?, Outs?).

%% My child requests consent: spawn a responder — the chosen clause binds the
%% consent writer directly.
agent(Id, St, UserIn, [msg(Child, Id1, group_consent_req(GroupId, Consent?))|NetIn], Outs) :-
    Id? =?= Id1? |
    respond_child_consent(offer(Child?, GroupId?), Consent),
    agent(Id?, St?, UserIn?, NetIn?, Outs?).

%% A peer answered my cold call.
agent(Id, St, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs) :-
    Id? =?= Id1? |
    handle_response(Id?, Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, St?, UserIn?, NetIn1?, Outs1?).

%% A friend messages me.
agent(Id, St, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs) :-
    Id? =?= Id1? |
    send_user(msg(agent, person, received(From?, Text?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% A group message arrives on a group channel — hold it, distribute to the
%% members on the list now, and show it to the person.  Holding it is what makes
%% it deliverable to a member that joins later.
agent(Id, state(Al, Om, Ps, Sn), UserIn, [msg(_, _, group_msg(GroupId, Author, Text))|NetIn], Outs) :-
    ground(Id?), ground(GroupId?), ground(Author?), ground(Text?) |
    add_post(post(GroupId?, Author?, Text?), Ps?, Ps1),
    distribute_group_msg(GroupId?,
        msg(Author?, Author?, group_msg(GroupId?, Author?, Text?)), Sn?, Sn1, Outs?, Outs1),
    send_user(msg(agent, person, group_received(GroupId?, Author?, Text?)),
        Outs1?, Outs2),
    agent(Id?, state(Al?, Om?, Ps1?, Sn1?), UserIn?, NetIn?, Outs2?).

%% A member left my group — close their hub-side entry.
agent(Id, St, UserIn, [msg(Member, _, group_leave(GroupId, Member1))|NetIn], Outs) :-
    ground(Id?), ground(GroupId?), ground(Member?), Member? =?= Member1? |
    close_output(group_member(GroupId?, Member?), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% The creator removed me from a group — close my member entry, tell the person.
agent(Id, St, UserIn, [msg(_, Id1, group_removed(GroupId))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    close_output(group(GroupId?), Outs?, Outs1),
    send_user(msg(agent, person, group_removed(GroupId?)), Outs1?, Outs2),
    agent(Id?, St?, UserIn?, NetIn?, Outs2?).

%% A friend unfriended me (Integrate unfriend): comply — tear down my side and
%% tell the person the friend is gone.
agent(Id, St, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs) :-
    Id? =?= Id1?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    send_user(msg(agent, person, unfriended(From?)), Outs1?, Outs2),
    agent(Id?, St?, UserIn?, NetIn?, Outs2?).

%% --- Reactive: responder answers and injected results on UserIn (UserIn does
%% not carry the person's commands — those are grants; it carries the answers
%% the responders inject and the results injected by inject_msg,
%% inject_intro_result, inject_group_result) ---

%% The person answered a friend offer (injected by respond_coldcall).
agent(Id, St, [decision(Dec, From, response(Resp?))|UserIn], NetIn, Outs) :-
    ground(Id?) |
    bind_response(Id?, Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, St?, UserIn?, NetIn1?, Outs1?).

%% The person approved a child introduction (injected by respond_child_intro):
%% forward it to the named own child.
agent(Id, St, [approve_child_intro(OtherChild, MyChild, Ch)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(OtherChild?), ground(MyChild?) |
    send_child(MyChild?, msg(Id?, MyChild?, child_intro(OtherChild?, Ch?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% The person accepted a group invite (injected by respond_group_invite):
%% await the group channel from the hub.
agent(Id, St, [accept_group(GroupId, ChRead)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(GroupId?) |
    await_group_channel(Id?, GroupId?, ChRead?, UserIn?, NetIn?, Outs?).

%% The person approved a group invite for their child (injected by
%% respond_group_invite_child): forward the invite to the child.
agent(Id, St, [approve_group(Child, GroupId, Ch)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Child?), ground(GroupId?) |
    send_child(Child?, msg(Id?, Child?, group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% My cold call was answered (injected by inject_msg).
agent(Id, St, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    handle_response(Id?, Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, St?, UserIn?, NetIn1?, Outs1?).

%% Intro result: peer acked — idempotent befriend commit (shared lib).
agent(Id, St, [intro_result(Other, Ch)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Other?) |
    befriend_commit(Id?, Other?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, St?, UserIn?, NetIn1?, Outs1?).

%% Intro result: peer nacked — notify rejected.
agent(Id, St, [intro_rejected(Other)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user(msg(agent, person, rejected(Other?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% Injected group_join_ack — creator wires the hub side and writes on it every
%% post of the group it holds, which the joiner is owed, then tells the person.
agent(Id, state(Al, Om, Ps, Sn), [group_join_ack(GroupId, Invitee, ch(_, [group_channel(MemberEnd?)|[]]))|UserIn],
        NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    setup_group_hub_side(GroupId?, Invitee?, Ps?, Ps1, Sn?, Sn1, Outs?, Outs1, NetIn?, NetIn1, MemberEnd),
    send_user(msg(agent, person, group_joined_member(GroupId?, Invitee?)),
        Outs1?, Outs2),
    agent(Id?, state(Al?, Om?, Ps1?, Sn1?), UserIn?, NetIn1?, Outs2?).

%% Injected group_join_nack — nothing to clean up.
agent(Id, St, [group_join_nack(_, _)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    agent(Id?, St?, UserIn?, NetIn?, Outs?).

%% --- Termination ---

%% --- Reactive: the enrolment and release answers, on UserIn ---

%% My own acceptance of an enrolment, from respond_enrol.  rho_r gains the
%% parent, and this agent is thereafter the child agent — a separate program,
%% and the one point at which this exhibit hands over.
agent(Id, St, [enrol_accepted(Parent, ch(FromParent, ToParent?))|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Parent?) |
    add_parent_output(Parent?, ToParent, Outs?, Outs1),
    send_user(msg(agent, person, enrolled(Parent?)), Outs1?, Outs2),
    merge(NetIn?, FromParent?, NetIn1),
    child_agent(Id?, Parent?, St?, UserIn?, NetIn1?, Outs2?).

%% The party I offered to enrol accepted: adopt the channel it conveyed.
%% kappa_p gains it.
agent(Id, St, [enrol_response(Child, enrol_accept(Ch))|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Child?) |
    enrol_commit(Child?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, St?, UserIn?, NetIn1?, Outs1?).

%% It declined.
agent(Id, St, [enrol_response(Child, enrol_no)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user(msg(agent, person, rejected(Child?)), Outs?, Outs1),
    agent(Id?, St?, UserIn?, NetIn?, Outs1?).

%% My ending of the parenting, from respond_release: grant it on the parent-child
%% channel, then tear the channel down.  kappa_p loses the child.
agent(Id, St, [approve_release(Child)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Child?) |
    send_child(Child?, msg(Id?, Child?, release_grant), Outs?, Outs1),
    close_child(Child?, Outs1?, Outs2),
    send_user(msg(agent, person, released(Child?)), Outs2?, Outs3),
    agent(Id?, St?, UserIn?, NetIn?, Outs3?).

agent(_, _, [], _, Outs) :- close_outputs(Outs?).
agent(_, _, _, [], Outs) :- close_outputs(Outs?).
