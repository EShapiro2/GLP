%% ---------------------------------------------------------------------------
%% CSSN.glp --- the child-safe social network, CSSN's (Udi, 2026-10-18;
%% Coordination, to_all 2026-10-18 19:23 UTC), in the term form programs/gsc
%% reads (its README, "Writing a contract"), for programs/vglp/cva/compiler to
%% compile into its canonical CVA platform (CSSN, Section 6.1, "The program";
%% Appendix C.5).  compile.sh beside this file has GSC's checker give its
%% verdict and then runs the compiler on it.  The clauses are in CSSN.md
%% beside this file; CSSN extends GSNP and Wards, GSC's, so the term holds
%% GSNP's twelve schemas (programs/gsc/GSNP.glp), with child forbidden at both
%% roles of befriend and at the joiner's role of join, and eleven schemas for
%% children, which realise Wards (CSSN, Appendix B.2; the tables in Appendix
%% C.2, sections/artefact-schemas.tex).  Written by CSSN #5 Cowork, 2026-10-18.
%%
%% Twenty-three schemas over thirteen predicates; friend is reflexive.  Every
%% role requires identity, except the role of establish, which adds it, and
%% the child's role of enter and enter_2, which forbid it and add it.  A
%% parent's role in the children's schemas, and the sender's in forward and
%% post, adds and deletes nothing: a guarding role may (GSC, Definition 2, at
%% GSC bd0ebc4; GSNP.glp at GLP e0be1bc2).  Each schema is in GSC's notation above its term, at each
%% role in turn: what the role requires, what it forbids (not), what it adds
%% (+) and what it deletes (-); a role marked ? is a guarding role.  A role is
%% rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i), and is
%% named by its index, role(1) the schema's first role; x, y and n are
%% speech-act variables, svar, and sgn(x, 1) is the signed term sgn(x, p), x
%% signed by the agent in role 1 (GSC, Definition 2).
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Schema    ::= schema(Constant, RoleSpecs) ; cschema(Constant, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(cssn, C): the contract, CSSN (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(cssn, reflexive([friend], C?)) :- cssn_schemas(C).

procedure cssn_schemas(Contract).
cssn_schemas(C?) :-
    gsnp_schemas(C1),
    children_schemas(C2),
    app(C1?, C2?, C).

procedure app(Contract?, Contract?, Contract).
app([], Ys, Ys?).
app([X|Xs], Ys, [X?|Zs?]) :- app(Xs?, Ys?, Zs).

%% GSNP's twelve schemas, as programs/gsc/GSNP.glp has them, with child
%% forbidden at both roles of befriend and at the joiner's role of join.
procedure gsnp_schemas(Contract).
gsnp_schemas([
%% GSG:1, Identity.
%%   establish(p?) :
%%       at p:  +identity
    schema(establish,
      [rs(guarded, [atom(identity, [])], [], [], [])]),
%% GSG:2, Friendship.
%%   befriend(p?, q?) :
%%       at p:  identity, not child, not friend(q), +friend(q)
%%       at q:  identity, not child, not friend(p), +friend(p)
    schema(befriend,
      [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                   [atom(child, []), atom(friend, [role(2)])]),
       rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                   [atom(child, []), atom(friend, [role(1)])])]),
%% GSG:3, Ending a friendship.
%%   unfriend(p?, q) :
%%       at p:  identity, -friend(q)
%%       at q:  identity, -friend(p)
    schema(unfriend,
      [rs(guarded,   [], [atom(friend, [role(2)])], [atom(identity, [])], []),
       rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
%% GSNP:1, Authorship.
%%   sign(p? ; x) :
%%       at p:  identity, +item(x)
    schema(sign,
      [rs(guarded, [atom(item, [svar(x)])], [], [atom(identity, [])], [])]),
%% GSN:1, Message, with GSNP:2, Forwarding.
%%   forward(p?, q ; x) :
%%       at p:  identity, item(x)
%%       at q:  identity, friend(p), +item(sgn(x, p))
    schema(forward,
      [rs(guarded,   [], [],
                     [atom(identity, []), atom(item, [svar(x)])], []),
       rs(unguarded, [atom(item, [sgn(x, 1)])], [],
                     [atom(identity, []), atom(friend, [role(1)])], [])]),
%% GSN:2, Group.
%%   create(a? ; n) :
%%       at a:  identity, not member(a, n), not closed(n), +member(a, n), +listed(a, n)
    schema(create,
      [rs(guarded, [atom(member, [role(1), svar(n)]),
                    atom(listed, [role(1), svar(n)])], [], [atom(identity, [])],
                   [atom(member, [role(1), svar(n)]), atom(closed, [svar(n)])])]),
%% GSN:3, Joining.
%%   join(a?, q? ; n) :
%%       at a:  identity, member(a, n), friend(q), +listed(q, n)
%%       at q:  identity, not child, friend(a), not member(a, n), +member(a, n)
    schema(join,
      [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                   [atom(identity, []), atom(member, [role(1), svar(n)]), atom(friend, [role(2)])], []),
       rs(guarded, [atom(member, [role(1), svar(n)])], [],
                   [atom(identity, []), atom(friend, [role(1)])],
                   [atom(child, []), atom(member, [role(1), svar(n)])])]),
%% GSN:4, Leaving: a member leaves; the leader leaving ends the group.
%%   leave(a, q? ; n) :
%%       at a:  identity, -listed(q, n)
%%       at q:  identity, -member(a, n)
    schema(leave,
      [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], []),
       rs(guarded,   [], [atom(member, [role(1), svar(n)])], [atom(identity, [])], [])]),
%%   close(a? ; n) :
%%       at a:  identity, +closed(n), -member(a, n), -listed(a, n)
    schema(close,
      [rs(guarded, [atom(closed, [svar(n)])],
                   [atom(member, [role(1), svar(n)]),
                    atom(listed, [role(1), svar(n)])], [atom(identity, [])], [])]),
%% GSN:5, Group message, with GSNP:2.
%%   post_own(a? ; x, n) :
%%       at a:  identity, item(x), member(a, n), not posted(x, n), +posted(x, n)
    schema(post_own,
      [rs(guarded, [atom(posted, [svar(x), svar(n)])], [],
                   [atom(identity, []), atom(item, [svar(x)]), atom(member, [role(1), svar(n)])],
                   [atom(posted, [svar(x), svar(n)])])]),
%%   post(p?, a ; x, n) :
%%       at p:  identity, item(x), member(a, n)
%%       at a:  identity, member(a, n), listed(p, n), +posted(sgn(x, p), n)
    schema(post,
      [rs(guarded,   [], [],
                     [atom(identity, []), atom(item, [svar(x)]), atom(member, [role(2), svar(n)])], []),
       rs(unguarded, [atom(posted, [sgn(x, 1), svar(n)])], [],
                     [atom(identity, []), atom(member, [role(2), svar(n)]),
                      atom(listed, [role(1), svar(n)])], [])]),
%%   deliver(a, q ; y, n) :
%%       at a:  identity, member(a, n), posted(y, n), listed(q, n), not delivered(y, q, n), +delivered(y, q, n)
%%       at q:  identity, member(a, n), +item(sgn(y, a))
    schema(deliver,
      [rs(unguarded, [atom(delivered, [svar(y), role(2), svar(n)])], [],
                     [atom(identity, []), atom(member, [role(1), svar(n)]),
                      atom(posted, [svar(y), svar(n)]),
                      atom(listed, [role(2), svar(n)])],
                     [atom(delivered, [svar(y), role(2), svar(n)])]),
       rs(unguarded, [atom(item, [sgn(y, 1)])], [],
                     [atom(identity, []), atom(member, [role(1), svar(n)])], [])])]).

%% The eleven schemas for children, realising Wards with CSSN:1 to CSSN:3.
procedure children_schemas(Contract).
children_schemas([
%% CSSN:1, Parents, with Wards:1.
%%   enter(p?, r?) :
%%       at p:  identity, not child, +parenting(r), +friend(r)
%%       at r:  not identity, +identity, +parent(p), +child, +friend(p)
    schema(enter,
      [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                   [atom(identity, [])], [atom(child, [])]),
       rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                    atom(friend, [role(1)])], [],
                   [], [atom(identity, [])])]),
%%   enter_2(p?, q?, r?) :
%%       at p:  identity, not child, +parenting(r), +coparent(q), +friend(r)
%%       at q:  identity, not child, +parenting(r), +coparent(p), +friend(r)
%%       at r:  not identity, +identity, +parent(p), +parent(q), +child, +child, +coparented, +friend(p), +friend(q)
    schema(enter_2,
      [rs(guarded, [atom(parenting, [role(3)]), atom(coparent, [role(2)]),
                    atom(friend, [role(3)])], [],
                   [atom(identity, [])], [atom(child, [])]),
       rs(guarded, [atom(parenting, [role(3)]), atom(coparent, [role(1)]),
                    atom(friend, [role(3)])], [],
                   [atom(identity, [])], [atom(child, [])]),
       rs(guarded, [atom(identity, []), atom(parent, [role(1)]),
                    atom(parent, [role(2)]), atom(child, []), atom(child, []),
                    atom(coparented, []), atom(friend, [role(1)]),
                    atom(friend, [role(2)])], [],
                   [], [atom(identity, [])])]),
%% CSSN:3, Coming of age, with Wards:4.
%%   of_age(p?, r) :
%%       at p:  identity, -parenting(r)
%%       at r:  identity, not coparented, -parent(p), -child
    schema(of_age,
      [rs(guarded, [], [atom(parenting, [role(2)])], [atom(identity, [])], []),
       rs(unguarded, [], [atom(parent, [role(1)]), atom(child, [])],
                     [atom(identity, [])], [atom(coparented, [])])]),
%%   of_age_2(p?, q, r) :
%%       at p:  identity, -parenting(r), -coparent(q)
%%       at q:  identity, -parenting(r), -coparent(p)
%%       at r:  identity, -parent(p), -parent(q), -child, -child, -coparented
    schema(of_age_2,
      [rs(guarded, [], [atom(parenting, [role(3)]), atom(coparent, [role(2)])],
                   [atom(identity, [])], []),
       rs(unguarded, [], [atom(parenting, [role(3)]), atom(coparent, [role(1)])],
                     [atom(identity, [])], []),
       rs(unguarded, [], [atom(parent, [role(1)]), atom(parent, [role(2)]),
                          atom(child, []), atom(child, []), atom(coparented, [])],
                     [atom(identity, [])], [])]),
%% CSSN:2, Friendship of a child, with Wards:2.
%%   child_befriend(r?, s?, p?, q?) :
%%       at r:  identity, child, parent(p), not friend(s), +friend(s)
%%       at s:  identity, child, parent(q), not friend(r), +friend(r)
%%       at p:  identity, not child, parenting(r), friend(q)
%%       at q:  identity, not child, parenting(s), friend(p)
    schema(child_befriend,
      [rs(guarded, [atom(friend, [role(2)])], [],
                   [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                   [atom(friend, [role(2)])]),
       rs(guarded, [atom(friend, [role(1)])], [],
                   [atom(identity, []), atom(child, []), atom(parent, [role(4)])],
                   [atom(friend, [role(1)])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                   [atom(child, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)]), atom(friend, [role(3)])],
                   [atom(child, [])])]),
%%   child_adult_befriend(r?, a?, p?) :
%%       at r:  identity, child, parent(p), not friend(a), +friend(a)
%%       at a:  identity, not child, not friend(r), +friend(r)
%%       at p:  identity, not child, parenting(r), friend(a)
    schema(child_adult_befriend,
      [rs(guarded, [atom(friend, [role(2)])], [],
                   [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                   [atom(friend, [role(2)])]),
       rs(guarded, [atom(friend, [role(1)])], [],
                   [atom(identity, [])],
                   [atom(child, []), atom(friend, [role(1)])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                   [atom(child, [])])]),
%% Wards:3, Ending a Relation, for a friendship.
%%   child_unfriend(r, s, p?) :
%%       at r:  identity, child, parent(p), -friend(s)
%%       at s:  identity, -friend(r)
%%       at p:  identity, not child, parenting(r)
    schema(child_unfriend,
      [rs(unguarded, [], [atom(friend, [role(2)])],
                     [atom(identity, []), atom(child, []), atom(parent, [role(3)])], []),
       rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], []),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)])], [atom(child, [])])]),
%% Wards:2, Relations, for a membership.
%%   child_join(a?, s?, p? ; n) :
%%       at a:  identity, not child, member(a, n), friend(s), +listed(s, n)
%%       at s:  identity, child, parent(p), friend(a), not member(a, n), +member(a, n)
%%       at p:  identity, not child, parenting(s)
    schema(child_join,
      [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                   [atom(identity, []), atom(member, [role(1), svar(n)]), atom(friend, [role(2)])],
                   [atom(child, [])]),
       rs(guarded, [atom(member, [role(1), svar(n)])], [],
                   [atom(identity, []), atom(child, []), atom(parent, [role(3)]),
                    atom(friend, [role(1)])],
                   [atom(member, [role(1), svar(n)])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)])], [atom(child, [])])]),
%%   child_join_2(r?, s?, p?, q? ; n) :
%%       at r:  identity, child, member(r, n), friend(s), parent(p), +listed(s, n)
%%       at s:  identity, child, parent(q), friend(r), not member(r, n), +member(r, n)
%%       at p:  identity, not child, parenting(r)
%%       at q:  identity, not child, parenting(s)
    schema(child_join_2,
      [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                   [atom(identity, []), atom(child, []), atom(member, [role(1), svar(n)]),
                    atom(friend, [role(2)]), atom(parent, [role(3)])], []),
       rs(guarded, [atom(member, [role(1), svar(n)])], [],
                   [atom(identity, []), atom(child, []), atom(parent, [role(4)]),
                    atom(friend, [role(1)])],
                   [atom(member, [role(1), svar(n)])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)])], [atom(child, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)])], [atom(child, [])])]),
%% Wards:3, Ending a Relation, for a membership.
%%   child_leave(a, s, p? ; n) :
%%       at a:  identity, -listed(s, n)
%%       at s:  identity, child, parent(p), -member(a, n)
%%       at p:  identity, not child, parenting(s)
    schema(child_leave,
      [rs(unguarded, [], [atom(listed, [role(2), svar(n)])],
                     [atom(identity, [])], []),
       rs(unguarded, [], [atom(member, [role(1), svar(n)])],
                     [atom(identity, []), atom(child, []), atom(parent, [role(3)])], []),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)])], [atom(child, [])])]),
%%   child_close(r, p? ; n) :
%%       at r:  identity, child, parent(p), -member(r, n), -listed(r, n), +closed(n)
%%       at p:  identity, not child, parenting(r)
    schema(child_close,
      [rs(unguarded, [atom(closed, [svar(n)])],
                     [atom(member, [role(1), svar(n)]), atom(listed, [role(1), svar(n)])],
                     [atom(identity, []), atom(child, []), atom(parent, [role(2)])], []),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)])], [atom(child, [])])])]).
