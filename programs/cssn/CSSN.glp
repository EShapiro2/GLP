%% ---------------------------------------------------------------------------
%% CSSN.glp --- the child-safe social network, CSSN's, in the term form programs/gsc reads (its README, "Writing a contract"), for programs/vglp/cva/compiler to compile into its canonical CVA platform (CSSN, Section 4.6.1).  The clauses are in CSSN.txt beside this file.  CSSN extends GSN, GSC's, and through it GSG and GKK, and GnW, GAI's, its wards children and their guardians parents.
%% 2026-10-30, to Udi's revision of the contracts in Coordination Appendix E, with the changes to GnW agreed with GAI (GAI #10, CSSN_inbox 11:37 UTC; CSSN #13's changes 2 to 6, GAI_inbox 11:29 to 11:48 UTC) and to CSSN that Udi approved (CSSN #13 Cowork).  GKK, GSG and GSN apply only to persons, so child is forbidden at both roles of acquaint, introduce, befriend, create and join, and a child acquaints, befriends, joins and creates a group by the schemas for children; a child messages, posts, leaves a group and ends a friendship by GSN's schemas (CSSN:5; GnW:3).  unfriend forbids at either role the creator or a parent of the other, the friendships GnW:1 and GnW:2 protect.  make_parent is an act of the creator and the adult, their friend, who becomes a guardian and a friend of the child (GnW:2); parent_unfriend ends a made parent's friendship with the child and their guardianship (GnW:2); retire is the creator ending their friendship with the child, which ends every guardianship and every friendship of the child, through the listed role of the child's friends, and every membership then ends by the leader's drop (GnW:5; GAI #10); child_acquaint_2 and child_befriend require that each parent know the other child (GnW:4), child_join that the child's parent be a friend of the leader (GnW:3), and child_join_2 that each parent know the other child and be a friend of the other parent (GnW:4); child_create is a child's creating a group with a parent's consent (CSSN:2).  Thirty-one schemas over sixteen predicates; friend and knows are reflexive.  Every role requires identity, except the role of establish and the child's role of enter, which forbid it and add it; every guarding role forbids retired, and so does the leader's role of post and deliver.  The guardianship is (child, identity, creator, created, parenting).  The history before this is in git.
%%
%% This term is the one source of the schemas: a run of the cascade prints their notation from it as schemas.txt (cascade.sh, programs/gsc/notation.glp).  Each comment below names the clause a schema realises.
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant)
            ; listed(Integer, Constant, Args).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Name      ::= Constant ; one(Constant, Constant).
Names     ::= [] ; [Name | Names].
Schema    ::= schema(Constant, Names, Args, RoleSpecs) ; cschema(Constant, Names, Args, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(cssn, C): the contract, CSSN (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(cssn, reflexive([friend, knows], C?)) :- cssn_schemas(C).

%% introduction_named(cssn, I): the contract's introduction predicate, knows, by which an agent introduces to each other, at the level of the machines, every two agents its person knows (CSSN, Section 4.6.1, "The program"; Appendix C.4; vGLP, Section 5.4, the paragraph on act schemas), in the form of programs/vglp/cva/contracts.glp.  Added by CSSN #8 Cowork, 2026-10-19, on Code #12's finding that the compiler printed introduction_preds([]), with friend; knows since GKK (CSSN #9 Cowork, 2026-10-20).
Intro ::= no_introduction ; introduction(Constant).
procedure introduction_named(Constant?, Intro).
introduction_named(cssn, introduction(knows)).

procedure cssn_schemas(Contract).
cssn_schemas(C?) :-
    gsn_schemas(C1),
    children_schemas(C2),
    app(C1?, C2?, C).

procedure app(Contract?, Contract?, Contract).
app([], Ys, Ys?).
app([X|Xs], Ys, [X?|Zs?]) :- app(Xs?, Ys?, Zs).

%% GSN's fifteen schemas, as programs/gsc/GSN.glp has them at GLP f1dcff63, with child forbidden at both roles of acquaint, introduce, befriend, create and join, the creator and a parent of the other forbidden at either role of unfriend, and retired at every guarding role.
procedure gsn_schemas(Contract).
gsn_schemas([
%% GKK:1, Identity.
    schema(establish, ['Alice'], [],
      [rs(guarded, [atom(identity, [])], [], [], [atom(identity, []), atom(retired, [])])]),
%% GKK:2, Acquaintance, for two persons.
    schema(acquaint, ['Alice', 'Bob'], [],
      [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])],
                   [atom(child, []), atom(retired, [])]),
       rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])],
                   [atom(child, []), atom(retired, [])])]),
%% GKK:3, Introduction, for two persons, with Bob's consent; the agent introduced, c, takes no part.
    schema(introduce, ['Alice', 'Bob'], [pvar(c)],
      [rs(guarded, [], [],
                   [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])],
                   [atom(child, []), atom(retired, [])]),
       rs(guarded, [atom(knows, [pvar(c)])], [],
                   [atom(identity, []), atom(knows, [role(1)])],
                   [atom(child, []), atom(retired, [])])]),
%% GSG:1, Friendship, for two persons who know each other.
    schema(befriend, ['Alice', 'Bob'], [],
      [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(knows, [role(2)])],
                   [atom(child, []), atom(friend, [role(2)]), atom(retired, [])]),
       rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(knows, [role(1)])],
                   [atom(child, []), atom(friend, [role(1)]), atom(retired, [])])]),
%% GSG:2, Ending a friendship, and GnW:3 for a child, but for the friendships GnW:1 and GnW:2 protect.
    schema(unfriend, ['Alice', 'Bob'], [],
      [rs(guarded,   [], [atom(friend, [role(2)])], [atom(identity, [])],
                     [atom(creator, [role(2)]), atom(parenting, [role(2)]), atom(retired, [])]),
       rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])],
                     [atom(creator, [role(1)]), atom(parenting, [role(1)])])]),
%% GSN:1, Messaging, and CSSN:5 for a child.
    schema(message, ['Alice', 'Bob'], [svar(x)],
      [rs(guarded,   [], [], [atom(identity, []), atom(friend, [role(2)])], [atom(retired, [])]),
       rs(unguarded, [atom(received, [svar(x), role(1)])], [],
                     [atom(identity, [])], [])]),
%% GSN:2, Group, for a person.
    schema(create, ['Alice'], [svar(n)],
      [rs(guarded, [atom(member, [nterm(ext(own(1), n))]),
                    atom(listed, [role(1), svar(n)])], [], [atom(identity, [])],
                   [atom(child, []), atom(member, [nterm(ext(own(1), n))]), atom(closed, [svar(n)]), atom(retired, [])])]),
%% GSN:3, Joining and Leaving, for two persons; a child joins by child_join or child_join_2.
    schema(join, ['Alice', 'Bob'], [svar(n)],
      [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                   [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(friend, [role(2)])],
                   [atom(child, []), atom(retired, [])]),
       rs(guarded, [atom(member, [nterm(ext(own(1), n))])], [],
                   [atom(identity, [])],
                   [atom(child, []), atom(member, [nterm(ext(own(1), n))]), atom(retired, [])])]),
%% GSN:3, Bob ends their membership, and GnW:3 for a child.
    schema(leave, ['Alice', 'Bob'], [svar(n)],
      [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], []),
       rs(guarded,   [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [atom(retired, [])])]),
%% GSN:3, Alice, the leader, ends Bob's membership, and GnW:3 for a child.
    schema(remove, ['Alice', 'Bob'], [svar(n)],
      [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], [atom(retired, [])]),
       rs(unguarded, [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% GSN:2, the leader closes the group by leaving it: the listed role is every member the leader lists, the leader among them.
    cschema(close, ['Alice', 'Alice'], [svar(n)], [],
      [rs(guarded, [atom(closed, [svar(n)])],
                   [atom(listed, [role(1), svar(n)])], [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [atom(retired, [])]),
       crs(listed(1, listed, [svar(n)]), unguarded,
           [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% GSN:3, a membership ends when the member and the leader cease to be friends.
    schema(drop, ['Alice', 'Bob'], [svar(n)],
      [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], [atom(friend, [role(2)])]),
       rs(unguarded, [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% GSN:4, Group messaging, and CSSN:5 for a child: the leader's own, a member's sent to the leader, and the leader delivering it to every member.
    schema(post_own, ['Alice'], [svar(x), svar(n)],
      [rs(guarded, [atom(posted, [svar(x), svar(n)])], [],
                   [atom(identity, []), atom(member, [nterm(ext(own(1), n))])],
                   [atom(posted, [svar(x), svar(n)]), atom(retired, [])])]),
    schema(post, ['Bob', 'Alice'], [svar(x), svar(n)],
      [rs(guarded,   [], [],
                     [atom(identity, []), atom(member, [nterm(ext(own(2), n))])], [atom(retired, [])]),
       rs(unguarded, [atom(posted, [svar(x), svar(n)])], [],
                     [atom(identity, []), atom(member, [nterm(ext(own(2), n))]),
                      atom(listed, [role(1), svar(n)]), atom(friend, [role(1)])],
                     [atom(posted, [svar(x), svar(n)]), atom(retired, [])])]),
    schema(deliver, ['Alice', 'Bob'], [svar(x), svar(n)],
      [rs(unguarded, [atom(delivered, [svar(x), role(2), svar(n)])], [],
                     [atom(identity, []), atom(member, [nterm(ext(own(1), n))]),
                      atom(posted, [svar(x), svar(n)]),
                      atom(listed, [role(2), svar(n)]), atom(friend, [role(2)])],
                     [atom(delivered, [svar(x), role(2), svar(n)]), atom(retired, [])]),
       rs(unguarded, [atom(received_in, [svar(x), role(1), svar(n)])], [],
                     [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [])])]).

%% The sixteen schemas for children, realising GnW with CSSN:1 to CSSN:3; Alice is Carol's parent and Bob Dave's, or the adult in GnW:3.
procedure children_schemas(Contract).
children_schemas([
%% GnW:1, Creation, with CSSN:1, Parent: the creator, Alice, chooses Carol's key pair and becomes Carol's guardian and friend.
    schema(enter, ['Alice', 'Carol'], [],
      [rs(guarded, [atom(created, [role(2)]), atom(parenting, [role(2)]),
                    atom(friend, [role(2)]), atom(knows, [role(2)])], [],
                   [atom(identity, [])], [atom(child, []), atom(retired, [])]),
       rs(guarded, [atom(identity, []), atom(child, []), atom(creator, [role(1)]),
                    atom(friend, [role(1)]), atom(knows, [role(1)])], [],
                   [], [atom(identity, []), atom(retired, [])])]),
%% GnW:2, Joint guardianship: an act of Alice, the creator, and Bob, their friend, who becomes a guardian and a friend of Carol.
    schema(make_parent, ['Alice', 'Bob', 'Carol'], [],
      [rs(guarded, [atom(made, [role(2), role(3)])], [],
                   [atom(identity, []), atom(created, [role(3)]), atom(friend, [role(2)])],
                   [atom(child, []), atom(made, [role(2), role(3)]), atom(retired, [])]),
       rs(guarded, [atom(parenting, [role(3)]), atom(friend, [role(3)]), atom(knows, [role(3)])], [],
                   [atom(identity, []), atom(friend, [role(1)])],
                   [atom(child, []), atom(parenting, [role(3)]), atom(friend, [role(3)]), atom(retired, [])]),
       rs(unguarded, [atom(friend, [role(2)]), atom(knows, [role(2)])], [],
                     [atom(identity, []), atom(child, []), atom(creator, [role(1)])],
                     [atom(friend, [role(2)]), atom(retired, [])])]),
%% GnW:2, the creator ends Bob's guardianship.
    schema(end_parent, ['Alice', 'Bob'], [pvar(r)],
      [rs(guarded, [], [atom(made, [role(2), pvar(r)])],
                   [atom(identity, []), atom(created, [pvar(r)])], [atom(retired, [])]),
       rs(unguarded, [], [atom(parenting, [pvar(r)])],
                     [atom(identity, [])], [atom(created, [pvar(r)])])]),
%% GnW:2, Bob ends their guardianship by ending their friendship with Carol.
    schema(parent_unfriend, ['Bob', 'Carol', 'Alice'], [],
      [rs(guarded, [], [atom(parenting, [role(2)]), atom(friend, [role(2)])],
                   [atom(identity, [])], [atom(created, [role(2)]), atom(retired, [])]),
       rs(unguarded, [], [atom(friend, [role(1)])],
                     [atom(identity, []), atom(child, []), atom(creator, [role(3)])], []),
       rs(unguarded, [], [atom(made, [role(1), role(2)])],
                     [atom(identity, []), atom(created, [role(2)])], [])]),
%% CSSN:3, Coming of age: the creator declares Carol of age, which ends every guardianship of Carol, the friendships remaining.
    cschema(of_age, ['Alice', 'Carol', 'Alice'], [], [],
      [rs(guarded, [], [atom(created, [role(2)]), atom(parenting, [role(2)])],
                   [atom(identity, [])], [atom(retired, [])]),
       rs(unguarded, [], [atom(child, []), atom(creator, [role(1)])],
                     [atom(identity, [])], []),
       crs(listed(1, made, [role(2)]), unguarded,
           [], [atom(parenting, [role(2)])], [atom(identity, [])], [atom(created, [role(2)])])]),
%% GnW:5, Retiring: the creator ends their friendship with Carol, which ends every guardianship, through the listed role of the parents the creator made, and every friendship of Carol, through the listed role of Carol's friends, the creator among them; every membership of Carol then ends by the leader's drop.
    cschema(retire, ['Alice', 'Carol', 'Alice', 'Bob'], [], [],
      [rs(guarded, [], [atom(created, [role(2)]), atom(parenting, [role(2)]), atom(friend, [role(2)])],
                   [atom(identity, [])], [atom(retired, [])]),
       rs(unguarded, [atom(retired, [])], [atom(child, []), atom(creator, [role(1)])],
                     [atom(identity, [])], []),
       crs(listed(1, made, [role(2)]), unguarded,
           [], [atom(parenting, [role(2)])], [atom(identity, [])], [atom(created, [role(2)])]),
       crs(listed(2, friend, []), unguarded,
           [], [atom(friend, [role(2)])], [atom(identity, [])], [])]),
%% GnW:3, Ward and person: Carol comes to know Bob provided Alice knows Bob.
    schema(child_acquaint, ['Carol', 'Bob', 'Alice'], [],
      [rs(guarded, [atom(knows, [role(2)])], [],
                   [atom(identity, []), atom(child, [])], [atom(retired, [])]),
       rs(guarded, [atom(knows, [role(1)])], [],
                   [atom(identity, [])], [atom(child, []), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)]), atom(knows, [role(2)])],
                   [atom(child, []), atom(retired, [])])]),
%% GnW:4, Ward and ward: Carol and Dave come to know each other provided each parent knows the other child and the other parent.
    schema(child_acquaint_2, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
      [rs(guarded, [atom(knows, [role(2)])], [],
                   [atom(identity, []), atom(child, [])], [atom(retired, [])]),
       rs(guarded, [atom(knows, [role(1)])], [],
                   [atom(identity, []), atom(child, [])], [atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)]), atom(knows, [role(2)]), atom(knows, [role(4)])],
                   [atom(child, []), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)]), atom(knows, [role(1)]), atom(knows, [role(3)])],
                   [atom(child, []), atom(retired, [])])]),
%% GnW:4, Carol and Dave become friends provided they know each other and each parent knows the other child and is a friend of the other parent.
    schema(child_befriend, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
      [rs(guarded, [atom(friend, [role(2)])], [],
                   [atom(identity, []), atom(child, []), atom(knows, [role(2)])],
                   [atom(friend, [role(2)]), atom(retired, [])]),
       rs(guarded, [atom(friend, [role(1)])], [],
                   [atom(identity, []), atom(child, []), atom(knows, [role(1)])],
                   [atom(friend, [role(1)]), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)]), atom(knows, [role(2)]), atom(friend, [role(4)])],
                   [atom(child, []), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)]), atom(knows, [role(1)]), atom(friend, [role(3)])],
                   [atom(child, []), atom(retired, [])])]),
%% GnW:3, Carol and Bob become friends provided they know each other and Alice is a friend of Bob.
    schema(child_adult_befriend, ['Carol', 'Bob', 'Alice'], [],
      [rs(guarded, [atom(friend, [role(2)])], [],
                   [atom(identity, []), atom(child, []), atom(knows, [role(2)])],
                   [atom(friend, [role(2)]), atom(retired, [])]),
       rs(guarded, [atom(friend, [role(1)])], [],
                   [atom(identity, []), atom(knows, [role(1)])],
                   [atom(child, []), atom(friend, [role(1)]), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                   [atom(child, []), atom(retired, [])])]),
%% GnW:3, Alice ends Carol's friendship, but one GnW:2 protects.
    schema(child_unfriend, ['Carol', 'Bob', 'Alice'], [],
      [rs(unguarded, [], [atom(friend, [role(2)])],
                     [atom(identity, []), atom(child, [])], []),
       rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])],
                     [atom(parenting, [role(1)])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)])], [atom(child, []), atom(retired, [])])]),
%% GnW:3, Carol joins the group of Bob, their friend, provided Alice is a friend of Bob.
    schema(child_join, ['Bob', 'Carol', 'Alice'], [svar(n)],
      [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                   [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(friend, [role(2)])],
                   [atom(child, []), atom(retired, [])]),
       rs(guarded, [atom(member, [nterm(ext(own(1), n))])], [],
                   [atom(identity, []), atom(child, [])],
                   [atom(member, [nterm(ext(own(1), n))]), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)]), atom(friend, [role(1)])],
                   [atom(child, []), atom(retired, [])])]),
%% GnW:4 with CSSN:2, Dave joins the group of Carol, their friend, provided each parent knows the other child and is a friend of the other parent.
    schema(child_join_2, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [svar(n)],
      [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                   [atom(identity, []), atom(child, []), atom(member, [nterm(ext(own(1), n))]),
                    atom(friend, [role(2)])], [atom(retired, [])]),
       rs(guarded, [atom(member, [nterm(ext(own(1), n))])], [],
                   [atom(identity, []), atom(child, [])],
                   [atom(member, [nterm(ext(own(1), n))]), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)]), atom(knows, [role(2)]), atom(friend, [role(4)])],
                   [atom(child, []), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)]), atom(knows, [role(1)]), atom(friend, [role(3)])],
                   [atom(child, []), atom(retired, [])])]),
%% GnW:3, Alice ends Carol's membership of Bob's group.
    schema(child_leave, ['Bob', 'Carol', 'Alice'], [svar(n)],
      [rs(unguarded, [], [atom(listed, [role(2), svar(n)])],
                     [atom(identity, [])], []),
       rs(unguarded, [], [atom(member, [nterm(ext(own(1), n))])],
                     [atom(identity, []), atom(child, [])], []),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(2)])], [atom(child, []), atom(retired, [])])]),
%% GnW:3, Alice closes the group Carol leads, ending every membership of it.
    cschema(child_close, ['Carol', 'Alice', 'Carol'], [svar(n)], [],
      [rs(unguarded, [atom(closed, [svar(n)])],
                     [atom(listed, [role(1), svar(n)])],
                     [atom(identity, []), atom(child, [])], []),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)])], [atom(child, []), atom(retired, [])]),
       crs(listed(1, listed, [svar(n)]), unguarded,
           [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% CSSN:2, A child's group: Carol creates a group with the consent of Alice, a parent.
    schema(child_create, ['Carol', 'Alice'], [svar(n)],
      [rs(guarded, [atom(member, [nterm(ext(own(1), n))]),
                    atom(listed, [role(1), svar(n)])], [],
                   [atom(identity, []), atom(child, [])],
                   [atom(member, [nterm(ext(own(1), n))]), atom(closed, [svar(n)]), atom(retired, [])]),
       rs(guarded, [], [],
                   [atom(identity, []), atom(parenting, [role(1)])], [atom(child, []), atom(retired, [])])])]).
