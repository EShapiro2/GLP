%% ---------------------------------------------------------------------------
%% CSSN.glp --- CSSN, the child-safe social network, CSSN's, its clauses in CSSN.txt beside this file: it instantiates GSNW (GSNW.glp beside this file), a child for a ward and a parent for a guardian, and restricts and extends it (Udi, 2026-11-10, to CSSN #14), in the terms of GSC's paper, Section Relations among Contracts, and in the clause syntax of its Section 3.2, for programs/vglp/cva/compiler to compile into its canonical CVA platform (CSSN, Section 4.6.1).  This term is the one source of the schemas.
%% Thirty-eight schemas.  The instance: GSNW's thirty-seven with child for ward and parenting for guardian_of, creator, created, guarded_by and retired at themselves; the term holds them restated until Code gives the term form of an instantiation, and the acts keep GnW's and GSNW's names, a restriction keeping the name of the schema it replaces.  The restrictions, by GSC's Proposition Syntactic restrictions (d), an added guard that changes no state: ward_acquaint and wards_acquaint take a parent of each child, who knows the other agent (CSSN:2), and ward_create a parent's consent, the child signing the group's name (CSSN:3).  The extension: of_age (CSSN:4), which deletes child where it adds person.
%% Written by CSSN #14 Cowork, 2026-11-10; printed by /Users/udi/Grassroots/CSSN/docs/gen_gsnw.py from programs/gsc/GnW.glp as it stood at the commit that last changed this file, GnW's schemas taken from it and not typed again, so that a change of GnW is carried by running the script again.  The earlier history is in git.
%% ---------------------------------------------------------------------------

%% introduction_named(cssn, I): the contract's introduction predicate, knows, by which an agent introduces to each other, at the level of the machines, every two agents its person knows (CSSN, Section 4.6.1, "The program"; vGLP, Section 5.4), in the form of programs/vglp/cva/contracts.glp.
Intro ::= no_introduction ; introduction(Constant).
procedure introduction_named(Constant?, Intro).
introduction_named(cssn, introduction(knows)).

% contract_named(cssn, C): the contract, CSSN, friend and knows reflexive.
procedure contract_named(Constant?, SDeclared).
contract_named(cssn, reflexive([friend, knows],
   [
%% GKK:1, Identity.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice']), atom(person, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
%% GKK:2, Acquaintance, for two persons.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(person, ['Alice']),
        atom(identity, ['Bob']), atom(person, ['Bob'])],
       true, ['Alice', 'Bob']),
%% GKK:3, Introduction, for persons, with Bob's consent, Carol, the person introduced, a reading role.
    sas(introduce, ['Alice', 'Bob', 'Carol'], [],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(person, ['Alice']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']),
        atom(person, ['Bob']),
        atom(identity, ['Carol']), atom(person, ['Carol'])],
       true, ['Alice', 'Bob']),
%% GSG:1, Friendship, for two persons who know each other.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])),
        atom(person, ['Alice']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice'])),
        atom(person, ['Bob'])],
       true, ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, by a person, Alice, with any agent Bob, but a ward she is a guardian of (GnW:2, guardian_unfriend).
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(listed, ['Alice', 'Bob', '_'])), not(atom(member, ['Alice', ext(own('Bob'), '_')])),
        not(atom(friend, ['Bob', 'Alice'])), not(atom(listed, ['Bob', 'Alice', '_'])), not(atom(member, ['Bob', ext(own('Alice'), '_')]))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']),
        atom(person, ['Alice']),
        not(atom(parenting, ['Alice', 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice'])],
       true, ['Alice']),
%% GnW:1, Creation: Alice creates the ward Carol, choosing Carol's key pair, and is her creator, a guardian and a friend.
    sas(enter, ['Alice', 'Carol'], [],
       [atom(created, ['Alice', 'Carol']), atom(parenting, ['Alice', 'Carol']),
        atom(friend, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(creator, ['Carol', 'Alice']),
        atom(guarded_by, ['Carol', 'Alice']),
        atom(friend, ['Carol', 'Alice']), atom(knows, ['Carol', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        not(atom(identity, ['Carol']))],
       true, ['Alice', 'Carol']),
%% GnW:2, Joint guardianship: Bob, a friend of Alice, a guardian of Carol, becomes a guardian and a friend of Carol, by an act of Bob and the guardians of Carol, Alice and every Erin.
    sas(make_guardian, ['Bob', 'Alice', 'Carol', 'Erin'], [],
       [atom(parenting, ['Bob', 'Carol']), atom(friend, ['Bob', 'Carol']),
        atom(guarded_by, ['Carol', 'Bob']), atom(friend, ['Carol', 'Bob'])],
       [atom(identity, ['Bob']), atom(person, ['Bob']),
        not(atom(parenting, ['Bob', 'Carol'])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        not(atom(guarded_by, ['Carol', 'Bob'])), not(atom(friend, ['Carol', 'Bob'])),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), true,
               and(atom(identity, ['Erin']), and(atom(person, ['Erin']), atom(parenting, ['Erin', 'Carol']))))],
       true, ['Bob', 'Alice', 'Erin']),
%% GnW:2: the guardians of Carol other than Bob, Alice and every other Erin, end Bob's guardianship of Carol.
    sas(end_guardian, ['Alice', 'Bob', 'Carol', 'Erin'], [],
       [not(atom(parenting, ['Bob', 'Carol'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(person, ['Bob']), atom(parenting, ['Bob', 'Carol']),
        atom(identity, ['Carol']), atom(guarded_by, ['Carol', 'Bob']), atom(guarded_by, ['Carol', 'Alice']),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), ne('Erin', 'Bob'),
               and(atom(identity, ['Erin']), and(atom(person, ['Erin']), atom(parenting, ['Erin', 'Carol']))))],
       true, ['Alice', 'Erin']),
%% GnW:2: Bob, a guardian of Carol, ends his guardianship of Carol, the friendship remaining.
    sas(resign, ['Bob', 'Carol'], [],
       [not(atom(parenting, ['Bob', 'Carol'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Bob']), atom(person, ['Bob']), atom(parenting, ['Bob', 'Carol']),
        atom(identity, ['Carol']), atom(guarded_by, ['Carol', 'Bob'])],
       true, ['Bob']),
%% GnW:2: Bob, a guardian of Carol, ends his friendship with Carol, which ends his guardianship.
    sas(guardian_unfriend, ['Bob', 'Carol'], [],
       [not(atom(friend, ['Bob', 'Carol'])), not(atom(parenting, ['Bob', 'Carol'])),
        not(atom(listed, ['Bob', 'Carol', '_'])), not(atom(member, ['Bob', ext(own('Carol'), '_')])),
        not(atom(listed, ['Carol', 'Bob', '_'])), not(atom(member, ['Carol', ext(own('Bob'), '_')])),
        not(atom(friend, ['Carol', 'Bob'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Bob']), atom(person, ['Bob']), atom(friend, ['Bob', 'Carol']), atom(parenting, ['Bob', 'Carol']),
        atom(identity, ['Carol']), atom(friend, ['Carol', 'Bob']), atom(guarded_by, ['Carol', 'Bob'])],
       true, ['Bob']),
%% CSSN:2, A child's acquaintances, restricting GnW:3's by GSC's Proposition Syntactic restrictions (d): Carol, a child of Alice, comes to know Bob by an act of Carol, Alice and Bob, provided Alice knows Bob.
    sas(ward_acquaint, ['Carol', 'Bob', 'Alice'], [],
       [atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Bob']), atom(person, ['Bob']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(knows, ['Alice', 'Bob'])],
       true, ['Carol', 'Bob', 'Alice']),
%% GnW:3, Ward and person, a relation: Carol and Bob, who know each other, become friends, provided Alice, a guardian of Carol, and Bob are friends, by an act of the three.
    sas(ward_befriend, ['Carol', 'Bob', 'Alice'], [],
       [atom(friend, ['Carol', 'Bob']), atom(friend, ['Bob', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(knows, ['Carol', 'Bob']), not(atom(friend, ['Carol', 'Bob'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Carol']),
        atom(person, ['Bob']), not(atom(friend, ['Bob', 'Carol'])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob'])],
       true, ['Carol', 'Bob', 'Alice']),
%% GnW:3: Alice, a guardian of Carol, ends a friendship of Carol with Bob, other than a guardian.
    sas(ward_unfriend, ['Carol', 'Bob', 'Alice'], [],
       [not(atom(friend, ['Carol', 'Bob'])), not(atom(listed, ['Carol', 'Bob', '_'])), not(atom(member, ['Carol', ext(own('Bob'), '_')])),
        not(atom(friend, ['Bob', 'Carol'])), not(atom(listed, ['Bob', 'Carol', '_'])), not(atom(member, ['Bob', ext(own('Carol'), '_')]))],
       [atom(identity, ['Carol']), atom(friend, ['Carol', 'Bob']), atom(guarded_by, ['Carol', 'Alice']),
        not(atom(guarded_by, ['Carol', 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Carol']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol'])],
       true, ['Alice']),
%% GnW:3: Carol, a ward of Alice, ends her friendship with Bob, other than a guardian; Alice an agent variable.
    sas(ward_end, ['Carol', 'Bob', 'Alice'], ['Alice'],
       [not(atom(friend, ['Carol', 'Bob'])), not(atom(listed, ['Carol', 'Bob', '_'])), not(atom(member, ['Carol', ext(own('Bob'), '_')])),
        not(atom(friend, ['Bob', 'Carol'])), not(atom(listed, ['Bob', 'Carol', '_'])), not(atom(member, ['Bob', ext(own('Carol'), '_')]))],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(friend, ['Carol', 'Bob']), not(atom(guarded_by, ['Carol', 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Carol'])],
       true, ['Carol']),
%% CSSN:2, restricting GnW:4's by (d): Carol comes to know Dave, a child of Bob, by an act of Carol, Alice, Dave and Bob, provided Alice knows Dave and Bob, and Bob knows Carol and Alice; Alice and Bob possibly one person.
    sas(wards_acquaint, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
       [atom(knows, ['Carol', 'Dave']), atom(knows, ['Dave', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Dave']), atom(child, ['Dave']), atom(guarded_by, ['Dave', 'Bob']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(person, ['Bob']), atom(parenting, ['Bob', 'Dave']),
        atom(knows, ['Bob', 'Carol']), atom(knows, ['Bob', 'Alice'])],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% GnW:4, Ward and ward, a relation: Carol and Dave, who know each other, become friends, provided Alice knows Dave and is a friend of Bob, by an act of the four; Alice and Bob possibly one person.
    sas(wards_befriend, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
       [atom(friend, ['Carol', 'Dave']), atom(friend, ['Dave', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(knows, ['Carol', 'Dave']), not(atom(friend, ['Carol', 'Dave'])),
        atom(identity, ['Dave']), atom(child, ['Dave']), atom(guarded_by, ['Dave', 'Bob']),
        atom(knows, ['Dave', 'Carol']), not(atom(friend, ['Dave', 'Carol'])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(person, ['Bob']), atom(parenting, ['Bob', 'Dave'])],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% GnW:5, Retiring: the guardians of Carol, Alice and every Erin, retire Carol, which ends every guardianship and every friendship of Carol, every friend Bob and every guardian Erin of Carol in the act by the quantified conjuncts; retired is a record, and the records of her creation stay.
    sas(retire, ['Carol', 'Alice', 'Bob', 'Erin'], [],
       [atom(retired, ['Carol']), not(atom(friend, ['Carol', '_'])), not(atom(guarded_by, ['Carol', '_'])),
        not(atom(listed, ['Carol', '_', '_'])), not(atom(member, ['Carol', '_'])),
        forall(['Bob'], atom(friend, ['Carol', 'Bob']), true,
               [not(atom(friend, ['Bob', 'Carol'])), not(atom(listed, ['Bob', 'Carol', '_'])), not(atom(member, ['Bob', ext(own('Carol'), '_')]))]),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), true, [not(atom(parenting, ['Erin', 'Carol']))])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        forall(['Bob'], atom(friend, ['Carol', 'Bob']), true,
               and(atom(identity, ['Bob']), atom(friend, ['Bob', 'Carol']))),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), true,
               and(atom(identity, ['Erin']), and(atom(person, ['Erin']), atom(parenting, ['Erin', 'Carol']))))],
       true, ['Alice', 'Erin']),
%% GSN:1, Messaging, by a person.
    sas(message, ['Alice', 'Bob'], [x],
       [atom(received, ['Bob', x, 'Alice'])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true, ['Alice']),
%% GSNW:1, A ward's messages: Carol, a ward of Alice, sends a message to her friend Bob; Alice an agent variable.
    sas(ward_message, ['Carol', 'Bob', 'Alice'], ['Alice', x],
       [atom(received, ['Bob', x, 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(friend, ['Carol', 'Bob']),
        atom(identity, ['Bob'])],
       true, ['Carol']),
%% GSN:2, Group, by a person.
    sas(create, ['Alice'], [n],
       [atom(member, ['Alice', ext(own('Alice'), n)]), atom(listed, ['Alice', 'Alice', n])],
       [atom(identity, ['Alice']), atom(person, ['Alice']),
        not(atom(member, ['Alice', ext(own('Alice'), n)])), not(atom(closed, ['Alice', n]))],
       true, ['Alice']),
%% CSSN:3, A child's group, restricting GSNW:2's by (d): Carol creates a group with the consent of a parent, Alice; Carol signs its name.
    sas(ward_create, ['Carol', 'Alice'], [n],
       [atom(member, ['Carol', ext(own('Carol'), n)]), atom(listed, ['Carol', 'Carol', n])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        not(atom(member, ['Carol', ext(own('Carol'), n)])), not(atom(closed, ['Carol', n])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol'])],
       signed('Carol', n), ['Carol', 'Alice']),
%% GSN:3, Joining and Leaving: Alice, the leader, a person, adds her friend Bob, a person, with his consent.
    sas(join, ['Alice', 'Bob'], [n],
       [atom(listed, ['Alice', 'Bob', n]), atom(member, ['Bob', ext(own('Alice'), n)])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(person, ['Bob']), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       true, ['Alice', 'Bob']),
%% GnW:3, a relation, the membership of a group: Carol, a ward of Alice, joins the group of Bob, her friend, provided Alice and Bob are friends, by an act of the three.
    sas(ward_join, ['Bob', 'Carol', 'Alice'], [n],
       [atom(listed, ['Bob', 'Carol', n]), atom(member, ['Carol', ext(own('Bob'), n)])],
       [atom(identity, ['Bob']), atom(person, ['Bob']), atom(member, ['Bob', ext(own('Bob'), n)]),
        atom(friend, ['Bob', 'Carol']),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        not(atom(member, ['Carol', ext(own('Bob'), n)])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob'])],
       true, ['Bob', 'Carol', 'Alice']),
%% GnW:4, a relation, the membership of a group: Dave, a ward of Bob, joins the group of Carol, a ward of Alice and his friend, provided Alice knows Dave and is a friend of Bob, by an act of the four; Alice and Bob possibly one person.
    sas(wards_join, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [n],
       [atom(listed, ['Carol', 'Dave', n]), atom(member, ['Dave', ext(own('Carol'), n)])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(member, ['Carol', ext(own('Carol'), n)]), atom(friend, ['Carol', 'Dave']),
        atom(identity, ['Dave']), atom(child, ['Dave']), atom(guarded_by, ['Dave', 'Bob']),
        not(atom(member, ['Dave', ext(own('Carol'), n)])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(person, ['Bob']), atom(parenting, ['Bob', 'Dave'])],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% GSN:3: Bob, a person, ends his membership.
    sas(leave, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(listed, ['Alice', 'Bob', n]),
        atom(identity, ['Bob']), atom(person, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       true, ['Bob']),
%% GnW:3: Carol, a ward of Alice, ends her membership of Bob's group; Alice an agent variable.
    sas(ward_leave, ['Bob', 'Carol', 'Alice'], ['Alice', n],
       [not(atom(listed, ['Bob', 'Carol', n])), not(atom(member, ['Carol', ext(own('Bob'), n)]))],
       [atom(identity, ['Bob']), atom(listed, ['Bob', 'Carol', n]),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(member, ['Carol', ext(own('Bob'), n)])],
       true, ['Carol']),
%% GSN:3: Alice, the leader, a person, ends Bob's membership.
    sas(remove, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(listed, ['Alice', 'Bob', n]),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       true, ['Alice']),
%% GnW:3: Carol, the leader, a ward of Alice, ends Bob's membership of her group; Alice an agent variable.
    sas(ward_remove, ['Carol', 'Bob', 'Alice'], ['Alice', n],
       [not(atom(listed, ['Carol', 'Bob', n])), not(atom(member, ['Bob', ext(own('Carol'), n)]))],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(listed, ['Carol', 'Bob', n]),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Carol'), n)])],
       true, ['Carol']),
%% GnW:3: Alice, a guardian of Carol, ends Carol's membership of Bob's group.
    sas(ward_withdraw, ['Bob', 'Carol', 'Alice'], [n],
       [not(atom(listed, ['Bob', 'Carol', n])), not(atom(member, ['Carol', ext(own('Bob'), n)]))],
       [atom(identity, ['Bob']), atom(listed, ['Bob', 'Carol', n]),
        atom(identity, ['Carol']), atom(member, ['Carol', ext(own('Bob'), n)]), atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol'])],
       true, ['Alice']),
%% GSN:2: Alice, the leader, a person, closes the group by leaving it, ending the membership of every Bob she lists.
    sas(close, ['Alice', 'Bob'], [n],
       [atom(closed, ['Alice', n]), not(atom(listed, ['Alice', 'Alice', n])),
        not(atom(member, ['Alice', ext(own('Alice'), n)])),
        forall(['Bob'], atom(listed, ['Alice', 'Bob', n]), true,
               [not(atom(member, ['Bob', ext(own('Alice'), n)]))])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Alice', n]),
        forall(['Bob'], atom(listed, ['Alice', 'Bob', n]), true,
               and(atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])))],
       true, ['Alice']),
%% GSNW:2: Carol, the leader, a ward of Alice, closes her group by leaving it, ending the membership of every Bob she lists; Alice an agent variable.
    sas(ward_close, ['Carol', 'Bob', 'Alice'], ['Alice', n],
       [atom(closed, ['Carol', n]), not(atom(listed, ['Carol', 'Carol', n])),
        not(atom(member, ['Carol', ext(own('Carol'), n)])),
        forall(['Bob'], atom(listed, ['Carol', 'Bob', n]), true,
               [not(atom(member, ['Bob', ext(own('Carol'), n)]))])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(member, ['Carol', ext(own('Carol'), n)]), atom(listed, ['Carol', 'Carol', n]),
        forall(['Bob'], atom(listed, ['Carol', 'Bob', n]), true,
               and(atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Carol'), n)])))],
       true, ['Carol']),
%% GSNW:2: Alice, a guardian of Carol, closes the group Carol leads, ending the membership of every Bob Carol lists.
    sas(guardian_close, ['Carol', 'Alice', 'Bob'], [n],
       [atom(closed, ['Carol', n]), not(atom(listed, ['Carol', 'Carol', n])),
        not(atom(member, ['Carol', ext(own('Carol'), n)])),
        forall(['Bob'], atom(listed, ['Carol', 'Bob', n]), true,
               [not(atom(member, ['Bob', ext(own('Carol'), n)]))])],
       [atom(identity, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(member, ['Carol', ext(own('Carol'), n)]), atom(listed, ['Carol', 'Carol', n]),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        forall(['Bob'], atom(listed, ['Carol', 'Bob', n]), true,
               and(atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Carol'), n)])))],
       true, ['Alice']),
%% GSN:4, Group messaging: the leader's own post, a person's.
    sas(post_own, ['Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        not(atom(posted, ['Alice', x, n]))],
       true, ['Alice']),
%% GSNW:1: the post of Carol, a ward of Alice, to the group she leads; Alice an agent variable.
    sas(ward_post_own, ['Carol', 'Alice'], ['Alice', x, n],
       [atom(posted, ['Carol', x, n])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(member, ['Carol', ext(own('Carol'), n)]), not(atom(posted, ['Carol', x, n]))],
       true, ['Carol']),
%% GSN:4: the post of Bob, a member and a person, sent to the leader.
    sas(post, ['Bob', 'Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Bob']), atom(person, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)]),
        atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(posted, ['Alice', x, n]))],
       true, ['Bob']),
%% GSNW:1: the post of Carol, a member and a ward of Alice, sent to the leader, Bob; Alice an agent variable.
    sas(ward_post, ['Carol', 'Bob', 'Alice'], ['Alice', x, n],
       [atom(posted, ['Bob', x, n])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(member, ['Carol', ext(own('Bob'), n)]),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Bob'), n)]),
        atom(listed, ['Bob', 'Carol', n]), atom(friend, ['Bob', 'Carol']),
        not(atom(posted, ['Bob', x, n]))],
       true, ['Carol']),
%% GSN:4: the leader delivers a post to a member, unguarded.
    sas(deliver, ['Alice', 'Bob'], [x, n],
       [atom(delivered, ['Alice', x, 'Bob', n]), atom(received_in, ['Bob', x, 'Alice', n])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(posted, ['Alice', x, n]), atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(delivered, ['Alice', x, 'Bob', n])),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       true, []),
%% CSSN:4, Coming of age, CSSN's extension: Alice, the creator of Carol, declares Carol of age, which ends every guardianship of Carol, of every parent Erin, the friendships remaining, and Carol is then a person.
    sas(of_age, ['Carol', 'Alice', 'Erin'], [],
       [atom(person, ['Carol']), not(atom(child, ['Carol'])), not(atom(creator, ['Carol', 'Alice'])),
        not(atom(guarded_by, ['Carol', '_'])),
        not(atom(created, ['Alice', 'Carol'])),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), true, [not(atom(parenting, ['Erin', 'Carol']))])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(creator, ['Carol', 'Alice']),
        atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(created, ['Alice', 'Carol']),
        atom(parenting, ['Alice', 'Carol']),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), true,
               and(atom(identity, ['Erin']), and(atom(person, ['Erin']), atom(parenting, ['Erin', 'Carol']))))],
       true, ['Alice'])
])).
