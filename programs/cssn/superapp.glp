%% superapp.glp --- the Grassroots Super-App, as much of it as these plays
%% need.
%%
%% The platform runs as a mini-app (childsafe/), and a mini-app makes no first
%% contact: the social graph befriends, and hands each execution a
%% conversation with the execution of the same mini-app at a friend.  In
%% deployment that is the Grassroots Super-App (GSG paper, Sections 3 and 5);
%% in these plays it is this module, one process beside each mini-app,
%% standing in for it.  It takes the person's befriending commands, carries the
%% invitation over a network of its own (sg_switch), shows the other person
%% the offer, and on acceptance hands each side its end of the conversation's
%% root channel.  It calls nothing that reaches the network or the person.

%% superapp(Id, Cmds, Notify, Convs, Out, In, Pending, N): the person's
%% commands and what it shows them; the conversations it hands the mini-app;
%% its network out and in; the invitations awaiting the person's answer, and
%% the next identifier.
exported procedure superapp(Key?, Stream(SgCmd)?, Stream(SgNotify), Stream(Conversation), SgOutStream, SgInStream?, Stream(SgPending)?, Integer?).

%% The person asks Target to befriend.
superapp(Id, [connect(Target)|Cmds], Notify?, Convs?, [sg(Target?, sg_invite(Id?, Resp))|Out?], In, Ps, N) :-
    ground(Id?), ground(Target?) |
    inject_sg_answer(Resp?, Target?, In?, In1),
    superapp(Id?, Cmds?, Notify, Convs, Out, In1?, Ps?, N?).

%% The person answers an offer.
superapp(Id, [decision(Dec, From, ReqId)|Cmds], Notify?, Convs?, Out?, In, Ps, N) :-
    ground(Id?), ground(Dec?), ground(From?), ground(ReqId?) |
    lookup_sg(ReqId?, Val, Ps?, Ps1),
    answer_invite(Dec?, From?, Val?, Convs, Convs1?),
    superapp(Id?, Cmds?, Notify, Convs1, Out, In?, Ps1?, N?).

%% An offer arrives: shown to the person, its answer pending.
superapp(Id, Cmds, Notify?, Convs?, Out?, [sg(Id1, sg_invite(From, Resp?))|In], Ps, N) :-
    Id? =?= Id1?, ground(From?), ground(N?) |
    N1 := N? + 1,
    show_invite(From?, req(N?), Notify, Notify1?),
    superapp(Id?, Cmds?, Notify1, Convs, Out, In?, [sg_pending(req(N?), sg_response(Resp))|Ps?], N1?).

%% Our own offer was accepted: the conversation goes to our mini-app.
superapp(Id, Cmds, Notify?, Convs?, Out?, [sg_answer(Target, sg_accept(End))|In], Ps, N) :-
    ground(Target?) |
    open_conv(Target?, End?, Convs, Convs1?),
    superapp(Id?, Cmds?, Notify, Convs1, Out, In?, Ps?, N?).

%% Or declined.
superapp(Id, Cmds, Notify?, Convs?, Out?, [sg_answer(Target, sg_decline)|In], Ps, N) :-
    ground(Target?) |
    show_declined(Target?, Notify, Notify1?),
    superapp(Id?, Cmds?, Notify1, Convs, Out, In?, Ps?, N?).

procedure show_invite(Key?, ReqId?, Stream(SgNotify), Stream(SgNotify)?).
show_invite(From, ReqId, [befriend(From?, ReqId?)|Notify1?], Notify1).

procedure show_declined(Key?, Stream(SgNotify), Stream(SgNotify)?).
show_declined(Target, [declined(Target?)|Notify1?], Notify1).

%% The invitation awaiting an answer, by the identifier the person was shown.
procedure lookup_sg(ReqId?, SgPendingValue, Stream(SgPending)?, Stream(SgPending)).
lookup_sg(ReqId, Val?, [sg_pending(Id, Val)|Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_sg(ReqId, Val?, [P|Rest], [P?|Rest1?]) :-
    otherwise |
    lookup_sg(ReqId?, Val, Rest?, Rest1).
lookup_sg(_, sg_error, [], []).

procedure answer_invite(Decision?, Key?, SgPendingValue?, Stream(Conversation), Stream(Conversation)?).
answer_invite(Dec, From, sg_response(Resp?), Convs?, Convs1) :-
    ground(Dec?), ground(From?) |
    bind_invite(Resp, Dec?, From?, Convs, Convs1?).
answer_invite(_, _, sg_error, Convs?, Convs).

%% Accepting creates the root channel of the conversation: one end is conveyed
%% in the answer, the other becomes this side's conversation.
procedure bind_invite(SgResponse, Decision?, Key?, Stream(Conversation), Stream(Conversation)?).
bind_invite(sg_accept(TheirEnd?), yes, From, Convs?, Convs1) :-
    ground(From?), new_channel(TheirEnd, MyEnd) |
    open_conv(From?, MyEnd?, Convs, Convs1?).
bind_invite(sg_decline, no, _, Convs?, Convs).

procedure open_conv(Key?, FriendChannel?, Stream(Conversation), Stream(Conversation)?).
open_conv(Q, End, [conversation(Q?, End?)|Convs1?], Convs1).

%% The answer to an offer of ours, when it comes.
procedure inject_sg_answer(SgResponse?, Key?, SgInStream?, SgInStream).
inject_sg_answer(Resp, Target, Ys, [sg_answer(Target?, Resp?)|Ys?]) :-
    known(Resp?), ground(Target?) | true.
inject_sg_answer(Resp, Target, [Y|Ys], [Y?|Ys1?]) :-
    inject_sg_answer(Resp?, Target?, Ys?, Ys1).

%% The super-apps' own network: one entry per party, keyed by name.
exported procedure sg_switch(SgOutStream?, Stream(SgEntry)?).
sg_switch([sg(Dest, Content)|In], Entries) :-
    ground(Dest?) |
    sg_send(Dest?, sg(Dest?, Content?), Entries?, Entries1),
    sg_switch(In?, Entries1?).
sg_switch([], Entries) :- sg_close(Entries?).

procedure sg_close(Stream(SgEntry)?).
sg_close([sg_entry(_, [])|Rest]) :- sg_close(Rest?).
sg_close([]).

procedure sg_send(Key?, SgInMsg?, Stream(SgEntry)?, Stream(SgEntry)).
sg_send(Dest, Msg, [sg_entry(K, [Msg?|Out1?])|Rest], [sg_entry(K?, Out1)|Rest?]) :-
    Dest? =?= K? | true.
sg_send(Dest, Msg, [E|Rest], [E?|Rest1?]) :-
    otherwise |
    sg_send(Dest?, Msg?, Rest?, Rest1).
sg_send(_, _, [], []).
