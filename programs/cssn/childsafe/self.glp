%% childsafe/self.glp --- the child-safe social network as a certified program
%% of its own (CSSN Section 6.1): the three agents, adult, parent and child
%% (adult.vglp, parent.vglp, child.vglp), three vGLP modules that hand a party
%% over to each other, compiled beside their sources; the cards they share
%% (self.vglp, which joins this module as the program loads); and the
%% mini-app's entries, cssn/3 for a party entering as an adult and
%% cssn_child/4 for one entering as a child with its parents (miniapp.glp).  The types and the helpers are the parent's (../self.glp, an
%% ancestor scope).
%%
%% It is a program of its own because the certificate of a program is refused
%% where any entry point reaches the person or the network, and the parent's
%% plays do (send_to_user/1): loaded here, without them, the program is
%% certified, and its module value is the mini-app the super-app installs and
%% activates by run/3 (GSG paper, Section 3).

imported procedure miniapp#cssn(Key?, PersonChannel(Drawn)?, Stream(Conversation)?).
exported procedure cssn(Key?, PersonChannel(Drawn)?, Stream(Conversation)?).
cssn(Id, Ui, Convs) :- miniapp # cssn(Id?, Ui?, Convs?).

imported procedure miniapp#cssn_child(Key?, ParentEnds?, PersonChannel(Drawn)?, Stream(Conversation)?).
exported procedure cssn_child(Key?, ParentEnds?, PersonChannel(Drawn)?, Stream(Conversation)?).
cssn_child(Id, Es, Ui, Convs) :- miniapp # cssn_child(Id?, Es?, Ui?, Convs?).
