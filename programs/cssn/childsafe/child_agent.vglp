%% child_agent.vglp --- the child agent of the child-safe social network, in
%% vGLP.
%%
%% The program a party runs while it holds a parent (CSSN Section 8.1): the
%% adult agent (agent.vglp) hands the party here when it becomes a child, and
%% this module hands it back when its last parenting ends, so a party becomes
%% an adult when the last parenting ends.  Its compilation is child_agent.glp
%% beside this file (glpc :emit); the compiled module is not edited.
%%
%% A child holds a set of parents, rho_r, the parent_output entries of its
%% outputs and the list Parents beside them, and may gain another: a parent of
%% a child is a choice its interface offers wherever the contract names one.
%% It cannot initiate a friendship --- a conversation the social graph opens
%% with it is refused, and every friendship of a child is established by a
%% parent's introduction --- and every act by which it gains or loses a friend
%% or a group leaves an approval or a withdrawal at the parent the contract
%% names.  It carries the whole of the parent's role besides, since a child
%% may itself become a parent and no clause of the contract may keep it from
%% that act (Appendix A, "No Gatekeeping"): it may not become a parent of a
%% parent of its own (the forbidden parent(r) of Appendix A2).
%%
%% Its question is the person's requests, asked by the adult agent and handed
%% over with the party; the cards it answers are self.vglp's.  The types and
%% the helpers are ../self.glp's; the routers, the befriending's convey, adopt
%% and already_friend are social/graph/routing's, exposed from the root.

%% A joining child's request for its parent's consent, where it needs one.
ConsentAsk ::= none ; ask(GroupId, YesNo?).

imported procedure agent#adult(Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% child(Reqs, Id, Parents, AgentIn, NetIn, Convs, Outs, St): the child agent,
%% with the rest of the person's requests and its parents.
exported procedure child(Stream(Request)?, Key?, Stream(Key)?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% --- What its cards and awaits hand it ---

%% Child befriend(r, s, p, q), committed at the child whose name sorts first
%% (Section 8.4, step 5): on reading the other's consent it conveys the friend
%% channel it mints, or the existing one where the two are already friends,
%% and the approval goes to P, the parent whose introduction it was.
child(Reqs, Id, Ps, [outcome(P, consented(Peer, C?))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Peer?), ground(P?) |
    already_friend(Peer?, Outs?, Outs1, Known),
    commit_proposer(Known?, P?, Peer?, C, Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% ... and at the other child, on reading the conveyance.
child(Reqs, Id, Ps, [outcome(P, adopt(Peer, Ch))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(Peer?), ground(P?) |
    adopt(Peer?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    count_at(P?, Id?, approval, Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

%% The other child declined.
child(Reqs, Id, Ps, [outcome(_, declined(Peer))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Peer?) |
    show(declined(Peer?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% An introduction approved for a child of its own goes on to the child.
child(Reqs, Id, Ps, [forward_intro(C, I, Cs)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, child_intro(I?, Cs?)), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Parent and child(p, r), at r: a further parent, accepted; rho_r gains it.
child(Reqs, Id, Ps, [become_child(P, Resp?)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(P?) |
    enrol_child_side(P?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% Parent and child(p, r), at p, a child being a parent too.
child(Reqs, Id, Ps, [enrol_response(C, enrol_accept(Ch))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(C?) |
    enrol_commit(C?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).
child(Reqs, Id, Ps, [enrol_response(C, enrol_no)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(C?) |
    show(declined(C?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% End parenting(r', p), at p: a child of its own released.
child(Reqs, Id, Ps, [release(C)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, release_grant), Outs?, Outs1),
    close_child(C?, Outs1?, Outs2),
    show(child_ended(C?), Outs2?, Outs3),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs3?, St?).

%% A group invitation of its own answered yes: the member joins, and where
%% the invitation took a parent's consent, the approval goes to that parent.
child(Reqs, Id, Ps, [group_reply(G, M, P, yes(X?))|AgentIn], NetIn, Convs, Outs, state(Al, Om, Gs, Sn)) :-
    ground(Id?), ground(G?), ground(M?), ground(P?) |
    setup_group_hub_side(G?, M?, Gs?, Gs1, Sn?, Sn1, Outs?, Outs1, NetIn?, NetIn1, X),
    show(member_joined(G?, M?), Outs1?, Outs2),
    count_at(P?, Id?, approval, Outs2?, Outs3),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs3?, state(Al?, Om?, Gs1?, Sn1?)).
child(Reqs, Id, Ps, [group_reply(_, M, _, no)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(M?) |
    show(declined(M?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% A group joined: the approval goes to the parent whose approval it took.
child(Reqs, Id, Ps, [group_joined(G, P, Ch)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(P?) |
    join_commit(G?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    count_at(P?, Id?, approval, Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

%% A group invitation approved for a child of its own goes on to the child.
child(Reqs, Id, Ps, [forward_group(C, G, R?)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, group_invite(G?, R)), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Join group (child creator)(g, s, p, q), at the creator r: its parent P
%% consented, and the invitation goes to the friend M.
child(Reqs, Id, Ps, [invite_now(G, M, P)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?), ground(M?), ground(P?) |
    send_friend(M?, msg(Id?, M?, group_invite(G?, R)), Outs?, Outs1),
    inject_group_reply(G?, M?, P?, R?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% --- A conversation the social graph opens: refused ---

%% A child's friendships are established through its parents, and the social
%% graph knows nothing of childhood, so the conversation is left unadopted, its
%% write end closed, and the person told.  This is where the child-safety
%% invariant meets the super-app.
child(Reqs, Id, Ps, AgentIn, NetIn, [conversation(Q, ch(_, []))|Convs], Outs, St) :-
    ground(Q?) |
    show(refused(Q?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% --- What the parties it is in relation with send it ---

child(Reqs, Id, Ps, AgentIn, [msg(From, To, text(T))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?) |
    show(received(From?, T?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Child unfriend(r, s, p, q), willed by the other child: the withdrawal goes
%% to a parent of this child, the first on its record.
child(Reqs, Id, [P|Ps], AgentIn, [msg(From, To, unfriend)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?), ground(P?) |
    close_friend(From?, Outs?, Outs1),
    show(unfriended(From?), Outs1?, Outs2),
    count_at(P?, Id?, withdrawal, Outs2?, Outs3),
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn?, Convs?, Outs3?, St?).

%% An introduction: from a parent of this child it is put to the person to
%% accept (Section 8.4, steps 3 and 4); from a friend it is for a child of this
%% party's own, to approve (step 2).
child(Reqs, Id, Ps, AgentIn, [msg(From, To, child_intro(I, Cs))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?), ground(I?), ground(Ps?) |
    member_of(From?, Ps?, FromParent),
    on_intro(FromParent?, From?, I?, Cs?, Id?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% Parent and child(p, r), at r: an offer of a further parent; refused where P
%% is one already (p not in rho_r).
child(Reqs, Id, Ps, AgentIn, [msg(_, To, enrol(P, Resp?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(P?), ground(Ps?) |
    member_of(P?, Ps?, Already),
    on_enrol(Already?, P?, Resp, Out),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% End parenting(r, p), at r: the parent P agreed.  rho_r loses P; where it is
%% then empty the party is an adult, and runs the adult agent.
child(Reqs, Id, Ps, AgentIn, [msg(P, To, release_grant)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(P?), ground(Ps?) |
    close_parent(P?, Outs?, Outs1),
    show(parent_ended(P?), Outs1?, Outs2),
    remove_key(P?, Ps?, Ps1),
    after_release(Ps1?, Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Child unfriend(r, s, p, q), willed by the parent P of this child.
child(Reqs, Id, Ps, AgentIn, [msg(P, To, unfriend_child(F))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(P?), ground(F?) |
    send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1),
    close_friend(F?, Outs1?, Outs2),
    show(unfriended(F?), Outs2?, Outs3),
    count_at(P?, Id?, withdrawal, Outs3?, Outs4),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs4?, St?).

%% Leave group (child)(g, s, p), willed by the parent P of this child.
child(Reqs, Id, Ps, AgentIn, [msg(P, To, leave_group(G))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(P?), ground(G?) |
    leave_group_commit(Id?, G?, Outs?, Outs1),
    count_at(P?, Id?, withdrawal, Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Leave group (child creator)(g, s, p, q), willed by the parent P of this
%% child, the creator, which holds the member list.
child(Reqs, Id, Ps, AgentIn, [msg(P, To, remove_member(G, M))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(P?), ground(G?), ground(M?) |
    remove_member(Id?, G?, M?, Outs?, Outs1),
    count_at(P?, Id?, withdrawal, Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% End parenting(r', p), at p: a child of its own asks.
child(Reqs, Id, Ps, AgentIn, [msg(C, To, release_request)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(C?) |
    agree_release(release(C?), A),
    release_answer(A?, C?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% A child of its own's act that took this parent's will.
child(Reqs, Id, Ps, AgentIn, [msg(_, To, approval)|NetIn], Convs, Outs, state(Al, Om, Gs, Sn)) :-
    Id? =?= To? |
    Al1 := Al? + 1,
    show(approvals(Al1?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, state(Al1?, Om?, Gs?, Sn?)).
child(Reqs, Id, Ps, AgentIn, [msg(_, To, withdrawal)|NetIn], Convs, Outs, state(Al, Om, Gs, Sn)) :-
    Id? =?= To? |
    Om1 := Om? + 1,
    show(withdrawals(Om1?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, state(Al?, Om1?, Gs?, Sn?)).

%% A group invitation: from a parent of this child, which has approved it, it
%% is put to the person; from a friend, a child creator, a parent's consent is
%% asked first, of the first on its record.
child(Reqs, Id, [P|Ps], AgentIn, [msg(From, To, group_invite(G, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?), ground(G?), ground(P?), ground(Ps?) |
    member_of(From?, [P?|Ps?], FromParent),
    on_group_invite(FromParent?, From?, P?, G?, Id?, R, Out, Ask),
    send_consent_req(Ask?, P?, Id?, Outs?, Outs1),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, [P?|Ps?], AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% Join group (child, creator an adult)(g, s, p), at p, a child being a parent
%% too.
child(Reqs, Id, Ps, AgentIn, [msg(_, To, group_invite_child(G, C, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(C?) |
    approve_join(join(G?, C?), A),
    forward_join(A?, C?, G?, R, Out),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% Join group (child creator)(g, s, p, q), at a parent, a child being a
%% parent too.
child(Reqs, Id, Ps, AgentIn, [msg(C, To, group_consent_req(G, Consent?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(C?) |
    approve_join(join(G?, C?), Consent),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs?, St?).
child(Reqs, Id, Ps, AgentIn, [msg(_, To, invite_consent_req(G, M, Consent?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(M?) |
    approve_invite(invite(G?, M?), Consent),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% A post in a group.
child(Reqs, Id, Ps, AgentIn, [msg(_, _, group_msg(G, A, T))|NetIn], Convs, Outs, state(Al, Om, Gs, Sn)) :-
    ground(G?), ground(A?), ground(T?) |
    add_post(post(G?, A?, T?), Gs?, Gs1),
    distribute_group_msg(G?, msg(A?, A?, group_msg(G?, A?, T?)), Sn?, Sn1, Outs?, Outs1),
    show(group_received(G?, A?, T?), Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs2?, state(Al?, Om?, Gs1?, Sn1?)).

%% Leave group (child creator)(g, s, p, q), willed by the member s, at the
%% creator r: the member is dropped from the list, and the withdrawal goes to
%% a parent of the creator, the first on its record, as the member's goes to
%% its own.
child(Reqs, Id, [P|Ps], AgentIn, [msg(M, _, group_leave(G, M1))|NetIn], Convs, Outs, St) :-
    ground(Id?), ground(G?), ground(M?), M? =?= M1?, ground(P?) |
    close_output(group_member(G?, M?), Outs?, Outs1),
    show(member_left(G?, M?), Outs1?, Outs2),
    count_at(P?, Id?, withdrawal, Outs2?, Outs3),
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn?, Convs?, Outs3?, St?).

%% Leave group (child), willed by the creator: the withdrawal goes to a parent
%% of this child.
child(Reqs, Id, [P|Ps], AgentIn, [msg(_, To, group_removed(G))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(P?) |
    close_output(group(G?), Outs?, Outs1),
    show(group_removed(G?), Outs1?, Outs2),
    count_at(P?, Id?, withdrawal, Outs2?, Outs3),
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn?, Convs?, Outs3?, St?).

%% --- The person's requests, one clause per alternative of Request ---

%% Parent and child(p, r), at p: refused where R is a parent of this party
%% (the forbidden parent(r) at the parent's role, Appendix A2); else the offer
%% travels the conversation with R, where one is open.
child([become_parent(R)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?), ground(Ps?) |
    member_of(R?, Ps?, Mine),
    offer_parent(Mine?, R?, Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Child befriend(r, s, p, q), proposed by p, a child being a parent too.
child([introduce(R, Q, S)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(Q?), ground(S?) |
    mint_consents(R?, S?, CR, CS),
    introduce(Id?, R?, Q?, S?, CR?, CS?, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child([send(F, T)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?) |
    send_friend(F?, msg(Id?, F?, text(T?)), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% End parenting(r, p), proposed by r, of a parent of its own.
child([end_parenting(P)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(P?), ground(Ps?) |
    member_of(P?, Ps?, Mine),
    ask_release(Mine?, P?, Id?, Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Child unfriend(r, s, p, q), willed by r: the withdrawal goes to a parent of
%% this child, the first on its record.
child([unfriend(F)|Reqs], Id, [P|Ps], AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?), ground(P?) |
    send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1),
    close_friend(F?, Outs1?, Outs2),
    show(unfriended(F?), Outs2?, Outs3),
    count_at(P?, Id?, withdrawal, Outs3?, Outs4),
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn?, Convs?, Outs4?, St?).

%% Child unfriend(r', s, p, q), willed by p, a child being a parent too.
child([unfriend_child(R, F)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(F?) |
    send_child(R?, msg(Id?, R?, unfriend_child(F?)), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Create group(g).
child([create_group(N)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?) |
    setup_group_creator(group_id(Id?, N?), Outs?, Outs1, NetIn?, NetIn1),
    show(group_joined(group_id(Id?, N?)), Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

%% Join group (child creator)(g, s, p, q), proposed by the creator r: the
%% consent of its parent p is asked first, of the first on its record.
child([invite(N, F)|Reqs], Id, [P|Ps], AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(F?), ground(P?) |
    send_parent(P?, msg(Id?, P?, invite_consent_req(group_id(Id?, N?), F?, Consent)), Outs?, Outs1),
    invite_after(Consent?, group_id(Id?, N?), F?, P?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, [P?|Ps?], AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% A child creator invites the child of a friend by way of the friend, its
%% parent, as an adult creator does, its own parent's consent asked first.
child([invite_child(N, C, Q)|Reqs], Id, [P|Ps], AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(C?), ground(Q?), ground(P?) |
    send_parent(P?, msg(Id?, P?, invite_consent_req(group_id(Id?, N?), C?, Consent)), Outs?, Outs1),
    invite_child_after(Consent?, group_id(Id?, N?), C?, Q?, P?, Id?, Outs1?, Outs2, AgentIn?, AgentIn1),
    child(Reqs?, Id?, [P?|Ps?], AgentIn1?, NetIn?, Convs?, Outs2?, St?).

child([post(G, T)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?), ground(T?) |
    lookup_send_group(group(G?), msg(Id?, Id?, group_msg(G?, Id?, T?)), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group (child), willed by the child: the withdrawal goes to a parent
%% of it, the first on its record.
child([leave(G)|Reqs], Id, [P|Ps], AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?), ground(P?) |
    leave_group_commit(Id?, G?, Outs?, Outs1),
    count_at(P?, Id?, withdrawal, Outs1?, Outs2),
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Leave group (child creator)(g, s, p, q), willed by the creator r.
child([remove(N, M)|Reqs], Id, [P|Ps], AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(M?), ground(P?) |
    remove_member(Id?, group_id(Id?, N?), M?, Outs?, Outs1),
    count_at(P?, Id?, withdrawal, Outs1?, Outs2),
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn?, Convs?, Outs2?, St?).

child([leave_child(R, G)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(G?) |
    send_child(R?, msg(Id?, R?, leave_group(G?)), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

child([remove_child_member(R, N, M)|Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(N?), ground(M?) |
    send_child(R?, msg(Id?, R?, remove_member(group_id(R?, N?), M?)), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% =============================================================================
%% Helpers
%% =============================================================================

%% The approval or withdrawal at the parent P, naming nobody.
%% P is the party itself where no parent is to count it: the second child of
%% a sibling introduction, whose one parent the first child's approval counts
%% (Section 6, "When p = q ... alpha_p grows by one").
procedure count_at(Key?, Key?, FriendContent?, Stream(OutputEntry)?, Stream(OutputEntry)).
count_at(P, Id, What, Outs, Outs1?) :-
    ground(P?), ground(Id?), P? =?\= Id? |
    send_parent(P?, msg(Id?, P?, What?), Outs?, Outs1).
count_at(P, Id, _, Outs, Outs?) :-
    P? =?= Id? | true.

%% The proposer's commit: a new friendship counts at P; an existing one is
%% conveyed and counts nothing, no transaction having been carried out.
procedure commit_proposer(Decision?, Key?, Key?, Conveyance(FriendChannel), Stream(Request)?, Key?, Stream(Key)?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
commit_proposer(no, P, Peer, C?, Reqs, Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    convey(no, Peer?, C, Outs?, Outs1, NetIn?, NetIn1),
    count_at(P?, Id?, approval, Outs1?, Outs2),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).
commit_proposer(yes, _, Peer, C?, Reqs, Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    convey(yes, Peer?, C, Outs?, Outs1, NetIn?, NetIn1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% An introduction from a parent is put to the person to accept; one from a
%% friend, for a child of this party's own, to approve.
procedure on_intro(Decision?, Key?, Intro?, Consents?, Key?, Stream(AgentIn)).
on_intro(yes, P, intro(P0, R, S), Cs, Id, Out?) :-
    ground(Id?), ground(R?), ground(S?), ground(P0?) |
    peer_of(Id?, R?, S?, Peer),
    counted_parent(Id?, R?, P0?, P?, Counted),
    accept(intro(P0?, R?, S?), A),
    accepted(A?, Peer?, Cs?, Counted?, Out).
on_intro(no, _, I, Cs, _, Out?) :-
    ground(I?) |
    approve(I?, A),
    approved(A?, I?, Cs?, Out).

%% The parent at whom this child's approval of the befriending is counted: the
%% introducing parent p at r; the parent q that forwarded it at s, except where
%% q is p, whose one approval r's counts.
procedure counted_parent(Key?, Key?, Key?, Key?, Key).
counted_parent(Id, R, P0, _, P0?) :- Id? =?= R? | true.
counted_parent(Id, R, P0, P, Id?) :- ground(Id?), Id? =?\= R?, P? =?= P0? | true.
counted_parent(Id, R, P0, P, P?) :- Id? =?\= R?, P? =?\= P0? | true.

%% The other child of an introduction.
procedure peer_of(Key?, Key?, Key?, Key).
peer_of(Id, R, S, S?) :- Id? =?= R? | true.
peer_of(Id, R, _, R?) :- Id? =?\= R? | true.

%% An offer of a further parent: declined where P is one already, else put to
%% the person.
procedure on_enrol(Decision?, Key?, EnrolResponse, Stream(AgentIn)).
on_enrol(yes, _, enrol_no, []).
on_enrol(no, P, Resp?, Out?) :-
    accept_parent(parent(P?), A),
    parent_answer(A?, P?, Resp, Out).

%% A group invitation at a child: from a parent, the person answers it, the
%% approval to that parent; from a friend, the parent P's consent is asked
%% first (Ask carries the consent to the parent), and the person answers it
%% once P consents.
procedure on_group_invite(Decision?, Key?, Key?, GroupId?, Key?, GroupReply, Stream(AgentIn), ConsentAsk).
on_group_invite(yes, From, _, G, _, R?, Out?, none) :-
    ground(G?) |
    join_group(group(G?), A),
    joined(A?, G?, From?, R, Out).
on_group_invite(no, _, P, G, _, R?, Out?, ask(G?, Consent)) :-
    ground(G?) |
    consented_join(Consent?, G?, P?, R, Out).

%% The joining child's consent request, to its parent.
procedure send_consent_req(ConsentAsk?, Key?, Key?, Stream(OutputEntry)?, Stream(OutputEntry)).
send_consent_req(none, _, _, Outs, Outs?).
send_consent_req(ask(G, Consent?), P, Id, Outs, Outs1?) :-
    ground(P?), ground(Id?) |
    send_parent(P?, msg(Id?, P?, group_consent_req(G?, Consent)), Outs?, Outs1).

%% Once the parent consents, the person answers the invitation; on no it goes
%% no further.
procedure consented_join(YesNo?, GroupId?, Key?, GroupReply, Stream(AgentIn)).
consented_join(yes, G, P, R?, Out?) :-
    ground(G?) |
    join_group(group(G?), A),
    joined(A?, G?, P?, R, Out).
consented_join(no, _, _, no, []).

%% A child creator's invitation, once its parent consents.
procedure invite_after(YesNo?, GroupId?, Key?, Key?, Stream(AgentIn)).
invite_after(yes, G, M, P, [invite_now(G?, M?, P?)]).
invite_after(no, _, _, _, []).

procedure invite_child_after(YesNo?, GroupId?, Key?, Key?, Key?, Key?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(AgentIn)?, Stream(AgentIn)).
invite_child_after(yes, G, C, Q, P, Id, Outs, Outs1?, AgentIn, AgentIn1?) :-
    ground(Q?), ground(Id?), ground(G?), ground(C?) |
    send_friend(Q?, msg(Id?, Q?, group_invite_child(G?, C?, R)), Outs?, Outs1),
    inject_group_reply(G?, C?, P?, R?, AgentIn?, AgentIn1).
invite_child_after(no, _, _, _, _, _, Outs, Outs?, AgentIn, AgentIn?).

%% Asking a parent of its own to end the parenting; asking a party that is not
%% one is not sent, and the screen says so.
procedure ask_release(Decision?, Key?, Key?, Stream(OutputEntry)?, Stream(OutputEntry)).
ask_release(yes, P, Id, Outs, Outs1?) :-
    ground(Id?) |
    send_parent(P?, msg(Id?, P?, release_request), Outs?, Outs1).
ask_release(no, P, _, Outs, Outs1?) :-
    show(not_my_parent(P?), Outs?, Outs1).

%% After a parent released this child: with no parent left it is an adult and
%% runs the adult agent; with one left it is still a child.
procedure after_release(Stream(Key)?, Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
after_release([], Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    show(adult, Outs?, Outs1),
    agent # adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).
after_release([P|Ps], Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    child(Reqs?, Id?, [P?|Ps?], AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Becoming a parent: refused where R is a parent of this party; else as an
%% adult offers.
procedure offer_parent(Decision?, Key?, Stream(Request)?, Key?, Stream(Key)?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
offer_parent(yes, R, Reqs, Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    show(my_parent(R?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).
offer_parent(no, R, Reqs, Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    has_friend(R?, Outs?, Outs1, Open),
    send_offer(Open?, R?, Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

procedure send_offer(Decision?, Key?, Stream(Request)?, Key?, Stream(Key)?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
send_offer(yes, R, Reqs, Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    send_friend(R?, msg(Id?, R?, enrol(Id?, Resp)), Outs?, Outs1),
    inject_enrol_response(Resp?, R?, AgentIn?, AgentIn1),
    child(Reqs?, Id?, Ps?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).
send_offer(no, R, Reqs, Id, Ps, AgentIn, NetIn, Convs, Outs, St) :-
    show(no_conversation(R?), Outs?, Outs1),
    child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?).
