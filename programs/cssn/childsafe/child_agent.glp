child(Reqs, Id, [P | Ps], AgentIn, [msg(From, To, group_invite(G, R?)) | NetIn], Convs, Outs, St, D?) :- (Id? =?= To?), ground(From?), ground(G?), ground(P?), ground(Ps?) | member_of(From?, [P? | Ps?], FromParent), on_group_invite(FromParent?, From?, P?, G?, Id?, R, Out, Ask, D1), send_consent_req(Ask?, P?, Id?, Outs?, Outs1), merge(Out?, AgentIn?, AgentIn1), child(Reqs?, Id?, [P? | Ps?], AgentIn1?, NetIn?, Convs?, Outs1?, St?, D2), merge(D1?, D2?, D).
