child(Reqs, Id, Ps, [enrol_response(C, enrol_no) | AgentIn], NetIn, Convs, Outs, St, D?) :- ground(C?) | show(declined(C?), Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
