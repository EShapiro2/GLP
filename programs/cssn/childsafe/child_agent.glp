child(Reqs, Id, Ps, AgentIn, [msg(_, To, approval) | NetIn], Convs, Outs, state(Al, Om, Gs, Sn), D?) :- (Id? =?= To?) | Al1 := (Al? + 1), show(approvals(Al1?), Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, state(Al1?, Om?, Gs?, Sn?), D).
