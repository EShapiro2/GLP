child([become_parent(R) | Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(R?), ground(Ps?) | member_of(R?, Ps?, Mine), offer_parent(Mine?, R?, Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs?, St?, D).
child([introduce(R, Q, S) | Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(R?), ground(Q?), ground(S?) | mint_consents(R?, S?, CR, CS), introduce(Id?, R?, Q?, S?, CR?, CS?, Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
child([send(F, T) | Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(F?) | send_friend(F?, msg(Id?, F?, text(T?)), Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
child([end_parenting(P) | Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(P?), ground(Ps?) | member_of(P?, Ps?, Mine), ask_release(Mine?, P?, Id?, Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
child([unfriend(F) | Reqs], Id, [P | Ps], AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(F?), ground(P?) | send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1), close_friend(F?, Outs1?, Outs2), show(unfriended(F?), Outs2?, Outs3), count_at(P?, Id?, withdrawal, Outs3?, Outs4), child(Reqs?, Id?, [P? | Ps?], AgentIn?, NetIn?, Convs?, Outs4?, St?, D).
child([unfriend_child(R, F) | Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(R?), ground(F?) | send_child(R?, msg(Id?, R?, unfriend_child(F?)), Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
child([create_group(N) | Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(N?) | setup_group_creator(group_id(Id?, N?), Outs?, Outs1, NetIn?, NetIn1), show(group_joined(group_id(Id?, N?)), Outs1?, Outs2), child(Reqs?, Id?, Ps?, AgentIn?, NetIn1?, Convs?, Outs2?, St?, D).
child([invite(N, F) | Reqs], Id, [P | Ps], AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(N?), ground(F?), ground(P?) | send_parent(P?, msg(Id?, P?, invite_consent_req(group_id(Id?, N?), F?, Consent)), Outs?, Outs1), invite_after(Consent?, group_id(Id?, N?), F?, P?, Out), merge(Out?, AgentIn?, AgentIn1), child(Reqs?, Id?, [P? | Ps?], AgentIn1?, NetIn?, Convs?, Outs1?, St?, D).
child([invite_child(N, C, Q) | Reqs], Id, [P | Ps], AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(N?), ground(C?), ground(Q?), ground(P?) | send_parent(P?, msg(Id?, P?, invite_consent_req(group_id(Id?, N?), C?, Consent)), Outs?, Outs1), invite_child_after(Consent?, group_id(Id?, N?), C?, Q?, P?, Id?, Outs1?, Outs2, AgentIn?, AgentIn1), child(Reqs?, Id?, [P? | Ps?], AgentIn1?, NetIn?, Convs?, Outs2?, St?, D).
child([post(G, T) | Reqs], Id, Ps, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(G?), ground(T?) | lookup_send_group(group(G?), msg(Id?, Id?, group_msg(G?, Id?, T?)), Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
