child(Reqs, Id, Ps, [outcome(_, declined(Peer)) | AgentIn], NetIn, Convs, Outs, St, D?) :- ground(Peer?) | show(declined(Peer?), Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
child(Reqs, Id, Ps, [forward_intro(C, I, Cs) | AgentIn], NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(C?) | send_child(C?, msg(Id?, C?, child_intro(I?, Cs?)), Outs?, Outs1), child(Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
