ConsentAsk ::= none ; ask(GroupId, YesNo?).

Question ::= card_w(Card) ; parentCard_w(ParentCard) ; releaseCard_w(ReleaseCard) ; groupCard_w(GroupCard) ; joinCard_w(JoinCard) ; inviteCard_w(InviteCard) ; stream_request_r(Stream(Request)?).

imported procedure agent#adult(Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Ask(Question))).

exported procedure child(Stream(Request)?, Key?, Stream(Key)?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Ask(Question))).
child(Reqs, Id, Ps, [outcome(P, consented(Peer, C?)) | AgentIn], NetIn, Convs, Outs, St, D?) :- ground(Peer?), ground(P?) | already_friend(Peer?, Outs?, Outs1, Known), commit_proposer(Known?, P?, Peer?, C, Reqs?, Id?, Ps?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
