%% the .vglp source and compile again.


Question ::= card_w(Card) ; groupCard_w(GroupCard) ; joinCard_w(JoinCard) ; inviteCard_w(InviteCard) ; stream_request_r(Stream(Request)?).

imported procedure parent#parent(Stream(Request)?, Key?, Kids?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Ask(Question))).

exported procedure agent(Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Ask(Question))).
agent(S1, S2, S3, S4, S5, S6, [ask('Stream(Request)?', stream_request_r(X)) | D?]) :- agent1(S1?, S2?, S3?, S4?, S5?, S6?, X?, D).

exported procedure agent1(Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Request)?, Stream(Ask(Question))).
agent1(Id, AgentIn, NetIn, Convs, Outs, St, Reqs, D?) :- adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?, D).

exported procedure adult(Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Ask(Question))).
adult(Reqs, Id, [group_reply(G, M, _, yes(X?)) | AgentIn], NetIn, Convs, Outs, state(Al, Om, Ps, Sn), D?) :- ground(G?), ground(M?) | setup_group_hub_side(G?, M?, Ps?, Ps1, Sn?, Sn1, Outs?, Outs1, NetIn?, NetIn1, X), show(member_joined(G?, M?), Outs1?, Outs2), adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs2?, state(Al?, Om?, Ps1?, Sn1?), D).
adult(Reqs, Id, [group_reply(_, M, _, no) | AgentIn], NetIn, Convs, Outs, St, D?) :- ground(M?) | show(declined(M?), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult(Reqs, Id, [group_joined(G, _, Ch) | AgentIn], NetIn, Convs, Outs, St, D?) :- join_commit(G?, Ch?, Outs?, Outs1, NetIn?, NetIn1), adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs1?, St?, D).
adult(Reqs, Id, AgentIn, NetIn, [conversation(Q, Ch) | Convs], Outs, St, D?) :- ground(Q?) | has_friend(Q?, Outs?, Outs1, Known), take_conv(Known?, Q?, Ch?, Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult(Reqs, Id, AgentIn, NetIn, [entered(C, Ch, Co) | Convs], Outs, St, D?) :- ground(C?), ground(Co?) | enter_parent_side(C?, Ch?, Outs?, Outs1, NetIn?, NetIn1), parent # parent(Reqs?, Id?, [kid(C?, Co?)], AgentIn?, NetIn1?, Convs?, Outs1?, St?, D).
adult(Reqs, Id, AgentIn, [msg(From, To, text(T)) | NetIn], Convs, Outs, St, D?) :- (Id? =?= To?), ground(From?) | show(received(From?, T?), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult(Reqs, Id, AgentIn, [msg(From, To, unfriend) | NetIn], Convs, Outs, St, D?) :- (Id? =?= To?), ground(From?) | close_friend(From?, Outs?, Outs1), show(unfriended(From?), Outs1?, Outs2), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?, D).
adult(Reqs, Id, AgentIn, [msg(_, To, group_invite(G, R?)) | NetIn], Convs, Outs, St, D?) :- (Id? =?= To?), ground(G?) | join_group(group(G?), A, D1), joined(A?, G?, Id?, R, Out), merge(Out?, AgentIn?, AgentIn1), adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs?, St?, D2), merge(D1?, D2?, D).
adult(Reqs, Id, AgentIn, [msg(_, _, group_msg(G, A, T)) | NetIn], Convs, Outs, state(Al, Om, Ps, Sn), D?) :- ground(G?), ground(A?), ground(T?) | add_post(post(G?, A?, T?), Ps?, Ps1), distribute_group_msg(G?, msg(A?, A?, group_msg(G?, A?, T?)), Sn?, Sn1, Outs?, Outs1), show(group_received(G?, A?, T?), Outs1?, Outs2), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, state(Al?, Om?, Ps1?, Sn1?), D).
adult(Reqs, Id, AgentIn, [msg(M, _, group_leave(G, M1)) | NetIn], Convs, Outs, St, D?) :- ground(G?), ground(M?), (M? =?= M1?) | close_output(group_member(G?, M?), Outs?, Outs1), show(member_left(G?, M?), Outs1?, Outs2), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?, D).
adult(Reqs, Id, AgentIn, [msg(_, To, group_removed(G)) | NetIn], Convs, Outs, St, D?) :- (Id? =?= To?), ground(G?) | close_output(group(G?), Outs?, Outs1), show(group_removed(G?), Outs1?, Outs2), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?, D).
adult([introduce(R, _, _) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(R?) | show(not_my_child(R?), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([declare_of_age(R) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(R?) | show(not_my_child(R?), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([send(F, T) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(F?) | send_friend(F?, msg(Id?, F?, text(T?)), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([unfriend(F) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(F?) | send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1), close_friend(F?, Outs1?, Outs2), show(unfriended(F?), Outs2?, Outs3), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs3?, St?, D).
adult([unfriend_child(R, _) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(R?) | show(not_my_child(R?), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([create_group(N) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(N?) | setup_group_creator(group_id(Id?, N?), Outs?, Outs1, NetIn?, NetIn1), show(group_joined(group_id(Id?, N?)), Outs1?, Outs2), adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs2?, St?, D).
adult([invite(N, F) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(N?), ground(F?) | send_friend(F?, msg(Id?, F?, group_invite(group_id(Id?, N?), R)), Outs?, Outs1), inject_group_reply(group_id(Id?, N?), F?, Id?, R?, AgentIn?, AgentIn1), adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs1?, St?, D).
adult([invite_child(N, C, P) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(N?), ground(C?), ground(P?) | send_friend(P?, msg(Id?, P?, group_invite_child(group_id(Id?, N?), C?, R)), Outs?, Outs1), inject_group_reply(group_id(Id?, N?), C?, Id?, R?, AgentIn?, AgentIn1), adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs1?, St?, D).
adult([post(G, T) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(G?), ground(T?) | lookup_send_group(group(G?), msg(Id?, Id?, group_msg(G?, Id?, T?)), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([leave(G) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(G?) | leave_group_commit(Id?, G?, Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([remove(N, M) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(Id?), ground(N?), ground(M?) | remove_member(Id?, group_id(Id?, N?), M?, Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([leave_child(R, _) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(R?) | show(not_my_child(R?), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).
adult([remove_child_member(R, _, _) | Reqs], Id, AgentIn, NetIn, Convs, Outs, St, D?) :- ground(R?) | show(not_my_child(R?), Outs?, Outs1), adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?, D).

procedure take_conv(Decision?, Key?, FriendChannel?, Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Ask(Question))).
take_conv(no, Q, Ch, Reqs, Id, AgentIn, NetIn, Convs, Outs, St, D?) :- adopt_conversation(Q?, Ch?, Outs?, Outs1, NetIn?, NetIn1), adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs1?, St?, D).
take_conv(yes, _, ch(_, []), Reqs, Id, AgentIn, NetIn, Convs, Outs, St, D?) :- adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?, D).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).
Event(Q, T) ::= Ask(Q) ; Input(T) ; Draw(T).
Events(Q, T) ::= [Event(Q, T) | Events(Q, T)].
Turn ::= ask ; grant ; draw.

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(_), Stream(Draw(T))?, Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, DOut, [], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) fair(Turn?, Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Events(Q, T)).
fair(ask, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(grant, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(draw, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(ask, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(grant, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(draw, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(ask, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(grant, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(draw, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).

procedure(Q, T) serve(Events(Q, T)?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve([ask(_, Q) | Es], CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve(Es?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve([input(Id, P, R) | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(input(Id?, P?, R?), Rs?, Rs1), serve(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve([draw(Id, W, V) | Es], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve(Es?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve([withdraw(Id) | Es], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve(Es?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(Path?, _?, Stream(_)).
shown(_, X, [X?]) :- ground(X?) | true.
shown(P, X, [pending(P?) | Vs?]) :- shown_whole(X?, Vs).

procedure shown_whole(_?, Stream(_)).
shown_whole(X, [X?]) :- ground(X?) | true.

procedure thread(Path?, Stream(_)?, Stream(Stream(_))).
thread(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread(_, [], [[]]).
thread(P, Xs, [[] | Vs?]) :- thread_tail(P?, Xs?, Vs).

procedure thread_tail(Path?, Stream(_)?, Stream(Stream(_))).
thread_tail(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread_tail(_, [], []).

procedure thread_cell(Path?, _?, Stream(_)?, Stream(Stream(_))).
thread_cell(P, X, Xs, Vs?) :- ground(P?) | path(P?, 1, P1), path(P?, 2, P2), shown(P1?, X?, V1), thread(P2?, Xs?, V2), cons_views(V1?, V2?, Vs).

procedure cons_views(Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_views([E | Es], [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_views([], _, []).
cons_views(_, [], []).

procedure cons_more(_?, Stream(_)?, Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_more(_, T, [E | Es], Ts, [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(E, _, Es, [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(_, _, [], [], []).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= card_w(_) ; groupCard_w(_) ; joinCard_w(_) ; inviteCard_w(_) ; stream_request_r(_) ; output(List(Output)) ; YesNo ; Request.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, Ss), output(thread(menu([form(connected, [field('Key', shown)]), form(unfriended, [field('Key', shown)]), form(received, [field('Key', shown), field('Text', shown)]), form(refused, [field('Key', shown)]), form(no_conversation, [field('Key', shown)]), form(declined, [field('Key', shown)]), form(not_my_child, [field('Key', shown)]), form(parent, [field('Key', shown)]), form(child, [field('Key', shown)]), shown, form(child_of_age, [field('Key', shown)]), shown, form(approvals, [field('Integer', shown)]), form(withdrawals, [field('Integer', shown)]), form(group_joined, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)]))]), form(member_joined, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)])), field('Key', shown)]), form(group_left, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)]))]), form(member_left, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)])), field('Key', shown)]), form(group_removed, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)]))]), form(group_received, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)])), field('Key', shown), field('Text', shown)])])), MOut?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, card_w(X), Gs, Ds?) :- present_card([], X?, Gs?, _, Vs, Done), run_card_w(Id?, form(card, [field('Intro', form(intro, [field('Parent', shown), field('Child', shown), field('OtherChild', shown)])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, groupCard_w(X), Gs, Ds?) :- present_groupCard([], X?, Gs?, _, Vs, Done), run_groupCard_w(Id?, form(card, [field('GroupOffer', form(group, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)]))])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, joinCard_w(X), Gs, Ds?) :- present_joinCard([], X?, Gs?, _, Vs, Done), run_joinCard_w(Id?, form(card, [field('JoinOffer', form(join, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)])), field('Child', shown)])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, inviteCard_w(X), Gs, Ds?) :- present_inviteCard([], X?, Gs?, _, Vs, Done), run_inviteCard_w(Id?, form(card, [field('InviteOffer', form(invite, [field('GroupId', form(group_id, [field('Creator', shown), field('Name', shown)])), field('Member', shown)])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).
construct(Id, stream_request_r(X?), Gs, Ds?) :- answer_stream_request([], X, Gs?, _, Done), run_stream_request_r(Id?, input_box(menu([form(introduce, [field('MyChild', peer), field('Friend', peer), field('FriendsChild', peer)]), form(declare_of_age, [field('MyChild', peer)]), form(send, [field('Friend', peer), field('Text', text)]), form(unfriend, [field('Friend', peer)]), form(unfriend_child, [field('MyChild', peer), field('Friend', peer)]), form(create_group, [field('Name', text)]), form(invite, [field('Name', text), field('Friend', peer)]), form(invite_child, [field('Name', text), field('FriendsChild', peer), field('Friend', peer)]), form(post, [field('GroupId', form(group_id, [field('Creator', peer), field('Name', text)])), field('Text', text)]), form(leave, [field('GroupId', form(group_id, [field('Creator', peer), field('Name', text)]))]), form(remove, [field('Name', text), field('Member', peer)]), form(leave_child, [field('MyChild', peer), field('GroupId', form(group_id, [field('Creator', peer), field('Name', text)]))]), form(remove_child_member, [field('MyChild', peer), field('Name', text), field('Member', peer)])])), [input([])], Done?, Ds).

procedure output(_?, Stream(Output)?, Stream(Draw(Drawn))).
output(W, Ms, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Ds).

procedure output_more(_?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Ds).
output_more(_, [], _, []).

procedure output_draw(_?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure form_yesNo(_?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

procedure start_card_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_card_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_card_card_2(V1?, V2?, S1?, S2?, Vs).
start_card_card_2([], _, []).
start_card_card_2(_, [], []).

procedure comb_card_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_card_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_card_card_2(V1?, V2?, S1?, S2?, Vs).
comb_card_card_2(_, _, [], [], []).

procedure present_card(Path?, Card?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_card(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_card_card_2(V1?, [input(M2?)], Vs).
present_card(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_card_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_card_wait(Path?, Card?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_card_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_card(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_card_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_card_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_card_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_card_w(Id, _, _, done, [withdraw(Id?)]).
run_card_w(Id, W, [V | Vs], Done, [draw(Id?, W?, card_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_card_w(Id?, W?, Vs?, Done?, Ds).
run_card_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure start_groupCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_groupCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_groupCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_groupCard_card_2([], _, []).
start_groupCard_card_2(_, [], []).

procedure comb_groupCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_groupCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_groupCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_groupCard_card_2(_, _, [], [], []).

procedure present_groupCard(Path?, GroupCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_groupCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_groupCard_card_2(V1?, [input(M2?)], Vs).
present_groupCard(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_groupCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_groupCard_wait(Path?, GroupCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_groupCard_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_groupCard(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_groupCard_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_groupCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_groupCard_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_groupCard_w(Id, _, _, done, [withdraw(Id?)]).
run_groupCard_w(Id, W, [V | Vs], Done, [draw(Id?, W?, groupCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_groupCard_w(Id?, W?, Vs?, Done?, Ds).
run_groupCard_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure start_joinCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_joinCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_joinCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_joinCard_card_2([], _, []).
start_joinCard_card_2(_, [], []).

procedure comb_joinCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_joinCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_joinCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_joinCard_card_2(_, _, [], [], []).

procedure present_joinCard(Path?, JoinCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_joinCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_joinCard_card_2(V1?, [input(M2?)], Vs).
present_joinCard(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_joinCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_joinCard_wait(Path?, JoinCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_joinCard_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_joinCard(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_joinCard_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_joinCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_joinCard_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_joinCard_w(Id, _, _, done, [withdraw(Id?)]).
run_joinCard_w(Id, W, [V | Vs], Done, [draw(Id?, W?, joinCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_joinCard_w(Id?, W?, Vs?, Done?, Ds).
run_joinCard_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure start_inviteCard_card_2(Stream(_)?, Stream(_)?, Stream(_)).
start_inviteCard_card_2([V1 | S1], [V2 | S2], [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_inviteCard_card_2(V1?, V2?, S1?, S2?, Vs).
start_inviteCard_card_2([], _, []).
start_inviteCard_card_2(_, [], []).

procedure comb_inviteCard_card_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_inviteCard_card_2(_, V2, [V1 | S1], S2, [card(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_inviteCard_card_2(V1?, V2?, S1?, S2?, Vs).
comb_inviteCard_card_2(_, _, [], [], []).

procedure present_inviteCard(Path?, InviteCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_inviteCard(P, card(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_inviteCard_card_2(V1?, [input(M2?)], Vs).
present_inviteCard(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_inviteCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_inviteCard_wait(Path?, InviteCard?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_inviteCard_wait(P, card(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_inviteCard(P?, card(H1?, H2), Gs?, Gs1, Vs, Done).
present_inviteCard_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_inviteCard_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_inviteCard_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_inviteCard_w(Id, _, _, done, [withdraw(Id?)]).
run_inviteCard_w(Id, W, [V | Vs], Done, [draw(Id?, W?, inviteCard_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_inviteCard_w(Id?, W?, Vs?, Done?, Ds).
run_inviteCard_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure join_request_introduce_3(Formed(MyChild)?, Formed(Friend)?, Formed(FriendsChild)?, Formed(Request)).
join_request_introduce_3(formed(X1), formed(X2), formed(X3), formed(introduce(X1?, X2?, X3?))).
join_request_introduce_3(refused, _, _, refused).
join_request_introduce_3(_, refused, _, refused).
join_request_introduce_3(_, _, refused, refused).

procedure join_request_declare_of_age_1(Formed(MyChild)?, Formed(Request)).
join_request_declare_of_age_1(formed(X1), formed(declare_of_age(X1?))).
join_request_declare_of_age_1(refused, refused).

procedure join_request_send_2(Formed(Friend)?, Formed(Text)?, Formed(Request)).
join_request_send_2(formed(X1), formed(X2), formed(send(X1?, X2?))).
join_request_send_2(refused, _, refused).
join_request_send_2(_, refused, refused).

procedure join_request_unfriend_1(Formed(Friend)?, Formed(Request)).
join_request_unfriend_1(formed(X1), formed(unfriend(X1?))).
join_request_unfriend_1(refused, refused).

procedure join_request_unfriend_child_2(Formed(MyChild)?, Formed(Friend)?, Formed(Request)).
join_request_unfriend_child_2(formed(X1), formed(X2), formed(unfriend_child(X1?, X2?))).
join_request_unfriend_child_2(refused, _, refused).
join_request_unfriend_child_2(_, refused, refused).

procedure join_request_create_group_1(Formed(Name)?, Formed(Request)).
join_request_create_group_1(formed(X1), formed(create_group(X1?))).
join_request_create_group_1(refused, refused).

procedure join_request_invite_2(Formed(Name)?, Formed(Friend)?, Formed(Request)).
join_request_invite_2(formed(X1), formed(X2), formed(invite(X1?, X2?))).
join_request_invite_2(refused, _, refused).
join_request_invite_2(_, refused, refused).

procedure join_request_invite_child_3(Formed(Name)?, Formed(FriendsChild)?, Formed(Friend)?, Formed(Request)).
join_request_invite_child_3(formed(X1), formed(X2), formed(X3), formed(invite_child(X1?, X2?, X3?))).
join_request_invite_child_3(refused, _, _, refused).
join_request_invite_child_3(_, refused, _, refused).
join_request_invite_child_3(_, _, refused, refused).

procedure join_groupId_group_id_2(Formed(Creator)?, Formed(Name)?, Formed(GroupId)).
join_groupId_group_id_2(formed(X1), formed(X2), formed(group_id(X1?, X2?))).
join_groupId_group_id_2(refused, _, refused).
join_groupId_group_id_2(_, refused, refused).

procedure form_groupId(_?, Formed(GroupId)).
form_groupId(group_id(R1, R2), F?) :- form_string(R1?, F1), form_constant(R2?, F2), join_groupId_group_id_2(F1?, F2?, F).
form_groupId(_, refused) :- otherwise | true.

procedure join_request_post_2(Formed(GroupId)?, Formed(Text)?, Formed(Request)).
join_request_post_2(formed(X1), formed(X2), formed(post(X1?, X2?))).
join_request_post_2(refused, _, refused).
join_request_post_2(_, refused, refused).

procedure join_request_leave_1(Formed(GroupId)?, Formed(Request)).
join_request_leave_1(formed(X1), formed(leave(X1?))).
join_request_leave_1(refused, refused).

procedure join_request_remove_2(Formed(Name)?, Formed(Member)?, Formed(Request)).
join_request_remove_2(formed(X1), formed(X2), formed(remove(X1?, X2?))).
join_request_remove_2(refused, _, refused).
join_request_remove_2(_, refused, refused).

procedure join_request_leave_child_2(Formed(MyChild)?, Formed(GroupId)?, Formed(Request)).
join_request_leave_child_2(formed(X1), formed(X2), formed(leave_child(X1?, X2?))).
join_request_leave_child_2(refused, _, refused).
join_request_leave_child_2(_, refused, refused).

procedure join_request_remove_child_member_3(Formed(MyChild)?, Formed(Name)?, Formed(Member)?, Formed(Request)).
join_request_remove_child_member_3(formed(X1), formed(X2), formed(X3), formed(remove_child_member(X1?, X2?, X3?))).
join_request_remove_child_member_3(refused, _, _, refused).
join_request_remove_child_member_3(_, refused, _, refused).
join_request_remove_child_member_3(_, _, refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(introduce(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), join_request_introduce_3(F1?, F2?, F3?, F).
form_request(declare_of_age(R1), F?) :- form_string(R1?, F1), join_request_declare_of_age_1(F1?, F).
form_request(send(R1, R2), F?) :- form_string(R1?, F1), form_constant(R2?, F2), join_request_send_2(F1?, F2?, F).
form_request(unfriend(R1), F?) :- form_string(R1?, F1), join_request_unfriend_1(F1?, F).
form_request(unfriend_child(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_request_unfriend_child_2(F1?, F2?, F).
form_request(create_group(R1), F?) :- form_constant(R1?, F1), join_request_create_group_1(F1?, F).
form_request(invite(R1, R2), F?) :- form_constant(R1?, F1), form_string(R2?, F2), join_request_invite_2(F1?, F2?, F).
form_request(invite_child(R1, R2, R3), F?) :- form_constant(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), join_request_invite_child_3(F1?, F2?, F3?, F).
form_request(post(R1, R2), F?) :- form_groupId(R1?, F1), form_constant(R2?, F2), join_request_post_2(F1?, F2?, F).
form_request(leave(R1), F?) :- form_groupId(R1?, F1), join_request_leave_1(F1?, F).
form_request(remove(R1, R2), F?) :- form_constant(R1?, F1), form_string(R2?, F2), join_request_remove_2(F1?, F2?, F).
form_request(leave_child(R1, R2), F?) :- form_string(R1?, F1), form_groupId(R2?, F2), join_request_leave_child_2(F1?, F2?, F).
form_request(remove_child_member(R1, R2, R3), F?) :- form_string(R1?, F1), form_constant(R2?, F2), form_string(R3?, F3), join_request_remove_child_member_3(F1?, F2?, F3?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_stream_request(Path?, Stream(Request), Inputs(Drawn)?, Inputs(Drawn), Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_stream_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_stream_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_stream_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_stream_request(Formed(Request)?, Path?, Stream(Request), Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_stream_request(formed(V), P, [V? | X1?], _, Gs, Gs1?, Done?) :- answer_stream_request(P?, X1, Gs?, Gs1, Done).
take_stream_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_stream_request(P?, X, Gs?, Gs1, Done).

procedure run_stream_request_r(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_stream_request_r(Id, _, _, done, [withdraw(Id?)]).
run_stream_request_r(Id, W, [V | Vs], Done, [draw(Id?, W?, stream_request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_stream_request_r(Id?, W?, Vs?, Done?, Ds).
run_stream_request_r(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

