%% miniapp.glp --- the child-safe social network as a mini-app of the
%% Grassroots Super-App (CSSN Section 8.1; GSG paper, Section 3).
%%
%% cssn(Id, Ui, Convs) is the goal the super-app activates by run/3, with
%% exactly its two channels.  Ui is the person channel (vGLP, Definition
%% "Person Channel, Person Writer, GLP with Persons, Grant"): on it the
%% mini-app receives the person's grants, input(Id, P, R), and shows the
%% constructs its dispatcher draws and withdraws and the screen its agent
%% writes.  Convs is the channel to the social graph, on which the social
%% graph hands the mini-app, at each invitation, one end of the root channel of
%% a conversation with the execution of this program at a friend.  The
%% mini-app holds nothing else --- no network entry, and no call to a
%% predicate that reaches the network or the person --- so the program is
%% certified.
%%
%% A party is activated as an adult, because that is what holding no parent
%% is: childhood is not given, it is made by an act, and the adult agent hands
%% the party over to the child agent when that act is taken.

imported procedure agent#agent(Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?, Stream(Ask(Question))).
imported procedure agent#dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

%% The agent with its dispatcher, the calls of the canonical compilation: the
%% agent starts with nothing of its own and its screen, and its asks --- its
%% own and the child agent's, one stream --- go to the dispatcher, which reads
%% the person channel; the screen goes to the person on the dispatcher's
%% channel to the program.
exported procedure cssn(Key?, PersonChannel(Drawn)?, Stream(Conversation)?).
cssn(Id, Ui, Convs) :-
    ground(Id?) |
    agent # agent(Id?, [], [], Convs?, [user_output(Screen)], state(0, 0, [], []), Asks),
    agent # dispatch(Asks?, Ui?, MCh),
    show_screen(MCh?, Screen?).

%% The screen onto the program's output to the person: each message's
%% content, the envelope msg(agent, person, C) stripped.
procedure show_screen(Channel(Stream(_), Stream(Output))?, Stream(ScreenMsg)?).
show_screen(ch(_, Out?), Screen) :- relay(Screen?, Out).

procedure relay(Stream(ScreenMsg)?, Stream(Output)).
relay([msg(_, _, C)|Ms], [C?|Out?]) :- relay(Ms?, Out).
relay([], []).
