%% adult.vglp --- the adult agent of the child-safe social network, in vGLP.
%%
%% The program a party runs while it is an adult and no parent: it holds no
%% parent and no child.  The
%% three agents, adult, parent and child, exclude one another: a party starts
%% here, or in the child module when it enters with its parents; this module
%% hands an adult to the parent module when a child enters with it; the parent
%% module hands it back when its last child is declared of age; and a
%% declaration of age hands a child here.  Its compilation (vGLP, Definition
%% "Canonical Compilation") is adult.glp beside this file (glpc :emit); the
%% compiled module is not edited.
%%
%% The agent is a volitional procedure whose question is the stream of the
%% person's requests, Stream(Request)?, one alternative per request; its one
%% clause asks it, once, and passes it to adult/7, ordinary GLP, which has a
%% clause per alternative and carries the rest of the stream through every
%% clause that continues the agent, and hands it on with the party.  The cards
%% it answers are self.vglp's.
%%
%% It runs as a mini-app of the Grassroots Super-App (miniapp.glp) and holds no
%% network entry: an adult's friendship is a conversation the social graph
%% opens, and every act of the contract travels a channel the agent holds.
%% The types and the helpers are ../self.glp's; the routers are
%% social/graph/routing's, exposed from the root.

imported procedure parent#parent(Stream(Request)?, Key?, Kids?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% agent(Id, AgentIn, NetIn, Convs, Outs, St): the party's name; what its cards
%% hand it; its input from the parties it is in relation with; the
%% conversations the social graph hands it; its outputs --- the screen and a
%% channel per friend and group --- and its state.  Its question is the stream
%% of the person's requests.
exported procedure (Stream(Request)?)*agent(Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% Ask the person for their requests, once, and serve them.
(Reqs)*agent(Id, AgentIn, NetIn, Convs, Outs, St) :-
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% adult(Reqs, Id, AgentIn, NetIn, Convs, Outs, St): the adult agent, with the
%% rest of the person's requests; the entry of the parent and child modules
%% back into it.
exported procedure adult(Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% --- What its cards hand it ---

%% A group invitation of its own answered yes: the member's stream opened, the
%% posts it is owed written on it, and its end of the group channel written
%% into the writer it handed over.
adult(Reqs, Id, [group_reply(G, M, yes(X?))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(G?), ground(M?) |
    setup_group_hub_side(G?, M?, St?, St1, Outs?, Outs1, NetIn?, NetIn1, X),
    show(member_joined(G?, M?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs2?, St1?).
adult(Reqs, Id, [group_reply(_, M, no)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(M?) |
    show(declined(M?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% A group joined.
adult(Reqs, Id, [group_joined(G, Ch)|AgentIn], NetIn, Convs, Outs, St) :-
    join_commit(G?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% --- What the social graph hands it ---

%% Befriend(p, q): adopting the conversation is the friendship, idempotently
%% --- a second conversation with a friend, two persons befriending each
%% other at once, is closed.
adult(Reqs, Id, AgentIn, NetIn, [conversation(Q, Ch)|Convs], Outs, St) :-
    ground(Q?) |
    has_friend(Q?, Outs?, Outs1, Known),
    take_conv(Known?, Q?, Ch?, Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Enter(p, r), or Enter with two parents(p, q, r), at p: a child enters with
%% this party as its parent at the setup of its phone, the parent-child
%% channel installed; kappa_p gains the child, and this party, a parent now,
%% runs the parent module.
adult(Reqs, Id, AgentIn, NetIn, [entered(C, Ch, Co)|Convs], Outs, St) :-
    ground(C?), ground(Co?) |
    enter_parent_side(C?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    parent # parent(Reqs?, Id?, [kid(C?, Co?)], AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% --- What the parties it is in relation with send it ---

%% Forward(q, p, x), at p: an item from a friend.
adult(Reqs, Id, AgentIn, [msg(_, To, item(X))|NetIn], Convs, Outs, St) :-
    Id? =?= To? |
    receive_item(X?, St?, St1, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

%% Unfriend(q, p), at p.
adult(Reqs, Id, AgentIn, [msg(From, To, unfriend)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    show(unfriended(From?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Join group(g, q), at q: a friend invites this party into its group.
adult(Reqs, Id, AgentIn, [msg(_, To, group_invite(G, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?) |
    join_group(group(G?), A),
    joined(A?, G?, R, Out),
    merge(Out?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% Post to group(g, p, x), at the leader a, this party: a member's post, held
%% and delivered to the members on the list now.
adult(Reqs, Id, AgentIn, [msg(_, _, group_msg(group_id(L, N), Y))|NetIn], Convs, Outs, St) :-
    L? =?= Id?, ground(L?), ground(N?) |
    hold_post(group_id(L?, N?), Y?, St?, St1, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

%% Deliver to member(g, q, y), at q, this party: the leader's delivery.
adult(Reqs, Id, AgentIn, [msg(_, _, group_msg(group_id(L, N), Z))|NetIn], Convs, Outs, St) :-
    L? =?\= Id?, ground(L?), ground(N?) |
    receive_delivery(group_id(L?, N?), Z?, St?, St1, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

%% Leave group(g, q), at the leader: a member left.
adult(Reqs, Id, AgentIn, [msg(M, _, group_leave(G, M1))|NetIn], Convs, Outs, St) :-
    ground(G?), ground(M?), M? =?= M1? |
    close_output(group_member(G?, M?), Outs?, Outs1),
    show(member_left(G?, M?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% --- The person's requests, one clause per alternative of Request ---

%% The acts of a parent: this party holds no child.
adult([introduce(R, _, _)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).
adult([declare_of_age(R)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Sign(p, x).
adult([sign(T)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    sign_item(Id?, T?, St?, St1, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

%% Forward(p, q, x).
adult([forward(F, X)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    forward_item(Id?, F?, X?, St?, St1, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

%% Unfriend(p, q), at p.
adult([unfriend(F)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?) |
    send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1),
    close_friend(F?, Outs1?, Outs2),
    show(unfriended(F?), Outs2?, Outs3),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs3?, St?).

adult([unfriend_child(R, _)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Create group(g).
adult([create_group(N)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?) |
    setup_group_leader(group_id(Id?, N?), Outs?, Outs1, NetIn?, NetIn1),
    show(group_joined(group_id(Id?, N?)), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

%% Join group(g, q), proposed by the leader.
adult([invite(N, F)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(F?) |
    send_friend(F?, msg(Id?, F?, group_invite(group_id(Id?, N?), R)), Outs?, Outs1),
    inject_group_reply(group_id(Id?, N?), F?, R?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% Child join, adult leader(g, s, p), proposed by the leader, by way of the
%% child's parent P, its friend.
adult([invite_child(N, C, P)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(C?), ground(P?) |
    send_friend(P?, msg(Id?, P?, group_invite_child(group_id(Id?, N?), C?, R)), Outs?, Outs1),
    inject_group_reply(group_id(Id?, N?), C?, R?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% Post to own group(g, x), or Post to group(g, p, x).
adult([post(G, X)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    post_item(Id?, G?, X?, St?, St1, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St1?).

%% Leave group(g, q), willed by the member q, this party.
adult([leave(G)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?) |
    leave_group_commit(Id?, G?, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

adult([leave_child(R, _)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    show(not_my_child(R?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% =============================================================================
%% Helpers that continue the agent
%% =============================================================================

procedure take_conv(Decision?, Key?, FriendChannel?, Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
take_conv(no, Q, Ch, Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    adopt_conversation(Q?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).
take_conv(yes, _, ch(_, []), Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?).
