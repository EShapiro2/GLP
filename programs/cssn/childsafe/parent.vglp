%% parent.vglp --- the parent agent of the child-safe social network, in
%% vGLP.
%%
%% The program a party runs while it is a parent: an adult with a recorded
%% child (CSSN Section 6.1, "The module is the state").  The adult module
%% hands an adult here when a child enters with it, and this module hands it
%% back when the last of its children is declared of age.  A parent is an
%% adult, so this module serves every act of the adult social network as the
%% adult module does, and the parent's role besides: introducing its child to
%% the child of a friend, approving an introduction or a group for its child,
%% ending a friendship or a membership of its child, and declaring its child
%% of age, a parent's act alone, which ends the parenting of every parent of
%% the child.  Its compilation is parent.glp beside this file (glpc :emit).
%%
%% Its question is the person's requests, asked by the adult agent and handed
%% over with the party; the cards it answers are self.vglp's.  The types and
%% the helpers are ../self.glp's; the routers are social/graph/routing's,
%% exposed from the root.

imported procedure adult#adult(Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% parent(Reqs, Id, Kids, AgentIn, NetIn, Convs, Outs, St): the parent agent,
%% with the rest of the person's requests and its children, each with its
%% co-parents.
exported procedure parent(Stream(Request)?, Key?, Kids?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% --- What its cards hand it ---

%% A group invitation of its own answered yes: the member's stream opened, the
%% posts it is owed written on it, and its end of the group channel written
%% into the writer it handed over.
parent(Reqs, Id, Kids, [group_reply(G, M, _, yes(X?))|AgentIn], NetIn, Convs, Outs, state(Al, Om, Ps, Sn)) :-
    ground(G?), ground(M?) |
    setup_group_hub_side(G?, M?, Ps?, Ps1, Sn?, Sn1, Outs?, Outs1, NetIn?, NetIn1, X),
    show(member_joined(G?, M?), Outs1?, Outs2),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn1?, Convs?, Outs2?, state(Al?, Om?, Ps1?, Sn1?)).
parent(Reqs, Id, Kids, [group_reply(_, M, _, no)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(M?) |
    show(declined(M?), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% A group joined.
parent(Reqs, Id, Kids, [group_joined(G, _, Ch)|AgentIn], NetIn, Convs, Outs, St) :-
    join_commit(G?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% --- What the social graph hands it ---

%% Befriend(p, q): adopting the conversation is the friendship, idempotently
%% --- a second conversation with a friend, two persons befriending each
%% other at once, is closed.
parent(Reqs, Id, Kids, AgentIn, NetIn, [conversation(Q, Ch)|Convs], Outs, St) :-
    ground(Q?) |
    has_friend(Q?, Outs?, Outs1, Known),
    take_conv(Known?, Q?, Ch?, Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% --- What the parties it is in relation with send it ---

parent(Reqs, Id, Kids, AgentIn, [msg(From, To, text(T))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?) |
    show(received(From?, T?), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Unfriend(q, p), at p.
parent(Reqs, Id, Kids, AgentIn, [msg(From, To, unfriend)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    show(unfriended(From?), Outs1?, Outs2),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Join group(g, q), at q: a friend invites this party into its group.
parent(Reqs, Id, Kids, AgentIn, [msg(_, To, group_invite(G, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?) |
    join_group(group(G?), A),
    joined(A?, G?, Id?, R, Out),
    merge(Out?, AgentIn?, AgentIn1),
    parent(Reqs?, Id?, Kids?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% A post in a group: held, sent on to the members on the list now where this
%% party created the group, and shown.
parent(Reqs, Id, Kids, AgentIn, [msg(_, _, group_msg(G, A, T))|NetIn], Convs, Outs, state(Al, Om, Ps, Sn)) :-
    ground(G?), ground(A?), ground(T?) |
    add_post(post(G?, A?, T?), Ps?, Ps1),
    distribute_group_msg(G?, msg(A?, A?, group_msg(G?, A?, T?)), Sn?, Sn1, Outs?, Outs1),
    show(group_received(G?, A?, T?), Outs1?, Outs2),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs2?, state(Al?, Om?, Ps1?, Sn1?)).

%% Leave group, at the creator: a member left.
parent(Reqs, Id, Kids, AgentIn, [msg(M, _, group_leave(G, M1))|NetIn], Convs, Outs, St) :-
    ground(G?), ground(M?), M? =?= M1? |
    close_output(group_member(G?, M?), Outs?, Outs1),
    show(member_left(G?, M?), Outs1?, Outs2),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Leave group, at the member: the creator removed it.
parent(Reqs, Id, Kids, AgentIn, [msg(_, To, group_removed(G))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?) |
    close_output(group(G?), Outs?, Outs1),
    show(group_removed(G?), Outs1?, Outs2),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% --- The person's requests, one clause per alternative of Request ---

parent([send(F, T)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?) |
    send_friend(F?, msg(Id?, F?, text(T?)), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Unfriend(p, q), at p.
parent([unfriend(F)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?) |
    send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1),
    close_friend(F?, Outs1?, Outs2),
    show(unfriended(F?), Outs2?, Outs3),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs3?, St?).

%% Create group(g).
parent([create_group(N)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?) |
    setup_group_creator(group_id(Id?, N?), Outs?, Outs1, NetIn?, NetIn1),
    show(group_joined(group_id(Id?, N?)), Outs1?, Outs2),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

%% Join group(g, q), proposed by the creator.
parent([invite(N, F)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(F?) |
    send_friend(F?, msg(Id?, F?, group_invite(group_id(Id?, N?), R)), Outs?, Outs1),
    inject_group_reply(group_id(Id?, N?), F?, Id?, R?, AgentIn?, AgentIn1),
    parent(Reqs?, Id?, Kids?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% Join group (child, creator an adult)(g, s, p), proposed by the creator, by
%% way of the child's parent P, its friend.
parent([invite_child(N, C, P)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(C?), ground(P?) |
    send_friend(P?, msg(Id?, P?, group_invite_child(group_id(Id?, N?), C?, R)), Outs?, Outs1),
    inject_group_reply(group_id(Id?, N?), C?, Id?, R?, AgentIn?, AgentIn1),
    parent(Reqs?, Id?, Kids?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% Post(p, a), into the group's channel.
parent([post(G, T)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?), ground(T?) |
    lookup_send_group(group(G?), msg(Id?, Id?, group_msg(G?, Id?, T?)), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group(g, q), willed by the member.
parent([leave(G)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?) |
    leave_group_commit(Id?, G?, Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group(g, q), willed by the creator.
parent([remove(N, M)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(M?) |
    remove_member(Id?, group_id(Id?, N?), M?, Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).


%% =============================================================================
%% The parent's role
%% =============================================================================

%% An introduction approved for a child of its own goes on to the child.
parent(Reqs, Id, Kids, [forward_intro(C, I, Cs)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, child_intro(I?, Cs?)), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% A group invitation approved for a child of its own goes on to the child.
parent(Reqs, Id, Kids, [forward_group(C, G, R?)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, group_invite(G?, R)), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Enter(p, r), at p: a further child enters with this party as its parent;
%% kappa_p gains it.
parent(Reqs, Id, Kids, AgentIn, NetIn, [entered(C, Ch, Co)|Convs], Outs, St) :-
    ground(C?), ground(Co?) |
    enter_parent_side(C?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    parent(Reqs?, Id?, [kid(C?, Co?)|Kids?], AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% Child befriend(r, s, p, q), at q (Section 6.4, step 2): a friend introduces
%% its child to a child of this party, which approves or not.
parent(Reqs, Id, Kids, AgentIn, [msg(_, To, child_intro(I, Cs))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(I?) |
    approve(I?, A),
    approved(A?, I?, Cs?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    parent(Reqs?, Id?, Kids?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% A child's act that took this parent's will: alpha_p or omega_p advances,
%% naming nobody.
parent(Reqs, Id, Kids, AgentIn, [msg(_, To, approval)|NetIn], Convs, Outs, state(Al, Om, Ps, Sn)) :-
    Id? =?= To? |
    Al1 := Al? + 1,
    show(approvals(Al1?), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, state(Al1?, Om?, Ps?, Sn?)).
parent(Reqs, Id, Kids, AgentIn, [msg(_, To, withdrawal)|NetIn], Convs, Outs, state(Al, Om, Ps, Sn)) :-
    Id? =?= To? |
    Om1 := Om? + 1,
    show(withdrawals(Om1?), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, state(Al?, Om1?, Ps?, Sn?)).

%% Join group (child, creator an adult)(g, s, p), at p: a friend invites a
%% child of this party into its group.
parent(Reqs, Id, Kids, AgentIn, [msg(_, To, group_invite_child(G, C, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(C?) |
    approve_join(join(G?, C?), A),
    forward_join(A?, C?, G?, R, Out),
    merge(Out?, AgentIn?, AgentIn1),
    parent(Reqs?, Id?, Kids?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% Join group (child creator)(g, s, p, q), at q: a child of this party,
%% invited by a friend that is a child, asks its consent.
parent(Reqs, Id, Kids, AgentIn, [msg(C, To, group_consent_req(G, Consent?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(C?) |
    approve_join(join(G?, C?), Consent),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Join group (child creator)(g, s, p, q), at p: a child of this party, the
%% creator, asks its consent to invite a member.
parent(Reqs, Id, Kids, AgentIn, [msg(_, To, invite_consent_req(G, M, Consent?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(M?) |
    approve_invite(invite(G?, M?), Consent),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Declare of age with two parents(q, p, r), at p: the other parent declared
%% the child of age, and the child tells this one; kappa_p loses the child,
%% gamma_p its co-parent.
parent(Reqs, Id, Kids, AgentIn, [msg(C, To, of_age_notice)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(C?), ground(Kids?) |
    close_child(C?, Outs?, Outs1),
    show(child_of_age(C?), Outs1?, Outs2),
    remove_kid(C?, Kids?, Kids1),
    after_kids(Kids1?, Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Child befriend(r, s, p, q), proposed by p (Section 6.4, step 1): p mints
%% the two consent variables and introduces its child R to the child S of its
%% friend Q, or, where Q is p itself, to another child of its own --- the
%% sibling case, where the two parents are one.
parent([introduce(R, Q, S)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(Q?), ground(S?) |
    mint_consents(R?, S?, CR, CS),
    introduce(Id?, R?, Q?, S?, CR?, CS?, Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Declare of age(p, r), or with two parents, willed by p alone: the child is
%% told on the parent-child channel, which is then torn down; kappa_p loses
%% the child.  The child tells its other parent, if it has one.
parent([declare_of_age(R)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?), ground(Kids?) |
    kid_of(R?, Kids?, Mine),
    declare(Mine?, R?, Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Child unfriend(r, s, p, q), willed by p: it tells its child R, which holds
%% the friendship; p holds no record of whom R befriended.
parent([unfriend_child(R, F)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(F?) |
    send_child(R?, msg(Id?, R?, unfriend_child(F?)), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group (child)(g, s, p), willed by the parent p: it tells its child.
parent([leave_child(R, G)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(G?) |
    send_child(R?, msg(Id?, R?, leave_group(G?)), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group (child creator)(g, s, p, q), willed by the creator's parent p:
%% it tells its child, the creator, which holds the member list.
parent([remove_child_member(R, N, M)|Reqs], Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(N?), ground(M?) |
    send_child(R?, msg(Id?, R?, remove_member(group_id(R?, N?), M?)), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% =============================================================================
%% Helpers that continue the agent
%% =============================================================================

procedure take_conv(Decision?, Key?, FriendChannel?, Stream(Request)?, Key?, Kids?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
take_conv(no, Q, Ch, Reqs, Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    adopt_conversation(Q?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).
take_conv(yes, _, ch(_, []), Reqs, Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Declaring a child of its own of age; a party that is not one is not
%% declared, and the screen says so.
procedure declare(Decision?, Key?, Stream(Request)?, Key?, Kids?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
declare(yes, R, Reqs, Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?) |
    send_child(R?, msg(Id?, R?, of_age), Outs?, Outs1),
    close_child(R?, Outs1?, Outs2),
    show(child_of_age(R?), Outs2?, Outs3),
    remove_kid(R?, Kids?, Kids1),
    after_kids(Kids1?, Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs3?, St?).
declare(no, R, Reqs, Id, Kids, AgentIn, NetIn, Convs, Outs, St) :-
    show(not_my_child(R?), Outs?, Outs1),
    parent(Reqs?, Id?, Kids?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% With no child left the party is an adult and no parent, and runs the adult
%% module; with one left it is a parent still.
procedure after_kids(Kids?, Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
after_kids([], Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    adult # adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?).
after_kids([K|Ks], Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    parent(Reqs?, Id?, [K?|Ks?], AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Whether R is a child of this party, and its children less R.
procedure kid_of(Key?, Kids?, Decision).
kid_of(R, [kid(R1, _)|_], yes) :- R? =?= R1? | true.
kid_of(R, [_|Ks], D?) :- otherwise | kid_of(R?, Ks?, D).
kid_of(_, [], no).

procedure remove_kid(Key?, Kids?, Kids).
remove_kid(R, [kid(R1, _)|Ks], Ks?) :- R? =?= R1? | true.
remove_kid(R, [K|Ks], [K?|Ks1?]) :- otherwise | remove_kid(R?, Ks?, Ks1).
remove_kid(_, [], []).
