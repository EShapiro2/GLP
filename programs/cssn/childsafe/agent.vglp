%% agent.vglp --- the adult agent of the child-safe social network, in vGLP.
%%
%% The program every party runs while it holds no parent, which is what being
%% an adult is (CSSN Section 8.1).  Becoming a child hands the party over to
%% the child agent (child_agent.vglp), and the child agent hands it back when
%% its last parenting ends: which module a party runs is part of its state.
%% Its compilation (vGLP, Definition "Canonical Compilation") is agent.glp
%% beside this file (glpc :emit); the compiled module is not edited.
%%
%% The agent is a volitional procedure whose question is the stream of the
%% person's requests, Stream(Request)?, one alternative per request; its one
%% clause asks it, once, and passes it to adult/7, ordinary GLP, which has a
%% clause per alternative and carries the rest of the stream through every
%% clause that continues the agent --- and hands it to the child agent.  The
%% cards a party answers are self.vglp's, shared with the child agent.
%%
%% It runs as a mini-app of the Grassroots Super-App (miniapp.glp) and holds no
%% network entry: an adult's friendship is a conversation the social graph
%% opens, and every act of the contract travels a channel the agent holds ---
%% a conversation, a parent-child channel, a friendship a parent's
%% introduction made, a group's.
%%
%% The types and the helpers are ../self.glp's; the routers send_user,
%% send_friend, send_child, add_friend_output and close_friend are
%% social/graph/routing's, exposed from the root.

imported procedure child_agent#child(Stream(Request)?, Key?, Stream(Key)?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% agent(Id, AgentIn, NetIn, Convs, Outs, St): the party's name; what its cards
%% hand it; its input from the parties it is in relation with; the
%% conversations the social graph hands it; its outputs --- the screen and a
%% channel per friend, child and group --- and its state.  Its question is the
%% stream of the person's requests.
exported procedure (Stream(Request)?)*agent(Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% Ask the person for their requests, once, and serve them.
(Reqs)*agent(Id, AgentIn, NetIn, Convs, Outs, St) :-
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% adult(Reqs, Id, AgentIn, NetIn, Convs, Outs, St): the adult agent, with the
%% rest of the person's requests; the child agent's entry back into it.
exported procedure adult(Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).

%% --- What its cards hand it ---

%% An introduction approved for a child of its own goes on to the child.
adult(Reqs, Id, [forward_intro(C, I, Cs)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, child_intro(I?, Cs?)), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Parent and child(p, r), at r: the person accepted P as its parent.  The
%% child allocates the parent-child channel and conveys P's end; rho_r gains
%% P, so this party is a child, and runs the child agent.
adult(Reqs, Id, [become_child(P, Resp?)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(P?) |
    enrol_child_side(P?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    child_agent # child(Reqs?, Id?, [P?], AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% Parent and child(p, r), at p: the child accepted; kappa_p gains it.
adult(Reqs, Id, [enrol_response(C, enrol_accept(Ch))|AgentIn], NetIn, Convs, Outs, St) :-
    ground(C?) |
    enrol_commit(C?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).
adult(Reqs, Id, [enrol_response(C, enrol_no)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(C?) |
    show(declined(C?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% End parenting(r, p), at p: the person agreed; the grant goes on the
%% parent-child channel, which is then torn down; kappa_p loses the child.
adult(Reqs, Id, [release(C)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, release_grant), Outs?, Outs1),
    close_child(C?, Outs1?, Outs2),
    show(child_ended(C?), Outs2?, Outs3),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs3?, St?).

%% A group invitation of its own answered yes: the member's stream opened, the
%% posts it is owed written on it, and its end of the group channel written
%% into the writer it handed over.
adult(Reqs, Id, [group_reply(G, M, _, yes(X?))|AgentIn], NetIn, Convs, Outs, state(Al, Om, Ps, Sn)) :-
    ground(G?), ground(M?) |
    setup_group_hub_side(G?, M?, Ps?, Ps1, Sn?, Sn1, Outs?, Outs1, NetIn?, NetIn1, X),
    show(member_joined(G?, M?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs2?, state(Al?, Om?, Ps1?, Sn1?)).
adult(Reqs, Id, [group_reply(_, M, _, no)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(M?) |
    show(declined(M?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% A group joined.
adult(Reqs, Id, [group_joined(G, _, Ch)|AgentIn], NetIn, Convs, Outs, St) :-
    join_commit(G?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).

%% A group invitation approved for a child of its own goes on to the child.
adult(Reqs, Id, [forward_group(C, G, R?)|AgentIn], NetIn, Convs, Outs, St) :-
    ground(Id?), ground(C?) |
    send_child(C?, msg(Id?, C?, group_invite(G?, R)), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% --- A conversation the social graph opens ---

%% Befriend(p, q): adopting the conversation is the friendship, idempotently
%% --- a second conversation with a friend, two persons befriending each
%% other at once, is closed.
adult(Reqs, Id, AgentIn, NetIn, [conversation(Q, Ch)|Convs], Outs, St) :-
    ground(Q?) |
    has_friend(Q?, Outs?, Outs1, Known),
    take_conv(Known?, Q?, Ch?, Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% --- What the parties it is in relation with send it ---

adult(Reqs, Id, AgentIn, [msg(From, To, text(T))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?) |
    show(received(From?, T?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Unfriend(q, p), at p.
adult(Reqs, Id, AgentIn, [msg(From, To, unfriend)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    show(unfriended(From?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Child befriend(r, s, p, q), at q (Section 8.4, step 2): a friend introduces
%% its child to a child of this party, which approves or not.
adult(Reqs, Id, AgentIn, [msg(_, To, child_intro(I, Cs))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(I?) |
    approve(I?, A),
    approved(A?, I?, Cs?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% Parent and child(p, r), at r: the offer, put to the person.
adult(Reqs, Id, AgentIn, [msg(_, To, enrol(P, Resp?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(P?) |
    accept_parent(parent(P?), A),
    parent_answer(A?, P?, Resp, Out),
    merge(Out?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% End parenting(r, p), at p: a child asks; the obligation to answer is the
%% parent's (Appendix A, "What the Contract Records").
adult(Reqs, Id, AgentIn, [msg(C, To, release_request)|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(C?) |
    agree_release(release(C?), A),
    release_answer(A?, C?, Out),
    merge(Out?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% A child's act that took this parent's will: alpha_p or omega_p advances,
%% naming nobody.
adult(Reqs, Id, AgentIn, [msg(_, To, approval)|NetIn], Convs, Outs, state(Al, Om, Ps, Sn)) :-
    Id? =?= To? |
    Al1 := Al? + 1,
    show(approvals(Al1?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, state(Al1?, Om?, Ps?, Sn?)).
adult(Reqs, Id, AgentIn, [msg(_, To, withdrawal)|NetIn], Convs, Outs, state(Al, Om, Ps, Sn)) :-
    Id? =?= To? |
    Om1 := Om? + 1,
    show(withdrawals(Om1?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, state(Al?, Om1?, Ps?, Sn?)).

%% Join group(g, q), at q: a friend invites this party into its group.
adult(Reqs, Id, AgentIn, [msg(_, To, group_invite(G, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?) |
    join_group(group(G?), A),
    joined(A?, G?, Id?, R, Out),
    merge(Out?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% Join group (child, creator an adult)(g, s, p), at p: a friend invites a
%% child of this party into its group.
adult(Reqs, Id, AgentIn, [msg(_, To, group_invite_child(G, C, R?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(C?) |
    approve_join(join(G?, C?), A),
    forward_join(A?, C?, G?, R, Out),
    merge(Out?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs?, St?).

%% Join group (child creator)(g, s, p, q), at q: a child of this party,
%% invited by a friend that is a child, asks its consent.
adult(Reqs, Id, AgentIn, [msg(C, To, group_consent_req(G, Consent?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(C?) |
    approve_join(join(G?, C?), Consent),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% Join group (child creator)(g, s, p, q), at p: a child of this party, the
%% creator, asks its consent to invite a member.
adult(Reqs, Id, AgentIn, [msg(_, To, invite_consent_req(G, M, Consent?))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?), ground(M?) |
    approve_invite(invite(G?, M?), Consent),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?).

%% A post in a group: held, sent on to the members on the list now where this
%% party created the group, and shown.
adult(Reqs, Id, AgentIn, [msg(_, _, group_msg(G, A, T))|NetIn], Convs, Outs, state(Al, Om, Ps, Sn)) :-
    ground(G?), ground(A?), ground(T?) |
    add_post(post(G?, A?, T?), Ps?, Ps1),
    distribute_group_msg(G?, msg(A?, A?, group_msg(G?, A?, T?)), Sn?, Sn1, Outs?, Outs1),
    show(group_received(G?, A?, T?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, state(Al?, Om?, Ps1?, Sn1?)).

%% Leave group, at the creator: a member left.
adult(Reqs, Id, AgentIn, [msg(M, _, group_leave(G, M1))|NetIn], Convs, Outs, St) :-
    ground(G?), ground(M?), M? =?= M1? |
    close_output(group_member(G?, M?), Outs?, Outs1),
    show(member_left(G?, M?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% Leave group, at the member: the creator removed it.
adult(Reqs, Id, AgentIn, [msg(_, To, group_removed(G))|NetIn], Convs, Outs, St) :-
    Id? =?= To?, ground(G?) |
    close_output(group(G?), Outs?, Outs1),
    show(group_removed(G?), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs2?, St?).

%% --- The person's requests, one clause per alternative of Request ---

%% Parent and child(p, r), at p: the offer travels the conversation with r;
%% with none open it is not sent, and the screen says so.  Becoming a parent
%% asks nothing more of an adult (Appendix A, "No Gatekeeping").
adult([become_parent(R)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(R?) |
    has_friend(R?, Outs?, Outs1, Open),
    offer_parent(Open?, R?, Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Child befriend(r, s, p, q), proposed by p (Section 8.4, step 1): p mints
%% the two consent variables and introduces its child R to the child S of its
%% friend Q, or, where Q is p itself, to another child of its own --- the
%% sibling case, where the two parents are one.
adult([introduce(R, Q, S)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(Q?), ground(S?) |
    mint_consents(R?, S?, CR, CS),
    introduce(Id?, R?, Q?, S?, CR?, CS?, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

adult([send(F, T)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?) |
    send_friend(F?, msg(Id?, F?, text(T?)), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% An adult holds no parent, so has no parenting to end.
adult([end_parenting(P)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(P?) |
    show(not_my_parent(P?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Unfriend(p, q), at p.
adult([unfriend(F)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(F?) |
    send_friend(F?, msg(Id?, F?, unfriend), Outs?, Outs1),
    close_friend(F?, Outs1?, Outs2),
    show(unfriended(F?), Outs2?, Outs3),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs3?, St?).

%% Child unfriend(r, s, p, q), willed by p: it tells its child R, which holds
%% the friendship; p holds no record of whom R befriended.
adult([unfriend_child(R, F)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(F?) |
    send_child(R?, msg(Id?, R?, unfriend_child(F?)), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Create group(g).
adult([create_group(N)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?) |
    setup_group_creator(group_id(Id?, N?), Outs?, Outs1, NetIn?, NetIn1),
    show(group_joined(group_id(Id?, N?)), Outs1?, Outs2),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs2?, St?).

%% Join group(g, q), proposed by the creator.
adult([invite(N, F)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(F?) |
    send_friend(F?, msg(Id?, F?, group_invite(group_id(Id?, N?), R)), Outs?, Outs1),
    inject_group_reply(group_id(Id?, N?), F?, Id?, R?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% Join group (child, creator an adult)(g, s, p), proposed by the creator, by
%% way of the child's parent P, its friend.
adult([invite_child(N, C, P)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(C?), ground(P?) |
    send_friend(P?, msg(Id?, P?, group_invite_child(group_id(Id?, N?), C?, R)), Outs?, Outs1),
    inject_group_reply(group_id(Id?, N?), C?, Id?, R?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).

%% Post(p, a), into the group's channel.
adult([post(G, T)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?), ground(T?) |
    lookup_send_group(group(G?), msg(Id?, Id?, group_msg(G?, Id?, T?)), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group(g, q), willed by the member.
adult([leave(G)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(G?) |
    leave_group_commit(Id?, G?, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group(g, q), willed by the creator.
adult([remove(N, M)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(N?), ground(M?) |
    remove_member(Id?, group_id(Id?, N?), M?, Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group (child)(g, s, p), willed by the parent p: it tells its child.
adult([leave_child(R, G)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(G?) |
    send_child(R?, msg(Id?, R?, leave_group(G?)), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% Leave group (child creator)(g, s, p, q), willed by the creator's parent p:
%% it tells its child, the creator, which holds the member list.
adult([remove_child_member(R, N, M)|Reqs], Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?), ground(R?), ground(N?), ground(M?) |
    send_child(R?, msg(Id?, R?, remove_member(group_id(R?, N?), M?)), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).

%% =============================================================================
%% Helpers that continue the agent
%% =============================================================================

procedure take_conv(Decision?, Key?, FriendChannel?, Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
take_conv(no, Q, Ch, Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    adopt_conversation(Q?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    adult(Reqs?, Id?, AgentIn?, NetIn1?, Convs?, Outs1?, St?).
take_conv(yes, _, ch(_, []), Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs?, St?).

procedure offer_parent(Decision?, Key?, Stream(Request)?, Key?, Stream(AgentIn)?, Stream(FriendMsg)?, Stream(Conversation)?, Stream(OutputEntry)?, AgentState?).
offer_parent(yes, R, Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    ground(Id?) |
    send_friend(R?, msg(Id?, R?, enrol(Id?, Resp)), Outs?, Outs1),
    inject_enrol_response(Resp?, R?, AgentIn?, AgentIn1),
    adult(Reqs?, Id?, AgentIn1?, NetIn?, Convs?, Outs1?, St?).
offer_parent(no, R, Reqs, Id, AgentIn, NetIn, Convs, Outs, St) :-
    show(no_conversation(R?), Outs?, Outs1),
    adult(Reqs?, Id?, AgentIn?, NetIn?, Convs?, Outs1?, St?).
