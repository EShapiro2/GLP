%% child_agent.glp — Child agent module (CSSN, full groups + blocking consent)
%%
%% Exports: child_agent/6
%% Types and helpers (merge, setup_group_*, approvals): from self.glp (ancestor
%% scoping)
%% await_group_channel, child_consent_wait: local (call child_agent recursively)
%%
%% CSSN child_agent handles befriending via parental introductions, messaging,
%% group creation/inviting/joining/messaging, and blocking parental consent
%% for child-managed group invites (consent flow 3).
%%
%% Childhood is not given:
%%   - A party does not boot as a child.  It becomes one by accepting the offer
%%     to become parent and child, which is where agent hands over to this
%%     module, and stops being one when the parenting ends, which is where this
%%     module hands back.  ParentId is therefore set by the act, not by boot, and
%%     rho_r is the parent_output entry the act created.  There is no declaring
%%     of age: a party is a child exactly while it holds a parent.
%%   - A child friendship or membership that commits, and one that ends, are
%%     reported to the parent as a bare approval or withdrawal, naming nobody.
%%   - A CHILD MAY BE A PARENT.  Becoming a parent asks nothing of the party that
%%     becomes one, and no clause of a grassroots contract may gate the act by
%%     which two strangers come into relation, so this module carries the whole
%%     parent role as well: offering, adopting the channel the child conveys,
%%     ending the parenting, and the counts its own children's acts leave here.

%% =============================================================================
%% IMPORTED PROCEDURES
%% =============================================================================

%% Release hands the agent back to the adult agent; enrol hands it here.  The
%% two modules import each other.
imported procedure agent#agent(Constant?, AgentState?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?).

%% =============================================================================
%% AWAIT_GROUP_CHANNEL — local (calls merge and child_agent)
%% =============================================================================

%% A child's membership commits here, and a parent of the child is a party to it,
%% so the parent's approval count advances --- at the commit, and naming nobody.
procedure await_group_channel(Constant?, Constant?, AgentState?, GroupId?, Stream(GroupSetupResponse)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?).
await_group_channel(Id, ParentId, St, GroupId, [group_channel(ch(FromHub, ToHub?))|_],
        UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?) |
    add_group_output(group(GroupId?), ToHub, Outs?, Outs1),
    merge(NetIn?, FromHub?, NetIn1),
    send_user( msg(agent, person, group_joined(GroupId?)),
        Outs1?, Outs2),
    send_parent(ParentId?, msg(Id?, ParentId?, approval), Outs2?, Outs3),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn1?, Outs3?).
await_group_channel(_, _, _, _, [], _, _, _) :- true.

%% =============================================================================
%% CHILD_CONSENT_WAIT/9 — blocking consent for child-managed group invites
%% =============================================================================

procedure child_consent_wait(Decision?, Constant?, Constant?, AgentState?, GroupId?,
    Channel(Stream(GroupSetupResponse), Stream(IntroContent))?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?).

%% Parent approved — present invite to child's UI
child_consent_wait(yes, Id, ParentId, St, GroupId, Ch, UserIn, NetIn, Outs) :-
    ground(Id?) |
    send_user( msg(agent, person, group_invite(GroupId?, Ch?)),
        Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Parent rejected — nack the invite channel, move on
child_consent_wait(no, Id, ParentId, St, _, ch(_, [nack|[]]), UserIn, NetIn, Outs) :-
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

%% =============================================================================
%% DECLINING COLD CALLS — a child's friendships come through its parent
%% =============================================================================

procedure decline_intro(Response).
decline_intro(no).

procedure decline_enrol(EnrolResponse).
decline_enrol(enrol_no).

%% =============================================================================
%% CHILD_AGENT/6 — Main loop
%% =============================================================================

exported procedure child_agent(Constant?, Constant?, AgentState?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?).

%% --- Ending the parenting ---

%% The child asks its parent to end it.  The parent owes it and answers on the
%% parent-child channel; a refusal is an act not taken and leaves no record.
child_agent(Id, ParentId, St, [msg(person, Id1, request_release)|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    send_parent(ParentId?, msg(Id?, ParentId?, release_request), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Ended.  rho_r loses the parent and so is empty, which IS being an adult: the
%% agent is an adult agent again, and nothing is counted or declared to make it
%% one.  That is what lets it befriend with no parent among the guards.
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, release_grant)|NetIn], Outs) :-
    Id? =?= Id1?, From? =?= ParentId? |
    close_parent(ParentId?, Outs?, Outs1),
    send_user( msg(agent, person, released(ParentId?)), Outs1?, Outs2),
    agent # agent(Id?, St?, UserIn?, NetIn?, Outs2?).

%% --- The parent role, which a child may hold too ---
%%
%% Becoming a parent asks nothing of the party that becomes one, and Section
%% "No Gatekeeping" shows no clause of a grassroots contract may gate the act by
%% which two strangers come into relation.  So a party that is a child carries
%% the whole parent role, and these clauses are its half of it.  Its own parent
%% is reached by send_parent and its children by send_child: rho_r and kappa_r
%% are different entries of the outputs list and never collide.
%%
%% Where the adult agent uses `otherwise` to separate the sibling case of an
%% introduction, this module uses negated equality: an `otherwise` here would
%% wait on the clauses reading this child's own network input.

%% Offer to become a parent of another party.
child_agent(Id, ParentId, St, [msg(person, Id1, enrol_child(Child))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Child?) |
    send_net( msg(Child?, enrol(Id?, Resp)), Outs?, Outs1),
    inject_enrol_response(Resp?, Child?, UserIn?, UserIn1),
    child_agent(Id?, ParentId?, St?, UserIn1?, NetIn?, Outs1?).

%% The other party accepted: adopt the channel it conveyed.  kappa_r gains it.
child_agent(Id, ParentId, St, [enrol_response(Child, enrol_accept(Ch))|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Child?) |
    enrol_commit(Child?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn1?, Outs1?).

%% It declined.
child_agent(Id, ParentId, St, [enrol_response(Child, enrol_no)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user( msg(agent, person, rejected(Child?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% End the parenting of a child of ours.
child_agent(Id, ParentId, St, [msg(person, Id1, approve_release(Child))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Child?) |
    send_child(Child?, msg(Id?, Child?, release_grant), Outs?, Outs1),
    close_child(Child?, Outs1?, Outs2),
    send_user( msg(agent, person, released(Child?)), Outs2?, Outs3),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs3?).

%% Introduce two children of our own to each other.
child_agent(Id, ParentId, St, [msg(person, Id1, child_introduce(Child1, Friend, Child2))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, Friend? =?= Id?,
    ground(Child1?), ground(Child2?),
    new_channel(C1Ch, C2Ch) |
    send_child(Child1?, msg(Id?, Child1?, child_intro(Child2?, C1Ch?)), Outs?, Outs1),
    send_child(Child2?, msg(Id?, Child2?, child_intro(Child1?, C2Ch?)), Outs1?, Outs2),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs2?).

%% Introduce a child of our own to a child of a friend.
child_agent(Id, ParentId, St, [msg(person, Id1, child_introduce(MyChild, Friend, FriendChild))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ~(Friend? =?= Id?),
    ground(MyChild?), ground(Friend?), ground(FriendChild?),
    new_channel(C1Ch, C2Ch) |
    send_child(MyChild?, msg(Id?, MyChild?, child_intro(FriendChild?, C1Ch?)), Outs?, Outs1),
    send_friend(Friend?, msg(Id?, Friend?, child_intro(MyChild?, C2Ch?)), Outs1?, Outs2),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs2?).

%% Approve an introduction for a child of our own — forward it on.
child_agent(Id, ParentId, St, [msg(person, Id1, approve_child_intro(OtherChild, MyChild, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(OtherChild?), ground(MyChild?) |
    send_child(MyChild?, msg(Id?, MyChild?, child_intro(OtherChild?, Ch?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Approve a group invite for a child of our own — forward it on.
child_agent(Id, ParentId, St, [msg(person, Id1, approve_group(Child, GroupId, group_channel(Ch)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    send_child(Child?, msg(Id?, Child?, group_invite(GroupId?, Ch?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Answer a consent request from a child of our own.
child_agent(Id, ParentId, St, [msg(person, Id1, approve_child_group(_, _, consent(yes)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

child_agent(Id, ParentId, St, [msg(person, Id1, reject_child_group(_, _, consent(no)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

%% Tell a child of our own to leave a group.
child_agent(Id, ParentId, St, [msg(person, Id1, leave_child_group(Child, GroupId))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Child?), ground(GroupId?) |
    send_child(Child?, msg(Id?, Child?, leave_group(GroupId?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% End a friendship of a child of our own.  Nothing is looked up and nothing
%% checked: our approvals name nobody.
child_agent(Id, ParentId, St, [msg(person, Id1, unfriend_child_of(MyChild, Target))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(MyChild?), ground(Target?) |
    send_child(MyChild?, msg(Id?, MyChild?, unfriend_child(Target?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% End a child's membership of a group a child of our own created: the fourth
%% role of child_leave_2.  A party that is a child carries this like every other
%% part of the parent role --- the creator it names is a child of ITS OWN, and
%% its own parent is a different entry of the outputs list.  Nothing is looked up:
%% the member list belongs to the creator, so this clause tells it and the
%% creator's clause carries the removal out.
child_agent(Id, ParentId, St, [msg(person, Id1, remove_child_member(MyChild, GroupId, Member))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(MyChild?), ground(GroupId?), ground(Member?) |
    send_child(MyChild?, msg(Id?, MyChild?, remove_member(GroupId?, Member?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% --- User messages ---

%% Send text to friend
child_agent(Id, ParentId, St, [msg(person, Id1, send(Target, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    send_friend(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Accept child intro — send ack, await peer
child_agent(Id, ParentId, St, [msg(person, Id1, accept_child_intro(Other, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, UserIn?, UserIn1),
    child_agent(Id?, ParentId?, St?, UserIn1?, NetIn?, Outs?).

%% Reject child intro — send nack
child_agent(Id, ParentId, St, [msg(person, Id1, reject_child_intro(_, channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

%% --- Group user messages ---

%% Child creates a group
child_agent(Id, ParentId, St, [msg(person, Id1, create_group(Name))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Name?) |
    setup_group_creator(group_id(Id?, Name?),
        Outs?, Outs1, NetIn?, NetIn1),
    send_user( msg(agent, person, group_joined(group_id(Id?, Name?))),
        Outs1?, Outs2),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn1?, Outs2?).

%% Child invites friend to group
child_agent(Id, ParentId, St, [msg(person, Id1, invite_group(GroupId, Invitee))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Invitee?),
    new_channel(InviteeCh, CreatorCh) |
    send_friend(Invitee?,
        msg(Id?, Invitee?, group_invite(GroupId?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Invitee?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    child_agent(Id?, ParentId?, St?, UserIn1?, NetIn?, Outs1?).

%% Child accepts group invite
child_agent(Id, ParentId, St, [msg(person, Id1, accept_group(GroupId,
        group_channel(ch(ChRead, [ack(Id?)|[]]))))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    await_group_channel(Id?, ParentId?, St?, GroupId?, ChRead?, UserIn?, NetIn?, Outs?).

%% Child rejects group invite — send nack, close channel
child_agent(Id, ParentId, St, [msg(person, Id1, reject_group(_, group_channel(ch(_, [nack|[]]))))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

%% Child sends group message
child_agent(Id, ParentId, St, [msg(person, Id1, send_group(GroupId, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Text?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_msg(GroupId?, Id?, Text?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% The creator of a group of ours removes a member.  This is the creator's role
%% of child_leave_2, the four-role ending of child_join_2: a child that created
%% a group is one of the four who may end a child's membership of it, and until
%% now it was the one that could not.  Our own parent takes a withdrawal, the
%% removed child's parent taking the other when group_removed reaches it.
child_agent(Id, ParentId, St, [msg(person, Id1, remove_from_group(GroupId, Member))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Member?) |
    remove_member_commit(Id?, ParentId?, GroupId?, Member?, Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Child leaves group (own choice).  A child's leaving is guarded by any one of
%% the creator, the child and a parent of it, and advances that parent's
%% withdrawal count whichever of them willed it.
child_agent(Id, ParentId, St, [msg(person, Id1, leave_group(GroupId))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_leave(GroupId?, Id?)), Outs?, Outs1),
    close_output(group(GroupId?), Outs1?, Outs2),
    send_user( msg(agent, person, group_left(GroupId?)), Outs2?, Outs3),
    send_parent(ParentId?, msg(Id?, ParentId?, withdrawal), Outs3?, Outs4),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs4?).

%% Child initiates unfriend.  The parent is told, and its withdrawal count
%% advances; it names nobody, so nothing it holds says which friendship ended.
child_agent(Id, ParentId, St, [msg(person, Id1, unfriend_child(Target))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    send_friend(Target?, msg(Id?, Target?, unfriend), Outs?, Outs1),
    close_friend(Target?, Outs1?, Outs2),
    send_parent(ParentId?, msg(Id?, ParentId?, withdrawal), Outs2?, Outs3),
    send_user( msg(agent, person, unfriended(Target?)), Outs3?, Outs4),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs4?).

%% --- Injected intro results ---

%% Intro result: peer acked — idempotent befriend commit with smaller-name
%% tie-break, then tell the parent, whose approval is part of the same
%% transaction.
child_agent(Id, ParentId, St, [intro_result(Other, Ch)|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Other?) |
    befriend_commit(Id?, Other?, Ch?, Outs?, Outs1, NetIn?, NetIn1),
    send_parent(ParentId?, msg(Id?, ParentId?, approval), Outs1?, Outs2),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn1?, Outs2?).

%% Intro result: peer nacked — notify rejected
child_agent(Id, ParentId, St, [intro_rejected(Other)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    send_user( msg(agent, person, rejected(Other?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% --- Injected group results ---

%% Group join ack — creator wires hub-side, sends member-end channel, and writes
%% on it every post of the group this creator holds: the joiner is owed them.
child_agent(Id, ParentId, state(Al, Om, Ps, Sn), [group_join_ack(GroupId, Invitee, ch(_, [group_channel(MemberEnd?)|[]]))|UserIn],
        NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    setup_group_hub_side(GroupId?, Invitee?, Ps?, Ps1, Sn?, Sn1, Outs?, Outs1, NetIn?, NetIn1, MemberEnd),
    send_user( msg(agent, person, group_joined_member(GroupId?, Invitee?)),
        Outs1?, Outs2),
    child_agent(Id?, ParentId?, state(Al?, Om?, Ps1?, Sn1?), UserIn?, NetIn1?, Outs2?).

%% Group join nack — nothing to clean up
child_agent(Id, ParentId, St, [group_join_nack(_, _)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

%% --- Cold calls a child does not take ---

%% A child's friendships are established through parental introductions, so a
%% cold call is declined without troubling the person.  Before v3 a child had no
%% network entry at all and none could arrive; it has one now, because an
%% enrolment offer has nowhere else to reach it.
child_agent(Id, ParentId, St, UserIn, [msg(Id1, intro(_, Resp?))|NetIn], Outs) :-
    Id? =?= Id1? |
    decline_intro(Resp),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

%% A party already enrolled declines a further enrolment.
child_agent(Id, ParentId, St, UserIn, [msg(Id1, enrol(_, Resp?))|NetIn], Outs) :-
    Id? =?= Id1? |
    decline_enrol(Resp),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs?).

%% --- Network messages from parent (From =?= ParentId) ---

%% Parent sends child_intro — present to UI
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, child_intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, From? =?= ParentId?, ground(Other?) |
    send_user( msg(agent, person, child_befriend(From?, Other?, Ch?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Parent forwards group_invite — parent already consented (consent flow 2)
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, group_invite(GroupId, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, From? =?= ParentId?, ground(GroupId?) |
    send_user( msg(agent, person, group_invite(GroupId?, Ch?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Parent tells child to leave group
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, leave_group(GroupId))|NetIn], Outs) :-
    Id? =?= Id1?, From? =?= ParentId?, ground(GroupId?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_leave(GroupId?, Id?)), Outs?, Outs1),
    close_output(group(GroupId?), Outs1?, Outs2),
    send_user( msg(agent, person, group_left(GroupId?)), Outs2?, Outs3),
    send_parent(ParentId?, msg(Id?, ParentId?, withdrawal), Outs3?, Outs4),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs4?).

%% Our parent tells us, the creator of a group, to remove a member of it: the
%% fourth role of child_leave_2 arriving at the creator.  It is the same act the
%% clause above carries out when we will it ourselves, so it is the same body ---
%% the member is told, dropped from the list, and our parent takes the
%% withdrawal, which is the parent that willed it here.  Our approvals name
%% nobody, so there is nothing to check: any parent of ours may end any
%% membership of a group of ours.
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, remove_member(GroupId, Member))|NetIn], Outs) :-
    Id? =?= Id1?, From? =?= ParentId?, ground(GroupId?), ground(Member?) |
    remove_member_commit(Id?, ParentId?, GroupId?, Member?, Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Parent tells child to unfriend.  ANY parent of either child may will this, so
%% the parent that sent it need not be the one that approved the friendship ---
%% and this child's own parent is the one whose withdrawal count advances.
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, unfriend_child(Target))|NetIn], Outs) :-
    Id? =?= Id1?, From? =?= ParentId?, ground(Target?) |
    send_friend(Target?, msg(Id?, Target?, unfriend), Outs?, Outs1),
    close_friend(Target?, Outs1?, Outs2),
    send_parent(ParentId?, msg(Id?, ParentId?, withdrawal), Outs2?, Outs3),
    send_user( msg(agent, person, unfriended(Target?)), Outs3?, Outs4),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs4?).

%% --- Network messages from a child of our own ---

%% A child of ours asks us to end the parenting.
child_agent(Id, ParentId, St, UserIn, [msg(Child, Id1, release_request)|NetIn], Outs) :-
    Id? =?= Id1?, ground(Child?) |
    send_user( msg(agent, person, release_asked(Child?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% A friendship or membership of a child of ours has been established, or ended.
child_agent(Id, ParentId, state(Al, Om, Ps, Sn), UserIn, [msg(_, Id1, approval)|NetIn], Outs) :-
    Id? =?= Id1? |
    Al1 := Al? + 1,
    child_agent(Id?, ParentId?, state(Al1?, Om?, Ps?, Sn?), UserIn?, NetIn?, Outs?).

child_agent(Id, ParentId, state(Al, Om, Ps, Sn), UserIn, [msg(_, Id1, withdrawal)|NetIn], Outs) :-
    Id? =?= Id1? |
    Om1 := Om? + 1,
    child_agent(Id?, ParentId?, state(Al?, Om1?, Ps?, Sn?), UserIn?, NetIn?, Outs?).

%% A child of ours asks our consent for a group invite it received.
child_agent(Id, ParentId, St, UserIn, [msg(Child, Id1, group_consent_req(GroupId, Consent?))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Child?), ground(GroupId?) |
    send_user( msg(agent, person,
        child_group_consent(Child?, GroupId?, Consent)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% --- Network messages from friends (otherwise) ---

%% A friend introduces a child of theirs to a child of ours.  A party that is
%% both a child and a parent is delivered this exactly as an adult parent is:
%% without it the approve_child_intro clause above could never be reached, and a
%% module that lets a child become a parent and not act as one has gated the
%% introductory act by half.
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, child_intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ~(From? =?= ParentId?), ground(Other?) |
    send_user( msg(agent, person, child_befriend(From?, Other?, Ch?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% A creator invites a child of ours into a group.  Delivered here for the same
%% reason, and it is what makes the approve_group clause above reachable.
child_agent(Id, ParentId, St, UserIn, [msg(_, Id1, group_invite_child(GroupId, Child, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    send_user( msg(agent, person, group_invite_child(GroupId?, Child?, Ch?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Friend sends text — notify UI
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs) :-
    Id? =?= Id1? |
    send_user( msg(agent, person, received(From?, Text?)), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Friend sends group_invite — child-managed group, need parental consent (consent flow 3)
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, group_invite(GroupId, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ~(From? =?= ParentId?), ground(GroupId?) |
    send_parent(ParentId?,
        msg(Id?, ParentId?, group_consent_req(GroupId?, Consent)),
        Outs?, Outs1),
    child_consent_wait(Consent?, Id?, ParentId?, St?, GroupId?, Ch?,
        UserIn?, NetIn?, Outs1?).

%% Group message from group channel — hold it, distribute to the members on the
%% list now, and notify the user.
child_agent(Id, ParentId, state(Al, Om, Ps, Sn), UserIn, [msg(_, _, group_msg(GroupId, Author, Text))|NetIn], Outs) :-
    ground(Id?), ground(GroupId?), ground(Author?), ground(Text?) |
    add_post(post(GroupId?, Author?, Text?), Ps?, Ps1),
    distribute_group_msg(GroupId?,
        msg(Author?, Author?, group_msg(GroupId?, Author?, Text?)), Sn?, Sn1, Outs?, Outs1),
    send_user( msg(agent, person, group_received(GroupId?, Author?, Text?)),
        Outs1?, Outs2),
    child_agent(Id?, ParentId?, state(Al?, Om?, Ps1?, Sn1?), UserIn?, NetIn?, Outs2?).

%% Creator removes child from group — the third party that may will a child's
%% leaving, and it advances the parent's withdrawal count like the other two.
child_agent(Id, ParentId, St, UserIn, [msg(_, Id1, group_removed(GroupId))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    close_output(group(GroupId?), Outs?, Outs1),
    send_user( msg(agent, person, group_removed(GroupId?)), Outs1?, Outs2),
    send_parent(ParentId?, msg(Id?, ParentId?, withdrawal), Outs2?, Outs3),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs3?).

%% Creator receives leave notification from child member
child_agent(Id, ParentId, St, UserIn, [msg(Member, _, group_leave(GroupId, Member1))|NetIn], Outs) :-
    ground(Id?), ground(GroupId?), ground(Member?), Member? =?= Member1? |
    close_output(group_member(GroupId?, Member?), Outs?, Outs1),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs1?).

%% Receive unfriend from friend — close friend channel, tell the parent, notify UI
child_agent(Id, ParentId, St, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs) :-
    Id? =?= Id1?, ground(From?) |
    close_friend(From?, Outs?, Outs1),
    send_parent(ParentId?, msg(Id?, ParentId?, withdrawal), Outs1?, Outs2),
    send_user( msg(agent, person, unfriended(From?)), Outs2?, Outs3),
    child_agent(Id?, ParentId?, St?, UserIn?, NetIn?, Outs3?).

%% --- Termination ---

child_agent(_, _, _, [], _, Outs) :- close_outputs(Outs?).
child_agent(_, _, _, _, [], Outs) :- close_outputs(Outs?).
