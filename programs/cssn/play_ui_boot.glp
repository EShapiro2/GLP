%% play_ui_boot.glp — single-isolate CSSN social-network scenario (live UI).
%%
%% Bob is the live-UI agent: his UserCmd stream comes from the person through
%% the Dart bridge (agent_init/3's UserIn) and his UserNotify stream returns to
%% the person through send_to_user.  Alice and Charlie are actors: each
%% cold-calls Bob and, once he accepts, transacts so his screen comes alive:
%%   - Alice, once Bob is her friend, creates a group (chess) and invites Bob —
%%     so Bob's Groups panel shows a group-invitation card; on accepting, Bob
%%     joins and both can post.  Alice posts a greeting when Bob joins.
%%   - Charlie befriends Bob and waits; if Bob creates a group and invites him,
%%     Charlie accepts and greets the group.
%% Both actors accept any friend offer or group invite Bob composes and reply to
%% his chat messages.  Each party carries a stand-in for the Grassroots
%% Super-App (superapp.glp), which befriends over a network of its own and hands
%% each mini-app the conversations it opens; friend channels are in-heap.
%%
%% The play wires the deployed compiled pair of this platform — agent.glp and
%% ui/mediator.glp — to the Dart bridge: the code under the live UI is the code
%% the fplays test.  UIVE app wiring (UI); added under the 2026-07-09 waiver.

%% =============================================================================
%% IMPORTED PROCEDURES — cross-module dependencies
%% =============================================================================

imported procedure childsafe#agent(Constant?, AgentState?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Conversation)?, Stream(OutputEntry)?).

imported procedure childsafe#ui_mediator(Constant?, Channel(Stream(AgentToUserMsg), Stream(MediatorToAgentMsg))?, Channel(Stream(AppCmd), Stream(AppNotify))?, Stream(PendingEntry)?, Constant?).

%% From superapp.glp (sibling): the stand-in for the Grassroots Super-App.
imported procedure superapp#split_cmds(Stream(UserCmd)?, Stream(AppCmd), Stream(SgCmd)).
imported procedure superapp#merge_notify(Stream(UserNotify)?, Stream(UserNotify)?, Stream(UserNotify)).
imported procedure superapp#superapp(Constant?, Stream(SgCmd)?, Stream(SgNotify), Stream(Conversation), SgOutStream, SgInStream?, Stream(SgPending)?, Constant?).
imported procedure superapp#sg_switch(SgOutStream?, Stream(SgEntry)?).

%% =============================================================================
%% ACTORS
%% =============================================================================

%% Alice: cold-call Bob; once his friend, create a group and invite him.
procedure alice_actor(Stream(UserNotify)?, Stream(UserCmd)).
alice_actor(Ns, [connect(bob) | Cs?]) :- alice_run(Ns?, Cs).

procedure alice_run(Stream(UserNotify)?, Stream(UserCmd)).
alice_run([connected(bob) | Ns],
    [create_group(chess) | [invite_group(group_id(alice, chess), bob) | Cs?]]) :-
    ui_drain(alice, Ns?, Cs).
alice_run([befriend(Who, Req) | Ns], [decision(yes, Who?, Req?) | Cs?]) :-
    ground(Who?), ground(Req?) | alice_run(Ns?, Cs).
alice_run([_ | Ns], Cs?) :- otherwise | alice_run(Ns?, Cs).
alice_run([], []).

%% Charlie: cold-call Bob; then steady-state (accept invites, reply).
procedure charlie_actor(Stream(UserNotify)?, Stream(UserCmd)).
charlie_actor(Ns, [connect(bob) | Cs?]) :- charlie_run(Ns?, Cs).

procedure charlie_run(Stream(UserNotify)?, Stream(UserCmd)).
charlie_run([connected(bob) | Ns], Cs?) :- ui_drain(charlie, Ns?, Cs).
charlie_run([befriend(Who, Req) | Ns], [decision(yes, Who?, Req?) | Cs?]) :-
    ground(Who?), ground(Req?) | charlie_run(Ns?, Cs).
charlie_run([_ | Ns], Cs?) :- otherwise | charlie_run(Ns?, Cs).
charlie_run([], []).

%% Each actor's canned message (chat reply and group greeting).
procedure reply_of(Constant?, Constant).
reply_of(alice, hello_from_alice).
reply_of(charlie, hi_from_charlie).

%% Steady state: reply to chats, accept friend offers and group invites, greet a
%% group on joining (member) or on a member joining (creator), ignore the rest.
%% Group greetings fire on the one-shot membership events, so no reply loop.
procedure ui_drain(Constant?, Stream(UserNotify)?, Stream(UserCmd)).
ui_drain(Me, [received(From, _) | Ns], [send(From?, R?) | Cs?]) :-
    ground(Me?), ground(From?) |
    reply_of(Me?, R),
    ui_drain(Me?, Ns?, Cs).
ui_drain(Me, [befriend(Who, Req) | Ns], [decision(yes, Who?, Req?) | Cs?]) :-
    ground(Me?), ground(Who?), ground(Req?) | ui_drain(Me?, Ns?, Cs).
ui_drain(Me, [group_invite(G, Req) | Ns], [accept_group(G?, Req?) | Cs?]) :-
    ground(Me?), ground(G?), ground(Req?) | ui_drain(Me?, Ns?, Cs).
ui_drain(Me, [group_joined(G) | Ns], [send_group(G?, R?) | Cs?]) :-
    ground(Me?), ground(G?) |
    reply_of(Me?, R),
    ui_drain(Me?, Ns?, Cs).
ui_drain(Me, [group_joined_member(G, _) | Ns], [send_group(G?, R?) | Cs?]) :-
    ground(Me?), ground(G?) |
    reply_of(Me?, R),
    ui_drain(Me?, Ns?, Cs).
ui_drain(Me, [_ | Ns], Cs?) :- ground(Me?), otherwise | ui_drain(Me?, Ns?, Cs).
ui_drain(_, [], []).

%% =============================================================================
%% SCENARIO BOOT (entered as Bob's agent_init)
%% =============================================================================

%% The third argument was the isolate's network entry; the platform holds
%% none.  It is the channel to the social graph, and in the live app the
%% super-app writes it; here each party's stand-in does.
procedure agent_init(Constant?, Stream(UserCmd)?, Stream(Conversation)?).
agent_init(bob, UserIn, _) :-
    superapp # split_cmds(UserIn?, BMedIn, BSgCmds),
    superapp # superapp(bob, BSgCmds?, BSgNotify, BConvs, BSgOut, BSgIn?, [], 1),
    childsafe # agent(bob, state(0, 0, [], []), BAgentIn?, BNetIn?, BConvs?,
          [user_output(BA2U)]),
    childsafe # ui_mediator(bob, ch(BA2U?, BAgentIn),
                ch(BMedIn?, BAppOut), [], 1),
    superapp # merge_notify(BSgNotify?, BAppOut?, BUserOut),
    send_to_user(BUserOut?),
    superapp # split_cmds(ACmds?, AMedIn, ASgCmds),
    superapp # superapp(alice, ASgCmds?, ASgNotify, AConvs, ASgOut, ASgIn?, [], 1),
    childsafe # agent(alice, state(0, 0, [], []), AAgentIn?, ANetIn?, AConvs?,
          [user_output(AA2U)]),
    childsafe # ui_mediator(alice, ch(AA2U?, AAgentIn),
                ch(AMedIn?, AAppOut), [], 1),
    superapp # merge_notify(ASgNotify?, AAppOut?, AUserOut),
    alice_actor(AUserOut?, ACmds),
    superapp # split_cmds(CCmds?, CMedIn, CSgCmds),
    superapp # superapp(charlie, CSgCmds?, CSgNotify, CConvs, CSgOut, CSgIn?, [], 1),
    childsafe # agent(charlie, state(0, 0, [], []), CAgentIn?, CNetIn?, CConvs?,
          [user_output(CA2U)]),
    childsafe # ui_mediator(charlie, ch(CA2U?, CAgentIn),
                ch(CMedIn?, CAppOut), [], 1),
    superapp # merge_notify(CSgNotify?, CAppOut?, CUserOut),
    charlie_actor(CUserOut?, CCmds),
    merge(ASgOut?, BSgOut?, SG1),
    merge(SG1?, CSgOut?, AllSgOut),
    superapp # sg_switch(AllSgOut?, [sg_entry(alice, ASgIn),
                                     sg_entry(bob, BSgIn),
                                     sg_entry(charlie, CSgIn)]).
