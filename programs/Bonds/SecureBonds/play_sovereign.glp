-module(play_sovereign).
-mode(system).

%% play_sovereign.glp — Test plays for secure bonds sovereign
%%
%% play: basic sovereign with mint + pay, verify finality
%% play_recover: same, plus verify the log is recoverable

%% =============================================================================
%% IMPORTED PROCEDURES
%% =============================================================================

imported procedure sovereign#setup(Stream(ApprovalReq)?).
imported procedure sovereign#setup_with_log(Stream(ApprovalReq)?, Stream(SovBlock)).
imported procedure sovereign#recover_counter(Stream(SovBlock)?, Constant).

%% =============================================================================
%% OBSERVE — Wait for finality then terminate
%% =============================================================================

procedure observe(Constant?, Finality?).
observe(_, finalized).

%% =============================================================================
%% CHECK_EQUALS — Verify two constants are equal
%% =============================================================================

procedure check_equals(Constant?, Constant?).
check_equals(N, M) :- N? =?= M? | true.

%% =============================================================================
%% PLAY — Basic sovereign test
%% =============================================================================

exported procedure play.
play :-
    Requests = [
        approve_mint(10, 0, FinalityMint),
        approve_pay(bob, charlie, bond(alice, 0, 1), FinalityPayQ, FinalityPayR)
    ] |
    sovereign # setup(Requests?),
    observe(mint, FinalityMint?),
    observe(pay_q, FinalityPayQ?),
    observe(pay_r, FinalityPayR?).

%% =============================================================================
%% PLAY_RECOVER — Sovereign test with recovery verification
%% =============================================================================
%%
%% Runs the sovereign with a log copy, verifies finality,
%% then recovers the counter from the log and checks it equals 2
%% (two transactions: mint at counter 1, pay at counter 2).

exported procedure play_recover.
play_recover :-
    Requests = [
        approve_mint(10, 0, FinalityMint),
        approve_pay(bob, charlie, bond(alice, 0, 1), FinalityPayQ, FinalityPayR)
    ] |
    sovereign # setup_with_log(Requests?, Log),
    observe(mint, FinalityMint?),
    observe(pay_q, FinalityPayQ?),
    observe(pay_r, FinalityPayR?),
    sovereign # recover_counter(Log?, Counter),
    check_equals(Counter?, 2).
