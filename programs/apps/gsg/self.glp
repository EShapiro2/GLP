%% ---------------------------------------------------------------------------
%% programs/apps/gsg --- the app of GSG, the grassroots social graph (GSC's contract, programs/gsc/GSG.txt and GSG.glp; Coordination Appendix C), as a mini-app of the Grassroots Super-App (GSG paper, Section 2), compiled down the abstraction cascade from its act schemas: the canonical CVA platform vGLP's compiler prints from them, platform.vglp (vGLP, Section 3.2, Definition "Canonical CVA Platform"; Section 5.4, "The compilation"), compiled to GLP by the canonical compilation when the directory loads (vGLP, Section 6.3, "The canonical compilation").
%%
%% The directory is a certified program of its own: the platform, the mini-app entry miniapp/4 that wraps it (miniapp.glp), its scripted person (person.glp) and the plays that activate it by run/3, two executions over one conversation, with no super-app (plays.glp).  It calls nothing that reaches the network or the person, so the REPL's :artefact certifies it, and its artefact gsg.glpw is what the super-app installs; the plays of the super-app hosting it on two smartphones are ../gsg_boot.glp.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module, as every hand-written module importing a compiled procedure restates them today (the plays of programs/vglp/cva/social_graph likewise).  The compiled module's own definitions shadow these within it, and the two must agree.
%% ---------------------------------------------------------------------------

Peer     ::= Key.
Class    ::= establish(Peer) ; meet(Peer, Peer) ; introduce(Peer, Peer, Peer)
           ; befriend(Peer, Peer) ; unfriend(Peer, Peer).
Proposal ::= establish(Peer) ; meet(Peer, Peer) ; introduce(Peer, Peer, Peer)
           ; befriend(Peer, Peer) ; unfriend(Peer, Peer).
Request  ::= propose(Proposal).
YesNo    ::= yes ; no.
Reason   ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote     ::= yes ; no(Reason).
Decision ::= commit ; abort(Peer, Reason) ; yield.
Rho      ::= one(Class) ; rho(Proposal).
Names    ::= none ; request(Rho, Integer).
Attempt  ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo    ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
           ; yield(Attempt) ; request(Rho, Integer).
Content  ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= identity ; knows(Peer) ; friend(Peer).
Output   ::= view(List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab      ::= tab(String, Constant).
Asking   ::= Attempt ; hello(Peer, Proposal).
Approved ::= Proposal.
Approval ::= approval(Asking, List(Word), YesNo?).
Word     ::= text(String) ; person(Peer).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

%% What the mini-app's scripted person reports, its screen (person.glp): each view the program writes, once, the machine state and the persons the agent knows (vGLP b7e3517, Section 5.4, "The compilation"), and each notice, refused(P, Q, D) (vGLP f0acbc1, Section 5.4, "The compilation"); the agent's own key and the persons a request question shows, where the script looks; and each answer it gives an approval question, of the attempt or of an attempt of the class its script names.
Asked    ::= Class ; Attempt.
Seen     ::= Output ; menu(Key, List(Key)) ; gave(Asked, YesNo).

%% The network of the platform over the conversations (miniapp.glp): what its router reads, a conversation the social graph opened, the peer's key and this side's end of its root channel, or a message the agent sent; a conversation's route, the peer's key and the writer of the conversation's outgoing stream; and whether a message went on a conversation or is held for one not yet open.
NetEvent ::= opened(Key, RootChannel(Net)) ; sent(Net).
Route    ::= route(Key, Stream(Net)?).
Routes   ::= [] ; [Route | Routes].
Sending  ::= went ; held(Net).

%% The mini-app's entry, the instance of the root's entry template miniapp/4 (programs/self.glp) at the mini-app's two types: Drawn, what its dispatcher draws for its person, and Net, the messages of its root channels, the platform's network messages (miniapp.glp).
imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
miniapp(Id, Ui, Sg, Cal) :- miniapp # miniapp(Id?, Ui?, Sg?, Cal?).

%% The scripted person, the instance of the root's second template miniapp_person/4 at Drawn and at Seen, the screen it reports.
imported procedure person#miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
exported procedure miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Id, Role, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, PEnd?, Screen).

%% The plays with no super-app (plays.glp).
imported procedure plays#play_friends(Stream(Seen), Stream(Seen)).
exported procedure play_friends(Stream(Seen), Stream(Seen)).
play_friends(A?, B?) :- plays # play_friends(A, B).

imported procedure plays#play_held(Stream(Net), Stream(Net), Stream(Net)).
exported procedure play_held(Stream(Net), Stream(Net), Stream(Net)).
play_held(A?, B?, C?) :- plays # play_held(A, B, C).
