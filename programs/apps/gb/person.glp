%% person.glp --- the GB mini-app's scripted person: the instance of the root's second template miniapp_person/5 (programs/self.glp) at Drawn, what the mini-app's dispatcher draws, and at Seen, the screen the person reports (self.glp).  The super-app's plays activate it from the module value, as they activate the entry (../gc_boot.glp); the plays of this directory call it beside the entry (plays.glp).  It is GSG's app's person (../gsg/person.glp) with GB's scripts, and the wait on fewer than N copies of an atom, lacks(A, N), beside lacks(A).
%%
%% The person reads what the dispatcher draws on the person channel (vGLP, "The construct process": draw(Id, W, V) and withdraw(Id); a grant input(Id, P, R)): the agent's request questions, each bare, of the request type Request?, taking one request (vGLP 12f629d, Section 5.4, "The compilation"); the program's output, construct 0, drawn whole as it grows, on which the agent writes its view, view(Id, S, K, A, Ts), its own key Id, the machine state S, the persons K it knows, the approvals A its person made that are pending and the tabs Ts, when it starts and whenever any changes (vGLP 12f629d, Section 5.4, "The compilation"), and the notices it writes there when an approval its person made, by a request or by an answer yes, ends by a refusal, refused(N, Q, D), N the request name of the part of the refused attempt, Q its refuser and D the reason, declined or unable (vGLP e286276, Section 5.4, "The compilation"); and the approval questions Start raises.  The person's screen shows the last view written and the notices written after it (vGLP f5f1644, Section 5.4, "The compilation").  Its script is a list of steps: req(R) grants the request R on the request question open, once one is drawn; own(Ks, R) grants R likewise, once the person has written into each of the holes Ks the agent's own key, which the last view drawn shows, R reading the holes wherever it names the agent, so that a person proposing a class that names their agent names it by the key they read off the view, as the request form does (vGLP 12f629d, Section 5.4, "The compilation"; Section 6.2: "A declared widget is drawn also with the last value drawn on construct 0"); look reports menu(K, Ks), K the agent's own key and Ks the persons it knows, as the last view drawn shows them, once a request question is drawn; wait(C) waits until the screen shows C; approval(K, A) answers A, yes or no, the approval question of the attempt K, or of an attempt of the class K, once it is drawn.  The screen shows known(Q) where the last view shows Q among the persons the agent knows; holds(A) where its machine state holds the atom A, lacks(A) where it does not, and has(A, N) where it holds A at least N times; refused(P, Q, D) where that notice is written after the last view; refused_by(P, Q) where a notice refused(P, Q, D) has been written, of any reason D; asked(K) where the approval question of the attempt K, or of an attempt of the class K, is drawn and not answered; and asking where a request question is drawn and not answered.  It reports each view and each notice once, with gave(K, A) where it answers an approval question. It is the scripted person of the plays of programs/vglp/cva (self.glp there), at the platform's own types.
%%
%% The roles, by which the plays choose a script, each with the keys of those its person has a conversation with, in the order the plays give them (alice: bob, carol; bob: alice; carol: alice; market_alice: bob, charlie, eve, frank; market_bob: alice, diana; market_charlie: alice, eve, escrow; market_diana: bob, frank; market_eve: alice, charlie, frank; market_frank: diana, eve, escrow, alice; market_escrow: charlie, frank), its own key the first argument:
%%   alice  looks at her request question; establishes her identity (GKK:1);
%%          asks to come to know bob, and then carol (GKK:2), each request's
%%          hello asking the other; once her date is the first day, the play's
%%          calendar giving it (GB:2), mints five Alice-coins and three
%%          Alice-bonds maturing at day 10 (GB:1); once she holds them, asks
%%          bob for a loan, two of her Alice-coins for three of his Bob-bonds
%%          maturing at day 5, swap_cb(alice, bob, alice, 2, bob, 5, 3)
%%          (GB:3); once she holds the Bob-bonds and her date is day 5, which
%%          the play writes on her calendar once bob's date is day 5, redeems
%%          a matured Bob-bond against an Alice-coin bob holds,
%%          redeem_bc(alice, bob, 5, alice) (GB:5); once she holds the
%%          Alice-coin, deposits two Alice-coins with carol,
%%          deposit_c(alice, carol, alice, 2) (GB:7); looks again.
%%   bob    establishes his identity; once his date is the first day, mints
%%          four Bob-bonds maturing at day 5 (GB:1); once he holds them,
%%          answers yes to alice asking that they come to know each other, the question
%%          her hello asks, and yes to her asking for the loan.  He mints
%%          before he answers the acquaintance, so that he holds the Bob-bonds when
%%          alice's swap reaches him.
%%   carol  establishes her identity; answers yes to alice asking that they come to
%%          know each other, and yes to her asking to deposit two Alice-coins with
%%          her.
%%   market_alice to market_escrow  the villagers and the escrow agent of
%%          the village market (play_village), their scripts below.
%% Any other role has no script: its person reports the views and acts on nothing.

Step  ::= req(Request) ; own(Holes, Request) ; look ; wait(Cond) ; approval(Asked, YesNo)
        ; approval(Fills, Class, YesNo).
Cond  ::= known(Key) ; holds(Atom) ; lacks(Atom) ; lacks(Atom, Integer) ; has(Atom, Integer)
        ; refused(Proposal, Key, Reason) ; refused_by(Proposal, Key) ; asked(Asked) ; asking.
Last  ::= last(Key, List(Atom), List(Key)) ; nolast.
Steps ::= [] ; [Step | Steps].
Holes ::= [] ; [Key? | Holes].
Sess  ::= nosess ; sess(Integer, Path).
Shown ::= shown(Integer, Path, Asking).
Shows ::= [] ; [Shown | Shows].
PSt   ::= ps(Sess, List(Output), Shows, Steps).
ApprovalAt ::= approval_at(Integer, Path, Shows) ; noapproval.
YN    ::= y ; n.
Fills ::= [] ; [Holes | Fills].
Found ::= found(List(Key)) ; nomatch.
Matched ::= matched(Integer, Path, Shows, List(Key)) ; unmatched.

exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Me, Role, Ps, ch(Ds, Gs?), S?) :-
    script(Role?, Me?, Ps?, Ss),
    person(Ds?, Gs, ps(nosess, [], [], Ss?), S).

%% script(Role, Me, Ps, Ss): the script Ss of the role, Me the person's own key and Ps the keys the person knows, each peer named by its key in Ps, by its position there; the issuer of a coin whom the person does not know is a hole of an approval step, filled by matching the approval question (approval(Fs, K, A), below).
procedure script(Constant?, Key?, List(Key)?, Steps).
script(alice, Me, [Bob, Carol], [look, own([A1], propose(establish(A1?))), wait(holds(identity)),
               own([M1], propose(acquaint(M1?, Bob?))), wait(holds(knows(Bob?))),
               own([M2], propose(acquaint(M2?, Carol?))), wait(holds(knows(Carol?))),
               wait(holds(date(1))),
               own([A2], propose(mint(A2?, 5))), wait(has(coin(Me?), 5)),
               own([A3], propose(mint_bond(A3?, 10, 3))), wait(has(bond(Me?, 10), 3)),
               own([A4, A5], propose(swap_cb(A4?, Bob?, A5?, 2, Bob?, 5, 3))), wait(has(bond(Bob?, 5), 3)),
               wait(holds(date(5))),
               own([A6, A7], propose(redeem_bc(A6?, Bob?, 5, A7?))), wait(has(coin(Me?), 4)),
               own([A8, A9], propose(deposit_c(A8?, Carol?, A9?, 2))), wait(lacks(coin(Me?), 3)), look]) :-
    ground(Me?), ground(Bob?), ground(Carol?) | true.
script(bob, Me, [Alice], [own([B1], propose(establish(B1?))), wait(holds(identity)),
             wait(holds(date(1))),
             own([B2], propose(mint_bond(B2?, 5, 4))), wait(has(bond(Me?, 5), 4)),
             approval(acquaint(Alice?, Me?), yes),
             approval(swap_cb(Alice?, Me?, Alice?, 2, Me?, 5, 3), yes)]) :-
    ground(Me?), ground(Alice?) | true.
script(carol, Me, [Alice], [own([C1], propose(establish(C1?))), wait(holds(identity)),
               approval(acquaint(Alice?, Me?), yes),
               approval(deposit_c(Alice?, Me?, Alice?, 2), yes)]) :-
    ground(Me?), ground(Alice?) | true.
%% The village market of GB's paper, Section 7.1, on the compiled app (play_village, plays.glp): six villagers and an escrow agent, each script its villager's acts of the seven operations, after each has minted, got the first day as their date and come to know those they transact with (GKK:2), each acquaintance willed by both.  Each waits on its own screen, so that a request is made once what it needs of its proposer holds; what it needs of the other party holds by the order of the scripts, each party minting before it answers an acquaintance.
script(market_alice, Me, [Bob, Charlie, Eve, Frank], [own([A1], propose(establish(A1?))), wait(holds(identity)), wait(holds(dated)),
        own([A2], propose(mint(A2?, 30))), wait(has(coin(Me?), 30)),
        own([M1], propose(acquaint(M1?, Bob?))), wait(holds(knows(Bob?))),
        own([M2], propose(acquaint(M2?, Charlie?))), wait(holds(knows(Charlie?))),
        own([M3], propose(acquaint(M3?, Eve?))), wait(holds(knows(Eve?))),
        own([M4], propose(acquaint(M4?, Frank?))), wait(holds(knows(Frank?))),
        own([A3, A4], propose(swap(A3?, Bob?, A4?, 15, Bob?, 15))), wait(has(coin(Bob?), 15)),
        own([A5, A6], propose(swap(A5?, Charlie?, A6?, 15, Charlie?, 15))), wait(has(coin(Charlie?), 15)),
        wait(has(coin(Me?), 8)),
        own([A7], propose(swap(A7?, Eve?, Bob?, 10, Frank?, 4))), wait(has(coin(Frank?), 4)), look]) :-
    ground(Me?), ground(Bob?), ground(Charlie?), ground(Eve?), ground(Frank?) | true.
script(market_bob, Me, [Alice, Diana], [own([B1], propose(establish(B1?))), wait(holds(identity)), wait(holds(dated)),
        own([B2], propose(mint(B2?, 15))), wait(has(coin(Me?), 15)),
        own([B3], propose(mint_bond(B3?, 25, 24))), wait(has(bond(Me?, 25), 24)),
        approval(acquaint(Alice?, Me?), yes), approval(acquaint(Diana?, Me?), yes),
        approval(swap(Alice?, Me?, Alice?, 15, Me?, 15), yes),
        approval(swap_cb(Diana?, Me?, Diana?, 20, Me?, 25, 24), yes),
        wait(has(coin(Alice?), 15)),
        own([B4], propose(pay(B4?, Alice?, 5))), wait(lacks(coin(Alice?), 11)), look]) :-
    ground(Me?), ground(Alice?), ground(Diana?) | true.
script(market_charlie, Me, [Alice, Eve, Escrow], [own([C1], propose(establish(C1?))), wait(holds(identity)), wait(holds(dated)),
        own([C2], propose(mint(C2?, 25))), wait(has(coin(Me?), 25)),
        approval(acquaint(Alice?, Me?), yes),
        own([M1], propose(acquaint(M1?, Eve?))), wait(holds(knows(Eve?))),
        own([M2], propose(acquaint(M2?, Escrow?))), wait(holds(knows(Escrow?))),
        approval(swap(Alice?, Me?, Alice?, 15, Me?, 15), yes),
        own([C3, C4], propose(swap(C3?, Eve?, C4?, 10, Eve?, 10))), wait(has(coin(Eve?), 10)),
        approval([[F1, F2, F3, F4]], swap(Eve?, Me?, F1?, 5, Alice?, 5), yes),
        wait(has(coin(F2?), 5)),
        own([C5], propose(deposit_c(C5?, Escrow?, F3?, 5))), wait(lacks(coin(F4?))), look]) :-
    ground(Me?), ground(Alice?), ground(Eve?), ground(Escrow?) | true.
script(market_diana, Me, [Bob, Frank], [own([D1], propose(establish(D1?))), wait(holds(identity)), wait(holds(dated)),
        own([D2], propose(mint(D2?, 35))), wait(has(coin(Me?), 35)),
        own([M1], propose(acquaint(M1?, Bob?))), wait(holds(knows(Bob?))),
        own([M2], propose(acquaint(M2?, Frank?))), wait(holds(knows(Frank?))),
        own([D3, D4], propose(swap_cb(D3?, Bob?, D4?, 20, Bob?, 25, 24))), wait(has(bond(Bob?, 25), 24)),
        own([D5, D6], propose(swap_cb(D5?, Frank?, D6?, 15, Frank?, 28, 18))), wait(has(bond(Frank?, 28), 18)),
        wait(has(coin(Me?), 3)),
        own([D7], propose(redeem_bc(D7?, Frank?, 28, Frank?))), wait(refused_by(redeem_bc(Me?, Frank?, 28, Frank?), Frank?)),
        wait(lacks(bond(Frank?, 28), 14)),
        own([D8], propose(redeem_bc(D8?, Frank?, 28, Frank?))), wait(lacks(bond(Frank?, 28), 13)), look]) :-
    ground(Me?), ground(Bob?), ground(Frank?) | true.
script(market_eve, Me, [Alice, Charlie, Frank], [own([E1], propose(establish(E1?))), wait(holds(identity)), wait(holds(dated)),
        own([E2], propose(mint(E2?, 20))), wait(has(coin(Me?), 20)),
        approval(acquaint(Alice?, Me?), yes), approval(acquaint(Charlie?, Me?), yes),
        own([M1], propose(acquaint(M1?, Frank?))), wait(holds(knows(Frank?))),
        approval(swap(Charlie?, Me?, Charlie?, 10, Me?, 10), yes),
        own([E3, E4], propose(swap(E3?, Frank?, E4?, 10, Frank?, 10))), wait(has(coin(Frank?), 10)),
        own([E5], propose(pay(E5?, Charlie?, 6))), wait(lacks(coin(Charlie?), 5)),
        own([E6], propose(swap(E6?, Charlie?, Frank?, 5, Alice?, 5))), wait(has(coin(Alice?), 5)),
        own([E7], propose(pay(E7?, Alice?, 3))), wait(lacks(coin(Alice?), 3)),
        approval([[B1]], swap(Alice?, Me?, B1?, 10, Frank?, 4), yes), look]) :-
    ground(Me?), ground(Alice?), ground(Charlie?), ground(Frank?) | true.
script(market_frank, Me, [Diana, Eve, Escrow, Alice], [own([F1], propose(establish(F1?))), wait(holds(identity)), wait(holds(dated)),
        own([F2], propose(mint(F2?, 10))), wait(has(coin(Me?), 10)),
        own([F3], propose(mint_bond(F3?, 28, 18))), wait(has(bond(Me?, 28), 18)),
        approval(acquaint(Diana?, Me?), yes), approval(acquaint(Eve?, Me?), yes), approval(acquaint(Escrow?, Me?), yes), approval(acquaint(Alice?, Me?), yes),
        approval(swap_cb(Diana?, Me?, Diana?, 15, Me?, 28, 18), yes),
        approval(swap(Eve?, Me?, Eve?, 10, Me?, 10), yes),
        wait(has(coin(Diana?), 15)),
        own([F4], propose(pay(F4?, Diana?, 3))), wait(lacks(coin(Diana?), 13)),
        wait(holds(date(28))),
        own([F5], propose(redeem_cb(F5?, Diana?, Me?, 28))), wait(lacks(coin(Diana?), 12)),
        own([F6], propose(redeem_cb(F6?, Diana?, Me?, 28))), wait(lacks(coin(Diana?), 11)),
        own([F7], propose(redeem_cb(F7?, Diana?, Me?, 28))), wait(lacks(coin(Diana?), 10)),
        own([F8], propose(redeem_cb(F8?, Diana?, Me?, 28))), wait(lacks(coin(Diana?), 9)),
        approval(release_c(Escrow?, Me?, Me?, 5), yes), wait(has(coin(Me?), 5)),
        own([F9], propose(redeem_cb(F9?, Diana?, Me?, 28))), wait(lacks(coin(Diana?), 8)), look]) :-
    ground(Me?), ground(Diana?), ground(Eve?), ground(Escrow?), ground(Alice?) | true.
script(market_escrow, Me, [Charlie, Frank], [own([G1], propose(establish(G1?))), wait(holds(identity)), wait(holds(dated)),
        approval(acquaint(Charlie?, Me?), yes),
        own([M1], propose(acquaint(M1?, Frank?))), wait(holds(knows(Frank?))),
        approval(deposit_c(Charlie?, Me?, Frank?, 5), yes), wait(has(coin(Frank?), 5)),
        wait(holds(date(30))),
        own([G2], propose(release_c(G2?, Frank?, Frank?, 5))), wait(lacks(coin(Frank?))), look]) :-
    ground(Me?), ground(Charlie?), ground(Frank?) | true.
script(_, _, _, []) :- otherwise | true.

%% The person.
procedure person(PersonOut(Drawn)?, PersonIn(Drawn), PSt?, Stream(Seen)).
person([draw(0, _, output(T)) | Ds], Gs?, ps(Se, Old, Cs, Ss), Log?) :-
    ground(T?) |
    log_new(Old?, T?, Log, Log1?),
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log1, Log2?),
    person(Ds?, Gs1, St1?, Log2).
%% The request question, bare, of the request type Request? (vGLP 12f629d, Section 5.4, "The compilation"): the person reads the agent's own key and the persons it knows off the last view drawn on construct 0, as the request form does (Section 6.2).
person([draw(Id, _, request_r(input(P))) | Ds], Gs?, ps(_, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?) |
    advance(ps(sess(Id?, P?), T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([draw(Id, _, approval_w(approval(At, _, input(P)))) | Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?), ground(At?) |
    advance(ps(Se?, T?, [shown(Id?, P?, At?) | Cs?], Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([withdraw(Id) | Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :-
    ground(Id?) |
    drop_shown(Id?, Cs?, Cs1),
    person(Ds?, Gs, ps(Se?, T?, Cs1?, Ss?), Log).
person([_ | Ds], Gs?, St, Log?) :-
    otherwise | person(Ds?, Gs, St?, Log).

%% advance(St, Gs, Gs1, St1, Log, Log1): the script's steps taken as far as they can be, the grants written on Gs, continuing at Gs1.
procedure advance(PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
advance(ps(sess(Id, P), T, Cs, [req(R) | Ss]), [input(Id?, P?, R?) | Gs?], Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?) |
    advance(ps(nosess, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [req(R) | Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [req(R?) | Ss?]), Log1?, Log1).
advance(ps(sess(Id, P), T, Cs, [own(Ks, R) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?), ground(T?) |
    last_of(T?, L),
    owned(L?, ps(sess(Id?, P?), T?, Cs?, [own(Ks?, R?) | Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [own(Ks, R) | Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [own(Ks?, R?) | Ss?]), Log1?, Log1).
advance(ps(sess(Id, P), T, Cs, [look | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?), ground(T?) |
    last_of(T?, L),
    looked(L?, ps(sess(Id?, P?), T?, Cs?, [look | Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [look | Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [look | Ss?]), Log1?, Log1).
advance(ps(Se, T, Cs, [wait(X) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Se?), ground(T?), ground(Cs?), ground(X?) |
    shows(X?, Se?, T?, Cs?, B),
    waited(B?, ps(Se?, T?, Cs?, [wait(X?) | Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, [approval(K, A) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Cs?), ground(K?) |
    find_approval(K?, Cs?, F),
    approved(F?, ps(Se?, T?, Cs?, [approval(K?, A?) | Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, [approval(Fs, K, A) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Cs?) |
    rev_shown(Cs?, [], Rs),
    match_approval(K?, Rs?, [], M, K1),
    matched(M?, Fs?, K1?, A?, ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, []), Gs1?, Gs1, ps(Se?, T?, Cs?, []), Log1?, Log1).

%% owned(L, St, ...): the step own(Ks, R), the agent's own key read off the last view drawn, L, written into each hole of Ks, and R granted; with no view drawn yet, the step waits (vGLP 12f629d, Section 5.4, "The compilation": the view carries "its own key k"; Section 6.2).
procedure owned(Last?, PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
owned(last(Me, _, _), ps(sess(Id, P), T, Cs, [own(Ks, R) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Me?), ground(Id?), ground(P?) |
    fill(Me?, Ks?),
    grant(Id?, P?, R?, Gs, Gs2?),
    advance(ps(nosess, T?, Cs?, Ss?), Gs2, Gs1?, St1, Log, Log1?).
owned(nolast, St, Gs1?, Gs1, St?, Log1?, Log1).

%% looked(L, St, ...): the step look, which reports menu(K, Ks), the agent's own key and the persons it knows as the last view drawn, L, shows them; with no view drawn yet, the step waits.
procedure looked(Last?, PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
looked(last(Me, _, Ks), ps(Se, T, Cs, [look | Ss]), Gs?, Gs1, St1?, [menu(Me?, Ks?) | Log?], Log1) :-
    ground(Me?), ground(Ks?) |
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
looked(nolast, St, Gs1?, Gs1, St?, Log1?, Log1).

%% fill(Me, Ks): the agent's own key Me written into each hole of Ks.
procedure fill(Key?, Holes?).
fill(Me, [Me? | Ks]) :- ground(Me?) | fill(Me?, Ks?).
fill(_, []).

%% The step approval(Fs, K, A): the answer A to the earliest approval question drawn whose attempt's class, or whose hello's proposal, the class K matches, K holding holes where the script does not know the key the question carries --- the issuer of a coin offered by one the person knows, say.  The question's keys at the holes fill them, the holes of K in order, the first hole's key into each hole of the first list of Fs, and so on, so that the steps after it name that key by the holes they read (GLP #11 Cowork, Code_inbox.md, 2026-11-03 17:23 UTC, item 2: "a form of wait or approval with holes filled by matching is a construct of the owners' scripted-person interpreter, written in GLP").  A hole is a key still unknown where the class is matched; the class names every other key.
procedure matched(Matched?, Fills?, Class?, YesNo?, PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
matched(matched(Id, P, Cs1, Vs), Fs, K, A, ps(Se, T, _, Ss), [input(Id?, P?, A?) | Gs?], Gs1, St1?, [gave(K?, A?) | Log?], Log1) :-
    ground(Vs?), ground(A?) |
    rev_keys(Vs?, [], Ws),
    fill_each(Ws?, Fs?),
    advance(ps(Se?, T?, Cs1?, Ss?), Gs, Gs1?, St1, Log, Log1?).
matched(unmatched, Fs, K, A, ps(Se, T, Cs, Ss), Gs1?, Gs1, ps(Se?, T?, Cs?, [approval(Fs?, K?, A?) | Ss?]), Log1?, Log1).

%% fill_each(Ws, Fs): each key of Ws written into each hole of the list of Fs at its place.
procedure fill_each(List(Key)?, Fills?).
fill_each([W | Ws], [Hs | Fs]) :- ground(W?) | fill(W?, Hs?), fill_each(Ws?, Fs?).
fill_each([], []).

procedure rev_keys(List(Key)?, List(Key)?, List(Key)).
rev_keys([], Acc, Acc?).
rev_keys([K | Ks], Acc, R?) :- rev_keys(Ks?, [K? | Acc?], R).

%% match_approval(K, Cs, Done, M, K1): M matched(Id, P, Rest, Vs), the earliest question of Cs whose asking K matches, Vs the keys at K's holes, the last first, Rest the questions left; unmatched where none does.  K1 is K, passed back.
procedure match_approval(Class?, Shows?, Shows?, Matched, Class).
match_approval(K, [], _, unmatched, K?).
match_approval(K, [shown(Id, P, At) | Cs], Done, M?, K2?) :-
    ground(Id?), ground(P?), ground(At?) |
    match_asking(K?, At?, F, K1),
    match_next(F?, K1?, shown(Id?, P?, At?), Cs?, Done?, M, K2).

procedure match_next(Found?, Class?, Shown?, Shows?, Shows?, Matched, Class).
match_next(found(Vs), K, shown(Id, P, _), Cs, Done, matched(Id?, P?, Rest?, Vs?), K?) :-
    rev_shown(Done?, Cs?, Rest).
match_next(nomatch, K, S, Cs, Done, M?, K1?) :-
    match_approval(K?, Cs?, [S? | Done?], M, K1).

%% An attempt is matched by its class, a hello by its proposal.
procedure match_asking(Class?, Asking?, Found, Class).
match_asking(K, attempt(_, _, _, C, _), F?, K1?) :- match_class(K?, C?, [], F, K1).
match_asking(K, hello(_, N), F?, K1?) :- match_class(K?, N?, [], F, K1).

%% match_class(K, X, Vs, F, K1): F found(Vs1) where the class K, with holes, matches X, Vs1 the keys of X at K's holes, the last first, before Vs; nomatch where it does not.  K1 is K, passed back.
procedure match_class(Class?, Class?, List(Key)?, Found, Class).
match_class(establish(K1), establish(XK1), Vs, F?, establish(BK1?)) :-
    match_key(K1?, XK1?, found(Vs?), F, BK1).
match_class(acquaint(K1, K2), acquaint(XK1, XK2), Vs, F?, acquaint(BK1?, BK2?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, F, BK2).
match_class(introduce(K1, K2, K3), introduce(XK1, XK2, XK3), Vs, F?, introduce(BK1?, BK2?, BK3?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, F, BK3).
match_class(mint(K1, K2), mint(XK1, XK2), Vs, F?, mint(BK1?, BK2?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_int(K2?, XK2?, R1?, F, BK2).
match_class(mint_bond(K1, K2, K3), mint_bond(XK1, XK2, XK3), Vs, F?, mint_bond(BK1?, BK2?, BK3?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_int(K2?, XK2?, R1?, R2, BK2),
    match_int(K3?, XK3?, R2?, F, BK3).
match_class(first_date(K1, K2), first_date(XK1, XK2), Vs, F?, first_date(BK1?, BK2?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_int(K2?, XK2?, R1?, F, BK2).
match_class(advance(K1, K2), advance(XK1, XK2), Vs, F?, advance(BK1?, BK2?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_int(K2?, XK2?, R1?, F, BK2).
match_class(swap(K1, K2, K3, K4, K5, K6), swap(XK1, XK2, XK3, XK4, XK5, XK6), Vs, F?, swap(BK1?, BK2?, BK3?, BK4?, BK5?, BK6?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, R4, BK4),
    match_key(K5?, XK5?, R4?, R5, BK5),
    match_int(K6?, XK6?, R5?, F, BK6).
match_class(swap_cb(K1, K2, K3, K4, K5, K6, K7), swap_cb(XK1, XK2, XK3, XK4, XK5, XK6, XK7), Vs, F?, swap_cb(BK1?, BK2?, BK3?, BK4?, BK5?, BK6?, BK7?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, R4, BK4),
    match_key(K5?, XK5?, R4?, R5, BK5),
    match_int(K6?, XK6?, R5?, R6, BK6),
    match_int(K7?, XK7?, R6?, F, BK7).
match_class(swap_bc(K1, K2, K3, K4, K5, K6, K7), swap_bc(XK1, XK2, XK3, XK4, XK5, XK6, XK7), Vs, F?, swap_bc(BK1?, BK2?, BK3?, BK4?, BK5?, BK6?, BK7?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, R4, BK4),
    match_int(K5?, XK5?, R4?, R5, BK5),
    match_key(K6?, XK6?, R5?, R6, BK6),
    match_int(K7?, XK7?, R6?, F, BK7).
match_class(swap_bb(K1, K2, K3, K4, K5, K6, K7, K8), swap_bb(XK1, XK2, XK3, XK4, XK5, XK6, XK7, XK8), Vs, F?, swap_bb(BK1?, BK2?, BK3?, BK4?, BK5?, BK6?, BK7?, BK8?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, R4, BK4),
    match_int(K5?, XK5?, R4?, R5, BK5),
    match_key(K6?, XK6?, R5?, R6, BK6),
    match_int(K7?, XK7?, R6?, R7, BK7),
    match_int(K8?, XK8?, R7?, F, BK8).
match_class(pay(K1, K2, K3), pay(XK1, XK2, XK3), Vs, F?, pay(BK1?, BK2?, BK3?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_int(K3?, XK3?, R2?, F, BK3).
match_class(redeem(K1, K2, K3), redeem(XK1, XK2, XK3), Vs, F?, redeem(BK1?, BK2?, BK3?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, F, BK3).
match_class(redeem_cb(K1, K2, K3, K4), redeem_cb(XK1, XK2, XK3, XK4), Vs, F?, redeem_cb(BK1?, BK2?, BK3?, BK4?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, F, BK4).
match_class(redeem_bc(K1, K2, K3, K4), redeem_bc(XK1, XK2, XK3, XK4), Vs, F?, redeem_bc(BK1?, BK2?, BK3?, BK4?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_int(K3?, XK3?, R2?, R3, BK3),
    match_key(K4?, XK4?, R3?, F, BK4).
match_class(redeem_bb(K1, K2, K3, K4, K5), redeem_bb(XK1, XK2, XK3, XK4, XK5), Vs, F?, redeem_bb(BK1?, BK2?, BK3?, BK4?, BK5?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_int(K3?, XK3?, R2?, R3, BK3),
    match_key(K4?, XK4?, R3?, R4, BK4),
    match_int(K5?, XK5?, R4?, F, BK5).
match_class(deposit_c(K1, K2, K3, K4), deposit_c(XK1, XK2, XK3, XK4), Vs, F?, deposit_c(BK1?, BK2?, BK3?, BK4?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, F, BK4).
match_class(deposit_b(K1, K2, K3, K4, K5), deposit_b(XK1, XK2, XK3, XK4, XK5), Vs, F?, deposit_b(BK1?, BK2?, BK3?, BK4?, BK5?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, R4, BK4),
    match_int(K5?, XK5?, R4?, F, BK5).
match_class(release_c(K1, K2, K3, K4), release_c(XK1, XK2, XK3, XK4), Vs, F?, release_c(BK1?, BK2?, BK3?, BK4?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, F, BK4).
match_class(release_b(K1, K2, K3, K4, K5), release_b(XK1, XK2, XK3, XK4, XK5), Vs, F?, release_b(BK1?, BK2?, BK3?, BK4?, BK5?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, R4, BK4),
    match_int(K5?, XK5?, R4?, F, BK5).
match_class(return_c(K1, K2, K3, K4), return_c(XK1, XK2, XK3, XK4), Vs, F?, return_c(BK1?, BK2?, BK3?, BK4?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, F, BK4).
match_class(return_b(K1, K2, K3, K4, K5), return_b(XK1, XK2, XK3, XK4, XK5), Vs, F?, return_b(BK1?, BK2?, BK3?, BK4?, BK5?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_key(K3?, XK3?, R2?, R3, BK3),
    match_int(K4?, XK4?, R3?, R4, BK4),
    match_int(K5?, XK5?, R4?, F, BK5).
match_class(K, _, _, nomatch, K?) :- otherwise | true.

%% match_key(K, X, F0, F, K1): a hole K, unknown, takes the key X; a key K matches X where the two are equal.
procedure match_key(Key?, Key?, Found?, Found, Key).
match_key(K, _, nomatch, nomatch, K?).
match_key(K, X, found(Vs), found([X? | Vs?]), K?) :- unknown(K?) | true.
match_key(K, X, found(Vs), found(Vs?), K?) :- K? =?= X? | true.
match_key(K, _, found(_), nomatch, K?) :- otherwise | true.

procedure match_int(Integer?, Integer?, Found?, Found, Integer).
match_int(I, _, nomatch, nomatch, I?).
match_int(I, X, found(Vs), found(Vs?), I?) :- I? =:= X? | true.
match_int(I, _, found(_), nomatch, I?) :- otherwise | true.

%% grant(Id, P, R, Gs, Gs1): the grant of R on the question Id at P, once R, its holes filled, is ground.
procedure grant(Integer?, Path?, Request?, PersonIn(Drawn), PersonIn(Drawn)?).
grant(Id, P, R, [input(Id?, P?, R?) | Gs1?], Gs1) :- ground(R?) | true.

procedure waited(YN?, PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
waited(y, ps(Se, T, Cs, [_ | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
waited(n, St, Gs1?, Gs1, St?, Log1?, Log1).

%% What the person's screen shows (the step wait(C)): the last view written and the notices written after it, the approval questions drawn and not answered, and whether a request question is drawn and not answered.
procedure shows(Cond?, Sess?, List(Output)?, Shows?, YN).
shows(known(Q), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    known_in(Q?, L?, B).
shows(holds(A), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, 1, B).
shows(lacks(A), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, 1, B1),
    flip(B1?, B).
shows(lacks(A, K), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, K?, B1),
    flip(B1?, B).
shows(has(A, K), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, K?, B).
shows(refused(P, Q, D), _, T, _, B?) :- ground(P?), ground(Q?), ground(D?), ground(T?) |
    notices_of(T?, Ns),
    among_output(refused(P?, Q?, D?), Ns?, B).
shows(refused_by(P, Q), _, T, _, B?) :- ground(P?), ground(Q?), ground(T?) |
    ever_refused(P?, Q?, T?, B).
shows(asked(K), _, _, Cs, B?) :- ground(K?), ground(Cs?) |
    find_approval(K?, Cs?, F),
    found_yn(F?, B).
shows(asking, sess(_, _), _, _, y).
shows(asking, nosess, _, _, n).

%% The last view written, or none: the output holds the views and the notices.
procedure last_of(List(Output)?, Last).
last_of(T, L?) :- last_view(T?, nolast, L).
procedure last_view(List(Output)?, Last?, Last).
last_view([], L, L?).
%% The view, view(Id, S, K, A, Ts): the agent's own key, the machine state, the persons it knows, the approvals pending and the tabs (vGLP 12f629d, Section 5.4, "The compilation"), the script looking at the first three.
last_view([view(Me, S, K, _, _) | Xs], _, L?) :- last_view(Xs?, last(Me?, S?, K?), L).
last_view([_ | Xs], L0, L?) :- otherwise | last_view(Xs?, L0?, L).

%% The notices written after the last view, which the screen shows until the next view is written (vGLP f5f1644, Section 5.4, "The compilation": the widget "draws the last view written and the notices written after it").
procedure notices_of(List(Output)?, List(Output)).
notices_of(T, Ns?) :- notices_after(T?, [], Ns).
procedure notices_after(List(Output)?, List(Output)?, List(Output)).
notices_after([], Ns, Ns?).
notices_after([view(_, _, _, _, _) | Xs], _, Ns?) :- notices_after(Xs?, [], Ns).
notices_after([X | Xs], Ns0, Ns?) :- otherwise | notices_after(Xs?, [X? | Ns0?], Ns).
procedure among_output(Output?, List(Output)?, YN).
among_output(_, [], n).
among_output(X, [Y | _], y) :- X? =?= Y? | true.
among_output(X, [_ | Ys], B?) :- otherwise | among_output(X?, Ys?, B).

%% Whether a notice refused(P, Q, D) has been written, whatever its reason and whatever was written after it.
procedure ever_refused(Proposal?, Key?, List(Output)?, YN).
ever_refused(_, _, [], n).
ever_refused(P, Q, [refused(P1, Q1, _) | _], y) :- P? =?= P1?, Q? =?= Q1? | true.
ever_refused(P, Q, [_ | Xs], B?) :- otherwise | ever_refused(P?, Q?, Xs?, B).

procedure known_in(Key?, Last?, YN).
known_in(Q, last(_, _, Ks), B?) :- among_key(Q?, Ks?, B).
known_in(_, nolast, n).

procedure among_key(Key?, List(Key)?, YN).
among_key(_, [], n).
among_key(X, [Y | _], y) :- X? =?= Y? | true.
among_key(X, [_ | Ys], B?) :- otherwise | among_key(X?, Ys?, B).

procedure count_in(Atom?, Last?, Integer).
count_in(A, last(_, S, _), N?) :- count(A?, S?, N).
count_in(_, nolast, 0).

procedure count(Atom?, List(Atom)?, Integer).
count(_, [], 0).
count(X, [Y | Ys], N?) :- X? =?= Y? | count(X?, Ys?, M), N := M? + 1.
count(X, [_ | Ys], N?) :- otherwise | count(X?, Ys?, N).

procedure at_least(Integer?, Integer?, YN).
at_least(N, K, y) :- N? >= K? | true.
at_least(N, K, n) :- N? < K? | true.

procedure flip(YN?, YN).
flip(y, n).
flip(n, y).

procedure found_yn(ApprovalAt?, YN).
found_yn(approval_at(_, _, _), y).
found_yn(noapproval, n).

procedure approved(ApprovalAt?, PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
approved(approval_at(Id, P, Cs1), ps(Se, T, _, [approval(K, A) | Ss]),
         [input(Id?, P?, A?) | Gs?], Gs1, St1?, [gave(K?, A?) | Log?], Log1) :-
    ground(K?), ground(A?) |
    advance(ps(Se?, T?, Cs1?, Ss?), Gs, Gs1?, St1, Log, Log1?).
approved(noapproval, St, Gs1?, Gs1, St?, Log1?, Log1).

%% The approval question of the attempt K, or of an attempt of the class K, the earliest drawn first.
procedure find_approval(Asked?, Shows?, ApprovalAt).
find_approval(K, Cs, F?) :- ground(Cs?) | rev_shown(Cs?, [], Rs), find_approval1(K?, Rs?, [], F).

procedure find_approval1(Asked?, Shows?, Shows?, ApprovalAt).
find_approval1(_, [], _, noapproval).
find_approval1(K, [shown(Id, P, At) | Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(At?), ground(K?), K? =?= At? |
    rev_shown(Done?, Cs?, Rest).
find_approval1(K, [shown(Id, P, attempt(_, _, _, C, _)) | Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(C?), ground(K?), K? =?= C? |
    rev_shown(Done?, Cs?, Rest).
find_approval1(K, [shown(Id, P, hello(_, N)) | Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(N?), ground(K?), K? =?= N? |
    rev_shown(Done?, Cs?, Rest).
find_approval1(K, [S | Cs], Done, F?) :-
    otherwise | find_approval1(K?, Cs?, [S? | Done?], F).

procedure rev_shown(Shows?, Shows?, Shows).
rev_shown([], Acc, Acc?).
rev_shown([S | Ss], Acc, R?) :- rev_shown(Ss?, [S? | Acc?], R).

procedure drop_shown(Integer?, Shows?, Shows).
drop_shown(_, [], []).
drop_shown(Id, [shown(J, _, _) | Cs], Cs?) :- Id? =:= J? | true.
drop_shown(Id, [S | Cs], [S? | Cs1?]) :- otherwise | drop_shown(Id?, Cs?, Cs1).

%% The views and the notices not reported before: the output is drawn whole each time it grows, so those past the old one's length are new.
procedure log_new(List(Output)?, List(Output)?, Stream(Seen), Stream(Seen)?).
log_new([_ | Os], [_ | Ns], Log?, Log1) :- log_new(Os?, Ns?, Log, Log1?).
log_new([], Ns, Log?, Log1) :- put(Ns?, Log, Log1?).
log_new([_ | _], [], Log1?, Log1).

procedure put(List(Output)?, Stream(Seen), Stream(Seen)?).
put([X | Xs], [X? | Log?], Log1) :- put(Xs?, Log, Log1?).
put([], Log1?, Log1).
