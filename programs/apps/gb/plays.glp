%% plays.glp --- the GB mini-app activated as the super-app activates it (GSG paper, Section 2, "Activation and joining"): by run/3, under the type identity of its entry miniapp/4, with its grants; and, for each two executions that transact, with the two ends of one root channel handed to them as their conversation, the play standing in for the social graph, as ../gc/plays.glp does.  The persons are scripted (person.glp), each under its role, and the play returns their screens.  GB requires the day, so each execution is granted a calendar, a stream of dates (GSG, miniapp/4; vGLP, Section 5.4, "Act schemas as local specifications"), which on a device its clock writes and here the play writes: the first day, 1, on each calendar, and day 5 on bob's once his screen shows him answering yes to the loan, so that his bonds are mature by the current date at him, their issuer, when alice presents one (GB:3, Redeem bond: today(Bob,Today)).  The day is no atom of the view (vGLP, Section 5.4, "Act schemas as local specifications"), so no person waits on it.  A run does not end --- the agent's request question stays open and the person channel never closes --- so once each agent has taken its own transactions until none holds and no trigger is left, the run suspends, and a play's result is read off a partial stream.

imported procedure person#miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).

%% play_bonds(A, B, C): alice, bob and carol, a conversation between alice and each of the other two.  Each establishes their identity (GKK:1); alice comes to know bob and carol (GKK:2, an act of both); alice issues five Alice-coins and three Alice-bonds due day 10, and bob four Bob-bonds due day 5, each later than the day their calendar gives (GC:1; GB:1, Issue bond); alice asks bob for a loan, two Alice-coins for three Bob-bonds, and he answers yes (GB:2, Swap coin for bond, an act of both); the day is then day 5, which the play writes on bob's calendar, the issuer's, once he has answered yes; alice redeems a mature Bob-bond against an Alice-coin bob holds (GB:3, Redeem bond, an act of alice); and alice deposits two Alice-coins with carol, the escrow agent, for bob on the condition day 10, and carol answers yes (GB:4, Deposit).  These are the acts of the screens of GB's app (screens/).
exported procedure play_bonds(Stream(Seen), Stream(Seen), Stream(Seen)).
play_bonds(A?, B?, C?) :-
    self_module(M),
    find_type(miniapp/4, T),
    run(miniapp(alice, ch(GA?, DA), ch([conversation(bob, ch(BA?, AB)), conversation(carol, ch(CA?, AC))], _), [1]), T?, M?),
    person # miniapp_person(alice, alice, [bob, carol], ch(DA?, GA), A),
    run(miniapp(bob, ch(GB?, DB), ch([conversation(alice, ch(AB?, BA))], _), [1 | KB?]), T?, M?),
    person # miniapp_person(bob, bob, [alice], ch(DB?, GB), SB),
    cal_when(SB?, B, answered(swap_coin_for_bond(alice, bob, alice, 2, bob, 5, 3), yes), 5, KB),
    run(miniapp(carol, ch(GC?, DC), ch([conversation(alice, ch(AC?, CA))], _), [1]), T?, M?),
    person # miniapp_person(carol, carol, [alice], ch(DC?, GC), C).

procedure count_atom(Atom?, List(Atom)?, Integer).
count_atom(_, [], 0).
count_atom(X, [Y | Ys], N?) :- X? =?= Y? | count_atom(X?, Ys?, M), N := M? + 1.
count_atom(X, [_ | Ys], N?) :- otherwise | count_atom(X?, Ys?, N).

%% play_village(A, B, C, D, E, F, G): the village market of GB's paper, Section 7.1, on the compiled app: alice, bob, charlie, diana, eve and frank, the villagers, and escrow, the escrow agent, under the roles market_alice to market_escrow (person.glp); ten conversations, one between each two who transact, and alice's with frank, whom she comes to know (GKK:2) before she asks eve for frank-coins.  The seven operations: symmetric mutual credit, alice with bob and with charlie 15 coins each, charlie with eve 10, eve with frank 10 (GC:2); the loans, diana's 20 diana-coins for 24 bob-bonds due day 25, and her 15 for 18 frank-bonds due day 28 (GB:2, Swap coin for bond); the payments, bob to alice 5, eve to charlie 6, frank to diana 3, eve to alice 3, each in coins of the payee (GC:3); eve's portfolio swap with charlie, 5 frank-coins for 5 alice-coins (GC:2); charlie's deposit of 5 frank-coins with the escrow agent for frank on the condition day 30, released to frank by the escrow agent and frank (GB:4, Deposit and Release); frank's redemption of 5 diana-coins, one at a time, each against a frank-bond diana holds (GB:3, Redeem coin against bond); and alice's sale of 10 bob-coins to eve for 4 frank-coins (GC:2).  What the day adds, once, on frank's bonds: once frank has redeemed his fifth diana-coin, after the release, and before frank's calendar gives day 28, diana presents a frank-bond to redeem it against a frank-coin, and frank's machine refuses it, the bond not mature by the current date at frank, its issuer; the play then writes day 28 on frank's calendar, and diana redeems a mature frank-bond against a frank-coin he holds (GB:3, Redeem bond: today(Bob,Today)).  The play writes the calendars: day 1 on each; day 25 on bob's once he holds the diana-coins of his loan; day 28 on frank's once diana's screen shows her presentation refused by him; and day 30 on the escrow agent's once it holds the deposit.
exported procedure play_village(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_village(A?, B?, C?, D?, E?, F?, G?) :-
    self_module(M),
    find_type(miniapp/4, T),
    run(miniapp(alice, ch(GA?, DA), ch([conversation(bob, ch(BA?, AB)), conversation(charlie, ch(CA?, AC)), conversation(eve, ch(EA?, AE)), conversation(frank, ch(FA?, AF))], _), [1]), T?, M?),
    person # miniapp_person(alice, market_alice, [bob, charlie, eve, frank], ch(DA?, GA), A),
    run(miniapp(bob, ch(GB?, DB), ch([conversation(alice, ch(AB?, BA)), conversation(diana, ch(DB1?, BD))], _), [1 | KB?]), T?, M?),
    person # miniapp_person(bob, market_bob, [alice, diana], ch(DB?, GB), SB),
    cal_when(SB?, B, holds(coin(diana)), 25, KB),
    run(miniapp(charlie, ch(GC?, DC), ch([conversation(alice, ch(AC?, CA)), conversation(eve, ch(EC?, CE)), conversation(escrow, ch(XC?, CX))], _), [1]), T?, M?),
    person # miniapp_person(charlie, market_charlie, [alice, eve, escrow], ch(DC?, GC), C),
    run(miniapp(diana, ch(GD?, DD), ch([conversation(bob, ch(BD?, DB1)), conversation(frank, ch(FD?, DF))], _), [1]), T?, M?),
    person # miniapp_person(diana, market_diana, [bob, frank], ch(DD?, GD), SD),
    cal_when(SD?, D, refused_by(redeem_bond(diana, frank, 28, frank), frank), 28, KF),
    run(miniapp(eve, ch(GE?, DE), ch([conversation(alice, ch(AE?, EA)), conversation(charlie, ch(CE?, EC)), conversation(frank, ch(FE?, EF))], _), [1]), T?, M?),
    person # miniapp_person(eve, market_eve, [alice, charlie, frank], ch(DE?, GE), E),
    run(miniapp(frank, ch(GF?, DF1), ch([conversation(diana, ch(DF?, FD)), conversation(eve, ch(EF?, FE)), conversation(escrow, ch(XF?, FX)), conversation(alice, ch(AF?, FA))], _), [1 | KF?]), T?, M?),
    person # miniapp_person(frank, market_frank, [diana, eve, escrow, alice], ch(DF1?, GF), F),
    run(miniapp(escrow, ch(GX?, DX), ch([conversation(charlie, ch(CX?, XC)), conversation(frank, ch(FX?, XF))], _), [1 | KX?]), T?, M?),
    person # miniapp_person(escrow, market_escrow, [charlie, frank], ch(DX?, GX), SX),
    cal_when(SX?, G, holds(escrow_coin(frank, charlie, frank, speech(utterance('day 30'), charlie))), 30, KX).

%% cal_when(Xs, Ys, W, D, K): what a person reports, Xs, passed on whole as Ys, and the date D written on the calendar K once it shows W: an atom their last view holds, holds(A), a notice of a refusal of their request P by Q, refused_by(P, Q), whatever its reason, or their answer A to the approval question of an attempt of the class C, answered(C, A).
When ::= holds(Atom) ; refused_by(Proposal, Key) ; answered(Class, YesNo).

procedure cal_when(Stream(Seen)?, Stream(Seen), When?, Integer?, Stream(Integer)).
cal_when([X | Xs], [X? | Ys?], W, D, K?) :-
    ground(X?), ground(W?) |
    met(X?, W?, B),
    cal_then(B?, Xs?, Ys, W?, D?, K).
cal_when([], [], _, _, []).

procedure cal_then(Integer?, Stream(Seen)?, Stream(Seen), When?, Integer?, Stream(Integer)).
cal_then(0, Xs, Ys?, W, D, K?) :- cal_when(Xs?, Ys, W?, D?, K).
cal_then(N, Xs, Ys?, _, D, [D?]) :- N? > 0 | pass(Xs?, Ys).

procedure met(Seen?, When?, Integer).
met(view(_, S, _, _, _), holds(A), N?) :- count_atom(A?, S?, N).
met(refused(P, Q, _), refused_by(P1, Q1), 1) :- P? =?= P1?, Q? =?= Q1? | true.
met(gave(K, A), answered(K1, A1), 1) :- K? =?= K1?, A? =?= A1? | true.
met(_, _, 0) :- otherwise | true.

procedure pass(Stream(Seen)?, Stream(Seen)).
pass([X | Xs], [X? | Ys?]) :- pass(Xs?, Ys).
pass([], []).
