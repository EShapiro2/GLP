%% plays.glp --- the GB mini-app activated as the super-app activates it (GSG paper, Section 2, "Activation and joining"): by run/3, under the type identity of its entry miniapp/3, with its grants; and, for each two executions that transact, with the two ends of one root channel handed to them as their conversation, the play standing in for the social graph, as ../gc/plays.glp does.  The persons are scripted (person.glp), each under its role, and the play returns their screens.  GB requires the day, which the compiled agent reads from the machine's clock by now/1, in whole days, floor(T / 86400000), UTC (vGLP, Section 5.4, "Speech-act schemas as local specifications"); the plays run on one machine, which has one clock, and the scripted persons set it by their steps clock(T) (person.glp): day 1 at the start, and day 5 once bob answers yes to the loan, so that his bonds are mature by the current date at him, their issuer, when alice presents one (GB:3, Redeem bond: today(Bob,Today)).  The day is no atom of the view (vGLP, Section 5.4, "Act schemas as local specifications"), so no person waits on it.  A run does not end --- the agent's request question stays open and the person channel never closes --- so once each agent has taken its own transactions until none holds and no trigger is left, the run suspends, and a play's result is read off a partial stream.

imported procedure person#miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).

%% play_bonds(A, B, C): alice, bob and carol, a conversation between alice and each of the other two.  Each establishes their identity (GKK:1); alice comes to know bob and carol (GKK:2, an act of both); alice issues five Alice-coins and three Alice-bonds due day 10, and bob four Bob-bonds due day 5, each later than day 1, the day the clock gives (GC:1; GB:1, Issue bond); alice asks bob for a loan, two Alice-coins for three Bob-bonds, and he answers yes (GB:2, Swap coin for bond, an act of both); the day is then day 5, which bob, the issuer, sets on the clock once he has answered yes; alice redeems a mature Bob-bond against an Alice-coin bob holds (GB:3, Redeem bond, an act of alice); and alice deposits two Alice-coins with carol, the escrow agent, for bob on the condition day 10, and carol answers yes (GB:4, Deposit).  These are the acts of the screens of GB's app (screens/).
exported procedure play_bonds(Stream(Seen), Stream(Seen), Stream(Seen)).
play_bonds(A?, B?, C?) :-
    self_module(M),
    find_type(miniapp/3, T),
    run(miniapp(alice, ch(GA?, DA), ch([conversation(bob, ch(BA?, AB)), conversation(carol, ch(CA?, AC))], _)), T?, M?),
    person # miniapp_person(alice, alice, [bob, carol], ch(DA?, GA), A),
    run(miniapp(bob, ch(GB?, DB), ch([conversation(alice, ch(AB?, BA))], _)), T?, M?),
    person # miniapp_person(bob, bob, [alice], ch(DB?, GB), B),
    run(miniapp(carol, ch(GC?, DC), ch([conversation(alice, ch(AC?, CA))], _)), T?, M?),
    person # miniapp_person(carol, carol, [alice], ch(DC?, GC), C).

%% play_village(A, B, C, D, E, F, G): the village market of GB's paper, Section 7.1, on the compiled app: alice, bob, charlie, diana, eve and frank, the villagers, and escrow, the escrow agent, under the roles market_alice to market_escrow (person.glp); ten conversations, one between each two who transact, and alice's with frank, whom she comes to know (GKK:2) before she asks eve for frank-coins.  The seven operations: symmetric mutual credit, alice with bob and with charlie 15 coins each, charlie with eve 10, eve with frank 10 (GC:2); the loans, diana's 20 diana-coins for 24 bob-bonds due day 25, and her 15 for 18 frank-bonds due day 28 (GB:2, Swap coin for bond); the payments, bob to alice 5, eve to charlie 6, frank to diana 3, eve to alice 3, each in coins of the payee (GC:3); eve's portfolio swap with charlie, 5 frank-coins for 5 alice-coins (GC:2); charlie's deposit of 5 frank-coins with the escrow agent for frank on the condition day 30, released to frank by the escrow agent and frank (GB:4, Deposit and Release); frank's redemption of 5 diana-coins, one at a time, each against a frank-bond diana holds (GB:3, Redeem coin against bond); and alice's sale of 10 bob-coins to eve for 4 frank-coins (GC:2).  What the day adds, once, on frank's bonds: once frank has paid her three diana-coins, before the clock gives day 28, diana presents a frank-bond to redeem it against a diana-coin frank holds, and frank's machine refuses it, the bond not mature by the current date at frank, its issuer; frank sets the clock to day 28 after his fourth redemption, and once he has redeemed his fifth diana-coin, after the release, diana redeems a mature frank-bond against a frank-coin he holds (GB:3, Redeem bond: today(Bob,Today)).  The persons set the one clock: day 1 at the start; day 25, bob, once he holds the diana-coins of his loan; day 28, frank, after his fourth redemption and before he answers the release; and day 30, the escrow agent, once the release has taken its deposit.
exported procedure play_village(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_village(A?, B?, C?, D?, E?, F?, G?) :-
    self_module(M),
    find_type(miniapp/3, T),
    run(miniapp(alice, ch(GA?, DA), ch([conversation(bob, ch(BA?, AB)), conversation(charlie, ch(CA?, AC)), conversation(eve, ch(EA?, AE)), conversation(frank, ch(FA?, AF))], _)), T?, M?),
    person # miniapp_person(alice, market_alice, [bob, charlie, eve, frank], ch(DA?, GA), A),
    run(miniapp(bob, ch(GB?, DB), ch([conversation(alice, ch(AB?, BA)), conversation(diana, ch(DB1?, BD))], _)), T?, M?),
    person # miniapp_person(bob, market_bob, [alice, diana], ch(DB?, GB), B),
    run(miniapp(charlie, ch(GC?, DC), ch([conversation(alice, ch(AC?, CA)), conversation(eve, ch(EC?, CE)), conversation(escrow, ch(XC?, CX))], _)), T?, M?),
    person # miniapp_person(charlie, market_charlie, [alice, eve, escrow], ch(DC?, GC), C),
    run(miniapp(diana, ch(GD?, DD), ch([conversation(bob, ch(BD?, DB1)), conversation(frank, ch(FD?, DF))], _)), T?, M?),
    person # miniapp_person(diana, market_diana, [bob, frank], ch(DD?, GD), D),
    run(miniapp(eve, ch(GE?, DE), ch([conversation(alice, ch(AE?, EA)), conversation(charlie, ch(CE?, EC)), conversation(frank, ch(FE?, EF))], _)), T?, M?),
    person # miniapp_person(eve, market_eve, [alice, charlie, frank], ch(DE?, GE), E),
    run(miniapp(frank, ch(GF?, DF1), ch([conversation(diana, ch(DF?, FD)), conversation(eve, ch(EF?, FE)), conversation(escrow, ch(XF?, FX)), conversation(alice, ch(AF?, FA))], _)), T?, M?),
    person # miniapp_person(frank, market_frank, [diana, eve, escrow, alice], ch(DF1?, GF), F),
    run(miniapp(escrow, ch(GX?, DX), ch([conversation(charlie, ch(CX?, XC)), conversation(frank, ch(FX?, XF))], _)), T?, M?),
    person # miniapp_person(escrow, market_escrow, [charlie, frank], ch(DX?, GX), G).
