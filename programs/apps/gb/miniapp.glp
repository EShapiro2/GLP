%% miniapp.glp --- the canonical CVA platform of this directory, platform.vglp, as a mini-app of the Grassroots Super-App (GSG paper, Section 2, "Activation and joining" and "What the super-app grants a mini-app").  It is the file of the other apps of programs/apps (../gsg/miniapp.glp) but for the calendar: GB requires the day, so its agent reads the calendar the super-app grants (vGLP, Section 5.4, "Act schemas as local specifications": "the compiled agent reads, with its triggers, a calendar, a stream of dates the device writes, one a day"), where the agent of a platform with no day ignores it; the suite's Section APPS holds the two files equal but for that.
%%
%% miniapp(Id, Ui, Sg, Cal) is the entry the super-app activates by run/3: the instance of the root's entry template miniapp/4 (programs/self.glp) at the mini-app's two types, Drawn, what its dispatcher draws for its person, and Net, the platform's network messages, which its root channels carry.  Its grants: Id, the person's key, which the super-app holds and which is the person's identity (GSG:1, Identity), the agent's Peer; Ui, the person channel (vGLP, Definition "Person Channel, Person Writer, GLP with Persons, Grant"); Sg, the channel to the social graph, down which the social graph hands the mini-app, at each invitation, one end of the root channel of a conversation with the execution of this program at a friend; and Cal, the calendar, a stream of dates the device writes from its clock, one a day (GSG, miniapp/4), which the agent reads with its triggers and holds as today(d), d the last date read (vGLP, Section 5.4, "Act schemas as local specifications").  The mini-app holds nothing else, and calls nothing that reaches the network or the person, so the program is certified.
%%
%% It runs the platform's agent with the person's key as its Peer and the dispatcher on the agent's asks, as the canonical compilation runs a vGLP program (vGLP, "The canonical compilation"): the agent's questions, its request questions and approval questions, are drawn on the person channel, and its thread, the program's output to the person, is drawn as construct 0.  The agent's network is the conversations: each message msg(Q, C) the agent sends goes on the conversation with Q, and each message arriving on a conversation joins the agent's input.

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output), Stream(Integer)?, Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
miniapp(Id, Ui, ch(Down, Up?), Cal) :-
    ground(Id?) |
    platform # agent(Id?, NetIn?, NetOut, Thread, Cal?, Asks),
    platform # dispatch(Asks?, Ui?, MCh),
    to_person(MCh?, Thread?),
    from_sg(Down?, SgEvents, Closed),
    from_agent(NetOut?, AgentEvents),
    merge(SgEvents?, AgentEvents?, Events),
    route_net(Events?, [], [], [], NetIn, Invites),
    upward(Closed?, Invites?, Up).

%% The program's output to its person, the thread, on the dispatcher's channel to the program, which draws it as construct 0 (vGLP, "The canonical compilation").
procedure to_person(Channel(Stream(_), Stream(Output))?, Stream(Output)?).
to_person(ch(_, O?), O).

%% =============================================================================
%% The network over the conversations
%% =============================================================================

%% The social graph's stream: each conversation, as it opens, and each friend the program asked to invite who declined, lacks the program or is unknown, declined(K) (GSA paper, Section 3, "Distribution with an invitation").  A held end is passed over: the platform forwards no variable of a conversation.  Closed closes when the social graph's stream does, and with it the stream up to the social graph (upward/3).
procedure from_sg(Stream(SgToApp(Net))?, Stream(NetEvent), Stream(AppToSg)).
from_sg([conversation(K, Ch) | Down], [opened(K?, Ch?) | Es?], Up?) :-
    from_sg(Down?, Es, Up).
from_sg([held(_, _) | Down], Es?, Up?) :-
    from_sg(Down?, Es, Up).
from_sg([declined(K) | Down], [declined(K?) | Es?], Up?) :-
    from_sg(Down?, Es, Up).
from_sg([], [], []).

%% upward(Closed, Asks, Up): the router's requests up the social-graph channel, each as it comes, until the social graph's stream closes, which closes the stream up to it (GSA paper, Section 3, "What the Grassroots App grants a program": over the channel to the social graph "the program asks the social graph to invite a friend").
procedure upward(Stream(AppToSg)?, Stream(AppToSg)?, Stream(AppToSg)).
upward([], _, []).
upward(C, [A | As], [A? | Up?]) :- upward(C?, As?, Up).
upward(C, [], C?).

%% The agent's network output, each message as it is sent.
procedure from_agent(Stream(Net)?, Stream(NetEvent)).
from_agent([M | Ms], [sent(M?) | Es?]) :- from_agent(Ms?, Es).
from_agent([], []).

%% route_net(Events, Routes, Held, Asked, In, Asks): a conversation opened joins its incoming stream to the agent's input In, sends on it the messages held for its peer, in the order sent, and becomes the peer's route; a message the agent sent goes on the route to its recipient, and is held, in order, while no conversation with the recipient is open, the network delivering every message the agent sends (vGLP, Section 5.4, "Communicate is the agent goal's reading of a message the network streams carried to it").  The first message held for a peer asks, on Asks, for the invitation of that peer, once: Asked holds the peers asked for; the peer declined, lacking the program or unknown, the messages held for it are dropped and it is asked for again by the next (GSA paper, Section 3, "Distribution with an invitation": "the program's first message to a friend it has no conversation with is its request to invite him, which it hands to the Grassroots App over its social-graph channel, naming Bob, and the message waits until the conversation opens").
procedure route_net(Stream(NetEvent)?, Routes?, List(Net)?, List(Key)?, Stream(Net), Stream(AppToSg)).
route_net([opened(K, ch(I, O?)) | Es], Rs, Hs, As, In?, Up?) :-
    ground(K?), ground(Hs?) |
    merge(I?, In1?, In),
    flush(K?, Hs?, O, T?, Hs1),
    route_net(Es?, [route(K?, T) | Rs?], Hs1?, As?, In1, Up).
route_net([sent(msg(Q, C)) | Es], Rs, Hs, As, In?, Up?) :-
    ground(Q?), ground(C?) |
    send(Q?, msg(Q?, C?), Rs?, Rs1, S),
    hold_ask(S?, Q?, Hs?, Hs1, As?, As1, Up, Up1?),
    route_net(Es?, Rs1?, Hs1?, As1?, In, Up1).
route_net([declined(K) | Es], Rs, Hs, As, In?, Up?) :-
    ground(K?), ground(Hs?), ground(As?) |
    drop_held(K?, Hs?, Hs1),
    drop_key(K?, As?, As1),
    route_net(Es?, Rs?, Hs1?, As1?, In, Up).
route_net([], Rs, _, _, [], []) :-
    close_routes(Rs?).

%% router(Events, Routes, Held, In): the routing alone, its requests read and passed over, for a play of the router by itself (../gsg/plays.glp, play_held).
exported procedure router(Stream(NetEvent)?, Routes?, List(Net)?, Stream(Net)).
router(Es, Rs, Hs, In?) :-
    route_net(Es?, Rs?, Hs?, [], In, Asks),
    pass_asks(Asks?).

procedure pass_asks(Stream(AppToSg)?).
pass_asks([_ | As]) :- pass_asks(As?).
pass_asks([]).

%% hold_ask(S, Q, Hs, Hs1, As, As1, Up, Up1): a message that went is done; a message held is appended to Hs, and the invitation of Q asked for on Up where Q has not been asked for before.
procedure hold_ask(Sending?, Key?, List(Net)?, List(Net), List(Key)?, List(Key), Stream(AppToSg), Stream(AppToSg)?).
hold_ask(went, _, Hs, Hs?, As, As?, U?, U).
hold_ask(held(M), Q, Hs, Hs1?, As, As1?, U?, V) :-
    append_net(Hs?, M?, Hs1),
    asked(Q?, As?, As1, U, V?).

%% drop_held(K, Hs, Hs1): the messages held for K dropped, the others kept in order; drop_key(K, As, As1): K no longer among the peers asked for, so that a later message to K asks again (GSA paper, Section 3, "Distribution with an invitation"; GSA #2, 2026-11-07 21:58 UTC, Udi approving).
procedure drop_held(Key?, List(Net)?, List(Net)).
drop_held(K, [msg(Q, C) | Hs], Hs1?) :- K? =?= Q?, ground(C?) | drop_held(K?, Hs?, Hs1).
drop_held(K, [M | Hs], [M? | Hs1?]) :- otherwise | drop_held(K?, Hs?, Hs1).
drop_held(_, [], []).

procedure drop_key(Key?, List(Key)?, List(Key)).
drop_key(K, [Q | Qs], Qs1?) :- K? =?= Q? | drop_key(K?, Qs?, Qs1).
drop_key(K, [Q | Qs], [Q? | Qs1?]) :- otherwise | drop_key(K?, Qs?, Qs1).
drop_key(_, [], []).

%% asked(Q, As, As1, Up, Up1): Q among the peers asked for, or invite(Q) on Up and Q added.
procedure asked(Key?, List(Key)?, List(Key), Stream(AppToSg), Stream(AppToSg)?).
asked(Q, [], [Q?], [invite(Q?) | U?], U) :- ground(Q?) | true.
asked(Q, [K | Ks], [K? | Ks?], U?, U) :- Q? =?= K? | true.
asked(Q, [K | Ks], [K? | Ks1?], U?, V) :- otherwise | asked(Q?, Ks?, Ks1, U, V?).

%% send(Q, M, Rs, Rs1, S): M on the route to Q, the newest first.
procedure send(Key?, Net?, Routes?, Routes, Sending).
send(Q, M, [route(K, [M? | W?]) | Rs], [route(K?, W) | Rs?], went) :-
    Q? =?= K? | true.
send(Q, M, [R | Rs], [R? | Rs1?], S?) :-
    otherwise | send(Q?, M?, Rs?, Rs1, S).
send(_, M, [], [], held(M?)).

%% A message with no route, held after those held before it.
procedure hold(Sending?, List(Net)?, List(Net)).
hold(went, Hs, Hs?).
hold(held(M), Hs, Hs1?) :- append_net(Hs?, M?, Hs1).

procedure append_net(List(Net)?, Net?, List(Net)).
append_net([H | Hs], M, [H? | Hs1?]) :- append_net(Hs?, M?, Hs1).
append_net([], M, [M?]).

%% flush(K, Hs, O, T, Hs1): the messages held for K written on O, in order, followed by T; those held for others kept, in order, in Hs1.
procedure flush(Key?, List(Net)?, Stream(Net), Stream(Net)?, List(Net)).
flush(K, [msg(Q, C) | Hs], [msg(Q?, C?) | O?], T, Hs1?) :-
    K? =?= Q? | flush(K?, Hs?, O, T?, Hs1).
flush(K, [M | Hs], O?, T, [M? | Hs1?]) :-
    otherwise | flush(K?, Hs?, O, T?, Hs1).
flush(_, [], T?, T, []).

%% Every conversation's outgoing stream closed, once the social graph's stream and the agent's have ended.
procedure close_routes(Routes?).
close_routes([route(_, []) | Rs]) :- close_routes(Rs?).
close_routes([]).
