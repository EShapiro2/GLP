%% ---------------------------------------------------------------------------
%% programs/apps/gkk --- the app of GKK, Grassroots Keys and Knowledge (GSC's contract, programs/gsc/GKK.txt and GKK.glp; Coordination Appendix C), the base mini-app of the grassroots app, which every other mini-app extends, as a mini-app of the Grassroots Super-App (GSG paper, Section 2), compiled down the abstraction cascade from its act schemas: the canonical CVA platform vGLP's compiler prints from them, platform.vglp (vGLP, Section 3.2, Definition "Canonical CVA Platform"; Section 5.4, "The compilation"), compiled to GLP by the canonical compilation when the directory loads (vGLP, Section 6.3, "The canonical compilation").
%%
%% The directory is a certified program of its own: the platform, the mini-app entry miniapp/4 that wraps it (miniapp.glp), its scripted person (person.glp) and the play that activates it by run/3, three executions over two conversations, with no super-app (plays.glp).  It calls nothing that reaches the network or the person, so the REPL's :artefact certifies it, and its artefact gkk.glpw is what the super-app installs.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module, as every hand-written module importing a compiled procedure restates them today (the plays of programs/vglp/cva/social_graph likewise).  The compiled module's own definitions shadow these within it, and the two must agree.
%% ---------------------------------------------------------------------------

Peer     ::= Key.
Class    ::= establish(Peer) ; acquaint(Peer, Peer) ; introduce(Peer, Peer, Peer).
Proposal ::= establish(Peer) ; acquaint(Peer, Peer) ; introduce(Peer, Peer, Peer).
Request  ::= propose(Proposal) ; refresh.
YesNo    ::= yes ; no.
Reason   ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote     ::= yes ; no(Reason).
Decision ::= commit ; abort(Peer, Reason) ; yield.
Rho      ::= one(Class) ; rho(Proposal).
Names    ::= none ; request(Rho, Integer).
Attempt  ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo    ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
           ; yield(Attempt) ; request(Rho, Integer).
Content  ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= identity ; knows(Peer).
Output   ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab      ::= tab(String, Constant) ; tab(String, Constant, Constant).
Asking   ::= Attempt ; hello(Peer, Proposal).
Approved ::= Proposal.
Approval ::= approval(Asking, List(Word), YesNo?).
Word     ::= text(String) ; person(Peer) ; named(String, Peer) ; valued(String, Integer) ; held(Atom, Integer).
Question ::= request_r(Request?) ; approval_w(Approval).
Drawn    ::= request_r(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

%% What the mini-app's scripted person reports, its screen (person.glp): each view the program writes, once, view(Id, S, K, A, Ts), the agent's own key, the machine state, the persons the agent knows, the approvals pending and the tabs (vGLP 12f629d, Section 5.4, "The compilation"), and each notice, refused(P, Q, D) (vGLP f0acbc1, Section 5.4, "The compilation"); the agent's own key and the persons it knows, as the last view drawn shows them, where the script looks; and each answer it gives an approval question, of the attempt or of an attempt of the class its script names.
Asked    ::= Class ; Attempt.
Seen     ::= Output ; menu(Key, List(Key)) ; gave(Asked, YesNo).

%% The network of the platform over the conversations (miniapp.glp): what its router reads, a conversation the social graph opened, the peer's key and this side's end of its root channel, or a message the agent sent; a conversation's route, the peer's key and the writer of the conversation's outgoing stream; and whether a message went on a conversation or is held for one not yet open.
NetEvent ::= opened(Key, RootChannel(Net)) ; sent(Net).
Route    ::= route(Key, Stream(Net)?).
Routes   ::= [] ; [Route | Routes].
Sending  ::= went ; held(Net).

%% The mini-app's entry, the instance of the root's entry template miniapp/4 (programs/self.glp) at the mini-app's two types: Drawn, what its dispatcher draws for its person, and Net, the messages of its root channels, the platform's network messages (miniapp.glp).
imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
miniapp(Id, Ui, Sg, Cal) :- miniapp # miniapp(Id?, Ui?, Sg?, Cal?).

%% The scripted person, the instance of the root's second template miniapp_person/5 at Drawn and at Seen, the screen it reports.
imported procedure person#miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Id, Role, Ps, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, Ps?, PEnd?, Screen).

%% The play with no super-app (plays.glp).
imported procedure plays#play_keys(Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_keys(Stream(Seen), Stream(Seen), Stream(Seen)).
play_keys(A?, B?, C?) :- plays # play_keys(A, B, C).

%% Every agent's initial goal, agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), is answered by this program: "A boot defines no agent/2: the program it loads answers the initial goal, in a simulation as on a phone, and the person goal's first act names the entry the program starts" (IGLP, Implementation Notes, "Boot").  The person's first act, gkk_agent, names the entry, the mini-app as maGLP (maglp.glp); the acts after it are the agents the person names, call(Q), and the grants on the mini-app's questions, input(I, P, D).  What the agent writes the person is what the mini-app draws, and called(Q, Kq), the key of an agent the person named.  The network messages are cold calls, each a conversation, conv(K, Kq, Ch): the caller's key, a writer for the called agent's key, and the called agent's end of the conversation's root channel; pending(Q, Kq, Ch) is the caller's end, until Kq is assigned.
MaStart   ::= gkk_agent.
MaPIns ::= [MaStart | MaIns].
MaIn      ::= call(Key) ; input(Integer, Path, Drawn).
MaIns     ::= [MaIn | MaIns].
MaConv    ::= conv(Key, Key?, RootChannel(Net)).
MaPending ::= pending(Key, Key, RootChannel(Net)).
MaOut     ::= Draw(Drawn) ; called(Key, Key).
MaOuts    ::= [MaOut | MaOuts].

imported procedure maglp#gkk_agent(MaIns?, MaOuts, Stream(NetMsg(MaConv))?, Stream(NetMsg(MaConv))).

exported procedure agent(Channel(MaPIns, MaOuts)?, Channel(Stream(NetMsg(MaConv)), Stream(NetMsg(MaConv)))?).
agent(ch(In, POut?), ch(N, NOut?)) :- start(In?, POut, N?, NOut).

%% The entry the person's first act names.
procedure start(MaPIns?, MaOuts, Stream(NetMsg(MaConv))?, Stream(NetMsg(MaConv))).
start([gkk_agent | PIn], POut?, N, NOut?) :- maglp # gkk_agent(PIn?, POut, N?, NOut).
