%% gsn_boot.glp --- the app of GSN, the grassroots social network, on two smartphones (GSG paper, Sections 2 and 6, "The Grassroots Super-App" and "Mini-Apps on the Prototype"), as gsg_boot.glp runs GSG's app: under the boot harness, one isolate per person, each with its own key pair, running the social graph of programs/social/graph/core as its super-app and hosting GSN's mini-app (programs/apps/gsn).  The program is graph/core, named as :boot's second argument, and this file is loaded on top of it, calling its exported agent/4 (IGLP, Implementation Notes, "The scope a boot source is checked in"); the super-app is not edited:
%%   :artefact programs/apps/gsn programs/social/graph/core
%%   :boot programs/apps/gsn_boot.glp programs/social/graph/core
%%
%% Each person trusts the compiler's key, reads the certified artefact gsn.glpw from graph/core with load_file/2 and installs it, with one end of a person channel; alice connects to bob, they befriend in the super-app's social graph across the isolates, alice invites bob to the mini-app, bob consents, and the handshake opens a root channel between their two executions.  Over that conversation the mini-app runs GSN's contract, as play_network of programs/apps/gsn runs it: each establishes their identity (GKK:1), they come to know each other (GKK:2) and become friends (GSG:1), alice creates the group friends, adds bob to it and sends him the message 'Hi Bob', bob sends the group the message 'Hi all', which alice delivers to him, and bob leaves the group.  The other end of each person channel is the mini-app's own scripted person (programs/apps/gsn/person.glp), activated from the module value under its role; its screen goes to the person, one line each, and so does what the super-app told the person of the friendship in its own social graph, sg(...).
%%
%% The boot settles, as gsg_boot.glp's does: the boot harness reduces each event until the program is quiescent, as the device runtime does (IGLP, Implementation Notes: "On each event the agent binds what the event delivers, reduces until quiescent"), and after each event the platform's agent takes its own transactions until none holds and then waits for the next (vGLP, Section 5.4, "Triggers").  Section APPS of the suite runs this file and holds each person's lines, in order.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, alice, [bob], ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, bob, [alice], ch(_?, _))@bob.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/4, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"): it tells the agent its role in the mini-app's play, its own name and the names of the persons it knows --- alice knows bob and bob knows alice --- each name a variable standing for a key (IGLP, Remark "Agent Names"; Boot: "the ground arguments of P carry the keys the person knows, and the person gives them to the agent as a person makes an acquaintance").  By them agent/2 starts the agent's smartphone, gsn_phone/4, on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network (GLP-Spec appendix-guards.tex, "Identity and signature").  No peer is named here by an atom: the only names are the person goal's, and the clauses below take every peer from the list the person gave.
Role     ::= alice ; bob.
BootSays ::= init(Role, Key, List(Key)).
exported procedure agent(Channel(Stream(BootSays), Stream(Constant))?, Channel(NetInStream, NetOutStream)?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The agent's smartphone, by the role, the name and the peers its person tells it.
procedure start(Stream(BootSays)?, NetInStream?).
start([init(R, Me, Ps) | _], N) :- gsn_phone(R?, Me?, Ps?, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its role, its name and the names it knows, and reads nothing.
exported procedure say(Role?, Key?, List(Key)?, Channel(Stream(Constant), Stream(BootSays))?).
say(R, Me, Ps, ch(_, [init(R?, Me?, Ps?)])).

%% One smartphone: the super-app's agent on the isolate's network under the person's own name, the mini-app read from its artefact beside the program and installed, and the person's acts by role, over the one peer the person knows.  The mini-app's scripted person is activated under the role, which chooses its script, with the key the person knows, by which the script names its peer (programs/self.glp, the template miniapp_person/5: "a role choosing the script among the mini-app's own plays").
procedure gsn_phone(Role?, Key?, List(Key)?, NetInStream?).
gsn_phone(alice, Me, [Q], NetIn) :-
    agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsn.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_gsn(Me?, Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, alice, [Q?], PersonEnd?, Screen),
    send_to_user(Screen?).
gsn_phone(bob, Me, [P], NetIn) :-
    agent(Me?, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsn.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_gsn(Me?, P?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, Me?, bob, [P?], PersonEnd?, Screen),
    send_to_user(Screen?).
%% A person who knows nobody, or more than the one the play gives, has no smartphone here.
gsn_phone(_, _, _, _) :- otherwise | true.

%% alice's acts on her super-app: trust the compiler's key, install the mini-app with her end of its person channel, connect to the one she knows, and once connected invite them to the mini-app.
procedure alice_gsn(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_gsn(Me, Q, C, CK, CSig, AppEnd, Outs,
          [msg(person, Me?, trust(CK?)),
           msg(person, Me?, install(gsn, C?, CSig?, AppEnd?)),
           msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    alice_gsn_run(Me?, Q?, Outs?, Cmds).
procedure alice_gsn_run(Key?, Key?, AgentToUserStream?, UserInStream).
alice_gsn_run(Me, Q, [msg(agent, person, connected(Q1)) | Outs],
              [msg(person, Me?, invite(gsn, Q?)) | Cmds?]) :-
    Q1? =?= Q? |
    send_to_user([sg(connected(Q1?))]),
    alice_gsn_run(Me?, Q?, Outs?, Cmds).
alice_gsn_run(Me, Q, [_ | Outs], Cmds?) :- otherwise | alice_gsn_run(Me?, Q?, Outs?, Cmds).
alice_gsn_run(_, _, [], []).

%% bob's acts on his: trust the compiler's key, install the mini-app with his end of its person channel, consent in advance to the invitation of the one he knows, and consent to their request to connect.
procedure bob_gsn(Key?, Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_gsn(Me, P, C, CK, CSig, AppEnd, Outs,
        [msg(person, Me?, trust(CK?)),
         msg(person, Me?, install(gsn, C?, CSig?, AppEnd?)),
         msg(person, Me?, accept_invite(gsn, P?)) | Cmds?]) :-
    ground(Me?), ground(P?) |
    bob_gsn_run(Me?, P?, Outs?, Cmds).
procedure bob_gsn_run(Key?, Key?, AgentToUserStream?, UserInStream).
bob_gsn_run(Me, P, [msg(agent, person, befriend(P1, X)) | Outs],
            [msg(person, Me?, decision(yes, P?, X?)) | Cmds?]) :-
    P1? =?= P? |
    send_to_user([sg(befriend(P1?))]),
    bob_gsn_run(Me?, P?, Outs?, Cmds).
bob_gsn_run(Me, P, [msg(agent, person, connected(P1)) | Outs], Cmds?) :-
    P1? =?= P? |
    send_to_user([sg(connected(P1?))]),
    bob_gsn_run(Me?, P?, Outs?, Cmds).
bob_gsn_run(Me, P, [_ | Outs], Cmds?) :- otherwise | bob_gsn_run(Me?, P?, Outs?, Cmds).
bob_gsn_run(_, _, [], []).

%% The creator's certification, signed here over the mini-app's source identity, the contract's fourteen act schemas, establish, acquaint, introduce, befriend, unfriend, message, create, join, leave, close, drop, post_own, post and deliver (programs/gsc/GSN.glp), and the checker's verdict (GSG paper, Section 2, "A mini-app is a certified program"), as the super-app's plays sign it (superapp_plays.glp, certified/3); and the compiler's key the artefact's certificate carries, which the person trusts.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [establish, acquaint, introduce, befriend, unfriend, message, create, join, leave, close, drop, post_own, post, deliver], grassroots), K?, CSig).

%% The mini-app's scripted person activated from the module value by run/3, at the type identity of the second template's opaque instance at the type the module's exports record for miniapp_person/5, on the person's end of the person channel whose other end the super-app installs the mini-app with; where the person channel's type the module records for the person is not the entry's, no person runs, its end held for good.  Written again from superapp_plays.glp (miniapp_person_run/6, person_at/8) and core/self.glp (hold_person/1), which do not export them, as in gsg_boot.glp.
procedure miniapp_person_run(Content?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, Ps, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/4, M?, H0),
    opaque_type(miniapp_person/5, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, Ps?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D, S], M, Id, Role, Ps, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/5, [D?, S?], T),
    run(miniapp_person(Id?, Role?, Ps?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

procedure hold_person(Channel(PersonOut(Opaque), PersonIn(Opaque))?).
hold_person(ch([_ | Ds], Gs?)) :- hold_person(ch(Ds?, Gs)).
