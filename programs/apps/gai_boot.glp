%% gai_boot.glp --- the app of GAI, accountable AI agents, on three smartphones (GSG paper, Sections 2 and 6, "The Grassroots Super-App" and "Mini-Apps on the Prototype"), as gsnp_boot.glp runs GSNP's app on five: under the boot harness, one isolate per agent, each with its own key pair, running the social graph of programs/social/graph/core as its super-app and hosting GAI's mini-app (programs/apps/gai).  An agent of GAI's paper is "a person or an AI agent, with its machine" (Section 3.2), so alf, alice's AI agent, has a smartphone of its own, on which its program takes the AI agent's acts.  The program is graph/core, named as :boot's second argument, and this file is loaded on top of it, calling its exported agent/4 (IGLP, Implementation Notes, "The scope a boot source is checked in"); the super-app is not edited:
%%   :artefact programs/apps/gai programs/social/graph/core
%%   :boot programs/apps/gai_boot.glp programs/social/graph/core
%%
%% The agents are those of the play of programs/apps/gai, alice, alf and bob (plays.glp there).  Each trusts the compiler's key, reads the certified artefact gai.glpw from graph/core with load_file/2 and installs it, with one end of a person channel.  alice connects to alf; once connected, alf connects to bob, and bob to alice; each pair befriends in the super-app's social graph across the isolates; once connected to the next, each invites them to the mini-app, and the invitee, having consented in advance, joins it, each handshake opening a root channel between the two executions.  Over those three conversations the mini-app runs GAI's contract, as play_agents of programs/apps/gai runs it: alice and bob establish their identities (GKK:1) and meet (GKK:2); alice signs the code of alf and holds it (GAI:1), and enters her AI agent alf with it, attesting that alf runs it (GnW:1, GAI:1, GAI:2); alice, its principal, proposes alf's meeting with bob, her machine filling the attestation from her record, alf and bob asked, bob recording alf, its principal and its attestation (GnW:2, GAI:2), and then its befriending him, alf and bob asked (GnW:2); bob and alice become friends (GSG:1); alice retires alf (GAI:4); and bob ends his friendship with alf (GSG:2).  The item of the paper's example is GSNP's, the full platform (gsnp_boot.glp).  The other end of each person channel is the mini-app's own scripted person (programs/apps/gai/person.glp), alf's the AI agent's program, activated from the module value under its role; its screen goes to the agent, one line each, and so does what the super-app told the agent of the friendships in its own social graph, sg(...).
%%
%% The boot settles, as gsnp_boot.glp's does: the boot harness reduces each event until the program is quiescent, as the device runtime does (IGLP, Implementation Notes: "On each event the agent binds what the event delivers, reduces until quiescent"), and after each event the platform's agent takes its own transactions until none holds and then waits for the next (vGLP, Section 5.4, "Triggers").  Section APPS of the suite runs this file and holds each agent's lines, in order.

procedure boot.
boot :-
    gai_phone(alice, _)@alice,
    gai_phone(alf, _)@alf,
    gai_phone(bob, _)@bob.

%% One smartphone: the super-app's agent on the isolate's network, the mini-app read from its artefact beside the program and installed, and the agent's acts on its super-app, given the agent before it in the ring alice, alf, bob, whose invitation it accepts, the agent after it, whom it connects to and invites, and whether it connects first.
procedure gai_phone(Key?, NetInStream?).
gai_phone(alice, NetIn) :-
    agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gai.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gai_acts(alice, bob, alf, first, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, alice, alice, PersonEnd?, Screen),
    send_to_user(Screen?).
gai_phone(alf, NetIn) :-
    agent(alf, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gai.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gai_acts(alf, alice, bob, later, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, alf, alf, PersonEnd?, Screen),
    send_to_user(Screen?).
gai_phone(bob, NetIn) :-
    agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gai.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gai_acts(bob, alf, alice, later, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, bob, bob, PersonEnd?, Screen),
    send_to_user(Screen?).

%% Whether an agent connects to the one after it at once, or once the one before it has connected to it.
Start ::= first ; later.

%% The agent's first acts on its super-app: trust the compiler's key, install the mini-app with its end of its person channel, and consent in advance to the invitation of the one before it; the first of the ring then connects to the one after it.
procedure gai_acts(Key?, Key?, Key?, Start?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
gai_acts(Me, P, Q, first, C, CK, CSig, AppEnd, Outs,
         [msg(person, Me?, trust(CK?)),
          msg(person, Me?, install(gai, C?, CSig?, AppEnd?)),
          msg(person, Me?, accept_invite(gai, P?)),
          msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(P?), ground(Q?) |
    gai_run(Me?, P?, Q?, first, Outs?, Cmds).
gai_acts(Me, P, Q, later, C, CK, CSig, AppEnd, Outs,
         [msg(person, Me?, trust(CK?)),
          msg(person, Me?, install(gai, C?, CSig?, AppEnd?)),
          msg(person, Me?, accept_invite(gai, P?)) | Cmds?]) :-
    ground(Me?), ground(P?) |
    gai_run(Me?, P?, Q?, later, Outs?, Cmds).

%% The agent's acts on what its super-app tells it: consent to the request to connect of the one before it; once connected to the one before it, connect to the one after, unless it connected first; and once connected to the one after, invite them to the mini-app.
procedure gai_run(Key?, Key?, Key?, Start?, AgentToUserStream?, UserInStream).
gai_run(Me, P, Q, S, [msg(agent, person, befriend(P1, X)) | Outs],
        [msg(person, Me?, decision(yes, P1?, X?)) | Cmds?]) :-
    ground(Me?), ground(P?), P1? =?= P? |
    send_to_user([sg(befriend(P1?))]),
    gai_run(Me?, P?, Q?, S?, Outs?, Cmds).
gai_run(Me, P, Q, later, [msg(agent, person, connected(P1)) | Outs],
        [msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(P?), ground(Q?), P1? =?= P? |
    send_to_user([sg(connected(P1?))]),
    gai_run(Me?, P?, Q?, later, Outs?, Cmds).
gai_run(Me, P, Q, first, [msg(agent, person, connected(P1)) | Outs], Cmds?) :-
    ground(P?), P1? =?= P? |
    send_to_user([sg(connected(P1?))]),
    gai_run(Me?, P?, Q?, first, Outs?, Cmds).
gai_run(Me, P, Q, S, [msg(agent, person, connected(Q1)) | Outs],
        [msg(person, Me?, invite(gai, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?), Q1? =?= Q? |
    send_to_user([sg(connected(Q1?))]),
    gai_run(Me?, P?, Q?, S?, Outs?, Cmds).
gai_run(Me, P, Q, S, [_ | Outs], Cmds?) :-
    otherwise | gai_run(Me?, P?, Q?, S?, Outs?, Cmds).
gai_run(_, _, _, _, [], []).

%% The creator's certification, signed here over the mini-app's source identity, the contract's sixteen act schemas, establish, meet, introduce, befriend, unfriend_p, unfriend_q, enter, agent_meet, agents_meet, agent_befriend, agents_befriend, agent_unfriend, retire, sign, message and forward (programs/gai/GAI.glp at GLP 9d736804), and the checker's verdict (GSG paper, Section 2, "A mini-app is a certified program"), as the super-app's plays sign it (superapp_plays.glp, certified/3); and the compiler's key the artefact's certificate carries, which the person trusts.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [establish, meet, introduce, befriend, unfriend_p, unfriend_q, enter, agent_meet, agents_meet, agent_befriend, agents_befriend, agent_unfriend, retire, sign, message, forward], grassroots), K?, CSig).

%% The mini-app's scripted person activated from the module value by run/3, at the type identity of the second template's opaque instance at the type the module's exports record for miniapp_person/4, on the person's end of the person channel whose other end the super-app installs the mini-app with; where the person channel's type the module records for the person is not the entry's, no person runs, its end held for good.  Written again from superapp_plays.glp (miniapp_person_run/5, person_at/7) and core/self.glp (hold_person/1), which do not export them, as in gsg_boot.glp, gsn_boot.glp and gsnp_boot.glp.
procedure miniapp_person_run(Content?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/4, M?, H0),
    opaque_type(miniapp_person/4, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D, S], M, Id, Role, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/4, [D?, S?], T),
    run(miniapp_person(Id?, Role?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

procedure hold_person(Channel(PersonOut(Opaque), PersonIn(Opaque))?).
hold_person(ch([_ | Ds], Gs?)) :- hold_person(ch(Ds?, Gs)).
