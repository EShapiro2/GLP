%% gsnp_boot.glp --- the app of GSNP, the grassroots social network with provenance, on five smartphones (GSG paper, Sections 2 and 6, "The Grassroots Super-App" and "Mini-Apps on the Prototype"), as gsn_boot.glp runs GSN's app on two: under the boot harness, one isolate per person, each with its own key pair, running the social graph of programs/social/graph/core as its super-app and hosting GSNP's mini-app (programs/apps/gsnp).  The program is graph/core, named as :boot's second argument, and this file is loaded on top of it, calling its exported agent/4 (IGLP, Implementation Notes, "The scope a boot source is checked in"); the super-app is not edited:
%%   :artefact programs/apps/gsnp programs/social/graph/core
%%   :boot programs/apps/gsnp_boot.glp programs/social/graph/core
%%
%% The persons are those of the play of GAI's GSNP figure, dan, eve, carol, bob and fay (plays.glp of programs/apps/gsnp).  Each trusts the compiler's key, reads the certified artefact gsnp.glpw from graph/core with load_file/2 and installs it, with one end of a person channel.  dan connects to eve; once connected, eve connects to carol, carol to bob and bob to fay; each pair befriends in the super-app's social graph across the isolates; once connected to the next, each invites them to the mini-app, and the invitee, having consented in advance, joins it, each handshake opening a root channel between the two executions.  Over those four conversations the mini-app runs GSNP's contract, as play_provenance of programs/apps/gsnp runs it: each establishes their identity (GSG:1); dan and eve, eve and carol, carol and bob, and bob and fay become friends; dan signs the item 'Flood on Main Street' and sends it to eve in a message; eve forwards it to carol, and carol to bob, who holds it signed by dan, then by eve, then by carol.  The other end of each person channel is the mini-app's own scripted person (programs/apps/gsnp/person.glp), activated from the module value under its role; its screen goes to the person, one line each, and so does what the super-app told the person of the friendships in its own social graph, sg(...).
%%
%% The boot settles, as gsn_boot.glp's does: the boot harness reduces each event until the program is quiescent, as the device runtime does (IGLP, Implementation Notes: "On each event the agent binds what the event delivers, reduces until quiescent"), and after each event the platform's agent takes its own transactions until none holds and then waits for the next (vGLP, Section 5.4, "Triggers").  Section APPS of the suite runs this file and holds each person's lines, in order.

procedure boot.
boot :-
    gsnp_phone(dan, _)@dan,
    gsnp_phone(eve, _)@eve,
    gsnp_phone(carol, _)@carol,
    gsnp_phone(bob, _)@bob,
    gsnp_phone(fay, _)@fay.

%% One smartphone: the super-app's agent on the isolate's network, the mini-app read from its artefact beside the program and installed, and the person's acts, given the person before them in the chain, who invites them, and the person after them, whom they connect to and invite, each one or none.
procedure gsnp_phone(Key?, NetInStream?).
gsnp_phone(dan, NetIn) :-
    agent(dan, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gsnp_acts(dan, none, one(eve), C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, dan, dan, PersonEnd?, Screen),
    send_to_user(Screen?).
gsnp_phone(eve, NetIn) :-
    agent(eve, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gsnp_acts(eve, one(dan), one(carol), C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, eve, eve, PersonEnd?, Screen),
    send_to_user(Screen?).
gsnp_phone(carol, NetIn) :-
    agent(carol, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gsnp_acts(carol, one(eve), one(bob), C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, carol, carol, PersonEnd?, Screen),
    send_to_user(Screen?).
gsnp_phone(bob, NetIn) :-
    agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gsnp_acts(bob, one(carol), one(fay), C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, bob, bob, PersonEnd?, Screen),
    send_to_user(Screen?).
gsnp_phone(fay, NetIn) :-
    agent(fay, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    gsnp_acts(fay, one(bob), none, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, fay, fay, PersonEnd?, Screen),
    send_to_user(Screen?).

%% The person before or after another in the chain: none, or one, by key.
Link ::= none ; one(Key).

%% The person's first acts on their super-app: trust the compiler's key and install the mini-app with their end of its person channel; then the first of the chain connects to the next, and every other consents in advance to the invitation of the one before them.
procedure gsnp_acts(Key?, Link?, Link?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
gsnp_acts(Me, none, one(Q), C, CK, CSig, AppEnd, Outs,
          [msg(person, Me?, trust(CK?)),
           msg(person, Me?, install(gsnp, C?, CSig?, AppEnd?)),
           msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?) |
    gsnp_run(Me?, none, one(Q?), Outs?, Cmds).
gsnp_acts(Me, one(P), Next, C, CK, CSig, AppEnd, Outs,
          [msg(person, Me?, trust(CK?)),
           msg(person, Me?, install(gsnp, C?, CSig?, AppEnd?)),
           msg(person, Me?, accept_invite(gsnp, P?)) | Cmds?]) :-
    ground(Me?), ground(P?) |
    gsnp_run(Me?, one(P?), Next?, Outs?, Cmds).

%% The person's acts on what their super-app tells them: consent to the request to connect of the one before them; once connected to the one before them, connect to the one after; and once connected to the one after, invite them to the mini-app.
procedure gsnp_run(Key?, Link?, Link?, AgentToUserStream?, UserInStream).
gsnp_run(Me, one(P), Next, [msg(agent, person, befriend(P1, X)) | Outs],
         [msg(person, Me?, decision(yes, P1?, X?)) | Cmds?]) :-
    ground(Me?), ground(P?), P1? =?= P? |
    send_to_user([sg(befriend(P1?))]),
    gsnp_run(Me?, one(P?), Next?, Outs?, Cmds).
gsnp_run(Me, one(P), one(Q), [msg(agent, person, connected(P1)) | Outs],
         [msg(person, Me?, connect(Q?)) | Cmds?]) :-
    ground(Me?), ground(P?), ground(Q?), P1? =?= P? |
    send_to_user([sg(connected(P1?))]),
    gsnp_run(Me?, one(P?), one(Q?), Outs?, Cmds).
gsnp_run(Me, one(P), none, [msg(agent, person, connected(P1)) | Outs], Cmds?) :-
    ground(P?), P1? =?= P? |
    send_to_user([sg(connected(P1?))]),
    gsnp_run(Me?, one(P?), none, Outs?, Cmds).
gsnp_run(Me, Prev, one(Q), [msg(agent, person, connected(Q1)) | Outs],
         [msg(person, Me?, invite(gsnp, Q?)) | Cmds?]) :-
    ground(Me?), ground(Q?), Q1? =?= Q? |
    send_to_user([sg(connected(Q1?))]),
    gsnp_run(Me?, Prev?, one(Q?), Outs?, Cmds).
gsnp_run(Me, Prev, Next, [_ | Outs], Cmds?) :-
    otherwise | gsnp_run(Me?, Prev?, Next?, Outs?, Cmds).
gsnp_run(_, _, _, [], []).

%% The creator's certification, signed here over the mini-app's source identity, the contract's sixteen act schemas, establish, befriend, unfriend, sign, message, forward, create, join, leave, close, drop, post_own, post, post_forward, deliver and deliver_own (programs/gsc/GSNP.glp), and the checker's verdict (GSG paper, Section 2, "A mini-app is a certified program"), as the super-app's plays sign it (superapp_plays.glp, certified/3); and the compiler's key the artefact's certificate carries, which the person trusts.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [establish, befriend, unfriend, sign, message, forward, create, join, leave, close, drop, post_own, post, post_forward, deliver, deliver_own], grassroots), K?, CSig).

%% The mini-app's scripted person activated from the module value by run/3, at the type identity of the second template's opaque instance at the type the module's exports record for miniapp_person/4, on the person's end of the person channel whose other end the super-app installs the mini-app with; where the person channel's type the module records for the person is not the entry's, no person runs, its end held for good.  Written again from superapp_plays.glp (miniapp_person_run/5, person_at/7) and core/self.glp (hold_person/1), which do not export them, as in gsg_boot.glp and gsn_boot.glp.
procedure miniapp_person_run(Content?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/4, M?, H0),
    opaque_type(miniapp_person/4, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D, S], M, Id, Role, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/4, [D?, S?], T),
    run(miniapp_person(Id?, Role?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

procedure hold_person(Channel(PersonOut(Opaque), PersonIn(Opaque))?).
hold_person(ch([_ | Ds], Gs?)) :- hold_person(ch(Ds?, Gs)).
