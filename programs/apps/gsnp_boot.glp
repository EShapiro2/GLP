%% gsnp_boot.glp --- the app of GSNP, the grassroots social network with provenance, on three smartphones (GSG paper, Sections 2 and 6, "The Grassroots Super-App" and "Mini-Apps on the Prototype"), as gsn_boot.glp runs GSN's app on two: under the boot harness, one isolate per person, each with its own key pair, running the social graph of programs/social/graph/core as its super-app and hosting GSNP's mini-app (programs/apps/gsnp).  The program is graph/core, named as :boot's second argument, and this file is loaded on top of it, calling its exported agent/4 (IGLP, Implementation Notes, "The scope a boot source is checked in"); the super-app is not edited:
%%   :artefact programs/apps/gsnp programs/social/graph/core
%%   :boot programs/apps/gsnp_boot.glp programs/social/graph/core
%%
%% Each person trusts the compiler's key, reads the certified artefact gsnp.glpw from graph/core with load_file/2 and installs it, with one end of a person channel.  alice connects to bob and bob to carol; each pair befriends in the super-app's social graph across the isolates; alice invites bob to the mini-app and bob invites carol, each invitee consents, and each handshake opens a root channel between the two executions, so that bob's execution has two conversations.  Over them the mini-app runs GSNP's contract, as play_provenance of programs/apps/gsnp runs it: each establishes their identity (GSG:1); alice and bob become friends, and bob and carol; alice signs the item 'Flood on Main Street' and forwards it to bob; and bob forwards it to carol, who holds it signed by alice and then by bob.  The other end of each person channel is the mini-app's own scripted person (programs/apps/gsnp/person.glp), activated from the module value under its role; its screen goes to the person, one line each, and so does what the super-app told the person of the friendships in its own social graph, sg(...).
%%
%% The boot settles, as gsn_boot.glp's does: the boot harness reduces each event until the program is quiescent, as the device runtime does (IGLP, Implementation Notes: "On each event the agent binds what the event delivers, reduces until quiescent"), and after each event the platform's agent takes its own transactions until none holds and then waits for the next (vGLP, Section 5.4, "Triggers").  Section APPS of the suite runs this file and holds each person's lines, in order.

procedure boot.
boot :-
    gsnp_phone(alice, _)@alice,
    gsnp_phone(bob, _)@bob,
    gsnp_phone(carol, _)@carol.

%% One smartphone: the super-app's agent on the isolate's network, the mini-app read from its artefact beside the program and installed, and the person's acts by role.
procedure gsnp_phone(Key?, NetInStream?).
gsnp_phone(alice, NetIn) :-
    agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_gsnp(C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, alice, alice, PersonEnd?, Screen),
    send_to_user(Screen?).
gsnp_phone(bob, NetIn) :-
    agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_gsnp(C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, bob, bob, PersonEnd?, Screen),
    send_to_user(Screen?).
gsnp_phone(carol, NetIn) :-
    agent(carol, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gsnp.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    carol_gsnp(C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, carol, carol, PersonEnd?, Screen),
    send_to_user(Screen?).

%% alice's acts on her super-app: trust the compiler's key, install the mini-app with her end of its person channel, connect to bob, and once connected invite him to the mini-app.
procedure alice_gsnp(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_gsnp(C, CK, CSig, AppEnd, Outs,
           [msg(person, alice, trust(CK?)),
            msg(person, alice, install(gsnp, C?, CSig?, AppEnd?)),
            msg(person, alice, connect(bob)) | Cmds?]) :-
    alice_gsnp_run(Outs?, Cmds).

procedure alice_gsnp_run(AgentToUserStream?, UserInStream).
alice_gsnp_run([msg(agent, person, connected(bob)) | Outs],
               [msg(person, alice, invite(gsnp, bob)) | Cmds?]) :-
    send_to_user([sg(connected(bob))]),
    alice_gsnp_run(Outs?, Cmds).
alice_gsnp_run([_ | Outs], Cmds?) :- otherwise | alice_gsnp_run(Outs?, Cmds).
alice_gsnp_run([], []).

%% bob's acts on his: trust the compiler's key, install the mini-app with his end of its person channel, consent in advance to alice's invitation to it, connect to carol, consent to alice's request to connect, and once connected to carol invite her to the mini-app.
procedure bob_gsnp(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_gsnp(C, CK, CSig, AppEnd, Outs,
         [msg(person, bob, trust(CK?)),
          msg(person, bob, install(gsnp, C?, CSig?, AppEnd?)),
          msg(person, bob, accept_invite(gsnp, alice)),
          msg(person, bob, connect(carol)) | Cmds?]) :-
    bob_gsnp_run(Outs?, Cmds).

procedure bob_gsnp_run(AgentToUserStream?, UserInStream).
bob_gsnp_run([msg(agent, person, befriend(alice, P)) | Outs],
             [msg(person, bob, decision(yes, alice, P?)) | Cmds?]) :-
    send_to_user([sg(befriend(alice))]),
    bob_gsnp_run(Outs?, Cmds).
bob_gsnp_run([msg(agent, person, connected(alice)) | Outs], Cmds?) :-
    send_to_user([sg(connected(alice))]),
    bob_gsnp_run(Outs?, Cmds).
bob_gsnp_run([msg(agent, person, connected(carol)) | Outs],
             [msg(person, bob, invite(gsnp, carol)) | Cmds?]) :-
    send_to_user([sg(connected(carol))]),
    bob_gsnp_run(Outs?, Cmds).
bob_gsnp_run([_ | Outs], Cmds?) :- otherwise | bob_gsnp_run(Outs?, Cmds).
bob_gsnp_run([], []).

%% carol's acts on hers: trust the compiler's key, install the mini-app with her end of its person channel, consent in advance to bob's invitation to it, and consent to bob's request to connect.
procedure carol_gsnp(Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
carol_gsnp(C, CK, CSig, AppEnd, Outs,
           [msg(person, carol, trust(CK?)),
            msg(person, carol, install(gsnp, C?, CSig?, AppEnd?)),
            msg(person, carol, accept_invite(gsnp, bob)) | Cmds?]) :-
    carol_gsnp_run(Outs?, Cmds).

procedure carol_gsnp_run(AgentToUserStream?, UserInStream).
carol_gsnp_run([msg(agent, person, befriend(bob, P)) | Outs],
               [msg(person, carol, decision(yes, bob, P?)) | Cmds?]) :-
    send_to_user([sg(befriend(bob))]),
    carol_gsnp_run(Outs?, Cmds).
carol_gsnp_run([msg(agent, person, connected(bob)) | Outs], Cmds?) :-
    send_to_user([sg(connected(bob))]),
    carol_gsnp_run(Outs?, Cmds).
carol_gsnp_run([_ | Outs], Cmds?) :- otherwise | carol_gsnp_run(Outs?, Cmds).
carol_gsnp_run([], []).

%% The creator's certification, signed here over the mini-app's source identity, the contract's twelve act schemas and the checker's verdict (GSG paper, Section 2, "A mini-app is a certified program"), as the super-app's plays sign it (superapp_plays.glp, certified/3); and the compiler's key the artefact's certificate carries, which the person trusts.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [establish, befriend, unfriend, sign, forward, create, join, leave, close, post_own, post, deliver], grassroots), K?, CSig).

%% The mini-app's scripted person activated from the module value by run/3, at the type identity of the second template's opaque instance at the type the module's exports record for miniapp_person/4, on the person's end of the person channel whose other end the super-app installs the mini-app with; where the person channel's type the module records for the person is not the entry's, no person runs, its end held for good.  Written again from superapp_plays.glp (miniapp_person_run/5, person_at/7) and core/self.glp (hold_person/1), which do not export them, as in gsg_boot.glp and gsn_boot.glp.
procedure miniapp_person_run(Content?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/4, M?, H0),
    opaque_type(miniapp_person/4, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D, S], M, Id, Role, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/4, [D?, S?], T),
    run(miniapp_person(Id?, Role?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

procedure hold_person(Channel(PersonOut(Opaque), PersonIn(Opaque))?).
hold_person(ch([_ | Ds], Gs?)) :- hold_person(ch(Ds?, Gs)).
