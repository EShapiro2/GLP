%% ---------------------------------------------------------------------------
%% programs/apps/dgc --- the app of Denominated Currencies (Currencies' contract, SGC's, programs/currencies/sovereign/Denominated-Currencies.txt and Denominated-Currencies.glp), which extends Bonds and Denominated Coins, as a mini-app of the Grassroots Super-App (GSG paper, Section 2), compiled down the abstraction cascade from its speech-act schemas: the canonical CVA platform vGLP's compiler prints from them, platform.vglp (vGLP, Section 3.2, Definition "Canonical CVA Platform"; Section 5.4, "The compilation"), compiled to GLP by the canonical compilation when the directory loads (vGLP, Section 6.3, "The canonical compilation").
%%
%% The directory is a certified program of its own, as programs/apps/gb is: the platform, the mini-app entry miniapp/3 that wraps it (miniapp.glp, a byte copy of gsg's), its scripted person (person.glp) and the play that activates it by run/3 (plays.glp).
%%
%% The types of platform.vglp, written again for the declarations of this directory's modules, but for those the compilation forms --- Question, Drawn and Ask(Q) --- as in programs/apps/gb.
%% ---------------------------------------------------------------------------

Peer     ::= Key.
Speech   ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; program(Module) ; Speech.
Class ::=
establish(Peer)
;
acquaint(Peer, Peer)
;
introduce(Peer, Peer, Peer)
;
issue(Peer, Speech, Integer)
;
issue_bond(Peer, Integer, Speech, Integer)
;
swap(Peer, Peer, Peer, Peer, Speech, Integer, Integer)
;
swap_coin_for_bond(Peer, Peer, Peer, Speech, Integer, Peer, Integer, Integer)
;
swap_bonds(Peer, Peer, Peer, Integer, Speech, Integer, Peer, Integer, Integer)
;
pay(Peer, Peer, Peer, Speech, Integer)
;
pay_issuer(Peer, Peer, Speech, Integer)
;
pay_bond(Peer, Peer, Peer, Integer, Speech, Integer)
;
deposit(Peer, Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_bond(Peer, Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
release(Peer, Peer, Peer, Speech, Peer, Speech, Integer)
;
release_bond(Peer, Peer, Peer, Integer, Speech, Peer, Speech, Integer)
;
return(Peer, Peer, Peer, Speech, Peer, Speech, Integer)
;
return_bond(Peer, Peer, Peer, Integer, Speech, Peer, Speech, Integer)
;
redeem(Peer, Peer, Peer, Speech)
;
redeem_coin_against_bond(Peer, Peer, Speech, Peer, Integer)
;
redeem_bond(Peer, Peer, Integer, Speech, Peer)
;
redeem_bond_against_bond(Peer, Peer, Integer, Speech, Peer, Integer)
;
first_issue(Peer, Speech, Integer)
;
issue_denominated_bond(Peer, Integer, Speech, Integer)
;
deposit_own_coins(Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_with_the_issuer(Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_more(Peer, Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_own_bonds(Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
deposit_bond_with_the_issuer(Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
deposit_bond_more(Peer, Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
accept(Peer, Peer, Speech, Integer)
;
accept_by_bond(Peer, Peer, Speech, Integer)
;
pay_accepted_coins(Peer, Peer, Peer, Speech)
;
pay_own_accepted_coins(Peer, Peer, Speech)
;
pay_accepted_coins_to_the_issuer(Peer, Peer, Speech)
.
Proposal ::=
establish(Peer)
;
acquaint(Peer, Peer)
;
introduce(Peer, Peer, Peer)
;
issue(Peer, Speech, Integer)
;
issue_bond(Peer, Integer, Speech, Integer)
;
swap(Peer, Peer, Peer, Peer, Speech, Integer, Integer)
;
swap_coin_for_bond(Peer, Peer, Peer, Speech, Integer, Peer, Integer, Integer)
;
swap_bonds(Peer, Peer, Peer, Integer, Speech, Integer, Peer, Integer, Integer)
;
pay(Peer, Peer, Peer, Speech, Integer)
;
pay_issuer(Peer, Peer, Speech, Integer)
;
pay_bond(Peer, Peer, Peer, Integer, Speech, Integer)
;
deposit(Peer, Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_bond(Peer, Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
release(Peer, Peer, Peer, Speech, Peer, Speech, Integer)
;
release_bond(Peer, Peer, Peer, Integer, Speech, Peer, Speech, Integer)
;
return(Peer, Peer, Peer, Speech, Peer, Speech, Integer)
;
return_bond(Peer, Peer, Peer, Integer, Speech, Peer, Speech, Integer)
;
redeem(Peer, Peer, Peer, Speech)
;
redeem_coin_against_bond(Peer, Peer, Speech, Peer, Integer)
;
redeem_bond(Peer, Peer, Integer, Speech, Peer)
;
redeem_bond_against_bond(Peer, Peer, Integer, Speech, Peer, Integer)
;
first_issue(Peer, Speech, Integer)
;
issue_denominated_bond(Peer, Integer, Speech, Integer)
;
deposit_own_coins(Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_with_the_issuer(Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_more(Peer, Peer, Peer, Speech, Integer, Peer, Speech)
;
deposit_own_bonds(Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
deposit_bond_with_the_issuer(Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
deposit_bond_more(Peer, Peer, Peer, Integer, Speech, Integer, Peer, Speech)
;
accept(Peer, Peer, Speech, Integer)
;
accept_by_bond(Peer, Peer, Speech, Integer)
;
pay_accepted_coins(Peer, Peer, Peer, Speech)
;
pay_own_accepted_coins(Peer, Peer, Speech)
;
pay_accepted_coins_to_the_issuer(Peer, Peer, Speech)
.
Request  ::= propose(Proposal).
YesNo    ::= yes ; no.
Reason   ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote     ::= yes ; no(Reason).
Decision ::= commit ; abort(Peer, Reason) ; yield.
Rho      ::= one(Class) ; rho(Proposal).
Names    ::= none ; request(Rho, Integer).
Attempt  ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo    ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
           ; yield(Attempt) ; request(Rho, Integer).
Content  ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= identity ; person ; knows(Peer) ; coin(Peer, Speech) ; issued_in(Speech) ; bond(Peer, Integer, Speech) ; escrow_coin(Peer, Speech, Peer, Peer, Speech) ; escrow_denomination(Peer, Peer, Speech, Speech) ; escrow_bond(Peer, Integer, Speech, Peer, Peer, Speech) ; issued_bond_in(Speech, Integer) ; accepts(Peer, Speech).
Approved ::= Proposal.
Output   ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab      ::= tab(String, Constant) ; tab(String, Constant, Constant).
Asking   ::= Attempt ; hello(Peer, Proposal).
Approval ::= approval(Asking, List(Word), YesNo?).
Word     ::= text(String) ; person(Peer) ; named(String, Peer) ; valued(String, Number) ; held(Atom, Integer).

%% What the mini-app's scripted person reports, its screen (person.glp): each view the program writes, once, view(Id, S, K, A, Ts), the agent's own key, the machine state, the persons the agent knows, the approvals pending and the tabs (vGLP 12f629d, Section 5.4, "The compilation"), and each notice, refused(P, Q, D) (vGLP f0acbc1, Section 5.4, "The compilation"); the agent's own key and the persons it knows, as the last view drawn shows them, where the script looks; and each answer it gives an approval question, of the attempt or of an attempt of the class its script names.
Asked    ::= Class ; Attempt.
Seen     ::= Output ; menu(Key, List(Key)) ; gave(Asked, YesNo).

%% The network of the platform over the conversations (miniapp.glp): what its router reads, a conversation the social graph opened, the peer's key and this side's end of its root channel, or a message the agent sent; a conversation's route, the peer's key and the writer of the conversation's outgoing stream; and whether a message went on a conversation or is held for one not yet open.
NetEvent ::= opened(Key, RootChannel(Net)) ; sent(Net) ; declined(Key).
Route    ::= route(Key, Stream(Net)?).
Routes   ::= [] ; [Route | Routes].
Sending  ::= went ; held(Net).

%% The mini-app's entry, the instance of the root's entry template miniapp/3 (programs/self.glp) at the mini-app's two types: Drawn, what its dispatcher draws for its person, and Net, the messages of its root channels, the platform's network messages (miniapp.glp).
imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?).
miniapp(Id, Ui, Sg) :- miniapp # miniapp(Id?, Ui?, Sg?).

%% The scripted person, the instance of the root's second template miniapp_person/5 at Drawn and at Seen, the screen it reports.
imported procedure person#miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Id, Role, Ps, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, Ps?, PEnd?, Screen).

%% The play with no super-app (plays.glp).
imported procedure plays#play_sovereign(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_sovereign(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_sovereign(A?, B?, C?, D?, E?) :- plays # play_sovereign(A, B, C, D, E).
