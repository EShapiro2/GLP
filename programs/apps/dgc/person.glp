match_class(pay_accepted_coins_to_the_issuer(K1, K2, K3), pay_accepted_coins_to_the_issuer(XK1, XK2, XK3), Vs, F?, pay_accepted_coins_to_the_issuer(BK1?, BK2?, BK3?)) :-
