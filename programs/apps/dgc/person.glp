    match_int(K3?, XK3?, R2?, F, BK3).
match_class(issue_denominated_bond(K1, K2, K3, K4), issue_denominated_bond(XK1, XK2, XK3, XK4), Vs, F?, issue_denominated_bond(BK1?, BK2?, BK3?, BK4?)) :-
