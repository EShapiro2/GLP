    match_key(K3?, XK3?, R2?, R3, BK3),
    match_const(K4?, XK4?, R3?, F, BK4).
match_class(redeem_coin_against_bond(K1, K2, K3, K4, K5), redeem_coin_against_bond(XK1, XK2, XK3, XK4, XK5), Vs, F?, redeem_coin_against_bond(BK1?, BK2?, BK3?, BK4?, BK5?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_const(K3?, XK3?, R2?, R3, BK3),
    match_key(K4?, XK4?, R3?, R4, BK4),
    match_int(K5?, XK5?, R4?, F, BK5).
match_class(redeem_bond(K1, K2, K3, K4, K5), redeem_bond(XK1, XK2, XK3, XK4, XK5), Vs, F?, redeem_bond(BK1?, BK2?, BK3?, BK4?, BK5?)) :-
