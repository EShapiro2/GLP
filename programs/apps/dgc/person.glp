    match_int(K3?, XK3?, R2?, R3, BK3),
    match_const(K4?, XK4?, R3?, R4, BK4),
    match_key(K5?, XK5?, R4?, F, BK5).
match_class(redeem_bond_against_bond(K1, K2, K3, K4, K5, K6), redeem_bond_against_bond(XK1, XK2, XK3, XK4, XK5, XK6), Vs, F?, redeem_bond_against_bond(BK1?, BK2?, BK3?, BK4?, BK5?, BK6?)) :-
    match_key(K1?, XK1?, found(Vs?), R1, BK1),
    match_key(K2?, XK2?, R1?, R2, BK2),
    match_int(K3?, XK3?, R2?, R3, BK3),
    match_const(K4?, XK4?, R3?, R4, BK4),
    match_key(K5?, XK5?, R4?, R5, BK5),
