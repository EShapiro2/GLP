%% plays.glp --- the GFF-FR mini-app activated as the super-app activates it (GSG paper, Section 2, "Activation and joining"): by run/3, under the type identity of its entry miniapp/4, with its grants; for five executions, with the two ends of each of five root channels handed to them as their conversations, the play standing in for the social graph, as ../gff/plays.glp does.  The persons are scripted (person.glp), each under its role, and the play returns their screens.

imported procedure person#cued_person(Key?, Constant?, Steps?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).

%% What the play waits for on a person's screen before it gives another person the next steps of their script: a view whose machine state holds the atom, or lacks it.
Want  ::= holds(Atom) ; lacks(Atom).
Wants ::= [] ; [Want | Wants].

%% The relay on a conversation: what it reads, a message or a word of its control, and its control's words.  Closed, it holds the messages it reads, in order; opened, it passes them on, those held first.
RelayIn   ::= data(Net) ; ctl(RelayCtl).
RelayCtl  ::= close ; open.
Done      ::= done.

%% play_resilient(A, B, C, D, E): GFF-FR's play (GFF #1 Cowork, Code_inbox.md, 2026-10-28 10:27 UTC), alice, bob, carol, dave and eve, over five conversations: alice's with bob and with eve, carol's with bob, with eve and with dave.  Alice posts an item; bob introduces her to carol, who, told by bob's and eve's updates that each follows alice, presses Follow, and her machine follows alice through both (GFF-FR:1, as GFF-FR's chooser takes it, chooser.glp); carol introduces her to dave, who follows her through carol.  Once dave holds the first item, eve's machine is held: the relay on each of her two conversations, each way, holds what it reads, eve sending and receiving nothing; once each relay has closed, alice posts a second item.  Alice's delivery to eve is a sending and holds alice in nothing (GFF:4, deliver_own, its recipient's role received).  Carol receives the second item from bob and not from eve, and forwards it to eve (GFF-FR:2, redundant_forward), a sending, which the relay holds; once carol's screen shows the item sent to eve, the relays open, and eve holds the item along alice, bob and carol, as well as from alice.  Dave holds each item once.
exported procedure play_resilient(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_resilient(A?, B?, C?, D?, E?) :-
    self_module(M),
    find_type(miniapp/4, T),
    run(miniapp(alice, ch(GA?, WA), ch([conversation(bob, ch(BA?, AB)), conversation(eve, ch(EAr?, AE))], _), []), T?, M?),
    person # cued_person(alice, r_alice, TA?, ch(WA?, GA), A),
    run(miniapp(bob, ch(GB?, WB), ch([conversation(alice, ch(AB?, BA)), conversation(carol, ch(CB?, BC))], _), []), T?, M?),
    person # cued_person(bob, r_bob, [], ch(WB?, GB), B),
    run(miniapp(carol, ch(GC?, WC), ch([conversation(bob, ch(BC?, CB)), conversation(eve, ch(ECr?, CE)), conversation(dave, ch(DC?, CD))], _), []), T?, M?),
    person # cued_person(carol, r_carol, [], ch(WC?, GC), C0),
    run(miniapp(dave, ch(GD?, WD), ch([conversation(carol, ch(CD?, DC))], _), []), T?, M?),
    person # cued_person(dave, r_dave, [], ch(WD?, GD), D0),
    run(miniapp(eve, ch(GE?, WE), ch([conversation(alice, ch(AEr?, EA)), conversation(carol, ch(CEr?, EC))], _), []), T?, M?),
    person # cued_person(eve, r_eve, [], ch(WE?, GE), E),
    relay(AE?, K1?, AEr, Q1),
    relay(EA?, K2?, EAr, Q2),
    relay(CE?, K3?, CEr, Q3),
    relay(EC?, K4?, ECr, Q4),
    cue(D0?, D, holds(item(speech(utterance('First item'), alice), alice)), Hold),
    cue(C0?, C, holds(sent(speech(utterance('Second item'), alice), eve)), Open),
    controls(Hold?, Open?, K1, K2, K3, K4),
    held(Q1?, Q2?, Q3?, Q4?,
         [own([P1, P2], propose(post(P1?, speech(utterance('Second item'), P2?)))),
          wait(holds(feed(speech(utterance('Second item'), alice))))], TA).

%% relay(Xs, Ks, Ys, Q): Ys the messages Xs, passed on while the relay is open, held while it is closed, the controls Ks closing and opening it; Q done once it has closed.
procedure relay(Stream(Net)?, Stream(RelayIn)?, Stream(Net), Done).
relay(Xs, Ks, Ys?, Q?) :-
    as_data(Xs?, Ds),
    merge(Ds?, Ks?, In),
    relay_open(In?, Ys, Q).

procedure as_data(Stream(Net)?, Stream(RelayIn)).
as_data([X | Xs], [data(X?) | Ds?]) :- as_data(Xs?, Ds).
as_data([], []).

procedure relay_open(Stream(RelayIn)?, Stream(Net), Done).
relay_open([data(X) | In], [X? | Ys?], Q?) :- relay_open(In?, Ys, Q).
relay_open([ctl(close) | In], Ys?, done) :- relay_closed(In?, [], Ys).
relay_open([ctl(open) | In], Ys?, Q?) :- relay_open(In?, Ys, Q).
relay_open([], [], done).

procedure relay_closed(Stream(RelayIn)?, List(Net)?, Stream(Net)).
relay_closed([data(X) | In], Hs, Ys?) :- ground(X?) | put_last(Hs?, X?, Hs1), relay_closed(In?, Hs1?, Ys).
relay_closed([ctl(open) | In], Hs, Ys?) :- flush_held(Hs?, Ys, Ys1?), relay_again(In?, Ys1).
relay_closed([ctl(close) | In], Hs, Ys?) :- relay_closed(In?, Hs?, Ys).
relay_closed([], Hs, Ys?) :- flush_held(Hs?, Ys, []).

%% Once opened again, the relay passes every message on.
procedure relay_again(Stream(RelayIn)?, Stream(Net)).
relay_again([data(X) | In], [X? | Ys?]) :- relay_again(In?, Ys).
relay_again([ctl(_) | In], Ys?) :- relay_again(In?, Ys).
relay_again([], []).

procedure put_last(List(Net)?, Net?, List(Net)).
put_last([], X, [X?]).
put_last([H | Hs], X, [H? | Hs1?]) :- put_last(Hs?, X?, Hs1).

procedure flush_held(List(Net)?, Stream(Net), Stream(Net)?).
flush_held([], Ys1?, Ys1).
flush_held([H | Hs], [H? | Ys?], Ys1) :- flush_held(Hs?, Ys, Ys1?).

%% controls(Hold, Open, K1, K2, K3, K4): each relay's controls: close once Hold is given, and open once Open is.
procedure controls(Done?, Done?, Stream(RelayIn), Stream(RelayIn), Stream(RelayIn), Stream(RelayIn)).
controls(done, Open, [ctl(close) | K1?], [ctl(close) | K2?], [ctl(close) | K3?], [ctl(close) | K4?]) :-
    opens(Open?, K1, K2, K3, K4).

procedure opens(Done?, Stream(RelayIn), Stream(RelayIn), Stream(RelayIn), Stream(RelayIn)).
opens(done, [ctl(open)], [ctl(open)], [ctl(open)], [ctl(open)]).

%% held(Q1, Q2, Q3, Q4, Go, Out): Out is Go once every relay has closed.
procedure held(Done?, Done?, Done?, Done?, Steps?, Steps).
held(done, done, done, done, Go, Go?).

%% cue(Xs, Ys, W, Q): Ys is the screen Xs, passed on unchanged; Q is done once its views have shown W.
procedure cue(Stream(Seen)?, Stream(Seen), Want?, Done).
cue([X | Xs], [X? | Ys?], W, Q?) :-
    ground(X?), ground(W?) |
    met(W?, X?, R),
    cue1(R?, Xs?, Ys, W?, Q).
%% A screen that ends, its run having ended, gives the cue, there being nothing left to wait for.
cue([], [], _, done).
procedure cue1(YesNo?, Stream(Seen)?, Stream(Seen), Want?, Done).
cue1(yes, Xs, Ys?, _, done) :- copy(Xs?, Ys).
cue1(no, Xs, Ys?, W, Q?) :- cue(Xs?, Ys, W?, Q).

%% watch(Xs, Ys, Wants, Go, Out): Ys is the screen Xs, passed on unchanged; once its views have shown each of Wants in turn, Out is Go.
procedure watch(Stream(Seen)?, Stream(Seen), Wants?, Steps?, Steps).
watch(Xs, Ys?, [], Go, Go?) :- copy(Xs?, Ys).
watch([X | Xs], [X? | Ys?], [W | Ws], Go, Out?) :-
    ground(X?), ground(W?) |
    met(W?, X?, R),
    watch1(R?, Xs?, Ys, W?, Ws?, Go?, Out).

procedure watch1(YesNo?, Stream(Seen)?, Stream(Seen), Want?, Wants?, Steps?, Steps).
watch1(yes, Xs, Ys?, _, Ws, Go, Out?) :- watch(Xs?, Ys, Ws?, Go?, Out).
watch1(no, Xs, Ys?, W, Ws, Go, Out?) :- watch(Xs?, Ys, [W? | Ws?], Go?, Out).

%% met(W, X, R): whether the screen's line X is a view whose machine state shows W.
procedure met(Want?, Seen?, YesNo).
met(holds(A), view(S, _, _, _), R?) :- ground(A?), ground(S?) | among_atom(A?, S?, R).
met(lacks(A), view(S, _, _, _), R?) :- ground(A?), ground(S?) | among_atom(A?, S?, R1), flip_yn(R1?, R).
met(_, _, no) :- otherwise | true.

procedure among_atom(Atom?, List(Atom)?, YesNo).
among_atom(_, [], no).
among_atom(A, [B | _], yes) :- A? =?= B? | true.
among_atom(A, [_ | Bs], R?) :- otherwise | among_atom(A?, Bs?, R).

procedure flip_yn(YesNo?, YesNo).
flip_yn(yes, no).
flip_yn(no, yes).

procedure copy(Stream(Seen)?, Stream(Seen)).
copy([X | Xs], [X? | Ys?]) :- copy(Xs?, Ys).
copy([], []).
