%% gc_boot.glp --- the app of GC, grassroots currencies, on two smartphones (GSG paper, Sections 2 and 6, "The Grassroots Super-App" and "Mini-Apps on the Prototype"), as gsg_boot.glp runs GSG's app: under the boot harness, one isolate per person, each with its own key pair, running the social graph of programs/social/graph/core as its super-app and hosting GC's mini-app (programs/apps/gc).  The program is graph/core, named as :boot's second argument, and this file is loaded on top of it, calling its exported agent/4 (IGLP, Implementation Notes, "The scope a boot source is checked in"); the super-app is not edited:
%%   :artefact programs/apps/gc programs/social/graph/core
%%   :boot programs/apps/gc_boot.glp programs/social/graph/core
%%
%% Each person trusts the compiler's key, reads the certified artefact gc.glpw from graph/core with load_file/2 and installs it, with one end of a person channel; alice connects to bob, they befriend in the super-app's social graph across the isolates, alice invites bob to the mini-app, bob consents, and the handshake opens a root channel between their two executions.  The super-app carries a mini-app's messages only between friends in its own social graph (programs/apps/gsg/README.md, "GSN's app"), though no act of GC requires a friend.  Over that conversation the mini-app runs GC's contract, as play_coins of programs/apps/gc runs it: each establishes their identity (GKK:1) and bob mints a Bob-coin (GC:1); they come to know each other (GKK:2); alice mints an Alice-coin and asks bob to swap it for his Bob-coin, and he answers yes (GC:2); and alice pays the Bob-coin to bob (GC:3).  The other end of each person channel is the mini-app's own scripted person (programs/apps/gc/person.glp), activated from the module value under its role; its screen goes to the person, one line each, and so does what the super-app told the person of the friendship in its own social graph, sg(...).  Expected, each person's lines in order:
%%   [alice] sg(connected(bob)), view([], []), menu(alice, []), view([identity], []), view([identity], [bob]), view([knows(bob), identity], [bob]), view([coin(alice), knows(bob), identity], [bob]), view([coin(bob), knows(bob), identity], [bob]), view([knows(bob), identity], [bob]), menu(alice, [bob]);
%%   [bob] sg(befriend(alice)), sg(connected(alice)), view([], []), view([identity], []), view([coin(bob), identity], []), view([coin(bob), identity], [alice]), gave(acquaint(alice, bob), yes), view([knows(alice), coin(bob), identity], [alice]), gave(swap(alice, bob, alice, bob), yes), view([coin(alice), knows(alice), identity], [alice]), view([coin(bob), coin(alice), knows(alice), identity], [alice]).
%%
%% The boot settles, as gsg_boot.glp's does: the boot harness reduces each event until the program is quiescent, as the device runtime does (IGLP, Implementation Notes: "On each event the agent binds what the event delivers, reduces until quiescent"), and after each event the platform's agent takes its own transactions until none holds and then waits for the next (vGLP, Section 5.4, "Triggers").  Section APPS of the suite runs this file and holds each person's lines, in order.

procedure boot.
boot :-
    agent(ch(_?, _), ch(_?, _))@alice,
    say(alice, bob, ch(_?, _))@alice,
    agent(ch(_?, _), ch(_?, _))@bob,
    say(bob, alice, ch(_?, _))@bob.

%% Every agent's initial goal is agent(ch(_?,_),ch(_?,_)), the person channel first and the network channel second (GLP-Spec maglp.tex, Definition "Multiagent GLP"), and the person scripted at each agent, say/3, run on its person channel in the person's place (IGLP, Implementation Notes, "Boot"), tells the agent its name and then the key of the one peer the person knows, its two ground arguments, alice and bob being the atoms that stand for the two keys in a simulation (IGLP, Implementation Notes, "Boot": "An agent learns the keys of its peers from its person"; Remark "Agent Names"); by these agent/2 starts the agent's smartphone, gc_phone/3, on the network input; self_key/1 first makes the agent's key, before which nothing is sent on the network (GLP-Spec appendix-guards.tex, "Identity and signature").
exported procedure agent(Channel(Stream(Key), Stream(Key))?, Channel(NetInStream, NetOutStream)?).
agent(ch(In, []), ch(N, [])) :- self_key(_), start(In?, N?).

%% The agent's smartphone, by the name and the peer its person tells it.
procedure start(Stream(Key)?, NetInStream?).
start([P, Q | _], N) :- gc_phone(P?, Q?, N?).
start(_, _) :- otherwise | true.

%% The person at each agent: it tells the agent its name and the key of the peer it knows, and reads nothing.
exported procedure say(Key?, Key?, Channel(Stream(Key), Stream(Key))?).
say(P, Q, ch(_, [P?, Q?])).

%% One smartphone: the super-app's agent on the isolate's network, the mini-app read from its artefact beside the program and installed, and the person's acts by role, toward the peer Q the person named.
procedure gc_phone(Key?, Key?, NetInStream?).
gc_phone(alice, Q, NetIn) :-
    agent(alice, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gc.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    alice_gc(Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, alice, alice, [Q?], PersonEnd?, Screen),
    send_to_user(Screen?).
gc_phone(bob, Q, NetIn) :-
    agent(bob, In?, NetIn?, [user_output(Out), net_output(NetOut)]),
    send_to_net(NetOut?),
    load_file("gc.glpw", C),
    certified(C?, CK, CSig),
    new_channel(AppEnd, PersonEnd),
    bob_gc(Q?, C?, CK?, CSig?, AppEnd?, Out?, In),
    miniapp_person_run(C?, bob, bob, [Q?], PersonEnd?, Screen),
    send_to_user(Screen?).

%% alice's acts on her super-app: trust the compiler's key, install the mini-app with her end of its person channel, connect to the peer Q, bob, and once connected invite Q to the mini-app.
procedure alice_gc(Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
alice_gc(Q, C, CK, CSig, AppEnd, Outs,
         [msg(person, alice, trust(CK?)),
          msg(person, alice, install(gc, C?, CSig?, AppEnd?)),
          msg(person, alice, connect(Q?)) | Cmds?]) :-
    ground(Q?) |
    alice_gc_run(Q?, Outs?, Cmds).

procedure alice_gc_run(Key?, AgentToUserStream?, UserInStream).
alice_gc_run(Q, [msg(agent, person, connected(Q1)) | Outs],
             [msg(person, alice, invite(gc, Q?)) | Cmds?]) :-
    Q1? =?= Q? |
    send_to_user([sg(connected(Q1?))]),
    alice_gc_run(Q?, Outs?, Cmds).
alice_gc_run(Q, [_ | Outs], Cmds?) :- otherwise | alice_gc_run(Q?, Outs?, Cmds).
alice_gc_run(_, [], []).

%% bob's acts on his: trust the compiler's key, install the mini-app with his end of its person channel, consent in advance to the invitation of the peer Q, alice, to it, and consent to Q's request to connect.
procedure bob_gc(Key?, Content?, String?, String?, PersonChannel(Opaque)?, AgentToUserStream?, UserInStream).
bob_gc(Q, C, CK, CSig, AppEnd, Outs,
       [msg(person, bob, trust(CK?)),
        msg(person, bob, install(gc, C?, CSig?, AppEnd?)),
        msg(person, bob, accept_invite(gc, Q?)) | Cmds?]) :-
    ground(Q?) |
    bob_gc_run(Q?, Outs?, Cmds).

procedure bob_gc_run(Key?, AgentToUserStream?, UserInStream).
bob_gc_run(Q, [msg(agent, person, befriend(Q1, P)) | Outs],
           [msg(person, bob, decision(yes, Q?, P?)) | Cmds?]) :-
    Q1? =?= Q? |
    send_to_user([sg(befriend(Q1?))]),
    bob_gc_run(Q?, Outs?, Cmds).
bob_gc_run(Q, [msg(agent, person, connected(Q1)) | Outs], Cmds?) :-
    Q1? =?= Q? |
    send_to_user([sg(connected(Q1?))]),
    bob_gc_run(Q?, Outs?, Cmds).
bob_gc_run(Q, [_ | Outs], Cmds?) :- otherwise | bob_gc_run(Q?, Outs?, Cmds).
bob_gc_run(_, [], []).

%% The creator's certification, signed here over the mini-app's source identity, the contract's seven act schemas, establish, acquaint, introduce, mint, swap, pay and redeem (programs/currencies/coins/GC.glp), and the checker's verdict (GSG paper, Section 2, "A mini-app is a certified program"), as the super-app's plays sign it (superapp_plays.glp, certified/3); and the compiler's key the artefact's certificate carries, which the person trusts.
procedure certified(Content?, String, String).
certified(M, CK?, CSig?) :-
    module(M?) |
    decompose_module(M?, CK, Src, _),
    self_key(K),
    sign(creator_cert(Src?, [establish, acquaint, introduce, mint, swap, pay, redeem], grassroots), K?, CSig).

%% The mini-app's scripted person activated from the module value by run/3, at the type identity of the second template's opaque instance at the type the module's exports record for miniapp_person/5, on the person's end of the person channel whose other end the super-app installs the mini-app with; where the person channel's type the module records for the person is not the entry's, no person runs, its end held for good.  Written again from superapp_plays.glp (miniapp_person_run/6, person_at/8) and core/self.glp (hold_person/1), which do not export them, as in gsg_boot.glp.
procedure miniapp_person_run(Content?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
miniapp_person_run(M, Id, Role, Ps, PEnd, Screen?) :-
    module(M?) |
    opaque_type(miniapp/4, M?, H0),
    opaque_type(miniapp_person/5, M?, H),
    person_at(H0?, H?, M?, Id?, Role?, Ps?, PEnd?, Screen).

procedure person_at(Stream(Constant)?, Stream(Constant)?, Module?, Key?, Constant?, List(Key)?, Channel(PersonOut(Opaque), PersonIn(Opaque))?, Stream(Opaque)).
person_at([D0, _], [D, S], M, Id, Role, Ps, PEnd, Screen?) :-
    D0? =?= D? |
    find_type(miniapp_person/5, [D?, S?], T),
    run(miniapp_person(Id?, Role?, Ps?, PEnd?, Screen), T?, M?).
person_at(_, _, _, _, _, _, PEnd, []) :- otherwise | hold_person(PEnd?).

procedure hold_person(Channel(PersonOut(Opaque), PersonIn(Opaque))?).
hold_person(ch([_ | Ds], Gs?)) :- hold_person(ch(Ds?, Gs)).
