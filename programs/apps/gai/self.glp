%% ---------------------------------------------------------------------------
%% programs/apps/gai --- the app of GAI, accountable AI agents (GAI's contract, programs/gai/GAI.txt and GAI.glp; Coordination Appendix C), which extends GnW, and through it GSG and GKK, with GSNP's signing, messaging and forwarding beneath it, as a mini-app of the Grassroots Super-App (GSG paper, Section 2), compiled down the abstraction cascade from its act schemas: the canonical CVA platform vGLP's compiler prints from them, platform.vglp (vGLP, Section 3.2, Definition "Canonical CVA Platform"; Section 5.4, "The compilation"), compiled to GLP by the canonical compilation when the directory loads (vGLP, Section 6.3, "The canonical compilation").  It is the host of GSG's app, ../gsg, on GAI's platform: the same entry miniapp/4 (miniapp.glp, the same file as ../gsg's), its scripted person (person.glp) and the play that activates it by run/3, three executions over three conversations, with no super-app (plays.glp).  It calls nothing that reaches the network or the person, so the REPL's :artefact certifies it, and its artefact gai.glpw is what the super-app installs; the plays of the super-app hosting it on three smartphones are ../gai_boot.glp.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module, as every hand-written module importing a compiled procedure restates them today.  The compiled module's own definitions shadow these within it, and the two must agree.
%% ---------------------------------------------------------------------------

Peer      ::= Key.
Speech    ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
Class ::=
establish(Peer)
;
acquaint(Peer, Peer)
;
introduce(Peer, Peer, Peer)
;
befriend(Peer, Peer)
;
unfriend(Peer, Peer)
;
enter(Peer, Peer, Speech)
;
make_guardian(Peer, Peer, Peer, Speech)
;
end_guardian(Peer, Peer, Peer)
;
resign(Peer, Peer)
;
guardian_unfriend(Peer, Peer)
;
agent_acquaint(Peer, Peer, Peer, Speech)
;
agent_befriend(Peer, Peer, Peer)
;
agent_unfriend(Peer, Peer, Peer)
;
agents_acquaint(Peer, Peer, Peer, Peer, Speech, Speech)
;
agents_befriend(Peer, Peer, Peer, Peer)
;
retire(Peer, Peer, List(Peer), List(Peer))
;
sign(Peer, Speech)
.
Proposal ::=
establish(Peer)
;
acquaint(Peer, Peer)
;
introduce(Peer, Peer, Peer)
;
befriend(Peer, Peer)
;
unfriend(Peer, Peer)
;
enter(Peer, Peer, Speech)
;
make_guardian(Peer, Peer, Peer, Speech)
;
end_guardian(Peer, Peer, Peer)
;
resign(Peer, Peer)
;
guardian_unfriend(Peer, Peer)
;
agent_acquaint(Peer, Peer, Peer, Speech)
;
agent_befriend(Peer, Peer, Peer)
;
agent_unfriend(Peer, Peer, Peer)
;
agents_acquaint(Peer, Peer, Peer, Peer, Speech, Speech)
;
agents_befriend(Peer, Peer, Peer, Peer)
;
retire(Peer, Peer)
;
sign(Peer, Speech)
.
Request ::= propose(Proposal).
YesNo     ::= yes ; no.
Reason    ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote      ::= yes ; no(Reason).
Decision  ::= commit ; abort(Peer, Reason) ; yield.
Rho       ::= one(Class) ; rho(Proposal).
Names     ::= none ; request(Rho, Integer).
Attempt   ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo     ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
            ; yield(Attempt) ; request(Rho, Integer).
Content   ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net       ::= msg(Peer, Content).
Atom ::=
identity
;
retired
;
knows(Peer)
;
agent
;
friend(Peer)
;
principal(Peer)
;
guarded_by(Peer)
;
principal_of(Peer)
;
guardian_of(Peer)
;
agent_of(Peer, Speech)
;
authored(Speech)
;
attestation(Speech)
;
retired_of(Peer)
;
item(Speech)
.
Output    ::= view(List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab       ::= tab(String, Constant) ; tab(String, Constant, Constant).
Asking    ::= Attempt ; hello(Peer, Proposal).
Approved  ::= Proposal.
Approval  ::= approval(Asking, List(Word), YesNo?).
Word      ::= text(String) ; person(Peer) ; named(String, Peer) ; valued(String, Integer).
Menu      ::= menu(Key, List(Key), Request?).
Question  ::= menu_w(Menu) ; approval_w(Approval).
Drawn     ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)    ::= ask(Constant, Q).

%% What the mini-app's scripted person reports, its screen (person.glp): each view the program writes, once, the machine state and the persons the agent knows (vGLP b7e3517, Section 5.4, "The compilation"), and each notice, refused(P, Q, D) (vGLP f0acbc1, Section 5.4, "The compilation"); the agent's own key and the persons a request question shows, where the script looks; and each answer it gives an approval question, of the attempt or of an attempt of the class its script names.
Asked     ::= Class ; Attempt.
Seen      ::= Output ; menu(Key, List(Key)) ; gave(Asked, YesNo).

%% The network of the platform over the conversations (miniapp.glp), as in ../gsg/self.glp.
NetEvent  ::= opened(Key, RootChannel(Net)) ; sent(Net).
Route     ::= route(Key, Stream(Net)?).
Routes    ::= [] ; [Route | Routes].
Sending   ::= went ; held(Net).

%% The mini-app's entry, the instance of the root's entry template miniapp/4 (programs/self.glp) at the mini-app's two types, Drawn and Net.
imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?, Stream(Integer)?).
miniapp(Id, Ui, Sg, Cal) :- miniapp # miniapp(Id?, Ui?, Sg?, Cal?).

%% The scripted person, the instance of the root's second template miniapp_person/4 at Drawn and at Seen.
imported procedure person#miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
exported procedure miniapp_person(Key?, Constant?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Id, Role, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, PEnd?, Screen).

%% The play with no super-app (plays.glp).
imported procedure plays#play_agents(Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_agents(Stream(Seen), Stream(Seen), Stream(Seen)).
play_agents(A?, R?, B?) :- plays # play_agents(A, R, B).
