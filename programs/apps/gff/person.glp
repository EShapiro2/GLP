%% person.glp --- the GFF mini-app's scripted person: the instance of the root's second template miniapp_person/5 (programs/self.glp) at Drawn, what the mini-app's dispatcher draws, and at Seen, the screen the person reports (self.glp); and cued_person/5, the same person whose script ends in a tail the play gives, which the play binds once another person's screen shows what the play waits for (plays.glp).  It is ../gsnp/person.glp with GFF's scripts, the steps and the conditions being written in self.glp.
%%
%% The person reads what the dispatcher draws on the person channel: the agent's request questions, each showing the agent's own key and the persons it knows and taking one request; the program's output, construct 0, drawn whole as it grows, on which the agent writes its view when it starts and whenever it changes, and its notices; and the approval questions Start raises (vGLP, Section 5.4, "The compilation").  The person's screen shows the last view written and the notices written after it.  Its script is a list of steps (self.glp, Step).  A script whose tail is not yet given stops there: the person takes no further step, and reads and reports nothing more, until the tail is given.
%%
%% The roles are the persons of GFF's play (Code_inbox.md, GFF #1 Cowork, 2026-10-27 16:34 UTC, and its revisions of 17:21, 18:39, 19:2x and 20:25 UTC): Alice, Bob, Carol, Dave and Eve; the friendships Alice and Bob, Bob and Carol, Carol and Dave, Dave and Eve, each the first meeting the second by their key, the second answering yes to its hello, and then offering the second friendship, who answers yes (GKK:2, GSG:1).  Friends follow each other, by an unguarded act each machine takes once they are friends (GFF:2, friends_follow); a person's one step of following another is Follow, follow (GFF:2); the asking and the following through a friend are unguarded acts, which the person's machine takes once they are enabled (GFF:2, GFF:3; vGLP, Section 5.4, "Triggers").  The items are utterances signed by alice at their posting (GFF:1; GSC, Definition "Binding": admissible):
%%   alice  establishes her identity (GKK:1); meets bob and befriends him; posts the first item and the second (GFF:1); then her script ends in the play's tail.
%%   bob    establishes his identity; answers yes to alice's meeting and friendship, by which the two follow each other (GFF:2, friends_follow); meets carol and befriends her; once he follows alice and both items have reached him, introduces alice to carol (GKK:3), whom carol must know to decide to follow her (GFF:2).
%%   carol  establishes her identity; answers yes to bob's meeting and friendship; meets dave and befriends him; answers yes to bob's introducing alice; once she knows alice, decides to follow her; once she follows her and both items have reached her, introduces alice to dave; then her script ends in the play's tail.
%%   dave   as carol, one friend further: answers yes to carol's meeting and friendship; meets eve and befriends her; answers yes to carol's introducing alice; decides to follow alice; once he follows her and both items have reached him, introduces alice to eve.
%%   eve    establishes her identity; answers yes to dave's meeting and friendship and to his introducing alice; decides to follow alice; waits until the third item holds at her, signed by alice, bob, carol and dave.
%% Each person introduces the next only once both items have reached them, so that no delivery to them is open while their introduction is: an attempt that yields is proposed again, and the person introduced is asked again, where their script answers once.
%% Any other role has no script: its person reports the views and acts on nothing.

Last  ::= last(List(Atom), List(Key)) ; nolast.
Sess  ::= nosess ; sess(Integer, Path, Key, List(Key)).
Shown ::= shown(Integer, Path, Asking).
Shows ::= [] ; [Shown | Shows].
PSt   ::= ps(Sess, List(Output), Shows, Steps).
ApprovalAt ::= approval_at(Integer, Path, Shows) ; noapproval.
YN    ::= y ; n.

exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Me, Role, Ps, ch(Ds, Gs?), S?) :-
    script(Role?, Me?, Ps?, [], Ss),
    person(Ds?, Gs, ps(nosess, [], [], Ss?), S).

%% cued_person(Key, Role, Ps, Tail, PEnd, Screen): the person of Role, who knows the keys Ps, whose script ends in Tail.
exported procedure cued_person(Key?, Constant?, List(Key)?, Steps?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
cued_person(Me, Role, Ps, Tail, ch(Ds, Gs?), S?) :-
    script(Role?, Me?, Ps?, Tail?, Ss),
    person(Ds?, Gs, ps(nosess, [], [], Ss?), S).

%% script(Role, Me, Ps, Tail, Steps): the steps of Role, ending in Tail, Me the person's own key and Ps the keys the person knows, each peer named by its key in Ps, by its position there (alice: bob; bob: alice, carol; carol: bob, dave, alice; dave: carol, eve, alice; eve: dave, alice, the last the person introduced to them), as the play gives them; an item's earlier signers whom the person does not know are named by their names.
procedure script(Constant?, Key?, List(Key)?, Steps?, Steps).
script(alice, Me, [Bob], T, [own([A1], propose(establish(A1?))), wait(holds(identity)),
                             own([A2], propose(acquaint(A2?, Bob?))), wait(holds(knows(Bob?))),
                             own([A3], propose(befriend(A3?, Bob?))), wait(holds(friend(Bob?))),
                             own([A4, A5], propose(post(A4?, speech(utterance('First item'), A5?)))),
                             wait(holds(feed(speech(utterance('First item'), Me?)))),
                             own([A6, A7], propose(post(A6?, speech(utterance('Second item'), A7?)))),
                             wait(holds(feed(speech(utterance('Second item'), Me?)))) | T?]) :-
    ground(Me?), ground(Bob?) | true.
script(bob, Me, [Alice, Carol], T, [own([B1], propose(establish(B1?))), wait(holds(identity)),
                                    approval(acquaint(Alice?, Me?), yes),
                                    approval(befriend(Alice?, Me?), yes),
                                    own([B2], propose(acquaint(B2?, Carol?))), wait(holds(knows(Carol?))),
                                    own([B3], propose(befriend(B3?, Carol?))), wait(holds(friend(Carol?))),
                                    wait(holds(following(Alice?))),
                                    wait(holds(item(speech(utterance('First item'), Alice?), Alice?))),
                                    wait(holds(item(speech(utterance('Second item'), Alice?), Alice?))),
                                    own([B4], propose(introduce(B4?, Carol?, Alice?))) | T?]) :-
    ground(Me?), ground(Alice?), ground(Carol?) | true.
script(carol, Me, [Bob, Dave, Alice], T, [own([C1], propose(establish(C1?))), wait(holds(identity)),
                                          approval(acquaint(Bob?, Me?), yes),
                                          approval(befriend(Bob?, Me?), yes),
                                          own([C2], propose(acquaint(C2?, Dave?))), wait(holds(knows(Dave?))),
                                          own([C3], propose(befriend(C3?, Dave?))), wait(holds(friend(Dave?))),
                                          approval(introduce(Bob?, Me?, Alice?), yes), wait(holds(knows(Alice?))),
                                          own([C4], propose(follow(C4?, Alice?))), wait(holds(following(Alice?))),
                                          wait(holds(item(speech(speech(utterance('First item'), Alice?), Bob?), Alice?))),
                                          wait(holds(item(speech(speech(utterance('Second item'), Alice?), Bob?), Alice?))),
                                          own([C5], propose(introduce(C5?, Dave?, Alice?))) | T?]) :-
    ground(Me?), ground(Bob?), ground(Dave?), ground(Alice?) | true.
script(dave, Me, [Carol, Eve, Alice], T, [own([D1], propose(establish(D1?))), wait(holds(identity)),
                                          approval(acquaint(Carol?, Me?), yes),
                                          approval(befriend(Carol?, Me?), yes),
                                          own([D2], propose(acquaint(D2?, Eve?))), wait(holds(knows(Eve?))),
                                          own([D3], propose(befriend(D3?, Eve?))), wait(holds(friend(Eve?))),
                                          approval(introduce(Carol?, Me?, Alice?), yes), wait(holds(knows(Alice?))),
                                          own([D4], propose(follow(D4?, Alice?))), wait(holds(following(Alice?))),
                                          wait(holds(item(speech(speech(speech(utterance('First item'), Alice?), bob), Carol?), Alice?))),
                                          wait(holds(item(speech(speech(speech(utterance('Second item'), Alice?), bob), Carol?), Alice?))),
                                          own([D5], propose(introduce(D5?, Eve?, Alice?))) | T?]) :-
    ground(Me?), ground(Carol?), ground(Eve?), ground(Alice?) | true.
script(eve, Me, [Dave, Alice], T, [own([E1], propose(establish(E1?))), wait(holds(identity)),
                                   approval(acquaint(Dave?, Me?), yes),
                                   approval(befriend(Dave?, Me?), yes),
                                   approval(introduce(Dave?, Me?, Alice?), yes), wait(holds(knows(Alice?))),
                                   own([E2], propose(follow(E2?, Alice?))), wait(holds(following(Alice?))),
                                   wait(holds(item(speech(speech(speech(speech(utterance('Third item'), Alice?), bob), carol), Dave?), Alice?))) | T?]) :-
    ground(Me?), ground(Dave?), ground(Alice?) | true.
script(_, _, _, T, T?) :- otherwise | true.

%% The person.
procedure person(PersonOut(Drawn)?, PersonIn(Drawn), PSt?, Stream(Seen)).
person([draw(0, _, output(T)) | Ds], Gs?, ps(Se, Old, Cs, Ss), Log?) :-
    ground(T?) |
    log_new(Old?, T?, Log, Log1?),
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log1, Log2?),
    person(Ds?, Gs1, St1?, Log2).
person([draw(Id, _, menu_w(menu(Me, Ks, input(P)))) | Ds], Gs?, ps(_, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?), ground(Me?), ground(Ks?) |
    advance(ps(sess(Id?, P?, Me?, Ks?), T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([draw(Id, _, approval_w(approval(At, _, input(P)))) | Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?), ground(At?) |
    advance(ps(Se?, T?, [shown(Id?, P?, At?) | Cs?], Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([withdraw(Id) | Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :-
    ground(Id?) |
    drop_shown(Id?, Cs?, Cs1),
    person(Ds?, Gs, ps(Se?, T?, Cs1?, Ss?), Log).
person([_ | Ds], Gs?, St, Log?) :-
    otherwise | person(Ds?, Gs, St?, Log).

%% advance(St, Gs, Gs1, St1, Log, Log1): the script's steps taken as far as they can be, the grants written on Gs, continuing at Gs1.
procedure advance(PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
advance(ps(sess(Id, P, _, _), T, Cs, [req(R) | Ss]), [input(Id?, P?, R?) | Gs?], Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?) |
    advance(ps(nosess, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [req(R) | Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [req(R?) | Ss?]), Log1?, Log1).
advance(ps(sess(Id, P, Me, _), T, Cs, [own(Ks, R) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?) |
    fill(Me?, Ks?),
    grant(Id?, P?, R?, Gs, Gs2?),
    advance(ps(nosess, T?, Cs?, Ss?), Gs2, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [own(Ks, R) | Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [own(Ks?, R?) | Ss?]), Log1?, Log1).
advance(ps(sess(Id, P, Me, Ks), T, Cs, [look | Ss]), Gs?, Gs1, St1?, [menu(Me?, Ks?) | Log?], Log1) :-
    ground(Id?), ground(P?), ground(Me?), ground(Ks?) |
    advance(ps(sess(Id?, P?, Me?, Ks?), T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [look | Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [look | Ss?]), Log1?, Log1).
advance(ps(Se, T, Cs, [wait(X) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Se?), ground(T?), ground(Cs?), ground(X?) |
    shows(X?, Se?, T?, Cs?, B),
    waited(B?, ps(Se?, T?, Cs?, [wait(X?) | Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, [approval(K, A) | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Cs?), ground(K?) |
    find_approval(K?, Cs?, F),
    approved(F?, ps(Se?, T?, Cs?, [approval(K?, A?) | Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, []), Gs1?, Gs1, ps(Se?, T?, Cs?, []), Log1?, Log1).

%% fill(Me, Ks): the agent's own key Me written into each hole of Ks.
procedure fill(Key?, Holes?).
fill(Me, [Me? | Ks]) :- ground(Me?) | fill(Me?, Ks?).
fill(_, []).

%% grant(Id, P, R, Gs, Gs1): the grant of R on the question Id at P, once R, its holes filled, is ground.
procedure grant(Integer?, Path?, Request?, PersonIn(Drawn), PersonIn(Drawn)?).
grant(Id, P, R, [input(Id?, P?, R?) | Gs1?], Gs1) :- ground(R?) | true.

procedure waited(YN?, PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
waited(y, ps(Se, T, Cs, [_ | Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
waited(n, St, Gs1?, Gs1, St?, Log1?, Log1).

%% What the person's screen shows (the step wait(C)): the last view written and the notices written after it, the approval questions drawn and not answered, and whether a request question is drawn and not answered.
procedure shows(Cond?, Sess?, List(Output)?, Shows?, YN).
shows(known(Q), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    known_in(Q?, L?, B).
shows(holds(A), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, 1, B).
shows(lacks(A), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, 1, B1),
    flip(B1?, B).
shows(has(A, K), _, T, _, B?) :- ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, K?, B).
shows(refused(P, Q, D), _, T, _, B?) :- ground(P?), ground(Q?), ground(D?), ground(T?) |
    notices_of(T?, Ns),
    among_output(refused(P?, Q?, D?), Ns?, B).
shows(asked(K), _, _, Cs, B?) :- ground(K?), ground(Cs?) |
    find_approval(K?, Cs?, F),
    found_yn(F?, B).
shows(asking, sess(_, _, _, _), _, _, y).
shows(asking, nosess, _, _, n).

%% The last view written, or none: the output holds the views and the notices.
procedure last_of(List(Output)?, Last).
last_of(T, L?) :- last_view(T?, nolast, L).
procedure last_view(List(Output)?, Last?, Last).
last_view([], L, L?).
last_view([view(S, K, _, _) | Xs], _, L?) :- last_view(Xs?, last(S?, K?), L).
last_view([_ | Xs], L0, L?) :- otherwise | last_view(Xs?, L0?, L).

%% The notices written after the last view, which the screen shows until the next view is written (vGLP f5f1644, Section 5.4, "The compilation": the widget "draws the last view written and the notices written after it").
procedure notices_of(List(Output)?, List(Output)).
notices_of(T, Ns?) :- notices_after(T?, [], Ns).
procedure notices_after(List(Output)?, List(Output)?, List(Output)).
notices_after([], Ns, Ns?).
notices_after([view(_, _, _, _) | Xs], _, Ns?) :- notices_after(Xs?, [], Ns).
notices_after([X | Xs], Ns0, Ns?) :- otherwise | notices_after(Xs?, [X? | Ns0?], Ns).
procedure among_output(Output?, List(Output)?, YN).
among_output(_, [], n).
among_output(X, [Y | _], y) :- X? =?= Y? | true.
among_output(X, [_ | Ys], B?) :- otherwise | among_output(X?, Ys?, B).

procedure known_in(Key?, Last?, YN).
known_in(Q, last(_, Ks), B?) :- among_key(Q?, Ks?, B).
known_in(_, nolast, n).

procedure among_key(Key?, List(Key)?, YN).
among_key(_, [], n).
among_key(X, [Y | _], y) :- X? =?= Y? | true.
among_key(X, [_ | Ys], B?) :- otherwise | among_key(X?, Ys?, B).

procedure count_in(Atom?, Last?, Integer).
count_in(A, last(S, _), N?) :- count(A?, S?, N).
count_in(_, nolast, 0).

procedure count(Atom?, List(Atom)?, Integer).
count(_, [], 0).
count(X, [Y | Ys], N?) :- X? =?= Y? | count(X?, Ys?, M), N := M? + 1.
count(X, [_ | Ys], N?) :- otherwise | count(X?, Ys?, N).

procedure at_least(Integer?, Integer?, YN).
at_least(N, K, y) :- N? >= K? | true.
at_least(N, K, n) :- N? < K? | true.

procedure flip(YN?, YN).
flip(y, n).
flip(n, y).

procedure found_yn(ApprovalAt?, YN).
found_yn(approval_at(_, _, _), y).
found_yn(noapproval, n).

procedure approved(ApprovalAt?, PSt?, PersonIn(Drawn), PersonIn(Drawn)?, PSt, Stream(Seen), Stream(Seen)?).
approved(approval_at(Id, P, Cs1), ps(Se, T, _, [approval(K, A) | Ss]),
         [input(Id?, P?, A?) | Gs?], Gs1, St1?, [gave(K?, A?) | Log?], Log1) :-
    ground(K?), ground(A?) |
    advance(ps(Se?, T?, Cs1?, Ss?), Gs, Gs1?, St1, Log, Log1?).
approved(noapproval, St, Gs1?, Gs1, St?, Log1?, Log1).

%% The approval question of the attempt K, or of an attempt of the class K, the earliest drawn first.
procedure find_approval(Asked?, Shows?, ApprovalAt).
find_approval(K, Cs, F?) :- ground(Cs?) | rev_shown(Cs?, [], Rs), find_approval1(K?, Rs?, [], F).

procedure find_approval1(Asked?, Shows?, Shows?, ApprovalAt).
find_approval1(_, [], _, noapproval).
find_approval1(K, [shown(Id, P, At) | Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(At?), ground(K?), K? =?= At? |
    rev_shown(Done?, Cs?, Rest).
find_approval1(K, [shown(Id, P, attempt(_, _, _, C, _)) | Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(C?), ground(K?), K? =?= C? |
    rev_shown(Done?, Cs?, Rest).
find_approval1(K, [shown(Id, P, hello(_, N)) | Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(N?), ground(K?), K? =?= N? |
    rev_shown(Done?, Cs?, Rest).
find_approval1(K, [S | Cs], Done, F?) :-
    otherwise | find_approval1(K?, Cs?, [S? | Done?], F).

procedure rev_shown(Shows?, Shows?, Shows).
rev_shown([], Acc, Acc?).
rev_shown([S | Ss], Acc, R?) :- rev_shown(Ss?, [S? | Acc?], R).

procedure drop_shown(Integer?, Shows?, Shows).
drop_shown(_, [], []).
drop_shown(Id, [shown(J, _, _) | Cs], Cs?) :- Id? =:= J? | true.
drop_shown(Id, [S | Cs], [S? | Cs1?]) :- otherwise | drop_shown(Id?, Cs?, Cs1).

%% The views and the notices not reported before: the output is drawn whole each time it grows, so those past the old one's length are new.
procedure log_new(List(Output)?, List(Output)?, Stream(Seen), Stream(Seen)?).
log_new([_ | Os], [_ | Ns], Log?, Log1) :- log_new(Os?, Ns?, Log, Log1?).
log_new([], Ns, Log?, Log1) :- put(Ns?, Log, Log1?).
log_new([_ | _], [], Log1?, Log1).

procedure put(List(Output)?, Stream(Seen), Stream(Seen)?).
put([X | Xs], [X? | Log?], Log1) :- put(Xs?, Log, Log1?).
put([], Log1?, Log1).
