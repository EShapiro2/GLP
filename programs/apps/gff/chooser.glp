%% chooser.glp --- GFF's chooser, the module chooser of GFF's app, which the platform's agent calls on each own trigger with the Proposes of the unguarded parts it opens whose condition holds, the longest waited first, its machine state as its view shows it, and the every_so_often parts it has committed as their initiator, newest first, each once (programs/vglp/cva/compiler/CHOOSER.md, "The seam"; the experiment GFF-chooser, approved by Udi on 2026-10-27, reported by GFF #1 Cowork).
%%
%% Written from the Algorithms section of GFF's pragmas, programs/gff/GFF.txt on the branch GFF-chooser at 2cf31e80: "Updating: Carol updates a friend whenever Carol comes to follow or ceases to follow an agent, and a new friend upon befriending (GFF:5)."  Carol's role in update and update_ceased carries the mark every_so_often (GFF.glp).  The chooser takes update(Carol, Alice, b) where the newer of update(Carol, Alice, b) and update_ceased(Carol, Alice, b) among the parts committed is not update, a new friend having neither, and update_ceased(Carol, Alice, b) where the newer is update; it holds each otherwise.  So Carol tells Alice once after each change of whether Carol follows b, and a new friend once upon befriending.  Every other part it takes as the default does: of the parts, the first that it does not hold.

%% The types of the platform the chooser is written against, platform.vglp's as GFF's contract prints them, written again here so that the module carries them, as the record of a run of the cascade holds it beside the platform with no self.glp (cascade.sh); they agree with platform.vglp's and with self.glp's, as the import of choose/4 in platform.vglp requires.
Peer      ::= Key.
Speech    ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
Class     ::= establish(Peer) ; acquaint(Peer, Peer) ; introduce(Peer, Peer, Peer)
            ; befriend(Peer, Peer) ; unfriend(Peer, Peer) ; post(Peer, Speech)
            ; friends_follow(Peer, Peer) ; friend_following_ended(Peer, Peer)
            ; follow_through(Peer, Peer, Peer) ; path_broken(Peer, Peer, Peer)
            ; friendship_ended(Peer, Peer, Peer) ; unfollow(Peer, Peer, Peer)
            ; deliver_own(Peer, Peer, Speech) ; deliver_on(Peer, Peer, Peer, Speech)
            ; update(Peer, Peer, Peer) ; update_ceased(Peer, Peer, Peer).
Atom      ::= identity ; knows(Peer) ; friend(Peer) ; feed(Speech) ; follows_friend(Peer)
            ; following(Peer) ; follower(Peer, Peer) ; follows(Peer, Peer) ; sent(Speech, Peer)
            ; item(Speech, Peer) ; friend_follows(Peer, Peer).
YesNo     ::= yes ; no.

%% What the chooser returns: the part to take, by its class term, or none yet (CHOOSER.md, "The seam").
Chosen    ::= take(Class) ; none_yet.
%% What Carol last told Alice about b, by the parts committed: that Carol follows b, that Carol does not, or nothing.
Told      ::= told_follows ; told_ceased ; told_nothing.

exported procedure choose(List(Class)?, List(Atom)?, List(Class)?, Chosen).
choose([], _, _, none_yet).
choose([P | Ps], S, Of, C?) :-
    ground(P?), ground(Of?) |
    allowed(P?, Of?, A),
    choose1(A?, P?, Ps?, S?, Of?, C).

procedure choose1(YesNo?, Class?, List(Class)?, List(Atom)?, List(Class)?, Chosen).
choose1(yes, P, _, _, _, take(P?)).
choose1(no, _, Ps, S, Of, C?) :- choose(Ps?, S?, Of?, C).

%% Whether the part may be taken now: an update where Carol has not told Alice that Carol follows b since it last changed, an update_ceased where Carol last told Alice that Carol follows b, and every other part at once.
procedure allowed(Class?, List(Class)?, YesNo).
allowed(update(_, A, B), Of, R?) :-
    ground(A?), ground(B?) |
    told(Of?, A?, B?, T),
    due_follows(T?, R).
allowed(update_ceased(_, A, B), Of, R?) :-
    ground(A?), ground(B?) |
    told(Of?, A?, B?, T),
    due_ceased(T?, R).
allowed(_, _, yes) :- otherwise | true.

procedure due_follows(Told?, YesNo).
due_follows(told_follows, no).
due_follows(told_ceased, yes).
due_follows(told_nothing, yes).

procedure due_ceased(Told?, YesNo).
due_ceased(told_follows, yes).
due_ceased(told_ceased, no).
due_ceased(told_nothing, no).

%% told(Of, A, B, T): the newer of update(_, A, B) and update_ceased(_, A, B) among the parts committed, newest first.
procedure told(List(Class)?, Peer?, Peer?, Told).
told([], _, _, told_nothing).
told([update(_, A1, B1) | _], A, B, told_follows) :- A1? =?= A?, B1? =?= B? | true.
told([update_ceased(_, A1, B1) | _], A, B, told_ceased) :- A1? =?= A?, B1? =?= B? | true.
told([_ | Of], A, B, T?) :- otherwise | told(Of?, A?, B?, T).
