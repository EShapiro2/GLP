%% ---------------------------------------------------------------------------
%% programs/apps/gff --- the app of GFF, Grassroots Feeds and Followers, compiled from GFF-I, Implementable GFF (programs/gff/GFF-I.txt and GFF-I.glp), the contract vGLP compiles for GFF, which restricts GFF and with it GDO-L, GDO, GSG and GKK, as a mini-app of the Grassroots Super-App (GSG paper, Section 2), compiled down the abstraction cascade from its act schemas: the canonical CVA platform vGLP's compiler prints from them, platform.vglp (vGLP, Section 3.2, Definition "Canonical CVA Platform"; Section 5.4, "The compilation"), compiled to GLP by the canonical compilation when the directory loads (vGLP, Section 6.3, "The canonical compilation").  It is the host of ../gsg on GFF-I's platform: the same entry miniapp/3 (miniapp.glp, the same file), a scripted person (person.glp) and the play that activates it by run/3, four executions over four conversations, with no super-app (plays.glp).
%%
%% The types of platform.vglp, written again for the declarations of this directory's modules, but for those the compilation forms --- Question, Drawn and Ask(Q) --- which the linker writes into every module that imports a compiled procedure, the dispatcher, or a procedure whose declaration names them (vGLP, Section 6.3, "The canonical compilation") (../gsg/self.glp).  The compiled module's own definitions shadow these within it, and the two must agree.
%% ---------------------------------------------------------------------------

Peer      ::= Key.
Speech    ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
Class     ::= establish(Peer) ; acquaint(Peer, Peer) ; introduce(Peer, Peer, Peer)
            ; befriend(Peer, Peer) ; unfriend(Peer, Peer)
            ; point_friend(Peer, Peer) ; point_transitive(Peer, Peer, Peer) ; unpoint(Peer, Peer)
            ; follow_friend(Peer, Peer, Peer) ; follow_transitive(Peer, Peer, Peer, Peer)
            ; follow_transitive_friend(Peer, Peer, Peer, Peer) ; unfollow(Peer, Peer)
            ; post(Peer, Speech) ; deliver(Peer, Peer, Peer, Speech).
Proposal  ::= establish(Peer) ; acquaint(Peer, Peer) ; introduce(Peer, Peer, Peer)
            ; befriend(Peer, Peer) ; unfriend(Peer, Peer)
            ; point_friend(Peer, Peer) ; point_transitive(Peer, Peer, Peer) ; unpoint(Peer, Peer)
            ; follow_friend(Peer, Peer, Peer) ; follow_transitive(Peer, Peer, Peer, Peer)
            ; follow_transitive_friend(Peer, Peer, Peer, Peer) ; unfollow(Peer, Peer)
            ; post(Peer, Speech).
Request   ::= propose(Proposal).
YesNo     ::= yes ; no.
Reason    ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote      ::= yes ; no(Reason).
Decision  ::= commit ; abort(Peer, Reason) ; yield.
Rho       ::= one(Class) ; rho(Proposal).
Names     ::= none ; request(Rho, Integer).
Attempt   ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo     ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
            ; yield(Attempt) ; request(Rho, Integer).
Content   ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net       ::= msg(Peer, Content).
Atom      ::= identity ; knows(Peer) ; friend(Peer) ; pointer(Peer, Peer) ; points_to(Peer)
            ; item(Speech, Peer) ; received(Speech, Peer, Peer).
Output    ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)) ; refused(Approved, Key, Reason).
Tab       ::= tab(String, Constant) ; tab(String, Constant, Constant).
Asking    ::= Attempt ; hello(Peer, Proposal).
Approved  ::= Proposal.
Approval  ::= approval(Asking, List(Word), YesNo?).
Word      ::= text(String) ; person(Peer) ; named(String, Peer) ; valued(String, Number) ; held(Atom, Integer).

%% What the mini-app's scripted person reports, its screen (person.glp): each view the program writes, once, and each notice; the agent's own key and the persons it knows, as the last view drawn shows them, where the script looks; and each answer it gives an approval question, of the attempt or of an attempt of the class its script names.
Asked     ::= Class ; Attempt.
Seen      ::= Output ; menu(Key, List(Key)) ; gave(Asked, YesNo).

%% The scripted person's steps (person.glp), which the play also writes (plays.glp): req(R) grants the request R; own(Ks, R) grants R once the agent's own key is written into each hole of Ks; look reports the agent's own key and the persons it knows; wait(C) waits until the screen shows C; approval(K, A) answers A the approval question of K.
Step      ::= req(Request) ; own(Holes, Request) ; look ; wait(Cond) ; approval(Asked, YesNo).
Cond      ::= known(Key) ; holds(Atom) ; lacks(Atom) ; has(Atom, Integer)
            ; refused(Proposal, Key, Reason) ; asked(Asked) ; asking.
Steps     ::= [] ; [Step | Steps].
Holes     ::= [] ; [Key? | Holes].

%% The network of the platform over the conversations (miniapp.glp), as in ../gsg/self.glp.
NetEvent  ::= opened(Key, RootChannel(Net)) ; sent(Net) ; declined(Key).
Route     ::= route(Key, Stream(Net)?).
Routes    ::= [] ; [Route | Routes].
Sending   ::= went ; held(Net).

%% The mini-app's entry, the instance of the root's entry template miniapp/3 (programs/self.glp) at the mini-app's two types, Drawn and Net.
imported procedure miniapp#miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?).
exported procedure miniapp(Key?, PersonChannel(Drawn)?, SgChannel(Net)?).
miniapp(Id, Ui, Sg) :- miniapp # miniapp(Id?, Ui?, Sg?).

%% The scripted person, the instance of the root's second template miniapp_person/5 at Drawn and at Seen.
imported procedure person#miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
exported procedure miniapp_person(Key?, Constant?, List(Key)?, Channel(PersonOut(Drawn), PersonIn(Drawn))?, Stream(Seen)).
miniapp_person(Id, Role, Ps, PEnd, Screen?) :- person # miniapp_person(Id?, Role?, Ps?, PEnd?, Screen).

%% The play with no super-app (plays.glp).
imported procedure plays#play_feeds(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
exported procedure play_feeds(Stream(Seen), Stream(Seen), Stream(Seen), Stream(Seen)).
play_feeds(A?, B?, C?, D?) :- plays # play_feeds(A, B, C, D).
