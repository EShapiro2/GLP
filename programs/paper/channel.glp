% Test: Bidirectional Channel
% Paper: Appendix A.6
% Description: Two-way communication channel with send/receive
% Tests interactive Channel type with complementary streams

procedure my_new_channel(Channel(X, Y), Channel(Y, X)).
procedure my_send(X?, Channel(Stream(X))?, Channel(Stream(X))).
procedure my_receive(X, Channel(Stream(X))?, Channel(Stream(X))).

my_new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).
my_send(X, ch(In, [X?|Out?]), ch(In?, Out)).
my_receive(X?, ch([X|In], Out?), ch(In?, Out)).
