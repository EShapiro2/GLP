% Test: Stream Merge
% Paper: Appendix A.1
% Description: Classic fair merge of two streams into one
% Uses predefined Stream type from root self.glp

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).

merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).
