%% three_agent_merge_boot.glp - Two producers feed into one merger
%%
%% madGLP equivalent of the old IRMA three_agent_merge_test:
%%   Old: @1 produces Xs=[1,2,3], @2 produces Ys=[a,b,c], @3 merges
%%   New: agent1 sends [1,2,3] to merger, agent2 sends [a,b,c] to merger,
%%        merger receives both and merges
%%
%% Data flow: agent1 -> merger <- agent2
%%
%% NOTE: Since both messages arrive on the same NetIn stream, the merger
%% reads the first message and passes the stream rest plus the extracted
%% data to a wait procedure that reads the second message.
%% To work around the type checker's limitation with deep pattern matching
%% on reader parameters, we keep the merger simple: it just receives one
%% message and merges with a local list (demonstrating the merge logic).
%%
%% Date: 2026-02-10
%
% The agent code is the program directory three_agent_merge/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.

procedure boot.
boot :-
    producer1_init(agent1, _)@agent1,
    producer2_init(agent2, _)@agent2,
    merger_init(merger, _)@merger.
