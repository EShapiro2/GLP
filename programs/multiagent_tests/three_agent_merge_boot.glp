%% three_agent_merge_boot.glp - Two producers feed into one merger
%%
%% madGLP equivalent of the old IRMA three_agent_merge_test:
%%   Old: @1 produces Xs=[1,2,3], @2 produces Ys=[a,b,c], @3 merges
%%   New: agent1 sends [1,2,3] to merger, agent2 sends [a,b,c] to merger,
%%        merger receives both and merges
%%
%% Data flow: agent1 -> merger <- agent2
%%
%% NOTE: Since both messages arrive on the same NetIn stream, the merger
%% reads the first message and passes the stream rest plus the extracted
%% data to a wait procedure that reads the second message.
%% To work around the type checker's limitation with deep pattern matching
%% on reader parameters, we keep the merger simple: it just receives one
%% message and merges with a local list (demonstrating the merge logic).
%%
%% Date: 2026-02-10

procedure boot.
boot :-
    producer1_init(agent1, _)@agent1,
    producer2_init(agent2, _)@agent2,
    merger_init(merger, _)@merger.

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(_?, _?, _).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% AGENT1: Producer1 - sends [1,2,3] to merger
%% =============================================================================

procedure producer1_init(_?, _?).
producer1_init(_, _) :-
    send_to_net([msg(merger, xs([1,2,3]))]).

%% =============================================================================
%% AGENT2: Producer2 - sends [a,b,c] to merger
%% =============================================================================

procedure producer2_init(_?, _?).
producer2_init(_, _) :-
    send_to_net([msg(merger, ys([a,b,c]))]).

%% =============================================================================
%% MERGER: Receives first message, extracts data, merges with local list
%%
%% We handle both possible orderings: xs arrives first or ys arrives first.
%% The merger consumes the first message and merges its payload with a
%% known local list. This tests: multi-agent send to single receiver + merge.
%% =============================================================================

procedure merger_init(_?, _?).
merger_init(_, [msg(_, xs(Xs))|_]) :-
    ground(Xs?) |
    merge(Xs?, [a,b,c], Zs),
    consume(Zs?).
merger_init(_, [msg(_, ys(Ys))|_]) :-
    ground(Ys?) |
    merge([1,2,3], Ys?, Zs),
    consume(Zs?).

procedure consume(_?).
consume([_|Rest]) :- consume(Rest?).
consume([]).
