%% two_hop_flow/agents.glp — the agent code of two_hop_flow_boot.glp.
%% The entry points the boot clause spawns are exported here and
%% forwarded from self.glp; every other procedure is local to this module.
%% =============================================================================
%% AGENT1: Sends data to agent2
%% =============================================================================

exported procedure agent1_init(_?, _?).
agent1_init(_, _) :-
    send_to_net([msg(agent2, data([1,2,3]))]).

%% =============================================================================
%% AGENT2: Receives data, transforms it, sends result back to agent1
%% Tests: receive from network, local computation, send result to network
%% =============================================================================

exported procedure agent2_init(_?, _?).
agent2_init(_, [msg(_, data(Xs))|_]) :-
    ground(Xs?) |
    transform(Xs?, Ys),
    send_to_net([msg(agent1, result(Ys?))]).

procedure transform(_?, _).
transform([X|Xs], [got(X?)|Ys?]) :- transform(Xs?, Ys).
transform([], []).
