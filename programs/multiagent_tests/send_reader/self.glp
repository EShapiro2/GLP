%% send_reader/self.glp — program interface.
%%
% The entry points named in ../send_reader_boot.glp are exported here and forwarded
%% to agents.glp, which defines them.  The boot clause itself is NOT in this
%% directory: BootLoader strips it on the boot path, but a directory load does
%% not, and its @ atoms would then meet the type checker.

imported procedure agents#sender_init(_?, _?).
imported procedure agents#receiver_init(_?, _?).

exported procedure sender_init(_?, _?).
sender_init(Id, In) :- agents # sender_init(Id?, In?).

exported procedure receiver_init(_?, _?).
receiver_init(Id, In) :- agents # receiver_init(Id?, In?).
