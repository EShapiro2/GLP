%% coop_stream_boot.glp - Cooperative stream: producer on one agent, merge on another
%%
%% madGLP equivalent of the old IRMA coop_stream_test:
%%   Old: @1 produces Xs=[1,2,3], @2 produces Ys=[a,b,c] and merges
%%   New: agent1 sends list [1,2,3] to agent2, agent2 merges with local [a,b,c]
%%
%% Scenario:
%%   agent1: sends list [1,2,3] element-by-element to agent2
%%   agent2: receives from NetIn, produces local [a,b,c], merges both
%%
%% Date: 2026-02-10
%
% The agent code is the program directory coop_stream/, which this boot spawns
% into; BootConfig.programDir loads it and this boot clause on top.

procedure boot.
boot :-
    agent1_init(agent1, _)@agent1,
    agent2_init(agent2, _)@agent2.
