% ---------------------------------------------------------------------------
% The state a row computes (Definition "State of a Row"), read with the decided
% acts of the row in place of its act records (Definition "State of a Row,
% Implied").
%
% row_state/4 is the implied reading and row_state_explicit/3 the reading as it
% stands, for the layer of Definition "Grassroots Federation over Records";
% both go through row_state_on/4, which is the definition itself over whatever
% act records it is handed.
% ---------------------------------------------------------------------------

imported procedure name#name_eq(Name?, Name?, Ans).
imported procedure name#name_extend(Name?, Integer?, Name).
imported procedure name#name_is_agent(Name?, Ans).
imported procedure name#name_agent(Name?, Constant).
imported procedure rat#rat_add(Rat?, Rat?, Rat).
imported procedure decide#decided_acts(Rat?, Row?, Arecs).
imported procedure decide#explicit_acts(Row?, Arecs).
imported procedure decide#row_motions(Row?, Motions).
imported procedure decide#motion_act(Motion?, Act).
imported procedure decide#motion_epoch(Motion?, Integer).
imported procedure decide#motion_community(Motion?, Name).

% ---------------------------------------------------------------------------
% Epochs and the pair an act record sits on
% ---------------------------------------------------------------------------

procedure motions_max_epoch(Motions?, Integer).
motions_max_epoch([], 0).
motions_max_epoch([M|Ms], N?) :- ground(M?), ground(Ms?) |
    decide # motion_epoch(M?, K),
    motions_max_epoch(Ms?, N1),
    imax(K?, N1?, N).

% The epoch of an act record is the greatest of its motions'.
procedure arec_epoch(Arec?, Integer).
arec_epoch(arec(_, Ms), N?) :- ground(Ms?) | motions_max_epoch(Ms?, N).

% The community a Federate forms: (u, k+1) for k the epoch of its motion.
procedure fed_parent(Name?, Motions?, Name).
fed_parent(U, Ms, P?) :- ground(U?), ground(Ms?) |
    motions_max_epoch(Ms?, K),
    fed_parent1(U?, K?, P).

procedure fed_parent1(Name?, Integer?, Name).
fed_parent1(U, K, P?) :- ground(U?), integer(K?) |
    K1 := K? + 1,
    name # name_extend(U?, K1?, P).

% Is this act record on the pair f -> u?  A Federate u sits on the pair from
% the community it forms to u.
procedure arec_on_pair(Arec?, Name?, Name?, Ans).
arec_on_pair(arec(join(F1, G1), _), F, U, R?) :-
    ground(F1?), ground(G1?), ground(F?), ground(U?) |
    name # name_eq(F1?, F?, A1),
    name # name_eq(G1?, U?, A2),
    and_ans(A1?, A2?, R).
arec_on_pair(arec(leave(F1, G1), _), F, U, R?) :-
    ground(F1?), ground(G1?), ground(F?), ground(U?) |
    name # name_eq(F1?, F?, A1),
    name # name_eq(G1?, U?, A2),
    and_ans(A1?, A2?, R).
arec_on_pair(arec(federate(U1), Ms), F, U, R?) :-
    ground(U1?), ground(Ms?), ground(F?), ground(U?) |
    name # name_eq(U1?, U?, A1),
    arec_on_pair1(A1?, U1?, Ms?, F?, R).

procedure arec_on_pair1(Ans?, Name?, Motions?, Name?, Ans).
arec_on_pair1(no, _, _, _, no).
arec_on_pair1(yes, U1, Ms, F, R?) :- ground(U1?), ground(Ms?), ground(F?) |
    fed_parent(U1?, Ms?, P),
    name # name_eq(P?, F?, R).

% ---------------------------------------------------------------------------
% Heads (Definition "State of a Row"(1))
% ---------------------------------------------------------------------------

procedure on_pair_only(Arecs?, Name?, Name?, Arecs).
on_pair_only([], _, _, []).
on_pair_only([A|As], F, U, R?) :-
    ground(A?), ground(As?), ground(F?), ground(U?) |
    arec_on_pair(A?, F?, U?, Y),
    on_pair_only1(Y?, A?, As?, F?, U?, R).

procedure on_pair_only1(Ans?, Arec?, Arecs?, Name?, Name?, Arecs).
on_pair_only1(yes, A, As, F, U, [A?|R?]) :- ground(As?), ground(F?), ground(U?) |
    on_pair_only(As?, F?, U?, R).
on_pair_only1(no, _, As, F, U, R?) :- ground(As?), ground(F?), ground(U?) |
    on_pair_only(As?, F?, U?, R).

procedure max_epoch(Arecs?, Integer).
max_epoch([], 0).
max_epoch([A|As], N?) :- ground(A?), ground(As?) |
    arec_epoch(A?, K),
    max_epoch(As?, N1),
    imax(K?, N1?, N).

procedure at_epoch(Arecs?, Integer?, Arecs).
at_epoch([], _, []).
at_epoch([A|As], K, R?) :- ground(A?), ground(As?), integer(K?) |
    arec_epoch(A?, K1),
    at_epoch1(K1?, K?, A?, As?, R).

procedure at_epoch1(Integer?, Integer?, Arec?, Arecs?, Arecs).
at_epoch1(K1, K, A, As, [A?|R?]) :- K1? =:= K?, ground(As?) | at_epoch(As?, K?, R).
at_epoch1(K1, K, _, As, R?) :- K1? =\= K?, ground(As?) | at_epoch(As?, K?, R).

exported procedure heads(Arecs?, Name?, Name?, Arecs).
heads(As, F, U, R?) :- ground(As?), ground(F?), ground(U?) |
    on_pair_only(As?, F?, U?, Ps),
    heads1(Ps?, R).

procedure heads1(Arecs?, Arecs).
heads1(Ps, R?) :- ground(Ps?) |
    max_epoch(Ps?, K),
    at_epoch(Ps?, K?, R).

procedure any_leave(Arecs?, Ans).
any_leave([], no).
any_leave([arec(leave(_, _), _)|_], yes).
any_leave([_|As], R?) :- otherwise, ground(As?) | any_leave(As?, R).

% An edge holds when the heads are nonempty and none of them is a Leave.
procedure edge_from_heads(Arecs?, Ans).
edge_from_heads([], no).
edge_from_heads([A|As], R?) :- ground(A?), ground(As?) |
    any_leave([A?|As?], L),
    not_ans(L?, R).

% ---------------------------------------------------------------------------
% What a transaction reads of a pair: whether the edge holds, and the epoch a
% Move takes --- one more than the greatest epoch of an act record on the pair
% or of that Federate, and 0 where there is none.
% ---------------------------------------------------------------------------

exported procedure edge_holds(Arecs?, Name?, Name?, Ans).
edge_holds(As, F, G, R?) :- ground(As?), ground(F?), ground(G?) |
    heads(As?, F?, G?, H),
    edge_from_heads(H?, R).

procedure epoch_after(Arecs?, Integer).
epoch_after([], 0).
epoch_after([A|As], R?) :- ground(A?), ground(As?) |
    max_epoch([A?|As?], K),
    R := K? + 1.

exported procedure pair_epoch(Arecs?, Name?, Name?, Integer).
pair_epoch(As, F, G, R?) :- ground(As?), ground(F?), ground(G?) |
    on_pair_only(As?, F?, G?, Ps),
    epoch_after(Ps?, R).

procedure fed_acts1(Ans?, Name?, Motions?, Arecs?, Name?, Arecs).
fed_acts1(yes, U1, Ms, As, U, [arec(federate(U1?), Ms?)|R?]) :-
    ground(As?), ground(U?) |
    fed_acts(As?, U?, R).
fed_acts1(no, _, _, As, U, R?) :- ground(As?), ground(U?) | fed_acts(As?, U?, R).

exported procedure fed_acts(Arecs?, Name?, Arecs).
fed_acts([], _, []).
fed_acts([arec(federate(U1), Ms)|As], U, R?) :-
    ground(U1?), ground(Ms?), ground(As?), ground(U?) |
    name # name_eq(U1?, U?, A),
    fed_acts1(A?, U1?, Ms?, As?, U?, R).
fed_acts([_|As], U, R?) :- otherwise, ground(As?), ground(U?) | fed_acts(As?, U?, R).

exported procedure federate_epoch(Arecs?, Name?, Integer).
federate_epoch(As, U, R?) :- ground(As?), ground(U?) |
    fed_acts(As?, U?, Ps),
    epoch_after(Ps?, R).

exported procedure act_epoch(Arecs?, Act?, Integer).
act_epoch(As, join(F, G), R?) :- ground(As?), ground(F?), ground(G?) |
    pair_epoch(As?, F?, G?, R).
act_epoch(As, leave(F, G), R?) :- ground(As?), ground(F?), ground(G?) |
    pair_epoch(As?, F?, G?, R).
act_epoch(As, federate(U), R?) :- ground(As?), ground(U?) |
    federate_epoch(As?, U?, R).

% ---------------------------------------------------------------------------
% Children and parents (Definition "State of a Row"(1))
% ---------------------------------------------------------------------------

procedure names_member(Names?, Name?, Ans).
names_member([], _, no).
names_member([A|As], B, R?) :- ground(A?), ground(As?), ground(B?) |
    name # name_eq(A?, B?, Y),
    names_member1(Y?, As?, B?, R).

procedure names_member1(Ans?, Names?, Name?, Ans).
names_member1(yes, _, _, yes).
names_member1(no, As, B, R?) :- ground(As?), ground(B?) | names_member(As?, B?, R).

procedure names_add(Name?, Names?, Names).
names_add(N, Ns, R?) :- ground(N?), ground(Ns?) |
    names_member(Ns?, N?, Y),
    names_add1(Y?, N?, Ns?, R).

procedure names_add1(Ans?, Name?, Names?, Names).
names_add1(yes, _, Ns, Ns?).
names_add1(no, N, Ns, R?) :- ground(N?), ground(Ns?) | names_app(Ns?, [N?], R).

procedure names_addall(Names?, Names?, Names).
names_addall([], T, T?).
names_addall([N|Ns], T, R?) :- ground(N?), ground(Ns?), ground(T?) |
    names_addall(Ns?, T?, R1),
    names_add(N?, R1?, R).

procedure name_if(Ans?, Name?, Names).
name_if(yes, N, [N?]).
name_if(no, _, []).

procedure arec_target(Arec?, Name?, Names).
arec_target(arec(join(F, G), _), V, R?) :- ground(F?), ground(G?), ground(V?) |
    name # name_eq(F?, V?, A),
    name_if(A?, G?, R).
arec_target(arec(leave(F, G), _), V, R?) :- ground(F?), ground(G?), ground(V?) |
    name # name_eq(F?, V?, A),
    name_if(A?, G?, R).
arec_target(arec(federate(U), Ms), V, R?) :- ground(U?), ground(Ms?), ground(V?) |
    fed_parent(U?, Ms?, P),
    arec_target1(P?, U?, V?, R).

procedure arec_target1(Name?, Name?, Name?, Names).
arec_target1(P, U, V, R?) :- ground(P?), ground(U?), ground(V?) |
    name # name_eq(P?, V?, A),
    name_if(A?, U?, R).

procedure arec_source(Arec?, Name?, Names).
arec_source(arec(join(F, G), _), V, R?) :- ground(F?), ground(G?), ground(V?) |
    name # name_eq(G?, V?, A),
    name_if(A?, F?, R).
arec_source(arec(leave(F, G), _), V, R?) :- ground(F?), ground(G?), ground(V?) |
    name # name_eq(G?, V?, A),
    name_if(A?, F?, R).
arec_source(arec(federate(U), Ms), V, R?) :- ground(U?), ground(Ms?), ground(V?) |
    name # name_eq(U?, V?, A),
    arec_source1(A?, U?, Ms?, R).

procedure arec_source1(Ans?, Name?, Motions?, Names).
arec_source1(no, _, _, []).
arec_source1(yes, U, Ms, [P?]) :- ground(U?), ground(Ms?) | fed_parent(U?, Ms?, P).

procedure targets(Arecs?, Name?, Names).
targets([], _, []).
targets([A|As], V, R?) :- ground(A?), ground(As?), ground(V?) |
    arec_target(A?, V?, T),
    targets(As?, V?, R1),
    names_addall(T?, R1?, R).

procedure sources(Arecs?, Name?, Names).
sources([], _, []).
sources([A|As], V, R?) :- ground(A?), ground(As?), ground(V?) |
    arec_source(A?, V?, T),
    sources(As?, V?, R1),
    names_addall(T?, R1?, R).

exported procedure children(Arecs?, Name?, Names).
children(As, V, R?) :- ground(As?), ground(V?) |
    targets(As?, V?, Ts),
    keep_children(Ts?, As?, V?, R).

procedure keep_children(Names?, Arecs?, Name?, Names).
keep_children([], _, _, []).
keep_children([U|Us], As, V, R?) :-
    ground(U?), ground(Us?), ground(As?), ground(V?) |
    heads(As?, V?, U?, H),
    edge_from_heads(H?, Y),
    keep_children1(Y?, U?, Us?, As?, V?, R).

procedure keep_children1(Ans?, Name?, Names?, Arecs?, Name?, Names).
keep_children1(yes, U, Us, As, V, [U?|R?]) :- ground(Us?), ground(As?), ground(V?) |
    keep_children(Us?, As?, V?, R).
keep_children1(no, _, Us, As, V, R?) :- ground(Us?), ground(As?), ground(V?) |
    keep_children(Us?, As?, V?, R).

exported procedure parents(Arecs?, Name?, Names).
parents(As, V, R?) :- ground(As?), ground(V?) |
    sources(As?, V?, Fs),
    keep_parents(Fs?, As?, V?, R).

procedure keep_parents(Names?, Arecs?, Name?, Names).
keep_parents([], _, _, []).
keep_parents([F|Fs], As, V, R?) :-
    ground(F?), ground(Fs?), ground(As?), ground(V?) |
    heads(As?, F?, V?, H),
    edge_from_heads(H?, Y),
    keep_parents1(Y?, F?, Fs?, As?, V?, R).

procedure keep_parents1(Ans?, Name?, Names?, Arecs?, Name?, Names).
keep_parents1(yes, F, Fs, As, V, [F?|R?]) :- ground(Fs?), ground(As?), ground(V?) |
    keep_parents(Fs?, As?, V?, R).
keep_parents1(no, _, Fs, As, V, R?) :- ground(Fs?), ground(As?), ground(V?) |
    keep_parents(Fs?, As?, V?, R).

% ---------------------------------------------------------------------------
% Members (Definition "State of a Row"(2))
% ---------------------------------------------------------------------------

procedure rep_max(Rep?, Integer?, Agents?, Rep).
rep_max(norep, K, Y, rep(K?, Y?)).
rep_max(rep(K1, Y1), K, _, rep(K1?, Y1?)) :- K1? >= K? | true.
rep_max(rep(K1, _), K, Y, rep(K?, Y?)) :- K1? < K?, ground(Y?) | true.

procedure best_report(Row?, Name?, Rep).
best_report([], _, norep).
best_report([report(U1, Y, K)|Rs], U, R?) :-
    ground(U1?), ground(Y?), integer(K?), ground(Rs?), ground(U?) |
    name # name_eq(U1?, U?, A),
    best_report1(A?, Y?, K?, Rs?, U?, R).
best_report([_|Rs], U, R?) :- otherwise, ground(Rs?), ground(U?) |
    best_report(Rs?, U?, R).

procedure best_report1(Ans?, Agents?, Integer?, Row?, Name?, Rep).
best_report1(no, _, _, Rs, U, R?) :- ground(Rs?), ground(U?) |
    best_report(Rs?, U?, R).
best_report1(yes, Y, K, Rs, U, R?) :-
    ground(Y?), integer(K?), ground(Rs?), ground(U?) |
    best_report(Rs?, U?, R1),
    rep_max(R1?, K?, Y?, R).

procedure members_add(Rep?, Agents?, Agents).
members_add(norep, T, T?).
members_add(rep(_, Y), T, R?) :- ground(Y?), ground(T?) | agents_union(Y?, T?, R).

procedure members_of(Names?, Row?, Agents).
members_of([], _, []).
members_of([U|Us], Row, R?) :- ground(U?), ground(Us?), ground(Row?) |
    best_report(Row?, U?, Rp),
    members_of(Us?, Row?, R1),
    members_add(Rp?, R1?, R).

% The members a row records for one of its children: the latest report of that
% child, and none where it has made none.
procedure rep_agents(Rep?, Agents).
rep_agents(norep, []).
rep_agents(rep(_, Y), Y?).

exported procedure child_report(Row?, Name?, Rep).
child_report(Row, U, R?) :- ground(Row?), ground(U?) | best_report(Row?, U?, R).

exported procedure child_members(Row?, Name?, Agents).
child_members(Row, U, R?) :- ground(Row?), ground(U?) |
    best_report(Row?, U?, Rp),
    rep_agents(Rp?, R).

exported procedure members(Row?, Name?, Names?, Agents).
members(Row, V, Ch, R?) :- ground(Row?), ground(V?), ground(Ch?) |
    name # name_is_agent(V?, A),
    members1(A?, Row?, V?, Ch?, R).

procedure members1(Ans?, Row?, Name?, Names?, Agents).
members1(yes, _, V, _, [P?]) :- ground(V?) | name # name_agent(V?, P).
members1(no, Row, _, Ch, R?) :- ground(Row?), ground(Ch?) |
    members_of(Ch?, Row?, R).

% ---------------------------------------------------------------------------
% The assembly (Definition "State of a Row"(4))
% ---------------------------------------------------------------------------

procedure seat_recs(Row?, SeatRecs).
seat_recs([], []).
seat_recs([seat(S, Q, Y, D, K)|Rs], [sr(S?, Q?, Y?, D?, K?)|R?]) :-
    ground(S?), ground(Q?), ground(Y?), integer(D?), integer(K?), ground(Rs?) |
    seat_recs(Rs?, R).
seat_recs([_|Rs], R?) :- otherwise, ground(Rs?) | seat_recs(Rs?, R).

procedure sr_lt1(Integer?, Integer?, Constant?, Constant?, Ans).
sr_lt1(K1, K2, _, _, yes) :- K1? < K2? | true.
sr_lt1(K1, K2, _, _, no) :- K1? > K2? | true.
sr_lt1(K1, K2, Q1, Q2, yes) :- K1? =:= K2?, Q1? @< Q2? | true.
sr_lt1(K1, K2, Q1, Q2, no) :- K1? =:= K2?, Q2? @< Q1? | true.
sr_lt1(K1, K2, Q1, Q2, no) :- K1? =:= K2?, Q1? =?= Q2? | true.

procedure sr_lt(SeatRec?, SeatRec?, Ans).
sr_lt(sr(_, Q1, _, _, K1), sr(_, Q2, _, _, K2), R?) :-
    integer(K1?), integer(K2?), ground(Q1?), ground(Q2?) |
    sr_lt1(K1?, K2?, Q1?, Q2?, R).

procedure sr_insert1(Ans?, SeatRec?, SeatRec?, SeatRecs?, SeatRecs).
sr_insert1(yes, X, Y, Ys, [X?, Y?|Ys?]).
sr_insert1(no, X, Y, Ys, [Y?|R?]) :- ground(X?), ground(Ys?) | sr_insert(X?, Ys?, R).

procedure sr_insert(SeatRec?, SeatRecs?, SeatRecs).
sr_insert(X, [], [X?]).
sr_insert(X, [Y|Ys], R?) :- ground(X?), ground(Y?), ground(Ys?) |
    sr_lt(X?, Y?, A),
    sr_insert1(A?, X?, Y?, Ys?, R).

procedure sr_sort(SeatRecs?, SeatRecs).
sr_sort([], []).
sr_sort([X|Xs], R?) :- ground(X?), ground(Xs?) |
    sr_sort(Xs?, S),
    sr_insert(X?, S?, R).

procedure seat_held(Seats?, Constant?, Ans).
seat_held([], _, no).
seat_held([st(Q1, _, _)|_], Q, yes) :- Q1? =?= Q? | true.
seat_held([_|Ss], Q, R?) :- otherwise, ground(Ss?), ground(Q?) |
    seat_held(Ss?, Q?, R).

procedure seat_remove(Seats?, Constant?, Colour?, Integer?, Seats).
seat_remove([], _, _, _, []).
seat_remove([st(Q1, Y1, D1)|Ss], Q, Y, D, Ss?) :-
    Q1? =?= Q?, Y1? =?= Y?, D1? =:= D? | true.
seat_remove([S|Ss], Q, Y, D, [S?|R?]) :-
    otherwise, ground(Ss?), ground(Q?), ground(Y?), integer(D?) |
    seat_remove(Ss?, Q?, Y?, D?, R).

procedure seat_fold_add(Ans?, Constant?, Colour?, Integer?, SeatRecs?, Seats?, Seats).
seat_fold_add(yes, _, _, _, Xs, A, R?) :- ground(Xs?), ground(A?) |
    seat_fold(Xs?, A?, R).
seat_fold_add(no, Q, Y, D, Xs, A, R?) :-
    ground(Q?), ground(Y?), integer(D?), ground(Xs?), ground(A?) |
    seats_app(A?, [st(Q?, Y?, D?)], A1),
    seat_fold(Xs?, A1?, R).

% A + seats q where q holds no seat; a - removes the seat (q,y,s) where it is
% present.
procedure seat_fold(SeatRecs?, Seats?, Seats).
seat_fold([], A, A?).
seat_fold([sr(plus, Q, Y, D, _)|Xs], A, R?) :-
    ground(Q?), ground(Y?), integer(D?), ground(Xs?), ground(A?) |
    seat_held(A?, Q?, H),
    seat_fold_add(H?, Q?, Y?, D?, Xs?, A?, R).
seat_fold([sr(minus, Q, Y, D, _)|Xs], A, R?) :-
    ground(Q?), ground(Y?), integer(D?), ground(Xs?), ground(A?) |
    seat_remove(A?, Q?, Y?, D?, A1),
    seat_fold(Xs?, A1?, R).

exported procedure assembly(Row?, Name?, Seats).
assembly(Row, V, R?) :- ground(Row?), ground(V?) |
    name # name_is_agent(V?, A),
    assembly1(A?, Row?, V?, R).

procedure assembly1(Ans?, Row?, Name?, Seats).
assembly1(yes, _, V, [st(P?, uncoloured, 0)]) :- ground(V?) |
    name # name_agent(V?, P).
assembly1(no, Row, _, R?) :- ground(Row?) |
    seat_recs(Row?, Ss),
    assembly2(Ss?, R).

procedure assembly2(SeatRecs?, Seats).
assembly2(Ss, R?) :- ground(Ss?) |
    sr_sort(Ss?, Sorted),
    seat_fold(Sorted?, [], R).

% ---------------------------------------------------------------------------
% The date and the accounts (Definition "State of a Row"(5))
% ---------------------------------------------------------------------------

procedure raise_recs(Row?, RaiseRecs).
raise_recs([], []).
raise_recs([raise(T0, T1, S, E)|Rs], [rr(T0?, T1?, S?, E?)|R?]) :-
    integer(T0?), integer(T1?), ground(S?), ground(E?), ground(Rs?) |
    raise_recs(Rs?, R).
raise_recs([_|Rs], R?) :- otherwise, ground(Rs?) | raise_recs(Rs?, R).

procedure rr_lt1(Integer?, Integer?, Integer?, Integer?, Ans).
rr_lt1(A0, _, B0, _, yes) :- A0? < B0? | true.
rr_lt1(A0, _, B0, _, no) :- A0? > B0? | true.
rr_lt1(A0, A1, B0, B1, yes) :- A0? =:= B0?, A1? < B1? | true.
rr_lt1(A0, A1, B0, B1, no) :- A0? =:= B0?, A1? >= B1? | true.

procedure rr_lt(RaiseRec?, RaiseRec?, Ans).
rr_lt(rr(A0, A1, _, _), rr(B0, B1, _, _), R?) :-
    integer(A0?), integer(A1?), integer(B0?), integer(B1?) |
    rr_lt1(A0?, A1?, B0?, B1?, R).

procedure rr_insert1(Ans?, RaiseRec?, RaiseRec?, RaiseRecs?, RaiseRecs).
rr_insert1(yes, X, Y, Ys, [X?, Y?|Ys?]).
rr_insert1(no, X, Y, Ys, [Y?|R?]) :- ground(X?), ground(Ys?) | rr_insert(X?, Ys?, R).

procedure rr_insert(RaiseRec?, RaiseRecs?, RaiseRecs).
rr_insert(X, [], [X?]).
rr_insert(X, [Y|Ys], R?) :- ground(X?), ground(Y?), ground(Ys?) |
    rr_lt(X?, Y?, A),
    rr_insert1(A?, X?, Y?, Ys?, R).

procedure rr_sort(RaiseRecs?, RaiseRecs).
rr_sort([], []).
rr_sort([X|Xs], R?) :- ground(X?), ground(Xs?) |
    rr_sort(Xs?, S),
    rr_insert(X?, S?, R).

procedure acct_add_s(Accts?, Node?, Integer?, Accts).
acct_add_s([], X, N, [acct(X?, N?, rat(0, 1))]).
acct_add_s([acct(X1, S, H)|As], X, N, [acct(X1?, S1?, H?)|As?]) :-
    X1? =?= X?, integer(S?), integer(N?) |
    S1 := S? + N?.
acct_add_s([A|As], X, N, [A?|R?]) :-
    otherwise, ground(As?), ground(X?), integer(N?) |
    acct_add_s(As?, X?, N?, R).

procedure acct_add_h(Accts?, Node?, Rat?, Accts).
acct_add_h([], X, Q, [acct(X?, 0, Q?)]).
acct_add_h([acct(X1, S, H)|As], X, Q, [acct(X1?, S?, H1?)|As?]) :-
    X1? =?= X?, ground(H?), ground(Q?) |
    rat # rat_add(H?, Q?, H1).
acct_add_h([A|As], X, Q, [A?|R?]) :-
    otherwise, ground(As?), ground(X?), ground(Q?) |
    acct_add_h(As?, X?, Q?, R).

procedure accrue_sig(Sigma?, Accts?, Accts).
accrue_sig([], A, A?).
accrue_sig([sig(X, N)|Xs], A, R?) :-
    ground(X?), integer(N?), ground(Xs?), ground(A?) |
    acct_add_s(A?, X?, N?, A1),
    accrue_sig(Xs?, A1?, R).

procedure accrue_eta(Eta?, Accts?, Accts).
accrue_eta([], A, A?).
accrue_eta([et(X, Q)|Xs], A, R?) :-
    ground(X?), ground(Q?), ground(Xs?), ground(A?) |
    acct_add_h(A?, X?, Q?, A1),
    accrue_eta(Xs?, A1?, R).

% Only a raise whose first date is the date reached so far is taken.
procedure rr_fold(RaiseRecs?, Integer?, Accts?, DA).
rr_fold([], D, A, da(D?, A?)).
rr_fold([rr(T0, T1, S, E)|Xs], D, A, R?) :-
    T0? =:= D?, integer(T1?), ground(S?), ground(E?), ground(Xs?), ground(A?) |
    accrue_sig(S?, A?, A1),
    accrue_eta(E?, A1?, A2),
    rr_fold(Xs?, T1?, A2?, R).
rr_fold([rr(T0, _, _, _)|Xs], D, A, R?) :-
    T0? =\= D?, ground(Xs?), ground(A?) |
    rr_fold(Xs?, D?, A?, R).

exported procedure date_accounts(Row?, DA).
date_accounts(Row, R?) :- ground(Row?) |
    raise_recs(Row?, Rs),
    date_accounts1(Rs?, R).

procedure date_accounts1(RaiseRecs?, DA).
date_accounts1(Rs, R?) :- ground(Rs?) |
    rr_sort(Rs?, S),
    rr_fold(S?, 0, [], R).

procedure da_parts(DA?, Integer, Accts).
da_parts(da(D, A), D?, A?).

% ---------------------------------------------------------------------------
% The open motions (Definition "State of a Row"(6))
% ---------------------------------------------------------------------------
% The locus of a Join or a Leave is its pair, that of a Federate the Federate
% itself; a motion of epoch k is open while no act record of the row on that
% locus has epoch at least k.

procedure arec_touches(Arec?, Act?, Ans).
arec_touches(A, join(F, G), R?) :- ground(A?), ground(F?), ground(G?) |
    arec_on_pair(A?, F?, G?, R).
arec_touches(A, leave(F, G), R?) :- ground(A?), ground(F?), ground(G?) |
    arec_on_pair(A?, F?, G?, R).
arec_touches(arec(federate(U1), _), federate(U), R?) :- ground(U1?), ground(U?) |
    name # name_eq(U1?, U?, R).
arec_touches(arec(join(_, _), _), federate(_), no).
arec_touches(arec(leave(_, _), _), federate(_), no).

procedure any_touch_ge1(Ans?, Integer?, Integer?, Arecs?, Act?, Ans).
any_touch_ge1(yes, E, K, _, _, yes) :- E? >= K? | true.
any_touch_ge1(yes, E, K, As, Ac, R?) :- E? < K?, ground(As?), ground(Ac?) |
    any_touch_ge(As?, Ac?, K?, R).
any_touch_ge1(no, _, K, As, Ac, R?) :- integer(K?), ground(As?), ground(Ac?) |
    any_touch_ge(As?, Ac?, K?, R).

procedure any_touch_ge(Arecs?, Act?, Integer?, Ans).
any_touch_ge([], _, _, no).
any_touch_ge([A|As], Ac, K, R?) :-
    ground(A?), ground(As?), ground(Ac?), integer(K?) |
    arec_touches(A?, Ac?, T),
    arec_epoch(A?, E),
    any_touch_ge1(T?, E?, K?, As?, Ac?, R).

procedure motion_open1(Act?, Integer?, Arecs?, Ans).
motion_open1(Ac, K, As, R?) :- ground(Ac?), integer(K?), ground(As?) |
    any_touch_ge(As?, Ac?, K?, T),
    not_ans(T?, R).

exported procedure motion_open(Motion?, Arecs?, Ans).
motion_open(M, As, R?) :- ground(M?), ground(As?) |
    decide # motion_act(M?, Ac),
    decide # motion_epoch(M?, K),
    motion_open1(Ac?, K?, As?, R).

procedure motion_here_open(Motion?, Name?, Arecs?, Ans).
motion_here_open(M, V, As, R?) :- ground(M?), ground(V?), ground(As?) |
    decide # motion_community(M?, U),
    motion_here_open1(U?, V?, M?, As?, R).

procedure motion_here_open1(Name?, Name?, Motion?, Arecs?, Ans).
motion_here_open1(U, V, M, As, R?) :-
    ground(U?), ground(V?), ground(M?), ground(As?) |
    name # name_eq(U?, V?, A1),
    motion_open(M?, As?, A2),
    and_ans(A1?, A2?, R).

procedure open_motions2(Ans?, Motion?, Motions?, Name?, Arecs?, Motions).
open_motions2(yes, M, Ms, V, As, [M?|R?]) :- ground(Ms?), ground(V?), ground(As?) |
    open_motions1(Ms?, V?, As?, R).
open_motions2(no, _, Ms, V, As, R?) :- ground(Ms?), ground(V?), ground(As?) |
    open_motions1(Ms?, V?, As?, R).

procedure open_motions1(Motions?, Name?, Arecs?, Motions).
open_motions1([], _, _, []).
open_motions1([M|Ms], V, As, R?) :-
    ground(M?), ground(Ms?), ground(V?), ground(As?) |
    motion_here_open(M?, V?, As?, Y),
    open_motions2(Y?, M?, Ms?, V?, As?, R).

exported procedure open_motions(Row?, Name?, Arecs?, Motions).
open_motions(Row, V, As, R?) :- ground(Row?), ground(V?), ground(As?) |
    decide # row_motions(Row?, Ms),
    open_motions1(Ms?, V?, As?, R).

% ---------------------------------------------------------------------------
% The dates of the agents (Definition "State of a Row"(3))
% ---------------------------------------------------------------------------

exported procedure agent_date(Row?, Constant?, Integer).
agent_date([], _, 0).
agent_date([date(Q1, T)|Rs], Q, R?) :-
    Q1? =?= Q?, integer(T?), ground(Rs?), ground(Q?) |
    agent_date(Rs?, Q?, R1),
    imax(T?, R1?, R).
agent_date([_|Rs], Q, R?) :- otherwise, ground(Rs?), ground(Q?) |
    agent_date(Rs?, Q?, R).

procedure row_agents(Row?, Agents).
row_agents([], []).
row_agents([date(Q, _)|Rs], R?) :- ground(Q?), ground(Rs?) |
    row_agents(Rs?, R1),
    agents_add(Q?, R1?, R).
row_agents([_|Rs], R?) :- otherwise, ground(Rs?) | row_agents(Rs?, R).

procedure agent_dates1(Agents?, Row?, Adates).
agent_dates1([], _, []).
agent_dates1([Q|Qs], Row, [adate(Q?, T?)|R?]) :-
    ground(Q?), ground(Qs?), ground(Row?) |
    agent_date(Row?, Q?, T),
    agent_dates1(Qs?, Row?, R).

exported procedure agent_dates(Row?, Adates).
agent_dates(Row, R?) :- ground(Row?) |
    row_agents(Row?, Qs),
    agent_dates1(Qs?, Row?, R).

% ---------------------------------------------------------------------------
% The state of a row
% ---------------------------------------------------------------------------

procedure row_state_on1(Row?, Name?, Arecs?, Names?, State).
row_state_on1(Row, V, As, Ch, state(Ch?, Pa?, Mem?, Asm?, D?, Ac?, Mo?)) :-
    ground(Row?), ground(V?), ground(As?), ground(Ch?) |
    parents(As?, V?, Pa),
    members(Row?, V?, Ch?, Mem),
    assembly(Row?, V?, Asm),
    date_accounts(Row?, DA),
    da_parts(DA?, D, Ac),
    open_motions(Row?, V?, As?, Mo).

exported procedure row_state_on(Row?, Name?, Arecs?, State).
row_state_on(Row, V, As, S?) :- ground(Row?), ground(V?), ground(As?) |
    children(As?, V?, Ch),
    row_state_on1(Row?, V?, As?, Ch?, S).

% Definition "State of a Row, Implied": the decided acts in place of the act
% records.
exported procedure row_state(Rat?, Row?, Name?, State).
row_state(T, Row, V, S?) :- ground(T?), ground(Row?), ground(V?) |
    decide # decided_acts(T?, Row?, As),
    row_state_on(Row?, V?, As?, S).

% Definition "State of a Row" as it stands.
exported procedure row_state_explicit(Row?, Name?, State).
row_state_explicit(Row, V, S?) :- ground(Row?), ground(V?) |
    decide # explicit_acts(Row?, As),
    row_state_on(Row?, V?, As?, S).
