% ---------------------------------------------------------------------------
% Community names and their order (Definition "Community Name", and the order
% fixed with it in Section "Grassroots Federation": a total order on agents
% and on decision identities, by which names, read as sequences alternating
% agents and identities, are compared lexicographically).  The order this
% implementation fixes on agents and on identities alike is the standard order
% of terms, @<.
% ---------------------------------------------------------------------------

exported procedure name_is_agent(Name?, Ans).
name_is_agent(name(_, []), yes).
name_is_agent(name(_, [_|_]), no).

exported procedure name_agent(Name?, Constant).
name_agent(name(P, _), P?).

exported procedure name_eq(Name?, Name?, Ans).
name_eq(A, B, yes) :- A? =?= B? | true.
name_eq(_, _, no) :- otherwise | true.

% Lexicographic on two lists of identities: a proper prefix is the lesser.
procedure ids_gt(Ids?, Ids?, Ans).
ids_gt([], _, no).
ids_gt([_|_], [], yes).
ids_gt([I|_], [J|_], yes) :- J? @< I? | true.
ids_gt([I|_], [J|_], no) :- I? @< J? | true.
ids_gt([I|Is], [J|Js], R?) :- I? =?= J?, ground(Is?), ground(Js?) |
    ids_gt(Is?, Js?, R).

procedure name_gt1(Constant?, Constant?, Ids?, Ids?, Ans).
name_gt1(P, Q, _, _, yes) :- Q? @< P? | true.
name_gt1(P, Q, _, _, no) :- P? @< Q? | true.
name_gt1(P, Q, Is, Js, R?) :- P? =?= Q?, ground(Is?), ground(Js?) |
    ids_gt(Is?, Js?, R).

% f > g: the agents decide it, and at one agent the identities, lexicographically.
exported procedure name_gt(Name?, Name?, Ans).
name_gt(name(P, Is), name(Q, Js), R?) :-
    ground(P?), ground(Q?), ground(Is?), ground(Js?) |
    name_gt1(P?, Q?, Is?, Js?, R).

% The name v.y: v with the identity y appended.
exported procedure name_extend(Name?, Constant?, Name).
name_extend(name(P, Is), Y, name(P?, Js?)) :- ground(Is?), ground(Y?) |
    ids_app(Is?, [Y?], Js).
