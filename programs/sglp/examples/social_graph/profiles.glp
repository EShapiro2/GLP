%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(social_graph, profiles)

%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).

%% person(homophile)
%% binds(Menu, homophile_menu)
exported procedure homophile_menu(Menu?, Person?, Integer?, MutualRef?).
homophile_menu(M, _, S, _)
:-
random(S?, 100, K, S1)
,
rated(0.0000016534391534391535, Tok)
,
homophile_pick(Tok?, K?, S1?, M?)
.
procedure homophile_pick(Token?, Integer?, Integer?, Menu?).
homophile_pick(stop, _, _, _)
.
homophile_pick(go(_), K, S, menu(Ss, _, same(P?)))
:-
'=<'(K?, 98)
,
ground(Ss?)
|
one_of(Ss?, S?, P)
.
homophile_pick(go(_), K, S, menu(_, Os, other(P?)))
:-
'>'(K?, 98)
,
ground(Os?)
|
one_of(Os?, S?, P)
.

