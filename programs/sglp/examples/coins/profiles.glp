%% transform(coins, profiles)

%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).
procedure request(Token?, Integer?, Menu?).
request(stop, _, _)
.
request(go(_), S, menu(Fs, [], swap(F?, 10)))
:-
ground(Fs?)
|
one_of(Fs?, S?, F)
.
request(go(_), S, menu(_, [H | Hs], pay(F?, K?)))
:-
ground(H?)
,
ground(Hs?)
|
random(S?, 5, K, S1)
,
one_of([H? | Hs?], S1?, Hd)
,
issuer(Hd?, F)
.
procedure issuer(Holding?, Peer).
issuer(holding(F, _), F?)
.

%% person(spender)
%% binds(Menu, spender_menu)
exported procedure spender_menu(Menu?, Person?, Integer?, MutualRef?).
spender_menu(M, _, S, _)
:-
rated(0.000011574074074074073, Tok)
,
request(Tok?, S?, M?)
.

