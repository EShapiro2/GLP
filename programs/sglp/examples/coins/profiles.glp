.

%% person(cautious)
%% binds(Offer, cautious_offer)
exported procedure cautious_offer(Offer?, Person?, Integer?, MutualRef?).
cautious_offer(O, _, _, _)
:-
rated(0.0002777777777777778, Tok)
,
weigh(Tok?, O?)
.
procedure weigh(Token?, Offer?).
weigh(stop, _)
.
weigh(go(_), offer(_, _, Held, yes))
:-
'=<'(Held?, 20)
|
true
.
weigh(go(_), offer(_, _, Held, no))
:-
'>'(Held?, 20)
|
true
.

