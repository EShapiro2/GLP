%% programs/sglp: sGLP in GLP, as the stochastic pi-calculus was in FCP (sGLP's
%% paper, the repository svGLP-Stochastic-Volitional-GLP at d2f64b6, Section 4).
%%
%%   monitor.glp    the monitor, over the guard when_idle;
%%   construct.glp  the construct process of a compiled program in a
%%                  simulation;
%%   transform.glp  the transformation, from an example's sGLP source in the
%%                  term form (README.md) to its profiles.glp and
%%                  population.glp, which transform.sh writes;
%%   social_graph/  the Grassroots Social Graph: its sGLP source, its compiled
%%                  program, the printed profiles and population, its harness
%%                  and its run script;
%%   coins/         coins among friends, the same;
%%   tests/         the tests of the suite's sGLP block (test_sglp.sh).
%%
%% Both modules are exposed to the subtree: the compiled programs call
%% construct/3, and the harnesses spawn the monitor.
%% A run of the social graph is a call of social_graph/4, or of social_graph/6
%% for another mix, with this directory loaded (social_graph/run.sh); a run of
%% coins among friends is a call of coins/7 (coins/run.sh).
-expose(monitor).
-expose(construct).

%% The term form of an sGLP program (README.md, "The term form"): a list of
%% terms, one per declaration and clause, in GLP-Spec's term syntax; its
%% elements are terms of any form, the source's heads and goals among them, so
%% they are typed _, as a meta-interpreter's are (docs/typed-glp-manual.md,
%% 18.3).
SglpTerms ::= [] ; [_ | SglpTerms].

%% transform(Program?, Part?): print Part, profiles or population, of the
%% transformation of Program, social_graph or coins, from its sGLP source
%% (transform.glp; transform.sh writes the printed modules).
imported procedure transform#transform(Constant?, Constant?).
exported procedure transform(Constant?, Constant?).
transform(P, Part) :- transform # transform(P?, Part?).

%% transform_terms(V?, S?, Part?): the same for an sGLP source given as its
%% terms, V the vGLP program's interface and S the sGLP program.
imported procedure transform#transform_terms(SglpTerms?, SglpTerms?, Constant?).
exported procedure transform_terms(SglpTerms?, SglpTerms?, Constant?).
transform_terms(V, S, Part) :- transform # transform_terms(V?, S?, Part?).

%% The horizon of a run declaration, `until <number> <unit>`: the unit singular
%% or plural (Appendix B).
Span ::= TimeUnit ; seconds ; minutes ; hours ; days ; weeks ; years.

%% span(U?, S): S is the number of seconds in one U, a year being 365.25 days.
procedure span(Span?, Integer).
span(second, 1).
span(seconds, 1).
span(minute, 60).
span(minutes, 60).
span(hour, 3600).
span(hours, 3600).
span(day, 86400).
span(days, 86400).
span(week, 604800).
span(weeks, 604800).
span(year, 31557600).
span(years, 31557600).

%% one_of, length and nth, ordinary GLP, shared by the examples' profiles (the
%% social graph's, moved here from social_graph/graph.glp for coins among
%% friends, sGLP's code task of 2026-10-02 15:24 UTC, item 2): nth's clause for
%% the end of the list in the form that checks, nth(_, [], _?) (TGLP,
%% "Anonymous variables": an output the clause never produces).

%% one_of(Xs?, S?, X): X is drawn uniformly from Xs by random from the seed S.
procedure(X) one_of(Stream(X)?, Integer?, X).
one_of(Xs, S, X?) :- ground(Xs?) |
    length(Xs?, N), random(S?, N?, K, _), nth(K?, Xs?, X).

%% length(Xs?, N): N is the number of elements of Xs, counted by length/3 in
%% an accumulator, tail-recursively, so that a list of n elements leaves no n
%% additions suspended at once, each waiting on the count of the rest, as the
%% count it replaces did (sGLP's code task of 2026-10-02 20:58 UTC, S2).
procedure(X) length(Stream(X)?, Integer).
length(Xs, N?) :- length(Xs?, 0, N).

%% length(Xs?, A?, N): N is A plus the number of elements of Xs.
procedure(X) length(Stream(X)?, Integer?, Integer).
length([], A, A?).
length([_|Xs], A, N?) :- A1 := A? + 1, length(Xs?, A1?, N).

%% nth(K?, Xs?, X): X is the K-th element of Xs, counting from 1.  Past the
%% end of Xs nothing is assigned to X.
procedure(X) nth(Integer?, Stream(X)?, X).
nth(1, [X|_], X?).
nth(K, [_|Xs], X?) :- K? > 1 | K1 := K? - 1, nth(K1?, Xs?, X).
nth(_, [], _?).

%% social_graph(Agents?, Count?, Unit?, Seed?): the social graph's run with
%% Agents agents until Count Units from seed Seed, with the run declaration's
%% mix, homophile 0.6 and wary 0.7, its thresholds read from the declaration
%% the population prints (social_graph/population.glp, declaration/6).
%% social_graph(Agents?, Count?, Unit?, Seed?, Hom?, Wary?): the same run with
%% the mix given by Hom and Wary, integers 0..100: an agent is homophile for its
%% first draw K =< Hom and wary for its second K =< Wary, K of 1..100, so 0 is
%% none and 100 is all (sGLP's code task of 2026-10-02 15:23 UTC, item 1).
imported procedure social_graph#run(Integer?, Number?, Span?, Integer?,
                                    Integer?, Integer?).
imported procedure social_graph#declaration(Integer, Number, Span, Integer,
                                            Integer, Integer).
exported procedure social_graph(Integer?, Number?, Span?, Integer?).
social_graph(N, C, U, Seed) :-
    social_graph # declaration(_, _, _, _, Hom, Wary),
    social_graph # run(N?, C?, U?, Seed?, Hom?, Wary?).
exported procedure social_graph(Integer?, Number?, Span?, Integer?, Integer?,
                                Integer?).
social_graph(N, C, U, Seed, Hom, Wary) :-
    social_graph # run(N?, C?, U?, Seed?, Hom?, Wary?).

%% The population's draw: how many agents of each profile in each dimension,
%% and each agent's profiles, agents 1..N in order.  Approach and Response are
%% the profiles of the social graph's two dimensions, and Spending and Credit
%% those of coins among friends', as the draws report them: the types the
%% population prints for the dimensions, Dimension1 and Dimension2 in each
%% example's population.glp, structurally, and named here, where the reports'
%% types are declared.
Approach ::= homophile ; indifferent.
Response ::= wary ; sociable.
Spending ::= spender ; saver.
Credit   ::= cautious ; generous.

Draw    ::= draw(Integer, Integer, Integer, Integer, Drawn).
Drawn   ::= [] ; [AgentIs | Drawn].
AgentIs ::= agent(Integer, Approach, Response).

%% social_graph_draw(Agents?, Seed?, Hom?, Wary?, D): D is draw(Homophile,
%% Indifferent, Wary, Sociable, As), the numbers of agents of each profile in
%% the run of social_graph/6 with those arguments, and As the list of
%% agent(A, Approach, Response), each agent's profiles, A of 1..Agents in
%% order, computed without running it, the counts those of As
%% (social_graph/harness.glp; sGLP's code tasks of 2026-10-02 15:44 UTC and
%% 2026-10-03 08:58 UTC).
imported procedure social_graph#draw(Integer?, Integer?, Integer?, Integer?,
                                     Draw).
exported procedure social_graph_draw(Integer?, Integer?, Integer?, Integer?,
                                     Draw).
social_graph_draw(N, Seed, Hom, Wary, D?) :-
    social_graph # draw(N?, Seed?, Hom?, Wary?, D).

%% coins(Agents?, Friends?, Count?, Unit?, Seed?, Spend?, Cred?): coins among
%% friends with Agents agents until Count Units from seed Seed (coins/harness.glp;
%% sGLP's code task of 2026-10-02 15:24 UTC, item 3): agent a's friends are the
%% a-th list of Friends, in increasing order; an agent is a spender for its
%% first draw K =< Spend and cautious for its second K =< Cred, K of 1..100, so
%% the run declaration's mix is 50 and 50.
%% Peer and Peers are the children's, social_graph/self.glp's and
%% coins/self.glp's, structurally, defined here so that coins/7's declaration
%% names a type in its scope, a module seeing its ancestors' types and not its
%% children's (TGLP, "Declaration parameters" and Definition "Root, Scope";
%% sGLP's code task of 2026-10-03 21:09 UTC).
Peer  ::= Constant.
Peers ::= [] ; [Peer | Peers].

imported procedure coins#run(Integer?, Stream(Peers)?, Number?, Span?, Integer?,
                             Integer?, Integer?).
exported procedure coins(Integer?, Stream(Peers)?, Number?, Span?, Integer?,
                         Integer?, Integer?).
coins(N, Fss, C, U, Seed, Spend, Cred) :-
    coins # run(N?, Fss?, C?, U?, Seed?, Spend?, Cred?).

%% The population's draw of coins among friends: how many agents of each
%% profile in each dimension, and each agent's profiles, agents 1..N in order.
CoinsDraw    ::= draw(Integer, Integer, Integer, Integer, CoinsDrawn).
CoinsDrawn   ::= [] ; [CoinsAgentIs | CoinsDrawn].
CoinsAgentIs ::= agent(Integer, Spending, Credit).

%% coins_draw(Agents?, Seed?, Spend?, Cred?, D): D is draw(Spender, Saver,
%% Generous, Cautious, As), the numbers of agents of each profile in the run of
%% coins/7 with those arguments, whatever its friends, and As the list of
%% agent(A, Spending, Credit), each agent's profiles, A of 1..Agents in order,
%% computed without running it, the counts those of As (coins/harness.glp;
%% sGLP's code task of 2026-10-03 09:45 UTC).
imported procedure coins#draw(Integer?, Integer?, Integer?, Integer?,
                              CoinsDraw).
exported procedure coins_draw(Integer?, Integer?, Integer?, Integer?,
                              CoinsDraw).
coins_draw(N, Seed, Spend, Cred, D?) :-
    coins # draw(N?, Seed?, Spend?, Cred?, D).
