%% The sGLP source of the test of the harness of every canonical CVA platform
%% over a platform whose agent is agent/6, of an environment (Audit #4,
%% Grassroots-Audit programs/sglp/cva/harness.glp.in.md, Finding 1), in the
%% term form the transformation reads (programs/sglp/README.md, "The term
%% form"), over the canonical platform of Local Overlay, whose contract has an
%% "Environment:" line.  Its surface form:
%%
%%   Person ::= person(Key, Constant, List(Constant)).
%%   procedure pair(Integer?, List(Person)).
%%   pair(_, [person(p1, agent, [two]), person(p2, agent, [three])]).
%%   procedure environment(Person?, List(Atom)).
%%   environment(person(_, _, [N]), [bound(N?)]).
%%   environment(_, []) :- otherwise | true.
%%
%%   person establisher.
%%   Request =::= establish_request.
%%   Approval =::= agree.
%%   establish_request(R?, person(K, _, _), _) :-
%%       establish(K?, R) @ 1 per hour.
%%   establish(K, propose(establish(K?))).
%%   agree(approval(_, _, A?), _, _) :- say_yes(A) @ 1 per hour.
%%   say_yes(yes).
%%
%%   run pair [all ~ (establisher : 1.0)] until 1 day seed 1.
%%
%% The census, pair, draws two persons, keyed p1 and p2, the platform's keys;
%% environment/2 gives each its environment, bound(two) and bound(three),
%% which the platform reads once at the start and shows in its first view;
%% each person establishes their identity, about an hour into the run.

exported procedure source(SglpTerms).
source([
   type('Person', [person('Key', 'Constant', 'List'('Constant'))]),
   decl(pair(dual('Integer'), 'List'('Person'))),
   clause(pair(var('_'), [person(p1, agent, [two]), person(p2, agent, [three])]), [], []),
   decl(environment(dual('Person'), 'List'('Atom'))),
   clause(environment(person(var('_'), var('_'), [var('N')]), [bound(var('N?'))]), [], []),
   clause(environment(var('_'), []), [otherwise], []),

   person(establisher),
   binds('Request', establish_request),
   binds('Approval', agree),
   decl(establish_request('Request', dual('Person'), dual('Integer'))),
   clause(establish_request(var('R?'), person(var('K'), var('_'), var('_')), var('_')), [],
          [rated(establish(var('K?'), slot(var('R'))), rate(1, hour))]),
   decl(establish(dual('Key'), dual('Slot'('Request')))),
   clause(establish(var('K'), slot(propose(establish(var('K?'))))), [], []),
   decl(agree(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(agree(approval(var('_'), var('_'), var('A?')), var('_'), var('_')), [], [rated(say_yes(slot(var('A'))), rate(1, hour))]),
   decl(say_yes(dual('Slot'('YesNo')))),
   clause(say_yes(slot(yes)), [], []),

   run(pair, [mix(all, agent, [share(establisher, 1.0)])], 1, day, 1)]).
