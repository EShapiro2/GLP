%% The population of the test of the harness's network (platform.glp beside
%% it), structurally a printed population (programs/sglp/transform.glp,
%% cva_check/3, cva_agents/6 and cva_draw/3): a census of three persons keyed
%% p2, p1 and p3, in that order, which is not the order @< takes; each agent's
%% seat, its ask stream read to its end and the program's output to its person
%% shown on its screen, each element logged as output.

Ask ::= ask(Constant, Question).
Question ::= none.
Seat(X) ::= seat(Key, Stream(Ask)?, Stream(X)?).

exported procedure cva_check(Integer?, Stream(Key)?, Constant).
cva_check(_, _, yes).

exported procedure(X) cva_agents(Integer?, Stream(Key)?, MutualRef?, MutualRef?,
                                 Stream(Key), Stream(Seat(X))).
cva_agents(_, _, Mon, Log, [p2, p1, p3], [seat(p2, A1, O1), seat(p1, A2, O2), seat(p3, A3, O3)]) :-
    asks(A1?), asks(A2?), asks(A3?),
    screen(1, O1?, Mon?, Log?), screen(2, O2?, Mon?, Log?), screen(3, O3?, Mon?, Log?).

exported procedure cva_draw(Integer?, Stream(Key)?, Stream(_)).
cva_draw(_, _, [agent(1, stub(none)), agent(2, stub(none)), agent(3, stub(none))]).

%% asks(As?): the agent's ask stream, read to its end.
procedure asks(Stream(Ask)?).
asks([_|As]) :- asks(As?).
asks([]).

%% screen(A?, O?, Mon?, Log?): each element of the program's output O to the
%% person of agent A logged as output, at the monitor's time.
procedure(X) screen(Integer?, Stream(X)?, MutualRef?, MutualRef?).
screen(A, [E|O], Mon, Log) :- ground(E?) |
    stream_append(time(Time), Mon?, _),
    stream_append(entry(Time?, A?, output, E?), Log?, _),
    screen(A?, O?, Mon?, Log?).
screen(_, [], _, _).
