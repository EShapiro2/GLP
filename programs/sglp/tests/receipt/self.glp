%% Test (xiii) of sGLP in GLP (sGLP's task 8 of 2026-10-10 09:33 UTC; sGLP's
%% paper, Section 3, Definition "Log"; Section 4, "The person process": "Every
%% term crossing between the program and the person goal, in either direction
%% and at every depth, crosses the person process so, a question the program
%% puts inside an answer included"; Appendix B): a vGLP program whose
%% interactive type is the person's Stream(Msg)?, Msg ::= msg(String,
%% Status?), as test (xii)'s, with Status ::= sent ; read(Ack?): the program,
%% writing read into a message the person wrote, puts inside that answer a
%% question of the person's, the acknowledgement of a read receipt; a profile
%% writing three messages and acknowledging each read; and its run, the log
%% showing the acknowledgement, which crosses the person process.
%%
%%   chat.vglp          the vGLP program;
%%   chat.glp           its canonical compilation (vGLP, Definition
%%                      "Canonical Compilation"), written by hand;
%%   receipt_sglp.glp   the sGLP source in the term form
%%                      (programs/sglp/README.md), the profile talker and the
%%                      run declaration, the vGLP program's interface and its
%%                      compiled program's predicates;
%%   profiles.glp and population.glp  printed from receipt_sglp.glp by
%%                      programs/sglp/transform.sh, and not edited;
%%   harness.glp        the run, by hand: the monitor, the log's sink, the one
%%                      agent's initial goal and its person process.
%%
%%   receipt_run(Rs)    the run of the run declaration; Rs the receipts the
%%                      program output, in order

%% The vGLP program's types (chat.vglp).
Ack     ::= ack.
Status  ::= sent ; read(Ack?).
Msg     ::= msg(String, Status?).
Receipt ::= plain(String) ; acked(String, Ack).

%% The type of the asks, which the canonical compilation adds: Stream(Msg) is
%% in reader mode, so its alternative of Question is
%% stream_msg_r(Stream(Msg)?), the ask carrying the writer the person process
%% writes.
Ask      ::= ask(Constant, Question).
Question ::= stream_msg_r(Stream(Msg)?).

%% A stochastic person, one profile in the one dimension, as the harness hands
%% it from the population's draw to the person process (population.glp).
Talking  ::= talker.
Profiles ::= profiles(Talking).

imported procedure harness#run(Stream(Receipt)).
exported procedure receipt_run(Stream(Receipt)).
receipt_run(Rs?) :- harness # run(Rs).

%% The sGLP source in the term form, receipt_sglp.glp, for the transformation
%% (programs/sglp/transform.glp).
imported procedure receipt_sglp#source(SglpTerms, SglpTerms).
exported procedure source(SglpTerms, SglpTerms).
source(V?, S?) :- receipt_sglp # source(V, S).
