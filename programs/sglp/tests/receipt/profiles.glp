%% Printed by programs/sglp/transform.glp from the sGLP source in the term form
%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(receipt, profiles)

%% person(talker)
%% binds(Stream(Msg), talk)
exported procedure
talk
(
Stream(Msg)
,
Integer?
,
MutualRef?
)
.
talk(Ms?, _, Mon)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
say(Tok?, 1, Ms, Mon?)
.
procedure
say
(
Token?
,
Integer?
,
Stream(Msg)
,
MutualRef?
)
.
say(go, I, [msg(T?, St) | Ms?], Mon)
:-
'=<'(I?, 3)
|
text(I?, T)
,
next(St?, I?, Ms, Mon?)
.
say(go, I, [], _)
:-
'>'(I?, 3)
|
true
.
procedure
next
(
Status
?
,
Integer?
,
Stream(Msg)
,
MutualRef?
)
.
next(sent, I, Ms?, Mon)
:-
':='(I1, '+'(I?, 1))
,
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
say(Tok?, I1?, Ms, Mon?)
.
next(read(Q?), I, Ms?, Mon)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
acknowledge(Tok?, I?, Q, Ms, Mon?)
.
procedure
acknowledge
(
Token?
,
Integer?
,
Ack
,
Stream(Msg)
,
MutualRef?
)
.
acknowledge(go, I, ack, Ms?, Mon)
:-
':='(I1, '+'(I?, 1))
,
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
say(Tok?, I1?, Ms, Mon?)
.
procedure
text
(
Integer?
,
String
)
.
text(1, hello)
.
text(2, there)
.
text(3, bye)
.
