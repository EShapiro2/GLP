%% transform(receipt, profiles)

%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).

%% person(talker)
%% binds(Stream(Msg), talk)
exported procedure
talk
(
Stream(Msg)
,
Person
?
,
Integer?
,
MutualRef?
,
MutualRef?
)
.
talk(Ms?, _, _, Mon, _)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
say(Tok?, 1, slot(Ms), Mon?)
.
procedure
say
(
Token?
,
Integer?
,
Slot(Stream(Msg))
?
,
MutualRef?
)
.
say(stop, _, _, _)
.
say(go, I, slot([msg(T?, St) | Ms?]), Mon)
:-
'=<'(I?, 3)
|
text(I?, T)
,
next(St?, I?, Ms, Mon?)
.
say(go, I, slot([]), _)
:-
'>'(I?, 3)
|
true
.
procedure
next
(
Status
?
,
Integer?
,
Stream(Msg)
,
MutualRef?
)
.
next(sent, I, Ms?, Mon)
:-
':='(I1, '+'(I?, 1))
,
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
say(Tok?, I1?, slot(Ms), Mon?)
.
next(read(Q?), I, Ms?, Mon)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
acknowledge(Tok?, I?, slot(Q), slot(Ms), Mon?)
.
procedure
acknowledge
(
Token?
,
Integer?
,
Slot(Ack)
?
,
Slot(Stream(Msg))
?
,
MutualRef?
)
.
acknowledge(stop, _, _, _, _)
.
acknowledge(go, I, slot(ack), slot(Ms?), Mon)
:-
':='(I1, '+'(I?, 1))
,
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
say(Tok?, I1?, slot(Ms), Mon?)
.
procedure
text
(
Integer?
,
String
)
.
text(1, hello)
.
text(2, there)
.
text(3, bye)
.
