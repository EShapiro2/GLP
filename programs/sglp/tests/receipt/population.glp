%% The person procedures, in the profiles module.
imported procedure
profiles
#
talk
(
Stream(Msg)
,
Integer?
,
MutualRef?
)
.

%% The person process (sGLP's paper, Section 4, "The person process").
exported procedure person(Integer?, Profiles?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, profiles(talker), Mon, Seed, Log, [ask(Type, stream_msg_r(X?)) | As])
:-
random(Seed?, 2147483646, K, S)
,
profiles
#
talk(Y, K?, Mon?)
,
answer_1(A?, Type?, Y?, X, Mon?, Log?)
,
person(A?, profiles(talker), Mon?, S?, Log?, As?)
.
person(_, _, _, _, _, []).

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
Stream(Msg)
?
,
Stream(Msg)
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, [], [], Mon, Log)
:-
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, []), Log?, _)
.
answer_1(A, Type, [msg(Z1, Z2?) | Z4], [msg(Z1?, Z3) | Z5?], Mon, Log)
:-
ground(Z1?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, [msg(Z1?, '_') | '_']), Log?, _)
,
present_1(A?, Type?, Z3?, Z2, Mon?, Log?)
,
answer_1(A?, Type?, Z4?, Z5, Mon?, Log?)
.

%% The question shown, each position the person writes answered as a question of its own (Section 4, "The person process").
procedure
present_1
(
Integer?
,
Constant?
,
Status
?
,
Status
,
MutualRef?
,
MutualRef?
)
.
present_1(_, _, sent, sent, _, _)
.
present_1(A, Type, read(Z1?), read(Z2), Mon, Log)
:-
answer_2(A?, Type?, Z2?, Z1, Mon?, Log?)
.

%% The answer to a question shown, handed over and logged in it (Section 4, "The person process" and "The log").
procedure
answer_2
(
Integer?
,
Constant?
,
Ack
?
,
Ack
,
MutualRef?
,
MutualRef?
)
.
answer_2(A, Type, Y, Y?, Mon, Log)
:-
ground(Y?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, read(Y?)), Log?, _)
.

