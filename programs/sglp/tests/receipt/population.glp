%% An agent's stochastic person, drawn from its block (Appendix B).
exported procedure
stochastic_person
(
Integer?
,
Profiles
,
Integer
)
.
stochastic_person(B, profiles(P1?), S?)
:-
random(B?, 100, K1, S)
,
talking(K1?, P1)
.

%% The draw of the dimension(talking)
procedure
talking
(
Integer?
,
Dimension1
)
.
talking(_, talker)
.
