%% Printed by programs/sglp/transform/transform.glp from the sGLP source in the term form
%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(delivery, profiles)

%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).

%% person(talker)
%% binds(Stream(Msg), talk)
exported procedure talk(Stream(Msg), Person?, Integer?, MutualRef?).
talk(Ms?, _, _, _)
:-
rated(0.0002777777777777778, Tok)
,
say(Tok?, 1, slot(Ms))
.
procedure say(Token?, Integer?, Slot(Stream(Msg))?).
say(stop, _, _)
.
say(go(_), I, slot([msg(T?, St) | Ms?]))
:-
'=<'(I?, 3)
|
text(I?, T)
,
next(St?, I?, Ms)
.
say(go(_), I, slot([]))
:-
'>'(I?, 3)
|
true
.
procedure next(Status?, Integer?, Stream(Msg)).
next(St, I, Ms?)
:-
known(St?)
|
':='(I1, '+'(I?, 1))
,
rated(0.0002777777777777778, Tok)
,
say(Tok?, I1?, slot(Ms))
.
procedure text(Integer?, String).
text(1, hello)
.
text(2, there)
.
text(3, bye)
.
