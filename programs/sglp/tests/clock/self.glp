%% The test of the machine's clock in an sGLP run (Audit #4, Grassroots-Audit
%% programs/sglp/cva/harness.glp.in.md, Finding 2; programs/sglp/monitor.glp):
%% the monitor sets the machine's clock to the simulated clock, in Unix
%% milliseconds, at the start and at each Release, so that a program reading
%% the date by now/1, as a canonical CVA platform does, reads the simulated
%% date.
%%
%% clock(N): N rated goals in a chain, each of rate 1 a day, the first spawned
%% at the start; each released goal, go(T), spawns the next and a goal that,
%% one goal later, reads the machine's clock, now(M), and prints r(T, M).  The
%% test reads that each M is T seconds in milliseconds, up to the wall-clock
%% time between the monitor's set_clock and the reading, and that each M's
%% day, M // 86400000, is T's, T // 86400.

exported procedure clock(Integer?).
clock(N) :-
    integer(N?) |
    allocate_mutual_reference(_, Requests),
    allocate_mutual_reference(Log, _),
    allocate_mutual_reference(Out, Os),
    send_to_user(Os?),
    monitor(Requests?, 20260927, 3153600000, Log?),
    rated_reader(N?, Out?).

%% rated_reader(N?, Out?): N more rated goals of rate 1 a day, translated as the
%% transformation translates G @ 1/day.
procedure rated_reader(Integer?, MutualRef?).
rated_reader(0, _).
rated_reader(N, Out) :-
    N? > 0 |
    R := 1 / 86400,
    rated(R?, Tok),
    reader(Tok?, N?, Out?).

procedure reader(Token?, Integer?, MutualRef?).
reader(go(T), N, Out) :-
    number(T?), integer(N?) |
    hop(T?, Out?),
    N1 := N? - 1,
    rated_reader(N1?, Out?).
reader(stop, _, _).

%% hop(T?, Out?): one goal later, the clock read.
procedure hop(Number?, MutualRef?).
hop(T, Out) :- read_at(T?, Out?).

%% read_at(T?, Out?): the machine's clock read, beside the released time T.
procedure read_at(Number?, MutualRef?).
read_at(T, Out) :-
    now(M),
    report(T?, M?, Out?).

procedure report(Number?, Integer?, MutualRef?).
report(T, M, Out) :-
    number(T?), integer(M?) |
    stream_append(r(T?, M?), Out?, _).
