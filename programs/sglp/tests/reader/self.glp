%% Test (xi) of sGLP in GLP (sGLP's tasks 5 of 2026-10-09 22:01 UTC and 6 of
%% 2026-10-10 07:59 UTC; sGLP's paper, Section 3, Definitions "Dual, Person
%% Procedure, Person Declaration" and "Person Process, Simulation Program,
%% Stochastic Agent"; Section 4, "The person process"): a vGLP program with
%% one interactive type in reader mode, Rating?, the person writing the whole
%% term; a profile answering it; and a run of a few asks.
%%
%%   rating.vglp      the vGLP program;
%%   rating.glp       its canonical compilation (vGLP, Definition "Canonical
%%                    Compilation"), written by hand: the asking clause in
%%                    reader mode, X and X? not exchanged, the ask carrying
%%                    the writer X;
%%   rating_sglp.glp  the sGLP source in the term form (programs/sglp/README.md),
%%                    the profile fair and the run declaration, the vGLP
%%                    program's interface and its compiled program's
%%                    predicates;
%%   profiles.glp and population.glp  printed from rating_sglp.glp by
%%                    programs/sglp/transform.sh, and not edited;
%%   harness.glp      the run, by hand: the monitor, the log's sink, the one
%%                    agent's initial goal and its person process.
%%
%%   reader_run(K, Ns)   the run of the run declaration with K asks; Ns the
%%                       ratings the program read, in the order asked

%% The vGLP program's type (rating.vglp).
Rating ::= rating(Integer).

%% The type of the asks, which the canonical compilation adds: Rating is in
%% reader mode, so its alternative of Question is rating_r(Rating?), the ask
%% carrying the writer the person process writes.
Ask      ::= ask(Constant, Question).
Question ::= rating_r(Rating?).

%% A stochastic person, one profile in the one dimension, as the harness hands
%% it from the population's draw to the person process (population.glp).
Rater    ::= fair.
Profiles ::= profiles(Rater).

imported procedure harness#run(Integer?, Stream(Integer)).
exported procedure reader_run(Integer?, Stream(Integer)).
reader_run(K, Ns?) :- harness # run(K?, Ns).

%% The sGLP source in the term form, rating_sglp.glp, for the transformation
%% (programs/sglp/transform.glp).
imported procedure rating_sglp#source(SglpTerms, SglpTerms).
exported procedure source(SglpTerms, SglpTerms).
source(V?, S?) :- rating_sglp # source(V, S).
