%% Test (xx) of sGLP in GLP (sGLP's task of 2026-10-20 08:00 UTC, items 1 to 4
%% and 7; sGLP's paper at 0270ac6, Section 3, Definitions "Person, Census",
%% "Dual, Person Procedure, Person Declaration", "Profile, Dimension",
%% "Stochastic Person, Population" and "Screen, Seen"; Appendix B, "Seeds"): a
%% vGLP program that writes nothing to its person; a census drawing persons of
%% two roles with attributes; dimensions of one role each, a parent's two and
%% a child's one; person procedures reading their person, one calling seen(L)
%% with no Output; and its run.
%%
%%   village.vglp       the vGLP program;
%%   village.glp        its canonical compilation (vGLP, Definition
%%                      "Canonical Compilation"), written by hand;
%%   village_sglp.glp   the sGLP source in the term form
%%                      (programs/sglp/README.md), the census, its types, the
%%                      profiles and the run declaration, the vGLP program's
%%                      interface and its compiled program's predicates;
%%   profiles.glp and population.glp  printed from village_sglp.glp by
%%                      programs/sglp/transform.sh, and not edited;
%%   harness.glp        the run, by hand: the persons the census draws, refused
%%                      where it draws none or one of a role of no dimension;
%%                      the monitor, the log's sink, and at each agent its
%%                      initial goal, its screen and its person process.
%%
%%   census_run(Ps)          the run of the run declaration; Ps the persons
%%   census_seeded(Seed, Ps) the same run from the seed Seed
%%   census_draw(Ds)         the population's draw of that run without it, Ds
%%                           each agent's stochastic person, agent(A, P)
%%   census_persons(Seed, Ok, Ps)  the census's persons drawn for a run of
%%                           seed Seed, Ok yes, or no where the run refuses them

%% The vGLP program's types (village.vglp).
Hello ::= hello(Constant?, Integer?).
Mood  ::= mood(Constant?).
Said  ::= said(Constant, Integer, Constant).

%% The type of the asks, which the canonical compilation adds: Hello and Mood
%% are in writer mode, so their alternatives of Question are hello_w(Hello)
%% and mood_w(Mood).
Ask      ::= ask(Constant, Question).
Question ::= hello_w(Hello) ; mood_w(Mood).

%% A stochastic person, a parent's two profiles and a child's one, as the
%% harness hands it from the population to the person process; and the
%% person, as the source defines it: structurally population.glp's.
Greeting ::= formal.
Temper   ::= kind ; grumpy.
Play     ::= casual.
Profiles ::= parent(Greeting, Temper) ; child(Play).
Attr     ::= age(Integer) ; kids(Integer).
Person   ::= person(Constant, Constant, List(Attr)).
Drawn    ::= agent(Integer, Profiles).

imported procedure harness#run(List(Person)).
exported procedure census_run(List(Person)).
census_run(Ps?) :- harness # run(Ps).

imported procedure harness#seeded(Integer?, List(Person)).
exported procedure census_seeded(Integer?, List(Person)).
census_seeded(Seed, Ps?) :- harness # seeded(Seed?, Ps).

imported procedure harness#draw(Stream(Drawn)).
exported procedure census_draw(Stream(Drawn)).
census_draw(Ds?) :- harness # draw(Ds).

imported procedure harness#persons(Integer?, Constant, List(Person)).
exported procedure census_persons(Integer?, Constant, List(Person)).
census_persons(Seed, Ok?, Ps?) :- harness # persons(Seed?, Ok, Ps).

%% The sGLP source in the term form, village_sglp.glp, for the transformation
%% (programs/sglp/transform.glp).
imported procedure village_sglp#source(SglpTerms, SglpTerms).
exported procedure source(SglpTerms, SglpTerms).
source(V?, S?) :- village_sglp # source(V, S).
