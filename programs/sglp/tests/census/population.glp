%% The run declaration of the source:
%% (run(village, [mix(greeting, parent, [share(formal, 1.0)]), mix(temper, parent, [share(kind, 0.5), share(grumpy, 0.5)]), mix(play, child, [share(casual, 1.0)])], 1, day, 20260927))

Profiles
::=
parent(Dimension1, Dimension2)
;
child(Dimension3)
.
Dimension1
::=
formal
.
Dimension2
::=
kind
;
grumpy
.
Dimension3
::=
casual
.
Ask ::= ask(Constant, Question).
Question
::=
hello_w(Hello)
;
mood_w(Mood)
.
Attr
::=
age(Integer)
;
kids(Integer)
.
Person
::=
person(Constant, Constant, List(Attr))
.

