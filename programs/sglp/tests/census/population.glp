%% The person process (sGLP's paper, Section 3, Definition "Person Process"; Section 4, "The person process").
exported procedure person(Integer?, Profiles?, Person?, MutualRef?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, parent(formal, D2), H, Mon, Scr, Seed, Log, [ask('Hello', hello_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
formal_hello(Y?, H?, K?, Mon?, Scr?)
,
relay_1(A?, 'Hello', E?, Y, Mon?, Log?)
,
person(A?, parent(formal, D2?), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, parent(D1, kind), H, Mon, Scr, Seed, Log, [ask('Mood', mood_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
kind_mood(Y?, H?, K?, Mon?, Scr?)
,
relay_2(A?, 'Mood', E?, Y, Mon?, Log?)
,
person(A?, parent(D1?, kind), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, parent(D1, grumpy), H, Mon, Scr, Seed, Log, [ask('Mood', mood_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
grumpy_mood(Y?, H?, K?, Mon?, Scr?)
,
relay_2(A?, 'Mood', E?, Y, Mon?, Log?)
,
person(A?, parent(D1?, grumpy), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, child(casual), H, Mon, Scr, Seed, Log, [ask('Hello', hello_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
casual_hello(Y?, H?, K?, Mon?, Scr?)
,
relay_1(A?, 'Hello', E?, Y, Mon?, Log?)
,
person(A?, child(casual), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, child(casual), H, Mon, Scr, Seed, Log, [ask('Mood', mood_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
casual_mood(Y?, H?, K?, Mon?, Scr?)
,
relay_2(A?, 'Mood', E?, Y, Mon?, Log?)
,
person(A?, child(casual), H?, Mon?, Scr?, S?, Log?, As?)
.
person(_, _, _, _, _, _, _, []).

%% The relay of an interactive type (Definition "Copy, Relay").
procedure
relay_1
(
Integer?
,
Constant?
,
Hello
?
,
Hello
,
MutualRef?
,
MutualRef?
)
.
relay_1(A, Type, hello(X1?, X2?), hello(Y1, Y2), Mon, Log)
:-
answer_1(A?, Type?, Y1?, X1, Mon?, Log?)
,
answer_2(A?, Type?, Y2?, X2, Mon?, Log?)
.

%% The relay of an interactive type (Definition "Copy, Relay").
procedure
relay_2
(
Integer?
,
Constant?
,
Mood
?
,
Mood
,
MutualRef?
,
MutualRef?
)
.
relay_2(A, Type, mood(X1?), mood(Y1), Mon, Log)
:-
answer_3(A?, Type?, Y1?, X1, Mon?, Log?)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
Constant?
,
Constant
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, Y1, Y1?, Mon, Log)
:-
ground(Y1?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, hello(Y1?, '_')), Log?, _)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_2
(
Integer?
,
Constant?
,
Integer?
,
Integer
,
MutualRef?
,
MutualRef?
)
.
answer_2(A, Type, Y2, Y2?, Mon, Log)
:-
ground(Y2?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, hello('_', Y2?)), Log?, _)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_3
(
Integer?
,
Constant?
,
Constant?
,
Constant
,
MutualRef?
,
MutualRef?
)
.
answer_3(A, Type, Y1, Y1?, Mon, Log)
:-
ground(Y1?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, mood(Y1?)), Log?, _)
.

%% The screen of an agent (sGLP's paper, Section 3, Definition "Screen, Seen"; Section 4, "The screen" and "The log").
Seen(X) ::= seen(List(X)?).
exported procedure(X) screen(Integer?, Stream(X)?, List(X)?, Stream(Seen(X))?, MutualRef?, MutualRef?).
screen(A, [E|O], Os, Rs, Mon, Log) :- ground(E?) | stream_append(time(Time), Mon?, _), stream_append(entry(Time?, A?, output, E?), Log?, _), screen(A?, O?, [E?|Os?], Rs?, Mon?, Log?).
screen(A, O, Os, [seen(Os?)|Rs], Mon, Log) :- ground(Os?) | screen(A?, O?, Os?, Rs?, Mon?, Log?).
screen(_, [], _, [], _, _).

%% An agent's screen on the program's output O to its person, and its reference, Scr, on which the person goals request seen(L).
exported procedure(X) start_screen(Integer?, Stream(X)?, MutualRef?, MutualRef?, MutualRef).
start_screen(A, O, Mon, Log, Scr?) :- allocate_mutual_reference(Scr, Rs), screen(A?, O?, [], Rs?, Mon?, Log?).

%% The run declaration: its persons, horizon, seed and thresholds.
exported procedure
declaration
(
Constant
,
Number
,
Span
,
Integer
,
Integer
)
.
declaration(village, 1, day, 20260927, 50)
.

%% The persons of the run, drawn by its census (sGLP's paper, Section 3, Definition "Person, Census", and after Definition "Well-Formed"; Appendix B).
exported procedure
persons
(
Integer?
,
Stream(Constant)
?
,
Constant
,
List(Person)
,
Integer
)
.
persons(B, _, Ok?, Ps?, B1?)
:-
integer(B?)
|
profiles
#
village(B?, Ps0)
,
checked(Ps0?, Ok, Ps)
,
skip(4096, B?, B1)
.
procedure skip(Integer?, Integer?, Integer).
skip(0, S, S?).
skip(J, S, S1?) :- J? > 0, integer(S?) | random(S?, 1, _, S2), J1 := J? - 1, skip(J1?, S2?, S1).
procedure checked(List(Person)?, Constant, List(Person)).
checked([], no, []).
checked([P|Ps], Ok?, [P?|Ps?]) :- ground(P?), ground(Ps?) | roles_ok([P?|Ps?], Ok).
procedure roles_ok(List(Person)?, Constant).
roles_ok([], yes).
roles_ok([person(_, parent, _) | Ps], Ok?)
:-
roles_ok(Ps?, Ok)
.
roles_ok([person(_, child, _) | Ps], Ok?)
:-
roles_ok(Ps?, Ok)
.
roles_ok([_|_], no) :- otherwise | true.

%% An agent's stochastic person, one profile per dimension of the role of its person, drawn from its block (Appendix B).
exported procedure
stochastic_person
(
Integer?
,
Person
?
,
Integer?
,
Profiles
,
Integer
)
.
stochastic_person(B, person(_, parent, _), T1, parent(P1?, P2?), S?)
:-
random(B?, 100, K1, B1)
,
random(B1?, 100, K2, S)
,
greeting(K1?, P1)
,
temper(K2?, T1?, P2)
.
stochastic_person(B, person(_, child, _), _, child(P1?), S?)
:-
random(B?, 100, K1, S)
,
play(K1?, P1)
.

%% The draw of the dimension(greeting)
procedure
greeting
(
Integer?
,
Dimension1
)
.
greeting(_, formal)
.

%% The draw of the dimension(temper)
procedure
temper
(
Integer?
,
Integer?
,
Dimension2
)
.
temper(K, T1, kind)
:-
'=<'(K?, T1?)
|
true
.
temper(K, T1, grumpy)
:-
'>'(K?, T1?)
|
true
.

%% The draw of the dimension(play)
procedure
play
(
Integer?
,
Dimension3
)
.
play(_, casual)
.
