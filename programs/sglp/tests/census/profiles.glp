)
.
kind_mood(mood(M?), _, _, Mon, _)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
tell(Tok?, slot(M), kind)
.
procedure
tell
(
Token?
,
Slot(Constant)
?
,
Constant?
)
.
tell(stop, _, _)
.
tell(go, slot(V?), V)
.

