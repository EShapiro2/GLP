%% person(casual)
%% binds(Hello, casual_hello)
%% binds(Mood, casual_mood)
exported procedure
casual_hello
(
Hello
?
,
Person
?
,
Integer?
,
MutualRef?
,
MutualRef?
)
.
casual_hello(hello(K?, A?), H, _, Mon, _)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
say_age(Tok?, H?, slot(K), slot(A))
.
procedure
say_age
(
Token?
,
Person
?
,
Slot(Constant)
?
,
Slot(Integer)
?
)
.
say_age(stop, _, _, _)
.
say_age(go, person(Me, _, As), slot(Me?), slot(Ag?))
:-
age_of(As?, Ag)
.
procedure
age_of
(
List(Attr)
?
,
Integer
)
.
age_of([], 0)
.
age_of([age(A) | _], A?)
.
age_of([kids(_) | As], A?)
:-
age_of(As?, A)
.
exported procedure
casual_mood
(
Mood
?
,
Person
?
,
Integer?
,
MutualRef?
,
MutualRef?
)
.
casual_mood(mood(M?), _, _, Mon, _)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
tell(Tok?, slot(M), happy)
.
