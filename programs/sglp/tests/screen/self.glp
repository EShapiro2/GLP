%% Test (xix) of sGLP in GLP (sGLP's task of 2026-10-20 08:00 UTC, items 4, 5
%% and 7; sGLP's paper at 0270ac6, Section 3, Definitions "Screen, Seen" and
%% "Simulation Program"; Section 4, "The screen" and "The log"): a vGLP program
%% that writes to its person; a profile that calls seen(L) before an element
%% of the output arrives and after; and its run, the log showing each element
%% the screen shows, output, beside the answers.
%%
%%   notes.vglp         the vGLP program;
%%   notes.glp          its canonical compilation (vGLP, Definition
%%                      "Canonical Compilation"), written by hand;
%%   notes_sglp.glp     the sGLP source in the term form
%%                      (programs/sglp/README.md), the profile looker and the
%%                      run declaration, the vGLP program's interface and its
%%                      compiled program's predicates;
%%   profiles.glp and population.glp  printed from notes_sglp.glp by
%%                      programs/sglp/transform.sh, and not edited;
%%   harness.glp        the run, by hand: the monitor, the log's sink, the one
%%                      agent's initial goal, its screen on the program's
%%                      output to its person, and its person process.
%%
%%   screen_run(Ns)     the run of the run declaration; Ns the counts the
%%                      program read

%% The vGLP program's types (notes.vglp).
Output ::= note(Integer).
Count  ::= count(Integer?).

%% The type of the asks, which the canonical compilation adds: Count is in
%% writer mode, so its alternative of Question is count_w(Count).
Ask      ::= ask(Constant, Question).
Question ::= count_w(Count).

%% A stochastic person, of the role agent, one profile in the one dimension,
%% and a person, as run n agents draws them, as the harness hands them from the
%% population to the person process: structurally population.glp's.
Looking  ::= looker.
Profiles ::= agent(Looking).
Person   ::= person(Constant, Constant, List(Constant)).

imported procedure harness#run(Stream(Integer)).
exported procedure screen_run(Stream(Integer)).
screen_run(Ns?) :- harness # run(Ns).

%% The sGLP source in the term form, notes_sglp.glp, for the transformation
%% (programs/sglp/transform.glp).
imported procedure notes_sglp#source(SglpTerms, SglpTerms).
exported procedure source(SglpTerms, SglpTerms).
source(V?, S?) :- notes_sglp # source(V, S).
