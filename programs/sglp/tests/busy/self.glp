%% Test (i) of sGLP in GLP (sGLP's code task of 2026-10-02 00:06 UTC, item 6;
%% sGLP's paper at 2bc479b, Section 4, "The clock", "The monitor" and "The
%% claim, tested"): a request's token is
%% bound only after when_idle has succeeded.  A rated goal and an unrated busy
%% goal: the busy goal runs to rest first.
%%
%%   busy(N)       the rated goal spawned before count(N, Z)    prints after
%%   busy_late(N)  the rated goal spawned after it               prints after
%%
%% The rated goal makes its token Tok pending at rate 1 a second, rated(1,
%% Tok), and waits on Tok; the monitor (programs/sglp/monitor.glp, exposed by
%% programs/sglp/self.glp) steps GLP's clock when the machine rests, binding
%% Tok to go(T); released, the goal finds Z assigned (after) or not (before),
%% and appends which through a mutual reference, the test reading the stream
%% the reference was allocated on by send_to_user/1, as the monitor writes its
%% log.  Were a token bound before the machine rested, it would find count/2
%% still counting.  The
%% probe takes inputs only and its stop clause drops them, as the
%% transformation prints a rated goal's procedure (sGLP's paper, Section 4,
%% "The transformation"; sGLP's answer of 2026-10-14 11:40 UTC, 2).

exported procedure busy(Integer?).
busy(N) :-
    allocate_mutual_reference(_, Requests),
    allocate_mutual_reference(Log, _),
    allocate_mutual_reference(Out, Os),
    send_to_user(Os?),
    monitor(Requests?, 20260927, 3600, Log?),
    rated_probe(Z?, Out?),
    count(N?, Z).

exported procedure busy_late(Integer?).
busy_late(N) :-
    allocate_mutual_reference(_, Requests),
    allocate_mutual_reference(Log, _),
    allocate_mutual_reference(Out, Os),
    send_to_user(Os?),
    count(N?, Z),
    monitor(Requests?, 20260927, 3600, Log?),
    rated_probe(Z?, Out?).

%% rated_probe(Z?, Out?): a goal of rate 1 a second, translated as the
%% transformation translates G @ 1/second.
procedure rated_probe(Integer?, MutualRef?).
rated_probe(Z, Out) :-
    rated(1, Tok),
    probe(Tok?, Z?, Out?).

procedure probe(Token?, Integer?, MutualRef?).
probe(go(_), Z, Out) :- known(Z?) | stream_append(after, Out?, _).
probe(go(_), Z, Out) :- unknown(Z?) | stream_append(before, Out?, _).
probe(stop, _, _).

procedure count(Integer?, Integer).
count(0, 0).
count(N, Z?) :- N? > 0 | N1 := N? - 1, count(N1?, Z).
