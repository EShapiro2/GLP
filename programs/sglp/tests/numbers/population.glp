.
declaration(1, 1, week, 20260927)
.

%% An agent's stochastic person, drawn from its block (Appendix B).
exported procedure
stochastic_person
(
Integer?
,
Profiles
,
Integer
)
.
stochastic_person(B, profiles(P1?), S?)
:-
random(B?, 100, K1, S)
,
counting(K1?, P1)
.

%% The draw of the dimension(counting)
procedure
counting
(
Integer?
,
Dimension1
)
.
counting(_, counter)
.
