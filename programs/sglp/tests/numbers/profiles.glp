%% Printed by programs/sglp/transform.glp from the sGLP source in the term form
%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(numbers, profiles)

%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).

%% person(counter)
%% binds(Stream(Integer), count)
exported procedure count(Stream(Integer), Person?, Integer?, MutualRef?).
count(Ns?, _, _, _)
:-
rated(0.0002777777777777778, Tok)
,
step(Tok?, 1, slot(Ns))
.
procedure step(Token?, Integer?, Slot(Stream(Integer))?).
step(stop, _, _)
.
step(go(_), I, slot([I? | Ns?]))
:-
'=<'(I?, 3)
|
':='(I1, '+'(I?, 1))
,
rated(0.0002777777777777778, Tok)
,
step(Tok?, I1?, slot(Ns))
.
step(go(_), I, slot([]))
:-
'>'(I?, 3)
|
true
.
