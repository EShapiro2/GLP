%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).

%% person(counter)
%% binds(Stream(Integer), count)
exported procedure
count
(
Stream(Integer)
,
Person
?
,
Integer?
,
MutualRef?
,
MutualRef?
)
.
count(Ns?, _, _, Mon, _)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
step(Tok?, 1, slot(Ns), Mon?)
.
procedure
step
(
Token?
,
Integer?
,
Slot(Stream(Integer))
?
,
MutualRef?
)
.
step(stop, _, _, _)
.
step(go, I, slot([I? | Ns?]), Mon)
:-
'=<'(I?, 3)
|
':='(I1, '+'(I?, 1))
,
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
step(Tok?, I1?, slot(Ns), Mon?)
.
step(go, I, slot([]), _)
:-
'>'(I?, 3)
|
true
.
