%% The sGLP source of the test of the harness of every canonical CVA platform
%% (programs/sglp/cva/; sGLP's task of 2026-10-18 20:50 UTC, the gate: "a test
%% of the harness on a canonical platform with scripted profiles of your own in
%% tests/"), in the term form the transformation reads (programs/sglp/README.md,
%% "The term form"), the profiles over the canonical platform's questions and
%% nothing of its interface, which is the platform's as the cascade emits it
%% (programs/sglp/cva/interface.sh).  It is written for the canonical platform
%% of the social graph, GSG, and two agents, keyed p1 and p2 (cva/run.sh).  Its
%% surface form:
%%
%%   person scripted.
%%   Request =::= script_request.
%%   procedure script_request(Request, Person?, Integer?).
%%   script_request(R?, person(p1, _, _), S) :-
%%       random(S?, 3, K, _), act(K?, p1, p2, slot(R)) @ 1/hour.
%%   script_request(R?, person(p2, _, _), S) :-
%%       random(S?, 3, K, _), act(K?, p2, p1, slot(R)) @ 1/hour.
%%   procedure act(Integer?, Key?, Key?, Slot(Request)?).
%%   act(1, Me, _, slot(propose(establish(Me?)))).
%%   act(2, Me, Q, slot(propose(acquaint(Me?, Q?)))).
%%   act(3, Me, Q, slot(propose(befriend(Me?, Q?)))).
%%
%%   person agreeable.
%%   Approval =::= agree.
%%   procedure agree(Approval?, Person?, Integer?).
%%   agree(approval(_, _, A?), _, _) :- say_yes(slot(A)) @ 1/hour.
%%   procedure say_yes(Slot(YesNo)?).
%%   say_yes(slot(yes)).
%%
%%   run 2 agents [requests ~ (scripted : 1.0), approvals ~ (agreeable : 1.0)]
%%       until 1 day seed 20260927.
%%
%% A request question is of the request type, Request?, and takes one request,
%% propose(Proposal), and an approval question shows the attempt or
%% the hello it asks about, the words it shows and the answer, approval(Asking,
%% List(Word), YesNo?), as the canonical platform of the GSG record prints them
%% (cascade/GSG/interface.glp; vGLP d433f71, "The compilation"); Request? is in
%% reader mode, so its person procedure is declared with its dual, Request
%% (Section 3, Definition "Dual, Person Procedure, Person Declaration").  The
%% scripted person, at each request question, by a draw, proposes establishing
%% its identity, an acquaintance with the other agent, or befriending it
%% (GKK:1, GKK:2, GSG:1), its own key and the other's read off its person,
%% person(p1, agent, []) or person(p2, agent, []); the agreeable person
%% approves every attempt and every hello it is asked about.

exported procedure source(SglpTerms).
source([
   person(scripted),
   binds('Request', script_request),
   decl(script_request('Request', dual('Person'), dual('Integer'))),
   clause(script_request(var('R?'), person(p1, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 3, var('K'), var('_')), rated(act(var('K?'), p1, p2, slot(var('R'))), rate(1, hour))]),
   clause(script_request(var('R?'), person(p2, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 3, var('K'), var('_')), rated(act(var('K?'), p2, p1, slot(var('R'))), rate(1, hour))]),
   decl(act(dual('Integer'), dual('Key'), dual('Key'), dual('Slot'('Request')))),
   clause(act(1, var('Me'), var('_'), slot(propose(establish(var('Me?'))))), [], []),
   clause(act(2, var('Me'), var('Q'), slot(propose(acquaint(var('Me?'), var('Q?'))))), [], []),
   clause(act(3, var('Me'), var('Q'), slot(propose(befriend(var('Me?'), var('Q?'))))), [], []),

   person(agreeable),
   binds('Approval', agree),
   decl(agree(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(agree(approval(var('_'), var('_'), var('A?')), var('_'), var('_')), [], [rated(say_yes(slot(var('A'))), rate(1, hour))]),
   decl(say_yes(dual('Slot'('YesNo')))),
   clause(say_yes(slot(yes)), [], []),

   run(2, [mix(requests, [share(scripted, 1.0)]), mix(approvals, [share(agreeable, 1.0)])], 1, day, 20260927)]).
