%% The sGLP source of the test of the harness of every canonical CVA platform
%% with a census (sGLP's task of 2026-10-20 08:00 UTC, items 1, 2 and 7;
%% sGLP's paper at 0270ac6, Section 3, Definitions "Person, Census" and
%% "Profile, Dimension"), in the term form the transformation reads
%% (programs/sglp/README.md, "The term form"), over the canonical platform of
%% the social graph, GSG, as scripted_sglp.glp beside it.  Its surface form:
%%
%%   Person ::= person(Key, Constant, List(Constant)).
%%   procedure pair(Integer?, List(Person)).
%%   pair(_, [person(p1, host, [p2]), person(p2, guest, [])]).
%%
%%   person scripted.
%%   Menu =::= script_menu.
%%   (script_menu, say and act as in scripted_sglp.glp)
%%
%%   person agreeable.
%%   Approval =::= agree.
%%   (agree and say_yes as in scripted_sglp.glp)
%%
%%   person guest.
%%   Menu =::= script_menu.
%%   Approval =::= agree.
%%
%%   run pair [menus of host ~ (scripted : 1.0),
%%             approvals of host ~ (agreeable : 1.0),
%%             guesting of guest ~ (guest : 1.0)]
%%       until 1 day seed 20260927.
%%
%% The census, pair, draws two persons, keyed p1 and p2, the platform's keys,
%% the first a host, who knows the second, and the second a guest; a host has
%% two dimensions and a guest one, which declares both questions, its person
%% procedures those the host's profiles declare, defined once (Section 3,
%% Definition "Well-Formed": a predicate two profiles' programs define has one
%% definition in both).  The run is cva/run.sh's with census for its agents.

exported procedure source(SglpTerms).
source([
   type('Person', [person('Key', 'Constant', 'List'('Constant'))]),
   decl(pair(dual('Integer'), 'List'('Person'))),
   clause(pair(var('_'), [person(p1, host, [p2]), person(p2, guest, [])]), [], []),

   person(scripted),
   binds('Menu', script_menu),
   decl(script_menu(dual('Menu'), dual('Person'), dual('Integer'))),
   clause(script_menu(menu(p1, [], var('R?')), var('_'), var('_')), [], [rated(say(slot(var('R')), known(p2)), rate(1, hour))]),
   clause(script_menu(menu(p2, [], var('R?')), var('_'), var('_')), [], [rated(say(slot(var('R')), known(p1)), rate(1, hour))]),
   clause(script_menu(menu(var('Me'), [var('Q') | var('_')], var('R?')), var('_'), var('S')), [],
          [random(var('S?'), 2, var('K'), var('_')),
           rated(act(var('K?'), var('Me?'), var('Q?'), slot(var('R'))), rate(1, hour))]),
   decl(say(dual('Slot'('Request')), dual('Request'))),
   clause(say(slot(var('V?')), var('V')), [], []),
   decl(act(dual('Integer'), dual('Key'), dual('Key'), dual('Slot'('Request')))),
   clause(act(1, var('Me'), var('_'), slot(propose(establish(var('Me?'))))), [], []),
   clause(act(2, var('Me'), var('Q'), slot(propose(befriend(var('Me?'), var('Q?'))))), [], []),

   person(agreeable),
   binds('Approval', agree),
   decl(agree(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(agree(approval(var('_'), var('A?')), var('_'), var('_')), [], [rated(say_yes(slot(var('A'))), rate(1, hour))]),
   decl(say_yes(dual('Slot'('YesNo')))),
   clause(say_yes(slot(yes)), [], []),

   person(guest),
   binds('Menu', script_menu),
   binds('Approval', agree),

   run(pair,
       [mix(menus, host, [share(scripted, 1.0)]),
        mix(approvals, host, [share(agreeable, 1.0)]),
        mix(guesting, guest, [share(guest, 1.0)])],
       1, day, 20260927)]).
