%% Test (xvii) of sGLP in GLP (sGLP's task of 2026-10-18 20:52 UTC, item 1;
%% sGLP's paper at e8367a3, Section 3, Definition "Relay" (ii): the relay shows
%% the person a term the program writes only once it has no reader; Appendix
%% B, the person process: "a list the program writes inside a question is shown
%% whole, once its last cell is written"): a vGLP program that writes the list
%% of a panel's cards in two steps, the second once the person has answered
%% another question; a profile answering each question; and its run, the log
%% showing both cards' answers after the readiness, each in the panel as shown
%% whole.
%%
%%   steps.vglp         the vGLP program;
%%   steps.glp          its canonical compilation (vGLP, Definition
%%                      "Canonical Compilation"), written by hand;
%%   steps_sglp.glp     the sGLP source in the term form
%%                      (programs/sglp/README.md), the profile stepper and the
%%                      run declaration, the vGLP program's interface and its
%%                      compiled program's predicates;
%%   profiles.glp and population.glp  printed from steps_sglp.glp by
%%                      programs/sglp/transform.sh, and not edited;
%%   harness.glp        the run, by hand: the monitor, the log's sink, the one
%%                      agent's initial goal and its person process.
%%
%%   steps_run(As)      the run of the run declaration; As the answers the
%%                      program read, the readiness and the two cards'

%% The vGLP program's types (steps.vglp).
YesNo ::= yes ; no.
Card  ::= card(Integer, YesNo?).
Panel ::= panel(List(Card)).
Ready ::= ready(YesNo?).

%% The type of the asks, which the canonical compilation adds: Ready and Panel
%% are in writer mode, so their alternatives of Question are ready_w(Ready) and
%% panel_w(Panel), the ask carrying the reader the program writes.
Ask      ::= ask(Constant, Question).
Question ::= ready_w(Ready) ; panel_w(Panel).

%% A stochastic person, one profile in the one dimension, as the harness hands
%% it from the population's draw to the person process (population.glp).
Stepping ::= stepper.
Profiles ::= profiles(Stepping).

imported procedure harness#run(Stream(YesNo)).
exported procedure steps_run(Stream(YesNo)).
steps_run(As?) :- harness # run(As).

%% The sGLP source in the term form, steps_sglp.glp, for the transformation
%% (programs/sglp/transform.glp).
imported procedure steps_sglp#source(SglpTerms, SglpTerms).
exported procedure source(SglpTerms, SglpTerms).
source(V?, S?) :- steps_sglp # source(V, S).
