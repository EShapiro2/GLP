%% The person process (sGLP's paper, Section 4, "The person process").
exported procedure person(Integer?, Profiles?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, profiles(stepper), Mon, Seed, Log, [ask('Ready', ready_w(E)) | As])
:-
random(Seed?, 2147483646, K, S)
,
profiles
#
get_ready(Y?, K?, Mon?)
,
relay_1(A?, 'Ready', E?, Y, Mon?, Log?)
,
person(A?, profiles(stepper), Mon?, S?, Log?, As?)
.
person(A, profiles(stepper), Mon, Seed, Log, [ask('Panel', panel_w(E)) | As])
:-
random(Seed?, 2147483646, K, S)
,
profiles
#
judge_fast(Y?, K?, Mon?)
,
relay_2(A?, 'Panel', E?, Y, Mon?, Log?)
,
person(A?, profiles(stepper), Mon?, S?, Log?, As?)
.
person(_, _, _, _, _, []).

%% The relay of an interactive type (Definition "Copy, Relay").
procedure
relay_1
(
Integer?
,
Constant?
,
Ready
?
,
Ready
,
MutualRef?
,
MutualRef?
)
.
relay_1(A, Type, ready(X1?), ready(Y1), Mon, Log)
:-
answer_1(A?, Type?, Y1?, X1, Mon?, Log?)
.

%% The relay of an interactive type (Definition "Copy, Relay").
procedure
relay_2
(
Integer?
,
Constant?
,
Panel
?
,
Panel
,
MutualRef?
,
MutualRef?
)
.
relay_2(A, Type, X, Y?, Mon, Log)
:-
no_readers(X?)
|
present_1(A?, Type?, X?, B, S, 1, _, Fs, [], Mon?, Log?)
,
show_whole(B?, S?, Fs?, Y)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
YesNo
?
,
YesNo
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, Y1, Y1?, Mon, Log)
:-
ground(Y1?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, ready(Y1?)), Log?, _)
.

%% The build of a question shown whole: the copy, its skeleton for the log, and the answer of each position the person writes (Section 3, Definition "Relay").
