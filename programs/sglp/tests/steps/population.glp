%% The run declaration of the source:
%% (run(1, [mix(stepping, [share(stepper, 1.0)])], 1, week, 20260927))

Profiles
::=
profiles(Dimension1)
.
Dimension1
::=
stepper
.
Ask ::= ask(Constant, Question).
Question
::=
ready_w(Ready)
;
panel_w(Panel)
.

