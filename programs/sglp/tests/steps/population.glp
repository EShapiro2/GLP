.
present_1(A, Type, panel([card(Z1, Z2?) | Z4]), panel([card(Z1?, Z3) | Z5?]), panel([card(Z1?, '$h'(C0?, 0)) | S1?]), C0, N2?, [slot(F1) | G1?], Fs0, Mon, Log)
:-
ground(Z1?)
,
