%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).

%% person(judge)
%% binds(Panel, judge_panel)
exported procedure judge_panel(Panel?, Person?, Integer?, MutualRef?).
judge_panel(panel(Cs), _, S, _)
:-
judge(Cs?, S?)
.
procedure judge(List(Card)?, Integer?).
judge([card(_, A?) | Cs], S)
:-
random(S?, 2, K, S1)
,
rated(0.0002777777777777778, Tok)
,
verdict(Tok?, K?, slot(A))
,
judge(Cs?, S1?)
.
judge([], _)
.
procedure verdict(Token?, Integer?, Slot(YesNo)?).
verdict(stop, _, _)
.
verdict(go(_), 1, slot(yes))
.
verdict(go(_), 2, slot(no))
.
