%% The person process (sGLP's paper, Section 4, "The person process").
exported procedure person(Integer?, Profiles?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, profiles(judge), Mon, Seed, Log, [ask(_, panel_w(panel([]))) | As])
:-
random(Seed?, 2147483646, K, S)
,
profiles
#
judge_panel(panel([]), K?, Mon?)
,
person(A?, profiles(judge), Mon?, S?, Log?, As?)
.
person(A, profiles(judge), Mon, Seed, Log, [ask(Type, panel_w(panel([card(Z1, Z2?) | Z4]))) | As])
:-
ground(Z1?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
judge_panel(panel([card(Z1?, Z3) | Z5?]), K?, Mon?)
,
answer_1(A?, Type?, Z1?, Z3?, Z2, Mon?, Log?)
,
present_1(A?, Type?, Z4?, Z5, Mon?, Log?)
,
person(A?, profiles(judge), Mon?, S?, Log?, As?)
.
person(_, _, _, _, _, []).

%% The answer to a question shown, handed over and logged in it (Section 4, "The person process" and "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
Integer?
,
YesNo
?
,
YesNo
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, V1, Y, Y?, Mon, Log)
:-
ground(Y?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, panel([card(V1?, Y?) | '_'])), Log?, _)
.

%% The question shown, each position the person writes answered as a question of its own (Section 4, "The person process").
procedure
present_1
(
