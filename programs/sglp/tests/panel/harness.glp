%% The run of test (xiv), by hand, as the examples' harnesses (sGLP's paper,
%% Section 4, "The run"; Appendix B): the run declaration of show_sglp.glp,
%% one agent, its initial goal show/3 of show.glp with a panel of N cards, and
%% its person process (population.glp, person/8), with its stochastic person
%% and its seed, reading show/3's ask stream in the dispatcher's place
%% (Section 3, Definition "Simulation Program"); the monitor, with the clock's
%% seed and the horizon in seconds; and the log's sink, the root's
%% send_to_user/1, which prints each entry, ground, on its own line, and the
%% monitor's clock last.
%% The seeds are the examples' (Appendix B, "Seeds"): the clock's split from the
%% run's seed first, then the agent's, from which its stochastic person is
%% drawn and its person process's seed split.  The program holds no
%% call of the transformation, which printed population.glp before the run
%% (transform.sh).

imported procedure show#show(Integer?, Stream(YesNo), Stream(Ask)).
imported procedure population#declaration(Integer, Number, Span, Integer).
imported procedure population#persons(Integer?, Stream(Constant)?, Constant,
                                      List(Person), Integer).
imported procedure population#stochastic_person(Integer?, Person?, Profiles,
                                                Integer).
imported procedure(X) population#start_screen(Integer?, Stream(X)?, MutualRef?,
                                              MutualRef?, MutualRef).
imported procedure population#person(Integer?, Profiles?, Person?, MutualRef?,
                                     MutualRef?, Integer?, MutualRef?,
                                     Stream(Ask)?).

%% run(N?, As): the run declaration's run with a panel of N cards, As the
%% answers the program read.
exported procedure run(Integer?, Stream(YesNo)).
run(K, As?) :-
    population # declaration(N, C, U, Seed),
    run(N?, C?, U?, Seed?, K?, As).

%% run(N?, C?, U?, Seed?, K?, As): the run of one agent until C Us from Seed.
procedure run(Integer?, Number?, Span?, Integer?, Integer?, Stream(YesNo)).
run(1, C, U, Seed, K, As?) :-
    number(C?), integer(Seed?) |
    split_random_seed(Seed?, Clock, Base),
    population # persons(Base?, [1], Ok, Ps, B),
    go(Ok?, Ps?, B?, C?, U?, Clock?, K?, As).

%% go(Ok?, Ps?, B?, C?, U?, Clock?, ...): the run of the one person of Ps, run 1
%% agents' person(1, agent, []), B the seed the agent's is split from, where the census's
%% draw is not refused (Section 3, after Definition "Well-Formed"): the
%% monitor, the log's sink, the agent's initial goal, its screen, on [], the
%% program writing nothing to its person, and its person process; refused, the
%% run takes no goal but the line refused.
procedure go(Constant?, List(Person)?, Integer?, Number?, Span?, Integer?,
             Integer?, Stream(YesNo)).
go(yes, [H], B, C, U, Clock, K, As?) :-
    ground(H?), number(C?), integer(Clock?) |
    span(U?, Secs),
    Hz := C? * Secs?,
    allocate_mutual_reference(Mon, Requests),
    allocate_mutual_reference(Log, Entries),
    send_to_user(Entries?),
    monitor(Requests?, Clock?, Hz?, Log?),
    split_random_seed(B?, A, _),
    population # stochastic_person(A?, H?, P, S),
    split_random_seed(S?, PS, _),
    show # show(K?, As, Asks),
    population # start_screen(1, [], Mon?, Log?, Scr),
    population # person(1, P?, H?, Mon?, Scr?, PS?, Log?, Asks?).
go(no, _, _, _, _, _, _, []) :- send_to_user([refused]).
