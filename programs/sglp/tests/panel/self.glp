%% Test (xiv) of sGLP in GLP (sGLP's answer Q1 of 2026-10-10 09:33 UTC; sGLP's
%% paper, Section 4, "The person process": the person process "shows the
%% person goal the question once the positions the program writes are ground,
%% the positions the person writes inside them left open, each answered as a
%% question of its own --- vGLP's Present"; Appendix B): a vGLP program whose
%% interactive type in writer mode, Panel ::= panel(Cards), Card ::=
%% card(Integer, YesNo?), holds the positions the person writes inside the
%% argument the program writes; a profile answering each card; and its run,
%% the log showing each card's answer as a question of its own, in the panel
%% as shown.
%%
%%   show.vglp          the vGLP program;
%%   show.glp           its canonical compilation (vGLP, Definition
%%                      "Canonical Compilation"), written by hand;
%%   show_sglp.glp      the sGLP source in the term form
%%                      (programs/sglp/README.md), the profile judge and the
%%                      run declaration, the vGLP program's interface and its
%%                      compiled program's predicates;
%%   profiles.glp and population.glp  printed from show_sglp.glp by
%%                      programs/sglp/transform.sh, and not edited;
%%   harness.glp        the run, by hand: the monitor, the log's sink, the one
%%                      agent's initial goal and its person process.
%%
%%   panel_run(N, As)   the run of the run declaration with a panel of N
%%                      cards; As the answers the program read, in order

%% The vGLP program's types (show.vglp).
YesNo ::= yes ; no.
Card  ::= card(Integer, YesNo?).
Cards ::= [] ; [Card | Cards].
Panel ::= panel(Cards).

%% The type of the asks, which the canonical compilation adds: Panel is in
%% writer mode, so its alternative of Question is panel_w(Panel), the ask
%% carrying the reader the program writes.
Ask      ::= ask(Constant, Question).
Question ::= panel_w(Panel).

%% A stochastic person, one profile in the one dimension, as the harness hands
%% it from the population's draw to the person process (population.glp).
Judging  ::= judge.
Profiles ::= profiles(Judging).

imported procedure harness#run(Integer?, Stream(YesNo)).
exported procedure panel_run(Integer?, Stream(YesNo)).
panel_run(N, As?) :- harness # run(N?, As).

%% The sGLP source in the term form, show_sglp.glp, for the transformation
%% (programs/sglp/transform.glp).
imported procedure show_sglp#source(SglpTerms, SglpTerms).
exported procedure source(SglpTerms, SglpTerms).
source(V?, S?) :- show_sglp # source(V, S).
