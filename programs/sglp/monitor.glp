%% The monitor of an sGLP run (sGLP's paper, the repository
%% svGLP-Stochastic-Volitional-GLP at 8c05210: Appendix C, "The Monitor", the
%% whole module; Section 4, "The guard", "The clock" and "The monitor";
%% Appendix B, "Implementation Notes").  It steps GLP's simulated clock
%% (GLP-ICLP, appendix-guards, "Simulated time (start_clock/1, rated/2,
%% step_clock/2)"), whose types Token and ClockStep are the root's.

Request ::= time(Number?).
Clock   ::= clock(Number).

%% monitor(Requests?, Seed?, Horizon?, Log?): the input stream, the clock's
%% seed, the horizon in seconds and the log's reference; it starts the
%% engine's clock with the seed, and its own at zero.
exported procedure monitor(Stream(Request)?, Integer?, Number?,
                           MutualRef?).
monitor(In, Seed, Horizon, Log) :-
    start_clock(Seed?),
    monitor_loop(In?, 0, Horizon?, Log?).

%% monitor_loop(Requests?, Clock?, Horizon?, Log?): a time request answered from
%% the clock of the last step; the step taken only when the machine rests.
procedure monitor_loop(Stream(Request)?, Number?, Number?, MutualRef?).
monitor_loop([time(Clock?)|In], Clock, Horizon, Log) :-
    monitor_loop(In?, Clock?, Horizon?, Log?).
monitor_loop(In, _, Horizon, Log) :-
    when_idle |
    step_clock(Horizon?, Step),
    stepped(Step?, In?, Horizon?, Log?).

%% stepped(Step?, Requests?, Horizon?, Log?): released(T) goes on with T as
%% the clock; stopped(C) writes clock(C) to the log and ends.
procedure stepped(ClockStep?, Stream(Request)?, Number?, MutualRef?).
stepped(released(T), In, Horizon, Log) :-
    monitor_loop(In?, T?, Horizon?, Log?).
stepped(stopped(Clock), _, _, Log) :-
    stream_append(clock(Clock?), Log?, _).
