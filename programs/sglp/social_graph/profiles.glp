,
wary_answer(Tok?, K?, C?)
.
procedure
wary_answer
(
Token?
,
Integer?
,
Card
?
)
.
wary_answer(go, K, card(_, yes))
:-
'=<'(K?, 20)
|
true
.
wary_answer(go, K, card(_, no))
:-
'>'(K?, 20)
|
true
.

