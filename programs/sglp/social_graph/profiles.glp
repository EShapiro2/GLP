%% person(wary)
%% binds(Approval, wary_approval)
exported procedure
wary_approval
(
Approval
?
,
Person
?
,
Integer?
,
MutualRef?
,
MutualRef?
)
.
wary_approval(C, _, S, Mon, _)
:-
random(S?, 100, K, _)
,
stream_append(rated('/'(1, day), Tok), Mon?, _)
,
wary_answer(Tok?, K?, C?)
.
procedure
wary_answer
(
Token?
,
Integer?
,
Approval
?
)
.
wary_answer(stop, _, _)
.
wary_answer(go, K, approval(_, yes))
:-
'=<'(K?, 20)
|
true
.
wary_answer(go, K, approval(_, no))
:-
'>'(K?, 20)
|
true
.

