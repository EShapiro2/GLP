%% person(homophile)
%% binds(Menu, homophile_menu)
exported procedure
homophile_menu
(
Menu
?
,
Integer?
,
MutualRef?
)
.
homophile_menu(M, S, Mon)
:-
random(S?, 100, K, S1)
,
stream_append(rated('/'(1, week), Tok), Mon?, _)
,
homophile_pick(Tok?, K?, S1?, M?)
.
procedure
homophile_pick
(
Token?
,
Integer?
,
Integer?
,
Menu
?
)
.
homophile_pick(go, K, S, menu(Ss, _, same(P?)))
:-
'=<'(K?, 98)
,
ground(Ss?)
|
one_of(Ss?, S?, P)
.
homophile_pick(go, K, S, menu(_, Os, other(P?)))
:-
'>'(K?, 98)
,
ground(Os?)
|
one_of(Os?, S?, P)
.

