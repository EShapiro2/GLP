%% The run of the Grassroots Social Graph (sGLP's paper, the repository
%% svGLP-Stochastic-Volitional-GLP: Section 4, "The run"; Section 5; Appendix
%% B): the machine's setup, written by hand, the population's draw and its
%% person processes being the transformation's (population.glp, printed from
%% the run declaration of graph_sglp.glp; sGLP's ruling of 2026-10-03 12:10
%% UTC).  The declaration, as Section 5 has it:
%%
%%   run 100 agents [ approach ~ (homophile : 0.6 ; indifferent : 0.4),
%%                    response ~ (wary : 0.7 ; sociable : 0.3) ]
%%       until 1 year seed 20260927.
%%
%% run(N, C, U, Seed, Hom, Wary) runs it with N agents until C Us from Seed, the
%% mix given by Hom and Wary, integers 0..100 (sGLP's code task of 2026-10-02
%% 15:23 UTC, item 1): an agent's first draw K, of 1..100, makes it homophile
%% for K =< Hom and indifferent otherwise, its second wary for K =< Wary and
%% sociable otherwise, so 0 is none and 100 is all: they are the thresholds of
%% the population's draw, stochastic_person/6 of population.glp, and the run
%% declaration's are 60 and 70, its declaration/6, which programs/sglp/self.glp's
%% social_graph/4 passes.  The persons are run N agents', drawn by its census,
%% person(a, agent, []) for a of 1..N, each agent's key its number (Section 3,
%% after Definition "Person, Census"; Appendix B; population.glp, persons/5),
%% and the run is refused where the census draws no person or a person of a
%% role of no dimension (Section 3, after Definition "Well-Formed").  The
%% whole population is in one machine, as the guard when_idle requires (Section
%% 4, "The guard").  Its goals:
%%
%%   at each agent a of 1..N, its start goal --- the compiled start/6, with a,
%%   its two lists in increasing order (agents 1..N/2 are of one sex and the
%%   rest of the other; the first list is the two agents of a's sex it knows at
%%   the start, the second the two of the other sex, drawn from its block;
%%   Section 5, Appendix B), its input and output streams and its ask stream
%%   --- its person process (population.glp, person/8), with its stochastic
%%   person, its person and its seed, reading that ask stream in the
%%   dispatcher's place, and its screen, on [], the program writing nothing to
%%   its person (Section 3, Definition "Simulation Program"; population.glp,
%%   start_screen/5);
%%   at no agent, the network --- the root's mwm/2 merging the agents' output
%%   streams, and a balanced tree of deliver/4 goals handing each message to the
%%   input stream of the agent it names --- the monitor, with the run's seed and
%%   the horizon in seconds, and the log's sink.
%%
%% In one machine a goal is at agent a by being one of a's: its start goal, its
%% person process, its screen, and the goals they spawn; no goal carries a place.
%%
%% The draws (Appendix B).  The monitor draws from the run's seed.  The
%% population's draws are from a second generator, started at the first value
%% drawn from the run's seed, split into blocks of 4096 consecutive draws:
%% agent a's block is the a-th, run N agents naming no census (Appendix B,
%% "Seeds").  Its first two draws pick a's profile in each dimension of its
%% role by the mix (population.glp, stochastic_person/6); the next is the
%% seed of its person process, a value of 1..2147483646 drawn from the seed
%% the profiles leave, random(S?, 2147483646, PSeed, S1), so that the person
%% process's draws are on a chain of their own, as the person process seeds
%% each person goal; and from S1 are drawn the two agents of a's sex it knows
%% at the start, then the two of the other sex, uniformly and without
%% replacement (known/6; sGLP's answer of 2026-10-16 13:40 UTC), whatever the
%% mix.  With fewer than 6 agents an agent would have fewer than two others of
%% its sex, so the run requires N even and at least 6.  An agent's draws stay within its block
%% while it answers fewer than about 4090 questions; past that they run into
%% the next agent's.
%%
%% The log's sink: the run's log is the output stream of a mutual reference that
%% every person process and the monitor append to; the harness hands it to the
%% root's send_to_user/1, which prints each entry, ground, on its own line, and
%% run.sh writes those lines to the log file it is given, tab-separated.

imported procedure graph#start(Peer?, Peers?, Peers?, Stream(Msg)?, Stream(Msg),
                               Stream(Ask)).
imported procedure population#persons(Integer?, Stream(Constant)?, Constant,
                                      List(Person), Integer).
imported procedure population#stochastic_person(Integer?, Person?, Integer?,
                                                Integer?, Profiles, Integer).
imported procedure(X) population#start_screen(Integer?, Stream(X)?, MutualRef?,
                                              MutualRef?, MutualRef).
imported procedure population#person(Integer?, Profiles?, Person?, MutualRef?,
                                     MutualRef?, Integer?, MutualRef?,
                                     Stream(Ask)?).

exported procedure run(Integer?, Number?, Span?, Integer?, Integer?, Integer?).
run(N, C, U, Seed, Hom, Wary) :-
    N? >= 6, N? mod 2 =:= 0,
    Hom? >= 0, Hom? =< 100, Wary? >= 0, Wary? =< 100 |
    random(Seed?, 2147483646, Base, _),
    numbers(1, N?, Ks),
    population # persons(Base?, Ks?, Ok, Ps, B),
    go(Ok?, Ps?, B?, N?, C?, U?, Seed?, Hom?, Wary?).

%% go(Ok?, Ps?, B?, N?, C?, U?, Seed?, Hom?, Wary?): the run of the persons Ps,
%% where the census's draw is not refused, B the start of the first agent's
%% block; refused, the run takes no goal but the line refused.
procedure go(Constant?, List(Person)?, Integer?, Integer?, Number?, Span?,
             Integer?, Integer?, Integer?).
go(yes, Ps, B, N, C, U, Seed, Hom, Wary) :-
    integer(N?) |
    span(U?, Secs),
    H := C? * Secs?,
    allocate_mutual_reference(Mon, Requests),
    allocate_mutual_reference(Log, Entries),
    send_to_user(Entries?),
    monitor(Requests?, Seed?, H?, Log?),
    Half := N? // 2,
    tree(1, N?, Net?, Ins, []),
    mwm(Merges?, Net),
    agents(1, Half?, N?, Ps?, B?, Hom?, Wary?, Ins?, Merges, Mon?, Log?).
go(no, _, _, _, _, _, _, _, _) :- send_to_user([refused]).

%% numbers(A?, N?, Ks): Ks the agents A..N, each agent's key its number (Appendix
%% B, "The agents are numbered").
procedure numbers(Integer?, Integer?, Stream(Constant)).
numbers(A, N, [A?|Ks?]) :- A? =< N? | A1 := A? + 1, numbers(A1?, N?, Ks).
numbers(A, N, []) :- A? > N? | true.

%% agents(A?, Half?, N?, Ps?, Block?, Hom?, Wary?, Ins?, Merges, Mon?, Log?):
%% agents A..N, Half being N/2, Ps their persons, Block the start of A's block,
%% Hom and Wary the mix, Ins their input streams in order, Merges their output
%% streams for mwm/2.
procedure agents(Integer?, Integer?, Integer?, List(Person)?, Integer?, Integer?,
                 Integer?, Stream(Stream(Msg))?, MwmInput(Msg), MutualRef?,
                 MutualRef?).
agents(A, H, N, [P|Ps], B, Hom, Wary, [In|Ins], [merge(Out?)|Ms?], Mon, Log) :-
    A? =< N?, ground(P?) |
    population # stochastic_person(B?, P?, Hom?, Wary?, Pr, S),
    random(S?, 2147483646, Seed, S1),
    known(A?, H?, N?, S1?, Ss, Os),
    graph # start(A?, Ss?, Os?, In?, Out, Asks),
    population # person(A?, Pr?, P?, Mon?, Scr?, Seed?, Log?, Asks?),
    population # start_screen(A?, [], Mon?, Log?, Scr),
    skip(4096, B?, B2),
    A1 := A? + 1,
    agents(A1?, H?, N?, Ps?, B2?, Hom?, Wary?, Ins?, Ms, Mon?, Log?).
agents(A, _, N, [], _, _, _, [], [], _, _) :-
    A? > N? | true.

%% The population's draw (sGLP's code tasks of 2026-10-02 15:44 UTC and
%% 2026-10-03 08:58 UTC).  draw(N?, Seed?, Hom?, Wary?, D): D is
%% draw(Homophile, Indifferent, Wary, Sociable, As), the numbers of agents of
%% 1..N of each profile in each dimension in the run of N agents from Seed with
%% the mix Hom and Wary, and As the list of agent(A, Approach, Response), A of
%% 1..N in order, each agent's profiles, without running it: each agent's
%% stochastic person drawn from its block by population.glp's
%% stochastic_person/6, as agents/11 draws it, of its person drawn by the
%% census, and counted as they are listed.  run.sh calls it in a REPL
%% session of its own, so that the run's machine is the same with it as
%% without, and its log the same.  tally/15 draws as agents/11 does, and a
%% change to the one is a change to the other.
exported procedure draw(Integer?, Integer?, Integer?, Integer?, Draw).
draw(N, Seed, Hom, Wary, draw(H?, I?, W?, S?, As?)) :-
    N? >= 6, N? mod 2 =:= 0,
    Hom? >= 0, Hom? =< 100, Wary? >= 0, Wary? =< 100 |
    random(Seed?, 2147483646, Base, _),
    numbers(1, N?, Ks),
    population # persons(Base?, Ks?, _, Ps, B),
    tally(1, N?, Ps?, B?, Hom?, Wary?, 0, 0, 0, 0, As, H, I, W, S).

%% tally(A?, N?, Ps?, Block?, Hom?, Wary?, H?, I?, W?, S?, As, H2, I2, W2, S2):
%% agents A..N, Ps their persons, Block the start of A's block, listed in As,
%% and added to H homophile, I indifferent, W wary and S sociable agents before
%% A, giving H2, I2, W2 and S2.
procedure tally(Integer?, Integer?, List(Person)?, Integer?, Integer?, Integer?,
                Integer?, Integer?, Integer?, Integer?, Drawn, Integer, Integer,
                Integer, Integer).
tally(A, N, [P|Ps], B, Hom, Wary, H, I, W, S, [agent(A?, Ap?, Re?)|As?],
      H2?, I2?, W2?, S2?) :-
    A? =< N?, ground(P?) |
    population # stochastic_person(B?, P?, Hom?, Wary?, Pr, _),
    profiles_of(Pr?, Ap1, Re1),
    add_approach(Ap1?, H?, I?, H1, I1, Ap),
    add_response(Re1?, W?, S?, W1, S1, Re),
    skip(4096, B?, B2),
    A1 := A? + 1,
    tally(A1?, N?, Ps?, B2?, Hom?, Wary?, H1?, I1?, W1?, S1?, As, H2, I2, W2,
          S2).
tally(A, N, [], _, _, _, H, I, W, S, [], H?, I?, W?, S?) :-
    A? > N? | true.

%% profiles_of(P?, Ap, Re): the profiles of the stochastic person P, of the
%% role agent.
procedure profiles_of(Profiles?, Approach, Response).
profiles_of(agent(Ap, Re), Ap?, Re?).

%% add_approach(Ap?, H?, I?, H1, I1, Ap1) and add_response(Re?, W?, S?, W1, S1,
%% Re1): one agent of the profile added to its count, the profile given back
%% for its line in the list.
procedure add_approach(Approach?, Integer?, Integer?, Integer, Integer,
                       Approach).
add_approach(homophile, H, I, H1?, I?, homophile) :- H1 := H? + 1.
add_approach(indifferent, H, I, H?, I1?, indifferent) :- I1 := I? + 1.
procedure add_response(Response?, Integer?, Integer?, Integer, Integer,
                       Response).
add_response(wary, W, S, W1?, S?, wary) :- W1 := W? + 1.
add_response(sociable, W, S, W?, S1?, sociable) :- S1 := S? + 1.

%% skip(J?, S?, S1): S1 is the seed J draws after S, by J draws of random/4,
%% each reduced before the next is spawned: the clause waits on its seed,
%% integer(S?), so an agent's block of 4096 draws is drawn one draw at a time
%% once the block's start is known, where the 4096 goals were spawned at once,
%% each suspended on the last (sGLP's code task of 2026-10-02 20:58 UTC, S1).
%% Not the closed form, the seed times 16807^4096 mod 2^31 - 1: that is the
%% engine's generator, and GLP-Spec says only that the next seed is determined
%% by the seed.
procedure skip(Integer?, Integer?, Integer).
skip(0, S, S?).
skip(J, S, S1?) :-
    J? > 0, integer(S?) |
    random(S?, 1, _, S2),
    J1 := J? - 1,
    skip(J1?, S2?, S1).

%% known(A?, H?, N?, S?, Ss, Os): Ss the two agents of A's sex, other than A,
%% and Os the two of the other sex that A knows at the start, each list in
%% increasing order, drawn from S in that order, agents 1..H being of one sex
%% and H+1..N of the other.
procedure known(Integer?, Integer?, Integer?, Integer?, NonEmpty(Integer),
                NonEmpty(Integer)).
known(A, H, N, S, Ss?, Os?) :-
    A? =< H? |
    H1 := H? + 1,
    two(1, H?, A?, S?, Ss, S2),
    two(H1?, N?, 0, S2?, Os, _).
known(A, H, N, S, Ss?, Os?) :-
    A? > H? |
    H1 := H? + 1,
    two(H1?, N?, A?, S?, Ss, S2),
    two(1, H?, 0, S2?, Os, _).

%% two(Lo?, Hi?, Self?, S?, L, S2): L two agents of Lo..Hi other than Self (0
%% for none), in increasing order, drawn uniformly and without replacement from
%% S, two draws of random/4, the first of the M agents and the second of the
%% M - 1 left, S2 the seed they leave.
procedure two(Integer?, Integer?, Integer?, Integer?, NonEmpty(Integer),
              Integer).
two(Lo, Hi, Self, S, L?, S2?) :-
    Self? > 0, Lo? < Hi? |
    M := Hi? - Lo?,
    M1 := Hi? - Lo? - 1,
    random(S?, M?, K1, S1),
    random(S1?, M1?, K2, S2),
    pair(Lo?, K1?, K2?, Self?, L).
two(Lo, Hi, Self, S, L?, S2?) :-
    Self? =:= 0, Lo? < Hi? |
    M := Hi? - Lo? + 1,
    M1 := Hi? - Lo?,
    random(S?, M?, K1, S1),
    random(S1?, M1?, K2, S2),
    pair(Lo?, K1?, K2?, Self?, L).

%% pair(Lo?, K1?, K2?, Self?, L): the K1-th agent from Lo other than Self, X,
%% and the K2-th other than Self and X, in increasing order.
procedure pair(Integer?, Integer?, Integer?, Integer?, NonEmpty(Integer)).
pair(Lo, K1, K2, Self, L?) :-
    integer(Lo?), integer(Self?) |
    X0 := Lo? - 1 + K1?,
    bump(X0?, Self?, X),
    Y0 := Lo? - 1 + K2?,
    second(Y0?, Self?, X?, L).

%% second(Y0?, Self?, X?, L): Y0 moved past Self and X, in increasing order,
%% and paired with X.
procedure second(Integer?, Integer?, Integer?, NonEmpty(Integer)).
second(Y0, Self, X, L?) :-
    integer(Self?), integer(X?), Self? < X? |
    bump(Y0?, Self?, Y1),
    bump(Y1?, X?, Y),
    sorted(X?, Y?, L).
second(Y0, Self, X, L?) :-
    integer(Self?), integer(X?), Self? > X? |
    bump(Y0?, X?, Y1),
    bump(Y1?, Self?, Y),
    sorted(X?, Y?, L).

%% bump(V?, E?, V1): V1 is V + 1 where 0 < E =< V, and V otherwise: the V-th
%% agent counted past an excluded agent E.
procedure bump(Integer?, Integer?, Integer).
bump(V, E, V1?) :- E? > 0, E? =< V? | V1 := V? + 1.
bump(V, E, V?) :- E? =< 0 | true.
bump(V, E, V?) :- E? > V? | true.

%% sorted(X?, Y?, L): L is [X, Y] in increasing order.
procedure sorted(Integer?, Integer?, NonEmpty(Integer)).
sorted(X, Y, [X?, Y?]) :- X? < Y? | true.
sorted(X, Y, [Y?, X?]) :- X? > Y? | true.

%% The network.  tree(Lo?, Hi?, Ms?, Ins, Rest?): a balanced tree of deliver/4
%% goals over agents Lo..Hi routing the messages Ms, Ins being the input streams
%% of agents Lo..Hi in order, followed by Rest.
procedure tree(Integer?, Integer?, Stream(Msg)?, Stream(Stream(Msg)),
               Stream(Stream(Msg))?).
tree(Lo, Hi, Ms, [Ms?|Rest?], Rest) :-
    Lo? =:= Hi? | true.
tree(Lo, Hi, Ms, Ins?, Rest) :-
    Lo? < Hi? |
    Mid := (Lo? + Hi?) // 2,
    Mid1 := Mid? + 1,
    deliver(Ms?, Mid?, L, R),
    tree(Lo?, Mid?, L?, Ins, Ins1?),
    tree(Mid1?, Hi?, R?, Ins1, Rest?).

%% deliver(Ms?, Mid?, Ls, Hs) sends each message of Ms addressed to an agent
%% numbered Mid or less to Ls, and each other to Hs (graph.vglp at GLP
%% 723d1602).
procedure deliver(Stream(Msg)?, Integer?, Stream(Msg), Stream(Msg)).
deliver([msg(To, C)|Ms], Mid, [msg(To?, C?)|Ls?], Hs?) :-
    To? =< Mid? | deliver(Ms?, Mid?, Ls, Hs).
deliver([msg(To, C)|Ms], Mid, Ls?, [msg(To?, C?)|Hs?]) :-
    To? > Mid? | deliver(Ms?, Mid?, Ls, Hs).
deliver([], _, [], []).
