%% The person process (sGLP's paper, Section 4, "The person process").
exported procedure person(Integer?, Profiles?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, profiles(homophile, D2), Mon, Seed, Log, [ask(Type, menu_w(menu(X1, X2, X3?))) | As])
:-
ground(X1?)
,
ground(X2?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
homophile_menu(menu(X1?, X2?, Y3), K?, Mon?)
,
answer_1(A?, Type?, X1?, X2?, Y3?, X3, Mon?, Log?)
,
person(A?, profiles(homophile, D2?), Mon?, S?, Log?, As?)
.
person(A, profiles(indifferent, D2), Mon, Seed, Log, [ask(Type, menu_w(menu(X1, X2, X3?))) | As])
:-
ground(X1?)
,
ground(X2?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
indifferent_menu(menu(X1?, X2?, Y3), K?, Mon?)
,
answer_1(A?, Type?, X1?, X2?, Y3?, X3, Mon?, Log?)
,
person(A?, profiles(indifferent, D2?), Mon?, S?, Log?, As?)
.
person(A, profiles(D1, wary), Mon, Seed, Log, [ask(Type, card_w(card(X1, X2?))) | As])
:-
ground(X1?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
wary_card(card(X1?, Y2), K?, Mon?)
,
answer_2(A?, Type?, X1?, Y2?, X2, Mon?, Log?)
,
person(A?, profiles(D1?, wary), Mon?, S?, Log?, As?)
.
person(A, profiles(D1, sociable), Mon, Seed, Log, [ask(Type, card_w(card(X1, X2?))) | As])
:-
ground(X1?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
sociable_card(card(X1?, Y2), K?, Mon?)
,
answer_2(A?, Type?, X1?, Y2?, X2, Mon?, Log?)
,
person(A?, profiles(D1?, sociable), Mon?, S?, Log?, As?)
.
person(_, _, _, _, _, []).

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
Peers
?
,
Peers
?
,
Choice
?
,
Choice
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, X1, X2, Y3, Y3?, Mon, Log)
:-
ground(Y3?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, menu(X1?, X2?, Y3?)), Log?, _)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_2
(
Integer?
,
Constant?
,
Peer
?
,
YesNo
?
,
YesNo
,
MutualRef?
,
MutualRef?
)
.
answer_2(A, Type, X1, Y2, Y2?, Mon, Log)
:-
ground(Y2?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, card(X1?, Y2?)), Log?, _)
.

