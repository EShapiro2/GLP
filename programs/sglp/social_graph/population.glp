.
declaration(100, 1, year, 20260927, 60, 70)
.

%% An agent's stochastic person, drawn from its block (Appendix B).
exported procedure
stochastic_person
(
Integer?
,
Integer?
,
Integer?
,
Profiles
,
Integer
)
.
stochastic_person(B, T1, T2, profiles(P1?, P2?), S?)
:-
random(B?, 100, K1, B1)
,
random(B1?, 100, K2, S)
,
approach(K1?, T1?, P1)
,
response(K2?, T2?, P2)
.

%% The draw of the dimension(approach)
procedure
approach
(
Integer?
,
Integer?
,
Dimension1
)
.
approach(K, T1, homophile)
:-
'=<'(K?, T1?)
|
true
.
approach(K, T1, indifferent)
:-
'>'(K?, T1?)
|
true
.

%% The draw of the dimension(response)
procedure
response
(
Integer?
,
Integer?
,
Dimension2
)
.
response(K, T1, wary)
:-
'=<'(K?, T1?)
|
true
.
response(K, T1, sociable)
:-
'>'(K?, T1?)
|
true
.
