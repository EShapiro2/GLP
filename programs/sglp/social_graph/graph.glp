%% The Grassroots Social Graph's compiled program, written by hand: the
%% canonical compilation of graph.vglp, the vGLP program of sGLP's paper,
%% Section 5, by vGLP's Definition "Canonical Compilation"
%% (sections/elicitation.tex), clause for clause (README.md, "The vGLP sources
%% and their compilation").  The types, graph.vglp's and the type of the asks
%% the compilation adds, are the directory's (self.glp).  The construct
%% processes and the dispatcher are not here: in a simulation the person
%% process reads the ask stream of the agent's initial goal in their place
%% (sGLP's paper, Section 3, Definition "Simulation Program"; Section 4, "The
%% person process"), population.glp's person/6, printed by the transformation.
%%
%% Every procedure of graph.vglp reaches a question --- ask and respond are
%% volitional, and agent and start call them --- so each has one more
%% argument, last, its ask stream, which its goal writes: in a clause, each
%% call of a procedure that reaches a question is given a fresh writer, D1,
%% D2, as its ask stream, and the head carries D?, D the clause's ask stream,
%% the call given D itself where there is one such call and merge(D1?, D2?, D)
%% merging the two where there are two; the guarded clauses, ask1 and
%% respond1, call none, and carry [] in place of D?.
%%
%% Each volitional procedure q keeps its name for its asking clause, which every
%% call of q reaches unchanged, and its clauses as guarded clauses take the
%% fresh name q1, ask1 and respond1 (vGLP, Definition "Canonical Compilation").
%% The asking clause writes the ask ask(T, t(X?)) on its ask stream, T the
%% interactive type as a constant and t the functor the compilation gives it,
%% the type's name in lowercase with _w for writer mode, menu_w and card_w,
%% and calls q1 with X and its own ask stream: Menu and Card are in writer
%% mode, so the guarded clause takes the writer X and the ask carries X?
%% (README.md, "The vGLP sources and their compilation").

%% (Menu)*ask(Ss, Os, C?): the asking clause and the guarded clause.
procedure ask(Peers?, Peers?, Choice, Stream(Ask)).
ask(Ss, Os, C?, [ask('Menu', menu_w(X?))|D?]) :- ask1(Ss?, Os?, C, X, D).
procedure ask1(Peers?, Peers?, Choice, Menu, Stream(Ask)).
ask1(Ss, Os, C?, menu(Ss?, Os?, C), []).

%% (Card)*respond(From, A?): the asking clause and the guarded clause.
procedure respond(Peer?, YesNo, Stream(Ask)).
respond(From, A?, [ask('Card', card_w(X?))|D?]) :- respond1(From?, A, X, D).
procedure respond1(Peer?, YesNo, Card, Stream(Ask)).
respond1(From, A?, card(From?, A), []).

procedure agent(Peer?, Peers?, Peers?, Choice?,
                Stream(Msg)?, Stream(Msg), Stream(Ask)).

%% The person picked a peer: offer, and ask again.
agent(Id, Ss, Os, same(To), NetIn, [msg(To?, offer(Id?))|Outs?], D?) :-
    ground(Id?), ground(Ss?), ground(Os?), ground(To?) |
    ask(Ss?, Os?, Pick, D1),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs, D2),
    merge(D1?, D2?, D).
agent(Id, Ss, Os, other(To), NetIn, [msg(To?, offer(Id?))|Outs?], D?) :-
    ground(Id?), ground(Ss?), ground(Os?), ground(To?) |
    ask(Ss?, Os?, Pick, D1),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs, D2),
    merge(D1?, D2?, D).

%% An offer arrives: put it to the person, and reply.
agent(Id, Ss, Os, Pick, [msg(_, offer(From))|NetIn],
      [msg(From?, reply(Id?, A?))|Outs?], D?) :-
    ground(Id?), ground(From?) |
    respond(From?, A, D1),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs, D2),
    merge(D1?, D2?, D).

%% A reply to my offer arrives.
agent(Id, Ss, Os, Pick, [msg(_, reply(_, _))|NetIn], Outs?, D?) :-
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs, D).

%% The initial goal of an agent: ask the first menu.
exported procedure start(Peer?, Peers?, Peers?, Stream(Msg)?, Stream(Msg),
                         Stream(Ask)).
start(Id, Ss, Os, NetIn, Outs?, D?) :- ground(Ss?), ground(Os?) |
    ask(Ss?, Os?, Pick, D1),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs, D2),
    merge(D1?, D2?, D).
