%% The Grassroots Social Graph in sGLP: the example of sGLP's paper (the
%% repository svGLP-Stochastic-Volitional-GLP at 8ddff2e, sections/example.tex,
%% "Example: The Grassroots Social Graph"; the language, sections/sglp.tex; the
%% population, the simulation program and the log, sections/simulation.tex).
%%
%% In order: the paper's vGLP program, verbatim but for one word --- its eight
%% types, its two volitional procedures, the agent and its initial goal
%% start/5, declared `exported` here, as an entry point of a directory program
%% must be; one_of, which the paper declares and leaves to the repository, and
%% length and nth, which one_of calls; the network, the harness's goals at no
%% agent; the paper's four kinds and its run declaration, verbatim.
%%
%% The harness, run.sh, posts the initial goal goal.awk writes: one
%% conjunction, start(a, Ss, Os, Ia?, Ua) at each agent a of 1..n, agents
%% 1..n/2 of one sex and the rest of the other, Ss the other agents of a's sex
%% and Os the agents of the other sex, each in increasing order; and at no
%% agent, the root's mwm/2 merging the agents' output streams and a tree of
%% deliver/4 goals handing each message to the input stream of the agent it is
%% addressed to.  friendship.awk reads the run's log and writes the friendship
%% graph (Definition "Friendship Graph of a Run").

Peer    ::= Constant.
YesNo   ::= yes ; no.
Peers   ::= [] ; [Peer | Peers].
Choice  ::= same(Peer) ; other(Peer).
Menu    ::= menu(Peers, Peers, Choice?).
Card    ::= card(Peer, YesNo?).
Content ::= offer(Peer) ; reply(Peer, YesNo).
Msg     ::= msg(Peer, Content).

%% Show the person both lists, and hand them the choice.
procedure (Menu)*ask(Peers?, Peers?, Choice).
(menu(Ss?, Os?, C))*ask(Ss, Os, C?).

%% Show the person who offers, and hand them yes or no.
procedure (Card)*respond(Peer?, YesNo).
(card(From?, A))*respond(From, A?).

procedure agent(Peer?, Peers?, Peers?, Choice?,
                Stream(Msg)?, Stream(Msg)).

%% The person picked a peer: offer, and ask again.
agent(Id, Ss, Os, same(To), NetIn, [msg(To?, offer(Id?))|Outs?]) :-
    ground(Id?), ground(Ss?), ground(Os?), ground(To?) |
    ask(Ss?, Os?, Pick),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).
agent(Id, Ss, Os, other(To), NetIn, [msg(To?, offer(Id?))|Outs?]) :-
    ground(Id?), ground(Ss?), ground(Os?), ground(To?) |
    ask(Ss?, Os?, Pick),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).

%% An offer arrives: put it to the person, and reply.
agent(Id, Ss, Os, Pick, [msg(_, offer(From))|NetIn],
      [msg(From?, reply(Id?, A?))|Outs?]) :-
    ground(Id?), ground(From?) |
    respond(From?, A),
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).

%% A reply to my offer arrives.
agent(Id, Ss, Os, Pick, [msg(_, reply(_, _))|NetIn], Outs?) :-
    agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).

%% The initial goal of an agent: ask the first menu.
exported procedure start(Peer?, Peers?, Peers?, Stream(Msg)?, Stream(Msg)).
start(Id, Ss, Os, NetIn, Outs?) :- ground(Ss?), ground(Os?) |
    ask(Ss?, Os?, Pick), agent(Id?, Ss?, Os?, Pick?, NetIn?, Outs).

%% one_of(Xs?, S?, X) draws X uniformly from the list Xs by random from the
%% seed S: the paper declares it, Section 5, and leaves it to the repository.
procedure(X) one_of(Stream(X)?, Integer?, X).
one_of(Xs, S, X?) :- ground(Xs?) |
    length(Xs?, N), random(S?, N?, K, _), nth(K?, Xs?, X).

%% length(Xs?, N): N is the number of elements of Xs.
procedure(X) length(Stream(X)?, Integer).
length([], 0).
length([_|Xs], N?) :- length(Xs?, N1), N := N1? + 1.

%% nth(K?, Xs?, X): X is the K-th element of Xs, counting from 1.  Past the
%% end of Xs nothing is assigned to X.
procedure(X) nth(Integer?, Stream(X)?, X).
nth(1, [X|_], X?).
nth(K, [_|Xs], X?) :- K? > 1 | K1 := K? - 1, nth(K1?, Xs?, X).
nth(_, [], X?) :- true.

%% The network: the harness's, its goals at no agent.  deliver(Ms?, Mid?, Ls,
%% Hs) sends each message of Ms addressed to an agent numbered Mid or less to
%% Ls, and each other to Hs; the harness posts a tree of them over 1..n.
exported procedure deliver(Stream(Msg)?, Integer?, Stream(Msg), Stream(Msg)).
deliver([msg(To, C)|Ms], Mid, [msg(To?, C?)|Ls?], Hs?) :-
    To? =< Mid? | deliver(Ms?, Mid?, Ls, Hs).
deliver([msg(To, C)|Ms], Mid, Ls?, [msg(To?, C?)|Hs?]) :-
    To? > Mid? | deliver(Ms?, Mid?, Ls, Hs).
deliver([], _, [], []).

person homophile.
Menu =::= homophile_menu.
procedure homophile_menu(Menu?, Integer?).
homophile_menu(M, S) :-
    random(S?, 100, K, S1), homophile_pick(K?, S1?, M?) @ 1/week.
procedure homophile_pick(Integer?, Integer?, Menu?).
homophile_pick(K, S, menu(Ss, _, same(P?))) :-
    K? =< 98, ground(Ss?) | one_of(Ss?, S?, P).
homophile_pick(K, S, menu(_, Os, other(P?))) :-
    K? > 98, ground(Os?) | one_of(Os?, S?, P).

person indifferent.
Menu =::= indifferent_menu.
procedure indifferent_menu(Menu?, Integer?).
indifferent_menu(M, S) :-
    random(S?, 100, K, S1), indifferent_pick(K?, S1?, M?) @ 2/week.
procedure indifferent_pick(Integer?, Integer?, Menu?).
indifferent_pick(K, S, menu(Ss, _, same(P?))) :-
    K? =< 50, ground(Ss?) | one_of(Ss?, S?, P).
indifferent_pick(K, S, menu(_, Os, other(P?))) :-
    K? > 50, ground(Os?) | one_of(Os?, S?, P).

person wary.
Card =::= wary_card.
procedure wary_card(Card?, Integer?).
wary_card(C, S) :-
    random(S?, 100, K, _), wary_answer(K?, C?) @ 1/day.
procedure wary_answer(Integer?, Card?).
wary_answer(K, card(_, yes)) :- K? =< 20 | true.
wary_answer(K, card(_, no))  :- K? > 20  | true.

person sociable.
Card =::= sociable_card.
procedure sociable_card(Card?, Integer?).
sociable_card(C, S) :-
    random(S?, 100, K, _), sociable_answer(K?, C?) @ 1/hour.
procedure sociable_answer(Integer?, Card?).
sociable_answer(K, card(_, yes)) :- K? =< 90 | true.
sociable_answer(K, card(_, no))  :- K? > 90  | true.

run 1000 agents [ approach ~ (homophile : 0.6 ; indifferent : 0.4),
                  response ~ (wary : 0.7 ; sociable : 0.3) ]
    until 5 years seed 20260927.
