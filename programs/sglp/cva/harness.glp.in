%% The harness of every canonical CVA platform under sGLP (sGLP's task of
%% 2026-10-18 20:50 UTC, item 2, and of 2026-10-20 08:00 UTC, items 1 and 4;
%% sGLP's paper at 0270ac6: Section 3, Definitions "Person, Census", "Screen,
%% Seen", "Person Process" and "Simulation Program"; Section 4, "The run",
%% "The screen" and "The log"; Appendix B): the
%% machine's setup, written once, for the canonical platform of any contract,
%% its module platform.glp beside it, and the printed population of any sGLP
%% source over that platform's questions, population.glp beside it.  The whole
%% population is in one machine, as the guard when_idle requires (Section 4,
%% "The guard").  Its goals:
%%
%%   at each agent a of 1..N, the persons of the run numbered in the order its
%%   census draws them and each keyed by its person's key (sGLP's paper,
%%   Section 3, Definition "Person, Census", and after it; population.glp,
%%   persons/5): its initial goal as vGLP's compilation of the canonical
%%   platform states it, agent/5 of the platform's module with its key, its
%%   input stream from the network, its output stream to the network, the
%%   program's output to its person, and its ask stream (vGLP, Section 5.4,
%%   "The compilation"); its screen on the program's output to its person and
%%   its person process on that ask stream, the dispatcher's place being the
%%   person process's and the person's screen the screen (Definition
%%   "Simulation Program"), with its stochastic person, its person and its
%%   seed, population.glp's stochastic_agent/7;
%%   at no agent, the network --- the root's mwm/2 merging the agents' output
%%   streams, and a balanced tree of deliver/4 goals handing each message
%%   msg(Q, C) to the input stream of the agent keyed Q, as the examples'
%%   networks do, a message to a key of no agent of the run delivered to none
%%   (GLP-Spec, the transaction Cold-call, which moves a message to the agent
%%   it names) --- the monitor, with the run's seed and the horizon in seconds,
%%   and the log's sink.
%%
%% The persons: where the run declaration gives a number of agents, the census
%% of run n agents, person(K, agent, []) for each key K of Ks, the run script's:
%% Key is String, which GLP makes of no number, so run.sh writes them, agent
%% a's the letter p and a's number, zero-padded to the width of N, so that the
%% keys of agents 1..N are in the order of their numbers both ways, which the
%% tree's comparisons, @<, take; where it names a census, the persons that
%% census draws, Ks being empty, the keys their keys, in the census's order,
%% which need not be @<'s: the network sorts the keys and the seats together
%% by @< before it builds the tree, so a message to a key reaches the agent of
%% that key.  The run is refused where
%% the census draws no person or a person of a role of no dimension (Section 3,
%% after Definition "Well-Formed"): it takes no goal but the line refused.  The
%% draws are the examples' (Appendix B): the monitor draws from the run's seed;
%% the population's draws are from a second generator, started at the first
%% value drawn from the run's seed and cut into blocks of 4096 draws, a census
%% the run declaration names drawing from the first and agent a from the a-th
%% after it, or the a-th where it gives a number of agents, from which
%% population.glp draws its profiles and its person process's seed.  The
%% persons stay in population.glp, their type the source's: it hands the
%% harness each agent's key and its seat, seat(K, Asks, Thr), the writers of
%% the agent's ask stream and of the program's output to its person, whose
%% readers its person process and its screen hold (population.glp,
%% cva_agents/6).

%% An agent's seat, structurally population.glp's, Ask(Question) being the
%% platform's asks, as population.glp's Ask.
Seat(X) ::= seat(Key, Stream(Ask(Question))?, Stream(X)?).

imported procedure population#cva_check(Integer?, Stream(Key)?, Constant).
imported procedure(X) population#cva_agents(Integer?, Stream(Key)?, MutualRef?,
                                            MutualRef?, Stream(Key),
                                            Stream(Seat(X))).
imported procedure population#cva_draw(Integer?, Stream(Key)?, Stream(_)).

%% run(Ks?, C?, U?, Seed?): the run of the run declaration's persons until C
%% Us from Seed, Ks the keys of run n agents, or empty where it names a census.
exported procedure run(Stream(Key)?, Number?, Span?, Integer?).
run(Ks, C, U, Seed) :- ground(Ks?), number(C?), integer(Seed?) |
    random(Seed?, 2147483646, Base, _),
    population # cva_check(Base?, Ks?, Ok),
    go(Ok?, Base?, Ks?, C?, U?, Seed?).

%% go(Ok?, B?, Ks?, C?, U?, Seed?): the run, where the census's draw is not
%% refused, B the start of the census's block or of the first agent's.
procedure go(Constant?, Integer?, Stream(Key)?, Number?, Span?, Integer?).
go(yes, B, Ks, C, U, Seed) :- integer(B?), ground(Ks?), number(C?), integer(Seed?) |
    span(U?, Secs),
    H := C? * Secs?,
    allocate_mutual_reference(Mon, Requests),
    allocate_mutual_reference(Log, Entries),
    send_to_user(Entries?),
    monitor(Requests?, Seed?, H?, Log?),
    population # cva_agents(B?, Ks?, Mon?, Log?, Keys, Seats),
    network(Keys?, Seats?).
go(no, _, _, _, _, _) :- send_to_user([refused]).

%% network(Ks?, Ss?): the network over the agents keyed Ks, and at each agent
%% its initial goal on its seat of Ss.  The tree routes by @<, so it is built
%% over the keys sorted by @< and the seats sorted with them, each agent's
%% input stream kept with its key: a census's keys are in its own order, which
%% need not be @<'s, and a message to the key K reaches the agent keyed K
%% (GLP-Spec, the transaction Cold-call).  Keys p1..pN zero-padded are
%% already in @< order, and sorting leaves them as they are.
procedure network(Stream(Key)?, Stream(Seat(Output))?).
network(Ks, Ss) :- ground(Ks?) |
    sort_keys(Ks?, [], SKs),
    sort_seats(Ss?, [], SSs),
    keys_length(Ks?, 0, N),
    tree(1, N?, SKs?, Net?, Ins, []),
    mwm(Merges?, Net),
    agents(SSs?, Ins?, Merges).

%% agents(Ss?, Ins?, Merges): at each agent, its initial goal, agent/5 of the
%% platform, with its key, its input stream of Ins, its output stream for
%% mwm/2, and the program's output to its person and its ask stream, the
%% writers its seat holds.
procedure agents(Stream(Seat(Output))?, Stream(Stream(Net))?, MwmInput(Net)).
agents([seat(K, Asks?, Thr?)|Ss], [In|Ins], [merge(Out?)|Ms?]) :-
    agent(K?, In?, Out, Thr, Asks),
    agents(Ss?, Ins?, Ms).
agents([], [], []).

%% draw(Ks?, Seed?, D): D the list of agent(A, P), each agent's stochastic
%% person P, A of 1..N in order, the persons' order, drawn from its block as
%% cva_agents/6 draws it, without the run.
exported procedure draw(Stream(Key)?, Integer?, Stream(_)).
draw(Ks, Seed, D?) :- ground(Ks?), integer(Seed?) |
    random(Seed?, 2147483646, Base, _),
    population # cva_draw(Base?, Ks?, D).

%% keys_length(Ks?, A?, N): N is A plus the number of keys in Ks.
procedure keys_length(Stream(Key)?, Integer?, Integer).
keys_length([], A, A?).
keys_length([_|Ks], A, N?) :- A1 := A? + 1, keys_length(Ks?, A1?, N).

%% sort_keys(Ks?, Acc?, Sorted): Sorted is the keys of Ks inserted, in order,
%% into Acc, sorted by @<; sort_seats(Ss?, Acc?, Sorted) the seats of Ss so,
%% by their keys.  Each inserts a key or a seat before the first of Acc whose
%% key it precedes or equals, so the two put keys and seats in one order.
procedure sort_keys(Stream(Key)?, Stream(Key)?, Stream(Key)).
sort_keys([K|Ks], Acc, Sorted?) :- insert_key(K?, Acc?, Acc1), sort_keys(Ks?, Acc1?, Sorted).
sort_keys([], Acc, Acc?).

procedure insert_key(Key?, Stream(Key)?, Stream(Key)).
insert_key(K, [K1|Ks], [K1?|Out?]) :- ground(K?), ground(K1?), K1? @< K? |
    insert_key(K?, Ks?, Out).
insert_key(K, [K1|Ks], [K?, K1?|Ks?]) :- ground(K?), ground(K1?), K? @< K1? | true.
insert_key(K, [K1|Ks], [K?, K1?|Ks?]) :- ground(K?), ground(K1?), K? =?= K1? | true.
insert_key(K, [], [K?]).

procedure sort_seats(Stream(Seat(Output))?, Stream(Seat(Output))?, Stream(Seat(Output))).
sort_seats([S|Ss], Acc, Sorted?) :- insert_seat(S?, Acc?, Acc1), sort_seats(Ss?, Acc1?, Sorted).
sort_seats([], Acc, Acc?).

procedure insert_seat(Seat(Output)?, Stream(Seat(Output))?, Stream(Seat(Output))).
insert_seat(seat(K, A?, T?), [seat(K1, A1?, T1?)|Ss], [seat(K1?, A1, T1)|Out?]) :-
    ground(K?), ground(K1?), K1? @< K? |
    insert_seat(seat(K?, A, T), Ss?, Out).
insert_seat(seat(K, A?, T?), [seat(K1, A1?, T1?)|Ss], [seat(K?, A, T), seat(K1?, A1, T1)|Ss?]) :-
    ground(K?), ground(K1?), K? @< K1? | true.
insert_seat(seat(K, A?, T?), [seat(K1, A1?, T1?)|Ss], [seat(K?, A, T), seat(K1?, A1, T1)|Ss?]) :-
    ground(K?), ground(K1?), K? =?= K1? | true.
insert_seat(S, [], [S?]).

%% nth_key(I?, Ks?, K): K is the I-th of Ks.
procedure nth_key(Integer?, Stream(Key)?, Key).
nth_key(1, [K|_], K?).
nth_key(I, [_|Ks], K?) :- I? > 1 | I1 := I? - 1, nth_key(I1?, Ks?, K).
nth_key(_, [], none).

%% The network.  tree(Lo?, Hi?, Ks?, Ms?, Ins, Rest?): a balanced tree of
%% deliver/4 goals over agents Lo..Hi, Ks the keys of all the agents, routing
%% the messages Ms, Ins being the input streams of agents Lo..Hi in order,
%% followed by Rest.
procedure tree(Integer?, Integer?, Stream(Key)?, Stream(Net)?,
               Stream(Stream(Net)), Stream(Stream(Net))?).
tree(Lo, Hi, Ks, Ms, [In?|Rest?], Rest) :-
    Lo? =:= Hi?, ground(Ks?) |
    nth_key(Lo?, Ks?, K),
    leaf(Ms?, K?, In).
tree(Lo, Hi, Ks, Ms, Ins?, Rest) :-
    Lo? < Hi?, ground(Ks?) |
    Mid := (Lo? + Hi?) // 2,
    Mid1 := Mid? + 1,
    nth_key(Mid?, Ks?, MK),
    deliver(Ms?, MK?, L, R),
    tree(Lo?, Mid?, Ks?, L?, Ins, Ins1?),
    tree(Mid1?, Hi?, Ks?, R?, Ins1, Rest?).

%% deliver(Ms?, Mid?, Ls, Hs) sends each message of Ms addressed to a key
%% that is Mid or precedes it to Ls, and each other to Hs.
procedure deliver(Stream(Net)?, Key?, Stream(Net), Stream(Net)).
deliver([msg(To, C)|Ms], Mid, [msg(To?, C?)|Ls?], Hs?) :-
    To? =?= Mid? | deliver(Ms?, Mid?, Ls, Hs).
deliver([msg(To, C)|Ms], Mid, [msg(To?, C?)|Ls?], Hs?) :-
    To? @< Mid? | deliver(Ms?, Mid?, Ls, Hs).
deliver([msg(To, C)|Ms], Mid, Ls?, [msg(To?, C?)|Hs?]) :-
    Mid? @< To? | deliver(Ms?, Mid?, Ls, Hs).
deliver([], _, [], []).

%% leaf(Ms?, K?, In): the messages of Ms addressed to the agent keyed K, its
%% input stream In; one addressed to another key, of no agent of the run, is
%% dropped.
procedure leaf(Stream(Net)?, Key?, Stream(Net)).
leaf([msg(To, C)|Ms], K, [msg(To?, C?)|In?]) :- To? =?= K? | leaf(Ms?, K?, In).
leaf([msg(To, _)|Ms], K, In?) :- To? =?\= K? | leaf(Ms?, K?, In).
leaf([], _, []).
