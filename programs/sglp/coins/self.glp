%% Coins among friends in sGLP (sGLP's paper, the repository
%% svGLP-Stochastic-Volitional-GLP, Section 6, "Example: Coins Among Friends";
%% Section 4, "The transformation"; sGLP's code task of 2026-10-02 15:24 UTC):
%% this directory's interface and the vGLP program's types.
%%
%%   coins_sglp.glp  the sGLP source in the term form (programs/sglp/README.md),
%%                request, issuer, its profiles and its run declaration, and the
%%                vGLP program's interface the transformation reads;
%%   coins.vglp   the vGLP program of Section 6, its types and volitional
%%                procedures as Section 6 prints them, and the agent's clauses
%%                and the wallet's held, add and take as it and Appendix B
%%                describe them;
%%   coins.glp    its canonical compilation (vGLP, Definition "Canonical
%%                Compilation"), written by hand, vGLP's compilation being
%%                vGLP's and not the transformation's;
%%   profiles.glp the four profiles translated, with request and issuer, and
%%   population.glp  the person process, the run declaration and each agent's
%%                stochastic person: both printed by programs/sglp/transform.sh
%%                from coins_sglp.glp, and not edited;
%%   harness.glp  the run: the network, the monitor, the log's sink and each
%%                agent's initial goal, the machine's setup, by hand; and the
%%                population's draw, without running it;
%%   run.sh       a run through the REPL on a friendship graph, its log and its
%%                circulation;
%%   circulation.awk  the circulation from a run's log, at the end of each month.
%%
%% The run is a program of programs/sglp, the directory above; load
%% programs/sglp and call coins/7 there.

%% The vGLP program's types: Peer, Peers and YesNo the social graph's
%% (social_graph/self.glp); Holding, Wallet, Request, Menu and Offer the
%% paper's (Section 6); Content and Msg this directory's own (the task, item 1):
%% pay(From, K) is K of the recipient's own coins, which it redeems; coins(From,
%% K) is K of From's own coins, which the recipient holds; propose(From, K) and
%% decline(From) are a swap proposed and declined.
Peer    ::= Constant.
YesNo   ::= yes ; no.
Peers   ::= [] ; [Peer | Peers].
Holding ::= holding(Peer, Integer).
Wallet  ::= [] ; [Holding | Wallet].
Request ::= pay(Peer, Integer) ; swap(Peer, Integer).
Menu    ::= menu(Peers, Wallet, Request?).
Offer   ::= offer(Peer, Integer, Integer, YesNo?).
Content ::= pay(Peer, Integer) ; coins(Peer, Integer) ; propose(Peer, Integer)
          ; decline(Peer).
Msg     ::= msg(Peer, Content).

%% The friends of agents 1..N, agent a's the a-th list, in increasing order.
Friends ::= [] ; [Peers | Friends].

%% The type of the asks, which the canonical compilation adds (vGLP,
%% Definition "Canonical Compilation"): an ask, ask(T, t(X)), is the
%% interactive type T as a constant and, under the functor t the compilation
%% gives T, the person's end X of the question's interactive variable;
%% Question is the union over those functors, each type in its mode, Menu and
%% Offer being in writer mode.  t is the functor of T's one alternative
%% (coins.glp).  The harness hands the ask stream of each agent's start goal
%% to its person process (population.glp, person/6).
Ask      ::= ask(Constant, Question).
Question ::= menu(Menu) ; offer(Offer).

%% A stochastic person, one profile per dimension, as the harness hands it from
%% the population's draw to the person process (population.glp): Spending and
%% Credit are programs/sglp/self.glp's.
Profiles ::= profiles(Spending, Credit).

imported procedure harness#run(Integer?, Friends?, Number?, Span?, Integer?,
                               Integer?, Integer?).
imported procedure harness#draw(Integer?, Integer?, Integer?, Integer?,
                                CoinsDraw).

%% run(Agents?, Friends?, Count?, Unit?, Seed?, Spend?, Cred?): the run,
%% harness.glp, with the mix given by Spend and Cred, integers 0..100.
exported procedure run(Integer?, Friends?, Number?, Span?, Integer?, Integer?,
                       Integer?).
run(N, Fss, C, U, Seed, Spend, Cred) :-
    harness # run(N?, Fss?, C?, U?, Seed?, Spend?, Cred?).

%% draw(Agents?, Seed?, Spend?, Cred?, D): the population's draw in that run,
%% its counts and each agent's profiles, harness.glp, without running it.
exported procedure draw(Integer?, Integer?, Integer?, Integer?, CoinsDraw).
draw(N, Seed, Spend, Cred, D?) :- harness # draw(N?, Seed?, Spend?, Cred?, D).

%% The sGLP source of this program in the term form (README.md, "The term
%% form"), coins_sglp.glp, for the transformation (programs/sglp/transform.glp).
imported procedure coins_sglp#source(SglpTerms, SglpTerms).
exported procedure source(SglpTerms, SglpTerms).
source(V?, S?) :- coins_sglp # source(V, S).
