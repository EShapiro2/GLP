%% The person process (sGLP's paper, Section 4, "The person process").
exported procedure person(Integer?, Profiles?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, profiles(spender, D2), Mon, Seed, Log, [ask(Type, menu_w(menu(X1, X2, X3?))) | As])
:-
ground(X1?)
,
ground(X2?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
spender_menu(menu(X1?, X2?, Y3), K?, Mon?)
,
answer_1(A?, Type?, X1?, X2?, Y3?, X3, Mon?, Log?)
,
person(A?, profiles(spender, D2?), Mon?, S?, Log?, As?)
.
person(A, profiles(saver, D2), Mon, Seed, Log, [ask(Type, menu_w(menu(X1, X2, X3?))) | As])
:-
ground(X1?)
,
ground(X2?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
saver_menu(menu(X1?, X2?, Y3), K?, Mon?)
,
answer_1(A?, Type?, X1?, X2?, Y3?, X3, Mon?, Log?)
,
person(A?, profiles(saver, D2?), Mon?, S?, Log?, As?)
.
person(A, profiles(D1, cautious), Mon, Seed, Log, [ask(Type, offer_w(offer(X1, X2, X3, X4?))) | As])
:-
ground(X1?)
,
ground(X2?)
,
ground(X3?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
cautious_offer(offer(X1?, X2?, X3?, Y4), K?, Mon?)
,
answer_2(A?, Type?, X1?, X2?, X3?, Y4?, X4, Mon?, Log?)
,
person(A?, profiles(D1?, cautious), Mon?, S?, Log?, As?)
.
person(A, profiles(D1, generous), Mon, Seed, Log, [ask(Type, offer_w(offer(X1, X2, X3, X4?))) | As])
:-
ground(X1?)
,
ground(X2?)
,
ground(X3?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
generous_offer(offer(X1?, X2?, X3?, Y4), K?, Mon?)
,
answer_2(A?, Type?, X1?, X2?, X3?, Y4?, X4, Mon?, Log?)
,
person(A?, profiles(D1?, generous), Mon?, S?, Log?, As?)
.
person(_, _, _, _, _, []).

%% The answer, assigned and logged (Section 4, "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
Peers
?
,
Wallet
?
,
Request
?
,
Request
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, X1, X2, Y3, Y3?, Mon, Log)
:-
ground(Y3?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, menu(X1?, X2?, Y3?)), Log?, _)
.

%% The answer, assigned and logged (Section 4, "The log").
procedure
answer_2
(
Integer?
,
Constant?
,
Peer
?
,
Integer?
,
Integer?
,
YesNo
?
,
YesNo
,
MutualRef?
,
MutualRef?
)
.
answer_2(A, Type, X1, X2, X3, Y4, Y4?, Mon, Log)
:-
ground(Y4?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, offer(X1?, X2?, X3?, Y4?)), Log?, _)
.

