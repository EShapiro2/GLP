.
declaration(100, 1, year, 20260927, 50, 50)
.

%% An agent's stochastic person, drawn from its block (Appendix B).
exported procedure
stochastic_person
(
Integer?
,
Integer?
,
Integer?
,
Profiles
,
Integer
)
.
stochastic_person(B, T1, T2, profiles(P1?, P2?), S?)
:-
random(B?, 100, K1, B1)
,
random(B1?, 100, K2, S)
,
spending(K1?, T1?, P1)
,
credit(K2?, T2?, P2)
.

%% The draw of the dimension(spending)
procedure
spending
(
Integer?
,
Integer?
,
Dimension1
)
.
spending(K, T1, spender)
:-
'=<'(K?, T1?)
|
true
.
spending(K, T1, saver)
:-
'>'(K?, T1?)
|
true
.

%% The draw of the dimension(credit)
procedure
credit
(
Integer?
,
Integer?
,
Dimension2
)
.
credit(K, T1, cautious)
:-
'=<'(K?, T1?)
|
true
.
credit(K, T1, generous)
:-
'>'(K?, T1?)
|
true
.
