%% Printed by programs/sglp/transform.glp from the sGLP source in the term form
%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(coins, profiles)

%% A person, its key, its role and its attributes (Section 3, Definition "Person, Census"): the source defines no Person, so it is that of the persons run n agents draws, person(K, agent, []).
Person ::= person(Constant, Constant, List(Constant)).
procedure
request
(
Token?
,
Integer?
,
Menu
?
)
.
request(stop, _, _)
.
request(go, S, menu(Fs, [], swap(F?, 10)))
:-
ground(Fs?)
|
one_of(Fs?, S?, F)
.
request(go, S, menu(_, [H | Hs], pay(F?, K?)))
:-
ground(H?)
,
ground(Hs?)
|
random(S?, 5, K, S1)
,
one_of([H? | Hs?], S1?, Hd)
,
issuer(Hd?, F)
.
procedure
issuer
(
Holding
?
,
Peer
)
.
issuer(holding(F, _), F?)
.

%% person(spender)
%% binds(Menu, spender_menu)
exported procedure
spender_menu
(
Menu
?
,
Person
?
,
Integer?
,
MutualRef?
,
MutualRef?
)
.
spender_menu(M, _, S, Mon, _)
:-
stream_append(rated('/'(1, day), Tok), Mon?, _)
,
request(Tok?, S?, M?)
.

