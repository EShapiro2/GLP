%% person(cautious)
%% binds(Offer, cautious_offer)
exported procedure
cautious_offer
(
Offer
?
,
Person
?
,
Integer?
,
MutualRef?
,
MutualRef?
)
.
cautious_offer(O, _, _, Mon, _)
:-
stream_append(rated('/'(1, hour), Tok), Mon?, _)
,
weigh(Tok?, O?)
.
procedure
weigh
(
Token?
,
Offer
?
)
.
weigh(stop, _)
.
weigh(go, offer(_, _, Held, yes))
:-
'=<'(Held?, 20)
|
true
.
weigh(go, offer(_, _, Held, no))
:-
'>'(Held?, 20)
|
true
.

