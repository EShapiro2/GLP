%% self.glp — the rendezvous example's directory scope and interface.
%%
%% Carries the types the modules share and exports the program's entry points:
%% the test goals the REPL suite posts (manual §19.6, §19.7 — a program's entry
%% points are its root self.glp's exported procedures, defined there or
%% forwarded).

%% =============================================================================
%% SHARED TYPES
%% =============================================================================

SignalReply ::= punch(String) ; rejected.

SignalMsg ::= reconnect(Key, Key, SignedTerm, SignalReply?)
            ; available(Key, Key, SignedTerm, SignalReply?)
            ; register(Key, SignedTerm, SignalReply?)
            ; redeem(Key, SignedTerm, SignalReply?).

PendingEntry ::= needs(Key, Key, String, SignalReply?)
               ; ready(Key, Key, String, SignalReply?)
               ; invited(Key, Integer, SignalReply?)
               ; used(Key, Integer).
PendingList ::= [] ; [PendingEntry | PendingList].

%% Friend-mediated rendezvous (fmrv) — a friend already reachable over BLE
%% relays addresses so two NAT-bound friends can punch to each other.

AddrResult ::= found(String) ; not_found.

MsgOp ::= mediate(Key)
        ; punch_to(AddrResult)
        ; addr_update(String).

Msg ::= msg(Key, Key, MsgOp).

MsgStream ::= [] ; [Msg | MsgStream].
FriendStream ::= [] ; [Msg | FriendStream].

FriendEntry ::= fe(Key, FriendStream?, String).
FriendList ::= [] ; [FriendEntry | FriendList].

