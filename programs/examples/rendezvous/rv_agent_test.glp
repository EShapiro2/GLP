%% rv_agent_test.glp — test suite for rv_agent.glp
%%
%% Load rv_agent.glp first, then this file, then invoke test goals.

%% Local type redeclarations (structural identity allows sharing across modules)
SignalReply ::= punch(String) ; rejected.

PendingEntry ::= needs(Key, Key, String, SignalReply?)
               ; ready(Key, Key, String, SignalReply?).
PendingList ::= [] ; [PendingEntry | PendingList].

SignalMsg ::= reconnect(Key, Key, SignedTerm, SignalReply?)
            ; available(Key, Key, SignedTerm, SignalReply?).

imported procedure rv_agent#find_ready(Key?, Key?, String?,
                                        SignalReply,
                                        PendingList?, PendingList).
imported procedure rv_agent#find_needs(Key?, Key?, String?,
                                        SignalReply,
                                        PendingList?, PendingList).
imported procedure rv_agent#rv_agent(Hash?, Stream(SignalMsg)?,
                                      PendingList?).
imported procedure rv_agent#admit_reconnect(Hash?, Key?, Key?, Signature?,
                                             SignalReply,
                                             PendingList?, PendingList).
imported procedure rv_agent#admit_available(Hash?, Key?, Key?, Signature?,
                                             SignalReply,
                                             PendingList?, PendingList).
imported procedure rv_agent#match_reconnect(Key?, Key?, PeerAddress?,
                                             SignalReply,
                                             PendingList?, PendingList).
imported procedure rv_agent#match_available(Key?, Key?, PeerAddress?,
                                             SignalReply,
                                             PendingList?, PendingList).

%% In every test below alice @< bob and carol @< dave, so the pair of alice
%% and bob in the fixed order is attest(alice, bob).

%% =============================================================================
%% Test 1: A arrives first, no B waiting → entry stored in pending
%% =============================================================================

exported procedure test1_needs_stored(PendingList).
test1_needs_stored(Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, _, [], Pending1).

%% Expected: Pending1 = [needs(alice, bob, addr_a, _)]

%% =============================================================================
%% Test 2: B arrives first, no A waiting → entry stored in pending
%% =============================================================================

exported procedure test2_ready_stored(PendingList).
test2_ready_stored(Pending1?) :-
    rv_agent # find_needs(alice, bob, addr_b, _, [], Pending1).

%% Expected: Pending1 = [ready(bob, alice, addr_b, _)]

%% =============================================================================
%% Test 3: A arrives after B is waiting → match, both told to punch
%% =============================================================================

exported procedure test3_match_find_ready(SignalReply, SignalReply, PendingList).
test3_match_find_ready(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, ReplyA,
                           [ready(bob, alice, addr_b, ReplyB)], Pending1).

%% Expected: ReplyA = punch(addr_b), ReplyB = punch(addr_a), Pending1 = []

%% =============================================================================
%% Test 4: B arrives after A is waiting → match, both told to punch
%% =============================================================================

exported procedure test4_match_find_needs(SignalReply, SignalReply, PendingList).
test4_match_find_needs(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # find_needs(alice, bob, addr_b, ReplyB,
                           [needs(alice, bob, addr_a, ReplyA)], Pending1).

%% Expected: ReplyA = punch(addr_b), ReplyB = punch(addr_a), Pending1 = []

%% =============================================================================
%% Test 5: find_ready with non-matching ready entry → pass-through, store needs
%% =============================================================================

exported procedure test5_find_ready_no_match(PendingList).
test5_find_ready_no_match(Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, _,
                           [ready(carol, dave, addr_c, _)], Pending1).

%% Expected: Pending1 = [ready(carol, dave, addr_c, _),
%%                       needs(alice, bob, addr_a, _)]

%% =============================================================================
%% Test 6: find_ready with multiple entries, one matches
%% =============================================================================

exported procedure test6_find_ready_skip_then_match(SignalReply, SignalReply, PendingList).
test6_find_ready_skip_then_match(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, ReplyA,
                           [ready(carol, dave, addr_c, _),
                            ready(bob, alice, addr_b, ReplyB)], Pending1).

%% Expected: ReplyA = punch(addr_b), ReplyB = punch(addr_a),
%%           Pending1 = [ready(carol, dave, addr_c, _)]

%% =============================================================================
%% Test 7: Run rv_agent on a single reconnect message
%% =============================================================================
%%
%% Every request below is rejected: its Sig is no signed term, so
%% signature/2 assigns unsigned and admit_reconnect/7 or admit_available/7
%% refuses it.  No test under the plain REPL presents a signature over the
%% pair made under the social graph (graph_hash stands for its source
%% identity), so these tests exercise the reject path and the pending list
%% around it.

exported procedure test7_agent_single_reconnect(SignalReply).
test7_agent_single_reconnect(ReplyA?) :-
    rv_agent # rv_agent(
        graph_hash, [reconnect(alice, bob, sig_ab, ReplyA)], []).

%% Expected: ReplyA = rejected, agent terminates on empty stream

%% =============================================================================
%% Test 8: Run rv_agent with available then reconnect (B first, A second)
%% =============================================================================
%%
%% B's availability carries no signature of A's, so it is rejected and not
%% stored; A's reconnect is then rejected in its turn.

exported procedure test8_available_then_reconnect_rejected(SignalReply, SignalReply).
test8_available_then_reconnect_rejected(ReplyA?, ReplyB?) :-
    rv_agent # rv_agent(
        graph_hash, [available(bob, alice, sig_ba, ReplyB),
                     reconnect(alice, bob, sig_ab, ReplyA)], []).

%% Expected: ReplyA = rejected, ReplyB = rejected

%% =============================================================================
%% Test 9: Two reconnect messages for unrelated pairs → both rejected
%% =============================================================================
%%
%% Neither is stored: a rejected reconnect leaves the pending list untouched.

exported procedure test9_two_reconnects_rejected(SignalReply, SignalReply).
test9_two_reconnects_rejected(RA1?, RA2?) :-
    rv_agent # rv_agent(
        graph_hash, [reconnect(alice, bob, sig_ab, RA1),
                     reconnect(carol, dave, sig_cd, RA2)], []).

%% Expected: RA1 = rejected, RA2 = rejected

%% =============================================================================
%% Test 10: reconnect, then available for same pair → both rejected
%% =============================================================================
%%
%% The reconnect is rejected before it can be stored, and B's availability,
%% carrying no signature of A's, is rejected in its turn.

exported procedure test10_reconnect_then_available(SignalReply, SignalReply).
test10_reconnect_then_available(RA?, RB?) :-
    rv_agent # rv_agent(
        graph_hash, [reconnect(alice, bob, sig_ab, RA),
                     available(bob, alice, sig_ba, RB)], []).

%% Expected: RA = rejected, RB = rejected

%% =============================================================================
%% Test 11: reconnect with an invalid signature → reply is rejected
%% =============================================================================
%%
%% bad_sig is not bob's signature over attest(alice, bob): it is no signed
%% term at all, so signature/2 assigns unsigned and admit_reconnect/7
%% refuses it.

exported procedure test11_reconnect_rejected(SignalReply).
test11_reconnect_rejected(RA?) :-
    rv_agent # rv_agent(
        graph_hash, [reconnect(alice, bob, bad_sig, RA)], []).

%% Expected: RA = rejected

%% =============================================================================
%% Test 12: a rejected reconnect does not block the rest of the stream
%% =============================================================================
%%
%% The first reconnect is rejected; the available behind it is still
%% consumed, and rejected; the third message is rejected in its turn.  All
%% are rejected alike: neither bad_sig nor good_sig is a signed term, so
%% signature/2 assigns unsigned to each.

exported procedure test12_rejected_does_not_block_stream(SignalReply, SignalReply, SignalReply).
test12_rejected_does_not_block_stream(RA1?, RA2?, RB?) :-
    rv_agent # rv_agent(
        graph_hash, [reconnect(alice, bob, bad_sig, RA1),
                     available(bob, alice, bad_sig, RB),
                     reconnect(alice, bob, good_sig, RA2)], []).

%% Expected: RA1 = rejected, RA2 = rejected, RB = rejected

%% =============================================================================
%% Test 13: admit_reconnect refuses every Signature but B's over the pair
%% under the social graph
%% =============================================================================
%%
%% The dispatch on what signature/2 reports, given each refused form
%% directly: unsigned; carol's signature where the request names bob;
%% bob's over another term; and bob's over attest(alice, bob) made under
%% another program than the graph.

exported procedure test13_dispatch_refuses(SignalReply, SignalReply,
                                           SignalReply, SignalReply).
test13_dispatch_refuses(R1?, R2?, R3?, R4?) :-
    rv_agent # admit_reconnect(graph_hash, alice, bob, unsigned, R1, [], _),
    rv_agent # admit_reconnect(graph_hash, alice, bob,
        signed(carol, graph_hash, attest(alice, bob)), R2, [], _),
    rv_agent # admit_reconnect(graph_hash, alice, bob,
        signed(bob, graph_hash, attest(alice, carol)), R3, [], _),
    rv_agent # admit_reconnect(graph_hash, alice, bob,
        signed(bob, other_hash, attest(alice, bob)), R4, [], _).

%% Expected: R1 = R2 = R3 = R4 = rejected

%% =============================================================================
%% Test 14: a signature that verifies, made under another program, is rejected
%% =============================================================================
%%
%% This test program signs the pair of alice and K, in the fixed order,
%% under the person's own key K, and presents it as K's attestation for
%% alice.  signature/2 verifies it and reports signed(K, H, Pair), the
%% signer and the term those the request names; but H is this test
%% program's source identity and not the social graph's, so the request is
%% refused.

exported procedure test14_other_program_rejected(SignalReply).
test14_other_program_rejected(RA?) :-
    self_key(K),
    present_own_attestation(alice, K?, RA).

procedure present_own_attestation(Key?, Key?, SignalReply).
present_own_attestation(A, B, RA?) :-
    ground(A?), ground(B?), A? @< B? |
    sign(attest(A?, B?), B?, Sig),
    rv_agent # rv_agent(graph_hash, [reconnect(A?, B?, Sig?, RA)], []).
present_own_attestation(A, B, RA?) :-
    ground(A?), ground(B?), B? @< A? |
    sign(attest(B?, A?), B?, Sig),
    rv_agent # rv_agent(graph_hash, [reconnect(A?, B?, Sig?, RA)], []).

%% Expected: RA = rejected

%% =============================================================================
%% Test 15: an admitted reconnect for which the layer observes no address
%% =============================================================================
%%
%% match_reconnect/6 is given directly what peer_address/2 reports where the
%% networking layer observes no address for A: none.  There is no address
%% to relay, so the request is refused and not stored, and bob's waiting
%% entry is left as it was.

exported procedure test15_match_on_none(SignalReply, PendingList).
test15_match_on_none(ReplyA?, Pending1?) :-
    rv_agent # match_reconnect(alice, bob, none, ReplyA,
                                [ready(bob, alice, addr_b, _)], Pending1).

%% Expected: ReplyA = rejected, Pending1 = [ready(bob, alice, addr_b, _)]

%% =============================================================================
%% Test 16: an admitted reconnect for which the layer observes an address
%% =============================================================================
%%
%% match_reconnect/6 is given address(addr_a), what peer_address/2 reports
%% where the layer observes A at addr_a: bob's waiting entry is matched, and
%% each is told to punch to the other's address.

exported procedure test16_match_on_address(SignalReply, SignalReply,
                                           PendingList).
test16_match_on_address(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # match_reconnect(alice, bob, address(addr_a), ReplyA,
                                [ready(bob, alice, addr_b, ReplyB)], Pending1).

%% Expected: ReplyA = punch(addr_b), ReplyB = punch(addr_a), Pending1 = []

%% =============================================================================
%% Test 17: admit_available refuses every Signature but A's over the pair
%% under the social graph
%% =============================================================================
%%
%% B's availability for A verified as the reconnect request is, given each
%% refused form directly: unsigned; bob's own signature where the request
%% needs alice's; alice's over the pair out of the fixed order,
%% attest(bob, alice); and alice's over attest(alice, bob) made under
%% another program than the graph.

exported procedure test17_available_dispatch_refuses(SignalReply, SignalReply,
                                                     SignalReply, SignalReply).
test17_available_dispatch_refuses(R1?, R2?, R3?, R4?) :-
    rv_agent # admit_available(graph_hash, bob, alice, unsigned, R1, [], _),
    rv_agent # admit_available(graph_hash, bob, alice,
        signed(bob, graph_hash, attest(alice, bob)), R2, [], _),
    rv_agent # admit_available(graph_hash, bob, alice,
        signed(alice, graph_hash, attest(bob, alice)), R3, [], _),
    rv_agent # admit_available(graph_hash, bob, alice,
        signed(alice, other_hash, attest(alice, bob)), R4, [], _).

%% Expected: R1 = R2 = R3 = R4 = rejected

%% =============================================================================
%% Test 18: an unverified available is not matched with a waiting A
%% =============================================================================
%%
%% alice's request is waiting in the pending list; bob's availability for
%% her carries no signature of hers, so it is rejected, and alice is told
%% nothing: an unverified available never learns A's address.

exported procedure test18_unverified_available_not_matched(SignalReply,
                                                           SignalReply).
test18_unverified_available_not_matched(ReplyB?, ReplyA?) :-
    rv_agent # rv_agent(
        graph_hash, [available(bob, alice, bad_sig, ReplyB)],
        [needs(alice, bob, addr_a, ReplyA)]).

%% Expected: ReplyB = rejected, ReplyA unbound

%% =============================================================================
%% Test 19: a reconnect carrying the pair out of the fixed order is refused
%% =============================================================================
%%
%% bob's signature, under the graph, over attest(bob, alice): signer and
%% program are right, but the pair is not in the fixed order, alice being
%% the smaller key.

exported procedure test19_reconnect_pair_out_of_order(SignalReply).
test19_reconnect_pair_out_of_order(R?) :-
    rv_agent # admit_reconnect(graph_hash, alice, bob,
        signed(bob, graph_hash, attest(bob, alice)), R, [], _).

%% Expected: R = rejected

%% =============================================================================
%% Test 20: an admitted available for which the layer observes no address
%% =============================================================================
%%
%% match_available/6 is given none for B: refused and not stored, and
%% alice's waiting entry is left as it was.

exported procedure test20_match_available_on_none(SignalReply, PendingList).
test20_match_available_on_none(ReplyB?, Pending1?) :-
    rv_agent # match_available(bob, alice, none, ReplyB,
                                [needs(alice, bob, addr_a, _)], Pending1).

%% Expected: ReplyB = rejected, Pending1 = [needs(alice, bob, addr_a, _)]

%% =============================================================================
%% Test 21: an admitted available for which the layer observes an address
%% =============================================================================
%%
%% match_available/6 is given address(addr_b): alice's waiting entry is
%% matched, and each is told to punch to the other's address.

exported procedure test21_match_available_on_address(SignalReply, SignalReply,
                                                     PendingList).
test21_match_available_on_address(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # match_available(bob, alice, address(addr_b), ReplyB,
                                [needs(alice, bob, addr_a, ReplyA)], Pending1).

%% Expected: ReplyA = punch(addr_b), ReplyB = punch(addr_a), Pending1 = []

%% =============================================================================
%% Test 22: the admitting path under the plain REPL
%% =============================================================================
%%
%% An available whose signature verifies, taken through the agent to the
%% networking layer.  This test program stands in for the social graph: it
%% signs the pair of the person's own key K and bob, in the fixed order,
%% under K --- K being A, whose signature B's availability carries --- and
%% gives the agent as Graph the program identity signature/2 reports for
%% that signature.  The agent takes the signature apart, finds it A's over
%% the pair under Graph, and admits the availability; it then reads B's
%% address through the root's peer_address/2.  Under the plain REPL no
%% networking layer is bound, and the runtime stands in for a layer that
%% observes nothing (IGLP, "One interface"): peer_address/2 assigns none,
%% and match_available/6 refuses.  So B is rejected and A, waiting, is told
%% nothing --- test 18's outcome, reached here through the admission and the
%% layer and not through the signature.  The two punches, which follow only
%% where the layer observes an address, are tests 16 and 21, given
%% address(S) directly.
%%
%% Report is what signature/2 reports for the signature presented.

exported procedure test22_available_admitted_no_layer(Signature, SignalReply,
                                                      SignalReply).
test22_available_admitted_no_layer(Report?, ReplyB?, ReplyA?) :-
    self_key(K),
    sign_own_pair(K?, bob, Sig),
    present_signed_available(K?, bob, Sig?, Report, ReplyB, ReplyA).

%% A signs the pair of A and B, in the fixed order, under A's own key.
procedure sign_own_pair(Key?, Key?, SignedTerm).
sign_own_pair(A, B, Sig?) :-
    ground(A?), ground(B?), A? @< B? |
    sign(attest(A?, B?), A?, Sig).
sign_own_pair(A, B, Sig?) :-
    ground(A?), ground(B?), B? @< A? |
    sign(attest(B?, A?), A?, Sig).

%% B's availability for A carries A's signature Sig, A's request waiting.
procedure present_signed_available(Key?, Key?, SignedTerm?, Signature,
                                   SignalReply, SignalReply).
present_signed_available(A, B, Sig, Report?, ReplyB?, ReplyA?) :-
    ground(A?), ground(B?), ground(Sig?) |
    signature(Sig?, Report),
    signature(Sig?, S),
    graph_of(S?, Graph),
    rv_agent # rv_agent(Graph?, [available(B?, A?, Sig?, ReplyB)],
                        [needs(A?, B?, addr_a, ReplyA)]).

%% The program identity a signature was made under, given the agent as Graph.
procedure graph_of(Signature?, Hash).
graph_of(signed(_, H, _), H?).
graph_of(unsigned, no_graph).

%% Expected: Report = signed(K, H, attest(..)), K self_key's answer and the
%%           pair K's and bob's in the fixed order;
%%           ReplyB = rejected, ReplyA unbound
