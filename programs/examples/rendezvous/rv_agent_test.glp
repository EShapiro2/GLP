%% rv_agent_test.glp — test suite for rv_agent.glp
%%
%% Load rv_agent.glp first, then this file, then invoke test goals.

%% Local type redeclarations (structural identity allows sharing across modules)
SignalReply ::= punch(Constant) ; initiated ; rejected.

PendingEntry ::= needs(Constant, Constant, Constant, SignalReply?)
               ; ready(Constant, Constant, SignalReply?).
PendingList ::= [] ; [PendingEntry | PendingList].

SignalMsg ::= reconnect(Constant, Constant, Constant, Constant, SignalReply?)
            ; available(Constant, Constant, SignalReply?).

imported procedure rv_agent#find_ready(Constant?, Constant?, Constant?,
                                        SignalReply,
                                        PendingList?, PendingList).
imported procedure rv_agent#find_needs(Constant?, Constant?, SignalReply,
                                        PendingList?, PendingList).
imported procedure rv_agent#rv_agent(Stream(SignalMsg)?,
                                      PendingList?).

%% =============================================================================
%% Test 1: A arrives first, no B waiting → entry stored in pending
%% =============================================================================

exported procedure test1_needs_stored(PendingList).
test1_needs_stored(Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, _, [], Pending1).

%% Expected: Pending1 = [needs(alice, bob, addr_a, _)]

%% =============================================================================
%% Test 2: B arrives first, no A waiting → entry stored in pending
%% =============================================================================

exported procedure test2_ready_stored(PendingList).
test2_ready_stored(Pending1?) :-
    rv_agent # find_needs(alice, bob, _, [], Pending1).

%% Expected: Pending1 = [ready(bob, alice, _)]

%% =============================================================================
%% Test 3: A arrives after B is waiting → match, replies get bound
%% =============================================================================

exported procedure test3_match_find_ready(SignalReply, SignalReply, PendingList).
test3_match_find_ready(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, ReplyA,
                           [ready(bob, alice, ReplyB)], Pending1).

%% Expected: ReplyA = initiated, ReplyB = punch(addr_a), Pending1 = []

%% =============================================================================
%% Test 4: B arrives after A is waiting → match, replies get bound
%% =============================================================================

exported procedure test4_match_find_needs(SignalReply, SignalReply, PendingList).
test4_match_find_needs(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # find_needs(alice, bob, ReplyB,
                           [needs(alice, bob, addr_a, ReplyA)], Pending1).

%% Expected: ReplyA = initiated, ReplyB = punch(addr_a), Pending1 = []

%% =============================================================================
%% Test 5: find_ready with non-matching ready entry → pass-through, store needs
%% =============================================================================

exported procedure test5_find_ready_no_match(PendingList).
test5_find_ready_no_match(Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, _,
                           [ready(carol, dave, _)], Pending1).

%% Expected: Pending1 = [ready(carol, dave, _), needs(alice, bob, addr_a, _)]

%% =============================================================================
%% Test 6: find_ready with multiple entries, one matches
%% =============================================================================

exported procedure test6_find_ready_skip_then_match(SignalReply, SignalReply, PendingList).
test6_find_ready_skip_then_match(ReplyA?, ReplyB?, Pending1?) :-
    rv_agent # find_ready(alice, bob, addr_a, ReplyA,
                           [ready(carol, dave, _),
                            ready(bob, alice, ReplyB)], Pending1).

%% Expected: ReplyA = initiated, ReplyB = punch(addr_a),
%%           Pending1 = [ready(carol, dave, _)]

%% =============================================================================
%% Test 7: Run rv_agent on a single reconnect message
%% =============================================================================
%%
%% Every reconnect below is rejected, and not because its attestation is
%% forged: valid_attestation/4 fails outright when there is no madGLP network
%% on the context, which is every REPL run.  The accept path is unreachable
%% here by construction, so these tests exercise the reject path and the
%% pending list around it.

exported procedure test7_agent_single_reconnect(SignalReply).
test7_agent_single_reconnect(ReplyA?) :-
    rv_agent # rv_agent(
        [reconnect(alice, bob, bob, sig_ab, ReplyA)], []).

%% Expected: ReplyA = rejected, agent terminates on empty stream

%% =============================================================================
%% Test 8: Run rv_agent with available then reconnect (B first, A second)
%% =============================================================================
%%
%% B's availability is stored as a ready entry; A's reconnect is then
%% rejected, so the entry is never matched and B is never told to punch.

exported procedure test8_available_then_reconnect_rejected(SignalReply, SignalReply).
test8_available_then_reconnect_rejected(ReplyA?, ReplyB?) :-
    rv_agent # rv_agent(
        [available(bob, alice, ReplyB),
         reconnect(alice, bob, bob, sig_ab, ReplyA)], []).

%% Expected: ReplyA = rejected, ReplyB unbound (its ready entry is left pending)

%% =============================================================================
%% Test 9: Two reconnect messages for unrelated pairs → both rejected
%% =============================================================================
%%
%% Neither is stored: a rejected reconnect leaves the pending list untouched.

exported procedure test9_two_reconnects_rejected(SignalReply, SignalReply).
test9_two_reconnects_rejected(RA1?, RA2?) :-
    rv_agent # rv_agent(
        [reconnect(alice, bob, bob, sig_ab, RA1),
         reconnect(carol, dave, dave, sig_cd, RA2)], []).

%% Expected: RA1 = rejected, RA2 = rejected

%% =============================================================================
%% Test 10: reconnect, then available for same pair → nothing to match against
%% =============================================================================
%%
%% The reconnect is rejected before it can be stored, so B's availability
%% arrives to an empty pending list and is stored in its turn.

exported procedure test10_reconnect_then_available(SignalReply, SignalReply).
test10_reconnect_then_available(RA?, RB?) :-
    rv_agent # rv_agent(
        [reconnect(alice, bob, bob, sig_ab, RA),
         available(bob, alice, RB)], []).

%% Expected: RA = rejected, RB unbound (stored as a ready entry)

%% =============================================================================
%% Test 11: reconnect with an invalid signature → reply is rejected
%% =============================================================================
%%
%% The guard is valid_attestation/4.  It fails here for either of two
%% reasons — bad_sig is not Signer's signature over attest(alice, bob), and
%% there is no network on the context to check it against — and the reject
%% path is the same for both.

exported procedure test11_reconnect_rejected(SignalReply).
test11_reconnect_rejected(RA?) :-
    rv_agent # rv_agent(
        [reconnect(alice, bob, bob, bad_sig, RA)], []).

%% Expected: RA = rejected

%% =============================================================================
%% Test 12: a rejected reconnect does not block the rest of the stream
%% =============================================================================
%%
%% The first reconnect is rejected; the available behind it is still
%% consumed and stored; the third message is rejected in its turn.  Both
%% signatures are rejected alike, the well-formed one included, because the
%% guard has no network to check either against.

exported procedure test12_rejected_does_not_block_stream(SignalReply, SignalReply, SignalReply).
test12_rejected_does_not_block_stream(RA1?, RA2?, RB?) :-
    rv_agent # rv_agent(
        [reconnect(alice, bob, bob, bad_sig, RA1),
         available(bob, alice, RB),
         reconnect(alice, bob, bob, good_sig, RA2)], []).

%% Expected: RA1 = rejected, RA2 = rejected, RB unbound (stored as ready)
