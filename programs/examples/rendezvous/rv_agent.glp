%% rv_agent.glp - Rendezvous Agent
%%
%% A minimal GLP agent that coordinates reconnection between agents
%% that lost connectivity due to IP address changes.
%%
%% - Accepts cold-calls from any agent (no friends list, no social graph)
%% - Verifies the reconnection attestation with the language's signature/2
%% - Learns A's current public address via peer_address (reading the
%%   source address of the incoming cold-call packet)
%% - Relays addresses to coordinate hole-punching
%%
%% Protocol:
%%   1. A detects IP change, cold-calls:
%%      reconnect(A_pk, B_pk, Sig, Reply)
%%   2. B detects A went silent, cold-calls: available(B_pk, A_pk, Reply)
%%   3. The RV agent reads A's source address from the networking layer
%%      via peer_address(A?, AddrA), matches the requests, and tells B
%%      to punch to AddrA via Reply
%%
%% Capability verification (GNA, Section "Rendezvous Server", items
%% "Capability verification" and "Reconnection"; Section "System
%% Predicates", paragraph "Signatures"):
%%   on befriending, each friend signs attest(PkA, PkB) and gives the
%%   signature to the other.  A reconnection request from A for B carries
%%   B's signature over attest(A, B), and names no separate signer.  The
%%   agent takes the signature apart with signature/2, which assigns
%%   signed(Key, Hash, Term) --- the signer's key, the source identity of
%%   the signing program and the term signed --- where it verifies, and
%%   unsigned where it does not; admit_reconnect/7 dispatches on that:
%%
%%       signed(B, Graph, attest(A, B))   admits
%%
%%   the signer being the friend the request names and Graph the social
%%   graph's source identity.  Anything else --- unsigned, another signer,
%%   another term, or a Hash other than Graph --- is refused with rejected.
%%   Graph is a Hash the agent is given at boot, the first argument of
%%   rv_agent/3; it is never read from the attestation.
%%
%%   Under the plain REPL the tests present no attestation signed under the
%%   social graph, so they exercise the reject path alone.
%%
%% System predicates:
%%   signature(Signed?, Signature) — root self.glp (GLP-Spec catalogue):
%%     signed(Key, Hash, Term) or unsigned.
%%   peer_address(Pk?, Addr) — body predicate, reads the observed source
%%     address for peer Pk from the networking layer; the stub at the end
%%     of this file stands in for it.


%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Reply sent back to agents via their reply variable
SignalReply ::= punch(Constant) ; initiated ; rejected.

%% Messages arriving via cold-call on the agent's input stream
SignalMsg ::= reconnect(Key, Key, SignedTerm, SignalReply?)
              %% reconnect(A_pk, B_pk, Sig, Reply) — Sig is B's signature
              %% over attest(A_pk, B_pk)
            ; available(Key, Key, SignalReply?).
              %% available(B_pk, A_pk, Reply)

%% Pending entries awaiting a match
PendingEntry ::= needs(Key, Key, Constant, SignalReply?)
                 %% needs(A_pk, B_pk, AddrA, ReplyA?) — A wants to reconnect to B
               ; ready(Key, Key, SignalReply?).
                 %% ready(B_pk, A_pk, ReplyB?) — B is available for A
PendingList ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% MAIN LOOP
%% =============================================================================

exported procedure rv_agent(Hash?, Stream(SignalMsg)?, PendingList?).

%% A requests reconnection to B, presenting Sig, B's signature over
%% attest(A, B).  signature/2 takes it apart and admit_reconnect/7
%% dispatches on what it reports, against the social graph's source
%% identity Graph.  The guard grounds Graph, which is read twice.
rv_agent(Graph, [reconnect(A, B, Sig, ReplyA?)|In], Pending) :-
    ground(Graph?) |
    signature(Sig?, S),
    admit_reconnect(Graph?, A?, B?, S?, ReplyA, Pending?, Pending1),
    rv_agent(Graph?, In?, Pending1?).

%% B is available for reconnection from A
rv_agent(Graph, [available(B, A, ReplyB?)|In], Pending) :-
    find_needs(A?, B?, ReplyB, Pending?, Pending1),
    rv_agent(Graph?, In?, Pending1?).

rv_agent(_, [], _).

%% =============================================================================
%% admit_reconnect: dispatch on what signature/2 reports
%% =============================================================================

exported procedure admit_reconnect(Hash?, Key?, Key?, Signature?, SignalReply,
                                   PendingList?, PendingList).

%% B signed attest(A, B) under the social graph: admitted.  Only then does
%% the RV agent read A's source address from the networking layer via
%% peer_address (so A does not need to self-report its address) and look
%% for a waiting B.  The guard grounds A and B.
admit_reconnect(Graph, A, B, signed(K, H, attest(A1, B1)), ReplyA?,
                Pending, Pending1?) :-
    K? =?= B?, H? =?= Graph?, A1? =?= A?, B1? =?= B? |
    peer_address(A?, AddrA),
    find_ready(A?, B?, AddrA?, ReplyA, Pending?, Pending1).

%% unsigned, another signer, another term, or another program's signature:
%% the reply is bound to `rejected` and the request is not added to the
%% pending list.  That the signature verifies, and who made it under which
%% program, is signature/2's; what the binding authorizes is this agent's
%% logic.
admit_reconnect(_, _, _, _, rejected, Pending, Pending?) :-
    otherwise | true.

%% =============================================================================
%% find_ready: A arrived, search pending for a matching ready(B, A, ReplyB)
%% =============================================================================

exported procedure find_ready(Key?, Key?, Constant?, SignalReply,
                              PendingList?, PendingList).

%% Match found: B was waiting — assign replies
find_ready(A, B, AddrA, ReplyA?, [ready(B2, A2, ReplyB?)|Ps], Ps?) :-
    A? =?= A2?, B? =?= B2? |
    complete_rendezvous(AddrA?, ReplyA, ReplyB).

%% No match at this entry, keep searching
find_ready(A, B, AddrA, ReplyA?, [P|Ps], [P?|Ps1?]) :-
    otherwise |
    find_ready(A?, B?, AddrA?, ReplyA, Ps?, Ps1).

%% End of list, no match: store A's request in pending
find_ready(A, B, AddrA, ReplyA?, [], [needs(A?, B?, AddrA?, ReplyA)]).

%% =============================================================================
%% find_needs: B arrived, search pending for a matching needs(A, B, AddrA, ReplyA)
%% =============================================================================

exported procedure find_needs(Key?, Key?, SignalReply,
                              PendingList?, PendingList).

%% Match found: A was waiting — assign replies
find_needs(A, B, ReplyB?, [needs(A2, B2, AddrA, ReplyA?)|Ps], Ps?) :-
    A? =?= A2?, B? =?= B2? |
    complete_rendezvous(AddrA?, ReplyA, ReplyB).

%% No match at this entry, keep searching
find_needs(A, B, ReplyB?, [P|Ps], [P?|Ps1?]) :-
    otherwise |
    find_needs(A?, B?, ReplyB, Ps?, Ps1).

%% End of list, no match: store B's availability in pending
find_needs(A, B, ReplyB?, [], [ready(B?, A?, ReplyB)]).

%% =============================================================================
%% complete_rendezvous: Both sides matched — assign reply variables
%% =============================================================================

procedure complete_rendezvous(Constant?, SignalReply, SignalReply).
complete_rendezvous(AddrA, initiated, punch(AddrA?)).

%% =============================================================================
%% STUB for a system predicate (testing only)
%% =============================================================================
%%
%% peer_address(Pk?, Addr) — body predicate
%%   Reads the observed source address of the incoming packet from peer Pk.
%%   Stub: hardcoded mapping for alice, bob, carol.  A real implementation
%%   would consult the networking layer's recent-packet table.

procedure peer_address(Constant?, Constant).
peer_address(alice, stub_addr_alice).
peer_address(bob, stub_addr_bob).
peer_address(carol, stub_addr_carol).
