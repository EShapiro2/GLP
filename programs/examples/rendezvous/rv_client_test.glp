%% rv_client_test.glp — integration test for rv_client + rv_agent
%%
%% Demonstrates the full end-to-end rendezvous scenario: alice's IP
%% changes, bob detects it, both sides contact the RV agent, the RV
%% agent matches them, and both sides receive their replies.
%%
%% Load rv_agent.glp, rv_client.glp, then this file.

%% Local type redeclarations (structural identity allows sharing)
SignalReply ::= punch(String) ; rejected.

SignalMsg ::= reconnect(Key, Key, SignedTerm, SignalReply?)
            ; available(Key, Key, SignedTerm, SignalReply?).

PendingEntry ::= needs(Key, Key, String, SignalReply?)
               ; ready(Key, Key, String, SignalReply?).
PendingList ::= [] ; [PendingEntry | PendingList].

imported procedure rv_client#make_reconnect(Key?, Key?, SignedTerm?,
                                             SignalMsg, SignalReply).
imported procedure rv_client#make_available(Key?, Key?, SignedTerm?,
                                             SignalMsg, SignalReply).
imported procedure rv_client#handle_reply(SignalReply?).
imported procedure rv_agent#rv_agent(Hash?, Stream(SignalMsg)?,
                                      PendingList?).

%% =============================================================================
%% Test 1: make_reconnect produces the expected message shape
%% =============================================================================

exported procedure test1_make_reconnect(SignalMsg, SignalReply).
test1_make_reconnect(Msg?, Reply?) :-
    rv_client # make_reconnect(alice, bob, sig_ab, Msg, Reply).

%% Expected: Msg = reconnect(alice, bob, sig_ab, <unbound>)
%%           Reply = <unbound>

%% =============================================================================
%% Test 2: make_available produces the expected message shape
%% =============================================================================

exported procedure test2_make_available(SignalMsg, SignalReply).
test2_make_available(Msg?, Reply?) :-
    rv_client # make_available(bob, alice, sig_ba, Msg, Reply).

%% Expected: Msg = available(bob, alice, sig_ba, <unbound>)
%%           Reply = <unbound>

%% =============================================================================
%% Test 3: full scenario — A first, B second
%% =============================================================================
%%
%% Alice's IP changed.  Alice sends reconnect; bob (having detected the
%% disconnect) sends available.  The RV agent takes each attestation apart
%% with signature/2 before it will match them; neither sig_ab nor sig_ba
%% is a signed term, so signature/2 assigns unsigned to each, and
%% admit_reconnect/7 and admit_available/7 reject both.
%%
%% Expected: ReplyA = rejected, ReplyB = rejected

exported procedure test3_full_scenario_a_first(SignalReply, SignalReply).
test3_full_scenario_a_first(ReplyA?, ReplyB?) :-
    rv_client # make_reconnect(alice, bob, sig_ab, MsgA, ReplyA),
    rv_client # make_available(bob, alice, sig_ba, MsgB, ReplyB),
    rv_agent # rv_agent(graph_hash, [MsgA?, MsgB?], []).

%% =============================================================================
%% Test 4: full scenario — B first, A second
%% =============================================================================
%%
%% Bob detects the disconnect and contacts the RV agent before alice
%% has cold-called.  His availability is rejected by admit_available/7,
%% and alice's later reconnect by admit_reconnect/7 — the mirror of test 3,
%% and the same outcome.
%%
%% Expected: ReplyA = rejected, ReplyB = rejected

exported procedure test4_full_scenario_b_first(SignalReply, SignalReply).
test4_full_scenario_b_first(ReplyA?, ReplyB?) :-
    rv_client # make_reconnect(alice, bob, sig_ab, MsgA, ReplyA),
    rv_client # make_available(bob, alice, sig_ba, MsgB, ReplyB),
    rv_agent # rv_agent(graph_hash, [MsgB?, MsgA?], []).

%% =============================================================================
%% Test 5: full scenario with handle_reply dispatch
%% =============================================================================
%%
%% Runs the full scenario and then has each client dispatch on the reply
%% the scenario binds for it.  Both requests are rejected, so both replies
%% take handle_reply's rejected arm.  The punch arm is covered directly by
%% test 7.

exported procedure test5_full_scenario_with_handlers.
test5_full_scenario_with_handlers :-
    rv_client # make_reconnect(alice, bob, sig_ab, MsgA, ReplyA),
    rv_client # make_available(bob, alice, sig_ba, MsgB, ReplyB),
    rv_agent # rv_agent(graph_hash, [MsgA?, MsgB?], []),
    rv_client # handle_reply(ReplyA?),
    rv_client # handle_reply(ReplyB?).

%% Expected: succeeds — ReplyA = ReplyB = rejected, each taking
%% handle_reply's rejected arm

%% =============================================================================
%% Test 6: rejected proof — reply is rejected
%% =============================================================================
%%
%% Alice sends reconnect carrying a Sig that is not bob's signature over
%% attest(alice, bob).  signature/2 assigns unsigned and admit_reconnect/7's
%% otherwise clause binds rejected; the needs entry is never stored.  Bob's
%% availability carries no signature of alice's either, and is rejected by
%% admit_available/7.
%%
%% Expected: ReplyA = rejected, ReplyB = rejected

exported procedure test6_bad_signature(SignalReply, SignalReply).
test6_bad_signature(ReplyA?, ReplyB?) :-
    rv_client # make_reconnect(alice, bob, bad_sig, MsgA, ReplyA),
    rv_client # make_available(bob, alice, sig_ba, MsgB, ReplyB),
    rv_agent # rv_agent(graph_hash, [MsgA?, MsgB?], []).

%% =============================================================================
%% Test 7: handle_reply dispatches punch(Addr) to punch_udp
%% =============================================================================
%%
%% The punch arm is unreachable through the RV agent under the plain REPL,
%% where no test presents an attestation signed under the social graph, so
%% it is exercised on a literal reply.  The guard is ground(Addr?) and
%% punch_udp is the root's, which under the plain REPL, no networking layer
%% bound, returns having done nothing (IGLP, "One interface").

exported procedure test7_handle_reply_punch.
test7_handle_reply_punch :-
    rv_client # handle_reply(punch(stub_addr_alice)).

%% Expected: succeeds
