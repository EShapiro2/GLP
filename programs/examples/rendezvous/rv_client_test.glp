%% rv_client_test.glp — integration test for rv_client + rv_agent
%%
%% Demonstrates the full end-to-end rendezvous scenario: alice's IP
%% changes, bob detects it, both sides contact the RV agent, the RV
%% agent matches them, and both sides receive their replies.
%%
%% Load rv_agent.glp, rv_client.glp, then this file.

%% Local type redeclarations (structural identity allows sharing)
SignalReply ::= punch(Constant) ; initiated ; rejected.

SignalMsg ::= reconnect(Constant, Constant, Constant, Constant, SignalReply?)
            ; available(Constant, Constant, SignalReply?).

PendingEntry ::= needs(Constant, Constant, Constant, SignalReply?)
               ; ready(Constant, Constant, SignalReply?).
PendingList ::= [] ; [PendingEntry | PendingList].

imported procedure rv_client#make_reconnect(Constant?, Constant?, Constant?,
                                             Constant?,
                                             SignalMsg, SignalReply).
imported procedure rv_client#make_available(Constant?, Constant?,
                                             SignalMsg, SignalReply).
imported procedure rv_client#handle_reply(SignalReply?).
imported procedure rv_agent#rv_agent(Stream(SignalMsg)?, PendingList?).

%% =============================================================================
%% Test 1: make_reconnect produces the expected message shape
%% =============================================================================

exported procedure test1_make_reconnect(SignalMsg, SignalReply).
test1_make_reconnect(Msg?, Reply?) :-
    rv_client # make_reconnect(alice, bob, bob, sig_ab, Msg, Reply).

%% Expected: Msg = reconnect(alice, bob, bob, sig_ab, <unbound>)
%%           Reply = <unbound>

%% =============================================================================
%% Test 2: make_available produces the expected message shape
%% =============================================================================

exported procedure test2_make_available(SignalMsg, SignalReply).
test2_make_available(Msg?, Reply?) :-
    rv_client # make_available(bob, alice, Msg, Reply).

%% Expected: Msg = available(bob, alice, <unbound>)
%%           Reply = <unbound>

%% =============================================================================
%% Test 3: full scenario — A first, B second
%% =============================================================================
%%
%% Alice's IP changed.  Alice sends reconnect; bob (having detected the
%% disconnect) sends available.  The RV agent verifies the attestation in a
%% guard before it will match them, and under the plain REPL there is no
%% madGLP network for valid_attestation/4 to check it against, so the
%% reconnect is rejected and bob's availability is left waiting.
%%
%% Expected: ReplyA = rejected, ReplyB unbound

exported procedure test3_full_scenario_a_first(SignalReply, SignalReply).
test3_full_scenario_a_first(ReplyA?, ReplyB?) :-
    rv_client # make_reconnect(alice, bob, bob, sig_ab, MsgA, ReplyA),
    rv_client # make_available(bob, alice, MsgB, ReplyB),
    rv_agent # rv_agent([MsgA?, MsgB?], []).

%% =============================================================================
%% Test 4: full scenario — B first, A second
%% =============================================================================
%%
%% Bob detects the disconnect and contacts the RV agent before alice
%% has cold-called, so his availability is stored first.  Alice's later
%% reconnect is rejected in the guard, so the stored entry is never
%% matched — the mirror of test 3, and the same outcome.
%%
%% Expected: ReplyA = rejected, ReplyB unbound

exported procedure test4_full_scenario_b_first(SignalReply, SignalReply).
test4_full_scenario_b_first(ReplyA?, ReplyB?) :-
    rv_client # make_reconnect(alice, bob, bob, sig_ab, MsgA, ReplyA),
    rv_client # make_available(bob, alice, MsgB, ReplyB),
    rv_agent # rv_agent([MsgB?, MsgA?], []).

%% =============================================================================
%% Test 5: full scenario with handle_reply dispatch
%% =============================================================================
%%
%% Runs the full scenario and then dispatches on the reply the scenario
%% binds.  Only alice's is bound — the reconnect is rejected, so bob's
%% reply stays unbound and handle_reply on it would suspend forever
%% rather than fail.  The punch arm is covered directly by test 7.

exported procedure test5_full_scenario_with_handlers.
test5_full_scenario_with_handlers :-
    rv_client # make_reconnect(alice, bob, bob, sig_ab, MsgA, ReplyA),
    rv_client # make_available(bob, alice, MsgB, _),
    rv_agent # rv_agent([MsgA?, MsgB?], []),
    rv_client # handle_reply(ReplyA?).

%% Expected: succeeds — ReplyA = rejected takes handle_reply's rejected arm

%% =============================================================================
%% Test 6: rejected proof — reply is rejected
%% =============================================================================
%%
%% Alice sends reconnect carrying a signature that is not Signer's over
%% attest(alice, bob).  The RV agent's valid_attestation/4 guard fails and
%% the otherwise clause binds rejected; the needs entry is never stored, so
%% bob's availability finds nothing to match.
%%
%% Expected: ReplyA = rejected, ReplyB unbound

exported procedure test6_bad_signature(SignalReply, SignalReply).
test6_bad_signature(ReplyA?, ReplyB?) :-
    rv_client # make_reconnect(alice, bob, bob, bad_sig, MsgA, ReplyA),
    rv_client # make_available(bob, alice, MsgB, ReplyB),
    rv_agent # rv_agent([MsgA?, MsgB?], []).

%% =============================================================================
%% Test 7: handle_reply dispatches punch(Addr) to punch_udp
%% =============================================================================
%%
%% The punch arm is unreachable through the RV agent while the guard has no
%% network to verify against, so it is exercised on a literal reply.  The
%% guard is ground(Addr?) and punch_udp is rv_client's stub.

exported procedure test7_handle_reply_punch.
test7_handle_reply_punch :-
    rv_client # handle_reply(punch(stub_addr_alice)).

%% Expected: succeeds
