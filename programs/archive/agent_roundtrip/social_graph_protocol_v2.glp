%% social_graph_protocol.glp - Social Graph Cold-Call Befriending Protocol
%% Source: Art-of-GLP-2025, Chapter: The Grassroots Social Graph
%% Version: 2.0 - SRSW compliant, proper declaration placement
%%
%% Implements cold-call connection establishment between agents.
%% Each agent maintains a friends list and processes messages from
%% user, network, and established friends through a unified input stream.

%% =============================================================================
%% TYPE DEFINITIONS (must appear before use)
%% =============================================================================

%% Decision type
Decision ::= yes ; no.

%% Response types for connection offers
Resp ::= accept(FriendChannel) ; no.

%% Lookup result type
LookupResult ::= found(FriendStream) ; not_found.

%% Message operations
MsgOp ::= connect(Constant)              % User requests connection to target
        ; intro(Constant, Constant, Resp?)  % Introduction offer (from, from, response slot)
        ; befriend(Constant, Resp?)       % Ask user to approve (from, response slot)
        ; decision(Decision, Constant, Resp)  % User decision (yes/no, from, response)
        ; response(Resp?).                % Response to our offer

%% Protocol message: msg(From, To, Operation)
Msg ::= msg(Constant, Constant, MsgOp).

%% Tagged content from friend channels
TaggedMsg ::= tagged(Constant, Msg).

%% Unified message stream (protocol messages and tagged friend content)
MsgItem ::= Msg ; TaggedMsg.
MsgStream ::= [] ; [MsgItem | MsgStream].

%% Friend streams and channels
FriendStream  ::= [] ; [Msg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

%% Friends list: list of (name, output_stream) pairs
FriendEntry ::= (Constant, FriendStream).
FriendList ::= [] ; [FriendEntry | FriendList].

%% =============================================================================
%% MERGE: Combine two message streams
%% =============================================================================

procedure merge(MsgStream?, MsgStream?, MsgStream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

%% Agent entry point - pattern matches channel structures directly in head
%% (avoids SRSW violation from guard-based unification)
procedure agent(_?, Channel(X, Y)?, Channel(X, Y)?).
agent(Id, ch(UserIn, UserOut), ch(NetIn, NetOut)) :-
    merge(UserIn?, NetIn?, In),
    social_graph(Id?, In?, [(user, UserOut?), (net, NetOut?)]).

%% =============================================================================
%% SOCIAL GRAPH PROTOCOL - Main event loop
%% =============================================================================

procedure social_graph(_?, MsgStream?, FriendList?).

%% Process user request to connect (self-introduction)
social_graph(Id, [msg(user, To, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?), Id? =?= To? |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1, Success),
    handle_connect(Success?, Id?, Target?, Resp?, In?, Fs1?).

%% Process received self-introduction
%% Note: msg(From, To, intro(Src, Src, Resp)) where Src matches From
%% Using ground guards to verify equality rather than structural matching
social_graph(Id, [msg(From, To, intro(Src1, Src2, Resp))|In], Fs) :-
    ground(Id?), ground(From?), Id? =?= To?, From? =?= Src1?, From? =?= Src2? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% Process user decision on received introduction
social_graph(Id, [msg(user, To, decision(Dec, From, Resp))|In], Fs) :-
    ground(Id?), Id? =?= To? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Process response to sent introduction
social_graph(Id, [msg(From, To, response(Resp))|In], Fs) :-
    ground(Id?), Id? =?= To? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Skip unhandled messages
social_graph(Id, [_|In], Fs) :-
    otherwise |
    social_graph(Id?, In?, Fs?).

%% Base case: no more messages
social_graph(_, [], _).

%% =============================================================================
%% HANDLE_CONNECT: Handle result of sending connect request
%% =============================================================================

procedure handle_connect(_?, _?, _?, Resp?, MsgStream?, FriendList?).
handle_connect(yes, Id, Target, Resp, In, Fs) :-
    inject(Resp?, msg(Target?, Id?, response(Resp?)), In?, In1),
    social_graph(Id?, In1?, Fs?).
handle_connect(no, Id, _, _, In, Fs) :-
    social_graph(Id?, In?, Fs?).

%% =============================================================================
%% INJECT: Deferred message insertion
%% When trigger X becomes known, insert message Y into stream
%% =============================================================================

procedure inject(_?, MsgItem?, MsgStream?, MsgStream).
inject(X, Y, Ys, [Y?|Ys?]) :- known(X?) | true.
inject(X, Y, [Y1|Ys], [Y1?|Ys1?]) :- unknown(X?) | inject(X?, Y?, Ys?, Ys1).
inject(_, _, [], []).

%% =============================================================================
%% LOOKUP: Find value in association list
%% =============================================================================

procedure lookup(_?, FriendList?, LookupResult).
lookup(Key, [(K, Value)|_], found(Value?)) :- Key? =?= K? | true.
lookup(Key, [_|Rest], Result?) :-
    otherwise | lookup(Key?, Rest?, Result).
lookup(_, [], not_found).

%% =============================================================================
%% LOOKUP_SEND: Send message via friends list
%% Returns updated list and success flag
%% =============================================================================

procedure lookup_send(_?, Msg?, FriendList?, FriendList, _).
lookup_send(Key, Msg, Fs, Fs1?, Success?) :-
    ground(Key?) |
    lookup(Key?, Fs?, LookupRes),
    send_if_found(LookupRes?, Key?, Msg?, Fs?, Fs1, Success).

%% =============================================================================
%% SEND_IF_FOUND: Complete send operation based on lookup result
%% =============================================================================

procedure send_if_found(LookupResult?, _?, Msg?, FriendList?, FriendList, _).
send_if_found(found(Out), Key, Msg, Fs, Fs1?, yes) :-
    update(Key?, [Msg?|Out?], Fs?, Fs1).
send_if_found(not_found, _, _, Fs, Fs?, no).

%% =============================================================================
%% UPDATE: Replace value for key in association list
%% =============================================================================

procedure update(_?, Stream(X)?, FriendList?, FriendList).
update(Key, NewVal, [(K, _)|Fs], [(K?, NewVal?)|Fs?]) :- Key? =?= K? | true.
update(Key, NewVal, [F|Fs], [F?|Fs1?]) :-
    otherwise | update(Key?, NewVal?, Fs?, Fs1).
update(_, _, [], []).

%% =============================================================================
%% BIND_RESPONSE: Handle user's decision on received offer
%% =============================================================================

procedure bind_response(_?, _?, Resp, FriendList?, FriendList, MsgStream?, MsgStream).
bind_response(yes, From, accept(TheirCh?), Fs, Fs1?, In, In1?) :-
    new_channel(MyCh, TheirCh),
    handle_accept(From?, MyCh?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

%% =============================================================================
%% HANDLE_ACCEPT: Process accepted connection (local side)
%% =============================================================================

procedure handle_accept(_?, Channel(X, Y)?, FriendList?, FriendList, MsgStream?, MsgStream).
handle_accept(From, ch(FIn, FOut), Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).

%% =============================================================================
%% HANDLE_RESPONSE: Process response to our introduction offer
%% =============================================================================

procedure handle_response(Resp?, _?, FriendList?, FriendList, MsgStream?, MsgStream).
handle_response(accept(Ch), From, Fs, Fs1?, In, In1?) :-
    handle_accept(From?, Ch?, Fs?, Fs1, In?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

%% =============================================================================
%% TAG_STREAM: Tag messages with source identifier
%% =============================================================================

procedure tag_stream(_?, Stream(X)?, MsgStream).
tag_stream(Name, [M|In], [tagged(Name?, M?)|Out?]) :-
    constant(Name?) |
    tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% =============================================================================
%% NEW_CHANNEL: Create paired channels (from root self.glp)
%% =============================================================================

procedure new_channel(Channel(X, Y), Channel(X, Y)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).
