%% play_alice_bob_charlie_test_boot.glp - Test boot with GLP actors (no Flutter UI)
%%
%% This file tests the alice-bob-charlie play using GLP actor procedures
%% instead of Flutter UI windows. Each isolate spawns both agent and actor.
%%
%% Scenario (left-to-right: Alice - Bob - Charlie):
%% 1. Alice cold-calls Bob (Bob accepts)
%% 2. Alice sends message to Bob: "Hi Bob, this is Alice"
%% 3. Bob cold-calls Charlie (Charlie accepts)
%% 4. Charlie sends message to Bob: "Hi Bob, this is Charlie"
%% 5. Bob introduces Alice to Charlie (both accept)
%% 6. Alice sends message to Charlie: "Hi Charlie, this is Alice"
%% 7. Charlie responds to Alice: "Hi Alice, this is Charlie"
%%
%% Date: 2026-01-28

%% =============================================================================
%% THE boot - spawns agent_with_actor for each agent
%% =============================================================================

procedure boot.
boot :-
    agent_with_actor(alice, ch(_?,_), ch(_?,_))@alice,
    agent_with_actor(bob, ch(_?,_), ch(_?,_))@bob,
    agent_with_actor(charlie, ch(_?,_), ch(_?,_))@charlie.

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Response ::= accept(Channel) ; no.
FriendEntry ::= friend(String, Stream?).
FriendsList ::= [] ; [FriendEntry|FriendsList].

%% =============================================================================
%% CHANNEL OPERATIONS (Defined Guards)
%% =============================================================================

%% Unification (from stdlib - not loaded in isolates)
X = X?.

%% send(Msg, ChIn, ChOut) - send message on channel
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

%% receive(Msg, ChIn, ChOut) - receive message from channel
receive(X?, ch([X|In], Out?), ch(In?, Out)).

%% new_channel(Ch1, Ch2) - create connected channel pair
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, Stream?, Stream).
tag_stream(Name, [M|In], [msg(Name?, Name?, M?)|Out?]) :-
    ground(Name?) | tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% =============================================================================
%% LOOKUP_SEND - send message to named destination
%% =============================================================================

procedure lookup_send(String?, _?, FriendsList?, FriendsList).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(String?, _?, FriendsList?, FriendsList).
lookup_send_step(Key, Msg, [friend(K, [Msg?|Out1?])|Rest], [friend(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [friend(K, Out?)|Rest], [friend(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, _?, Stream?, Stream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% ADD_FRIEND - add friend to friends list
%% =============================================================================

procedure add_friend(_?, Stream, FriendsList?, FriendsList).
add_friend(Name, Out?, Fs, [friend(Name?, Out)|Fs?]).

%% =============================================================================
%% RESPONSE HANDLING (Cold-call)
%% =============================================================================

procedure bind_response(_?, _?, Response, FriendsList?, FriendsList, Stream?, Stream).
bind_response(yes, From, accept(RetCh?), Fs, Fs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

procedure handle_response(Response?, _?, FriendsList?, FriendsList, Stream?, Stream).
handle_response(accept(ch(FIn, FOut?)), From, Fs, Fs1?, In, In1?) :-
    ground(From?) |
    merge(In?, FIn?, In1),
    add_friend_and_notify(From?, FOut, Fs?, Fs1).
handle_response(no, From, Fs, Fs1?, In, In?) :-
    ground(From?) |
    lookup_send(user, msg(agent, user, rejected(From?)), Fs?, Fs1).

procedure add_friend_and_notify(_?, Stream, FriendsList?, FriendsList).
add_friend_and_notify(From, FOut?, Fs, [friend(From?, FOut)|Fs1?]) :-
    ground(From?) |
    lookup_send(user, msg(agent, user, connected(From?)), Fs?, Fs1).

%% =============================================================================
%% AGENT - Main loop (Cold-call + Messaging + Friend Introduction)
%% =============================================================================

procedure agent(_?, Stream?, FriendsList?).

%% --- Cold-call protocol ---

%% User initiates cold call
%% Cold-call uses 2-arg msg: msg(Target, intro(From, Resp))
agent(Id, [msg(user, Id1, connect(Target))|In], Fs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send(net, msg(Target?, intro(Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Received cold-call introduction (2-arg msg, 2-arg intro)
agent(Id, [msg(Id1, intro(From, Resp))|In], Fs) :-
    Id? =?= Id1? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User decision on cold-call introduction
agent(Id, [msg(user, Id1, decision(Dec, From, Resp?))|In], Fs) :-
    Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Response to sent cold-call introduction
agent(Id, [msg(From, Id1, response(Resp))|In], Fs) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% --- Text messaging ---

%% User sends text message to friend
agent(Id, [msg(user, Id1, send(Target, Text))|In], Fs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send(Target?, msg(Id?, Target?, text(Text?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% Received text message from friend - forward to user
agent(Id, [msg(From, Id1, text(Text))|In], Fs) :-
    Id? =?= Id1? |
    lookup_send(user, msg(agent, user, received(From?, Text?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% --- Friend-mediated introduction protocol ---

%% User commands: introduce P to Q (creates bidirectional channel)
agent(Id, [msg(user, Id1, introduce(P, Q))|In], Fs) :-
    Id? =?= Id1?, ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    lookup_send(P?, msg(Id?, P?, intro(Q?, QPCh?)), Fs?, Fs1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, PQCh?)), Fs1?, Fs2),
    agent(Id?, In?, Fs2?).

%% Received introduction from friend (3-arg msg, 2-arg intro) - forward to user
agent(Id, [msg(From, Id1, intro(Other, Ch))|In], Fs) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send(user, msg(agent, user, befriend_intro(From?, Other?, Ch?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User accepts friend introduction
agent(Id, [msg(user, Id1, accept_intro(Other, Ch))|In], Fs) :-
    Id? =?= Id1?, ground(Other?) |
    handle_intro_accept(Ch?, Other?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% User rejects friend introduction
agent(Id, [msg(user, Id1, reject_intro(_))|In], Fs) :-
    Id? =?= Id1? |
    agent(Id?, In?, Fs?).

%% --- Catch-all and termination ---

agent(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    agent(Id?, In?, Fs?).

agent(_, [], _).

%% =============================================================================
%% HANDLE_INTRO_ACCEPT - process accepted friend introduction
%% =============================================================================

procedure handle_intro_accept(Channel?, _?, FriendsList?, FriendsList, Stream?, Stream).
handle_intro_accept(ch(FIn, FOut?), Other, Fs, Fs1?, In, In1?) :-
    ground(Other?) |
    add_friend(Other?, FOut, Fs?, Fs1),
    merge(In?, FIn?, In1).

%% =============================================================================
%% AGENT INITIALIZATION WITH ACTOR
%% =============================================================================

%% Main entry point: spawns both agent and actor in parallel
%% Creates a NEW channel pair so agent and actor have connected endpoints:
%% - Agent reads from actor output, writes to actor input
%% - Actor reads from agent output, writes to agent input
procedure agent_with_actor(_?, Channel?, Channel?).
agent_with_actor(Id, _, NetCh) :-
    ground(Id?), new_channel(AgentUICh, ActorUICh) |
    agent_init(Id?, AgentUICh?, NetCh?),
    run_actor(Id?, ActorUICh?).

procedure agent_init(_?, Channel?, Channel?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    agent(Id?, In?, [friend(user, UserOut), friend(net, NetOut)]).

%% =============================================================================
%% ACTOR DISPATCH - routes to agent-specific actor
%% =============================================================================

procedure run_actor(_?, Channel?).
run_actor(alice, Ch) :- alice_actor(Ch?).
run_actor(bob, Ch) :- bob_actor(Ch?).
run_actor(charlie, Ch) :- charlie_actor(Ch?).

%% =============================================================================
%% ALICE ACTOR - Initiates cold-call to Bob, sends messages
%% =============================================================================

%% Alice's script:
%% 1. Cold-call Bob
%% 2. When connected, send "Hi Bob, this is Alice"
%% 3. When introduced to Charlie, accept and send "Hi Charlie, this is Alice"

procedure alice_actor(Channel?).
alice_actor(ch(In, Out?)) :-
    Out = [msg(user, alice, connect(bob))|Out1?],
    alice_wait_connected(In?, Out1).

procedure alice_wait_connected(Stream?, Stream).
%% Received connected notification - send message to Bob
alice_wait_connected([msg(agent, user, connected(bob))|In], Out?) :-
    Out = [msg(user, alice, send(bob, hello_bob_from_alice))|Out1?],
    alice_wait_intro(In?, Out1).
%% Skip other messages
alice_wait_connected([_|In], Out?) :-
    otherwise |
    alice_wait_connected(In?, Out).

procedure alice_wait_intro(Stream?, Stream).
%% Received introduction from Bob about Charlie - accept it
alice_wait_intro([msg(agent, user, befriend_intro(bob, charlie, Ch))|In], Out?) :-
    Out = [msg(user, alice, accept_intro(charlie, Ch?))|Out1?],
    alice_wait_charlie_connected(In?, Out1).
%% Skip other messages
alice_wait_intro([_|In], Out?) :-
    otherwise |
    alice_wait_intro(In?, Out).

procedure alice_wait_charlie_connected(Stream?, Stream).
%% Now we should be able to message Charlie - send greeting
alice_wait_charlie_connected(In, Out?) :-
    Out = [msg(user, alice, send(charlie, hello_charlie_from_alice))|Out1?],
    alice_wait_response(In?, Out1).

procedure alice_wait_response(Stream?, Stream).
%% Received message from Charlie - done!
alice_wait_response([msg(agent, user, received(charlie, _))|_], []).
%% Skip other messages
alice_wait_response([_|In], Out?) :-
    otherwise |
    alice_wait_response(In?, Out).
alice_wait_response([], []).

%% =============================================================================
%% BOB ACTOR - Accepts Alice's cold-call, cold-calls Charlie, introduces them
%% =============================================================================

%% Bob's script:
%% 1. Accept Alice's cold-call
%% 2. Cold-call Charlie
%% 3. When connected to Charlie, introduce Alice to Charlie

procedure bob_actor(Channel?).
bob_actor(ch(In, Out?)) :-
    bob_wait_befriend(In?, Out).

procedure bob_wait_befriend(Stream?, Stream).
%% Received befriend request from Alice - accept it
bob_wait_befriend([msg(agent, user, befriend(alice, Resp?))|In], Out?) :-
    Out = [msg(user, bob, decision(yes, alice, Resp))|Out1?],
    bob_coldcall_charlie(In?, Out1).
%% Skip other messages
bob_wait_befriend([_|In], Out?) :-
    otherwise |
    bob_wait_befriend(In?, Out).

procedure bob_coldcall_charlie(Stream?, Stream).
%% Initiate cold-call to Charlie
bob_coldcall_charlie(In, Out?) :-
    Out = [msg(user, bob, connect(charlie))|Out1?],
    bob_wait_charlie_connected(In?, Out1).

procedure bob_wait_charlie_connected(Stream?, Stream).
%% Connected to Charlie - now introduce Alice to Charlie
bob_wait_charlie_connected([msg(agent, user, connected(charlie))|In], Out?) :-
    Out = [msg(user, bob, introduce(alice, charlie))|Out1?],
    bob_wait_done(In?, Out1).
%% Skip other messages
bob_wait_charlie_connected([_|In], Out?) :-
    otherwise |
    bob_wait_charlie_connected(In?, Out).

procedure bob_wait_done(Stream?, Stream).
%% Bob is done after introducing - just consume remaining messages
bob_wait_done([_|In], Out?) :- bob_wait_done(In?, Out).
bob_wait_done([], []).

%% =============================================================================
%% CHARLIE ACTOR - Accepts Bob's cold-call, accepts intro to Alice, responds
%% =============================================================================

%% Charlie's script:
%% 1. Accept Bob's cold-call
%% 2. Send message to Bob: "Hi Bob, this is Charlie"
%% 3. Accept introduction from Bob about Alice
%% 4. When Alice messages, respond: "Hi Alice, this is Charlie"

procedure charlie_actor(Channel?).
charlie_actor(ch(In, Out?)) :-
    charlie_wait_befriend(In?, Out).

procedure charlie_wait_befriend(Stream?, Stream).
%% Received befriend request from Bob - accept it
charlie_wait_befriend([msg(agent, user, befriend(bob, Resp?))|In], Out?) :-
    Out = [msg(user, charlie, decision(yes, bob, Resp))|Out1?],
    charlie_send_hello_bob(In?, Out1).
%% Skip other messages
charlie_wait_befriend([_|In], Out?) :-
    otherwise |
    charlie_wait_befriend(In?, Out).

procedure charlie_send_hello_bob(Stream?, Stream).
%% Send greeting to Bob
charlie_send_hello_bob(In, Out?) :-
    Out = [msg(user, charlie, send(bob, hello_bob_from_charlie))|Out1?],
    charlie_wait_intro(In?, Out1).

procedure charlie_wait_intro(Stream?, Stream).
%% Received introduction from Bob about Alice - accept it
charlie_wait_intro([msg(agent, user, befriend_intro(bob, alice, Ch))|In], Out?) :-
    Out = [msg(user, charlie, accept_intro(alice, Ch?))|Out1?],
    charlie_wait_alice_msg(In?, Out1).
%% Skip other messages
charlie_wait_intro([_|In], Out?) :-
    otherwise |
    charlie_wait_intro(In?, Out).

procedure charlie_wait_alice_msg(Stream?, Stream).
%% Received message from Alice - respond
charlie_wait_alice_msg([msg(agent, user, received(alice, _))|In], Out?) :-
    Out = [msg(user, charlie, send(alice, hello_alice_from_charlie))|Out1?],
    charlie_done(In?, Out1).
%% Skip other messages
charlie_wait_alice_msg([_|In], Out?) :-
    otherwise |
    charlie_wait_alice_msg(In?, Out).

procedure charlie_done(Stream?, Stream).
%% Charlie is done
charlie_done([_|In], Out?) :- charlie_done(In?, Out).
charlie_done([], []).
