%% ---------------------------------------------------------------------------
%% GFF-FR.glp --- Fault-Resilient GFF, GFF's, in the clause syntax of GSC's paper, Section 3.2,
%% the term form GDO-LB.glp writes.  It restricts GFF-I, adding redundant_follow (GSC, Proposition Syntactic restrictions, (b)); redundancy(d) is an environment predicate.
%% Friends have each other's pointers, labeled by the friend, with no atom
%% (GDO-L's preamble; Udi, 2026-11-07): a body requiring a Dave-pointer to Bob
%% reads the atom or the friendship with Bob, Bob being Dave.  Every role
%% requires identity.  The clauses are in GFF-FR.txt beside this file.
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant)
              ; sgn(Constant, Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SHead       ::= SMult ; not(SMult) ; forall(PNames, SAtom, SCond, SHeads).
SHeads      ::= [] ; [SHead | SHeads].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr)
              ; fn(Constant, SExprs) ; cardinality(PNames, SAtom, SCond).
SExprs      ::= [] ; [SExpr | SExprs].
SCond       ::= true ; SMult ; not(SCond) ; and(SCond, SCond) ; or(SCond, SCond)
              ; eq(SExpr, SExpr) ; ne(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg)
              ; forall(PNames, SAtom, SCond, SCond) ; exists(PNames, SAtom, SCond).
SConds      ::= [] ; [SCond | SConds].
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SHeads, SConds, SCond, PNames).
Contract    ::= [] ; [Schema | Contract].
Preds       ::= [] ; [Constant | Preds].
Declared    ::= Contract ; environment(Preds, Contract).

%% contract_named(gff_fr, C): the contract, GFF-FR.
procedure contract_named(Constant?, Declared).
contract_named(gff_fr, environment([redundancy],
   [sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice']))],
       true, ['Alice', 'Bob']),
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
%% GDO:1, Pointing to friend.
    sas(point_friend, ['Alice', 'Bob'], [],
       [atom(points_to, ['Alice', 'Bob'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), not(atom(points_to, ['Alice', 'Bob'])), atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDO:2, Transitive pointing.
    sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(points_to, ['Alice', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), atom(points_to, ['Alice', 'Bob']), atom(identity, ['Bob']), atom(points_to, ['Bob', 'Carol'])],
       true,
       ['Alice']),
%% GDO:3, Ceasing to point.
    sas(unpoint, ['Alice', 'Bob'], [],
       [not(atom(points_to, ['Alice', 'Bob']))],
       [atom(identity, ['Alice']), atom(points_to, ['Alice', 'Bob']), atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDO-L:1, Labeled pointing to friend: a Dave-pointer to friend Bob, who has one, explicit or, Bob being Dave's friend, implied.
    sas(follow_friend, ['Alice', 'Bob', 'Dave', 'Carol'], ['Dave', 'Carol'],
       [atom(lpoints_to, ['Alice', 'Bob', 'Dave'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), not(atom(lpoints_to, ['Alice', 'Bob', 'Dave'])), atom(identity, ['Bob']), or(atom(lpoints_to, ['Bob', 'Carol', 'Dave']), and(atom(friend, ['Bob', 'Carol']), eq('Carol', 'Dave')))],
       true,
       ['Alice']),
%% GFF-I:1 (GDO-L:2, only if Carol knows Alice; Carol a reading role), Labeled transitive pointing, through a Dave-pointer to Bob.
    sas(follow_transitive, ['Alice', 'Bob', 'Carol', 'Dave'], ['Dave'],
       [atom(lpoints_to, ['Alice', 'Carol', 'Dave'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), atom(lpoints_to, ['Alice', 'Bob', 'Dave']), not(atom(lpoints_to, ['Alice', 'Carol', 'Dave'])), not(and(atom(friend, ['Alice', 'Carol']), eq('Carol', 'Dave'))), atom(identity, ['Bob']), or(atom(lpoints_to, ['Bob', 'Carol', 'Dave']), and(atom(friend, ['Bob', 'Carol']), eq('Carol', 'Dave'))), atom(identity, ['Carol']), atom(knows, ['Carol', 'Alice'])],
       true,
       ['Alice']),
%% GFF-I:1 (GDO-L:2, only if Carol knows Alice; Carol a reading role), Labeled transitive pointing, through Alice's friend Bob.
    sas(follow_transitive_friend, ['Alice', 'Bob', 'Carol', 'Dave'], ['Dave'],
       [atom(lpoints_to, ['Alice', 'Carol', 'Dave'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']), not(atom(lpoints_to, ['Alice', 'Carol', 'Dave'])), not(and(atom(friend, ['Alice', 'Carol']), eq('Carol', 'Dave'))), atom(identity, ['Bob']), or(atom(lpoints_to, ['Bob', 'Carol', 'Dave']), and(atom(friend, ['Bob', 'Carol']), eq('Carol', 'Dave'))), atom(identity, ['Carol']), atom(knows, ['Carol', 'Alice'])],
       true,
       ['Alice']),
%% GDO-L:3, Ceasing to point: a Dave-pointer Alice added.
    sas(unfollow, ['Alice', 'Bob', 'Dave'], ['Dave'],
       [not(atom(lpoints_to, ['Alice', 'Bob', 'Dave']))],
       [atom(identity, ['Alice']), atom(lpoints_to, ['Alice', 'Bob', 'Dave']), atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GFF:1, Feed.  The item x occurs in no atom the act requires, so Alice signs it.
    sas(post, ['Alice'], [x],
       [atom(item, ['Alice', x, 'Alice'])],
       [atom(identity, ['Alice']), not(atom(item, ['Alice', x, 'Alice']))],
       true,
       ['Alice']),
%% GFF-I:2, Delivery: GFF:2, only if Bob knows Alice; Bob its first role and a reading role, received(Alice, x, Carol, Bob) its signature atom.
    sas(deliver, ['Bob', 'Alice', 'Carol'], ['Carol', x],
       [atom(item, ['Alice', x, 'Carol']), atom(received, ['Alice', x, 'Carol', 'Bob'])],
       [atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), atom(item, ['Bob', x, 'Carol']), atom(identity, ['Alice']), or(atom(lpoints_to, ['Alice', 'Bob', 'Carol']), and(atom(friend, ['Alice', 'Bob']), eq('Bob', 'Carol'))), not(atom(item, ['Alice', x, 'Carol']))],
       true,
       []),
%% GFF-FR:1, Redundant following: no guarding role; Bob a reading role; lpoints_to(Alice, Bob, Carol), added, its signature atom; Carol-pointers counted with the one friendship with Carol implies; dd is the contract's d.
    sas(redundant_follow, ['Alice', 'Bob', 'Carol', c, e, f, g], ['Carol', dd],
       [atom(lpoints_to, ['Alice', 'Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), not(atom(lpoints_to, ['Alice', 'Bob', 'Carol'])), or(exists([c], atom(lpoints_to, ['Alice', c, 'Carol']), true), atom(friend, ['Alice', 'Carol'])), atom(redundancy, ['Alice', num(dd)]), atom(identity, ['Bob']), or(exists([e], atom(lpoints_to, ['Bob', e, 'Carol']), true), atom(friend, ['Bob', 'Carol']))],
       lt(plus(cardinality([f], atom(lpoints_to, ['Alice', f, 'Carol']), true), cardinality([g], atom(friend, ['Alice', g]), eq(g, 'Carol'))), num(dd)),
       [])
])).
