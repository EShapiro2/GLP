% programs/self.glp — Root type and procedure declarations
% This is the outermost ancestor in the scope chain, visible to every project.
-mode(system).

% Shared output/injection/introduction routers (A5 Stage B).  Exposed from the
% root because it is the only common ancestor of social/* and the sibling
% currencies/.  Each platform instantiates the parameterised routers at its own
% entry-union and message types; per-instantiation checking validates each.
-expose(social#graph#routing#output).
-expose(social#graph#routing#inject).
-expose(social#graph#routing#intro).
-expose(social#graph#routing#befriend).

% send_to_net/1, on the same ground: it is called from forty-six modules across
% the tree and the root is their only common ancestor.  Its clauses stay in
% programs/system/mad_predicates.glp, which exports it and nothing else, so
% resolution happens where the clauses live and global_send/3 stays confined to
% that system module (GLP-Spec, 2026-08-02).
-expose(system#mad_predicates).

% =============================================================================
% TYPE DEFINITIONS
% =============================================================================

% Collections (parameterized)
Stream(X) ::= [] ; [X | Stream(X)].
OpenStream(X) ::= [X | Stream(X)].
DiffList(X) ::= Stream(X) \ Stream(X)?.

% Communication (parameterized)
Channel(In, Out) ::= ch(In, Out?).

% A closed stream: the empty stream, with no further elements.  Used to type the
% close/1 defined guard, which consumes a closed read stream (see below).
Closed ::= [].

% Derived types.  The primitive types are Integer, Real, String and Module;
% Number and Constant are defined here (TGLP appendix "GLP Language Primitives").
Number ::= Integer ; Real.
Constant ::= Number ; String ; Module.

% Arithmetic expressions
Exp ::= Number ; +(Exp, Exp) ; -(Exp, Exp) ; *(Exp, Exp) ; /(Exp, Exp) ; //(Exp, Exp) ; mod(Exp, Exp) ; neg(Exp).

% Multiway merge (mwm/2 below).  Its input is a stream of merge(Stream(X))
% terms, each carrying one stream to be merged into the output.
MwmStream(X) ::= merge(Stream(X)).
MwmInput(X) ::= [] ; [MwmStream(X) | MwmInput(X)].

% Short-circuit termination token, threaded through mwm1/4 and mwm_copy/4.
Done ::= done.

% =============================================================================
% BUILTIN PROCEDURE DECLARATIONS (no clauses - implemented by runtime)
% =============================================================================

% Type guards
procedure integer(Integer?).
procedure number(Number?).
procedure string(String?).
procedure constant(Constant?).
procedure compound(_?).
procedure list(_?).
procedure module(Module?).
% Groundness guards
procedure ground(_?).
procedure known(_?).
procedure unknown(_?).
procedure no_readers(_?).

% Attestation guard — holds iff the fourth argument is the first's signature
% over the pair (PkA, PkB).  Implemented in the runtime guard machinery
% (bytecode/runner.dart); Secure-GLP renames it verify/3.
procedure valid_attestation(Constant?, Constant?, Constant?, Constant?).

% Time guards
procedure wait(Number?).
procedure wait_until(Number?).

% Arithmetic comparison guards
procedure <(Exp?, Exp?).
procedure >(Exp?, Exp?).
procedure =<(Exp?, Exp?).
procedure >=(Exp?, Exp?).
procedure =:=(Exp?, Exp?).
procedure =\=(Exp?, Exp?).

% Lexicographic comparison of ground constants
procedure @<(Constant?, Constant?).

% Equality guard
procedure =?=(_?, _?).

% Univ operations (term ↔ list conversion)
procedure =..(_, Stream(_)?).      % Compose: Stream? → Compound
procedure ..=(Stream(_), _?).      % Decompose: Compound? → Stream

% MWM (Mutual Write Merge) runtime guard
procedure is_mutual_ref(_?).

% =============================================================================
% BODY KERNELS (no clauses - implemented by runtime)
% =============================================================================
%
% Body kernels get ordinary clause-less declarations here, like every other
% runtime-implemented predicate (Udi, 2026-07-29).  Declaring them costs nothing
% in access control: only a system module may name one in call position, so no
% application module can call '_add' whatever this file declares (appendix
% "Admission to the Primitive Layer"; GLP-Spec appendix-guards.tex, "Naming and
% admission of body kernels").  What it buys is compile-time checking of a
% kernel call's argument types and arity, and a loadable programs/system/ module:
% the body-atom type checker demands a declaration for every body atom, so
% without these a real system module that names a kernel failed to load with
% "Undefined procedure: _send/3".
%
% Every kernel registered by runtime/body_kernels.dart and
% engine_v2/module_kernels.dart is here, save the five of the Network group.  The
% signatures are GLP-Spec's appendix-guards.tex body-kernel table, which is the
% authority.  '_trust_declare' is the one row the table is ahead of the code on:
% nothing registers it, so trust_declare/2 below wraps a kernel that does not yet
% exist.  The other four — '_peer_address', '_punch_udp', '_place_declare',
% '_place_remove' — were registered by 9d5e0dd9 and are still undeclared here,
% and not by choice: parser.dart:191 admits a clause-less root declaration only
% for a name in the Dart builtinProcedures set, and the four are not in it, so
% declaring them here fails the root scope and takes every load in the tree with
% it.  The four set entries are IGLP's to add and the declarations follow them.
%
% This file may name them because it declares -mode(system).

% Arithmetic
procedure '_add'(Number?, Number?, Number).
procedure '_sub'(Number?, Number?, Number).
procedure '_mul'(Number?, Number?, Number).
procedure '_div'(Number?, Number?, Number).
procedure '_idiv'(Integer?, Integer?, Integer).
procedure '_mod'(Integer?, Integer?, Integer).
procedure '_neg'(Number?, Number).

% Math
procedure '_abs'(Number?, Number).
procedure '_sqrt'(Number?, Number).
procedure '_sin'(Number?, Number).
procedure '_cos'(Number?, Number).
procedure '_tan'(Number?, Number).
procedure '_exp'(Number?, Number).
procedure '_ln'(Number?, Number).
procedure '_log10'(Number?, Number).
procedure '_pow'(Number?, Number?, Number).
procedure '_asin'(Number?, Number).
procedure '_acos'(Number?, Number).
procedure '_atan'(Number?, Number).

% Conversion
procedure '_integer'(Number?, Integer).
procedure '_real'(Number?, Number).
procedure '_round'(Number?, Integer).
procedure '_floor'(Number?, Integer).
procedure '_ceil'(Number?, Integer).

% Structure
procedure '_list_to_tuple'(Stream(_)?, _).
procedure '_tuple_to_list'(_?, Stream(_)).

% Copy
procedure '_copy'(_?, _).

% Time and random
procedure '_now'(Integer).
procedure '_random'(Integer?, Integer?, Integer, Integer).

% MWM (Mutual Write Merge)
procedure '_allocate_mutual_reference'(_, _).
procedure '_stream_append'(_?, _?, _).
procedure '_close_mutual_reference'(_?).

% Network
procedure '_send'(_?, _?, _?).
procedure '_authorise_link'(_?, _?).

% Signature
procedure '_sign'(_?, _).

% Modules as values
procedure '_self_module'(Module).
procedure '_run'(_?, Module?).

% I/O
procedure '_output'(_?).

% =============================================================================
% SINGLE-UNIT-CLAUSE PROCEDURES (DEFINED GUARDS)
% =============================================================================

% Assignment (unification)
procedure(X) =(X, X?).
X? = X.

% Difference list operations
procedure(X) dl_append(DiffList(X)?, DiffList(X)?, DiffList(X)).
dl_append(A\B?, B\C?, A?\C).

procedure(X) dl_to_list(DiffList(X)?, Stream(X)).
dl_to_list(L\[], L?).

% Channel operations
procedure(X, Y) new_channel(Channel(X, Y), Channel(Y, X)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

procedure(X, Y) send(X?, Channel(Y, Stream(X))?, Channel(Y, Stream(X))).
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

% receive consumes a message from a non-empty read stream (OpenStream(X));
% its continuation's read stream may be empty (Stream(X)).  A channel consumer
% covers the closed read stream with the close guard below.
procedure(X, Y) receive(X, Channel(OpenStream(X), Y)?, Channel(Stream(X), Y)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).

% close consumes a closed read stream and closes the write stream.  Together with
% receive it lets a channel consumer's two guarded clauses accept every input
% path of the channel.
procedure close(Channel(Closed, Closed)?).
close(ch([], [])).

% =============================================================================
% STREAM UTILITIES (multi-clause)
% =============================================================================

procedure(X) merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

% send_to_user/1 — system predicate emitting each ground term of the stream via
% the _output kernel. Application modules reach user output by calling this (or a
% local helper that calls it) rather than naming the reserved '_output' kernel.
procedure send_to_user(Stream(_)?).
send_to_user([T | In]) :- ground(T?) | '_output'(T?), send_to_user(In?).
send_to_user([]).

% send_to_net/1 is not declared here. It reaches every module through
% -expose(system#mad_predicates) at the top of this file, which carries its
% declaration and its clauses together. No catalogue row accompanies it and none
% is coming: its clauses are ordinary GLP and invoke no kernel, so it is not a
% language construct (GLP-Spec, 2026-08-02).

% =============================================================================
% ARITHMETIC ASSIGNMENT (:=/2)
% =============================================================================

procedure :=(Number, Exp?).

% Base case: plain number
Result? := N :- number(N?) | Result = N?.

% Addition
Result? := X + Y :-
  number(X?), number(Y?) |
  '_add'(X?, Y?, Result).
Result? := X + Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? + Y1?.

% Subtraction
Result? := X - Y :-
  number(X?), number(Y?) |
  '_sub'(X?, Y?, Result).
Result? := X - Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? - Y1?.

% Multiplication
Result? := X * Y :-
  number(X?), number(Y?) |
  '_mul'(X?, Y?, Result).
Result? := X * Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? * Y1?.

% Division (always returns float)
Result? := X / Y :-
  number(X?), number(Y?), Y? =\= 0 |
  '_div'(X?, Y?, Result).
_ := X / Y :-
  number(X?), number(Y?), Y? =:= 0 |
  abort("Division by zero").
Result? := X / Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? / Y1?.

% Integer division
Result? := X // Y :-
  integer(X?), integer(Y?), Y? =\= 0 |
  '_idiv'(X?, Y?, Result).
_ := X // Y :-
  integer(X?), integer(Y?), Y? =:= 0 |
  abort("Integer division by zero").
Result? := X // Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? // Y1?.

% Modulo
Result? := X mod Y :-
  integer(X?), integer(Y?), Y? =\= 0 |
  '_mod'(X?, Y?, Result).
_ := X mod Y :-
  integer(X?), integer(Y?), Y? =:= 0 |
  abort("Modulo by zero").
Result? := X mod Y :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := X1? mod Y1?.

% Unary negation
Result? := -X :-
  number(X?) |
  '_neg'(X?, Result).
Result? := -X :-
  otherwise |
  X1 := X?,
  Result := -X1?.

% Absolute value
Result? := abs(X) :-
  number(X?) |
  '_abs'(X?, Result).
Result? := abs(X) :-
  otherwise |
  X1 := X?,
  Result := abs(X1?).

% Square root
Result? := sqrt(X) :-
  number(X?), X? >= 0 |
  '_sqrt'(X?, Result).
_ := sqrt(X) :-
  number(X?), X? < 0 |
  abort("Square root of negative number").
Result? := sqrt(X) :-
  otherwise |
  X1 := X?,
  Result := sqrt(X1?).

% Sine
Result? := sin(X) :-
  number(X?) |
  '_sin'(X?, Result).
Result? := sin(X) :-
  otherwise |
  X1 := X?,
  Result := sin(X1?).

% Cosine
Result? := cos(X) :-
  number(X?) |
  '_cos'(X?, Result).
Result? := cos(X) :-
  otherwise |
  X1 := X?,
  Result := cos(X1?).

% Tangent
Result? := tan(X) :-
  number(X?) |
  '_tan'(X?, Result).
Result? := tan(X) :-
  otherwise |
  X1 := X?,
  Result := tan(X1?).

% Exponential
Result? := exp(X) :-
  number(X?) |
  '_exp'(X?, Result).
Result? := exp(X) :-
  otherwise |
  X1 := X?,
  Result := exp(X1?).

% Natural logarithm
Result? := ln(X) :-
  number(X?), X? > 0 |
  '_ln'(X?, Result).
_ := ln(X) :-
  number(X?), X? =< 0 |
  abort("Natural logarithm of non-positive number").
Result? := ln(X) :-
  otherwise |
  X1 := X?,
  Result := ln(X1?).

% Base-10 logarithm
Result? := log(X) :-
  number(X?), X? > 0 |
  '_log10'(X?, Result).
_ := log(X) :-
  number(X?), X? =< 0 |
  abort("Logarithm of non-positive number").
Result? := log(X) :-
  otherwise |
  X1 := X?,
  Result := log(X1?).

% Power
Result? := pow(X, Y) :-
  number(X?), number(Y?) |
  '_pow'(X?, Y?, Result).
Result? := pow(X, Y) :-
  otherwise |
  X1 := X?,
  Y1 := Y?,
  Result := pow(X1?, Y1?).

% Arc sine
Result? := asin(X) :-
  number(X?), X? >= -1, X? =< 1 |
  '_asin'(X?, Result).
_ := asin(X) :-
  number(X?), X? < -1 |
  abort("Arc sine domain error: argument must be in [-1, 1]").
_ := asin(X) :-
  number(X?), X? > 1 |
  abort("Arc sine domain error: argument must be in [-1, 1]").
Result? := asin(X) :-
  otherwise |
  X1 := X?,
  Result := asin(X1?).

% Arc cosine
Result? := acos(X) :-
  number(X?), X? >= -1, X? =< 1 |
  '_acos'(X?, Result).
_ := acos(X) :-
  number(X?), X? < -1 |
  abort("Arc cosine domain error: argument must be in [-1, 1]").
_ := acos(X) :-
  number(X?), X? > 1 |
  abort("Arc cosine domain error: argument must be in [-1, 1]").
Result? := acos(X) :-
  otherwise |
  X1 := X?,
  Result := acos(X1?).

% Arc tangent
Result? := atan(X) :-
  number(X?) |
  '_atan'(X?, Result).
Result? := atan(X) :-
  otherwise |
  X1 := X?,
  Result := atan(X1?).

% Convert to integer
Result? := integer(X) :-
  number(X?) |
  '_integer'(X?, Result).
Result? := integer(X) :-
  otherwise |
  X1 := X?,
  Result := integer(X1?).

% Convert to real
Result? := real(X) :-
  number(X?) |
  '_real'(X?, Result).
Result? := real(X) :-
  otherwise |
  X1 := X?,
  Result := real(X1?).

% Round
Result? := round(X) :-
  number(X?) |
  '_round'(X?, Result).
Result? := round(X) :-
  otherwise |
  X1 := X?,
  Result := round(X1?).

% Floor
Result? := floor(X) :-
  number(X?) |
  '_floor'(X?, Result).
Result? := floor(X) :-
  otherwise |
  X1 := X?,
  Result := floor(X1?).

% Ceiling
Result? := ceil(X) :-
  number(X?) |
  '_ceil'(X?, Result).
Result? := ceil(X) :-
  otherwise |
  X1 := X?,
  Result := ceil(X1?).

% =============================================================================
% TIME (now/1)
% =============================================================================

procedure now(Integer).
now(T?) :- '_now'(T).

% =============================================================================
% SEEDED RANDOM (random/4)
% =============================================================================
% random(Seed, N, Value, NextSeed): Value is a pseudo-random integer
% 1 =< Value =< N; NextSeed is the next draw's seed.  Threading NextSeed from
% each draw into the next reproduces exactly from an initial seed.  A body goal,
% not a guard (GLP-ICLP appendix-guards §"Seeded random numbers").
procedure random(Integer?, Integer?, Integer, Integer).
random(Seed, N, Value?, NextSeed?) :-
  integer(Seed?), integer(N?), N? >= 1 |
  '_random'(Seed?, N?, Value, NextSeed).

% =============================================================================
% UNIV (=../2, ..=/2)
% =============================================================================

% Composition: list → tuple
X? =.. [Y|Ys] :- list(Ys?) | '_list_to_tuple'([Y?|Ys?], X).

% Decomposition: compound → list
Y? ..= X :- compound(X?) | '_tuple_to_list'(X?, Y).

% =============================================================================
% MODULE AS A VALUE (self_module/1, run/2)
% =============================================================================
% Wrappers over the '_self_module' and '_run' kernels (GLP paper, appendix
% "Guards, Body Kernels, and System Predicates").  run(Goal, Module) activates
% the module value Module and posts Goal to it; Goal's predicate must be
% exported by Module, else an error.  The typed run/3 and find_type/2 (TGLP
% §Dynamic Activation) follow with the typechecked implementation.

procedure self_module(Module).
self_module(M?) :- '_self_module'(M).

procedure run(_?, Module?).
run(G, M) :- '_run'(G?, M?).

% =============================================================================
% ATTESTATION AND HELD LINKS (sign/2, authorise_link/2)
% =============================================================================
% Moved here from the engine's embedded madGLP prelude, where they were loaded
% only by enableMadGLP().  GLP's appendix-guards lists both among the system
% predicates whose complete definitions are in programs/self.glp.  Both kernels
% abort outside madGLP mode ("not in madGLP mode (no MadContext)").

%% sign/2 - bind Sig to the hex Ed25519 signature over the canonical
%% serialization of ground term T, under this agent's key (seam spec §4).
%% The ground/1 guard suspends until T is ground and resumes on binding.
procedure sign(_?, _).
sign(T, Sig?) :- ground(T?) | '_sign'(T?, Sig).

%% authorise_link/2 - answer a pending_link(Link, Sender) report (Definition
%% authorise_link Predicate).  L is the reported link's global name in its
%% ground presentation, A is authorise or refuse.  On authorise the runtime
%% releases what it held; on refuse it drops the link.
procedure authorise_link(_?, _?).
authorise_link(L, A) :- known(A?) | '_authorise_link'(L?, A?).

% =============================================================================
% NETWORKING SEAM (peer_address/2, punch_udp/1, place_declare/3, place_remove/1,
% trust_declare/2)
% =============================================================================
% GLP-Spec's appendix-guards lists all four among the system predicates, on the
% same grounds as sign/2 and authorise_link/2 above.  The clause bodies are
% IGLP's madglp-spec.tex, Definition "Seam Predicates"; the layer behind them is
% GLP-Networking-API's.
%
% The four declarations mirror the appendix's body-kernel rows argument for
% argument — '_peer_address'(_?, _), '_punch_udp'(_?), '_place_declare'(_?, _?, _),
% '_place_remove'(_?) — which was all the catalogue settled when they were
% written: its system-predicate table then gave a name and a description and
% carried no signature column, so the arity was the catalogue's and the argument
% types followed the kernel, as sign/2 and authorise_link/2 do.  The table has
% carried a signature column since 2026-08-01, so trust_declare/2 below takes its
% declaration from that column instead.
%
% 🔴 Two clauses depart from the paper, and only where SRSW forces it.  The paper
% writes peer_address(P, A) and place_declare(P, R, E) with the output variable a
% writer in the head and a writer again in the body — two writers and no reader,
% which the analyzer rejects ("Writer variable A occurs 2 times", "Variable A has
% no reader").  At a produce position the head form is the reader and the body
% supplies the writer, which is what sign/2 does three lines above.  Reported to
% IGLP 2026-08-01; the paper is theirs to correct.
%
% The four kernels were registered by 9d5e0dd9, though not yet declared in the
% block above.  '_trust_declare' was not, so a trust_declare/2 call reaches the runtime
% and fails there ("no procedure for goal, failed: _trust_declare(...)").  That is
% the intended half-state: the wrappers are GLP-Spec's and the kernels are IGLP's,
% and neither half waits on the other.

%% peer_address/2 - assign A the address at which the layer observes peer P.
procedure peer_address(_?, _).
peer_address(P, A?) :- ground(P?) | '_peer_address'(P?, A).

%% punch_udp/1 - open a path to address A; assigns nothing.
procedure punch_udp(_?).
punch_udp(A) :- ground(A?) | '_punch_udp'(A?).

%% place_declare/3 - declare place P of radius R about the declaring agent's
%% location at the time of the call, and assign E the stream of that agent's own
%% entered and exited events for P, carrying unobservable where the layer stops
%% reporting crossings and observable where it resumes.  A further declaration of
%% the same place supersedes the earlier one and closes its stream.
procedure place_declare(_?, _?, _).
place_declare(P, R, E?) :- ground(P?), ground(R?) | '_place_declare'(P?, R?, E).

%% place_remove/1 - end the declaration of P; does nothing where P is not
%% declared.
procedure place_remove(_?).
place_remove(P) :- ground(P?) | '_place_remove'(P?).

%% trust_declare/2 - declare Level as the cold-call trust level of proximity
%% medium Medium.  Under open the agent contacts and answers unrecognised
%% presences on that medium; under closed it ignores them.  Each medium carries
%% its own level, and a later declaration of the same medium supersedes the
%% earlier one.  The declaration is the catalogue's signature column verbatim.
procedure trust_declare(Constant?, Constant?).
trust_declare(Medium, Level) :-
    ground(Medium?), ground(Level?) |
    '_trust_declare'(Medium?, Level?).

% =============================================================================
% MULTIWAY MERGE (mwm/2)
% =============================================================================
procedure(X) mwm(MwmInput(X)?, Stream(X)).
mwm(In, Out?) :-
    '_allocate_mutual_reference'(Ref, Out),
    mwm_main(In?, Ref?).

% Intermediate predicate whose guard admits the multiple Ref? occurrences below.
procedure(X) mwm_main(MwmInput(X)?, _?).
mwm_main(In, Ref) :-
    is_mutual_ref(Ref?) |
    mwm1(In?, Ref?, done, Done),
    close_when_done(Done?, Ref?).

procedure(X) mwm1(MwmInput(X)?, _?, Done?, Done).
mwm1([merge(Xs)|Streams], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    mwm_copy(Xs?, Ref?, L?, M),
    mwm1(Streams?, Ref?, M?, R).
mwm1([], _, L, L?).

procedure(X) mwm_copy(Stream(X)?, _?, Done?, Done).
mwm_copy([X|Xs], Ref, L, R?) :-
    is_mutual_ref(Ref?) |
    stream_append(X?, Ref?, Ref1),
    mwm_copy(Xs?, Ref1?, L?, R).
mwm_copy([], _, L, L?).

procedure close_when_done(Done?, _?).
close_when_done(done, Ref) :-
    is_mutual_ref(Ref?) |
    close_mutual_reference(Ref?).

% The mutual-reference wrappers carry permissive (`_`) system-builtin types so
% that typed application modules can call them without a local declaration: a
% mutual reference is an opaque runtime value with no GLP type of its own.
procedure stream_append(_?, _?, _).
stream_append(Value, RefIn, RefOut?) :-
    is_mutual_ref(RefIn?) |
    '_stream_append'(RefIn?, Value?, RefOut).

procedure close_mutual_reference(_?).
close_mutual_reference(Ref) :-
    is_mutual_ref(Ref?) |
    '_close_mutual_reference'(Ref?).

% allocate_mutual_reference/2 — system wrapper for the allocation kernel, so
% application modules can build a mutual reference without naming the reserved
% '_allocate_mutual_reference' kernel.
procedure allocate_mutual_reference(_, _).
allocate_mutual_reference(Ref?, Out?) :- '_allocate_mutual_reference'(Ref, Out).
