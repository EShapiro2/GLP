%% boot.glp — CSSN play orchestrator
%%
%% Wires together: network <-> agent <-> ui_mediator <-> actor
%% Types: from self.glp (ancestor scoping)
%%
%% Cross-module dependencies declared via imported procedures.

-module(boot).
-mode(system).

%% =============================================================================
%% IMPORTED PROCEDURES — Cross-module dependencies
%% =============================================================================

%% From agent.glp (sibling)
imported procedure agent#agent(Constant?, UserInStream?, NetInStream?, OutputsList?).

%% From child_agent.glp (sibling)
imported procedure child_agent#child_agent(Constant?, Constant?, UserInStream?, NetInStream?, OutputsList?).

%% From ui/mediator.glp
imported procedure mediator#ui_mediator(Constant?, AgentChannel?, UserChannel?, PendingList?, Constant?).

%% From ui/actors.glp — plays 1-3 (3 agents)
imported procedure actors#alice1(ActorChannel?).
imported procedure actors#bob1(ActorChannel?).
imported procedure actors#charlie1(ActorChannel?).
imported procedure actors#alice2(ActorChannel?).
imported procedure actors#bob2(ActorChannel?).
imported procedure actors#charlie2(ActorChannel?).
imported procedure actors#alice3(ActorChannel?).
imported procedure actors#bob3(ActorChannel?).
imported procedure actors#charlie3(ActorChannel?).

%% From ui/actors.glp — plays 4-7 (4 agents: CSSG)
imported procedure actors#alice4(ActorChannel?).
imported procedure actors#bob4(ActorChannel?).
imported procedure actors#carol4(ActorChannel?).
imported procedure actors#dave4(ActorChannel?).
imported procedure actors#alice5(ActorChannel?).
imported procedure actors#bob5(ActorChannel?).
imported procedure actors#carol5(ActorChannel?).
imported procedure actors#dave5(ActorChannel?).
imported procedure actors#alice6(ActorChannel?).
imported procedure actors#bob6(ActorChannel?).
imported procedure actors#carol6(ActorChannel?).
imported procedure actors#dave6(ActorChannel?).
imported procedure actors#alice7(ActorChannel?).
imported procedure actors#bob7(ActorChannel?).
imported procedure actors#carol7(ActorChannel?).
imported procedure actors#dave7(ActorChannel?).

%% From ui/actors.glp — plays 8-10 (CSSN groups)
imported procedure actors#alice8(ActorChannel?).
imported procedure actors#bob8(ActorChannel?).
imported procedure actors#alice9(ActorChannel?).
imported procedure actors#bob9(ActorChannel?).
imported procedure actors#dave9(ActorChannel?).
imported procedure actors#alice10(ActorChannel?).
imported procedure actors#bob10(ActorChannel?).
imported procedure actors#dave10(ActorChannel?).

%% From ui/actors.glp — play 11 (6 agents: CSSN child-safe groups)
imported procedure actors#alice11(ActorChannel?).
imported procedure actors#bob11(ActorChannel?).
imported procedure actors#charlie11(ActorChannel?).
imported procedure actors#carol11(ActorChannel?).
imported procedure actors#dave11(ActorChannel?).
imported procedure actors#eve11(ActorChannel?).

%% From ui/actors.glp — play 12 (5 agents: parental consent for groups)
imported procedure actors#alice12(ActorChannel?).
imported procedure actors#bob12(ActorChannel?).
imported procedure actors#charlie12(ActorChannel?).
imported procedure actors#dave12(ActorChannel?).
imported procedure actors#eve12(ActorChannel?).

%% =============================================================================
%% LOCAL UTILITIES
%% =============================================================================

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

procedure tee(Stream(X)?, Stream(X), Stream(X)).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

procedure sink(Stream(X)?).
sink([_|Xs]) :- sink(Xs?).
sink([]).

%% =============================================================================
%% SEND_TO_USER_TAGGED — Merge display streams, tag with agent ID
%% =============================================================================

send_to_user_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    '_output'(tagged(Id?, cmd(T?))),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    '_output'(tagged(Id?, notify(T?))),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(_, [], []).
send_to_user_tagged(_, Cmds, []) :- sink(Cmds?).

%% =============================================================================
%% NETWORK SWITCH (3-way)
%% =============================================================================

%% --- Cold-call routing (2-arg msg) ---

network3(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch([msg(bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% --- Friend-to-friend routing (3-arg msg) ---

network3(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(alice, charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(alice, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(bob, charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(bob, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(charlie, alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(charlie, alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(charlie, bob, X?)|BobOut?]),
         ch([msg(charlie, bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Termination
network3(ch([], []), ch([], []), ch([], [])).

%% =============================================================================
%% NETWORK SWITCH (2-way)
%% =============================================================================

network2(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch([], []), ch([], [])).

%% =============================================================================
%% FPLAY1 — Both accept introduction (tagged output)
%% =============================================================================

fplay1 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    actors # alice1(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob1(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # charlie1(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent # agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    mediator # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?).

%% =============================================================================
%% FPLAY2 — Alice accepts, Charlie rejects (tagged output)
%% =============================================================================

fplay2 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    actors # alice2(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob2(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # charlie2(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent # agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    mediator # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?).

%% =============================================================================
%% FPLAY3 — Both reject introduction (tagged output)
%% =============================================================================

fplay3 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    actors # alice3(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob3(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # charlie3(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent # agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    mediator # ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?).

%% =============================================================================
%% FPLAY4 — CSSG: All four accept (tagged output)
%% =============================================================================

fplay4 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    actors # alice4(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent # agent(alice, AliceAgentIn?, AliceNetAndChildIn?,
          [output('_user', AliceAgentToUser),
           output('_net', AliceNetOut),
           output(child(carol), AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    mediator # ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    actors # bob4(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent # agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    mediator # ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    actors # carol4(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolMedIn, CarolDispCmd),
    child_agent # child_agent(carol, alice, CarolAgentIn?, CarolFromAlice?,
          [output('_user', CarolAgentToUser),
           output(parent(alice), CarolToAlice)]),
    mediator # ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    tee(CarolMedOut?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    actors # dave4(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    child_agent # child_agent(dave, bob, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(parent(bob), DaveToBob)]),
    mediator # ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave).

%% =============================================================================
%% FPLAY5 — CSSG: Bob rejects (tagged output)
