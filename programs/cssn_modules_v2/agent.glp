%% agent.glp — CSSN social agent module (v2)
%%
%% Exports: agent/4
%% Types and most helpers: from self.glp (ancestor scoping)
%% merge, bind_response, handle_response, setup_group_hub_side,
%% setup_group_creator, await_group_channel: local (Stream(X) subtyping limitation)
%%
%% v2 changes:
%%   - Helpers moved to self.glp (except merge-dependent ones)
%%   - Added parent consent clauses: group_consent_req, approve/reject_child_group

-module(agent).
-mode(system).

%% =============================================================================
%% MERGE — local (Stream(X) cross-module subtyping not supported)
%% =============================================================================

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% SETUP_GROUP_HUB_SIDE — local (calls merge)
%% =============================================================================

procedure setup_group_hub_side(GroupId?, Constant?, OutputsList?, OutputsList, NetInStream?, NetInStream, GroupChannel).
setup_group_hub_side(GroupId, Member, Outs, Outs1?, NetIn, NetIn1?,
    ch(HubToMember?, MemberToHub)) :-
    ground(GroupId?), ground(Member?) |
    add_group_output(group_member(GroupId?, Member?), HubToMember, Outs?, Outs1),
    merge(NetIn?, MemberToHub?, NetIn1).

%% =============================================================================
%% SETUP_GROUP_CREATOR — local (calls merge)
%% =============================================================================

procedure setup_group_creator(GroupId?, OutputsList?, OutputsList, NetInStream?, NetInStream).
setup_group_creator(GroupId, Outs, Outs1?, NetIn, NetIn1?) :-
    ground(GroupId?) |
    add_group_output(group(GroupId?), MemberToHub, Outs?, Outs1),
    merge(NetIn?, MemberToHub?, NetIn1).

%% =============================================================================
%% AWAIT_GROUP_CHANNEL — local (calls merge and agent)
%% =============================================================================

procedure await_group_channel(Constant?, GroupId?, GroupSetupResponseStream?, UserInStream?, NetInStream?, OutputsList?).
await_group_channel(Id, GroupId, [group_channel(ch(FromHub, ToHub?))|_],
        UserIn, NetIn, Outs) :-
    ground(Id?), ground(GroupId?) |
    add_group_output(group(GroupId?), ToHub, Outs?, Outs1),
    merge(NetIn?, FromHub?, NetIn1),
    lookup_send('_user', msg(agent, '_user', group_joined(GroupId?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?).
await_group_channel(_, _, [], _, _, _) :- true.

%% =============================================================================
%% RESPONSE HANDLING — local (calls merge)
%% =============================================================================

procedure bind_response(Decision?, Constant?, Response, OutputsList?, OutputsList, NetInStream?, NetInStream).
bind_response(yes, From, accept(RetCh?), Outs, Outs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Outs?, Outs1, In?, In1).
bind_response(no, _, no, Outs, Outs1?, In, In?) :-
    lookup_send('_user', msg(agent, '_user', rejected), Outs?, Outs1).

procedure handle_response(Response?, Constant?, OutputsList?, OutputsList, NetInStream?, NetInStream).
handle_response(accept(ch(FIn, FOut?)), From, Outs, Outs2?, In, In1?) :-
    ground(From?) |
    add_output(friend(From?), FOut, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', connected(From?)), Outs1?, Outs2),
    merge(In?, FIn?, In1).
handle_response(no, From, Outs, Outs1?, In, In?) :-
    ground(From?) |
    lookup_send('_user', msg(agent, '_user', rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% AGENT/4
%% =============================================================================

exported procedure agent(Constant?, UserInStream?, NetInStream?, OutputsList?).

%% --- User messages ---

%% User initiates cold call
agent(Id, [msg('_user', Id1, connect(Target))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send('_net', msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User decision on cold-call
agent(Id, [msg('_user', Id1, decision(Dec, From, response(Resp?)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% User sends text message to friend
agent(Id, [msg('_user', Id1, send(Target, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send(friend(Target?), msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% User introduces friend P to friend Q
agent(Id, [msg('_user', Id1, introduce(P, Q))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    lookup_send(friend(P?), msg(Id?, P?, intro(Q?, QPCh?)), Outs?, Outs1),
    lookup_send(friend(Q?), msg(Id?, Q?, intro(P?, PQCh?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% User accepts intro — send ack, spawn peer-wait, inject result
agent(Id, [msg('_user', Id1, accept_intro(Other, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).

%% User rejects intro — send nack on channel, close it
agent(Id, [msg('_user', Id1, reject_intro(_, channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Intro result: peer acked — add friend
agent(Id, [intro_result(Other, ch(FIn, FOut?))|UserIn], NetIn, Outs) :-
    ground(Id?), ground(Other?) |
    add_output(friend(Other?), FOut, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', connected(Other?)), Outs1?, Outs2),
    merge(NetIn?, FIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs2?).

%% Intro result: peer nacked — notify rejected
agent(Id, [intro_rejected(Other)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    lookup_send('_user', msg(agent, '_user', rejected(Other?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Response to cold-call (injected by inject_msg)
agent(Id, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% --- CSSG: Child-safe social graph ---

%% Parent initiates child introduction (fire and forget)
agent(Id, [msg('_user', Id1, child_introduce(MyChild, Friend, FriendChild))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(MyChild?), ground(Friend?), ground(FriendChild?),
    new_channel(C1Ch, C2Ch) |
    lookup_send(child(MyChild?), msg(Id?, MyChild?, child_intro(FriendChild?, C1Ch?)), Outs?, Outs1),
    lookup_send(friend(Friend?), msg(Id?, Friend?, child_intro(MyChild?, C2Ch?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% Child (or parent) accepts child_intro — send ack, spawn peer-wait, inject result
agent(Id, [msg('_user', Id1, accept_child_intro(Other, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?).

%% Child (or parent) rejects child_intro — send nack on channel, close it
agent(Id, [msg('_user', Id1, reject_child_intro(_, channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Parent approves child_intro — forward to own child
agent(Id, [msg('_user', Id1, approve_child_intro(OtherChild, MyChild, channel(Ch)))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(OtherChild?), ground(MyChild?) |
    lookup_send(child(MyChild?), msg(Id?, MyChild?, child_intro(OtherChild?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- CSSN: Child-safe social networking (groups) ---

%% User creates a group — creator sets up member-side write (no hub self-loop)
agent(Id, [msg('_user', Id1, create_group(Name, Type))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Name?), ground(Type?) |
    setup_group_creator(group_id(Id?, Name?, Type?),
        Outs?, Outs1, NetIn?, NetIn1),
    lookup_send('_user', msg(agent, '_user', group_joined(group_id(Id?, Name?, Type?))),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?).

%% User invites member to group
agent(Id, [msg('_user', Id1, invite_group(GroupId, Invitee))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Invitee?),
    new_channel(InviteeCh, CreatorCh) |
    lookup_send(friend(Invitee?),
        msg(Id?, Invitee?, group_invite(GroupId?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Invitee?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User invites child to group via parent
agent(Id, [msg('_user', Id1, invite_group(GroupId, Child, Parent))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?), ground(Parent?),
    new_channel(InviteeCh, CreatorCh) |
    lookup_send(friend(Parent?),
        msg(Id?, Parent?, group_invite_child(GroupId?, Child?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Child?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User accepts group invite
agent(Id, [msg('_user', Id1, accept_group(GroupId,
        group_channel(ch(ChRead, [ack(Id?)|[]]))))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    await_group_channel(Id?, GroupId?, ChRead?, UserIn?, NetIn?, Outs?).

%% User rejects group invite — send nack, close channel
agent(Id, [msg('_user', Id1, reject_group(_, group_channel(ch(_, [nack|[]]))))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Injected group_join_ack — creator wires hub-side, sends member-end channel
agent(Id, [group_join_ack(GroupId, Invitee, ch(_, [group_channel(MemberEnd?)|[]]))|UserIn],
        NetIn, Outs) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    setup_group_hub_side(GroupId?, Invitee?, Outs?, Outs1, NetIn?, NetIn1, MemberEnd),
    lookup_send('_user', msg(agent, '_user', group_joined_member(GroupId?, Invitee?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?).

%% Injected group_join_nack — nothing to clean up
agent(Id, [group_join_nack(_, _)|UserIn], NetIn, Outs) :-
    ground(Id?) |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% User sends group message — send on member-to-hub channel
agent(Id, [msg('_user', Id1, send_group(GroupId, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Text?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_msg(GroupId?, Id?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Parent approves group invite for child — forward group_invite to child channel
agent(Id, [msg('_user', Id1, approve_group(Child, GroupId, group_channel(Ch)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    lookup_send(child(Child?), msg(Id?, Child?, group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- Parent consent for child-managed groups (v2) ---

%% Parent approves child group consent — binds Decision to yes
agent(Id, [msg('_user', Id1, approve_child_group(_, _, consent(yes)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% Parent rejects child group consent — binds Decision to no
agent(Id, [msg('_user', Id1, reject_child_group(_, _, consent(no)))|UserIn],
        NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Network messages ---

%% Cold-call from network
agent(Id, UserIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', befriend(From?, Resp)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Response to cold-call from network
agent(Id, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% Text from friend
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Introduction from friend — pass channel to user via mediator
agent(Id, UserIn, [msg(From, Id1, intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send('_user', msg(agent, '_user', befriend_intro(From?, Other?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- CSSG network messages ---

%% Child receives child_intro from parent (or parent forwards from friend)
agent(Id, UserIn, [msg(From, Id1, child_intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send('_user', msg(agent, '_user', child_befriend(From?, Other?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% --- CSSN network messages ---

%% Group invite from friend — forward to user via mediator
agent(Id, UserIn, [msg(_, Id1, group_invite(GroupId, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?) |
    lookup_send('_user', msg(agent, '_user', group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Group invite for child from friend — forward to parent user via mediator
agent(Id, UserIn, [msg(_, Id1, group_invite_child(GroupId, Child, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    lookup_send('_user', msg(agent, '_user', group_invite_child(GroupId?, Child?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Consent request from child — forward to parent user via mediator (v2)
agent(Id, UserIn, [msg(Child, Id1, group_consent_req(GroupId, Consent))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Child?), ground(GroupId?) |
    lookup_send('_user', msg(agent, '_user',
        child_group_consent(Child?, GroupId?, Consent?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Group message from group channel — distribute to all members and notify user
agent(Id, UserIn, [msg(_, _, group_msg(GroupId, Author, Text))|NetIn], Outs) :-
    ground(Id?), ground(GroupId?), ground(Author?), ground(Text?) |
    distribute_group_msg(GroupId?,
        msg(Author?, Author?, group_msg(GroupId?, Author?, Text?)), Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', group_received(GroupId?, Author?, Text?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% --- Termination ---

agent(_, [], _, Outs) :- close_outputs(Outs?).
agent(_, _, [], Outs) :- close_outputs(Outs?).
