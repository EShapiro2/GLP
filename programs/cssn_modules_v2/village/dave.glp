%% dave.glp — Dave actor for Village scenario
%%
%% Dave is a child of Bob.
%% Act 2: Accepts intros to Carol and Eve (may interleave). Receives text from Carol.
%% Act 3: Joins Carol's kids_chat group, sends reply.
%% Act 4: Accepts study group invite, sends reply.
%% Act 5: Receives group_removed (removed from study by Bob).
%% Act 6: Receives unfriended(carol).
%% Types: from village/self.glp (ancestor scoping)

-mode(system).

%% =============================================================================
%% Act 2: Accept intros to Carol and Eve
%%
%% Bob fires approve_child_intro(carol,dave) and child_introduce(dave,bob,eve) together.
%% So child_befriend(bob,eve) may arrive before connected(carol). Handle both orderings.
%% =============================================================================

exported procedure dave13(Constant?, Channel(Stream(UserNotify), Stream(UserCmd))?, Stream(NarrativeItem)).
dave13(_, ch([child_befriend(bob, carol, ReqId)|In],
             [accept_child_intro(carol, ReqId?)|Out?]),
        Narr?) :-
    ground(ReqId?) |
    dave13_wait_carol_or_eve(In?, Out, Narr).

%% After accepting Carol intro, either connected(carol) or child_befriend(eve) first
procedure dave13_wait_carol_or_eve(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
%% Case 1: connected(carol) arrives first
dave13_wait_carol_or_eve([connected(carol)|In], Out?,
                         [friend(carol)|Narr?]) :-
    dave13_wait_eve_intro(In?, Out, Narr).
%% Case 2: child_befriend(eve) arrives first
dave13_wait_carol_or_eve([child_befriend(bob, eve, ReqId)|In],
                         [accept_child_intro(eve, ReqId?)|Out?],
                         Narr?) :-
    ground(ReqId?) |
    dave13_wait_both_connected(In?, Out, Narr).
dave13_wait_carol_or_eve([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_carol_or_eve(In?, Out, Narr).
dave13_wait_carol_or_eve([], [], []).

%% Case 1: Dave connected to Carol, wait for Eve intro
procedure dave13_wait_eve_intro(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_eve_intro([child_befriend(bob, eve, ReqId)|In],
                      [accept_child_intro(eve, ReqId?)|Out?],
                      Narr?) :-
    ground(ReqId?) |
    dave13_wait_eve_connected(In?, Out, Narr).
dave13_wait_eve_intro([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_eve_intro(In?, Out, Narr).
dave13_wait_eve_intro([], [], []).

%% Case 1: Wait for connected(eve), then wait for Carol's text
procedure dave13_wait_eve_connected(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_eve_connected([connected(eve)|In], Out?,
                          [friend(eve)|Narr?]) :-
    dave13_wait_carol_text(In?, Out, Narr).
dave13_wait_eve_connected([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_eve_connected(In?, Out, Narr).
dave13_wait_eve_connected([], [], []).

%% Case 2: Both intros accepted, wait for connected(carol) then connected(eve)
procedure dave13_wait_both_connected(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_both_connected([connected(carol)|In], Out?,
                           [friend(carol)|Narr?]) :-
    dave13_wait_eve_connected(In?, Out, Narr).
dave13_wait_both_connected([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_both_connected(In?, Out, Narr).
dave13_wait_both_connected([], [], []).

%% Wait for received(carol, 'Hi Dave!')
procedure dave13_wait_carol_text(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_carol_text([received(carol, _)|In], Out?,
                       [event('Received Hi from Carol')|Narr?]) :-
    dave13_act3(In?, Out, Narr).
dave13_wait_carol_text([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_carol_text(In?, Out, Narr).
dave13_wait_carol_text([], [], []).

%% =============================================================================
%% Act 3: Join Carol's kids_chat group
%% =============================================================================

%% Wait for group_invite from Carol's kids_chat
procedure dave13_act3(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_act3([group_invite(group_id(carol, kids_chat), ReqId)|In],
            [accept_group(group_id(carol, kids_chat), ReqId?)|Out?],
            [act('Accepting kids_chat invite')|Narr?]) :-
    ground(ReqId?) |
    dave13_wait_kids_joined(In?, Out, Narr).
dave13_act3([_|In], Out?, Narr?) :-
    otherwise | dave13_act3(In?, Out, Narr).
dave13_act3([], [], []).

%% Wait for group_joined
procedure dave13_wait_kids_joined(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_kids_joined([group_joined(group_id(carol, kids_chat))|In], Out?,
                        [event('Joined kids_chat')|Narr?]) :-
    dave13_wait_kids_welcome(In?, Out, Narr).
dave13_wait_kids_joined([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_kids_joined(In?, Out, Narr).
dave13_wait_kids_joined([], [], []).

%% Wait for Carol's welcome message, then reply
procedure dave13_wait_kids_welcome(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_kids_welcome([group_received(group_id(carol, kids_chat), carol, _)|In],
                         [send_group(group_id(carol, kids_chat), 'Thanks Carol!')|Out?],
                         [say('Thanks Carol!')|Narr?]) :-
    dave13_act4(In?, Out, Narr).
dave13_wait_kids_welcome([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_kids_welcome(In?, Out, Narr).
dave13_wait_kids_welcome([], [], []).

%% =============================================================================
%% Act 4: Accept study group invite
%% =============================================================================

procedure dave13_act4(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_act4([group_invite(group_id(frank, study), ReqId)|In],
            [accept_group(group_id(frank, study), ReqId?)|Out?],
            [act('Accepting study group invite')|Narr?]) :-
    ground(ReqId?) |
    dave13_wait_study_joined(In?, Out, Narr).
dave13_act4([_|In], Out?, Narr?) :-
    otherwise | dave13_act4(In?, Out, Narr).
dave13_act4([], [], []).

%% Wait for group_joined
procedure dave13_wait_study_joined(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_study_joined([group_joined(group_id(frank, study))|In], Out?,
                         [event('Joined study group')|Narr?]) :-
    dave13_wait_frank_group_msg(In?, Out, Narr).
dave13_wait_study_joined([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_study_joined(In?, Out, Narr).
dave13_wait_study_joined([], [], []).

%% Wait for Frank's welcome message, then reply
procedure dave13_wait_frank_group_msg(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_frank_group_msg([group_received(group_id(frank, study), frank, _)|In],
                            [send_group(group_id(frank, study), 'Hi from Dave!')|Out?],
                            [say('Hi from Dave!')|Narr?]) :-
    dave13_act5(In?, Out, Narr).
dave13_wait_frank_group_msg([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_frank_group_msg(In?, Out, Narr).
dave13_wait_frank_group_msg([], [], []).

%% =============================================================================
%% Acts 5-6: Group removal and unfriended (either order)
%% =============================================================================

procedure dave13_act5(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
%% Case 1: group_left arrives first
dave13_act5([group_removed(group_id(frank, study))|In], Out?,
            [event('Removed from study group')|Narr?]) :-
    dave13_wait_unfriended(In?, Out, Narr).
dave13_act5([group_left(group_id(frank, study))|In], Out?,
            [event('Removed from study group')|Narr?]) :-
    dave13_wait_unfriended(In?, Out, Narr).
%% Case 2: unfriended arrives first
dave13_act5([unfriended(carol)|In], Out?,
            [event('Unfriended by Carol')|Narr?]) :-
    dave13_wait_group_left(In?, Out, Narr).
dave13_act5([_|In], Out?, Narr?) :-
    otherwise | dave13_act5(In?, Out, Narr).
dave13_act5([], [], []).

%% Case 1: wait for unfriended(carol)
procedure dave13_wait_unfriended(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_unfriended([unfriended(carol)|In], Out?,
                       [event('Unfriended by Carol')|Narr?]) :-
    dave13_finish(In?, Out, Narr).
dave13_wait_unfriended([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_unfriended(In?, Out, Narr).
dave13_wait_unfriended([], [], []).

%% Case 2: wait for group_left/group_removed
procedure dave13_wait_group_left(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_wait_group_left([group_removed(group_id(frank, study))|In], Out?,
                       [event('Removed from study group')|Narr?]) :-
    dave13_finish(In?, Out, Narr).
dave13_wait_group_left([group_left(group_id(frank, study))|In], Out?,
                       [event('Removed from study group')|Narr?]) :-
    dave13_finish(In?, Out, Narr).
dave13_wait_group_left([_|In], Out?, Narr?) :-
    otherwise | dave13_wait_group_left(In?, Out, Narr).
dave13_wait_group_left([], [], []).

%% =============================================================================
%% Act 7: Termination
%% =============================================================================

procedure dave13_finish(Stream(UserNotify)?, Stream(UserCmd), Stream(NarrativeItem)).
dave13_finish(_, [], []).
