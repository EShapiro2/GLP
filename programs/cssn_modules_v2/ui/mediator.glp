%% mediator.glp — CSSN UI mediator module
%%
%% Exports: ui_mediator/5
%% Types: from self.glp (ancestor scoping)
%% No cross-module imports — all helpers are local.

-module(mediator).
-mode(system).

%% =============================================================================
%% CHANNEL OPERATIONS (Defined Guards)
%% =============================================================================

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).

%% =============================================================================
%% UI MEDIATOR - Main loop
%% =============================================================================

exported procedure ui_mediator(Constant?, AgentChannel?, UserChannel?, PendingList?, Constant?).

%% --- Agent-to-user: non-ground (replace variable with req ID) ---

%% befriend: Resp? reader in receive, Resp writer in body
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% Introduction befriend_intro: agent sends befriend_intro(From, Other, Ch)
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user',
                befriend_intro(From, Other, Ch)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Other?) |
    send(befriend_intro(From?, Other?, req(N?)),
         UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), channel(Ch?)) | Ps?], N1?).

%% CSSG: child_befriend
ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user',
                child_befriend(From, Other, Ch)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Other?) |
    send(child_befriend(From?, Other?, req(N?)),
         UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), channel(Ch?)) | Ps?], N1?).

%% --- Agent-to-user: ground (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(connected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected),
            AgentCh?, AgentCh1) |
    send(rejected, UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send(rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', received(From, Text)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Text?) |
    send(received(From?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (cold-call response) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Dec?), ground(From?),
    ground(ReqId?) |
    lookup_pending(ReqId?, Resp, Ps?, Ps1),
    send(msg('_user', Id?, decision(Dec?, From?, Resp?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: accept/reject intro ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_intro(Other, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, accept_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_intro(Other, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, reject_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: CSSG accept/reject/approve child_intro ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_child_intro(Other, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, accept_child_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_child_intro(Other, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Other?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, reject_child_intro(Other?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(approve_child_intro(OtherChild, MyChild, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(OtherChild?), ground(MyChild?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, approve_child_intro(OtherChild?, MyChild?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: pass-through commands ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(connect(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg('_user', Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(send(Target, Text), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(Text?) |
    send(msg('_user', Id?, send(Target?, Text?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(introduce(P, Q), UserCh?, UserCh1),
    ground(Id?), ground(P?), ground(Q?) |
    send(msg('_user', Id?, introduce(P?, Q?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(child_introduce(MyChild, Friend, FriendChild), UserCh?, UserCh1),
    ground(Id?), ground(MyChild?), ground(Friend?), ground(FriendChild?) |
    send(msg('_user', Id?, child_introduce(MyChild?, Friend?, FriendChild?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: group_invite (non-ground — store channel in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', group_invite(GroupId, Ch)),
            AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_invite(GroupId?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), group_channel(Ch?)) | Ps?], N1?).

%% --- Agent-to-user: group_invite_child (non-ground — store channel in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', group_invite_child(GroupId, Child, Ch)),
            AgentCh?, AgentCh1),
    ground(GroupId?), ground(Child?) |
    send(group_invite_child(GroupId?, Child?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), group_channel(Ch?)) | Ps?], N1?).

%% --- Agent-to-user: child_group_consent (non-ground — store Consent in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', child_group_consent(Child, GroupId, Consent?)),
            AgentCh?, AgentCh1),
    ground(Child?), ground(GroupId?) |
    send(child_group_consent(Child?, GroupId?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), consent(Consent)) | Ps?], N1?).

%% --- Agent-to-user: group_joined (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', group_joined(GroupId)),
            AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_joined(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: group_joined_member (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', group_joined_member(GroupId, Invitee)),
            AgentCh?, AgentCh1),
    ground(GroupId?), ground(Invitee?) |
    send(group_joined_member(GroupId?, Invitee?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: group_received (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', group_received(GroupId, Author, Text)),
            AgentCh?, AgentCh1),
    ground(GroupId?), ground(Author?), ground(Text?) |
    send(group_received(GroupId?, Author?, Text?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: accept_group (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_group(GroupId, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, accept_group(GroupId?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: reject_group (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_group(GroupId, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, reject_group(GroupId?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: approve_group (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(approve_group(Child, GroupId, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Child?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, approve_group(Child?, GroupId?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: approve_child_group (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(approve_child_group(Child, GroupId, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Child?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, approve_child_group(Child?, GroupId?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: reject_child_group (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_child_group(Child, GroupId, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Child?), ground(GroupId?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send(msg('_user', Id?, reject_child_group(Child?, GroupId?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: group pass-through commands ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(create_group(Name), UserCh?, UserCh1),
    ground(Id?), ground(Name?) |
    send(msg('_user', Id?, create_group(Name?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(invite_group(GroupId, Invitee), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    send(msg('_user', Id?, invite_group(GroupId?, Invitee?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(invite_group(GroupId, Child, Parent), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(Child?), ground(Parent?) |
    send(msg('_user', Id?, invite_group(GroupId?, Child?, Parent?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(send_group(GroupId, Text), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(Text?) |
    send(msg('_user', Id?, send_group(GroupId?, Text?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(leave_group(GroupId), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?) |
    send(msg('_user', Id?, leave_group(GroupId?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(leave_child_group(Child, GroupId), UserCh?, UserCh1),
    ground(Id?), ground(Child?), ground(GroupId?) |
    send(msg('_user', Id?, leave_child_group(Child?, GroupId?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(remove_from_group(GroupId, Member), UserCh?, UserCh1),
    ground(Id?), ground(GroupId?), ground(Member?) |
    send(msg('_user', Id?, remove_from_group(GroupId?, Member?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent notifications: group_left, group_removed ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', group_left(GroupId)),
            AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_left(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', group_removed(GroupId)),
            AgentCh?, AgentCh1),
    ground(GroupId?) |
    send(group_removed(GroupId?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Unfriend commands (v3) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(unfriend_child(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg('_user', Id?, unfriend_child(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(unfriend_child_of(MyChild, Target), UserCh?, UserCh1),
    ground(Id?), ground(MyChild?), ground(Target?) |
    send(msg('_user', Id?, unfriend_child_of(MyChild?, Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', unfriended(Target)),
            AgentCh?, AgentCh1),
    ground(Target?) |
    send(unfriended(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).
