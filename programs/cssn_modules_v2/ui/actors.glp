%% =============================================================================
%% PLAY 8 — CSSN: Group join (Alice creates group, invites Bob, Bob accepts)
%% =============================================================================

exported procedure alice8(ActorChannel?).
alice8(ch(In, [connect(bob)|Out?])) :-
    alice8_wait_connected(In?, Out).

procedure alice8_wait_connected(UserNotifyStream?, UserCmdStream).
alice8_wait_connected([connected(bob)|In],
                      [create_group(book_club, clique)|Out?]) :-
    alice8_wait_group_joined(In?, Out).
alice8_wait_connected([_|In], Out?) :-
    otherwise | alice8_wait_connected(In?, Out).
alice8_wait_connected([], []).

procedure alice8_wait_group_joined(UserNotifyStream?, UserCmdStream).
alice8_wait_group_joined(
        [group_joined(group_id(alice, book_club, clique))|In],
        [invite_group(group_id(alice, book_club, clique), bob)|Out?]) :-
    alice8_wait_member_joined(In?, Out).
alice8_wait_group_joined([_|In], Out?) :-
    otherwise | alice8_wait_group_joined(In?, Out).
alice8_wait_group_joined([], []).

procedure alice8_wait_member_joined(UserNotifyStream?, UserCmdStream).
alice8_wait_member_joined(
        [group_joined_member(group_id(alice, book_club, clique), bob)|In],
        Out?) :-
    alice8_wait_bob_msg(In?, Out).
alice8_wait_member_joined([_|In], Out?) :-
    otherwise | alice8_wait_member_joined(In?, Out).
alice8_wait_member_joined([], []).

procedure alice8_wait_bob_msg(UserNotifyStream?, UserCmdStream).
alice8_wait_bob_msg(
        [group_received(group_id(alice, book_club, clique), bob, 'Hello everyone')|_],
        [send_group(group_id(alice, book_club, clique), 'Hi Bob')]).
alice8_wait_bob_msg([_|In], Out?) :-
    otherwise | alice8_wait_bob_msg(In?, Out).
alice8_wait_bob_msg([], []).

exported procedure bob8(ActorChannel?).
bob8(ch([befriend(alice, ReqId)|In],
        [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob8_wait_connected(In?, Out).
bob8(ch([_|In], Out?)) :-
    otherwise | bob8(ch(In?, Out)).

procedure bob8_wait_connected(UserNotifyStream?, UserCmdStream).
bob8_wait_connected([connected(alice)|In], Out?) :-
    bob8_wait_group_invite(In?, Out).
bob8_wait_connected([_|In], Out?) :-
    otherwise | bob8_wait_connected(In?, Out).
bob8_wait_connected([], []).

procedure bob8_wait_group_invite(UserNotifyStream?, UserCmdStream).
bob8_wait_group_invite(
        [group_invite(group_id(alice, book_club, clique), ReqId)|In],
        [accept_group(group_id(alice, book_club, clique), ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob8_wait_group_joined(In?, Out).
bob8_wait_group_invite([_|In], Out?) :-
    otherwise | bob8_wait_group_invite(In?, Out).
bob8_wait_group_invite([], []).

procedure bob8_wait_group_joined(UserNotifyStream?, UserCmdStream).
bob8_wait_group_joined(
        [group_joined(group_id(alice, book_club, clique))|In],
        [send_group(group_id(alice, book_club, clique), 'Hello everyone')|Out?]) :-
    bob8_wait_alice_reply(In?, Out).
bob8_wait_group_joined([_|In], Out?) :-
    otherwise | bob8_wait_group_joined(In?, Out).
bob8_wait_group_joined([], []).

procedure bob8_wait_alice_reply(UserNotifyStream?, UserCmdStream).
bob8_wait_alice_reply(
        [group_received(group_id(alice, book_club, clique), alice, 'Hi Bob')|_], []).
bob8_wait_alice_reply([_|In], Out?) :-
    otherwise | bob8_wait_alice_reply(In?, Out).
bob8_wait_alice_reply([], []).

%% =============================================================================
