exported procedure alice12(ActorChannel?).
alice12(ch(In, [connect(bob), connect(charlie)|Out?])) :-
    alice12_wait_connected(In?, Out).

procedure alice12_wait_connected(UserNotifyStream?, UserCmdStream).
alice12_wait_connected([connected(bob)|In], Out?) :-
    alice12_wait_connected_charlie(In?, Out).
alice12_wait_connected([connected(charlie)|In], Out?) :-
    alice12_wait_connected_bob(In?, Out).
alice12_wait_connected([_|In], Out?) :-
    otherwise | alice12_wait_connected(In?, Out).
alice12_wait_connected([], []).

procedure alice12_wait_connected_charlie(UserNotifyStream?, UserCmdStream).
alice12_wait_connected_charlie([connected(charlie)|In],
                               [create_group(study, star)|Out?]) :-
    alice12_wait_group_joined(In?, Out).
alice12_wait_connected_charlie([_|In], Out?) :-
    otherwise | alice12_wait_connected_charlie(In?, Out).
