%% play_alice_bob_full.glp - Full cold-call play with send and friends
%% Tests: cold call, friend-to-friend messaging, friends list query
%%
%% Date: 2026-01-24

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Response ::= accept(Channel) ; no.
FriendEntry ::= friend(String?, Stream).
FriendsList ::= [] ; [FriendEntry|FriendsList].

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, Stream?, Stream).
tag_stream(Name, [M|In], [msg(Name?, Name?, M?)|Out?]) :-
    ground(Name?) | tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% =============================================================================
%% LOOKUP_SEND - send message to named destination
%% =============================================================================

procedure lookup_send(String?, _?, FriendsList?, FriendsList).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(String?, _?, FriendsList?, FriendsList).
lookup_send_step(Key, Msg, [friend(K, [Msg?|Out1?])|Rest], [friend(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [friend(K, Out?)|Rest], [friend(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% COLLECT_FRIENDS - extract friend names (exclude user, net)
%% =============================================================================

procedure collect_friends(FriendsList?, Stream, FriendsList).
collect_friends([friend(user, Out?)|Rest], Names?, [friend(user, Out)|Rest1?]) :-
    collect_friends(Rest?, Names, Rest1).
collect_friends([friend(net, Out?)|Rest], Names?, [friend(net, Out)|Rest1?]) :-
    collect_friends(Rest?, Names, Rest1).
collect_friends([friend(Name, Out?)|Rest], [Name?|Names?], [friend(Name?, Out)|Rest1?]) :-
    ground(Name?), otherwise | collect_friends(Rest?, Names, Rest1).
collect_friends([], [], []).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, _?, Stream?, Stream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% RESPONSE HANDLING
%% =============================================================================

procedure bind_response(_?, _?, Response, FriendsList?, FriendsList, Stream?, Stream).
bind_response(yes, From, accept(RetCh?), Fs, Fs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

procedure handle_response(Response?, _?, FriendsList?, FriendsList, Stream?, Stream).
handle_response(accept(ch(FIn?, FOut)), From, Fs, [friend(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

%% =============================================================================
%% AGENT - Main loop
%% =============================================================================

procedure agent(_?, Stream?, FriendsList?).

%% User initiates cold call
agent(Id, [msg(user, Id1, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?), Id? =?= Id1? |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Received self-introduction - forward to user
agent(Id, [msg(From, Id1, intro(From1, From2, Resp))|In], Fs) :-
    ground(Id?), ground(From?), Id? =?= Id1?, From? =?= From1?, From? =?= From2? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User decision on introduction
agent(Id, [msg(user, Id1, decision(Dec, From, Resp?))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Response to sent introduction
agent(Id, [msg(From, Id1, response(Resp))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% User queries friends list
agent(Id, [msg(user, Id1, friends)|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    collect_friends(Fs?, Names, Fs1),
    lookup_send(user, msg(agent, user, friends_list(Names?)), Fs1?, Fs2),
    agent(Id?, In?, Fs2?).

%% Message from friend (via tagged stream)
agent(Id, [msg(From, From1, Content)|In], Fs) :-
    ground(Id?), ground(From?), From? =?= From1? |
    lookup_send(user, msg(From?, user, Content?), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% Catch-all
agent(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    agent(Id?, In?, Fs?).

%% Termination
agent(_, [], _).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure agent_init(_?, Channel?, Channel?).
agent_init(Id, ch(UserIn, UserOut), ch(NetIn, NetOut)) :-
    merge(UserIn?, NetIn?, In),
    agent(Id?, In?, [friend(user, UserOut?), friend(net, NetOut?)]).

%% =============================================================================
%% NETWORK SWITCH
%% =============================================================================

procedure network2(Channel?, Channel?).

network2(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch([], []), ch([], [])).

%% =============================================================================
%% ACTORS - Extended to test full protocol
%% =============================================================================

%% Alice's script:
%% 1. Send connect(bob)
%% 2. Send message to Bob (don't wait for response)
%% 3. Query friends list
%% 4. Drain remaining messages

procedure alice_actor(Channel?).
alice_actor(ch(In, [msg(user, alice, connect(bob))|Out?])) :-
    alice_send_friends_query(In?, Out).

procedure alice_send_friends_query(Stream?, Stream).
alice_send_friends_query(In, [msg(user, alice, friends)|Out?]) :-
    alice_receive_all(In?, Out).

procedure alice_receive_all(Stream?, Stream).
alice_receive_all([_|In], Out?) :- alice_receive_all(In?, Out).
alice_receive_all([], []).

%% Bob's script:
%% 1. Wait for befriend request, accept
%% 2. Send message to Alice
%% 3. Query friends list  
%% 4. Drain remaining messages

procedure bob_actor(Channel?).
bob_actor(ch([msg(agent, user, befriend(From, Resp))|In], [msg(user, bob, decision(yes, From?, Resp?))|Out?])) :-
    ground(From?) |
    bob_send_friends_query(In?, Out).

procedure bob_send_friends_query(Stream?, Stream).
bob_send_friends_query(In, [msg(user, bob, friends)|Out?]) :-
    bob_receive_all(In?, Out).

procedure bob_receive_all(Stream?, Stream).
bob_receive_all([_|In], Out?) :- bob_receive_all(In?, Out).
bob_receive_all([], []).

%% =============================================================================
%% THE PLAY
%% =============================================================================

procedure play_alice_bob.
play_alice_bob :-
    new_channel(AliceUserCh, UserAliceCh),
    new_channel(AliceNetCh, NetAliceCh),
    new_channel(BobUserCh, UserBobCh),
    new_channel(BobNetCh, NetBobCh),
    
    network2(NetAliceCh?, NetBobCh?),
    agent_init(alice, AliceUserCh?, AliceNetCh?),
    agent_init(bob, BobUserCh?, BobNetCh?),
    alice_actor(UserAliceCh?),
    bob_actor(UserBobCh?).

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

procedure new_channel(Channel, Channel).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).
