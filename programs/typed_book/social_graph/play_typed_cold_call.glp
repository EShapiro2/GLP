%% play_typed_cold_call.glp - Two-agent cold call with network routing
%% 
%% Architecture:
%%   Alice's Actor <--UserChA--> Alice's Agent <--NetChA--> Network <--NetChB--> Bob's Agent <--UserChB--> Bob's Actor
%%
%% Flow:
%% 1. Bob's actor sends introduction request to Alice (via network)
%% 2. Alice's agent receives intro, forwards decision to Alice's user
%% 3. Alice's actor accepts, bind_response creates channel
%% 4. Response goes back to Bob via network
%% 5. Bob's agent receives response, adds Alice to friends
%%
%% Date: 2026-01-24

%% =============================================================================
%% TYPE DEFINITIONS (must match social_graph_protocol.glp)
%% =============================================================================

%% Channel is defined in prelude as: Channel ::= ch(Stream, Stream?).
FriendEntry ::= (_, Stream).
FriendList ::= [] ; [FriendEntry | FriendList].
Response ::= accept(Channel) ; no.

%% Network message type
NetMsg ::= msg(_, _, _).

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

procedure new_channel(Channel, Channel).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], [], []).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, Stream?, Stream).
tag_stream(_, [], []).
tag_stream(Tag, [X|Xs], [tagged(Tag?, X?)|Ys?]) :-
    ground(Tag?) |
    tag_stream(Tag?, Xs?, Ys).

%% =============================================================================
%% RESPONSE HANDLING
%% =============================================================================

procedure handle_response(Response?, _?, FriendList?, FriendList, Stream?, Stream).
handle_response(accept(ch(FIn, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

procedure bind_response(_?, _?, Response, FriendList?, FriendList, Stream?, Stream).
bind_response(yes, From, accept(TheirCh?), Fs, Fs1?, In, In1?) :-
    new_channel(OurCh, TheirCh),
    handle_response(accept(OurCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

%% =============================================================================
%% SOCIAL GRAPH (simplified - only handles decision and response)
%% =============================================================================

procedure social_graph(_?, Stream?, FriendList?).

social_graph(Id, [decision(Dec, From, Resp?)|In], Fs) :-
    ground(Id?) |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

social_graph(Id, [response(From, Resp)|In], Fs) :-
    ground(Id?) |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

social_graph(_, [], _).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure build_friends(Stream?, Stream?, FriendList).
build_friends(UserOut, NetOut, [(user, UserOut?), (net, NetOut?)]).

procedure agent(_?, Channel?, Channel?).
agent(Id, ch(UserIn, UserOut), ch(NetIn, NetOut)) :-
    merge(UserIn?, NetIn?, In),
    build_friends(UserOut?, NetOut?, Fs),
    social_graph(Id?, In?, Fs?).

%% =============================================================================
%% NETWORK SWITCH (routes messages between alice and bob)
%% =============================================================================

%% AgentEntry for network: holds channel to communicate with agent
AgentEntry ::= (_, Channel?).

procedure network(AgentEntry?, AgentEntry?).

%% Alice sends msg(alice, bob, X) -> deliver to Bob
network((alice, ch([msg(alice, bob, X)|AliceOut], AliceIn?)),
        (bob, ch(BobOut, [msg(alice, bob, X?)|BobIn?]))) :-
    network((alice, ch(AliceOut?, AliceIn)),
            (bob, ch(BobOut?, BobIn))).

%% Bob sends msg(bob, alice, X) -> deliver to Alice
network((alice, ch(AliceOut, [msg(bob, alice, X?)|AliceIn?])),
        (bob, ch([msg(bob, alice, X)|BobOut], BobIn?))) :-
    network((alice, ch(AliceOut?, AliceIn)),
            (bob, ch(BobOut?, BobIn))).

%% Termination: both streams empty
network((alice, ch([], _)), (bob, ch([], _))).

%% =============================================================================
%% SIMPLE TEST: Single agent processes decision
%% =============================================================================

%% This test mirrors what we already verified works
procedure test_single_agent.
test_single_agent :-
    social_graph(alice, 
                 [decision(yes, bob, Resp?)],
                 [(user, UserOut), (net, NetOut)]),
    observe_result(Resp?, UserOut?, NetOut?).

procedure observe_result(Response?, Stream?, Stream?).
observe_result(accept(_), _, _).
observe_result(no, _, _).

%% =============================================================================
%% TWO AGENT TEST: Proper channel wiring
%% =============================================================================

procedure test_two_agents.
test_two_agents :-
    %% Create network channels (one pair per agent)
    new_channel(AliceNetCh, NetAliceCh),
    new_channel(BobNetCh, NetBobCh),
    
    %% Create user channels (one pair per agent)  
    new_channel(AliceUserCh, UserAliceCh),
    new_channel(BobUserCh, UserBobCh),
    
    %% Start network switch with its channel ends
    network((alice, NetAliceCh?), (bob, NetBobCh?)),
    
    %% Start agents with their channel ends
    agent(alice, AliceUserCh?, AliceNetCh?),
    agent(bob, BobUserCh?, BobNetCh?),
    
    %% Start actors with user channel ends
    alice_actor(UserAliceCh?),
    bob_actor(UserBobCh?).

%% Alice's actor: receives befriend request, accepts
procedure alice_actor(Channel?).
alice_actor(ch([befriend(bob, Resp)|In], [decision(yes, bob, Resp?)|Out?])) :-
    alice_done(In?, Out).

procedure alice_done(Stream?, Stream?).
alice_done(_, []).

%% Bob's actor: initiates introduction, waits for response
procedure bob_actor(Channel?).
bob_actor(ch(In, [intro_request(alice)|Out?])) :-
    bob_wait(In?, Out).

procedure bob_wait(Stream?, Stream?).
bob_wait([response_received(Resp)|In], Out?) :-
    bob_done(In?, Out, Resp?).

procedure bob_done(Stream?, Stream?, Response?).
bob_done(_, [], _).
