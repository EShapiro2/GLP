%% social_graph_play.glp - Social Graph Cold-Call Befriending Protocol
%% Single-file, single-isolate implementation with play
%% Use :strict to disable type checking before loading (wait guard not in type checker)

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Channel ::= ch(Stream, Stream?).
Resp ::= accept(Channel) ; no.
LookupResult ::= found(MsgStream) ; not_found.
MsgOp ::= connect(_)
        ; intro(_, _, Resp?)
        ; befriend(_, Resp?)
        ; decision(_, _, Resp)
        ; response(Resp?)
        ; report(_).

Msg ::= msg(_, _, MsgOp).
TaggedMsg ::= tagged(_, _).
MsgItem ::= Msg ; TaggedMsg.
MsgStream ::= [] ; [MsgItem | MsgStream].

FriendEntry ::= (_, MsgStream).
FriendList ::= [] ; [FriendEntry | FriendList].
Friends ::= [] ; [_|Friends].

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).

%% =============================================================================
%% NEW_CHANNEL
%% =============================================================================

procedure new_channel(Channel, Channel).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% LOOKUP_SEND (single-pass)
%% =============================================================================

procedure lookup_send(_?, _?, Friends?, Friends).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(_?, _?, Friends?, Friends).
lookup_send_step(Key, Msg, [(K, [Msg?|Out1])|Rest], [(K?, Out1?)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [Pair|Rest], [Pair?|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG: Deferred response insertion
%% =============================================================================

procedure inject_msg(Resp?, _?, _?, Stream?, Stream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).
inject_msg(_, _, _, [], []).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, Stream?, Stream).
tag_stream(Name, [M|In], [tagged(Name?, M?)|Out?]) :-
    constant(Name?) |
    tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% =============================================================================
%% BIND_RESPONSE
%% =============================================================================

procedure bind_response(_?, _?, _, Friends?, Friends, Stream?, Stream).
bind_response(yes, From, accept(ch(FOut?, FIn)), Fs, Fs1?, In, In1?) :-
    handle_response(accept(ch(FIn?, FOut)), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

%% =============================================================================
%% HANDLE_RESPONSE
%% =============================================================================

procedure handle_response(_?, _?, Friends?, Friends, Stream?, Stream).
handle_response(accept(ch(FIn, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

%% =============================================================================
%% SOCIAL GRAPH PROTOCOL - Main event loop
%% =============================================================================

procedure social_graph(_?, Stream?, Friends?).

%% Process user request to connect
social_graph(Id, [msg(user, To, connect(Target))|In], Fs) :-
    wait(1000), ground(Id?), ground(Target?), Id? =?= To? |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Process received self-introduction
social_graph(Id, [msg(From, To, intro(Src1, Src2, Resp))|In], Fs) :-
    wait(1000), ground(Id?), ground(From?), Id? =?= To?, From? =?= Src1?, From? =?= Src2? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    social_graph(Id?, In?, Fs1?).

%% Process user decision on received introduction
social_graph(Id, [msg(user, To, decision(Dec, From, Resp?))|In], Fs) :-
    wait(1000), ground(Id?), Id? =?= To? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Process response to sent introduction
social_graph(Id, [msg(From, To, response(Resp))|In], Fs) :-
    wait(1000), ground(Id?), Id? =?= To? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Report current friends list (binds result, then stops)
social_graph(_, [msg(_, _, report(Fs?))|_], Fs) :-
    wait(1000) | true.

%% Skip unhandled messages (MUST BE LAST)
social_graph(Id, [_|In], Fs) :-
    otherwise |
    social_graph(Id?, In?, Fs?).

%% Base case
social_graph(_, [], _).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure agent_init(_?, Channel?, Channel?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    social_graph(Id?, In?, [(user, UserOut), (net, NetOut)]).

%% =============================================================================
%% NETWORK SWITCH (2-agent, in-process)
%% =============================================================================

procedure network2(_?, _?).
network2(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).
network2(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).
network2(ch([], _), ch([], _)).

%% =============================================================================
%% ACTORS
%% =============================================================================

procedure alice_actor(_?, _).
alice_actor(ch(_, [msg(user, alice, connect(bob))|[msg(user, alice, report(AliceFs?))|Out?]]), AliceFs) :-
    alice_done(Out).

procedure alice_done(Stream).
alice_done([]).

procedure bob_actor(_?, _).
bob_actor(ch([msg(agent, user, befriend(From, Resp))|In], [msg(user, bob, decision(yes, From?, Resp?))|[msg(user, bob, report(BobFs?))|Out?]]), BobFs) :-
    ground(From?) |
    bob_done(In?, Out).

procedure bob_done(Stream?, Stream).
bob_done([], []).
bob_done([_|Xs], Ys?) :- bob_done(Xs?, Ys).

%% =============================================================================
%% THE PLAY
%% =============================================================================

procedure play(_, _).
play(AliceFs?, BobFs?) :-
    new_channel(AliceUserCh, UserAliceCh),
    new_channel(AliceNetCh, NetAliceCh),
    new_channel(BobUserCh, UserBobCh),
    new_channel(BobNetCh, NetBobCh),
    network2(NetAliceCh?, NetBobCh?),
    agent_init(alice, AliceUserCh?, AliceNetCh?),
    agent_init(bob, BobUserCh?, BobNetCh?),
    alice_actor(UserAliceCh?, AliceFs),
    bob_actor(UserBobCh?, BobFs).
