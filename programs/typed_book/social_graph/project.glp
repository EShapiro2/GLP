%% project.glp - Self-contained social graph agent for Flutter app
%%
%% Combines: social_graph_agent.glp + social_graph_ui_mediator.glp + social_graph_ui_boot.glp
%%
%% Date: 2026-02-14

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================
Channel ::= ch(Stream, Stream?).
Resp ::= accept(Channel) ; no.
LookupResult ::= found(MsgStream) ; not_found.
MsgOp ::= connect(_)
        ; intro(_, _, Resp?)
        ; befriend(_, Resp?)
        ; decision(_, _, Resp)
        ; response(Resp?)
        ; remove(_).
Msg ::= msg(_, _, MsgOp).
TaggedMsg ::= tagged(_, _).
MsgItem ::= Msg ; TaggedMsg.
MsgStream ::= [] ; [MsgItem | MsgStream].
FriendEntry ::= (_, MsgStream).
FriendList ::= [] ; [FriendEntry | FriendList].
Friends ::= [] ; [_|Friends].

Decision ::= yes ; no.

%% Pending entries (from mediator)
PendingVar   ::= pending_response(Resp).
PendingEntry ::= pending(Constant, PendingVar).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% MERGE
%% =============================================================================
procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge(Xs, [], Xs?).
merge([], Ys, Ys?).
%% =============================================================================
%% NEW_CHANNEL
%% =============================================================================
procedure new_channel(Channel, Channel).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).
%% =============================================================================
%% LOOKUP_SEND (single-pass)
%% =============================================================================
procedure lookup_send(_?, _?, Friends?, Friends).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).
procedure lookup_send_step(_?, _?, Friends?, Friends).
lookup_send_step(Key, Msg, [(K, [Msg?|Out1])|Rest], [(K?, Out1?)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [Pair|Rest], [Pair?|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).
%% =============================================================================
%% INJECT_MSG: Deferred response insertion
%% =============================================================================
procedure inject_msg(Resp?, _?, _?, Stream?, Stream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).
inject_msg(_, _, _, [], []).
%% =============================================================================
%% TAG_STREAM
%% =============================================================================
procedure tag_stream(_?, Stream?, Stream).
tag_stream(Name, [M|In], [tagged(Name?, M?)|Out?]) :-
    constant(Name?) |
    tag_stream(Name?, In?, Out).
tag_stream(_, [], []).
%% =============================================================================
%% BIND_RESPONSE
%% =============================================================================
procedure bind_response(_?, _?, _, Friends?, Friends, Stream?, Stream).
bind_response(yes, From, accept(ch(FOut?, FIn)), Fs, Fs1?, In, In1?) :-
    handle_response(accept(ch(FIn?, FOut)), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).
%% =============================================================================
%% HANDLE_RESPONSE
%% =============================================================================
procedure handle_response(_?, _?, Friends?, Friends, Stream?, Stream).
handle_response(accept(ch(FIn, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).
%% =============================================================================
%% REMOVE_ENTRY: Remove a friend from the friends list by key
%% =============================================================================
procedure remove_entry(_?, Friends?, Friends).
remove_entry(Key, [(K, _)|Rest], Rest?) :- Key? =?= K? | true.
remove_entry(Key, [Entry|Rest], [Entry?|Rest1?]) :-
    otherwise | remove_entry(Key?, Rest?, Rest1).
remove_entry(_, [], []).
%% =============================================================================
%% SOCIAL GRAPH PROTOCOL - Main event loop
%% =============================================================================
procedure social_graph(_?, Stream?, Friends?).
%% Process user request to connect
social_graph(Id, [msg(user, To, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?), Id? =?= To? |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    social_graph(Id?, In1?, Fs1?).
%% Process received self-introduction
social_graph(Id, [msg(From, To, intro(Src1, Src2, Resp))|In], Fs) :-
    ground(Id?), ground(From?), Id? =?= To?, From? =?= Src1?, From? =?= Src2? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    social_graph(Id?, In?, Fs1?).
%% Process user decision on received introduction
social_graph(Id, [msg(user, To, decision(Dec, From, Resp?))|In], Fs) :-
    ground(Id?), Id? =?= To? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).
%% Process response to sent introduction
social_graph(Id, [msg(From, To, response(Resp))|In], Fs) :-
    ground(Id?), Id? =?= To? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).
%% Process user request to remove a friend
social_graph(Id, [msg(user, To, remove(Target))|In], Fs) :-
    ground(Id?), ground(Target?), Id? =?= To? |
    remove_entry(Target?, Fs?, Fs1),
    social_graph(Id?, In?, Fs1?).
%% Skip unhandled messages (MUST BE LAST)
social_graph(Id, [_|In], Fs) :-
    otherwise |
    social_graph(Id?, In?, Fs?).
%% Base case
social_graph(_, [], _).

%% =============================================================================
%% UI MEDIATOR - Main loop
%% =============================================================================

procedure ui_mediator(Constant?, Channel?, Channel?, PendingList?, Constant?).

%% --- Agent-to-user: befriend (non-ground Resp) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, user, befriend(From, Resp)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(N?, pending_response(Resp?)) | Ps?], N1?).

%% --- User-to-agent: connect ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(connect(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg(user, Id?, connect(Target?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (cold-call response) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Dec?), ground(From?),
    ground(ReqId?) |
    lookup_response(ReqId?, Resp, Ps?, Ps1),
    send(msg(user, Id?, decision(Dec?, From?, Resp?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: remove ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(remove(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send(msg(user, Id?, remove(Target?)), AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

%% lookup_response: retrieve a stored Resp by request ID
procedure lookup_response(Constant?, Resp,
                          PendingList?, PendingList).
lookup_response(ReqId, Resp?,
    [pending(Id, pending_response(Resp)) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_response(ReqId, Resp?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_response(ReqId?, Resp?, Rest?, Rest1).
lookup_response(_, no, [], []).

%% =============================================================================
%% AGENT INITIALIZATION (boot)
%% =============================================================================

-mode(system).

agent_init(Id, DartUserIn, NetIn) :-
    ground(Id?) |
    send_to_net(NetOut?),
    merge(MediatorToAgent?, NetIn?, In),
    social_graph(Id?, In?, [(user, AgentToMediator), (net, NetOut)]),
    ui_mediator(Id?, ch(AgentToMediator?, MediatorToAgent), ch(DartUserIn?, DartUserOut), [], 1),
    send_to_user(DartUserOut?).
