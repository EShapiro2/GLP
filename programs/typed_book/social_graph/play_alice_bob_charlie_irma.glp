%% play_alice_bob_charlie_irma.glp - Cold call + messaging + Friend-mediated introduction
%%
%% IRMA VERSION: Uses Network Transaction instead of network3
%%
%% Message format changes from play_alice_bob_charlie.glp:
%% - NetOut: msg(To, content) instead of msg(From, To, content)
%% - NetIn: msg(From, content) instead of msg(From, To, content)
%% - Cold-call intro: intro(From, Resp) instead of intro(From, From, Resp)
%%
%% Scenario (left-to-right: Alice - Bob - Charlie):
%% 1. Alice cold-calls Bob (Bob accepts)
%% 2. Alice sends message to Bob: "Hi Bob, this is Alice"
%% 3. Bob cold-calls Charlie (Charlie accepts)
%% 4. Charlie sends message to Bob: "Hi Bob, this is Charlie"
%% 5. Bob introduces Alice to Charlie (both accept)
%% 6. Alice sends message to Charlie: "Hi Charlie, this is Alice"
%% 7. Charlie responds to Alice: "Hi Alice, this is Charlie"
%%
%% Date: 2026-01-26

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Intro payload: either response variable (cold-call) or channel (friend intro)
IntroPayload ::= Response ; Channel.

%% Network/friend message content (2-arg messages)
NetContent ::= text(_)                    % text(String)
             ; intro(_, IntroPayload?)    % intro(Name, Resp/Ch)
             ; response(Response?).       % response to cold-call

%% User-agent message content (3-arg messages)
UserContent ::= connect(_)                % connect(Target) - initiate cold-call
              ; befriend(_, Response?)    % befriend(From, Resp) - ask user decision
              ; decision(_, _, Response?) % decision(yes/no, From, Resp)
              ; connected(_)              % connected(Name) - notify user
              ; rejected(_)               % rejected(Name) - notify user
              ; send(_, _)                % send(To, Text) - user sends text
              ; received(_, _)            % received(From, Text) - notify user
              ; introduce(_, _)           % introduce(P, Q) - user requests intro
              ; befriend_intro(_, _, Channel?)  % befriend_intro(From, Other, Ch)
              ; accept_intro(_, Channel?)       % accept_intro(Other, Ch)
              ; reject_intro(_).                % reject_intro(Other)

%% Messages: 2-arg for network/friends, 3-arg for user channel
Msg ::= msg(_, NetContent) ; msg(_, _, UserContent).

%% Message stream with typed elements
MsgStream ::= [] ; [Msg|MsgStream].

%% Channel: generic slots (modes checked by usage, not type)
Channel ::= ch(_, _).

Response ::= accept(Channel) ; no.
FriendEntry ::= friend(String?, MsgStream).
FriendsList ::= [] ; [FriendEntry|FriendsList].

%% =============================================================================
%% CHANNEL OPERATIONS (Defined Guards)
%% =============================================================================

%% send(Msg, ChIn, ChOut) - send message on channel
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

%% receive(Msg, ChIn, ChOut) - receive message from channel
receive(X?, ch([X|In], Out?), ch(In?, Out)).

%% new_channel(Ch1, Ch2) - create connected channel pair
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(MsgStream?, MsgStream?, MsgStream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% LOOKUP_SEND - send message to named destination
%% =============================================================================

procedure lookup_send(String?, _?, FriendsList?, FriendsList).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(String?, _?, FriendsList?, FriendsList).
lookup_send_step(Key, Msg, [friend(K, [Msg?|Out1?])|Rest], [friend(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [friend(K, Out?)|Rest], [friend(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, MsgStream?, MsgStream).
inject_msg(Resp, From, Ys, [msg(From?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, From, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, From?, Ys?, Ys1).

%% =============================================================================
%% ADD_FRIEND - add friend to friends list
%% =============================================================================

procedure add_friend(_?, MsgStream, FriendsList?, FriendsList).
add_friend(Name, Out?, Fs, [friend(Name?, Out)|Fs?]).

%% =============================================================================
%% RESPONSE HANDLING (Cold-call)
%% =============================================================================

procedure bind_response(_?, _?, Response, FriendsList?, FriendsList, MsgStream?, MsgStream).
bind_response(yes, From, accept(RetCh?), Fs, Fs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

procedure handle_response(Response?, _?, FriendsList?, FriendsList, MsgStream?, MsgStream).
handle_response(accept(ch(FIn, FOut?)), From, Fs, Fs1?, In, In1?) :-
    ground(From?) |
    merge(In?, FIn?, In1),
    add_friend_and_notify(From?, FOut, Fs?, Fs1).
handle_response(no, From, Fs, Fs1?, In, In?) :-
    ground(From?) |
    lookup_send(user, msg(agent, user, rejected(From?)), Fs?, Fs1).

procedure add_friend_and_notify(_?, MsgStream, FriendsList?, FriendsList).
add_friend_and_notify(From, FOut?, Fs, [friend(From?, FOut)|Fs1?]) :-
    ground(From?) |
    lookup_send(user, msg(agent, user, connected(From?)), Fs?, Fs1).

%% =============================================================================
%% AGENT - Main loop (Cold-call + Messaging + Friend Introduction)
%% =============================================================================
%%
%% IRMA message format:
%% - NetOut: msg(Target, content) - IRMA extracts Target, delivers content
%% - NetIn: msg(From, content) - IRMA wraps with sender
%% - UserCh: msg(user/agent, agent/user, content) - unchanged (local channel)

procedure agent(_?, MsgStream?, FriendsList?).

%% --- Cold-call protocol ---

%% User initiates cold call
%% Send msg(Target, intro(Id, Resp)) to network - IRMA routes to Target
agent(Id, [msg(user, agent, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?) |
    lookup_send(net, msg(Target?, intro(Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Received self-introduction (cold-call: 2-arg intro where sender == From)
%% Pattern: msg(From, intro(From, Resp)) where From is the sender
agent(Id, [msg(From, intro(From1, Resp))|In], Fs) :-
    ground(Id?), ground(From?), From? =?= From1? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User decision on cold-call introduction
agent(Id, [msg(user, agent, decision(Dec, From, Resp?))|In], Fs) :-
    ground(Id?) |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Response to sent cold-call introduction
agent(Id, [msg(From, response(Resp))|In], Fs) :-
    ground(Id?), ground(From?) |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% --- Text messaging ---

%% User sends text message to friend
agent(Id, [msg(user, agent, send(Target, Text))|In], Fs) :-
    ground(Id?), ground(Target?) |
    lookup_send(Target?, msg(Id?, text(Text?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% Received text message from friend - forward to user
agent(Id, [msg(From, text(Text))|In], Fs) :-
    ground(Id?), ground(From?) |
    lookup_send(user, msg(agent, user, received(From?, Text?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% --- Friend-mediated introduction protocol ---

%% User commands: introduce P to Q (creates bidirectional channel)
%% Uses friend channels (Communicate Transaction), not network
agent(Id, [msg(user, agent, introduce(P, Q))|In], Fs) :-
    ground(Id?), ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    lookup_send(P?, msg(Id?, intro(Q?, QPCh?)), Fs?, Fs1),
    lookup_send(Q?, msg(Id?, intro(P?, PQCh?)), Fs1?, Fs2),
    agent(Id?, In?, Fs2?).

%% Received introduction from friend (2-arg intro where sender != Other)
%% Pattern: msg(From, intro(Other, Ch)) where From is friend introducing you to Other
agent(Id, [msg(From, intro(Other, Ch))|In], Fs) :-
    ground(Id?), ground(From?), ground(Other?), ~(From? =?= Other?) |
    lookup_send(user, msg(agent, user, befriend_intro(From?, Other?, Ch?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User accepts friend introduction
agent(Id, [msg(user, agent, accept_intro(Other, Ch))|In], Fs) :-
    ground(Id?), ground(Other?) |
    handle_intro_accept(Ch?, Other?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% User rejects friend introduction
agent(Id, [msg(user, agent, reject_intro(_))|In], Fs) :-
    ground(Id?) |
    agent(Id?, In?, Fs?).

%% --- Catch-all and termination ---

agent(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    agent(Id?, In?, Fs?).

agent(_, [], _).

%% =============================================================================
%% HANDLE_INTRO_ACCEPT - process accepted friend introduction
%% =============================================================================

procedure handle_intro_accept(Channel?, _?, FriendsList?, FriendsList, MsgStream?, MsgStream).
handle_intro_accept(ch(FIn, FOut?), Other, Fs, Fs1?, In, In1?) :-
    ground(Other?) |
    add_friend(Other?, FOut, Fs?, Fs1),
    merge(In?, FIn?, In1).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure agent_init(_?, Channel?, Channel?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    agent(Id?, In?, [friend(user, UserOut), friend(net, NetOut)]).

%% =============================================================================
%% ACTORS (Updated for IRMA message format)
%% =============================================================================

%% Alice's script - messages to/from user unchanged
procedure alice_actor(Channel?).
alice_actor(ch(In, [msg(user, alice, connect(bob))|Out?])) :-
    alice_wait_bob_connected(In?, Out).

procedure alice_wait_bob_connected(MsgStream?, MsgStream).
alice_wait_bob_connected([msg(agent, user, connected(bob))|In],
                         [msg(user, alice, send(bob, 'Hi Bob, this is Alice'))|Out?]) :-
    alice_wait_intro(In?, Out).
alice_wait_bob_connected([], []).

procedure alice_wait_intro(MsgStream?, MsgStream).
alice_wait_intro([msg(agent, user, connected(_))|In], Out?) :-
    alice_wait_intro(In?, Out).
alice_wait_intro([msg(agent, user, received(_, _))|In], Out?) :-
    alice_wait_intro(In?, Out).
alice_wait_intro([msg(agent, user, befriend_intro(_, Other, Ch))|In],
                 [msg(user, alice, accept_intro(Other?, Ch?))|Out?]) :-
    ground(Other?) |
    alice_send_to_charlie(In?, Out).
alice_wait_intro([], []).

procedure alice_send_to_charlie(MsgStream?, MsgStream).
alice_send_to_charlie(In, [msg(user, alice, send(charlie, 'Hi Charlie, this is Alice'))|Out?]) :-
    alice_wait_charlie_reply(In?, Out).

procedure alice_wait_charlie_reply(MsgStream?, MsgStream).
alice_wait_charlie_reply([msg(agent, user, received(charlie, _))|In], Out?) :-
    alice_drain(In?, Out).
alice_wait_charlie_reply([msg(agent, user, connected(_))|In], Out?) :-
    alice_wait_charlie_reply(In?, Out).
alice_wait_charlie_reply([], []).

procedure alice_drain(MsgStream?, MsgStream).
alice_drain([_|In], Out?) :- alice_drain(In?, Out).
alice_drain([], []).

%% Bob's script
procedure bob_actor(Channel?).
bob_actor(ch([msg(agent, user, befriend(From, Resp))|In],
             [msg(user, bob, decision(yes, From?, Resp?))|Out?])) :-
    ground(From?) |
    bob_wait_alice_msg(In?, Out).

procedure bob_wait_alice_msg(MsgStream?, MsgStream).
bob_wait_alice_msg([msg(agent, user, connected(_))|In], Out?) :-
    bob_wait_alice_msg(In?, Out).
bob_wait_alice_msg([msg(agent, user, received(alice, _))|In],
                   [msg(user, bob, connect(charlie))|Out?]) :-
    bob_wait_charlie_connected(In?, Out).
bob_wait_alice_msg([], []).

procedure bob_wait_charlie_connected(MsgStream?, MsgStream).
bob_wait_charlie_connected([msg(agent, user, connected(charlie))|In], Out?) :-
    bob_wait_charlie_msg(In?, Out).
bob_wait_charlie_connected([msg(agent, user, connected(_))|In], Out?) :-
    bob_wait_charlie_connected(In?, Out).
bob_wait_charlie_connected([], []).

procedure bob_wait_charlie_msg(MsgStream?, MsgStream).
bob_wait_charlie_msg([msg(agent, user, received(charlie, _))|In],
                     [msg(user, bob, introduce(alice, charlie))|Out?]) :-
    bob_drain(In?, Out).
bob_wait_charlie_msg([msg(agent, user, connected(_))|In], Out?) :-
    bob_wait_charlie_msg(In?, Out).
bob_wait_charlie_msg([], []).

procedure bob_drain(MsgStream?, MsgStream).
bob_drain([_|In], Out?) :- bob_drain(In?, Out).
bob_drain([], []).

%% Charlie's script
procedure charlie_actor(Channel?).
charlie_actor(ch([msg(agent, user, befriend(From, Resp))|In],
                 [msg(user, charlie, decision(yes, From?, Resp?)),
                  msg(user, charlie, send(bob, 'Hi Bob, this is Charlie'))|Out?])) :-
    ground(From?) |
    charlie_wait_intro(In?, Out).

procedure charlie_wait_intro(MsgStream?, MsgStream).
charlie_wait_intro([msg(agent, user, connected(_))|In], Out?) :-
    charlie_wait_intro(In?, Out).
charlie_wait_intro([msg(agent, user, befriend_intro(_, Other, Ch))|In],
                   [msg(user, charlie, accept_intro(Other?, Ch?))|Out?]) :-
    ground(Other?) |
    charlie_wait_alice_msg(In?, Out).
charlie_wait_intro([], []).

procedure charlie_wait_alice_msg(MsgStream?, MsgStream).
charlie_wait_alice_msg([msg(agent, user, received(alice, _))|In],
                       [msg(user, charlie, send(alice, 'Hi Alice, this is Charlie'))|Out?]) :-
    charlie_drain(In?, Out).
charlie_wait_alice_msg([msg(agent, user, connected(_))|In], Out?) :-
    charlie_wait_alice_msg(In?, Out).
charlie_wait_alice_msg([], []).

procedure charlie_drain(MsgStream?, MsgStream).
charlie_drain([_|In], Out?) :- charlie_drain(In?, Out).
charlie_drain([], []).

%% =============================================================================
%% AGENT STARTUP PROCEDURES (for multi-isolate execution)
%% =============================================================================
%%
%% In multi-isolate execution:
%% - Each agent runs in its own isolate with its own IrmaContext
%% - IRMA's Network Transaction handles msg(Target, content) on NetOut
%% - IRMA delivers msg(Sender, content) to Target's NetIn
%% - The test harness creates UserCh and NetCh, then spawns the start goal
%%
%% Usage: spawn start_alice(UserCh?, NetCh?) in Alice's isolate
%%        spawn start_bob(UserCh?, NetCh?) in Bob's isolate
%%        spawn start_charlie(UserCh?, NetCh?) in Charlie's isolate

procedure start_alice(Channel?, Channel?).
start_alice(UserCh, NetCh) :-
    agent_init(alice, UserCh?, NetCh?).

procedure start_bob(Channel?, Channel?).
start_bob(UserCh, NetCh) :-
    agent_init(bob, UserCh?, NetCh?).

procedure start_charlie(Channel?, Channel?).
start_charlie(UserCh, NetCh) :-
    agent_init(charlie, UserCh?, NetCh?).

%% =============================================================================
%% ACTOR STARTUP PROCEDURES (for multi-isolate execution)
%% =============================================================================
%%
%% Each actor runs connected to an agent via the UserCh.
%% The test harness creates the channel and spawns both.

procedure run_alice_actor(Channel?).
run_alice_actor(UserCh) :- alice_actor(UserCh?).

procedure run_bob_actor(Channel?).
run_bob_actor(UserCh) :- bob_actor(UserCh?).

procedure run_charlie_actor(Channel?).
run_charlie_actor(UserCh) :- charlie_actor(UserCh?).
