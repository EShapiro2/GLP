%% alice_bob_charlie_direct_message.glp - Ring messaging with generic agents
%%
%% Three agents (Alice, Bob, Charlie) using identical logic.
%% All agents: receive number from predecessor, send N+1 to successor.
%%
%% Ring pattern: Alice -> Bob -> Charlie -> Alice -> ...
%% Terminates when count reaches max_count.
%%
%% Boot pattern (for future @ operator support):
%%   boot :- agent_init(alice, ch(_?,_), ch(_?,_))@alice, ...
%%
%% Date: 2026-01-28

%% =============================================================================
%% CONFIGURATION
%% =============================================================================

procedure max_count(_).
max_count(10).

%% ring_config(Agent, Predecessor, Successor)
procedure ring_config(_?, _, _).
ring_config(alice, charlie, bob).
ring_config(bob, alice, charlie).
ring_config(charlie, bob, alice).

%% ring_starter(Agent) - who initiates
procedure ring_starter(_?).
ring_starter(alice).

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% NETWORK3 - Routes msg(Target, Content) between agents
%% =============================================================================

procedure network3(Channel?, Channel?, Channel?).

%% Alice sends to Bob
network3(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Alice sends to Charlie
network3(ch([msg(charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(alice, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Bob sends to Alice
network3(ch(AliceIn, [msg(bob, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Bob sends to Charlie
network3(ch(AliceIn, AliceOut?),
         ch([msg(charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(bob, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Charlie sends to Alice
network3(ch(AliceIn, [msg(charlie, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Charlie sends to Bob
network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(charlie, X?)|BobOut?]),
         ch([msg(bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Termination
network3(ch([], []), ch([], []), ch([], [])).

%% =============================================================================
%% GENERIC RING AGENT - Same logic for all agents
%% =============================================================================

%% ring_agent(Id, Pred, Succ, InStream, OutStream, Max)
%% - Id: this agent's name (alice, bob, charlie)
%% - Pred: predecessor (receives from)
%% - Succ: successor (sends to)
%% - In/Out: message streams
%% - Max: termination count

procedure ring_agent(_?, _?, _?, Channel?, _?).

%% Starter: send initial message to successor
ring_agent(Id, Pred, Succ, ch(In, [msg(Succ?, num(1))|Out?]), Max) :-
    ring_starter(Id?), ground(Succ?) |
    ring_loop(Id?, Pred?, Succ?, ch(In?, Out), Max?).

%% Non-starter: just enter loop
ring_agent(Id, Pred, Succ, ch(In, Out?), Max) :-
    otherwise |
    ring_loop(Id?, Pred?, Succ?, ch(In?, Out), Max?).

procedure ring_loop(_?, _?, _?, Channel?, _?).

%% Receive from predecessor, forward N+1 to successor (N < Max)
ring_loop(Id, Pred, Succ, ch([msg(P, num(N))|In], [msg(Succ?, num(N1?))|Out?]), Max) :-
    ground(Id?), ground(Succ?), P? =?= Pred?, N? < Max? |
    N1 := N? + 1,
    ring_loop(Id?, Pred?, Succ?, ch(In?, Out), Max?).

%% Receive from predecessor, stop (N >= Max)
ring_loop(Id, Pred, _, ch([msg(P, num(N))|_], []), Max) :-
    ground(Id?), P? =?= Pred?, N? >= Max? |
    true.

%% Skip unknown messages
ring_loop(Id, Pred, Succ, ch([_|In], Out?), Max) :-
    otherwise |
    ring_loop(Id?, Pred?, Succ?, ch(In?, Out), Max?).

%% Empty stream
ring_loop(_, _, _, ch([], []), _).

%% =============================================================================
%% PLAY - For REPL testing
%% =============================================================================

procedure play.
play :-
    max_count(Max),
    ground(Max?),
    new_channel(AliceCh, NetAliceCh),
    new_channel(BobCh, NetBobCh),
    new_channel(CharlieCh, NetCharlieCh)
    |
    network3(NetAliceCh?, NetBobCh?, NetCharlieCh?),
    %% All agents use same ring_agent with config lookup in body
    start_agent(alice, AliceCh?, Max?),
    start_agent(bob, BobCh?, Max?),
    start_agent(charlie, CharlieCh?, Max?).

procedure start_agent(_?, Channel?, _?).
start_agent(Id, Ch, Max) :-
    ground(Id?), ground(Max?) |
    ring_config(Id?, Pred, Succ),
    ring_agent(Id?, Pred?, Succ?, Ch?, Max?).
