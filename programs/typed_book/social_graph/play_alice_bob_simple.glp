%% play_alice_bob_simple.glp - 2-agent cold-call play (simplified types)
%% Alice initiates connection to Bob, Bob accepts
%%
%% Uses Stream everywhere for simplicity.
%% Date: 2026-01-24

%% =============================================================================
%% TYPE DEFINITIONS (Simplified)
%% =============================================================================

%% Channel type - position 1 is output, position 2 is input (when consumed)
Channel ::= ch(Stream, Stream?).

%% Response to connection request
Response ::= accept(Channel) ; no.

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, Stream?, Stream).
tag_stream(Name, [M|In], [tagged(Name?, M?)|Out?]) :-
    ground(Name?) | tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% =============================================================================
%% LOOKUP
%% =============================================================================

procedure lookup(_?, Stream?, _).
lookup(Key, [(K, Value)|_], found(Value?)) :- Key? =?= K? | true.
lookup(Key, [(_, _)|Rest], Result?) :- otherwise | lookup(Key?, Rest?, Result).
lookup(_, [], not_found).

procedure lookup_send(_?, _?, Stream?, Stream).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(_?, _?, Stream?, Stream).
lookup_send_step(Key, Msg, [(K, [Msg?|Out1])|Rest], [(K?, Out1?)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [Pair|Rest], [Pair?|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, _?, Stream?, Stream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% RESPONSE HANDLING
%% =============================================================================

procedure bind_response(_?, _?, Response, Stream?, Stream, Stream?, Stream).
bind_response(yes, From, accept(ch(FOut?, FIn)), Fs, Fs1?, In, In1?) :-
    handle_response(accept(ch(FIn?, FOut)), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

procedure handle_response(Response?, _?, Stream?, Stream, Stream?, Stream).
handle_response(accept(ch(FIn, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

%% =============================================================================
%% SOCIAL GRAPH - Main agent loop
%% =============================================================================

procedure agent(_?, Stream?, Stream?).

%% User initiates connection
agent(Id, [msg(user, Id1, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?), Id? =?= Id1? |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Received self-introduction
agent(Id, [msg(From, Id1, intro(From1, From2, Resp))|In], Fs) :-
    ground(Id?), ground(From?), Id? =?= Id1?, From? =?= From1?, From? =?= From2? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User decision on received introduction
agent(Id, [msg(user, Id1, decision(Dec, From, Resp?))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Response to sent introduction
agent(Id, [msg(From, Id1, response(Resp))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Catch-all for other messages
agent(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    agent(Id?, In?, Fs?).

%% Termination
agent(_, [], _).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure agent_init(_?, Channel?, Channel?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    agent(Id?, In?, [(user, UserOut), (net, NetOut)]).

%% =============================================================================
%% NETWORK SWITCH
%% =============================================================================

procedure network2(Channel?, Channel?).

network2(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch([], _), ch([], _)).

%% =============================================================================
%% ACTORS (simulate user behavior)
%% =============================================================================

%% Alice's actor: sends connect, ignores agent output
procedure alice_actor(Channel?).
alice_actor(ch(_, [msg(user, alice, connect(bob))|Out?])) :-
    alice_done(Out).

procedure alice_done(Stream).
alice_done([]).

%% Bob's actor: waits for befriend, sends acceptance
procedure bob_actor(Channel?).
bob_actor(ch([msg(agent, user, befriend(From, Resp))|In], [msg(user, bob, decision(yes, From?, Resp?))|Out?])) :-
    ground(From?) |
    bob_done(In?, Out).

procedure bob_done(Stream?, Stream).
bob_done([], []).
bob_done([_|Xs], Ys?) :- bob_done(Xs?, Ys).

%% =============================================================================
%% THE PLAY
%% =============================================================================

procedure play_alice_bob.
play_alice_bob :-
    %% Create channel pairs using new_channel
    new_channel(AliceUserCh, UserAliceCh),
    new_channel(AliceNetCh, NetAliceCh),
    new_channel(BobUserCh, UserBobCh),
    new_channel(BobNetCh, NetBobCh),
    
    %% Network switch
    network2(NetAliceCh?, NetBobCh?),
    
    %% Alice's agent
    agent_init(alice, AliceUserCh?, AliceNetCh?),
    
    %% Bob's agent
    agent_init(bob, BobUserCh?, BobNetCh?),
    
    %% Actors
    alice_actor(UserAliceCh?),
    bob_actor(UserBobCh?).

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

procedure new_channel(Channel, Channel).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).
