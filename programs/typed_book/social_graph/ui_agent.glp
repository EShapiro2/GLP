%% ui_agent.glp - UI Agent for GLP term-based user interaction
%%
%% Phase 1: Users interact with GLP using GLP terms
%% - Output to user: ground terms or terms with writers (not readers)
%% - Input from user: GLP terms parsed with GLP parser
%%   - X = term  binds writer X to term
%%   - Other terms are injected into agent's input stream
%%
%% The UI agent validates:
%% - Output: only ground or writer variables allowed
%% - Input: parse errors reported, writer bindings verified
%%
%% Date: 2026-02-01

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Response ::= accept(Channel) ; no.
FriendEntry ::= friend(String, Stream?).
FriendsList ::= [] ; [FriendEntry|FriendsList].

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% UI AGENT - Validation Layer
%% =============================================================================

%% ui_agent(AgentCh, DartCh)
%% - AgentCh: channel to/from social agent
%% - DartCh: channel to/from Dart UI

procedure ui_agent(Channel?, Channel?).

%% --- Messages FROM social agent TO user ---
%% Validate that output contains only ground terms or writers, then pass through

ui_agent(AgentCh, DartCh) :-
    receive(Msg, AgentCh?, AgentCh1) |
    validate_and_send(Msg?, DartCh?, DartCh1),
    ui_agent(AgentCh1?, DartCh1?).

%% --- Messages FROM user TO agent ---
%% Handle binding commands (X = term) or pass through other terms

ui_agent(AgentCh, DartCh) :-
    receive(bind(X, Term), DartCh?, DartCh1),
    writer(X?) |
    X = Term?,
    ui_agent(AgentCh?, DartCh1?).

ui_agent(AgentCh, DartCh) :-
    receive(bind(X, _), DartCh?, DartCh1),
    not_writer(X?) |
    send(error(not_a_writer, X?), DartCh1?, DartCh2),
    ui_agent(AgentCh?, DartCh2?).

ui_agent(AgentCh, DartCh) :-
    receive(Msg, DartCh?, DartCh1),
    not_bind(Msg?) |
    send(Msg?, AgentCh?, AgentCh1),
    ui_agent(AgentCh1?, DartCh1?).

%% =============================================================================
%% VALIDATION HELPERS
%% =============================================================================

%% validate_and_send: check term and send to user
procedure validate_and_send(_?, Channel?, Channel).
validate_and_send(Msg, DartCh, DartCh1?) :-
    valid_for_user(Msg?) |
    send(Msg?, DartCh?, DartCh1).
validate_and_send(Msg, DartCh, DartCh1?) :-
    not_valid_for_user(Msg?) |
    send(error(invalid_output, Msg?), DartCh?, DartCh1).

%% valid_for_user: term is ground or contains only writers
%% For now, we trust the agent sends valid terms (checking done in Dart)
valid_for_user(_) :- true.

%% not_bind: term is not a bind(X, Term) structure
not_bind(bind(_, _)) :- fail.
not_bind(_) :- otherwise | true.

%% writer/not_writer: check if variable is a writer
%% These are defined guards that Dart must implement
%% For now, assume all unbound variables in user input are writers

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% LOOKUP_SEND - send message to named destination
%% =============================================================================

procedure lookup_send(String?, _?, FriendsList?, FriendsList).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(String?, _?, FriendsList?, FriendsList).
lookup_send_step(Key, Msg, [friend(K, [Msg?|Out1?])|Rest], [friend(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [friend(K, Out?)|Rest], [friend(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, _?, Stream?, Stream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% ADD_FRIEND - add friend to friends list
%% =============================================================================

procedure add_friend(_?, Stream, FriendsList?, FriendsList).
add_friend(Name, Out?, Fs, [friend(Name?, Out)|Fs?]).

%% =============================================================================
%% RESPONSE HANDLING (Cold-call)
%% =============================================================================

procedure bind_response(_?, _?, Response, FriendsList?, FriendsList, Stream?, Stream).
bind_response(yes, From, accept(RetCh?), Fs, Fs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

procedure handle_response(Response?, _?, FriendsList?, FriendsList, Stream?, Stream).
handle_response(accept(ch(FIn, FOut?)), From, Fs, Fs1?, In, In1?) :-
    ground(From?) |
    merge(In?, FIn?, In1),
    add_friend_and_notify(From?, FOut, Fs?, Fs1).
handle_response(no, From, Fs, Fs1?, In, In?) :-
    ground(From?) |
    lookup_send(user, rejected(From?), Fs?, Fs1).

procedure add_friend_and_notify(_?, Stream, FriendsList?, FriendsList).
add_friend_and_notify(From, FOut?, Fs, [friend(From?, FOut)|Fs1?]) :-
    ground(From?) |
    lookup_send(user, connected(From?), Fs?, Fs1).

%% =============================================================================
%% AGENT - Main loop (Cold-call + Messaging + Friend Introduction)
%% =============================================================================

procedure agent(_?, Stream?, FriendsList?).

%% --- Cold-call protocol ---

%% User initiates cold call: connect(Target)
agent(Id, [connect(Target)|In], Fs) :-
    ground(Target?) |
    lookup_send(net, msg(Target?, intro(Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Received cold-call introduction (2-arg msg from network)
agent(Id, [msg(Id1, intro(From, Resp))|In], Fs) :-
    Id? =?= Id1? |
    lookup_send(user, befriend(From?, Resp), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User binds response variable (handled by ui_agent, but response arrives here)
%% When user types "X35 = accept(Ch)" the ui_agent binds X35
%% The inject_msg will then fire and send response to initiator

%% Response to sent cold-call introduction
agent(Id, [msg(From, Id1, response(Resp))|In], Fs) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% --- Text messaging ---

%% User sends text message: send(Target, Text)
agent(Id, [send(Target, Text)|In], Fs) :-
    ground(Target?) |
    lookup_send(Target?, msg(Id?, Target?, text(Text?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% Received text message from friend
agent(Id, [msg(From, Id1, text(Text))|In], Fs) :-
    Id? =?= Id1? |
    lookup_send(user, received(From?, Text?), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% --- Friend-mediated introduction protocol ---

%% User commands: introduce(P, Q)
agent(Id, [introduce(P, Q)|In], Fs) :-
    ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    lookup_send(P?, msg(Id?, P?, intro(Q?, QPCh?)), Fs?, Fs1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, PQCh?)), Fs1?, Fs2),
    agent(Id?, In?, Fs2?).

%% Received introduction from friend
agent(Id, [msg(From, Id1, intro(Other, Ch))|In], Fs) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send(user, befriend_intro(From?, Other?, Ch), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User accepts friend introduction by binding Ch
%% (handled implicitly when user binds the channel variable)

%% --- Catch-all and termination ---

agent(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    agent(Id?, In?, Fs?).

agent(_, [], _).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure agent_init(_?, Channel?, Channel?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    agent(Id?, In?, [friend(user, UserOut), friend(net, NetOut)]).
