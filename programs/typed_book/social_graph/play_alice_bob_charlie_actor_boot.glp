%% play_alice_bob_charlie_actor_boot.glp - Actor-driven test with ui_agent layer
%%
%% This is the headless test version using scripted actors instead of UI windows.
%% agent_init spawns ui_agent_actor internally, which runs actor/2 to simulate user input.
%%
%% Scenario (left-to-right: Alice - Bob - Charlie):
%% 1. Alice cold-calls Bob (Bob accepts)
%% 2. Alice sends message to Bob: "Hi Bob, this is Alice"
%% 3. Bob cold-calls Charlie (Charlie accepts)
%% 4. Charlie sends message to Bob: "Hi Bob, this is Charlie"
%% 5. Bob introduces Alice to Charlie (both accept)
%% 6. Alice sends message to Charlie: "Hi Charlie, this is Alice"
%% 7. Charlie responds to Alice: "Hi Alice, this is Charlie"
%%
%% Date: 2026-02-01

-mode(system).  %% Uses reserved constants '_user' and '_net'

%% =============================================================================
%% BOOT (same structure as original - BootLoader compatible)
%% =============================================================================

procedure boot.
boot :-
    agent_init(alice, _)@alice,
    agent_init(bob, _)@bob,
    agent_init(charlie, _)@charlie.

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Stream and Channel are predefined in prelude:
%%   Stream ::= [] ; [_|Stream].
%%   Channel ::= ch(Stream, Stream?).

Response ::= accept(Channel) ; no.
OutputEntry ::= output(String, Stream?).
OutputsList ::= [] ; [OutputEntry|OutputsList].

%% =============================================================================
%% CHANNEL OPERATIONS (Defined Guards)
%% =============================================================================

%% send(Msg, ChIn, ChOut) - send message on channel
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

%% receive(Msg, ChIn, ChOut) - receive message from channel
receive(X?, ch([X|In], Out?), ch(In?, Out)).

%% new_channel(Ch1, Ch2) - create connected channel pair
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% AGENT INITIALIZATION (Actor Version)
%% - Spawns ui_agent_actor internally
%% - UI channel created here, net channel from boot
%% - Merges user and net inputs; OutputsList for uniform message sending
%% =============================================================================

procedure agent_init(Constant?, Stream?).
agent_init(Id, NetIn) :-
    ground(Id?), new_channel(ch(UserIn, UserOut?), ActorCh) |
    ui_agent_actor(Id?, ActorCh?),
    send_to_net(NetOut?),
    agent(Id?, UserIn?, NetIn?, [output('_user', UserOut), output('_net', NetOut)]).

%% =============================================================================
%% UI AGENT LAYER - Actor Implementation
%% =============================================================================

%% ui_agent_actor(AgentId, Ch) - runs scripted actor
%% Ch is the channel TO the social agent (we read from it, write to it)
procedure ui_agent_actor(_?, Channel?).
ui_agent_actor(Agent, Ch) :-
    new_channel(ActorCh, RelayCh) |  %% ActorCh is for actor (read/write), RelayCh for relay
    ui_relay(Ch?, RelayCh?),
    actor(Agent?, ActorCh?).

%% =============================================================================
%% UI RELAY with no_readers Validation
%% =============================================================================

procedure ui_relay(Channel?, Channel?).

%% From social agent to actor: wait until no readers, then forward
ui_relay(ch(AgentIn, AgentOut?), ch(ActorIn, ActorOut?)) :-
    receive(Msg, ch(AgentIn?, AgentOut), ch(AgentIn1, AgentOut1?)),
    no_readers(Msg?) |
    send(Msg?, ch(ActorIn?, ActorOut), ch(ActorIn1, ActorOut1?)),
    ui_relay(ch(AgentIn1?, AgentOut1), ch(ActorIn1?, ActorOut1)).

%% From actor to social agent: pass through
ui_relay(ch(AgentIn, AgentOut?), ch(ActorIn, ActorOut?)) :-
    receive(Msg, ch(ActorIn?, ActorOut), ch(ActorIn1, ActorOut1?)) |
    send(Msg?, ch(AgentIn?, AgentOut), ch(AgentIn1, AgentOut1?)),
    ui_relay(ch(AgentIn1?, AgentOut1), ch(ActorIn1?, ActorOut1)).

%% Termination
ui_relay(ch([], []), ch(_, [])).
ui_relay(ch(_, []), ch([], [])).

%% =============================================================================
%% ACTORS - Scripted user behavior for each agent
%% All actor/2 clauses must be contiguous (GLP compiler requirement)
%% =============================================================================

procedure actor(_?, Channel?).

actor(alice, Ch) :-
    send(msg('_user', alice, connect(bob)), Ch?, Ch1) |
    alice_actor(Ch1?).

actor(bob, Ch) :-
    bob_actor(Ch?, not_connected_alice, not_connected_charlie).

actor(charlie, Ch) :-
    charlie_actor(Ch?).


%% =============================================================================
%% ALICE_ACTOR - Alice's state machine
%% =============================================================================

procedure alice_actor(Channel?).

%% Bob accepted our connection
alice_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', connected(bob)) |
    send(msg('_user', alice, send(bob, 'Hi Bob, this is Alice')), Ch1?, Ch2),
    alice_actor(Ch2?).

%% Introduction from Bob to Charlie
alice_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', befriend_intro(bob, charlie, IntroChannel)) |
    send(msg('_user', alice, accept_intro(charlie, IntroChannel?)), Ch1?, Ch2),
    alice_actor(Ch2?).

%% Charlie is now connected (after introduction)
alice_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', connected(charlie)) |
    send(msg('_user', alice, send(charlie, 'Hi Charlie, this is Alice')), Ch1?, Ch2),
    alice_actor(Ch2?).

%% Received message from Charlie - scenario complete for Alice
alice_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', received(charlie, _)) |
    alice_actor(Ch1?).

%% Catch-all for other messages
alice_actor(Ch) :-
    receive(_, Ch?, Ch1), otherwise |
    alice_actor(Ch1?).

alice_actor(ch([], [])).


%% =============================================================================
%% BOB_ACTOR - Bob's state machine
%% =============================================================================

procedure bob_actor(Channel?, _?, _?).

%% Alice wants to befriend us - accept
bob_actor(Ch, _, CharlieStatus) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', befriend(alice, Resp)) |
    send(msg('_user', bob, decision(yes, alice, Resp?)), Ch1?, Ch2),
    bob_actor(Ch2?, waiting_alice, CharlieStatus?).

%% Alice connection confirmed
bob_actor(Ch, waiting_alice, CharlieStatus) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', connected(alice)) |
    send(msg('_user', bob, connect(charlie)), Ch1?, Ch2),
    bob_actor(Ch2?, connected_alice, CharlieStatus?).

%% Received message from Alice
bob_actor(Ch, AliceStatus, CharlieStatus) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', received(alice, _)) |
    bob_actor(Ch1?, AliceStatus?, CharlieStatus?).

%% Charlie accepted our connection
bob_actor(Ch, AliceStatus, _) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', connected(charlie)) |
    bob_actor(Ch1?, AliceStatus?, connected_charlie).

%% Received message from Charlie - now introduce Alice to Charlie
bob_actor(Ch, connected_alice, connected_charlie) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', received(charlie, _)) |
    send(msg('_user', bob, introduce(alice, charlie)), Ch1?, Ch2),
    bob_actor(Ch2?, introduced, introduced).

%% Catch-all for other messages
bob_actor(Ch, AliceStatus, CharlieStatus) :-
    receive(_, Ch?, Ch1), otherwise |
    bob_actor(Ch1?, AliceStatus?, CharlieStatus?).

bob_actor(ch([], []), _, _).


%% =============================================================================
%% CHARLIE_ACTOR - Charlie's state machine
%% =============================================================================

procedure charlie_actor(Channel?).

%% Bob wants to befriend us - accept
charlie_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', befriend(bob, Resp)) |
    send(msg('_user', charlie, decision(yes, bob, Resp?)), Ch1?, Ch2),
    charlie_actor(Ch2?).

%% Bob connection confirmed
charlie_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', connected(bob)) |
    send(msg('_user', charlie, send(bob, 'Hi Bob, this is Charlie')), Ch1?, Ch2),
    charlie_actor(Ch2?).

%% Introduction from Bob to Alice
charlie_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', befriend_intro(bob, alice, IntroChannel)) |
    send(msg('_user', charlie, accept_intro(alice, IntroChannel?)), Ch1?, Ch2),
    charlie_actor(Ch2?).

%% Received message from Alice - respond
charlie_actor(Ch) :-
    receive(Msg, Ch?, Ch1),
    Msg? = msg(agent, '_user', received(alice, _)) |
    send(msg('_user', charlie, send(alice, 'Hi Alice, this is Charlie')), Ch1?, Ch2),
    charlie_actor(Ch2?).

%% Catch-all for other messages
charlie_actor(Ch) :-
    receive(_, Ch?, Ch1), otherwise |
    charlie_actor(Ch1?).

charlie_actor(ch([], [])).


%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% LOOKUP_SEND - send message to named destination
%% =============================================================================

procedure lookup_send(String?, _?, OutputsList?, OutputsList).
lookup_send(Key, Msg, Outs, Outs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Outs?, Outs1).

procedure lookup_send_step(String?, _?, OutputsList?, OutputsList).
lookup_send_step(Key, Msg, [output(K, [Msg?|Out1?])|Rest], [output(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [output(K, Out?)|Rest], [output(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, _?, Stream?, Stream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% ADD_OUTPUT - add output to outputs list
%% =============================================================================

procedure add_output(_?, Stream, OutputsList?, OutputsList).
add_output(Name, Out?, Outs, [output(Name?, Out)|Outs?]).

%% =============================================================================
%% RESPONSE HANDLING (Cold-call)
%% =============================================================================

procedure bind_response(_?, _?, Response, OutputsList?, OutputsList, Stream?, Stream).
bind_response(yes, From, accept(RetCh?), Outs, Outs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Outs?, Outs1, In?, In1).
bind_response(no, _, no, Outs, Outs1?, In, In?) :-
    lookup_send('_user', msg(agent, '_user', rejected), Outs?, Outs1).

procedure handle_response(Response?, _?, OutputsList?, OutputsList, Stream?, Stream).
handle_response(accept(ch(FIn, FOut?)), From, Outs, Outs2?, In, In1?) :-
    ground(From?) |
    add_output(From?, FOut, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', connected(From?)), Outs1?, Outs2),
    merge(In?, FIn?, In1).
handle_response(no, From, Outs, Outs1?, In, In?) :-
    ground(From?) |
    lookup_send('_user', msg(agent, '_user', rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% AGENT - Main loop (Cold-call + Messaging + Friend Introduction)
%% Merged input stream; OutputsList for uniform message sending
%% =============================================================================

procedure agent(_?, Stream?, Stream?, OutputsList?).

%% --- User messages (from '_user') ---

%% User initiates cold call
agent(Id, [msg('_user', Id1, connect(Target))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send('_net', msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?).

%% User decision on cold-call introduction
agent(Id, [msg('_user', Id1, decision(Dec, From, Resp?))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% User sends text message to friend
agent(Id, [msg('_user', Id1, send(Target, Text))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send(Target?, msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% User commands: introduce P to Q
agent(Id, [msg('_user', Id1, introduce(P, Q))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    lookup_send(P?, msg(Id?, P?, intro(Q?, QPCh?)), Outs?, Outs1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, PQCh?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?).

%% User accepts friend introduction
agent(Id, [msg('_user', Id1, accept_intro(Other, Ch))|UserIn], NetIn, Outs) :-
    Id? =?= Id1?, ground(Other?) |
    handle_intro_accept(Ch?, Other?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% User rejects friend introduction
agent(Id, [msg('_user', Id1, reject_intro(_))|UserIn], NetIn, Outs) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% User catch-all
agent(Id, [_|UserIn], NetIn, Outs) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Network messages ---

%% Received cold-call introduction from net
agent(Id, UserIn, [msg(Id1, intro(From, Resp))|NetIn], Outs) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', befriend(From?, Resp?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Response to sent cold-call introduction
agent(Id, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?).

%% Received text message from friend - forward to user
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Received introduction from friend - forward to user
agent(Id, UserIn, [msg(From, Id1, intro(Other, Ch))|NetIn], Outs) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send('_user', msg(agent, '_user', befriend_intro(From?, Other?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?).

%% Network catch-all
agent(Id, UserIn, [_|NetIn], Outs) :-
    ground(Id?), otherwise |
    agent(Id?, UserIn?, NetIn?, Outs?).

%% --- Termination ---

agent(_, [], _, _).
agent(_, _, [], _).

%% =============================================================================
%% HANDLE_INTRO_ACCEPT - process accepted friend introduction
%% =============================================================================

procedure handle_intro_accept(Channel?, _?, OutputsList?, OutputsList, Stream?, Stream).
handle_intro_accept(ch(FIn, FOut?), Other, Outs, Outs2?, In, In1?) :-
    ground(Other?) |
    add_output(Other?, FOut, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', connected(Other?)), Outs1?, Outs2),
    merge(In?, FIn?, In1).
