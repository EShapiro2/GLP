%% play_alice_bob_carol.glp - Cold call + Friend-mediated introduction
%%
%% Scenario:
%% 1. Alice cold-calls Bob (Bob accepts)
%% 2. Alice cold-calls Carol (Carol accepts)
%% 3. Alice introduces Bob to Carol (both accept)
%% Result: All three are mutual friends
%%
%% Date: 2026-01-25

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Decision ::= yes ; no.
FriendChannel ::= ch(MsgStream, MsgStream?).
Response ::= accept(FriendChannel) ; no.

MsgPayload ::= connect(String?) ; connected(String?) ; rejected(String?)
             ; befriend(String?, Response) ; decision(Decision, String?, Response)
             ; befriend_intro(String?, String?, FriendChannel?) ; accept_intro(String?, FriendChannel?) ; reject_intro(String?)
             ; introduce(String?, String?)
             ; intro(String?, String?, Response) ; intro(String?, FriendChannel?)
             ; response(Response?).

Msg ::= msg(Constant, Constant, MsgPayload).
MsgStream ::= [] ; [Msg | MsgStream].

FriendEntry ::= friend(String?, MsgStream).
FriendsList ::= [] ; [FriendEntry|FriendsList].

%% =============================================================================
%% CHANNEL OPERATIONS (Defined Guards)
%% =============================================================================

%% send(Msg, ChIn, ChOut) - send message on channel
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

%% receive(Msg, ChIn, ChOut) - receive message from channel
receive(X?, ch([X|In], Out?), ch(In?, Out)).

%% new_channel(Ch1, Ch2) - create connected channel pair
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, Stream(X)?, Stream(X)).
tag_stream(Name, [M|In], [msg(Name?, Name?, M?)|Out?]) :-
    ground(Name?) | tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% =============================================================================
%% LOOKUP_SEND - send message to named destination
%% =============================================================================

procedure lookup_send(String?, _?, FriendsList?, FriendsList).
lookup_send(Key, Msg, Fs, Fs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Fs?, Fs1).

procedure lookup_send_step(String?, _?, FriendsList?, FriendsList).
lookup_send_step(Key, Msg, [friend(K, [Msg?|Out1?])|Rest], [friend(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [friend(K, Out?)|Rest], [friend(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% INJECT_MSG - defer insertion until Resp is known
%% =============================================================================

procedure inject_msg(Response?, _?, _?, Stream(X)?, Stream(X)).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% ADD_FRIEND - add friend to friends list
%% =============================================================================

procedure add_friend(_?, Stream(X), FriendsList?, FriendsList).
add_friend(Name, Out?, Fs, [friend(Name?, Out)|Fs?]).

%% =============================================================================
%% RESPONSE HANDLING (Cold-call)
%% =============================================================================

procedure bind_response(_?, _?, Response, FriendsList?, FriendsList, Stream(X)?, Stream(X)).
bind_response(yes, From, accept(RetCh?), Fs, Fs1?, In, In1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

procedure handle_response(Response?, _?, FriendsList?, FriendsList, Stream(X)?, Stream(X)).
handle_response(accept(ch(FIn, FOut?)), From, Fs, Fs1?, In, In1?) :-
    ground(From?) |
    merge(In?, FIn?, In1),
    add_friend_and_notify(From?, FOut, Fs?, Fs1).
handle_response(no, From, Fs, Fs1?, In, In?) :-
    ground(From?) |
    lookup_send(user, msg(agent, user, rejected(From?)), Fs?, Fs1).

procedure add_friend_and_notify(_?, Stream(X), FriendsList?, FriendsList).
add_friend_and_notify(From, FOut?, Fs, [friend(From?, FOut)|Fs1?]) :-
    ground(From?) |
    lookup_send(user, msg(agent, user, connected(From?)), Fs?, Fs1).

%% =============================================================================
%% AGENT - Main loop (Cold-call + Friend Introduction)
%% =============================================================================

procedure agent(_?, Stream(X)?, FriendsList?).

%% --- Cold-call protocol ---

%% User initiates cold call
agent(Id, [msg(user, Id1, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?), Id? =?= Id1? |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Received self-introduction (cold-call: 3-arg intro) - forward to user
agent(Id, [msg(From, Id1, intro(From1, From2, Resp))|In], Fs) :-
    ground(Id?), ground(From?), Id? =?= Id1?, From? =?= From1?, From? =?= From2? |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User decision on cold-call introduction
agent(Id, [msg(user, Id1, decision(Dec, From, Resp?))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% Response to sent cold-call introduction
agent(Id, [msg(From, Id1, response(Resp))|In], Fs) :-
    ground(Id?), ground(From?), Id? =?= Id1? |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% --- Friend-mediated introduction protocol ---

%% User commands: introduce P to Q (creates bidirectional channel)
agent(Id, [msg(user, Id1, introduce(P, Q))|In], Fs) :-
    ground(Id?), ground(P?), ground(Q?), Id? =?= Id1?, new_channel(PQCh, QPCh) |
    lookup_send(P?, msg(Id?, P?, intro(Q?, QPCh?)), Fs?, Fs1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, PQCh?)), Fs1?, Fs2),
    agent(Id?, In?, Fs2?).

%% Received introduction from friend (2-arg intro) - forward to user
agent(Id, [msg(From, Id1, intro(Other, Ch))|In], Fs) :-
    ground(Id?), ground(From?), ground(Other?), Id? =?= Id1? |
    lookup_send(user, msg(agent, user, befriend_intro(From?, Other?, Ch?)), Fs?, Fs1),
    agent(Id?, In?, Fs1?).

%% User accepts friend introduction
agent(Id, [msg(user, Id1, accept_intro(Other, Ch))|In], Fs) :-
    ground(Id?), ground(Other?), Id? =?= Id1? |
    handle_intro_accept(Ch?, Other?, Fs?, Fs1, In?, In1),
    agent(Id?, In1?, Fs1?).

%% User rejects friend introduction
agent(Id, [msg(user, Id1, reject_intro(_))|In], Fs) :-
    ground(Id?), Id? =?= Id1? |
    agent(Id?, In?, Fs?).

%% --- Catch-all and termination ---

agent(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    agent(Id?, In?, Fs?).

agent(_, [], _).

%% =============================================================================
%% HANDLE_INTRO_ACCEPT - process accepted friend introduction
%% =============================================================================

procedure handle_intro_accept(Channel(X, Y)?, _?, FriendsList?, FriendsList, Stream(X)?, Stream(X)).
handle_intro_accept(ch(FIn, FOut?), Other, Fs, Fs1?, In, In1?) :-
    ground(Other?) |
    add_friend(Other?, FOut, Fs?, Fs1),
    tag_stream(Other?, FIn?, Tagged),
    merge(In?, Tagged?, In1).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure agent_init(_?, Channel(X, Y)?, Channel(X, Y)?).
agent_init(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    agent(Id?, In?, [friend(user, UserOut), friend(net, NetOut)]).

%% =============================================================================
%% NETWORK SWITCH (3-way)
%% =============================================================================

procedure network3(Channel(X, Y)?, Channel(X, Y)?, Channel(X, Y)?).

%% Alice -> Bob
network3(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?]),
         ch(CarolIn, CarolOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CarolIn?, CarolOut)).

%% Alice -> Carol
network3(ch([msg(alice, carol, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CarolIn, [msg(alice, carol, X?)|CarolOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CarolIn?, CarolOut)).

%% Bob -> Alice
network3(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?),
         ch(CarolIn, CarolOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CarolIn?, CarolOut)).

%% Bob -> Carol
network3(ch(AliceIn, AliceOut?),
         ch([msg(bob, carol, X)|BobIn], BobOut?),
         ch(CarolIn, [msg(bob, carol, X?)|CarolOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CarolIn?, CarolOut)).

%% Carol -> Alice
network3(ch(AliceIn, [msg(carol, alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(carol, alice, X)|CarolIn], CarolOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CarolIn?, CarolOut)).

%% Carol -> Bob
network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(carol, bob, X?)|BobOut?]),
         ch([msg(carol, bob, X)|CarolIn], CarolOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CarolIn?, CarolOut)).

%% Termination
network3(ch([], []), ch([], []), ch([], [])).

%% =============================================================================
%% ACTORS
%% =============================================================================

%% Alice's script:
%% 1. Cold-call Bob
%% 2. Cold-call Carol
%% 3. Introduce Bob to Carol
%% 4. Drain messages

procedure alice_actor(Channel(X, Y)?).
alice_actor(ch(In, [msg(user, alice, connect(bob))|Out?])) :-
    alice_wait_bob_response(In?, Out).

procedure alice_wait_bob_response(Stream(X)?, Stream(X)).
alice_wait_bob_response([msg(agent, user, connected(bob))|In], Out?) :-
    alice_connect_carol(In?, Out).
alice_wait_bob_response([], []).

procedure alice_connect_carol(Stream(X)?, Stream(X)).
alice_connect_carol(In, [msg(user, alice, connect(carol))|Out?]) :-
    alice_wait_carol_response(In?, Out).

procedure alice_wait_carol_response(Stream(X)?, Stream(X)).
alice_wait_carol_response([msg(agent, user, connected(carol))|In], Out?) :-
    alice_introduce(In?, Out).
alice_wait_carol_response([], []).

procedure alice_introduce(Stream(X)?, Stream(X)).
alice_introduce(In, [msg(user, alice, introduce(bob, carol))|Out?]) :-
    alice_drain(In?, Out).

procedure alice_drain(Stream(X)?, Stream(X)).
alice_drain([_|In], Out?) :- alice_drain(In?, Out).
alice_drain([], []).

%% Bob's script:
%% 1. Accept Alice's cold-call
%% 2. Wait for introduction to Carol, accept it
%% 3. Drain messages

procedure bob_actor(Channel(X, Y)?).
bob_actor(ch([msg(agent, user, befriend(From, Resp))|In],
             [msg(user, bob, decision(yes, From?, Resp?))|Out?])) :-
    ground(From?) |
    bob_wait_intro(In?, Out).

procedure bob_wait_intro(Stream(X)?, Stream(X)).
bob_wait_intro([msg(agent, user, connected(_))|In], Out?) :-
    bob_wait_intro(In?, Out).
bob_wait_intro([msg(agent, user, befriend_intro(_, Other, Ch))|In],
               [msg(user, bob, accept_intro(Other?, Ch?))|Out?]) :-
    ground(Other?) |
    bob_drain(In?, Out).
bob_wait_intro([], []).

procedure bob_drain(Stream(X)?, Stream(X)).
bob_drain([_|In], Out?) :- bob_drain(In?, Out).
bob_drain([], []).

%% Carol's script:
%% 1. Accept Alice's cold-call
%% 2. Wait for introduction to Bob, accept it
%% 3. Drain messages

procedure carol_actor(Channel(X, Y)?).
carol_actor(ch([msg(agent, user, befriend(From, Resp))|In],
               [msg(user, carol, decision(yes, From?, Resp?))|Out?])) :-
    ground(From?) |
    carol_wait_intro(In?, Out).

procedure carol_wait_intro(Stream(X)?, Stream(X)).
carol_wait_intro([msg(agent, user, connected(_))|In], Out?) :-
    carol_wait_intro(In?, Out).
carol_wait_intro([msg(agent, user, befriend_intro(_, Other, Ch))|In],
                 [msg(user, carol, accept_intro(Other?, Ch?))|Out?]) :-
    ground(Other?) |
    carol_drain(In?, Out).
carol_wait_intro([], []).

procedure carol_drain(Stream(X)?, Stream(X)).
carol_drain([_|In], Out?) :- carol_drain(In?, Out).
carol_drain([], []).

%% =============================================================================
%% THE PLAY
%% =============================================================================

procedure play_alice_bob_carol.
play_alice_bob_carol :-
    new_channel(AliceUserCh, UserAliceCh),
    new_channel(AliceNetCh, NetAliceCh),
    new_channel(BobUserCh, UserBobCh),
    new_channel(BobNetCh, NetBobCh),
    new_channel(CarolUserCh, UserCarolCh),
    new_channel(CarolNetCh, NetCarolCh),

    network3(NetAliceCh?, NetBobCh?, NetCarolCh?),
    agent_init(alice, AliceUserCh?, AliceNetCh?),
    agent_init(bob, BobUserCh?, BobNetCh?),
    agent_init(carol, CarolUserCh?, CarolNetCh?),
    alice_actor(UserAliceCh?),
    bob_actor(UserBobCh?),
    carol_actor(UserCarolCh?).

