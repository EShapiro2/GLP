%% play_typed_simple.glp - Minimal two-agent typed play
%% 
%% Demonstrates the social graph protocol with two agents (Alice and Bob)
%% connected through a simple message relay without full network routing.
%%
%% Scenario: Bob sends introduction, Alice accepts, channel established
%%
%% Date: 2026-01-24

%% =============================================================================
%% TYPE DEFINITIONS (from social_graph_protocol.glp)
%% =============================================================================

%% Channel: position 1 is input (consumed), position 2 is output (produced)
%% The explicit dual preserves internal structure regardless of production/consumption context
Channel ::= ch(Stream?, Stream).
Channel? ::= ch(Stream?, Stream)?.
FriendEntry ::= (_, Stream).
FriendList ::= [] ; [FriendEntry | FriendList].
Response ::= accept(Channel) ; no.

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

procedure new_channel(Channel, Channel).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% MERGE
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], [], []).

%% =============================================================================
%% TAG_STREAM
%% =============================================================================

procedure tag_stream(_?, Stream?, Stream).
tag_stream(_, [], []).
tag_stream(Tag, [X|Xs], [tagged(Tag?, X?)|Ys?]) :-
    ground(Tag?) |
    tag_stream(Tag?, Xs?, Ys).

%% =============================================================================
%% RESPONSE HANDLING
%% =============================================================================

procedure handle_response(Response?, _?, FriendList?, FriendList, Stream?, Stream).
handle_response(accept(ch(FIn, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

procedure bind_response(_?, _?, Response, FriendList?, FriendList, Stream?, Stream).
bind_response(yes, From, accept(TheirCh?), Fs, Fs1?, In, In1?) :-
    new_channel(OurCh, TheirCh),
    handle_response(accept(OurCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

%% =============================================================================
%% SOCIAL GRAPH (handles decision and response messages)
%% =============================================================================

procedure social_graph(_?, Stream?, FriendList?).

social_graph(Id, [decision(Dec, From, Resp?)|In], Fs) :-
    ground(Id?) |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

social_graph(Id, [response(From, Resp)|In], Fs) :-
    ground(Id?) |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

social_graph(_, [], _).

%% =============================================================================
%% TEST 1: Alice processes single decision (already verified in unit tests)
%% =============================================================================

procedure test_alice_decides.
test_alice_decides :-
    social_graph(alice, 
                 [decision(yes, bob, Resp?)],
                 [(user, _), (net, _)]),
    check_response(Resp?).

procedure check_response(Response?).
check_response(accept(Ch)) :- known(Ch?) | true.
check_response(no).

%% =============================================================================
%% TEST 2: Bob receives Alice's response (already verified in unit tests)
%% =============================================================================

procedure test_bob_receives.
test_bob_receives :-
    new_channel(AliceCh, BobCh),
    social_graph(bob,
                 [response(alice, accept(BobCh?))],
                 [(user, _), (net, _)]),
    check_channel(AliceCh?).

procedure check_channel(Channel?).
check_channel(ch(In, Out)) :- known(In?) | true.
check_channel(ch(In, Out)) :- known(Out?) | true.

%% =============================================================================
%% TEST 3: Full exchange - Alice decides, Bob receives response
%%
%% This uses a relay to connect Alice's output to Bob's input.
%% The relay reads Resp from Alice and forwards it to Bob.
%% =============================================================================

procedure test_full_exchange.
test_full_exchange :-
    %% Alice processes decision, creates channel, fills AliceResp
    social_graph(alice,
                 [decision(yes, bob, AliceResp?)],
                 [(user, AliceUser), (net, AliceNet)]),
    
    %% Relay forwards Alice's response to Bob
    relay(AliceResp?, BobResp),
    
    %% Bob receives the relayed response
    social_graph(bob,
                 [response(alice, BobResp?)],
                 [(user, BobUser), (net, BobNet)]),
    
    %% Observe final state
    observe_exchange(AliceResp?, BobResp?, AliceUser?, BobUser?).

%% Relay copies a response from reader to writer
procedure relay(Response?, Response).
relay(Resp, Resp?).

procedure observe_exchange(Response?, Response?, Stream?, Stream?).
observe_exchange(_, _, _, _).
