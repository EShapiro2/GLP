%% social_graph_protocol.glp - Integrated Social Graph Protocol
%% Source: GLP-2025 Paper, Social Graph Programs
%%
%% This file integrates all necessary components into a single self-contained
%% program that passes both SRSW checking and type checking.

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Channel type (uses predefined Stream from stdlib)
Channel ::= ch(Stream, Stream?).

%% Friend list
FriendEntry ::= (_, Stream).
FriendList ::= [] ; [FriendEntry | FriendList].

%% Response type for connection offers
%% Channel is produced inside accept (standard covariant flow: producer provides channel to consumer)
Response ::= accept(Channel) ; no.

%% =============================================================================
%% MERGE: Fair merge of two streams (from merge_simple.glp - PASSES)
%% =============================================================================

procedure merge(Stream?, Stream?, Stream).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], [], []).

%% =============================================================================
%% CHANNEL OPERATIONS (from channel.glp - PASSES)
%% =============================================================================

procedure send(_?, Channel?, Channel).
send(X, ch(In, [X?|Out?]), ch(In?, Out)).

procedure receive(_, Channel?, Channel).
receive(X?, ch([X|In], Out?), ch(In?, Out)).

procedure new_channel(Channel, Channel).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% TAG_STREAM: Tag each element with source identifier
%% Output is Stream to be compatible with merge
%% =============================================================================

procedure tag_stream(_?, Stream?, Stream).
tag_stream(_, [], []).
tag_stream(Tag, [X|Xs], [tagged(Tag?, X?)|Ys?]) :-
    ground(Tag?) |
    tag_stream(Tag?, Xs?, Ys).

%% =============================================================================
%% LOOKUP: Find value in association list
%% =============================================================================

procedure lookup(_?, FriendList?, _).
lookup(Key, [(K, Value)|_], found(Value?)) :- Key? =?= K? | true.
lookup(Key, [(_, _)|Rest], Result?) :- otherwise | lookup(Key?, Rest?, Result).
lookup(_, [], not_found).

%% =============================================================================
%% UPDATE: Replace value for key in association list  
%% =============================================================================

procedure update(_?, _?, FriendList?, FriendList).
update(Key, NewVal, [(K, _)|Fs], [(K?, NewVal?)|Fs?]) :- Key? =?= K? | true.
update(Key, NewVal, [(K, V)|Fs], [(K?, V?)|Fs1?]) :- otherwise | update(Key?, NewVal?, Fs?, Fs1).
update(_, _, [], []).

%% =============================================================================
%% RESPONSE HANDLING
%% =============================================================================

%% handle_response - process accepted or rejected connection
%% Response? is input (consumed from message) - Channel inside becomes Channel (produced to us)
procedure handle_response(Response?, _?, FriendList?, FriendList, Stream?, Stream).
handle_response(accept(ch(FIn, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    ground(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

%% =============================================================================
%% BIND_RESPONSE: Handle user's decision on received offer
%% Third argument Response is output (produced to fill hollow slot in message)
%% OurCh/TheirCh are separate channel ends from new_channel
%% =============================================================================

procedure bind_response(_?, _?, Response, FriendList?, FriendList, Stream?, Stream).
bind_response(yes, From, accept(TheirCh?), Fs, Fs1?, In, In1?) :-
    new_channel(OurCh, TheirCh),
    handle_response(accept(OurCh?), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

%% =============================================================================
%% AGENT INITIALIZATION
%% =============================================================================

procedure build_friends(Stream?, Stream?, FriendList).
build_friends(UserOut, NetOut, [(user, UserOut?), (net, NetOut?)]).

procedure agent(_?, Channel?, Channel?).
agent(Id, ch(UserIn, UserOut), ch(NetIn, NetOut)) :-
    merge(UserIn?, NetIn?, In),
    build_friends(UserOut?, NetOut?, Fs),
    social_graph(Id?, In?, Fs?).

%% =============================================================================
%% SOCIAL GRAPH MAIN LOOP (simplified - handles responses only)
%% =============================================================================

procedure social_graph(_?, Stream?, FriendList?).

%% Process user decision on received introduction
%% Resp? in head receives the hollow slot, Resp in body fills it
social_graph(Id, [decision(Dec, From, Resp?)|In], Fs) :-
    ground(Id?) |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Process response to sent introduction
social_graph(Id, [response(From, Resp)|In], Fs) :-
    ground(Id?) |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Base case: no more messages
social_graph(_, [], _).
