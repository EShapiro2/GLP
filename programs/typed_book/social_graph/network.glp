% Network Switch for 2 Agents (based on Program 12)

%% Type definitions
%% 2-arg network messages: msg(Target, Content)
%% Content is protocol-opaque — router forwards without inspection
NetMsg ::= msg(Constant, _).
AgentEntry ::= (Constant, Channel(Stream(NetMsg), Stream(NetMsg))?).

procedure network(AgentEntry?, AgentEntry?).
network((P, ChP), (Q, ChQ)) :-
    receive(Msg?, ChP?, ChP1),
    Msg = msg(Q, X) |
    send(X?, ChQ?, ChQ1),
    network((P?, ChP1?), (Q?, ChQ1?)).

network((P, ChP), (Q, ChQ)) :-
    receive(Msg?, ChQ?, ChQ1),
    Msg = msg(P, X) |
    send(X?, ChP?, ChP1),
    network((P?, ChP1?), (Q?, ChQ1?)).

%% External procedures (defined elsewhere)
procedure receive(_, Channel(X, Y)?, Channel(X, Y)).
procedure send(_?, Channel(X, Y)?, Channel(X, Y)).
