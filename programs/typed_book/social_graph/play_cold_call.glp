%% play_cold_call.glp - Symmetric cold-call simulation
%% 
%% Two agents (Alice and Bob) connected via network router.
%% Bob initiates a cold-call to Alice, Alice accepts.
%%
%% Date: 2026-01-24

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Friend channel types
FriendContent ::= response(Response) ; text(Constant).
FriendChannel ::= ch(Stream(FriendContent), Stream(FriendContent)?).

%% Response to connection request
Response ::= accept(FriendChannel) ; no.

%% Friend management
FriendEntry ::= (Constant, FriendChannel).
FriendList ::= [] ; [FriendEntry | FriendList].

%% User interface - symmetric for all agents
Keyboard ::= connect(Constant) ; send(Constant, Constant) ; friends ; accept(Constant) ; reject(Constant).
Screen ::= connected(Constant) ; rejected(Constant) ; sent(Constant) ; not_friend(Constant)
         ; friends_list(FriendList) ; incoming(Constant).

%% Network messages between agents
NetMsg ::= intro(Constant, Response?) ; response(Constant, Response).

%% Pending connection requests (waiting for user decision)
PendingEntry ::= pending(Constant, Response).
PendingList ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

procedure new_channel(Channel(X, Y), Channel(X, Y)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% MERGE (for combining user and network inputs)
%% =============================================================================

procedure merge(Stream(X)?, Stream(X)?, Stream(X)).
merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% =============================================================================
%% LIST UTILITIES
%% =============================================================================

procedure lookup(_?, FriendList?, _).
lookup(Key, [(Key1, Value)|_], found(Value?)) :- Key? =?= Key1? | true.
lookup(Key, [(Key1, _)|Rest], Result?) :- Key? =\= Key1? | lookup(Key?, Rest?, Result).
lookup(_, [], not_found).

procedure add_pending(_?, Response?, PendingList?, PendingList).
add_pending(Name, Resp, Ps, [pending(Name?, Resp?)|Ps?]).

procedure lookup_pending(_?, PendingList?, _).
lookup_pending(Name, [pending(Name1, Resp)|_], found(Resp?)) :- Name? =?= Name1? | true.
lookup_pending(Name, [pending(Name1, _)|Rest], Result?) :- Name? =\= Name1? | lookup_pending(Name?, Rest?, Result).
lookup_pending(_, [], not_found).

%% =============================================================================
%% SOCIAL AGENT
%% =============================================================================

%% Agent state: Id, UserChannel, NetChannel, Friends, Pending
procedure agent(_?, Channel(X, Y)?, Channel(X, Y)?).
agent(Id, UserCh, NetCh) :-
    ground(Id?) |
    agent_loop(Id?, UserCh?, NetCh?, [], []).

procedure agent_loop(_?, Channel(X, Y)?, Channel(X, Y)?, FriendList?, PendingList?).

%% --- User wants to connect to someone ---
agent_loop(Id, ch([connect(Target)|UserIn], UserOut?), NetCh, Fs, Ps) :-
    ground(Id?), ground(Target?) |
    %% Send intro to target via network, with hollow Resp
    send_intro(Id?, Target?, NetCh?, NetCh1, Resp),
    %% Wait for response and continue
    handle_connect_response(Id?, Target?, Resp?, UserIn?, UserOut, NetCh1?, Fs?, Ps?).

%% --- User accepts incoming connection ---
agent_loop(Id, ch([accept(From)|UserIn], UserOut?), NetCh, Fs, Ps) :-
    ground(Id?), ground(From?) |
    handle_accept(Id?, From?, UserIn?, UserOut, NetCh?, Fs?, Ps?).

%% --- User rejects incoming connection ---
agent_loop(Id, ch([reject(From)|UserIn], UserOut?), NetCh, Fs, Ps) :-
    ground(Id?), ground(From?) |
    handle_reject(Id?, From?, UserIn?, UserOut, NetCh?, Fs?, Ps?).

%% --- User queries friends list ---
agent_loop(Id, ch([friends|UserIn], [friends_list(Fs?)|UserOut?]), NetCh, Fs, Ps) :-
    ground(Id?) |
    agent_loop(Id?, ch(UserIn?, UserOut), NetCh?, Fs?, Ps?).

%% --- Received intro from network (incoming cold-call) ---
agent_loop(Id, ch(UserIn, [incoming(From?)|UserOut?]), ch([intro(From, Resp)|NetIn], NetOut?), Fs, Ps) :-
    ground(Id?), ground(From?) |
    add_pending(From?, Resp?, Ps?, Ps1),
    agent_loop(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut), Fs?, Ps1?).

%% --- Received response to our intro ---
agent_loop(Id, ch(UserIn, [connected(From?)|UserOut?]), ch([response(From, accept(TheirCh))|NetIn], NetOut?), Fs, Ps) :-
    ground(Id?), ground(From?) |
    %% Add to friends
    agent_loop(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut), [(From?, TheirCh?)|Fs?], Ps?).

agent_loop(Id, ch(UserIn, [rejected(From?)|UserOut?]), ch([response(From, no)|NetIn], NetOut?), Fs, Ps) :-
    ground(Id?) |
    agent_loop(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut), Fs?, Ps?).

%% --- Termination ---
agent_loop(_, ch([], []), ch([], []), _, _).

%% --- Helper: send intro ---
procedure send_intro(_?, _?, Channel(X, Y)?, Channel(X, Y), Response?).
send_intro(Id, Target, ch(NetIn, [intro(Id?, Resp?)|NetOut?]), ch(NetIn?, NetOut), Resp).

%% --- Helper: handle response to our connect ---
procedure handle_connect_response(_?, _?, Response?, Stream(X)?, Stream(X), Channel(X, Y)?, FriendList?, PendingList?).
handle_connect_response(Id, Target, accept(TheirCh), UserIn, [connected(Target?)|UserOut?], NetCh, Fs, Ps) :-
    ground(Id?), ground(Target?) |
    agent_loop(Id?, ch(UserIn?, UserOut), NetCh?, [(Target?, TheirCh?)|Fs?], Ps?).
handle_connect_response(Id, Target, no, UserIn, [rejected(Target?)|UserOut?], NetCh, Fs, Ps) :-
    ground(Id?) |
    agent_loop(Id?, ch(UserIn?, UserOut), NetCh?, Fs?, Ps?).

%% --- Helper: handle user accepting ---
procedure handle_accept(_?, _?, Stream(X)?, Stream(X), Channel(X, Y)?, FriendList?, PendingList?).
handle_accept(Id, From, UserIn, [connected(From?)|UserOut?], ch(NetIn, [response(Id?, accept(TheirCh?))|NetOut?]), Fs, Ps) :-
    ground(Id?), ground(From?) |
    lookup_pending(From?, Ps?, LookupResult),
    fill_accept_response(LookupResult?, From?, OurCh, TheirCh),
    agent_loop(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut), [(From?, OurCh?)|Fs?], Ps?).

procedure fill_accept_response(_, _?, Channel(X, Y), Channel(X, Y)).
fill_accept_response(found(Resp), From, OurCh, TheirCh) :-
    ground(From?) |
    new_channel(OurCh, TheirCh),
    Resp = accept(TheirCh?).

%% --- Helper: handle user rejecting ---
procedure handle_reject(_?, _?, Stream(X)?, Stream(X), Channel(X, Y)?, FriendList?, PendingList?).
handle_reject(Id, From, UserIn, [rejected(From?)|UserOut?], ch(NetIn, [response(Id?, no)|NetOut?]), Fs, Ps) :-
    ground(Id?), ground(From?) |
    lookup_pending(From?, Ps?, LookupResult),
    fill_reject_response(LookupResult?),
    agent_loop(Id?, ch(UserIn?, UserOut), ch(NetIn?, NetOut), Fs?, Ps?).

procedure fill_reject_response(_).
fill_reject_response(found(Resp)) :- Resp = no.
fill_reject_response(not_found).

%% =============================================================================
%% NETWORK ROUTER
%% Routes messages between alice and bob
%% =============================================================================

procedure router(Channel(X, Y)?, Channel(X, Y)?).

%% Alice sends to Bob (intro or response)
router(ch([intro(alice, X)|AliceIn], AliceOut?),
       ch(BobIn, [intro(alice, X?)|BobOut?])) :-
    router(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

router(ch([response(alice, X)|AliceIn], AliceOut?),
       ch(BobIn, [response(alice, X?)|BobOut?])) :-
    router(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

%% Bob sends to Alice (intro or response)
router(ch(AliceIn, [intro(bob, X?)|AliceOut?]),
       ch([intro(bob, X)|BobIn], BobOut?)) :-
    router(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

router(ch(AliceIn, [response(bob, X?)|AliceOut?]),
       ch([response(bob, X)|BobIn], BobOut?)) :-
    router(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

%% Termination
router(ch([], _), ch([], _)).

%% =============================================================================
%% ACTORS (simulate user behavior)
%% =============================================================================

%% Bob: initiates connect to alice, then done
procedure bob_actor(Channel(X, Y)?).
bob_actor(ch([connected(alice)|In], [connect(alice)|Out?])) :-
    bob_done(In?, Out).
bob_actor(ch([rejected(alice)|In], [connect(alice)|Out?])) :-
    bob_done(In?, Out).

procedure bob_done(Stream(X)?, Stream(X)).
bob_done([], []).
bob_done([_|Xs], Ys?) :- bob_done(Xs?, Ys).

%% Alice: receives incoming, accepts, then done
procedure alice_actor(Channel(X, Y)?).
alice_actor(ch([incoming(bob)|In], Out?)) :-
    alice_respond(In?, Out).

procedure alice_respond(Stream(X)?, Stream(X)).
alice_respond([connected(bob)|In], [accept(bob)|Out?]) :-
    alice_done(In?, Out).

procedure alice_done(Stream(X)?, Stream(X)).
alice_done([], []).
alice_done([_|Xs], Ys?) :- alice_done(Xs?, Ys).

%% =============================================================================
%% THE PLAY
%% =============================================================================

procedure play.
play :-
    %% Create channel pairs
    new_channel(AliceUserCh, UserAliceCh),
    new_channel(AliceNetCh, NetAliceCh),
    new_channel(BobUserCh, UserBobCh),
    new_channel(BobNetCh, NetBobCh),
    
    %% Start network router
    router(NetAliceCh?, NetBobCh?),
    
    %% Start agents
    agent(alice, AliceUserCh?, AliceNetCh?),
    agent(bob, BobUserCh?, BobNetCh?),
    
    %% Start actors (simulate users)
    alice_actor(UserAliceCh?),
    bob_actor(UserBobCh?).
