%% producer_consumer_countdown.glp - Countdown producer-consumer
%% Source: AofGLP Book Chapter 5
%%
%% Producer counts down from N to 0, consumer sums elements.

%% Type definitions
NumList ::= [] ; [Number | NumList].

%% Procedure type declarations
procedure producer(NumList, Number).
procedure consumer(NumList, Number, Number).

producer([], 0).
producer([N?|Xs?], N) :- N? > 0 | N1 := N? - 1, producer(Xs, N1?).

consumer([], Sum, Sum?).
consumer([X|Xs], Sum, Result?) :- ground(X?) |
    Sum1 := Sum? + X?,
    consumer(Xs?, Sum1?, Result).

%% Example: producer(Xs, 5), consumer(Xs?, 0, R).
%% Result: R = 15 (5+4+3+2+1+0)
