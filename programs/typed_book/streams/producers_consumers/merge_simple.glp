% Topic: Simple fair merge
% Section: Streams - Simple Fair Merge
%
% Test goals:
% merge([1,2], [a,b], Out).

%% Procedure type declarations
procedure merge(Stream?, Stream?, Stream).

merge([X|Xs], Ys, [X?|Zs?]) :- merge(Ys?, Xs?, Zs).
merge(Xs, [Y|Ys], [Y?|Zs?]) :- merge(Xs?, Ys?, Zs).
merge([], [], []).
