%% bounded_buffer_original.glp - Bounded buffer stream communication (original version)
%% Source: CP Collected Papers, Ch 18 (Takeuchi & Furukawa)
%%
%% NOTE: This is the original version with SRSW violations.
%% See bounded_buffer.glp for the corrected version.
%%
%% Bounded buffer communication limits sender when buffer is full.
%% The receiver controls buffer expansion by creating new slots.

%% Type definitions
DiffList ::= Stream -- Stream?.

%% Procedure type declarations
procedure send_unbounded(_?, Stream?, Stream).
procedure receive_unbounded(_, Stream?, Stream).
procedure send(_?, Stream?, Stream).
procedure receive(_, DiffList?, DiffList).
procedure close(Stream?).
procedure closed(_?).
procedure open(Number?, DiffList).
procedure sq_num_buffered(Number?, Stream?, Number?).
procedure integers(Number?, Number?, Stream?).
procedure square(DiffList?, Stream).

%% Unbounded buffer send/receive (standard stream communication)
send_unbounded(Msg, [Msg?|Tail], Tail?).
receive_unbounded(Msg?, [Msg|Tail], Tail?).

%% Bounded buffer send/receive
%% Buffer is represented as difference-list: Head--Tail
send(Msg, [Msg?|Buf], Buf?).
receive(Msg?, [Msg|Buf]--[_|Tail], Buf?--Tail?).

close([end_of_stream|_]).
closed(end_of_stream).

%% Open a buffer of given size
open(0, X--X?).
open(N, [_|Y?]--Z?) :- N? > 0 | N1 := N? - 1, open(N1?, Y--Z).

%% Example: Buffered stream of squares
%% NOTE: This example has SRSW violation (Buf appears twice as writer).
%% SRSW limitation: Single-reader/single-writer difference-list streams cannot
%% be shared between multiple processes. This violates the fundamental assumption
%% that each variable cell has exactly one writer and one reader.
%% See: CP Collected Papers Ch 18, Section 4.2 on difference-list limitations.
sq_num_buffered(N, Ss?, Size) :-
    open(Size?, Buf--Tail),
    integers(1, N?, Buf),
    square(Buf?--Tail?, Ss).

integers(I, N, [I?|Buf?]) :-
    I? =< N? |
    J := I? + 1,
    integers(J?, N?, Buf).
integers(I, N, Buf) :-
    I? > N? |
    close(Buf?).

square([I|Buf], [I2?|Ss?]) :-
    number(I?) |
    I2 := I? * I?,
    square(Buf?, Ss).
square([I|_], []) :- closed(I?) | true.
