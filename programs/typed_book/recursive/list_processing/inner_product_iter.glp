%% inner_product_iter.glp - Computing inner products iteratively (AoP 8.7b)
%% inner_product(Xs,Ys,Value) :- Value is the inner product of vectors Xs and Ys.

%% Type definitions
NumList ::= [] ; [Number | NumList].

%% Procedure type declarations
procedure inner_product(NumList?, NumList?, Number).
inner_product(Xs, Ys, IP?) :- inner_product(Xs?, Ys?, 0, IP).

procedure inner_product(NumList?, NumList?, Number?, Number).
inner_product([X|Xs], [Y|Ys], Temp, IP?) :-
    Temp1 := X? * Y? + Temp?, inner_product(Xs?, Ys?, Temp1?, IP).
inner_product([], [], IP, IP?).

%% reduce clauses for metainterpreter
procedure reduce(_?, _).
reduce(inner_product(Xs, Ys, IP?), inner_product(Xs?, Ys?, 0, IP)).
reduce(inner_product([X|Xs], [Y|Ys], Temp, IP?), (Temp1 := X? * Y? + Temp?, inner_product(Xs?, Ys?, Temp1?, IP))).
reduce(inner_product([], [], IP, IP?), true).
