%% reverse.glp - Stream reversal examples
%%
%% Two implementations demonstrating O(n^2) vs O(n) complexity.

%% Uses predefined Stream type

%% Naive reverse - O(n^2) due to repeated append
procedure reverse_naive(Stream(X)?, Stream(X)).
reverse_naive([], []).
reverse_naive([X|Xs], Ys?) :-
    reverse_naive(Xs?, Zs),
    append(Zs?, [X?], Ys).

procedure append(Stream(X)?, Stream(X)?, Stream(X)).
append([], Ys, Ys?).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).

%% Accumulator reverse - O(n) single pass
procedure reverse(Stream(X)?, Stream(X)).
reverse(Xs, Ys?) :- reverse_acc(Xs?, [], Ys).

procedure reverse_acc(Stream(X)?, Stream(X)?, Stream(X)).
reverse_acc([], Acc, Acc?).
reverse_acc([X|Xs], Acc, Ys?) :- reverse_acc(Xs?, [X?|Acc?], Ys).

%% Test goals:
%% reverse_naive([a,b,c], R).
%% reverse([a,b,c], R).
