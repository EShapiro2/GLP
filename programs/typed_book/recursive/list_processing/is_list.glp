%% is_list.glp - Defining a list (AoP 3.11)
%% list(Xs) :- Xs is a list.

%% Uses predefined Stream type

%% Procedure type declarations
procedure list(Stream(X)?).
list([]).
list([_|Xs]) :- list(Xs?).

%% reduce clauses for metainterpreter
procedure reduce(_?, _).
reduce(list([]), true).
reduce(list([_|Xs]), list(Xs?)).
