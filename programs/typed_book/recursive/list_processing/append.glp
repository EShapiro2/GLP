%% append.glp - Stream concatenation
%% Source: Standard GLP list operations

%% Uses predefined Stream type

%% Procedure type declaration
procedure append(Stream?, Stream?, Stream).
procedure reduce(_?, _).

append([], Ys, Ys?).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).

%% Metainterpreter support
reduce(append([], Ys, Ys?), true).
reduce(append([X|Xs], Ys, [X?|Zs?]), append(Xs?, Ys?, Zs)).
