%% map_inc.glp - Increment each element of a list
%% Source: AofGLP Book Solutions Appendix

%% Type definitions
NumList ::= [] ; [Number | NumList].

%% Procedure type declarations
procedure map_inc(NumList, NumList).
procedure reduce(Any, Any).

map_inc([], []).
map_inc([X|Xs], [Y?|Ys?]) :-
    Y := X? + 1,
    map_inc(Xs?, Ys).

%% Metainterpreter support
reduce(map_inc([], []), true).
reduce(map_inc([X|Xs], [Y?|Ys?]), (Y := X? + 1, map_inc(Xs?, Ys))).
