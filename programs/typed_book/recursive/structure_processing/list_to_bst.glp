%% list_to_bst.glp - Convert sorted list to balanced BST
%% Source: AofGLP Book Chapter 6

%% Type definitions
BST ::= empty ; node(_, BST, BST).
NonEmptyList(X) ::= [X | Stream(X)].

procedure list_to_bst(Stream(X)?, BST).
list_to_bst([], empty).
list_to_bst(Xs, node(Mid?, L?, R?)) :-
    ~(Xs? =?= []) |
    length(Xs?, Len),
    Half := Len? // 2,
    split_at(Xs?, Half?, Left, Mid, Right),
    list_to_bst(Left?, L),
    list_to_bst(Right?, R).

%% split_at(Stream, N, Left, Mid, Right) - split list at position N
procedure split_at(NonEmptyList(X)?, Number?, Stream(X), X, Stream(X)).
split_at([X|Xs], 0, [], X?, Xs?).
split_at([X|Xs], N, [X?|Left?], Mid?, Right?) :-
    N? > 0 |
    N1 := N? - 1,
    split_at(Xs?, N1?, Left, Mid, Right).

%% Helper: length with accumulator
procedure length(Stream(X)?, Number).
length(Xs, N?) :- length_acc(Xs?, 0, N).

procedure length_acc(Stream(X)?, Number?, Number).
length_acc([], Acc, Acc?).
length_acc([_|Xs], Acc, N?) :-
    Acc1 := Acc? + 1,
    length_acc(Xs?, Acc1?, N).
