%% list_to_bst.glp - Convert sorted list to balanced BST
%% Source: AofGLP Book Chapter 6

%% Type definitions
BST ::= empty ; node(_, BST, BST).

%% Procedure type declarations
procedure list_to_bst(List?, BST).
procedure split_at(List?, Number?, List, _, List).
procedure length(List?, Number).
procedure length_acc(List?, Number?, Number).

list_to_bst([], empty).
list_to_bst(Xs, node(Mid?, L?, R?)) :-
    ~(Xs? =?= []) |
    length(Xs?, Len),
    Half := Len? // 2,
    split_at(Xs?, Half?, Left, Mid, Right),
    list_to_bst(Left?, L),
    list_to_bst(Right?, R).

%% split_at(List, N, Left, Mid, Right) - split list at position N
split_at([X|Xs], 0, [], X?, Xs?).
split_at([X|Xs], N, [X?|Left?], Mid?, Right?) :-
    N? > 0 |
    N1 := N? - 1,
    split_at(Xs?, N1?, Left, Mid, Right).

%% Helper: length with accumulator
length(Xs, N?) :- length_acc(Xs?, 0, N).
length_acc([], Acc, Acc?).
length_acc([_|Xs], Acc, N?) :-
    Acc1 := Acc? + 1,
    length_acc(Xs?, Acc1?, N).
