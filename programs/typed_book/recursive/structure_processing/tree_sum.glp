%% tree_sum.glp - Sum all values in a numeric tree
%% Source: AofGLP Book Chapter 6

%% Type definitions
Tree ::= empty ; node(Number, Tree, Tree).

procedure tree_sum(Tree?, Number).
tree_sum(empty, 0).
tree_sum(node(V, L, R), S?) :-
    tree_sum(L?, SL),
    tree_sum(R?, SR),
    S := V? + SL? + SR?.

%% Metainterpreter support
procedure reduce(_?, _).
reduce(tree_sum(empty, 0), true).
reduce(tree_sum(node(V, L, R), S?),
    (tree_sum(L?, SL), tree_sum(R?, SR), S := V? + SL? + SR?)).
