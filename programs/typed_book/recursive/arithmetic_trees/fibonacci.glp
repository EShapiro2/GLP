%% fibonacci.glp - Fibonacci in GLP
%% Source: Standard GLP arithmetic

%% Procedure type declarations
procedure fib(Number?, Number).
procedure fib_linear(Number?, Number).
procedure fib_acc(Number?, Number?, Number?, Number).
procedure reduce(_?, _).

fib(0, 0).
fib(1, 1).
fib(N, F?) :-
    N? > 1 |
    N1 := N? - 1,
    N2 := N? - 2,
    fib(N1?, F1),
    fib(N2?, F2),
    F := F1? + F2?.

%% Metainterpreter support for exponential version
reduce(fib(0, 0), true).
reduce(fib(1, 1), true).
reduce(fib(N, F?), (N1 := N? - 1, N2 := N? - 2, fib(N1?, F1), fib(N2?, F2), F := F1? + F2?)) :- N? > 1 | true.
reduce((X? := T), true) :- X := T? | true.

%% Linear Fibonacci with accumulator
fib_linear(N, F?) :- fib_acc(N?, 0, 1, F).

fib_acc(0, A, _, A?).
fib_acc(N, A, B, F?) :-
    N? > 0, number(B?) |
    N1 := N? - 1,
    AB := A? + B?,
    fib_acc(N1?, B?, AB?, F).

%% Metainterpreter support for linear version
reduce(fib_linear(N, F?), fib_acc(N?, 0, 1, F)).
reduce(fib_acc(0, A, _, A?), true).
reduce(fib_acc(N, A, B, F?), (N1 := N? - 1, AB := A? + B?, fib_acc(N1?, B?, AB?, F))) :- N? > 0, number(B?) | true.
