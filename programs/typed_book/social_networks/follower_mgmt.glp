%% follower_mgmt.glp - Follower management
%% Add and remove followers

%% Type definitions
FollowerList ::= [] ; [_ | FollowerList].

procedure add_follower(_, FollowerList, FollowerList, _).
add_follower(Name, Followers, [(Name?, Stream)|Followers?], Stream?).

procedure remove_follower(_, FollowerList, FollowerList).
remove_follower(Name, [(First, _)|Fs], Fs?) :- Name? =?= First? | true.
remove_follower(Name, [(Other, Stream)|Fs], [(Other?, Stream?)|Fs1?]) :-
    ~(Name? =?= Other?) |
    remove_follower(Name?, Fs?, Fs1).
