%% broadcast.glp - Broadcast to multiple recipients
%% Sends a message to all followers

%% Type definitions
FollowerEntry ::= (_, Stream).
FollowerList ::= [] ; [FollowerEntry | FollowerList].

%% Procedure type declarations
procedure broadcast(_?, FollowerList?, FollowerList).

broadcast(_, [], []).
broadcast(Post, [(Name, Out)|Fs], [(Name?, [Post?|Out?])|Fs1?]) :-
    ground(Post?) |
    broadcast(Post?, Fs?, Fs1).
