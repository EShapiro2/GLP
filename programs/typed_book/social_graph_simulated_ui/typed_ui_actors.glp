bob3_wait_charlie_connected([], []).

procedure bob3_wait_charlie_msg(Stream?, Stream).
bob3_wait_charlie_msg([received(charlie, _)|_],
                      [introduce(alice, charlie)]).
bob3_wait_charlie_msg([_|In], Out?) :-
