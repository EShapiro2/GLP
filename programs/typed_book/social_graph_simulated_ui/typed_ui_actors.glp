bob3_wait_charlie_msg([], []).

%% --- Charlie (play3) ---
%% 1. Wait befriend(bob, ReqId) → decision(yes, bob, ReqId) + send(bob, hello)
%% 2. Wait befriend_intro(bob, alice, ReqId2) → reject_intro(alice, ReqId2)
