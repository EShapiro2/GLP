%% circuits.glp - Compound circuits from simple gates
%% Source: AofGLP Book Chapter 4
%%
%% Demonstrates composition of gates and SRSW compliance.

%% Type definitions
BitList ::= [] ; [Number | BitList].

%% Import simple gates (or include inline)
procedure and(Number?, Number?, Number).
and(1, 1, 1).
and(1, 0, 0).
and(0, 1, 0).
and(0, 0, 0).

procedure or(Number?, Number?, Number).
or(1, 1, 1).
or(1, 0, 1).
or(0, 1, 1).
or(0, 0, 0).

procedure not(Number?, Number).
not(1, 0).
not(0, 1).

procedure xor(Number?, Number?, Number).
xor(1, 1, 0).
xor(1, 0, 1).
xor(0, 1, 1).
xor(0, 0, 0).

%% NAND gate - composition
procedure nand(Number?, Number?, Number).
nand(A, B, Z?) :- and(A?, B?, W), not(W?, Z).

%% Half adder - requires ground guards for multiple reader occurrences
procedure half_adder(Number?, Number?, Number, Number).
half_adder(A, B, Sum?, Carry?) :-
    ground(A?), ground(B?) |
    xor(A?, B?, Sum), and(A?, B?, Carry).

%% Full adder - no guards needed (each reader occurs once)
procedure full_adder(Number?, Number?, Number?, Number, Number).
full_adder(A, B, Cin, Sum?, Cout?) :-
    half_adder(A?, B?, S1, C1),
    half_adder(S1?, Cin?, Sum, C2),
    or(C1?, C2?, Cout).

%% N-bit ripple-carry adder
procedure adder(BitList?, BitList?, Number?, BitList).
adder([], [], Cin, [Cin?]).
adder([A|As], [B|Bs], Cin, [S?|Ss?]) :-
    full_adder(A?, B?, Cin?, S, Cout),
    adder(As?, Bs?, Cout?, Ss).
