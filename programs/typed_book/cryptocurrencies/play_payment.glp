%% play_payment.glp - Three-agent payment scenario
%% Alice and Bob establish credit, then Alice pays Carol in Bob-coins

%% Type definitions
BalanceList ::= [] ; [_ | BalanceList].
RequestList ::= [] ; [_ | RequestList].
BlockStream ::= [] ; [_ | BlockStream].

%% Procedure type declarations
procedure agent(RequestList?, BalanceList?, BlockStream).
procedure find_payment_to(_?, BlockStream?, _).
procedure find_approval(BlockStream?, _).
procedure play_payment.
procedure verify_payment(BlockStream?, BlockStream?, BlockStream?).
procedure report_payment(BlockStream?, BlockStream?, BlockStream?).
procedure check_stream_length(BlockStream?, Number).

%% ============================================
%% The Play
%% ============================================

%% Scenario:
%% 1. Alice and Bob exchange 100 personal coins (mutual credit)
%% 2. Alice pays Carol 20 Bob-coins
%% 3. Bob approves Alice's payment
%% 4. Carol accepts the payment

play_payment :-
    %% Alice: credit with Bob, then pay Carol
    agent([issue(bob, 100, alice),
           accept(100, bob, BobToAlice?, none),
           issue(carol, 20, bob)],
          [], AliceStream),
    
    %% Bob: credit with Alice, then approve Alice's payment to Carol
    agent([issue(alice, 100, bob),
           accept(100, alice, AliceToBob?, none),
           approve(AliceToCarol?)],
          [], BobStream),
    
    %% Carol: accept payment from Alice
    agent([accept(20, bob, AliceToCarol?, BobApproval?)],
          [], CarolStream),
    
    %% Wire up cross-references
    find_payment_to(bob, AliceStream?, AliceToBob),
    find_payment_to(alice, BobStream?, BobToAlice),
    find_payment_to(carol, AliceStream?, AliceToCarol),
    find_approval(BobStream?, BobApproval),
    
    %% Verify
    verify_payment(AliceStream?, BobStream?, CarolStream?).

verify_payment(AliceStream, BobStream, CarolStream) :-
    ground(AliceStream?), ground(BobStream?), ground(CarolStream?) |
    report_payment(AliceStream?, BobStream?, CarolStream?).

report_payment(AliceStream, BobStream, CarolStream) :-
    %% Alice: 3 blocks (issue to Bob, accept from Bob, issue to Carol)
    %% Bob: 3 blocks (issue to Alice, accept from Alice, approve)
    %% Carol: 1 block (accept from Alice)
    check_stream_length(AliceStream?, 3),
    check_stream_length(BobStream?, 3),
    check_stream_length(CarolStream?, 1).

check_stream_length([_], 1).
check_stream_length([_,_], 2).
check_stream_length([_,_,_], 3).
