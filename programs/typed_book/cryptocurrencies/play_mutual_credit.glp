%% play_mutual_credit.glp - Mutual credit establishment
%% Two agents exchange personal coins to establish a credit line

%% Type definitions
BalanceEntry ::= (Constant, Number).
BalanceList ::= [] ; [BalanceEntry | BalanceList].
Block ::= block(X, Y, BlockStream).
BlockStream ::= [] ; [Block | BlockStream].
Request ::= issue(Constant, Number, Constant) ; accept(Number, Constant, X, Y).
RequestList ::= [] ; [Request | RequestList].

%% ============================================
%% The Play
%% ============================================

%% Alice and Bob each issue 100 coins to the other
%% Each pays in their own currency (self-approved)
%% Each accepts the other's payment

procedure agent(RequestList?, BalanceList?, BlockStream).

procedure find_payment_to(Constant?, BlockStream?, Block).

procedure play_mutual_credit.
play_mutual_credit :-
    %% Alice: issue to Bob, accept from Bob
    agent([issue(bob, 100, alice),
           accept(100, bob, BobPayment?, none)],
          [], AliceStream),

    %% Bob: issue to Alice, accept from Alice
    agent([issue(alice, 100, bob),
           accept(100, alice, AlicePayment?, none)],
          [], BobStream),

    %% Wire up cross-references
    find_payment_to(bob, AliceStream?, AlicePayment),
    find_payment_to(alice, BobStream?, BobPayment),

    %% Verify
    verify_mutual_credit(AliceStream?, BobStream?).

procedure verify_mutual_credit(BlockStream?, BlockStream?).
verify_mutual_credit(AliceStream, BobStream) :-
    ground(AliceStream?), ground(BobStream?) |
    report_mutual_credit(AliceStream?, BobStream?).

procedure report_mutual_credit(BlockStream?, BlockStream?).
report_mutual_credit(AliceStream, BobStream) :-
    %% Alice issued 100 Alice-coins, accepted 100 Bob-coins
    %% Bob issued 100 Bob-coins, accepted 100 Alice-coins
    check_stream_length(AliceStream?, 2),
    check_stream_length(BobStream?, 2).

procedure check_stream_length(BlockStream?, Number).
check_stream_length([_,_], 2).
check_stream_length([_,_,_], 3).
