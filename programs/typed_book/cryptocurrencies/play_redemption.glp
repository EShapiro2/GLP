%% play_redemption.glp - Coin redemption scenario
%% Bob redeems Alice-coins with preference list

%% Type definitions
BalanceEntry ::= (Constant, Number).
BalanceList ::= [] ; [BalanceEntry | BalanceList].
PrefList ::= [] ; [Constant | PrefList].
Block ::= block(X, Y, BlockStream).
BlockStream ::= [] ; [Block | BlockStream].
Request ::= redeem(Constant, Number, PrefList)
          ; repay(Constant, Number, PrefList, Constant).
RequestList ::= [] ; [Request | RequestList].

%% ============================================
%% The Play
%% ============================================

%% Scenario:
%% - Bob holds 50 Alice-coins
%% - Bob redeems with preference [carol, dave]
%% - Alice has: 20 Carol-coins, 15 Dave-coins
%% - Alice repays: 20 Carol + 15 Dave + 15 Alice = 50

procedure agent(RequestList?, BalanceList?, BlockStream).

procedure play_redemption.
play_redemption :-
    %% Bob: redeem 50 Alice-coins
    agent([redeem(alice, 50, [carol, dave])],
          [(alice, 50)], BobStream),

    %% Alice: repay according to preference list
    %% She has 20 Carol-coins, 15 Dave-coins
    agent([repay(bob, 50, [carol, dave], claim_hash)],
          [(carol, 20), (dave, 15)], AliceStream),

    %% Verify
    verify_redemption(AliceStream?, BobStream?).

procedure verify_redemption(BlockStream?, BlockStream?).
verify_redemption(AliceStream, BobStream) :-
    ground(AliceStream?), ground(BobStream?) |
    report_redemption(AliceStream?, BobStream?).

procedure report_redemption(BlockStream?, BlockStream?).
report_redemption(AliceStream, BobStream) :-
    %% Bob: 1 block (redemption claim)
    %% Alice: 3 blocks (20 Carol, 15 Dave, 15 Alice)
    check_stream_length(BobStream?, 1),
    check_stream_length(AliceStream?, 3).

procedure check_stream_length(BlockStream?, Number).
check_stream_length([_], 1).
check_stream_length([_,_], 2).
check_stream_length([_,_,_], 3).
