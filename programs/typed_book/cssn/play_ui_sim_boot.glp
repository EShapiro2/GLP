%% play_ui_sim_boot.glp - Simulated UI boot with tee + sink display
%%
%% Full stack: network3 ↔ agent/4 ↔ ui_mediator ↔ tee ↔ actor
%%                                                 ↓
%%                                           sink (display)
%%
%% Each actor's output is tee'd to both the mediator and a display stream.
%% Each mediator's output is tee'd to both the actor and a display stream.
%% In pure GLP mode, the display streams are consumed by sink (discarded).
%% In Flutter mode, they connect to send_to_user_tagged for per-agent windows.
%%
%% network3 and play are untyped (no procedure declarations)
%% since they call cross-file agent/4 and ui_mediator/5.
%%
%% Usage:
%%   load typed_social_agent.glp
%%   load typed_ui_mediator.glp
%%   load typed_ui_actors.glp
%%   load play_ui_sim_boot.glp
%%   play1.
%%
%% Date: 2026-02-20

-mode(system).

%% =============================================================================
%% TEE — Stream splitter
%% =============================================================================

procedure tee(Stream?, Stream, Stream).
tee([X|Xs], [X?|Ys?], [X?|Zs?]) :- ground(X?) | tee(Xs?, Ys, Zs).
tee([], [], []).

%% =============================================================================
%% SINK — Dummy consumer (discards stream)
%% =============================================================================

procedure sink(Stream?).
sink([_|Xs]) :- sink(Xs?).
sink([]).

%% =============================================================================
%% SEND_TO_USER_TAGGED — Merge display streams, tag with agent ID
%% =============================================================================
%%
%% Merges two display streams (commands and notifications) and sends
%% each ground term to _output/1 wrapped as tagged(Id, cmd(T)) or
%% tagged(Id, notify(T)).  Dart parses the string to route to the
%% appropriate per-agent panel.

%% Untyped: _output/1 is a kernel predicate with no procedure declaration.
send_to_user_tagged(Id, [T|Cmds], Notifies) :-
    ground(Id?), ground(T?) |
    '_output'(tagged(Id?, cmd(T?))),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(Id, Cmds, [T|Notifies]) :-
    ground(Id?), ground(T?) |
    '_output'(tagged(Id?, notify(T?))),
    send_to_user_tagged(Id?, Cmds?, Notifies?).
send_to_user_tagged(_, [], []).
send_to_user_tagged(_, Cmds, []) :- sink(Cmds?).

%% =============================================================================
%% NETWORK SWITCH (3-way)
%% =============================================================================

%% --- Cold-call routing (2-arg msg) ---

network3(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?]),
         ch([msg(bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% --- Friend-to-friend routing (3-arg msg) ---

network3(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?]),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch([msg(alice, charlie, X)|AliceIn], AliceOut?),
         ch(BobIn, BobOut?),
         ch(CharlieIn, [msg(alice, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?),
         ch(CharlieIn, CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch([msg(bob, charlie, X)|BobIn], BobOut?),
         ch(CharlieIn, [msg(bob, charlie, X?)|CharlieOut?])) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, [msg(charlie, alice, X?)|AliceOut?]),
         ch(BobIn, BobOut?),
         ch([msg(charlie, alice, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

network3(ch(AliceIn, AliceOut?),
         ch(BobIn, [msg(charlie, bob, X?)|BobOut?]),
         ch([msg(charlie, bob, X)|CharlieIn], CharlieOut?)) :-
    network3(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut), ch(CharlieIn?, CharlieOut)).

%% Termination
network3(ch([], []), ch([], []), ch([], [])).

%% =============================================================================
%% PLAY1 — Both accept introduction (with tee + sink display)
%% =============================================================================

play1 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    alice1(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob
    bob1(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    %% Charlie
    charlie1(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    sink(CharlieDispCmd?), sink(CharlieDispNotify?).

%% =============================================================================
%% PLAY2 — Alice accepts, Charlie rejects (with tee + sink display)
%% =============================================================================

play2 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    alice2(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob
    bob2(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    %% Charlie
    charlie2(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    sink(CharlieDispCmd?), sink(CharlieDispNotify?).

%% =============================================================================
%% PLAY3 — Both reject introduction (with tee + sink display)
%% =============================================================================

play3 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    alice3(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob
    bob3(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    %% Charlie
    charlie3(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    sink(CharlieDispCmd?), sink(CharlieDispNotify?).

%% =============================================================================
%% FLUTTER PLAYS — Same scenarios with tagged output for per-agent windows
%% =============================================================================
%% These use send_to_user_tagged instead of sink, so display streams
%% reach Dart via _output/1 as tagged(Id, cmd/notify(...)).

fplay1 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    alice1(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob
    bob1(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie
    charlie1(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?).

fplay2 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    alice2(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob
    bob2(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie
    charlie2(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?).

fplay3 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice
    alice3(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob
    bob3(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetIn?,
          [output('_user', BobAgentToUser), output('_net', BobNetOut)]),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie
    charlie3(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetIn?,
          [output('_user', CharlieAgentToUser), output('_net', CharlieNetOut)]),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?).

%% =============================================================================
%% NETWORK SWITCH (2-way, for CSSG plays: only parents on network)
%% =============================================================================

%% --- Cold-call routing (2-arg msg) ---

network2(ch([msg(bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(alice, X?)|AliceOut?]),
         ch([msg(alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

%% --- Friend-to-friend routing (3-arg msg) ---

network2(ch([msg(alice, bob, X)|AliceIn], AliceOut?),
         ch(BobIn, [msg(alice, bob, X?)|BobOut?])) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

network2(ch(AliceIn, [msg(bob, alice, X?)|AliceOut?]),
         ch([msg(bob, alice, X)|BobIn], BobOut?)) :-
    network2(ch(AliceIn?, AliceOut), ch(BobIn?, BobOut)).

%% Termination
network2(ch([], []), ch([], [])).

%% =============================================================================
%% PLAY4 — CSSG: All four accept (with tee + sink display)
%% =============================================================================

play4 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    %% Alice (parent): network + child channel
    alice4(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetAndChildIn?,
          [output('_user', AliceAgentToUser),
           output('_net', AliceNetOut),
           output(child(carol), AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob (parent): network + child channel
    bob4(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    %% Carol (child): parent channel only
    carol4(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolMedIn, CarolDispCmd),
    agent(carol, CarolAgentIn?, CarolFromAlice?,
          [output('_user', CarolAgentToUser),
           output(child(alice), CarolToAlice)]),
    ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    tee(CarolMedOut?, CarolActorIn, CarolDispNotify),
    sink(CarolDispCmd?), sink(CarolDispNotify?),

    %% Dave (child): parent channel only
    dave4(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    sink(DaveDispCmd?), sink(DaveDispNotify?),

    %% Wire parent-child channels
    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave).

%% =============================================================================
%% PLAY5 — CSSG: Bob rejects (with tee + sink display)
%% =============================================================================

play5 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    alice5(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetAndChildIn?,
          [output('_user', AliceAgentToUser),
           output('_net', AliceNetOut),
           output(child(carol), AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    bob5(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    carol5(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolMedIn, CarolDispCmd),
    agent(carol, CarolAgentIn?, CarolFromAlice?,
          [output('_user', CarolAgentToUser),
           output(child(alice), CarolToAlice)]),
    ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    tee(CarolMedOut?, CarolActorIn, CarolDispNotify),
    sink(CarolDispCmd?), sink(CarolDispNotify?),

    dave5(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    sink(DaveDispCmd?), sink(DaveDispNotify?),

    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave).

%% =============================================================================
%% PLAY6 — CSSG: Carol rejects (with tee + sink display)
%% =============================================================================

play6 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    alice6(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetAndChildIn?,
          [output('_user', AliceAgentToUser),
           output('_net', AliceNetOut),
           output(child(carol), AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    bob6(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    carol6(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolMedIn, CarolDispCmd),
    agent(carol, CarolAgentIn?, CarolFromAlice?,
          [output('_user', CarolAgentToUser),
           output(child(alice), CarolToAlice)]),
    ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    tee(CarolMedOut?, CarolActorIn, CarolDispNotify),
    sink(CarolDispCmd?), sink(CarolDispNotify?),

    dave6(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    sink(DaveDispCmd?), sink(DaveDispNotify?),

    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave).

%% =============================================================================
%% PLAY7 — CSSG: Dave rejects (with tee + sink display)
%% =============================================================================

play7 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    alice7(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetAndChildIn?,
          [output('_user', AliceAgentToUser),
           output('_net', AliceNetOut),
           output(child(carol), AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    bob7(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    carol7(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolMedIn, CarolDispCmd),
    agent(carol, CarolAgentIn?, CarolFromAlice?,
          [output('_user', CarolAgentToUser),
           output(child(alice), CarolToAlice)]),
    ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    tee(CarolMedOut?, CarolActorIn, CarolDispNotify),
    sink(CarolDispCmd?), sink(CarolDispNotify?),

    dave7(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    sink(DaveDispCmd?), sink(DaveDispNotify?),

    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave).

