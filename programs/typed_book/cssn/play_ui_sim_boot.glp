%% =============================================================================
%% PLAY11 — CSSN: Child-Safe Social Groups (6 agents, with tee + sink display)
%% =============================================================================
%%
%% 3 parents (Alice, Bob, Charlie) + 3 children (Carol, Dave, Eve).
%% Parents connect and introduce children to each other.
%% Carol creates a clique group, invites Dave and Eve directly.
%% All 3 children chat in the group.

play11 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice (parent of Carol): network + child channel
    alice11(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetAndChildIn?,
          [output('_user', AliceAgentToUser),
           output('_net', AliceNetOut),
           output(child(carol), AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    sink(AliceDispCmd?), sink(AliceDispNotify?),

    %% Bob (parent of Dave): network + child channel
    bob11(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    sink(BobDispCmd?), sink(BobDispNotify?),

    %% Charlie (parent of Eve): network + child channel
    charlie11(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetAndChildIn?,
          [output('_user', CharlieAgentToUser),
           output('_net', CharlieNetOut),
           output(child(eve), CharlieToEve)]),
    merge(CharlieNetIn?, CharlieFromEve?, CharlieNetAndChildIn),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    sink(CharlieDispCmd?), sink(CharlieDispNotify?),

    %% Carol (child of Alice): parent channel only
    carol11(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolMedIn, CarolDispCmd),
    agent(carol, CarolAgentIn?, CarolFromAlice?,
          [output('_user', CarolAgentToUser),
           output(child(alice), CarolToAlice)]),
    ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    tee(CarolMedOut?, CarolActorIn, CarolDispNotify),
    sink(CarolDispCmd?), sink(CarolDispNotify?),

    %% Dave (child of Bob): parent channel only
    dave11(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    sink(DaveDispCmd?), sink(DaveDispNotify?),

    %% Eve (child of Charlie): parent channel only
    eve11(ch(EveActorIn?, EveActorOut)),
    tee(EveActorOut?, EveMedIn, EveDispCmd),
    agent(eve, EveAgentIn?, EveFromCharlie?,
          [output('_user', EveAgentToUser),
           output(child(charlie), EveToCharlie)]),
    ui_mediator(eve, ch(EveAgentToUser?, EveAgentIn),
                ch(EveMedIn?, EveMedOut), [], 1),
    tee(EveMedOut?, EveActorIn, EveDispNotify),
    sink(EveDispCmd?), sink(EveDispNotify?),

    %% Wire parent-child channels
    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave),
    merge(CharlieToEve?, [], EveFromCharlie),
    merge(EveToCharlie?, [], CharlieFromEve).

fplay10 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    %% Alice (group creator): network only, no children
    alice10(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob (parent): network + child channel
    bob10(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Dave (child): parent channel only, idle
    dave10(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    %% Wire parent-child channels
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave).

%% =============================================================================
%% FLUTTER PLAY11 — Child-Safe Social Groups (6 agents, tagged output)
%% =============================================================================

fplay11 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice (parent of Carol): network + child channel
    alice11(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetAndChildIn?,
          [output('_user', AliceAgentToUser),
           output('_net', AliceNetOut),
           output(child(carol), AliceToCarol)]),
    merge(AliceNetIn?, AliceFromCarol?, AliceNetAndChildIn),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob (parent of Dave): network + child channel
    bob11(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie (parent of Eve): network + child channel
    charlie11(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetAndChildIn?,
          [output('_user', CharlieAgentToUser),
           output('_net', CharlieNetOut),
           output(child(eve), CharlieToEve)]),
    merge(CharlieNetIn?, CharlieFromEve?, CharlieNetAndChildIn),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?),

    %% Carol (child of Alice): parent channel only
    carol11(ch(CarolActorIn?, CarolActorOut)),
    tee(CarolActorOut?, CarolMedIn, CarolDispCmd),
    agent(carol, CarolAgentIn?, CarolFromAlice?,
          [output('_user', CarolAgentToUser),
           output(child(alice), CarolToAlice)]),
    ui_mediator(carol, ch(CarolAgentToUser?, CarolAgentIn),
                ch(CarolMedIn?, CarolMedOut), [], 1),
    tee(CarolMedOut?, CarolActorIn, CarolDispNotify),
    send_to_user_tagged(carol, CarolDispCmd?, CarolDispNotify?),

    %% Dave (child of Bob): parent channel only
    dave11(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    %% Eve (child of Charlie): parent channel only
    eve11(ch(EveActorIn?, EveActorOut)),
    tee(EveActorOut?, EveMedIn, EveDispCmd),
    agent(eve, EveAgentIn?, EveFromCharlie?,
          [output('_user', EveAgentToUser),
           output(child(charlie), EveToCharlie)]),
    ui_mediator(eve, ch(EveAgentToUser?, EveAgentIn),
                ch(EveMedIn?, EveMedOut), [], 1),
    tee(EveMedOut?, EveActorIn, EveDispNotify),
    send_to_user_tagged(eve, EveDispCmd?, EveDispNotify?),

    %% Wire parent-child channels
    merge(AliceToCarol?, [], CarolFromAlice),
    merge(CarolToAlice?, [], AliceFromCarol),
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave),
    merge(CharlieToEve?, [], EveFromCharlie),
    merge(EveToCharlie?, [], CharlieFromEve).

%% =============================================================================
%% FLUTTER PLAY12 — Parental Consent for Groups (5 agents, tagged output)
%% =============================================================================
%%
%% Alice (adult) creates a "study" star group.
%% Invites Bob and Charlie (adults) directly.
%% Invites Dave via Bob and Eve via Charlie — both require parental consent.
%% After all 5 join, Bob sends a message; Alice replies.

fplay12 :-
    network3(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn),
             ch(CharlieNetOut?, CharlieNetIn)),

    %% Alice (group creator): network only, no children
    alice12(ch(AliceActorIn?, AliceActorOut)),
    tee(AliceActorOut?, AliceMedIn, AliceDispCmd),
    agent(alice, AliceAgentIn?, AliceNetIn?,
          [output('_user', AliceAgentToUser), output('_net', AliceNetOut)]),
    ui_mediator(alice, ch(AliceAgentToUser?, AliceAgentIn),
                ch(AliceMedIn?, AliceMedOut), [], 1),
    tee(AliceMedOut?, AliceActorIn, AliceDispNotify),
    send_to_user_tagged(alice, AliceDispCmd?, AliceDispNotify?),

    %% Bob (parent of Dave): network + child channel
    bob12(ch(BobActorIn?, BobActorOut)),
    tee(BobActorOut?, BobMedIn, BobDispCmd),
    agent(bob, BobAgentIn?, BobNetAndChildIn?,
          [output('_user', BobAgentToUser),
           output('_net', BobNetOut),
           output(child(dave), BobToDave)]),
    merge(BobNetIn?, BobFromDave?, BobNetAndChildIn),
    ui_mediator(bob, ch(BobAgentToUser?, BobAgentIn),
                ch(BobMedIn?, BobMedOut), [], 1),
    tee(BobMedOut?, BobActorIn, BobDispNotify),
    send_to_user_tagged(bob, BobDispCmd?, BobDispNotify?),

    %% Charlie (parent of Eve): network + child channel
    charlie12(ch(CharlieActorIn?, CharlieActorOut)),
    tee(CharlieActorOut?, CharlieMedIn, CharlieDispCmd),
    agent(charlie, CharlieAgentIn?, CharlieNetAndChildIn?,
          [output('_user', CharlieAgentToUser),
           output('_net', CharlieNetOut),
           output(child(eve), CharlieToEve)]),
    merge(CharlieNetIn?, CharlieFromEve?, CharlieNetAndChildIn),
    ui_mediator(charlie, ch(CharlieAgentToUser?, CharlieAgentIn),
                ch(CharlieMedIn?, CharlieMedOut), [], 1),
    tee(CharlieMedOut?, CharlieActorIn, CharlieDispNotify),
    send_to_user_tagged(charlie, CharlieDispCmd?, CharlieDispNotify?),

    %% Dave (child of Bob): parent channel only
    dave12(ch(DaveActorIn?, DaveActorOut)),
    tee(DaveActorOut?, DaveMedIn, DaveDispCmd),
    agent(dave, DaveAgentIn?, DaveFromBob?,
          [output('_user', DaveAgentToUser),
           output(child(bob), DaveToBob)]),
    ui_mediator(dave, ch(DaveAgentToUser?, DaveAgentIn),
                ch(DaveMedIn?, DaveMedOut), [], 1),
    tee(DaveMedOut?, DaveActorIn, DaveDispNotify),
    send_to_user_tagged(dave, DaveDispCmd?, DaveDispNotify?),

    %% Eve (child of Charlie): parent channel only
    eve12(ch(EveActorIn?, EveActorOut)),
    tee(EveActorOut?, EveMedIn, EveDispCmd),
    agent(eve, EveAgentIn?, EveFromCharlie?,
          [output('_user', EveAgentToUser),
           output(child(charlie), EveToCharlie)]),
    ui_mediator(eve, ch(EveAgentToUser?, EveAgentIn),
                ch(EveMedIn?, EveMedOut), [], 1),
    tee(EveMedOut?, EveActorIn, EveDispNotify),
    send_to_user_tagged(eve, EveDispCmd?, EveDispNotify?),

    %% Wire parent-child channels
    merge(BobToDave?, [], DaveFromBob),
    merge(DaveToBob?, [], BobFromDave),
    merge(CharlieToEve?, [], EveFromCharlie),
    merge(EveToCharlie?, [], CharlieFromEve).
