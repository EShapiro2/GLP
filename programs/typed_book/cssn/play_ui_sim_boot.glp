%% =============================================================================
%% PLAY8 — CSSN: Group join (Alice creates group, invites Bob, Bob accepts)
%% =============================================================================

play8 :-
    network2(ch(AliceNetOut?, AliceNetIn),
             ch(BobNetOut?, BobNetIn)),

    %% Alice
    alice8(ch(AliceActorIn?, AliceActorOut)),
