%% send_reader_boot.glp - Send unbound reader, instantiate later
%%
%% Agent1 sends data(X?) with unbound reader X? to agent2.
%% Agent1 then binds X = done.
%% Agent2 receives data(Y), waits for Y? to become ground, completes.
%%
%% Tests globalize-reader path: X? is unbound at send time, so
%% globalize creates _r(agent1, i) and spawns global_send(X?, ...).
%% When agent1 binds X=done, the global_send fires and sends to agent2.

procedure boot.
boot :-
    sender_init(agent1, _)@agent1,
    receiver_init(agent2, _?)@agent2.

procedure sender_init(_?, _?).
sender_init(_, _) :-
    send_to_net([msg(agent2, data(X?))]),
    bind_later(X).

procedure bind_later(_).
bind_later(Done?) :- wait(1000) | done(Done).


procedure done(_).
done(done).

procedure receiver_init(_?, _?).
receiver_init(_, [msg(_, data(Y))|_]) :-
    got_it(Y?).

procedure got_it(_?).
got_it(done).
