%% bond_actors.glp - Scripted actors for Grassroots Bonds plays
%%
%% Phase 1: alice_p1 — solo mint + balance
%% Phase 2: alice_p2, bob_p2 — befriend + credit line
%%
%% Date: 2026-03-03

-mode(system).

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Bond     ::= bond(Constant, Constant, Constant).
BondList ::= [] ; [Bond | BondList].

ReqId ::= req(Constant).

%% User -> Mediator (actor writes these)
UserCmd ::= mint(Constant, Constant)
          ; balance
          ; done
          ; connect(Constant)
          ; decision(Decision, Constant, ReqId)
          ; credit(Constant, Constant, Constant)
          ; accept_credit(Constant, ReqId)
          ; reject_credit(Constant, ReqId).

Decision ::= yes ; no.

%% Mediator -> User (actor reads these)
UserNotify ::= minted(Constant, Constant)
             ; balance_report(BondList)
             ; befriend(Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; credit_proposed(Constant, Constant, Constant, ReqId)
             ; credit_opened(Constant, Constant)
             ; credit_rejected(Constant).

UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].

ActorChannel ::= ch(UserNotifyStream, UserCmdStream?).

%% =============================================================================
%% PLAY 1 — Solo mint + balance
%% =============================================================================

procedure alice_p1(ActorChannel?).
alice_p1(ch(In, [mint(3, 0)|Out?])) :-
    alice_p1_wait_minted1(In?, Out).

procedure alice_p1_wait_minted1(UserNotifyStream?, UserCmdStream).
alice_p1_wait_minted1([minted(3, 0)|In], [mint(2, 10)|Out?]) :-
    alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted1([_|In], Out?) :-
    otherwise | alice_p1_wait_minted1(In?, Out).
alice_p1_wait_minted1([], []).

procedure alice_p1_wait_minted2(UserNotifyStream?, UserCmdStream).
alice_p1_wait_minted2([minted(2, 10)|In], [balance|Out?]) :-
    alice_p1_wait_balance(In?, Out).
alice_p1_wait_minted2([_|In], Out?) :-
    otherwise | alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted2([], []).

procedure alice_p1_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p1_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p1_finish(In?, Out).
alice_p1_wait_balance([_|In], Out?) :-
    otherwise | alice_p1_wait_balance(In?, Out).
alice_p1_wait_balance([], []).

procedure alice_p1_finish(UserNotifyStream?, UserCmdStream).
alice_p1_finish(_, []).

%% =============================================================================
%% PLAY 2 — Alice cold-calls Bob, then opens credit line
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob)
%% 2. Wait connected(bob)
%% 3. credit(bob, 3, 0) — propose 3-coin credit line
%% 4. Wait credit_opened(bob, _)
%% 5. balance
%% 6. Wait balance_report(_)
%% 7. done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait credit_proposed(alice, 3, 0, ReqId2) → accept_credit(alice, ReqId2)
%% 4. Wait credit_opened(alice, _)
%% 5. balance
%% 6. Wait balance_report(_)
%% 7. done

procedure alice_p2(ActorChannel?).
alice_p2(ch(In, [connect(bob)|Out?])) :-
    alice_p2_wait_connected(In?, Out).

procedure alice_p2_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p2_wait_connected([connected(bob)|In],
                        [credit(bob, 3, 0)|Out?]) :-
    alice_p2_wait_credit(In?, Out).
alice_p2_wait_connected([_|In], Out?) :-
    otherwise | alice_p2_wait_connected(In?, Out).
alice_p2_wait_connected([], []).

procedure alice_p2_wait_credit(UserNotifyStream?, UserCmdStream).
alice_p2_wait_credit([credit_opened(bob, _)|In], [balance|Out?]) :-
    alice_p2_wait_balance(In?, Out).
alice_p2_wait_credit([_|In], Out?) :-
    otherwise | alice_p2_wait_credit(In?, Out).
alice_p2_wait_credit([], []).

procedure alice_p2_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p2_finish(In?, Out).
alice_p2_wait_balance([_|In], Out?) :-
    otherwise | alice_p2_wait_balance(In?, Out).
alice_p2_wait_balance([], []).

procedure alice_p2_finish(UserNotifyStream?, UserCmdStream).
alice_p2_finish(_, []).

%% --- Bob (play2) ---

procedure bob_p2(ActorChannel?).
bob_p2(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p2_wait_connected(In?, Out).
bob_p2(ch([_|In], Out?)) :-
    otherwise | bob_p2(ch(In?, Out)).

procedure bob_p2_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p2_wait_connected([connected(alice)|In], Out?) :-
    bob_p2_wait_credit_proposed(In?, Out).
bob_p2_wait_connected([_|In], Out?) :-
    otherwise | bob_p2_wait_connected(In?, Out).
bob_p2_wait_connected([], []).

procedure bob_p2_wait_credit_proposed(UserNotifyStream?, UserCmdStream).
bob_p2_wait_credit_proposed([credit_proposed(alice, 3, 0, ReqId)|In],
                            [accept_credit(alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob_p2_wait_credit_opened(In?, Out).
bob_p2_wait_credit_proposed([_|In], Out?) :-
    otherwise | bob_p2_wait_credit_proposed(In?, Out).
bob_p2_wait_credit_proposed([], []).

procedure bob_p2_wait_credit_opened(UserNotifyStream?, UserCmdStream).
bob_p2_wait_credit_opened([credit_opened(alice, _)|In], [balance|Out?]) :-
    bob_p2_wait_balance(In?, Out).
bob_p2_wait_credit_opened([_|In], Out?) :-
    otherwise | bob_p2_wait_credit_opened(In?, Out).
bob_p2_wait_credit_opened([], []).

procedure bob_p2_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p2_finish(In?, Out).
bob_p2_wait_balance([_|In], Out?) :-
    otherwise | bob_p2_wait_balance(In?, Out).
bob_p2_wait_balance([], []).

procedure bob_p2_finish(UserNotifyStream?, UserCmdStream).
bob_p2_finish(_, []).
