%% =============================================================================
%% PLAY 4 — Credit + redemption
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob)
%% 2. Wait connected(bob)
%% 3. credit(bob, 3, 0) — propose 3-coin credit line
%% 4. Wait credit_opened(bob, _)
%% 5. redeem(bob, 2, 0) — redeem 2 bob-coins
%% 6. Wait redeemed(bob, _)
%% 7. balance
%% 8. Wait balance_report(_)
%% 9. done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait credit_proposed(alice, 3, 0, ReqId2) → accept_credit(alice, ReqId2)
%% 4. Wait credit_opened(alice, _)
%% 5. Wait redeem_received(alice, _)
%% 6. balance
%% 7. Wait balance_report(_)
%% 8. done

procedure alice_p4(ActorChannel?).
alice_p4(ch(In, [connect(bob)|Out?])) :-
    alice_p4_wait_connected(In?, Out).

procedure alice_p4_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p4_wait_connected([connected(bob)|In],
                        [credit(bob, 3, 0)|Out?]) :-
    alice_p4_wait_credit(In?, Out).
alice_p4_wait_connected([_|In], Out?) :-
    otherwise | alice_p4_wait_connected(In?, Out).
alice_p4_wait_connected([], []).

procedure alice_p4_wait_credit(UserNotifyStream?, UserCmdStream).
alice_p4_wait_credit([credit_opened(bob, _)|In], [redeem(bob, 2, 0)|Out?]) :-
    alice_p4_wait_redeemed(In?, Out).
alice_p4_wait_credit([_|In], Out?) :-
    otherwise | alice_p4_wait_credit(In?, Out).
alice_p4_wait_credit([], []).

procedure alice_p4_wait_redeemed(UserNotifyStream?, UserCmdStream).
alice_p4_wait_redeemed([redeemed(bob, _)|In], [balance|Out?]) :-
