bob_p3_wait_connected([connected(alice)|In], Out?) :-
    bob_p3_wait_credit_proposed(In?, Out).
bob_p3_wait_connected([_|In], Out?) :-
    otherwise | bob_p3_wait_connected(In?, Out).
bob_p3_wait_connected([], []).

procedure bob_p3_wait_credit_proposed(UserNotifyStream?, UserCmdStream).
bob_p3_wait_credit_proposed([credit_proposed(alice, 3, 0, ReqId)|In],
                            [accept_credit(alice, ReqId?)|Out?]) :-
