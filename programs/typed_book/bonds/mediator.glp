%% bond_mediator.glp - UI mediator for Bond agent
%%
%% Translates between agent messages (msg/3 with non-ground channels)
%% and user/actor messages (ground terms with req IDs).
%%
%% Phase 1: mint, balance, done (all ground, pass-through)
%% Phase 2: befriend (non-ground Response in pending),
%%          credit_proposed (non-ground CreditResp + data in pending)
%%
%% Date: 2026-03-03

-mode(system).

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Bond     ::= bond(Constant, Constant, Constant).
BondList ::= [] ; [Bond | BondList].

CreditResponse ::= credit_accept(BondList) ; credit_reject.
LoanResponse ::= loan_accept(BondList) ; loan_reject.

Lot     ::= lot(Constant, Constant, Constant).
LotList ::= [] ; [Lot | LotList].
TradeResponse ::= trade_accept(BondList) ; trade_decline(BondList).

EscrowCancel    ::= cancel.
EscrowBenResult ::= escrow_bonds(BondList) ; escrow_cancelled.
EscrowDepResult ::= escrow_bonds(BondList) ; escrow_expired.

Installment ::= installment(Constant, Constant).
Schedule    ::= [] ; [Installment | Schedule].

FriendContent ::= response(Response)
                ; text(Constant)
                ; credit_propose(Constant, Constant, BondList, CreditResponse?)
                ; loan_propose(Constant, Schedule, BondList, LoanResponse?)
                ; trade_propose(LotList, BondList, TradeResponse?)
                ; escrow_offer(Constant, EscrowBenResult).
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

Response ::= accept(FriendChannel) ; no.
Decision ::= yes ; no.
ReqId    ::= req(Constant).

%% --- Agent-side content types ---

AgentContent ::= minted(Constant, Constant)
               ; balance_report(BondList)
               ; befriend(Constant, Response?)
               ; connected(Constant)
               ; rejected
               ; rejected(Constant)
               ; credit_proposed(Constant, Constant, Constant, CreditResponse?, BondList)
               ; credit_opened(Constant, Constant)
               ; credit_rejected(Constant)
               ; loan_proposed(Constant, Constant, Schedule, LoanResponse?, BondList)
               ; loan_opened(Constant, Constant, Constant)
               ; loan_rejected(Constant)
               ; trade_proposed(Constant, LotList, TradeResponse?, BondList)
               ; trade_completed(Constant)
               ; trade_failed(Constant)
               ; trade_returned(Constant)
               ; escrow_deposited(Constant, Constant, EscrowCancel?)
               ; escrow_received(Constant, Constant)
               ; escrow_released(Constant)
               ; escrow_cancelled(Constant)
               ; escrow_expired(Constant)
               ; escrow_returned(Constant)
               ; escrow_failed(Constant).

AgentToUserMsg    ::= msg(Constant, Constant, AgentContent).
AgentToUserStream ::= [] ; [AgentToUserMsg | AgentToUserStream].

PendingValue ::= response(Response?)
               ; credit_pending(CreditResponse?, Constant, Constant, BondList)
               ; loan_pending(LoanResponse?, Schedule, BondList)
               ; trade_pending(TradeResponse?, LotList, BondList)
               ; escrow_pending(EscrowCancel?)
               ; error.

UserContent ::= mint(Constant, Constant)
              ; balance
              ; done
              ; connect(Constant)
              ; decision(Decision, Constant, PendingValue)
              ; response(Response)
              ; credit(Constant, Constant, Constant)
              ; accept_credit(Constant, PendingValue)
              ; reject_credit(Constant, PendingValue)
              ; loan(Constant, Constant, Schedule)
              ; accept_loan(Constant, PendingValue)
              ; reject_loan(Constant, PendingValue)
              ; trade(Constant, LotList, LotList)
              ; accept_trade(Constant, PendingValue)
              ; reject_trade(Constant, PendingValue)
              ; deposit_escrow(Constant, LotList, Constant)
              ; cancel_escrow(Constant, PendingValue).

MediatorToAgentMsg    ::= msg(Constant, Constant, UserContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].

AgentChannel ::= ch(AgentToUserStream, MediatorToAgentStream?).

%% --- User-side message types ---

UserCmd ::= mint(Constant, Constant)
          ; balance
          ; done
          ; connect(Constant)
          ; decision(Decision, Constant, ReqId)
          ; credit(Constant, Constant, Constant)
          ; accept_credit(Constant, ReqId)
          ; reject_credit(Constant, ReqId)
          ; loan(Constant, Constant, Schedule)
          ; accept_loan(Constant, ReqId)
          ; reject_loan(Constant, ReqId)
          ; trade(Constant, LotList, LotList)
          ; accept_trade(Constant, ReqId)
          ; reject_trade(Constant, ReqId)
          ; deposit_escrow(Constant, LotList, Constant)
          ; cancel_escrow(Constant, ReqId).

UserNotify ::= minted(Constant, Constant)
             ; balance_report(BondList)
             ; befriend(Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; credit_proposed(Constant, Constant, Constant, ReqId)
             ; credit_opened(Constant, Constant)
             ; credit_rejected(Constant)
             ; loan_proposed(Constant, Constant, ReqId)
             ; loan_opened(Constant, Constant, Constant)
             ; loan_rejected(Constant)
             ; trade_proposed(Constant, LotList, ReqId)
             ; trade_completed(Constant)
             ; trade_failed(Constant)
             ; trade_returned(Constant)
             ; escrow_deposited(Constant, Constant, ReqId)
             ; escrow_received(Constant, Constant)
             ; escrow_released(Constant)
             ; escrow_cancelled(Constant)
             ; escrow_expired(Constant)
             ; escrow_returned(Constant)
             ; escrow_failed(Constant).

UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].
UserChannel      ::= ch(UserCmdStream, UserNotifyStream?).

%% Pending entries
PendingEntry ::= pending(ReqId, PendingValue).
PendingList  ::= [] ; [PendingEntry | PendingList].

%% =============================================================================
%% CHANNEL OPERATIONS
%% =============================================================================

send(X, ch(In, [X?|Out?]), ch(In?, Out)).
receive(X?, ch([X|In], Out?), ch(In?, Out)).
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

procedure send_agent(MediatorToAgentMsg?, AgentChannel?, AgentChannel).
send_agent(X, ch(In, [X?|Out?]), ch(In?, Out)).

procedure send_user(UserNotify?, UserChannel?, UserChannel).
send_user(X, ch(In, [X?|Out?]), ch(In?, Out)).

%% =============================================================================
%% PENDING MANAGEMENT
%% =============================================================================

procedure lookup_pending(ReqId?, PendingValue, PendingList?, PendingList).
lookup_pending(ReqId, Val?,
    [pending(Id, Val) | Rest], Rest?) :-
    ReqId? =?= Id? | true.
lookup_pending(ReqId, Val?, [P | Rest], [P? | Rest1?]) :-
    otherwise |
    lookup_pending(ReqId?, Val, Rest?, Rest1).
lookup_pending(_, error, [], []).

%% =============================================================================
%% UI MEDIATOR - Main loop
%% =============================================================================

procedure ui_mediator(Constant?, AgentChannel?, UserChannel?, PendingList?, Constant?).

%% --- Agent-to-user: Phase 1 ground pass-through ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', minted(K, Maturity)),
            AgentCh?, AgentCh1),
    ground(K?), ground(Maturity?) |
    send_user(minted(K?, Maturity?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', balance_report(Holdings)),
            AgentCh?, AgentCh1),
    ground(Holdings?) |
    send_user(balance_report(Holdings?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: befriend (non-ground — store Response in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', befriend(From, Resp?)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send_user(befriend(From?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), response(Resp)) | Ps?], N1?).

%% --- Agent-to-user: connected (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', connected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send_user(connected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected),
            AgentCh?, AgentCh1) |
    send_user(rejected, UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send_user(rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: credit_proposed (non-ground — store CreditResp + data in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', credit_proposed(From, K, Maturity, CreditResp?, TheirBonds)),
            AgentCh?, AgentCh1),
    ground(From?), ground(K?), ground(Maturity?), ground(TheirBonds?) |
    send_user(credit_proposed(From?, K?, Maturity?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), credit_pending(CreditResp, K?, Maturity?, TheirBonds?)) | Ps?], N1?).

%% --- Agent-to-user: credit_opened (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', credit_opened(Who, K)),
            AgentCh?, AgentCh1),
    ground(Who?), ground(K?) |
    send_user(credit_opened(Who?, K?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: credit_rejected (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', credit_rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send_user(credit_rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: Phase 1 pass-through ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(mint(K, Maturity), UserCh?, UserCh1),
    ground(Id?), ground(K?), ground(Maturity?) |
    send_agent(msg('_user', Id?, mint(K?, Maturity?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(balance, UserCh?, UserCh1),
    ground(Id?) |
    send_agent(msg('_user', Id?, balance),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(done, UserCh?, UserCh1),
    ground(Id?) |
    send_agent(msg('_user', Id?, done),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: connect (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(connect(Target), UserCh?, UserCh1),
    ground(Id?), ground(Target?) |
    send_agent(msg('_user', Id?, connect(Target?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: decision (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(decision(Dec, From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Dec?), ground(From?),
    ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, decision(Dec?, From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: credit (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(credit(Target, K, Maturity), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(K?), ground(Maturity?) |
    send_agent(msg('_user', Id?, credit(Target?, K?, Maturity?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: accept_credit (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_credit(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, accept_credit(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: reject_credit (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_credit(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, reject_credit(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Agent-to-user: loan_proposed (non-ground — store LoanResp + data in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', loan_proposed(From, Principal, Schedule, LoanResp?, LenderCoins)),
            AgentCh?, AgentCh1),
    ground(From?), ground(Principal?), ground(Schedule?), ground(LenderCoins?) |
    send_user(loan_proposed(From?, Principal?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), loan_pending(LoanResp, Schedule?, LenderCoins?)) | Ps?], N1?).

%% --- Agent-to-user: loan_opened (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', loan_opened(Who, Principal, FaceValue)),
            AgentCh?, AgentCh1),
    ground(Who?), ground(Principal?), ground(FaceValue?) |
    send_user(loan_opened(Who?, Principal?, FaceValue?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: loan_rejected (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', loan_rejected(Who)),
            AgentCh?, AgentCh1),
    ground(Who?) |
    send_user(loan_rejected(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: loan (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(loan(Target, Principal, Schedule), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(Principal?), ground(Schedule?) |
    send_agent(msg('_user', Id?, loan(Target?, Principal?, Schedule?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: accept_loan (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_loan(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, accept_loan(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: reject_loan (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_loan(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, reject_loan(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Agent-to-user: trade_proposed (non-ground — store TradeResp + data in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_proposed(From, WantSpec, TradeResp?, OfferedBonds)),
            AgentCh?, AgentCh1),
    ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    send_user(trade_proposed(From?, WantSpec?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), trade_pending(TradeResp, WantSpec?, OfferedBonds?)) | Ps?], N1?).

%% --- Agent-to-user: trade_completed (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_completed(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send_user(trade_completed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: trade_failed (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_failed(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send_user(trade_failed(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: trade_returned (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', trade_returned(Who)), AgentCh?, AgentCh1),
    ground(Who?) |
    send_user(trade_returned(Who?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: trade (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(trade(Target, GiveSpec, WantSpec), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    send_agent(msg('_user', Id?, trade(Target?, GiveSpec?, WantSpec?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: accept_trade (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(accept_trade(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, accept_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- User-to-agent: reject_trade (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(reject_trade(From, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(From?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, reject_trade(From?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Agent-to-user: escrow_deposited (non-ground — store CancelSignal in pending) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_deposited(Target, ReleaseTime, CancelSignal?)),
            AgentCh?, AgentCh1),
    ground(Target?), ground(ReleaseTime?) |
    send_user(escrow_deposited(Target?, ReleaseTime?, req(N?)), UserCh?, UserCh1),
    N1 := N? + 1,
    ui_mediator(Id?, AgentCh1?, UserCh1?,
        [pending(req(N?), escrow_pending(CancelSignal)) | Ps?], N1?).

%% --- Agent-to-user: escrow_received (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_received(From, ReleaseTime)),
            AgentCh?, AgentCh1),
    ground(From?), ground(ReleaseTime?) |
    send_user(escrow_received(From?, ReleaseTime?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_released (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_released(From)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send_user(escrow_released(From?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_cancelled (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_cancelled(From)),
            AgentCh?, AgentCh1),
    ground(From?) |
    send_user(escrow_cancelled(From?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_expired (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_expired(Target)),
            AgentCh?, AgentCh1),
    ground(Target?) |
    send_user(escrow_expired(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_returned (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_returned(Target)),
            AgentCh?, AgentCh1),
    ground(Target?) |
    send_user(escrow_returned(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- Agent-to-user: escrow_failed (ground — pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(msg(agent, '_user', escrow_failed(Target)),
            AgentCh?, AgentCh1),
    ground(Target?) |
    send_user(escrow_failed(Target?), UserCh?, UserCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: deposit_escrow (pass through) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(deposit_escrow(Target, GiveSpec, ReleaseTime), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(GiveSpec?), ground(ReleaseTime?) |
    send_agent(msg('_user', Id?, deposit_escrow(Target?, GiveSpec?, ReleaseTime?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps?, N?).

%% --- User-to-agent: cancel_escrow (with pending lookup) ---

ui_mediator(Id, AgentCh, UserCh, Ps, N) :-
    receive(cancel_escrow(Target, ReqId), UserCh?, UserCh1),
    ground(Id?), ground(Target?), ground(ReqId?) |
    lookup_pending(ReqId?, Pv, Ps?, Ps1),
    send_agent(msg('_user', Id?, cancel_escrow(Target?, Pv?)),
         AgentCh?, AgentCh1),
    ui_mediator(Id?, AgentCh1?, UserCh1?, Ps1?, N?).

%% --- Termination ---

ui_mediator(_, ch([], []), ch([], []), _, _).
