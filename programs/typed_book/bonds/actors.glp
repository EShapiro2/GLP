%% =============================================================================
%%
%% Alice:
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(5, 0) → wait minted(5, 0)
%% 3. trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)]) → wait trade_completed(bob)
%% 4. mint(3, 10) → wait minted(3, 10)
%% 5. trade(bob, [lot(alice, 10, 3)], [lot(alice, 0, 2)]) → wait trade_completed(bob)
%% 6. balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend → decision(yes) → wait connected
%% 2. Wait trade_proposed → mint(5, 0) → wait minted → accept_trade
%%    → wait trade_completed(alice)
%% 3. Wait trade_proposed (sale of debt) → accept_trade
%% 4. balance → wait balance_report(_) → done

procedure alice_p8(ActorChannel?).
