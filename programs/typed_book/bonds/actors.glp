%% bond_actors.glp - Scripted actors for Grassroots Bonds plays
%%
%% Phase 1: alice_p1 — solo mint + balance
%% Phase 2: alice_p2, bob_p2 — befriend + credit line
%% Phase 3: alice_p3, bob_p3 — credit + payment (via trade)
%% Phase 4: alice_p4, bob_p4 — credit + redemption (via trade)
%% Phase 4b: alice_p4b, bob_p4b — time-dependent redemption (via trade)
%% Phase 5: alice_p5, bob_p5 — zero-coupon loan
%% Phase 6: alice_p6, bob_p6 — balloon loan
%%
%% Date: 2026-03-03

-mode(system).

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Bond     ::= bond(Constant, Constant, Constant).
BondList ::= [] ; [Bond | BondList].

ReqId ::= req(Constant).

Lot     ::= lot(Constant, Constant, Constant).
LotList ::= [] ; [Lot | LotList].

Installment ::= installment(Constant, Constant).
Schedule    ::= [] ; [Installment | Schedule].

%% User -> Mediator (actor writes these)
UserCmd ::= mint(Constant, Constant)
          ; balance
          ; done
          ; connect(Constant)
          ; decision(Decision, Constant, ReqId)
          ; credit(Constant, Constant, Constant)
          ; accept_credit(Constant, ReqId)
          ; reject_credit(Constant, ReqId)
          ; loan(Constant, Constant, Schedule)
          ; accept_loan(Constant, ReqId)
          ; reject_loan(Constant, ReqId)
          ; trade(Constant, LotList, LotList)
          ; accept_trade(Constant, ReqId)
          ; reject_trade(Constant, ReqId)
          ; deposit_escrow(Constant, LotList, Constant)
          ; cancel_escrow(Constant, ReqId).

Decision ::= yes ; no.

%% Mediator -> User (actor reads these)
UserNotify ::= minted(Constant, Constant)
             ; balance_report(BondList)
             ; befriend(Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; credit_proposed(Constant, Constant, Constant, ReqId)
             ; credit_opened(Constant, Constant)
             ; credit_rejected(Constant)
             ; loan_proposed(Constant, Constant, ReqId)
             ; loan_opened(Constant, Constant, Constant)
             ; loan_rejected(Constant)
             ; trade_proposed(Constant, LotList, ReqId)
             ; trade_completed(Constant)
             ; trade_failed(Constant)
             ; trade_returned(Constant)
             ; escrow_deposited(Constant, Constant, ReqId)
             ; escrow_received(Constant, Constant)
             ; escrow_released(Constant)
             ; escrow_cancelled(Constant)
             ; escrow_expired(Constant)
             ; escrow_returned(Constant)
             ; escrow_failed(Constant).

UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].

ActorChannel ::= ch(UserNotifyStream, UserCmdStream?).

%% =============================================================================
%% PLAY 1 — Solo mint + balance
%% =============================================================================

procedure alice_p1(ActorChannel?).
alice_p1(ch(In, [mint(3, 0)|Out?])) :-
    alice_p1_wait_minted1(In?, Out).

procedure alice_p1_wait_minted1(UserNotifyStream?, UserCmdStream).
alice_p1_wait_minted1([minted(3, 0)|In], [mint(2, 10)|Out?]) :-
    alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted1([_|In], Out?) :-
    otherwise | alice_p1_wait_minted1(In?, Out).
alice_p1_wait_minted1([], []).

procedure alice_p1_wait_minted2(UserNotifyStream?, UserCmdStream).
alice_p1_wait_minted2([minted(2, 10)|In], [balance|Out?]) :-
    alice_p1_wait_balance(In?, Out).
alice_p1_wait_minted2([_|In], Out?) :-
    otherwise | alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted2([], []).

procedure alice_p1_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p1_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p1_finish(In?, Out).
alice_p1_wait_balance([_|In], Out?) :-
    otherwise | alice_p1_wait_balance(In?, Out).
alice_p1_wait_balance([], []).

procedure alice_p1_finish(UserNotifyStream?, UserCmdStream).
alice_p1_finish(_, []).

%% =============================================================================
%% PLAY 2 — Alice cold-calls Bob, then opens credit line
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob)
%% 2. Wait connected(bob)
%% 3. credit(bob, 3, 0) — propose 3-coin credit line
%% 4. Wait credit_opened(bob, _)
%% 5. balance
%% 6. Wait balance_report(_)
%% 7. done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait credit_proposed(alice, 3, 0, ReqId2) → accept_credit(alice, ReqId2)
%% 4. Wait credit_opened(alice, _)
%% 5. balance
%% 6. Wait balance_report(_)
%% 7. done

procedure alice_p2(ActorChannel?).
alice_p2(ch(In, [connect(bob)|Out?])) :-
    alice_p2_wait_connected(In?, Out).

procedure alice_p2_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p2_wait_connected([connected(bob)|In],
                        [credit(bob, 3, 0)|Out?]) :-
    alice_p2_wait_credit(In?, Out).
alice_p2_wait_connected([_|In], Out?) :-
    otherwise | alice_p2_wait_connected(In?, Out).
alice_p2_wait_connected([], []).

procedure alice_p2_wait_credit(UserNotifyStream?, UserCmdStream).
alice_p2_wait_credit([credit_opened(bob, _)|In], [balance|Out?]) :-
    alice_p2_wait_balance(In?, Out).
alice_p2_wait_credit([_|In], Out?) :-
    otherwise | alice_p2_wait_credit(In?, Out).
alice_p2_wait_credit([], []).

procedure alice_p2_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p2_finish(In?, Out).
alice_p2_wait_balance([_|In], Out?) :-
    otherwise | alice_p2_wait_balance(In?, Out).
alice_p2_wait_balance([], []).

procedure alice_p2_finish(UserNotifyStream?, UserCmdStream).
alice_p2_finish(_, []).

%% --- Bob (play2) ---

procedure bob_p2(ActorChannel?).
bob_p2(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p2_wait_connected(In?, Out).
bob_p2(ch([_|In], Out?)) :-
    otherwise | bob_p2(ch(In?, Out)).

procedure bob_p2_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p2_wait_connected([connected(alice)|In], Out?) :-
    bob_p2_wait_credit_proposed(In?, Out).
bob_p2_wait_connected([_|In], Out?) :-
    otherwise | bob_p2_wait_connected(In?, Out).
bob_p2_wait_connected([], []).

procedure bob_p2_wait_credit_proposed(UserNotifyStream?, UserCmdStream).
bob_p2_wait_credit_proposed([credit_proposed(alice, 3, 0, ReqId)|In],
                            [accept_credit(alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob_p2_wait_credit_opened(In?, Out).
bob_p2_wait_credit_proposed([_|In], Out?) :-
    otherwise | bob_p2_wait_credit_proposed(In?, Out).
bob_p2_wait_credit_proposed([], []).

procedure bob_p2_wait_credit_opened(UserNotifyStream?, UserCmdStream).
bob_p2_wait_credit_opened([credit_opened(alice, _)|In], [balance|Out?]) :-
    bob_p2_wait_balance(In?, Out).
bob_p2_wait_credit_opened([_|In], Out?) :-
    otherwise | bob_p2_wait_credit_opened(In?, Out).
bob_p2_wait_credit_opened([], []).

procedure bob_p2_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p2_finish(In?, Out).
bob_p2_wait_balance([_|In], Out?) :-
    otherwise | bob_p2_wait_balance(In?, Out).
bob_p2_wait_balance([], []).

procedure bob_p2_finish(UserNotifyStream?, UserCmdStream).
bob_p2_finish(_, []).

%% =============================================================================
%% PLAY 3 — Credit + payment (via trade)
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob)
%% 2. Wait connected(bob)
%% 3. credit(bob, 3, 0) — propose 3-coin credit line
%% 4. Wait credit_opened(bob, _)
%% 5. trade(bob, [lot(bob, 0, 2)], []) — pay 2 bob-coins to Bob
%% 6. Wait trade_completed(bob)
%% 7. balance
%% 8. Wait balance_report(_)
%% 9. done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait credit_proposed(alice, 3, 0, ReqId2) → accept_credit(alice, ReqId2)
%% 4. Wait credit_opened(alice, _)
%% 5. Wait trade_completed(alice) — auto-accepted (own coins returned)
%% 6. balance
%% 7. Wait balance_report(_)
%% 8. done

procedure alice_p3(ActorChannel?).
alice_p3(ch(In, [connect(bob)|Out?])) :-
    alice_p3_wait_connected(In?, Out).

procedure alice_p3_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p3_wait_connected([connected(bob)|In],
                        [credit(bob, 3, 0)|Out?]) :-
    alice_p3_wait_credit(In?, Out).
alice_p3_wait_connected([_|In], Out?) :-
    otherwise | alice_p3_wait_connected(In?, Out).
alice_p3_wait_connected([], []).

procedure alice_p3_wait_credit(UserNotifyStream?, UserCmdStream).
alice_p3_wait_credit([credit_opened(bob, _)|In],
                     [trade(bob, [lot(bob, 0, 2)], [])|Out?]) :-
    alice_p3_wait_trade(In?, Out).
alice_p3_wait_credit([_|In], Out?) :-
    otherwise | alice_p3_wait_credit(In?, Out).
alice_p3_wait_credit([], []).

procedure alice_p3_wait_trade(UserNotifyStream?, UserCmdStream).
alice_p3_wait_trade([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p3_wait_balance(In?, Out).
alice_p3_wait_trade([_|In], Out?) :-
    otherwise | alice_p3_wait_trade(In?, Out).
alice_p3_wait_trade([], []).

procedure alice_p3_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p3_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p3_finish(In?, Out).
alice_p3_wait_balance([_|In], Out?) :-
    otherwise | alice_p3_wait_balance(In?, Out).
alice_p3_wait_balance([], []).

procedure alice_p3_finish(UserNotifyStream?, UserCmdStream).
alice_p3_finish(_, []).

%% --- Bob (play3) ---

procedure bob_p3(ActorChannel?).
bob_p3(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p3_wait_connected(In?, Out).
bob_p3(ch([_|In], Out?)) :-
    otherwise | bob_p3(ch(In?, Out)).

procedure bob_p3_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p3_wait_connected([connected(alice)|In], Out?) :-
    bob_p3_wait_credit_proposed(In?, Out).
bob_p3_wait_connected([_|In], Out?) :-
    otherwise | bob_p3_wait_connected(In?, Out).
bob_p3_wait_connected([], []).

procedure bob_p3_wait_credit_proposed(UserNotifyStream?, UserCmdStream).
bob_p3_wait_credit_proposed([credit_proposed(alice, 3, 0, ReqId)|In],
                            [accept_credit(alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob_p3_wait_credit_opened(In?, Out).
bob_p3_wait_credit_proposed([_|In], Out?) :-
    otherwise | bob_p3_wait_credit_proposed(In?, Out).
bob_p3_wait_credit_proposed([], []).

procedure bob_p3_wait_credit_opened(UserNotifyStream?, UserCmdStream).
bob_p3_wait_credit_opened([credit_opened(alice, _)|In], Out?) :-
    bob_p3_wait_trade(In?, Out).
bob_p3_wait_credit_opened([_|In], Out?) :-
    otherwise | bob_p3_wait_credit_opened(In?, Out).
bob_p3_wait_credit_opened([], []).

procedure bob_p3_wait_trade(UserNotifyStream?, UserCmdStream).
bob_p3_wait_trade([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p3_wait_balance(In?, Out).
bob_p3_wait_trade([_|In], Out?) :-
    otherwise | bob_p3_wait_trade(In?, Out).
bob_p3_wait_trade([], []).

procedure bob_p3_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p3_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p3_finish(In?, Out).
bob_p3_wait_balance([_|In], Out?) :-
    otherwise | bob_p3_wait_balance(In?, Out).
bob_p3_wait_balance([], []).

procedure bob_p3_finish(UserNotifyStream?, UserCmdStream).
bob_p3_finish(_, []).

%% =============================================================================
%% PLAY 4 — Credit + redemption (via trade)
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob)
%% 2. Wait connected(bob)
%% 3. credit(bob, 3, 0) — propose 3-coin credit line
%% 4. Wait credit_opened(bob, _)
%% 5. trade(bob, [lot(bob, 0, 2)], [lot(alice, 0, 2)]) — redeem 2 bob-coins
%% 6. Wait trade_completed(bob)
%% 7. balance
%% 8. Wait balance_report(_)
%% 9. done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait credit_proposed(alice, 3, 0, ReqId2) → accept_credit(alice, ReqId2)
%% 4. Wait credit_opened(alice, _)
%% 5. Wait trade_completed(alice) — auto-accepted (own coins returned)
%% 6. balance
%% 7. Wait balance_report(_)
%% 8. done

procedure alice_p4(ActorChannel?).
alice_p4(ch(In, [connect(bob)|Out?])) :-
    alice_p4_wait_connected(In?, Out).

procedure alice_p4_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p4_wait_connected([connected(bob)|In],
                        [credit(bob, 3, 0)|Out?]) :-
    alice_p4_wait_credit(In?, Out).
alice_p4_wait_connected([_|In], Out?) :-
    otherwise | alice_p4_wait_connected(In?, Out).
alice_p4_wait_connected([], []).

procedure alice_p4_wait_credit(UserNotifyStream?, UserCmdStream).
alice_p4_wait_credit([credit_opened(bob, _)|In],
                     [trade(bob, [lot(bob, 0, 2)], [lot(alice, 0, 2)])|Out?]) :-
    alice_p4_wait_trade(In?, Out).
alice_p4_wait_credit([_|In], Out?) :-
    otherwise | alice_p4_wait_credit(In?, Out).
alice_p4_wait_credit([], []).

procedure alice_p4_wait_trade(UserNotifyStream?, UserCmdStream).
alice_p4_wait_trade([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4_wait_balance(In?, Out).
alice_p4_wait_trade([_|In], Out?) :-
    otherwise | alice_p4_wait_trade(In?, Out).
alice_p4_wait_trade([], []).

procedure alice_p4_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p4_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p4_finish(In?, Out).
alice_p4_wait_balance([_|In], Out?) :-
    otherwise | alice_p4_wait_balance(In?, Out).
alice_p4_wait_balance([], []).

procedure alice_p4_finish(UserNotifyStream?, UserCmdStream).
alice_p4_finish(_, []).

%% --- Bob (play4) ---

procedure bob_p4(ActorChannel?).
bob_p4(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p4_wait_connected(In?, Out).
bob_p4(ch([_|In], Out?)) :-
    otherwise | bob_p4(ch(In?, Out)).

procedure bob_p4_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p4_wait_connected([connected(alice)|In], Out?) :-
    bob_p4_wait_credit_proposed(In?, Out).
bob_p4_wait_connected([_|In], Out?) :-
    otherwise | bob_p4_wait_connected(In?, Out).
bob_p4_wait_connected([], []).

procedure bob_p4_wait_credit_proposed(UserNotifyStream?, UserCmdStream).
bob_p4_wait_credit_proposed([credit_proposed(alice, 3, 0, ReqId)|In],
                            [accept_credit(alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob_p4_wait_credit_opened(In?, Out).
bob_p4_wait_credit_proposed([_|In], Out?) :-
    otherwise | bob_p4_wait_credit_proposed(In?, Out).
bob_p4_wait_credit_proposed([], []).

procedure bob_p4_wait_credit_opened(UserNotifyStream?, UserCmdStream).
bob_p4_wait_credit_opened([credit_opened(alice, _)|In], Out?) :-
    bob_p4_wait_trade(In?, Out).
bob_p4_wait_credit_opened([_|In], Out?) :-
    otherwise | bob_p4_wait_credit_opened(In?, Out).
bob_p4_wait_credit_opened([], []).

procedure bob_p4_wait_trade(UserNotifyStream?, UserCmdStream).
bob_p4_wait_trade([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p4_wait_balance(In?, Out).
bob_p4_wait_trade([_|In], Out?) :-
    otherwise | bob_p4_wait_trade(In?, Out).
bob_p4_wait_trade([], []).

procedure bob_p4_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p4_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p4_finish(In?, Out).
bob_p4_wait_balance([_|In], Out?) :-
    otherwise | bob_p4_wait_balance(In?, Out).
bob_p4_wait_balance([], []).

procedure bob_p4_finish(UserNotifyStream?, UserCmdStream).
bob_p4_finish(_, []).

%% =============================================================================
%% PLAY 4b — Time-dependent redemption (via trade)
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob)
%% 2. Wait connected(bob)
%% 3. credit(bob, 5, 0) — coin credit line
%% 4. Wait credit_opened(bob, _)
%% 5. Compute T = now + 500. credit(bob, 5, T) — bond credit line
%% 6. Wait credit_opened(bob, _)
%% 7. trade(bob, [lot(bob,0,2)], [lot(alice,T,2)]) — pre-maturity: want alice-bonds(T)
%% 8. Wait trade_completed(bob)
%% 9. balance
%% 10. Wait balance_report(_), then wait(500)
%% 11. trade(bob, [lot(bob,0,2)], [lot(alice,0,2)]) — post-maturity: want alice-coins
%% 12. Wait trade_completed(bob)
%% 13. balance
%% 14. done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes)
%% 2. Wait connected(alice)
%% 3. Wait credit_proposed(alice, 5, 0, ReqId) → accept
%% 4. Wait credit_opened(alice, _)
%% 5. Wait credit_proposed(alice, 5, _, ReqId) → accept (maturity T)
%% 6. Wait credit_opened(alice, _)
%% 7. Wait trade_completed(alice) — first trade (auto-accepted)
%% 8. Wait trade_completed(alice) — second trade (auto-accepted)
%% 9. balance
%% 10. done

procedure alice_p4b(ActorChannel?, Constant?).
alice_p4b(ch(In, [connect(bob)|Out?]), T) :-
    alice_p4b_wait_connected(T?, In?, Out).

procedure alice_p4b_wait_connected(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_connected(T, [connected(bob)|In],
                         [credit(bob, 5, 0)|Out?]) :-
    alice_p4b_wait_credit1(T?, In?, Out).
alice_p4b_wait_connected(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_connected(T?, In?, Out).
alice_p4b_wait_connected(_, [], []).

%% Wait for coin credit to open, then send bond credit with maturity T
procedure alice_p4b_wait_credit1(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_credit1(T, [credit_opened(bob, _)|In], [credit(bob, 5, T?)|Out?]) :-
    alice_p4b_wait_credit2(T?, In?, Out).
alice_p4b_wait_credit1(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_credit1(T?, In?, Out).
alice_p4b_wait_credit1(_, [], []).

%% Wait for bond credit to open, then trade (pre-maturity redemption)
procedure alice_p4b_wait_credit2(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_credit2(T, [credit_opened(bob, _)|In],
                       [trade(bob, [lot(bob, 0, 2)], [lot(alice, T?, 2)])|Out?]) :-
    alice_p4b_wait_trade1(T?, In?, Out).
alice_p4b_wait_credit2(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_credit2(T?, In?, Out).
alice_p4b_wait_credit2(_, [], []).

%% Wait for first trade to complete
procedure alice_p4b_wait_trade1(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_trade1(T, [trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4b_wait_balance1(T?, In?, Out).
alice_p4b_wait_trade1(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_trade1(T?, In?, Out).
alice_p4b_wait_trade1(_, [], []).

%% Wait for balance report, then wait 500ms, then trade again (post-maturity)
procedure alice_p4b_wait_balance1(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_balance1(_, [balance_report(_)|In],
                        [trade(bob, [lot(bob, 0, 2)], [lot(alice, 0, 2)])|Out?]) :-
    wait(500) |
    alice_p4b_wait_trade2(In?, Out).
alice_p4b_wait_balance1(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_balance1(T?, In?, Out).
alice_p4b_wait_balance1(_, [], []).

%% Wait for second trade to complete
procedure alice_p4b_wait_trade2(UserNotifyStream?, UserCmdStream).
alice_p4b_wait_trade2([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4b_wait_balance2(In?, Out).
alice_p4b_wait_trade2([_|In], Out?) :-
    otherwise | alice_p4b_wait_trade2(In?, Out).
alice_p4b_wait_trade2([], []).

%% Wait for final balance report, then done
procedure alice_p4b_wait_balance2(UserNotifyStream?, UserCmdStream).
alice_p4b_wait_balance2([balance_report(_)|In], [done|Out?]) :-
    alice_p4b_finish(In?, Out).
alice_p4b_wait_balance2([_|In], Out?) :-
    otherwise | alice_p4b_wait_balance2(In?, Out).
alice_p4b_wait_balance2([], []).

procedure alice_p4b_finish(UserNotifyStream?, UserCmdStream).
alice_p4b_finish(_, []).

%% --- Bob (play4b) ---

procedure bob_p4b(ActorChannel?).
bob_p4b(ch([befriend(alice, ReqId)|In],
           [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p4b_wait_connected(In?, Out).
bob_p4b(ch([_|In], Out?)) :-
    otherwise | bob_p4b(ch(In?, Out)).

procedure bob_p4b_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p4b_wait_connected([connected(alice)|In], Out?) :-
    bob_p4b_wait_credit_proposed1(In?, Out).
bob_p4b_wait_connected([_|In], Out?) :-
    otherwise | bob_p4b_wait_connected(In?, Out).
bob_p4b_wait_connected([], []).

%% Wait for coin credit proposal (maturity 0)
procedure bob_p4b_wait_credit_proposed1(UserNotifyStream?, UserCmdStream).
bob_p4b_wait_credit_proposed1([credit_proposed(alice, 5, 0, ReqId)|In],
                              [accept_credit(alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    bob_p4b_wait_credit_opened1(In?, Out).
bob_p4b_wait_credit_proposed1([_|In], Out?) :-
    otherwise | bob_p4b_wait_credit_proposed1(In?, Out).
bob_p4b_wait_credit_proposed1([], []).

procedure bob_p4b_wait_credit_opened1(UserNotifyStream?, UserCmdStream).
bob_p4b_wait_credit_opened1([credit_opened(alice, _)|In], Out?) :-
    bob_p4b_wait_credit_proposed2(In?, Out).
bob_p4b_wait_credit_opened1([_|In], Out?) :-
    otherwise | bob_p4b_wait_credit_opened1(In?, Out).
