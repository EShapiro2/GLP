%% =============================================================================
%% PLAY 9 — Forward Contract
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob)
%% 2. Wait connected(bob)
%% 3. mint(3, 50)
%% 4. Wait minted(3, 50)
%% 5. trade(bob, [lot(alice, 50, 3)], [lot(bob, 50, 3)])
%% 6. Wait trade_completed(bob)
%% 7. balance
%% 8. Wait balance_report(_)
%% 9. done

procedure alice_p9(ActorChannel?).
alice_p9(ch(In, [connect(bob)|Out?])) :-
    alice_p9_wait_connected(In?, Out).

procedure alice_p9_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p9_wait_connected([connected(bob)|In],
                        [mint(3, 50)|Out?]) :-
    alice_p9_wait_minted(In?, Out).
alice_p9_wait_connected([_|In], Out?) :-
    otherwise | alice_p9_wait_connected(In?, Out).
alice_p9_wait_connected([], []).

procedure alice_p9_wait_minted(UserNotifyStream?, UserCmdStream).
alice_p9_wait_minted([minted(3, 50)|In],
                     [trade(bob, [lot(alice, 50, 3)], [lot(bob, 50, 3)])|Out?]) :-
    alice_p9_wait_trade(In?, Out).
alice_p9_wait_minted([_|In], Out?) :-
    otherwise | alice_p9_wait_minted(In?, Out).
alice_p9_wait_minted([], []).

procedure alice_p9_wait_trade(UserNotifyStream?, UserCmdStream).
alice_p9_wait_trade([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p9_wait_balance(In?, Out).
alice_p9_wait_trade([_|In], Out?) :-
    otherwise | alice_p9_wait_trade(In?, Out).
alice_p9_wait_trade([], []).

procedure alice_p9_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p9_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p9_finish(In?, Out).
alice_p9_wait_balance([_|In], Out?) :-
    otherwise | alice_p9_wait_balance(In?, Out).
alice_p9_wait_balance([], []).

procedure alice_p9_finish(UserNotifyStream?, UserCmdStream).
alice_p9_finish(_, []).

%% --- Bob (play9) ---

procedure bob_p9(ActorChannel?).
bob_p9(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p9_wait_connected(In?, Out).
bob_p9(ch([_|In], Out?)) :-
    otherwise | bob_p9(ch(In?, Out)).

procedure bob_p9_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p9_wait_connected([connected(alice)|In], [mint(3, 50)|Out?]) :-
    bob_p9_wait_minted(In?, Out).
bob_p9_wait_connected([_|In], Out?) :-
    otherwise | bob_p9_wait_connected(In?, Out).
bob_p9_wait_connected([], []).

procedure bob_p9_wait_minted(UserNotifyStream?, UserCmdStream).
bob_p9_wait_minted([minted(3, 50)|In], Out?) :-
    bob_p9_wait_trade_proposed(In?, Out).
bob_p9_wait_minted([_|In], Out?) :-
    otherwise | bob_p9_wait_minted(In?, Out).
bob_p9_wait_minted([], []).

procedure bob_p9_wait_trade_proposed(UserNotifyStream?, UserCmdStream).
bob_p9_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                           [accept_trade(alice, ReqId?), balance|Out?]) :-
    ground(ReqId?) |
    bob_p9_wait_balance(In?, Out).
bob_p9_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p9_wait_trade_proposed(In?, Out).
bob_p9_wait_trade_proposed([], []).

procedure bob_p9_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p9_wait_balance([balance_report(_)|_], [done|Out?]) :-
    bob_p9_finish(Out).
bob_p9_wait_balance([_|In], Out?) :-
    otherwise | bob_p9_wait_balance(In?, Out).
bob_p9_wait_balance([], []).

procedure bob_p9_finish(UserCmdStream).
bob_p9_finish([]).

%% =============================================================================
%% PLAY 10 — Credit + escrow time-release (via mint+trade+escrow)
%% =============================================================================
%%
%% Alice(T):
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(5, 0) → wait minted(5, 0)
%% 3. trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)]) → wait trade_completed(bob)
%% 4. deposit_escrow(bob, [lot(bob, 0, 3)], T) → wait escrow_deposited(bob, _, _)
%% 5. wait escrow_expired(bob) → balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend → decision(yes) → wait connected
%% 2. Wait trade_proposed → mint(5, 0) → wait minted → accept_trade
%%    → wait trade_completed(alice)
%% 3. Wait escrow_received(alice, _) → wait escrow_released(alice)
%% 4. balance → wait balance_report(_) → done

%% --- Alice (play10) ---

procedure alice_p10(Constant?, ActorChannel?).
alice_p10(T, ch(In, [connect(bob)|Out?])) :-
    ground(T?) |
    alice_p10_wait_connected(T?, In?, Out).

procedure alice_p10_wait_connected(Constant?, UserNotifyStream?, UserCmdStream).
alice_p10_wait_connected(T, [connected(bob)|In], [mint(5, 0)|Out?]) :-
    alice_p10_wait_minted(T?, In?, Out).
alice_p10_wait_connected(T, [_|In], Out?) :-
    otherwise | alice_p10_wait_connected(T?, In?, Out).
alice_p10_wait_connected(_, [], []).

procedure alice_p10_wait_minted(Constant?, UserNotifyStream?, UserCmdStream).
alice_p10_wait_minted(T, [minted(5, 0)|In],
                      [trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)])|Out?]) :-
    alice_p10_wait_trade(T?, In?, Out).
alice_p10_wait_minted(T, [_|In], Out?) :-
    otherwise | alice_p10_wait_minted(T?, In?, Out).
alice_p10_wait_minted(_, [], []).

procedure alice_p10_wait_trade(Constant?, UserNotifyStream?, UserCmdStream).
alice_p10_wait_trade(T, [trade_completed(bob)|In],
                     [deposit_escrow(bob, [lot(bob, 0, 3)], T?)|Out?]) :-
    alice_p10_wait_deposited(In?, Out).
alice_p10_wait_trade(T, [_|In], Out?) :-
    otherwise | alice_p10_wait_trade(T?, In?, Out).
alice_p10_wait_trade(_, [], []).

procedure alice_p10_wait_deposited(UserNotifyStream?, UserCmdStream).
alice_p10_wait_deposited([escrow_deposited(bob, _, _)|In], Out?) :-
    alice_p10_wait_expired(In?, Out).
alice_p10_wait_deposited([_|In], Out?) :-
    otherwise | alice_p10_wait_deposited(In?, Out).
alice_p10_wait_deposited([], []).

procedure alice_p10_wait_expired(UserNotifyStream?, UserCmdStream).
alice_p10_wait_expired([escrow_expired(bob)|In], [balance|Out?]) :-
    alice_p10_wait_balance(In?, Out).
alice_p10_wait_expired([_|In], Out?) :-
    otherwise | alice_p10_wait_expired(In?, Out).
alice_p10_wait_expired([], []).

procedure alice_p10_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p10_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p10_finish(In?, Out).
alice_p10_wait_balance([_|In], Out?) :-
    otherwise | alice_p10_wait_balance(In?, Out).
alice_p10_wait_balance([], []).

procedure alice_p10_finish(UserNotifyStream?, UserCmdStream).
alice_p10_finish(_, []).

%% --- Bob (play10) ---

procedure bob_p10(ActorChannel?).
bob_p10(ch([befriend(alice, ReqId)|In],
           [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p10_wait_connected(In?, Out).
bob_p10(ch([_|In], Out?)) :-
    otherwise | bob_p10(ch(In?, Out)).

procedure bob_p10_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p10_wait_connected([connected(alice)|In], Out?) :-
    bob_p10_wait_trade_proposed(In?, Out).
bob_p10_wait_connected([_|In], Out?) :-
    otherwise | bob_p10_wait_connected(In?, Out).
bob_p10_wait_connected([], []).

procedure bob_p10_wait_trade_proposed(UserNotifyStream?, UserCmdStream).
bob_p10_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                            [mint(5, 0)|Out?]) :-
    ground(ReqId?) |
    bob_p10_wait_minted(ReqId?, In?, Out).
bob_p10_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p10_wait_trade_proposed(In?, Out).
bob_p10_wait_trade_proposed([], []).

procedure bob_p10_wait_minted(ReqId?, UserNotifyStream?, UserCmdStream).
bob_p10_wait_minted(ReqId, [minted(5, 0)|In],
                    [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p10_wait_trade_completed(In?, Out).
bob_p10_wait_minted(ReqId, [_|In], Out?) :-
    otherwise | bob_p10_wait_minted(ReqId?, In?, Out).
bob_p10_wait_minted(_, [], []).

procedure bob_p10_wait_trade_completed(UserNotifyStream?, UserCmdStream).
bob_p10_wait_trade_completed([trade_completed(alice)|In], Out?) :-
    bob_p10_wait_escrow_received(In?, Out).
bob_p10_wait_trade_completed([_|In], Out?) :-
    otherwise | bob_p10_wait_trade_completed(In?, Out).
bob_p10_wait_trade_completed([], []).

procedure bob_p10_wait_escrow_received(UserNotifyStream?, UserCmdStream).
bob_p10_wait_escrow_received([escrow_received(alice, _)|In], Out?) :-
    bob_p10_wait_escrow_released(In?, Out).
bob_p10_wait_escrow_received([_|In], Out?) :-
    otherwise | bob_p10_wait_escrow_received(In?, Out).
bob_p10_wait_escrow_received([], []).

procedure bob_p10_wait_escrow_released(UserNotifyStream?, UserCmdStream).
bob_p10_wait_escrow_released([escrow_released(alice)|In], [balance|Out?]) :-
    bob_p10_wait_balance(In?, Out).
bob_p10_wait_escrow_released([_|In], Out?) :-
    otherwise | bob_p10_wait_escrow_released(In?, Out).
bob_p10_wait_escrow_released([], []).

procedure bob_p10_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p10_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p10_finish(In?, Out).
bob_p10_wait_balance([_|In], Out?) :-
    otherwise | bob_p10_wait_balance(In?, Out).
bob_p10_wait_balance([], []).

procedure bob_p10_finish(UserNotifyStream?, UserCmdStream).
bob_p10_finish(_, []).

%% =============================================================================
%% PLAY 11 — Credit + escrow cancel (via mint+trade+escrow)
%% =============================================================================
%%
%% Alice(T):
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(5, 0) → wait minted(5, 0)
%% 3. trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)]) → wait trade_completed(bob)
%% 4. deposit_escrow(bob, [lot(bob, 0, 3)], T) → wait escrow_deposited(bob, _, ReqId)
%% 5. cancel_escrow(bob, ReqId) → wait escrow_returned(bob)
%% 6. balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend → decision(yes) → wait connected
%% 2. Wait trade_proposed → mint(5, 0) → wait minted → accept_trade
%%    → wait trade_completed(alice)
%% 3. Wait escrow_received(alice, _) → wait escrow_cancelled(alice)
%% 4. balance → wait balance_report(_) → done

%% --- Alice (play11) ---

procedure alice_p11(Constant?, ActorChannel?).
alice_p11(T, ch(In, [connect(bob)|Out?])) :-
    ground(T?) |
    alice_p11_wait_connected(T?, In?, Out).

procedure alice_p11_wait_connected(Constant?, UserNotifyStream?, UserCmdStream).
alice_p11_wait_connected(T, [connected(bob)|In], [mint(5, 0)|Out?]) :-
    alice_p11_wait_minted(T?, In?, Out).
alice_p11_wait_connected(T, [_|In], Out?) :-
    otherwise | alice_p11_wait_connected(T?, In?, Out).
alice_p11_wait_connected(_, [], []).

procedure alice_p11_wait_minted(Constant?, UserNotifyStream?, UserCmdStream).
alice_p11_wait_minted(T, [minted(5, 0)|In],
                      [trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)])|Out?]) :-
    alice_p11_wait_trade(T?, In?, Out).
alice_p11_wait_minted(T, [_|In], Out?) :-
    otherwise | alice_p11_wait_minted(T?, In?, Out).
alice_p11_wait_minted(_, [], []).

procedure alice_p11_wait_trade(Constant?, UserNotifyStream?, UserCmdStream).
alice_p11_wait_trade(T, [trade_completed(bob)|In],
                     [deposit_escrow(bob, [lot(bob, 0, 3)], T?)|Out?]) :-
    alice_p11_wait_deposited(In?, Out).
alice_p11_wait_trade(T, [_|In], Out?) :-
    otherwise | alice_p11_wait_trade(T?, In?, Out).
alice_p11_wait_trade(_, [], []).

procedure alice_p11_wait_deposited(UserNotifyStream?, UserCmdStream).
alice_p11_wait_deposited([escrow_deposited(bob, _, ReqId)|In],
                         [cancel_escrow(bob, ReqId?)|Out?]) :-
    ground(ReqId?) |
    alice_p11_wait_returned(In?, Out).
alice_p11_wait_deposited([_|In], Out?) :-
    otherwise | alice_p11_wait_deposited(In?, Out).
alice_p11_wait_deposited([], []).

procedure alice_p11_wait_returned(UserNotifyStream?, UserCmdStream).
alice_p11_wait_returned([escrow_returned(bob)|In], [balance|Out?]) :-
    alice_p11_wait_balance(In?, Out).
alice_p11_wait_returned([_|In], Out?) :-
    otherwise | alice_p11_wait_returned(In?, Out).
alice_p11_wait_returned([], []).

procedure alice_p11_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p11_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p11_finish(In?, Out).
alice_p11_wait_balance([_|In], Out?) :-
    otherwise | alice_p11_wait_balance(In?, Out).
alice_p11_wait_balance([], []).

procedure alice_p11_finish(UserNotifyStream?, UserCmdStream).
alice_p11_finish(_, []).

%% --- Bob (play11) ---

procedure bob_p11(ActorChannel?).
bob_p11(ch([befriend(alice, ReqId)|In],
           [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p11_wait_connected(In?, Out).
bob_p11(ch([_|In], Out?)) :-
    otherwise | bob_p11(ch(In?, Out)).

procedure bob_p11_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p11_wait_connected([connected(alice)|In], Out?) :-
    bob_p11_wait_trade_proposed(In?, Out).
bob_p11_wait_connected([_|In], Out?) :-
    otherwise | bob_p11_wait_connected(In?, Out).
bob_p11_wait_connected([], []).

procedure bob_p11_wait_trade_proposed(UserNotifyStream?, UserCmdStream).
bob_p11_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                            [mint(5, 0)|Out?]) :-
    ground(ReqId?) |
    bob_p11_wait_minted(ReqId?, In?, Out).
bob_p11_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p11_wait_trade_proposed(In?, Out).
bob_p11_wait_trade_proposed([], []).

procedure bob_p11_wait_minted(ReqId?, UserNotifyStream?, UserCmdStream).
bob_p11_wait_minted(ReqId, [minted(5, 0)|In],
                    [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p11_wait_trade_completed(In?, Out).
bob_p11_wait_minted(ReqId, [_|In], Out?) :-
    otherwise | bob_p11_wait_minted(ReqId?, In?, Out).
bob_p11_wait_minted(_, [], []).

procedure bob_p11_wait_trade_completed(UserNotifyStream?, UserCmdStream).
bob_p11_wait_trade_completed([trade_completed(alice)|In], Out?) :-
    bob_p11_wait_escrow_received(In?, Out).
bob_p11_wait_trade_completed([_|In], Out?) :-
    otherwise | bob_p11_wait_trade_completed(In?, Out).
bob_p11_wait_trade_completed([], []).

procedure bob_p11_wait_escrow_received(UserNotifyStream?, UserCmdStream).
bob_p11_wait_escrow_received([escrow_received(alice, _)|In], Out?) :-
    bob_p11_wait_escrow_cancelled(In?, Out).
bob_p11_wait_escrow_received([_|In], Out?) :-
    otherwise | bob_p11_wait_escrow_received(In?, Out).
bob_p11_wait_escrow_received([], []).

procedure bob_p11_wait_escrow_cancelled(UserNotifyStream?, UserCmdStream).
bob_p11_wait_escrow_cancelled([escrow_cancelled(alice)|In], [balance|Out?]) :-
    bob_p11_wait_balance(In?, Out).
bob_p11_wait_escrow_cancelled([_|In], Out?) :-
    otherwise | bob_p11_wait_escrow_cancelled(In?, Out).
bob_p11_wait_escrow_cancelled([], []).

procedure bob_p11_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p11_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p11_finish(In?, Out).
bob_p11_wait_balance([_|In], Out?) :-
    otherwise | bob_p11_wait_balance(In?, Out).
bob_p11_wait_balance([], []).

procedure bob_p11_finish(UserNotifyStream?, UserCmdStream).
bob_p11_finish(_, []).
