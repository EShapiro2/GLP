%% bond_actors.glp - Scripted actors for Grassroots Bonds plays
%%
%% Phase 1: alice_p1 — solo mint + balance
%% Phase 2: alice_p2, bob_p2 — befriend + symmetric credit (mint+trade)
%% Phase 3: alice_p3, bob_p3 — credit + payment (mint+trade+trade)
%% Phase 4: alice_p4, bob_p4 — credit + redemption (mint+trade+trade)
%% Phase 4b: alice_p4b, bob_p4b — time-dependent redemption (mint+trade)
%% Phase 5: alice_p5, bob_p5 — zero-coupon loan (mint+trade)
%% Phase 6: alice_p6, bob_p6 — balloon loan (mint+trade)
%% Phase 8: alice_p8, bob_p8 — credit + sale of debt (mint+trade+trade)
%% Phase 9: alice_p9, bob_p9 — forward contract (mint+trade)
%% Phase 10: alice_p10, bob_p10 — credit + escrow time-release (mint+trade+escrow)
%% Phase 11: alice_p11, bob_p11 — credit + escrow cancel (mint+trade+escrow)
%%
%% Date: 2026-03-03

-mode(system).

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

Bond     ::= bond(Constant, Constant, Constant).
BondList ::= [] ; [Bond | BondList].

ReqId ::= req(Constant).

Lot     ::= lot(Constant, Constant, Constant).
LotList ::= [] ; [Lot | LotList].

%% User -> Mediator (actor writes these)
UserCmd ::= mint(Constant, Constant)
          ; balance
          ; done
          ; connect(Constant)
          ; decision(Decision, Constant, ReqId)
          ; trade(Constant, LotList, LotList)
          ; accept_trade(Constant, ReqId)
          ; reject_trade(Constant, ReqId)
          ; deposit_escrow(Constant, LotList, Constant)
          ; cancel_escrow(Constant, ReqId).

Decision ::= yes ; no.

%% Mediator -> User (actor reads these)
UserNotify ::= minted(Constant, Constant)
             ; balance_report(BondList)
             ; befriend(Constant, ReqId)
             ; connected(Constant)
             ; rejected
             ; rejected(Constant)
             ; trade_proposed(Constant, LotList, ReqId)
             ; trade_completed(Constant)
             ; trade_failed(Constant)
             ; trade_returned(Constant)
             ; escrow_deposited(Constant, Constant, ReqId)
             ; escrow_received(Constant, Constant)
             ; escrow_released(Constant)
             ; escrow_cancelled(Constant)
             ; escrow_expired(Constant)
             ; escrow_returned(Constant)
             ; escrow_failed(Constant)
             ; trade_returned_menu(Constant, BondList).

UserCmdStream    ::= [] ; [UserCmd | UserCmdStream].
UserNotifyStream ::= [] ; [UserNotify | UserNotifyStream].

ActorChannel ::= ch(UserNotifyStream, UserCmdStream?).

%% =============================================================================
%% PLAY 1 — Solo mint + balance
%% =============================================================================

procedure alice_p1(ActorChannel?).
alice_p1(ch(In, [mint(3, 0)|Out?])) :-
    alice_p1_wait_minted1(In?, Out).

procedure alice_p1_wait_minted1(UserNotifyStream?, UserCmdStream).
alice_p1_wait_minted1([minted(3, 0)|In], [mint(2, 10)|Out?]) :-
    alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted1([_|In], Out?) :-
    otherwise | alice_p1_wait_minted1(In?, Out).
alice_p1_wait_minted1([], []).

procedure alice_p1_wait_minted2(UserNotifyStream?, UserCmdStream).
alice_p1_wait_minted2([minted(2, 10)|In], [balance|Out?]) :-
    alice_p1_wait_balance(In?, Out).
alice_p1_wait_minted2([_|In], Out?) :-
    otherwise | alice_p1_wait_minted2(In?, Out).
alice_p1_wait_minted2([], []).

procedure alice_p1_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p1_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p1_finish(In?, Out).
alice_p1_wait_balance([_|In], Out?) :-
    otherwise | alice_p1_wait_balance(In?, Out).
alice_p1_wait_balance([], []).

procedure alice_p1_finish(UserNotifyStream?, UserCmdStream).
alice_p1_finish(_, []).

%% =============================================================================
%% PLAY 2 — Alice cold-calls Bob, then symmetric credit via mint+trade
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(3, 0) → wait minted(3, 0)
%% 3. trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)]) → wait trade_completed(bob)
%% 4. balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait trade_proposed(alice, _, ReqId2) → mint(3, 0) → wait minted(3, 0)
%%    → accept_trade(alice, ReqId2) → wait trade_completed(alice)
%% 4. balance → wait balance_report(_) → done

procedure alice_p2(ActorChannel?).
alice_p2(ch(In, [connect(bob)|Out?])) :-
    alice_p2_wait_connected(In?, Out).

procedure alice_p2_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p2_wait_connected([connected(bob)|In], [mint(3, 0)|Out?]) :-
    alice_p2_wait_minted(In?, Out).
alice_p2_wait_connected([_|In], Out?) :-
    otherwise | alice_p2_wait_connected(In?, Out).
alice_p2_wait_connected([], []).

procedure alice_p2_wait_minted(UserNotifyStream?, UserCmdStream).
alice_p2_wait_minted([minted(3, 0)|In],
                     [trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)])|Out?]) :-
    alice_p2_wait_trade(In?, Out).
alice_p2_wait_minted([_|In], Out?) :-
    otherwise | alice_p2_wait_minted(In?, Out).
alice_p2_wait_minted([], []).

procedure alice_p2_wait_trade(UserNotifyStream?, UserCmdStream).
alice_p2_wait_trade([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p2_wait_balance(In?, Out).
alice_p2_wait_trade([_|In], Out?) :-
    otherwise | alice_p2_wait_trade(In?, Out).
alice_p2_wait_trade([], []).

procedure alice_p2_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p2_finish(In?, Out).
alice_p2_wait_balance([_|In], Out?) :-
    otherwise | alice_p2_wait_balance(In?, Out).
alice_p2_wait_balance([], []).

procedure alice_p2_finish(UserNotifyStream?, UserCmdStream).
alice_p2_finish(_, []).

%% --- Bob (play2) ---

procedure bob_p2(ActorChannel?).
bob_p2(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p2_wait_connected(In?, Out).
bob_p2(ch([_|In], Out?)) :-
    otherwise | bob_p2(ch(In?, Out)).

procedure bob_p2_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p2_wait_connected([connected(alice)|In], Out?) :-
    bob_p2_wait_trade_proposed(In?, Out).
bob_p2_wait_connected([_|In], Out?) :-
    otherwise | bob_p2_wait_connected(In?, Out).
bob_p2_wait_connected([], []).

procedure bob_p2_wait_trade_proposed(UserNotifyStream?, UserCmdStream).
bob_p2_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                           [mint(3, 0)|Out?]) :-
    ground(ReqId?) |
    bob_p2_wait_minted(ReqId?, In?, Out).
bob_p2_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p2_wait_trade_proposed(In?, Out).
bob_p2_wait_trade_proposed([], []).

procedure bob_p2_wait_minted(ReqId?, UserNotifyStream?, UserCmdStream).
bob_p2_wait_minted(ReqId, [minted(3, 0)|In],
                   [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p2_wait_trade_completed(In?, Out).
bob_p2_wait_minted(ReqId, [_|In], Out?) :-
    otherwise | bob_p2_wait_minted(ReqId?, In?, Out).
bob_p2_wait_minted(_, [], []).

procedure bob_p2_wait_trade_completed(UserNotifyStream?, UserCmdStream).
bob_p2_wait_trade_completed([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p2_wait_balance(In?, Out).
bob_p2_wait_trade_completed([_|In], Out?) :-
    otherwise | bob_p2_wait_trade_completed(In?, Out).
bob_p2_wait_trade_completed([], []).

procedure bob_p2_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p2_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p2_finish(In?, Out).
bob_p2_wait_balance([_|In], Out?) :-
    otherwise | bob_p2_wait_balance(In?, Out).
bob_p2_wait_balance([], []).

procedure bob_p2_finish(UserNotifyStream?, UserCmdStream).
bob_p2_finish(_, []).

%% =============================================================================
%% PLAY 3 — Credit + payment (via mint+trade+trade)
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(3, 0) → wait minted(3, 0)
%% 3. trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)]) → wait trade_completed(bob)
%% 4. trade(bob, [lot(bob, 0, 2)], []) → wait trade_completed(bob)
%% 5. balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend(alice, ReqId) → decision(yes, alice, ReqId)
%% 2. Wait connected(alice)
%% 3. Wait trade_proposed → mint(3, 0) → wait minted → accept_trade
%%    → wait trade_completed(alice)
%% 4. Wait trade_completed(alice) — payment auto-accepted
%% 5. balance → wait balance_report(_) → done

procedure alice_p3(ActorChannel?).
alice_p3(ch(In, [connect(bob)|Out?])) :-
    alice_p3_wait_connected(In?, Out).

procedure alice_p3_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p3_wait_connected([connected(bob)|In], [mint(3, 0)|Out?]) :-
    alice_p3_wait_minted(In?, Out).
alice_p3_wait_connected([_|In], Out?) :-
    otherwise | alice_p3_wait_connected(In?, Out).
alice_p3_wait_connected([], []).

procedure alice_p3_wait_minted(UserNotifyStream?, UserCmdStream).
alice_p3_wait_minted([minted(3, 0)|In],
                     [trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)])|Out?]) :-
    alice_p3_wait_trade1(In?, Out).
alice_p3_wait_minted([_|In], Out?) :-
    otherwise | alice_p3_wait_minted(In?, Out).
alice_p3_wait_minted([], []).

procedure alice_p3_wait_trade1(UserNotifyStream?, UserCmdStream).
alice_p3_wait_trade1([trade_completed(bob)|In],
                     [trade(bob, [lot(bob, 0, 2)], [])|Out?]) :-
    alice_p3_wait_trade2(In?, Out).
alice_p3_wait_trade1([_|In], Out?) :-
    otherwise | alice_p3_wait_trade1(In?, Out).
alice_p3_wait_trade1([], []).

procedure alice_p3_wait_trade2(UserNotifyStream?, UserCmdStream).
alice_p3_wait_trade2([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p3_wait_balance(In?, Out).
alice_p3_wait_trade2([_|In], Out?) :-
    otherwise | alice_p3_wait_trade2(In?, Out).
alice_p3_wait_trade2([], []).

procedure alice_p3_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p3_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p3_finish(In?, Out).
alice_p3_wait_balance([_|In], Out?) :-
    otherwise | alice_p3_wait_balance(In?, Out).
alice_p3_wait_balance([], []).

procedure alice_p3_finish(UserNotifyStream?, UserCmdStream).
alice_p3_finish(_, []).

%% --- Bob (play3) ---

procedure bob_p3(ActorChannel?).
bob_p3(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p3_wait_connected(In?, Out).
bob_p3(ch([_|In], Out?)) :-
    otherwise | bob_p3(ch(In?, Out)).

procedure bob_p3_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p3_wait_connected([connected(alice)|In], Out?) :-
    bob_p3_wait_trade_proposed(In?, Out).
bob_p3_wait_connected([_|In], Out?) :-
    otherwise | bob_p3_wait_connected(In?, Out).
bob_p3_wait_connected([], []).

procedure bob_p3_wait_trade_proposed(UserNotifyStream?, UserCmdStream).
bob_p3_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                           [mint(3, 0)|Out?]) :-
    ground(ReqId?) |
    bob_p3_wait_minted(ReqId?, In?, Out).
bob_p3_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p3_wait_trade_proposed(In?, Out).
bob_p3_wait_trade_proposed([], []).

procedure bob_p3_wait_minted(ReqId?, UserNotifyStream?, UserCmdStream).
bob_p3_wait_minted(ReqId, [minted(3, 0)|In],
                   [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p3_wait_trade1(In?, Out).
bob_p3_wait_minted(ReqId, [_|In], Out?) :-
    otherwise | bob_p3_wait_minted(ReqId?, In?, Out).
bob_p3_wait_minted(_, [], []).

procedure bob_p3_wait_trade1(UserNotifyStream?, UserCmdStream).
bob_p3_wait_trade1([trade_completed(alice)|In], Out?) :-
    bob_p3_wait_trade2(In?, Out).
bob_p3_wait_trade1([_|In], Out?) :-
    otherwise | bob_p3_wait_trade1(In?, Out).
bob_p3_wait_trade1([], []).

procedure bob_p3_wait_trade2(UserNotifyStream?, UserCmdStream).
bob_p3_wait_trade2([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p3_wait_balance(In?, Out).
bob_p3_wait_trade2([_|In], Out?) :-
    otherwise | bob_p3_wait_trade2(In?, Out).
bob_p3_wait_trade2([], []).

procedure bob_p3_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p3_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p3_finish(In?, Out).
bob_p3_wait_balance([_|In], Out?) :-
    otherwise | bob_p3_wait_balance(In?, Out).
bob_p3_wait_balance([], []).

procedure bob_p3_finish(UserNotifyStream?, UserCmdStream).
bob_p3_finish(_, []).

%% =============================================================================
%% PLAY 4 — Credit + redemption (via mint+trade+trade)
%% =============================================================================
%%
%% Alice:
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(3, 0) → wait minted(3, 0)
%% 3. trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)]) → wait trade_completed(bob)
%% 4. trade(bob, [lot(bob, 0, 2)], [lot(alice, 0, 2)]) → wait trade_completed(bob)
%% 5. balance → wait balance_report(_) → done
%%
%% Bob:
%% 1. Wait befriend → decision(yes) → wait connected
%% 2. Wait trade_proposed → mint(3, 0) → wait minted → accept_trade
%%    → wait trade_completed(alice)
%% 3. Wait trade_completed(alice) — redemption auto-accepted
%% 4. balance → wait balance_report(_) → done

procedure alice_p4(ActorChannel?).
alice_p4(ch(In, [connect(bob)|Out?])) :-
    alice_p4_wait_connected(In?, Out).

procedure alice_p4_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p4_wait_connected([connected(bob)|In], [mint(3, 0)|Out?]) :-
    alice_p4_wait_minted(In?, Out).
alice_p4_wait_connected([_|In], Out?) :-
    otherwise | alice_p4_wait_connected(In?, Out).
alice_p4_wait_connected([], []).

procedure alice_p4_wait_minted(UserNotifyStream?, UserCmdStream).
alice_p4_wait_minted([minted(3, 0)|In],
                     [trade(bob, [lot(alice, 0, 3)], [lot(bob, 0, 3)])|Out?]) :-
    alice_p4_wait_trade1(In?, Out).
alice_p4_wait_minted([_|In], Out?) :-
    otherwise | alice_p4_wait_minted(In?, Out).
alice_p4_wait_minted([], []).

procedure alice_p4_wait_trade1(UserNotifyStream?, UserCmdStream).
alice_p4_wait_trade1([trade_completed(bob)|In],
                     [trade(bob, [lot(bob, 0, 2)], [lot(alice, 0, 2)])|Out?]) :-
    alice_p4_wait_trade2(In?, Out).
alice_p4_wait_trade1([_|In], Out?) :-
    otherwise | alice_p4_wait_trade1(In?, Out).
alice_p4_wait_trade1([], []).

procedure alice_p4_wait_trade2(UserNotifyStream?, UserCmdStream).
alice_p4_wait_trade2([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4_wait_balance(In?, Out).
alice_p4_wait_trade2([_|In], Out?) :-
    otherwise | alice_p4_wait_trade2(In?, Out).
alice_p4_wait_trade2([], []).

procedure alice_p4_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p4_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p4_finish(In?, Out).
alice_p4_wait_balance([_|In], Out?) :-
    otherwise | alice_p4_wait_balance(In?, Out).
alice_p4_wait_balance([], []).

procedure alice_p4_finish(UserNotifyStream?, UserCmdStream).
alice_p4_finish(_, []).

%% --- Bob (play4) ---

procedure bob_p4(ActorChannel?).
bob_p4(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
    ground(ReqId?) |
    bob_p4_wait_connected(In?, Out).
bob_p4(ch([_|In], Out?)) :-
    otherwise | bob_p4(ch(In?, Out)).

procedure bob_p4_wait_connected(UserNotifyStream?, UserCmdStream).
bob_p4_wait_connected([connected(alice)|In], Out?) :-
    bob_p4_wait_trade_proposed(In?, Out).
bob_p4_wait_connected([_|In], Out?) :-
    otherwise | bob_p4_wait_connected(In?, Out).
bob_p4_wait_connected([], []).

procedure bob_p4_wait_trade_proposed(UserNotifyStream?, UserCmdStream).
bob_p4_wait_trade_proposed([trade_proposed(alice, _, ReqId)|In],
                           [mint(3, 0)|Out?]) :-
    ground(ReqId?) |
    bob_p4_wait_minted(ReqId?, In?, Out).
bob_p4_wait_trade_proposed([_|In], Out?) :-
    otherwise | bob_p4_wait_trade_proposed(In?, Out).
bob_p4_wait_trade_proposed([], []).

procedure bob_p4_wait_minted(ReqId?, UserNotifyStream?, UserCmdStream).
bob_p4_wait_minted(ReqId, [minted(3, 0)|In],
                   [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p4_wait_trade1(In?, Out).
bob_p4_wait_minted(ReqId, [_|In], Out?) :-
    otherwise | bob_p4_wait_minted(ReqId?, In?, Out).
bob_p4_wait_minted(_, [], []).

procedure bob_p4_wait_trade1(UserNotifyStream?, UserCmdStream).
bob_p4_wait_trade1([trade_completed(alice)|In], Out?) :-
    bob_p4_wait_trade2(In?, Out).
bob_p4_wait_trade1([_|In], Out?) :-
    otherwise | bob_p4_wait_trade1(In?, Out).
bob_p4_wait_trade1([], []).

procedure bob_p4_wait_trade2(UserNotifyStream?, UserCmdStream).
bob_p4_wait_trade2([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p4_wait_balance(In?, Out).
bob_p4_wait_trade2([_|In], Out?) :-
    otherwise | bob_p4_wait_trade2(In?, Out).
bob_p4_wait_trade2([], []).

procedure bob_p4_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p4_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p4_finish(In?, Out).
bob_p4_wait_balance([_|In], Out?) :-
    otherwise | bob_p4_wait_balance(In?, Out).
bob_p4_wait_balance([], []).

procedure bob_p4_finish(UserNotifyStream?, UserCmdStream).
bob_p4_finish(_, []).

%% =============================================================================
%% PLAY 4b — Time-dependent: coin credit + bond credit (via mint+trade)
%% =============================================================================
%%
%% Alice(T):
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(5, 0) → wait minted(5, 0)
%% 3. trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)]) → wait trade_completed(bob)
%% 4. mint(5, T) → wait minted(5, T)
%% 5. trade(bob, [lot(alice, T, 5)], [lot(bob, T, 5)]) → wait trade_completed(bob)
%% 6. trade(bob, [lot(bob, 0, 2)], [lot(alice, T, 2)]) → wait trade_completed(bob)
%% 7. balance → wait balance_report(_) → wait(500)
%% 8. trade(bob, [lot(bob, 0, 2)], [lot(alice, 0, 2)]) → wait trade_completed(bob)
%% 9. balance → done
%%
%% Bob(T):
%% 1. Wait befriend → decision(yes) → wait connected
%% 2. Wait trade_proposed → mint(5, 0) → wait minted → accept_trade
%%    → wait trade_completed
%% 3. Wait trade_proposed → mint(5, T) → wait minted → accept_trade
%% 4. Wait trade_completed (accept) → wait trade_completed (pre-maturity auto)
%%    → wait trade_completed (post-maturity auto, after wait(500))
%% 5. balance → done

procedure alice_p4b(ActorChannel?, Constant?).
alice_p4b(ch(In, [connect(bob)|Out?]), T) :-
    alice_p4b_wait_connected(T?, In?, Out).

procedure alice_p4b_wait_connected(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_connected(T, [connected(bob)|In], [mint(5, 0)|Out?]) :-
    alice_p4b_wait_minted1(T?, In?, Out).
alice_p4b_wait_connected(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_connected(T?, In?, Out).
alice_p4b_wait_connected(_, [], []).

procedure alice_p4b_wait_minted1(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_minted1(T, [minted(5, 0)|In],
                       [trade(bob, [lot(alice, 0, 5)], [lot(bob, 0, 5)])|Out?]) :-
    alice_p4b_wait_trade1(T?, In?, Out).
alice_p4b_wait_minted1(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_minted1(T?, In?, Out).
alice_p4b_wait_minted1(_, [], []).

procedure alice_p4b_wait_trade1(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_trade1(T, [trade_completed(bob)|In], [mint(5, T?)|Out?]) :-
    alice_p4b_wait_minted2(T?, In?, Out).
alice_p4b_wait_trade1(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_trade1(T?, In?, Out).
alice_p4b_wait_trade1(_, [], []).

procedure alice_p4b_wait_minted2(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_minted2(T, [minted(5, _)|In],
                       [trade(bob, [lot(alice, T?, 5)], [lot(bob, T?, 5)])|Out?]) :-
    alice_p4b_wait_trade2(T?, In?, Out).
alice_p4b_wait_minted2(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_minted2(T?, In?, Out).
alice_p4b_wait_minted2(_, [], []).

procedure alice_p4b_wait_trade2(Constant?, UserNotifyStream?, UserCmdStream).
alice_p4b_wait_trade2(T, [trade_completed(bob)|In],
                      [trade(bob, [lot(bob, 0, 2)], [lot(alice, T?, 2)])|Out?]) :-
    alice_p4b_wait_trade3(In?, Out).
alice_p4b_wait_trade2(T, [_|In], Out?) :-
    otherwise | alice_p4b_wait_trade2(T?, In?, Out).
alice_p4b_wait_trade2(_, [], []).

procedure alice_p4b_wait_trade3(UserNotifyStream?, UserCmdStream).
alice_p4b_wait_trade3([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4b_wait_balance1(In?, Out).
alice_p4b_wait_trade3([_|In], Out?) :-
    otherwise | alice_p4b_wait_trade3(In?, Out).
alice_p4b_wait_trade3([], []).

%% Wait for balance report, then wait 500ms, then trade again (post-maturity)
procedure alice_p4b_wait_balance1(UserNotifyStream?, UserCmdStream).
alice_p4b_wait_balance1([balance_report(_)|In],
                        [trade(bob, [lot(bob, 0, 2)], [lot(alice, 0, 2)])|Out?]) :-
    wait(500) |
    alice_p4b_wait_trade4(In?, Out).
alice_p4b_wait_balance1([_|In], Out?) :-
    otherwise | alice_p4b_wait_balance1(In?, Out).
alice_p4b_wait_balance1([], []).

procedure alice_p4b_wait_trade4(UserNotifyStream?, UserCmdStream).
alice_p4b_wait_trade4([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p4b_wait_balance2(In?, Out).
alice_p4b_wait_trade4([_|In], Out?) :-
    otherwise | alice_p4b_wait_trade4(In?, Out).
alice_p4b_wait_trade4([], []).

procedure alice_p4b_wait_balance2(UserNotifyStream?, UserCmdStream).
alice_p4b_wait_balance2([balance_report(_)|In], [done|Out?]) :-
    alice_p4b_finish(In?, Out).
alice_p4b_wait_balance2([_|In], Out?) :-
    otherwise | alice_p4b_wait_balance2(In?, Out).
alice_p4b_wait_balance2([], []).

procedure alice_p4b_finish(UserNotifyStream?, UserCmdStream).
alice_p4b_finish(_, []).

%% --- Bob (play4b) ---

procedure bob_p4b(ActorChannel?, Constant?).
bob_p4b(ch([befriend(alice, ReqId)|In],
           [decision(yes, alice, ReqId?)|Out?]), T) :-
    ground(ReqId?) |
    bob_p4b_wait_connected(T?, In?, Out).
bob_p4b(ch([_|In], Out?), T) :-
    otherwise | bob_p4b(ch(In?, Out), T?).

procedure bob_p4b_wait_connected(Constant?, UserNotifyStream?, UserCmdStream).
bob_p4b_wait_connected(T, [connected(alice)|In], Out?) :-
    bob_p4b_wait_trade_proposed1(T?, In?, Out).
bob_p4b_wait_connected(T, [_|In], Out?) :-
    otherwise | bob_p4b_wait_connected(T?, In?, Out).
bob_p4b_wait_connected(_, [], []).

%% Wait for first trade proposal (coin credit)
procedure bob_p4b_wait_trade_proposed1(Constant?, UserNotifyStream?, UserCmdStream).
bob_p4b_wait_trade_proposed1(T, [trade_proposed(alice, _, ReqId)|In],
                             [mint(5, 0)|Out?]) :-
    ground(ReqId?) |
    bob_p4b_wait_minted1(T?, ReqId?, In?, Out).
bob_p4b_wait_trade_proposed1(T, [_|In], Out?) :-
    otherwise | bob_p4b_wait_trade_proposed1(T?, In?, Out).
bob_p4b_wait_trade_proposed1(_, [], []).

procedure bob_p4b_wait_minted1(Constant?, ReqId?, UserNotifyStream?, UserCmdStream).
bob_p4b_wait_minted1(T, ReqId, [minted(5, 0)|In],
                     [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p4b_wait_trade_completed1(T?, In?, Out).
bob_p4b_wait_minted1(T, ReqId, [_|In], Out?) :-
    otherwise | bob_p4b_wait_minted1(T?, ReqId?, In?, Out).
bob_p4b_wait_minted1(_, _, [], []).

procedure bob_p4b_wait_trade_completed1(Constant?, UserNotifyStream?, UserCmdStream).
bob_p4b_wait_trade_completed1(T, [trade_completed(alice)|In], Out?) :-
    bob_p4b_wait_trade_proposed2(T?, In?, Out).
bob_p4b_wait_trade_completed1(T, [_|In], Out?) :-
    otherwise | bob_p4b_wait_trade_completed1(T?, In?, Out).
bob_p4b_wait_trade_completed1(_, [], []).

%% Wait for second trade proposal (bond credit)
procedure bob_p4b_wait_trade_proposed2(Constant?, UserNotifyStream?, UserCmdStream).
bob_p4b_wait_trade_proposed2(T, [trade_proposed(alice, _, ReqId)|In],
                             [mint(5, T?)|Out?]) :-
    ground(ReqId?) |
    bob_p4b_wait_minted2(ReqId?, In?, Out).
bob_p4b_wait_trade_proposed2(T, [_|In], Out?) :-
    otherwise | bob_p4b_wait_trade_proposed2(T?, In?, Out).
bob_p4b_wait_trade_proposed2(_, [], []).

procedure bob_p4b_wait_minted2(ReqId?, UserNotifyStream?, UserCmdStream).
bob_p4b_wait_minted2(ReqId, [minted(5, _)|In],
                     [accept_trade(alice, ReqId?)|Out?]) :-
    bob_p4b_wait_auto1(In?, Out).
bob_p4b_wait_minted2(ReqId, [_|In], Out?) :-
    otherwise | bob_p4b_wait_minted2(ReqId?, In?, Out).
bob_p4b_wait_minted2(_, [], []).

%% Wait for three trade_completed(alice) notifications:
%%   auto1: from accepting bond-credit trade (second accept_trade)
%%   auto2: pre-maturity redemption (auto-accepted)
%%   auto3: post-maturity redemption (auto-accepted, arrives after wait(500))
procedure bob_p4b_wait_auto1(UserNotifyStream?, UserCmdStream).
bob_p4b_wait_auto1([trade_completed(alice)|In], Out?) :-
    bob_p4b_wait_auto2(In?, Out).
bob_p4b_wait_auto1([_|In], Out?) :-
    otherwise | bob_p4b_wait_auto1(In?, Out).
bob_p4b_wait_auto1([], []).

procedure bob_p4b_wait_auto2(UserNotifyStream?, UserCmdStream).
bob_p4b_wait_auto2([trade_completed(alice)|In], Out?) :-
    bob_p4b_wait_auto3(In?, Out).
bob_p4b_wait_auto2([_|In], Out?) :-
    otherwise | bob_p4b_wait_auto2(In?, Out).
bob_p4b_wait_auto2([], []).

procedure bob_p4b_wait_auto3(UserNotifyStream?, UserCmdStream).
bob_p4b_wait_auto3([trade_completed(alice)|In], [balance|Out?]) :-
    bob_p4b_wait_balance(In?, Out).
bob_p4b_wait_auto3([_|In], Out?) :-
    otherwise | bob_p4b_wait_auto3(In?, Out).
bob_p4b_wait_auto3([], []).

procedure bob_p4b_wait_balance(UserNotifyStream?, UserCmdStream).
bob_p4b_wait_balance([balance_report(_)|In], [done|Out?]) :-
    bob_p4b_finish(In?, Out).
bob_p4b_wait_balance([_|In], Out?) :-
    otherwise | bob_p4b_wait_balance(In?, Out).
bob_p4b_wait_balance([], []).

procedure bob_p4b_finish(UserNotifyStream?, UserCmdStream).
bob_p4b_finish(_, []).

%% =============================================================================
%% PLAY 5 — Zero-coupon loan (via mint+trade)
%% =============================================================================
%%
%% Alice (lender):
%% 1. connect(bob) → wait connected(bob)
%% 2. mint(9, 0) → wait minted(9, 0)
%% 3. trade(bob, [lot(alice, 0, 9)], [lot(bob, 5, 10)]) → wait trade_completed(bob)
%% 4. balance → wait balance_report(_) → done
%%
%% Bob (borrower):
%% 1. Wait befriend → decision(yes) → wait connected
%% 2. Wait trade_proposed → mint(10, 5) → wait minted → accept_trade
%%    → wait trade_completed(alice)
%% 3. balance → wait balance_report(_) → done

procedure alice_p5(ActorChannel?).
alice_p5(ch(In, [connect(bob)|Out?])) :-
    alice_p5_wait_connected(In?, Out).

procedure alice_p5_wait_connected(UserNotifyStream?, UserCmdStream).
alice_p5_wait_connected([connected(bob)|In], [mint(9, 0)|Out?]) :-
    alice_p5_wait_minted(In?, Out).
alice_p5_wait_connected([_|In], Out?) :-
    otherwise | alice_p5_wait_connected(In?, Out).
alice_p5_wait_connected([], []).

procedure alice_p5_wait_minted(UserNotifyStream?, UserCmdStream).
alice_p5_wait_minted([minted(9, 0)|In],
                     [trade(bob, [lot(alice, 0, 9)], [lot(bob, 5, 10)])|Out?]) :-
    alice_p5_wait_trade(In?, Out).
alice_p5_wait_minted([_|In], Out?) :-
    otherwise | alice_p5_wait_minted(In?, Out).
alice_p5_wait_minted([], []).

procedure alice_p5_wait_trade(UserNotifyStream?, UserCmdStream).
alice_p5_wait_trade([trade_completed(bob)|In], [balance|Out?]) :-
    alice_p5_wait_balance(In?, Out).
alice_p5_wait_trade([_|In], Out?) :-
    otherwise | alice_p5_wait_trade(In?, Out).
alice_p5_wait_trade([], []).

procedure alice_p5_wait_balance(UserNotifyStream?, UserCmdStream).
alice_p5_wait_balance([balance_report(_)|In], [done|Out?]) :-
    alice_p5_finish(In?, Out).
alice_p5_wait_balance([_|In], Out?) :-
    otherwise | alice_p5_wait_balance(In?, Out).
alice_p5_wait_balance([], []).

procedure alice_p5_finish(UserNotifyStream?, UserCmdStream).
alice_p5_finish(_, []).

%% --- Bob (play5) ---

procedure bob_p5(ActorChannel?).
bob_p5(ch([befriend(alice, ReqId)|In],
          [decision(yes, alice, ReqId?)|Out?])) :-
