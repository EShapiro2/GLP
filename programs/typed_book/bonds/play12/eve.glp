%% eve.glp -- Teacher actor for Play 12 (Village Market Month)
%%
%% Eve accepts befriends from Alice and Charlie (concurrent, any order),
%% then connects to Frank.
%% Symmetric trade with Charlie (10-for-10).
%% Symmetric trade with Frank (10-for-10).
%% Pays Charlie (bookshelf), trades with Charlie for alice-coins,
%% pays Alice (bread).
%% Act 7: accepts Alice's debt-sale proposal.
%%
%% Types: from self.glp (ancestor scoping)

-mode(system).

procedure eve_p12(ActorChannel?, NarrativeStream).
eve_p12(ch(In, Out?), Narr?) :-
    eve_p12_gather(none, none, In?, Out, Narr).

%% Gather befriends from Alice and Charlie (2 actors, any order).
%% AS = alice status, CS = charlie status.
%% Status atoms: none → befriended → done.
procedure eve_p12_gather(Constant?, Constant?, UserNotifyStream?, UserCmdStream, NarrativeStream).

%% Both connected — proceed to connect Frank
eve_p12_gather(done, done, In, [connect(frank)|Out?], Narr?) :-
    eve_p12_wait_connected_frank(In?, Out, Narr).

%% Befriend from Alice
eve_p12_gather(none, CS, [befriend(alice, ReqId)|In],
               [decision(yes, alice, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) |
    eve_p12_gather(befriended, CS?, In?, Out, Narr).

%% Connected Alice
eve_p12_gather(befriended, CS, [connected(alice)|In], Out?,
               [friend(alice)|Narr?]) :-
    eve_p12_gather(done, CS?, In?, Out, Narr).

%% Befriend from Charlie
eve_p12_gather(AS, none, [befriend(charlie, ReqId)|In],
               [decision(yes, charlie, ReqId?)|Out?], Narr?) :-
    ground(ReqId?) |
    eve_p12_gather(AS?, befriended, In?, Out, Narr).

%% Connected Charlie
eve_p12_gather(AS, befriended, [connected(charlie)|In], Out?,
               [friend(charlie)|Narr?]) :-
    eve_p12_gather(AS?, done, In?, Out, Narr).

%% Skip other messages
eve_p12_gather(AS, CS, [_|In], Out?, Narr?) :-
    otherwise | eve_p12_gather(AS?, CS?, In?, Out, Narr).
eve_p12_gather(_, _, [], [], []).

procedure eve_p12_wait_connected_frank(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_connected_frank([connected(frank)|In],
                             [mint(10, 0)|Out?],
                             [friend(frank)|Narr?]) :-
    eve_p12_wait_minted1(In?, Out, Narr).
eve_p12_wait_connected_frank([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_connected_frank(In?, Out, Narr).
eve_p12_wait_connected_frank([], [], []).

%% Act 2d: Mint eve-coins for symmetric trade with Charlie
procedure eve_p12_wait_minted1(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_minted1([minted(10, 0)|In], Out?, Narr?) :-
    eve_p12_wait_trade_charlie(In?, Out, Narr).
eve_p12_wait_minted1([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_minted1(In?, Out, Narr).
eve_p12_wait_minted1([], [], []).

%% Accept Charlie's symmetric trade proposal
procedure eve_p12_wait_trade_charlie(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_trade_charlie([trade_proposed(charlie, _, ReqId)|In],
                           [accept_trade(charlie, ReqId?), mint(10, 0)|Out?],
                           [say('Charlie, 10 for 10 — works for me'),
                            act('Credit line with Charlie: 10 eve-coins for 10 charlie-coins')|Narr?]) :-
    ground(ReqId?) |
    eve_p12_wait_minted2(In?, Out, Narr).
eve_p12_wait_trade_charlie([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_trade_charlie(In?, Out, Narr).
eve_p12_wait_trade_charlie([], [], []).

%% Act 2f: Mint eve-coins for symmetric trade with Frank
procedure eve_p12_wait_minted2(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_minted2([minted(10, 0)|In],
                     [trade(frank, [lot(eve, 0, 10)], [lot(frank, 0, 10)])|Out?],
                     [say('Frank, were family — 10 for 10')|Narr?]) :-
    eve_p12_wait_trade_frank(In?, Out, Narr).
eve_p12_wait_minted2([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_minted2(In?, Out, Narr).
eve_p12_wait_minted2([], [], []).

procedure eve_p12_wait_trade_frank(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_trade_frank([trade_completed(frank)|In],
                         [pay(charlie, 6)|Out?],
                         [act('Credit line with Frank: 10 eve-coins for 10 frank-coins'),
                          say('Charlie, 6 coins for the bookshelf')|Narr?]) :-
    eve_p12_wait_paid_charlie(In?, Out, Narr).
eve_p12_wait_trade_frank([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_trade_frank(In?, Out, Narr).
eve_p12_wait_trade_frank([], [], []).

%% Act 3c: Eve pays Charlie for bookshelf
procedure eve_p12_wait_paid_charlie(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_paid_charlie([paid(charlie, 6)|In],
                          [trade(charlie, [lot(frank, 0, 5)], [lot(alice, 0, 5)])|Out?],
                          [act('Paid Charlie 6 for bookshelf'),
                           say('Charlie, can I swap 5 frank-coins for 5 alice-coins?')|Narr?]) :-
    eve_p12_wait_trade_charlie2(In?, Out, Narr).
eve_p12_wait_paid_charlie([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_paid_charlie(In?, Out, Narr).
eve_p12_wait_paid_charlie([], [], []).

%% Act 4a: Eve trades frank-coins for alice-coins with Charlie
procedure eve_p12_wait_trade_charlie2(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_trade_charlie2([trade_completed(charlie)|In],
                            [pay(alice, 3)|Out?],
                            [act('Swap with Charlie: 5 frank-coins for 5 alice-coins'),
                             say('Alice, 3 loaves please')|Narr?]) :-
    eve_p12_wait_paid_alice(In?, Out, Narr).
eve_p12_wait_trade_charlie2([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_trade_charlie2(In?, Out, Narr).
eve_p12_wait_trade_charlie2([], [], []).

%% Act 4b: Eve pays Alice for bread
procedure eve_p12_wait_paid_alice(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_paid_alice([paid(alice, 3)|In], Out?,
                        [act('Paid Alice 3 for bread')|Narr?]) :-
    eve_p12_wait_trade_alice(In?, Out, Narr).
eve_p12_wait_paid_alice([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_paid_alice(In?, Out, Narr).
eve_p12_wait_paid_alice([], [], []).

%% Act 7: Accept Alice's debt-sale proposal (skip negotiation)
procedure eve_p12_wait_trade_alice(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_trade_alice([trade_proposed(alice, _, ReqId)|In],
                         [accept_trade(alice, ReqId?), balance|Out?],
                         [say('Alice, deal — 4 frank-coins for 10 bob-bonds'),
                          act('Bought debt: 10 bob-bonds from Alice for 4 frank-coins')|Narr?]) :-
    ground(ReqId?) |
    eve_p12_wait_balance(In?, Out, Narr).
eve_p12_wait_trade_alice([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_trade_alice(In?, Out, Narr).
eve_p12_wait_trade_alice([], [], []).

procedure eve_p12_wait_balance(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_wait_balance([balance_report(_)|In], [done|Out?],
                     [act('Balance: 10 bob-coins, 2 alice-coins, 4 charlie-coins, 1 frank-coin')|Narr?]) :-
    eve_p12_finish(In?, Out, Narr).
eve_p12_wait_balance([_|In], Out?, Narr?) :-
    otherwise | eve_p12_wait_balance(In?, Out, Narr).
eve_p12_wait_balance([], [], []).

procedure eve_p12_finish(UserNotifyStream?, UserCmdStream, NarrativeStream).
eve_p12_finish(_, [], []).
