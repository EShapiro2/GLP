%% charlie.glp -- Carpenter actor for Play 12 (Village Market Month)
%%
%% Charlie accepts Alice's befriend, connects to Eve and Frank.
%% Symmetric trade with Alice (15-for-15).
%% Symmetric trade with Eve (10-for-10).
%% Receives payment from Eve (bookshelf).
%% Deposits escrow with Frank (dock construction).
%%
%% Takes T (escrow release time) as parameter.
%% Types: from self.glp (ancestor scoping)

-module(charlie).
-mode(system).

exported procedure charlie_p12(Constant?, ActorChannel?).
charlie_p12(T, ch(In, Out?)) :-
    ground(T?) |
    charlie_p12_wait_befriend_alice(T?, In?, Out).

%% Act 1: Accept Alice's befriend request
procedure charlie_p12_wait_befriend_alice(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_befriend_alice(T, [befriend(alice, ReqId)|In],
                                [decision(yes, alice, ReqId?)|Out?]) :-
    ground(ReqId?) |
    charlie_p12_wait_connected_alice(T?, In?, Out).
charlie_p12_wait_befriend_alice(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_befriend_alice(T?, In?, Out).
charlie_p12_wait_befriend_alice(_, [], []).

procedure charlie_p12_wait_connected_alice(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_connected_alice(T, [connected(alice)|In],
                                 [connect(eve)|Out?]) :-
    charlie_p12_wait_connected_eve(T?, In?, Out).
charlie_p12_wait_connected_alice(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_connected_alice(T?, In?, Out).
charlie_p12_wait_connected_alice(_, [], []).

procedure charlie_p12_wait_connected_eve(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_connected_eve(T, [connected(eve)|In],
                               [connect(frank)|Out?]) :-
    charlie_p12_wait_connected_frank(T?, In?, Out).
charlie_p12_wait_connected_eve(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_connected_eve(T?, In?, Out).
charlie_p12_wait_connected_eve(_, [], []).

procedure charlie_p12_wait_connected_frank(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_connected_frank(T, [connected(frank)|In],
                                 [mint(15, 0)|Out?]) :-
    charlie_p12_wait_minted1(T?, In?, Out).
charlie_p12_wait_connected_frank(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_connected_frank(T?, In?, Out).
charlie_p12_wait_connected_frank(_, [], []).

%% Act 2b: Mint charlie-coins for symmetric trade with Alice
procedure charlie_p12_wait_minted1(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_minted1(T, [minted(15, 0)|In], Out?) :-
    charlie_p12_wait_trade_alice(T?, In?, Out).
charlie_p12_wait_minted1(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_minted1(T?, In?, Out).
charlie_p12_wait_minted1(_, [], []).

%% Accept Alice's symmetric trade proposal
procedure charlie_p12_wait_trade_alice(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_trade_alice(T, [trade_proposed(alice, _, ReqId)|In],
                             [accept_trade(alice, ReqId?), mint(10, 0)|Out?]) :-
    ground(ReqId?) |
    charlie_p12_wait_minted2(T?, In?, Out).
charlie_p12_wait_trade_alice(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_trade_alice(T?, In?, Out).
charlie_p12_wait_trade_alice(_, [], []).

%% Act 2d: Mint charlie-coins for symmetric trade with Eve
procedure charlie_p12_wait_minted2(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_minted2(T, [minted(10, 0)|In],
                         [trade(eve, [lot(charlie, 0, 10)], [lot(eve, 0, 10)])|Out?]) :-
    charlie_p12_wait_trade_eve(T?, In?, Out).
charlie_p12_wait_minted2(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_minted2(T?, In?, Out).
charlie_p12_wait_minted2(_, [], []).

procedure charlie_p12_wait_trade_eve(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_trade_eve(T, [trade_completed(eve)|In], Out?) :-
    charlie_p12_wait_payment_eve(T?, In?, Out).
charlie_p12_wait_trade_eve(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_trade_eve(T?, In?, Out).
charlie_p12_wait_trade_eve(_, [], []).

%% Act 3c: Eve buys bookshelf (payment_received)
procedure charlie_p12_wait_payment_eve(Constant?, UserNotifyStream?, UserCmdStream).
charlie_p12_wait_payment_eve(T, [payment_received(eve, 6)|In],
                             [deposit_escrow(frank, [lot(alice, 0, 8)], T?)|Out?]) :-
    charlie_p12_wait_escrow_deposited(In?, Out).
charlie_p12_wait_payment_eve(T, [_|In], Out?) :-
    otherwise | charlie_p12_wait_payment_eve(T?, In?, Out).
charlie_p12_wait_payment_eve(_, [], []).

%% Act 5: Escrow deposited, wait for expiry (dock done)
procedure charlie_p12_wait_escrow_deposited(UserNotifyStream?, UserCmdStream).
charlie_p12_wait_escrow_deposited([escrow_deposited(frank, _, _)|In], Out?) :-
    charlie_p12_wait_escrow_expired(In?, Out).
charlie_p12_wait_escrow_deposited([_|In], Out?) :-
    otherwise | charlie_p12_wait_escrow_deposited(In?, Out).
charlie_p12_wait_escrow_deposited([], []).

procedure charlie_p12_wait_escrow_expired(UserNotifyStream?, UserCmdStream).
charlie_p12_wait_escrow_expired([escrow_expired(frank)|In], [balance|Out?]) :-
    charlie_p12_wait_balance(In?, Out).
charlie_p12_wait_escrow_expired([_|In], Out?) :-
    otherwise | charlie_p12_wait_escrow_expired(In?, Out).
charlie_p12_wait_escrow_expired([], []).

procedure charlie_p12_wait_balance(UserNotifyStream?, UserCmdStream).
charlie_p12_wait_balance([balance_report(_)|In], [done|Out?]) :-
    charlie_p12_finish(In?, Out).
charlie_p12_wait_balance([_|In], Out?) :-
    otherwise | charlie_p12_wait_balance(In?, Out).
charlie_p12_wait_balance([], []).

procedure charlie_p12_finish(UserNotifyStream?, UserCmdStream).
charlie_p12_finish(_, []).
