%% bond_agent.glp - Bond agent for Grassroots Bonds
%%
%% Extends the social graph agent (agent/4) to agent/6 with:
%%   - Holdings: list of bonds held by this agent
%%   - NextSerial: next serial number for minting
%%
%% Phase 1: mint + balance + done (single-agent, no network)
%% Phase 2: social graph befriending + symmetric credit line
%% Phase 3: payment (unilateral coin transfer between friends)
%%
%% Date: 2026-03-03

-mode(system).

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Stream and Channel are predefined in prelude:
%%   Stream ::= [] ; [_|Stream].
%%   Channel ::= ch(Stream, Stream?).

%% Bond representation: bond(Issuer, Maturity, Serial)
Bond     ::= bond(Constant, Constant, Constant).
BondList ::= [] ; [Bond | BondList].

%% Credit response — written by responder, read by proposer's inject
CreditResponse ::= credit_accept(BondList) ; credit_reject.

%% Loan response — written by borrower, read by lender's inject
LoanResponse ::= loan_accept(BondList) ; loan_reject.

%% Trade types
Lot     ::= lot(Constant, Constant, Constant).
LotList ::= [] ; [Lot | LotList].
TradeResponse ::= trade_accept(BondList) ; trade_decline(BondList).

%% Escrow cancel signal
EscrowCancel ::= cancel.

%% Escrow results — typed unions for escrow output variables
EscrowBenResult ::= escrow_bonds(BondList) ; escrow_cancelled.
EscrowDepResult ::= escrow_bonds(BondList) ; escrow_expired.

%% Installment schedule for loans
Installment ::= installment(Constant, Constant).
Schedule    ::= [] ; [Installment | Schedule].

%% Friend messages (after connection established)
FriendContent ::= response(Response)
                ; text(Constant)
                ; credit_propose(Constant, Constant, BondList, CreditResponse?)
                ; loan_propose(Constant, Schedule, BondList, LoanResponse?)
                ; trade_propose(LotList, BondList, TradeResponse?)
                ; escrow_offer(Constant, EscrowBenResult).
FriendMsg     ::= msg(Constant, Constant, FriendContent).
FriendStream  ::= [] ; [FriendMsg | FriendStream].
FriendChannel ::= ch(FriendStream, FriendStream?).

Response ::= accept(FriendChannel) ; no.
Decision ::= yes ; no.

%% Network content (2-arg cold-call: msg(Dest, Content))
NetColdCall ::= intro(Constant, Response?).

%% --- Content types for messages ---

%% Content carried inside user-to-agent messages (msg('_user', Id, Content))
UserContent ::= mint(Constant, Constant)       %% mint(K, Maturity)
              ; balance                         %% query holdings
              ; done                            %% terminate agent
              ; connect(Constant)               %% cold-call target
              ; decision(Decision, Constant, PendingValue)  %% accept/reject cold-call
              ; response(Response)              %% injected cold-call response
              ; credit(Constant, Constant, Constant)  %% credit(Target, K, Maturity)
              ; accept_credit(Constant, PendingValue) %% accept credit proposal
              ; reject_credit(Constant, PendingValue) %% reject credit proposal
              ; loan(Constant, Constant, Schedule)  %% loan(Target, Principal, Schedule)
              ; accept_loan(Constant, PendingValue)    %% accept_loan(From, PendingValue)
              ; reject_loan(Constant, PendingValue)    %% reject_loan(From, PendingValue)
              ; trade(Constant, LotList, LotList)      %% trade(Target, GiveSpec, WantSpec)
              ; accept_trade(Constant, PendingValue)   %% accept_trade(From, PendingValue)
              ; reject_trade(Constant, PendingValue)   %% reject_trade(From, PendingValue)
              ; deposit_escrow(Constant, LotList, Constant)  %% deposit_escrow(Target, GiveSpec, ReleaseTime)
              ; cancel_escrow(Constant, PendingValue).       %% cancel_escrow(Target, PendingValue)

%% Pending values stored by mediator
PendingValue ::= response(Response?)
               ; credit_pending(CreditResponse?, Constant, Constant, BondList)
               ; loan_pending(LoanResponse?, Schedule, BondList)
               ; trade_pending(TradeResponse?, LotList, BondList)
               ; escrow_pending(EscrowCancel?)
               ; error.

%% Content carried inside agent-to-user messages (msg(agent, '_user', Content))
AgentContent ::= minted(Constant, Constant)     %% minted(K, Maturity)
               ; balance_report(BondList)        %% balance_report(Holdings)
               ; befriend(Constant, Response?)   %% cold-call received
               ; connected(Constant)             %% friend established
               ; rejected                        %% cold-call rejected (our side)
               ; rejected(Constant)              %% cold-call rejected by target
               ; credit_proposed(Constant, Constant, Constant, CreditResponse?, BondList)
               ; credit_opened(Constant, Constant) %% credit_opened(Other, K)
               ; credit_rejected(Constant)       %% credit rejected by other
               ; loan_proposed(Constant, Constant, Schedule, LoanResponse?, BondList)
               ; loan_opened(Constant, Constant, Constant)   %% loan_opened(Other, Principal, FaceValue)
               ; loan_rejected(Constant)               %% loan_rejected(Other)
               ; trade_proposed(Constant, LotList, TradeResponse?, BondList)
               ; trade_completed(Constant)
               ; trade_failed(Constant)
               ; trade_returned(Constant)
               ; escrow_deposited(Constant, Constant, EscrowCancel?)
               ; escrow_received(Constant, Constant)
               ; escrow_released(Constant)
               ; escrow_cancelled(Constant)
               ; escrow_expired(Constant)
               ; escrow_returned(Constant)
               ; escrow_failed(Constant).

%% Credit result — written by inject_credit_result
CreditResult ::= credit_result(Constant, Constant, BondList)
               ; credit_was_rejected(Constant).

%% Agent input stream (from mediator + injected results)
UserInMsg    ::= msg(Constant, Constant, UserContent)
               ; credit_result(Constant, Constant, BondList)
               ; credit_was_rejected(Constant)
               ; loan_result(Constant, Constant, Constant, BondList)
               ; loan_was_rejected(Constant)
               ; trade_complete(Constant, BondList)
               ; trade_returned_bonds(Constant, BondList)
               ; escrow_ben_released(Constant, BondList)
               ; escrow_ben_cancelled(Constant)
               ; escrow_dep_expired(Constant)
               ; escrow_dep_returned(Constant, BondList).
UserInStream ::= [] ; [UserInMsg | UserInStream].

MediatorToAgentMsg    ::= msg(Constant, Constant, UserContent).
MediatorToAgentStream ::= [] ; [MediatorToAgentMsg | MediatorToAgentStream].

%% Agent-to-user output
AgentToUserMsg    ::= msg(Constant, Constant, AgentContent).
AgentToUserStream ::= [] ; [AgentToUserMsg | AgentToUserStream].

%% Agent-mediator channel
AgentChannel ::= ch(AgentToUserStream, MediatorToAgentStream?).

%% Network input: cold-calls (2-arg) and friend messages (3-arg)
NetInMsg ::= msg(Constant, NetColdCall)
           ; msg(Constant, Constant, FriendContent).
NetInStream ::= [] ; [NetInMsg | NetInStream].

%% Output list — keys distinguish system channels and friends
OutputKey   ::= '_user' ; '_net' ; friend(Constant).

%% Union of all content the agent sends on output streams
OutputContent ::= minted(Constant, Constant)
                ; balance_report(BondList)
                ; befriend(Constant, Response?)
                ; connected(Constant)
                ; rejected
                ; rejected(Constant)
                ; credit_proposed(Constant, Constant, Constant, CreditResponse?, BondList)
                ; credit_opened(Constant, Constant)
                ; credit_rejected(Constant)
                ; response(Response)
                ; credit_propose(Constant, Constant, BondList, CreditResponse?)
                ; loan_propose(Constant, Schedule, BondList, LoanResponse?)
                ; loan_proposed(Constant, Constant, Schedule, LoanResponse?, BondList)
                ; loan_opened(Constant, Constant, Constant)
                ; loan_rejected(Constant)
                ; trade_propose(LotList, BondList, TradeResponse?)
                ; trade_proposed(Constant, LotList, TradeResponse?, BondList)
                ; trade_completed(Constant)
                ; trade_failed(Constant)
                ; trade_returned(Constant)
                ; escrow_offer(Constant, EscrowBenResult)
                ; escrow_deposited(Constant, Constant, EscrowCancel?)
                ; escrow_received(Constant, Constant)
                ; escrow_released(Constant)
                ; escrow_cancelled(Constant)
                ; escrow_expired(Constant)
                ; escrow_returned(Constant)
                ; escrow_failed(Constant).
OutputMsg    ::= msg(Constant, Constant, OutputContent)
               ; msg(Constant, NetColdCall).
OutputStream ::= [] ; [OutputMsg | OutputStream].

OutputEntry ::= output(OutputKey, OutputStream?).
OutputsList ::= [] ; [OutputEntry | OutputsList].

%% =============================================================================
%% MERGE_NET_IN
%% =============================================================================

procedure merge_net_in(NetInStream?, NetInStream?, NetInStream).
merge_net_in([X|Xs], Ys, [X?|Zs?]) :- merge_net_in(Ys?, Xs?, Zs).
merge_net_in(Xs, [Y|Ys], [Y?|Zs?]) :- merge_net_in(Xs?, Ys?, Zs).
merge_net_in([], Ys, Ys?).
merge_net_in(Xs, [], Xs?).

%% =============================================================================
%% LOOKUP_SEND
%% =============================================================================

procedure lookup_send(OutputKey?, OutputMsg?, OutputsList?, OutputsList).
lookup_send(Key, Msg, Outs, Outs1?) :-
    ground(Key?) |
    lookup_send_step(Key?, Msg?, Outs?, Outs1).

procedure lookup_send_step(OutputKey?, OutputMsg?, OutputsList?, OutputsList).
lookup_send_step(Key, Msg, [output(K, [Msg?|Out1?])|Rest], [output(K?, Out1)|Rest?]) :-
    Key? =?= K? | true.
lookup_send_step(Key, Msg, [output(K, Out?)|Rest], [output(K?, Out)|Rest1?]) :-
    otherwise |
    lookup_send_step(Key?, Msg?, Rest?, Rest1).
lookup_send_step(_, _, [], []).

%% =============================================================================
%% ADD_OUTPUT
%% =============================================================================

procedure add_output(OutputKey?, OutputStream, OutputsList?, OutputsList).
add_output(Key, Out?, Outs, [output(Key?, Out)|Outs?]).

%% =============================================================================
%% CLOSE_OUTPUTS
%% =============================================================================

procedure close_outputs(OutputsList?).
close_outputs([output(_, [])|Outs]) :- close_outputs(Outs?).
close_outputs([]).

%% =============================================================================
%% INJECT_MSG — Inject cold-call response into UserIn
%% =============================================================================

procedure inject_msg(Response?, Constant?, Constant?, UserInStream?, UserInStream).
inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% =============================================================================
%% INJECT_CREDIT_RESULT — Inject credit response into UserIn
%% =============================================================================
%%
%% Waits for CreditResp to become known (bound by responder).
%% credit_accept(Bonds) → inject credit_result(From, Bonds)
%% credit_reject → inject credit_was_rejected(From)

procedure inject_credit_result(CreditResponse?, Constant?, Constant?, UserInStream?, UserInStream).
inject_credit_result(credit_accept(Bonds), From, K, Ys,
    [credit_result(From?, K?, Bonds?)|Ys?]) :-
    ground(From?), ground(K?), ground(Bonds?) | true.
inject_credit_result(credit_reject, From, _, Ys,
    [credit_was_rejected(From?)|Ys?]) :-
    ground(From?) | true.
inject_credit_result(Resp, From, K, [Y|Ys], [Y?|Ys1?]) :-
    inject_credit_result(Resp?, From?, K?, Ys?, Ys1).

%% =============================================================================
%% NEW_FRIEND_CHANNEL — Create a bidirectional FriendChannel pair
%% =============================================================================

procedure new_friend_channel(FriendChannel, FriendChannel).
new_friend_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% =============================================================================
%% RESPONSE HANDLING — bind cold-call decision
%% =============================================================================

procedure bind_response(Decision?, Constant?, Response, OutputsList?, OutputsList, NetInStream?, NetInStream).
bind_response(yes, From, accept(RetCh?), Outs, Outs1?, In, In1?) :-
    new_friend_channel(RetCh, LocalCh) |
    handle_response(accept(LocalCh?), From?, Outs?, Outs1, In?, In1).
bind_response(no, _, no, Outs, Outs1?, In, In?) :-
    lookup_send('_user', msg(agent, '_user', rejected), Outs?, Outs1).

procedure handle_response(Response?, Constant?, OutputsList?, OutputsList, NetInStream?, NetInStream).
handle_response(accept(ch(FIn, FOut?)), From, Outs, Outs2?, In, In1?) :-
    ground(From?) |
    add_output(friend(From?), FOut, Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', connected(From?)), Outs1?, Outs2),
    merge_net_in(In?, FIn?, In1).
handle_response(no, From, Outs, Outs1?, In, In?) :-
    ground(From?) |
    lookup_send('_user', msg(agent, '_user', rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% LIST_LENGTH — Count elements in a bond list
%% =============================================================================

procedure list_length(BondList?, Constant).
list_length([_|Xs], N?) :- list_length(Xs?, N1), N := N1? + 1.
list_length([], 0).

%% =============================================================================
%% BIND_CREDIT — Bind CreditResponse variable (writer mode)
%% =============================================================================
%%
%% Same design as bind_response: the CreditResponse parameter is in writer
%% mode, so the clause head constructs the value that binds the variable.

procedure bind_credit_accept(CreditResponse, Constant?, Constant?, Constant?, Constant?).
bind_credit_accept(credit_accept(MyBonds?), Id, Maturity, K, Serial) :-
    ground(Id?), ground(Maturity?), ground(K?), ground(Serial?) |
    create_bonds(Id?, Maturity?, K?, Serial?, MyBonds).

procedure bind_credit_reject(CreditResponse).
bind_credit_reject(credit_reject).

%% =============================================================================
%% CREATE_BONDS — Create K bonds with given issuer and maturity
%% =============================================================================

procedure create_bonds(Constant?, Constant?, Constant?, Constant?, BondList).
create_bonds(Issuer, Maturity, K, Serial,
             [bond(Issuer?, Maturity?, Serial?)|Rest?]) :-
    K? > 0 |
    K1 := K? - 1,
    S1 := Serial? + 1,
    create_bonds(Issuer?, Maturity?, K1?, S1?, Rest).
create_bonds(_, _, 0, _, []).

%% =============================================================================
%% APPEND — Append two bond lists
%% =============================================================================

procedure append(BondList?, BondList?, BondList).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).
append([], Ys, Ys?).

%% =============================================================================
%% SCHEDULE_TOTAL — Sum of amounts in a schedule
%% =============================================================================

procedure schedule_total(Schedule?, Constant).
schedule_total([installment(Amount, _)|Rest], Total?) :-
    schedule_total(Rest?, SubTotal),
    Total := SubTotal? + Amount?.
schedule_total([], 0).

%% =============================================================================
%% CREATE_BONDS_FROM_SCHEDULE — Create bonds for each installment
%% =============================================================================

procedure create_bonds_from_schedule(Constant?, Schedule?, Constant?, BondList, Constant).
create_bonds_from_schedule(Id, [installment(Amount, Maturity)|Rest], Serial, AllBonds?, NewSerial?) :-
    ground(Amount?), ground(Maturity?) |
    create_bonds(Id?, Maturity?, Amount?, Serial?, Batch),
    BatchSerial := Serial? + Amount?,
    create_bonds_from_schedule(Id?, Rest?, BatchSerial?, RestBonds, NewSerial),
    append(Batch?, RestBonds?, AllBonds).
create_bonds_from_schedule(_, [], Serial, [], Serial?).

%% =============================================================================
%% BIND_LOAN — Bind LoanResponse variable (writer mode)
%% =============================================================================
%%
%% Same design as bind_credit_accept: the LoanResponse parameter is in writer
%% mode, so the clause head constructs the value that binds the variable.

procedure bind_loan_accept(LoanResponse, Constant?, Schedule?, Constant?, Constant).
bind_loan_accept(loan_accept(MyBonds?), Id, Schedule, Serial, NewSerial?) :-
    ground(Id?), ground(Schedule?), ground(Serial?) |
    create_bonds_from_schedule(Id?, Schedule?, Serial?, MyBonds, NewSerial).

procedure bind_loan_reject(LoanResponse).
bind_loan_reject(loan_reject).

%% =============================================================================
%% INJECT_LOAN_RESULT — Inject loan response into UserIn
%% =============================================================================
%%
%% Waits for LoanResp to become known (bound by borrower).
%% loan_accept(Bonds) → inject loan_result(From, Principal, FaceValue, Bonds)
%% loan_reject → inject loan_was_rejected(From)

procedure inject_loan_result(LoanResponse?, Constant?, Constant?, Constant?, UserInStream?, UserInStream).
inject_loan_result(loan_accept(Bonds), From, Principal, FaceValue, Ys,
    [loan_result(From?, Principal?, FaceValue?, Bonds?)|Ys?]) :-
    ground(From?), ground(Principal?), ground(FaceValue?), ground(Bonds?) | true.
inject_loan_result(loan_reject, From, _, _, Ys,
    [loan_was_rejected(From?)|Ys?]) :-
    ground(From?) | true.
inject_loan_result(Resp, From, Principal, FaceValue, [Y|Ys], [Y?|Ys1?]) :-
    inject_loan_result(Resp?, From?, Principal?, FaceValue?, Ys?, Ys1).

%% =============================================================================
%% SELECT_BONDS_EXACT — Select K bonds with exact Issuer+Maturity
%% =============================================================================

procedure select_bonds_exact(Constant?, Constant?, Constant?, BondList?, Constant, BondList, BondList).
select_bonds_exact(_, _, 0, Hs, ok, [], Hs?).
select_bonds_exact(Issuer, Maturity, K, [bond(I, M, S)|Rest], Status?, [bond(I?, M?, S?)|Sel?], Rem?) :-
    K? > 0, Issuer? =?= I?, Maturity? =?= M? |
    K1 := K? - 1,
    select_bonds_exact(Issuer?, Maturity?, K1?, Rest?, Status, Sel, Rem).
select_bonds_exact(Issuer, Maturity, K, [B|Rest], Status?, Sel?, [B?|Rem?]) :-
    otherwise |
    select_bonds_exact(Issuer?, Maturity?, K?, Rest?, Status, Sel, Rem).
select_bonds_exact(_, _, K, [], fail, [], []) :- K? > 0 | true.

%% =============================================================================
%% SELECT_BONDS_BY_SPEC — Fold over LotList
%% =============================================================================

procedure select_bonds_by_spec(LotList?, BondList?, Constant, BondList, BondList).
select_bonds_by_spec([lot(Issuer, Maturity, Count)|Rest], Holdings, Status?, AllSel?, FinalRem?) :-
    ground(Issuer?), ground(Maturity?), ground(Count?) |
    select_bonds_exact(Issuer?, Maturity?, Count?, Holdings?, LotStatus, LotSel, LotRem),
    select_by_spec_continue(LotStatus?, Rest?, LotSel?, LotRem?, Status, AllSel, FinalRem).
select_bonds_by_spec([], Holdings, ok, [], Holdings?).

procedure select_by_spec_continue(Constant?, LotList?, BondList?, BondList?, Constant, BondList, BondList).
select_by_spec_continue(ok, Rest, LotSel, LotRem, Status?, AllSel?, FinalRem?) :-
    select_bonds_by_spec(Rest?, LotRem?, Status, RestSel, FinalRem),
    append(LotSel?, RestSel?, AllSel).
select_by_spec_continue(fail, _, LotSel, LotRem, fail, LotSel?, LotRem?).

%% =============================================================================
%% BIND_TRADE — Bind TradeResponse variable (writer mode)
%% =============================================================================

procedure bind_trade_accept(TradeResponse, BondList?).
bind_trade_accept(trade_accept(Bonds?), Bonds).

procedure bind_trade_decline(TradeResponse, BondList?).
bind_trade_decline(trade_decline(Bonds?), Bonds).

%% =============================================================================
%% INJECT_TRADE_RESULT — Inject trade response into UserIn
%% =============================================================================

procedure inject_trade_result(TradeResponse?, Constant?, UserInStream?, UserInStream).
inject_trade_result(trade_accept(TheirBonds), From, Ys,
    [trade_complete(From?, TheirBonds?)|Ys?]) :-
    ground(From?), ground(TheirBonds?) | true.
inject_trade_result(trade_decline(OurBonds), From, Ys,
    [trade_returned_bonds(From?, OurBonds?)|Ys?]) :-
    ground(From?), ground(OurBonds?) | true.
inject_trade_result(Resp, From, [Y|Ys], [Y?|Ys1?]) :-
    inject_trade_result(Resp?, From?, Ys?, Ys1).

%% =============================================================================
%% DO_TRADE — Select bonds matching GiveSpec, then send or fail
%% =============================================================================

procedure do_trade(Constant?, Constant?, LotList?, LotList?, BondList?, UserInStream?, NetInStream?, OutputsList?, Constant?).
do_trade(Id, Target, GiveSpec, WantSpec, Holdings, UserIn, NetIn, Outs, NextSerial) :-
    select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_trade_result(Status?, Id?, Target?, WantSpec?, Selected?, Remaining?, UserIn?, NetIn?, Outs?, NextSerial?).

procedure do_trade_result(Constant?, Constant?, Constant?, LotList?, BondList?, BondList?, UserInStream?, NetInStream?, OutputsList?, Constant?).
do_trade_result(ok, Id, Target, WantSpec, Selected, Remaining, UserIn, NetIn, Outs, NextSerial) :-
    lookup_send(friend(Target?),
        msg(Id?, Target?, trade_propose(WantSpec?, Selected?, TradeResp)),
        Outs?, Outs1),
    inject_trade_result(TradeResp?, Target?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Remaining?, NextSerial?).
do_trade_result(fail, Id, Target, _, Selected, Remaining, UserIn, NetIn, Outs, NextSerial) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', trade_failed(Target?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?).

%% =============================================================================
%% HANDLE_TRADE_FILL — Bind TradeResponse after selection attempt
%% =============================================================================

procedure handle_trade_fill(Constant?, Constant?, Constant?, TradeResponse, BondList?, BondList?, BondList?, UserInStream?, NetInStream?, OutputsList?, Constant?).
%% Can fill: bind accept(our bonds), take offered bonds
handle_trade_fill(ok, Id, _, trade_accept(Selected?), OfferedBonds, Selected, Remaining, UserIn, NetIn, Outs, NextSerial) :-
    append(Remaining?, OfferedBonds?, NewHoldings),
    agent(Id?, UserIn?, NetIn?, Outs?, NewHoldings?, NextSerial?).
%% Can't fill: bind decline(offered bonds back), reconstruct own holdings
handle_trade_fill(fail, Id, From, trade_decline(OfferedBonds?), OfferedBonds, Selected, Remaining, UserIn, NetIn, Outs, NextSerial) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', trade_failed(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?).

%% =============================================================================
%% CHECK_OWN_BOND — Check if any offered bond was issued by me
%% =============================================================================

procedure check_own_bond(Constant?, BondList?, Constant).
check_own_bond(Id, [bond(I, _, _)|_], yes) :- Id? =?= I? | true.
check_own_bond(Id, [_|Rest], Result?) :- otherwise | check_own_bond(Id?, Rest?, Result).
check_own_bond(_, [], no).

%% =============================================================================
%% TRADE_DISPATCH — Branch on auto-accept vs. user decision
%% =============================================================================

procedure trade_dispatch(Constant?, Constant?, Constant?, LotList?, BondList?, TradeResponse,
    BondList?, UserInStream?, NetInStream?, OutputsList?, Constant?).

%% Redemption/payment — auto-accept
trade_dispatch(yes, Id, From, WantSpec, OfferedBonds, TradeResp?,
    Holdings, UserIn, NetIn, Outs, NextSerial) :-
    select_bonds_by_spec(WantSpec?, Holdings?, Status, Selected, Remaining),
    handle_trade_auto(Status?, Id?, From?, TradeResp, OfferedBonds?, Selected?, Remaining?,
        UserIn?, NetIn?, Outs?, NextSerial?).

%% Normal trade — present to user
trade_dispatch(no, Id, From, WantSpec, OfferedBonds, TradeResp?,
    Holdings, UserIn, NetIn, Outs, NextSerial) :-
    lookup_send('_user',
        msg(agent, '_user', trade_proposed(From?, WantSpec?, TradeResp, OfferedBonds?)),
        Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% =============================================================================
%% HANDLE_TRADE_AUTO — Auto-accept trade with user notification
%% =============================================================================

procedure handle_trade_auto(Constant?, Constant?, Constant?, TradeResponse, BondList?, BondList?, BondList?,
    UserInStream?, NetInStream?, OutputsList?, Constant?).

%% Can fill: bind accept(our bonds), take offered bonds, notify user
handle_trade_auto(ok, Id, From, trade_accept(Selected?), OfferedBonds, Selected, Remaining,
    UserIn, NetIn, Outs, NextSerial) :-
    append(Remaining?, OfferedBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_completed(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?).

%% Can't fill: bind decline(offered bonds back), reconstruct own holdings
handle_trade_auto(fail, Id, From, trade_decline(OfferedBonds?), OfferedBonds, Selected, Remaining,
    UserIn, NetIn, Outs, NextSerial) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', trade_failed(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?).

%% =============================================================================
%% ESCROW — Concurrent race between timer and cancel signal
%% =============================================================================
%%
%% Two-clause race:
%%   Clause 1: wait_until(T?) suspends until time T, then beneficiary wins
%%   Clause 2: head match on cancel suspends until CancelSignal bound, then depositor wins
%% First clause to commit wins; the other is abandoned.

procedure escrow(Constant?, BondList?, EscrowCancel?, EscrowBenResult, EscrowDepResult).

%% Time passes — beneficiary gets bonds, depositor gets 'expired'
escrow(T, Bonds, _,
    escrow_bonds(Bonds?),
    escrow_expired) :-
    wait_until(T?) | true.

%% Depositor cancels — depositor gets bonds back, beneficiary gets 'cancelled'
escrow(_, Bonds, cancel,
    escrow_cancelled,
    escrow_bonds(Bonds?)).

%% =============================================================================
%% INJECT_ESCROW_BEN_RESULT — Monitor beneficiary's escrow outcome
%% =============================================================================

procedure inject_escrow_ben_result(EscrowBenResult?, Constant?, UserInStream?, UserInStream).
inject_escrow_ben_result(escrow_bonds(Bonds), From, Ys,
    [escrow_ben_released(From?, Bonds?)|Ys?]) :-
    ground(From?), ground(Bonds?) | true.
inject_escrow_ben_result(escrow_cancelled, From, Ys,
    [escrow_ben_cancelled(From?)|Ys?]) :-
    ground(From?) | true.
inject_escrow_ben_result(Resp, From, [Y|Ys], [Y?|Ys1?]) :-
    inject_escrow_ben_result(Resp?, From?, Ys?, Ys1).

%% =============================================================================
%% INJECT_ESCROW_DEP_RESULT — Monitor depositor's escrow outcome
%% =============================================================================

procedure inject_escrow_dep_result(EscrowDepResult?, Constant?, UserInStream?, UserInStream).
inject_escrow_dep_result(escrow_bonds(Bonds), Target, Ys,
    [escrow_dep_returned(Target?, Bonds?)|Ys?]) :-
    ground(Target?), ground(Bonds?) | true.
inject_escrow_dep_result(escrow_expired, Target, Ys,
    [escrow_dep_expired(Target?)|Ys?]) :-
    ground(Target?) | true.
inject_escrow_dep_result(Resp, Target, [Y|Ys], [Y?|Ys1?]) :-
    inject_escrow_dep_result(Resp?, Target?, Ys?, Ys1).

%% =============================================================================
%% DO_DEPOSIT_ESCROW — Select bonds and create escrow or fail
%% =============================================================================

procedure do_deposit_escrow(Constant?, Constant?, LotList?, Constant?, BondList?, UserInStream?, NetInStream?, OutputsList?, Constant?).
do_deposit_escrow(Id, Target, GiveSpec, ReleaseTime, Holdings, UserIn, NetIn, Outs, NextSerial) :-
    select_bonds_by_spec(GiveSpec?, Holdings?, Status, Selected, Remaining),
    do_deposit_escrow_result(Status?, Id?, Target?, ReleaseTime?, Selected?, Remaining?, UserIn?, NetIn?, Outs?, NextSerial?).

procedure do_deposit_escrow_result(Constant?, Constant?, Constant?, Constant?, BondList?, BondList?, UserInStream?, NetInStream?, OutputsList?, Constant?).
do_deposit_escrow_result(ok, Id, Target, ReleaseTime, Selected, Remaining, UserIn, NetIn, Outs, NextSerial) :-
    ground(Selected?) |
    escrow(ReleaseTime?, Selected?, CancelSignal?, BenResult, DepResult),
    inject_escrow_dep_result(DepResult?, Target?, UserIn?, UserIn1),
    lookup_send(friend(Target?),
        msg(Id?, Target?, escrow_offer(ReleaseTime?, BenResult?)),
        Outs?, Outs1),
    lookup_send('_user',
        msg(agent, '_user', escrow_deposited(Target?, ReleaseTime?, CancelSignal)),
        Outs1?, Outs2),
    agent(Id?, UserIn1?, NetIn?, Outs2?, Remaining?, NextSerial?).
do_deposit_escrow_result(fail, Id, Target, _, Selected, Remaining, UserIn, NetIn, Outs, NextSerial) :-
    append(Selected?, Remaining?, OrigHoldings),
    lookup_send('_user', msg(agent, '_user', escrow_failed(Target?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, OrigHoldings?, NextSerial?).

%% =============================================================================
%% BIND_ESCROW_CANCEL — Bind CancelSignal to cancel
%% =============================================================================

procedure bind_escrow_cancel(EscrowCancel).
bind_escrow_cancel(cancel).

%% =============================================================================
%% AGENT/6 — Bond agent
%% =============================================================================
%%
%% agent(Id, UserIn, NetIn, Outs, Holdings, NextSerial)
%%   Id         — agent identity (constant)
%%   UserIn     — stream of messages from mediator (+ injected results)
%%   NetIn      — stream of messages from network
%%   Outs       — output list ('_user', '_net', friend(X), ...)
%%   Holdings   — list of bonds held by this agent
%%   NextSerial — next serial number for minting

procedure agent(Constant?, UserInStream?, NetInStream?, OutputsList?, BondList?, Constant?).

%% --- Phase 1: Mint / Balance / Done ---

%% User requests mint: create K bonds, add to holdings, notify user
agent(Id, [msg('_user', Id1, mint(K, Maturity))|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(K?), ground(Maturity?) |
    NewNextSerial := NextSerial? + K?,
    create_bonds(Id?, Maturity?, K?, NextSerial?, NewBonds),
    append(Holdings?, NewBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', minted(K?, Maturity?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NewNextSerial?).

%% User requests balance: report current holdings
agent(Id, [msg('_user', Id1, balance)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(Holdings?) |
    lookup_send('_user', msg(agent, '_user', balance_report(Holdings?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% User sends done: terminate agent
agent(Id, [msg('_user', Id1, done)|_], _, Outs, _, _) :-
    Id? =?= Id1? |
    close_outputs(Outs?).

%% --- Phase 2: Social graph (cold-call befriending) ---

%% User initiates cold call
agent(Id, [msg('_user', Id1, connect(Target))|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send('_net', msg(Target?, intro(Id?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% User decision on cold-call
agent(Id, [msg('_user', Id1, decision(Dec, From, response(Resp?)))|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1? |
    bind_response(Dec?, From?, Resp, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?, NextSerial?).

%% Response to cold-call (injected by inject_msg)
agent(Id, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1? |
    handle_response(Resp?, From?, Outs?, Outs1, NetIn?, NetIn1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, Holdings?, NextSerial?).

%% Cold-call from network
agent(Id, UserIn, [msg(Id1, intro(From, Resp?))|NetIn], Outs, Holdings, NextSerial) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', befriend(From?, Resp)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% --- Phase 2: Symmetric Credit Line ---

%% User requests credit line with a friend
%% Agent mints K bonds, sends credit_propose on friend channel with unbound CreditResp
agent(Id, [msg('_user', Id1, credit(Target, K, Maturity))|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(Target?), ground(K?), ground(Maturity?) |
    NewNextSerial := NextSerial? + K?,
    create_bonds(Id?, Maturity?, K?, NextSerial?, MyBonds),
    lookup_send(friend(Target?),
        msg(Id?, Target?, credit_propose(K?, Maturity?, MyBonds?, CreditResp)),
        Outs?, Outs1),
    inject_credit_result(CreditResp?, Target?, K?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?, NewNextSerial?).

%% Credit result: other accepted — add their bonds to holdings, notify user
agent(Id, [credit_result(From, K, TheirBonds)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?), ground(From?), ground(K?), ground(TheirBonds?) |
    append(Holdings?, TheirBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', credit_opened(From?, K?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?).

%% Credit result: other rejected — notify user
agent(Id, [credit_was_rejected(From)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?) |
    lookup_send('_user', msg(agent, '_user', credit_rejected(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% Incoming credit_propose from friend channel
%% Notify user via mediator (non-ground: CreditResp stored in pending)
agent(Id, UserIn, [msg(From, Id1, credit_propose(K, Maturity, TheirBonds, CreditResp?))|NetIn],
      Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(K?), ground(Maturity?), ground(TheirBonds?) |
    lookup_send('_user',
        msg(agent, '_user', credit_proposed(From?, K?, Maturity?, CreditResp, TheirBonds?)),
        Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% User accepts credit: mint K bonds, bind CreditResp, add proposer's bonds
agent(Id, [msg('_user', Id1, accept_credit(From,
        credit_pending(CreditResp?, K, Maturity, TheirBonds)))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(K?), ground(Maturity?), ground(TheirBonds?) |
    NewNextSerial := NextSerial? + K?,
    bind_credit_accept(CreditResp, Id?, Maturity?, K?, NextSerial?),
    append(Holdings?, TheirBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', credit_opened(From?, K?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NewNextSerial?).

%% User rejects credit: bind CreditResp to credit_reject
agent(Id, [msg('_user', Id1, reject_credit(_,
        credit_pending(CreditResp?, _, _, _)))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1? |
    bind_credit_reject(CreditResp),
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?).

%% --- Phase 5: Zero-Coupon Loan ---

%% User requests loan (lender side): mint Principal coins, propose on friend channel
agent(Id, [msg('_user', Id1, loan(Target, Principal, Schedule))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(Target?), ground(Principal?), ground(Schedule?) |
    NewNextSerial := NextSerial? + Principal?,
    create_bonds(Id?, 0, Principal?, NextSerial?, MyCoins),
    schedule_total(Schedule?, TotalFV),
    lookup_send(friend(Target?),
        msg(Id?, Target?, loan_propose(Principal?, Schedule?, MyCoins?, LoanResp)),
        Outs?, Outs1),
    inject_loan_result(LoanResp?, Target?, Principal?, TotalFV?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?, NewNextSerial?).

%% Injected loan_result: borrower accepted — add borrower's bonds, notify user
agent(Id, [loan_result(From, Principal, FaceValue, BorrowerBonds)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?), ground(From?), ground(Principal?), ground(FaceValue?), ground(BorrowerBonds?) |
    append(Holdings?, BorrowerBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', loan_opened(From?, Principal?, FaceValue?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?).

%% Injected loan_was_rejected: borrower rejected — notify user
agent(Id, [loan_was_rejected(From)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?) |
    lookup_send('_user', msg(agent, '_user', loan_rejected(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% Incoming loan_propose from friend (borrower receives)
agent(Id, UserIn, [msg(From, Id1, loan_propose(Principal, Schedule, LenderCoins, LoanResp?))|NetIn],
      Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(Principal?), ground(Schedule?), ground(LenderCoins?) |
    lookup_send('_user',
        msg(agent, '_user', loan_proposed(From?, Principal?, Schedule?, LoanResp, LenderCoins?)),
        Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% User accepts loan (borrower side): mint bonds per schedule, bind LoanResp, add lender's coins
agent(Id, [msg('_user', Id1, accept_loan(From,
        loan_pending(LoanResp?, Schedule, LenderCoins)))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(Schedule?), ground(LenderCoins?) |
    bind_loan_accept(LoanResp, Id?, Schedule?, NextSerial?, NewNextSerial),
    schedule_total(Schedule?, TotalFV),
    append(Holdings?, LenderCoins?, NewHoldings),
    list_length(LenderCoins?, Principal),
    lookup_send('_user', msg(agent, '_user', loan_opened(From?, Principal?, TotalFV?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NewNextSerial?).

%% User rejects loan (borrower side): bind LoanResp to loan_reject
agent(Id, [msg('_user', Id1, reject_loan(_,
        loan_pending(LoanResp?, _, _)))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1? |
    bind_loan_reject(LoanResp),
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?).

%% --- Phase 7: Trade (Sale of Debt + Forward Contract) ---

%% Proposer: trade command
agent(Id, [msg('_user', Id1, trade(Target, GiveSpec, WantSpec))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(WantSpec?) |
    do_trade(Id?, Target?, GiveSpec?, WantSpec?, Holdings?, UserIn?, NetIn?, Outs?, NextSerial?).

%% Proposer: trade_complete (injected — accept)
agent(Id, [trade_complete(From, TheirBonds)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?), ground(From?), ground(TheirBonds?) |
    append(Holdings?, TheirBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_completed(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?).

%% Proposer: trade_returned_bonds (injected — decline)
agent(Id, [trade_returned_bonds(From, OurBonds)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?), ground(From?), ground(OurBonds?) |
    append(Holdings?, OurBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', trade_returned(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?).

%% Responder: incoming trade_propose (auto-accept if offered bonds include own)
agent(Id, UserIn, [msg(From, Id1, trade_propose(WantSpec, OfferedBonds, TradeResp?))|NetIn],
      Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    check_own_bond(Id?, OfferedBonds?, IsRedemption),
    trade_dispatch(IsRedemption?, Id?, From?, WantSpec?, OfferedBonds?, TradeResp,
        Holdings?, UserIn?, NetIn?, Outs?, NextSerial?).

%% Responder: accept_trade (inlined — select bonds then fill)
agent(Id, [msg('_user', Id1, accept_trade(From,
        trade_pending(TradeResp?, WantSpec, OfferedBonds)))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(WantSpec?), ground(OfferedBonds?) |
    select_bonds_by_spec(WantSpec?, Holdings?, Status, Selected, Remaining),
    handle_trade_fill(Status?, Id?, From?, TradeResp, OfferedBonds?, Selected?, Remaining?, UserIn?, NetIn?, Outs?, NextSerial?).

%% Responder: reject_trade
agent(Id, [msg('_user', Id1, reject_trade(From,
        trade_pending(TradeResp?, _, OfferedBonds)))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(OfferedBonds?) |
    bind_trade_decline(TradeResp, OfferedBonds?),
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?).

%% --- Phase 8: Escrow ---

%% Depositor: deposit_escrow command
agent(Id, [msg('_user', Id1, deposit_escrow(Target, GiveSpec, ReleaseTime))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(Target?), ground(GiveSpec?), ground(ReleaseTime?) |
    do_deposit_escrow(Id?, Target?, GiveSpec?, ReleaseTime?, Holdings?, UserIn?, NetIn?, Outs?, NextSerial?).

%% Depositor: escrow expired (injected — time passed, bonds went to beneficiary)
agent(Id, [escrow_dep_expired(Target)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?) |
    lookup_send('_user', msg(agent, '_user', escrow_expired(Target?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% Depositor: escrow returned (injected — cancel succeeded, bonds back)
agent(Id, [escrow_dep_returned(Target, OurBonds)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?), ground(Target?), ground(OurBonds?) |
    append(Holdings?, OurBonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', escrow_returned(Target?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?).

%% Depositor: cancel_escrow — bind CancelSignal to cancel
agent(Id, [msg('_user', Id1, cancel_escrow(Target,
        escrow_pending(CancelSignal?)))|UserIn],
      NetIn, Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(Target?) |
    bind_escrow_cancel(CancelSignal),
    agent(Id?, UserIn?, NetIn?, Outs?, Holdings?, NextSerial?).

%% Beneficiary: incoming escrow_offer
agent(Id, UserIn, [msg(From, Id1, escrow_offer(ReleaseTime, BenResult))|NetIn],
      Outs, Holdings, NextSerial) :-
    Id? =?= Id1?, ground(From?), ground(ReleaseTime?) |
    inject_escrow_ben_result(BenResult?, From?, UserIn?, UserIn1),
    lookup_send('_user', msg(agent, '_user', escrow_received(From?, ReleaseTime?)), Outs?, Outs1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% Beneficiary: escrow released (injected — time passed, bonds received)
agent(Id, [escrow_ben_released(From, Bonds)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?), ground(From?), ground(Bonds?) |
    append(Holdings?, Bonds?, NewHoldings),
    lookup_send('_user', msg(agent, '_user', escrow_released(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, NewHoldings?, NextSerial?).

%% Beneficiary: escrow cancelled (injected — depositor cancelled)
agent(Id, [escrow_ben_cancelled(From)|UserIn], NetIn, Outs, Holdings, NextSerial) :-
    ground(Id?) |
    lookup_send('_user', msg(agent, '_user', escrow_cancelled(From?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, Holdings?, NextSerial?).

%% --- Termination ---
%%
%% Only terminate on UserIn closure. NetIn closure is NOT used because
%% in single-agent plays NetIn is unbound, and an unbound variable
%% matches [] in GLP, causing premature termination.
%% Multi-agent plays terminate via explicit 'done' commands.

agent(_, [], _, Outs, _, _) :- close_outputs(Outs?).

