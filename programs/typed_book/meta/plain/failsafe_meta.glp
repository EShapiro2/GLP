%% failsafe_meta.glp - Fail-safe GLP metainterpreter
%% Source: GLP Papers (Program: GLP fail-safe metainterpreter)
%%
%% TYPE CHECKER NOTE: This program requires parameterized types and a typed
%% module system (cross-module calls via #). Will be supported in a future version.
%%
%% Reports failures via short-circuit instead of aborting.
%% L--R threads through computation for failure collection.

%% Type definitions
FailList ::= [] ; [_ | FailList].

%% External procedure declarations (no clauses in this file)
procedure reduce(_?, _).

procedure run(_?, _?, FailList?, FailList).
run(_, true, L, L?).                             % halt - close circuit
run(M, (A, B), L, R?) :-                         % fork - chain
    ground(M?) |
    run(M?, A?, L?, Mid),
    run(M?, B?, Mid?, R).
run(_, M1 # G, L, R?) :- run(M1?, G?, L?, R).    % cross-module
run(_, failed(A), L, [failed(A?)|L?]).           % report failure
run(M, A, L, R?) :-                              % reduce
    compound(A?), ground(M?) |
    M? # reduce(A?, B),
    run(M?, B?, L?, R).

%% Object program must include catch-all:
%% reduce(A, failed(A?)) :- otherwise | true.

%% Example usage:
%% ?- run(merge_module, merge([1,2], [3], Zs), done, Failures).
