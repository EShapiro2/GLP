%% tracing_meta.glp - Tracing GLP metainterpreter
%% Source: GLP Papers (Program: GLP tracing metainterpreter)
%%
%% TYPE CHECKER NOTE: This program requires parameterized types and a typed
%% module system (cross-module calls via #). Will be supported in a future version.
%%
%% Builds execution tree capturing each reduction.
%% Uses observe/3 to capture goal state at each step.

%% Type definitions
ExecTree ::= true ; fork(ExecTree, ExecTree) ; reduction(_, _?, ExecTree).

%% Procedure type declarations
procedure run(_?, _?, ExecTree).
procedure replay(_?, ExecTree?, _).
procedure reduce(_?, _, _).
procedure reduce_by_index(_?, _, _).
procedure observe(_?, _, _).

run(_, true, true).                              % halt
run(M, (A, B), fork(TA?, TB?)) :-                % fork
    ground(M?) |
    run(M?, A?, TA),
    run(M?, B?, TB).
run(_, M1 # G, Tree?) :- run(M1?, G?, Tree).     % cross-module
run(M, A, reduction(A_obs?, I?, TB?)) :-         % reduce
    compound(A?), ground(M?) |
    observe(A?, A_exec, A_obs),
    M? # reduce(A_exec?, B, I),
    run(M?, B?, TB).

%% Object program must provide reduce/3 with clause index:
%% reduce(merge([X|Xs], Ys, [X?|Zs?]), merge(Xs?, Ys?, Zs), 1).

%% Replay from trace
replay(_, true, true).
replay(M, fork(T1, T2), (A?, B?)) :-
    ground(M?) |
    replay(M?, T1?, A),
    replay(M?, T2?, B).
replay(M, reduction(_, I, SubTree), Goal?) :-
    ground(M?) |
    M? # reduce_by_index(I?, Goal, Body),
    replay(M?, SubTree?, Body?).
