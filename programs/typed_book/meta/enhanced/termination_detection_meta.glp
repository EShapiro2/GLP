%% termination_detection_meta.glp - Termination detecting metainterpreter
%% Source: CP Collected Papers, Ch 25 (Safra & Shapiro)
%%
%% TYPE CHECKER NOTE: This program requires parameterized types and a typed
%% module system (cross-module calls via #). Will be supported in a future version.
%%
%% Uses short-circuit technique to detect distributed termination.

%% External procedure declarations (no clauses in this file)
procedure reduce(_?, _).

procedure run(_?, _?, _?, _).
run(_, true, L, L?).                             % halt - close circuit
run(M, (A, B), L, R?) :-                         % fork - split chain
    ground(M?) |
    run(M?, A?, L?, Mid),
    run(M?, B?, Mid?, R).
run(_, M1 # G, L, R?) :- run(M1?, G?, L?, R).    % cross-module
run(M, A, L, R?) :-                              % reduce
    compound(A?), ground(M?) |
    M? # reduce(A?, B),
    run(M?, B?, L?, R).

%% Termination detected when Result? becomes known(done)
%% Example: run(module, Goal, done, Result), known(Result?) | ...
