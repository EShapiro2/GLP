%% abortable_meta.glp - Abortable GLP metainterpreter
%% Source: CP Collected Papers, Ch 25 (Safra & Shapiro)
%%
%% TYPE CHECKER NOTE: This program requires parameterized types and a typed
%% module system (cross-module calls via #). Will be supported in a future version.
%%
%% Supports abort via equator (emergency brake).
%% When Eq is bound, computation stops.

%% External procedure declarations (no clauses in this file)
procedure reduce(_?, _).

procedure run(_?, _?, _?).
run(_, true, _).                                 % halt
run(M, (A, B), Eq) :-                            % fork
    ground(M?), unknown(Eq?) |
    run(M?, A?, Eq?), run(M?, B?, Eq?).
run(_, M1 # G, Eq) :- run(M1?, G?, Eq?).         % cross-module
run(M, A, Eq) :-                                 % reduce
    compound(A?), unknown(Eq?) |
    M? # reduce(A?, B),
    run(M?, B?, Eq?).
run(_, _, Eq) :- known(Eq?) | true.              % abort - brake pulled

%% Example usage:
%% ?- run(module, Goal, Eq?), ... bind Eq to abort when needed
