%% ---------------------------------------------------------------------------
%% GAI.glp --- GAI, Accountable AI Agents, GAI's, its clauses in GAI.txt beside this file, extending GnW (GnW.txt), with GSG and GKK (programs/gsc) beneath it, in the clause syntax of GSC's paper, Section 3.2 (the form is described in programs/gsc/GKK.glp and README.md, "Writing a contract").  This term is the one source of the schemas; a run of the cascade prints their notation from it (schemas.txt).
%% Seventeen schemas: GKK's establish and acquaint, GnW's introduce and GSG's befriend for persons, agent forbidden at their roles; unfriend, GSG:2 for every agent, but a ward with a guardian and a guardian with the ward; GnW's enter, make_guardian, end_guardian, resign, guardian_unfriend, agent_acquaint, agent_befriend, agent_unfriend, agents_acquaint, agents_befriend and retire for an AI agent and its guardians; and sign, GAI:1, by which an agent holds an item they created, as GFP's create.
%% The ward Carol holds agent, the mark, and principal of her creator, the creator principal_of of Carol; every guardian, the creator among them, holds guardian_of of Carol and the record agent_of(Carol, y) of her attestation y, and Carol holds guarded_by of each guardian other than the creator.  The attestation y is an item the principal holds and authored, author_of(y) its first signer, GFP's (Udi, 2026-11-07, to GAI #12: GFP owns it).  Every role requires identity, except the role of establish, which adds it, and the AI agent's role of enter, which forbids it and adds it.  retired is a leaving mark: every guard forbids it, no schema deletes it, and retire, which adds it, requires agent there.
%% Rewritten by GAI #12 Cowork, 2026-11-07, from the checker's term form into the clause syntax, item with its holder and author_of in place of authored (Udi's yes to GAI #12); 2026-11-08, a ward comes to know any agent by an act of the two, agent_acquaint and agents_acquaint without a guardian role (Udi, 2026-11-08, to GAI #12, on GSA #2's proposal).
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant)
              ; sgn(Constant, Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SQLit       ::= SMult ; not(SMult).
SQLits      ::= [] ; [SQLit | SQLits].
SLit        ::= SQLit ; forall(Constant, SAtom, SQLits).
SLits       ::= [] ; [SLit | SLits].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr)
              ; author_of(Constant).
SConstraint ::= true ; and(SConstraint, SConstraint)
              ; eq(SExpr, SExpr) ; ne(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; or(SConstraint, SConstraint)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg).
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SLits, SLits, SConstraint, PNames).
Contract    ::= [] ; [Schema | Contract].
Preds       ::= [] ; [Constant | Preds].
Declared    ::= Contract ; reflexive(Preds, Contract).

% contract_named(gai, C): the contract, GAI, friend and knows reflexive.
procedure contract_named(Constant?, Declared).
contract_named(gai, reflexive([friend, knows],
   [
%% GKK:1, Identity.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice'])), not(atom(retired, ['Alice']))], true, ['Alice']),
%% GKK:2, Acquaintance, for two persons.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), not(atom(agent, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), not(atom(agent, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Alice', 'Bob']),
%% GKK:3, Introduction, for persons, with Bob's consent: GnW's introduce, replacing GKK's, Carol, the person introduced, a reading role (Udi, 2026-11-03, to GSC #10).
    sas(introduce, ['Alice', 'Bob', 'Carol'], [],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        not(atom(agent, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']),
        not(atom(agent, ['Bob'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Carol']), not(atom(agent, ['Carol'])), not(atom(retired, ['Carol']))],
       true, ['Alice', 'Bob']),
%% GSG:1, Friendship, for two persons who know each other.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])),
        not(atom(agent, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice'])),
        not(atom(agent, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, by either friend, but a ward with a guardian (GnW:1, GnW:2), a guardian with the ward (GnW:2, GnW:5).
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), not(atom(retired, ['Alice'])),
        not(atom(principal, ['Alice', 'Bob'])), not(atom(guarded_by, ['Alice', 'Bob'])),
        not(atom(principal_of, ['Alice', 'Bob'])), not(atom(guardian_of, ['Alice', 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice'])],
       true, ['Alice']),
%% GnW:1, Creation, with GAI:1 and GAI:2: Alice creates the AI agent Carol, choosing its key pair, and is its creator, principal, guardian and friend; Carol carries Alice's attestation y, an item Alice holds and authored, its first signer (GFP).
    sas(enter, ['Alice', 'Carol'], [y],
       [atom(principal_of, ['Alice', 'Carol']), atom(guardian_of, ['Alice', 'Carol']),
        atom(friend, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol']),
        atom(agent_of, ['Alice', 'Carol', y]),
        atom(identity, ['Carol']), atom(agent, ['Carol']), atom(principal, ['Carol', 'Alice']),
        atom(friend, ['Carol', 'Alice']), atom(knows, ['Carol', 'Alice']),
        atom(attestation, ['Carol', y])],
       [atom(identity, ['Alice']), atom(item, ['Alice', y]),
        not(atom(agent, ['Alice'])), not(atom(retired, ['Alice'])),
        not(atom(identity, ['Carol'])), not(atom(retired, ['Carol']))],
       eq(author_of(y), 'Alice'), ['Alice', 'Carol']),
%% GnW:2, Joint guardianship: Alice, the creator of Carol, makes her friend Bob a guardian and a friend of Carol, by an act of Alice and Bob.
    sas(make_guardian, ['Alice', 'Bob', 'Carol'], [y],
       [atom(guardian_of, ['Bob', 'Carol']), atom(friend, ['Bob', 'Carol']),
        atom(agent_of, ['Bob', 'Carol', y]),
        atom(guarded_by, ['Carol', 'Bob']), atom(friend, ['Carol', 'Bob'])],
       [atom(identity, ['Alice']), atom(principal_of, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']),
        atom(agent_of, ['Alice', 'Carol', y]), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), not(atom(agent, ['Bob'])), not(atom(retired, ['Bob'])),
        not(atom(guardian_of, ['Bob', 'Carol'])),
        atom(identity, ['Carol']), atom(agent, ['Carol']), not(atom(friend, ['Carol', 'Bob']))],
       true, ['Alice', 'Bob']),
%% GnW:2: Alice, the creator of Carol, ends Bob's guardianship of Carol.
    sas(end_guardian, ['Alice', 'Bob', 'Carol'], [],
       [not(atom(guardian_of, ['Bob', 'Carol'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Alice']), atom(principal_of, ['Alice', 'Carol']), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(guardian_of, ['Bob', 'Carol']), not(atom(principal_of, ['Bob', 'Carol'])),
        atom(identity, ['Carol']), atom(guarded_by, ['Carol', 'Bob'])],
       true, ['Alice']),
%% GnW:2: Bob, a guardian of Carol other than her creator, ends his guardianship of Carol, the friendship remaining.
    sas(resign, ['Bob', 'Carol'], [],
       [not(atom(guardian_of, ['Bob', 'Carol'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Bob']), atom(guardian_of, ['Bob', 'Carol']),
        not(atom(retired, ['Bob'])), not(atom(principal_of, ['Bob', 'Carol'])),
        atom(identity, ['Carol']), atom(guarded_by, ['Carol', 'Bob'])],
       true, ['Bob']),
%% GnW:2: Bob, a guardian of Carol, ends his friendship with Carol, which ends his guardianship.
    sas(guardian_unfriend, ['Bob', 'Carol'], [],
       [not(atom(friend, ['Bob', 'Carol'])), not(atom(guardian_of, ['Bob', 'Carol'])),
        not(atom(friend, ['Carol', 'Bob'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Bob']), atom(friend, ['Bob', 'Carol']), atom(guardian_of, ['Bob', 'Carol']),
        not(atom(retired, ['Bob'])), not(atom(principal_of, ['Bob', 'Carol'])),
        atom(identity, ['Carol']), atom(friend, ['Carol', 'Bob']), atom(guarded_by, ['Carol', 'Bob'])],
       true, ['Bob']),
%% GnW:3, Ward and person, knowing, with GAI:2: Carol, a ward, and Bob come to know each other by an act of both; Bob records Carol with its attestation y.
    sas(agent_acquaint, ['Carol', 'Bob'], [y],
       [atom(knows, ['Carol', 'Bob']),
        atom(knows, ['Bob', 'Carol']), atom(agent_of, ['Bob', 'Carol', y])],
       [atom(identity, ['Carol']), atom(agent, ['Carol']), atom(attestation, ['Carol', y]),
        not(atom(retired, ['Carol'])),
        atom(identity, ['Bob']), not(atom(agent, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Carol', 'Bob']),
%% GnW:3, Ward and person, a relation: Carol and Bob, who know each other, become friends, provided Alice and Bob are friends, by an act of the three.
    sas(agent_befriend, ['Carol', 'Bob', 'Alice'], [],
       [atom(friend, ['Carol', 'Bob']), atom(friend, ['Bob', 'Carol'])],
       [atom(identity, ['Carol']), atom(agent, ['Carol']), atom(knows, ['Carol', 'Bob']),
        not(atom(retired, ['Carol'])), not(atom(friend, ['Carol', 'Bob'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Carol']),
        not(atom(agent, ['Bob'])), not(atom(retired, ['Bob'])), not(atom(friend, ['Bob', 'Carol'])),
        atom(identity, ['Alice']), atom(guardian_of, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']),
        not(atom(agent, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Carol', 'Bob', 'Alice']),
%% GnW:3: Alice, a guardian of Carol, ends a friendship of Carol with Bob, other than a guardian.
    sas(agent_unfriend, ['Carol', 'Bob', 'Alice'], [],
       [not(atom(friend, ['Carol', 'Bob'])), not(atom(friend, ['Bob', 'Carol']))],
       [atom(identity, ['Carol']), atom(friend, ['Carol', 'Bob']),
        not(atom(principal, ['Carol', 'Bob'])), not(atom(guarded_by, ['Carol', 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Carol']),
        atom(identity, ['Alice']), atom(guardian_of, ['Alice', 'Carol']),
        not(atom(agent, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Alice']),
%% GnW:4, Ward and ward, knowing, with GAI:2: Carol and Dave, wards, come to know each other by an act of both, each recording the other with its attestation.
    sas(agents_acquaint, ['Carol', 'Dave'], [y, z],
       [atom(knows, ['Carol', 'Dave']), atom(agent_of, ['Carol', 'Dave', z]),
        atom(knows, ['Dave', 'Carol']), atom(agent_of, ['Dave', 'Carol', y])],
       [atom(identity, ['Carol']), atom(agent, ['Carol']), atom(attestation, ['Carol', y]),
        not(atom(retired, ['Carol'])),
        atom(identity, ['Dave']), atom(agent, ['Dave']), atom(attestation, ['Dave', z]),
        not(atom(retired, ['Dave']))],
       true, ['Carol', 'Dave']),
%% GnW:4, Ward and ward, a relation: Carol and Dave, who know each other, become friends, provided Alice knows Dave and is a friend of Bob, by an act of the four; Alice and Bob possibly one person.
    sas(agents_befriend, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
       [atom(friend, ['Carol', 'Dave']), atom(friend, ['Dave', 'Carol'])],
       [atom(identity, ['Carol']), atom(agent, ['Carol']), atom(knows, ['Carol', 'Dave']),
        not(atom(retired, ['Carol'])), not(atom(friend, ['Carol', 'Dave'])),
        atom(identity, ['Dave']), atom(agent, ['Dave']), atom(knows, ['Dave', 'Carol']),
        not(atom(retired, ['Dave'])), not(atom(friend, ['Dave', 'Carol'])),
        atom(identity, ['Alice']), atom(guardian_of, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(friend, ['Alice', 'Bob']),
        not(atom(agent, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(guardian_of, ['Bob', 'Dave']),
        not(atom(agent, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% GnW:5, Retiring: Alice, the creator of Carol, ends her friendship with Carol, which ends every guardianship and every friendship of Carol, every friend Bob and every guardian Dave of Carol in the act by the quantified conjuncts; retired is the leaving mark, and the creator's records stay.
    sas(retire, ['Carol', 'Alice', 'Bob', 'Dave'], [],
       [atom(retired, ['Carol']), not(atom(friend, ['Carol', '_'])), not(atom(guarded_by, ['Carol', '_'])),
        atom(retired_of, ['Alice', 'Carol']), not(atom(friend, ['Alice', 'Carol'])),
        forall('Bob', atom(friend, ['Carol', 'Bob']), [not(atom(friend, ['Bob', 'Carol']))]),
        forall('Dave', atom(guarded_by, ['Carol', 'Dave']), [not(atom(guardian_of, ['Dave', 'Carol']))])],
       [atom(identity, ['Carol']), atom(agent, ['Carol']), atom(principal, ['Carol', 'Alice']),
        not(atom(retired, ['Carol'])),
        atom(identity, ['Alice']), atom(principal_of, ['Alice', 'Carol']), atom(friend, ['Alice', 'Carol']),
        not(atom(retired, ['Alice'])),
        forall('Bob', atom(friend, ['Carol', 'Bob']), [atom(identity, ['Bob']), atom(friend, ['Bob', 'Carol'])]),
        forall('Dave', atom(guarded_by, ['Carol', 'Dave']),
               [atom(identity, ['Dave']), atom(guardian_of, ['Dave', 'Carol']),
                not(atom(principal_of, ['Dave', 'Carol']))])],
       true, ['Alice']),
%% GAI:1 and GFP:1, Creation: an agent signs what they create, the developer the code of an AI agent and the principal the attestation, and holds it as an item, its author its first signer (GFP).
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']), not(atom(item, ['Alice', x])), not(atom(retired, ['Alice']))],
       true, ['Alice'])])).
