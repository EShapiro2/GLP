%% ---------------------------------------------------------------------------
%% GAI.glp --- GAI, Accountable AI Agents, GAI's contract (Coordination
%% Appendix C; to_all 2026-10-18 19:23 UTC), its clauses in GAI.md beside this
%% file, extending Wards (programs/gsc/Wards.md), with GSG (GSG.md, GSG.glp)
%% and GSNP's signing and forwarding (GSNP.md) beneath it, in the term form
%% programs/gsc reads (its README, "Writing a contract").  The term is the
%% contract for friendship: GSG's schemas with identity required, the wards
%% core's for an AI agent and its principal, GAI's retire, and GSNP's sign and
%% forward with identity required and retired forbidden at the acting role.
%% establish realises a person choosing their key pair (GSG:1); GAI:1, GAI:3
%% and the principal knowing the developer (GAI:2) describe no act.  A ward's
%% membership of a group (Wards:2 with GSN:3) is not in this term.
%%
%% Eleven schemas over twelve predicates.  unfriend carries no ? and stands for one
%% schema per role, guarded at that role, unfriend_p and unfriend_q, as CSSN
%% writes it.  Every role requires identity, except the role of establish,
%% which adds it and requires and forbids nothing (GSC, def:unobstructed,
%% clause 1), and the AI agent's role of enter, which forbids it and adds it.
%% A role is its index in the schema, in the order of the schema's parameters; p and q are
%% persons, r and s AI agents, every role a party role; x, an item, is a
%% speech-act variable, svar, and sgn(x, p) is x signed over by the party in
%% role p (GSC, Section 3.1).  A role is
%% rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i).
%%
%%   establish(p?)      :  +identity
%%   befriend(p?, q?)   :  identity, not agent, not friend(q), +friend(q)
%%                         identity, not agent, not friend(p), +friend(p)
%%   unfriend_p(p?, q)  :  identity, not retired, -friend(q)
%%                         identity, -friend(p)
%%   unfriend_q(p, q?)  :  identity, -friend(q)
%%                         identity, not retired, -friend(p)
%%   enter(p?, r?)      :  identity, not agent, +principal_of(r), +friend(r)
%%                         not identity, +identity, +agent, +principal(p), +friend(p)
%%   agent_befriend(r?, q?, p?) :
%%                         identity, agent, principal(p), not retired, not friend(q), +friend(q)
%%                         identity, not agent, not friend(r), +friend(r), +agent_of(r, p)
%%                         identity, principal_of(r), +approval
%%   agents_befriend(r?, s?, p?, q?) :
%%                         identity, agent, principal(p), not retired, not friend(s), +friend(s), +agent_of(s, q)
%%                         identity, agent, principal(q), not retired, not friend(r), +friend(r), +agent_of(r, p)
%%                         identity, principal_of(r), +approval
%%                         identity, principal_of(s), +approval
%%   agent_unfriend(r, q, p?) :
%%                         identity, principal(p), -friend(q)
%%                         identity, -friend(r)
%%                         identity, principal_of(r), +withdrawal
%%   retire(p?, r)      :  identity, principal_of(r), +retired_of(r)
%%                         identity, agent, principal(p), not retired, +retired
%%   sign(p?; x)        :  identity, not retired, +item(x)
%%   forward(p?, q; x)  :  identity, item(x), not retired, +sent(x, q)
%%                         identity, friend(p), +item(sgn(x, p))
%%
%% The ? on an AI agent's role (r in enter, agent_befriend and agents_befriend,
%% s in agents_befriend) is taken by the AI agent's program, in enter as the
%% program the principal set up, and after it under the principal's will,
%% given once, on creating it (GAI's paper, Section 4.1).
%% ---------------------------------------------------------------------------

%% The contract, as programs/gsc/self.glp writes it.
NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Schema    ::= schema(Constant, RoleSpecs) ; cschema(Constant, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gai, C): the contract.
procedure contract_named(Constant?, Declared).
contract_named(gai,
%%   establish(p?) :
%%       at p:  +identity
   [schema(establish,
       [rs(guarded, [atom(identity, [])], [], [], [])]),
%%   befriend(p?, q?) :
%%       at p:  identity, not agent, not friend(q), +friend(q)
%%       at q:  identity, not agent, not friend(p), +friend(p)
    schema(befriend,
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(friend, [role(1)])])]),
%%   unfriend_p(p?, q) :
%%       at p:  identity, not retired, -friend(q)
%%       at q:  identity, -friend(p)
    schema(unfriend_p,
       [rs(guarded, [], [atom(friend, [role(2)])], [atom(identity, [])],
                    [atom(retired, [])]),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
%%   unfriend_q(p, q?) :
%%       at p:  identity, -friend(q)
%%       at q:  identity, not retired, -friend(p)
    schema(unfriend_q,
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(guarded, [], [atom(friend, [role(1)])], [atom(identity, [])],
                    [atom(retired, [])])]),
%%   enter(p?, r?) :
%%       at p:  identity, not agent, +principal_of(r), +friend(r)
%%       at r:  not identity, +identity, +agent, +principal(p), +friend(p)
    schema(enter,
       [rs(guarded, [atom(principal_of, [role(2)]), atom(friend, [role(2)])], [],
                    [atom(identity, [])], [atom(agent, [])]),
        rs(guarded, [atom(identity, []), atom(agent, []), atom(principal, [role(1)]),
                     atom(friend, [role(1)])], [],
                    [], [atom(identity, [])])]),
%%   agent_befriend(r?, q?, p?) :
%%       at r:  identity, agent, principal(p), not retired, not friend(q), +friend(q)
%%       at q:  identity, not agent, not friend(r), +friend(r), +agent_of(r, p)
%%       at p:  identity, principal_of(r), +approval
    schema(agent_befriend,
       [rs(guarded, [atom(friend, [role(2)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(3)])],
                    [atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)]), atom(agent_of, [role(1), role(3)])], [],
                    [atom(identity, [])],
                    [atom(agent, []), atom(friend, [role(1)])]),
        rs(guarded, [atom(approval, [])], [],
                    [atom(identity, []), atom(principal_of, [role(1)])], [])]),
%%   agents_befriend(r?, s?, p?, q?) :
%%       at r:  identity, agent, principal(p), not retired, not friend(s), +friend(s), +agent_of(s, q)
%%       at s:  identity, agent, principal(q), not retired, not friend(r), +friend(r), +agent_of(r, p)
%%       at p:  identity, principal_of(r), +approval
%%       at q:  identity, principal_of(s), +approval
    schema(agents_befriend,
       [rs(guarded, [atom(friend, [role(2)]), atom(agent_of, [role(2), role(4)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(3)])],
                    [atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)]), atom(agent_of, [role(1), role(3)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(4)])],
                    [atom(retired, []), atom(friend, [role(1)])]),
        rs(guarded, [atom(approval, [])], [],
                    [atom(identity, []), atom(principal_of, [role(1)])], []),
        rs(guarded, [atom(approval, [])], [],
                    [atom(identity, []), atom(principal_of, [role(2)])], [])]),
%%   agent_unfriend(r, q, p?) :
%%       at r:  identity, principal(p), -friend(q)
%%       at q:  identity, -friend(r)
%%       at p:  identity, principal_of(r), +withdrawal
    schema(agent_unfriend,
       [rs(unguarded, [], [atom(friend, [role(2)])],
                      [atom(identity, []), atom(principal, [role(3)])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], []),
        rs(guarded, [atom(withdrawal, [])], [],
                    [atom(identity, []), atom(principal_of, [role(1)])], [])]),
%%   retire(p?, r) :
%%       at p:  identity, principal_of(r), +retired_of(r)
%%       at r:  identity, agent, principal(p), not retired, +retired
    schema(retire,
       [rs(guarded, [atom(retired_of, [role(2)])], [],
                    [atom(identity, []), atom(principal_of, [role(2)])], []),
        rs(unguarded, [atom(retired, [])], [],
                      [atom(identity, []), atom(agent, []), atom(principal, [role(1)])],
                      [atom(retired, [])])]),
%%   sign(p? ; x) :
%%       at p:  identity, not retired, +item(x)
    schema(sign,
       [rs(guarded, [atom(item, [svar(x)])], [],
                    [atom(identity, [])], [atom(retired, [])])]),
%%   forward(p?, q ; x) :
%%       at p:  identity, item(x), not retired, +sent(x, q)
%%       at q:  identity, friend(p), +item(sgn(x, p))
    schema(forward,
       [rs(guarded, [atom(sent, [svar(x), role(2)])], [],
                    [atom(identity, []), atom(item, [svar(x)])],
                    [atom(retired, [])]),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(identity, []), atom(friend, [role(1)])], [])])]).
