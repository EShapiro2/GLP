%% ---------------------------------------------------------------------------
%% GSNP.glp --- Grassroots Social Network with Provenance, GAI's (Udi, 2026-10-20; GSC's until that day), in the term form programs/gsc reads (its README, "Writing a contract").  The clauses are in GSNP.txt beside this file; GSNP extends GSN, which extends GSG, which extends GKK, so the term holds the schemas of all four, and every role but establish's requires identity.  Written by GSC #2 Cowork, 2026-10-18; GAI's since 2026-10-20.  This term is the one source of the schemas: a run of the cascade prints their notation from it as schemas.txt (cascade.sh, programs/gsc/notation.glp).
%% Eighteen schemas over ten predicates.  A schema's second argument lists its variables in the order of its head; a role is rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i), named by its index, role(1) the schema's first role; x, y, and n, a group's name, are speech-act variables, svar, and sgn(x, 1) is the signed term sgn(x, p), x signed over by the agent in role 1, which requires an atom with x among its arguments (GAI's paper, Appendix "Contracts with Wards", signed terms).  A message carries an item its sender authored as they signed it, and forwards an item they received; a group's leader delivers a member's message by forwarding it, signed by the leader, and their own as they signed it (Udi, 2026-10-18; 2026-10-19, to GSC #4).  A post and a delivery require that the member be the leader's friend, and drop ends the membership of a member who is not (CSSN #6's request, approved by Udi, 2026-10-19).  A group is named by its community name <a>.n (GSC, Appendix D), and close takes the listed role a[listed(*, n)], every member the leader lists (GSC, Appendix D.4).
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant)
            ; listed(Integer, Constant, Args).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Schema    ::= schema(Constant, Args, RoleSpecs) ; cschema(Constant, Args, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gsnp, C): the contract, GSNP (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gsnp,
%% GKK:1, Identity.
   [schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
%% GKK:2, Meeting.
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
%% GKK:3, Introduction.
    schema(introduce, [pvar(c)],
       [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
        rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GSG:1, Friendship, for two agents who know each other, and GSG:2, Ending a friendship.
    schema(befriend, [],
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(knows, [role(2)])], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(knows, [role(1)])], [atom(friend, [role(1)])])]),
    schema(unfriend, [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
%% GSNP:1, Authorship, and GSN:1, Message, for content the sender created.
    schema(sign, [svar(x)],
       [rs(guarded, [atom(item, [svar(x)]), atom(authored, [svar(x)])], [], [atom(identity, [])], [])]),
    schema(message, [svar(x)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(authored, [svar(x)])], []),
        rs(unguarded, [atom(item, [svar(x)])], [],
                      [atom(identity, []), atom(friend, [role(1)])], [])]),
%% GSN:1, Message, for content the sender received, with GSNP:2, Forwarding.
    schema(forward, [svar(x)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(item, [svar(x)])],
                      [atom(authored, [svar(x)])]),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(identity, []), atom(friend, [role(1)])], [])]),
%% GSN:2, Group.
    schema(create, [svar(n)],
       [rs(guarded, [atom(member, [nterm(ext(own(1), n))]),
                     atom(listed, [role(1), svar(n)])], [], [atom(identity, [])],
                    [atom(member, [nterm(ext(own(1), n))]), atom(closed, [svar(n)])])]),
%% GSN:3, Joining.
    schema(join, [svar(n)],
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(friend, [role(2)])], []),
        rs(guarded, [atom(member, [nterm(ext(own(1), n))])], [],
                    [atom(identity, []), atom(friend, [role(1)])],
                    [atom(member, [nterm(ext(own(1), n))])])]),
%% GSN:4, Leaving: a member leaves; the leader leaving ends the group; a member who is not a friend of the leader is removed.
    schema(leave, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], []),
        rs(guarded,   [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
    cschema(close, [svar(n)], [],
       [rs(guarded, [atom(closed, [svar(n)])],
                    [atom(listed, [role(1), svar(n)])], [atom(identity, [])], []),
        crs(listed(1, listed, [svar(n)]), unguarded,
            [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
    schema(drop, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], [atom(friend, [role(2)])]),
        rs(unguarded, [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% GSN:5, Group message, with GSNP:2: the leader's item; a member's own item, sent to the leader as they signed it, and an item they received, forwarded to the leader; the leader forwarding a posted item to every member, and delivering their own as they signed it.
    schema(post_own, [svar(x), svar(n)],
       [rs(guarded, [atom(posted, [svar(x), svar(n)])], [],
                    [atom(identity, []), atom(item, [svar(x)]), atom(member, [nterm(ext(own(1), n))])],
                    [atom(posted, [svar(x), svar(n)])])]),
    schema(post, [svar(x), svar(n)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(authored, [svar(x)]), atom(member, [nterm(ext(own(2), n))])], []),
        rs(unguarded, [atom(posted, [svar(x), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(2), n))]),
                       atom(listed, [role(1), svar(n)]), atom(friend, [role(1)])], [])]),
    schema(post_forward, [svar(x), svar(n)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(item, [svar(x)]), atom(member, [nterm(ext(own(2), n))])],
                      [atom(authored, [svar(x)])]),
        rs(unguarded, [atom(posted, [sgn(x, 1), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(2), n))]),
                       atom(listed, [role(1), svar(n)]), atom(friend, [role(1)])], [])]),
    schema(deliver, [svar(y), svar(n)],
       [rs(unguarded, [atom(delivered, [svar(y), role(2), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))]),
                       atom(posted, [svar(y), svar(n)]),
                       atom(listed, [role(2), svar(n)]), atom(friend, [role(2)])],
                      [atom(authored, [svar(y)]), atom(delivered, [svar(y), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [sgn(y, 1)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [])]),
    schema(deliver_own, [svar(y), svar(n)],
       [rs(unguarded, [atom(delivered, [svar(y), role(2), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))]),
                       atom(posted, [svar(y), svar(n)]), atom(authored, [svar(y)]),
                       atom(listed, [role(2), svar(n)]), atom(friend, [role(2)])],
                      [atom(delivered, [svar(y), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [svar(y)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [])])]).
