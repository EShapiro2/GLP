%% ---------------------------------------------------------------------------
%% GSNP.glp --- Grassroots Social Network with Provenance, GAI's (Udi, 2026-10-20; GSC's until that day), in the term form programs/gsc reads (its README, "Writing a contract").  The clauses are in GSNP.txt beside this file; GSNP extends GSN, GSC's, and GnW and GAI, GAI's, so the term holds the schemas of the whole platform of GAI's paper, Section 4: GKK's, GSG's and GnW's and GAI's for an AI agent and its principal, as GAI.glp has them, with sign, message and forward and the ten schemas of a group (Udi, 2026-10-24, approving GAI #8's proposal that the contracts say what the paper says).  This term is the one source of the schemas: a run of the cascade prints their notation from it as schemas.txt (cascade.sh, programs/gsc/notation.glp).
%% Twenty-five schemas over seventeen predicates.  A schema's second argument names its roles as its clause does (GSC, 2026-10-25), its third lists its variables in the order of its head; a role is rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i), named by its index, role(1) the schema's first role; x, y, z and n, a group's name, are speech-act variables, svar, and sgn(x, 1) is the signed term sgn(x, p), x signed over by the agent in role 1, which requires an atom with x among its arguments (GAI's paper, Appendix "Contracts with Wards", signed terms).  A message carries an item its sender authored as they signed it, and forwards an item they received; a group's leader delivers a member's message by forwarding it, signed by the leader, and their own as they signed it (Udi, 2026-10-18; 2026-10-19, to GSC #4).  A post and a delivery require that the member be the leader's friend, and drop ends the membership of a member who is not (CSSN #6's request, approved by Udi, 2026-10-19).  A group is named by its community name <a>.n (GSC, Appendix D), and close takes the listed role a[listed(*, n)], every member the leader lists (GSC, Appendix D.4).
%% Every guarding role forbids retired, the leaving mark, and create and join forbid agent: an AI agent takes no group act in this term, the ward's membership of GnW:2 being left out, as GAI's paper says (Section 3.2); an AI agent signs, messages and forwards as any agent does.
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant)
            ; listed(Integer, Constant, Args).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Name      ::= Constant ; one(Constant, Constant).
Names     ::= [] ; [Name | Names].
Schema    ::= schema(Constant, Names, Args, RoleSpecs) ; cschema(Constant, Names, Args, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gsnp, C): the contract, GSNP (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gsnp,
%% GKK:1, Identity.
   [schema(establish, ['Alice'], [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(identity, []), atom(retired, [])])]),
%% GKK:2, Acquaintance, for two persons; an AI agent comes to know an agent by agent_acquaint or agents_acquaint (GnW:2).
    schema(acquaint, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(retired, [])])]),
%% GKK:3, Introduction, between persons: an AI agent neither introduces nor is introduced (GnW:2, GAI:2).
    schema(introduce, ['Alice', 'Bob'], [pvar(c)],
       [rs(guarded, [], [],
                    [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(knows, [pvar(c)])], [],
                    [atom(identity, []), atom(knows, [role(1)])],
                    [atom(agent, []), atom(retired, [])])]),
%% GSG:1, Friendship, for two persons who know each other.
    schema(befriend, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(friend, [role(2)])], [],
                    [atom(identity, []), atom(knows, [role(2)])],
                    [atom(agent, []), atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [],
                    [atom(identity, []), atom(knows, [role(1)])],
                    [atom(agent, []), atom(retired, []), atom(friend, [role(1)])])]),
%% GSG:2, Ending a friendship, by either friend, unless one is an AI agent of the other (GnW:3, GAI:4).
    schema(unfriend, ['Alice', 'Bob'], [],
       [rs(guarded, [], [atom(friend, [role(2)])], [atom(identity, [])],
                    [atom(retired, []), atom(principal, [role(2)]),
                     atom(principal_of, [role(2)])]),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
%% GnW:1 and GAI:1: a person creates an AI agent, attesting that it runs the code x signed by its developer, and is its principal and friend.
    schema(enter, ['Alice', 'Carol'], [svar(x)],
       [rs(guarded, [atom(principal_of, [role(2)]), atom(friend, [role(2)]), atom(knows, [role(2)]),
                     atom(agent_of, [role(2), role(1), sgn(x, 1)])], [],
                    [atom(identity, []), atom(item, [svar(x)])], [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(identity, []), atom(agent, []), atom(principal, [role(1)]),
                     atom(friend, [role(1)]), atom(knows, [role(1)]), atom(attestation, [sgn(x, 1)])], [],
                    [], [atom(identity, []), atom(retired, [])])]),
%% GnW:2, knowing, and GAI:2: an AI agent and a person come to know each other by an act of both and of the principal, the person recording the AI agent, its principal and its attestation.
    schema(agent_acquaint, ['Carol', 'Bob', 'Alice'], [svar(y)],
       [rs(guarded, [atom(knows, [role(2)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(3)]),
                     atom(attestation, [svar(y)])],
                    [atom(retired, [])]),
        rs(guarded, [atom(knows, [role(1)]), atom(agent_of, [role(1), role(3), svar(y)])], [],
                    [atom(identity, [])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(1)]),
                     atom(agent_of, [role(1), role(3), svar(y)])], [atom(retired, [])])]),
%% GnW:2, knowing, and GAI:2, for two AI agents and their principals.
    schema(agents_acquaint, ['Carol', 'Bob', 'Alice', one('Dave', 'Alice')], [svar(y), svar(z)],
       [rs(guarded, [atom(knows, [role(2)]), atom(agent_of, [role(2), role(4), svar(z)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(3)]),
                     atom(attestation, [svar(y)])],
                    [atom(retired, [])]),
        rs(guarded, [atom(knows, [role(1)]), atom(agent_of, [role(1), role(3), svar(y)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(4)]),
                     atom(attestation, [svar(z)])],
                    [atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(1)]),
                     atom(agent_of, [role(1), role(3), svar(y)])], [atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(2)]),
                     atom(agent_of, [role(2), role(4), svar(z)])], [atom(retired, [])])]),
%% GnW:2, a relation: an AI agent and a person who know each other befriend by an act of both and of the principal.  The AI agent knows the person only by agent_acquaint, which recorded the attestation at the person (acquaint and introduce forbid agent at the role coming to know), so the person holds it.
    schema(agent_befriend, ['Carol', 'Bob', 'Alice'], [],
       [rs(guarded, [atom(friend, [role(2)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(3)]),
                     atom(knows, [role(2)])],
                    [atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [],
                    [atom(identity, []), atom(knows, [role(1)])],
                    [atom(agent, []), atom(retired, []), atom(friend, [role(1)])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(1)])], [atom(retired, [])])]),
%% GnW:2, a relation, for two AI agents who know each other and their principals.
    schema(agents_befriend, ['Carol', 'Bob', 'Alice', one('Dave', 'Alice')], [],
       [rs(guarded, [atom(friend, [role(2)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(3)]),
                     atom(knows, [role(2)])],
                    [atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [],
                    [atom(identity, []), atom(agent, []), atom(principal, [role(4)]),
                     atom(knows, [role(1)])],
                    [atom(retired, []), atom(friend, [role(1)])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(1)])], [atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(2)])], [atom(retired, [])])]),
%% GnW:3: the principal ends a friendship of its AI agent, other than their own.
    schema(agent_unfriend, ['Carol', 'Bob', 'Alice'], [],
       [rs(unguarded, [], [atom(friend, [role(2)])],
                      [atom(identity, []), atom(principal, [role(3)])],
                      [atom(principal, [role(2)])]),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], []),
        rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(1)])], [atom(retired, [])])]),
%% GAI:4, with GnW:3 and GnW:4: the principal retires its AI agent by ending their friendship, which ends the guardianship; retired is the leaving mark.
    schema(retire, ['Alice', 'Alf'], [],
       [rs(guarded, [atom(retired_of, [role(2)])], [atom(friend, [role(2)])],
                    [atom(identity, []), atom(principal_of, [role(2)])], [atom(retired, [])]),
        rs(unguarded, [atom(retired, [])], [atom(friend, [role(1)])],
                      [atom(identity, []), atom(agent, []), atom(principal, [role(1)])],
                      [atom(retired, [])])]),
%% GSNP:1, Authorship, and GSN:1, Message, for content the sender created; GSNP:2, Forwarding, for content received: as GSNP.glp has them, with retired forbidden at the acting role.
    schema(sign, ['Alice'], [svar(x)],
       [rs(guarded, [atom(item, [svar(x)]), atom(authored, [svar(x)])], [],
                    [atom(identity, [])], [atom(retired, [])])]),
    schema(message, ['Alice', 'Bob'], [svar(x)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(authored, [svar(x)]), atom(friend, [role(2)])],
                      [atom(retired, [])]),
        rs(unguarded, [atom(item, [svar(x)])], [],
                      [atom(identity, [])], [])]),
    schema(forward, ['Alice', 'Bob'], [svar(x)],
       [rs(guarded, [], [],
                    [atom(identity, []), atom(item, [svar(x)]), atom(friend, [role(2)])],
                    [atom(authored, [svar(x)]), atom(retired, [])]),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(identity, [])], [])]),
%% GSN:2, Group.
    schema(create, ['Alice'], [svar(n)],
       [rs(guarded, [atom(member, [nterm(ext(own(1), n))]),
                     atom(listed, [role(1), svar(n)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(retired, []), atom(member, [nterm(ext(own(1), n))]), atom(closed, [svar(n)])])]),
%% GSN:3, Joining.
    schema(join, ['Alice', 'Bob'], [svar(n)],
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(friend, [role(2)])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(member, [nterm(ext(own(1), n))])], [],
                    [atom(identity, [])],
                    [atom(agent, []), atom(retired, []), atom(member, [nterm(ext(own(1), n))])])]),
%% GSN:4, Leaving: a member leaves; the leader leaving ends the group; a member who is not a friend of the leader is removed.
    schema(leave, ['Alice', 'Bob'], [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], []),
        rs(guarded,   [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [atom(retired, [])])]),
    cschema(close, ['Alice', 'Alice'], [svar(n)], [],
       [rs(guarded, [atom(closed, [svar(n)])],
                    [atom(listed, [role(1), svar(n)])], [atom(identity, [])], [atom(retired, [])]),
        crs(listed(1, listed, [svar(n)]), unguarded,
            [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
    schema(drop, ['Alice', 'Bob'], [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], [atom(friend, [role(2)])]),
        rs(unguarded, [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% GSN:5, Group message, with GSNP:2: the leader's item; a member's own item, sent to the leader as they signed it, and an item they received, forwarded to the leader; the leader forwarding a posted item to every member, and delivering their own as they signed it.
    schema(post_own, ['Alice'], [svar(x), svar(n)],
       [rs(guarded, [atom(posted, [svar(x), svar(n)])], [],
                    [atom(identity, []), atom(item, [svar(x)]), atom(member, [nterm(ext(own(1), n))])],
                    [atom(retired, []), atom(posted, [svar(x), svar(n)])])]),
    schema(post, ['Bob', 'Alice'], [svar(x), svar(n)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(authored, [svar(x)]), atom(member, [nterm(ext(own(2), n))])],
                      [atom(retired, [])]),
        rs(unguarded, [atom(posted, [svar(x), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(2), n))]),
                       atom(listed, [role(1), svar(n)]), atom(friend, [role(1)])], [])]),
    schema(post_forward, ['Bob', 'Alice'], [svar(x), svar(n)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(item, [svar(x)]), atom(member, [nterm(ext(own(2), n))])],
                      [atom(authored, [svar(x)]), atom(retired, [])]),
        rs(unguarded, [atom(posted, [sgn(x, 1), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(2), n))]),
                       atom(listed, [role(1), svar(n)]), atom(friend, [role(1)])], [])]),
    schema(deliver, ['Alice', 'Bob'], [svar(y), svar(n)],
       [rs(unguarded, [atom(delivered, [svar(y), role(2), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))]),
                       atom(posted, [svar(y), svar(n)]),
                       atom(listed, [role(2), svar(n)]), atom(friend, [role(2)])],
                      [atom(authored, [svar(y)]), atom(delivered, [svar(y), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [sgn(y, 1)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [])]),
    schema(deliver_own, ['Alice', 'Bob'], [svar(y), svar(n)],
       [rs(unguarded, [atom(delivered, [svar(y), role(2), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))]),
                       atom(posted, [svar(y), svar(n)]), atom(authored, [svar(y)]),
                       atom(listed, [role(2), svar(n)]), atom(friend, [role(2)])],
                      [atom(delivered, [svar(y), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [svar(y)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [])])]).
