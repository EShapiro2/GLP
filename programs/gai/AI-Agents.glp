 sas(person_unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(enter, ['Alice', 'Alf'], ['Proof'], [atom(identity, ['Alf']), atom(ai_agent, ['Alf']), atom(has_guardian, ['Alf', 'Alice']), atom(principal, ['Alice', 'Alf']), atom(guardian, ['Alice', 'Alf']), atom(knows, ['Alice', 'Alf']), atom(knows, ['Alf', 'Alice']), atom(friend, ['Alice', 'Alf']), atom(friend, ['Alf', 'Alice']), atom(attestation, ['Alf', 'Proof']), atom(attestation_record, ['Alice', 'Alf', 'Proof'])], [atom(identity, ['Alice']), atom(person, ['Alice']), not(atom(identity, ['Alf'])), atom(item, ['Alice', 'Proof'])], eq(author_of('Proof'), 'Alice'), ['Alice', 'Alf']),
 sas(make_guardian, ['Bob', 'Alf', 'Decider', 'Codecider'], ['Proof'], [atom(guardian, ['Bob', 'Alf']), atom(has_guardian, ['Alf', 'Bob']), atom(knows, ['Bob', 'Alf']), atom(knows, ['Alf', 'Bob']), atom(friend, ['Bob', 'Alf']), atom(friend, ['Alf', 'Bob']), atom(attestation_record, ['Bob', 'Alf', 'Proof'])], [atom(identity, ['Bob']), atom(identity, ['Alf']), atom(identity, ['Decider']), atom(ai_agent, ['Alf']), not(atom(retired, ['Alf'])), atom(person, ['Bob']), atom(friend, ['Bob', 'Decider']), not(atom(guardian, ['Bob', 'Alf'])), not(atom(has_guardian, ['Alf', 'Bob'])), atom(attestation, ['Alf', 'Proof']), atom(has_guardian, ['Alf', 'Decider']), atom(person, ['Decider']), atom(guardian, ['Decider', 'Alf']), atom(attestation_record, ['Decider', 'Alf', 'Proof']), forall(['Codecider'], atom(has_guardian, ['Alf', 'Codecider']), true, and(atom(identity, ['Codecider']), and(atom(person, ['Codecider']), and(atom(guardian, ['Codecider', 'Alf']), atom(attestation_record, ['Codecider', 'Alf', 'Proof'])))))], true, ['Bob', 'Decider', 'Codecider']),
 sas(resign, ['Bob', 'Alf'], [], [not(atom(guardian, ['Bob', 'Alf'])), not(atom(has_guardian, ['Alf', 'Bob']))], [atom(identity, ['Bob']), atom(identity, ['Alf']), atom(guardian, ['Bob', 'Alf']), atom(has_guardian, ['Alf', 'Bob']), atom(person, ['Bob'])], true, ['Bob']),
 sas(end_guardian, ['Bob', 'Alf', 'Decider', 'Codecider'], [], [not(atom(guardian, ['Bob', 'Alf'])), not(atom(has_guardian, ['Alf', 'Bob']))], [atom(identity, ['Bob']), atom(identity, ['Alf']), atom(identity, ['Decider']), atom(guardian, ['Bob', 'Alf']), atom(has_guardian, ['Alf', 'Bob']), atom(has_guardian, ['Alf', 'Decider']), atom(person, ['Decider']), atom(guardian, ['Decider', 'Alf']), forall(['Codecider'], atom(has_guardian, ['Alf', 'Codecider']), ne('Codecider', 'Bob'), and(atom(identity, ['Codecider']), and(atom(person, ['Codecider']), atom(guardian, ['Codecider', 'Alf']))))], true, ['Decider', 'Codecider']),
 sas(guardian_unfriend, ['Bob', 'Alf'], [], [not(atom(friend, ['Bob', 'Alf'])), not(atom(friend, ['Alf', 'Bob'])), not(atom(guardian, ['Bob', 'Alf'])), not(atom(has_guardian, ['Alf', 'Bob']))], [atom(identity, ['Bob']), atom(identity, ['Alf']), atom(friend, ['Bob', 'Alf']), atom(friend, ['Alf', 'Bob']), atom(guardian, ['Bob', 'Alf']), atom(has_guardian, ['Alf', 'Bob']), atom(person, ['Bob'])], true, ['Bob']),
