 sas(ai_agent_befriend, ['Alf', 'Bob', 'Alice'], ['Proof'], [atom(friend, ['Alf', 'Bob']), atom(friend, ['Bob', 'Alf'])], [atom(identity, ['Alf']), atom(identity, ['Bob']), atom(identity, ['Alice']), atom(ai_agent, ['Alf']), not(atom(retired, ['Alf'])), atom(has_guardian, ['Alf', 'Alice']), atom(person, ['Bob']), atom(knows, ['Alf', 'Bob']), atom(knows, ['Bob', 'Alf']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(friend, ['Alf', 'Bob'])), not(atom(friend, ['Bob', 'Alf'])), atom(attestation, ['Alf', 'Proof']), atom(person, ['Alice'])], true, ['Alf', 'Bob', 'Alice']),
 sas(ai_agent_end, ['Alf', 'Bob'], ['Proof'], [not(atom(friend, ['Alf', 'Bob'])), not(atom(friend, ['Bob', 'Alf']))], [atom(identity, ['Alf']), atom(identity, ['Bob']), not(atom(has_guardian, ['Alf', 'Bob'])), atom(friend, ['Alf', 'Bob']), atom(friend, ['Bob', 'Alf']), atom(attestation, ['Alf', 'Proof']), or(atom(person, ['Alf']), and(atom(ai_agent, ['Alf']), exists(['G1'], atom(has_guardian, ['Alf', 'G1']), true)))], true, ['Alf']),
 sas(unfriend, ['Bob', 'Alf'], [], [not(atom(friend, ['Bob', 'Alf'])), not(atom(friend, ['Alf', 'Bob']))], [atom(identity, ['Bob']), atom(identity, ['Alf']), not(atom(guardian, ['Bob', 'Alf'])), atom(friend, ['Bob', 'Alf']), atom(friend, ['Alf', 'Bob']), atom(person, ['Bob'])], true, ['Bob']),
 sas(ai_agent_unfriend, ['Alf', 'Bob', 'Alice'], [], [not(atom(friend, ['Alf', 'Bob'])), not(atom(friend, ['Bob', 'Alf']))], [atom(identity, ['Alf']), atom(identity, ['Bob']), atom(identity, ['Alice']), atom(has_guardian, ['Alf', 'Alice']), not(atom(guardian, ['Bob', 'Alf'])), atom(friend, ['Alf', 'Bob']), atom(friend, ['Bob', 'Alf']), atom(person, ['Alice'])], true, ['Alice']),
 sas(ai_agents_acquaint, ['Alf', 'Will', 'Alice', one('Bob', 'Alice')], ['Seal', 'Proof', 'Alice', 'Bob'], [atom(knows, ['Alf', 'Will']), atom(knows, ['Will', 'Alf']), atom(attestation_record, ['Alf', 'Will', 'Seal']), atom(attestation_record, ['Will', 'Alf', 'Proof'])], [atom(identity, ['Alf']), atom(identity, ['Will']), atom(ai_agent, ['Alf']), atom(has_guardian, ['Alf', 'Alice']), atom(ai_agent, ['Will']), atom(has_guardian, ['Will', 'Bob']), atom(attestation, ['Alf', 'Proof']), atom(attestation, ['Will', 'Seal'])], true, ['Alf', 'Will']),
 sas(ai_agents_befriend, ['Alf', 'Will', 'Alice', one('Bob', 'Alice')], ['Proof', 'Seal'], [atom(friend, ['Alf', 'Will']), atom(friend, ['Will', 'Alf'])], [atom(identity, ['Alf']), atom(identity, ['Will']), atom(identity, ['Alice']), atom(identity, ['Bob']), atom(ai_agent, ['Alf']), not(atom(retired, ['Alf'])), atom(has_guardian, ['Alf', 'Alice']), atom(ai_agent, ['Will']), not(atom(retired, ['Will'])), atom(has_guardian, ['Will', 'Bob']), atom(knows, ['Alf', 'Will']), atom(knows, ['Will', 'Alf']), atom(knows, ['Alice', 'Will']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(friend, ['Alf', 'Will'])), not(atom(friend, ['Will', 'Alf'])), atom(attestation, ['Alf', 'Proof']), atom(attestation, ['Will', 'Seal']), atom(person, ['Alice']), atom(person, ['Bob'])], true, ['Alf', 'Will', 'Alice', 'Bob']),
 sas(ai_agents_of_one_guardian_befriend, ['Alf', 'Will', 'Alice'], ['Proof', 'Seal'], [atom(friend, ['Alf', 'Will']), atom(friend, ['Will', 'Alf'])], [atom(identity, ['Alf']), atom(identity, ['Will']), atom(identity, ['Alice']), atom(ai_agent, ['Alf']), not(atom(retired, ['Alf'])), atom(has_guardian, ['Alf', 'Alice']), atom(ai_agent, ['Will']), not(atom(retired, ['Will'])), atom(has_guardian, ['Will', 'Alice']), atom(knows, ['Alf', 'Will']), atom(knows, ['Will', 'Alf']), not(atom(friend, ['Alf', 'Will'])), not(atom(friend, ['Will', 'Alf'])), atom(attestation, ['Alf', 'Proof']), atom(attestation, ['Will', 'Seal']), atom(person, ['Alice'])], true, ['Alf', 'Will', 'Alice']),
 sas(retire, ['Alf', 'Decider', 'Codecider'], [], [atom(retired, ['Alf']), forall(['E1'], atom(has_guardian, ['Alf', 'E1']), true, [not(atom(guardian, ['E1', 'Alf']))]), not(atom(has_guardian, ['Alf', '_'])), not(atom(friend, ['Alf', '_'])), forall(['E2'], atom(friend, ['Alf', 'E2']), true, [not(atom(friend, ['E2', 'Alf']))])], [atom(identity, ['Alf']), atom(identity, ['Decider']), not(atom(retired, ['Alf'])), atom(has_guardian, ['Alf', 'Decider']), atom(person, ['Decider']), atom(guardian, ['Decider', 'Alf']), forall(['Codecider'], atom(has_guardian, ['Alf', 'Codecider']), true, and(atom(identity, ['Codecider']), and(atom(person, ['Codecider']), atom(guardian, ['Codecider', 'Alf'])))), forall(['E1'], atom(has_guardian, ['Alf', 'E1']), true, [atom(identity, ['E1']), atom(guardian, ['E1', 'Alf'])]), forall(['E2'], atom(friend, ['Alf', 'E2']), true, [atom(identity, ['E2']), atom(friend, ['E2', 'Alf'])])], true, ['Decider', 'Codecider']),
 sas(sign, ['Alice'], ['Item'], [atom(item, ['Alice', 'Item'])], [atom(identity, ['Alice']), not(atom(item, ['Alice', 'Item'])), atom(person, ['Alice'])], true, ['Alice']),
 sas(forward, ['Bob', 'Alice'], ['Item'], [atom(item, ['Bob', sgn('Item', 'Alice')])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(item, ['Alice', 'Item']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(person, ['Alice'])], true, ['Alice']),
 sas(agent_sign, ['Alf', 'Alice'], ['Item', 'Proof', 'Alice'], [atom(item, ['Alf', 'Item'])], [atom(identity, ['Alf']), atom(ai_agent, ['Alf']), atom(attestation, ['Alf', 'Proof']), atom(has_guardian, ['Alf', 'Alice']), not(atom(item, ['Alf', 'Item']))], true, ['Alf']),
 sas(agent_forward, ['Bob', 'Alf', 'Alice'], ['Item', 'Proof', 'Alice'], [atom(item, ['Bob', sgn('Item', 'Alf')])], [atom(identity, ['Bob']), atom(identity, ['Alf']), atom(ai_agent, ['Alf']), atom(attestation, ['Alf', 'Proof']), atom(has_guardian, ['Alf', 'Alice']), atom(item, ['Alf', 'Item']), atom(friend, ['Alf', 'Bob']), atom(friend, ['Bob', 'Alf'])], true, ['Alf'])])).
