%% test_suspend_fail.glp - Minimal test case for suspend vs fail behavior
%% Testing: Does a goal with unbound reader args suspend or fail?

%% Simple procedure with list patterns - WORKS
process([H|T], [H?|Out?]) :- process(T?, Out).
process([], []).

%% With ground guard on destructured element
guarded([H|T], [H?|Out?]) :-
    ground(H?) |
    guarded(T?, Out).
guarded([], []).

%% Simpler: single arg with ground guard - WORKS
check([H|T]) :-
    ground(H?) |
    check(T?).
check([]).

%% Mimic social_graph pattern: two args - SUSPENDS
social([cmd(To, Content)|In], [msg(To?, Content?)|Out?]) :-
    ground(To?), ground(Content?) |
    social(In?, Out).
social([], []).

%% Three args like social_graph - SUSPENDS
triple(Id, [cmd(To, Content)|In], [msg(Id?, To?, Content?)|Out?]) :-
    ground(Id?), ground(To?), ground(Content?) |
    triple(Id?, In?, Out).
triple(_, [], []).

%% With otherwise clause - TEST THIS
withother(Id, [cmd(To)|In], [ok(Id?, To?)|Out?]) :-
    ground(Id?), ground(To?) |
    withother(Id?, In?, Out).
withother(Id, [X|In], [err(X?)|Out?]) :-
    ground(Id?), ground(X?), otherwise |
    withother(Id?, In?, Out).
withother(_, [], []).
