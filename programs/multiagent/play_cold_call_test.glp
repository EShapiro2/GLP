%% play_cold_call_test.glp - Test cold-call protocol with 2 agents
%%
%% Alice cold-calls Bob through the network, Bob accepts.
%% Based on social_agent.glp patterns with SRSW-compliant cold-call.
%%
%% Run: play_cold_call.

%% ========== Type Definitions ==========

NetMsg ::= msg(_, _, _).
MsgStream ::= [] ; [_ | MsgStream].

%% Channel: first slot is input (read), second slot is output (write)
Channel ::= ch(MsgStream?, MsgStream).

%% FriendEntry: second slot MsgStream? flips to output mode when consumed
%% This allows storing writer streams in the friends list
FriendEntry ::= (_, MsgStream?).
FriendList ::= [] ; [FriendEntry | FriendList].

Status ::= found ; not_found.

%% BefriendResp: Channel? so when BefriendResp? is consumed, 
%% the channel inside has the right orientation (writer at position 2)
BefriendResp ::= accept(Channel?) ; no.

%% ========== Procedure Declarations ==========

procedure play_cold_call().
procedure network2(_?, _?).
procedure agent(_?, Channel?, Channel?).
procedure social_graph(_?, MsgStream?, FriendList?).
procedure lookup_send(_?, _?, FriendList?, FriendList, Status).
procedure inject_msg(_?, _?, _?, MsgStream?, MsgStream).
procedure bind_response(_?, _?, BefriendResp, FriendList?, FriendList, MsgStream?, MsgStream).
procedure handle_response(BefriendResp?, _?, FriendList?, FriendList, MsgStream?, MsgStream).
procedure add_friend(_?, MsgStream, FriendList?, FriendList).
procedure tag_stream(_?, MsgStream?, MsgStream).
procedure merge(MsgStream?, MsgStream?, MsgStream).
procedure alice_actor(MsgStream?, MsgStream).
procedure bob_actor(MsgStream?, MsgStream).

%% ========== The Play ==========

play_cold_call :-
    %% Network switch: network reads agent output, writes agent input
    network2((alice, ch(AliceNetOut, AliceNetIn?)),
             (bob, ch(BobNetOut, BobNetIn?))),

    %% Agents consume channels
    agent(alice, ch(AliceUserIn, AliceUserOut?), ch(AliceNetIn, AliceNetOut?)),
    agent(bob, ch(BobUserIn, BobUserOut?), ch(BobNetIn, BobNetOut?)),

    %% Actors: read agent output, write agent input
    alice_actor(AliceUserOut?, AliceUserIn),
    bob_actor(BobUserOut?, BobUserIn).

%% ========== Agent ==========

agent(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    social_graph(Id?, In?, [(user, UserOut), (net, NetOut)]).

%% ========== Social Graph (Cold-Call Protocol) ==========

%% User requests connection
social_graph(Id, [msg(user, Id?, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?) |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1, _),
    inject_msg(Resp?, Target?, Id?, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Receive self-introduction (cold-call)
social_graph(Id, [msg(From, Id?, intro(From?, From?, Resp))|In], Fs) :-
    ground(Id?), ground(From?) |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% User decision on befriend request
social_graph(Id, [msg(user, Id?, decision(Dec, From, Resp))|In], Fs) :-
    ground(Id?) |
    bind_response(Dec?, From?, Resp, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Response to our introduction
social_graph(Id, [msg(From, Id?, response(Resp))|In], Fs) :-
    ground(Id?) |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Skip unrecognized messages
social_graph(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    social_graph(Id?, In?, Fs?).

%% Termination
social_graph(_, [], _).

%% ========== Inject Response Message ==========

inject_msg(Resp, Target, Id, Ys, [msg(Target?, Id?, response(Resp?))|Ys?]) :-
    known(Resp?) | true.
inject_msg(Resp, Target, Id, [Y|Ys], [Y?|Ys1?]) :-
    otherwise | 
    inject_msg(Resp?, Target?, Id?, Ys?, Ys1).

%% ========== Channel Creation ==========

%% new_channel creates complementary channel pair (defined guard, will be unfolded)
new_channel(ch(Xs?, Ys), ch(Ys?, Xs)).

%% ========== Response Handling ==========

%% bind_response: user accepts, create channel pair
%% - FCh (produced as BefriendResp output) goes to sender
%% - We keep ch(FIn, FOut): FIn for reading, FOut for writing to new friend
%% - With Channel? inside BefriendResp?, handle_response receives ch(FIn?, FOut)
%%   where FIn? is reader (we read via it) and FOut is writer (we store it)
bind_response(yes, From, accept(FCh), Fs, Fs1?, In, In1?) :-
    constant(From?), new_channel(ch(FIn, FOut), FCh?) |
    handle_response(accept(ch(FIn?, FOut)), From?, Fs?, Fs1, In?, In1).
bind_response(no, _, no, Fs, Fs?, In, In?).

%% handle_response: process accepted channel
%% With BefriendResp? consumed and Channel? inside:
%% - Position 1 expects reader (FIn?) - we read from new friend
%% - Position 2 expects writer (FOut) - we store to write to new friend
handle_response(accept(ch(FIn?, FOut)), From, Fs, [(From?, FOut?)|Fs?], In, In1?) :-
    constant(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1).
handle_response(no, _, Fs, Fs?, In, In?).

%% ========== Friend Management ==========

add_friend(Name, Out, Fs, [(Name?, Out?)|Fs?]).

tag_stream(_, [], []).
tag_stream(From, [Content|Rest], [msg(From?, _, Content?)|Tagged?]) :-
    ground(From?) |
    tag_stream(From?, Rest?, Tagged).

%% ========== Lookup Send ==========

%% Restructured to avoid body unification — output construction in head
lookup_send(_, _, [], [], not_found).

lookup_send(Key, Msg, [(K, [Msg?|Out1])|Rest], [(K?, Out1?)|Rest?], found) :-
    Key? =?= K? | true.

lookup_send(Key, Msg, [Pair|Rest], [Pair?|Rest1?], Status?) :-
    otherwise |
    lookup_send(Key?, Msg?, Rest?, Rest1, Status).

%% ========== Merge ==========

merge([H|T1], T2, [H?|T3?]) :- merge(T1?, T2?, T3).
merge(T1, [H|T2], [H?|T3?]) :- merge(T1?, T2?, T3).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

%% ========== Network Switch (2-way) ==========

%% Alice sends to Bob
network2((alice, ch([msg(alice, bob, X)|AliceOut], AliceIn?)),
         (bob, ch(BobOut, [msg(alice, bob, X?)|BobIn?]))) :-
    network2((alice, ch(AliceOut?, AliceIn)),
             (bob, ch(BobOut?, BobIn))).

%% Bob sends to Alice
network2((alice, ch(AliceOut, [msg(bob, alice, X?)|AliceIn?])),
         (bob, ch([msg(bob, alice, X)|BobOut], BobIn?))) :-
    network2((alice, ch(AliceOut?, AliceIn)),
             (bob, ch(BobOut?, BobIn))).

%% Termination
network2((_, ch([], _)), (_, ch([], _))).

%% ========== Actors ==========

%% Alice: send connect command to agent
alice_actor(_, [msg(user, alice, connect(bob))|_]).

%% Bob: wait for befriend request, send acceptance decision
bob_actor([msg(agent, user, befriend(From, Resp))|_],
          [msg(user, bob, decision(yes, From?, Resp?))|_]).

%% Bob: handle empty input (suspend)
bob_actor([], _).
