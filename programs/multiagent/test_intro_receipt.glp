%% Test intro receipt - with actual lookup_send from social_agent.glp
%% Verifies msg(bob, alice, intro(charlie, Ch)) matches and produces intro_offer

%% Actual lookup_send from social_agent.glp (no ground(Msg?) guard!)
lookup_send(_, _, [], [], not_found).

lookup_send(Key, Msg, [(K, Out)|Rest], [(K?, Out1?)|Rest?], found) :-
    Key? =?= K? |
    Out? = [Msg?|Out1].

lookup_send(Key, Msg, [Pair|Rest], [Pair?|Rest1?], Status?) :-
    otherwise |
    lookup_send(Key?, Msg?, Rest?, Rest1, Status).

%% The clause under test (exact copy from social_agent.glp)
social_graph(Id, [msg(From, Id?, intro(Other, Ch))|In], Fs) :-
    ground(Id?), ground(From?), ground(Other?) |
    lookup_send(user, intro_offer(From?, Other?, Ch?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

social_graph(_, [], _).

%% Test 1: ground channel
test1(UserOut?) :-
    social_graph(alice, [msg(bob, alice, intro(charlie, ch(stream_in, stream_out)))], [(user, UserOut)]).

%% Test 2: channel with unbound variables (like real intro scenario)
test2(UserOut?, AliceIn, AliceOut?) :-
    social_graph(alice, [msg(bob, alice, intro(charlie, ch(AliceIn?, AliceOut)))], [(user, UserOut)]).
