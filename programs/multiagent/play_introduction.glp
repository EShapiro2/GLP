%% play_introduction.glp - Three-agent friend-mediated introduction test
%%
%% Pure GLP simulation of the friend-mediated introduction protocol.
%% Based on GLP-ICLP-2026 paper examples.
%%
%% Topology:
%%   Alice <-> Bob <-> Charlie
%%   (Alice and Charlie do NOT initially know each other)
%%
%% Protocol:
%%   1. Bob types: introduce(alice, charlie)
%%   2. Alice receives: intro_offer(bob, charlie, Ch)
%%   3. Charlie receives: intro_offer(bob, alice, Ch)
%%   4. Alice types: accept_intro(charlie, Ch)
%%   5. Charlie types: accept_intro(alice, Ch)
%%   6. Alice and Charlie can now communicate directly
%%
%% Run: play(AliceOut, BobOut, CharlieOut, AliceIn, BobIn, CharlieIn)

%% ========== Type Definitions ==========

%% Using simple wildcard types to avoid type checker issues
MsgStream ::= [] ; [_ | MsgStream].
Channel ::= ch(MsgStream?, MsgStream).
FriendEntry ::= (_, _).
FriendList ::= [] ; [FriendEntry | FriendList].
Status ::= found ; not_found.

%% ========== Procedure Declarations ==========

procedure play(MsgStream, MsgStream, MsgStream, MsgStream?, MsgStream?, MsgStream?).
procedure agent(_?, FriendList?, Channel?, Channel?).
procedure social_graph(_?, MsgStream?, FriendList?).
procedure build_friends(FriendList?, MsgStream, MsgStream, FriendList).
procedure lookup_send(_?, _?, FriendList?, FriendList, Status).
procedure handle_send_status(Status?, _?, _?, FriendList?, FriendList).
procedure handle_intro_status(Status?, Status?, _?, _?, FriendList?, FriendList).
procedure handle_ping_status(Status?, _?, _?, FriendList?, FriendList).
procedure add_friend(_?, _?, FriendList?, FriendList).
procedure tag_stream(_?, MsgStream?, MsgStream).
procedure append(FriendList?, FriendList?, FriendList).
procedure merge(MsgStream?, MsgStream?, MsgStream).
procedure network(_?, _?, _?).

%% ========== Play Setup ==========

%% play(AliceOut, BobOut, CharlieOut, AliceIn, BobIn, CharlieIn)
%% AliceOut, BobOut, CharlieOut: Streams showing what each user sees
%% AliceIn, BobIn, CharlieIn: Streams for user input to each agent
play(AliceOut, BobOut, CharlieOut, AliceIn, BobIn, CharlieIn) :-
    %% Create channels between agents and their users
    %% Alice
    agent(alice, [(bob, AliceToBobOut?)], 
          ch(AliceIn?, AliceOut), ch(AliceNetIn, AliceNetOut?)),
    
    %% Bob (knows both Alice and Charlie)
    agent(bob, [(alice, BobToAliceOut?), (charlie, BobToCharlieOut?)], 
          ch(BobIn?, BobOut), ch(BobNetIn, BobNetOut?)),
    
    %% Charlie
    agent(charlie, [(bob, CharlieToBobOut?)], 
          ch(CharlieIn?, CharlieOut), ch(CharlieNetIn, CharlieNetOut?)),
    
    %% 3-way network switch routes messages between agents
    %% Each agent has a network channel; the switch forwards messages
    network((alice, ch(AliceNetIn?, AliceNetOut)),
            (bob, ch(BobNetIn?, BobNetOut)),
            (charlie, ch(CharlieNetIn?, CharlieNetOut))).

%% ========== Agent Definition ==========

agent(Id, FriendPairs, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    build_friends(FriendPairs?, UserOut, NetOut, Fs),
    social_graph(Id?, In?, Fs?).

build_friends(FriendPairs, UserOut, NetOut, Fs?) :-
    append([(user, UserOut?), (net, NetOut?)], FriendPairs?, Fs).

%% ========== Social Graph Main Loop ==========

%% User sends message to a friend
social_graph(Id, [send(To, Content)|In], Fs) :-
    ground(Id?), ground(To?), ground(Content?) |
    lookup_send(To?, msg(Id?, To?, Content?), Fs?, Fs1, Status),
    handle_send_status(Status?, To?, Content?, Fs1?, Fs2),
    social_graph(Id?, In?, Fs2?).

%% ========== Friend-Mediated Introduction Protocol ==========

%% User requests introduction: introduce(P, Q)
social_graph(Id, [introduce(P, Q)|In], Fs) :-
    ground(Id?), ground(P?), ground(Q?) |
    %% Create fresh channel pair: PtoQ and QtoP are the two halves
    %% P gets ch(QtoP?, PtoQ) - reads from Q, writes to Q
    %% Q gets ch(PtoQ?, QtoP) - reads from P, writes to P
    lookup_send(P?, msg(Id?, P?, intro(Q?, ch(QtoP?, PtoQ))), Fs?, Fs1, Status1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, ch(PtoQ?, QtoP))), Fs1?, Fs2, Status2),
    handle_intro_status(Status1?, Status2?, P?, Q?, Fs2?, Fs3),
    social_graph(Id?, In?, Fs3?).

%% Handle introduction status
handle_intro_status(found, found, P, Q, Fs, Fs1?) :-
    lookup_send(user, introduced(P?, Q?), Fs?, Fs1, _).

handle_intro_status(not_found, _, P, _, Fs, Fs1?) :-
    lookup_send(user, error(intro_failed, P?), Fs?, Fs1, _).

handle_intro_status(_, not_found, _, Q, Fs, Fs1?) :-
    lookup_send(user, error(intro_failed, Q?), Fs?, Fs1, _).

%% Receive introduction from a friend
social_graph(Id, [msg(From, Id?, intro(Other, Ch))|In], Fs) :-
    ground(Id?), ground(From?), ground(Other?) |
    lookup_send(user, intro_offer(From?, Other?, Ch?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% User accepts introduction
social_graph(Id, [accept_intro(Other, ch(FIn, FOut))|In], Fs) :-
    ground(Id?), ground(Other?) |
    tag_stream(Other?, FIn?, Tagged),
    merge(In?, Tagged?, In1),
    add_friend(Other?, FOut?, Fs?, Fs1),
    lookup_send(user, accepted_intro(Other?), Fs1?, Fs2, _),
    social_graph(Id?, In1?, Fs2?).

%% User rejects introduction
social_graph(Id, [reject_intro(Other, _)|In], Fs) :-
    ground(Id?), ground(Other?) |
    lookup_send(user, rejected_intro(Other?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% ========== Ping/Pong Protocol ==========

social_graph(Id, [msg(From, Id?, ping)|In], Fs) :-
    ground(Id?), ground(From?) |
    lookup_send(user, received_ping(From?), Fs?, Fs1, _),
    lookup_send(From?, msg(Id?, From?, pong), Fs1?, Fs2, Status),
    handle_ping_status(Status?, Id?, From?, Fs2?, Fs3),
    social_graph(Id?, In?, Fs3?).

social_graph(Id, [msg(From, Id?, pong)|In], Fs) :-
    ground(Id?), ground(From?) |
    lookup_send(user, received_pong(From?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% Receive other message
social_graph(Id, [msg(From, Id?, Content)|In], Fs) :-
    ground(Id?), ground(From?), ground(Content?) |
    lookup_send(user, received(From?, Content?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% Unknown command
social_graph(Id, [Cmd|In], Fs) :-
    ground(Id?), ground(Cmd?), otherwise |
    lookup_send(user, error(unknown_command, Cmd?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% Empty input
social_graph(_, [], _).

%% ========== Status Handlers ==========

handle_send_status(found, To, Content, Fs, Fs1?) :-
    lookup_send(user, sent(To?, Content?), Fs?, Fs1, _).

handle_send_status(not_found, To, _, Fs, Fs1?) :-
    lookup_send(user, error(unknown_recipient, To?), Fs?, Fs1, _).

handle_ping_status(found, _, _, Fs, Fs?).

handle_ping_status(not_found, _, From, Fs, Fs1?) :-
    lookup_send(user, error(ping_reply_failed, From?), Fs?, Fs1, _).

%% ========== Friend Management ==========

add_friend(Name, Out, Fs, [(Name?, Out?)|Fs?]).

tag_stream(_, [], []).
tag_stream(From, [Content|Rest], [msg(From?, _, Content?)|Tagged?]) :-
    ground(From?) |
    tag_stream(From?, Rest?, Tagged).

%% ========== Lookup Send ==========

lookup_send(_, _, [], [], not_found).

lookup_send(Key, Msg, [(K, Out)|Rest], [(K?, Out1?)|Rest?], found) :-
    Key? =?= K? |
    Out? = [Msg?|Out1].

lookup_send(Key, Msg, [Pair|Rest], [Pair?|Rest1?], Status?) :-
    otherwise |
    lookup_send(Key?, Msg?, Rest?, Rest1, Status).

%% ========== 3-Way Network Switch ==========
%% From GLP-ICLP-2026 Appendix - routes messages between three agents

%% Alice to Bob
network((alice, ChA), (bob, ChB), (charlie, ChC)) :-
    ChA? = ch([msg(bob, X)|InA], OutA),
    ChB? = ch(InB, [X?|OutB]) |
    network((alice, ch(InA?, OutA?)), (bob, ch(InB?, OutB)), (charlie, ChC?)).

%% Alice to Charlie
network((alice, ChA), (bob, ChB), (charlie, ChC)) :-
    ChA? = ch([msg(charlie, X)|InA], OutA),
    ChC? = ch(InC, [X?|OutC]) |
    network((alice, ch(InA?, OutA?)), (bob, ChB?), (charlie, ch(InC?, OutC))).

%% Bob to Alice
network((alice, ChA), (bob, ChB), (charlie, ChC)) :-
    ChB? = ch([msg(alice, X)|InB], OutB),
    ChA? = ch(InA, [X?|OutA]) |
    network((alice, ch(InA?, OutA)), (bob, ch(InB?, OutB?)), (charlie, ChC?)).

%% Bob to Charlie
network((alice, ChA), (bob, ChB), (charlie, ChC)) :-
    ChB? = ch([msg(charlie, X)|InB], OutB),
    ChC? = ch(InC, [X?|OutC]) |
    network((alice, ChA?), (bob, ch(InB?, OutB?)), (charlie, ch(InC?, OutC))).

%% Charlie to Alice
network((alice, ChA), (bob, ChB), (charlie, ChC)) :-
    ChC? = ch([msg(alice, X)|InC], OutC),
    ChA? = ch(InA, [X?|OutA]) |
    network((alice, ch(InA?, OutA)), (bob, ChB?), (charlie, ch(InC?, OutC?))).

%% Charlie to Bob
network((alice, ChA), (bob, ChB), (charlie, ChC)) :-
    ChC? = ch([msg(bob, X)|InC], OutC),
    ChB? = ch(InB, [X?|OutB]) |
    network((alice, ChA?), (bob, ch(InB?, OutB)), (charlie, ch(InC?, OutC?))).

%% Termination - all channels empty
network((_, ch([], _)), (_, ch([], _)), (_, ch([], _))).

%% ========== Utilities ==========

merge([H|T1], T2, [H?|T3?]) :- merge(T1?, T2?, T3).
merge(T1, [H|T2], [H?|T3?]) :- merge(T1?, T2?, T3).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).

append([], Ys, Ys?).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).

%% ========== Test Scenario ==========
%%
%% To run the friend-mediated introduction:
%%
%% 1. Start simulation:
%%    play(AliceOut, BobOut, CharlieOut, AliceIn, BobIn, CharlieIn)
%%
%% 2. Bob introduces Alice to Charlie:
%%    BobIn = [introduce(alice, charlie) | BobIn1]
%%
%% 3. Observe:
%%    AliceOut should show: intro_offer(bob, charlie, ch(CharlieToAlice?, AliceToCharlie))
%%    CharlieOut should show: intro_offer(bob, alice, ch(AliceToCharlie?, CharlieToAlice))
%%    BobOut should show: introduced(alice, charlie)
%%
%% 4. Alice accepts (using the channel from intro_offer):
%%    AliceIn1 = [accept_intro(charlie, Ch) | AliceIn2]
%%    (where Ch is the channel received in intro_offer)
%%
%% 5. Charlie accepts:
%%    CharlieIn1 = [accept_intro(alice, Ch) | CharlieIn2]
%%
%% 6. Now Alice can send directly to Charlie:
%%    AliceIn2 = [send(charlie, hello) | AliceIn3]
%%
%% 7. Observe:
%%    CharlieOut should show: received(alice, hello)
