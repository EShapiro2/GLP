%% Diagnostic: print parsed arguments for the problematic clause structure

procedure test(_?, _?, _?).
procedure lookup_send(_?, _?, _?, _, _).

test(Id, [introduce(P, Q)|In], Fs) :-
    ground(Id?), ground(P?), ground(Q?) |
    lookup_send(P?, msg(Id?, P?, intro(Q?, ch(QtoP?, PtoQ))), Fs?, Fs1, Status1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, ch(PtoQ?, QtoP))), Fs1?, Fs2, Status2),
    test(Id?, In?, Status1?),
    test(Id?, In?, Status2?).
