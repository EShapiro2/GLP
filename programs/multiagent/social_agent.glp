%% social_agent.glp - Social graph agent with friends list
%% Based on GLP-2025 paper architecture
%% For use with glp_multiagent Flutter app
%% 
%% Supports multiple pre-configured friends via FriendPairs list.
%% Supports friend-mediated introduction protocol.
%% Pending intros are stored internally so user just types accept_intro(name).

%% ========== Type Definitions ==========

%% Network messages between agents
NetMsg ::= msg(_, _, _).

%% User commands (input from user)
%% Note: accept_intro and reject_intro now take just the name, not the channel
UserCmd ::= send(_, _) ; introduce(_, _) ; accept_intro(_) ; reject_intro(_).

%% User feedback messages (output to user)
UserFeedback ::= sent(_, _) ; received(_, _) ; received_ping(_) ; received_pong(_) 
              ; intro_offer(_, _) ; introduced(_, _) ; accepted_intro(_) ; rejected_intro(_)
              ; error(_, _).

%% All message types in streams
Msg ::= NetMsg ; UserCmd ; UserFeedback.

%% Message streams
MsgStream ::= [] ; [Msg | MsgStream].

%% Channel pair: reader for input, writer for output
Channel ::= ch(MsgStream?, MsgStream).

%% Friend list entry: (name, output stream)
FriendEntry ::= (_, MsgStream).
FriendList ::= [] ; [FriendEntry | FriendList].

%% Friend pairs for initialization (name, output stream)
FriendPairs ::= [] ; [FriendEntry | FriendPairs].

%% Pending intro entry: pending(Other, From, Channel)
PendingIntro ::= pending(_, _, Channel).
PendingIntros ::= [] ; [PendingIntro | PendingIntros].

%% Lookup status
Status ::= found ; not_found.

%% ========== Procedure Declarations ==========

procedure agent(_?, FriendPairs?, Channel?, Channel?).
procedure build_friends(FriendPairs?, MsgStream, MsgStream, FriendList).
procedure social_graph(_?, MsgStream?, FriendList?, PendingIntros?).
procedure lookup_send(_?, Msg?, FriendList?, FriendList, Status).
procedure handle_send_status(Status?, _?, _?, FriendList?, PendingIntros?, FriendList, PendingIntros).
procedure handle_intro_status(Status?, Status?, _?, _?, FriendList?, PendingIntros?, FriendList, PendingIntros).
procedure handle_ping_status(Status?, _?, _?, FriendList?, PendingIntros?, FriendList, PendingIntros).
procedure handle_accept_intro(Status?, _?, _?, Channel?, MsgStream?, FriendList?, PendingIntros?).
procedure handle_reject_intro(Status?, _?, _?, MsgStream?, FriendList?, PendingIntros?).
procedure add_friend(_?, MsgStream?, FriendList?, FriendList).
procedure tag_stream(_?, MsgStream?, MsgStream).
procedure lookup_pending(_?, PendingIntros?, Channel, PendingIntros, Status).
procedure append(FriendList?, FriendList?, FriendList).
procedure merge(MsgStream?, MsgStream?, MsgStream).

%% ========== Agent Initialization ==========

%% agent(Id, FriendPairs, UserCh, NetCh)
%% FriendPairs is a list of (Name, OutStream) pairs for pre-configured friends
agent(Id, FriendPairs, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    build_friends(FriendPairs?, UserOut, NetOut, Fs),
    social_graph(Id?, In?, Fs?, []).

%% Build friends list from pairs, adding user and net channels
build_friends(FriendPairs, UserOut, NetOut, Fs?) :-
    append([(user, UserOut?), (net, NetOut?)], FriendPairs?, Fs).

%% ========== Social Graph Main Loop (ALL CLAUSES CONTIGUOUS) ==========

%% User sends message to a friend
social_graph(Id, [send(To, Content)|In], Fs, Pending) :-
    ground(Id?), ground(To?), ground(Content?) |
    lookup_send(To?, msg(Id?, To?, Content?), Fs?, Fs1, Status),
    handle_send_status(Status?, To?, Content?, Fs1?, Pending?, Fs2, Pending1),
    social_graph(Id?, In?, Fs2?, Pending1?).

%% User requests introduction: introduce(P, Q)
social_graph(Id, [introduce(P, Q)|In], Fs, Pending) :-
    ground(Id?), ground(P?), ground(Q?) |
    lookup_send(P?, msg(Id?, P?, intro(Q?, ch(QtoP?, PtoQ))), Fs?, Fs1, Status1),
    lookup_send(Q?, msg(Id?, Q?, intro(P?, ch(PtoQ?, QtoP))), Fs1?, Fs2, Status2),
    handle_intro_status(Status1?, Status2?, P?, Q?, Fs2?, Pending?, Fs3, Pending1),
    social_graph(Id?, In?, Fs3?, Pending1?).

%% Receive introduction from a friend - store in pending intros
social_graph(Id, [msg(From, Id?, intro(Other, Ch))|In], Fs, Pending) :-
    ground(Id?), ground(From?), ground(Other?) |
    lookup_send(user, intro_offer(From?, Other?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?, [pending(Other?, From?, Ch?)|Pending?]).

%% User accepts introduction - lookup channel from pending
social_graph(Id, [accept_intro(Other)|In], Fs, Pending) :-
    ground(Id?), ground(Other?) |
    lookup_pending(Other?, Pending?, Ch, Pending1, Status),
    handle_accept_intro(Status?, Id?, Other?, Ch?, In?, Fs?, Pending1?).

%% User rejects introduction - lookup and remove from pending
social_graph(Id, [reject_intro(Other)|In], Fs, Pending) :-
    ground(Id?), ground(Other?) |
    lookup_pending(Other?, Pending?, _, Pending1, Status),
    handle_reject_intro(Status?, Id?, Other?, In?, Fs?, Pending1?).

%% Receive ping - reply with pong
social_graph(Id, [msg(From, Id?, ping)|In], Fs, Pending) :-
    ground(Id?), ground(From?) |
    lookup_send(user, received_ping(From?), Fs?, Fs1, _),
    lookup_send(From?, msg(Id?, From?, pong), Fs1?, Fs2, Status),
    handle_ping_status(Status?, Id?, From?, Fs2?, Pending?, Fs3, Pending1),
    social_graph(Id?, In?, Fs3?, Pending1?).

%% Receive pong - display only
social_graph(Id, [msg(From, Id?, pong)|In], Fs, Pending) :-
    ground(Id?), ground(From?) |
    lookup_send(user, received_pong(From?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?, Pending?).

%% Receive other message - display only
social_graph(Id, [msg(From, Id?, Content)|In], Fs, Pending) :-
    ground(Id?), ground(From?), ground(Content?) |
    lookup_send(user, received(From?, Content?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?, Pending?).

%% Unknown command - report error
social_graph(Id, [Cmd|In], Fs, Pending) :-
    ground(Id?), ground(Cmd?), otherwise |
    lookup_send(user, error(unknown_command, Cmd?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?, Pending?).

%% Empty input - done
social_graph(_, [], _, _).

%% ========== Accept/Reject Intro Handlers ==========

%% Found pending intro - add friend and merge streams
handle_accept_intro(found, Id, Other, ch(FIn, FOut), In, Fs, Pending) :-
    ground(Other?) |
    tag_stream(Other?, FIn?, Tagged),
    merge(In?, Tagged?, In1),
    add_friend(Other?, FOut?, Fs?, Fs1),
    lookup_send(user, accepted_intro(Other?), Fs1?, Fs2, _),
    social_graph(Id?, In1?, Fs2?, Pending?).

%% Not found - error
handle_accept_intro(not_found, Id, Other, _, In, Fs, Pending) :-
    lookup_send(user, error(no_pending_intro, Other?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?, Pending?).

%% Found pending intro - just report rejection
handle_reject_intro(found, Id, Other, In, Fs, Pending) :-
    lookup_send(user, rejected_intro(Other?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?, Pending?).

%% Not found - error
handle_reject_intro(not_found, Id, Other, In, Fs, Pending) :-
    lookup_send(user, error(no_pending_intro, Other?), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?, Pending?).

%% ========== Status Handlers ==========

handle_send_status(found, To, Content, Fs, Pending, Fs1?, Pending?) :-
    lookup_send(user, sent(To?, Content?), Fs?, Fs1, _).

handle_send_status(not_found, To, _, Fs, Pending, Fs1?, Pending?) :-
    lookup_send(user, error(unknown_recipient, To?), Fs?, Fs1, _).

handle_intro_status(found, found, P, Q, Fs, Pending, Fs1?, Pending?) :-
    lookup_send(user, introduced(P?, Q?), Fs?, Fs1, _).

handle_intro_status(not_found, _, P, _, Fs, Pending, Fs1?, Pending?) :-
    lookup_send(user, error(intro_failed, P?), Fs?, Fs1, _).

handle_intro_status(_, not_found, _, Q, Fs, Pending, Fs1?, Pending?) :-
    lookup_send(user, error(intro_failed, Q?), Fs?, Fs1, _).

handle_ping_status(found, _, _, Fs, Pending, Fs?, Pending?).

handle_ping_status(not_found, _, From, Fs, Pending, Fs1?, Pending?) :-
    lookup_send(user, error(ping_reply_failed, From?), Fs?, Fs1, _).

%% ========== Friend Management ==========

add_friend(Name, Out, Fs, [(Name?, Out?)|Fs?]).

tag_stream(_, [], []).
tag_stream(From, [Content|Rest], [msg(From?, _, Content?)|Tagged?]) :-
    ground(From?) |
    tag_stream(From?, Rest?, Tagged).

%% ========== Lookup Pending Intro ==========

%% Not found
lookup_pending(_, [], _, [], not_found).

%% Found - return channel and remove from list
lookup_pending(Other, [pending(O, _, Ch)|Rest], Ch?, Rest?, found) :-
    Other? =?= O? | true.

%% Keep searching
lookup_pending(Other, [Entry|Rest], Ch?, [Entry?|Rest1?], Status?) :-
    otherwise |
    lookup_pending(Other?, Rest?, Ch, Rest1, Status).

%% ========== Lookup Send ==========

lookup_send(_, _, [], [], not_found).

lookup_send(Key, Msg, [(K, Out)|Rest], [(K?, Out1?)|Rest?], found) :-
    Key? =?= K? |
    Out? = [Msg?|Out1].

lookup_send(Key, Msg, [Pair|Rest], [Pair?|Rest1?], Status?) :-
    otherwise |
    lookup_send(Key?, Msg?, Rest?, Rest1, Status).

%% ========== Append ==========

append([], Ys, Ys?).
append([X|Xs], Ys, [X?|Zs?]) :- append(Xs?, Ys?, Zs).

%% ========== Merge ==========

merge([H|T1], T2, [H?|T3?]) :- merge(T1?, T2?, T3).
merge(T1, [H|T2], [H?|T3?]) :- merge(T1?, T2?, T3).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).
