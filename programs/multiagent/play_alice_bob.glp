%% play_alice_bob.glp - Two-agent befriending play with proper types
%% Based on Art-of-GLP-2025 Chapter 8

%% ========== Type Declarations ==========

%% Messages between agents
NetMsg ::= msg(_, _, _).

%% Channel: input stream (read) and output stream (write)
Channel ::= ch(NetMsg?, NetMsg).

%% Agent pair for network switch
AgentChannel ::= (_, Channel).

%% User commands
UserCmd ::= connect(_) | decision(_, _, _).

%% Agent responses to user
UserResp ::= befriend(_, _) | connected(_).

%% Befriend response
BefriendResp ::= accept(Channel) | no.

%% Friends list entry
FriendEntry ::= (_, NetMsg).
FriendList ::= list(FriendEntry).

%% ========== Procedure Declarations ==========

%% Network switch routes messages between two agents
procedure network2(AgentChannel?, AgentChannel?).

%% Main play entry point
procedure play_alice_bob.

%% Agent initialization - takes identity, user channel, network channel
procedure agent(_, Channel?, Channel?).

%% Social graph main loop
procedure social_graph(_, NetMsg?, FriendList?).

%% Actor for Alice - reads agent output, writes user commands
procedure alice_actor(UserResp?, UserCmd).

%% Wait for connection response
procedure alice_wait_response(UserResp?, UserCmd).

%% Actor for Bob - reads agent output, writes user commands  
procedure bob_actor(UserResp?, UserCmd).

%% Done waiting
procedure bob_done(UserResp?, UserCmd).

%% Response stream - produces message when response arrives
procedure response_stream(_?, _, _, NetMsg).

%% Bind response based on user decision
procedure bind_response(_, _, BefriendResp, FriendList?, FriendList, NetMsg?, NetMsg).

%% Handle accepted response
procedure handle_accept(_, Channel?, FriendList?, FriendList, NetMsg?, NetMsg).

%% Handle response to our introduction
procedure handle_response(BefriendResp?, _, FriendList?, FriendList, NetMsg?, NetMsg).

%% Add friend to list
procedure add_friend(_, NetMsg, FriendList?, FriendList).

%% Lookup and send message
procedure lookup_send(_, NetMsg?, FriendList?, FriendList, _).

%% Tag stream with sender identity
procedure tag_stream(_, NetMsg?, NetMsg).

%% Merge two streams
procedure merge(NetMsg?, NetMsg?, NetMsg).

%% ========== 2-Way Network Switch ==========

%% Alice sends to Bob
network2((alice, ch([msg(alice, bob, X)|AliceIn], AliceOut?)),
         (bob, ch(BobIn, [msg(alice, bob, X?)|BobOut?]))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% Bob sends to Alice
network2((alice, ch(AliceIn, [msg(bob, alice, X?)|AliceOut?])),
         (bob, ch([msg(bob, alice, X)|BobIn], BobOut?))) :-
    network2((alice, ch(AliceIn?, AliceOut)),
             (bob, ch(BobIn?, BobOut))).

%% Termination
network2((_, ch([], _)), (_, ch([], _))).

%% ========== Play ==========

play_alice_bob :-
    %% Network switch (holds inverse channels: ch(AgentOut?, AgentIn))
    network2((alice, ch(AliceNetOut?, AliceNetIn)),
             (bob, ch(BobNetOut?, BobNetIn))),

    %% Agents (receive channels: ch(In?, Out))
    agent(alice, ch(AliceUserIn?, AliceUserOut), ch(AliceNetIn?, AliceNetOut)),
    agent(bob, ch(BobUserIn?, BobUserOut), ch(BobNetIn?, BobNetOut)),

    %% Actors connect to user channels
    %% Actor writes to agent's user input, reads from agent's user output
    alice_actor(AliceUserOut?, AliceUserIn),
    bob_actor(BobUserOut?, BobUserIn).

%% ========== Agent ==========

agent(Id, ch(UserIn, UserOut?), ch(NetIn, NetOut?)) :-
    merge(UserIn?, NetIn?, In),
    social_graph(Id?, In?, [(user, UserOut), (net, NetOut)]).

%% ========== Actors ==========

%% Alice: send connect command, then wait for response
%% AgentOut?: what we read from agent
%% UserIn: what we write to agent
alice_actor(AgentOut?, [msg(user, alice, connect(bob))|UserIn?]) :-
    alice_wait_response(AgentOut?, UserIn).

%% Wait for connected message
alice_wait_response([msg(agent, user, connected(bob))|_], _).
alice_wait_response([_|AgentOut], UserIn?) :- 
    alice_wait_response(AgentOut?, UserIn).

%% Bob: wait for befriend request, send acceptance
bob_actor([msg(agent, user, befriend(alice, Resp))|AgentOut?],
          [msg(user, bob, decision(yes, alice, Resp?))|UserIn?]) :-
    bob_done(AgentOut?, UserIn).
bob_actor([_|AgentOut], UserIn?) :- 
    bob_actor(AgentOut?, UserIn).

bob_done(_, _).

%% ========== Social Graph ==========

%% User requests connection
social_graph(Id, [msg(user, Id?, connect(Target))|In], Fs) :-
    ground(Id?), ground(Target?) |
    lookup_send(net, msg(Id?, Target?, intro(Id?, Id?, Resp)), Fs?, Fs1, _),
    response_stream(Resp?, Target?, Id?, Rs),
    merge(In?, Rs?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Receive self-introduction from another agent
social_graph(Id, [msg(From, Id?, intro(From?, From?, Resp))|In], Fs) :-
    ground(Id?), ground(From?) |
    lookup_send(user, msg(agent, user, befriend(From?, Resp?)), Fs?, Fs1, _),
    social_graph(Id?, In?, Fs1?).

%% User decision on befriend request
social_graph(Id, [msg(user, Id?, decision(Dec, From, Resp))|In], Fs) :-
    ground(Id?) |
    bind_response(Dec?, From?, Resp?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Response to our introduction
social_graph(Id, [msg(From, Id?, response(Resp))|In], Fs) :-
    ground(Id?) |
    handle_response(Resp?, From?, Fs?, Fs1, In?, In1),
    social_graph(Id?, In1?, Fs1?).

%% Skip unrecognized messages
social_graph(Id, [_|In], Fs) :-
    ground(Id?), otherwise |
    social_graph(Id?, In?, Fs?).

%% Termination
social_graph(_, [], _).

%% ========== Response Handling ==========

%% Produce response message when Resp becomes bound
response_stream(Resp, Target, Id, [msg(Target?, Id?, response(Resp?))]) :-
    known(Resp?) | true.

%% User accepts: create channel, handle acceptance
bind_response(yes, From, accept(ch(FOut?, FIn)), Fs, Fs1?, In, In1?) :-
    constant(From?) |
    handle_accept(From?, ch(FIn?, FOut), Fs?, Fs1, In?, In1).

%% User rejects
bind_response(no, _, no, Fs, Fs?, In, In?).

%% Handle acceptance: add friend, merge tagged input
handle_accept(From, ch(FIn, FOut), Fs, Fs1?, In, In1?) :-
    constant(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1),
    add_friend(From?, FOut?, Fs?, Fs1).

%% Handle response to our introduction: acceptance
handle_response(accept(ch(FIn, FOut)), From, Fs, Fs2?, In, In1?) :-
    constant(From?) |
    tag_stream(From?, FIn?, Tagged),
    merge(In?, Tagged?, In1),
    add_friend(From?, FOut?, Fs?, Fs1),
    lookup_send(user, msg(agent, user, connected(From?)), Fs1?, Fs2, _).

%% Handle response: rejection
handle_response(no, _, Fs, Fs?, In, In?).

%% Add friend to list
add_friend(Name, Out, Fs, [(Name?, Out?)|Fs?]).

%% ========== Utilities ==========

%% Lookup key and send message
lookup_send(_, _, [], [], not_found).
lookup_send(Key, Msg, [(K, Out)|Rest], [(K?, Out1?)|Rest?], found) :-
    Key? =?= K? |
    Out? = [Msg?|Out1].
lookup_send(Key, Msg, [Pair|Rest], [Pair?|Rest1?], Status?) :-
    otherwise |
    lookup_send(Key?, Msg?, Rest?, Rest1, Status).

%% Tag each message with sender
tag_stream(_, [], []).
tag_stream(From, [Content|Rest], [msg(From?, _, Content?)|Tagged?]) :-
    ground(From?) |
    tag_stream(From?, Rest?, Tagged).

%% Merge two streams
merge([H|T1], T2, [H?|T3?]) :- merge(T1?, T2?, T3).
merge(T1, [H|T2], [H?|T3?]) :- merge(T1?, T2?, T3).
merge([], Ys, Ys?).
merge(Xs, [], Xs?).
