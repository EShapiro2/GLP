%% tag_stream.glp - Stream Tagging for Source Identification
%% Owner: GLP-ICLP (Program: Stream Tagging)
%%
%% When multiple input streams merge, source identity is lost. Stream tagging
%% preserves it by wrapping each message with its source identifier: tagged
%% streams can be merged while preserving source information.

procedure tag_stream(_?, Stream(_)?, Stream(_)).
tag_stream(Name, [M|In], [msg(Name?, M?)|Out?]) :-
    ground(Name?) | tag_stream(Name?, In?, Out).
tag_stream(_, [], []).

%% Example initial goal:
%% tag_stream(alice, [hi, bye], Tagged).   %% Tagged = [msg(alice,hi), msg(alice,bye)]
