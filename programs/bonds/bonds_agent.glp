agent(Med, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial, S1, S2, S3, S4, S5, S6, none) :- ground(Id?) | send(ask(agent_7, ctx_agent_7, R, Id1, no_deadline), Med?, Med1), agent(Med1?, Id?, UserIn?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, S1?, S2?, S3?, S4?, S5?, S6?, ask(R?, Id1?)).
agent(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) :- otherwise | true.

procedure on_act(Channel(Closed, Stream(AgentMsg))?, PeerContent?, Link?, Constant?, Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Integer?, Stream(Warranty)?, Integer?).
on_act(Med, pay(Bonds, Resp?), Link, From, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Bonds?) | adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), own_coins(Id?, Date?, Bonds?, Own), take_payment(Med?, Own?, Id?, From?, Bonds?, Date?, Resp, UserIn?, NetIn1?, Cal?, Outs1?, Holdings?, Ws?, Serial?).
on_act(Med, redeem(Bond, R, D1, Resp?), Link, From, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Bond?), ground(R?), integer(D1?) | adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), fulfil(Med?, Bond?, R?, D1?, Resp, Id?, From?, UserIn?, NetIn1?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?).
on_act(Med, swap(Want, Offered, Resp?), Link, From, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Want?), ground(Offered?) | med_split(Med?, Medb, Medr), respond_swap(Medb?, offer(From?, Want?, Offered?), Link?, Resp, Ans, none, none), merge(Ans?, UserIn?, UserIn1), agent(Medr?, Id?, UserIn1?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).
on_act(Med, transfer(Kind, Bonds, Resp?), Link, From, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Kind?), ground(Bonds?) | med_split(Med?, Medb, Medr), respond_transfer(Medb?, offer_transfer(Kind?, From?, Bonds?), Link?, Resp, Ans, none, none), merge(Ans?, UserIn?, UserIn1), agent(Medr?, Id?, UserIn1?, NetIn?, Cal?, Outs?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure take_payment(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Stream(Bond)?, Integer?, PayResponse, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Stream(Warranty)?, Integer?).
take_payment(Med, yes, Id, From, Bonds, Date, pay_taken(Date?), UserIn, NetIn, Cal, Outs, Holdings, Ws, Serial) :- ground(Bonds?) | append_bonds(Holdings?, Bonds?, Holdings1), count_bonds(Bonds?, 0, K), show(received(From?, K?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?).
take_payment(Med, no, Id, From, Bonds, Date, pay_returned(Bonds?), UserIn, NetIn, Cal, Outs, Holdings, Ws, Serial) :- ground(Bonds?) | count_bonds(Bonds?, 0, K), show(refused_payment(From?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure fulfil(Channel(Closed, Stream(AgentMsg))?, Bond?, Constant?, Integer?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Integer?, Stream(Warranty)?, Integer?).
fulfil(Med, bond(I, M, S), R, D1, Resp?, Id, From, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- (I? =?= Id?), (M? =< Date?) | take_bond(R?, D1?, Holdings?, Found, Rest), give(Med?, Found?, bond(I?, M?, S?), R?, D1?, Date?, Resp, Id?, From?, UserIn?, NetIn?, Cal?, Outs?, Rest?, Ws?, Serial?).
fulfil(Med, bond(I, M, S), _, _, redeem_declined(bond(I?, M?, S?)), Id, From, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- otherwise | show(refused(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure give(Channel(Closed, Stream(AgentMsg))?, Found?, Bond?, Constant?, Integer?, Integer?, RedeemResponse, Constant?, Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Stream(Warranty)?, Integer?).
give(Med, found(B), Mine, R, D1, Date, redeem_give(B?, Date?), Id, From, UserIn, NetIn, Cal, Outs, Rest, Ws, Serial) :- append_bonds(Rest?, [Mine?], Holdings1), show(presented(From?, R?, D1?), Outs?, Outs1), after_change(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings1?, Date?, Ws?, Serial?).
give(Med, not_found, Mine, R, D1, Date, redeem_menu(Mine?, Menu?), Id, From, UserIn, NetIn, Cal, Outs, Rest, Ws, Serial) :- ground(Rest?) | menu_of(Id?, Rest?, [], Menu), show(unfulfilled(From?, R?, D1?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Rest?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure fill_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, SwapResponse, Stream(Bond)?, Stream(Bond)?, Stream(Bond)?, Link?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
fill_swap(Med, ok, Id, From, swap_accept(Give?), Give, Offered, Rest, Link, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- adopt(Link?, From?, Outs?, Outs1, NetIn?, NetIn1), append_bonds(Rest?, Offered?, Holdings1), show(swap_done(From?), Outs1?, Outs2), after_change(Med?, Id?, UserIn?, NetIn1?, Cal?, Outs2?, Holdings1?, Date?, Ws?, Serial?).
fill_swap(Med, fail, Id, From, swap_decline(Offered?), Give, Offered, Rest, Link, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- drop_link(Link?), append_bonds(Give?, Rest?, Orig), show(swap_failed(From?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure propose_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Lot?, Lot?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
propose_swap(Med, ok, Id, Q, _, Want, Give, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- ground(Q?), ground(Want?), ground(Give?) | med_split(Med?, Medb, Medr), has_peer(Q?, Outs?, Outs1, Known), send_swap(Medb?, Known?, Id?, Q?, Want?, Give?, Outs1?, Outs2, UserIn?, UserIn1), after_change(Medr?, Id?, UserIn1?, NetIn?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?).
propose_swap(Med, fail, Id, Q, lot(U, D, K), _, Give, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure send_swap(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Lot?, Stream(Bond)?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(UserInMsg)?, Stream(UserInMsg)).
send_swap(Med, yes, Id, Q, Want, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Q?) | send_friend(Q?, msg(Id?, Q?, swap(Want?, Give?, Resp)), Outs?, Outs1), inject_swap_result(Resp?, Q?, linked, UserIn?, UserIn1).
send_swap(Med, no, Id, Q, Want, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Q?), new_channel(TheirEnd, MyEnd) | send_net(msg(Q?, call(Id?, swap(Want?, Give?, Resp), TheirEnd?)), Outs?, Outs1), inject_swap_result(Resp?, Q?, link(MyEnd?), UserIn?, UserIn1).

procedure propose_transfer(Channel(Closed, Stream(AgentMsg))?, Constant?, Kind?, Constant?, Constant?, Lot?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
propose_transfer(Med, ok, Kind, Id, Q, Lot, Give, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- ground(Kind?), ground(Q?), ground(Lot?), ground(Give?) | med_split(Med?, Medb, Medr), has_peer(Q?, Outs?, Outs1, Known), send_transfer(Medb?, Known?, Kind?, Id?, Q?, Give?, Outs1?, Outs2, UserIn?, UserIn1), show(offered_transfer(Kind?, Q?, Lot?), Outs2?, Outs3), after_change(Medr?, Id?, UserIn1?, NetIn?, Cal?, Outs3?, Rest?, Date?, Ws?, Serial?).
propose_transfer(Med, fail, _, Id, _, lot(U, D, K), Give, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(lacking(U?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure send_transfer(Channel(Closed, Stream(AgentMsg))?, Constant?, Kind?, Constant?, Constant?, Stream(Bond)?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(UserInMsg)?, Stream(UserInMsg)).
send_transfer(Med, yes, Kind, Id, Q, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Kind?), ground(Q?) | send_friend(Q?, msg(Id?, Q?, transfer(Kind?, Give?, Resp)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, linked, UserIn?, UserIn1).
send_transfer(Med, no, Kind, Id, Q, Give, Outs, Outs1?, UserIn, UserIn1?) :- ground(Kind?), ground(Q?), new_channel(TheirEnd, MyEnd) | send_net(msg(Q?, call(Id?, transfer(Kind?, Give?, Resp), TheirEnd?)), Outs?, Outs1), inject_transfer_result(Resp?, Kind?, Q?, link(MyEnd?), UserIn?, UserIn1).

procedure do_pay(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, Integer?, Integer?, Stream(Bond)?, Stream(Bond)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
do_pay(Med, ok, Id, Q, D, K, Give, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | med_split(Med?, Medb, Medr), has_peer(Q?, Outs?, Outs1, Known), send_owed(Medb?, Known?, Id?, Q?, pay(Give?, Resp), Outs1?, Outs2, NetIn?, NetIn1), inject_pay_result(Resp?, Q?, K?, UserIn?, UserIn1), show(paying(Q?, D?, K?), Outs2?, Outs3), after_change(Medr?, Id?, UserIn1?, NetIn1?, Cal?, Outs3?, Rest?, Date?, Ws?, Serial?).
do_pay(Med, fail, Id, Q, D, K, Give, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- append_bonds(Give?, Rest?, Orig), show(lacking(Q?, D?, K?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Orig?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure do_redeem(Channel(Closed, Stream(AgentMsg))?, Found?, Constant?, Constant?, Constant?, Integer?, Stream(Bond)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Integer?, Stream(Warranty)?, Integer?).
do_redeem(Med, found(B), Id, Q, R, D1, Rest, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- ground(Q?) | med_split(Med?, Medb, Medr), has_peer(Q?, Outs?, Outs1, Known), send_owed(Medb?, Known?, Id?, Q?, redeem(B?, R?, D1?, Resp), Outs1?, Outs2, NetIn?, NetIn1), inject_redeem_result(Resp?, Q?, UserIn?, UserIn1), after_change(Medr?, Id?, UserIn1?, NetIn1?, Cal?, Outs2?, Rest?, Date?, Ws?, Serial?).
do_redeem(Med, not_found, Id, Q, _, D, Holdings, UserIn, NetIn, Cal, Outs, Date, Ws, Serial) :- show(lacking(Q?, D?, 1), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

procedure send_owed(Channel(Closed, Stream(AgentMsg))?, Constant?, Constant?, Constant?, PeerContent?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg)).
send_owed(Med, yes, Id, Q, Act, Outs, Outs1?, NetIn, NetIn?) :- send_friend(Q?, msg(Id?, Q?, Act?), Outs?, Outs1).
send_owed(Med, no, Id, Q, Act, Outs, Outs2?, NetIn, NetIn1?) :- ground(Q?), new_channel(TheirEnd, MyEnd) | send_net(msg(Q?, call(Id?, Act?, TheirEnd?)), Outs?, Outs1), adopt(link(MyEnd?), Q?, Outs1?, Outs2, NetIn?, NetIn1).

procedure after_change(Channel(Closed, Stream(AgentMsg))?, Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(Integer)?, Stream(OutputEntry)?, Stream(Bond)?, Integer?, Stream(Warranty)?, Integer?).
after_change(Med, Id, UserIn, NetIn, Cal, Outs, Holdings, Date, Ws, Serial) :- ground(Holdings?) | tally(Holdings?, [], Lots), show(holdings(Lots?), Outs?, Outs1), agent(Med?, Id?, UserIn?, NetIn?, Cal?, Outs1?, Holdings?, Date?, Ws?, Serial?, none, none, none, none, none, none, none).

%% --- the mediator ---
exported procedure med(Channel(Stream(UserAnswer), Stream(Card))?, Channel(Stream(AgentMsg), Closed)?, TimerStream?, PendingList?, Integer?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(ask(C, Ctx, R?, Id?, deadline), AgentCh?, AgentCh1), ground(C?), ground(Ctx?) | Id = req(N?), send(card(C?, Ctx?, req(N?)), UserCh?, UserCh1), N1 := (N? + 1), deadline(D), timer(req(N?), D?, T), merge(T?, Ts?, Ts1), med(UserCh1?, AgentCh1?, Ts1?, [pending(req(N?), R) | Ps?], N1?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(ask(C, Ctx, R?, Id?, no_deadline), AgentCh?, AgentCh1), ground(C?), ground(Ctx?) | Id = req(N?), send(card(C?, Ctx?, req(N?)), UserCh?, UserCh1), N1 := (N? + 1), med(UserCh1?, AgentCh1?, Ts?, [pending(req(N?), R) | Ps?], N1?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(answer(ReqId, Vs), UserCh?, UserCh1), ground(ReqId?), ground(Vs?) | answer(ReqId?, Vs?, Ps?, Ps1), med(UserCh1?, AgentCh?, Ts?, Ps1?, N?).
med(UserCh, AgentCh, [timeout(ReqId) | Ts], Ps, N) :- ground(ReqId?) | close(ReqId?, Ps?, Ps1), send(closed(ReqId?), UserCh?, UserCh1), med(UserCh1?, AgentCh?, Ts?, Ps1?, N?).
med(UserCh, AgentCh, Ts, Ps, N) :- receive(abort(ReqId), AgentCh?, AgentCh1), ground(ReqId?) | close(ReqId?, Ps?, Ps1), send(closed(ReqId?), UserCh?, UserCh1), med(UserCh1?, AgentCh1?, Ts?, Ps1?, N?).

exported procedure timer(ReqId?, Number?, TimerStream).
timer(ReqId, D, [timeout(ReqId?)]) :- wait_until(D?) | true.

exported procedure deadline(Number).
deadline(D?) :- now(T), D := (T? + 60000).

exported procedure answer(ReqId?, Answer?, PendingList?, PendingList).
answer(ReqId, Vs, [pending(Id, R?) | Ps], Ps?) :- (ReqId? =?= Id?) | R = then(Vs?).
answer(ReqId, Vs, [P | Ps], [P? | Ps1?]) :- otherwise | answer(ReqId?, Vs?, Ps?, Ps1).
answer(_, _, [], []).

exported procedure close(ReqId?, PendingList?, PendingList).
close(ReqId, [pending(Id, R?) | Ps], Ps?) :- (ReqId? =?= Id?) | R = else.
close(ReqId, [P | Ps], [P? | Ps1?]) :- otherwise | close(ReqId?, Ps?, Ps1).
close(_, [], []).

exported procedure aborts(Slots?, Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg))).
aborts([], Med, Med?).
aborts([none | Ss], Med, Med1?) :- aborts(Ss?, Med?, Med1).
aborts([ask(_, Id) | Ss], Med, Med1?) :- ground(Id?) | send(abort(Id?), Med?, Med2), aborts(Ss?, Med2?, Med1).

exported procedure med_split(Channel(Closed, Stream(AgentMsg))?, Channel(Closed, Stream(AgentMsg)), Channel(Closed, Stream(AgentMsg))).
med_split(ch(_, Out?), ch([], O1), ch([], O2)) :- merge(O1?, O2?, Out).

