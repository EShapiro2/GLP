%% --- the mediator's vocabulary, instantiated ---
ReqId ::= req(Integer).
Reply ::= then(Answer) ; else.
Slot ::= none ; ask(Reply, ReqId).
Slots ::= [] ; [Slot | Slots].
Deadline ::= deadline ; no_deadline.
AgentMsg ::= ask(Constant, Context, Reply?, ReqId?, Deadline) ; abort(ReqId).
Card ::= card(Constant, Context, ReqId) ; closed(ReqId).
UserAnswer ::= answer(ReqId, Answer).
PendingEntry ::= pending(ReqId, Reply?).
PendingList ::= [] ; [PendingEntry | PendingList].
Timeout ::= timeout(ReqId).
TimerStream ::= [] ; [Timeout | TimerStream].

%% --- the display declarations, carried through ---
display agent *(K, D) : panel(bonds), label("Mint"), field(K, number), field(D, date), persistent.
display agent *(Q, U, D, K, V, D1, K1) : panel(bonds), label("Swap"), field(Q, peer), field(U, peer), field(D, date), field(K, number), field(V, peer), field(D1, date), field(K1, number), persistent.
display agent *(Q, D, K) : panel(bonds), label("Pay"), field(Q, peer), field(D, date), field(K, number), persistent.
display agent *(Q, D, R, D1) : panel(bonds), label("Redeem"), field(Q, peer), field(D, date), field(R, peer), field(D1, date), persistent.
display agent *(E, U, D, K) : panel(bonds), label("Deposit"), field(E, peer), field(U, peer), field(D, date), field(K, number), persistent.
display agent *(Q, U, D, K) : panel(bonds), label("Release"), field(Q, peer), field(U, peer), field(D, date), field(K, number), persistent.
display agent *(P, U, D, K) : panel(bonds), label("Return"), field(P, peer), field(U, peer), field(D, date), field(K, number), persistent.
display respond_swap *(no, From?, Want?, Offered?) : panel(bonds), label("Decline"), transient.
display respond_swap *(yes, From?, Want?, Offered?) : panel(bonds), label("Accept"), transient.
display respond_transfer *(no, Kind?, From?, Bonds?) : panel(bonds), label("Decline"), transient.
display respond_transfer *(yes, Kind?, From?, Bonds?) : panel(bonds), label("Accept"), transient.
display msg(agent, person, holdings(Lots)) : panel(bonds), view(balances).

