%% ---------------------------------------------------------------------------
%% ORH.glp --- ORH, the contract's speech-act schemas, GO's (Udi, 2026-11-09, to GO #3), in the clause syntax of GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint, Guards), as programs/gsc/README.md reads it; the clauses are in ORH.txt beside this file.
%% Extends GNO and GRA-SS, Grassroots Ride Auction, Second-Score Restriction, GRH's (programs/lbm).  The term holds every schema of what it extends, restated, the persons' schemas as GnW writes them (programs/gsc/GnW.glp), person required at a person's role.  GO instantiates GnW's parameters (GSC 745b9e3): ward at org, creator and created at themselves, guardian_of at officer_of and guarded_by at officer, each with the role, and retired at itself; the schemas are restated here until Code gives the term form of an instantiation.  An organisation guards its founding, its first guardian making its founding will for it (GSC 689b6f0), and after it each of its acts is taken for it by its officers, by the role and the rule its bylaws name (Udi, 2026-11-10).
%% 79 schemas.  This term is the one source of the schemas; a run of the cascade prints their notation from it.  Written by GO #3 Cowork and regenerated by GO #5, 2026-11-11, by GO/docs/tools/gen.py; the problems found in writing them are GO/docs/schemas-problems.md.
%% Environment predicates: today, fraction, now, location, since, degree, threshold, rider, driver.
%% ---------------------------------------------------------------------------

% contract_named(orh, C): the contract, ORH.
procedure contract_named(Constant?, SDeclared).
contract_named(orh, environment([today, fraction, now, location, since, degree, threshold, rider, driver],
   [
%% GKK:1, Identity, adding person, as GnW writes it.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice']),
        atom(person, ['Alice'])],
       [not(atom(identity, ['Alice']))],
       true,
       ['Alice']),
%% GKK:2, Acquaintance, for two persons; the introductory act, unobstructed but for org.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(identity, ['Bob']),
        atom(person, ['Bob'])],
       true,
       ['Alice', 'Bob']),
%% GKK:3, Introduction, for persons, with Bob's consent; Carol a reading role, as GnW writes it.
    sas(introduce, ['Alice', 'Bob', 'Carol'], [],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        atom(identity, ['Carol']),
        atom(person, ['Carol'])],
       true,
       ['Alice', 'Bob']),
%% GSG:1, Friendship, for two persons.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']),
        atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        not(atom(friend, ['Bob', 'Alice']))],
       true,
       ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, by a person, but an officer with the organisation, as GnW writes it for a guardian.
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])),
        not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(friend, ['Alice', 'Bob']),
        not(atom(officer_of, ['Alice', 'Bob', '_'])),
        atom(identity, ['Bob']),
        atom(friend, ['Bob', 'Alice'])],
       true,
       ['Alice']),
%% GFP:1, Creation: an agent signs what they create, bylaws and proposals among it, and holds it as an item.
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        not(atom(item, ['Alice', x]))],
       true,
       ['Alice']),
%% CC:1, Founding: Alice founds Orga for the Dollar, the denomination f, its bylaws those of a community currency, and becomes its first treasurer, the role 1.  Guarded by Orga too: a ward is founded by its first guardian, who makes the ward's founding will on behalf of the ward (GSC 689b6f0); Orga's guarding role forbids identity and requires no mark.
    sas(found, ['Alice', 'Orga'], [f],
       [atom(created, ['Alice', 'Orga']),
        atom(officer_of, ['Alice', 'Orga', num(1)]),
        atom(participates, ['Alice', 'Orga']),
        atom(friend, ['Alice', 'Orga']),
        atom(knows, ['Alice', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(creator, ['Orga', 'Alice']),
        atom(bylaws, ['Orga', val(bylaws_cc)]),
        atom(officer, ['Orga', 'Alice', num(1)]),
        atom(participant, ['Orga', 'Alice']),
        atom(friend, ['Orga', 'Alice']),
        atom(knows, ['Orga', 'Alice']),
        atom(denomination, ['Orga', num(f)])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        not(atom(identity, ['Orga']))],
       true,
       ['Alice', 'Orga']),
%% GnW:3, Ward and person: Orga and Bob come to know each other by an act of both; a relay act with a ward role and a free role.  Taken for Orga by its officers (all 1).
    sas(org_acquaint, ['Orga', 'Bob', 'Otto', v1a, v2a], [xpa, via, vna],
       [atom(knows, ['Orga', 'Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_org_acquaint, ['Orga', xpa, 'Bob']))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_org_acquaint, ['Orga', xpa, 'Bob'])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), eq(num(via), num(vna)))),
       ['Otto', 'Bob']),
%% GnW:4, Ward and ward: two organisations come to know each other by an act of both; a relay act with two ward roles.  Taken for Orga by its officers (all 1).  Taken for Orgb by its officers (all None).
    sas(orgs_acquaint, ['Orga', 'Orgb', 'Otto', v1a, v2a, 'Bruno', v1b, v2b], [xpa, via, vna, rob, xpb, vib, vnb],
       [atom(knows, ['Orga', 'Orgb']),
        atom(knows, ['Orgb', 'Orga']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_orgs_acquaint, ['Orga', xpa, 'Orgb'])),
        not(atom(proposal, ['Orgb', xpb])),
        not(atom(vote, ['Orgb', '_', xpb, '_'])),
        not(atom(motion_orgs_acquaint, ['Orgb', xpb, 'Orga', 'Otto']))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Orgb']),
        atom(org, ['Orgb']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_orgs_acquaint, ['Orga', xpa, 'Orgb']),
        atom(identity, ['Bruno']),
        atom(person, ['Bruno']),
        atom(officer_of, ['Bruno', 'Orgb', num(rob)]),
        atom(officer, ['Orgb', 'Bruno', num(rob)]),
        atom(proposal, ['Orgb', xpb]),
        atom(motion_orgs_acquaint, ['Orgb', xpb, 'Orga', 'Otto'])],
       and(and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), eq(num(via), num(vna)))), and(eq(num(vib), cardinality([v1b, rvb], atom(vote, ['Orgb', v1b, xpb, num(rvb)]), true)), and(eq(num(vnb), cardinality([v2b, rqb], atom(officer, ['Orgb', v2b, num(rqb)]), true)), eq(num(vib), num(vnb))))),
       ['Otto', 'Bruno']),
%% GnW:5, Retiring, as GO's paper revises it: the officers of Orga, its guardians (GO:4), every one of them a guard, retire Orga jointly; retired is a record, and Orga, with no officer, takes no act.  Taken for Orga by its officers (all None).
    sas(retire, ['Orga', 'Dave', 'Otto', v1a, v2a], [roa, xpa, via, vna],
       [atom(retired, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, [not(atom(officer_of, ['Dave', 'Orga', num(r)]))]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_retire, ['Orga', xpa]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, and(atom(identity, ['Dave']), atom(officer_of, ['Dave', 'Orga', num(r)]))),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_retire, ['Orga', xpa])],
       and(eq(num(via), cardinality([v1a, rva], atom(vote, ['Orga', v1a, xpa, num(rva)]), true)), and(eq(num(vna), cardinality([v2a, rqa], atom(officer, ['Orga', v2a, num(rqa)]), true)), eq(num(via), num(vna)))),
       ['Otto']),
%% GO:2: an officer, Bob, proposes an act of Orga, which the item x describes.
    sas(propose, ['Bob', 'Orga'], [x, r],
       [atom(proposal, ['Orga', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(item, ['Bob', x]),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        not(atom(proposal, ['Orga', x]))],
       eq(author_of(x), 'Bob'),
       ['Bob']),
%% GO:2: an officer, Bob, votes for the proposed act x, once for each role he holds.
    sas(vote, ['Bob', 'Orga'], [x, r],
       [atom(voted, ['Bob', 'Orga', x, num(r)]),
        atom(vote, ['Orga', 'Bob', x, num(r)])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        not(atom(voted, ['Bob', 'Orga', x, num(r)])),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(proposal, ['Orga', x])],
       true,
       ['Bob']),
%% GO:3, Participation: Bob becomes a participant of Orga by an act of Bob and Orga.  Taken for Orga by its officers (all 1).
    sas(join, ['Bob', 'Orga', 'Otto', v1a, v2a], [xpa, via, vna],
       [atom(participates, ['Bob', 'Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_join, ['Orga', xpa, 'Bob']))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(participates, ['Bob', 'Orga'])),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(knows, ['Orga', 'Bob']),
        not(atom(participant, ['Orga', 'Bob'])),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_join, ['Orga', xpa, 'Bob'])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), eq(num(via), num(vna)))),
       ['Bob', 'Otto']),
%% GO:4, Officers: a participant, Bob, is appointed to the role r by an act of Orga and Bob, and is a guardian of Orga while he holds a role.  A treasurer is appointed by CC:2 alone.  Taken for Orga by its officers (all 1).
    sas(appoint, ['Orga', 'Bob', 'Otto', v1a, v2a], [r, xpa, via, vna],
       [atom(officer, ['Orga', 'Bob', num(r)]),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_appoint, ['Orga', xpa, 'Bob', num(r)]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(officer, ['Orga', 'Bob', num(r)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_appoint, ['Orga', xpa, 'Bob', num(r)])],
       and(ne(num(r), num(1)), and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), eq(num(via), num(vna))))),
       ['Otto', 'Bob']),
%% GO:4: Orga removes Bob from the role r.  Taken for Orga by its officers (all 1).
    sas(dismiss, ['Orga', 'Bob', 'Otto', v1a, v2a], [r, xpa, via, vna],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)])),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_dismiss, ['Orga', xpa, 'Bob', num(r)]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(identity, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_dismiss, ['Orga', xpa, 'Bob', num(r)])],
       and(ne(num(r), num(1)), and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), ge(num(via), minus(num(vna), num(1)))))),
       ['Otto']),
%% GO:4: Bob removes himself from the role r.
    sas(resign_role, ['Bob', 'Orga'], [r],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)]))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)])],
       true,
       ['Bob']),
%% GO:5, Amendment: Orga replaces its bylaws b by b1.  Taken for Orga by its officers (all 1).
    sas(amend, ['Orga', 'Otto', v1a, v2a], [b, b1, xpa, via, vna],
       [not(atom(bylaws, ['Orga', b])),
        atom(bylaws, ['Orga', b1]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_amend, ['Orga', xpa, b, b1]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(bylaws, ['Orga', b]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_amend, ['Orga', xpa, b, b1])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), eq(num(via), num(vna)))),
       ['Otto']),
%% DGC:1, Minting: Alice issues k of her coins of the denomination f.
    sas(mint_coin, ['Alice'], [f, k],
       [times(num(k), atom(coin, ['Alice', 'Alice', num(f)]))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice'])],
       true,
       ['Alice']),
%% DGC:1: Alice issues k of her bonds of the denomination f and the maturity d, later than her date t.
    sas(mint_bond, ['Alice'], [f, d, k, t],
       [times(num(k), atom(bond, ['Alice', 'Alice', num(f), num(d)]))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(date, ['Alice', num(t)])],
       gt(num(d), num(t)),
       ['Alice']),
%% DGC:2, Date: an act no one wills, which keeps the date at the current date.
    sas(first_date, ['Alice'], [d],
       [atom(date, ['Alice', num(d)]),
        atom(dated, ['Alice'])],
       [atom(identity, ['Alice']),
        atom(today, ['Alice', num(d)]),
        not(atom(dated, ['Alice']))],
       true,
       []),
%% DGC:2.
    sas(advance, ['Alice'], [t, t1, d],
       [atom(date, ['Alice', num(t1)]),
        not(atom(date, ['Alice', num(t)]))],
       [atom(identity, ['Alice']),
        atom(today, ['Alice', num(d)]),
        atom(date, ['Alice', num(t)])],
       and(succ(num(t), num(t1)), le(num(t1), num(d))),
       []),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated coins for k1 coins; each comes to know the issuer of what they receive.
    sas(swap_cc, ['Alice', 'Bob', u, v], [f, u, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v, num(f)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u, num(f)]))),
        times(num(k), atom(coin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v, num(f)])))],
       [times(num(k), atom(coin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v, num(f)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated coins for k1 bonds; each comes to know the issuer of what they receive.
    sas(swap_cb, ['Alice', 'Bob', u, v], [f, u, k, v, d1, k1],
       [times(num(k1), atom(bond, ['Alice', v, num(f), num(d1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u, num(f)]))),
        times(num(k), atom(coin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])))],
       [times(num(k), atom(coin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated bonds for k1 coins; each comes to know the issuer of what they receive.
    sas(swap_bc, ['Alice', 'Bob', u, v], [f, u, d, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v, num(f)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(bond, ['Alice', u, num(f), num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(f), num(d)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v, num(f)])))],
       [times(num(k), atom(bond, ['Alice', u, num(f), num(d)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v, num(f)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated bonds for k1 bonds; each comes to know the issuer of what they receive.
    sas(swap_bb, ['Alice', 'Bob', u, v], [f, u, d, k, v, d1, k1],
       [times(num(k1), atom(bond, ['Alice', v, num(f), num(d1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(bond, ['Alice', u, num(f), num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(f), num(d)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])))],
       [times(num(k), atom(bond, ['Alice', u, num(f), num(d)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:4, Acceptance: Alice accepts l u-coins, holding a u-coin.
    sas(accept_c, ['Alice', u], [f, u, l],
       [times(num(l), atom(accepts, ['Alice', u, num(f)]))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(coin, ['Alice', u, num(f)])],
       true,
       ['Alice']),
