%% ---------------------------------------------------------------------------
%% GO.glp --- GO, the contract's speech-act schemas, GO's (Udi, 2026-11-09, to GO #3), in the clause syntax of GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint, Guards), as programs/gsc/README.md reads it; the clauses are in GO.txt beside this file.
%% Extends GnW, Guardians 'n' Wards, GSC's (programs/gsc), and through it GSG and GKK.  The term holds every schema of what it extends, restated, the persons' schemas as GnW writes them (programs/gsc/GnW.glp), person required at a person's role.  GO instantiates GnW's parameters (GSC 745b9e3): ward at org, creator and created at themselves, guardian_of at officer_of and guarded_by at officer, each with the role, and retired at itself; the schemas are restated here until Code gives the term form of an instantiation.  An organisation guards nothing, each of its acts taken for it by its officers, by the role and the rule its bylaws name (Udi, 2026-11-10).
%% 23 schemas.  This term is the one source of the schemas; a run of the cascade prints their notation from it.  Written by GO #3 Cowork, 2026-11-10, by GO/docs/tools/gen.py; the problems found in writing them are GO/docs/schemas-problems.md.
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant) ; real(Constant)
              ; sgn(Constant, Constant) ; item_of(Constant) ; val(Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SHead       ::= SMult ; not(SMult) ; forall(PNames, SAtom, SCond, SHeads).
SHeads      ::= [] ; [SHead | SHeads].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr)
              ; fn(Constant, SExprs) ; cardinality(PNames, SAtom, SCond)
              ; sum(PNames, SAtom, SCond, SExpr) ; author_of(Constant) ; item_of(Constant).
SExprs      ::= [] ; [SExpr | SExprs].
SCond       ::= true ; SMult ; not(SCond) ; and(SCond, SCond) ; or(SCond, SCond)
              ; eq(SExpr, SExpr) ; ne(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg) ; rel(Constant, SExprs)
              ; forall(PNames, SAtom, SCond, SCond) ; exists(PNames, SAtom, SCond).
SConds      ::= [] ; [SCond | SConds].
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SHeads, SConds, SCond, PNames).
Contract    ::= [] ; [Schema | Contract].
Preds       ::= [] ; [Constant | Preds].
SParam      ::= Constant ; val(Constant).
SParams     ::= [] ; [SParam | SParams].
Declared    ::= Contract ; environment(Preds, Contract) ; parametric(SParams, Declared).

% contract_named(go, C): the contract, GO.
procedure contract_named(Constant?, Declared).
contract_named(go, 
   [
%% GKK:1, Identity, adding person, as GnW writes it.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice']),
        atom(person, ['Alice'])],
       [not(atom(identity, ['Alice']))],
       true,
       ['Alice']),
%% GKK:2, Acquaintance, for two persons; the introductory act, unobstructed but for org.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(identity, ['Bob']),
        atom(person, ['Bob'])],
       true,
       ['Alice', 'Bob']),
%% GKK:3, Introduction, for persons, with Bob's consent; Carol a reading role, as GnW writes it.
    sas(introduce, ['Alice', 'Bob', 'Carol'], [],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        atom(identity, ['Carol']),
        atom(person, ['Carol'])],
       true,
       ['Alice', 'Bob']),
%% GSG:1, Friendship, for two persons.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']),
        atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        not(atom(friend, ['Bob', 'Alice']))],
       true,
       ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, by a person, but an officer with the organisation, as GnW writes it for a guardian.
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])),
        not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(friend, ['Alice', 'Bob']),
        not(atom(officer_of, ['Alice', 'Bob', '_'])),
        atom(identity, ['Bob']),
        atom(friend, ['Bob', 'Alice'])],
       true,
       ['Alice']),
%% GFP:1, Creation: an agent signs what they create, bylaws and proposals among it, and holds it as an item.
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        not(atom(item, ['Alice', x]))],
       true,
       ['Alice']),
%% GO:1, Founding, by Alice: she creates Orga as a ward (GnW:1), choosing its bylaws b, and is its creator (GnW:1), its first officer, in the role r, a participant and its friend.
    sas(found, ['Alice', 'Orga'], [b, r],
       [atom(created, ['Alice', 'Orga']),
        atom(officer_of, ['Alice', 'Orga', num(r)]),
        atom(participates, ['Alice', 'Orga']),
        atom(friend, ['Alice', 'Orga']),
        atom(knows, ['Alice', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(creator, ['Orga', 'Alice']),
        atom(bylaws, ['Orga', b]),
        atom(officer, ['Orga', 'Alice', num(r)]),
        atom(participant, ['Orga', 'Alice']),
        atom(friend, ['Orga', 'Alice']),
        atom(knows, ['Orga', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(item, ['Alice', b]),
        not(atom(identity, ['Orga']))],
       eq(author_of(b), 'Alice'),
       ['Alice']),
%% GO:1, Founding, by an organisation, Gov, with Alice: Gov chooses the bylaws b, and Alice is the founder of the ward and its first officer, a guardian being a person (GnW).  Taken for Gov by its officers (abstract).
    sas(found_by, ['Gov', 'Alice', 'Orga', 'Greta', v1g, v2g], [b, r, rog, xpg, vig, vng, blg],
       [atom(founded, ['Gov', 'Orga']),
        atom(knows, ['Gov', 'Orga']),
        atom(created, ['Alice', 'Orga']),
        atom(officer_of, ['Alice', 'Orga', num(r)]),
        atom(participates, ['Alice', 'Orga']),
        atom(friend, ['Alice', 'Orga']),
        atom(knows, ['Alice', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(creator, ['Orga', 'Alice']),
        atom(bylaws, ['Orga', b]),
        atom(officer, ['Orga', 'Alice', num(r)]),
        atom(participant, ['Orga', 'Alice']),
        atom(friend, ['Orga', 'Alice']),
        atom(knows, ['Orga', 'Alice']),
        not(atom(proposal, ['Gov', xpg])),
        not(atom(vote, ['Gov', '_', xpg]))],
       [atom(identity, ['Gov']),
        atom(org, ['Gov']),
        atom(item, ['Gov', b]),
        atom(knows, ['Gov', 'Alice']),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Gov']),
        not(atom(identity, ['Orga'])),
        atom(identity, ['Greta']),
        atom(person, ['Greta']),
        atom(officer_of, ['Greta', 'Gov', num(rog)]),
        atom(officer, ['Gov', 'Greta', num(rog)]),
        atom(proposal, ['Gov', xpg]),
        atom(bylaws, ['Gov', blg])],
       and(eq(author_of(b), 'Gov'), and(eq(num(vig), cardinality([v1g], atom(vote, ['Gov', v1g, xpg]), true)), and(eq(num(vng), cardinality([v2g], atom(officer, ['Gov', v2g, num(rog)]), true)), rel(admits, [item_of(blg), item_of(xpg), val(found_by), num(rog), num(vig), num(vng)])))),
       ['Alice', 'Greta']),
%% GnW:3, Ward and person: Orga and Bob come to know each other by an act of both; a relay act with a ward role and a free role.  Taken for Orga by its officers (abstract).
    sas(org_acquaint, ['Orga', 'Bob', 'Otto', v1a, v2a], [roa, xpa, via, vna, bla],
       [atom(knows, ['Orga', 'Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(bylaws, ['Orga', bla])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(roa)]), true)), rel(admits, [item_of(bla), item_of(xpa), val(org_acquaint), num(roa), num(via), num(vna)]))),
       ['Bob', 'Otto']),
%% GnW:4, Ward and ward: two organisations come to know each other by an act of both; a relay act with two ward roles.  Taken for Orga by its officers (abstract).  Taken for Orgb by its officers (abstract).
    sas(orgs_acquaint, ['Orga', 'Orgb', 'Otto', v1a, v2a, 'Bruno', v1b, v2b], [roa, xpa, via, vna, bla, rob, xpb, vib, vnb, blb],
       [atom(knows, ['Orga', 'Orgb']),
        atom(knows, ['Orgb', 'Orga']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa])),
        not(atom(proposal, ['Orgb', xpb])),
        not(atom(vote, ['Orgb', '_', xpb]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Orgb']),
        atom(org, ['Orgb']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(bylaws, ['Orga', bla]),
        atom(identity, ['Bruno']),
        atom(person, ['Bruno']),
        atom(officer_of, ['Bruno', 'Orgb', num(rob)]),
        atom(officer, ['Orgb', 'Bruno', num(rob)]),
        atom(proposal, ['Orgb', xpb]),
        atom(bylaws, ['Orgb', blb])],
       and(and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(roa)]), true)), rel(admits, [item_of(bla), item_of(xpa), val(orgs_acquaint), num(roa), num(via), num(vna)]))), and(eq(num(vib), cardinality([v1b], atom(vote, ['Orgb', v1b, xpb]), true)), and(eq(num(vnb), cardinality([v2b], atom(officer, ['Orgb', v2b, num(rob)]), true)), rel(admits, [item_of(blb), item_of(xpb), val(orgs_acquaint), num(rob), num(vib), num(vnb)])))),
       ['Otto', 'Bruno']),
%% GnW:5, Retiring, as GO's paper revises it: the officers of Orga, its guardians (GO:4), every one of them a guard, retire Orga jointly; retired is a record, and Orga, with no officer, takes no act.  Taken for Orga by its officers (joint None).
    sas(retire, ['Orga', 'Dave', 'Otto', 'Olga'], [roa],
       [atom(retired, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, [not(atom(officer_of, ['Dave', 'Orga', num(r)]))])],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, and(atom(identity, ['Dave']), atom(officer_of, ['Dave', 'Orga', num(r)]))),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        forall(['Olga', rqa], atom(officer, ['Orga', 'Olga', num(rqa)]), ne('Olga', 'Otto'), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(rqa)]))))],
       true,
       ['Otto', 'Olga']),
%% GO:2: an officer, Bob, proposes an act of Orga, which the item x describes.
    sas(propose, ['Bob', 'Orga'], [x, r],
       [atom(proposal, ['Orga', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(item, ['Bob', x]),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        not(atom(proposal, ['Orga', x]))],
       eq(author_of(x), 'Bob'),
       ['Bob']),
%% GO:2: an officer, Bob, votes for the proposed act x.
    sas(vote, ['Bob', 'Orga'], [x, r],
       [atom(voted, ['Bob', 'Orga', x]),
        atom(vote, ['Orga', 'Bob', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        not(atom(voted, ['Bob', 'Orga', x])),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(proposal, ['Orga', x])],
       true,
       ['Bob']),
%% GO:3, Participation: Bob becomes a participant of Orga by an act of Bob and Orga.  Taken for Orga by its officers (abstract).
    sas(join, ['Bob', 'Orga', 'Otto', v1a, v2a], [roa, xpa, via, vna, bla],
       [atom(participates, ['Bob', 'Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa]))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(participates, ['Bob', 'Orga'])),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(knows, ['Orga', 'Bob']),
        not(atom(participant, ['Orga', 'Bob'])),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(bylaws, ['Orga', bla])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(roa)]), true)), rel(admits, [item_of(bla), item_of(xpa), val(join), num(roa), num(via), num(vna)]))),
       ['Bob', 'Otto']),
%% GO:3: Bob ends his participation by his own act, and with it every role he holds.
    sas(leave, ['Bob', 'Orga'], [],
       [not(atom(participates, ['Bob', 'Orga'])),
        not(atom(participant, ['Orga', 'Bob'])),
        not(atom(officer_of, ['Bob', 'Orga', '_'])),
        not(atom(officer, ['Orga', 'Bob', '_']))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Orga']),
        atom(participant, ['Orga', 'Bob'])],
       true,
       ['Bob']),
%% GO:3: Orga ends Bob's participation by its act, and with it every role he holds.  Taken for Orga by its officers (abstract).
    sas(expel, ['Orga', 'Bob', 'Otto', v1a, v2a], [roa, xpa, via, vna, bla],
       [not(atom(participant, ['Orga', 'Bob'])),
        not(atom(participates, ['Bob', 'Orga'])),
        not(atom(officer_of, ['Bob', 'Orga', '_'])),
        not(atom(officer, ['Orga', 'Bob', '_'])),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participant, ['Orga', 'Bob']),
        atom(identity, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(bylaws, ['Orga', bla])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(roa)]), true)), rel(admits, [item_of(bla), item_of(xpa), val(expel), num(roa), num(via), num(vna)]))),
       ['Otto']),
%% GO:4, Officers: a participant, Bob, is appointed to the role r by an act of Orga and Bob, and is a guardian of Orga while he holds a role.  Taken for Orga by its officers (abstract).
    sas(appoint, ['Orga', 'Bob', 'Otto', v1a, v2a], [r, roa, xpa, via, vna, bla],
       [atom(officer, ['Orga', 'Bob', num(r)]),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(officer, ['Orga', 'Bob', num(r)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(bylaws, ['Orga', bla])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(roa)]), true)), rel(admits, [item_of(bla), item_of(xpa), val(appoint), num(roa), num(via), num(vna)]))),
       ['Bob', 'Otto']),
%% GO:4: Orga removes Bob from the role r.  Taken for Orga by its officers (abstract).
    sas(dismiss, ['Orga', 'Bob', 'Otto', v1a, v2a], [r, roa, xpa, via, vna, bla],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)])),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(identity, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(bylaws, ['Orga', bla])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(roa)]), true)), rel(admits, [item_of(bla), item_of(xpa), val(dismiss), num(roa), num(via), num(vna)]))),
       ['Otto']),
%% GO:4: Bob removes himself from the role r.
    sas(resign_role, ['Bob', 'Orga'], [r],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)]))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)])],
       true,
       ['Bob']),
%% GO:2: a person the bylaws name, Bob, proposes an act of Orga, which the item x describes.
    sas(propose_named, ['Bob', 'Orga'], [x, b],
       [atom(proposal, ['Orga', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(item, ['Bob', x]),
        atom(knows, ['Bob', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(bylaws, ['Orga', b]),
        not(atom(proposal, ['Orga', x]))],
       and(eq(author_of(x), 'Bob'), rel(names, [item_of(b), item_of(x)])),
       ['Bob']),
%% GO:2: a person the bylaws name for the act x, Bob, votes for it, presenting the item y the bylaws name him by.
    sas(vote_named, ['Bob', 'Orga'], [x, b, y],
       [atom(voted, ['Bob', 'Orga', x]),
        atom(vote, ['Orga', 'Bob', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Orga']),
        atom(item, ['Bob', y]),
        not(atom(voted, ['Bob', 'Orga', x])),
        atom(identity, ['Orga']),
        atom(bylaws, ['Orga', b]),
        atom(proposal, ['Orga', x])],
       and(eq(author_of(y), 'Bob'), rel(names, [item_of(b), item_of(x), item_of(y)])),
       ['Bob']),
%% GO's definition: appointing an officer when there is none, by a person the bylaws name, Nora, presenting the item y they name her by, and the participant, Bob (GSC 7e00aba admits it).
    sas(appoint_none, ['Nora', 'Bob', 'Orga'], [r, b, y],
       [atom(officer, ['Orga', 'Bob', num(r)]),
        atom(officer_of, ['Bob', 'Orga', num(r)])],
       [atom(identity, ['Nora']),
        atom(person, ['Nora']),
        atom(item, ['Nora', y]),
        atom(knows, ['Nora', 'Orga']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(bylaws, ['Orga', b]),
        atom(participant, ['Orga', 'Bob']),
        not(atom(officer, ['Orga', '_', '_']))],
       and(eq(author_of(y), 'Nora'), rel(names, [item_of(b), val(appoint_none), item_of(y)])),
       ['Nora', 'Bob']),
%% GO:5, Amendment: Orga replaces its bylaws b by b1.  Taken for Orga by its officers (abstract).
    sas(amend, ['Orga', 'Otto', v1a, v2a], [b, b1, roa, xpa, via, vna],
       [not(atom(bylaws, ['Orga', b])),
        atom(bylaws, ['Orga', b1]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(bylaws, ['Orga', b]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(roa)]), true)), rel(admits, [item_of(b), item_of(xpa), val(amend), num(roa), num(via), num(vna)]))),
       ['Otto'])]).
