        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), ne('Olga', 'Otto'), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       true,
       ['Otto', 'Olga']),
%% GNO:4, Arbitration: Alice, the customer, raises a dispute over the coins locked in z to an arbiter, Carol.
    sas(gno_raise_c, ['Alice', 'Orga', 'Bob', 'Carol'], [z, 'Bob', 'Carol'],
       [atom(disputed, ['Orga', z, 'Carol'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Orga']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', '_', '_', '_']),
        atom(officer, ['Orga', 'Carol', num(2)]),
        not(atom(disputed, ['Orga', z, '_']))],
       true,
       ['Alice']),
%% GNO:4: Bob, the provider, raises a dispute over the coins locked in z to an arbiter, Carol.
    sas(gno_raise_p, ['Bob', 'Orga', 'Alice', 'Carol'], [z, 'Alice', 'Carol'],
       [atom(disputed, ['Orga', z, 'Carol'])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Orga']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', '_', '_', '_']),
        atom(officer, ['Orga', 'Carol', num(2)]),
        not(atom(disputed, ['Orga', z, '_']))],
       true,
       ['Bob']),
%% GNO:4: Carol, the arbiter, decides the release of the locked coins, a1 to Alice and c1 to Bob, less the fee e, which is released to her.
    sas(gno_arbitrate, ['Carol', 'Orga', 'Alice', 'Bob'], [z, 'Alice', 'Bob', a, c, e, a1, c1],
       [not(atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)])),
        not(atom(disputed, ['Orga', z, 'Carol'])),
        atom(settle, ['Orga', z, 'Alice', num(a1)]),
        atom(settle, ['Orga', z, 'Bob', num(c1)]),
        atom(settle, ['Orga', z, 'Carol', num(e)])],
       [atom(identity, ['Carol']),
        atom(person, ['Carol']),
        atom(officer_of, ['Carol', 'Orga', num(2)]),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)]),
        atom(disputed, ['Orga', z, 'Carol'])],
       and(eq(plus(plus(num(a1), num(c1)), num(e)), plus(num(a), num(c))), and(ge(num(a1), num(0)), ge(num(c1), num(0)))),
       ['Carol']),
%% The release of locked coins: Orga pays Bob the x Orga-coins settled to him; an act no one wills.
    sas(settle_pay, ['Orga', 'Bob'], [f, z, x],
       [not(atom(settle, ['Orga', z, 'Bob', num(x)])),
        not(times(num(x), atom(coin, ['Orga', 'Orga', num(f)]))),
        times(num(x), atom(coin, ['Bob', 'Orga', num(f)]))],
       [atom(identity, ['Orga']),
        atom(settle, ['Orga', z, 'Bob', num(x)]),
        times(num(x), atom(coin, ['Orga', 'Orga', num(f)])),
        atom(denomination, ['Orga', num(f)]),
        atom(identity, ['Bob'])],
       ge(num(x), num(1)),
       []),
%% GDO:1, Pointing to friend.
    sas(point_friend, ['Alice', 'Bob'], [],
       [atom(points_to, ['Alice', 'Bob'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(friend, ['Alice', 'Bob']),
        not(atom(points_to, ['Alice', 'Bob'])),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDO:2, Transitive pointing: Bob a reading role, Carol a variable.
    sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(points_to, ['Alice', 'Carol'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Carol']),
        atom(points_to, ['Alice', 'Bob']),
        atom(identity, ['Bob']),
        atom(points_to, ['Bob', 'Carol'])],
       true,
       ['Alice']),
%% GDO:3, Ceasing to point.
    sas(unpoint, ['Alice', 'Bob'], [],
       [not(atom(points_to, ['Alice', 'Bob']))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(points_to, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GAN's definition: a member's profile is in their state and nowhere else; Alice sets hers.
    sas(gan_profile, ['Alice'], [p],
       [not(atom(profile, ['Alice', '_'])),
        atom(profile, ['Alice', num(p)])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice'])],
       true,
       ['Alice']),
%% GAN:1: Bob, an advertiser, creates the ad l, its budget g Orga-coins locked at Orga on top of his stake.
    sas(gan_fund, ['Bob', 'Orga'], [l, f, s, g, f1b, stb],
       [atom(listed, ['Bob', l]),
        not(times(num(g), atom(coin, ['Bob', 'Orga', num(f)]))),
        times(num(g), atom(coin, ['Orga', 'Orga', num(f)])),
        atom(budget, ['Orga', l, 'Bob', num(g)])],
       [times(num(g), atom(coin, ['Bob', 'Orga', num(f)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(listed, ['Bob', l])),
        atom(identity, ['Orga']),
        atom(stake, ['Orga', num(s)]),
        atom(denomination, ['Orga', num(f)]),
        atom(coin, ['Bob', 'Orga', num(f1b)])],
       and(ge(num(g), num(1)), and(eq(num(stb), cardinality([], atom(coin, ['Bob', 'Orga', num(f1b)]), true)), and(eq(num(f1b), num(f)), ge(num(stb), plus(num(s), num(g)))))),
       ['Bob']),
%% GAN:1, Posting: Bob, an advertiser, posts an ad l, for the profile pr, paying v Orga-coins a view and k a click, and at most mx to one member, to Alice, a member he points to, its budget locked by gan_fund.
    sas(gan_post, ['Bob', 'Alice', 'Orga'], [l, f, pr, v, k, mx],
       [atom(posted, ['Bob', l, 'Alice']),
        atom(ad, ['Alice', l, 'Bob', 'Orga', num(f), num(pr), num(v), num(k), num(mx)])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(points_to, ['Bob', 'Alice']),
        atom(listed, ['Bob', l]),
        not(atom(posted, ['Bob', l, 'Alice'])),
        atom(identity, ['Alice']),
        atom(accepts, ['Alice', 'Orga', num(f)]),
        not(atom(ad, ['Alice', l, '_', '_', '_', '_', '_', '_', '_'])),
        atom(identity, ['Orga']),
        atom(budget, ['Orga', l, 'Bob', '_']),
        atom(denomination, ['Orga', num(f)])],
       true,
       ['Bob']),
%% GAN:1: Alice, a member, passes the ad to Carol, a member she points to.
    sas(gan_pass, ['Alice', 'Carol', 'Bob', 'Orga'], [l, f, pr, v, k, mx, 'Bob', 'Orga'],
       [atom(passed, ['Alice', l, 'Carol']),
        atom(ad, ['Carol', l, 'Bob', 'Orga', num(f), num(pr), num(v), num(k), num(mx)])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(ad, ['Alice', l, 'Bob', 'Orga', num(f), num(pr), num(v), num(k), num(mx)]),
        atom(points_to, ['Alice', 'Carol']),
        not(atom(passed, ['Alice', l, 'Carol'])),
        atom(identity, ['Carol']),
        not(atom(ad, ['Carol', l, '_', '_', '_', '_', '_', '_', '_']))],
       true,
       ['Alice']),
%% GAN:2, Showing: Alice is shown an ad she received if it is for her profile; an act no one wills.
    sas(gan_show, ['Alice'], [l, f, pr, v, k, mx, p, 'Bob', 'Orga'],
       [atom(shown, ['Alice', l])],
       [atom(identity, ['Alice']),
        atom(ad, ['Alice', l, 'Bob', 'Orga', num(f), num(pr), num(v), num(k), num(mx)]),
        atom(profile, ['Alice', num(p)]),
        not(atom(shown, ['Alice', l]))],
       rel(for_profile, [num(pr), num(p)]),
       []),
%% GAN:3, Viewing, attested: Alice attests that she viewed the ad, and Bob pays her v Orga-coins from his stake, up to mx.
    sas(gan_view, ['Alice', 'Orga'], [l, f, pr, v, k, mx, 'Bob', g, g1],
       [times(num(v), atom(coin, ['Alice', 'Orga', num(f)])),
        times(num(v), atom(earned, ['Alice', l])),
        atom(viewed, ['Alice', l]),
        not(times(num(v), atom(coin, ['Orga', 'Orga', num(f)]))),
        not(atom(budget, ['Orga', l, 'Bob', num(g)])),
        atom(budget, ['Orga', l, 'Bob', num(g1)])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(shown, ['Alice', l]),
        atom(ad, ['Alice', l, 'Bob', 'Orga', num(f), num(pr), num(v), num(k), num(mx)]),
        not(atom(viewed, ['Alice', l])),
        atom(identity, ['Orga']),
        times(num(v), atom(coin, ['Orga', 'Orga', num(f)])),
        atom(budget, ['Orga', l, 'Bob', num(g)])],
       and(le(plus(cardinality([], atom(earned, ['Alice', l]), true), num(v)), num(mx)), and(eq(num(g1), minus(num(g), num(v))), ge(num(g1), num(0)))),
       ['Alice']),
%% GAN:3, Clicking, attested: Alice attests that she clicked the ad, and Bob pays her k Orga-coins from his stake, up to mx.
    sas(gan_click, ['Alice', 'Orga'], [l, f, pr, v, k, mx, 'Bob', g, g1],
       [times(num(k), atom(coin, ['Alice', 'Orga', num(f)])),
        times(num(k), atom(earned, ['Alice', l])),
        atom(clicked, ['Alice', l]),
        not(times(num(k), atom(coin, ['Orga', 'Orga', num(f)]))),
        not(atom(budget, ['Orga', l, 'Bob', num(g)])),
        atom(budget, ['Orga', l, 'Bob', num(g1)])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(shown, ['Alice', l]),
        atom(ad, ['Alice', l, 'Bob', 'Orga', num(f), num(pr), num(v), num(k), num(mx)]),
        not(atom(clicked, ['Alice', l])),
        atom(identity, ['Orga']),
        times(num(k), atom(coin, ['Orga', 'Orga', num(f)])),
        atom(budget, ['Orga', l, 'Bob', num(g)])],
       and(le(plus(cardinality([], atom(earned, ['Alice', l]), true), num(k)), num(mx)), and(eq(num(g1), minus(num(g), num(k))), ge(num(g1), num(0)))),
       ['Alice'])])).
