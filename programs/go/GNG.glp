        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), and(ne('Olga', 'Otto'), ne('Olga', 'Alice')), and(atom(identity, ['Olga']), and(not(atom(retired, ['Olga'])), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       ge(num(d), num(1)),
       ['Otto', 'Olga']),
%% GBCC:3, as above, a later payment.  Taken for Orga by its officers (joint 1).
    sas(gbcc_record, ['Orga', 'Alice', 'Otto', 'Olga'], ['Alice', d, p, p1],
       [not(atom(paid, ['Orga', 'Alice', num(p)])),
        atom(paid, ['Orga', 'Alice', num(p1)])],
       [atom(identity, ['Orga']),
        atom(ward, ['Orga']),
        atom(org, ['Orga']),
        not(atom(retired, ['Orga'])),
        atom(officer, ['Orga', 'Alice', num(1)]),
        atom(paid, ['Orga', 'Alice', num(p)]),
        atom(identity, ['Otto']),
        not(atom(ward, ['Otto'])),
        not(atom(retired, ['Otto'])),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), and(ne('Olga', 'Otto'), ne('Olga', 'Alice')), and(atom(identity, ['Olga']), and(not(atom(retired, ['Olga'])), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       and(ge(num(d), num(1)), eq(num(p1), plus(num(p), num(d)))),
       ['Otto', 'Olga']),
%% GNO:1, Stake: the treasurers set S, an act of Orga (GO:2).  Taken for Orga by its officers (joint 1).
    sas(gno_stake, ['Orga', 'Otto', 'Olga'], [s],
       [not(atom(stake, ['Orga', '_'])),
        atom(stake, ['Orga', num(s)])],
       [atom(identity, ['Orga']),
        atom(ward, ['Orga']),
        atom(org, ['Orga']),
        not(atom(retired, ['Orga'])),
        atom(identity, ['Otto']),
        not(atom(ward, ['Otto'])),
        not(atom(retired, ['Otto'])),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), ne('Olga', 'Otto'), and(atom(identity, ['Olga']), and(not(atom(retired, ['Olga'])), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       true,
       ['Otto', 'Olga']),
%% GNO:4, Arbitration: Alice, the customer, raises a dispute over the coins locked in z to an arbiter, Carol.
    sas(gno_raise_c, ['Alice', 'Orga', 'Bob', 'Carol'], [z, 'Bob', 'Carol'],
       [atom(disputed, ['Orga', z, 'Carol'])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(knows, ['Alice', 'Orga']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', '_', '_', '_']),
        atom(officer, ['Orga', 'Carol', num(2)]),
        not(atom(disputed, ['Orga', z, '_']))],
       true,
       ['Alice']),
%% GNO:4: Bob, the provider, raises a dispute over the coins locked in z to an arbiter, Carol.
    sas(gno_raise_p, ['Bob', 'Orga', 'Alice', 'Carol'], [z, 'Alice', 'Carol'],
       [atom(disputed, ['Orga', z, 'Carol'])],
       [atom(identity, ['Bob']),
        not(atom(retired, ['Bob'])),
        atom(knows, ['Bob', 'Orga']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', '_', '_', '_']),
        atom(officer, ['Orga', 'Carol', num(2)]),
        not(atom(disputed, ['Orga', z, '_']))],
       true,
       ['Bob']),
%% GNO:4: Carol, the arbiter, decides the release of the locked coins, a1 to Alice and c1 to Bob, less the fee e, which is released to her.
    sas(gno_arbitrate, ['Carol', 'Orga', 'Alice', 'Bob'], [z, 'Alice', 'Bob', a, c, e, a1, c1],
       [not(atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)])),
        not(atom(disputed, ['Orga', z, 'Carol'])),
        atom(settle, ['Orga', z, 'Alice', num(a1)]),
        atom(settle, ['Orga', z, 'Bob', num(c1)]),
        atom(settle, ['Orga', z, 'Carol', num(e)])],
       [atom(identity, ['Carol']),
        not(atom(retired, ['Carol'])),
        atom(officer_of, ['Carol', 'Orga', num(2)]),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)]),
        atom(disputed, ['Orga', z, 'Carol'])],
       and(eq(plus(plus(num(a1), num(c1)), num(e)), plus(num(a), num(c))), and(ge(num(a1), num(0)), ge(num(c1), num(0)))),
       ['Carol']),
%% The release of locked coins: Orga pays Bob the x Orga-coins settled to him; an act no one wills.
    sas(settle_pay, ['Orga', 'Bob'], [f, z, x],
       [not(atom(settle, ['Orga', z, 'Bob', num(x)])),
        not(times(num(x), atom(coin, ['Orga', 'Orga', num(f)]))),
        times(num(x), atom(coin, ['Bob', 'Orga', num(f)]))],
       [atom(identity, ['Orga']),
        atom(settle, ['Orga', z, 'Bob', num(x)]),
        times(num(x), atom(coin, ['Orga', 'Orga', num(f)])),
        atom(denomination, ['Orga', num(f)]),
        atom(identity, ['Bob'])],
       ge(num(x), num(1)),
       []),
%% GDO:1, Pointing to friend.
    sas(point_friend, ['Alice', 'Bob'], [],
       [atom(points_to, ['Alice', 'Bob'])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(friend, ['Alice', 'Bob']),
        not(atom(points_to, ['Alice', 'Bob'])),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDO:2, Transitive pointing: Bob a reading role, Carol a variable.
    sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(points_to, ['Alice', 'Carol'])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(knows, ['Alice', 'Carol']),
        atom(points_to, ['Alice', 'Bob']),
        atom(identity, ['Bob']),
        atom(points_to, ['Bob', 'Carol'])],
       true,
       ['Alice']),
%% GDO:3, Ceasing to point.
    sas(unpoint, ['Alice', 'Bob'], [],
       [not(atom(points_to, ['Alice', 'Bob']))],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(points_to, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GNG:1, Job: Alice, a client, posts a job l, its price pr, its deadline dl and its terms tm, to Bob, a worker she points to.
    sas(gng_job, ['Alice', 'Bob', 'Orga'], [l, f, s, pr, dl, tm, f1b, stb],
       [atom(listed, ['Alice', l]),
        atom(job, ['Bob', l, 'Alice', 'Orga', num(f), num(pr), num(dl), num(tm)])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(points_to, ['Alice', 'Bob']),
        atom(knows, ['Alice', 'Orga']),
        not(atom(listed, ['Alice', l])),
        atom(identity, ['Bob']),
        not(atom(job, ['Bob', l, '_', '_', '_', '_', '_', '_'])),
        atom(identity, ['Orga']),
        atom(stake, ['Orga', num(s)]),
        atom(denomination, ['Orga', num(f)]),
        atom(coin, ['Bob', 'Orga', num(f1b)])],
       and(eq(num(stb), cardinality([], atom(coin, ['Bob', 'Orga', num(f1b)]), true)), and(eq(num(f1b), num(f)), ge(num(stb), plus(num(s), num(0))))),
       ['Alice']),
%% GNG:1: Bob, a worker, passes the job to Carol, a worker he points to.
    sas(gng_pass, ['Bob', 'Carol', 'Alice', 'Orga'], [l, f, pr, dl, tm, 'Alice', 'Orga'],
       [atom(passed, ['Bob', l, 'Carol']),
        atom(job, ['Carol', l, 'Alice', 'Orga', num(f), num(pr), num(dl), num(tm)])],
       [atom(identity, ['Bob']),
        not(atom(retired, ['Bob'])),
        atom(job, ['Bob', l, 'Alice', 'Orga', num(f), num(pr), num(dl), num(tm)]),
        atom(points_to, ['Bob', 'Carol']),
        not(atom(passed, ['Bob', l, 'Carol'])),
        atom(identity, ['Carol']),
        not(atom(job, ['Carol', l, '_', '_', '_', '_', '_', '_']))],
       true,
       ['Bob']),
%% GNG:1: Alice withdraws her job.
    sas(gng_withdraw, ['Alice'], [l],
       [atom(withdrawn, ['Alice', l])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(listed, ['Alice', l]),
        not(atom(withdrawn, ['Alice', l]))],
       true,
       ['Alice']),
%% GNG:2, Engagement: Alice and Bob jointly engage Bob for the job; Alice's payment a and Bob's deposit c, on top of his stake, are locked at Orga.
    sas(gng_engage, ['Alice', 'Bob', 'Orga'], [l, f, s, pr, dl, tm, a, c, e, z, f1b, stb],
       [not(times(num(a), atom(coin, ['Alice', 'Orga', num(f)]))),
        atom(deal, ['Alice', z, l]),
        not(times(num(c), atom(coin, ['Bob', 'Orga', num(f)]))),
        atom(deal, ['Bob', z, l]),
        times(num(a), atom(coin, ['Orga', 'Orga', num(f)])),
        times(num(c), atom(coin, ['Orga', 'Orga', num(f)])),
        atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)]),
        atom(terms, ['Orga', z, l, num(pr), num(dl), num(tm)])],
       [times(num(a), atom(coin, ['Alice', 'Orga', num(f)])),
        atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(knows, ['Alice', 'Bob']),
        atom(listed, ['Alice', l]),
        not(atom(withdrawn, ['Alice', l])),
        times(num(c), atom(coin, ['Bob', 'Orga', num(f)])),
        atom(identity, ['Bob']),
        not(atom(retired, ['Bob'])),
        atom(knows, ['Bob', 'Alice']),
        atom(job, ['Bob', l, 'Alice', 'Orga', num(f), num(pr), num(dl), num(tm)]),
        atom(identity, ['Orga']),
        atom(stake, ['Orga', num(s)]),
        atom(denomination, ['Orga', num(f)]),
        atom(coin, ['Bob', 'Orga', num(f1b)])],
       and(and(ge(num(a), num(1)), and(ge(num(c), num(1)), rel(terms_set, [num(tm), num(a), num(c), num(e)]))), and(eq(num(stb), cardinality([], atom(coin, ['Bob', 'Orga', num(f1b)]), true)), and(eq(num(f1b), num(f)), ge(num(stb), plus(num(s), num(c)))))),
       ['Alice', 'Bob']),
%% GNG:3, Delivery, attested: Bob attests that he delivered the work to Alice.
    sas(gng_deliver, ['Bob', 'Orga'], [z],
       [atom(delivered, ['Orga', z])],
       [atom(identity, ['Bob']),
        not(atom(retired, ['Bob'])),
        atom(deal, ['Bob', z, '_']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, '_', '_', '_', '_', '_']),
        not(atom(delivered, ['Orga', z]))],
       true,
       ['Bob']),
%% GNG:4, Acceptance: Alice accepts the delivered work, and the payment and the deposit are released to Bob.
    sas(gng_accept, ['Alice', 'Orga', 'Bob'], [z, 'Bob', a, c, e, x],
       [not(atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)])),
        atom(settle, ['Orga', z, 'Bob', num(x)]),
        atom(accepted, ['Orga', z])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(deal, ['Alice', z, '_']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)]),
        not(atom(disputed, ['Orga', z, '_'])),
        atom(delivered, ['Orga', z])],
       eq(num(x), plus(num(a), num(c))),
       ['Alice']),
%% GNG:4: Alice rejects the delivered work, raising a dispute to an arbiter, Carol (GNO:4).
    sas(gng_reject, ['Alice', 'Orga', 'Carol'], [z, 'Carol'],
       [atom(disputed, ['Orga', z, 'Carol'])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(deal, ['Alice', z, '_']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', '_', '_', '_', '_']),
        atom(delivered, ['Orga', z]),
        atom(officer, ['Orga', 'Carol', num(2)]),
        not(atom(disputed, ['Orga', z, '_']))],
       true,
       ['Alice']),
%% GNG:5, Cancelling: Alice cancels the engagement before delivery, released as the terms say.
    sas(gng_cancel_c, ['Alice', 'Orga', 'Bob'], [z, 'Bob', a, c, e, a1, c1, a2, c2, x1, x2],
       [not(atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)])),
        atom(settle, ['Orga', z, 'Alice', num(x1)]),
        atom(settle, ['Orga', z, 'Bob', num(x2)]),
        atom(cancelled, ['Orga', z])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(deal, ['Alice', z, '_']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)]),
        not(atom(disputed, ['Orga', z, '_'])),
        not(atom(delivered, ['Orga', z]))],
       and(eq(plus(num(a1), num(a2)), num(a)), and(eq(plus(num(c1), num(c2)), num(c)), and(eq(num(x1), plus(num(a1), num(c1))), and(eq(num(x2), plus(num(a2), num(c2))), and(ge(num(a1), num(0)), and(ge(num(a2), num(0)), and(ge(num(c1), num(0)), ge(num(c2), num(0))))))))),
       ['Alice']),
%% GNG:5: Bob cancels the engagement before delivery.
    sas(gng_cancel_p, ['Bob', 'Orga', 'Alice'], [z, 'Alice', a, c, e, a1, c1, a2, c2, x1, x2],
       [not(atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)])),
        atom(settle, ['Orga', z, 'Alice', num(x1)]),
        atom(settle, ['Orga', z, 'Bob', num(x2)]),
        atom(cancelled, ['Orga', z])],
       [atom(identity, ['Bob']),
        not(atom(retired, ['Bob'])),
        atom(deal, ['Bob', z, '_']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)]),
        not(atom(disputed, ['Orga', z, '_'])),
        not(atom(delivered, ['Orga', z]))],
       and(eq(plus(num(a1), num(a2)), num(a)), and(eq(plus(num(c1), num(c2)), num(c)), and(eq(num(x1), plus(num(a1), num(c1))), and(eq(num(x2), plus(num(a2), num(c2))), and(ge(num(a1), num(0)), and(ge(num(a2), num(0)), and(ge(num(c1), num(0)), ge(num(c2), num(0))))))))),
       ['Bob']),
%% GNG:5: if no delivery is attested by the deadline, Alice cancels and both are released to her.
    sas(gng_lapse, ['Alice', 'Orga', 'Bob'], [z, 'Bob', a, c, e, x, t, dl],
       [not(atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)])),
        atom(settle, ['Orga', z, 'Alice', num(x)]),
        atom(cancelled, ['Orga', z])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(deal, ['Alice', z, '_']),
        atom(identity, ['Orga']),
        atom(lock, ['Orga', z, 'Alice', 'Bob', num(a), num(c), num(e)]),
        not(atom(disputed, ['Orga', z, '_'])),
        not(atom(delivered, ['Orga', z])),
        atom(now, ['Alice', num(t)]),
        atom(terms, ['Orga', z, '_', '_', num(dl), '_'])],
       and(eq(num(x), plus(num(a), num(c))), gt(num(t), num(dl))),
       ['Alice']),
%% GNG:6, Review: REC:1, where Alice recommends Bob for the work, z, after acceptance.
    sas(recommend, ['Alice', 'Bob', 'Orga'], [s, z, l],
       [atom(recommended, ['Alice', 'Bob', s]),
        atom(endorsement, ['Bob', 'Alice', s])],
       [atom(identity, ['Alice']),
        not(atom(ward, ['Alice'])),
        not(atom(retired, ['Alice'])),
        atom(knows, ['Alice', 'Bob']),
        not(atom(recommended, ['Alice', 'Bob', s])),
        not(atom(withdrew, ['Alice', 'Bob', s])),
        atom(identity, ['Bob']),
        atom(deal, ['Alice', z, l]),
        atom(knows, ['Alice', 'Orga']),
        atom(deal, ['Bob', z, l]),
        atom(identity, ['Orga']),
        atom(accepted, ['Orga', z])],
       eq(s, z),
       ['Alice']),
%% REC:2, Showing: Bob shows a recommendation of him by Alice for s to Carol, whom he knows, once; Carol sees who recommended Bob and for what.
    sas(show, ['Bob', 'Carol', 'Alice'], ['Alice', s],
       [atom(shown, ['Bob', 'Carol', 'Alice', s]),
        atom(vouched, ['Carol', 'Alice', s])],
       [atom(identity, ['Bob']),
        not(atom(retired, ['Bob'])),
        atom(endorsement, ['Bob', 'Alice', s]),
        atom(knows, ['Bob', 'Carol']),
        not(atom(shown, ['Bob', 'Carol', 'Alice', s])),
        atom(identity, ['Carol'])],
       true,
       ['Bob']),
%% REC:3, Withdrawing: Alice withdraws her recommendation of Bob for s; it is gone from Bob and from everyone Bob showed it to, Carol a listed role, and Alice may not make it again.
    sas(withdraw_recommendation, ['Alice', 'Bob', 'Carol'], [s],
       [atom(withdrew, ['Alice', 'Bob', s]),
        not(atom(recommended, ['Alice', 'Bob', s])),
        not(atom(endorsement, ['Bob', 'Alice', s])),
        forall(['Carol'], atom(shown, ['Bob', 'Carol', 'Alice', s]), true, [not(atom(vouched, ['Carol', 'Alice', s]))])],
       [atom(identity, ['Alice']),
        not(atom(retired, ['Alice'])),
        atom(recommended, ['Alice', 'Bob', s]),
        atom(identity, ['Bob']),
        atom(endorsement, ['Bob', 'Alice', s]),
        forall(['Carol'], atom(shown, ['Bob', 'Carol', 'Alice', s]), true, and(atom(identity, ['Carol']), atom(vouched, ['Carol', 'Alice', s])))],
       true,
       ['Alice'])])).
