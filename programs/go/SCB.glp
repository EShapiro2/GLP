%% ---------------------------------------------------------------------------
%% SCB.glp --- SCB, the contract's speech-act schemas, GO's (Udi, 2026-11-09, to GO #3), in the clause syntax of GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint, Guards), as programs/gsc/README.md reads it; the clauses are in SCB.txt beside this file.
%% Extends GBank, instantiating its bylaws and restricting it.  The term holds every schema of what it extends, restated, the persons' schemas as GnW writes them (programs/gsc/GnW.glp), person required at a person's role.  GO instantiates GnW's parameters (GSC 745b9e3): ward at org, creator and created at themselves, guardian_of at officer_of and guarded_by at officer, each with the role, and retired at itself; the schemas are restated here until Code gives the term form of an instantiation.  An organisation guards nothing, each of its acts taken for it by its officers, by the role and the rule its bylaws name (Udi, 2026-11-10).
%% 44 schemas.  This term is the one source of the schemas; a run of the cascade prints their notation from it.  Written by GO #3 Cowork, 2026-11-10, by GO/docs/tools/gen.py; the problems found in writing them are GO/docs/schemas-problems.md.
%% Environment predicates: today.
%% Instantiates the parameter bylaws_p by the utterance bylaws_scb (GSC, Section 8).
%% ---------------------------------------------------------------------------

% contract_named(scb, C): the contract, SCB.
procedure contract_named(Constant?, SDeclared).
contract_named(scb, environment([today],
   [
%% GKK:1, Identity, adding person, as GnW writes it.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice']),
        atom(person, ['Alice'])],
       [not(atom(identity, ['Alice']))],
       true,
       ['Alice']),
%% GKK:2, Acquaintance, for two persons; the introductory act, unobstructed but for org.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(identity, ['Bob']),
        atom(person, ['Bob'])],
       true,
       ['Alice', 'Bob']),
%% GKK:3, Introduction, for persons, with Bob's consent; Carol a reading role, as GnW writes it.
    sas(introduce, ['Alice', 'Bob', 'Carol'], [],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        atom(identity, ['Carol']),
        atom(person, ['Carol'])],
       true,
       ['Alice', 'Bob']),
%% GSG:1, Friendship, for two persons.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']),
        atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        not(atom(friend, ['Bob', 'Alice']))],
       true,
       ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, by a person, but an officer with the organisation, as GnW writes it for a guardian.
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])),
        not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(friend, ['Alice', 'Bob']),
        not(atom(officer_of, ['Alice', 'Bob', '_'])),
        atom(identity, ['Bob']),
        atom(friend, ['Bob', 'Alice'])],
       true,
       ['Alice']),
%% GFP:1, Creation: an agent signs what they create, bylaws and proposals among it, and holds it as an item.
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        not(atom(item, ['Alice', x]))],
       true,
       ['Alice']),
%% SCB:1, Founding: Gov founds Orga as the sovereign of the Dollar, the denomination f, its bylaws those of a central bank, Alice its first governor, the role 1; the role 2 is committee member.  Taken for Gov by its officers (joint None).
    sas(found_by, ['Gov', 'Alice', 'Orga', 'Greta', 'Gerd'], [f, rog],
       [atom(founded, ['Gov', 'Orga']),
        atom(knows, ['Gov', 'Orga']),
        atom(created, ['Alice', 'Orga']),
        atom(officer_of, ['Alice', 'Orga', num(1)]),
        atom(participates, ['Alice', 'Orga']),
        atom(friend, ['Alice', 'Orga']),
        atom(knows, ['Alice', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(creator, ['Orga', 'Alice']),
        atom(bylaws, ['Orga', val(bylaws_scb)]),
        atom(officer, ['Orga', 'Alice', num(1)]),
        atom(participant, ['Orga', 'Alice']),
        atom(friend, ['Orga', 'Alice']),
        atom(knows, ['Orga', 'Alice']),
        atom(sovereign, ['Orga', num(f)])],
       [atom(identity, ['Gov']),
        atom(org, ['Gov']),
        atom(knows, ['Gov', 'Alice']),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Gov']),
        not(atom(identity, ['Orga'])),
        atom(identity, ['Greta']),
        atom(person, ['Greta']),
        atom(officer_of, ['Greta', 'Gov', num(rog)]),
        atom(officer, ['Gov', 'Greta', num(rog)]),
        forall(['Gerd', rqg], atom(officer, ['Gov', 'Gerd', num(rqg)]), and(ne('Gerd', 'Greta'), ne('Gerd', 'Alice')), and(atom(identity, ['Gerd']), and(atom(person, ['Gerd']), atom(officer_of, ['Gerd', 'Gov', num(rqg)]))))],
       true,
       ['Alice', 'Greta', 'Gerd']),
%% GnW:3, Ward and person: Orga and Bob come to know each other by an act of both; a relay act with a ward role and a free role.  Taken for Orga by its officers (joint 1).
    sas(org_acquaint, ['Orga', 'Bob', 'Otto', 'Olga'], [],
       [atom(knows, ['Orga', 'Bob']),
        atom(knows, ['Bob', 'Orga'])],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), and(ne('Olga', 'Otto'), ne('Olga', 'Bob')), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       true,
       ['Bob', 'Otto', 'Olga']),
%% GnW:4, Ward and ward: two organisations come to know each other by an act of both; a relay act with two ward roles.  Taken for Orga by its officers (joint 1).  Taken for Orgb by its officers (joint None).
    sas(orgs_acquaint, ['Orga', 'Orgb', 'Otto', 'Olga', 'Bruno', 'Berta'], [rob],
       [atom(knows, ['Orga', 'Orgb']),
        atom(knows, ['Orgb', 'Orga'])],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Orgb']),
        atom(org, ['Orgb']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), ne('Olga', 'Otto'), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(1)])))),
        atom(identity, ['Bruno']),
        atom(person, ['Bruno']),
        atom(officer_of, ['Bruno', 'Orgb', num(rob)]),
        atom(officer, ['Orgb', 'Bruno', num(rob)]),
        forall(['Berta', rqb], atom(officer, ['Orgb', 'Berta', num(rqb)]), and(ne('Berta', 'Bruno'), ne('Berta', 'Otto')), and(atom(identity, ['Berta']), and(atom(person, ['Berta']), atom(officer_of, ['Berta', 'Orgb', num(rqb)]))))],
       true,
       ['Otto', 'Olga', 'Bruno', 'Berta']),
%% GnW:5, Retiring, as GO's paper revises it: the officers of Orga, its guardians (GO:4), every one of them a guard, retire Orga jointly; retired is a record, and Orga, with no officer, takes no act.  Taken for Orga by its officers (joint None).
    sas(retire, ['Orga', 'Dave', 'Otto', 'Olga'], [roa],
       [atom(retired, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, [not(atom(officer_of, ['Dave', 'Orga', num(r)]))])],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, and(atom(identity, ['Dave']), atom(officer_of, ['Dave', 'Orga', num(r)]))),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        forall(['Olga', rqa], atom(officer, ['Orga', 'Olga', num(rqa)]), ne('Olga', 'Otto'), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(rqa)]))))],
       true,
       ['Otto', 'Olga']),
%% GO:2: an officer, Bob, proposes an act of Orga, which the item x describes.
    sas(propose, ['Bob', 'Orga'], [x, r],
       [atom(proposal, ['Orga', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(item, ['Bob', x]),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        not(atom(proposal, ['Orga', x]))],
       eq(author_of(x), 'Bob'),
       ['Bob']),
%% GO:2: an officer, Bob, votes for the proposed act x.
    sas(vote, ['Bob', 'Orga'], [x, r],
       [atom(voted, ['Bob', 'Orga', x]),
        atom(vote, ['Orga', 'Bob', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        not(atom(voted, ['Bob', 'Orga', x])),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(proposal, ['Orga', x])],
       true,
       ['Bob']),
%% GO:3, Participation: Bob becomes a participant of Orga by an act of Bob and Orga.  Taken for Orga by its officers (joint 1).
    sas(join, ['Bob', 'Orga', 'Otto', 'Olga'], [],
       [atom(participates, ['Bob', 'Orga']),
        atom(participant, ['Orga', 'Bob'])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(participates, ['Bob', 'Orga'])),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(knows, ['Orga', 'Bob']),
        not(atom(participant, ['Orga', 'Bob'])),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), and(ne('Olga', 'Otto'), ne('Olga', 'Bob')), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       true,
       ['Bob', 'Otto', 'Olga']),
%% SCB:2, Counterparties: Bob ceases to be a counterparty by an act of Bob and the governors, an act of Orga (GO:2).  Taken for Orga by its officers (joint 1).
    sas(leave, ['Bob', 'Orga', 'Otto', 'Olga'], [],
       [not(atom(participates, ['Bob', 'Orga'])),
        not(atom(participant, ['Orga', 'Bob'])),
        not(atom(officer_of, ['Bob', 'Orga', '_'])),
        not(atom(officer, ['Orga', 'Bob', '_']))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participant, ['Orga', 'Bob']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), and(ne('Olga', 'Otto'), ne('Olga', 'Bob')), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       true,
       ['Bob', 'Otto', 'Olga']),
%% SCB:3, Officers: the officers of Gov decide the appointment of a governor or a committee member.  Taken for Gov by its officers (joint None).
    sas(appoint, ['Orga', 'Bob', 'Gov', 'Greta', 'Gerd'], [r, rog],
       [atom(officer, ['Orga', 'Bob', num(r)]),
        atom(officer_of, ['Bob', 'Orga', num(r)])],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(officer, ['Orga', 'Bob', num(r)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Gov']),
        atom(org, ['Gov']),
        atom(founded, ['Gov', 'Orga']),
        atom(identity, ['Greta']),
        atom(person, ['Greta']),
        atom(officer_of, ['Greta', 'Gov', num(rog)]),
        atom(officer, ['Gov', 'Greta', num(rog)]),
        forall(['Gerd', rqg], atom(officer, ['Gov', 'Gerd', num(rqg)]), and(ne('Gerd', 'Greta'), ne('Gerd', 'Bob')), and(atom(identity, ['Gerd']), and(atom(person, ['Gerd']), atom(officer_of, ['Gerd', 'Gov', num(rqg)]))))],
       true,
       ['Bob', 'Greta', 'Gerd']),
%% SCB:3, Officers: the officers of Gov decide the removal of a governor or a committee member.  Taken for Gov by its officers (joint None).
    sas(dismiss, ['Orga', 'Bob', 'Gov', 'Greta', 'Gerd'], [r, rog],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(identity, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Gov']),
        atom(org, ['Gov']),
        atom(founded, ['Gov', 'Orga']),
        atom(identity, ['Greta']),
        atom(person, ['Greta']),
        atom(officer_of, ['Greta', 'Gov', num(rog)]),
        atom(officer, ['Gov', 'Greta', num(rog)]),
        forall(['Gerd', rqg], atom(officer, ['Gov', 'Gerd', num(rqg)]), and(ne('Gerd', 'Greta'), ne('Gerd', 'Bob')), and(atom(identity, ['Gerd']), and(atom(person, ['Gerd']), atom(officer_of, ['Gerd', 'Gov', num(rqg)]))))],
       true,
       ['Greta', 'Gerd']),
%% GO:4: Bob removes himself from the role r.
    sas(resign_role, ['Bob', 'Orga'], [r],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)]))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)])],
       true,
       ['Bob']),
%% GO:5, Amendment: Orga replaces its bylaws b by b1.  Taken for Orga by its officers (joint 1).
    sas(amend, ['Orga', 'Otto', 'Olga'], [b, b1],
       [not(atom(bylaws, ['Orga', b])),
        atom(bylaws, ['Orga', b1])],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(bylaws, ['Orga', b]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), ne('Olga', 'Otto'), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       true,
       ['Otto', 'Olga']),
%% DGC:1, Minting: Alice issues k of her coins of the denomination f.
    sas(mint_coin, ['Alice'], [f, k],
       [times(num(k), atom(coin, ['Alice', 'Alice', num(f)]))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice'])],
       true,
       ['Alice']),
%% DGC:1: Alice issues k of her bonds of the denomination f and the maturity d, later than her date t.
    sas(mint_bond, ['Alice'], [f, d, k, t],
       [times(num(k), atom(bond, ['Alice', 'Alice', num(f), num(d)]))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(date, ['Alice', num(t)])],
       gt(num(d), num(t)),
       ['Alice']),
%% DGC:2, Date: an act no one wills, which keeps the date at the current date.
    sas(first_date, ['Alice'], [d],
       [atom(date, ['Alice', num(d)]),
        atom(dated, ['Alice'])],
       [atom(identity, ['Alice']),
        atom(today, ['Alice', num(d)]),
        not(atom(dated, ['Alice']))],
       true,
       []),
%% DGC:2.
    sas(advance, ['Alice'], [t, t1, d],
       [atom(date, ['Alice', num(t1)]),
        not(atom(date, ['Alice', num(t)]))],
       [atom(identity, ['Alice']),
        atom(today, ['Alice', num(d)]),
        atom(date, ['Alice', num(t)])],
       and(succ(num(t), num(t1)), le(num(t1), num(d))),
       []),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated coins for k1 coins; each comes to know the issuer of what they receive.
    sas(swap_cc, ['Alice', 'Bob', u, v], [f, u, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v, num(f)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u, num(f)]))),
        times(num(k), atom(coin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v, num(f)])))],
       [times(num(k), atom(coin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v, num(f)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated coins for k1 bonds; each comes to know the issuer of what they receive.
    sas(swap_cb, ['Alice', 'Bob', u, v], [f, u, k, v, d1, k1],
       [times(num(k1), atom(bond, ['Alice', v, num(f), num(d1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u, num(f)]))),
        times(num(k), atom(coin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])))],
       [times(num(k), atom(coin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated bonds for k1 coins; each comes to know the issuer of what they receive.
    sas(swap_bc, ['Alice', 'Bob', u, v], [f, u, d, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v, num(f)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(bond, ['Alice', u, num(f), num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(f), num(d)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v, num(f)])))],
       [times(num(k), atom(bond, ['Alice', u, num(f), num(d)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v, num(f)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:3, Swap: Alice and Bob swap k Dollar-denominated bonds for k1 bonds; each comes to know the issuer of what they receive.
    sas(swap_bb, ['Alice', 'Bob', u, v], [f, u, d, k, v, d1, k1],
       [times(num(k1), atom(bond, ['Alice', v, num(f), num(d1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(bond, ['Alice', u, num(f), num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(f), num(d)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])))],
       [times(num(k), atom(bond, ['Alice', u, num(f), num(d)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(bond, ['Bob', v, num(f), num(d1)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
%% DGC:4, Acceptance: Alice accepts l u-coins, holding a u-coin.
    sas(accept_c, ['Alice', u], [f, u, l],
       [times(num(l), atom(accepts, ['Alice', u, num(f)]))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(coin, ['Alice', u, num(f)])],
       true,
       ['Alice']),
%% DGC:4: Alice accepts l u-coins, holding a u-bond.
    sas(accept_b, ['Alice', u], [f, u, d, l],
       [times(num(l), atom(accepts, ['Alice', u, num(f)]))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(bond, ['Alice', u, num(f), num(d)])],
       true,
       ['Alice']),
%% DGC:5, Payment: Alice pays Bob k Bob-coins, which Bob accepts as his own.
    sas(pay, ['Alice', 'Bob'], [f, k],
       [not(times(num(k), atom(coin, ['Alice', 'Bob', num(f)]))),
        times(num(k), atom(coin, ['Bob', 'Bob', num(f)]))],
       [times(num(k), atom(coin, ['Alice', 'Bob', num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% DGC:5: Alice pays Bob k Alice-coins, which Bob accepts.
    sas(payout, ['Alice', 'Bob'], [f, k],
       [not(times(num(k), atom(coin, ['Alice', 'Alice', num(f)]))),
        times(num(k), atom(coin, ['Bob', 'Alice', num(f)])),
        not(times(num(k), atom(accepts, ['Bob', 'Alice', num(f)])))],
       [times(num(k), atom(coin, ['Alice', 'Alice', num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k), atom(accepts, ['Bob', 'Alice', num(f)])),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% DGC:5: Alice pays Bob k Carol-coins, which Bob accepts.
    sas(spend, ['Alice', 'Bob', 'Carol'], [f, k],
       [not(times(num(k), atom(coin, ['Alice', 'Carol', num(f)]))),
        times(num(k), atom(coin, ['Bob', 'Carol', num(f)])),
        not(times(num(k), atom(accepts, ['Bob', 'Carol', num(f)])))],
       [times(num(k), atom(coin, ['Alice', 'Carol', num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        times(num(k), atom(accepts, ['Bob', 'Carol', num(f)])),
        atom(identity, ['Bob']),
        atom(identity, ['Carol'])],
       true,
       ['Alice']),
%% DGC:6, Redemption: Alice redeems a Bob-coin she holds against an r-coin Bob holds.
    sas(redeem_cc, ['Alice', 'Bob', r], [f, r],
       [atom(coin, ['Alice', r, num(f)]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob', num(f)])),
        atom(coin, ['Bob', 'Bob', num(f)]),
        not(atom(coin, ['Bob', r, num(f)]))],
       [atom(coin, ['Alice', 'Bob', num(f)]),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r, num(f)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% DGC:6, Redemption: Alice redeems a Bob-coin she holds against an r-bond Bob holds.
    sas(redeem_cb, ['Alice', 'Bob', r], [f, r, d1],
       [atom(bond, ['Alice', r, num(f), num(d1)]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob', num(f)])),
        atom(coin, ['Bob', 'Bob', num(f)]),
        not(atom(bond, ['Bob', r, num(f), num(d1)]))],
       [atom(coin, ['Alice', 'Bob', num(f)]),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(bond, ['Bob', r, num(f), num(d1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% DGC:6, Redemption: Alice redeems a Bob-bond, matured she holds against an r-coin Bob holds.
    sas(redeem_bc, ['Alice', 'Bob', r], [f, d, r, t],
       [atom(coin, ['Alice', r, num(f)]),
        atom(knows, ['Alice', r]),
        not(atom(bond, ['Alice', 'Bob', num(f), num(d)])),
        atom(bond, ['Bob', 'Bob', num(f), num(d)]),
        not(atom(coin, ['Bob', r, num(f)]))],
       [atom(bond, ['Alice', 'Bob', num(f), num(d)]),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r, num(f)]),
        atom(identity, ['Bob']),
        atom(date, ['Bob', num(t)])],
       le(num(d), num(t)),
       ['Alice']),
%% DGC:6, Redemption: Alice redeems a Bob-bond, matured she holds against an r-bond Bob holds.
    sas(redeem_bb, ['Alice', 'Bob', r], [f, d, r, d1, t],
       [atom(bond, ['Alice', r, num(f), num(d1)]),
        atom(knows, ['Alice', r]),
        not(atom(bond, ['Alice', 'Bob', num(f), num(d)])),
        atom(bond, ['Bob', 'Bob', num(f), num(d)]),
        not(atom(bond, ['Bob', r, num(f), num(d1)]))],
       [atom(bond, ['Alice', 'Bob', num(f), num(d)]),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(bond, ['Bob', r, num(f), num(d1)]),
        atom(identity, ['Bob']),
        atom(date, ['Bob', num(t)])],
       le(num(d), num(t)),
       ['Alice']),
%% DGC:9, Escrow: Alice deposits k u-coins with Carol.
    sas(deposit_c, ['Alice', 'Carol', u], [f, u, k],
       [not(times(num(k), atom(coin, ['Alice', u, num(f)]))),
        times(num(k), atom(coin, ['Carol', u, num(f)])),
        atom(knows, ['Carol', u])],
       [times(num(k), atom(coin, ['Alice', u, num(f)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Carol']),
        atom(person, ['Carol']),
        atom(knows, ['Carol', 'Alice'])],
       true,
       ['Alice', 'Carol']),
%% DGC:9, Escrow: Alice deposits k u-bonds with Carol.
    sas(deposit_b, ['Alice', 'Carol', u], [f, u, d, k],
       [not(times(num(k), atom(bond, ['Alice', u, num(f), num(d)]))),
        times(num(k), atom(bond, ['Carol', u, num(f), num(d)])),
        atom(knows, ['Carol', u])],
       [times(num(k), atom(bond, ['Alice', u, num(f), num(d)])),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Carol']),
        atom(person, ['Carol']),
        atom(knows, ['Carol', 'Alice'])],
       true,
       ['Alice', 'Carol']),
%% DGC:9: Carol and Bob release k u-coins to Bob.
    sas(release_c, ['Carol', 'Bob', u], [f, u, k],
       [not(times(num(k), atom(coin, ['Carol', u, num(f)]))),
        times(num(k), atom(coin, ['Bob', u, num(f)])),
        atom(knows, ['Bob', u])],
       [times(num(k), atom(coin, ['Carol', u, num(f)])),
        atom(identity, ['Carol']),
        atom(person, ['Carol']),
        atom(knows, ['Carol', 'Bob']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Carol'])],
       true,
       ['Carol', 'Bob']),
%% DGC:9: Carol and Bob release k u-bonds to Bob.
    sas(release_b, ['Carol', 'Bob', u], [f, u, d, k],
       [not(times(num(k), atom(bond, ['Carol', u, num(f), num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(f), num(d)])),
        atom(knows, ['Bob', u])],
       [times(num(k), atom(bond, ['Carol', u, num(f), num(d)])),
        atom(identity, ['Carol']),
        atom(person, ['Carol']),
        atom(knows, ['Carol', 'Bob']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Carol'])],
       true,
       ['Carol', 'Bob']),
%% DGC:9: Carol and Alice return k u-coins to Alice.
    sas(return_c, ['Carol', 'Alice', u], [f, u, k],
       [not(times(num(k), atom(coin, ['Carol', u, num(f)]))),
        times(num(k), atom(coin, ['Alice', u, num(f)])),
        atom(knows, ['Alice', u])],
       [times(num(k), atom(coin, ['Carol', u, num(f)])),
        atom(identity, ['Carol']),
        atom(person, ['Carol']),
        atom(knows, ['Carol', 'Alice']),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Carol'])],
       true,
       ['Carol', 'Alice']),
%% DGC:9: Carol and Alice return k u-bonds to Alice.
    sas(return_b, ['Carol', 'Alice', u], [f, u, d, k],
       [not(times(num(k), atom(bond, ['Carol', u, num(f), num(d)]))),
        times(num(k), atom(bond, ['Alice', u, num(f), num(d)])),
        atom(knows, ['Alice', u])],
       [times(num(k), atom(bond, ['Carol', u, num(f), num(d)])),
        atom(identity, ['Carol']),
        atom(person, ['Carol']),
        atom(knows, ['Carol', 'Alice']),
        atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Carol'])],
       true,
       ['Carol', 'Alice']),
%% SCB:4, Policy rate: the committee members set the policy rate rho for the term d, by a majority, an act of Orga (GO:2).  Taken for Orga by its officers (majority 2).
    sas(scb_rate, ['Orga', 'Otto', v1a, v2a], [d, rho, xpa, via, vna],
       [not(atom(rate, ['Orga', num(d), '_'])),
        atom(rate, ['Orga', num(d), real(rho)]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa])),
        not(atom(motion_scb_rate, ['Orga', xpa, num(d), real(rho)]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(2)]),
        atom(officer, ['Orga', 'Otto', num(2)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_scb_rate, ['Orga', xpa, num(d), real(rho)])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(2)]), true)), gt(mul(num(2), num(via)), num(vna)))),
       ['Otto']),
%% SCB:5, Lending: Bob, a counterparty, and Orga swap k Orga-coins, which Orga issues, for j Bob-bonds of the term e, as many bonds as the coins and the interest on them at the policy rate rho for that term.  Taken for Orga by its officers (joint 1).
    sas(scb_lend, ['Bob', 'Orga', 'Otto', 'Olga'], [f, k, d, j, t, e, rho],
       [times(num(k), atom(coin, ['Bob', 'Orga', num(f)])),
        times(num(j), atom(bond, ['Orga', 'Bob', num(f), num(d)]))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(date, ['Bob', num(t)]),
        atom(knows, ['Bob', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(officer, ['Orga', 'Bob', '_'])),
        atom(sovereign, ['Orga', num(f)]),
        atom(rate, ['Orga', num(e), real(rho)]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        forall(['Olga'], atom(officer, ['Orga', 'Olga', num(1)]), and(ne('Olga', 'Otto'), ne('Olga', 'Bob')), and(atom(identity, ['Olga']), and(atom(person, ['Olga']), atom(officer_of, ['Olga', 'Orga', num(1)]))))],
       and(eq(num(d), plus(num(t), num(e))), eq(num(j), mul(num(k), plus(num(1), real(rho))))),
       ['Bob', 'Otto', 'Olga']),
%% GO:2: an officer proposes the act scb_rate of Orga, with what it names, as the motion xpa.
    sas(propose_scb_rate, ['Otto', 'Orga'], [d, rho, xpa],
       [atom(proposal, ['Orga', xpa]),
        atom(motion_scb_rate, ['Orga', xpa, num(d), real(rho)])],
       [atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(2)]),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Otto', num(2)]),
        not(atom(proposal, ['Orga', xpa]))],
       true,
       ['Otto'])])).
