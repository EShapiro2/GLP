       ['Otto']),
%% GO:2: an officer moves the act scb_lend of Orga, with what it names, as the motion xpa.
    sas(move_scb_lend, ['Otto', 'Orga', 'Bob'], ['Bob', f, k, t, e, rho, xpa],
       [atom(proposal, ['Orga', xpa]),
        atom(motion_scb_lend, ['Orga', xpa, 'Bob', num(f), num(k), num(t), num(e), real(rho)])],
       [atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(knows, ['Otto', 'Bob']),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Otto', num(1)]),
        not(atom(proposal, ['Orga', xpa]))],
       true,
       ['Otto'])])).
