%% ---------------------------------------------------------------------------
%% LWGA.glp --- LWGA, the speech-act schemas, written by tools/lwg from the bylaws drawn from: Amutot Law, 5740-1980, First Schedule.
%% Instantiates GCoop (programs/go) and restricts it; the schemas of GCoop are produced by the generator of the organisations paper, called as a library, and the decision rules by tools/lwg/lwg/rules.py.
%% 60 schemas.
%% Environment predicates: today.
%% Instantiates the parameter bylaws_p by the utterance bylaws_lwga.
%% ---------------------------------------------------------------------------

% contract_named(lwga, C): the contract, LWGA.
procedure contract_named(Constant?, SDeclared).
contract_named(lwga, environment([today],
   [
%% GKK:1, Identity, adding person, as GnW writes it.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice']),
        atom(person, ['Alice'])],
       [not(atom(identity, ['Alice']))],
       true,
       ['Alice']),
%% GKK:2, Acquaintance, for two persons; the introductory act, unobstructed but for org.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(identity, ['Bob']),
        atom(person, ['Bob'])],
       true,
       ['Alice', 'Bob']),
%% GKK:3, Introduction, for persons, with Bob's consent; Carol a reading role, as GnW writes it.
    sas(introduce, ['Alice', 'Bob', 'Carol'], [],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        atom(identity, ['Carol']),
        atom(person, ['Carol'])],
       true,
       ['Alice', 'Bob']),
%% GSG:1, Friendship, for two persons.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']),
        atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Alice']),
        not(atom(friend, ['Bob', 'Alice']))],
       true,
       ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, by a person, but an officer with the organisation, as GnW writes it for a guardian.
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])),
        not(atom(friend, ['Bob', 'Alice']))],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        atom(friend, ['Alice', 'Bob']),
        not(atom(officer_of, ['Alice', 'Bob', '_'])),
        atom(identity, ['Bob']),
        atom(friend, ['Bob', 'Alice'])],
       true,
       ['Alice']),
%% GFP:1, Creation: an agent signs what they create, bylaws and proposals among it, and holds it as an item.
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        not(atom(item, ['Alice', x]))],
       true,
       ['Alice']),
%% GCoop:1, Founding: Alice founds Orga, its bylaws those of a cooperative, the members deciding by a majority of the members, and becomes its first member, the role 1; the role 2 is board member.  Guarded by Orga too: a ward is founded by its first guardian, who makes the ward's founding will on behalf of the ward (GSC 689b6f0); Orga's guarding role forbids identity and requires no mark.
    sas(found, ['Alice', 'Orga'], [],
       [atom(created, ['Alice', 'Orga']),
        atom(officer_of, ['Alice', 'Orga', num(1)]),
        atom(participates, ['Alice', 'Orga']),
        atom(friend, ['Alice', 'Orga']),
        atom(knows, ['Alice', 'Orga']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(creator, ['Orga', 'Alice']),
        atom(bylaws, ['Orga', val(bylaws_lwga)]),
        atom(officer, ['Orga', 'Alice', num(1)]),
        atom(participant, ['Orga', 'Alice']),
        atom(friend, ['Orga', 'Alice']),
        atom(knows, ['Orga', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']),
        not(atom(identity, ['Orga']))],
       true,
       ['Alice', 'Orga']),
%% GnW:3, Ward and person: Orga and Bob come to know each other by an act of both; a relay act with a ward role and a free role.  Decided by: more than half of the votes cast are for, and at least a quarter of the holder of role 1s voted, and the motion was moved at least 10 days before.
    sas(org_acquaint, ['Orga', 'Bob', 'Otto', v1a, v2a, v3a], [xpa, via, vna, mda, tda, nia],
       [atom(knows, ['Orga', 'Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_org_acquaint, ['Orga', xpa, 'Bob'])),
        not(atom(moved_on, ['Orga', xpa, num(mda)])),
        not(atom(nay, ['Orga', '_', xpa, '_']))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_org_acquaint, ['Orga', xpa, 'Bob']),
        atom(moved_on, ['Orga', xpa, num(mda)]),
        atom(today, ['Orga', num(tda)])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), and(gt(mul(num(2), num(via)), mul(num(1), plus(num(via), num(nia)))), and(eq(num(nia), cardinality([v3a], atom(nay, ['Orga', v3a, xpa, num(1)]), true)), and(ge(mul(num(4), plus(num(via), num(nia))), mul(num(1), num(vna))), ge(num(tda), plus(num(mda), num(10)))))))),
       ['Otto', 'Bob']),
%% GnW:4, Ward and ward: two organisations come to know each other by an act of both; a relay act with two ward roles.  Decided by: more than half of the votes cast are for, and at least a quarter of the holder of role 1s voted, and the motion was moved at least 10 days before.  Taken for Orgb by its officers (all None).
    sas(orgs_acquaint, ['Orga', 'Orgb', 'Otto', v1a, v2a, v3a, 'Bruno', v1b, v2b], [xpa, via, vna, mda, tda, nia, rob, xpb, vib, vnb],
       [atom(knows, ['Orga', 'Orgb']),
        atom(knows, ['Orgb', 'Orga']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_orgs_acquaint, ['Orga', xpa, 'Orgb'])),
        not(atom(moved_on, ['Orga', xpa, num(mda)])),
        not(atom(nay, ['Orga', '_', xpa, '_'])),
        not(atom(proposal, ['Orgb', xpb])),
        not(atom(vote, ['Orgb', '_', xpb, '_'])),
        not(atom(motion_orgs_acquaint, ['Orgb', xpb, 'Orga', 'Otto', num(mda), num(tda)]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(identity, ['Orgb']),
        atom(org, ['Orgb']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_orgs_acquaint, ['Orga', xpa, 'Orgb']),
        atom(moved_on, ['Orga', xpa, num(mda)]),
        atom(today, ['Orga', num(tda)]),
        atom(identity, ['Bruno']),
        atom(person, ['Bruno']),
        atom(officer_of, ['Bruno', 'Orgb', num(rob)]),
        atom(officer, ['Orgb', 'Bruno', num(rob)]),
        atom(proposal, ['Orgb', xpb]),
        atom(motion_orgs_acquaint, ['Orgb', xpb, 'Orga', 'Otto', num(mda), num(tda)])],
       and(and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), and(gt(mul(num(2), num(via)), mul(num(1), plus(num(via), num(nia)))), and(eq(num(nia), cardinality([v3a], atom(nay, ['Orga', v3a, xpa, num(1)]), true)), and(ge(mul(num(4), plus(num(via), num(nia))), mul(num(1), num(vna))), ge(num(tda), plus(num(mda), num(10)))))))), and(eq(num(vib), cardinality([v1b, rvb], atom(vote, ['Orgb', v1b, xpb, num(rvb)]), true)), and(eq(num(vnb), cardinality([v2b, rqb], atom(officer, ['Orgb', v2b, num(rqb)]), true)), eq(num(vib), num(vnb))))),
       ['Otto', 'Bruno']),
%% GnW:5, Retiring, as GO's paper revises it: the officers of Orga, its guardians (GO:4), every one of them a guard, retire Orga jointly; retired is a record, and Orga, with no officer, takes no act.  Taken for Orga by its officers (all None).
    sas(retire, ['Orga', 'Dave', 'Otto', v1a, v2a], [roa, xpa, via, vna],
       [atom(retired, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, [not(atom(officer_of, ['Dave', 'Orga', num(r)]))]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_retire, ['Orga', xpa]))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        forall(['Dave', r], atom(officer, ['Orga', 'Dave', num(r)]), true, and(atom(identity, ['Dave']), atom(officer_of, ['Dave', 'Orga', num(r)]))),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(roa)]),
        atom(officer, ['Orga', 'Otto', num(roa)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_retire, ['Orga', xpa])],
       and(eq(num(via), cardinality([v1a, rva], atom(vote, ['Orga', v1a, xpa, num(rva)]), true)), and(eq(num(vna), cardinality([v2a, rqa], atom(officer, ['Orga', v2a, num(rqa)]), true)), eq(num(via), num(vna)))),
       ['Otto']),
%% GO:2: an officer, Bob, proposes an act of Orga, which the item x describes.
    sas(propose, ['Bob', 'Orga'], [x, r],
       [atom(proposal, ['Orga', x])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(item, ['Bob', x]),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        not(atom(proposal, ['Orga', x]))],
       eq(author_of(x), 'Bob'),
       ['Bob']),
%% GO:2: an officer, Bob, votes for the proposed act x, once for each role he holds.
    sas(vote, ['Bob', 'Orga'], [x, r],
       [atom(voted, ['Bob', 'Orga', x, num(r)]),
        atom(vote, ['Orga', 'Bob', x, num(r)])],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        not(atom(voted, ['Bob', 'Orga', x, num(r)])),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(proposal, ['Orga', x])],
       true,
       ['Bob']),
%% GO:3, Participation: Bob becomes a participant of Orga by an act of Bob and Orga.  Decided by: more than half of the votes cast are for, and at least a quarter of the holder of role 1s voted, and the motion was moved at least 10 days before.
    sas(join, ['Bob', 'Orga', 'Otto', v1a, v2a, v3a], [xpa, via, vna, mda, tda, nia],
       [atom(participates, ['Bob', 'Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_join, ['Orga', xpa, 'Bob'])),
        not(atom(moved_on, ['Orga', xpa, num(mda)])),
        not(atom(nay, ['Orga', '_', xpa, '_']))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(knows, ['Bob', 'Orga']),
        not(atom(participates, ['Bob', 'Orga'])),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(knows, ['Orga', 'Bob']),
        not(atom(participant, ['Orga', 'Bob'])),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_join, ['Orga', xpa, 'Bob']),
        atom(moved_on, ['Orga', xpa, num(mda)]),
        atom(today, ['Orga', num(tda)])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), and(gt(mul(num(2), num(via)), mul(num(1), plus(num(via), num(nia)))), and(eq(num(nia), cardinality([v3a], atom(nay, ['Orga', v3a, xpa, num(1)]), true)), and(ge(mul(num(4), plus(num(via), num(nia))), mul(num(1), num(vna))), ge(num(tda), plus(num(mda), num(10)))))))),
       ['Bob', 'Otto']),
%% GCoop:2, Membership: Bob ends his membership by his own act.
    sas(leave, ['Bob', 'Orga'], [],
       [not(atom(participates, ['Bob', 'Orga'])),
        not(atom(participant, ['Orga', 'Bob'])),
        not(atom(officer, ['Orga', 'Bob', '_'])),
        not(atom(officer_of, ['Bob', 'Orga', '_']))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(identity, ['Orga']),
        atom(participates, ['Bob', 'Orga']),
        atom(officer_of, ['Bob', 'Orga', num(1)]),
        atom(participant, ['Orga', 'Bob']),
        atom(officer, ['Orga', 'Bob', num(1)])],
       true,
       ['Bob']),
%% GCoop:2: the other members end Bob's membership, an act of Orga (GO:2).  Decided by: more than half of the votes cast are for, and at least a quarter of the holder of role 1s voted, and the motion was moved at least 10 days before.
    sas(expel, ['Orga', 'Bob', 'Otto', v1a, v2a, v3a], [xpa, via, vna, mda, tda, nia],
       [not(atom(participates, ['Bob', 'Orga'])),
        not(atom(participant, ['Orga', 'Bob'])),
        not(atom(officer, ['Orga', 'Bob', '_'])),
        not(atom(officer_of, ['Bob', 'Orga', '_'])),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_expel, ['Orga', xpa, 'Bob'])),
        not(atom(moved_on, ['Orga', xpa, num(mda)])),
        not(atom(nay, ['Orga', '_', xpa, '_']))],
       [atom(identity, ['Bob']),
        atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participates, ['Bob', 'Orga']),
        atom(officer_of, ['Bob', 'Orga', num(1)]),
        atom(participant, ['Orga', 'Bob']),
        atom(officer, ['Orga', 'Bob', num(1)]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_expel, ['Orga', xpa, 'Bob']),
        atom(moved_on, ['Orga', xpa, num(mda)]),
        atom(today, ['Orga', num(tda)])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), and(gt(mul(num(2), num(via)), mul(num(1), plus(num(via), num(nia)))), and(eq(num(nia), cardinality([v3a], atom(nay, ['Orga', v3a, xpa, num(1)]), true)), and(ge(mul(num(4), plus(num(via), num(nia))), mul(num(1), num(vna))), ge(num(tda), plus(num(mda), num(10)))))))),
       ['Otto']),
%% GO:4, Officers: a participant, Bob, is appointed to the role r by an act of Orga and Bob, and is a guardian of Orga while he holds a role.  Decided by: more than half of the votes cast are for, and at least a quarter of the holder of role 1s voted, and the motion was moved at least 10 days before.
    sas(appoint, ['Orga', 'Bob', 'Otto', v1a, v2a, v3a], [r, xpa, via, vna, mda, tda, nia],
       [atom(officer, ['Orga', 'Bob', num(r)]),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_appoint, ['Orga', xpa, 'Bob', num(r)])),
        not(atom(moved_on, ['Orga', xpa, num(mda)])),
        not(atom(nay, ['Orga', '_', xpa, '_']))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(participant, ['Orga', 'Bob']),
        not(atom(officer, ['Orga', 'Bob', num(r)])),
        atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(participates, ['Bob', 'Orga']),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_appoint, ['Orga', xpa, 'Bob', num(r)]),
        atom(moved_on, ['Orga', xpa, num(mda)]),
        atom(today, ['Orga', num(tda)])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), and(gt(mul(num(2), num(via)), mul(num(1), plus(num(via), num(nia)))), and(eq(num(nia), cardinality([v3a], atom(nay, ['Orga', v3a, xpa, num(1)]), true)), and(ge(mul(num(4), plus(num(via), num(nia))), mul(num(1), num(vna))), ge(num(tda), plus(num(mda), num(10)))))))),
       ['Otto', 'Bob']),
%% GO:4: Orga removes Bob from the role r.  Decided by: more than half of the votes cast are for, and at least a quarter of the holder of role 1s voted, and the motion was moved at least 10 days before.
    sas(dismiss, ['Orga', 'Bob', 'Otto', v1a, v2a, v3a], [r, xpa, via, vna, mda, tda, nia],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)])),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_dismiss, ['Orga', xpa, 'Bob', num(r)])),
        not(atom(moved_on, ['Orga', xpa, num(mda)])),
        not(atom(nay, ['Orga', '_', xpa, '_']))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)]),
        atom(identity, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_dismiss, ['Orga', xpa, 'Bob', num(r)]),
        atom(moved_on, ['Orga', xpa, num(mda)]),
        atom(today, ['Orga', num(tda)])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), and(gt(mul(num(2), num(via)), mul(num(1), plus(num(via), num(nia)))), and(eq(num(nia), cardinality([v3a], atom(nay, ['Orga', v3a, xpa, num(1)]), true)), and(ge(mul(num(4), plus(num(via), num(nia))), mul(num(1), num(vna))), ge(num(tda), plus(num(mda), num(10)))))))),
       ['Otto']),
%% GO:4: Bob removes himself from the role r.
    sas(resign_role, ['Bob', 'Orga'], [r],
       [not(atom(officer, ['Orga', 'Bob', num(r)])),
        not(atom(officer_of, ['Bob', 'Orga', num(r)]))],
       [atom(identity, ['Bob']),
        atom(person, ['Bob']),
        atom(officer_of, ['Bob', 'Orga', num(r)]),
        atom(identity, ['Orga']),
        atom(officer, ['Orga', 'Bob', num(r)])],
       true,
       ['Bob']),
%% GO:5, Amendment: Orga replaces its bylaws b by b1.  Decided by: more than half of the votes cast are for, and at least a quarter of the holder of role 1s voted, and the motion was moved at least 10 days before.
    sas(amend, ['Orga', 'Otto', v1a, v2a, v3a], [b, b1, xpa, via, vna, mda, tda, nia],
       [not(atom(bylaws, ['Orga', b])),
        atom(bylaws, ['Orga', b1]),
        not(atom(proposal, ['Orga', xpa])),
        not(atom(vote, ['Orga', '_', xpa, '_'])),
        not(atom(motion_amend, ['Orga', xpa, b, b1])),
        not(atom(moved_on, ['Orga', xpa, num(mda)])),
        not(atom(nay, ['Orga', '_', xpa, '_']))],
       [atom(identity, ['Orga']),
        atom(org, ['Orga']),
        atom(bylaws, ['Orga', b]),
        atom(identity, ['Otto']),
        atom(person, ['Otto']),
        atom(officer_of, ['Otto', 'Orga', num(1)]),
        atom(officer, ['Orga', 'Otto', num(1)]),
        atom(proposal, ['Orga', xpa]),
        atom(motion_amend, ['Orga', xpa, b, b1]),
        atom(moved_on, ['Orga', xpa, num(mda)]),
        atom(today, ['Orga', num(tda)])],
       and(eq(num(via), cardinality([v1a], atom(vote, ['Orga', v1a, xpa, num(1)]), true)), and(eq(num(vna), cardinality([v2a], atom(officer, ['Orga', v2a, num(1)]), true)), and(gt(mul(num(2), num(via)), mul(num(1), plus(num(via), num(nia)))), and(eq(num(nia), cardinality([v3a], atom(nay, ['Orga', v3a, xpa, num(1)]), true)), and(ge(mul(num(4), plus(num(via), num(nia))), mul(num(1), num(vna))), ge(num(tda), plus(num(mda), num(10)))))))),
       ['Otto']),
%% DGC:1, Minting: Alice issues k of her coins of the denomination f.
