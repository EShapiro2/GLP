% ---------------------------------------------------------------------------
% Traceable provenance (def:grounded of /Grassroots/GSC, Section 3.6), for a
% contract of agent roles and listed roles alike (GSC ac7ad63).
%
% The largest set of predicates having it is a greatest fixpoint: start from
% every predicate of the contract, drop those the definition rejects against
% the set in hand, and repeat until nothing drops.  A contract has finitely
% many predicates, so the loop ends.
%
% Each added atom of Phi_E is put to the definition's two requirements:
% prov_c1s the first, on every argument of the atom that is an agent role, an
% agent variable or a name term, whose base is not that of its role (GSC
% 1934846, a value having no base), and prov_c2s the second, on every
% speech-act variable that is an argument of the atom or occurs in a name
% term among its arguments.  The atoms psi are those required at an agent
% role, =(i) u -(i), a cleared atom requiring none (def:schema, GSC 327e035),
% and, of a conditional atom or a listed role's, the anchor of its conjunct
% (def:schema, GSC 5e014fd); a condition of the body is read by none of this
% (def:schema, GSC c8c5ead).
% ---------------------------------------------------------------------------

% ---------------------------------------------------------------------------
% The predicates of a contract
% ---------------------------------------------------------------------------

procedure atoms_preds(Atoms?, Preds?, Preds).
atoms_preds([], T, T?).
atoms_preds([atom(Q, _)|Xs], T, [Q?|R?]) :- ground(Xs?), ground(T?) |
    atoms_preds(Xs?, T?, R).

% A cleared atom's predicate occurs in the contract too (def:schema).
procedure roles_preds(RoleSpecs?, Preds?, Preds).
roles_preds([], T, T?).
roles_preds([RS|Rs], T, R?) :- ground(RS?), ground(Rs?), ground(T?) |
    rs_add(RS?, P),
    rs_marked_del(RS?, M),
    rs_keep(RS?, K),
    rs_forb(RS?, N),
    roles_preds(Rs?, T?, R1),
    atoms_preds(N?, R1?, R2),
    atoms_preds(K?, R2?, R3),
    atoms_preds(M?, R3?, R4),
    atoms_preds(P?, R4?, R).

procedure contract_preds(Contract?, Preds?, Preds).
contract_preds([], T, T?).
contract_preds([S|Ss], T, R?) :- ground(S?), ground(Ss?), ground(T?) |
    sch_roles(S?, Rs),
    sch_conjs(S?, Cj),
    contract_preds(Ss?, T?, R1),
    conjs_preds(Cj?, R1?, R2),
    roles_preds(Rs?, R2?, R).

% The anchor and the conditional literals of a conjunct of the head.
procedure conjs_preds(Conjuncts?, Preds?, Preds).
conjs_preds([], T, T?).
conjs_preds([conjunct(_, _, A, _, P, M, _)|Cs], T, R?) :-
    ground(A?), ground(P?), ground(M?), ground(Cs?), ground(T?) |
    conjs_preds(Cs?, T?, R1),
    hms_atoms(M?, M1),
    hms_atoms(P?, P1),
    atoms_preds([A?|P1?], R1?, R2),
    atoms_preds(M1?, R2?, R).

procedure hms_atoms(HMults?, Atoms).
hms_atoms([], []).
hms_atoms([hm(_, M)|Ms], [A?|R?]) :- ground(M?) |
    plain_mult(M?, A),
    hms_atoms(Ms?, R).

% The predicates occurring in a contract, in order of first occurrence.
exported procedure all_preds(Contract?, Preds).
all_preds(C, R?) :- ground(C?) |
    contract_preds(C?, [], P),
    preds_dedup(P?, R).

% ---------------------------------------------------------------------------
% What one schema is decided against
% ---------------------------------------------------------------------------

procedure role_bases(RoleSpecs?, Integer?, Bases).
role_bases([], _, []).
role_bases([RS|Rs], I, [B?|R?]) :- ground(RS?), ground(Rs?), integer(I?) |
    role_base(RS?, I?, B),
    I1 := I? + 1,
    role_bases(Rs?, I1?, R).

% The bases carried by the atoms of Phi_E the roles of a schema require.
procedure req_bases(RoleSpecs?, Preds?, Bases?, Bases).
req_bases([], _, T, T?).
req_bases([RS|Rs], E, T, R?) :- ground(RS?), ground(Rs?), ground(E?), ground(T?) |
    rs_req(RS?, Req),
    req_bases(Rs?, E?, T?, R1),
    phi_bases(Req?, E?, R1?, R).

% The speech-act variables occurring in the atoms the roles require, as
% arguments or in name terms among them.
procedure req_args(RoleSpecs?, Args?, Args).
req_args([], T, T?).
req_args([RS|Rs], T, R?) :- ground(RS?), ground(Rs?), ground(T?) |
    rs_req(RS?, Req),
    req_args(Rs?, T?, R1),
    atoms_args(Req?, R1?, R).

procedure req_svars(RoleSpecs?, Args).
req_svars(Rs, R?) :- ground(Rs?) |
    req_args(Rs?, [], As),
    filter_svars(As?, SV),
    args_dedup(SV?, R).

% The same of the atoms of Phi_E the roles require.
procedure phi_args1(Ans?, Args?, Args?, Args).
phi_args1(no, _, T, T?).
phi_args1(yes, As, T, R?) :- ground(As?), ground(T?) | args_app(As?, T?, R).

procedure phi_args(Atoms?, Preds?, Args?, Args).
phi_args([], _, T, T?).
phi_args([atom(Q, As)|Xs], E, T, R?) :-
    ground(Q?), ground(As?), ground(Xs?), ground(E?), ground(T?) |
    pred_member(Q?, E?, M),
    phi_args(Xs?, E?, T?, R1),
    phi_args1(M?, As?, R1?, R).

procedure req_phi_args(RoleSpecs?, Preds?, Args?, Args).
req_phi_args([], _, T, T?).
req_phi_args([RS|Rs], E, T, R?) :- ground(RS?), ground(Rs?), ground(E?), ground(T?) |
    rs_req(RS?, Req),
    req_phi_args(Rs?, E?, T?, R1),
    phi_args(Req?, E?, R1?, R).

procedure req_phi_svars(RoleSpecs?, Preds?, Args).
req_phi_svars(Rs, E, R?) :- ground(Rs?), ground(E?) |
    req_phi_args(Rs?, E?, [], As),
    filter_svars(As?, SV),
    args_dedup(SV?, R).

% The agent roles of a schema, whose required atoms of Phi_E are the psi of
% the definition: they carry the bases and the speech-act variables a traced
% argument may be among.
procedure agent_roles(RoleSpecs?, RoleSpecs).
agent_roles([], []).
agent_roles([rs(G, P, M, K, N)|Rs], [rs(G?, P?, M?, K?, N?)|R?]) :- agent_roles(Rs?, R).
agent_roles([crs(_, _, _, _, _, _)|Rs], R?) :- agent_roles(Rs?, R).

% ---------------------------------------------------------------------------
% The two requirements of def:grounded
% ---------------------------------------------------------------------------

% The first, on an argument that is an agent role, an agent variable or a
% name term, whose base is not that of the role: its base is that of some
% role, or of some argument of a required atom of Phi_E at an agent role.  It
% asks nothing of a speech-act variable or a value, which have no base.
procedure prov_arg1(Base?, Base?, Bases?, Bases?, Ans).
prov_arg1(B, RB, _, _, yes) :- B? =?= RB? | true.
prov_arg1(B, _, RBs, QBs, R?) :- otherwise, ground(B?), ground(RBs?), ground(QBs?) |
    base_member(RBs?, B?, A1),
    base_member(QBs?, B?, A2),
    or_yes(A1?, A2?, R).

procedure prov_c1(Arg?, Base?, Bases?, Bases?, Ans).
prov_c1(svar(_), _, _, _, yes).
% A value is no agent role, no agent variable and no name term, so the
% definition asks nothing of it (the appendix "Values in Speech-Act Schemas").
prov_c1(num(_), _, _, _, yes).
prov_c1(A, RB, RBs, QBs, R?) :-
    otherwise, ground(A?), ground(RB?), ground(RBs?), ground(QBs?) |
    arg_base(A?, B),
    prov_arg1(B?, RB?, RBs?, QBs?, R).

procedure prov_c1s1(Ans?, Args?, Base?, Bases?, Bases?, Ans).
prov_c1s1(no, _, _, _, _, no).
prov_c1s1(yes, As, RB, RBs, QBs, R?) :-
    ground(As?), ground(RB?), ground(RBs?), ground(QBs?) |
    prov_c1s(As?, RB?, RBs?, QBs?, R).

procedure prov_c1s(Args?, Base?, Bases?, Bases?, Ans).
prov_c1s([], _, _, _, yes).
prov_c1s([A|As], RB, RBs, QBs, R?) :-
    ground(A?), ground(As?), ground(RB?), ground(RBs?), ground(QBs?) |
    prov_c1(A?, RB?, RBs?, QBs?, A1),
    prov_c1s1(A1?, As?, RB?, RBs?, QBs?, R).

% The second, on a speech-act variable Y of the added atom.  QSV holds the
% speech-act variables of the required atoms of Phi_E at agent roles, as
% arguments or in name terms among them, and SV those of every atom required
% at a role; Y meets the requirement when it is in QSV or not in SV.  A
% signed term sgn(y, pi), GAI's, counts as the two arguments y and pi:
% filter_svars gives y, and arg_base the base of pi.
procedure prov_c2(Arg?, Args?, Args?, Ans).
prov_c2(Y, QSV, SV, R?) :- ground(Y?), ground(QSV?), ground(SV?) |
    args_member(QSV?, Y?, A1),
    args_member(SV?, Y?, A2),
    flip(A2?, A3),
    or_yes(A1?, A3?, R).

procedure prov_c2s1(Ans?, Args?, Args?, Args?, Ans).
prov_c2s1(no, _, _, _, no).
prov_c2s1(yes, Ys, QSV, SV, R?) :- ground(Ys?), ground(QSV?), ground(SV?) |
    prov_c2s(Ys?, QSV?, SV?, R).

procedure prov_c2s(Args?, Args?, Args?, Ans).
prov_c2s([], _, _, yes).
prov_c2s([Y|Ys], QSV, SV, R?) :-
    ground(Y?), ground(Ys?), ground(QSV?), ground(SV?) |
    prov_c2(Y?, QSV?, SV?, A),
    prov_c2s1(A?, Ys?, QSV?, SV?, R).

% One added atom of Phi_E, with arguments As, at a role of base RB.
procedure prov_atom(Args?, Base?, PCtx?, Ans).
prov_atom(As, RB, pctx(RBs, QBs, QSV, SV), R?) :-
    ground(As?), ground(RB?), ground(RBs?), ground(QBs?), ground(QSV?), ground(SV?) |
    prov_c1s(As?, RB?, RBs?, QBs?, A1),
    filter_svars(As?, Ys),
    prov_c2s(Ys?, QSV?, SV?, A2),
    both_yes(A1?, A2?, R).

procedure prov_plus1(Ans?, Atoms?, Constant?, Base?, PCtx?, Ans).
prov_plus1(no, _, _, _, _, no).
prov_plus1(yes, Xs, Pd, RB, Cx, R?) :-
    ground(Xs?), ground(Pd?), ground(RB?), ground(Cx?) |
    prov_plus(Xs?, Pd?, RB?, Cx?, R).

procedure prov_plus(Atoms?, Constant?, Base?, PCtx?, Ans).
prov_plus([], _, _, _, yes).
prov_plus([atom(Q, As)|Xs], Pd, RB, Cx, R?) :-
    Q? =?= Pd?, ground(As?), ground(Xs?), ground(RB?), ground(Cx?) |
    prov_atom(As?, RB?, Cx?, A),
    prov_plus1(A?, Xs?, Pd?, RB?, Cx?, R).
prov_plus([atom(_, _)|Xs], Pd, RB, Cx, R?) :-
    otherwise, ground(Xs?), ground(Pd?), ground(RB?), ground(Cx?) |
    prov_plus(Xs?, Pd?, RB?, Cx?, R).

procedure prov_roles1(Ans?, RoleSpecs?, Integer?, Constant?, PCtx?, Preds?, Ans).
prov_roles1(no, _, _, _, _, _, no).
prov_roles1(yes, Rs, I, Pd, Cx, E, R?) :-
    ground(Rs?), integer(I?), ground(Pd?), ground(Cx?), ground(E?) |
    I1 := I? + 1,
    prov_roles(Rs?, I1?, Pd?, Cx?, E?, R).

procedure prov_roles(RoleSpecs?, Integer?, Constant?, PCtx?, Preds?, Ans).
prov_roles([], _, _, _, _, yes).
prov_roles([RS|Rs], I, Pd, Cx, E, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Pd?), ground(Cx?), ground(E?) |
    rs_add(RS?, P),
    role_base(RS?, I?, RB),
    role_cx(RS?, I?, Cx?, E?, Cx1),
    prov_plus(P?, Pd?, RB?, Cx1?, A),
    prov_roles1(A?, Rs?, I?, Pd?, Cx?, E?, R).

% What the atoms of a role are read against: an agent role's, the schema's; a
% listed role's, with its anchor, "the anchor of the conjunct counts as an atom
% its holder requires" (def:schema, GSC 5e014fd).  Every quantifier binding a
% listed role has one anchor (def:role), which its kind holds.
procedure role_cx(RoleSpec?, Integer?, PCtx?, Preds?, PCtx).
role_cx(rs(_, _, _, _, _), _, Cx, _, Cx?).
role_cx(crs(listed(_, Rho, As), _, _, _, _, _), I, Cx, E, R?) :-
    ground(Rho?), ground(As?), integer(I?), ground(Cx?), ground(E?) |
    anchored_cx(atom(Rho?, [role(I?)|As?]), Cx?, E?, R).
role_cx(crs(qlisted(_, Rho, As, _), _, _, _, _, _), _, Cx, E, R?) :-
    ground(Rho?), ground(As?), ground(Cx?), ground(E?) |
    anchored_cx(atom(Rho?, As?), Cx?, E?, R).

% The context with the atom A among those required: at an agent role, and of
% Phi_E where its predicate is in E.
procedure anchored_cx(Atom?, PCtx?, Preds?, PCtx).
anchored_cx(A, pctx(RBs, QBs, QSV, SV), E, pctx(RBs?, QB1?, QSV1?, SV1?)) :-
    ground(A?), ground(RBs?), ground(QBs?), ground(QSV?), ground(SV?), ground(E?) |
    phi_bases([A?], E?, QBs?, QB1),
    phi_args([A?], E?, [], As1),
    filter_svars(As1?, S1),
    args_app(S1?, QSV?, QSV1),
    atoms_args([A?], [], As2),
    filter_svars(As2?, S2),
    args_app(S2?, SV?, SV1).

procedure prov_pred1(Ans?, Constant?, Contract?, Preds?, Ans).
prov_pred1(no, _, _, _, no).
prov_pred1(yes, Pd, Ss, E, R?) :- ground(Pd?), ground(Ss?), ground(E?) |
    prov_pred(Pd?, Ss?, E?, R).

procedure prov_pred(Constant?, Contract?, Preds?, Ans).
prov_pred(_, [], _, yes).
prov_pred(Pd, [S|Ss], E, R?) :-
    ground(S?), ground(Ss?), ground(Pd?), ground(E?) |
    sch_roles(S?, Rs),
    sch_conjs(S?, Cj),
    prov_pred_w(Rs?, Cj?, Pd?, Ss?, E?, R).

procedure prov_pred_w(RoleSpecs?, Conjuncts?, Constant?, Contract?, Preds?, Ans).
prov_pred_w(Rs, Cj, Pd, Ss, E, R?) :-
    ground(Rs?), ground(Cj?), ground(Pd?), ground(Ss?), ground(E?) |
    agent_roles(Rs?, Ws),
    prov_pred_roles(Rs?, Ws?, Cj?, Pd?, Ss?, E?, R).

% Ws are the agent roles of the schema.
procedure prov_pred_roles(RoleSpecs?, RoleSpecs?, Conjuncts?, Constant?, Contract?, Preds?, Ans).
prov_pred_roles(Rs, Ws, Cj, Pd, Ss, E, R?) :-
    ground(Rs?), ground(Ws?), ground(Cj?), ground(Pd?), ground(Ss?), ground(E?) |
    role_bases(Rs?, 1, RBs),
    req_bases(Ws?, E?, [], QBs),
    req_phi_svars(Ws?, E?, QSV),
    req_svars(Rs?, SV),
    prov_pred_cx(pctx(RBs?, QBs?, QSV?, SV?), Rs?, Cj?, Pd?, Ss?, E?, R).

procedure prov_pred_cx(PCtx?, RoleSpecs?, Conjuncts?, Constant?, Contract?, Preds?, Ans).
prov_pred_cx(Cx, Rs, Cj, Pd, Ss, E, R?) :-
    ground(Cx?), ground(Rs?), ground(Cj?), ground(Pd?), ground(Ss?), ground(E?) |
    prov_roles(Rs?, 1, Pd?, Cx?, E?, A1),
    prov_conjs(Cj?, Pd?, Cx?, E?, A2),
    both_yes(A1?, A2?, A),
    prov_pred1(A?, Pd?, Ss?, E?, R).

% "A conditional atom added at an agent role is read the same way
% (Definition Speech-act schema), the anchor of its conjunct counting as an
% atom of = at its holder" (def:grounded).
procedure prov_conjs(Conjuncts?, Constant?, PCtx?, Preds?, Ans).
prov_conjs([], _, _, _, yes).
prov_conjs([conjunct(_, _, A, _, P, _, _)|Cs], Pd, Cx, E, R?) :-
    ground(A?), ground(P?), ground(Cs?), ground(Pd?), ground(Cx?), ground(E?) |
    anchored_cx(A?, Cx?, E?, Cx1),
    prov_hms(P?, Pd?, Cx1?, A1),
    prov_conjs1(A1?, Cs?, Pd?, Cx?, E?, R).

procedure prov_conjs1(Ans?, Conjuncts?, Constant?, PCtx?, Preds?, Ans).
prov_conjs1(no, _, _, _, _, no).
prov_conjs1(yes, Cs, Pd, Cx, E, R?) :- prov_conjs(Cs?, Pd?, Cx?, E?, R).

procedure prov_hms(HMults?, Constant?, PCtx?, Ans).
prov_hms([], _, _, yes).
prov_hms([hm(J, M)|Ms], Pd, Cx, R?) :- integer(J?), ground(M?), ground(Ms?), ground(Pd?), ground(Cx?) |
    plain_mult(M?, A),
    prov_plus([A?], Pd?, b_role(J?), Cx?, B),
    prov_hms1(B?, Ms?, Pd?, Cx?, R).

procedure prov_hms1(Ans?, HMults?, Constant?, PCtx?, Ans).
prov_hms1(no, _, _, _, no).
prov_hms1(yes, Ms, Pd, Cx, R?) :- prov_hms(Ms?, Pd?, Cx?, R).

% ---------------------------------------------------------------------------
% The fixpoint
% ---------------------------------------------------------------------------

procedure tp_filter1(Ans?, Constant?, Preds?, Contract?, Preds?, Preds).
tp_filter1(yes, P, Ps, C, E, [P?|R?]) :- ground(P?), ground(Ps?), ground(C?), ground(E?) |
    tp_filter(Ps?, C?, E?, R).
tp_filter1(no, _, Ps, C, E, R?) :- ground(Ps?), ground(C?), ground(E?) |
    tp_filter(Ps?, C?, E?, R).

procedure tp_filter(Preds?, Contract?, Preds?, Preds).
tp_filter([], _, _, []).
tp_filter([P|Ps], C, E, R?) :- ground(P?), ground(Ps?), ground(C?), ground(E?) |
    prov_pred(P?, C?, E?, A),
    tp_filter1(A?, P?, Ps?, C?, E?, R).

procedure tp_loop2(Integer?, Integer?, Preds?, Contract?, Preds).
tp_loop2(L1, L2, E1, _, E1?) :- L1? =:= L2? | true.
tp_loop2(_, _, E1, C, R?) :- otherwise, ground(E1?), ground(C?) |
    tp_loop(C?, E1?, R).

procedure tp_loop1(Preds?, Preds?, Contract?, Preds).
tp_loop1(E1, E, C, R?) :- ground(E1?), ground(E?), ground(C?) |
    preds_len(E1?, L1),
    preds_len(E?, L2),
    tp_loop2(L1?, L2?, E1?, C?, R).

procedure tp_loop(Contract?, Preds?, Preds).
tp_loop(C, E, R?) :- ground(C?), ground(E?) |
    tp_filter(E?, C?, E?, E1),
    tp_loop1(E1?, E?, C?, R).

% The largest set of predicates of the contract having traceable provenance.
exported procedure traceable(Contract?, Preds).
traceable(C, E?) :- ground(C?) |
    all_preds(C?, P0),
    tp_loop(C?, P0?, E).
