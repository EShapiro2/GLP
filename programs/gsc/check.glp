% ---------------------------------------------------------------------------
% The verdict.
%
% A contract whose roles are all party roles is the contract of
% /Grassroots/GSC, Section 3, and is decided by
% def:syntactically-grassroots: it passes when it has an unobstructed
% introductory act, when the set of predicates occurring in it has traceable
% provenance, and when it satisfies volition; the faults of the three
% conjuncts are reported together, in that order.  The second conjunct is
% decided from the largest set of predicates having traceable provenance,
% which traceable_of gives: the fault names the predicates of the contract
% outside it.  Volition is one condition in Section 3 and Appendix D, def:volition
% being definition:volition for a contract whose roles are all party roles
% (Appendix D, after its Definition Volition), so the third conjunct is decided
% by community.glp's volition_faults, as Appendix D's volition is.
%
% A contract written in the language of Appendix D -- with a seated or a
% constituent role, a reach condition or a name term -- that is agent-named
% (Appendix D.4, definition:agent-named) is decided by the four clauses of
% definition:sg-agent-named: an unobstructed introductory act with agent
% roles and no name term, the schemas of arity one of clause 1 of
% def:unobstructed having an agent role and no name term; no seated role
% adding an atom of a predicate the introductory act forbids at a role;
% traceable provenance of the set of predicates occurring in it, each atom
% psi required at an agent role; and a connected role graph or a guarding
% agent role in every connected component of it.  The faults of the four are
% reported together, in that order, the first two as the first conjunct of
% def:syntactically-grassroots is; a contract meeting them is
% syntactically_grassroots_with_seated_roles, and the protocol realising it
% is volitionally grassroots (Theorem "Grassroots realisation with seated
% roles").
%
% Any other contract with community roles is a contract of Appendix D, and is decided
% by the three conditions on the text stated there: traceable provenance of
% the set of predicates occurring in it (definition:provenance), volition
% (definition:volition) and cohesion (definition:cohesive), each of which it
% meets or fails; the faults of the three are reported together, in that
% order.  The first is decided from the largest set of predicates having
% traceable provenance, which traceable_of gives, as for a contract of Section
% 3.  Rootedness (definition:rooted) is no condition on the text, and
% rooted_of gives the predicates that are rooted.  Openness and closure are
% proved of a contract in the paper, are not conditions on the text, and are
% neither decided nor claimed here.
%
% A schema is an act schema only when it is formed as def:schema requires:
% +(i) and -(i) disjoint at every role, and +(i) u -(i) nonempty at every
% role that is not a guarding role and at some role, a guarding role being
% one that may add and delete nothing (def:schema and the sentence after its
% example).  Appendix D's Definition Act schema requires the first alone.  A
% contract with a schema formed otherwise is malformed: it is refused, its
% verdict malformed(Faults), and no condition is decided for it.
%
% A contract may declare predicates of arity one reflexive, and then no
% schema of it adds or deletes, at a role, the atom of a reflexive predicate
% naming that role (the paragraph after def:binding).  A contract in which one
% does is malformed too, the verdict naming each such schema, role and atom.
% So is a
% contract with a schema whose signed term violates what def:schema requires
% of it -- that it occur only in an atom marked +, and that its speech-act
% variable occur in an atom its role requires -- or whose role is not an
% agent role, Appendix D's Definition Act schema admitting sgn(y, pi) for pi
% an agent role, with the two requirements of def:schema.
%
% A contract of Section 3 whose first conjunct fails may still be grassroots
% with wards (Appendix F): when it has an introduction with wards
% (def:introduction-wards), traceable provenance and volition, the protocol
% realising it is volitionally grassroots (thm:grassroots-wards), and its
% verdict names the introductory act, the marks, their guardianships, the
% relay acts the search found and the leaving marks of the contract
% (def:leaving): with none the realisation is open and the protocol is
% grassroots as well (Appendix F, its last paragraph); with any, the paper
% claims it volitionally grassroots and no more.  Otherwise the faults are
% reported as before.
% ---------------------------------------------------------------------------

imported procedure unobstructed#intro_result(Contract?, Preds?, Faults).
imported procedure prov#traceable(Contract?, Preds).
imported procedure prov#all_preds(Contract?, Preds).
imported procedure community#volition_faults(Contract?, Preds?, Faults).
imported procedure community#volition_faults_agent(Contract?, Preds?, Faults).
imported procedure community#conditions(Contract?, Faults).
imported procedure community#traceable(Contract?, Preds).
imported procedure community#traceable_agent(Contract?, Preds).
imported procedure community#rooted(Contract?, Preds).
imported procedure wards#wards(Contract?, Preds?, Wards).
imported procedure wards#guardianships_for(Contract?, Preds?, Guardianships).
imported procedure wards#leaving_for(Contract?, Preds?, Leavings).
imported procedure contracts#contract(Constant?, Declared).
imported procedure contracts#variant(Constant?, Contract?, Declared).

procedure verdict(Faults?, Verdict).
verdict([], syntactically_grassroots).
verdict([F|Fs], not_grassroots([F?|Fs?])).

% The second conjunct of def:syntactically-grassroots: every predicate of the
% contract is in the largest set having traceable provenance.
procedure untraceable_faults(Preds?, Faults).
untraceable_faults([], []).
untraceable_faults([P|Ps], [untraceable([P?|Ps?])]).

procedure check_section3(Contract?, Preds?, Verdict).
check_section3(C, Rf, V?) :- ground(C?), ground(Rf?) |
    prov # traceable(C?, E),
    section3_verdict(C?, Rf?, E?, V).

% E is read by two conjuncts, so it is taken ground in a head of its own.
procedure section3_verdict(Contract?, Preds?, Preds?, Verdict).
section3_verdict(C, Rf, E, V?) :- ground(C?), ground(Rf?), ground(E?) |
    prov # all_preds(C?, Ps),
    preds_diff(Ps?, E?, Missing),
    untraceable_faults(Missing?, FT),
    unobstructed # intro_result(C?, Rf?, F1),
    community # volition_faults(C?, E?, F2),
    faults_app(FT?, F2?, F23),
    wards_verdict(F1?, F23?, C?, Rf?, V).

% The first conjunct failing and the other two holding, Appendix F is tried:
% a contract with an introduction with wards is grassroots with wards
% (def:introduction-wards, thm:grassroots-wards); otherwise the faults of the
% three conjuncts are reported as before, in their order.
procedure wards_verdict(Faults?, Faults?, Contract?, Preds?, Verdict).
wards_verdict([], F23, _, _, V?) :- ground(F23?) | verdict(F23?, V).
wards_verdict([F|Fs], [], C, Rf, V?) :-
    ground(F?), ground(Fs?), ground(C?), ground(Rf?) |
    wards # wards(C?, Rf?, W),
    wards_verdict1(W?, [F?|Fs?], V).
wards_verdict([F|Fs], [G|Gs], _, _, V?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Gs?) |
    faults_app([F?|Fs?], [G?|Gs?], FF),
    verdict(FF?, V).

procedure wards_verdict1(Wards?, Faults?, Verdict).
wards_verdict1(introduction_with_wards(Nm, M, Gs, Rs, Lv), _,
               grassroots_with_wards(Nm?, M?, Gs?, Rs?, Lv?)).
wards_verdict1(no_introduction_with_wards, F, not_grassroots(F?)).

procedure community_verdict(Faults?, Verdict).
community_verdict([], conditions_met).
community_verdict([F|Fs], conditions_failed([F?|Fs?])).

procedure check_appendix(Contract?, Verdict).
check_appendix(C, V?) :- ground(C?) |
    community # conditions(C?, F),
    community_verdict(F?, V).

% --- an agent-named contract (Appendix D.4, definition:sg-agent-named) ----
% Clause 3 is decided from the largest set of predicates having traceable
% provenance with each psi required at an agent role, E3, which traceable_of
% gives for such a contract: its fault names the predicates outside it.
% Clause 4's role graph is that of definition:volition, over the predicates
% of traceable provenance of definition:provenance, E.  Clauses 1 and 2 are
% unobstructed.glp's, at each introductory act in turn.
procedure seated_verdict1(Faults?, Verdict).
seated_verdict1([], syntactically_grassroots_with_seated_roles).
seated_verdict1([F|Fs], not_grassroots([F?|Fs?])).

procedure seated_verdict(Contract?, Preds?, Preds?, Preds?, Verdict).
seated_verdict(C, Rf, E3, E, V?) :- ground(C?), ground(Rf?), ground(E3?), ground(E?) |
    prov # all_preds(C?, Ps),
    preds_diff(Ps?, E3?, Missing),
    untraceable_faults(Missing?, FT),
    unobstructed # intro_result(C?, Rf?, F12),
    community # volition_faults_agent(C?, E?, F4),
    faults_app(FT?, F4?, F34),
    faults_app(F12?, F34?, F),
    seated_verdict1(F?, V).

procedure check_seated(Contract?, Preds?, Verdict).
check_seated(C, Rf, V?) :- ground(C?), ground(Rf?) |
    community # traceable_agent(C?, E3),
    community # traceable(C?, E),
    seated_verdict(C?, Rf?, E3?, E?, V).

procedure check_app1(Ans?, Contract?, Preds?, Verdict).
check_app1(yes, C, Rf, V?) :- ground(C?), ground(Rf?) | check_seated(C?, Rf?, V).
check_app1(no, C, _, V?) :- ground(C?) | check_appendix(C?, V).

procedure check1(Ans?, Contract?, Preds?, Verdict).
check1(no, C, Rf, V?) :- ground(C?), ground(Rf?) | check_section3(C?, Rf?, V).
check1(yes, C, Rf, V?) :- ground(C?), ground(Rf?) |
    agent_named(C?, A),
    check_app1(A?, C?, Rf?, V).

% --- the form of a schema (def:schema; Appendix D, Definition Act schema) --
% def:schema requires that +(i) and -(i) be disjoint, and that +(i) u -(i) be
% nonempty at every role that is not a guarding role and at some role.  Each
% atom a role both adds and deletes is a fault
% added_and_deleted(Schema, Role, Atom); each role that is not a guarding
% role and adds and deletes nothing a fault changes_nothing(Schema, Role);
% and a schema adding and deleting nothing at every role a fault
% no_role_changes(Schema), one per requirement violated.  Appendix D's
% Definition Act schema requires +(i) and -(i) disjoint and nothing of
% +(i) u -(i), so a contract with community roles is put to the first alone.

procedure atoms_nonempty(Atoms?, Ans).
atoms_nonempty([], no).
atoms_nonempty([_|_], yes).

% The role adds or deletes an atom: +(i) u -(i) is nonempty.
procedure role_changes(RoleSpec?, Ans).
role_changes(RS, R?) :- ground(RS?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    atoms_app(P?, M?, PM),
    atoms_nonempty(PM?, R).

procedure roles_change1(Ans?, RoleSpecs?, Ans).
roles_change1(yes, _, yes).
roles_change1(no, Rs, R?) :- ground(Rs?) | roles_change(Rs?, R).

% Some role adds or deletes an atom.
procedure roles_change(RoleSpecs?, Ans).
roles_change([], no).
roles_change([RS|Rs], R?) :- ground(RS?), ground(Rs?) |
    role_changes(RS?, A),
    roles_change1(A?, Rs?, R).

% Each atom of Plus that Minus holds is added and deleted at the role.
procedure overlap_fault(Ans?, Atom?, Constant?, Integer?, Faults?, Faults).
overlap_fault(yes, A, Nm, I, T, [added_and_deleted(Nm?, I?, A?)|T?]).
overlap_fault(no, _, _, _, T, T?).

procedure overlap_faults(Atoms?, Atoms?, Constant?, Integer?, Faults?, Faults).
overlap_faults([], _, _, _, T, T?).
overlap_faults([A|As], M, Nm, I, T, R?) :-
    ground(A?), ground(As?), ground(M?), ground(Nm?), integer(I?), ground(T?) |
    atoms_member(M?, A?, In),
    overlap_faults(As?, M?, Nm?, I?, T?, R1),
    overlap_fault(In?, A?, Nm?, I?, R1?, R).

% A role that is not guarding (first argument no) and adds and deletes
% nothing (second argument no).
procedure inert_fault(Ans?, Ans?, Constant?, Integer?, Faults?, Faults).
inert_fault(no, no, Nm, I, T, [changes_nothing(Nm?, I?)|T?]).
inert_fault(no, yes, _, _, T, T?).
inert_fault(yes, _, _, _, T, T?).

% The requirement on +(i) u -(i) at a role, for a schema of Section 3 (first
% argument yes) and for none of Appendix D (no).
procedure role_inert(Ans?, RoleSpec?, Constant?, Integer?, Faults?, Faults).
role_inert(yes, RS, Nm, I, T, R?) :-
    ground(RS?), ground(Nm?), integer(I?), ground(T?) |
    is_guarding(RS?, G),
    role_changes(RS?, C),
    inert_fault(G?, C?, Nm?, I?, T?, R).
role_inert(no, _, _, _, T, T?).

procedure form_roles(RoleSpecs?, Integer?, Constant?, Ans?, Faults).
form_roles([], _, _, _, []).
form_roles([RS|Rs], I, Nm, S3, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(S3?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    I1 := I? + 1,
    form_roles(Rs?, I1?, Nm?, S3?, R1),
    role_inert(S3?, RS?, Nm?, I?, R1?, R2),
    overlap_faults(P?, M?, Nm?, I?, R2?, R).

% Some role adds or deletes an atom, for a schema of Section 3.
procedure schema_change_fault(Ans?, Ans?, Constant?, Faults).
schema_change_fault(yes, no, Nm, [no_role_changes(Nm?)]).
schema_change_fault(yes, yes, _, []).
schema_change_fault(no, _, _, []).

% A, from has_community, is yes for a contract with community roles.
procedure form_schema(Ans?, Schema?, Faults).
form_schema(A, S, R?) :- ground(A?), ground(S?) |
    flip(A?, S3),
    form_schema1(S3?, S?, R).

procedure form_schema1(Ans?, Schema?, Faults).
form_schema1(S3, S, R?) :- ground(S3?), ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    form_schema2(S3?, Nm?, Rs?, R).

procedure form_schema2(Ans?, Constant?, RoleSpecs?, Faults).
form_schema2(S3, Nm, Rs, R?) :- ground(S3?), ground(Nm?), ground(Rs?) |
    form_roles(Rs?, 1, Nm?, S3?, F1),
    roles_change(Rs?, Ch),
    schema_change_fault(S3?, Ch?, Nm?, F2),
    faults_app(F1?, F2?, R).

procedure form_schemas(Contract?, Ans?, Faults).
form_schemas([], _, []).
form_schemas([S|Ss], A, R?) :- ground(S?), ground(Ss?), ground(A?) |
    form_schema(A?, S?, F1),
    form_schemas(Ss?, A?, F2),
    faults_app(F1?, F2?, R).

% --- a contract declaring predicates reflexive (after def:binding) ---------
% Each atom a role adds or deletes that is the atom of a reflexive predicate
% naming that role is a fault reflexive(Schema, Role, Atom).

procedure refl_atom_faults(Atoms?, Constant?, Integer?, Faults?, Faults).
refl_atom_faults([], _, _, T, T?).
refl_atom_faults([A|As], Nm, I, T, [reflexive(Nm?, I?, A?)|R?]) :-
    ground(As?), ground(Nm?), integer(I?), ground(T?) |
    refl_atom_faults(As?, Nm?, I?, T?, R).

procedure refl_roles(RoleSpecs?, Integer?, Constant?, Preds?, Faults).
refl_roles([], _, _, _, []).
refl_roles([RS|Rs], I, Nm, Rf, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(Rf?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    atoms_app(P?, M?, PM),
    refl_keep(PM?, I?, Rf?, yes, Own),
    I1 := I? + 1,
    refl_roles(Rs?, I1?, Nm?, Rf?, R1),
    refl_atom_faults(Own?, Nm?, I?, R1?, R).

procedure refl_schemas(Contract?, Preds?, Faults).
refl_schemas([], _, []).
refl_schemas([S|Ss], Rf, R?) :- ground(S?), ground(Ss?), ground(Rf?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    refl_roles(Rs?, 1, Nm?, Rf?, F1),
    refl_schemas(Ss?, Rf?, F2),
    faults_app(F1?, F2?, R).

% --- the signed terms of a schema (def:schema) ----------------------------
% def:schema requires of a signed term sgn(y, pi) that it occur only in an
% atom marked +, and that its speech-act variable y occur in an atom its role
% pi requires; Appendix D's Definition Act schema requires the same, and that
% pi be an agent role.  Each atom carrying a signed term that violates one of
% them is a fault signed(Schema, Role, Atom, Cause), not_added for the first,
% not_required for the second and not_agent_role for the third, one per
% requirement it violates.  The roles of a schema of Section 3 are agent
% roles, so the third asks nothing of it.

% The signed terms among the arguments of an atom.
procedure args_sgns(Args?, Args).
args_sgns([], []).
args_sgns([sgn(Y, J)|As], [sgn(Y?, J?)|R?]) :- ground(As?) | args_sgns(As?, R).
args_sgns([A|As], R?) :- otherwise, ground(A?), ground(As?) | args_sgns(As?, R).

% The atoms of Phis carrying a signed term, each a fault with the cause W.
procedure sgn_carrying(Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying([], _, _, _, T, T?).
sgn_carrying([atom(P, As)|Xs], Nm, I, W, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_carrying1(Ss?, atom(P?, As?), Xs?, Nm?, I?, W?, T?, R).

procedure sgn_carrying1(Args?, Atom?, Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying1([], _, Xs, Nm, I, W, T, R?) :-
    ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).
sgn_carrying1([_|_], A, Xs, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|R?]) :-
    ground(A?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).

% One added atom: for each signed term sgn(y, pi) it carries, the role pi
% requires an atom with y among its arguments.
procedure sgn_required(Args?, RoleSpecs?, Ans).
sgn_required([], _, yes).
sgn_required([sgn(Y, J)|Ss], Rs, R?) :-
    ground(Y?), integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    req_occurs(RS?, svar(Y?), A),
    sgn_required1(A?, Ss?, Rs?, R).
sgn_required([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_required(Ss?, Rs?, R).

procedure sgn_required1(Ans?, Args?, RoleSpecs?, Ans).
sgn_required1(no, _, _, no).
sgn_required1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_required(Ss?, Rs?, R).

procedure sgn_fault(Ans?, Atom?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_fault(yes, _, _, _, _, T, T?).
sgn_fault(no, A, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|T?]).

% For each signed term sgn(y, pi) among Args, pi is an agent role.
procedure sgn_agent1(Ans?, Args?, RoleSpecs?, Ans).
sgn_agent1(no, _, _, no).
sgn_agent1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_agent(Ss?, Rs?, R).

procedure sgn_agent(Args?, RoleSpecs?, Ans).
sgn_agent([], _, yes).
sgn_agent([sgn(_, J)|Ss], Rs, R?) :- integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    is_party_role(RS?, A),
    sgn_agent1(A?, Ss?, Rs?, R).
sgn_agent([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_agent(Ss?, Rs?, R).

procedure sgn_added1(Args?, Atom?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added1(Ss, A, Rs, Nm, I, T, R?) :-
    ground(Ss?), ground(A?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    sgn_agent(Ss?, Rs?, A0),
    sgn_required(Ss?, Rs?, A1),
    sgn_fault(A1?, A?, Nm?, I?, not_required, T?, R1),
    sgn_fault(A0?, A?, Nm?, I?, not_agent_role, R1?, R).

procedure sgn_added(Atoms?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added([], _, _, _, T, T?).
sgn_added([atom(P, As)|Xs], Rs, Nm, I, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_added(Xs?, Rs?, Nm?, I?, T?, R1),
    sgn_added1(Ss?, atom(P?, As?), Rs?, Nm?, I?, R1?, R).

% The roles of a schema of Section 3: the two requirements at each.
procedure sgn_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Faults).
sgn_roles([], _, _, _, []).
sgn_roles([RS|Rs], I, All, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(All?), ground(Nm?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    rs_keep(RS?, K),
    rs_forb(RS?, N),
    atoms_app(K?, N?, KN),
    atoms_app(M?, KN?, MKN),
    I1 := I? + 1,
    sgn_roles(Rs?, I1?, All?, Nm?, R1),
    sgn_carrying(MKN?, Nm?, I?, not_added, R1?, R2),
    sgn_added(P?, All?, Nm?, I?, R2?, R).

procedure sgn_schema1(RoleSpecs?, Constant?, Faults).
sgn_schema1(Rs, Nm, R?) :- ground(Rs?), ground(Nm?) |
    sgn_roles(Rs?, 1, Rs?, Nm?, R).

procedure sgn_schema(Schema?, Faults).
sgn_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    sgn_schema1(Rs?, Nm?, R).

procedure sgn_schemas(Contract?, Faults).
sgn_schemas([], []).
sgn_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sgn_schema(S?, F1),
    sgn_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% A malformed contract is refused; a contract that is not is decided by
% Section 3 or by Appendix D, according to its roles.
procedure check_formed(Faults?, Ans?, Contract?, Preds?, Verdict).
check_formed([], A, C, Rf, V?) :- ground(A?), ground(C?), ground(Rf?) |
    check1(A?, C?, Rf?, V).
check_formed([F|Fs], _, _, _, malformed([F?|Fs?])).

procedure check_decl(Contract?, Preds?, Verdict).
check_decl(C, Rf, V?) :- ground(C?), ground(Rf?) |
    has_community(C?, A),
    form_schemas(C?, A?, M0),
    refl_schemas(C?, Rf?, M1),
    sgn_schemas(C?, M2),
    faults_app(M1?, M2?, M12),
    faults_app(M0?, M12?, M),
    check_formed(M?, A?, C?, Rf?, V).

exported procedure check(Declared?, Verdict).
check(D, V?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    check_decl(C?, Rf?, V).

exported procedure check_named(Constant?, Verdict).
check_named(Nm, V?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    check(D?, V).

% A fixture that changes a contract in one place, by name and the contract it
% changes (contracts.glp, variant/3).
exported procedure check_variant(Constant?, Contract?, Verdict).
check_variant(Nm, B, V?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    check(D?, V).

% The predicates of traceable provenance, for inspection: def:grounded for a
% contract of Section 3, definition:provenance with each psi required at an
% agent role for an agent-named contract with community roles (clause 3 of
% definition:sg-agent-named), and definition:provenance for any other.
procedure traceable2(Ans?, Contract?, Preds).
traceable2(yes, C, E?) :- ground(C?) | community # traceable_agent(C?, E).
traceable2(no, C, E?) :- ground(C?) | community # traceable(C?, E).

procedure traceable1(Ans?, Contract?, Preds).
traceable1(no, C, E?) :- ground(C?) | prov # traceable(C?, E).
traceable1(yes, C, E?) :- ground(C?) |
    agent_named(C?, A),
    traceable2(A?, C?, E).

procedure traceable_in(Contract?, Preds).
traceable_in(C, E?) :- ground(C?) |
    has_community(C?, A),
    traceable1(A?, C?, E).

exported procedure traceable_of(Constant?, Preds).
traceable_of(Nm, E?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    decl_schemas(D?, C),
    traceable_in(C?, E).

exported procedure traceable_preds(Declared?, Preds).
traceable_preds(D, E?) :- ground(D?) |
    decl_schemas(D?, C),
    traceable_in(C?, E).

exported procedure traceable_variant(Constant?, Contract?, Preds).
traceable_variant(Nm, B, E?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    traceable_preds(D?, E).

% The introduction with wards of Appendix F, for inspection, searched for
% whatever the verdict: what it found, or no_introduction_with_wards.  A
% contract with community roles has none, Appendix F being written over the
% schemas of Section 3.
procedure wards1(Ans?, Contract?, Preds?, Wards).
wards1(no, C, Rf, W?) :- ground(C?), ground(Rf?) | wards # wards(C?, Rf?, W).
wards1(yes, _, _, no_introduction_with_wards).

procedure wards_in(Contract?, Preds?, Wards).
wards_in(C, Rf, W?) :- ground(C?), ground(Rf?) |
    has_community(C?, A),
    wards1(A?, C?, Rf?, W).

exported procedure wards(Declared?, Wards).
wards(D, W?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    wards_in(C?, Rf?, W).

exported procedure wards_of(Constant?, Wards).
wards_of(Nm, W?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    wards(D?, W).

exported procedure wards_variant(Constant?, Contract?, Wards).
wards_variant(Nm, B, W?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    wards(D?, W).

% The guardianships for a set of marks M (def:guardianship), every one of
% each mark, for inspection.
exported procedure guardianships(Declared?, Preds?, Guardianships).
guardianships(D, M, G?) :- ground(D?), ground(M?) |
    decl_schemas(D?, C),
    wards # guardianships_for(C?, M?, G).

% The leaving marks of a contract for a set M of marks (def:leaving), for
% inspection: def:leaving supposes a guardianship for every mark in M, and
% its clause 3 reads the g of that guardianship, so the leaving marks are
% given for each choice of a guardianship for each mark, leaving(Gs, L).
exported procedure leaving(Declared?, Preds?, Leavings).
leaving(D, M, L?) :- ground(D?), ground(M?) |
    decl_schemas(D?, C),
    wards # leaving_for(C?, M?, L).

exported procedure leaving_of(Constant?, Preds?, Leavings).
leaving_of(Nm, M, L?) :- ground(Nm?), ground(M?) |
    contracts # contract(Nm?, D),
    leaving(D?, M?, L).

% The predicates that are rooted (definition:rooted).  Rootedness is a notion
% of Appendix D; a contract of Section 3 is not asked about it.
procedure rooted1(Ans?, Contract?, Preds).
rooted1(no, _, []).
rooted1(yes, C, E?) :- ground(C?) | community # rooted(C?, E).

procedure rooted_in(Contract?, Preds).
rooted_in(C, E?) :- ground(C?) |
    has_community(C?, A),
    rooted1(A?, C?, E).

exported procedure rooted_of(Constant?, Preds).
rooted_of(Nm, E?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    decl_schemas(D?, C),
    rooted_in(C?, E).

exported procedure rooted_preds(Declared?, Preds).
rooted_preds(D, E?) :- ground(D?) |
    decl_schemas(D?, C),
    rooted_in(C?, E).

exported procedure rooted_variant(Constant?, Contract?, Preds).
rooted_variant(Nm, B, E?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    rooted_preds(D?, E).
