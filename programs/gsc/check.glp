% ---------------------------------------------------------------------------
% The verdict.
%
% A contract is decided by def:syntactically-grassroots of /Grassroots/GSC,
% Section 3.6, one definition for a contract of agent roles and listed roles
% (GSC ac7ad63): it passes when it has an unobstructed introductory act
% (def:introduction, def:unobstructed, unobstructed.glp), when the set of
% predicates occurring in it has traceable provenance (def:grounded,
% prov.glp), and when it satisfies volition (def:volition, volition.glp);
% the faults of the three conjuncts are reported together, in that order.
% The second conjunct is decided from the largest set of predicates having
% traceable provenance, which traceable_of gives: the fault names the
% predicates of the contract outside it, and volition is decided over that
% set.  A schema may carry values (the appendix "Values in Speech-Act Schemas"):
% the first conjunct is decided on the contract as written, an introduction
% choosing its own values (unobstructed.glp), and the other two on its plain
% form, a value naming no agent.
%
% A schema is a speech-act schema only when it is formed as def:role and
% def:schema require: its name terms based on its agent roles, its listed
% roles of its agent roles, +(i) and -(i) disjoint at every role, and
% +(i) u -(i) nonempty at every role that is not a guarding role and at some
% role, a guarding role being one that may add and delete nothing (def:schema
% and the sentence after its example); and only an agent role carries the
% mark ?.  A contract with a schema formed otherwise is malformed: it is
% refused, its verdict malformed(Faults), and no condition is decided for
% it.
%
% GAI's extension of the language (GAI's appendix "Contracts with Wards"):
% a contract may declare predicates of arity one reflexive, and then no
% schema of it adds or deletes, at a role, the atom of a reflexive predicate
% naming that role.  A contract in which one does is malformed too, the
% verdict naming each such schema, role and atom.  So is a contract with a
% schema whose signed term violates what GAI's Definition Speech-act schema
% requires of it -- that it occur only in an atom marked +, and that its
% speech-act variable occur in an atom its role requires -- or whose role is
% not an agent role.
%
% A contract whose first conjunct fails, and whose other two hold, may be
% grassroots with wards.  One with no community roles (self.glp) is decided
% by GAI's appendix "Contracts with Wards": when it has an introduction with
% wards (def:introduction-wards), the protocol realising it is volitionally
% grassroots (thm:grassroots-wards), and its verdict names the introductory
% act, the marks, their guardianships, the relay acts the search found and
% the leaving marks of the contract (def:leaving): with none the
% realisation is open and the protocol is grassroots as well (the paragraph
% after thm:grassroots-wards); with any, the paper claims it volitionally
% grassroots and no more.  One with community roles is decided by
% def:sg-wards of CSSN's paper, which composes GAI's appendix with GSC's
% conditions: an agent-named contract with an introduction with wards
% meeting it is syntactically_grassroots_with_wards(Act, Marks,
% Guardianships, Relays, Leaving).  Otherwise the faults are reported as
% before.
% ---------------------------------------------------------------------------

imported procedure unobstructed#intro_result_env(NContract?, Preds?, Preds?, Faults).
imported procedure unobstructed#intro_acts(NContract?, Preds?, IntroActs).
imported procedure prov#traceable(Contract?, Preds).
imported procedure prov#all_preds(Contract?, Preds).
imported procedure volition#volition_faults(Contract?, Preds?, Faults).
imported procedure wards#wards(Contract?, Preds?, Wards).
imported procedure wards#guardianships_for(Contract?, Preds?, Guardianships).
imported procedure wards#leaving_for(Contract?, Preds?, Leavings).
imported procedure wards#relay_h_for(Contract?, Preds?, Wards?, RelayHs).
imported procedure contracts#contract(Constant?, NDeclared).
imported procedure contracts#variant(Constant?, WContract?, WDeclared).

procedure verdict(Faults?, Verdict).
verdict([], syntactically_grassroots).
verdict([F|Fs], not_grassroots([F?|Fs?])).

% The second conjunct of def:syntactically-grassroots: every predicate of the
% contract is in the largest set having traceable provenance.
procedure untraceable_faults(Preds?, Faults).
untraceable_faults([], []).
untraceable_faults([P|Ps], [untraceable([P?|Ps?])]).

procedure check_contract(Contract?, NContract?, Preds?, Preds?, Verdict).
check_contract(C, NC, Rf, Ev, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?) |
    prov # traceable(C?, E),
    contract_verdict(C?, NC?, Rf?, Ev?, E?, V).

% E is read by two conjuncts, so it is taken ground in a head of its own.
% The first conjunct, def:unobstructed, is decided on the contract as
% written, NC (unobstructed.glp), the other two on its plain form, C.
procedure contract_verdict(Contract?, NContract?, Preds?, Preds?, Preds?, Verdict).
contract_verdict(C, NC, Rf, Ev, E, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?), ground(E?) |
    prov # all_preds(C?, Ps),
    preds_diff(Ps?, E?, Missing),
    untraceable_faults(Missing?, FT),
    unobstructed # intro_result_env(NC?, Rf?, Ev?, F1),
    volition # volition_faults(C?, E?, F2),
    faults_app(FT?, F2?, F23),
    wards_verdict(F1?, F23?, C?, Rf?, V).

% The first conjunct failing and the other two holding, the wards are tried
% (GAI's appendix "Contracts with Wards"; CSSN's def:sg-wards for a contract
% with community roles); otherwise the faults of the three conjuncts are
% reported, in their order.
procedure wards_verdict(Faults?, Faults?, Contract?, Preds?, Verdict).
wards_verdict([], F23, _, _, V?) :- ground(F23?) | verdict(F23?, V).
wards_verdict([F|Fs], [], C, Rf, V?) :-
    ground(F?), ground(Fs?), ground(C?), ground(Rf?) |
    wards_verdict2([F?|Fs?], C?, Rf?, V).
wards_verdict([F|Fs], [G|Gs], _, _, V?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Gs?) |
    faults_app([F?|Fs?], [G?|Gs?], FF),
    verdict(FF?, V).

procedure wards_verdict2(Faults?, Contract?, Preds?, Verdict).
wards_verdict2(F, C, Rf, V?) :- ground(F?), ground(C?), ground(Rf?) |
    has_community(C?, A),
    wards # wards(C?, Rf?, W),
    wards_verdict1(A?, W?, F?, V).

% A contract with no community roles that has an introduction with wards is
% grassroots with wards (GAI's appendix); one with community roles is
% syntactically grassroots with wards (CSSN's def:sg-wards, whose clauses 1
% and 2 the search of wards asks).
procedure wards_verdict1(Ans?, Wards?, Faults?, Verdict).
wards_verdict1(no, introduction_with_wards(Nm, M, Gs, Rs, Lv), _,
               grassroots_with_wards(Nm?, M?, Gs?, Rs?, Lv?)).
wards_verdict1(yes, introduction_with_wards(Nm, M, Gs, Rs, Lv), _,
               syntactically_grassroots_with_wards(Nm?, M?, Gs?, Rs?, Lv?)).
wards_verdict1(_, no_introduction_with_wards, F, not_grassroots(F?)).

% --- the name terms of a schema (def:role) ---------------------------------
% A name term of a schema is <pi> for an agent role pi of it, or sigma.y for
% a name term sigma of it, so its base is an agent role of the schema; each
% name term whose base is not is a fault name_term_base(Schema, NameTerm),
% once per name term.

procedure nts_remove(NameTerms?, NameTerm?, NameTerms).
nts_remove([], _, []).
nts_remove([N|Ns], M, R?) :- N? =?= M? | nts_remove(Ns?, M?, R).
nts_remove([N|Ns], M, [N?|R?]) :- otherwise, ground(N?) | nts_remove(Ns?, M?, R).

procedure nts_dedup(NameTerms?, NameTerms).
nts_dedup([], []).
nts_dedup([N|Ns], [N?|R?]) :- ground(N?), ground(Ns?) |
    nts_remove(Ns?, N?, Ns1),
    nts_dedup(Ns1?, R).

procedure nt_base_fault(Ans?, Constant?, NameTerm?, Faults?, Faults).
nt_base_fault(yes, _, _, T, T?).
nt_base_fault(no, Nm, S, T, [name_term_base(Nm?, S?)|T?]).

procedure nt_faults(NameTerms?, RoleSpecs?, Constant?, Faults).
nt_faults([], _, _, []).
nt_faults([S|Ns], Rs, Nm, R?) :- ground(S?), ground(Ns?), ground(Rs?), ground(Nm?) |
    nt_base(S?, B),
    base_agent_role(B?, Rs?, A),
    nt_faults(Ns?, Rs?, Nm?, R1),
    nt_base_fault(A?, Nm?, S?, R1?, R).

procedure nt_schema1(NameTerms?, RoleSpecs?, Constant?, Faults).
nt_schema1(Ns, Rs, Nm, R?) :- ground(Ns?), ground(Rs?), ground(Nm?) |
    nts_dedup(Ns?, Ns1),
    nt_faults(Ns1?, Rs?, Nm?, R).

procedure nt_schemas(Contract?, Faults).
nt_schemas([], []).
nt_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    sch_nts(S?, Ns),
    nt_schema1(Ns?, Rs?, Nm?, F1),
    nt_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the form of a schema (def:schema) -------------------------------------
% def:schema requires that +(i) and -(i) be disjoint, and that +(i) u -(i)
% be nonempty at every role that is not a guarding role and at some role.  Each atom a role both
% adds and deletes is a fault added_and_deleted(Schema, Role, Atom); each
% role that is not a guarding role and adds and deletes nothing a fault
% changes_nothing(Schema, Role); and a schema adding and deleting nothing at
% every role a fault no_role_changes(Schema), one per requirement violated.

procedure atoms_nonempty(Atoms?, Ans).
atoms_nonempty([], no).
atoms_nonempty([_|_], yes).

% The role adds or deletes an atom: +(i) u -(i) is nonempty.
procedure role_changes(RoleSpec?, Ans).
role_changes(RS, R?) :- ground(RS?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    atoms_app(P?, M?, PM),
    atoms_nonempty(PM?, R).

procedure roles_change1(Ans?, RoleSpecs?, Ans).
roles_change1(yes, _, yes).
roles_change1(no, Rs, R?) :- ground(Rs?) | roles_change(Rs?, R).

% Some role adds or deletes an atom.
procedure roles_change(RoleSpecs?, Ans).
roles_change([], no).
roles_change([RS|Rs], R?) :- ground(RS?), ground(Rs?) |
    role_changes(RS?, A),
    roles_change1(A?, Rs?, R).

% Each atom of Plus that Minus holds is added and deleted at the role.
procedure overlap_fault(Ans?, Atom?, Constant?, Integer?, Faults?, Faults).
overlap_fault(yes, A, Nm, I, T, [added_and_deleted(Nm?, I?, A?)|T?]).
overlap_fault(no, _, _, _, T, T?).

procedure overlap_faults(Atoms?, Atoms?, Constant?, Integer?, Faults?, Faults).
overlap_faults([], _, _, _, T, T?).
overlap_faults([A|As], M, Nm, I, T, R?) :-
    ground(A?), ground(As?), ground(M?), ground(Nm?), integer(I?), ground(T?) |
    atoms_member(M?, A?, In),
    overlap_faults(As?, M?, Nm?, I?, T?, R1),
    overlap_fault(In?, A?, Nm?, I?, R1?, R).

% A role that is not guarding (first argument no) and adds and deletes
% nothing (second argument no).
procedure inert_fault(Ans?, Ans?, Constant?, Integer?, Faults?, Faults).
inert_fault(no, no, Nm, I, T, [changes_nothing(Nm?, I?)|T?]).
inert_fault(no, yes, _, _, T, T?).
inert_fault(yes, _, _, _, T, T?).

% The requirement on +(i) u -(i) at a role.
procedure role_inert(RoleSpec?, Constant?, Integer?, Faults?, Faults).
role_inert(RS, Nm, I, T, R?) :-
    ground(RS?), ground(Nm?), integer(I?), ground(T?) |
    is_guarding(RS?, G0),
    is_often(RS?, O),
    either(G0?, O?, G),
    role_changes(RS?, C),
    inert_fault(G?, C?, Nm?, I?, T?, R).

% A role marked every_so_often may add and delete nothing, as a guarding role
% may (the experiment GFF-chooser; CHOOSER.md, "For GSC").
procedure either(Ans?, Ans?, Ans).
either(yes, _, yes).
either(no, B, B?).

procedure form_roles(RoleSpecs?, Integer?, Constant?, Faults).
form_roles([], _, _, []).
form_roles([RS|Rs], I, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    I1 := I? + 1,
    form_roles(Rs?, I1?, Nm?, R1),
    role_inert(RS?, Nm?, I?, R1?, R2a),
    received_fault(RS?, Nm?, I?, R2a?, R2),
    overlap_faults(P?, M?, Nm?, I?, R2?, R).

% A role marked received is the second role, requires nothing but identity,
% deletes nothing and forbids nothing, and only adds (Udi, 2026-10-28, reported
% by GFF #1 Cowork; CHOOSER.md, "For GSC"); a role marked received otherwise is
% the fault received_form(Schema, Role).
procedure received_fault(RoleSpec?, Constant?, Integer?, Faults?, Faults).
received_fault(rs(received, _, M, K, F), Nm, I, T, R?) :- ground(M?), ground(K?), ground(F?), integer(I?) |
    received_ok(I?, M?, K?, F?, Ok),
    received_fault1(Ok?, Nm?, I?, T?, R).
received_fault(_, _, _, T, T?) :- otherwise | true.

procedure received_ok(Integer?, Atoms?, Atoms?, Atoms?, Ans).
received_ok(2, [], [atom(identity, [])], [], yes).
received_ok(_, _, _, _, no) :- otherwise | true.

procedure received_fault1(Ans?, Constant?, Integer?, Faults?, Faults).
received_fault1(yes, _, _, T, T?).
received_fault1(no, Nm, I, T, [received_form(Nm?, I?)|T?]).

% Some role adds or deletes an atom.
procedure schema_change_fault(Ans?, Constant?, Faults).
schema_change_fault(no, Nm, [no_role_changes(Nm?)]).
schema_change_fault(yes, _, []).

procedure form_schema(Schema?, Faults).
form_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    form_schema2(Nm?, Rs?, R).

procedure form_schema2(Constant?, RoleSpecs?, Faults).
form_schema2(Nm, Rs, R?) :- ground(Nm?), ground(Rs?) |
    form_roles(Rs?, 1, Nm?, F1),
    roles_change(Rs?, Ch),
    schema_change_fault(Ch?, Nm?, F2),
    faults_app(F1?, F2?, R).

procedure form_schemas(Contract?, Faults).
form_schemas([], []).
form_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    form_schema(S?, F1),
    form_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- a contract declaring predicates reflexive (GAI, "Contracts with Wards")
% Each atom a role adds or deletes that is the atom of a reflexive predicate
% naming that role is a fault reflexive(Schema, Role, Atom).

procedure refl_atom_faults(Atoms?, Constant?, Integer?, Faults?, Faults).
refl_atom_faults([], _, _, T, T?).
refl_atom_faults([A|As], Nm, I, T, [reflexive(Nm?, I?, A?)|R?]) :-
    ground(As?), ground(Nm?), integer(I?), ground(T?) |
    refl_atom_faults(As?, Nm?, I?, T?, R).

procedure refl_roles(RoleSpecs?, Integer?, Constant?, Preds?, Faults).
refl_roles([], _, _, _, []).
refl_roles([RS|Rs], I, Nm, Rf, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(Rf?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    atoms_app(P?, M?, PM),
    refl_keep(PM?, I?, Rf?, yes, Own),
    I1 := I? + 1,
    refl_roles(Rs?, I1?, Nm?, Rf?, R1),
    refl_atom_faults(Own?, Nm?, I?, R1?, R).

procedure refl_schemas(Contract?, Preds?, Faults).
refl_schemas([], _, []).
refl_schemas([S|Ss], Rf, R?) :- ground(S?), ground(Ss?), ground(Rf?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    refl_roles(Rs?, 1, Nm?, Rf?, F1),
    refl_schemas(Ss?, Rf?, F2),
    faults_app(F1?, F2?, R).

% --- the signed terms of a schema (GAI, Definition Speech-act schema) -------------
% GAI's Definition Speech-act schema requires of a signed term sgn(y, pi) that it
% occur only in an atom marked +, and that its speech-act variable y occur in
% an atom its role pi requires; and that pi be an agent role, as GSC
% required of it until GSC 1a2a5f3 removed the signed term from GSC's
% language.  Each atom carrying a signed term that violates one of them is a
% fault signed(Schema, Role, Atom, Cause), not_added for the first,
% not_required for the second and not_agent_role for the third, one per
% requirement it violates.  A schema of agent roles has no fault of the
% third.

% The signed terms among the arguments of an atom.
procedure args_sgns(Args?, Args).
args_sgns([], []).
args_sgns([sgn(Y, J)|As], [sgn(Y?, J?)|R?]) :- ground(As?) | args_sgns(As?, R).
args_sgns([A|As], R?) :- otherwise, ground(A?), ground(As?) | args_sgns(As?, R).

% The atoms of Phis carrying a signed term, each a fault with the cause W.
procedure sgn_carrying(Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying([], _, _, _, T, T?).
sgn_carrying([atom(P, As)|Xs], Nm, I, W, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_carrying1(Ss?, atom(P?, As?), Xs?, Nm?, I?, W?, T?, R).

procedure sgn_carrying1(Args?, Atom?, Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying1([], _, Xs, Nm, I, W, T, R?) :-
    ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).
sgn_carrying1([_|_], A, Xs, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|R?]) :-
    ground(A?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).

% One added atom: for each signed term sgn(y, pi) it carries, the role pi
% requires an atom with y among its arguments.
procedure sgn_required(Args?, RoleSpecs?, Ans).
sgn_required([], _, yes).
sgn_required([sgn(Y, J)|Ss], Rs, R?) :-
    ground(Y?), integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    req_occurs(RS?, svar(Y?), A),
    sgn_required1(A?, Ss?, Rs?, R).
sgn_required([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_required(Ss?, Rs?, R).

procedure sgn_required1(Ans?, Args?, RoleSpecs?, Ans).
sgn_required1(no, _, _, no).
sgn_required1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_required(Ss?, Rs?, R).

procedure sgn_fault(Ans?, Atom?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_fault(yes, _, _, _, _, T, T?).
sgn_fault(no, A, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|T?]).

% For each signed term sgn(y, pi) among Args, pi is an agent role.
procedure sgn_agent1(Ans?, Args?, RoleSpecs?, Ans).
sgn_agent1(no, _, _, no).
sgn_agent1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_agent(Ss?, Rs?, R).

procedure sgn_agent(Args?, RoleSpecs?, Ans).
sgn_agent([], _, yes).
sgn_agent([sgn(_, J)|Ss], Rs, R?) :- integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    is_party_role(RS?, A),
    sgn_agent1(A?, Ss?, Rs?, R).
sgn_agent([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_agent(Ss?, Rs?, R).

procedure sgn_added1(Args?, Atom?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added1(Ss, A, Rs, Nm, I, T, R?) :-
    ground(Ss?), ground(A?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    sgn_agent(Ss?, Rs?, A0),
    sgn_required(Ss?, Rs?, A1),
    sgn_fault(A1?, A?, Nm?, I?, not_required, T?, R1),
    sgn_fault(A0?, A?, Nm?, I?, not_agent_role, R1?, R).

procedure sgn_added(Atoms?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added([], _, _, _, T, T?).
sgn_added([atom(P, As)|Xs], Rs, Nm, I, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_added(Xs?, Rs?, Nm?, I?, T?, R1),
    sgn_added1(Ss?, atom(P?, As?), Rs?, Nm?, I?, R1?, R).

% The roles of a schema: the two requirements at each.
procedure sgn_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Faults).
sgn_roles([], _, _, _, []).
sgn_roles([RS|Rs], I, All, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(All?), ground(Nm?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    rs_keep(RS?, K),
    rs_forb(RS?, N),
    atoms_app(K?, N?, KN),
    atoms_app(M?, KN?, MKN),
    I1 := I? + 1,
    sgn_roles(Rs?, I1?, All?, Nm?, R1),
    sgn_carrying(MKN?, Nm?, I?, not_added, R1?, R2),
    sgn_added(P?, All?, Nm?, I?, R2?, R).

procedure sgn_schema1(RoleSpecs?, Constant?, Faults).
sgn_schema1(Rs, Nm, R?) :- ground(Rs?), ground(Nm?) |
    sgn_roles(Rs?, 1, Rs?, Nm?, R).

procedure sgn_schema(Schema?, Faults).
sgn_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    sgn_schema1(Rs?, Nm?, R).

procedure sgn_schemas(Contract?, Faults).
sgn_schemas([], []).
sgn_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sgn_schema(S?, F1),
    sgn_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- a listed role (def:role, def:schema) ----------------------------------
% A listed role pi[rho(*, u_2, ..., u_r)] is of an agent role pi of its
% schema (def:role); listed(I, Rho, Args) whose role I is not an agent role
% of the schema is a fault listed_base(Schema, Role), Role the listed role.
% Its arguments u_2, ..., u_r are arguments of the schema, and a signed term,
% GAI's, occurs only in an atom marked +, so a signed term among them is a
% fault listed_signed(Schema, Role).  Only an agent role may carry the mark ?
% (def:schema), so a listed role carrying it is a fault
% listed_guarded(Schema, Role).

procedure listed_base_fault(Ans?, Constant?, Integer?, Faults?, Faults).
listed_base_fault(yes, _, _, T, T?).
listed_base_fault(no, Nm, J, T, [listed_base(Nm?, J?)|T?]).

procedure listed_signed_fault(Args?, Constant?, Integer?, Faults?, Faults).
listed_signed_fault([], _, _, T, T?).
listed_signed_fault([_|_], Nm, J, T, [listed_signed(Nm?, J?)|T?]).

procedure listed_guard_fault(Guard?, Constant?, Integer?, Faults?, Faults).
listed_guard_fault(unguarded, _, _, T, T?).
listed_guard_fault(every_so_often, Nm, J, T, [listed_often(Nm?, J?)|T?]).
listed_guard_fault(received, Nm, J, T, [received_form(Nm?, J?)|T?]).
listed_guard_fault(guarded, Nm, J, T, [listed_guarded(Nm?, J?)|T?]).

procedure listed_role_faults(RoleSpec?, Integer?, RoleSpecs?, Constant?, Faults?, Faults).
listed_role_faults(crs(listed(I, _, As), G, _, _, _, _), J, Rs, Nm, T, R?) :-
    integer(I?), ground(As?), ground(G?), integer(J?), ground(Rs?), ground(Nm?), ground(T?) |
    base_agent_role(b_role(I?), Rs?, A),
    args_sgns(As?, Ss),
    listed_guard_fault(G?, Nm?, J?, T?, R0),
    listed_signed_fault(Ss?, Nm?, J?, R0?, R1),
    listed_base_fault(A?, Nm?, J?, R1?, R).
listed_role_faults(RS, _, _, _, T, T?) :- otherwise, ground(RS?) | true.

procedure listed_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Faults).
listed_roles([], _, _, _, []).
listed_roles([RS|Rs], J, All, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(J?), ground(All?), ground(Nm?) |
    J1 := J? + 1,
    listed_roles(Rs?, J1?, All?, Nm?, R1),
    listed_role_faults(RS?, J?, All?, Nm?, R1?, R).

procedure listed_schema1(RoleSpecs?, Constant?, Faults).
listed_schema1(Rs, Nm, R?) :- ground(Rs?), ground(Nm?) |
    listed_roles(Rs?, 1, Rs?, Nm?, R).

procedure listed_schemas(Contract?, Faults).
listed_schemas([], []).
listed_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    listed_schema1(Rs?, Nm?, F1),
    listed_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the head of a schema (def:schema) -------------------------------------
% A schema lists its variables x_1, ..., x_m in its head, distinct agent and
% speech-act variables, and its atoms are over its roles, those variables
% and its signed terms (GSC 0228e79).  Each entry of the head that is not a
% variable is a fault head_not_variable(Schema, Entry), each entry listed
% before a fault head_repeated(Schema, Entry), and each variable occurring
% in the schema and not in its head a fault not_in_head(Schema, Var).

% A value variable, num(X) with X a name, is a variable of the head, and a
% number, num(X) with X a number, is not (GSC, Section 3.2).
procedure head_entry_fault(Arg?, Constant?, Faults?, Faults).
head_entry_fault(pvar(_), _, T, T?).
head_entry_fault(svar(_), _, T, T?).
head_entry_fault(num(X), Nm, T, [head_not_variable(Nm?, num(X?))|T?]) :-
    number(X?), ground(Nm?), ground(T?) | true.
head_entry_fault(num(_), _, T, T?) :- otherwise | true.
head_entry_fault(A, Nm, T, [head_not_variable(Nm?, A?)|T?]) :-
    otherwise, ground(A?), ground(Nm?), ground(T?) | true.

procedure head_rep_fault(Ans?, Arg?, Constant?, Faults?, Faults).
head_rep_fault(yes, A, Nm, T, [head_repeated(Nm?, A?)|T?]).
head_rep_fault(no, _, _, T, T?).

procedure head_entries(Args?, Args?, Constant?, Faults).
head_entries([], _, _, []).
head_entries([A|As], Seen, Nm, R?) :- ground(A?), ground(As?), ground(Seen?), ground(Nm?) |
    args_member(Seen?, A?, Rep),
    head_entries(As?, [A?|Seen?], Nm?, R1),
    head_rep_fault(Rep?, A?, Nm?, R1?, R2),
    head_entry_fault(A?, Nm?, R2?, R).

procedure unlisted_fault(Ans?, Arg?, Constant?, Faults?, Faults).
unlisted_fault(yes, _, _, T, T?).
unlisted_fault(no, V, Nm, T, [not_in_head(Nm?, V?)|T?]).

procedure unlisted_faults(Args?, Args?, Constant?, Faults).
unlisted_faults([], _, _, []).
unlisted_faults([V|Vs], H, Nm, R?) :- ground(V?), ground(Vs?), ground(H?), ground(Nm?) |
    args_member(H?, V?, In),
    unlisted_faults(Vs?, H?, Nm?, R1),
    unlisted_fault(In?, V?, Nm?, R1?, R).

procedure head_schema1(Constant?, Args?, Args?, Faults).
head_schema1(Nm, H, Os, R?) :- ground(Nm?), ground(H?), ground(Os?) |
    head_entries(H?, [], Nm?, F1),
    unlisted_faults(Os?, H?, Nm?, F2),
    faults_app(F1?, F2?, R).

% The head of a schema as written: its value variables occur in its atoms,
% its multiplicities and its constraint, and are listed in its head with its
% agent and speech-act variables (GSC, Section 3.2; Currencies' GB.glp).
procedure head_schema(NSchema?, Faults).
head_schema(S, R?) :- ground(S?) |
    nsch_name(S?, Nm),
    nsch_vars(S?, H),
    nsch_occ_vars(S?, Os),
    head_schema1(Nm?, H?, Os?, R).

procedure head_schemas(NContract?, Faults).
head_schemas([], []).
head_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    head_schema(S?, F1),
    head_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the values of a schema (GSC, Section 3.2; def:numbers) ----------------
% "An argument of an atom may be a value or a value variable, a schema may
% carry a constraint on its value variables, which every binding
% satisfies, and an atom added or deleted may carry a multiplicity, a count
% of copies and so a positive whole number" (Section 3.2; def:numbers).  Each
% atom carrying a multiplicity that a role requires or forbids and neither
% adds nor deletes is a fault multiplicity_not_added(Schema, Role, Atom); each
% multiplicity that is no value argument a fault
% multiplicity_not_numeric(Schema, Role, Atom); and each argument of the
% constraint that is no value argument a fault constraint_not_numeric(Schema,
% Arg).  A value argument is num(X), a value variable or a number.  The
% constraint "is a conjunction of linear equalities and inequalities over its
% value variables and values" (def:numbers): a disjunction in it is a fault
% constraint_not_conjunction(Schema, Or), and a product of two expressions
% each carrying a value variable a fault constraint_not_linear(Schema,
% Product).

procedure is_num(Arg?, Ans).
is_num(num(_), yes).
is_num(A, no) :- otherwise, ground(A?) | true.

% A multiplicity on an atom a role adds or deletes: it is a value argument.
procedure mult_num_fault(Ans?, Atom?, Constant?, Integer?, Faults?, Faults).
mult_num_fault(yes, _, _, _, T, T?).
mult_num_fault(no, A, Nm, I, T, [multiplicity_not_numeric(Nm?, I?, A?)|T?]).

procedure mults_numeric(Mults?, Constant?, Integer?, Faults?, Faults).
mults_numeric([], _, _, T, T?).
mults_numeric([atom(_, _)|Ms], Nm, I, T, R?) :-
    ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    mults_numeric(Ms?, Nm?, I?, T?, R).
mults_numeric([times(K, A)|Ms], Nm, I, T, R?) :-
    ground(K?), ground(A?), ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    is_num(K?, Ok),
    is_whole(K?, Wh),
    mults_numeric(Ms?, Nm?, I?, T?, R1),
    mult_whole_fault(Wh?, A?, Nm?, I?, R1?, R2),
    mult_num_fault(Ok?, A?, Nm?, I?, R2?, R).

% A multiplicity written as a number is a positive whole number
% (def:numbers); a value variable is one at every binding
% (def:binding-numbers).
procedure is_whole(Arg?, Ans).
is_whole(num(X), R?) :- number(X?) | pos_whole(X?, R).
is_whole(A, yes) :- otherwise, ground(A?) | true.

procedure mult_whole_fault(Ans?, Atom?, Constant?, Integer?, Faults?, Faults).
mult_whole_fault(yes, _, _, _, T, T?).
mult_whole_fault(no, A, Nm, I, T, [multiplicity_not_whole(Nm?, I?, A?)|T?]).

% A multiplicity on an atom a role requires or forbids only.
procedure mults_unadded(Mults?, Constant?, Integer?, Faults?, Faults).
mults_unadded([], _, _, T, T?).
mults_unadded([atom(_, _)|Ms], Nm, I, T, R?) :-
    ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    mults_unadded(Ms?, Nm?, I?, T?, R).
mults_unadded([times(_, A)|Ms], Nm, I, T, [multiplicity_not_added(Nm?, I?, A?)|R?]) :-
    ground(A?), ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    mults_unadded(Ms?, Nm?, I?, T?, R).

procedure num_roles(NRoleSpecs?, Integer?, Constant?, Faults).
num_roles([], _, _, []).
num_roles([RS|Rs], I, Nm, R?) :- ground(RS?), ground(Rs?), integer(I?), ground(Nm?) |
    nrs_add(RS?, P),
    nrs_del(RS?, M),
    nrs_keep(RS?, K),
    nrs_forb(RS?, N),
    mults_app(P?, M?, PM),
    mults_app(K?, N?, KN),
    I1 := I? + 1,
    num_roles(Rs?, I1?, Nm?, R1),
    mults_unadded(KN?, Nm?, I?, R1?, R2),
    mults_numeric(PM?, Nm?, I?, R2?, R).

procedure cons_num_fault(Ans?, Arg?, Constant?, Faults?, Faults).
cons_num_fault(yes, _, _, T, T?).
cons_num_fault(no, A, Nm, T, [constraint_not_numeric(Nm?, A?)|T?]).

procedure cons_faults(Args?, Constant?, Faults).
cons_faults([], _, []).
cons_faults([A|As], Nm, R?) :- ground(A?), ground(As?), ground(Nm?) |
    is_num(A?, Ok),
    cons_faults(As?, Nm?, R1),
    cons_num_fault(Ok?, A?, Nm?, R1?, R).

procedure num_schema(NSchema?, Faults).
num_schema(S, R?) :- ground(S?) |
    nsch_name(S?, Nm),
    nsch_roles(S?, Rs),
    nsch_constraint(S?, Cn),
    num_schema1(Nm?, Rs?, Cn?, R).

procedure num_schema1(Constant?, NRoleSpecs?, Constraint?, Faults).
num_schema1(Nm, Rs, Cn, R?) :- ground(Nm?), ground(Rs?), ground(Cn?) |
    num_roles(Rs?, 1, Nm?, F1),
    constraint_args(Cn?, [], As),
    cons_faults(As?, Nm?, F2),
    shape_faults(Cn?, Nm?, F3),
    faults_app(F2?, F3?, F23),
    faults_app(F1?, F23?, R).

% A value variable occurs in the expression.
procedure expr_var(Expr?, Ans).
expr_var(num(X), no) :- number(X?) | true.
expr_var(num(X), yes) :- otherwise, ground(X?) | true.
expr_var(plus(A, B), R?) :- ground(A?), ground(B?) |
    expr_var(A?, R1),
    expr_var(B?, R2),
    or_yes(R1?, R2?, R).
expr_var(minus(A, B), R?) :- ground(A?), ground(B?) |
    expr_var(A?, R1),
    expr_var(B?, R2),
    or_yes(R1?, R2?, R).
expr_var(mul(A, B), R?) :- ground(A?), ground(B?) |
    expr_var(A?, R1),
    expr_var(B?, R2),
    or_yes(R1?, R2?, R).
expr_var(X, no) :- otherwise, ground(X?) | true.

% Each product of two expressions that both carry a value variable.
procedure expr_faults(Expr?, Constant?, Faults?, Faults).
expr_faults(plus(A, B), Nm, T, R?) :- ground(A?), ground(B?), ground(Nm?), ground(T?) |
    expr_faults(B?, Nm?, T?, R1),
    expr_faults(A?, Nm?, R1?, R).
expr_faults(minus(A, B), Nm, T, R?) :- ground(A?), ground(B?), ground(Nm?), ground(T?) |
    expr_faults(B?, Nm?, T?, R1),
    expr_faults(A?, Nm?, R1?, R).
expr_faults(mul(A, B), Nm, T, R?) :- ground(A?), ground(B?), ground(Nm?), ground(T?) |
    expr_var(A?, VA),
    expr_var(B?, VB),
    both_yes(VA?, VB?, NL),
    expr_faults(B?, Nm?, T?, R1),
    expr_faults(A?, Nm?, R1?, R2),
    nonlin_fault(NL?, mul(A?, B?), Nm?, R2?, R).
expr_faults(X, _, T, T?) :- otherwise, ground(X?) | true.

procedure nonlin_fault(Ans?, Expr?, Constant?, Faults?, Faults).
nonlin_fault(yes, X, Nm, T, [constraint_not_linear(Nm?, X?)|T?]).
nonlin_fault(no, _, _, T, T?).

procedure exprs_faults(Exprs?, Constant?, Faults?, Faults).
exprs_faults([], _, T, T?).
exprs_faults([X|Xs], Nm, T, R?) :- ground(X?), ground(Xs?), ground(Nm?), ground(T?) |
    exprs_faults(Xs?, Nm?, T?, R1),
    expr_faults(X?, Nm?, R1?, R).

% The constraint is a conjunction of linear equalities and inequalities.
procedure shape_faults(Constraint?, Constant?, Faults).
shape_faults(true, _, []).
shape_faults(and(A, B), Nm, R?) :- ground(A?), ground(B?), ground(Nm?) |
    shape_faults(A?, Nm?, R1),
    shape_faults(B?, Nm?, R2),
    faults_app(R1?, R2?, R).
shape_faults(or(A, B), Nm, [constraint_not_conjunction(Nm?, or(A?, B?))]).
shape_faults(eq(X, Y), Nm, R?) :- ground(X?), ground(Y?), ground(Nm?) | exprs_faults([X?, Y?], Nm?, [], R).
shape_faults(le(X, Y), Nm, R?) :- ground(X?), ground(Y?), ground(Nm?) | exprs_faults([X?, Y?], Nm?, [], R).
shape_faults(lt(X, Y), Nm, R?) :- ground(X?), ground(Y?), ground(Nm?) | exprs_faults([X?, Y?], Nm?, [], R).
shape_faults(ge(X, Y), Nm, R?) :- ground(X?), ground(Y?), ground(Nm?) | exprs_faults([X?, Y?], Nm?, [], R).
shape_faults(gt(X, Y), Nm, R?) :- ground(X?), ground(Y?), ground(Nm?) | exprs_faults([X?, Y?], Nm?, [], R).
shape_faults(succ(_, _), _, []).

procedure num_schemas(NContract?, Faults).
num_schemas([], []).
num_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    num_schema(S?, F1),
    num_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% A malformed contract is refused; a contract that is not is decided by
% def:syntactically-grassroots.  The faults are given in the order: the
% head, the numbers, the name terms, the listed roles, the form of a schema,
% the reflexive predicates, the signed terms.  The head and the numbers are
% decided on the contract as written, the rest on its plain form (self.glp,
% plain_decl), and so are traceable provenance and volition;
% def:unobstructed is decided on the contract as written (unobstructed.glp).
procedure check_formed(Faults?, Contract?, NContract?, Preds?, Preds?, Verdict).
check_formed([], C, NC, Rf, Ev, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?) |
    check_contract(C?, NC?, Rf?, Ev?, V).
check_formed([F|Fs], _, _, _, _, malformed([F?|Fs?])).

procedure check_decl(Contract?, NContract?, Preds?, Preds?, Faults?, Verdict).
check_decl(C, NC, Rf, Ev, MHN, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?), ground(MHN?) |
    form_schemas(C?, M0),
    refl_schemas(C?, Rf?, M1),
    sgn_schemas(C?, M2),
    nt_schemas(C?, MT),
    listed_schemas(C?, ML),
    faults_app(M1?, M2?, M12),
    faults_app(ML?, M0?, ML0),
    faults_app(MT?, ML0?, MT0),
    faults_app(MHN?, MT0?, MH0),
    faults_app(MH0?, M12?, M),
    check_formed(M?, C?, NC?, Rf?, Ev?, V).

procedure check_ndecl(NContract?, Preds?, Preds?, Verdict).
check_ndecl(NC, Rf, Ev, V?) :- ground(NC?), ground(Rf?), ground(Ev?) |
    plain_contract(NC?, C),
    head_schemas(NC?, MH),
    num_schemas(NC?, MN),
    faults_app(MH?, MN?, MHN),
    check_decl(C?, NC?, Rf?, Ev?, MHN?, V).

exported procedure check(NDeclared?, Verdict).
check(D, V?) :- ground(D?) |
    ndecl_schemas(D?, NC),
    ndecl_reflexive(D?, Rf),
    check_ndecl(NC?, Rf?, [], V).

% The verdict on a contract naming environment predicates Ev (GSC 25b6b3c, the appendix "Values in Speech-Act Schemas": "an unobstructed introductory act requires no environment atom, clause 1 of Definition unobstructed admitting only atoms a schema adds, and forbids none"): an introductory act requiring or forbidding an atom of one is obstructed (unobstructed.glp, intro_result_env).
exported procedure check_env(NDeclared?, Preds?, Verdict).
check_env(D, Ev, V?) :- ground(D?), ground(Ev?) |
    ndecl_schemas(D?, NC),
    ndecl_reflexive(D?, Rf),
    check_ndecl(NC?, Rf?, Ev?, V).

exported procedure check_named(Constant?, Verdict).
check_named(Nm, V?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    check(D?, V).

% A fixture that changes a contract in one place, by name and the contract it
% changes (contracts.glp, variant/3).
exported procedure check_variant(Constant?, WContract?, Verdict).
check_variant(Nm, B, V?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, W),
    unnamed(W?, D),
    check(D?, V).

% The predicates of traceable provenance, for inspection: the largest set
% having it (def:grounded).
procedure traceable_in(Contract?, Preds).
traceable_in(C, E?) :- ground(C?) | prov # traceable(C?, E).

exported procedure traceable_of(Constant?, Preds).
traceable_of(Nm, E?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    traceable_preds(D?, E).

exported procedure traceable_preds(NDeclared?, Preds).
traceable_preds(D, E?) :- ground(D?) |
    plain_decl(D?, PD),
    traceable_pd(PD?, E).

procedure traceable_pd(Declared?, Preds).
traceable_pd(D, E?) :- ground(D?) |
    decl_schemas(D?, C),
    traceable_in(C?, E).

exported procedure traceable_variant(Constant?, WContract?, Preds).
traceable_variant(Nm, B, E?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, W),
    unnamed(W?, D),
    traceable_preds(D?, E).

% The introductory acts of a contract, for inspection (def:introduction,
% def:unobstructed): each schema that is an introductory act, in the order of
% the contract, unobstructed, or obstructed with the faults of its first
% introduction.  The verdict says that some introductory act is
% unobstructed; this says which.
exported procedure intro_acts(NDeclared?, IntroActs).
intro_acts(D, A?) :- ground(D?) |
    ndecl_schemas(D?, NC),
    ndecl_reflexive(D?, Rf),
    unobstructed # intro_acts(NC?, Rf?, A).

exported procedure intro_acts_variant(Constant?, WContract?, IntroActs).
intro_acts_variant(Nm, B, A?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, W),
    unnamed(W?, D),
    intro_acts(D?, A).

% The introduction with wards (GAI's appendix "Contracts with Wards"), for
% inspection, searched for whatever the verdict: what it found, or
% no_introduction_with_wards.  A contract with a name term not based on an
% agent role, which def:role admits not and check refuses, has none, GAI's
% appendix being written over the schemas of agent roles and def:sg-wards
% over those of an agent-named contract (CSSN's def:agent-named).
procedure wards2(Ans?, Contract?, Preds?, Wards).
wards2(yes, C, Rf, W?) :- ground(C?), ground(Rf?) | wards # wards(C?, Rf?, W).
wards2(no, _, _, no_introduction_with_wards).

procedure wards_in(Contract?, Preds?, Wards).
wards_in(C, Rf, W?) :- ground(C?), ground(Rf?) |
    agent_named(C?, A),
    wards2(A?, C?, Rf?, W).

exported procedure wards(NDeclared?, Wards).
wards(D, W?) :- ground(D?) |
    plain_decl(D?, PD),
    wards_pd(PD?, W).

procedure wards_pd(Declared?, Wards).
wards_pd(D, W?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    wards_in(C?, Rf?, W).

exported procedure wards_of(Constant?, Wards).
wards_of(Nm, W?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    wards(D?, W).

exported procedure wards_variant(Constant?, WContract?, Wards).
wards_variant(Nm, B, W?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, WD),
    unnamed(WD?, D),
    wards(D?, W).

% The atoms the relay acts of the introduction with wards require at their ward roles as atoms of a predicate h, admitted by that alternative of clause 2 of def:relay and by no other (GSC 410a440), each h(Schema, Role, H), for inspection: [] where there is no introduction with wards.
procedure relay_h1(Contract?, Preds?, RelayHs).
relay_h1(C, Rf, H?) :- ground(C?), ground(Rf?) |
    wards_in(C?, Rf?, W),
    wards # relay_h_for(C?, Rf?, W?, H).

exported procedure relay_h(NDeclared?, RelayHs).
relay_h(D, H?) :- ground(D?) |
    plain_decl(D?, PD),
    relay_h_pd(PD?, H).

procedure relay_h_pd(Declared?, RelayHs).
relay_h_pd(D, H?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    relay_h1(C?, Rf?, H).

% The guardianships for a set of marks M (def:guardianship), every one of
% each mark, for inspection.
exported procedure guardianships(NDeclared?, Preds?, Guardianships).
guardianships(D, M, G?) :- ground(D?), ground(M?) |
    plain_decl(D?, PD),
    guardianships_pd(PD?, M?, G).

procedure guardianships_pd(Declared?, Preds?, Guardianships).
guardianships_pd(D, M, G?) :- ground(D?), ground(M?) |
    decl_schemas(D?, C),
    wards # guardianships_for(C?, M?, G).

% The leaving marks of a contract for a set M of marks (def:leaving), for
% inspection: def:leaving supposes a guardianship for every mark in M, and
% its clause 3 reads the g of that guardianship, so the leaving marks are
% given for each choice of a guardianship for each mark, leaving(Gs, L).
exported procedure leaving(NDeclared?, Preds?, Leavings).
leaving(D, M, L?) :- ground(D?), ground(M?) |
    plain_decl(D?, PD),
    leaving_pd(PD?, M?, L).

procedure leaving_pd(Declared?, Preds?, Leavings).
leaving_pd(D, M, L?) :- ground(D?), ground(M?) |
    decl_schemas(D?, C),
    wards # leaving_for(C?, M?, L).

exported procedure leaving_of(Constant?, Preds?, Leavings).
leaving_of(Nm, M, L?) :- ground(Nm?), ground(M?) |
    contracts # contract(Nm?, D),
    leaving(D?, M?, L).
