% ---------------------------------------------------------------------------
% The verdict.
%
% A contract whose roles are all agent roles is the contract of
% /Grassroots/GSC, Section 3, and is decided by
% def:syntactically-grassroots: it passes when it has an unobstructed
% introductory act, when the set of predicates occurring in it has traceable
% provenance, and when it satisfies volition; the faults of the three
% conjuncts are reported together, in that order.  The second conjunct is
% decided from the largest set of predicates having traceable provenance,
% which traceable_of gives: the fault names the predicates of the contract
% outside it.  Volition is one condition in Section 3 and Appendix D, def:volition
% being definition:volition for a contract whose roles are all agent roles
% (Appendix D, after its Definition Volition), so the third conjunct is decided
% by community.glp's volition_faults, as Appendix D's volition is.
%
% A contract written in the language of Appendix D -- with a listed role, a
% name term or a schema written cschema -- that is agent-named (Appendix
% D.4, definition:agent-named: every name term based on an agent role of its
% schema, GSC f3c4f43) is decided by the four clauses of
% definition:sg-agent-named: an unobstructed introductory act with agent
% roles and no name term, the schemas of arity one of clause 1 of
% def:unobstructed having an agent role and no name term; no listed role
% adding an atom of a predicate the introductory act forbids at a role;
% traceable provenance of the set of predicates occurring in it, each atom
% psi required at an agent role; and volition (definition:volition), a
% listed role being no guarding role.  The faults of the four are reported
% together, in that order, the first two as the first conjunct of
% def:syntactically-grassroots is; a contract meeting them is
% syntactically_grassroots_with_listed_roles, and the protocol realising it
% is volitionally grassroots (Theorem "Grassroots realisation with listed
% roles").  When its first two clauses fail and the other two hold, the
% wards are tried: an agent-named contract with an introduction with wards
% that meets def:sg-wards (CSSN's paper, composing GAI's appendix "Contracts
% with Wards" with Appendix D.4) is syntactically_grassroots_with_wards(Act,
% Marks, Guardianships, Relays, Leaving).
%
% Any other contract with community roles, one with a name term based on an
% agent variable, is decided by the two conditions on the text of Appendix
% D: traceable provenance of the set of predicates occurring in it
% (definition:provenance) and volition (definition:volition), each of which
% it meets or fails; the faults of the two are reported together, in that
% order.  The first is decided from the largest set of predicates having
% traceable provenance, which traceable_of gives, as for a contract of
% Section 3.  Appendix D proves no theorem of such a contract, and nothing
% is claimed of it here.
%
% A schema is an act schema only when it is formed as def:schema, and
% Appendix D's Definition Act schema, require: +(i) and -(i) disjoint at
% every role, and +(i) u -(i) nonempty at every role that is not a guarding
% role and at some role, a guarding role being one that may add and delete
% nothing (def:schema and the sentence after its example); and only an agent
% role carries the mark ?.  A contract with a schema formed otherwise is
% malformed: it is refused, its verdict malformed(Faults), and no condition
% is decided for it.
%
% GAI's extension of the language (GAI's appendix "Contracts with Wards"):
% a contract may declare predicates of arity one reflexive, and then no
% schema of it adds or deletes, at a role, the atom of a reflexive predicate
% naming that role.  A contract in which one does is malformed too, the
% verdict naming each such schema, role and atom.  So is a contract with a
% schema whose signed term violates what GAI's Definition Act schema
% requires of it -- that it occur only in an atom marked +, and that its
% speech-act variable occur in an atom its role requires -- or whose role is
% not an agent role.
%
% A contract of Section 3 whose first conjunct fails may still be grassroots
% with wards (GAI's appendix "Contracts with Wards"): when it has an
% introduction with wards (def:introduction-wards), traceable provenance and
% volition, the protocol realising it is volitionally grassroots
% (thm:grassroots-wards), and its verdict names the introductory act, the
% marks, their guardianships, the relay acts the search found and the
% leaving marks of the contract (def:leaving): with none the realisation is
% open and the protocol is grassroots as well (the paragraph after
% thm:grassroots-wards); with any, the paper claims it volitionally
% grassroots and no more.  Otherwise the faults are reported as before.
% ---------------------------------------------------------------------------

imported procedure unobstructed#intro_result(Contract?, Preds?, Faults).
imported procedure unobstructed#intro_acts(Contract?, Preds?, IntroActs).
imported procedure prov#traceable(Contract?, Preds).
imported procedure prov#all_preds(Contract?, Preds).
imported procedure community#volition_faults(Contract?, Preds?, Faults).
imported procedure community#conditions(Contract?, Faults).
imported procedure community#traceable(Contract?, Preds).
imported procedure community#traceable_agent(Contract?, Preds).
imported procedure wards#wards(Contract?, Preds?, Wards).
imported procedure wards#guardianships_for(Contract?, Preds?, Guardianships).
imported procedure wards#leaving_for(Contract?, Preds?, Leavings).
imported procedure wards#relay_h_for(Contract?, Preds?, Wards?, RelayHs).
imported procedure contracts#contract(Constant?, Declared).
imported procedure contracts#variant(Constant?, Contract?, Declared).

procedure verdict(Faults?, Verdict).
verdict([], syntactically_grassroots).
verdict([F|Fs], not_grassroots([F?|Fs?])).

% The second conjunct of def:syntactically-grassroots: every predicate of the
% contract is in the largest set having traceable provenance.
procedure untraceable_faults(Preds?, Faults).
untraceable_faults([], []).
untraceable_faults([P|Ps], [untraceable([P?|Ps?])]).

procedure check_section3(Contract?, Preds?, Verdict).
check_section3(C, Rf, V?) :- ground(C?), ground(Rf?) |
    prov # traceable(C?, E),
    section3_verdict(C?, Rf?, E?, V).

% E is read by two conjuncts, so it is taken ground in a head of its own.
procedure section3_verdict(Contract?, Preds?, Preds?, Verdict).
section3_verdict(C, Rf, E, V?) :- ground(C?), ground(Rf?), ground(E?) |
    prov # all_preds(C?, Ps),
    preds_diff(Ps?, E?, Missing),
    untraceable_faults(Missing?, FT),
    unobstructed # intro_result(C?, Rf?, F1),
    community # volition_faults(C?, E?, F2),
    faults_app(FT?, F2?, F23),
    wards_verdict(F1?, F23?, C?, Rf?, V).

% The first conjunct failing and the other two holding, the wards are tried
% (GAI's appendix "Contracts with Wards"): a contract with an introduction
% with wards is grassroots with wards (def:introduction-wards,
% thm:grassroots-wards); otherwise the faults of the three conjuncts are
% reported as before, in their order.
procedure wards_verdict(Faults?, Faults?, Contract?, Preds?, Verdict).
wards_verdict([], F23, _, _, V?) :- ground(F23?) | verdict(F23?, V).
wards_verdict([F|Fs], [], C, Rf, V?) :-
    ground(F?), ground(Fs?), ground(C?), ground(Rf?) |
    wards # wards(C?, Rf?, W),
    wards_verdict1(W?, [F?|Fs?], V).
wards_verdict([F|Fs], [G|Gs], _, _, V?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Gs?) |
    faults_app([F?|Fs?], [G?|Gs?], FF),
    verdict(FF?, V).

procedure wards_verdict1(Wards?, Faults?, Verdict).
wards_verdict1(introduction_with_wards(Nm, M, Gs, Rs, Lv), _,
               grassroots_with_wards(Nm?, M?, Gs?, Rs?, Lv?)).
wards_verdict1(no_introduction_with_wards, F, not_grassroots(F?)).

procedure community_verdict(Faults?, Verdict).
community_verdict([], conditions_met).
community_verdict([F|Fs], conditions_failed([F?|Fs?])).

procedure check_appendix(Contract?, Verdict).
check_appendix(C, V?) :- ground(C?) |
    community # conditions(C?, F),
    community_verdict(F?, V).

% --- an agent-named contract (Appendix D.4, definition:sg-agent-named) ----
% Clause 3 is decided from the largest set of predicates having traceable
% provenance with each psi required at an agent role, E3, which traceable_of
% gives for such a contract: its fault names the predicates outside it.
% Clause 4 is definition:volition, its role graph over the predicates of
% traceable provenance of definition:provenance, E.  Clauses 1 and 2 are
% unobstructed.glp's, at each introductory act in turn.  Clauses 1 and 2
% failing and clauses 3 and 4 holding, the wards are tried, as for a
% contract of Section 3: an agent-named contract with an introduction with
% wards meeting def:sg-wards (CSSN's paper) is syntactically grassroots with
% wards; clause 1 of def:sg-wards, on the introductory act, the relay acts
% and the schemas of arity one, and its clause 2, on the listed roles, are
% asked in the search of wards, its clause 3 here.
procedure named_wards1(Wards?, Faults?, Verdict).
named_wards1(introduction_with_wards(Nm, M, Gs, Rs, Lv), _,
             syntactically_grassroots_with_wards(Nm?, M?, Gs?, Rs?, Lv?)).
named_wards1(no_introduction_with_wards, F, not_grassroots(F?)).

procedure named_verdict1(Faults?, Faults?, Contract?, Preds?, Verdict).
named_verdict1([], [], _, _, syntactically_grassroots_with_listed_roles).
named_verdict1([], [F|Fs], _, _, not_grassroots([F?|Fs?])).
named_verdict1([F|Fs], [], C, Rf, V?) :-
    ground(F?), ground(Fs?), ground(C?), ground(Rf?) |
    wards # wards(C?, Rf?, W),
    named_wards1(W?, [F?|Fs?], V).
named_verdict1([F|Fs], [G|Gs], _, _, V?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Gs?) |
    faults_app([F?|Fs?], [G?|Gs?], FF),
    verdict(FF?, V).

procedure named_verdict(Contract?, Preds?, Preds?, Preds?, Verdict).
named_verdict(C, Rf, E3, E, V?) :- ground(C?), ground(Rf?), ground(E3?), ground(E?) |
    prov # all_preds(C?, Ps),
    preds_diff(Ps?, E3?, Missing),
    untraceable_faults(Missing?, FT),
    unobstructed # intro_result(C?, Rf?, F12),
    community # volition_faults(C?, E?, F4),
    faults_app(FT?, F4?, F34),
    named_verdict1(F12?, F34?, C?, Rf?, V).

procedure check_agent_named(Contract?, Preds?, Verdict).
check_agent_named(C, Rf, V?) :- ground(C?), ground(Rf?) |
    community # traceable_agent(C?, E3),
    community # traceable(C?, E),
    named_verdict(C?, Rf?, E3?, E?, V).

procedure check_app1(Ans?, Contract?, Preds?, Verdict).
check_app1(yes, C, Rf, V?) :- ground(C?), ground(Rf?) | check_agent_named(C?, Rf?, V).
check_app1(no, C, _, V?) :- ground(C?) | check_appendix(C?, V).

procedure check1(Ans?, Contract?, Preds?, Verdict).
check1(no, C, Rf, V?) :- ground(C?), ground(Rf?) | check_section3(C?, Rf?, V).
check1(yes, C, Rf, V?) :- ground(C?), ground(Rf?) |
    agent_named(C?, A),
    check_app1(A?, C?, Rf?, V).

% --- the form of a schema (def:schema; Appendix D, Definition Act schema) --
% def:schema, and Appendix D's Definition Act schema (GSC 70afdc4), require
% that +(i) and -(i) be disjoint, and that +(i) u -(i) be nonempty at every
% role that is not a guarding role and at some role.  Each atom a role both
% adds and deletes is a fault added_and_deleted(Schema, Role, Atom); each
% role that is not a guarding role and adds and deletes nothing a fault
% changes_nothing(Schema, Role); and a schema adding and deleting nothing at
% every role a fault no_role_changes(Schema), one per requirement violated.

procedure atoms_nonempty(Atoms?, Ans).
atoms_nonempty([], no).
atoms_nonempty([_|_], yes).

% The role adds or deletes an atom: +(i) u -(i) is nonempty.
procedure role_changes(RoleSpec?, Ans).
role_changes(RS, R?) :- ground(RS?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    atoms_app(P?, M?, PM),
    atoms_nonempty(PM?, R).

procedure roles_change1(Ans?, RoleSpecs?, Ans).
roles_change1(yes, _, yes).
roles_change1(no, Rs, R?) :- ground(Rs?) | roles_change(Rs?, R).

% Some role adds or deletes an atom.
procedure roles_change(RoleSpecs?, Ans).
roles_change([], no).
roles_change([RS|Rs], R?) :- ground(RS?), ground(Rs?) |
    role_changes(RS?, A),
    roles_change1(A?, Rs?, R).

% Each atom of Plus that Minus holds is added and deleted at the role.
procedure overlap_fault(Ans?, Atom?, Constant?, Integer?, Faults?, Faults).
overlap_fault(yes, A, Nm, I, T, [added_and_deleted(Nm?, I?, A?)|T?]).
overlap_fault(no, _, _, _, T, T?).

procedure overlap_faults(Atoms?, Atoms?, Constant?, Integer?, Faults?, Faults).
overlap_faults([], _, _, _, T, T?).
overlap_faults([A|As], M, Nm, I, T, R?) :-
    ground(A?), ground(As?), ground(M?), ground(Nm?), integer(I?), ground(T?) |
    atoms_member(M?, A?, In),
    overlap_faults(As?, M?, Nm?, I?, T?, R1),
    overlap_fault(In?, A?, Nm?, I?, R1?, R).

% A role that is not guarding (first argument no) and adds and deletes
% nothing (second argument no).
procedure inert_fault(Ans?, Ans?, Constant?, Integer?, Faults?, Faults).
inert_fault(no, no, Nm, I, T, [changes_nothing(Nm?, I?)|T?]).
inert_fault(no, yes, _, _, T, T?).
inert_fault(yes, _, _, _, T, T?).

% The requirement on +(i) u -(i) at a role.
procedure role_inert(RoleSpec?, Constant?, Integer?, Faults?, Faults).
role_inert(RS, Nm, I, T, R?) :-
    ground(RS?), ground(Nm?), integer(I?), ground(T?) |
    is_guarding(RS?, G),
    role_changes(RS?, C),
    inert_fault(G?, C?, Nm?, I?, T?, R).

procedure form_roles(RoleSpecs?, Integer?, Constant?, Faults).
form_roles([], _, _, []).
form_roles([RS|Rs], I, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    I1 := I? + 1,
    form_roles(Rs?, I1?, Nm?, R1),
    role_inert(RS?, Nm?, I?, R1?, R2),
    overlap_faults(P?, M?, Nm?, I?, R2?, R).

% Some role adds or deletes an atom.
procedure schema_change_fault(Ans?, Constant?, Faults).
schema_change_fault(no, Nm, [no_role_changes(Nm?)]).
schema_change_fault(yes, _, []).

procedure form_schema(Schema?, Faults).
form_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    form_schema2(Nm?, Rs?, R).

procedure form_schema2(Constant?, RoleSpecs?, Faults).
form_schema2(Nm, Rs, R?) :- ground(Nm?), ground(Rs?) |
    form_roles(Rs?, 1, Nm?, F1),
    roles_change(Rs?, Ch),
    schema_change_fault(Ch?, Nm?, F2),
    faults_app(F1?, F2?, R).

procedure form_schemas(Contract?, Faults).
form_schemas([], []).
form_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    form_schema(S?, F1),
    form_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- a contract declaring predicates reflexive (GAI, "Contracts with Wards")
% Each atom a role adds or deletes that is the atom of a reflexive predicate
% naming that role is a fault reflexive(Schema, Role, Atom).

procedure refl_atom_faults(Atoms?, Constant?, Integer?, Faults?, Faults).
refl_atom_faults([], _, _, T, T?).
refl_atom_faults([A|As], Nm, I, T, [reflexive(Nm?, I?, A?)|R?]) :-
    ground(As?), ground(Nm?), integer(I?), ground(T?) |
    refl_atom_faults(As?, Nm?, I?, T?, R).

procedure refl_roles(RoleSpecs?, Integer?, Constant?, Preds?, Faults).
refl_roles([], _, _, _, []).
refl_roles([RS|Rs], I, Nm, Rf, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(Rf?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    atoms_app(P?, M?, PM),
    refl_keep(PM?, I?, Rf?, yes, Own),
    I1 := I? + 1,
    refl_roles(Rs?, I1?, Nm?, Rf?, R1),
    refl_atom_faults(Own?, Nm?, I?, R1?, R).

procedure refl_schemas(Contract?, Preds?, Faults).
refl_schemas([], _, []).
refl_schemas([S|Ss], Rf, R?) :- ground(S?), ground(Ss?), ground(Rf?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    refl_roles(Rs?, 1, Nm?, Rf?, F1),
    refl_schemas(Ss?, Rf?, F2),
    faults_app(F1?, F2?, R).

% --- the signed terms of a schema (GAI, Definition Act schema) -------------
% GAI's Definition Act schema requires of a signed term sgn(y, pi) that it
% occur only in an atom marked +, and that its speech-act variable y occur in
% an atom its role pi requires; and that pi be an agent role, as GSC's
% Appendix D required of it until GSC 1a2a5f3 removed the signed term from
% GSC's language.  Each atom carrying a signed term that violates one of
% them is a fault signed(Schema, Role, Atom, Cause), not_added for the first,
% not_required for the second and not_agent_role for the third, one per
% requirement it violates.  The roles of a schema of Section 3 are agent
% roles, so the third asks nothing of it.

% The signed terms among the arguments of an atom.
procedure args_sgns(Args?, Args).
args_sgns([], []).
args_sgns([sgn(Y, J)|As], [sgn(Y?, J?)|R?]) :- ground(As?) | args_sgns(As?, R).
args_sgns([A|As], R?) :- otherwise, ground(A?), ground(As?) | args_sgns(As?, R).

% The atoms of Phis carrying a signed term, each a fault with the cause W.
procedure sgn_carrying(Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying([], _, _, _, T, T?).
sgn_carrying([atom(P, As)|Xs], Nm, I, W, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_carrying1(Ss?, atom(P?, As?), Xs?, Nm?, I?, W?, T?, R).

procedure sgn_carrying1(Args?, Atom?, Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying1([], _, Xs, Nm, I, W, T, R?) :-
    ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).
sgn_carrying1([_|_], A, Xs, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|R?]) :-
    ground(A?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).

% One added atom: for each signed term sgn(y, pi) it carries, the role pi
% requires an atom with y among its arguments.
procedure sgn_required(Args?, RoleSpecs?, Ans).
sgn_required([], _, yes).
sgn_required([sgn(Y, J)|Ss], Rs, R?) :-
    ground(Y?), integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    req_occurs(RS?, svar(Y?), A),
    sgn_required1(A?, Ss?, Rs?, R).
sgn_required([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_required(Ss?, Rs?, R).

procedure sgn_required1(Ans?, Args?, RoleSpecs?, Ans).
sgn_required1(no, _, _, no).
sgn_required1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_required(Ss?, Rs?, R).

procedure sgn_fault(Ans?, Atom?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_fault(yes, _, _, _, _, T, T?).
sgn_fault(no, A, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|T?]).

% For each signed term sgn(y, pi) among Args, pi is an agent role.
procedure sgn_agent1(Ans?, Args?, RoleSpecs?, Ans).
sgn_agent1(no, _, _, no).
sgn_agent1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_agent(Ss?, Rs?, R).

procedure sgn_agent(Args?, RoleSpecs?, Ans).
sgn_agent([], _, yes).
sgn_agent([sgn(_, J)|Ss], Rs, R?) :- integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    is_party_role(RS?, A),
    sgn_agent1(A?, Ss?, Rs?, R).
sgn_agent([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_agent(Ss?, Rs?, R).

procedure sgn_added1(Args?, Atom?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added1(Ss, A, Rs, Nm, I, T, R?) :-
    ground(Ss?), ground(A?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    sgn_agent(Ss?, Rs?, A0),
    sgn_required(Ss?, Rs?, A1),
    sgn_fault(A1?, A?, Nm?, I?, not_required, T?, R1),
    sgn_fault(A0?, A?, Nm?, I?, not_agent_role, R1?, R).

procedure sgn_added(Atoms?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added([], _, _, _, T, T?).
sgn_added([atom(P, As)|Xs], Rs, Nm, I, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_added(Xs?, Rs?, Nm?, I?, T?, R1),
    sgn_added1(Ss?, atom(P?, As?), Rs?, Nm?, I?, R1?, R).

% The roles of a schema of Section 3: the two requirements at each.
procedure sgn_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Faults).
sgn_roles([], _, _, _, []).
sgn_roles([RS|Rs], I, All, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(All?), ground(Nm?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    rs_keep(RS?, K),
    rs_forb(RS?, N),
    atoms_app(K?, N?, KN),
    atoms_app(M?, KN?, MKN),
    I1 := I? + 1,
    sgn_roles(Rs?, I1?, All?, Nm?, R1),
    sgn_carrying(MKN?, Nm?, I?, not_added, R1?, R2),
    sgn_added(P?, All?, Nm?, I?, R2?, R).

procedure sgn_schema1(RoleSpecs?, Constant?, Faults).
sgn_schema1(Rs, Nm, R?) :- ground(Rs?), ground(Nm?) |
    sgn_roles(Rs?, 1, Rs?, Nm?, R).

procedure sgn_schema(Schema?, Faults).
sgn_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    sgn_schema1(Rs?, Nm?, R).

procedure sgn_schemas(Contract?, Faults).
sgn_schemas([], []).
sgn_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sgn_schema(S?, F1),
    sgn_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- a listed role (Appendix D, Definitions Role and Act schema) -----------
% A listed role pi[rho(*, u_2, ..., u_r)] is of an agent role pi of its
% schema; listed(I, Rho, Args) whose role I is not an agent role of the
% schema is a fault listed_base(Schema, Role), Role the listed role.  Its
% arguments u_2, ..., u_r are arguments of the schema, and a signed term
% occurs only in an atom marked +, so a signed term among them is a fault
% listed_signed(Schema, Role).  Only an agent role may carry the mark ?
% (Definition Act schema), so a listed role carrying it is a fault
% listed_guarded(Schema, Role).

procedure listed_base_fault(Ans?, Constant?, Integer?, Faults?, Faults).
listed_base_fault(yes, _, _, T, T?).
listed_base_fault(no, Nm, J, T, [listed_base(Nm?, J?)|T?]).

procedure listed_signed_fault(Args?, Constant?, Integer?, Faults?, Faults).
listed_signed_fault([], _, _, T, T?).
listed_signed_fault([_|_], Nm, J, T, [listed_signed(Nm?, J?)|T?]).

procedure listed_guard_fault(Guard?, Constant?, Integer?, Faults?, Faults).
listed_guard_fault(unguarded, _, _, T, T?).
listed_guard_fault(guarded, Nm, J, T, [listed_guarded(Nm?, J?)|T?]).

procedure listed_role_faults(RoleSpec?, Integer?, RoleSpecs?, Constant?, Faults?, Faults).
listed_role_faults(crs(listed(I, _, As), G, _, _, _, _), J, Rs, Nm, T, R?) :-
    integer(I?), ground(As?), ground(G?), integer(J?), ground(Rs?), ground(Nm?), ground(T?) |
    base_agent_role(b_role(I?), Rs?, A),
    args_sgns(As?, Ss),
    listed_guard_fault(G?, Nm?, J?, T?, R0),
    listed_signed_fault(Ss?, Nm?, J?, R0?, R1),
    listed_base_fault(A?, Nm?, J?, R1?, R).
listed_role_faults(RS, _, _, _, T, T?) :- otherwise, ground(RS?) | true.

procedure listed_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Faults).
listed_roles([], _, _, _, []).
listed_roles([RS|Rs], J, All, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(J?), ground(All?), ground(Nm?) |
    J1 := J? + 1,
    listed_roles(Rs?, J1?, All?, Nm?, R1),
    listed_role_faults(RS?, J?, All?, Nm?, R1?, R).

procedure listed_schema1(RoleSpecs?, Constant?, Faults).
listed_schema1(Rs, Nm, R?) :- ground(Rs?), ground(Nm?) |
    listed_roles(Rs?, 1, Rs?, Nm?, R).

procedure listed_schemas(Contract?, Faults).
listed_schemas([], []).
listed_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    listed_schema1(Rs?, Nm?, F1),
    listed_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the head of a schema (def:schema; Appendix D, Definition Act schema) ---
% A schema lists its variables x_1, ..., x_m in its head, distinct agent and
% speech-act variables, and its atoms are over its roles, those variables
% and its signed terms (GSC 0228e79).  Each entry of the head that is not a
% variable is a fault head_not_variable(Schema, Entry), each entry listed
% before a fault head_repeated(Schema, Entry), and each variable occurring
% in the schema and not in its head a fault not_in_head(Schema, Var).

procedure head_entry_fault(Arg?, Constant?, Faults?, Faults).
head_entry_fault(pvar(_), _, T, T?).
head_entry_fault(svar(_), _, T, T?).
head_entry_fault(A, Nm, T, [head_not_variable(Nm?, A?)|T?]) :-
    otherwise, ground(A?), ground(Nm?), ground(T?) | true.

procedure head_rep_fault(Ans?, Arg?, Constant?, Faults?, Faults).
head_rep_fault(yes, A, Nm, T, [head_repeated(Nm?, A?)|T?]).
head_rep_fault(no, _, _, T, T?).

procedure head_entries(Args?, Args?, Constant?, Faults).
head_entries([], _, _, []).
head_entries([A|As], Seen, Nm, R?) :- ground(A?), ground(As?), ground(Seen?), ground(Nm?) |
    args_member(Seen?, A?, Rep),
    head_entries(As?, [A?|Seen?], Nm?, R1),
    head_rep_fault(Rep?, A?, Nm?, R1?, R2),
    head_entry_fault(A?, Nm?, R2?, R).

procedure unlisted_fault(Ans?, Arg?, Constant?, Faults?, Faults).
unlisted_fault(yes, _, _, T, T?).
unlisted_fault(no, V, Nm, T, [not_in_head(Nm?, V?)|T?]).

procedure unlisted_faults(Args?, Args?, Constant?, Faults).
unlisted_faults([], _, _, []).
unlisted_faults([V|Vs], H, Nm, R?) :- ground(V?), ground(Vs?), ground(H?), ground(Nm?) |
    args_member(H?, V?, In),
    unlisted_faults(Vs?, H?, Nm?, R1),
    unlisted_fault(In?, V?, Nm?, R1?, R).

procedure head_schema1(Constant?, Args?, Args?, Faults).
head_schema1(Nm, H, Os, R?) :- ground(Nm?), ground(H?), ground(Os?) |
    head_entries(H?, [], Nm?, F1),
    unlisted_faults(Os?, H?, Nm?, F2),
    faults_app(F1?, F2?, R).

procedure head_schema(Schema?, Faults).
head_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_vars(S?, H),
    sch_occ_vars(S?, Os),
    head_schema1(Nm?, H?, Os?, R).

procedure head_schemas(Contract?, Faults).
head_schemas([], []).
head_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    head_schema(S?, F1),
    head_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% A malformed contract is refused; a contract that is not is decided by
% Section 3 or by Appendix D, according to its roles.  The faults are given
% in the order: the head, the listed roles, the form of a schema, the
% reflexive predicates, the signed terms.
procedure check_formed(Faults?, Ans?, Contract?, Preds?, Verdict).
check_formed([], A, C, Rf, V?) :- ground(A?), ground(C?), ground(Rf?) |
    check1(A?, C?, Rf?, V).
check_formed([F|Fs], _, _, _, malformed([F?|Fs?])).

procedure check_decl(Contract?, Preds?, Verdict).
check_decl(C, Rf, V?) :- ground(C?), ground(Rf?) |
    has_community(C?, A),
    form_schemas(C?, M0),
    refl_schemas(C?, Rf?, M1),
    sgn_schemas(C?, M2),
    head_schemas(C?, MH),
    listed_schemas(C?, ML),
    faults_app(M1?, M2?, M12),
    faults_app(ML?, M0?, ML0),
    faults_app(MH?, ML0?, MH0),
    faults_app(MH0?, M12?, M),
    check_formed(M?, A?, C?, Rf?, V).

exported procedure check(Declared?, Verdict).
check(D, V?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    check_decl(C?, Rf?, V).

exported procedure check_named(Constant?, Verdict).
check_named(Nm, V?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    check(D?, V).

% A fixture that changes a contract in one place, by name and the contract it
% changes (contracts.glp, variant/3).
exported procedure check_variant(Constant?, Contract?, Verdict).
check_variant(Nm, B, V?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    check(D?, V).

% The predicates of traceable provenance, for inspection: def:grounded for a
% contract of Section 3, definition:provenance with each psi required at an
% agent role for an agent-named contract with community roles (clause 3 of
% definition:sg-agent-named), and definition:provenance for any other.
procedure traceable2(Ans?, Contract?, Preds).
traceable2(yes, C, E?) :- ground(C?) | community # traceable_agent(C?, E).
traceable2(no, C, E?) :- ground(C?) | community # traceable(C?, E).

procedure traceable1(Ans?, Contract?, Preds).
traceable1(no, C, E?) :- ground(C?) | prov # traceable(C?, E).
traceable1(yes, C, E?) :- ground(C?) |
    agent_named(C?, A),
    traceable2(A?, C?, E).

procedure traceable_in(Contract?, Preds).
traceable_in(C, E?) :- ground(C?) |
    has_community(C?, A),
    traceable1(A?, C?, E).

exported procedure traceable_of(Constant?, Preds).
traceable_of(Nm, E?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    decl_schemas(D?, C),
    traceable_in(C?, E).

exported procedure traceable_preds(Declared?, Preds).
traceable_preds(D, E?) :- ground(D?) |
    decl_schemas(D?, C),
    traceable_in(C?, E).

exported procedure traceable_variant(Constant?, Contract?, Preds).
traceable_variant(Nm, B, E?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    traceable_preds(D?, E).

% The introductory acts of a contract, for inspection (def:introduction,
% def:unobstructed): each schema that is an introductory act, in the order of
% the contract, unobstructed, or obstructed with the faults of its first
% introduction.  The verdict says that some introductory act is
% unobstructed; this says which.
exported procedure intro_acts(Declared?, IntroActs).
intro_acts(D, A?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    unobstructed # intro_acts(C?, Rf?, A).

exported procedure intro_acts_variant(Constant?, Contract?, IntroActs).
intro_acts_variant(Nm, B, A?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    intro_acts(D?, A).

% The introduction with wards (GAI's appendix "Contracts with Wards"), for
% inspection, searched for whatever the verdict: what it found, or
% no_introduction_with_wards.  A contract with community roles that is not
% agent-named has none, GAI's appendix being written over the schemas of
% Section 3 and def:sg-wards over those of an agent-named contract.
procedure wards2(Ans?, Contract?, Preds?, Wards).
wards2(yes, C, Rf, W?) :- ground(C?), ground(Rf?) | wards # wards(C?, Rf?, W).
wards2(no, _, _, no_introduction_with_wards).

procedure wards1(Ans?, Contract?, Preds?, Wards).
wards1(no, C, Rf, W?) :- ground(C?), ground(Rf?) | wards # wards(C?, Rf?, W).
wards1(yes, C, Rf, W?) :- ground(C?), ground(Rf?) |
    agent_named(C?, A),
    wards2(A?, C?, Rf?, W).

procedure wards_in(Contract?, Preds?, Wards).
wards_in(C, Rf, W?) :- ground(C?), ground(Rf?) |
    has_community(C?, A),
    wards1(A?, C?, Rf?, W).

exported procedure wards(Declared?, Wards).
wards(D, W?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    wards_in(C?, Rf?, W).

exported procedure wards_of(Constant?, Wards).
wards_of(Nm, W?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    wards(D?, W).

exported procedure wards_variant(Constant?, Contract?, Wards).
wards_variant(Nm, B, W?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    wards(D?, W).

% The atoms the relay acts of the introduction with wards require at their ward roles as atoms of a predicate h, admitted by that alternative of clause 2 of def:relay and by no other (GSC 410a440), each h(Schema, Role, H), for inspection: [] where there is no introduction with wards.
procedure relay_h1(Contract?, Preds?, RelayHs).
relay_h1(C, Rf, H?) :- ground(C?), ground(Rf?) |
    wards_in(C?, Rf?, W),
    wards # relay_h_for(C?, Rf?, W?, H).

exported procedure relay_h(Declared?, RelayHs).
relay_h(D, H?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    relay_h1(C?, Rf?, H).

% The guardianships for a set of marks M (def:guardianship), every one of
% each mark, for inspection.
exported procedure guardianships(Declared?, Preds?, Guardianships).
guardianships(D, M, G?) :- ground(D?), ground(M?) |
    decl_schemas(D?, C),
    wards # guardianships_for(C?, M?, G).

% The leaving marks of a contract for a set M of marks (def:leaving), for
% inspection: def:leaving supposes a guardianship for every mark in M, and
% its clause 3 reads the g of that guardianship, so the leaving marks are
% given for each choice of a guardianship for each mark, leaving(Gs, L).
exported procedure leaving(Declared?, Preds?, Leavings).
leaving(D, M, L?) :- ground(D?), ground(M?) |
    decl_schemas(D?, C),
    wards # leaving_for(C?, M?, L).

exported procedure leaving_of(Constant?, Preds?, Leavings).
leaving_of(Nm, M, L?) :- ground(Nm?), ground(M?) |
    contracts # contract(Nm?, D),
    leaving(D?, M?, L).
