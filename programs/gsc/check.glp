% ---------------------------------------------------------------------------
% The verdict.
%
% A contract is decided by def:syntactically-grassroots of /Grassroots/GSC,
% Section 3.6, one definition for a contract of agent roles and listed roles
% (GSC ac7ad63): it passes when it has an unobstructed introductory act
% (def:introduction, def:unobstructed, unobstructed.glp), when the set of
% predicates occurring in it has traceable provenance (def:grounded,
% prov.glp), and when it satisfies volition (def:volition, volition.glp);
% the faults of the three conjuncts are reported together, in that order.
% The second conjunct is decided from the largest set of predicates having
% traceable provenance, which traceable_of gives: the fault names the
% predicates of the contract outside it, and volition is decided over that
% set.  A schema may carry values (the appendix "Values in Speech-Act Schemas"):
% the first conjunct is decided on the contract as written, an introduction
% choosing its own values (unobstructed.glp), and the other two on its plain
% form, a value naming no agent.
%
% A schema is a speech-act schema only when it is formed as def:role and
% def:schema require: its name terms over its agent variables, its listed
% roles of its agent roles, and +(i) u -(i) nonempty at some role, a role
% that is not a guarding role and adds and deletes nothing being a reading
% role, which def:volition decides (def:schema; GSC 0380a8a).  Definition
% Denotation's proviso that what is added at an agent is disjoint from what
% is deleted there is decided at a transaction, and is no condition on the
% text (GSC f5b3f06).  A contract with a schema formed otherwise is malformed: it is
% refused, its verdict malformed(Faults), and no condition is decided for
% it.
%
% GAI's extension of the language (GAI's appendix "Contracts with Wards"):
% a contract may declare predicates of arity one reflexive, and then no
% schema of it adds or deletes, at a role, the atom of a reflexive predicate
% naming that role.  A contract in which one does is malformed too, the
% verdict naming each such schema, role and atom.  So is a contract with a
% schema whose signed term violates what GAI's Definition Speech-act schema
% requires of it -- that it occur only in an atom marked +, and that its
% speech-act variable occur in an atom its role requires -- or whose role is
% not an agent role.
%
% A contract whose first conjunct fails, and whose other two hold, may be
% grassroots with wards.  One with no community roles (self.glp) is decided
% by GSC's Section 8, "Contracts with Wards" (GSC 7e00aba): when it has an
% introduction with wards (def:introduction-wards), the protocol realising it
% is volitionally grassroots (thm:grassroots-wards), and its verdict names
% the introductory act, the ward marks M, their guardianships, the relay acts
% the search found and [iota, f] of its kinds (iota, f, M) (def:kinds).  One
% with community roles is decided by def:sg-wards of CSSN's paper, which
% composes Section 8 with GSC's conditions: an agent-named contract with an
% introduction with wards meeting it is
% syntactically_grassroots_with_wards(Act, Marks, Guardianships, Relays,
% [Iota, F]).  Otherwise the faults are reported as before.
% ---------------------------------------------------------------------------

imported procedure unobstructed#intro_result_env(NContract?, Preds?, Preds?, Faults).
imported procedure unobstructed#intro_acts(NContract?, Preds?, IntroActs).
imported procedure prov#traceable_c(Contract?, Constraints?, Preds).
imported procedure prov#traceable_env(Contract?, Constraints?, Preds?, Preds).
imported procedure prov#all_preds(Contract?, Preds).
imported procedure volition#volition_faults(Contract?, NContract?, Preds?, Faults).
imported procedure wards#wards(Contract?, Preds?, Wards).
imported procedure wards#guardianships_for(Contract?, Preds?, Preds?, Guardianships).
imported procedure wards#relay_h_for(Contract?, Preds?, Wards?, RelayHs).
imported procedure contracts#contract(Constant?, NDeclared).
imported procedure contracts#variant(Constant?, WContract?, WDeclared).

procedure verdict(Faults?, Verdict).
verdict([], syntactically_grassroots).
verdict([F|Fs], not_grassroots([F?|Fs?])).

% The second conjunct of def:syntactically-grassroots: every predicate of the
% contract other than its environment predicates is in the largest set having
% traceable provenance (GSC a380dab: "the set of predicates occurring in it
% other than its environment predicates has traceable provenance").
procedure untraceable_faults(Preds?, Faults).
untraceable_faults([], []).
untraceable_faults([P|Ps], [untraceable([P?|Ps?])]).

procedure check_contract(Contract?, NContract?, Preds?, Preds?, Verdict).
check_contract(C, NC, Rf, Ev, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?) |
    ncontract_constraints(NC?, Cns),
    prov # traceable_env(C?, Cns?, Ev?, E),
    contract_verdict(C?, NC?, Rf?, Ev?, E?, V).

% E is read by two conjuncts, so it is taken ground in a head of its own.
% The first conjunct, def:unobstructed, is decided on the contract as
% written, NC (unobstructed.glp), the other two on its plain form, C.
procedure contract_verdict(Contract?, NContract?, Preds?, Preds?, Preds?, Verdict).
contract_verdict(C, NC, Rf, Ev, E, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?), ground(E?) |
    prov # all_preds(C?, Ps),
    preds_diff(Ps?, Ev?, Ps1),
    preds_diff(Ps1?, E?, Missing),
    untraceable_faults(Missing?, FT),
    unobstructed # intro_result_env(NC?, Rf?, Ev?, F1),
    volition # volition_faults(C?, NC?, E?, F2),
    faults_app(FT?, F2?, F23),
    wards_verdict(F1?, F23?, C?, Rf?, V).

% The first conjunct failing and the other two holding, the wards are tried
% (GAI's appendix "Contracts with Wards"; CSSN's def:sg-wards for a contract
% with community roles); otherwise the faults of the three conjuncts are
% reported, in their order.
procedure wards_verdict(Faults?, Faults?, Contract?, Preds?, Verdict).
wards_verdict([], F23, _, _, V?) :- ground(F23?) | verdict(F23?, V).
wards_verdict([F|Fs], [], C, Rf, V?) :-
    ground(F?), ground(Fs?), ground(C?), ground(Rf?) |
    wards_verdict2([F?|Fs?], C?, Rf?, V).
wards_verdict([F|Fs], [G|Gs], _, _, V?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Gs?) |
    faults_app([F?|Fs?], [G?|Gs?], FF),
    verdict(FF?, V).

procedure wards_verdict2(Faults?, Contract?, Preds?, Verdict).
wards_verdict2(F, C, Rf, V?) :- ground(F?), ground(C?), ground(Rf?) |
    has_community(C?, A),
    wards # wards(C?, Rf?, W),
    wards_verdict1(A?, W?, F?, V).

% A contract with no community roles that has an introduction with wards is
% grassroots with wards (GAI's appendix); one with community roles is
% syntactically grassroots with wards (CSSN's def:sg-wards, whose clauses 1
% and 2 the search of wards asks).
procedure wards_verdict1(Ans?, Wards?, Faults?, Verdict).
wards_verdict1(no, introduction_with_wards(Nm, M, Gs, Rs, Lv), _,
               grassroots_with_wards(Nm?, M?, Gs?, Rs?, Lv?)).
wards_verdict1(yes, introduction_with_wards(Nm, M, Gs, Rs, Lv), _,
               syntactically_grassroots_with_wards(Nm?, M?, Gs?, Rs?, Lv?)).
wards_verdict1(_, no_introduction_with_wards, F, not_grassroots(F?)).

% --- the name terms of a schema (def:role) ---------------------------------
% A name term of a schema is <pi> for an agent variable pi of it, or sigma.y
% for a name term sigma of it (GSC f5b3f06).  own_var(X), <x>, is over a
% variable the head lists (not_in_head); own(I) over a role, and one over no
% role of the schema is a fault name_term_base(Schema, NameTerm), once per
% name term.

procedure nts_remove(NameTerms?, NameTerm?, NameTerms).
nts_remove([], _, []).
nts_remove([N|Ns], M, R?) :- N? =?= M? | nts_remove(Ns?, M?, R).
nts_remove([N|Ns], M, [N?|R?]) :- otherwise, ground(N?) | nts_remove(Ns?, M?, R).

procedure nts_dedup(NameTerms?, NameTerms).
nts_dedup([], []).
nts_dedup([N|Ns], [N?|R?]) :- ground(N?), ground(Ns?) |
    nts_remove(Ns?, N?, Ns1),
    nts_dedup(Ns1?, R).

procedure nt_base_fault(Ans?, Constant?, NameTerm?, Faults?, Faults).
nt_base_fault(yes, _, _, T, T?).
nt_base_fault(no, Nm, S, T, [name_term_base(Nm?, S?)|T?]).

procedure nt_faults(NameTerms?, RoleSpecs?, Constant?, Faults).
nt_faults([], _, _, []).
nt_faults([S|Ns], Rs, Nm, R?) :- ground(S?), ground(Ns?), ground(Rs?), ground(Nm?) |
    nt_base(S?, B),
    base_of_schema(B?, Rs?, A),
    nt_faults(Ns?, Rs?, Nm?, R1),
    nt_base_fault(A?, Nm?, S?, R1?, R).

% The base is an agent variable of the schema: a role of it, or a variable.
procedure base_of_schema(Base?, RoleSpecs?, Ans).
base_of_schema(b_role(I), Rs, R?) :- integer(I?), ground(Rs?) |
    roles_len(Rs?, K),
    in_range(I?, K?, R).
base_of_schema(_, _, yes) :- otherwise | true.

procedure in_range(Integer?, Integer?, Ans).
in_range(I, K, yes) :- I? >= 1, I? =< K? | true.
in_range(_, _, no) :- otherwise | true.

procedure nt_schema1(NameTerms?, RoleSpecs?, Constant?, Faults).
nt_schema1(Ns, Rs, Nm, R?) :- ground(Ns?), ground(Rs?), ground(Nm?) |
    nts_dedup(Ns?, Ns1),
    nt_faults(Ns1?, Rs?, Nm?, R).

procedure nt_schemas(Contract?, Faults).
nt_schemas([], []).
nt_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    sch_nts(S?, Ns),
    nt_schema1(Ns?, Rs?, Nm?, F1),
    nt_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the form of a schema (def:schema) -------------------------------------
% def:schema requires that +(i) u -(i) be nonempty at some role, -(i) the
% atoms marked - with no wildcard, so a cleared atom is no change a role
% makes there: a schema adding and deleting nothing at every role is a fault
% no_role_changes(Schema).  A role that is not a guarding role and adds and
% deletes nothing is a reading role (GSC 0380a8a), which def:schema admits
% and def:volition decides (volition.glp).

procedure atoms_nonempty(Atoms?, Ans).
atoms_nonempty([], no).
atoms_nonempty([_|_], yes).

% The role adds or deletes an atom: +(i) u -(i) is nonempty.
procedure role_changes(RoleSpec?, Ans).
role_changes(RS, R?) :- ground(RS?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    atoms_app(P?, M?, PM),
    atoms_nonempty(PM?, R).

procedure roles_change1(Ans?, RoleSpecs?, Ans).
roles_change1(yes, _, yes).
roles_change1(no, Rs, R?) :- ground(Rs?) | roles_change(Rs?, R).

% Some role adds or deletes an atom.
procedure roles_change(RoleSpecs?, Ans).
roles_change([], no).
roles_change([RS|Rs], R?) :- ground(RS?), ground(Rs?) |
    role_changes(RS?, A),
    roles_change1(A?, Rs?, R).

% Some role adds or deletes an atom.
procedure schema_change_fault(Ans?, Constant?, Faults).
schema_change_fault(no, Nm, [no_role_changes(Nm?)]).
schema_change_fault(yes, _, []).

procedure form_schema(Schema?, Faults).
form_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    form_schema2(Nm?, Rs?, R).

procedure form_schema2(Constant?, RoleSpecs?, Faults).
form_schema2(Nm, Rs, R?) :- ground(Nm?), ground(Rs?) |
    roles_change(Rs?, Ch),
    schema_change_fault(Ch?, Nm?, R).

procedure form_schemas(Contract?, Faults).
form_schemas([], []).
form_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    form_schema(S?, F1),
    form_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- a contract declaring predicates reflexive (GAI, "Contracts with Wards")
% Each atom a role adds or deletes that is the atom of a reflexive predicate
% naming that role is a fault reflexive(Schema, Role, Atom).

procedure refl_atom_faults(Atoms?, Constant?, Integer?, Faults?, Faults).
refl_atom_faults([], _, _, T, T?).
refl_atom_faults([A|As], Nm, I, T, [reflexive(Nm?, I?, A?)|R?]) :-
    ground(As?), ground(Nm?), integer(I?), ground(T?) |
    refl_atom_faults(As?, Nm?, I?, T?, R).

procedure refl_roles(RoleSpecs?, Integer?, Constant?, Preds?, Faults).
refl_roles([], _, _, _, []).
refl_roles([RS|Rs], I, Nm, Rf, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(Rf?) |
    rs_add(RS?, P),
    rs_marked_del(RS?, M),
    atoms_app(P?, M?, PM),
    refl_keep(PM?, I?, Rf?, yes, Own),
    I1 := I? + 1,
    refl_roles(Rs?, I1?, Nm?, Rf?, R1),
    refl_atom_faults(Own?, Nm?, I?, R1?, R).

procedure refl_schemas(Contract?, Preds?, Faults).
refl_schemas([], _, []).
refl_schemas([S|Ss], Rf, R?) :- ground(S?), ground(Ss?), ground(Rf?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    refl_roles(Rs?, 1, Nm?, Rf?, F1),
    refl_schemas(Ss?, Rf?, F2),
    faults_app(F1?, F2?, R).

% --- the signed terms of a schema (GAI, Definition Speech-act schema) -------------
% GAI's Definition Speech-act schema requires of a signed term sgn(y, pi) that it
% occur only in an atom marked +, and that its speech-act variable y occur in
% an atom its role pi requires; and that pi be an agent role, as GSC
% required of it until GSC 1a2a5f3 removed the signed term from GSC's
% language.  Each atom carrying a signed term that violates one of them is a
% fault signed(Schema, Role, Atom, Cause), not_added for the first,
% not_required for the second and not_agent_role for the third, one per
% requirement it violates.  A schema of agent roles has no fault of the
% third.

% The signed terms among the arguments of an atom.
procedure args_sgns(Args?, Args).
args_sgns([], []).
args_sgns([sgn(Y, J)|As], [sgn(Y?, J?)|R?]) :- ground(As?) | args_sgns(As?, R).
args_sgns([A|As], R?) :- otherwise, ground(A?), ground(As?) | args_sgns(As?, R).

% The atoms of Phis carrying a signed term, each a fault with the cause W.
procedure sgn_carrying(Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying([], _, _, _, T, T?).
sgn_carrying([atom(P, As)|Xs], Nm, I, W, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_carrying1(Ss?, atom(P?, As?), Xs?, Nm?, I?, W?, T?, R).

procedure sgn_carrying1(Args?, Atom?, Atoms?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_carrying1([], _, Xs, Nm, I, W, T, R?) :-
    ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).
sgn_carrying1([_|_], A, Xs, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|R?]) :-
    ground(A?), ground(Xs?), ground(Nm?), integer(I?), ground(W?), ground(T?) |
    sgn_carrying(Xs?, Nm?, I?, W?, T?, R).

% One added atom: for each signed term sgn(y, pi) it carries, the role pi
% requires an atom with y among its arguments.
procedure sgn_required(Args?, RoleSpecs?, Ans).
sgn_required([], _, yes).
sgn_required([sgn(Y, J)|Ss], Rs, R?) :-
    ground(Y?), integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    req_occurs(RS?, svar(Y?), A),
    sgn_required1(A?, Ss?, Rs?, R).
sgn_required([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_required(Ss?, Rs?, R).

procedure sgn_required1(Ans?, Args?, RoleSpecs?, Ans).
sgn_required1(no, _, _, no).
sgn_required1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_required(Ss?, Rs?, R).

procedure sgn_fault(Ans?, Atom?, Constant?, Integer?, SgnCause?, Faults?, Faults).
sgn_fault(yes, _, _, _, _, T, T?).
sgn_fault(no, A, Nm, I, W, T, [signed(Nm?, I?, A?, W?)|T?]).

% For each signed term sgn(y, pi) among Args, pi is an agent role.
procedure sgn_agent1(Ans?, Args?, RoleSpecs?, Ans).
sgn_agent1(no, _, _, no).
sgn_agent1(yes, Ss, Rs, R?) :- ground(Ss?), ground(Rs?) | sgn_agent(Ss?, Rs?, R).

procedure sgn_agent(Args?, RoleSpecs?, Ans).
sgn_agent([], _, yes).
sgn_agent([sgn(_, J)|Ss], Rs, R?) :- integer(J?), ground(Ss?), ground(Rs?) |
    nth_rs(Rs?, J?, RS),
    is_party_role(RS?, A),
    sgn_agent1(A?, Ss?, Rs?, R).
sgn_agent([A|Ss], Rs, R?) :- otherwise, ground(A?), ground(Ss?), ground(Rs?) |
    sgn_agent(Ss?, Rs?, R).

procedure sgn_added1(Args?, Atom?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added1(Ss, A, Rs, Nm, I, T, R?) :-
    ground(Ss?), ground(A?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    sgn_agent(Ss?, Rs?, A0),
    sgn_required(Ss?, Rs?, A1),
    sgn_fault(A1?, A?, Nm?, I?, not_required, T?, R1),
    sgn_fault(A0?, A?, Nm?, I?, not_agent_role, R1?, R).

procedure sgn_added(Atoms?, RoleSpecs?, Constant?, Integer?, Faults?, Faults).
sgn_added([], _, _, _, T, T?).
sgn_added([atom(P, As)|Xs], Rs, Nm, I, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(Rs?), ground(Nm?), integer(I?), ground(T?) |
    args_sgns(As?, Ss),
    sgn_added(Xs?, Rs?, Nm?, I?, T?, R1),
    sgn_added1(Ss?, atom(P?, As?), Rs?, Nm?, I?, R1?, R).

% The roles of a schema: the two requirements at each.
procedure sgn_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Faults).
sgn_roles([], _, _, _, []).
sgn_roles([RS|Rs], I, All, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(All?), ground(Nm?) |
    rs_add(RS?, P),
    rs_marked_del(RS?, M),
    rs_keep(RS?, K),
    rs_forb(RS?, N),
    atoms_app(K?, N?, KN),
    atoms_app(M?, KN?, MKN),
    I1 := I? + 1,
    sgn_roles(Rs?, I1?, All?, Nm?, R1),
    sgn_carrying(MKN?, Nm?, I?, not_added, R1?, R2),
    sgn_added(P?, All?, Nm?, I?, R2?, R).

procedure sgn_schema1(RoleSpecs?, Constant?, Faults).
sgn_schema1(Rs, Nm, R?) :- ground(Rs?), ground(Nm?) |
    sgn_roles(Rs?, 1, Rs?, Nm?, R).

procedure sgn_schema(Schema?, Faults).
sgn_schema(S, R?) :- ground(S?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    sgn_schema1(Rs?, Nm?, R).

procedure sgn_schemas(Contract?, Faults).
sgn_schemas([], []).
sgn_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sgn_schema(S?, F1),
    sgn_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- a listed role (def:role, def:schema) ----------------------------------
% A listed role is of an agent role of its schema, the holder of its anchor
% (def:role); listed(I, Rho, Args) whose role I is not one is a fault
% listed_base(Schema, Role), Role the listed role.  A signed term, GAI's,
% occurs only in an atom marked +, so one among its anchor's arguments is a
% fault listed_signed(Schema, Role).

procedure listed_base_fault(Ans?, Constant?, Integer?, Faults?, Faults).
listed_base_fault(yes, _, _, T, T?).
listed_base_fault(no, Nm, J, T, [listed_base(Nm?, J?)|T?]).

procedure listed_signed_fault(Args?, Constant?, Integer?, Faults?, Faults).
listed_signed_fault([], _, _, T, T?).
listed_signed_fault([_|_], Nm, J, T, [listed_signed(Nm?, J?)|T?]).

procedure listed_role_faults(RoleSpec?, Integer?, RoleSpecs?, Constant?, Faults?, Faults).
listed_role_faults(crs(listed(I, _, As), _, _, _, _, _), J, Rs, Nm, T, R?) :-
    integer(I?), ground(As?), integer(J?), ground(Rs?), ground(Nm?), ground(T?) |
    listed_role_faults1(I?, As?, J?, Rs?, Nm?, T?, R).
listed_role_faults(crs(qlisted(I, _, As, _), _, _, _, _, _), J, Rs, Nm, T, R?) :-
    integer(I?), ground(As?), integer(J?), ground(Rs?), ground(Nm?), ground(T?) |
    listed_role_faults1(I?, As?, J?, Rs?, Nm?, T?, R).
listed_role_faults(RS, _, _, _, T, T?) :- otherwise, ground(RS?) | true.

procedure listed_role_faults1(Integer?, Args?, Integer?, RoleSpecs?, Constant?, Faults?, Faults).
listed_role_faults1(I, As, J, Rs, Nm, T, R?) :-
    integer(I?), ground(As?), integer(J?), ground(Rs?), ground(Nm?), ground(T?) |
    base_agent_role(b_role(I?), Rs?, A),
    args_sgns(As?, Ss),
    listed_signed_fault(Ss?, Nm?, J?, T?, R1),
    listed_base_fault(A?, Nm?, J?, R1?, R).

procedure listed_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Faults).
listed_roles([], _, _, _, []).
listed_roles([RS|Rs], J, All, Nm, R?) :-
    ground(RS?), ground(Rs?), integer(J?), ground(All?), ground(Nm?) |
    J1 := J? + 1,
    listed_roles(Rs?, J1?, All?, Nm?, R1),
    listed_role_faults(RS?, J?, All?, Nm?, R1?, R).

procedure listed_schema1(RoleSpecs?, Constant?, Faults).
listed_schema1(Rs, Nm, R?) :- ground(Rs?), ground(Nm?) |
    listed_roles(Rs?, 1, Rs?, Nm?, R).

procedure listed_schemas(Contract?, Faults).
listed_schemas([], []).
listed_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    sch_name(S?, Nm),
    sch_roles(S?, Rs),
    listed_schema1(Rs?, Nm?, F1),
    listed_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the head of a schema (def:schema) -------------------------------------
% A schema lists its variables x_1, ..., x_m in its head, distinct agent and
% speech-act variables, and its atoms are over its roles, those variables
% and its signed terms (GSC 0228e79).  Each entry of the head that is not a
% variable is a fault head_not_variable(Schema, Entry), each entry listed
% before a fault head_repeated(Schema, Entry), and each variable occurring
% in the schema and not in its head a fault not_in_head(Schema, Var).

% A value variable, num(X) with X a name, is a variable of the head, and a
% number, num(X) with X a number, is not (GSC, Section 3.2).
procedure head_entry_fault(Arg?, Constant?, Faults?, Faults).
head_entry_fault(pvar(_), _, T, T?).
head_entry_fault(svar(_), _, T, T?).
head_entry_fault(num(X), Nm, T, [head_not_variable(Nm?, num(X?))|T?]) :-
    number(X?), ground(Nm?), ground(T?) | true.
head_entry_fault(num(_), _, T, T?) :- otherwise | true.
head_entry_fault(A, Nm, T, [head_not_variable(Nm?, A?)|T?]) :-
    otherwise, ground(A?), ground(Nm?), ground(T?) | true.

procedure head_rep_fault(Ans?, Arg?, Constant?, Faults?, Faults).
head_rep_fault(yes, A, Nm, T, [head_repeated(Nm?, A?)|T?]).
head_rep_fault(no, _, _, T, T?).

procedure head_entries(Args?, Args?, Constant?, Faults).
head_entries([], _, _, []).
head_entries([A|As], Seen, Nm, R?) :- ground(A?), ground(As?), ground(Seen?), ground(Nm?) |
    args_member(Seen?, A?, Rep),
    head_entries(As?, [A?|Seen?], Nm?, R1),
    head_rep_fault(Rep?, A?, Nm?, R1?, R2),
    head_entry_fault(A?, Nm?, R2?, R).

procedure unlisted_fault(Ans?, Arg?, Constant?, Faults?, Faults).
unlisted_fault(yes, _, _, T, T?).
unlisted_fault(no, V, Nm, T, [not_in_head(Nm?, V?)|T?]).

procedure unlisted_faults(Args?, Args?, Constant?, Faults).
unlisted_faults([], _, _, []).
unlisted_faults([V|Vs], H, Nm, R?) :- ground(V?), ground(Vs?), ground(H?), ground(Nm?) |
    args_member(H?, V?, In),
    unlisted_faults(Vs?, H?, Nm?, R1),
    unlisted_fault(In?, V?, Nm?, R1?, R).

% Bd the names its quantifiers bind, no variables of its head.
procedure head_schema1(Constant?, Args?, Args?, Args?, Faults).
head_schema1(Nm, H, Bd, Os, R?) :- ground(Nm?), ground(H?), ground(Bd?), ground(Os?) |
    head_entries(H?, [], Nm?, F1),
    args_app(H?, Bd?, HB),
    unlisted_faults(Os?, HB?, Nm?, F2),
    faults_app(F1?, F2?, R).

% The head of a schema as written: its value variables occur in its atoms,
% its multiplicities and its constraint, and are listed in its head with its
% agent and speech-act variables (GSC, Section 3.2; Currencies' GB.glp).
procedure head_schema(NSchema?, Faults).
head_schema(S, R?) :- ground(S?) |
    nsch_name(S?, Nm),
    nsch_vars(S?, H0),
    head_untyped(H0?, H),
    nsch_bound(S?, Bd),
    nsch_occ_vars(S?, Os),
    head_schema1(Nm?, H?, Bd?, Os?, R).

% A value variable's type is its head's, real(X) or num(X) (self.glp, Arg),
% and its atoms write num(X) of either, so the head is compared as num(X).
procedure head_untyped(Args?, Args).
head_untyped([], []).
head_untyped([real(X)|As], [num(X?)|R?]) :- head_untyped(As?, R).
head_untyped([A|As], [A?|R?]) :- otherwise | head_untyped(As?, R).

procedure head_schemas(NContract?, Faults).
head_schemas([], []).
head_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    head_schema(S?, F1),
    head_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the values of a schema (GSC, Section 3.2; def:numbers) ----------------
% "An atom of H or of B with no wildcard may carry a multiplicity kappa, a
% positive whole number or a value variable" (def:numbers): each atom
% carrying a multiplicity and the wildcard is a fault
% multiplicity_wildcard(Schema, Role, Atom); each multiplicity that is no
% value argument a fault multiplicity_not_numeric(Schema, Role, Atom), and a
% number no positive whole number a fault multiplicity_not_whole(Schema,
% Role, Atom).  Each argument of a constraint that is no value argument, but
% in an equality or inequality of two agent variables, two speech-act
% variables or two name terms (GSC 6f0bda1), is a fault
% constraint_not_numeric(Schema, Arg).  A constraint is otherwise "a decidable
% condition ... written in the relations and functions the types of the
% values provide", and no condition reads it (the appendix).  The same is
% asked of the safe formulas of a body and the conjuncts of a head, a role
% in a formula being any agent variable of it, and of each cardinality's and
% sum's anchored safe formula, as of a quantifier's (def:numbers, binding "as
% the anchored quantifiers ... do"; GSC #12, 2026-11-06 17:23 UTC): an agent
% is no value, so a term with an agent in it is no numeric term, and each
% such argument of a sum's term is constraint_not_numeric.

procedure is_num(Arg?, Ans).
is_num(num(_), yes).
is_num(A, no) :- otherwise, ground(A?) | true.

% A multiplicity on an atom a role adds or deletes: it is a value argument.
procedure mult_num_fault(Ans?, Atom?, Constant?, Integer?, Faults?, Faults).
mult_num_fault(yes, _, _, _, T, T?).
mult_num_fault(no, A, Nm, I, T, [multiplicity_not_numeric(Nm?, I?, A?)|T?]).

procedure mults_numeric(Mults?, Constant?, Integer?, Faults?, Faults).
mults_numeric([], _, _, T, T?).
mults_numeric([atom(_, _)|Ms], Nm, I, T, R?) :-
    ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    mults_numeric(Ms?, Nm?, I?, T?, R).
mults_numeric([times(K, A)|Ms], Nm, I, T, R?) :-
    ground(K?), ground(A?), ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    is_num(K?, Ok),
    is_whole(K?, Wh),
    mults_numeric(Ms?, Nm?, I?, T?, R1),
    mult_whole_fault(Wh?, A?, Nm?, I?, R1?, R2),
    mult_num_fault(Ok?, A?, Nm?, I?, R2?, R).
mults_numeric([rest(K, _, A)|Ms], Nm, I, T, R?) :-
    ground(K?), ground(A?), ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    rest_numeric(K?, A?, Nm?, I?, T?, R1),
    mults_numeric(Ms?, Nm?, I?, R1?, R).

% K of rest(K, J, A), a sum of multiplicities.
procedure rest_numeric(Expr?, Atom?, Constant?, Integer?, Faults?, Faults).
rest_numeric(plus(X, Y), A, Nm, I, T, R?) :-
    ground(X?), ground(Y?), ground(A?), ground(Nm?), integer(I?), ground(T?) |
    rest_numeric(Y?, A?, Nm?, I?, T?, R1),
    rest_numeric(X?, A?, Nm?, I?, R1?, R).
rest_numeric(num(K), A, Nm, I, T, R?) :- mults_numeric([times(num(K?), A?)], Nm?, I?, T?, R).
rest_numeric(_, _, _, _, T, T?) :- otherwise | true.

% A multiplicity written as a number is a positive whole number
% (def:numbers); a value variable is one at every binding
% (def:binding-numbers).
procedure is_whole(Arg?, Ans).
is_whole(num(X), R?) :- number(X?) | pos_whole(X?, R).
is_whole(A, yes) :- otherwise, ground(A?) | true.

procedure mult_whole_fault(Ans?, Atom?, Constant?, Integer?, Faults?, Faults).
mult_whole_fault(yes, _, _, _, T, T?).
mult_whole_fault(no, A, Nm, I, T, [multiplicity_not_whole(Nm?, I?, A?)|T?]).

% A multiplicity on an atom carrying the wildcard, Mults the atoms a role
% adds or deletes that carry it (mults_cleared).
procedure mults_wild(Mults?, Constant?, Integer?, Faults?, Faults).
mults_wild([], _, _, T, T?).
mults_wild([atom(_, _)|Ms], Nm, I, T, R?) :-
    ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    mults_wild(Ms?, Nm?, I?, T?, R).
mults_wild([times(_, A)|Ms], Nm, I, T, [multiplicity_wildcard(Nm?, I?, A?)|R?]) :-
    ground(A?), ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    mults_wild(Ms?, Nm?, I?, T?, R).
mults_wild([rest(_, _, A)|Ms], Nm, I, T, [multiplicity_wildcard(Nm?, I?, A?)|R?]) :-
    ground(A?), ground(Ms?), ground(Nm?), integer(I?), ground(T?) |
    mults_wild(Ms?, Nm?, I?, T?, R).

% The atoms a role adds or deletes, Mults, those carrying the wildcard and
% the others.
procedure mults_wild_split(Mults?, Mults, Mults).
mults_wild_split(Ms, W?, N?) :- ground(Ms?) |
    mults_cleared(Ms?, yes, W),
    mults_cleared(Ms?, no, N).

procedure num_roles(NRoleSpecs?, Integer?, Constant?, Faults).
num_roles([], _, _, []).
num_roles([RS|Rs], I, Nm, R?) :- ground(RS?), ground(Rs?), integer(I?), ground(Nm?) |
    nrs_add(RS?, P),
    nrs_marked_del(RS?, M),
    nrs_keep(RS?, K),
    nrs_forb(RS?, N),
    mults_app(P?, M?, PM),
    mults_app(PM?, K?, PMK),
    mults_app(PMK?, N?, All),
    I1 := I? + 1,
    num_roles(Rs?, I1?, Nm?, R1),
    num_mults(All?, I?, Nm?, R1?, R).

% The multiplicities of the atoms Ms at the role I.
procedure num_mults(Mults?, Integer?, Constant?, Faults?, Faults).
num_mults(Ms, I, Nm, T, R?) :- ground(Ms?), integer(I?), ground(Nm?), ground(T?) |
    mults_wild_split(Ms?, W, M1),
    mults_wild(W?, Nm?, I?, T?, R1),
    mults_numeric(M1?, Nm?, I?, R1?, R).

procedure cons_num_fault(Ans?, Arg?, Constant?, Faults?, Faults).
cons_num_fault(yes, _, _, T, T?).
cons_num_fault(no, A, Nm, T, [constraint_not_numeric(Nm?, A?)|T?]).

procedure cons_faults(Args?, Constant?, Faults).
cons_faults([], _, []).
cons_faults([A|As], Nm, R?) :- ground(A?), ground(As?), ground(Nm?) |
    is_num(A?, Ok),
    cons_faults(As?, Nm?, R1),
    cons_num_fault(Ok?, A?, Nm?, R1?, R).

procedure num_schema(NSchema?, Faults).
num_schema(S, R?) :- ground(S?) |
    nsch_name(S?, Nm),
    nsch_roles(S?, Rs),
    nsch_constraint(S?, Cn),
    nsch_conjs(S?, Cj),
    nsch_forms(S?, Fs),
    num_schema1(Nm?, Rs?, Cn?, Cj?, Fs?, R).

procedure num_schema1(Constant?, NRoleSpecs?, Constraint?, Conjuncts?, Forms?, Faults).
num_schema1(Nm, Rs, Cn, Cj, Fs, R?) :- ground(Nm?), ground(Rs?), ground(Cn?), ground(Cj?), ground(Fs?) |
    num_roles(Rs?, 1, Nm?, F1),
    cons_check(Cn?, Rs?, Nm?, F2),
    agents_all(Rs?, Rs1),
    conj_forms(Cj?, Fs?, All0),
    forms_anchored(All0?, [], An0),
    cons_anchored(Cn?, An0?, An),
    conj_forms(Cj?, Fs?, All1),
    forms_app(An?, All1?, All),
    forms_parts(All?, pp([], []), P),
    fp_parts(P?, Cs, Hs),
    conses_check(Cs?, Rs1?, Nm?, F3),
    hmults_check(Hs?, Nm?, [], F4),
    faults_app(F3?, F4?, F34),
    faults_app(F2?, F34?, F23),
    faults_app(F1?, F23?, R).

% One constraint: its arguments, and its signing conditions.
procedure cons_check(Constraint?, NRoleSpecs?, Constant?, Faults).
cons_check(Cn, Rs, Nm, R?) :- ground(Cn?), ground(Rs?), ground(Nm?) |
    constraint_args(Cn?, [], As),
    cons_faults(As?, Nm?, F1),
    signing_faults(Cn?, Rs?, Nm?, [], F2),
    faults_app(F1?, F2?, R).

procedure conses_check(Constraints?, NRoleSpecs?, Constant?, Faults).
conses_check([], _, _, []).
conses_check([C|Cs], Rs, Nm, R?) :- ground(C?), ground(Cs?), ground(Rs?), ground(Nm?) |
    cons_check(C?, Rs?, Nm?, F1),
    conses_check(Cs?, Rs?, Nm?, F2),
    faults_app(F1?, F2?, R).

% In a safe formula a listed role is an agent variable a constraint may name.
procedure agents_all(NRoleSpecs?, NRoleSpecs).
agents_all([], []).
agents_all([rs(G, P, M, K, N)|Rs], [rs(G?, P?, M?, K?, N?)|R?]) :- agents_all(Rs?, R).
agents_all([crs(_, G, P, M, K, N)|Rs], [rs(G?, P?, M?, K?, N?)|R?]) :- agents_all(Rs?, R).

% The constraints of safe formulas, and their multiplicities at a holder.
FP ::= pp(Constraints, HMults).
procedure fp_parts(FP?, Constraints, HMults).
fp_parts(pp(C, M), C?, M?).

procedure forms_parts(Forms?, FP?, FP).
forms_parts([], P, P?).
forms_parts([F|Fs], P, R?) :- form_parts(F?, P?, P1), forms_parts(Fs?, P1?, R).

procedure form_parts(Form?, FP?, FP).
form_parts(fa(H, M), pp(C, Ms), pp(C?, [hm(I?, M?)|Ms?])) :- ground(H?) | holder_index(H?, I).
form_parts(fnot(F), P, R?) :- form_parts(F?, P?, R).
form_parts(fand(A, B), P, R?) :- form_parts(A?, P?, P1), form_parts(B?, P1?, R).
form_parts(for(A, B), P, R?) :- form_parts(A?, P?, P1), form_parts(B?, P1?, R).
form_parts(fexists(_, _, _, F), P, R?) :- form_parts(F?, P?, R).
form_parts(fforall(_, _, _, F, G), P, R?) :- form_parts(F?, P?, P1), forms_parts(G?, P1?, R).
form_parts(fcons(C), pp(Cs, Ms), pp([C?|Cs?], Ms?)).

procedure holder_index(Arg?, Integer).
holder_index(role(I), I?).
holder_index(_, 0) :- otherwise | true.

procedure hmults_check(HMults?, Constant?, Faults?, Faults).
hmults_check([], _, T, T?).
hmults_check([hm(I, M)|Ms], Nm, T, R?) :- integer(I?), ground(M?), ground(Nm?), ground(T?) |
    hmults_check(Ms?, Nm?, T?, R1),
    num_mults([M?], I?, Nm?, R1?, R).

% --- the signing conditions of a constraint (def:numbers, GSC 10fcc92) ------
% "signing conditions signed(u, y) and unsigned(u, y), u an agent role or
% agent variable and y a speech-act variable of the schema" (def:numbers).
% Each u that is neither role(I), I an agent role of the schema, nor pvar(X)
% is a fault signing_not_agent(Schema, U), and each y that is not svar(Y) a
% fault signing_not_speech_act(Schema, Y); a variable among them that the
% head does not list is not_in_head (head_schema).  So too of the agent
% variables u and v of u = v and u != v (def:numbers); the base of a name
% term u or v is as the agent variable is, a fault name_term_base(Schema,
% NameTerm) otherwise, and a speech-act variable asks nothing more.  No
% condition of
% def:syntactically-grassroots reads a signing condition or an equality (the
% appendix, after def:binding-numbers): linear.glp takes each as true.

% The I-th role of a schema as written is an agent role.
procedure nrs_agent_at(NRoleSpecs?, Integer?, Ans).
nrs_agent_at([rs(_, _, _, _, _)|_], I, yes) :- I? =:= 1 | true.
nrs_agent_at([crs(_, _, _, _, _, _)|_], I, no) :- I? =:= 1 | true.
nrs_agent_at([_|Rs], I, R?) :- I? > 1, integer(I?), ground(Rs?) |
    I1 := I? - 1,
    nrs_agent_at(Rs?, I1?, R).
nrs_agent_at(_, _, no) :- otherwise | true.

% u is an agent role of the schema or an agent variable.
procedure sign_agent(Arg?, NRoleSpecs?, Ans).
sign_agent(pvar(_), _, yes).
sign_agent(role(I), Rs, R?) :- integer(I?), ground(Rs?) | nrs_agent_at(Rs?, I?, R).
sign_agent(A, _, no) :- otherwise, ground(A?) | true.

% y is a speech-act variable.
procedure sign_speech_act(Arg?, Ans).
sign_speech_act(svar(_), yes).
sign_speech_act(A, no) :- otherwise, ground(A?) | true.

procedure sign_agent_fault(Ans?, Arg?, Constant?, Faults?, Faults).
sign_agent_fault(yes, _, _, T, T?).
sign_agent_fault(no, U, Nm, T, [signing_not_agent(Nm?, U?)|T?]).

procedure sign_speech_act_fault(Ans?, Arg?, Constant?, Faults?, Faults).
sign_speech_act_fault(yes, _, _, T, T?).
sign_speech_act_fault(no, Y, Nm, T, [signing_not_speech_act(Nm?, Y?)|T?]).

procedure sign_cond_faults(Arg?, Arg?, NRoleSpecs?, Constant?, Faults?, Faults).
sign_cond_faults(U, Y, Rs, Nm, T, R?) :-
    ground(U?), ground(Y?), ground(Rs?), ground(Nm?), ground(T?) |
    sign_agent(U?, Rs?, A),
    sign_speech_act(Y?, B),
    sign_speech_act_fault(B?, Y?, Nm?, T?, R1),
    sign_agent_fault(A?, U?, Nm?, R1?, R).

procedure signing_faults(Constraint?, NRoleSpecs?, Constant?, Faults?, Faults).
signing_faults(true, _, _, T, T?).
signing_faults(and(A, B), Rs, Nm, T, R?) :-
    ground(A?), ground(B?), ground(Rs?), ground(Nm?), ground(T?) |
    signing_faults(B?, Rs?, Nm?, T?, R1),
    signing_faults(A?, Rs?, Nm?, R1?, R).
signing_faults(or(A, B), Rs, Nm, T, R?) :-
    ground(A?), ground(B?), ground(Rs?), ground(Nm?), ground(T?) |
    signing_faults(B?, Rs?, Nm?, T?, R1),
    signing_faults(A?, Rs?, Nm?, R1?, R).
signing_faults(not(A), Rs, Nm, T, R?) :- signing_faults(A?, Rs?, Nm?, T?, R).
signing_faults(implies(A, B), Rs, Nm, T, R?) :-
    ground(A?), ground(B?), ground(Rs?), ground(Nm?), ground(T?) |
    signing_faults(B?, Rs?, Nm?, T?, R1),
    signing_faults(A?, Rs?, Nm?, R1?, R).
signing_faults(rel(_, _), _, _, T, T?).
signing_faults(eq(X, Y), Rs, Nm, T, R?) :- agent_cmp_faults(X?, Y?, Rs?, Nm?, T?, R).
signing_faults(ne(X, Y), Rs, Nm, T, R?) :- agent_cmp_faults(X?, Y?, Rs?, Nm?, T?, R).
signing_faults(le(_, _), _, _, T, T?).
signing_faults(lt(_, _), _, _, T, T?).
signing_faults(ge(_, _), _, _, T, T?).
signing_faults(gt(_, _), _, _, T, T?).
signing_faults(succ(_, _), _, _, T, T?).
signing_faults(signed(U, Y), Rs, Nm, T, R?) :- sign_cond_faults(U?, Y?, Rs?, Nm?, T?, R).
signing_faults(unsigned(U, Y), Rs, Nm, T, R?) :- sign_cond_faults(U?, Y?, Rs?, Nm?, T?, R).
signing_faults(program(X), _, Nm, T, R?) :- utter_fault(X?, Nm?, T?, R).

% author(y) and item(y) are of a speech-act variable y of the schema
% (def:numbers: "the author author(y), the first signer of y", "the item
% item(y), the utterance under the signatures of y"), and so is the item a
% condition program(X) is on: each other y is a fault
% signing_not_speech_act(Schema, Y).  A condition on what is no item is
% constraint_not_numeric (constraint_args).
procedure utter_fault(Expr?, Constant?, Faults?, Faults).
utter_fault(author_of(Y), Nm, T, R?) :- ground(Y?), ground(Nm?), ground(T?) |
    sign_speech_act(Y?, B),
    sign_speech_act_fault(B?, Y?, Nm?, T?, R).
utter_fault(item_of(Y), Nm, T, R?) :- ground(Y?), ground(Nm?), ground(T?) |
    sign_speech_act(Y?, B),
    sign_speech_act_fault(B?, Y?, Nm?, T?, R).
utter_fault(_, _, T, T?) :- otherwise | true.

% u = v and u != v, of two agent variables, each an agent role of the schema
% or an agent variable, of two speech-act variables, or of two name terms
% (def:numbers, GSC 6f0bda1).
procedure agent_cmp_faults(Expr?, Expr?, NRoleSpecs?, Constant?, Faults?, Faults).
agent_cmp_faults(X, Y, Rs, Nm, T, R?) :- ground(X?), ground(Y?), ground(Rs?), ground(Nm?), ground(T?) |
    name_eq(X?, Y?, A),
    agent_cmp1(A?, X?, Y?, Rs?, Nm?, T?, R).

procedure agent_cmp1(Ans?, Expr?, Expr?, NRoleSpecs?, Constant?, Faults?, Faults).
agent_cmp1(no, _, _, _, _, T, T?).
agent_cmp1(yes, X, Y, Rs, Nm, T, R?) :- ground(X?), ground(Y?), ground(Rs?), ground(Nm?), ground(T?) |
    cmp_side_faults(Y?, Rs?, Nm?, T?, R1),
    cmp_side_faults(X?, Rs?, Nm?, R1?, R).

% A side of u = v: author(y) or item(y), asking y be a speech-act variable
% (utter_fault), or an argument of the kind name_eq found.
procedure cmp_side_faults(Expr?, NRoleSpecs?, Constant?, Faults?, Faults).
cmp_side_faults(author_of(Y), _, Nm, T, R?) :- utter_fault(author_of(Y?), Nm?, T?, R).
cmp_side_faults(item_of(Y), _, Nm, T, R?) :- utter_fault(item_of(Y?), Nm?, T?, R).
cmp_side_faults(X, Rs, Nm, T, R?) :- otherwise, ground(X?), ground(Rs?), ground(Nm?), ground(T?) |
    exprs_args([X?], [], As),
    cmp_args_faults(As?, Rs?, Nm?, T?, R).

procedure cmp_args_faults(Args?, NRoleSpecs?, Constant?, Faults?, Faults).
cmp_args_faults([], _, _, T, T?).
cmp_args_faults([U|Us], Rs, Nm, T, R?) :- ground(U?), ground(Us?), ground(Rs?), ground(Nm?), ground(T?) |
    cmp_args_faults(Us?, Rs?, Nm?, T?, R1),
    cmp_arg_fault(U?, Rs?, Nm?, R1?, R).

procedure cmp_arg_fault(Arg?, NRoleSpecs?, Constant?, Faults?, Faults).
cmp_arg_fault(svar(_), _, _, T, T?).
cmp_arg_fault(nterm(S), Rs, Nm, T, R?) :- ground(S?), ground(Rs?), ground(Nm?), ground(T?) |
    nt_base(S?, B),
    cmp_base(B?, Rs?, A),
    nt_base_fault(A?, Nm?, S?, T?, R).
cmp_arg_fault(U, Rs, Nm, T, R?) :- otherwise, ground(U?), ground(Rs?), ground(Nm?), ground(T?) |
    sign_agent(U?, Rs?, A),
    sign_agent_fault(A?, U?, Nm?, T?, R).

% The base of a name term in a constraint: an agent role of the schema, or
% any variable the head lists.
procedure cmp_base(Base?, NRoleSpecs?, Ans).
cmp_base(b_role(I), Rs, R?) :- integer(I?), ground(Rs?) | nrs_agent_at(Rs?, I?, R).
cmp_base(_, _, yes) :- otherwise | true.

procedure num_schemas(NContract?, Faults).
num_schemas([], []).
num_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    num_schema(S?, F1),
    num_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% --- the items among the arguments of atoms (def:numbers, GSC 4401dd6) ------
% "an argument of an atom may be a value or a value variable, or the item
% item(y) of a speech-act variable y of the schema that an agent role
% requires, the utterance under the signatures of y, which names no agent"
% (def:numbers).  Each item item_of(Y) among the arguments of an atom of the
% schema as written -- an atom a role adds, deletes, clears, requires or
% forbids, an atom of a quantified conjunct or of a safe formula, and the
% anchor of a cardinality or a sum -- whose Y is not svar(Y) is a fault
% signing_not_speech_act(Schema, Y), as of an item in a constraint
% (utter_fault), and each whose speech-act variable y occurs in no atom an
% agent role requires (def:schema: "An agent role requires the atoms of B it
% holds") a fault item_argument(Schema, Y); a variable the head does not
% list is not_in_head (head_schema).  An item in a constraint is asked
% nothing more (signing_faults).  Each item is asked once.

% The arguments of the atoms of a formula, its constraints left out.
procedure form_atom_args(Form?, Args?, Args).
form_atom_args(fa(_, M), T, R?) :- ground(M?), ground(T?) |
    plain_mult(M?, A),
    atoms_args([A?], T?, R).
form_atom_args(fnot(F), T, R?) :- form_atom_args(F?, T?, R).
form_atom_args(fand(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    forms_atom_args([A?, B?], T?, R).
form_atom_args(for(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    forms_atom_args([A?, B?], T?, R).
form_atom_args(fexists(_, _, atom(_, As), F), T, R?) :- ground(As?), ground(F?), ground(T?) |
    form_atom_args(F?, T?, R1),
    args_app(As?, R1?, R).
form_atom_args(fforall(_, _, atom(_, As), F, G), T, R?) :-
    ground(As?), ground(F?), ground(G?), ground(T?) |
    forms_atom_args([F?|G?], T?, R1),
    args_app(As?, R1?, R).
form_atom_args(fcons(_), T, T?).

procedure forms_atom_args(Forms?, Args?, Args).
forms_atom_args([], T, T?).
forms_atom_args([F|Fs], T, R?) :- ground(F?), ground(Fs?), ground(T?) |
    forms_atom_args(Fs?, T?, R1),
    form_atom_args(F?, R1?, R).

% The anchors of the conjuncts, and their formulas.
procedure conj_atom_args(Conjuncts?, Args?, Args).
conj_atom_args([], T, T?).
conj_atom_args([conjunct(_, _, atom(_, As), Phi, _, _, L)|Cs], T, R?) :-
    ground(As?), ground(Phi?), ground(L?), ground(Cs?), ground(T?) |
    conj_atom_args(Cs?, T?, R1),
    forms_atom_args([Phi?|L?], R1?, R2),
    args_app(As?, R2?, R).

% The items among arguments.
procedure args_items(Args?, Args?, Args).
args_items([], T, T?).
args_items([item_of(Y)|As], T, [item_of(Y?)|R?]) :- args_items(As?, T?, R).
args_items([_|As], T, R?) :- otherwise | args_items(As?, T?, R).

% Some agent role requires an atom with the speech-act variable Y among its
% arguments (req_occurs).
procedure agent_requires(RoleSpecs?, Arg?, Ans).
agent_requires([], _, no).
agent_requires([RS|Rs], Y, R?) :- ground(RS?), ground(Rs?), ground(Y?) |
    is_party_role(RS?, P),
    req_occurs(RS?, Y?, Q),
    both_yes(P?, Q?, A),
    agent_requires1(A?, Rs?, Y?, R).

procedure agent_requires1(Ans?, RoleSpecs?, Arg?, Ans).
agent_requires1(yes, _, _, yes).
agent_requires1(no, Rs, Y, R?) :- ground(Rs?), ground(Y?) | agent_requires(Rs?, Y?, R).

procedure item_fault(Arg?, RoleSpecs?, Constant?, Faults?, Faults).
item_fault(svar(Y), Rs, Nm, T, R?) :- ground(Y?), ground(Rs?), ground(Nm?), ground(T?) |
    agent_requires(Rs?, svar(Y?), A),
    item_req_fault(A?, Y?, Nm?, T?, R).
item_fault(Y, _, Nm, T, [signing_not_speech_act(Nm?, Y?)|T?]) :-
    otherwise, ground(Y?), ground(Nm?), ground(T?) | true.

procedure item_req_fault(Ans?, Constant?, Constant?, Faults?, Faults).
item_req_fault(yes, _, _, T, T?).
item_req_fault(no, Y, Nm, T, [item_argument(Nm?, Y?)|T?]).

procedure items_faults(Args?, RoleSpecs?, Constant?, Faults).
items_faults([], _, _, []).
items_faults([item_of(Y)|Is], Rs, Nm, R?) :- ground(Y?), ground(Is?), ground(Rs?), ground(Nm?) |
    items_faults(Is?, Rs?, Nm?, R1),
    item_fault(Y?, Rs?, Nm?, R1?, R).
items_faults([_|Is], Rs, Nm, R?) :- otherwise, ground(Is?), ground(Rs?), ground(Nm?) |
    items_faults(Is?, Rs?, Nm?, R).

procedure item_schema(NSchema?, Faults).
item_schema(NSc, R?) :- ground(NSc?) |
    nsch_name(NSc?, Nm),
    plain_schema(NSc?, Sc),
    nsch_anchored(NSc?, An),
    item_schema1(Nm?, Sc?, An?, R).

procedure item_schema1(Constant?, Schema?, Forms?, Faults).
item_schema1(Nm, Sc, An, R?) :- ground(Nm?), ground(Sc?), ground(An?) |
    sch_roles(Sc?, Rs),
    sch_conjs(Sc?, Cj),
    sch_forms(Sc?, Fs),
    item_schema2(Nm?, Rs?, Cj?, Fs?, An?, R).

% Rs is read twice, so it is taken ground in a head of its own.
procedure item_schema2(Constant?, RoleSpecs?, Conjuncts?, Forms?, Forms?, Faults).
item_schema2(Nm, Rs, Cj, Fs, An, R?) :- ground(Nm?), ground(Rs?), ground(Cj?), ground(Fs?), ground(An?) |
    rolespecs_args(Rs?, [], A2),
    conj_atom_args(Cj?, A2?, A3),
    forms_atom_args(Fs?, A3?, A4),
    forms_atom_args(An?, A4?, A5),
    args_items(A5?, [], Is0),
    args_dedup(Is0?, Is),
    items_faults(Is?, Rs?, Nm?, R).

procedure item_schemas(NContract?, Faults).
item_schemas([], []).
item_schemas([S|Ss], R?) :- ground(S?), ground(Ss?) |
    item_schema(S?, F1),
    item_schemas(Ss?, F2),
    faults_app(F1?, F2?, R).

% A malformed contract is refused; a contract that is not is decided by
% def:syntactically-grassroots.  The faults are given in the order: the
% head, the numbers, the items, the name terms, the listed roles, the form of a schema,
% the reflexive predicates, the signed terms.  The head and the numbers are
% decided on the contract as written, the rest on its plain form (self.glp,
% plain_decl), and so are traceable provenance and volition;
% def:unobstructed is decided on the contract as written (unobstructed.glp).
procedure check_formed(Faults?, Contract?, NContract?, Preds?, Preds?, Verdict).
check_formed([], C, NC, Rf, Ev, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?) |
    check_contract(C?, NC?, Rf?, Ev?, V).
check_formed([F|Fs], _, _, _, _, malformed([F?|Fs?])).

procedure check_decl(Contract?, NContract?, Preds?, Preds?, Faults?, Verdict).
check_decl(C, NC, Rf, Ev, MHN, V?) :- ground(C?), ground(NC?), ground(Rf?), ground(Ev?), ground(MHN?) |
    form_schemas(C?, M0),
    refl_schemas(C?, Rf?, M1),
    sgn_schemas(C?, M2),
    nt_schemas(C?, MT),
    listed_schemas(C?, ML),
    faults_app(M1?, M2?, M12),
    faults_app(ML?, M0?, ML0),
    faults_app(MT?, ML0?, MT0),
    faults_app(MHN?, MT0?, MH0),
    faults_app(MH0?, M12?, M),
    check_formed(M?, C?, NC?, Rf?, Ev?, V).

procedure check_ndecl(NContract?, Preds?, Preds?, Verdict).
check_ndecl(NC, Rf, Ev, V?) :- ground(NC?), ground(Rf?), ground(Ev?) |
    plain_contract(NC?, C),
    head_schemas(NC?, MH),
    num_schemas(NC?, MN),
    item_schemas(NC?, MI),
    faults_app(MN?, MI?, MNI),
    faults_app(MH?, MNI?, MHN),
    check_decl(C?, NC?, Rf?, Ev?, MHN?, V).

exported procedure check(NDeclared?, Verdict).
check(D, V?) :- ground(D?) |
    ndecl_schemas(D?, NC),
    ndecl_reflexive(D?, Rf),
    check_ndecl(NC?, Rf?, [], V).

% The verdict on a contract naming environment predicates Ev (GSC 25b6b3c, the appendix "Values in Speech-Act Schemas": "an unobstructed introductory act requires no environment atom, clause 1 of Definition unobstructed admitting only atoms a schema adds, and forbids none"): an introductory act requiring or forbidding an atom of one is obstructed (unobstructed.glp, intro_result_env).
exported procedure check_env(NDeclared?, Preds?, Verdict).
check_env(D, Ev, V?) :- ground(D?), ground(Ev?) |
    ndecl_schemas(D?, NC),
    ndecl_reflexive(D?, Rf),
    check_ndecl(NC?, Rf?, Ev?, V).

exported procedure check_named(Constant?, Verdict).
check_named(Nm, V?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    check(D?, V).

% A fixture that changes a contract in one place, by name and the contract it
% changes (contracts.glp, variant/3).
exported procedure check_variant(Constant?, WContract?, Verdict).
check_variant(Nm, B, V?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, W),
    unnamed(W?, D),
    check(D?, V).

% The predicates of traceable provenance, for inspection: the largest set
% having it (def:grounded).
procedure traceable_in(Contract?, Constraints?, Preds).
traceable_in(C, Cns, E?) :- ground(C?), ground(Cns?) | prov # traceable_c(C?, Cns?, E).

exported procedure traceable_of(Constant?, Preds).
traceable_of(Nm, E?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    traceable_preds(D?, E).

exported procedure traceable_preds(NDeclared?, Preds).
traceable_preds(D, E?) :- ground(D?) |
    plain_decl(D?, PD),
    ndecl_schemas(D?, NC),
    ncontract_constraints(NC?, Cns),
    traceable_pd(PD?, Cns?, E).

% Each schema's constraint is read with its body (def:grounded, GSC 7324ec7),
% so the constraints of the contract as written go beside its plain form.
procedure traceable_pd(Declared?, Constraints?, Preds).
traceable_pd(D, Cns, E?) :- ground(D?), ground(Cns?) |
    decl_schemas(D?, C),
    traceable_in(C?, Cns?, E).

exported procedure traceable_variant(Constant?, WContract?, Preds).
traceable_variant(Nm, B, E?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, W),
    unnamed(W?, D),
    traceable_preds(D?, E).

% The introductory acts of a contract, for inspection (def:introduction,
% def:unobstructed): each schema that is an introductory act, in the order of
% the contract, unobstructed, or obstructed with the faults of its first
% introduction.  The verdict says that some introductory act is
% unobstructed; this says which.
exported procedure intro_acts(NDeclared?, IntroActs).
intro_acts(D, A?) :- ground(D?) |
    ndecl_schemas(D?, NC),
    ndecl_reflexive(D?, Rf),
    unobstructed # intro_acts(NC?, Rf?, A).

exported procedure intro_acts_variant(Constant?, WContract?, IntroActs).
intro_acts_variant(Nm, B, A?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, W),
    unnamed(W?, D),
    intro_acts(D?, A).

% The introduction with wards (GAI's appendix "Contracts with Wards"), for
% inspection, searched for whatever the verdict: what it found, or
% no_introduction_with_wards.  A contract with a name term not based on an
% agent role, which def:role admits not and check refuses, has none, GAI's
% appendix being written over the schemas of agent roles and def:sg-wards
% over those of an agent-named contract (CSSN's def:agent-named).
procedure wards2(Ans?, Contract?, Preds?, Wards).
wards2(yes, C, Rf, W?) :- ground(C?), ground(Rf?) | wards # wards(C?, Rf?, W).
wards2(no, _, _, no_introduction_with_wards).

procedure wards_in(Contract?, Preds?, Wards).
wards_in(C, Rf, W?) :- ground(C?), ground(Rf?) |
    agent_named(C?, A),
    wards2(A?, C?, Rf?, W).

exported procedure wards(NDeclared?, Wards).
wards(D, W?) :- ground(D?) |
    plain_decl(D?, PD),
    wards_pd(PD?, W).

procedure wards_pd(Declared?, Wards).
wards_pd(D, W?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    wards_in(C?, Rf?, W).

exported procedure wards_of(Constant?, Wards).
wards_of(Nm, W?) :- ground(Nm?) |
    contracts # contract(Nm?, D),
    wards(D?, W).

exported procedure wards_variant(Constant?, WContract?, Wards).
wards_variant(Nm, B, W?) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, WD),
    unnamed(WD?, D),
    wards(D?, W).

% The atoms the relay acts of the introduction with wards require at their ward roles as atoms of a predicate h, admitted by that alternative of clause 2 of def:relay and by no other (GSC 410a440), each h(Schema, Role, H), for inspection: [] where there is no introduction with wards.
procedure relay_h1(Contract?, Preds?, RelayHs).
relay_h1(C, Rf, H?) :- ground(C?), ground(Rf?) |
    wards_in(C?, Rf?, W),
    wards # relay_h_for(C?, Rf?, W?, H).

exported procedure relay_h(NDeclared?, RelayHs).
relay_h(D, H?) :- ground(D?) |
    plain_decl(D?, PD),
    relay_h_pd(PD?, H).

procedure relay_h_pd(Declared?, RelayHs).
relay_h_pd(D, H?) :- ground(D?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    relay_h1(C?, Rf?, H).

% The guardianships for the kinds [iota, f] and a set of marks M
% (def:kinds, def:guardianship), every one of each mark, for inspection.
exported procedure guardianships(NDeclared?, Preds?, Preds?, Guardianships).
guardianships(D, K, M, G?) :- ground(D?), ground(K?), ground(M?) |
    plain_decl(D?, PD),
    guardianships_pd(PD?, K?, M?, G).

procedure guardianships_pd(Declared?, Preds?, Preds?, Guardianships).
guardianships_pd(D, K, M, G?) :- ground(D?), ground(K?), ground(M?) |
    decl_schemas(D?, C),
    wards # guardianships_for(C?, K?, M?, G).

