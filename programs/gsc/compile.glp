% ---------------------------------------------------------------------------
% The compilation, as LaTeX: def:compile of /Grassroots/GSC, Section 5.1,
% one definition for a schema of agent roles and listed roles (GSC ac7ad63),
% printed in one of two forms.
%
% A schema of agent roles, written schema and with no name term, is printed
% in the short form, the form of the displays of befriend in Section 5.1 and
% of the swap in Appendix B.3: the assignment, the proviso and the guard of
% def:compile, whatever the contract it is in, as befriend of GSN, a
% contract with a listed role, compiles to Section 5.1's display.  Any other
% schema is printed in the general form, the lines of def:compile's own
% display (the full version), each role's over its extent ext_c(pi_i), the
% form of GSC's Appendix D until GSC ac7ad63.  The paper is the
% specification and def:compile is not restated in this file.  Section 5
% opens by saying that the compilation is defined for syntactically
% grassroots contracts, so compile_named runs the checker first and compiles
% nothing otherwise.
%
% GLP has no string concatenation, so a display is emitted as its tokens, one
% to a line.  A newline is whitespace to LaTeX, so the lines are the display
% and are pasted as they stand.
%
% Act schemas allow numbers (GSC, Section 3.2; def:numbers): a numeric
% argument, a multiplicity on an atom added or deleted, and a constraint on
% the value variables, which every binding satisfies.  def:compile applies
% to a schema with values as written (the appendix "Values in Act
% Schemas"), whose example prints GB's redeem_bc in the form below, the
% constraint on a proviso line of its own; the display of a schema with
% numbers is the schema as written (self.glp, NSchema): a value argument as its
% variable or number; a multiplicity k on an atom A as k\cdot A, as GB's
% paper writes it (GB, Appendix A), so that k\cdot A in a multiset is A k
% times; a multiset of required atoms carrying a multiplicity included in
% c_S, as def:compile writes a multiset; and the constraint on a proviso line
% of its own after the forbidden atoms, gt as >, le as \le, succ(X, Y) as
% Y = X + 1 and or as \lor, as GB's paper writes its constraints.  A schema
% with no number is printed as before.
% ---------------------------------------------------------------------------

imported procedure check#check(NDeclared?, Verdict).
imported procedure contracts#contract(Constant?, NDeclared).
imported procedure contracts#variant(Constant?, Contract?, Declared).

procedure chunks_app(Chunks?, Chunks?, Chunks).
chunks_app([], T, T?).
chunks_app([C|Cs], T, [C?|R?]) :- chunks_app(Cs?, T?, R).

procedure is_empty(Mults?, Ans).
is_empty([], yes).
is_empty([_|_], no).

% --- Arguments (def:schema, def:role) --------------------------------------
% Roles one and two are the paper's \Alice and \Bob; an agent or speech-act
% variable is written as it is named.

procedure latex_role(Integer?, Chunks?, Chunks).
latex_role(I, T, ['\\Alice'|T?]) :- I? =:= 1 | true.
latex_role(I, T, ['\\Bob'|T?]) :- I? =:= 2 | true.
latex_role(I, T, ['\\mathit{Carol}'|T?]) :- I? =:= 3 | true.
latex_role(I, T, ['\\mathit{Dave}'|T?]) :- I? =:= 4 | true.
latex_role(I, T, R?) :- otherwise, integer(I?), ground(T?) | latex_role_n(I?, T?, R).

% A role beyond the fourth has no name in the paper and is written p_i.
procedure latex_role_n(Constant?, Chunks?, Chunks).
latex_role_n(I, T, ['\\mathit{p}_{', I?, '}'|T?]).

% A name term (def:role): <u> for an agent role, or sigma.y; <x> for an
% agent variable, which def:role does not admit, is printed for a contract
% given to latex_schema directly, compile_named refusing one.
procedure latex_nt(NameTerm?, Chunks?, Chunks).
latex_nt(own(I), T, ['\\langle'|R?]) :- integer(I?), ground(T?) |
    latex_role(I?, ['\\rangle'|T?], R).
latex_nt(own_var(X), T, ['\\langle', X?, '\\rangle'|T?]).
latex_nt(ext(S, Y), T, R?) :- ground(S?), ground(Y?), ground(T?) |
    latex_nt(S?, ['\\cdot', Y?|T?], R).

% A signed term is written \mathrm{sgn}(x,\Alice), as Section 3.3 writes it.
procedure latex_arg(Arg?, Chunks?, Chunks).
latex_arg(role(I), T, R?) :- integer(I?), ground(T?) | latex_role(I?, T?, R).
latex_arg(pvar(X), T, [X?|T?]).
latex_arg(svar(X), T, [X?|T?]).
latex_arg(nterm(S), T, R?) :- ground(S?), ground(T?) | latex_nt(S?, T?, R).
latex_arg(sgn(X, J), T, ['\\mathrm{sgn}(', X?, ','|R?]) :-
    ground(X?), integer(J?), ground(T?) |
    latex_role(J?, [')'|T?], R).
% A value argument, the value variable as it is named or the number.
latex_arg(num(X), T, [X?|T?]).

procedure latex_args(Args?, Chunks?, Chunks).
latex_args([], T, T?).
latex_args([A], T, R?) :- ground(A?), ground(T?) | latex_arg(A?, T?, R).
latex_args([A, B|As], T, R?) :- ground(A?), ground(B?), ground(As?), ground(T?) |
    latex_args([B?|As?], T?, R1),
    latex_arg(A?, [','|R1?], R).

% --- Atoms -----------------------------------------------------------------
% The papers write the currencies' predicates, GC's coin and GB's cent, as
% the cent sign, wherever they appear (Udi's ruling, reported by GSC,
% Code_inbox.md, 2026-10-24 07:32 UTC); every other predicate is set in
% \mathit.  A predicate of arity zero carries no parentheses.

procedure latex_pred(Constant?, Chunks?, Chunks).
latex_pred(P, T, ['\\text{\\textcent}'|T?]) :- P? =?= coin | true.
latex_pred(P, T, ['\\text{\\textcent}'|T?]) :- P? =?= cent | true.
latex_pred(P, T, ['\\mathit{', P?, '}'|T?]) :- otherwise, ground(P?) | true.

procedure latex_atom(Atom?, Chunks?, Chunks).
latex_atom(atom(P, []), T, R?) :- ground(P?), ground(T?) | latex_pred(P?, T?, R).
latex_atom(atom(P, [A|As]), T, R?) :-
    ground(P?), ground(A?), ground(As?), ground(T?) |
    latex_args([A?|As?], [')'|T?], R1),
    latex_pred(P?, ['('|R1?], R).

% An atom with a multiplicity k is written k\cdot A, as GB's paper writes it
% (GB, Appendix A).
procedure latex_mult(Mult?, Chunks?, Chunks).
latex_mult(atom(P, As), T, R?) :- ground(P?), ground(As?), ground(T?) |
    latex_atom(atom(P?, As?), T?, R).
latex_mult(times(K, A), T, R?) :- ground(K?), ground(A?), ground(T?) |
    latex_atom(A?, T?, R1),
    latex_arg(K?, ['\\cdot'|R1?], R).

% The atoms of a set are written apart by Sep, a comma, as Section 5.1
% writes the two atoms befriend requires at a role and the two close deletes
% at its leader.
procedure latex_atoms(Mults?, Constant?, Chunks?, Chunks).
latex_atoms([], _, T, T?).
latex_atoms([A], _, T, R?) :- ground(A?), ground(T?) | latex_mult(A?, T?, R).
latex_atoms([A, B|As], Sep, T, R?) :-
    ground(A?), ground(B?), ground(As?), ground(Sep?), ground(T?) |
    latex_atoms([B?|As?], Sep?, T?, R1),
    latex_mult(A?, [Sep?|R1?], R).

procedure latex_set(Mults?, Constant?, Chunks?, Chunks).
latex_set(As, Sep, T, ['\\{'|R?]) :- ground(As?), ground(Sep?), ground(T?) |
    latex_atoms(As?, Sep?, ['\\}'|T?], R).

% --- The roles as the paper writes them (def:role, def:extent) -------------
% An agent role by its name, and a listed role pi[rho(*, u_2, ..., u_r)], as
% Section 5.1 writes close's, \Alice[\mathit{listed}(\ast,n)] (GSC 8064cfb);
% ext_c(pi_i) is the extent of the role in c (def:extent).

procedure latex_role_term(NRoleSpec?, Integer?, Chunks?, Chunks).
latex_role_term(rs(_, _, _, _, _), I, T, R?) :- integer(I?), ground(T?) |
    latex_role(I?, T?, R).
latex_role_term(crs(listed(I, Rho, As), _, _, _, _, _), _, T, R?) :-
    integer(I?), ground(Rho?), ground(As?), ground(T?) |
    latex_listed_args(As?, [')', ']'|T?], R1),
    latex_pred(Rho?, ['(', '\\ast'|R1?], R2),
    latex_role(I?, ['['|R2?], R).

% The arguments u_2, ..., u_r of a listed role, each after a comma, following
% the * of its first place.
procedure latex_listed_args(Args?, Chunks?, Chunks).
latex_listed_args([], T, T?).
latex_listed_args([A|As], T, [','|R?]) :- ground(A?), ground(As?), ground(T?) |
    latex_args([A?|As?], T?, R).

procedure latex_ext(NRoleSpec?, Integer?, Chunks?, Chunks).
latex_ext(RS, I, T, ['\\mathrm{ext}_c('|R?]) :-
    ground(RS?), integer(I?), ground(T?) |
    latex_role_term(RS?, I?, [')'|T?], R).

% --- The assignment of one role (def:compile) ------------------------------
% c'_S := (c_S \ -(i)) u +(i), with an empty half left out, and both at a
% guarding role that adds and deletes nothing, which def:schema admits:
% c'_S := c_S, the assignment def:compile gives it (1 <= i <= k); S is the
% subscript, {\Alice} for the agent of an agent role and q for the other
% agents of a listed role's extent.

procedure update_body(Ans?, Ans?, Mults?, Mults?, Constant?, Chunks?, Chunks?,
                      Chunks).
update_body(yes, yes, _, _, _, S, T, ['c_'|R?]) :- ground(S?), ground(T?) |
    chunks_app(S?, T?, R).
update_body(no, yes, Add, _, Sep, S, T, ['c_'|R?]) :-
    ground(Add?), ground(Sep?), ground(S?), ground(T?) |
    latex_set(Add?, Sep?, T?, R1),
    chunks_app(S?, [' \\uplus '|R1?], R).
update_body(yes, no, _, Del, Sep, S, T, ['c_'|R?]) :-
    ground(Del?), ground(Sep?), ground(S?), ground(T?) |
    latex_set(Del?, Sep?, T?, R1),
    chunks_app(S?, [' \\setminus '|R1?], R).
update_body(no, no, Add, Del, Sep, S, T, ['(c_'|R?]) :-
    ground(Add?), ground(Del?), ground(Sep?), ground(S?), ground(T?) |
    latex_set(Add?, Sep?, T?, R1),
    latex_set(Del?, Sep?, [') \\uplus '|R1?], R2),
    chunks_app(S?, [' \\setminus '|R2?], R).

procedure latex_update_at(NRoleSpec?, Constant?, Chunks?, Chunks?, Chunks).
latex_update_at(RS, Sep, S, T, ['c\'_'|R?]) :-
    ground(RS?), ground(Sep?), ground(S?), ground(T?) |
    nrs_add(RS?, Add),
    nrs_del(RS?, Del),
    update_rhs(Add?, Del?, Sep?, S?, T?, R1),
    chunks_app(S?, [' := '|R1?], R).

procedure update_rhs(Mults?, Mults?, Constant?, Chunks?, Chunks?, Chunks).
update_rhs(Add, Del, Sep, S, T, R?) :-
    ground(Add?), ground(Del?), ground(Sep?), ground(S?), ground(T?) |
    is_empty(Add?, AE),
    is_empty(Del?, DE),
    update_body(AE?, DE?, Add?, Del?, Sep?, S?, T?, R).

% The subscript of an agent role in Section 5.1 and Appendix B.3: {\Alice}.
procedure latex_sub(Integer?, Chunks).
latex_sub(I, ['{'|R?]) :- integer(I?) | latex_role(I?, ['}'], R).

procedure latex_update(NRoleSpec?, Integer?, Chunks?, Chunks).
latex_update(RS, I, T, R?) :- ground(RS?), integer(I?), ground(T?) |
    latex_sub(I?, S),
    latex_update_at(RS?, ',', S?, T?, R).

procedure latex_updates(NRoleSpecs?, Integer?, Chunks?, Chunks).
latex_updates([], _, T, T?).
latex_updates([RS], I, T, R?) :- ground(RS?), integer(I?), ground(T?) |
    latex_update(RS?, I?, T?, R).
latex_updates([RS, RS2|Rs], I, T, R?) :-
    ground(RS?), ground(RS2?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    latex_updates([RS2?|Rs?], I1?, T?, R1),
    latex_update(RS?, I?, [', \\qquad '|R1?], R).

% --- The proviso of one role (def:compile) ---------------------------------
% =(i) u -(i) included in c_S and not(i) disjoint from it, one conjunct each
% and left out when the multiset is empty; a singleton is written with \in and
% \notin, as Section 5.1 and Appendix B.3 write it, and, in the form of
% Section 5.1, required atoms that are distinct are listed before \in, as
% Section 5.1 writes befriend's,
% "\mathit{identity}, \mathit{knows}(\Bob) \in c_{\Alice}" (GSC 21c1b28); a
% multiset of required atoms with an atom twice in it is written as
% def:compile writes it, included in c_S.  The layout is Udi's
% ruling (GSC #3 to Code, 2026-10-18 21:49 UTC; GSC aca046b, Definition
% Compilation, befriend's display in Section 5.1 and the
% swap's in Appendix B.3): the required atoms on one proviso line and the
% forbidden atoms on the next, each in role order, a line omitted when it
% has no atom, and the guard on a line of its own.

% A multiset of required atoms carrying a multiplicity may hold an atom more
% than once, and is written as def:compile writes it, included in c_S.
procedure req_conj(Mults?, Constant?, Chunks?, ChunkLists?, ChunkLists).
req_conj([], _, _, T, T?).
req_conj([A|As], Sep, S, T, R?) :-
    ground(A?), ground(As?), ground(Sep?), ground(S?), ground(T?) |
    atoms_distinct([A?|As?], D),
    req_conj2(D?, [A?|As?], Sep?, S?, T?, R).

procedure req_conj2(Ans?, Mults?, Constant?, Chunks?, ChunkLists?, ChunkLists).
req_conj2(yes, As, Sep, S, T, [C?|T?]) :-
    ground(As?), ground(Sep?), ground(S?), ground(T?) |
    latex_atoms(As?, Sep?, [' \\in c_'|S?], C).
req_conj2(no, As, Sep, S, T, [C?|T?]) :-
    ground(As?), ground(Sep?), ground(S?), ground(T?) |
    latex_set(As?, Sep?, [' \\subseteq c_'|S?], C).

% Whether no atom occurs twice among the atoms, none carrying a
% multiplicity.
procedure mults_member(Mults?, Mult?, Ans).
mults_member([], _, no).
mults_member([A|_], B, yes) :- A? =?= B? | true.
mults_member([_|As], B, R?) :- otherwise | mults_member(As?, B?, R).

procedure atoms_distinct(Mults?, Ans).
atoms_distinct([], yes).
atoms_distinct([times(_, _)|_], no).
atoms_distinct([atom(P, Bs)|As], R?) :- ground(P?), ground(Bs?), ground(As?) |
    mults_member(As?, atom(P?, Bs?), M),
    atoms_distinct1(M?, As?, R).

procedure atoms_distinct1(Ans?, Mults?, Ans).
atoms_distinct1(yes, _, no).
atoms_distinct1(no, As, R?) :- ground(As?) | atoms_distinct(As?, R).

procedure forb_conj(Mults?, Constant?, Chunks?, ChunkLists?, ChunkLists).
forb_conj([], _, _, T, T?).
forb_conj([A], _, S, T, [C?|T?]) :- ground(A?), ground(S?), ground(T?) |
    latex_mult(A?, [' \\notin c_'|S?], C).
forb_conj([A, B|As], Sep, S, T, [C?|T?]) :-
    ground(A?), ground(B?), ground(As?), ground(Sep?), ground(S?), ground(T?) |
    chunks_app(S?, [' = \\emptyset'], S1),
    latex_set([A?, B?|As?], Sep?, [' \\cap c_'|S1?], C).

% The conjuncts of the required atoms of every role of the short form, in
% role order, and those of the forbidden atoms.
procedure req_conjs(NRoleSpecs?, Integer?, ChunkLists?, ChunkLists).
req_conjs([], _, T, T?).
req_conjs([RS|Rs], I, T, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    req_conjs(Rs?, I1?, T?, T1),
    latex_sub(I?, S),
    nrs_req(RS?, Req),
    req_conj(Req?, ',', S?, T1?, R).

procedure forb_conjs(NRoleSpecs?, Integer?, ChunkLists?, ChunkLists).
forb_conjs([], _, T, T?).
forb_conjs([RS|Rs], I, T, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    forb_conjs(Rs?, I1?, T?, T1),
    latex_sub(I?, S),
    nrs_forb(RS?, Forb),
    forb_conj(Forb?, ',', S?, T1?, R).

procedure join_conjs(ChunkLists?, Chunks?, Chunks).
join_conjs([], T, T?).
join_conjs([C], T, R?) :- ground(C?), ground(T?) | chunks_app(C?, T?, R).
join_conjs([C, D|Cs], T, R?) :- ground(C?), ground(D?), ground(Cs?), ground(T?) |
    join_conjs([D?|Cs?], T?, R1),
    chunks_app(C?, [' \\text{ and } '|R1?], R).

% A proviso line of the short form, its conjuncts joined by "and"; no
% line where there is no conjunct.
procedure provided_line(ChunkLists?, ChunkLists?, ChunkLists).
provided_line([], T, T?).
provided_line([C|Cs], T, [['\\text{provided } '|L?]|T?]) :-
    ground(C?), ground(Cs?), ground(T?) |
    join_conjs([C?|Cs?], [], L).

% --- The guarding roles of a schema -----------------------------------------

procedure guard_roles(NRoleSpecs?, Integer?, Ints?, Ints).
guard_roles([], _, T, T?).
guard_roles([RS|Rs], I, T, R?) :- ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    n_is_guarding(RS?, A),
    guard_roles1(A?, Rs?, I?, T?, R).

procedure guard_roles1(Ans?, NRoleSpecs?, Integer?, Ints?, Ints).
guard_roles1(yes, Rs, I, T, [I?|R?]) :- ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, T?, R).
guard_roles1(no, Rs, I, T, R?) :- ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, T?, R).

% --- The guard (def:compile): the guarding roles ---------------------------

procedure latex_guard_list(Ints?, Chunks?, Chunks).
latex_guard_list([], T, T?).
latex_guard_list([I], T, R?) :- integer(I?), ground(T?) | latex_role(I?, T?, R).
latex_guard_list([I, J|Is], T, R?) :-
    integer(I?), integer(J?), ground(Is?), ground(T?) |
    latex_guard_list([J?|Is?], T?, R1),
    latex_role(I?, [','|R1?], R).

procedure latex_guard(Ints?, Chunks?, Chunks).
latex_guard([], T, ['\\text{guarded by } \\emptyset'|T?]).
latex_guard([I|Is], T, ['\\text{guarded by } \\{'|R?]) :-
    integer(I?), ground(Is?), ground(T?) |
    latex_guard_list([I?|Is?], ['\\}'|T?], R).

% --- The constraint (GSC, Section 3.2; def:numbers) -------------------------
% A proviso line of its own, after the forbidden atoms and before the guard,
% none for the constraint true: and as \land, eq as =, le as \le, lt as <,
% ge as \ge, gt as >, and succ(X, Y) as Y = X + 1, as GB's paper writes its
% constraints (GB, Appendix A); plus and minus as + and -, and a product as
% \cdot, an operand that is a sum or a difference in parentheses where it
% follows a minus or is a factor.

procedure latex_constraint(Constraint?, Chunks?, Chunks).
latex_constraint(true, T, ['\\top'|T?]).
latex_constraint(and(C1, C2), T, R?) :- ground(C1?), ground(C2?), ground(T?) |
    latex_constraint(C2?, T?, R1),
    latex_constraint(C1?, ['\\land'|R1?], R).
latex_constraint(eq(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    latex_cmp(X?, '=', Y?, T?, R).
latex_constraint(le(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    latex_cmp(X?, '\\le', Y?, T?, R).
latex_constraint(lt(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    latex_cmp(X?, '<', Y?, T?, R).
latex_constraint(ge(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    latex_cmp(X?, '\\ge', Y?, T?, R).
latex_constraint(gt(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    latex_cmp(X?, '>', Y?, T?, R).
latex_constraint(succ(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    latex_arg(X?, ['+ 1'|T?], R1),
    latex_arg(Y?, ['='|R1?], R).
latex_constraint(or(C1, C2), T, R?) :- ground(C1?), ground(C2?), ground(T?) |
    latex_constraint(C2?, T?, R1),
    latex_constraint(C1?, ['\\lor'|R1?], R).

procedure latex_cmp(Expr?, Constant?, Expr?, Chunks?, Chunks).
latex_cmp(X, Op, Y, T, R?) :- ground(X?), ground(Op?), ground(Y?), ground(T?) |
    latex_expr(Y?, T?, R1),
    latex_expr(X?, [Op?|R1?], R).

procedure latex_expr(Expr?, Chunks?, Chunks).
latex_expr(plus(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    latex_expr(B?, T?, R1),
    latex_expr(A?, ['+'|R1?], R).
latex_expr(minus(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    latex_operand(B?, T?, R1),
    latex_expr(A?, ['-'|R1?], R).
latex_expr(mul(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    latex_operand(B?, T?, R1),
    latex_operand(A?, ['\\cdot'|R1?], R).
latex_expr(num(X), T, R?) :- latex_arg(num(X?), T?, R).
latex_expr(role(I), T, R?) :- latex_arg(role(I?), T?, R).
latex_expr(pvar(X), T, R?) :- latex_arg(pvar(X?), T?, R).
latex_expr(svar(X), T, R?) :- latex_arg(svar(X?), T?, R).
latex_expr(nterm(N), T, R?) :- latex_arg(nterm(N?), T?, R).
latex_expr(sgn(Y, J), T, R?) :- latex_arg(sgn(Y?, J?), T?, R).

% An operand in parentheses where it is a sum or a difference.
procedure latex_operand(Expr?, Chunks?, Chunks).
latex_operand(plus(A, B), T, ['('|R?]) :- ground(A?), ground(B?), ground(T?) |
    latex_expr(plus(A?, B?), [')'|T?], R).
latex_operand(minus(A, B), T, ['('|R?]) :- ground(A?), ground(B?), ground(T?) |
    latex_expr(minus(A?, B?), [')'|T?], R).
latex_operand(mul(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    latex_expr(mul(A?, B?), T?, R).
latex_operand(num(X), T, R?) :- latex_arg(num(X?), T?, R).
latex_operand(role(I), T, R?) :- latex_arg(role(I?), T?, R).
latex_operand(pvar(X), T, R?) :- latex_arg(pvar(X?), T?, R).
latex_operand(svar(X), T, R?) :- latex_arg(svar(X?), T?, R).
latex_operand(nterm(N), T, R?) :- latex_arg(nterm(N?), T?, R).
latex_operand(sgn(Y, J), T, R?) :- latex_arg(sgn(Y?, J?), T?, R).

procedure constraint_line(Constraint?, ChunkLists?, ChunkLists).
constraint_line(true, T, T?).
constraint_line(C, T, [['\\text{provided } '|L?]|T?]) :-
    otherwise, ground(C?), ground(T?) |
    latex_constraint(C?, [], L).

% --- The display of a schema in the short form (Section 5.1, Appendix B.3) -
% The assignments of every role on one line; the required atoms on the next,
% the forbidden atoms on the next, each left out when it has no atom; and the
% guard on a line of its own, as befriend's display in Section 5.1 and the
% swap's in Appendix B.3 print them (GSC aca046b).  Each line opens with &
% and ,\\ separates them (join_lines, below).

procedure latex_schema_s3(NSchema?, Chunks?, Chunks).
latex_schema_s3(Sc, T, ['\\begin{align*}'|R?]) :-
    ground(Sc?), ground(T?) |
    nsch_roles(Sc?, Rs),
    nsch_constraint(Sc?, Cn),
    latex_s3_roles(Rs?, Cn?, T?, R).

procedure latex_s3_roles(NRoleSpecs?, Constraint?, Chunks?, Chunks).
latex_s3_roles(Rs, Cn, T, R?) :- ground(Rs?), ground(Cn?), ground(T?) |
    guard_roles(Rs?, 1, [], G),
    latex_guard(G?, [], GL),
    constraint_line(Cn?, [GL?], LC),
    forb_conjs(Rs?, 1, [], Fs),
    provided_line(Fs?, LC?, L3),
    req_conjs(Rs?, 1, [], Qs),
    provided_line(Qs?, L3?, L2),
    latex_updates(Rs?, 1, [], A),
    join_lines([A?|L2?], ['\\end{align*}'|T?], R).

% --- The display of a schema in the general form (def:compile) ------------
% A line per agent, as def:compile's display has it and Section 5.1 prints
% close's (Udi, 2026-10-23, to GSC #7, reported by GSC #7 Cowork): first the
% agent of each agent role, in role order, its line joining what every role
% whose extent holds it adds and deletes there; then the other agents of
% the extents of the listed roles, q, their line joining what those roles
% do.  The agent of an agent role is in the extent of a listed role
% pi[rho(*, u_2, ..., u_r)] (def:extent) where the role pi requires
% rho(that role, u_2, ..., u_r), as close's leader requires
% listed(\Alice, n) and is in the extent of \Alice[listed(*, n)]; it is not
% where pi forbids that atom; and where the schema says neither, its line is
% written for each case, the case after it in parentheses.  The required
% atoms follow, on one proviso line, an agent role's included in c_{\Alice}
% and a listed role's in c_q over its extent, the extent after the line in
% parentheses; then the forbidden atoms the same way; then the freshness of
% every name term sigma.y of the schema that occurs in no atom required at a
% role (GSC 6d4f147); then the constraint; and the guard, the guarding roles
% of the schema, which are agent roles, written as Section 5.1 writes it.
% A schema of more than one listed role has a proviso line per listed role
% after the agent roles' line, and a line for q per set of the listed roles
% whose extents hold q.  The line on what is added and deleted at an agent
% is left out, as the displays of Section 5.1 leave it out.

Mem      ::= m_in ; m_out ; m_open.
IntLists ::= [] ; [Ints | IntLists].

procedure nth_nrs(NRoleSpecs?, Integer?, NRoleSpec).
nth_nrs([], _, rs(unguarded, [], [], [], [])).
nth_nrs([X|_], I, X?) :- I? =:= 1 | true.
nth_nrs([_|Xs], I, R?) :- I? > 1, integer(I?), ground(Xs?) |
    I1 := I? - 1,
    nth_nrs(Xs?, I1?, R).

% The indices of the agent roles and of the listed roles, in role order.
procedure agent_idx(NRoleSpecs?, Integer?, Ints).
agent_idx([], _, []).
agent_idx([rs(_, _, _, _, _)|Rs], I, [I?|R?]) :- integer(I?), ground(Rs?) |
    I1 := I? + 1,
    agent_idx(Rs?, I1?, R).
agent_idx([crs(_, _, _, _, _, _)|Rs], I, R?) :- integer(I?), ground(Rs?) |
    I1 := I? + 1,
    agent_idx(Rs?, I1?, R).

procedure listed_idx(NRoleSpecs?, Integer?, Ints).
listed_idx([], _, []).
listed_idx([crs(_, _, _, _, _, _)|Rs], I, [I?|R?]) :- integer(I?), ground(Rs?) |
    I1 := I? + 1,
    listed_idx(Rs?, I1?, R).
listed_idx([rs(_, _, _, _, _)|Rs], I, R?) :- integer(I?), ground(Rs?) |
    I1 := I? + 1,
    listed_idx(Rs?, I1?, R).

% Whether the agent of the agent role A is in the extent of the listed role
% LR: its base requires the atom of LR's predicate naming A, forbids it, or
% does neither.
procedure membership(Integer?, NRoleSpec?, NRoleSpecs?, Mem).
membership(A, crs(listed(I, Rho, Us), _, _, _, _, _), Rs, M?) :-
    integer(A?), integer(I?), ground(Rho?), ground(Us?), ground(Rs?) |
    nth_nrs(Rs?, I?, B),
    mem_of(B?, atom(Rho?, [role(A?)|Us?]), M).
membership(_, rs(_, _, _, _, _), _, m_out).

procedure mem_of(NRoleSpec?, Atom?, Mem).
mem_of(B, At, M?) :- ground(B?), ground(At?) |
    nrs_req(B?, Rq),
    plain_mults(Rq?, RqA),
    atoms_member(RqA?, At?, In),
    nrs_forb(B?, Fb),
    plain_mults(Fb?, FbA),
    atoms_member(FbA?, At?, Out),
    mem_of1(In?, Out?, M).

procedure mem_of1(Ans?, Ans?, Mem).
mem_of1(yes, _, m_in).
mem_of1(no, yes, m_out).
mem_of1(no, no, m_open).

% mems(Ls, A, Rs, K, U): the listed roles among Ls whose extent holds the
% agent of A, K, and those of which the schema does not say, U.
procedure mems(Ints?, Integer?, NRoleSpecs?, Ints, Ints).
mems([], _, _, [], []).
mems([L|Ls], A, Rs, K?, U?) :- integer(L?), ground(Ls?), integer(A?), ground(Rs?) |
    nth_nrs(Rs?, L?, LR),
    membership(A?, LR?, Rs?, M),
    mems(Ls?, A?, Rs?, K1, U1),
    mems1(M?, L?, K1?, U1?, K, U).

procedure mems1(Mem?, Integer?, Ints?, Ints?, Ints, Ints).
mems1(m_in, L, K1, U1, [L?|K1?], U1?).
mems1(m_out, _, K1, U1, K1?, U1?).
mems1(m_open, L, K1, U1, K1?, [L?|U1?]).

procedure ints_app(Ints?, Ints?, Ints).
ints_app([], T, T?).
ints_app([X|Xs], T, [X?|R?]) :- ints_app(Xs?, T?, R).

procedure lists_app(IntLists?, IntLists?, IntLists).
lists_app([], T, T?).
lists_app([X|Xs], T, [X?|R?]) :- lists_app(Xs?, T?, R).

procedure with_x(IntLists?, Integer?, IntLists).
with_x([], _, []).
with_x([S|Ss], X, [[X?|S?]|R?]) :- integer(X?), ground(Ss?) | with_x(Ss?, X?, R).

% Every subset of a list, those without its first member first, each in the
% order of the list.
procedure subsets(Ints?, IntLists).
subsets([], [[]]).
subsets([X|Xs], R?) :- integer(X?), ground(Xs?) |
    subsets(Xs?, S),
    subsets1(S?, X?, R).

procedure subsets1(IntLists?, Integer?, IntLists).
subsets1(S, X, R?) :- ground(S?), integer(X?) |
    with_x(S?, X?, WX),
    lists_app(S?, WX?, R).

% The join of what the roles Is add and delete (def:compile): the atoms of
% each, in role order, each once.
procedure mults_union(Mults?, Mults?, Mults).
mults_union(A, [], A?).
mults_union(A, [M|Ms], R?) :- ground(A?), ground(M?), ground(Ms?) |
    mults_member(A?, M?, In),
    mults_union1(In?, A?, M?, Ms?, R).

procedure mults_union1(Ans?, Mults?, Mult?, Mults?, Mults).
mults_union1(yes, A, _, Ms, R?) :- ground(A?), ground(Ms?) | mults_union(A?, Ms?, R).
mults_union1(no, A, M, Ms, R?) :- ground(A?), ground(M?), ground(Ms?) |
    mults_app(A?, [M?], A1),
    mults_union(A1?, Ms?, R).

procedure join_one(NRoleSpec?, Ints?, NRoleSpecs?, Mults?, Mults?, Mults, Mults).
join_one(RS, Is, Rs, A, D, RA?, RD?) :-
    ground(RS?), ground(Is?), ground(Rs?), ground(A?), ground(D?) |
    nrs_add(RS?, P),
    nrs_del(RS?, M),
    mults_union(A?, P?, A1),
    mults_union(D?, M?, D1),
    join_roles(Is?, Rs?, A1?, D1?, RA, RD).

procedure join_roles(Ints?, NRoleSpecs?, Mults?, Mults?, Mults, Mults).
join_roles([], _, A, D, A?, D?).
join_roles([I|Is], Rs, A, D, RA?, RD?) :-
    integer(I?), ground(Is?), ground(Rs?), ground(A?), ground(D?) |
    nth_nrs(Rs?, I?, RS),
    join_one(RS?, Is?, Rs?, A?, D?, RA, RD).

% c'_S := (c_S \ D) u A, with the side condition T after it.
procedure latex_assign(Mults?, Mults?, Chunks?, Chunks?, Chunks).
latex_assign(Add, Del, S, T, ['c\'_'|R?]) :-
    ground(Add?), ground(Del?), ground(S?), ground(T?) |
    update_rhs(Add?, Del?, ',', S?, T?, R1),
    chunks_app(S?, [' := '|R1?], R).

procedure assign_joined(Ints?, NRoleSpecs?, Chunks?, Chunks?, Chunks).
assign_joined(Is, Rs, S, T, R?) :- ground(Is?), ground(Rs?), ground(S?), ground(T?) |
    join_roles(Is?, Rs?, [], [], A, D),
    latex_assign(A?, D?, S?, T?, R).

% \mathrm{ext}_c(pi) of the listed role L.
procedure ext_of(Integer?, NRoleSpecs?, Chunks?, Chunks).
ext_of(L, Rs, T, R?) :- integer(L?), ground(Rs?), ground(T?) |
    nth_nrs(Rs?, L?, LR),
    latex_ext(LR?, L?, T?, R).

% Items of a side condition, joined by a comma and a control space, after a
% \qquad and in parentheses; none where there is no item.
procedure join_items(ChunkLists?, Chunks?, Chunks).
join_items([], T, T?).
join_items([C], T, R?) :- ground(C?), ground(T?) | chunks_app(C?, T?, R).
join_items([C, D|Cs], T, R?) :- ground(C?), ground(D?), ground(Cs?), ground(T?) |
    join_items([D?|Cs?], T?, R1),
    chunks_app(C?, [',\\ '|R1?], R).

procedure side(ChunkLists?, Chunks).
side([], []).
side([C|Cs], [' \\qquad ('|R?]) :- ground(C?), ground(Cs?) | join_items([C?|Cs?], [')'], R).

% The membership of a term W (a role's name, or q) in the extents of the
% listed roles Ls, those of S holding it and the rest not.
procedure mem_items(Ints?, Ints?, Chunks?, NRoleSpecs?, ChunkLists?, ChunkLists).
mem_items([], _, _, _, T, T?).
mem_items([L|Ls], S, W, Rs, T, [I?|R?]) :-
    integer(L?), ground(Ls?), ground(S?), ground(W?), ground(Rs?), ground(T?) |
    ints_member(S?, L?, In),
    mem_rel(In?, Op),
    ext_of(L?, Rs?, [], E),
    chunks_app(Op?, E?, OE),
    chunks_app(W?, OE?, I),
    mem_items(Ls?, S?, W?, Rs?, T?, R).

procedure mem_rel(Ans?, Chunks).
mem_rel(yes, [' \\in ']).
mem_rel(no, [' \\notin ']).

% The lines of the agent of the agent role A, one per case of the listed
% roles U its schema does not say whether hold it.
procedure agent_case_lines(IntLists?, Integer?, Ints?, Ints?, NRoleSpecs?, ChunkLists?, ChunkLists).
agent_case_lines([], _, _, _, _, T, T?).
agent_case_lines([S|Ss], A, K, U, Rs, T, [L?|R?]) :-
    ground(S?), ground(Ss?), integer(A?), ground(K?), ground(U?), ground(Rs?), ground(T?) |
    latex_role(A?, [], W),
    mem_items(U?, S?, W?, Rs?, [], Its),
    side(Its?, Sd),
    ints_app(K?, S?, KS),
    latex_sub(A?, Sub),
    assign_joined([A?|KS?], Rs?, Sub?, Sd?, L),
    agent_case_lines(Ss?, A?, K?, U?, Rs?, T?, R).

procedure agent_lines1(Ints?, Ints?, Integer?, Ints?, Ints?, NRoleSpecs?, ChunkLists?, ChunkLists).
agent_lines1(K, U, A, As, Ls, Rs, T, R?) :-
    ground(K?), ground(U?), integer(A?), ground(As?), ground(Ls?), ground(Rs?), ground(T?) |
    subsets(U?, Ss),
    agent_lines(As?, Ls?, Rs?, T?, R1),
    agent_case_lines(Ss?, A?, K?, U?, Rs?, R1?, R).

procedure agent_lines(Ints?, Ints?, NRoleSpecs?, ChunkLists?, ChunkLists).
agent_lines([], _, _, T, T?).
agent_lines([A|As], Ls, Rs, T, R?) :-
    integer(A?), ground(As?), ground(Ls?), ground(Rs?), ground(T?) |
    mems(Ls?, A?, Rs?, K, U),
    agent_lines1(K?, U?, A?, As?, Ls?, Rs?, T?, R).

% The agent roles whose agent may be in the extent of a listed role, which
% the lines of q leave out.
procedure x_agents(Ints?, Ints?, NRoleSpecs?, Ints).
x_agents([], _, _, []).
x_agents([A|As], Ls, Rs, R?) :- integer(A?), ground(As?), ground(Ls?), ground(Rs?) |
    mems(Ls?, A?, Rs?, K, U),
    x_agents(As?, Ls?, Rs?, R1),
    x_agent1(K?, U?, A?, R1?, R).

procedure x_agent1(Ints?, Ints?, Integer?, Ints?, Ints).
x_agent1([], [], _, T, T?).
x_agent1(K, U, A, T, [A?|T?]) :- otherwise, ground(K?), ground(U?), integer(A?), ground(T?) | true.

procedure neq_items(Ints?, ChunkLists?, ChunkLists).
neq_items([], T, T?).
neq_items([A|As], T, [I?|R?]) :- integer(A?), ground(As?), ground(T?) |
    latex_role(A?, [], W),
    chunks_app(['q \\neq '], W?, I),
    neq_items(As?, T?, R).

% The lines of q, one per nonempty set S of the listed roles whose extents
% hold it.
procedure q_lines1(IntLists?, Ints?, Ints?, NRoleSpecs?, ChunkLists?, ChunkLists).
q_lines1([], _, _, _, T, T?).
q_lines1([[]|Ss], Ls, X, Rs, T, R?) :- ground(Ss?), ground(Ls?), ground(X?), ground(Rs?), ground(T?) |
    q_lines1(Ss?, Ls?, X?, Rs?, T?, R).
q_lines1([[I|Is]|Ss], Ls, X, Rs, T, [L?|R?]) :-
    integer(I?), ground(Is?), ground(Ss?), ground(Ls?), ground(X?), ground(Rs?), ground(T?) |
    neq_items(X?, [], Ne),
    mem_items(Ls?, [I?|Is?], ['q'], Rs?, Ne?, Its),
    side(Its?, Sd),
    assign_joined([I?|Is?], Rs?, ['q'], Sd?, L),
    q_lines1(Ss?, Ls?, X?, Rs?, T?, R).

procedure q_lines(Ints?, Ints?, NRoleSpecs?, ChunkLists?, ChunkLists).
q_lines(Ls, As, Rs, T, R?) :- ground(Ls?), ground(As?), ground(Rs?), ground(T?) |
    subsets(Ls?, Ss),
    x_agents(As?, Ls?, Rs?, X),
    q_lines1(Ss?, Ls?, X?, Rs?, T?, R).

% The proviso conjuncts of the agent roles As, in role order: the required
% atoms (W = req) or the forbidden ones (W = forb).
Which ::= req ; forb.

procedure role_conj(Which?, NRoleSpec?, Chunks?, ChunkLists?, ChunkLists).
role_conj(req, RS, S, T, R?) :- ground(RS?), ground(S?), ground(T?) |
    nrs_req(RS?, Q),
    req_conj(Q?, ',', S?, T?, R).
role_conj(forb, RS, S, T, R?) :- ground(RS?), ground(S?), ground(T?) |
    nrs_forb(RS?, F),
    forb_conj(F?, ',', S?, T?, R).

procedure agent_conjs(Ints?, Which?, NRoleSpecs?, ChunkLists?, ChunkLists).
agent_conjs([], _, _, T, T?).
agent_conjs([A|As], W, Rs, T, R?) :-
    integer(A?), ground(As?), ground(W?), ground(Rs?), ground(T?) |
    nth_nrs(Rs?, A?, RS),
    latex_sub(A?, S),
    agent_conjs(As?, W?, Rs?, T?, R1),
    role_conj(W?, RS?, S?, R1?, R).

% The line of conjuncts Cs, with the side condition Sd; none where there is
% no conjunct.
procedure conj_line(ChunkLists?, Chunks?, ChunkLists?, ChunkLists).
conj_line([], _, T, T?).
conj_line([C|Cs], Sd, T, [['\\text{provided } '|L?]|T?]) :-
    ground(C?), ground(Cs?), ground(Sd?), ground(T?) |
    join_conjs([C?|Cs?], Sd?, L).

% The side condition of a listed role's conjunct: (q \in ext_c(pi)), where it
% has one.
procedure listed_side(ChunkLists?, Integer?, NRoleSpecs?, Chunks).
listed_side([], _, _, []).
listed_side([_|_], L, Rs, R?) :- integer(L?), ground(Rs?) |
    ext_of(L?, Rs?, [], E),
    chunks_app(['q \\in '], E?, I),
    side([I?], R).

% One listed role: its conjunct on the line of the agent roles', its side
% condition after it.  Several: a line for the agent roles' conjuncts, then
% one for each listed role's.
procedure prov_lines(Ints?, Ints?, Which?, NRoleSpecs?, ChunkLists?, ChunkLists).
prov_lines(As, [L], W, Rs, T, R?) :-
    ground(As?), integer(L?), ground(W?), ground(Rs?), ground(T?) |
    nth_nrs(Rs?, L?, LR),
    agent_conjs(As?, W?, Rs?, [], CA),
    prov_one(LR?, L?, CA?, W?, Rs?, T?, R).
prov_lines(As, Ls, W, Rs, T, R?) :-
    otherwise, ground(As?), ground(Ls?), ground(W?), ground(Rs?), ground(T?) |
    agent_conjs(As?, W?, Rs?, [], CA),
    listed_prov(Ls?, W?, Rs?, T?, R1),
    conj_line(CA?, [], R1?, R).

procedure prov_one(NRoleSpec?, Integer?, ChunkLists?, Which?, NRoleSpecs?, ChunkLists?, ChunkLists).
prov_one(LR, L, CA, W, Rs, T, R?) :-
    ground(LR?), integer(L?), ground(CA?), ground(W?), ground(Rs?), ground(T?) |
    role_conj(W?, LR?, ['q'], [], CL),
    prov_one1(CL?, L?, CA?, Rs?, T?, R).

procedure prov_one1(ChunkLists?, Integer?, ChunkLists?, NRoleSpecs?, ChunkLists?, ChunkLists).
prov_one1(CL, L, CA, Rs, T, R?) :-
    ground(CL?), integer(L?), ground(CA?), ground(Rs?), ground(T?) |
    listed_side(CL?, L?, Rs?, Sd),
    chunklists_app(CA?, CL?, Cs),
    conj_line(Cs?, Sd?, T?, R).

procedure listed_prov(Ints?, Which?, NRoleSpecs?, ChunkLists?, ChunkLists).
listed_prov([], _, _, T, T?).
listed_prov([L|Ls], W, Rs, T, R?) :-
    integer(L?), ground(Ls?), ground(W?), ground(Rs?), ground(T?) |
    nth_nrs(Rs?, L?, LR),
    listed_prov(Ls?, W?, Rs?, T?, R1),
    prov_one(LR?, L?, [], W?, Rs?, R1?, R).

procedure chunklists_app(ChunkLists?, ChunkLists?, ChunkLists).
chunklists_app([], T, T?).
chunklists_app([C|Cs], T, [C?|R?]) :- chunklists_app(Cs?, T?, R).

% The name terms sigma.y of a schema: those occurring among the arguments
% of its listed roles and of its atoms, with the name terms within them, that
% are of the form sigma.y, each once and in order of first occurrence.
procedure roles_nterms(RoleSpecs?, NameTerms?, NameTerms).
roles_nterms([], T, T?).
roles_nterms([RS|Rs], T, R?) :- ground(RS?), ground(Rs?), ground(T?) |
    rs_kind_args(RS?, KA),
    roles_nterms(Rs?, T?, R1),
    args_nterms(KA?, R1?, R).

procedure args_nterms(Args?, NameTerms?, NameTerms).
args_nterms([], T, T?).
args_nterms([nterm(S)|As], T, [S?|R?]) :- ground(S?), ground(As?), ground(T?) |
    args_nterms(As?, T?, R).
args_nterms([A|As], T, R?) :- otherwise, ground(A?), ground(As?), ground(T?) |
    args_nterms(As?, T?, R).

procedure ext_within(NameTerm?, NameTerms?, NameTerms).
ext_within(ext(S, Y), T, [ext(S?, Y?)|R?]) :- ground(S?), ground(Y?), ground(T?) |
    ext_within(S?, T?, R).
ext_within(own(_), T, T?).
ext_within(own_var(_), T, T?).

procedure ext_terms(NameTerms?, NameTerms?, NameTerms).
ext_terms([], T, T?).
ext_terms([S|Ss], T, R?) :- ground(S?), ground(Ss?), ground(T?) |
    ext_terms(Ss?, T?, R1),
    ext_within(S?, R1?, R).

procedure nterms_remove(NameTerms?, NameTerm?, NameTerms).
nterms_remove([], _, []).
nterms_remove([M|Ns], N, R?) :- M? =?= N? | nterms_remove(Ns?, N?, R).
nterms_remove([M|Ns], N, [M?|R?]) :- otherwise, ground(M?) | nterms_remove(Ns?, N?, R).

procedure nterms_dedup(NameTerms?, NameTerms).
nterms_dedup([], []).
nterms_dedup([N|Ns], [N?|R?]) :- ground(N?), ground(Ns?) |
    nterms_remove(Ns?, N?, Ns1),
    nterms_dedup(Ns1?, R).

procedure sch_ext_terms(Schema?, NameTerms).
sch_ext_terms(Sc, R?) :- ground(Sc?) |
    sch_roles(Sc?, Rs),
    roles_nterms(Rs?, [], N1),
    schema_args(Sc?, As),
    args_nterms(As?, [], N2),
    nterms_app(N1?, N2?, N),
    ext_terms(N?, [], Es),
    nterms_dedup(Es?, R).

% The name terms sigma.y occurring in an atom some role of the schema
% requires, as an argument or within one.
procedure req_ext_terms(RoleSpecs?, NameTerms).
req_ext_terms(Rs, R?) :- ground(Rs?) |
    req_atoms_all(Rs?, [], Req),
    atoms_args(Req?, [], As),
    args_nterms(As?, [], N),
    ext_terms(N?, [], R).

procedure req_atoms_all(RoleSpecs?, Atoms?, Atoms).
req_atoms_all([], T, T?).
req_atoms_all([RS|Rs], T, R?) :- ground(RS?), ground(Rs?), ground(T?) |
    rs_req(RS?, Q),
    req_atoms_all(Rs?, T?, R1),
    atoms_app(Q?, R1?, R).

% Those of Es occurring in no atom required at a role, which are the name
% terms def:compile asks freshness of.
procedure fresh_terms1(Ans?, NameTerm?, NameTerms?, NameTerms?, NameTerms).
fresh_terms1(yes, _, Es, Qs, R?) :- ground(Es?), ground(Qs?) | fresh_terms(Es?, Qs?, R).
fresh_terms1(no, S, Es, Qs, [S?|R?]) :- ground(Es?), ground(Qs?) | fresh_terms(Es?, Qs?, R).

procedure fresh_terms(NameTerms?, NameTerms?, NameTerms).
fresh_terms([], _, []).
fresh_terms([S|Es], Qs, R?) :- ground(S?), ground(Es?), ground(Qs?) |
    nt_member(Qs?, S?, A),
    fresh_terms1(A?, S?, Es?, Qs?, R).

procedure fresh_lines(NameTerms?, ChunkLists?, ChunkLists).
fresh_lines([], T, T?).
fresh_lines([S|Ss], T, [['\\text{provided } '|L?]|R?]) :-
    ground(S?), ground(Ss?), ground(T?) |
    latex_nt(S?, [' \\text{ is an argument of no atom of } c'], L),
    fresh_lines(Ss?, T?, R).

procedure join_lines(ChunkLists?, Chunks?, Chunks).
join_lines([], T, T?).
join_lines([L], T, ['&'|R?]) :- ground(L?), ground(T?) | chunks_app(L?, T?, R).
join_lines([L, M|Ls], T, ['&'|R?]) :- ground(L?), ground(M?), ground(Ls?), ground(T?) |
    join_lines([M?|Ls?], T?, R1),
    chunks_app(L?, [',\\\\'|R1?], R).

% The name terms are read off the plain form of the schema (self.glp,
% plain_schema), which has the same arguments.
procedure latex_schema_app(NSchema?, Chunks?, Chunks).
latex_schema_app(Sc, T, ['\\begin{align*}'|R?]) :- ground(Sc?), ground(T?) |
    nsch_roles(Sc?, Rs),
    nsch_constraint(Sc?, Cn),
    plain_schema(Sc?, P),
    latex_app_plain(P?, Rs?, Cn?, T?, R).

procedure latex_app_plain(Schema?, NRoleSpecs?, Constraint?, Chunks?, Chunks).
latex_app_plain(P, Rs, Cn, T, R?) :-
    ground(P?), ground(Rs?), ground(Cn?), ground(T?) |
    sch_ext_terms(P?, Es0),
    sch_roles(P?, PRs),
    latex_app_fresh(Rs?, PRs?, Es0?, Cn?, T?, R).

procedure latex_app_fresh(NRoleSpecs?, RoleSpecs?, NameTerms?, Constraint?, Chunks?, Chunks).
latex_app_fresh(Rs, PRs, Es0, Cn, T, R?) :-
    ground(Rs?), ground(PRs?), ground(Es0?), ground(Cn?), ground(T?) |
    req_ext_terms(PRs?, Qs),
    fresh_terms(Es0?, Qs?, Es),
    latex_app_roles(Rs?, Es?, Cn?, T?, R).

procedure latex_app_roles(NRoleSpecs?, NameTerms?, Constraint?, Chunks?, Chunks).
latex_app_roles(Rs, Es, Cn, T, R?) :- ground(Rs?), ground(Es?), ground(Cn?), ground(T?) |
    agent_idx(Rs?, 1, As),
    listed_idx(Rs?, 1, Ls),
    guard_roles(Rs?, 1, [], G),
    latex_guard(G?, [], GL),
    constraint_line(Cn?, [GL?], LC),
    fresh_lines(Es?, LC?, L3),
    gen_lines(As?, Ls?, Rs?, L3?, Lines),
    join_lines(Lines?, ['\\end{align*}'|T?], R).

procedure gen_lines(Ints?, Ints?, NRoleSpecs?, ChunkLists?, ChunkLists).
gen_lines(As, Ls, Rs, T, R?) :- ground(As?), ground(Ls?), ground(Rs?), ground(T?) |
    prov_lines(As?, Ls?, forb, Rs?, T?, L2),
    prov_lines(As?, Ls?, req, Rs?, L2?, L1),
    q_lines(Ls?, As?, Rs?, L1?, L0),
    agent_lines(As?, Ls?, Rs?, L0?, R).

% --- The display of one schema, in its form ------------------------------
% A schema of agent roles, written schema and with no name term, in the
% short form, of Section 5.1 and Appendix B.3; any other in the general
% form.

procedure s3_form(NSchema?, Ans).
s3_form(NSc, R?) :- ground(NSc?) |
    plain_schema(NSc?, Sc),
    s3_form_plain(Sc?, R).

procedure s3_form_plain(Schema?, Ans).
s3_form_plain(Sc, R?) :- ground(Sc?) |
    sch_roles(Sc?, Rs),
    roles_community(Rs?, A1),
    flip(A1?, A2),
    sch_nts(Sc?, Ns),
    nts_empty(Ns?, A3),
    both_yes(A2?, A3?, R).

procedure latex_schema1(Ans?, NSchema?, Chunks?, Chunks).
latex_schema1(yes, Sc, T, R?) :- ground(Sc?), ground(T?) | latex_schema_s3(Sc?, T?, R).
latex_schema1(no, Sc, T, R?) :- ground(Sc?), ground(T?) | latex_schema_app(Sc?, T?, R).

procedure latex_schema(Ans?, NSchema?, Chunks?, Chunks).
latex_schema(_, Sc, T, R?) :- ground(Sc?), ground(T?) |
    s3_form(Sc?, A),
    latex_schema1(A?, Sc?, T?, R).

% A schema's name is no part of its compiled form, so it is carried in a
% conditional TeX skips, and the whole output is pasted as it stands.
procedure latex_contract(Ans?, NContract?, Chunks?, Chunks).
latex_contract(_, [], T, T?).
latex_contract(K, [S|Ss], T, ['\\iffalse', Nm?, '\\fi'|R?]) :-
    ground(K?), ground(S?), ground(Ss?), ground(T?) |
    nsch_name(S?, Nm),
    latex_contract(K?, Ss?, T?, R1),
    latex_schema(K?, S?, R1?, R).

% --- Entry points ----------------------------------------------------------
% The checker first: a contract that is malformed, that is not syntactically
% grassroots (def:syntactically-grassroots) is not compiled at all.  A contract
% grassroots with wards is compiled as a syntactically grassroots one: the
% compilation of Section 5 uses nothing of the introductory act, and its
% realisation is taken as GSC's (GAI's appendix "Contracts with Wards", the
% paragraph after Definition Compilation).  A contract's reflexive
% predicates are no part of its compiled form, which is its schemas'.

% A schema of a contract as written, found by its name, or none.
NFoundS ::= found(NSchema) ; not_found.

procedure find_schema1(Constant?, Constant?, NSchema?, NContract?, NFoundS).
find_schema1(Nm, Sn, S, _, found(S?)) :- Nm? =?= Sn? | true.
find_schema1(_, Sn, _, Ss, R?) :- otherwise, ground(Sn?), ground(Ss?) |
    find_schema(Ss?, Sn?, R).

procedure find_schema(NContract?, Constant?, NFoundS).
find_schema([], _, not_found).
find_schema([S|Ss], Sn, R?) :- ground(S?), ground(Ss?), ground(Sn?) |
    nsch_name(S?, Nm),
    find_schema1(Nm?, Sn?, S?, Ss?, R).

procedure emit_schema(NFoundS?, Ans?, Constant?).
emit_schema(found(S), K, _) :- ground(S?), ground(K?) |
    latex_schema(K?, S?, [], L),
    send_to_user(L?).
emit_schema(not_found, _, Sn) :- ground(Sn?) |
    send_to_user(['% no schema named', Sn?, 'in this contract.']).

procedure not_compiled(Constant?).
not_compiled(Nm) :- ground(Nm?) |
    send_to_user(['% not compiled:', Nm?,
                  'is not syntactically grassroots; check_named gives the faults.']).

% A malformed contract is not compiled, and the message names each fault the
% checker found, schema and role, in the papers' words: GAI's appendix
% "Contracts with Wards" for a reflexive predicate and a signed term,
% def:schema for the form of a schema, and def:role and def:schema for a
% name term and a listed role.
procedure malformed_lines(Faults?, Chunks?, Chunks).
malformed_lines([], T, T?).
malformed_lines([reflexive(S, I, _)|Fs], T,
                [S?, 'at role', I?,
                 'adds or deletes the atom of a reflexive predicate naming that role;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([signed(S, I, _, not_added)|Fs], T,
                [S?, 'at role', I?,
                 'carries a signed term in an atom not marked +;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([signed(S, I, _, not_required)|Fs], T,
                [S?, 'at role', I?,
                 'carries a signed term whose speech-act variable occurs in no atom its role requires;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([signed(S, I, _, not_agent_role)|Fs], T,
                [S?, 'at role', I?,
                 'carries a signed term whose role is not an agent role;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([added_and_deleted(S, I, _)|Fs], T,
                [S?, 'at role', I?,
                 'adds and deletes the same atom;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([changes_nothing(S, I)|Fs], T,
                [S?, 'at role', I?,
                 'is not a guarding role and adds and deletes nothing;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([no_role_changes(S)|Fs], T,
                [S?, 'adds and deletes nothing at any role;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([head_not_variable(S, _)|Fs], T,
                [S?, 'lists in its head an entry that is not a variable;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([head_repeated(S, _)|Fs], T,
                [S?, 'lists a variable twice in its head;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([not_in_head(S, _)|Fs], T,
                [S?, 'has a variable its head does not list;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([name_term_base(S, _)|Fs], T,
                [S?, 'has a name term whose base is not an agent role of the schema;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([listed_base(S, I)|Fs], T,
                [S?, 'at role', I?,
                 'has a listed role whose base is not an agent role of the schema;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([listed_signed(S, I)|Fs], T,
                [S?, 'at role', I?,
                 'has a listed role with a signed term among its arguments;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([listed_guarded(S, I)|Fs], T,
                [S?, 'at role', I?,
                 'has a listed role carrying the mark ?, which only an agent role may carry;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([multiplicity_not_added(S, I, _)|Fs], T,
                [S?, 'at role', I?,
                 'carries a multiplicity on an atom it neither adds nor deletes;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([multiplicity_not_numeric(S, I, _)|Fs], T,
                [S?, 'at role', I?,
                 'carries a multiplicity that is not a number;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([multiplicity_not_whole(S, I, _)|Fs], T,
                [S?, 'at role', I?,
                 'carries a multiplicity that is not a positive whole number;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([constraint_not_numeric(S, _)|Fs], T,
                [S?, 'carries a constraint on an argument that is not a number;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([constraint_not_linear(S, _)|Fs], T,
                [S?, 'carries a constraint that is not linear;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([constraint_not_conjunction(S, _)|Fs], T,
                [S?, 'carries a constraint that is not a conjunction;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([_|Fs], T, R?) :- otherwise, ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).

procedure not_compiled_malformed(Constant?, Faults?).
not_compiled_malformed(Nm, Fs) :- ground(Nm?), ground(Fs?) |
    malformed_lines(Fs?, ['check_named gives the faults.'], L),
    send_to_user(['% not compiled:', Nm?, 'is malformed:'|L?]).

procedure compile_on(Verdict?, Constant?, NContract?).
compile_on(syntactically_grassroots, _, C) :- ground(C?) |
    latex_contract(no, C?, [], L),
    send_to_user(L?).
compile_on(grassroots_with_wards(_, _, _, _, _), _, C) :- ground(C?) |
    latex_contract(no, C?, [], L),
    send_to_user(L?).
compile_on(syntactically_grassroots_with_wards(_, _, _, _, _), _, C) :- ground(C?) |
    latex_contract(yes, C?, [], L),
    send_to_user(L?).
compile_on(not_grassroots(_), Nm, _) :- ground(Nm?) | not_compiled(Nm?).
compile_on(malformed(Fs), Nm, _) :- ground(Nm?), ground(Fs?) | not_compiled_malformed(Nm?, Fs?).

procedure compile_checked(Constant?, NDeclared?).
compile_checked(Nm, D) :- ground(Nm?), ground(D?) |
    check # check(D?, V),
    ndecl_schemas(D?, C),
    compile_on(V?, Nm?, C?).

exported procedure compile_named(Constant?).
compile_named(Nm) :- ground(Nm?) |
    contracts # contract(Nm?, C),
    compile_checked(Nm?, C?).

% A contract given as a term, under the name its displays are reported by.
exported procedure compile_contract(Constant?, NDeclared?).
compile_contract(Nm, D) :- ground(Nm?), ground(D?) |
    compile_checked(Nm?, D?).

% A fixture that changes a contract in one place, by name and the contract it
% changes (contracts.glp, variant/3).
exported procedure compile_variant(Constant?, Contract?).
compile_variant(Nm, B) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    compile_checked(Nm?, D?).

procedure compile_s_on(Verdict?, Constant?, Constant?, NContract?).
compile_s_on(syntactically_grassroots, _, Sn, C) :- ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, no, Sn?).
compile_s_on(grassroots_with_wards(_, _, _, _, _), _, Sn, C) :- ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, no, Sn?).
compile_s_on(syntactically_grassroots_with_wards(_, _, _, _, _), _, Sn, C) :-
    ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, yes, Sn?).
compile_s_on(not_grassroots(_), Nm, _, _) :- ground(Nm?) | not_compiled(Nm?).
compile_s_on(malformed(Fs), Nm, _, _) :- ground(Nm?), ground(Fs?) | not_compiled_malformed(Nm?, Fs?).

procedure compile_s_checked(Constant?, Constant?, NDeclared?).
compile_s_checked(Nm, Sn, D) :- ground(Nm?), ground(Sn?), ground(D?) |
    check # check(D?, V),
    ndecl_schemas(D?, C),
    compile_s_on(V?, Nm?, Sn?, C?).

exported procedure compile_schema(Constant?, Constant?).
compile_schema(Nm, Sn) :- ground(Nm?), ground(Sn?) |
    contracts # contract(Nm?, C),
    compile_s_checked(Nm?, Sn?, C?).

exported procedure compile_schema_in(Constant?, NDeclared?, Constant?).
compile_schema_in(Nm, D, Sn) :- ground(Nm?), ground(D?), ground(Sn?) |
    compile_s_checked(Nm?, Sn?, D?).

exported procedure compile_schema_variant(Constant?, Contract?, Constant?).
compile_schema_variant(Nm, B, Sn) :- ground(Nm?), ground(B?), ground(Sn?) |
    contracts # variant(Nm?, B?, D),
    compile_s_checked(Nm?, Sn?, D?).
