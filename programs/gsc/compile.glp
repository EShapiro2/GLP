% ---------------------------------------------------------------------------
% The compilation, as LaTeX: def:compile of /Grassroots/GSC, Section 5, for
% a contract whose roles are all party roles, and definition:compile of
% Appendix D for a contract with community roles.
%
% A schema of Section 3 -- its roles agent roles, no reach condition and no
% name term -- compiles to the assignment, the proviso and the guard of
% def:compile, and the displays of Section 5.1 and Appendix B.3 are the form
% printed, whatever the contract it is in: befriend of GSNP, a contract with
% a seated role, compiles to Section 5.1's display, as Section 5.1 says.  Any
% other schema compiles to the lines of definition:compile, and the worked
% box of Appendix D is the form printed.  For a schema of Section 3 the two
% definitions determine the same transactions.  The paper is the
% specification and neither definition is restated in this file.  Section 5
% opens by saying that the compilation is defined for syntactically
% grassroots contracts, so compile_named runs the checker first and compiles
% nothing otherwise; an agent-named contract with community roles is
% compiled when it is syntactically grassroots by definition:sg-agent-named,
% and any other contract with community roles when it meets the conditions on
% the text of Appendix D.
%
% GLP has no string concatenation, so a display is emitted as its tokens, one
% to a line.  A newline is whitespace to LaTeX, so the lines are the display
% and are pasted as they stand.
% ---------------------------------------------------------------------------

imported procedure check#check(Declared?, Verdict).
imported procedure contracts#contract(Constant?, Declared).
imported procedure contracts#variant(Constant?, Contract?, Declared).

procedure chunks_app(Chunks?, Chunks?, Chunks).
chunks_app([], T, T?).
chunks_app([C|Cs], T, [C?|R?]) :- chunks_app(Cs?, T?, R).

procedure is_empty(Atoms?, Ans).
is_empty([], yes).
is_empty([_|_], no).

% --- Arguments (def:schema, definition:term) -------------------------------
% Roles one and two are the paper's \Alice and \Bob; a party or speech-act
% variable is written as it is named; a name variable and a threshold are
% named by a Greek letter and written as its command.

procedure latex_role(Integer?, Chunks?, Chunks).
latex_role(I, T, ['\\Alice'|T?]) :- I? =:= 1 | true.
latex_role(I, T, ['\\Bob'|T?]) :- I? =:= 2 | true.
latex_role(I, T, ['\\mathit{Carol}'|T?]) :- I? =:= 3 | true.
latex_role(I, T, ['\\mathit{Dave}'|T?]) :- I? =:= 4 | true.
latex_role(I, T, R?) :- otherwise, integer(I?), ground(T?) | latex_role_n(I?, T?, R).

% A role beyond the fourth has no name in the paper and is written p_i.
procedure latex_role_n(Constant?, Chunks?, Chunks).
latex_role_n(I, T, ['\\mathit{p}_{', I?, '}'|T?]).

procedure latex_greek(Constant?, Chunks?, Chunks).
latex_greek(alpha, T, ['\\alpha'|T?]).
latex_greek(beta, T, ['\\beta'|T?]).
latex_greek(gamma, T, ['\\gamma'|T?]).
latex_greek(delta, T, ['\\delta'|T?]).
latex_greek(epsilon, T, ['\\epsilon'|T?]).
latex_greek(zeta, T, ['\\zeta'|T?]).
latex_greek(eta, T, ['\\eta'|T?]).
latex_greek(theta, T, ['\\theta'|T?]).
latex_greek(iota, T, ['\\iota'|T?]).
latex_greek(kappa, T, ['\\kappa'|T?]).
latex_greek(lambda, T, ['\\lambda'|T?]).
latex_greek(mu, T, ['\\mu'|T?]).
latex_greek(nu, T, ['\\nu'|T?]).
latex_greek(xi, T, ['\\xi'|T?]).
latex_greek(pi, T, ['\\pi'|T?]).
latex_greek(rho, T, ['\\rho'|T?]).
latex_greek(sigma, T, ['\\sigma'|T?]).
latex_greek(tau, T, ['\\tau'|T?]).
latex_greek(upsilon, T, ['\\upsilon'|T?]).
latex_greek(phi, T, ['\\phi'|T?]).
latex_greek(chi, T, ['\\chi'|T?]).
latex_greek(psi, T, ['\\psi'|T?]).
latex_greek(omega, T, ['\\omega'|T?]).
latex_greek(X, T, ['\\mathit{', X?, '}'|T?]) :- otherwise, ground(X?) | true.

% A name term (definition:term): <u> for a role or a party variable, a name
% variable, or sigma.y.
procedure latex_nt(NameTerm?, Chunks?, Chunks).
latex_nt(own(I), T, ['\\langle'|R?]) :- integer(I?), ground(T?) |
    latex_role(I?, ['\\rangle'|T?], R).
latex_nt(own_var(X), T, ['\\langle', X?, '\\rangle'|T?]).
latex_nt(nvar(Z), T, R?) :- ground(Z?), ground(T?) | latex_greek(Z?, T?, R).
latex_nt(ext(S, Y), T, R?) :- ground(S?), ground(Y?), ground(T?) |
    latex_nt(S?, ['\\cdot', Y?|T?], R).

% A signed term is written \mathrm{sgn}(x,\Alice), as Section 3.3 writes it.
procedure latex_arg(Arg?, Chunks?, Chunks).
latex_arg(role(I), T, R?) :- integer(I?), ground(T?) | latex_role(I?, T?, R).
latex_arg(pvar(X), T, [X?|T?]).
latex_arg(svar(X), T, [X?|T?]).
latex_arg(nterm(S), T, R?) :- ground(S?), ground(T?) | latex_nt(S?, T?, R).
latex_arg(sgn(X, J), T, ['\\mathrm{sgn}(', X?, ','|R?]) :-
    ground(X?), integer(J?), ground(T?) |
    latex_role(J?, [')'|T?], R).

procedure latex_args(Args?, Chunks?, Chunks).
latex_args([], T, T?).
latex_args([A], T, R?) :- ground(A?), ground(T?) | latex_arg(A?, T?, R).
latex_args([A, B|As], T, R?) :- ground(A?), ground(B?), ground(As?), ground(T?) |
    latex_args([B?|As?], T?, R1),
    latex_arg(A?, [','|R1?], R).

% --- Atoms -----------------------------------------------------------------
% The paper writes the currency's predicate as the cent sign; every other
% predicate is set in \mathit.  A predicate of arity zero carries no
% parentheses.

procedure latex_pred(Constant?, Chunks?, Chunks).
latex_pred(P, T, ['\\text{\\textcent}'|T?]) :- P? =?= coin | true.
latex_pred(P, T, ['\\mathit{', P?, '}'|T?]) :- otherwise, ground(P?) | true.

procedure latex_atom(Atom?, Chunks?, Chunks).
latex_atom(atom(P, []), T, R?) :- ground(P?), ground(T?) | latex_pred(P?, T?, R).
latex_atom(atom(P, [A|As]), T, R?) :-
    ground(P?), ground(A?), ground(As?), ground(T?) |
    latex_args([A?|As?], [')'|T?], R1),
    latex_pred(P?, ['('|R1?], R).

% The atoms of a set are written apart by Sep, which the form of the display
% supplies: a comma in the form of Section 5.1 and Appendix B.3, whose displays write no set of
% two atoms, and a comma and a control space in the form of Appendix D, as its
% worked box writes the two atoms federate adds.  latex_update and
% req_conjs and forb_conjs supply the first, assign_lines and req_lines and
% forb_lines the second.
procedure latex_atoms(Atoms?, Constant?, Chunks?, Chunks).
latex_atoms([], _, T, T?).
latex_atoms([A], _, T, R?) :- ground(A?), ground(T?) | latex_atom(A?, T?, R).
latex_atoms([A, B|As], Sep, T, R?) :-
    ground(A?), ground(B?), ground(As?), ground(Sep?), ground(T?) |
    latex_atoms([B?|As?], Sep?, T?, R1),
    latex_atom(A?, [Sep?|R1?], R).

procedure latex_set(Atoms?, Constant?, Chunks?, Chunks).
latex_set(As, Sep, T, ['\\{'|R?]) :- ground(As?), ground(Sep?), ground(T?) |
    latex_atoms(As?, Sep?, ['\\}'|T?], R).

% --- The roles as the paper writes them (definition:role, definition:extent)
% A party role by its name, a seated role sigma^{mu} and a constituent role
% sigma^{rho*}; ext_c(pi_i) is the extent of the role in c, and a line of
% Appendix D's display ranges over the agents p in it.

procedure latex_role_term(RoleSpec?, Integer?, Chunks?, Chunks).
latex_role_term(rs(_, _, _, _, _), I, T, R?) :- integer(I?), ground(T?) |
    latex_role(I?, T?, R).
latex_role_term(crs(seated(S, Mu), _, _, _, _, _), _, T, R?) :-
    ground(S?), ground(Mu?), ground(T?) |
    latex_pred(Mu?, ['}'|T?], R1),
    latex_nt_sup(S?, ['^{'|R1?], R).
latex_role_term(crs(constituent(S, Rho), _, _, _, _, _), _, T, R?) :-
    ground(S?), ground(Rho?), ground(T?) |
    latex_pred(Rho?, ['\\ast}'|T?], R1),
    latex_nt_sup(S?, ['^{'|R1?], R).

% The name term under a superscript: sigma.y in parentheses, as the paper
% writes the seated role of close, (<Alice>.n)^{member} (GSC, Appendix D.4
% and Section 3.3).
procedure latex_nt_sup(NameTerm?, Chunks?, Chunks).
latex_nt_sup(ext(S, Y), T, ['('|R?]) :- ground(S?), ground(Y?), ground(T?) |
    latex_nt(ext(S?, Y?), [')'|T?], R).
latex_nt_sup(S, T, R?) :- otherwise, ground(S?), ground(T?) | latex_nt(S?, T?, R).

procedure latex_ext(RoleSpec?, Integer?, Chunks?, Chunks).
latex_ext(RS, I, T, ['\\mathrm{ext}_c('|R?]) :-
    ground(RS?), integer(I?), ground(T?) |
    latex_role_term(RS?, I?, [')'|T?], R).

procedure latex_over(RoleSpec?, Integer?, Chunks?, Chunks).
latex_over(RS, I, T, ['&& (p \\in '|R?]) :-
    ground(RS?), integer(I?), ground(T?) |
    latex_ext(RS?, I?, [')'|T?], R).

% --- The assignment of one role (def:compile, definition:compile) ----------
% c'_S := (c_S \ -(i)) u +(i), with an empty half left out, and both at a
% guarding role that adds and deletes nothing, which def:schema admits:
% c'_S := c_S, the assignment def:compile gives it (1 <= i <= k); S is the
% subscript, {\Alice} for a role of Section 5.1 and Appendix B.3 and p, ranging over the
% extent, for a role of Appendix D.

procedure update_body(Ans?, Ans?, Atoms?, Atoms?, Constant?, Chunks?, Chunks?,
                      Chunks).
update_body(yes, yes, _, _, _, S, T, ['c_'|R?]) :- ground(S?), ground(T?) |
    chunks_app(S?, T?, R).
update_body(no, yes, Add, _, Sep, S, T, ['c_'|R?]) :-
    ground(Add?), ground(Sep?), ground(S?), ground(T?) |
    latex_set(Add?, Sep?, T?, R1),
    chunks_app(S?, [' \\uplus '|R1?], R).
update_body(yes, no, _, Del, Sep, S, T, ['c_'|R?]) :-
    ground(Del?), ground(Sep?), ground(S?), ground(T?) |
    latex_set(Del?, Sep?, T?, R1),
    chunks_app(S?, [' \\setminus '|R1?], R).
update_body(no, no, Add, Del, Sep, S, T, ['(c_'|R?]) :-
    ground(Add?), ground(Del?), ground(Sep?), ground(S?), ground(T?) |
    latex_set(Add?, Sep?, T?, R1),
    latex_set(Del?, Sep?, [') \\uplus '|R1?], R2),
    chunks_app(S?, [' \\setminus '|R2?], R).

procedure latex_update_at(RoleSpec?, Constant?, Chunks?, Chunks?, Chunks).
latex_update_at(RS, Sep, S, T, ['c\'_'|R?]) :-
    ground(RS?), ground(Sep?), ground(S?), ground(T?) |
    rs_add(RS?, Add),
    rs_del(RS?, Del),
    update_rhs(Add?, Del?, Sep?, S?, T?, R1),
    chunks_app(S?, [' := '|R1?], R).

procedure update_rhs(Atoms?, Atoms?, Constant?, Chunks?, Chunks?, Chunks).
update_rhs(Add, Del, Sep, S, T, R?) :-
    ground(Add?), ground(Del?), ground(Sep?), ground(S?), ground(T?) |
    is_empty(Add?, AE),
    is_empty(Del?, DE),
    update_body(AE?, DE?, Add?, Del?, Sep?, S?, T?, R).

% The subscript of a party role in Section 5.1 and Appendix B.3: {\Alice}.
procedure latex_sub(Integer?, Chunks).
latex_sub(I, ['{'|R?]) :- integer(I?) | latex_role(I?, ['}'], R).

procedure latex_update(RoleSpec?, Integer?, Chunks?, Chunks).
latex_update(RS, I, T, R?) :- ground(RS?), integer(I?), ground(T?) |
    latex_sub(I?, S),
    latex_update_at(RS?, ',', S?, T?, R).

procedure latex_updates(RoleSpecs?, Integer?, Chunks?, Chunks).
latex_updates([], _, T, T?).
latex_updates([RS], I, T, R?) :- ground(RS?), integer(I?), ground(T?) |
    latex_update(RS?, I?, T?, R).
latex_updates([RS, RS2|Rs], I, T, R?) :-
    ground(RS?), ground(RS2?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    latex_updates([RS2?|Rs?], I1?, T?, R1),
    latex_update(RS?, I?, [', \\qquad '|R1?], R).

% --- The proviso of one role (def:compile, definition:compile) -------------
% =(i) u -(i) included in c_S and not(i) disjoint from it, one conjunct each
% and left out when the multiset is empty; a singleton is written with \in and
% \notin, as Section 5.1 and Appendix B.3 write it.  The layout is Udi's
% ruling (GSC #3 to Code, 2026-10-18 21:49 UTC; GSC aca046b, Definition
% Compilation and Appendix D's, befriend's display in Section 5.1 and the
% swap's in Appendix B.3): the required atoms on one proviso line and the
% forbidden atoms on the next, each in role order, a line omitted when it
% has no atom, and the guard on a line of its own.

procedure req_conj(Atoms?, Constant?, Chunks?, ChunkLists?, ChunkLists).
req_conj([], _, _, T, T?).
req_conj([A], _, S, T, [C?|T?]) :- ground(A?), ground(S?), ground(T?) |
    latex_atom(A?, [' \\in c_'|S?], C).
req_conj([A, B|As], Sep, S, T, [C?|T?]) :-
    ground(A?), ground(B?), ground(As?), ground(Sep?), ground(S?), ground(T?) |
    latex_set([A?, B?|As?], Sep?, [' \\subseteq c_'|S?], C).

procedure forb_conj(Atoms?, Constant?, Chunks?, ChunkLists?, ChunkLists).
forb_conj([], _, _, T, T?).
forb_conj([A], _, S, T, [C?|T?]) :- ground(A?), ground(S?), ground(T?) |
    latex_atom(A?, [' \\notin c_'|S?], C).
forb_conj([A, B|As], Sep, S, T, [C?|T?]) :-
    ground(A?), ground(B?), ground(As?), ground(Sep?), ground(S?), ground(T?) |
    chunks_app(S?, [' = \\emptyset'], S1),
    latex_set([A?, B?|As?], Sep?, [' \\cap c_'|S1?], C).

% The conjuncts of the required atoms of every role of Section 3's form, in
% role order, and those of the forbidden atoms.
procedure req_conjs(RoleSpecs?, Integer?, ChunkLists?, ChunkLists).
req_conjs([], _, T, T?).
req_conjs([RS|Rs], I, T, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    req_conjs(Rs?, I1?, T?, T1),
    latex_sub(I?, S),
    rs_req(RS?, Req),
    req_conj(Req?, ',', S?, T1?, R).

procedure forb_conjs(RoleSpecs?, Integer?, ChunkLists?, ChunkLists).
forb_conjs([], _, T, T?).
forb_conjs([RS|Rs], I, T, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    forb_conjs(Rs?, I1?, T?, T1),
    latex_sub(I?, S),
    rs_forb(RS?, Forb),
    forb_conj(Forb?, ',', S?, T1?, R).

procedure join_conjs(ChunkLists?, Chunks?, Chunks).
join_conjs([], T, T?).
join_conjs([C], T, R?) :- ground(C?), ground(T?) | chunks_app(C?, T?, R).
join_conjs([C, D|Cs], T, R?) :- ground(C?), ground(D?), ground(Cs?), ground(T?) |
    join_conjs([D?|Cs?], T?, R1),
    chunks_app(C?, [' \\text{ and } '|R1?], R).

% A proviso line of Section 3's form, its conjuncts joined by "and"; no
% line where there is no conjunct.
procedure provided_line(ChunkLists?, ChunkLists?, ChunkLists).
provided_line([], T, T?).
provided_line([C|Cs], T, [['\\text{provided } '|L?]|T?]) :-
    ground(C?), ground(Cs?), ground(T?) |
    join_conjs([C?|Cs?], [], L).

% --- The guarding roles of a schema -----------------------------------------

procedure guard_roles(RoleSpecs?, Integer?, Ints?, Ints).
guard_roles([], _, T, T?).
guard_roles([RS|Rs], I, T, R?) :- ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    is_guarding(RS?, A),
    guard_roles1(A?, Rs?, I?, T?, R).

procedure guard_roles1(Ans?, RoleSpecs?, Integer?, Ints?, Ints).
guard_roles1(yes, Rs, I, T, [I?|R?]) :- ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, T?, R).
guard_roles1(no, Rs, I, T, R?) :- ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, T?, R).

% --- The guard (def:compile): the guarding roles ---------------------------

procedure latex_guard_list(Ints?, Chunks?, Chunks).
latex_guard_list([], T, T?).
latex_guard_list([I], T, R?) :- integer(I?), ground(T?) | latex_role(I?, T?, R).
latex_guard_list([I, J|Is], T, R?) :-
    integer(I?), integer(J?), ground(Is?), ground(T?) |
    latex_guard_list([J?|Is?], T?, R1),
    latex_role(I?, [','|R1?], R).

procedure latex_guard(Ints?, Chunks?, Chunks).
latex_guard([], T, ['\\text{guarded by } \\emptyset'|T?]).
latex_guard([I|Is], T, ['\\text{guarded by } \\{'|R?]) :-
    integer(I?), ground(Is?), ground(T?) |
    latex_guard_list([I?|Is?], ['\\}'|T?], R).

% --- The display of a schema of Section 3 (Section 5.1, Appendix B.3) -----
% The assignments of every role on one line; the required atoms on the next,
% the forbidden atoms on the next, each left out when it has no atom; and the
% guard on a line of its own, as befriend's display in Section 5.1 and the
% swap's in Appendix B.3 print them (GSC aca046b).  Each line opens with &
% and ,\\ separates them (join_lines, below).

procedure latex_schema_s3(Schema?, Chunks?, Chunks).
latex_schema_s3(Sc, T, ['\\begin{align*}'|R?]) :-
    ground(Sc?), ground(T?) |
    sch_roles(Sc?, Rs),
    latex_s3_roles(Rs?, T?, R).

procedure latex_s3_roles(RoleSpecs?, Chunks?, Chunks).
latex_s3_roles(Rs, T, R?) :- ground(Rs?), ground(T?) |
    guard_roles(Rs?, 1, [], G),
    latex_guard(G?, [], GL),
    forb_conjs(Rs?, 1, [], Fs),
    provided_line(Fs?, [GL?], L3),
    req_conjs(Rs?, 1, [], Qs),
    provided_line(Qs?, L3?, L2),
    latex_updates(Rs?, 1, [], A),
    join_lines([A?|L2?], ['\\end{align*}'|T?], R).

% --- The display of a schema with community roles (definition:compile) ----
% In the order of the lines of definition:compile (GSC aca046b): a line per
% role for its assignment; a line per role that requires an atom, for its
% required atoms, in role order; a line per role that forbids an atom, for
% its forbidden atoms, in role order; a line c'_p \neq c_p per role that adds
% and deletes nothing and is not a guarding agent role (change_lines, below);
% each over p in ext_c(pi_i); then provided Theta, where the schema carries
% reach conditions; then, for every name term sigma.y of the schema that
% occurs in no atom required at a role, that it is an argument of no atom of
% c (definition:compile at GSC 6d4f147); then the guard.  A role's atoms range over
% its own extent, so the one line of Section 3's form for the required atoms,
% and the one for the forbidden atoms, is a line per role here, as the
% assignment is.  Each line is a Chunks; every line opens with & and ,\\
% separates them.  The worked box of Appendix D is the display for federate.

procedure assign_lines(RoleSpecs?, Integer?, ChunkLists?, ChunkLists).
assign_lines([], _, T, T?).
assign_lines([RS|Rs], I, T, [L?|R?]) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    latex_over(RS?, I?, [], O),
    latex_update_at(RS?, ',\\ ', ['p'], O?, L),
    I1 := I? + 1,
    assign_lines(Rs?, I1?, T?, R).

procedure proviso_line(ChunkLists?, RoleSpec?, Integer?, ChunkLists?, ChunkLists).
proviso_line([], _, _, T, T?).
proviso_line([C|Cs], RS, I, T, [['\\text{provided } '|L?]|T?]) :-
    ground(C?), ground(Cs?), ground(RS?), integer(I?), ground(T?) |
    latex_over(RS?, I?, [], O),
    join_conjs([C?|Cs?], O?, L).

procedure req_lines(RoleSpecs?, Integer?, ChunkLists?, ChunkLists).
req_lines([], _, T, T?).
req_lines([RS|Rs], I, T, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    rs_req(RS?, Req),
    req_conj(Req?, ',\\ ', ['p'], [], Cs),
    I1 := I? + 1,
    req_lines(Rs?, I1?, T?, R1),
    proviso_line(Cs?, RS?, I?, R1?, R).

procedure forb_lines(RoleSpecs?, Integer?, ChunkLists?, ChunkLists).
forb_lines([], _, T, T?).
forb_lines([RS|Rs], I, T, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    rs_forb(RS?, Forb),
    forb_conj(Forb?, ',\\ ', ['p'], [], Cs),
    I1 := I? + 1,
    forb_lines(Rs?, I1?, T?, R1),
    proviso_line(Cs?, RS?, I?, R1?, R).

% The proviso c'_p \neq c_p (definition:compile), over the extent of a role
% that is not a guarding agent role.  The worked box of Appendix D leaves it
% out for federate, whose one role, a seated role, adds two atoms: at a role
% that adds or deletes an atom it holds under the other provisos, what is
% added and what is deleted at p being disjoint and what is deleted being in
% c_p.  So it is printed at a role that adds and deletes nothing and is not a
% guarding agent role, and nowhere else.  Section 5's def:compile asks it at
% a role that is not guarding, which def:schema forbids to add and delete
% nothing, so the form of Section 5.1 and Appendix B.3 never carries it.

procedure guarding_agent(RoleSpec?, Ans).
guarding_agent(RS, R?) :- ground(RS?) |
    is_party_role(RS?, P),
    is_guarding(RS?, G),
    both_yes(P?, G?, R).

procedure role_inert(RoleSpec?, Ans).
role_inert(RS, R?) :- ground(RS?) |
    rs_add(RS?, Add),
    rs_del(RS?, Del),
    is_empty(Add?, AE),
    is_empty(Del?, DE),
    both_yes(AE?, DE?, R).

procedure change_line(Ans?, Ans?, RoleSpec?, Integer?, ChunkLists?, ChunkLists).
change_line(no, yes, RS, I, T, [['\\text{provided } ', 'c\'_p', '\\neq', 'c_p'|O?]|T?]) :-
    ground(RS?), integer(I?), ground(T?) |
    latex_over(RS?, I?, [], O).
change_line(no, no, _, _, T, T?).
change_line(yes, _, _, _, T, T?).

procedure change_lines(RoleSpecs?, Integer?, ChunkLists?, ChunkLists).
change_lines([], _, T, T?).
change_lines([RS|Rs], I, T, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    guarding_agent(RS?, GA),
    role_inert(RS?, IN),
    I1 := I? + 1,
    change_lines(Rs?, I1?, T?, R1),
    change_line(GA?, IN?, RS?, I?, R1?, R).

% A reach condition sigma !~>_rho sigma' (definition:schema); the conditions
% of Theta are joined as the conjuncts of a proviso are.
procedure latex_reach(Reach?, Chunks?, Chunks).
latex_reach(reach(S, Rho, S2), T, R?) :-
    ground(S?), ground(Rho?), ground(S2?), ground(T?) |
    latex_nt(S2?, T?, R1),
    latex_pred(Rho?, ['}'|R1?], R2),
    latex_nt(S?, ['\\not\\rightsquigarrow_{'|R2?], R).

procedure latex_reaches(Reaches?, Chunks?, Chunks).
latex_reaches([], T, T?).
latex_reaches([X], T, R?) :- ground(X?), ground(T?) | latex_reach(X?, T?, R).
latex_reaches([X, Y|Xs], T, R?) :- ground(X?), ground(Y?), ground(Xs?), ground(T?) |
    latex_reaches([Y?|Xs?], T?, R1),
    latex_reach(X?, [' \\text{ and } '|R1?], R).

procedure reach_line(Reaches?, ChunkLists?, ChunkLists).
reach_line([], T, T?).
reach_line([X|Xs], T, [['\\text{provided } '|L?]|T?]) :-
    ground(X?), ground(Xs?), ground(T?) |
    latex_reaches([X?|Xs?], [], L).

% The name terms sigma.y of a schema: those occurring in its roles, its atoms
% and its reach conditions, with the name terms within them, that are of the
% form sigma.y, each once and in order of first occurrence.
procedure roles_nterms(RoleSpecs?, NameTerms?, NameTerms).
roles_nterms([], T, T?).
roles_nterms([RS|Rs], T, R?) :- ground(RS?), ground(Rs?), ground(T?) |
    rs_nterm(RS?, N),
    roles_nterms(Rs?, T?, R1),
    nterms_app(N?, R1?, R).

procedure args_nterms(Args?, NameTerms?, NameTerms).
args_nterms([], T, T?).
args_nterms([nterm(S)|As], T, [S?|R?]) :- ground(S?), ground(As?), ground(T?) |
    args_nterms(As?, T?, R).
args_nterms([A|As], T, R?) :- otherwise, ground(A?), ground(As?), ground(T?) |
    args_nterms(As?, T?, R).

procedure reaches_nterms(Reaches?, NameTerms?, NameTerms).
reaches_nterms([], T, T?).
reaches_nterms([reach(S, _, S2)|Xs], T, [S?, S2?|R?]) :-
    ground(S?), ground(S2?), ground(Xs?), ground(T?) |
    reaches_nterms(Xs?, T?, R).

procedure ext_within(NameTerm?, NameTerms?, NameTerms).
ext_within(ext(S, Y), T, [ext(S?, Y?)|R?]) :- ground(S?), ground(Y?), ground(T?) |
    ext_within(S?, T?, R).
ext_within(own(_), T, T?).
ext_within(own_var(_), T, T?).
ext_within(nvar(_), T, T?).

procedure ext_terms(NameTerms?, NameTerms?, NameTerms).
ext_terms([], T, T?).
ext_terms([S|Ss], T, R?) :- ground(S?), ground(Ss?), ground(T?) |
    ext_terms(Ss?, T?, R1),
    ext_within(S?, R1?, R).

procedure nterms_remove(NameTerms?, NameTerm?, NameTerms).
nterms_remove([], _, []).
nterms_remove([M|Ns], N, R?) :- M? =?= N? | nterms_remove(Ns?, N?, R).
nterms_remove([M|Ns], N, [M?|R?]) :- otherwise, ground(M?) | nterms_remove(Ns?, N?, R).

procedure nterms_dedup(NameTerms?, NameTerms).
nterms_dedup([], []).
nterms_dedup([N|Ns], [N?|R?]) :- ground(N?), ground(Ns?) |
    nterms_remove(Ns?, N?, Ns1),
    nterms_dedup(Ns1?, R).

procedure sch_ext_terms(Schema?, NameTerms).
sch_ext_terms(Sc, R?) :- ground(Sc?) |
    sch_roles(Sc?, Rs),
    sch_reaches(Sc?, Th),
    roles_nterms(Rs?, [], N1),
    schema_args(Sc?, As),
    args_nterms(As?, [], N2),
    reaches_nterms(Th?, [], N3),
    nterms_app(N2?, N3?, N23),
    nterms_app(N1?, N23?, N),
    ext_terms(N?, [], Es),
    nterms_dedup(Es?, R).

% The name terms sigma.y occurring in an atom some role of the schema
% requires, as an argument or within one.
procedure req_ext_terms(RoleSpecs?, NameTerms).
req_ext_terms(Rs, R?) :- ground(Rs?) |
    req_atoms_all(Rs?, [], Req),
    atoms_args(Req?, [], As),
    args_nterms(As?, [], N),
    ext_terms(N?, [], R).

procedure req_atoms_all(RoleSpecs?, Atoms?, Atoms).
req_atoms_all([], T, T?).
req_atoms_all([RS|Rs], T, R?) :- ground(RS?), ground(Rs?), ground(T?) |
    rs_req(RS?, Q),
    req_atoms_all(Rs?, T?, R1),
    atoms_app(Q?, R1?, R).

% Those of Es occurring in no atom required at a role, which are the name
% terms definition:compile asks freshness of.
procedure fresh_terms1(Ans?, NameTerm?, NameTerms?, NameTerms?, NameTerms).
fresh_terms1(yes, _, Es, Qs, R?) :- ground(Es?), ground(Qs?) | fresh_terms(Es?, Qs?, R).
fresh_terms1(no, S, Es, Qs, [S?|R?]) :- ground(Es?), ground(Qs?) | fresh_terms(Es?, Qs?, R).

procedure fresh_terms(NameTerms?, NameTerms?, NameTerms).
fresh_terms([], _, []).
fresh_terms([S|Es], Qs, R?) :- ground(S?), ground(Es?), ground(Qs?) |
    nt_member(Qs?, S?, A),
    fresh_terms1(A?, S?, Es?, Qs?, R).

procedure fresh_lines(NameTerms?, ChunkLists?, ChunkLists).
fresh_lines([], T, T?).
fresh_lines([S|Ss], T, [['\\text{provided } '|L?]|R?]) :-
    ground(S?), ground(Ss?), ground(T?) |
    latex_nt(S?, [' \\text{ is an argument of no atom of } c'], L),
    fresh_lines(Ss?, T?, R).

% --- The guard of Appendix D (definition:compile) ---------------------------
% guarded by G_{i_1} u ... u G_{i_n}, with G_{i_j} a part of ext_c(pi_{i_j})
% larger than theta_{i_j} of it, the parts joined as the conjuncts of a
% proviso are; G alone where one role guards, as the worked box writes it,
% and \emptyset where none does.  The threshold of a party role is 0
% (definition:schema).

procedure latex_theta(Guard?, Chunks?, Chunks).
latex_theta(guarded, T, [0|T?]).
latex_theta(guarded_at(X), T, R?) :- ground(X?), ground(T?) | latex_greek(X?, T?, R).
latex_theta(unguarded, T, T?).

procedure g_name(Integer?, Constant?, Chunks).
g_name(N, _, ['G']) :- N? =:= 1 | true.
g_name(N, I, ['G_{', I?, '}']) :- N? > 1, ground(I?) | true.

procedure guard_part(Chunks?, RoleSpec?, Integer?, Chunks?, Chunks).
guard_part(G, RS, I, T, R?) :- ground(G?), ground(RS?), integer(I?), ground(T?) |
    rs_guard(RS?, Gd),
    latex_ext(RS?, I?, ['|'|T?], E2),
    latex_theta(Gd?, ['|'|E2?], Th),
    chunks_app(G?, ['| > '|Th?], G2),
    latex_ext(RS?, I?, [' \\text{ with } |'|G2?], E1),
    chunks_app(G?, [' \\subseteq '|E1?], R).

procedure guard_parts(Ints?, Integer?, RoleSpecs?, Chunks?, Chunks).
guard_parts([], _, _, T, T?).
guard_parts([I], N, Rs, T, R?) :- integer(I?), integer(N?), ground(Rs?), ground(T?) |
    nth_rs(Rs?, I?, RS),
    g_name(N?, I?, G),
    guard_part(G?, RS?, I?, T?, R).
guard_parts([I, J|Is], N, Rs, T, R?) :-
    integer(I?), integer(J?), ground(Is?), integer(N?), ground(Rs?), ground(T?) |
    guard_parts([J?|Is?], N?, Rs?, T?, R1),
    nth_rs(Rs?, I?, RS),
    g_name(N?, I?, G),
    guard_part(G?, RS?, I?, [' \\text{ and } '|R1?], R).

procedure guard_union(Ints?, Integer?, Chunks?, Chunks).
guard_union([], _, T, T?).
guard_union([I], N, T, R?) :- integer(I?), integer(N?), ground(T?) |
    g_name(N?, I?, G),
    chunks_app(G?, T?, R).
guard_union([I, J|Is], N, T, R?) :-
    integer(I?), integer(J?), ground(Is?), integer(N?), ground(T?) |
    guard_union([J?|Is?], N?, T?, R1),
    g_name(N?, I?, G),
    chunks_app(G?, ['\\cup '|R1?], R).

procedure guard_line(Ints?, RoleSpecs?, Chunks).
guard_line([], _, ['\\text{guarded by } \\emptyset']).
guard_line([I|Is], Rs, ['\\text{guarded by } '|R?]) :-
    integer(I?), ground(Is?), ground(Rs?) |
    ints_len([I?|Is?], N),
    guard_parts([I?|Is?], N?, Rs?, [], P),
    guard_union([I?|Is?], N?, [',\\ '|P?], R).

procedure join_lines(ChunkLists?, Chunks?, Chunks).
join_lines([], T, T?).
join_lines([L], T, ['&'|R?]) :- ground(L?), ground(T?) | chunks_app(L?, T?, R).
join_lines([L, M|Ls], T, ['&'|R?]) :- ground(L?), ground(M?), ground(Ls?), ground(T?) |
    join_lines([M?|Ls?], T?, R1),
    chunks_app(L?, [',\\\\'|R1?], R).

procedure latex_schema_app(Schema?, Chunks?, Chunks).
latex_schema_app(Sc, T, ['\\begin{align*}'|R?]) :- ground(Sc?), ground(T?) |
    sch_roles(Sc?, Rs),
    sch_reaches(Sc?, Th),
    sch_ext_terms(Sc?, Es0),
    latex_app_fresh(Rs?, Th?, Es0?, T?, R).

procedure latex_app_fresh(RoleSpecs?, Reaches?, NameTerms?, Chunks?, Chunks).
latex_app_fresh(Rs, Th, Es0, T, R?) :-
    ground(Rs?), ground(Th?), ground(Es0?), ground(T?) |
    req_ext_terms(Rs?, Qs),
    fresh_terms(Es0?, Qs?, Es),
    latex_app_roles(Rs?, Th?, Es?, T?, R).

procedure latex_app_roles(RoleSpecs?, Reaches?, NameTerms?, Chunks?, Chunks).
latex_app_roles(Rs, Th, Es, T, R?) :- ground(Rs?), ground(Th?), ground(Es?), ground(T?) |
    guard_roles(Rs?, 1, [], G),
    guard_line(G?, Rs?, GL),
    fresh_lines(Es?, [GL?], L5),
    reach_line(Th?, L5?, L4),
    change_lines(Rs?, 1, L4?, L3),
    forb_lines(Rs?, 1, L3?, L2),
    req_lines(Rs?, 1, L2?, L1),
    assign_lines(Rs?, 1, L1?, Ls),
    join_lines(Ls?, ['\\end{align*}'|T?], R).

% --- The display of one schema, in its form ------------------------------
% A schema of Section 3 -- its roles agent roles, no reach condition and no
% name term -- in the form of Section 5.1 and Appendix B.3, any other in
% Appendix D's.

procedure s3_form(Schema?, Ans).
s3_form(Sc, R?) :- ground(Sc?) |
    sch_roles(Sc?, Rs),
    roles_community(Rs?, A1),
    flip(A1?, A2),
    sch_nts(Sc?, Ns),
    nts_empty(Ns?, A3),
    both_yes(A2?, A3?, R).

procedure latex_schema1(Ans?, Schema?, Chunks?, Chunks).
latex_schema1(yes, Sc, T, R?) :- ground(Sc?), ground(T?) | latex_schema_s3(Sc?, T?, R).
latex_schema1(no, Sc, T, R?) :- ground(Sc?), ground(T?) | latex_schema_app(Sc?, T?, R).

procedure latex_schema(Ans?, Schema?, Chunks?, Chunks).
latex_schema(_, Sc, T, R?) :- ground(Sc?), ground(T?) |
    s3_form(Sc?, A),
    latex_schema1(A?, Sc?, T?, R).

% A schema's name is no part of its compiled form, so it is carried in a
% conditional TeX skips, and the whole output is pasted as it stands.
procedure latex_contract(Ans?, Contract?, Chunks?, Chunks).
latex_contract(_, [], T, T?).
latex_contract(K, [S|Ss], T, ['\\iffalse', Nm?, '\\fi'|R?]) :-
    ground(K?), ground(S?), ground(Ss?), ground(T?) |
    sch_name(S?, Nm),
    latex_contract(K?, Ss?, T?, R1),
    latex_schema(K?, S?, R1?, R).

% --- Entry points ----------------------------------------------------------
% The checker first: a contract that is malformed, that is not syntactically
% grassroots (def:syntactically-grassroots, or definition:sg-agent-named for
% an agent-named contract with community roles), or that fails the
% conditions on the text of Appendix D, is not compiled at all.  A contract grassroots with wards is compiled as a
% syntactically grassroots one: the compilation of Section 5 uses nothing of
% the introductory act, and its realisation is taken by def:realisation
% (Appendix F, after def:introduction-wards).  A contract's reflexive
% predicates are no part of its compiled form, which is its schemas'.

procedure find_schema1(Constant?, Constant?, Schema?, Contract?, FoundS).
find_schema1(Nm, Sn, S, _, found(S?)) :- Nm? =?= Sn? | true.
find_schema1(_, Sn, _, Ss, R?) :- otherwise, ground(Sn?), ground(Ss?) |
    find_schema(Ss?, Sn?, R).

procedure find_schema(Contract?, Constant?, FoundS).
find_schema([], _, not_found).
find_schema([S|Ss], Sn, R?) :- ground(S?), ground(Ss?), ground(Sn?) |
    sch_name(S?, Nm),
    find_schema1(Nm?, Sn?, S?, Ss?, R).

procedure emit_schema(FoundS?, Ans?, Constant?).
emit_schema(found(S), K, _) :- ground(S?), ground(K?) |
    latex_schema(K?, S?, [], L),
    send_to_user(L?).
emit_schema(not_found, _, Sn) :- ground(Sn?) |
    send_to_user(['% no schema named', Sn?, 'in this contract.']).

procedure not_compiled(Constant?).
not_compiled(Nm) :- ground(Nm?) |
    send_to_user(['% not compiled:', Nm?,
                  'is not syntactically grassroots; check_named gives the faults.']).

procedure not_compiled_app(Constant?).
not_compiled_app(Nm) :- ground(Nm?) |
    send_to_user(['% not compiled:', Nm?,
                  'fails the conditions on the text of Appendix D;',
                  'check_named gives the faults.']).

% A malformed contract is not compiled, and the message names each fault the
% checker found, schema and role, in the paper's words: the paragraph after
% def:binding for a reflexive predicate, def:schema for a signed term and for
% the form of a schema, and Appendix D's Definition Act schema for a signed
% term whose role is not an agent role.
procedure malformed_lines(Faults?, Chunks?, Chunks).
malformed_lines([], T, T?).
malformed_lines([reflexive(S, I, _)|Fs], T,
                [S?, 'at role', I?,
                 'adds or deletes the atom of a reflexive predicate naming that role;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([signed(S, I, _, not_added)|Fs], T,
                [S?, 'at role', I?,
                 'carries a signed term in an atom not marked +;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([signed(S, I, _, not_required)|Fs], T,
                [S?, 'at role', I?,
                 'carries a signed term whose speech-act variable occurs in no atom its role requires;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([signed(S, I, _, not_agent_role)|Fs], T,
                [S?, 'at role', I?,
                 'carries a signed term whose role is not an agent role;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([added_and_deleted(S, I, _)|Fs], T,
                [S?, 'at role', I?,
                 'adds and deletes the same atom;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([changes_nothing(S, I)|Fs], T,
                [S?, 'at role', I?,
                 'is not a guarding role and adds and deletes nothing;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([no_role_changes(S)|Fs], T,
                [S?, 'adds and deletes nothing at any role;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([head_not_variable(S, _)|Fs], T,
                [S?, 'lists in its head an entry that is not a variable;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([head_repeated(S, _)|Fs], T,
                [S?, 'lists a variable twice in its head;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([not_in_head(S, _)|Fs], T,
                [S?, 'has a variable its head does not list;'|R?]) :-
    ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).
malformed_lines([_|Fs], T, R?) :- otherwise, ground(Fs?), ground(T?) |
    malformed_lines(Fs?, T?, R).

procedure not_compiled_malformed(Constant?, Faults?).
not_compiled_malformed(Nm, Fs) :- ground(Nm?), ground(Fs?) |
    malformed_lines(Fs?, ['check_named gives the faults.'], L),
    send_to_user(['% not compiled:', Nm?, 'is malformed:'|L?]).

procedure compile_on(Verdict?, Constant?, Contract?).
compile_on(syntactically_grassroots, _, C) :- ground(C?) |
    latex_contract(no, C?, [], L),
    send_to_user(L?).
compile_on(grassroots_with_wards(_, _, _, _, _), _, C) :- ground(C?) |
    latex_contract(no, C?, [], L),
    send_to_user(L?).
compile_on(syntactically_grassroots_with_wards(_, _, _, _, _), _, C) :- ground(C?) |
    latex_contract(yes, C?, [], L),
    send_to_user(L?).
compile_on(syntactically_grassroots_with_seated_roles, _, C) :- ground(C?) |
    latex_contract(yes, C?, [], L),
    send_to_user(L?).
compile_on(not_grassroots(_), Nm, _) :- ground(Nm?) | not_compiled(Nm?).
compile_on(conditions_met, _, C) :- ground(C?) |
    latex_contract(yes, C?, [], L),
    send_to_user(L?).
compile_on(conditions_failed(_), Nm, _) :- ground(Nm?) | not_compiled_app(Nm?).
compile_on(malformed(Fs), Nm, _) :- ground(Nm?), ground(Fs?) | not_compiled_malformed(Nm?, Fs?).

procedure compile_checked(Constant?, Declared?).
compile_checked(Nm, D) :- ground(Nm?), ground(D?) |
    check # check(D?, V),
    decl_schemas(D?, C),
    compile_on(V?, Nm?, C?).

exported procedure compile_named(Constant?).
compile_named(Nm) :- ground(Nm?) |
    contracts # contract(Nm?, C),
    compile_checked(Nm?, C?).

% A contract given as a term, under the name its displays are reported by.
exported procedure compile_contract(Constant?, Declared?).
compile_contract(Nm, D) :- ground(Nm?), ground(D?) |
    compile_checked(Nm?, D?).

% A fixture that changes a contract in one place, by name and the contract it
% changes (contracts.glp, variant/3).
exported procedure compile_variant(Constant?, Contract?).
compile_variant(Nm, B) :- ground(Nm?), ground(B?) |
    contracts # variant(Nm?, B?, D),
    compile_checked(Nm?, D?).

procedure compile_s_on(Verdict?, Constant?, Constant?, Contract?).
compile_s_on(syntactically_grassroots, _, Sn, C) :- ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, no, Sn?).
compile_s_on(grassroots_with_wards(_, _, _, _, _), _, Sn, C) :- ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, no, Sn?).
compile_s_on(syntactically_grassroots_with_wards(_, _, _, _, _), _, Sn, C) :-
    ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, yes, Sn?).
compile_s_on(syntactically_grassroots_with_seated_roles, _, Sn, C) :-
    ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, yes, Sn?).
compile_s_on(not_grassroots(_), Nm, _, _) :- ground(Nm?) | not_compiled(Nm?).
compile_s_on(conditions_met, _, Sn, C) :- ground(Sn?), ground(C?) |
    find_schema(C?, Sn?, S),
    emit_schema(S?, yes, Sn?).
compile_s_on(conditions_failed(_), Nm, _, _) :- ground(Nm?) | not_compiled_app(Nm?).
compile_s_on(malformed(Fs), Nm, _, _) :- ground(Nm?), ground(Fs?) | not_compiled_malformed(Nm?, Fs?).

procedure compile_s_checked(Constant?, Constant?, Declared?).
compile_s_checked(Nm, Sn, D) :- ground(Nm?), ground(Sn?), ground(D?) |
    check # check(D?, V),
    decl_schemas(D?, C),
    compile_s_on(V?, Nm?, Sn?, C?).

exported procedure compile_schema(Constant?, Constant?).
compile_schema(Nm, Sn) :- ground(Nm?), ground(Sn?) |
    contracts # contract(Nm?, C),
    compile_s_checked(Nm?, Sn?, C?).

exported procedure compile_schema_in(Constant?, Declared?, Constant?).
compile_schema_in(Nm, D, Sn) :- ground(Nm?), ground(D?), ground(Sn?) |
    compile_s_checked(Nm?, Sn?, D?).

exported procedure compile_schema_variant(Constant?, Contract?, Constant?).
compile_schema_variant(Nm, B, Sn) :- ground(Nm?), ground(B?), ground(Sn?) |
    contracts # variant(Nm?, B?, D),
    compile_s_checked(Nm?, Sn?, D?).
