% ---------------------------------------------------------------------------
% The notation of a contract's speech-act schemas, printed from its term: each schema
% as Definition Speech-act schema of /Grassroots/GSC writes it, def:schema of Section
% 3.2, tau(pi_1, ..., pi_k; x_1, ..., x_m) followed by its marked multisets
% E_1 ... E_k, a guarding role carrying ?; the listed role
% pi[rho(*, u_2, ..., u_r)] and the name terms <u> and sigma.y as def:role
% writes them; the signed term
% sgn(y, pi) as GAI's Definition Speech-act schema writes it, and the predicates a
% contract declares reflexive under the heading of GAI's paragraph "Reflexive
% predicates" (GAI's appendix "Contracts with Wards").  The paper is the
% specification and no definition of it is restated in this file.
%
% The text is plain, as programs/gsc/README.md writes befriend of Section 3.2:
% the mark not for the paper's negation sign, <u> for its angle brackets, a
% full stop for its centred dot and * for its asterisk.  Each E_i is on a line
% of its own, labelled by its role, as Section 3.3's table labels its columns
% "at Alice" and "at Bob"; within it the unmarked atoms come first, then those
% marked not, +, and -, the order of the paper's displays.  Roles one to four
% are named as compile.glp names them, Alice, Bob, Carol and Dave, and a role
% beyond the fourth p_i; a variable is written as it is named.  A schema whose
% head names its roles, schema(Name, Names, Vars, Roles) (programs/gsc
% self.glp, WSchema; GSC 25b6b3c, Section 2: "the schemas naming their roles
% as the clauses do"), is printed with each role by its name, the I-th of
% Names: the schema is printed as above and each of the four role names in
% it, which n_role alone writes, is replaced by the name its index takes in
% Names (n_rename).
%
% GLP has no string concatenation, so the text is printed as its tokens, one
% to a line, between the lines %% notation begin and %% notation end; the
% empty token ends a line of the text, and the tokens between two empty ones
% are that line.  cascade.sh joins them into schemas.txt.
%
% Speech-act schemas allow numbers (GSC, Section 3.2, the paragraph after the
% example of def:schema), and they are printed as def:numbers writes a
% schema with numbers, as GB's paper does (GB, Appendix A): a numeric
% argument as its variable or its number, the value variables in the head
% with the other variables, in the order of the head; a constraint after the
% head, tau(...) | constraint :, gt(X, Y) as X > Y, le(X, Y) as X <= Y,
% succ(X, Y) as Y = X + 1 and or(C1, C2) as C1 or C2; and a multiplicity k on
% an atom A as k.A, a full stop for the centred dot of def:numbers, as for
% the centred dot of a name term.
% ---------------------------------------------------------------------------

% --- Arguments (def:schema, def:role) --------------------------------------

procedure n_role(Integer?, Chunks?, Chunks).
n_role(I, T, ['Alice'|T?]) :- I? =:= 1 | true.
n_role(I, T, ['Bob'|T?]) :- I? =:= 2 | true.
n_role(I, T, ['Carol'|T?]) :- I? =:= 3 | true.
n_role(I, T, ['Dave'|T?]) :- I? =:= 4 | true.
n_role(I, T, R?) :- otherwise, integer(I?), ground(T?) | n_role_n(I?, T?, R).

% A role beyond the fourth has no name in the paper and is written p_i.
procedure n_role_n(Constant?, Chunks?, Chunks).
n_role_n(I, T, ['p_', I?|T?]).

% A name term (def:role): <u> for an agent role, or sigma.y; <x> for an
% agent variable, which def:role does not admit, is printed as written.
procedure n_nt(NameTerm?, Chunks?, Chunks).
n_nt(own(I), T, ['<'|R?]) :- integer(I?), ground(T?) |
    n_role(I?, ['>'|T?], R).
n_nt(own_var(X), T, ['<', X?, '>'|T?]).
n_nt(ext(S, Y), T, R?) :- ground(S?), ground(Y?), ground(T?) |
    n_nt(S?, ['.', Y?|T?], R).

procedure n_arg(Arg?, Chunks?, Chunks).
n_arg(role(I), T, R?) :- integer(I?), ground(T?) | n_role(I?, T?, R).
n_arg(pvar(X), T, [X?|T?]).
n_arg(svar(X), T, [X?|T?]).
n_arg(nterm(S), T, R?) :- ground(S?), ground(T?) | n_nt(S?, T?, R).
n_arg(sgn(X, J), T, ['sgn(', X?, ', '|R?]) :-
    ground(X?), integer(J?), ground(T?) |
    n_role(J?, [')'|T?], R).
n_arg(num(X), T, [X?|T?]).

procedure n_args(Args?, Chunks?, Chunks).
n_args([], T, T?).
n_args([A], T, R?) :- ground(A?), ground(T?) | n_arg(A?, T?, R).
n_args([A, B|As], T, R?) :- ground(A?), ground(B?), ground(As?), ground(T?) |
    n_args([B?|As?], T?, R1),
    n_arg(A?, [', '|R1?], R).

% --- Atoms and marked atoms (def:schema) -----------------------------------
% A predicate of arity zero carries no parentheses.

procedure n_atom(Atom?, Chunks?, Chunks).
n_atom(atom(P, []), T, [P?|T?]).
n_atom(atom(P, [A|As]), T, [P?, '('|R?]) :-
    ground(A?), ground(As?), ground(T?) |
    n_args([A?|As?], [')'|T?], R).

% An atom with a multiplicity k, k.A (GB, Appendix A, k\cdot A).
procedure n_mult(Mult?, Chunks?, Chunks).
n_mult(atom(P, As), T, R?) :- ground(P?), ground(As?), ground(T?) |
    n_atom(atom(P?, As?), T?, R).
n_mult(times(K, A), T, R?) :- ground(K?), ground(A?), ground(T?) |
    n_atom(A?, T?, R1),
    n_arg(K?, ['.'|R1?], R).

% The atoms of E_i, each with its mark: m(Mark, Atom), Mark keep for an
% unmarked atom and forb, add and del for the marks not, + and -.
Mark   ::= keep ; forb ; add ; del.
MAtom  ::= m(Mark, Mult).
MAtoms ::= [] ; [MAtom | MAtoms].

procedure n_marks(Mults?, Mark?, MAtoms?, MAtoms).
n_marks([], _, T, T?).
n_marks([A|As], M, T, [m(M?, A?)|R?]) :- ground(M?), ground(As?), ground(T?) |
    n_marks(As?, M?, T?, R).

procedure n_mark_token(Mark?, Chunks?, Chunks).
n_mark_token(keep, T, T?).
n_mark_token(forb, T, ['not '|T?]).
n_mark_token(add, T, ['+'|T?]).
n_mark_token(del, T, ['-'|T?]).

procedure n_matom(MAtom?, Chunks?, Chunks).
n_matom(m(M, A), T, R?) :- ground(M?), ground(A?), ground(T?) |
    n_mult(A?, T?, R1),
    n_mark_token(M?, R1?, R).

% The marked atoms of E_i after a space, apart by a comma; nothing when E_i is
% empty.
procedure n_matoms(MAtoms?, Chunks?, Chunks).
n_matoms([], T, T?).
n_matoms([X|Xs], T, [' '|R?]) :- ground(X?), ground(Xs?), ground(T?) |
    n_matoms1([X?|Xs?], T?, R).

procedure n_matoms1(MAtoms?, Chunks?, Chunks).
n_matoms1([], T, T?).
n_matoms1([X], T, R?) :- ground(X?), ground(T?) | n_matom(X?, T?, R).
n_matoms1([X, Y|Ys], T, R?) :- ground(X?), ground(Y?), ground(Ys?), ground(T?) |
    n_matoms1([Y?|Ys?], T?, R1),
    n_matom(X?, [', '|R1?], R).

% E_i of the role RS: the unmarked atoms =(i), then not(i), +(i) and -(i).
procedure n_e(NRoleSpec?, Chunks?, Chunks).
n_e(RS, T, R?) :- ground(RS?), ground(T?) |
    nrs_keep(RS?, K),
    nrs_forb(RS?, F),
    nrs_add(RS?, P),
    nrs_del(RS?, M),
    n_marks(M?, del, [], L3),
    n_marks(P?, add, L3?, L2),
    n_marks(F?, forb, L2?, L1),
    n_marks(K?, keep, L1?, L),
    n_matoms(L?, T?, R).

% --- Roles (def:schema, def:role) ------------------------------------------
% An agent role by its name, and a listed role pi[rho(*, u_2, ..., u_r)] as
% Section 3.2 writes close's, Alice[listed(*, n)]; a guarding role carries ?.

procedure n_listed_args(Args?, Chunks?, Chunks).
n_listed_args([], T, T?).
n_listed_args([A|As], T, [', '|R?]) :- ground(A?), ground(As?), ground(T?) |
    n_args([A?|As?], T?, R).

procedure n_role_term(NRoleSpec?, Integer?, Chunks?, Chunks).
n_role_term(rs(_, _, _, _, _), I, T, R?) :- integer(I?), ground(T?) |
    n_role(I?, T?, R).
n_role_term(crs(listed(I, Rho, As), _, _, _, _, _), _, T, R?) :-
    integer(I?), ground(Rho?), ground(As?), ground(T?) |
    n_listed_args(As?, [')]'|T?], R1),
    n_role(I?, ['[', Rho?, '(*'|R1?], R).

procedure n_mark(Ans?, Chunks?, Chunks).
n_mark(yes, T, ['?'|T?]).
n_mark(no, T, T?).

procedure n_head_role(NRoleSpec?, Integer?, Chunks?, Chunks).
n_head_role(RS, I, T, R?) :- ground(RS?), integer(I?), ground(T?) |
    n_is_guarding(RS?, G),
    n_mark(G?, T?, T1),
    n_is_received(RS?, Rc),
    n_role_term(RS?, I?, T1?, R0),
    n_received(Rc?, R0?, R).

% A role carrying the mark received is printed "received" before its name
% (the experiment GFF-chooser; CHOOSER.md, "For GSC").
procedure n_received(Ans?, Chunks?, Chunks).
n_received(yes, T, ['received '|T?]).
n_received(no, T, T?).

procedure n_head_roles(NRoleSpecs?, Integer?, Chunks?, Chunks).
n_head_roles([], _, T, T?).
n_head_roles([RS], I, T, R?) :- ground(RS?), integer(I?), ground(T?) |
    n_head_role(RS?, I?, T?, R).
n_head_roles([RS, RS2|Rs], I, T, R?) :-
    ground(RS?), ground(RS2?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    n_head_roles([RS2?|Rs?], I1?, T?, R1),
    n_head_role(RS?, I?, [', '|R1?], R).

% The variables of the head, after a semicolon; none when it has none.
procedure n_head_vars(Args?, Chunks?, Chunks).
n_head_vars([], T, T?).
n_head_vars([V|Vs], T, ['; '|R?]) :- ground(V?), ground(Vs?), ground(T?) |
    n_args([V?|Vs?], T?, R).

% --- The constraint (GSC, def:numbers) -------------------------------------
% After the head and a bar, as GB's paper writes it; none for true.  and as
% a comma, eq, le, lt, ge and gt as =, <=, <, >= and >, succ(X, Y) as Y = X
% + 1; plus, minus and a product as +, - and *, an operand that is a sum or
% a difference in parentheses where it follows a minus or is a factor.

procedure n_constraint(Constraint?, Chunks?, Chunks).
n_constraint(true, T, ['true'|T?]).
n_constraint(and(C1, C2), T, R?) :- ground(C1?), ground(C2?), ground(T?) |
    n_constraint(C2?, T?, R1),
    n_constraint(C1?, [', '|R1?], R).
n_constraint(eq(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) | n_cmp(X?, ' = ', Y?, T?, R).
n_constraint(le(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) | n_cmp(X?, ' <= ', Y?, T?, R).
n_constraint(lt(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) | n_cmp(X?, ' < ', Y?, T?, R).
n_constraint(ge(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) | n_cmp(X?, ' >= ', Y?, T?, R).
n_constraint(gt(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) | n_cmp(X?, ' > ', Y?, T?, R).
n_constraint(succ(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    n_arg(X?, [' + 1'|T?], R1),
    n_arg(Y?, [' = '|R1?], R).
n_constraint(or(C1, C2), T, R?) :- ground(C1?), ground(C2?), ground(T?) |
    n_constraint(C2?, T?, R1),
    n_constraint(C1?, [' or '|R1?], R).
% signed(X, Y) as "X signed Y", unsigned(X, Y) as "X did not sign Y" (CHOOSER.md, "For GSC").
n_constraint(signed(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    n_arg(Y?, T?, R1),
    n_arg(X?, [' signed '|R1?], R).
n_constraint(unsigned(X, Y), T, R?) :- ground(X?), ground(Y?), ground(T?) |
    n_arg(Y?, T?, R1),
    n_arg(X?, [' did not sign '|R1?], R).

procedure n_cmp(Expr?, Constant?, Expr?, Chunks?, Chunks).
n_cmp(X, Op, Y, T, R?) :- ground(X?), ground(Op?), ground(Y?), ground(T?) |
    n_expr(Y?, T?, R1),
    n_expr(X?, [Op?|R1?], R).

procedure n_expr(Expr?, Chunks?, Chunks).
n_expr(plus(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    n_expr(B?, T?, R1),
    n_expr(A?, [' + '|R1?], R).
n_expr(minus(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    n_operand(B?, T?, R1),
    n_expr(A?, [' - '|R1?], R).
n_expr(mul(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    n_operand(B?, T?, R1),
    n_operand(A?, ['*'|R1?], R).
n_expr(num(X), T, R?) :- n_arg(num(X?), T?, R).
n_expr(role(I), T, R?) :- n_arg(role(I?), T?, R).
n_expr(pvar(X), T, R?) :- n_arg(pvar(X?), T?, R).
n_expr(svar(X), T, R?) :- n_arg(svar(X?), T?, R).
n_expr(nterm(N), T, R?) :- n_arg(nterm(N?), T?, R).
n_expr(sgn(Y, J), T, R?) :- n_arg(sgn(Y?, J?), T?, R).

procedure n_operand(Expr?, Chunks?, Chunks).
n_operand(plus(A, B), T, ['('|R?]) :- ground(A?), ground(B?), ground(T?) |
    n_expr(plus(A?, B?), [')'|T?], R).
n_operand(minus(A, B), T, ['('|R?]) :- ground(A?), ground(B?), ground(T?) |
    n_expr(minus(A?, B?), [')'|T?], R).
n_operand(mul(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    n_expr(mul(A?, B?), T?, R).
n_operand(num(X), T, R?) :- n_arg(num(X?), T?, R).
n_operand(role(I), T, R?) :- n_arg(role(I?), T?, R).
n_operand(pvar(X), T, R?) :- n_arg(pvar(X?), T?, R).
n_operand(svar(X), T, R?) :- n_arg(svar(X?), T?, R).
n_operand(nterm(N), T, R?) :- n_arg(nterm(N?), T?, R).
n_operand(sgn(Y, J), T, R?) :- n_arg(sgn(Y?, J?), T?, R).

procedure n_head_constraint(Constraint?, Chunks?, Chunks).
n_head_constraint(true, T, T?).
n_head_constraint(C, T, [' | '|R?]) :- otherwise, ground(C?), ground(T?) |
    n_constraint(C?, T?, R).

% --- A schema (def:schema, def:numbers) ------------------------------------
% The head, tau(pi_1, ..., pi_k; x_1, ..., x_m) :, on a line, its constraint
% after a bar before the colon, then a line per role, at pi_i: E_i.

procedure n_role_lines(NRoleSpecs?, Integer?, Chunks?, Chunks).
n_role_lines([], _, T, T?).
n_role_lines([RS|Rs], I, T, ['    at '|R?]) :-
    ground(RS?), ground(Rs?), integer(I?), ground(T?) |
    I1 := I? + 1,
    n_role_lines(Rs?, I1?, T?, R2),
    n_e(RS?, [''|R2?], R1),
    n_role_term(RS?, I?, [':'|R1?], R).

procedure n_schema(NSchema?, Chunks?, Chunks).
n_schema(Sc, T, R?) :- ground(Sc?), ground(T?) |
    nsch_name(Sc?, Nm),
    nsch_vars(Sc?, Vs),
    nsch_roles(Sc?, Rs),
    nsch_constraint(Sc?, Cn),
    n_schema0(Nm?, Vs?, Rs?, Cn?, T?, R).

% A schema one of whose roles carries the mark every_so_often is printed with
% "every so often" before its head (the experiment GFF-chooser; CHOOSER.md,
% "For GSC").
procedure n_schema0(Constant?, Args?, NRoleSpecs?, Constraint?, Chunks?, Chunks).
n_schema0(Nm, Vs, Rs, Cn, T, R?) :- ground(Nm?), ground(Rs?) |
    n_schema1(Vs?, Rs?, Cn?, T?, R1),
    n_any_often(Rs?, O),
    n_often(O?, [Nm?, '('|R1?], R).

procedure n_any_often(NRoleSpecs?, Ans).
n_any_often([], no).
n_any_often([RS|Rs], R?) :- ground(RS?) |
    n_is_often(RS?, O),
    n_any_often1(O?, Rs?, R).

procedure n_any_often1(Ans?, NRoleSpecs?, Ans).
n_any_often1(yes, _, yes).
n_any_often1(no, Rs, R?) :- n_any_often(Rs?, R).

procedure n_often(Ans?, Chunks?, Chunks).
n_often(yes, T, ['every so often '|T?]).
n_often(no, T, T?).

procedure n_schema1(Args?, NRoleSpecs?, Constraint?, Chunks?, Chunks).
n_schema1(Vs, Rs, Cn, T, R?) :- ground(Vs?), ground(Rs?), ground(Cn?), ground(T?) |
    n_role_lines(Rs?, 1, T?, R3),
    n_head_constraint(Cn?, [' :', ''|R3?], R2),
    n_head_vars(Vs?, [')'|R2?], R1),
    n_head_roles(Rs?, 1, R1?, R).

% The schemas apart by an empty line (n_wschemas).

% --- A contract -------------------------------------------------------------
% A contract declaring predicates reflexive opens with them, then an empty
% line.

procedure n_preds(Preds?, RChunks?, RChunks).
n_preds([], T, T?).
n_preds([P], T, [P?|T?]).
n_preds([P, Q|Ps], T, [P?, ', '|R?]) :- ground(Q?), ground(Ps?), ground(T?) |
    n_preds([Q?|Ps?], T?, R).

% A schema as its owner writes it, its roles by their names.
procedure n_wschema(WSchema?, RChunks?, RChunks).
n_wschema(W, T, R?) :- ground(W?), ground(T?) |
    unnamed_s(W?, S),
    wsch_names(W?, Ns),
    n_schema(S?, [], R0),
    n_rename(R0?, Ns?, R1),
    capp(R1?, T?, R).
procedure capp(RChunks?, RChunks?, RChunks).
capp([], T, T?).
capp([C|Cs], T, [C?|R?]) :- capp(Cs?, T?, R).
procedure n_rename(Chunks?, Names?, RChunks).
n_rename([], _, []).
n_rename([C|Cs], Ns, [D?|Ds?]) :- ground(C?), ground(Ns?) |
    n_pos(C?, I),
    n_name(I?, Ns?, C?, D),
    n_rename(Cs?, Ns?, Ds).
procedure n_pos(Constant?, Integer).
n_pos('Alice', 1).
n_pos('Bob', 2).
n_pos('Carol', 3).
n_pos('Dave', 4).
n_pos(C, 0) :- otherwise, ground(C?) | true.
procedure n_name(Integer?, Names?, Constant?, RName).
n_name(0, _, C, C?).
n_name(I, Ns, C, D?) :- I? > 0, ground(Ns?) | nth_name(I?, Ns?, C?, D).
procedure nth_name(Integer?, Names?, Constant?, RName).
nth_name(_, [], C, C?).
nth_name(1, [N|_], _, N?).
nth_name(I, [_|Ns], C, D?) :- I? > 1 | I1 := I? - 1, nth_name(I1?, Ns?, C?, D).

procedure n_wschemas(WContract?, RChunks?, RChunks).
n_wschemas([], T, T?).
n_wschemas([S], T, R?) :- ground(S?), ground(T?) | n_wschema(S?, T?, R).
n_wschemas([S, S2|Ss], T, R?) :- ground(S?), ground(S2?), ground(Ss?), ground(T?) |
    n_wschemas([S2?|Ss?], T?, R1),
    n_wschema(S?, [''|R1?], R).

% A contract naming environment predicates opens with them, as with reflexive ones, then an empty line.
procedure n_body(WBody?, RChunks?, RChunks).
n_body([], T, T?).
n_body([S|Ss], T, R?) :- ground(S?), ground(Ss?), ground(T?) |
    n_wschemas([S?|Ss?], T?, R).
n_body(reflexive(Ps, Ss), T, ['Reflexive predicates: '|R?]) :-
    ground(Ps?), ground(Ss?), ground(T?) |
    n_wschemas(Ss?, T?, R2),
    n_preds(Ps?, ['', ''|R2?], R).
procedure n_declared(WDeclared?, RChunks?, RChunks).
n_declared([], T, T?).
n_declared([S|Ss], T, R?) :- ground(S?), ground(Ss?), ground(T?) |
    n_wschemas([S?|Ss?], T?, R).
n_declared(reflexive(Ps, Ss), T, ['Reflexive predicates: '|R?]) :-
    ground(Ps?), ground(Ss?), ground(T?) |
    n_wschemas(Ss?, T?, R2),
    n_preds(Ps?, ['', ''|R2?], R).
n_declared(environment(Ps, B), T, ['Environment predicates: '|R?]) :-
    ground(Ps?), ground(B?), ground(T?) |
    n_body(B?, T?, R2),
    n_preds(Ps?, ['', ''|R2?], R).

exported procedure notation_contract(WDeclared?).
notation_contract(D) :- ground(D?) |
    n_declared(D?, ['%% notation end'], L),
    send_to_user(['%% notation begin'|L?]).
