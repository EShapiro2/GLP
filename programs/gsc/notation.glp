% ---------------------------------------------------------------------------
% The notation of a contract's speech-act schemas, printed from its term: each
% schema as Definition Speech-act schema of /Grassroots/GSC (GSC 859a007,
% Section 3.2) writes it, the clause
%
%     tau: H <- B, gamma guarded by G
%
% of Definition Schema with values, its head H and its body B literals and
% quantified conjuncts, as Section 3.2 writes befriend and close.  Each atom
% carries its holder first ("a schema writes the holder first", Section 3.1),
% the holder of an agent role's atoms the role and of a listed role's the
% listed role, its quantified conjunct forall X (rho(pi, X, u_2, ..., u_r) ->
% L_1, ..., L_m) on its condition at its base (def:role).  The head holds,
% role by role, the atoms each role adds and then those it deletes, negated,
% a cleared atom among them; the body the atoms each role requires --- those
% it keeps and those it deletes, -(i) being a subset of =(i) --- and then
% those it forbids, negated, and after them the constraint gamma, which a
% schema with none omits; the guard lists the guarding roles, and a schema
% with none omits it, as the proof of Proposition Turing completeness writes
% the schemas of a two-counter machine.  A schema read in either term form,
% the clause syntax sas/7 or the checker's form (programs/gsc self.glp,
% WSchema), is printed from what it reads to, so one schema written in the
% two forms prints one clause.  The paper is the specification and no
% definition of it is restated in this file.
%
% The text is plain: not for the paper's negation sign, <- for its arrow,
% forall for its quantifier and -> for the arrow under it, <u> for its angle
% brackets, a full stop for its centred dot, _ for its wildcard, k.A for a
% multiplicity, as def:numbers writes kappa.phi.  A role is printed by the
% name its schema gives it (self.glp, wsch_rnames), and a role its schema
% names not by the name compile.glp gives it, Alice, Bob, Carol and Dave for
% roles one to four and p_i beyond; a variable is written as it is named.
% The predicates a contract declares reflexive, under the heading of GAI's
% paragraph "Reflexive predicates" (GAI's appendix "Contracts with Wards"),
% and its environment predicates open it.
%
% GLP has no string concatenation, so the text is printed as its tokens, one
% to a line, between the lines %% notation begin and %% notation end; the
% empty token ends a line of the text, and the tokens between two empty ones
% are that line.  cascade.sh joins them into schemas.txt.
% ---------------------------------------------------------------------------

% --- Names (def:role) -------------------------------------------------------

procedure c_default(Integer?, RChunks?, RChunks).
c_default(I, T, ['Alice'|T?]) :- I? =:= 1 | true.
c_default(I, T, ['Bob'|T?]) :- I? =:= 2 | true.
c_default(I, T, ['Carol'|T?]) :- I? =:= 3 | true.
c_default(I, T, ['Dave'|T?]) :- I? =:= 4 | true.
c_default(I, T, ['p_', I?|T?]) :- otherwise | true.

% The name of role I.
procedure c_name(Integer?, NameOfs?, RChunks?, RChunks).
c_name(I, [], T, R?) :- c_default(I?, T?, R).
c_name(I, [nm(N)|_], T, [N?|T?]) :- I? =:= 1 | true.
c_name(I, [dflt|_], T, R?) :- I? =:= 1 | c_default(I?, T?, R).
c_name(I, [_|Ns], T, R?) :- otherwise, integer(I?) |
    I1 := I? - 1,
    c_name_at(I?, I1?, Ns?, T?, R).

% Role I sought at position I1 of the rest; beyond the names, its default.
procedure c_name_at(Integer?, Integer?, NameOfs?, RChunks?, RChunks).
c_name_at(I, _, [], T, R?) :- c_default(I?, T?, R).
c_name_at(I, J, [nm(N)|_], T, [N?|T?]) :- J? =:= 1, integer(I?) | true.
c_name_at(I, J, [dflt|_], T, R?) :- J? =:= 1 | c_default(I?, T?, R).
c_name_at(I, J, [_|Ns], T, R?) :- otherwise, integer(J?) |
    J1 := J? - 1,
    c_name_at(I?, J1?, Ns?, T?, R).

% --- Arguments (def:role, def:schema, def:numbers) --------------------------

procedure c_nt(NameTerm?, NameOfs?, RChunks?, RChunks).
c_nt(own(I), Ns, T, ['<'|R?]) :- c_name(I?, Ns?, ['>'|T?], R).
c_nt(own_var(X), _, T, ['<', X?, '>'|T?]).
c_nt(ext(S, Y), Ns, T, R?) :- c_nt(S?, Ns?, ['.', Y?|T?], R).
c_nt(ext_any(S), Ns, T, R?) :- c_nt(S?, Ns?, ['.', '_'|T?], R).

procedure c_arg(Arg?, NameOfs?, RChunks?, RChunks).
c_arg(role(I), Ns, T, R?) :- c_name(I?, Ns?, T?, R).
c_arg(pvar(X), _, T, [X?|T?]).
c_arg(svar(X), _, T, [X?|T?]).
c_arg(nterm(S), Ns, T, R?) :- c_nt(S?, Ns?, T?, R).
c_arg(sgn(X, J), Ns, T, ['sgn(', X?, ', '|R?]) :- c_name(J?, Ns?, [')'|T?], R).
c_arg(num(X), _, T, [X?|T?]).
c_arg(any, _, T, ['_'|T?]).

% The arguments, each after a comma.
procedure c_rest(Args?, NameOfs?, RChunks?, RChunks).
c_rest([], _, T, T?).
c_rest([A|As], Ns, T, [', '|R?]) :- ground(Ns?) |
    c_rest(As?, Ns?, T?, R1),
    c_arg(A?, Ns?, R1?, R).

% --- Literals (def:schema) --------------------------------------------------
% An atom of role I, its holder first.

procedure c_hatom(Integer?, Atom?, NameOfs?, RChunks?, RChunks).
c_hatom(I, atom(P, As), Ns, T, [P?, '('|R?]) :- ground(Ns?) |
    c_rest(As?, Ns?, [')'|T?], R1),
    c_name(I?, Ns?, R1?, R).

procedure c_hmult(Integer?, Mult?, NameOfs?, RChunks?, RChunks).
c_hmult(I, atom(P, As), Ns, T, R?) :- c_hatom(I?, atom(P?, As?), Ns?, T?, R).
c_hmult(I, times(K, A), Ns, T, R?) :- ground(Ns?) |
    c_hatom(I?, A?, Ns?, T?, R1),
    c_arg(K?, Ns?, ['.'|R1?], R).
% rest(K, J, A), the copies of K.A beyond the J deleted (self.glp, Mult),
% is (K - J).A; a role's required atoms carry it as K.A (nrs_req).
c_hmult(I, rest(K, J, A), Ns, T, ['('|R?]) :- ground(Ns?) |
    c_hatom(I?, A?, Ns?, T?, R1),
    c_arg(J?, Ns?, [').'|R1?], R2),
    c_arg(K?, Ns?, [' - '|R2?], R).

% pl(I, A) the atom A of role I, ng(I, A) it negated, qa(I, Kind, Lits) the
% quantified conjunct of the listed role I, cn(Gamma) the constraint.
LItem  ::= pl(Integer, Mult) ; ng(Integer, Mult) ; qa(Integer, RoleKind, LItems)
         ; cn(Constraint).
LItems ::= [] ; [LItem | LItems].

procedure c_item(LItem?, NameOfs?, RChunks?, RChunks).
c_item(pl(I, A), Ns, T, R?) :- c_hmult(I?, A?, Ns?, T?, R).
c_item(ng(I, A), Ns, T, ['not '|R?]) :- c_hmult(I?, A?, Ns?, T?, R).
c_item(qa(I, listed(J, Rho, Us), Ls), Ns, T, ['forall '|R?]) :- integer(I?), ground(Ns?) |
    c_items(Ls?, Ns?, [')'|T?], R4),
    c_rest(Us?, Ns?, [') -> '|R4?], R3),
    c_name(I?, Ns?, R3?, R2),
    c_name(J?, Ns?, [', '|R2?], R1),
    c_name(I?, Ns?, [' (', Rho?, '('|R1?], R).
c_item(cn(C), Ns, T, R?) :- c_constraint(C?, Ns?, T?, R).

% The items apart by a comma.
procedure c_items(LItems?, NameOfs?, RChunks?, RChunks).
c_items([], _, T, T?).
c_items([X], Ns, T, R?) :- c_item(X?, Ns?, T?, R).
c_items([X, Y|Ys], Ns, T, R?) :- ground(Ns?) |
    c_items([Y?|Ys?], Ns?, T?, R1),
    c_item(X?, Ns?, [', '|R1?], R).

procedure c_marks(Mults?, Integer?, Ans?, LItems?, LItems).
c_marks([], _, _, T, T?).
c_marks([A|As], I, yes, T, [ng(I?, A?)|R?]) :- integer(I?) | c_marks(As?, I?, yes, T?, R).
c_marks([A|As], I, no, T, [pl(I?, A?)|R?]) :- integer(I?) | c_marks(As?, I?, no, T?, R).

% The literals of role I in the head, +(i) then -(i) and _(i) negated, and
% in the body, =(i) then -(i), then not(i) negated.
procedure c_hlits(NRoleSpec?, Integer?, LItems).
c_hlits(RS, I, L?) :- ground(RS?), integer(I?) |
    nrs_add(RS?, P),
    nrs_marked_del(RS?, M),
    c_marks(M?, I?, yes, [], L1),
    c_marks(P?, I?, no, L1?, L).

procedure c_blits(NRoleSpec?, Integer?, LItems).
c_blits(RS, I, L?) :- ground(RS?), integer(I?) |
    nrs_req(RS?, Q),
    nrs_forb(RS?, F),
    c_marks(F?, I?, yes, [], L2),
    c_marks(Q?, I?, no, L2?, L).

% A role's literals: an agent role's in the clause, a listed role's in its
% quantified conjunct, which a role with none there omits.
procedure c_role(NRoleSpec?, Integer?, LItems?, LItems?, LItems).
c_role(rs(_, _, _, _, _), _, L, T, R?) :- litems_app(L?, T?, R).
c_role(crs(_, _, _, _, _, _), _, [], T, T?).
c_role(crs(K, _, _, _, _, _), I, [L|Ls], T, [qa(I?, K?, [L?|Ls?])|T?]).

procedure litems_app(LItems?, LItems?, LItems).
litems_app([], T, T?).
litems_app([X|Xs], T, [X?|R?]) :- litems_app(Xs?, T?, R).

procedure c_head(NRoleSpecs?, Integer?, LItems).
c_head([], _, []).
c_head([RS|Rs], I, R?) :- ground(RS?), integer(I?) |
    I1 := I? + 1,
    c_head(Rs?, I1?, R1),
    c_hlits(RS?, I?, L),
    c_role(RS?, I?, L?, R1?, R).

procedure c_body(NRoleSpecs?, Integer?, LItems?, LItems).
c_body([], _, T, T?).
c_body([RS|Rs], I, T, R?) :- ground(RS?), integer(I?) |
    I1 := I? + 1,
    c_body(Rs?, I1?, T?, R1),
    c_blits(RS?, I?, L),
    c_role(RS?, I?, L?, R1?, R).

% The constraint after the body's literals; none for true.
procedure c_gamma(Constraint?, LItems).
c_gamma(true, []).
c_gamma(C, [cn(C?)]) :- otherwise | true.

% The guarding roles.
procedure c_guards(NRoleSpecs?, Integer?, Ints).
c_guards([], _, []).
c_guards([RS|Rs], I, R?) :- ground(RS?), integer(I?) |
    I1 := I? + 1,
    c_guards(Rs?, I1?, R1),
    n_is_guarding(RS?, G),
    c_guards1(G?, I?, R1?, R).

procedure c_guards1(Ans?, Integer?, Ints?, Ints).
c_guards1(yes, I, T, [I?|T?]).
c_guards1(no, _, T, T?).

procedure c_gnames(Ints?, NameOfs?, RChunks?, RChunks).
c_gnames([], _, T, T?).
c_gnames([I], Ns, T, R?) :- c_name(I?, Ns?, T?, R).
c_gnames([I, J|Is], Ns, T, R?) :- ground(Ns?) |
    c_gnames([J?|Is?], Ns?, T?, R1),
    c_name(I?, Ns?, [', '|R1?], R).

% guarded by G after the body, and nothing where G is empty.
procedure c_guard(Ints?, Ans?, NameOfs?, RChunks?, RChunks).
c_guard([], _, _, T, T?).
c_guard([I|Is], yes, Ns, T, ['guarded by '|R?]) :- c_gnames([I?|Is?], Ns?, T?, R).
c_guard([I|Is], no, Ns, T, [' guarded by '|R?]) :- c_gnames([I?|Is?], Ns?, T?, R).

procedure c_empty(LItems?, Ans).
c_empty([], yes).
c_empty([_|_], no).

% --- The constraint (def:numbers) -------------------------------------------
% and as a comma, eq, le, lt, ge and gt as =, <=, <, >= and >, succ(X, Y) as
% Y = X + 1; plus, minus and a product as +, - and *, an operand that is a
% sum or a difference in parentheses where it follows a minus or is a factor;
% a signing condition as def:numbers writes it.

procedure c_constraint(Constraint?, NameOfs?, RChunks?, RChunks).
c_constraint(true, _, T, ['true'|T?]).
c_constraint(and(C1, C2), Ns, T, R?) :- ground(Ns?) |
    c_constraint(C2?, Ns?, T?, R1),
    c_constraint(C1?, Ns?, [', '|R1?], R).
c_constraint(or(C1, C2), Ns, T, R?) :- ground(Ns?) |
    c_constraint(C2?, Ns?, T?, R1),
    c_constraint(C1?, Ns?, [' or '|R1?], R).
c_constraint(eq(X, Y), Ns, T, R?) :- c_cmp(X?, ' = ', Y?, Ns?, T?, R).
c_constraint(le(X, Y), Ns, T, R?) :- c_cmp(X?, ' <= ', Y?, Ns?, T?, R).
c_constraint(lt(X, Y), Ns, T, R?) :- c_cmp(X?, ' < ', Y?, Ns?, T?, R).
c_constraint(ge(X, Y), Ns, T, R?) :- c_cmp(X?, ' >= ', Y?, Ns?, T?, R).
c_constraint(gt(X, Y), Ns, T, R?) :- c_cmp(X?, ' > ', Y?, Ns?, T?, R).
c_constraint(succ(X, Y), Ns, T, R?) :- ground(Ns?) |
    c_arg(X?, Ns?, [' + 1'|T?], R1),
    c_arg(Y?, Ns?, [' = '|R1?], R).
c_constraint(signed(U, Y), Ns, T, ['signed('|R?]) :- ground(Ns?) |
    c_arg(Y?, Ns?, [')'|T?], R1),
    c_arg(U?, Ns?, [', '|R1?], R).
c_constraint(unsigned(U, Y), Ns, T, ['unsigned('|R?]) :- ground(Ns?) |
    c_arg(Y?, Ns?, [')'|T?], R1),
    c_arg(U?, Ns?, [', '|R1?], R).

procedure c_cmp(Expr?, Constant?, Expr?, NameOfs?, RChunks?, RChunks).
c_cmp(X, Op, Y, Ns, T, R?) :- ground(Ns?) |
    c_expr(Y?, Ns?, T?, R1),
    c_expr(X?, Ns?, [Op?|R1?], R).

procedure c_expr(Expr?, NameOfs?, RChunks?, RChunks).
c_expr(plus(A, B), Ns, T, R?) :- ground(Ns?) |
    c_expr(B?, Ns?, T?, R1),
    c_expr(A?, Ns?, [' + '|R1?], R).
c_expr(minus(A, B), Ns, T, R?) :- ground(Ns?) |
    c_operand(B?, Ns?, T?, R1),
    c_expr(A?, Ns?, [' - '|R1?], R).
c_expr(mul(A, B), Ns, T, R?) :- ground(Ns?) |
    c_operand(B?, Ns?, T?, R1),
    c_operand(A?, Ns?, ['*'|R1?], R).
c_expr(num(X), Ns, T, R?) :- c_arg(num(X?), Ns?, T?, R).
c_expr(role(I), Ns, T, R?) :- c_arg(role(I?), Ns?, T?, R).
c_expr(pvar(X), Ns, T, R?) :- c_arg(pvar(X?), Ns?, T?, R).
c_expr(svar(X), Ns, T, R?) :- c_arg(svar(X?), Ns?, T?, R).
c_expr(nterm(N), Ns, T, R?) :- c_arg(nterm(N?), Ns?, T?, R).
c_expr(sgn(Y, J), Ns, T, R?) :- c_arg(sgn(Y?, J?), Ns?, T?, R).
c_expr(any, Ns, T, R?) :- c_arg(any, Ns?, T?, R).

procedure c_operand(Expr?, NameOfs?, RChunks?, RChunks).
c_operand(plus(A, B), Ns, T, ['('|R?]) :- c_expr(plus(A?, B?), Ns?, [')'|T?], R).
c_operand(minus(A, B), Ns, T, ['('|R?]) :- c_expr(minus(A?, B?), Ns?, [')'|T?], R).
c_operand(mul(A, B), Ns, T, R?) :- c_expr(mul(A?, B?), Ns?, T?, R).
c_operand(num(X), Ns, T, R?) :- c_arg(num(X?), Ns?, T?, R).
c_operand(role(I), Ns, T, R?) :- c_arg(role(I?), Ns?, T?, R).
c_operand(pvar(X), Ns, T, R?) :- c_arg(pvar(X?), Ns?, T?, R).
c_operand(svar(X), Ns, T, R?) :- c_arg(svar(X?), Ns?, T?, R).
c_operand(nterm(N), Ns, T, R?) :- c_arg(nterm(N?), Ns?, T?, R).
c_operand(sgn(Y, J), Ns, T, R?) :- c_arg(sgn(Y?, J?), Ns?, T?, R).
c_operand(any, Ns, T, R?) :- c_arg(any, Ns?, T?, R).

% --- A schema (def:schema, def:numbers) -------------------------------------
% tau: H <- on a line, then B, gamma guarded by G on the next, indented.

procedure c_schema(NSchema?, NameOfs?, RChunks?, RChunks).
c_schema(Sc, Ns, T, [Nm?, ': '|R?]) :- ground(Sc?), ground(Ns?) |
    nsch_name(Sc?, Nm),
    nsch_roles(Sc?, Rs),
    nsch_constraint(Sc?, Cn),
    c_schema1(Rs?, Cn?, Ns?, T?, R).

procedure c_schema1(NRoleSpecs?, Constraint?, NameOfs?, RChunks?, RChunks).
c_schema1(Rs, Cn, Ns, T, R?) :- ground(Rs?), ground(Ns?) |
    c_head(Rs?, 1, H),
    c_gamma(Cn?, Gm),
    c_body(Rs?, 1, Gm?, B),
    c_guards(Rs?, 1, Gs),
    c_schema2(H?, B?, Gs?, Ns?, T?, R).

procedure c_schema2(LItems?, LItems?, Ints?, NameOfs?, RChunks?, RChunks).
c_schema2(H, B, Gs, Ns, T, R?) :- ground(B?), ground(Ns?) |
    c_empty(B?, E),
    c_guard(Gs?, E?, Ns?, [''|T?], R2),
    c_items(B?, Ns?, R2?, R1),
    c_items(H?, Ns?, [' <-', '', '    '|R1?], R).

% A schema as its owner writes it, read and printed by its roles' names.
procedure c_wschema(WSchema?, RChunks?, RChunks).
c_wschema(W, T, R?) :- ground(W?) |
    unnamed_s(W?, S),
    wsch_rnames(W?, Ns),
    c_schema(S?, Ns?, T?, R).

% The schemas apart by an empty line.
procedure n_wschemas(WContract?, RChunks?, RChunks).
n_wschemas([], T, T?).
n_wschemas([S], T, R?) :- c_wschema(S?, T?, R).
n_wschemas([S, S2|Ss], T, R?) :-
    n_wschemas([S2?|Ss?], T?, R1),
    c_wschema(S?, [''|R1?], R).

% --- A contract -------------------------------------------------------------
% A contract declaring predicates reflexive, or naming environment
% predicates, opens with them, then an empty line.

procedure n_preds(Preds?, RChunks?, RChunks).
n_preds([], T, T?).
n_preds([P], T, [P?|T?]).
n_preds([P, Q|Ps], T, [P?, ', '|R?]) :- n_preds([Q?|Ps?], T?, R).

procedure n_body(WBody?, RChunks?, RChunks).
n_body([], T, T?).
n_body([S|Ss], T, R?) :- n_wschemas([S?|Ss?], T?, R).
n_body(reflexive(Ps, Ss), T, ['Reflexive predicates: '|R?]) :-
    n_wschemas(Ss?, T?, R2),
    n_preds(Ps?, ['', ''|R2?], R).

procedure n_declared(WDeclared?, RChunks?, RChunks).
n_declared([], T, T?).
n_declared([S|Ss], T, R?) :- n_wschemas([S?|Ss?], T?, R).
n_declared(reflexive(Ps, Ss), T, ['Reflexive predicates: '|R?]) :-
    n_wschemas(Ss?, T?, R2),
    n_preds(Ps?, ['', ''|R2?], R).
n_declared(environment(Ps, B), T, ['Environment predicates: '|R?]) :-
    n_body(B?, T?, R2),
    n_preds(Ps?, ['', ''|R2?], R).

exported procedure notation_contract(WDeclared?).
notation_contract(D) :- ground(D?) |
    n_declared(D?, ['%% notation end'], L),
    send_to_user(['%% notation begin'|L?]).
