% ---------------------------------------------------------------------------
% The checker's fixtures: contracts broken in one place each, or small
% contracts that exercise one clause of a condition, which certify nothing
% but the checker.  Each names in its comment what it changes and which
% fault, if any, it is meant to raise.
%
% The contracts the checker is for are their owners' and live with their
% code, one copy each (claude.md "Sessions", the cascade rule; Coordination
% Appendix C): GSC's are programs/gsc/GSG.glp, GSN.glp and GSNP.glp, the
% social network with provenance of GSC, Section 3.3, the currency's
% programs/currencies/coins/GC.glp (Appendix B), the child-safe social
% network's programs/cssn/CSSN.glp and the federation's
% programs/federation/GFWC.glp (Appendix D).  Each
% prints its term by contract_named/2 in a REPL session on the file, and
% test_gsc.sh passes the term to check/2, traceable_preds/2,
% rooted_preds/2, compile_contract/2 and compile_schema_in/3.  A fixture that
% changes one of them in one place is a variant: variant/3 takes the owner's
% term and gives the fixture, so no copy of a contract is kept here.
%
% rs(Guard, Add, Del, Keep, Forb) is the role's +(i), -(i), =(i), not(i); a
% role is named by its index, so role(1) is the schema's first role.
% ---------------------------------------------------------------------------

% --- the social graph with items of arity three, no signed term ------------
% The social graph as Section 3.3 printed it before the signed term (GSC
% 63b301f): item(x, a, f), the item x by a as received from f.  A fixture, the
% base of the Appendix D variants below (sg_relay, sg_tri_cschema), since
% Appendix D's Definition Act schema admits no signed term and the contract
% GSNP carries one (programs/gsc/GSNP.glp); it certifies nothing of GSNP.
procedure sg_plain(Contract).
sg_plain([schema(befriend,
       [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
    schema(unfriend,
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
    schema(sign,
       [rs(guarded, [atom(item, [svar(x), role(1), role(1)])], [], [], [])]),
    schema(forward,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(a), pvar(f)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(a), role(1)])], [],
                      [atom(friend, [role(1)])], [])])]).

% --- negative: befriend guarded in one role only ---------------------------
% Nothing is then an introductory act, and befriend fails volition too.
procedure sg_unguarded(Contract).
sg_unguarded([schema(befriend,
       [rs(guarded,   [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
        rs(unguarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
    schema(unfriend,
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
    schema(sign,
       [rs(guarded, [atom(item, [svar(x), role(1), role(1)])], [], [], [])]),
    schema(forward,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(a), pvar(f)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(a), role(1)])], [],
                      [atom(friend, [role(1)])], [])])]).

% --- negative: befriending done to one of the two ---------------------------
% impose(p?, q) : +friend(q)   +friend(p)
% Clause 2 of def:unobstructed excuses it against befriend -- it gives the
% other party a role and the atom it adds names that party -- and volition is
% what rejects it: two roles, guarded at one, and neither requires an atom of
% traceable provenance naming the other.
procedure sg_imposed(Contract?, Contract).
sg_imposed(S, C?) :-
    contract_app(S?,
      [schema(impose,
         [rs(guarded,   [atom(friend, [role(2)])], [], [], []),
          rs(unguarded, [atom(friend, [role(1)])], [], [], [])])], C).

% --- negative: a friend atom naming somebody who takes no part -------------
% gossip(p?, f?) : knows(u), +friend(u)   +gossiped
% The atom befriend forbids at p is added at p by an act whose binding sends
% no role to q, so clause 2 of def:unobstructed fails: p can be left holding
% friend(q) without q ever taking part.  friend keeps traceable provenance,
% u being named by the knows atom the role requires, and gossip is guarded in
% both its roles, so volition is not what rejects this one.
procedure sg_gossip(Contract?, Contract).
sg_gossip(S, C?) :-
    contract_app(S?,
      [schema(gossip,
         [rs(guarded, [atom(friend, [pvar(u)])], [],
                      [atom(knows, [pvar(u)])], []),
          rs(guarded, [atom(gossiped, [])], [], [], [])])], C).

% --- volition above arity two: a role graph that is a path -----------------
% chain(p?, q, r, s) : friend(q), +chained(q)   friend(r), +chained(r)
%                      friend(s), +chained(s)   +chained(r)
% Guarded at one role, and no pair beyond the path has an edge, so the schema
% passes on connectedness and would fail on every pair.
procedure sg_chain(Contract?, Contract).
sg_chain(S, C?) :-
    contract_app(S?,
      [schema(chain,
         [rs(guarded,   [atom(chained, [role(2)])], [],
                        [atom(friend, [role(2)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [],
                        [atom(friend, [role(3)])], []),
          rs(unguarded, [atom(chained, [role(4)])], [],
                        [atom(friend, [role(4)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [], [], [])])], C).

% --- negative: the same schema with one edge of the path removed -----------
% Role 2 requires nothing, so the role graph falls into {1,2} and {3,4}, and
% {3,4} holds no guarding role.
procedure sg_chain_cut(Contract?, Contract).
sg_chain_cut(S, C?) :-
    contract_app(S?,
      [schema(chain,
         [rs(guarded,   [atom(chained, [role(2)])], [],
                        [atom(friend, [role(2)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [], [], []),
          rs(unguarded, [atom(chained, [role(4)])], [],
                        [atom(friend, [role(4)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [], [], [])])], C).

% --- volition by connected component, in Section 3 as in Appendix D ---------
% tri(p?, q, r?) :  +chained(q)    friend(p), +chained(p)    +chained(p)
% q requires friend(p), which joins roles 1 and 2, and nothing joins role 3,
% so the role graph falls into {1,2} and {3}, each holding a guarding role:
% tri is neither guarded in all its roles nor connected, and meets
% def:volition.  sg_tri_cschema is the same contract with tri written as a
% cschema, in the language of Appendix D, where it meets definition:volition.
procedure tri_roles(RoleSpecs).
tri_roles([rs(guarded,   [atom(chained, [role(2)])], [], [], []),
           rs(unguarded, [atom(chained, [role(1)])], [],
                         [atom(friend, [role(1)])], []),
           rs(guarded,   [atom(chained, [role(1)])], [], [], [])]).

procedure sg_tri(Contract?, Contract).
sg_tri(S, C?) :-
    tri_roles(Rs),
    contract_app(S?, [schema(tri, Rs?)], C).

procedure sg_tri_cschema(Contract?, Contract).
sg_tri_cschema(S, C?) :-
    tri_roles(Rs),
    contract_app(S?, [cschema(tri, [], Rs?)], C).

% --- negative: the currency without mint -----------------------------------
% The swap is still an introductory act, and each role requires a coin of its
% own issue that no act of arity one supplies: clause 1 of def:unobstructed
% fails.
procedure cur_no_mint(Contract).
cur_no_mint([schema(swap,
       [rs(guarded, [atom(coin, [pvar(v)])], [atom(coin, [pvar(u)])], [], []),
        rs(guarded, [atom(coin, [pvar(u)])], [atom(coin, [pvar(v)])], [], [])]),
     schema(pay,
       [rs(guarded,   [], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [], [], [])]),
     schema(redeem,
       [rs(guarded,   [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [], [])])]).

% --- negative: a speech act carried over from an untraceable record --------
% note(p?; x, u) : +tagged(x, u)      tag(p?; x, u) : tagged(x, u), +item(x)
% u is named by no atom note requires, so tagged loses traceable provenance;
% the x that tag adds in an item occurs in a required atom, tagged(x, u), but
% in none of traceable provenance, so item loses it too under the clause of
% def:grounded on speech-act variables; over GSNP, posted and delivered after
% it, each adding a speech act that the schema requires only in an item, or
% in a posted atom.  Befriend stays unobstructed and every schema
% satisfies volition, so what rejects the contract is the second conjunct of
% def:syntactically-grassroots alone.
procedure sg_svar_loose(Contract?, Contract).
sg_svar_loose(S, C?) :-
    contract_app(S?,
      [schema(note,
         [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
       schema(tag,
         [rs(guarded, [atom(item, [svar(x)])], [],
                      [atom(tagged, [svar(x), pvar(u)])], [])])], C).

% --- negative: minting a coin of somebody else's issue ---------------------
% mint(p?; u) : +coin(u), where u is named by no atom mint requires.  coin
% loses traceable provenance (def:grounded), and pay and redeem, guarded at
% one role and resting on it, then fail def:volition.
procedure cur_loose_mint(Contract).
cur_loose_mint([schema(mint,
       [rs(guarded, [atom(coin, [pvar(u)])], [], [], [])]),
     schema(swap,
       [rs(guarded, [atom(coin, [pvar(v)])], [atom(coin, [pvar(u)])], [], []),
        rs(guarded, [atom(coin, [pvar(u)])], [atom(coin, [pvar(v)])], [], [])]),
     schema(pay,
       [rs(guarded,   [], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [], [], [])]),
     schema(redeem,
       [rs(guarded,   [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [], [])])]).

% --- reflexive predicates (the paragraph after def:binding) ----------------
% The social graph with friend declared reflexive: every state is taken to
% hold friend of its holder, and nothing else changes, so it certifies.
procedure sg_reflexive(Contract?, Declared).
sg_reflexive(S, reflexive([friend], S?)).

% The social graph with its befriend changed in one place, for the variants
% of befriend below: at each role, friend of that role is added to what the
% role requires (own_keep) or to what it forbids (own_forb), and every other
% schema, and everything else befriend requires and forbids, is unchanged.
procedure own_friend(Constant?, RoleSpecs?, Integer?, RoleSpecs).
own_friend(_, [], _, []).
own_friend(own_keep, [rs(G, P, M, K, N)|Rs], I,
           [rs(G?, P?, M?, [atom(friend, [role(I?)])|K?], N?)|R?]) :-
    integer(I?), ground(Rs?) |
    I1 := I? + 1,
    own_friend(own_keep, Rs?, I1?, R).
own_friend(own_forb, [rs(G, P, M, K, N)|Rs], I,
           [rs(G?, P?, M?, K?, [atom(friend, [role(I?)])|N?])|R?]) :-
    integer(I?), ground(Rs?) |
    I1 := I? + 1,
    own_friend(own_forb, Rs?, I1?, R).
own_friend(W, [RS|Rs], I, [RS?|R?]) :- otherwise, ground(W?), integer(I?), ground(Rs?) |
    I1 := I? + 1,
    own_friend(W?, Rs?, I1?, R).

procedure befriend_own(Constant?, Contract?, Contract).
befriend_own(_, [], []).
befriend_own(W, [schema(befriend, Rs)|Ss], [schema(befriend, Rs1?)|R?]) :-
    ground(W?), ground(Rs?), ground(Ss?) |
    own_friend(W?, Rs?, 1, Rs1),
    befriend_own(W?, Ss?, R).
befriend_own(W, [S|Ss], [S?|R?]) :- otherwise, ground(W?), ground(Ss?) |
    befriend_own(W?, Ss?, R).

% --- negative: a schema adding or deleting friend of its own role ----------
% self_befriend(p?) : +friend(p)        self_unfriend(p?) : -friend(p)
% With friend reflexive no schema adds or deletes, at a role, the friend atom
% naming that role, so the contract is malformed: it is refused, each schema,
% role and atom named, and no condition is decided.
procedure sg_refl_malformed(Contract?, Declared).
sg_refl_malformed(S, reflexive([friend], C?)) :-
    contract_app(S?,
      [schema(self_befriend,
         [rs(guarded, [atom(friend, [role(1)])], [], [], [])]),
       schema(self_unfriend,
         [rs(guarded, [], [atom(friend, [role(1)])], [], [])])], C).

% --- negative: a role that does not guard and changes nothing --------------
% poke(p?, q) :  identity, +poked(q)        identity, friend(p)
% def:schema requires +(i) u -(i) nonempty at every role that is not a
% guarding role; q's role does not guard and adds and deletes nothing, so the
% contract is malformed, the schema and the role named.  GSNP's forward and
% post, whose guarding role adds and deletes nothing, are admitted.
procedure sg_inert_role(Contract?, Contract).
sg_inert_role(S, C?) :-
    contract_app(S?,
      [schema(poke,
         [rs(guarded,   [atom(poked, [role(2)])], [], [atom(identity, [])], []),
          rs(unguarded, [], [], [atom(identity, []), atom(friend, [role(1)])], [])])], C).

% --- negative: a schema that changes nothing at any role ------------------
% look(p?, q?) :  identity, friend(q)        identity, friend(p)
% Both roles guard and each may add and delete nothing, but def:schema
% requires +(i) u -(i) nonempty at some role, so the contract is malformed,
% the schema named.
procedure sg_inert_schema(Contract?, Contract).
sg_inert_schema(S, C?) :-
    contract_app(S?,
      [schema(look,
         [rs(guarded, [], [], [atom(identity, []), atom(friend, [role(2)])], []),
          rs(guarded, [], [], [atom(identity, []), atom(friend, [role(1)])], [])])], C).

% --- negative: an atom added and deleted at one role -----------------------
% toggle(p?) :  identity, -flag, +flag
% def:schema requires +(i) and -(i) disjoint, so the contract is malformed,
% the schema, the role and the atom named.
procedure sg_added_deleted(Contract?, Contract).
sg_added_deleted(S, C?) :-
    contract_app(S?,
      [schema(toggle,
         [rs(guarded, [atom(flag, [])], [atom(flag, [])], [atom(identity, [])], [])])], C).

% --- befriend requiring friend of each agent at its own role ---------------
% befriend(p?, q?) :  friend(p), identity, not friend(q), +friend(q)
%                     friend(q), identity, not friend(p), +friend(p)
% No act of arity one adds friend, so clause 1 of def:unobstructed fails at
% both roles of sg_self_required; with friend declared reflexive the clause
% skips those two atoms, and sg_refl_required certifies.
procedure sg_self_required(Contract?, Contract).
sg_self_required(S, C?) :- befriend_own(own_keep, S?, C).

procedure sg_refl_required(Contract?, Declared).
sg_refl_required(S, reflexive([friend], C?)) :- sg_self_required(S?, C).

% --- negative: befriend forbidding friend of each agent at its own role ----
% befriend(p?, q?) :  identity, not friend(p), not friend(q), +friend(q)
%                     identity, not friend(q), not friend(p), +friend(p)
% With friend reflexive every state holds friend of its holder, so clause 3 of
% def:unobstructed fails at both roles of befriend; no act adds at an agent
% friend of that agent, so clause 2 holds.  The verdict names befriend's
% faults, befriend being the contract's first introductory act.
procedure sg_refl_forbidden(Contract?, Declared).
sg_refl_forbidden(S, reflexive([friend], C?)) :- befriend_own(own_forb, S?, C).

% --- cs18: a child-safe social contract of eighteen schemas ----------------
% The checker's fixture for expanded schemas, four-party schemas, speech-act
% variables and a schema no party guards, in one contract: eighteen schemas,
% twenty-eight expanded, syntactically grassroots, its introductory act
% parent_child.  It is the child-safe social network's contract as CSSN
% drafted it in Legal's inbox on 2026-08-15 and 2026-08-16 and as it was
% brought to their paper on 2026-10-09 (send, parent_child, friend reflexive,
% the five expanded schemas); CSSN has since revised the contract, and the
% contract is programs/cssn/CSSN.glp, CSSN's, which certifies this
% fixture of nothing.
%
% unfriend, child_unfriend, leave, child_leave and child_leave_2 each stand
% for one schema per role, guarded at that role and differing in nothing
% else, and are written expanded: the one guarded at the role the table
% writes r is named <schema>_r, so unfriend_p and unfriend_q, leave_a and
% leave_q, child_leave_a, _s and _p, child_unfriend_r, _s, _p and _q, and
% child_leave_2_r, _s, _p and _q.  n names a group.  A group is no person,
% so n is a speech-act variable here, member and listed having traceable
% provenance only under that reading.
procedure cs18(Declared).
cs18(reflexive([friend], S?)) :- cs18_schemas(S).

procedure cs18_schemas(Contract).
cs18_schemas([schema(parent_child,
       [rs(guarded, [atom(parenting, [role(2)])], [], [],
                    [atom(parent, [role(2)])]),
        rs(guarded, [atom(parent, [role(1)]), atom(child, [])], [], [],
                    [atom(parent, [role(1)])])]),
     schema(end_parenting,
       [rs(guarded, [], [atom(parent, [role(2)]), atom(child, [])], [], []),
        rs(guarded, [], [atom(parenting, [role(1)])], [], [])]),
     schema(befriend,
       [rs(guarded, [atom(friend, [role(2)])], [], [],
                    [atom(child, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [],
                    [atom(child, []), atom(friend, [role(1)])])]),
     schema(unfriend_p,
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
     schema(unfriend_q,
       [rs(unguarded, [], [atom(friend, [role(2)])], [], []),
        rs(guarded,   [], [atom(friend, [role(1)])], [], [])]),
     schema(child_befriend,
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(parent, [role(3)])],
                    [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(parent, [role(4)])],
                    [atom(friend, [role(1)])]),
        rs(guarded, [atom(approval, [])], [],
                    [atom(parenting, [role(1)]), atom(friend, [role(4)])], []),
        rs(guarded, [atom(approval, [])], [],
                    [atom(parenting, [role(2)]), atom(friend, [role(3)])], [])]),
     schema(child_unfriend_r,
       [rs(guarded,   [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_unfriend_s,
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(guarded,   [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_unfriend_p,
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_unfriend_q,
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(create,
       [rs(guarded, [atom(member, [role(1), svar(n)]),
                     atom(listed, [role(1), svar(n)])], [], [], [])]),
     schema(join,
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(member, [role(1), svar(n)]), atom(friend, [role(2)])], []),
        rs(guarded, [atom(member, [role(1), svar(n)])], [],
                    [atom(friend, [role(1)])],
                    [atom(child, []), atom(member, [role(1), svar(n)])])]),
     schema(child_join,
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(member, [role(1), svar(n)]), atom(friend, [role(3)])], []),
        rs(guarded, [atom(member, [role(1), svar(n)])], [],
                    [atom(parent, [role(3)])],
                    [atom(member, [role(1), svar(n)])]),
        rs(guarded, [atom(approval, [])], [],
                    [atom(parenting, [role(2)]), atom(friend, [role(1)])], [])]),
     schema(child_join2,
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(member, [role(1), svar(n)]), atom(friend, [role(2)]),
                     atom(parent, [role(3)])], []),
        rs(guarded, [atom(member, [role(1), svar(n)])], [],
                    [atom(parent, [role(4)]), atom(friend, [role(1)])],
                    [atom(member, [role(1), svar(n)])]),
        rs(guarded, [atom(approval, [])], [], [atom(parenting, [role(1)])], []),
        rs(guarded, [atom(approval, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(leave_a,
       [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], [])]),
     schema(leave_q,
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(guarded,   [], [atom(member, [role(1), svar(n)])], [], [])]),
     schema(child_leave_a,
       [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_s,
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(guarded,   [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_p,
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(sign,
       [rs(guarded, [atom(item, [svar(x), role(1), role(1)])], [], [], [])]),
     schema(send,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(a), pvar(f)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(a), role(1)])], [],
                      [atom(friend, [role(1)])], [])]),
     schema(post,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(b), pvar(f)]),
                       atom(member, [role(2), svar(n)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(b), role(1)]),
                       atom(posted, [svar(x), svar(n)])], [],
                      [atom(listed, [role(1), svar(n)])], [])]),
     schema(deliver,
       [rs(unguarded, [atom(delivered, [svar(x), role(2), svar(n)])], [],
                      [atom(item, [svar(x), pvar(b), pvar(f)]),
                       atom(posted, [svar(x), svar(n)]),
                       atom(listed, [role(2), svar(n)])],
                      [atom(delivered, [svar(x), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [svar(x), pvar(b), role(1)])], [],
                      [atom(member, [role(1), svar(n)])], [])]),
     schema(child_leave_2_r,
       [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_2_s,
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(guarded,   [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_2_p,
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_2_q,
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(post_own,
       [rs(guarded, [atom(posted, [svar(x), svar(n)])], [],
                    [atom(item, [svar(x), pvar(b), pvar(f)]),
                     atom(listed, [role(1), svar(n)])], [])])]).

% --- the contracts by name -------------------------------------------------
% A fixture that stands alone, by name.  An unknown name is the empty
% contract, which has no introductory act.
exported procedure contract(Constant?, Declared).
contract(sg_plain, C?) :- sg_plain(C).
contract(sg_unguarded, C?) :- sg_unguarded(C).
contract(cur_no_mint, C?) :- cur_no_mint(C).
contract(cur_loose_mint, C?) :- cur_loose_mint(C).
contract(cs18, C?) :- cs18(C).
contract(sv_signed, C?) :- sv_signed(C).
contract(sv_loose, C?) :- sv_loose(C).
contract(sv_in_name_loose, C?) :- sv_in_name_loose(C).
contract(sv_in_name_carried, C?) :- sv_in_name_carried(C).
contract(sg_items, C?) :- sg_items(C).
contract(sgn_intro, C?) :- sgn_intro(C).
contract(sgn_intro_plain, C?) :- sgn_intro_plain(C).
contract(sgn_not_added, C?) :- sgn_not_added(C).
contract(sgn_other_role, C?) :- sgn_other_role(C).
contract(sgn_unguarded_signer, C?) :- sgn_unguarded_signer(C).
contract(sgn_not_required, C?) :- sgn_not_required(C).
contract(sgn_community, C?) :- sgn_community(C).
contract(sg_sgn_loose, C?) :- sg_sgn_loose(C).
contract(wd, C?) :- wd(C).
contract(wd_iota_deleted, C?) :- wd_iota_deleted(C).
contract(wd_two_marks, C?) :- wd_two_marks(C).
contract(wd_no_iota, C?) :- wd_no_iota(C).
contract(wd_no_g, C?) :- wd_no_g(C).
contract(wd_no_w, C?) :- wd_no_w(C).
contract(wd_sigma_marked, C?) :- wd_sigma_marked(C).
contract(wd_del_half, C?) :- wd_del_half(C).
contract(wd_req_unsupplied, C?) :- wd_req_unsupplied(C).
contract(wd_forb_other, C?) :- wd_forb_other(C).
contract(wd_asymmetric, C?) :- wd_asymmetric(C).
contract(wd_two_atoms, C?) :- wd_two_atoms(C).
contract(wd_no_adult_relay, C?) :- wd_no_adult_relay(C).
contract(wd_no_child_relay, C?) :- wd_no_child_relay(C).
contract(wd_relay_extra_role, C?) :- wd_relay_extra_role(C).
contract(wd_relay_guard_names, C?) :- wd_relay_guard_names(C).
contract(wd_relay_req, C?) :- wd_relay_req(C).
contract(wd_relay_forb, C?) :- wd_relay_forb(C).
contract(wd_relay_unguarded, C?) :- wd_relay_unguarded(C).
contract(wd2, C?) :- wd2(C).
contract(_, []) :- otherwise | true.

% A fixture that is a contract changed in one place, by name and the contract
% it changes, which test_gsc.sh reads from the owner's file: GSNP's for sg_*
% (sg_plain's for sg_relay and sg_tri_cschema, Appendix D admitting no signed
% term), the federation's for gf_*.  An unknown name is the empty contract.
exported procedure variant(Constant?, Contract?, Declared).
variant(sg_imposed, S, C?) :- sg_imposed(S?, C).
variant(sg_gossip, S, C?) :- sg_gossip(S?, C).
variant(sg_chain, S, C?) :- sg_chain(S?, C).
variant(sg_chain_cut, S, C?) :- sg_chain_cut(S?, C).
variant(sg_tri, S, C?) :- sg_tri(S?, C).
variant(sg_tri_cschema, S, C?) :- sg_tri_cschema(S?, C).
variant(sg_svar_loose, S, C?) :- sg_svar_loose(S?, C).
variant(sg_reflexive, S, C?) :- sg_reflexive(S?, C).
variant(sg_refl_malformed, S, C?) :- sg_refl_malformed(S?, C).
variant(sg_inert_role, S, C?) :- sg_inert_role(S?, C).
variant(sg_inert_schema, S, C?) :- sg_inert_schema(S?, C).
variant(sg_added_deleted, S, C?) :- sg_added_deleted(S?, C).
variant(sg_self_required, S, C?) :- sg_self_required(S?, C).
variant(sg_refl_required, S, C?) :- sg_refl_required(S?, C).
variant(sg_refl_forbidden, S, C?) :- sg_refl_forbidden(S?, C).
variant(sg_relay, S, C?) :- sg_relay(S?, C).
variant(gf_unrooted, F, C?) :- gf_unrooted(F?, C).
variant(gf_untraceable, F, C?) :- gf_untraceable(F?, C).
variant(gf_uncohesive, F, C?) :- gf_uncohesive(F?, C).
variant(gf_cohesion_only, F, C?) :- gf_cohesion_only(F?, C).
variant(gf_novolition, F, C?) :- gf_novolition(F?, C).
variant(gf_inert_seated, F, C?) :- gf_inert_seated(F?, C).
variant(gf_added_deleted, F, C?) :- gf_added_deleted(F?, C).
variant(_, _, []) :- otherwise | true.

% --- negative: the new community named without the decision that formed it --
% federate seats the assembly in the name of the community itself, of least
% rank zero and at no party role, so seat is not rooted.
procedure gf_unrooted(Contract?, Contract).
gf_unrooted([], []).
gf_unrooted([_], []).
gf_unrooted([F, _ | R],
   [F?, cschema(federate, [],
         [crs(seated(nvar(zeta), seat), guarded_at(theta),
              [atom(child, [nterm(ext(nvar(zeta), y)), nterm(nvar(zeta))]),
               atom(seat, [nterm(nvar(zeta))])], [], [], [])]) | R?]).

% --- negative: an atom naming a community nothing traces -------------------
% federate notes a community eta that is the name term of no role and that no
% atom any role requires names, so note loses traceable provenance; seat and
% child keep it, and the set of predicates occurring in the contract lacks it,
% the contract's one fault.  note is the predicate of no role, so cohesion is
% untouched.
procedure gf_untraceable(Contract?, Contract).
gf_untraceable([], []).
gf_untraceable([_], []).
gf_untraceable([F, _ | R],
   [F?, cschema(federate, [],
         [crs(seated(nvar(zeta), seat), guarded_at(theta),
              [atom(child, [nterm(ext(nvar(zeta), y)), nterm(nvar(zeta))]),
               atom(seat, [nterm(ext(nvar(zeta), y))]),
               atom(note, [nterm(nvar(eta))])], [], [], [])]) | R?]).

% --- negative: a seat atom of a community that is no role of the schema -----
% federate seats the assembly in eta, the name term of no role of it, in
% place of the community it forms, so cohesion fails at its seated role.
% seat is the one role predicate of the contract, every role being a party
% or a seated role, so cohesion asks its question of seat atoms alone
% (definition:cohesive), and a child atom naming eta would break nothing.
% The same atom costs seat its traceable provenance, which the verdict names
% before the cohesion fault, and its rootedness.
procedure gf_uncohesive(Contract?, Contract).
gf_uncohesive([], []).
gf_uncohesive([_], []).
gf_uncohesive([F, _ | R],
   [F?, cschema(federate, [],
         [crs(seated(nvar(zeta), seat), guarded_at(theta),
              [atom(child, [nterm(ext(nvar(zeta), y)), nterm(nvar(zeta))]),
               atom(seat, [nterm(nvar(eta))])], [], [], [])]) | R?]).

% --- negative: cohesion alone ---------------------------------------------
% The federation contract with one schema more,
%     seat_child(zeta^seat ?theta ; ; zeta, eta) :
%         zeta^seat:  child(zeta, eta), +seat(eta),
% the assembly of zeta seating itself in a child eta of zeta.  eta is the name
% term of no role of seat_child, and no <pi_i> of a party role or extension of
% either, so cohesion fails at its role (definition:cohesive).  eta is an
% argument of the child(zeta, eta) the role requires, child being in the set
% {seat, child}, so seat keeps traceable provenance (definition:provenance);
% the role graph is one role, so volition holds.  seat stops being rooted,
% which is no condition (Legal 2026-10-09 18:31 UTC).
procedure gf_cohesion_only(Contract?, Contract).
gf_cohesion_only(F, C?) :-
    contract_app(F?,
      [cschema(seat_child, [],
         [crs(seated(nvar(zeta), seat), guarded_at(theta),
              [atom(seat, [nterm(nvar(eta))])], [],
              [atom(child, [nterm(nvar(zeta)), nterm(nvar(eta))])], [])])], C).

% --- a seated role that changes nothing --------------------------------------
% The federation contract with one schema more,
%     confirm(zeta^seat ?theta, xi^seat ; ; zeta, xi) :
%         zeta^seat:  child(zeta, xi), +confirmed(zeta, xi)
%         xi^seat:    child(zeta, xi),
% the assembly of zeta confirming its child xi, whose assembly requires the
% child atom and adds and deletes nothing.  Appendix D's Definition Act schema
% requires +(i) and -(i) disjoint and nothing of +(i) u -(i), so the
% contract is formed; confirmed's xi is the base of a role, child has
% traceable provenance, and xi^seat requires child(zeta, xi), whose zeta is
% the base of the other role, so the three conditions on the text hold.  Its
% compiled form (definition:compile) carries c'_p \neq c_p over the extent of
% xi^seat, a seated role adding and deleting nothing.
procedure gf_inert_seated(Contract?, Contract).
gf_inert_seated(F, C?) :-
    contract_app(F?,
      [cschema(confirm, [],
         [crs(seated(nvar(zeta), seat), guarded_at(theta),
              [atom(confirmed, [nterm(nvar(zeta)), nterm(nvar(xi))])], [],
              [atom(child, [nterm(nvar(zeta)), nterm(nvar(xi))])], []),
          crs(seated(nvar(xi), seat), unguarded,
              [], [],
              [atom(child, [nterm(nvar(zeta)), nterm(nvar(xi))])], [])])], C).

% --- negative: an atom added and deleted at a seated role ------------------
% The federation contract with one schema more,
%     reseat(zeta^seat ?theta ; ; zeta) :  zeta^seat:  -seat(zeta), +seat(zeta).
% Appendix D's Definition Act schema requires +(i) and -(i) disjoint, so the
% contract is malformed, the schema, the role and the atom named.
procedure gf_added_deleted(Contract?, Contract).
gf_added_deleted(F, C?) :-
    contract_app(F?,
      [cschema(reseat, [],
         [crs(seated(nvar(zeta), seat), guarded_at(theta),
              [atom(seat, [nterm(nvar(zeta))])],
              [atom(seat, [nterm(nvar(zeta))])], [], [])])], C).

% --- negative: a join no assembly decides ----------------------------------
% The two roles of join are the assemblies of two communities, of different
% bases, and neither requires an atom, so nothing joins them; with neither
% guarding, no part of the role graph holds a guarding role.
procedure gf_novolition(Contract?, Contract).
gf_novolition([], []).
gf_novolition([_], []).
gf_novolition([F, D | _],
   [F?, D?, cschema(join, [reach(nvar(xi), child, nvar(zeta))],
         [crs(seated(nvar(zeta), seat), unguarded,
              [atom(child, [nterm(nvar(zeta)), nterm(nvar(xi))])], [], [],
              [atom(child, [nterm(nvar(zeta)), nterm(nvar(xi))])]),
          crs(seated(nvar(xi), seat), unguarded,
              [atom(child, [nterm(nvar(zeta)), nterm(nvar(xi))])], [], [],
              [atom(child, [nterm(nvar(zeta)), nterm(nvar(xi))])])])]).

% --- the speech-act variables of definition:provenance (Appendix D) ---------
% Four small contracts of party roles, put in the language of Appendix D by a
% cschema with no reach conditions.  The first clause of definition:provenance
% asks after the arguments of an added atom outside Y, the second after every
% speech-act variable that is an argument of it or occurs in a name term among
% its arguments.
%
% sign(p?; x) : +item(x, p)        take(p?, q) : +got(q)    item(z, p), +mark(q)
% x is a speech-act variable, so only the second clause asks after it, and it
% occurs in no atom sign requires: item has traceable provenance, and the item
% take's second role requires, naming the first, joins take's role graph.
procedure sv_take(Contract).
sv_take([schema(take,
       [rs(guarded,   [atom(got, [role(2)])], [], [], []),
        rs(unguarded, [atom(mark, [role(2)])], [],
                      [atom(item, [svar(z), role(1)])], [])])]).

procedure sv_signed(Contract).
sv_signed(C?) :-
    sv_take(T),
    contract_app([cschema(sign, [],
       [rs(guarded, [atom(item, [svar(x), role(1)])], [], [], [])])], T?, C).

% --- negative: the same speech act carried from an untraceable record ------
% note(p?; x, u) : +tagged(x, u)      tag(p?; x, u) : tagged(x, u), +item(x, p)
% The case of sg_svar_loose, in the language of Appendix D.  u is named by no
% atom note requires, so tagged loses traceable provenance; the x of the item
% tag adds occurs in tagged(x, u), which tag requires, and in no required atom
% of traceable provenance, so the second clause drops item, and take loses the
% edge it rested on.
procedure sv_loose(Contract).
sv_loose(C?) :-
    sv_signed(S),
    contract_app(S?,
      [schema(note,
         [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
       schema(tag,
         [rs(guarded, [atom(item, [svar(x), role(1)])], [],
                      [atom(tagged, [svar(x), pvar(u)])], [])])], C).

% --- negative: a speech act in a name term, from an untraceable record -----
% note(p?; x, u) : +tagged(x, u)    found(p?; x, u) : tagged(x, u), +club(<p>.x)
% The x in the name term of the club atom found adds occurs in tagged(x, u),
% which found requires, and in no required atom of traceable provenance, so
% the second clause drops club.
procedure sv_in_name_loose(Contract).
sv_in_name_loose([cschema(note, [],
       [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
     schema(found,
       [rs(guarded, [atom(club, [nterm(ext(own(1), x))])], [],
                    [atom(tagged, [svar(x), pvar(u)])], [])])]).

% --- a speech act carried from a name term of a required atom --------------
% found(p?; x) : +club(<p>.x)        cite(p?; x) : club(<p>.x), +cited(x)
% The x that cite adds occurs in a name term among the arguments of
% club(<p>.x), which cite requires and which has traceable provenance, so the
% second clause keeps cited.
procedure sv_in_name_carried(Contract).
sv_in_name_carried([cschema(found, [],
       [rs(guarded, [atom(club, [nterm(ext(own(1), x))])], [], [], [])]),
     schema(cite,
       [rs(guarded, [atom(cited, [svar(x)])], [],
                    [atom(club, [nterm(ext(own(1), x))])], [])])]).

% --- volition by connected component (definition:volition) ----------------
% relay(p?, q, r, zeta^seat ?theta) :
%     friend(q), +chained(q)    friend(r), +chained(r)    +chained(p)    +noted(zeta)
% Over the social graph, put in the language of Appendix D by the seated role.
% relay's role graph falls into the path p-q-r and the assembly of zeta, each
% holding a guarding role, and r has no edge to a guarding role: relay meets
% volition.  relay_unguarded is relay with the assembly unguarded, so that
% the assembly's component holds no guarding role, and it fails.
procedure sg_relay(Contract?, Contract).
sg_relay(S, C?) :-
    contract_app(S?,
      [schema(relay,
         [rs(guarded,   [atom(chained, [role(2)])], [],
                        [atom(friend, [role(2)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [],
                        [atom(friend, [role(3)])], []),
          rs(unguarded, [atom(chained, [role(1)])], [], [], []),
          crs(seated(nvar(zeta), seat), guarded_at(theta),
              [atom(noted, [nterm(nvar(zeta))])], [], [], [])]),
       schema(relay_unguarded,
         [rs(guarded,   [atom(chained, [role(2)])], [],
                        [atom(friend, [role(2)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [],
                        [atom(friend, [role(3)])], []),
          rs(unguarded, [atom(chained, [role(1)])], [], [], []),
          crs(seated(nvar(zeta), seat), unguarded,
              [atom(noted, [nterm(nvar(zeta))])], [], [], [])])], C).

% ===========================================================================
% The signed speech-act term (Sections 3.1 to 3.3; the commit 63b301f)
% ===========================================================================

% --- the social graph with items --------------------------------------------
% The social graph with items of arity one, without identity and groups:
% sign(Alice?; x) adds item(x), and forward(Alice?, Bob; x) requires item(x)
% at Alice, adds sent(x, Bob) there, and adds item(sgn(x, Alice)) at Bob,
% where friend(Alice) is required.  The checker's fixture, the base of
% sg_sgn_loose below; Section 3.3's network with provenance is GSNP, GSC's
% contract, programs/gsc/GSNP.glp, which test_gsc.sh reads.
procedure sg_items(Contract).
sg_items([schema(befriend,
       [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
    schema(unfriend,
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
    schema(sign,
       [rs(guarded, [atom(item, [svar(x)])], [], [], [])]),
    schema(forward,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(friend, [role(1)])], [])])]).

% --- an introduction through the signed term alone -------------------------
% exchange(Alice?, Bob?; x, y) :  item(x), +got(sgn(y, Bob))    item(y), +got(sgn(x, Alice))
% over sign.  Each role adds an atom naming the other only as the role of its
% signed term (Section 3.1, what an atom names; Appendix D, "names"), so
% exchange is an introductory act (def:introduction); it is unobstructed, the
% item each role requires being added by sign, of arity one, guarded,
% requiring and forbidding nothing (clause 1 of def:unobstructed); got has
% traceable provenance, y being an argument of the item Bob requires
% (def:grounded); and the contract is syntactically grassroots.
% sgn_intro_plain is the same with got(y) and got(x) in place of the signed
% terms: an added atom then names a speech-act variable and not the other
% party, and the contract has no introductory act.
procedure sgn_sign(Schema).
sgn_sign(schema(sign, [rs(guarded, [atom(item, [svar(x)])], [], [], [])])).

procedure sgn_intro(Contract).
sgn_intro([S?,
    schema(exchange,
       [rs(guarded, [atom(got, [sgn(y, 2)])], [], [atom(item, [svar(x)])], []),
        rs(guarded, [atom(got, [sgn(x, 1)])], [], [atom(item, [svar(y)])], [])])]) :-
    sgn_sign(S).

procedure sgn_intro_plain(Contract).
sgn_intro_plain([S?,
    schema(exchange,
       [rs(guarded, [atom(got, [svar(y)])], [], [atom(item, [svar(x)])], []),
        rs(guarded, [atom(got, [svar(x)])], [], [atom(item, [svar(y)])], [])])]) :-
    sgn_sign(S).

% --- negative: the signed term where def:schema forbids it -----------------
% Contracts of sign and forward, each with its signed term violating one of
% the two requirements def:schema makes of it, and refused as malformed
% (check.glp, sgn_schemas): in sgn_not_added forward requires
% item(sgn(x, Alice)) at Bob, an atom not marked +; in sgn_other_role it adds
% item(sgn(x, Bob)) at Bob, and Bob requires no atom with x among its
% arguments, Alice being the role that requires item(x); in sgn_not_required
% sign adds item(sgn(x, Alice)) with x required at no role.  sgn_community
% writes sign as a cschema, so that the contract has community roles, whose
% schemas admit no signed term (Appendix D, Definition Act schema), and
% forward's is refused as outside the language.
procedure sgn_not_added(Contract).
sgn_not_added([S?,
    schema(forward,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(got, [])], [], [atom(item, [sgn(x, 1)])], [])])]) :-
    sgn_sign(S).

procedure sgn_other_role(Contract).
sgn_other_role([S?,
    schema(forward,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 2)])], [], [atom(friend, [role(1)])], [])])]) :-
    sgn_sign(S).

procedure sgn_not_required(Contract).
sgn_not_required([schema(sign,
       [rs(guarded, [atom(item, [sgn(x, 1)])], [], [], [])])]).

% --- the signed term of a role that does not guard --------------------------
% forward(Alice, Bob; x) :  item(x), +sent(x, Bob)    friend(Alice), +item(sgn(x, Alice))
% over sign, with neither role guarding.  The signed term's role, Alice,
% requires item(x), an atom with x among its arguments, so def:schema admits
% it whether or not Alice guards; as GSNP's deliver, the leader's forward,
% which no agent wills.  The contract is not malformed; it has no
% introductory act.
procedure sgn_unguarded_signer(Contract).
sgn_unguarded_signer([S?,
    schema(forward,
       [rs(unguarded, [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [], [atom(friend, [role(1)])], [])])]) :-
    sgn_sign(S).

procedure sgn_community(Contract).
sgn_community([cschema(sign, [], [rs(guarded, [atom(item, [svar(x)])], [], [], [])]),
    schema(forward,
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [], [atom(friend, [role(1)])], [])])]).

% --- negative: a signed speech act from an untraceable record --------------
% note(p?; x, u) : +tagged(x, u)      tag(p?; x, u) : tagged(x, u), +item(sgn(x, p))
% over the social graph with items.  The case of sg_svar_loose with the item
% tag adds signed: u is named by no atom note requires, so tagged loses
% traceable provenance; the x of tag's signed term occurs in a required atom,
% tagged(x, u), but in none of traceable provenance, so item loses it under
% the clause of def:grounded on speech-act variables, a signed term counting
% as its two arguments, and sent after it.  Befriend stays unobstructed and
% every schema satisfies volition.
procedure sg_sgn_loose(Contract).
sg_sgn_loose(C?) :-
    sg_items(S),
    contract_app(S?,
      [schema(note,
         [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
       schema(tag,
         [rs(guarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(tagged, [svar(x), pvar(u)])], [])])], C).

% ===========================================================================
% Contracts with wards (Appendix F; the commit 00319cd)
% ===========================================================================

% --- wd: children and their parents ---------------------------------------
% The schemas Appendix F describes, in the term form, and nothing else:
% establish gives a person an identity; enter makes r the child of p, adding
% child, identity and parent(p) at r, who had no identity, and parenting(r) at
% p, who has one and is no child; of_age deletes the four together; befriend
% is for the unsupervised, forbidding child at both roles; unfriend is one
% schema per role; child_adult_befriend is the relay act of a child and an
% adult, the child's parent its guardian role, and child_befriend that of two
% children with their two parents, each required to be the friend of the
% other, friend being reflexive.  The guardianship for child is (child,
% identity, parent, parenting); befriend is unobstructed but for {child}; and
% wd has an introduction with wards (def:introduction-wards).  It is not
% syntactically grassroots: establish forbids the identity befriend requires,
% so clause 1 of def:unobstructed fails, and enter adds the child befriend
% forbids at a binding that gives the other party no role, so clause 2 fails.
% Each fixture below changes it in one place and fails one clause of one
% definition of Appendix F, its comment naming which.
procedure wd_establish(Schema).
wd_establish(schema(establish,
    [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])])).

procedure wd_enter(Schema).
wd_enter(schema(enter,
    [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                 [atom(identity, [])], [atom(child, [])]),
     rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                  atom(friend, [role(1)])], [], [], [atom(identity, [])])])).

procedure wd_of_age(Schema).
wd_of_age(schema(of_age,
    [rs(guarded,   [], [atom(parenting, [role(2)])], [atom(identity, [])], []),
     rs(unguarded, [], [atom(parent, [role(1)]), atom(child, [])],
                   [atom(identity, [])], [])])).

procedure wd_befriend(Schema).
wd_befriend(schema(befriend,
    [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                 [atom(child, []), atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(friend, [role(1)])])])).

procedure wd_unfriends(Contract).
wd_unfriends([schema(unfriend_p,
       [rs(guarded,   [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
     schema(unfriend_q,
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(guarded,   [], [atom(friend, [role(1)])], [atom(identity, [])], [])])]).

procedure wd_child_adult(Schema).
wd_child_adult(schema(child_adult_befriend,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 [atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(friend, [role(1)])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                 [atom(child, [])])])).

procedure wd_child_child(Schema).
wd_child_child(schema(child_befriend,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 [atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(4)])],
                 [atom(friend, [role(1)])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                 [atom(child, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(2)]), atom(friend, [role(3)])],
                 [atom(child, [])])])).

% wd_with(Establish, Enter, OfAge, Befriend, Rest, C): the contract from its
% parts, the two unfriend schemas before Rest.
procedure wd_with(Schema?, Schema?, Schema?, Schema?, Contract?, Declared).
wd_with(E, N, O, B, Rest, reflexive([friend], [E?, N?, O?, B?|C?])) :- ground(Rest?) |
    wd_unfriends(U),
    contract_app(U?, Rest?, C).

procedure wd(Declared).
wd(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?, [A?, K?], C).

% --- negative, def:guardianship ---------------------------------------------
% wd_iota_deleted, clause 1: forget(p?) : identity, -identity deletes the
% identity mark.  wd_no_iota, clause 2: adopt(p?, r?) adds child at r without
% adding and forbidding identity there.  wd_no_g, clause 3: enter adds child at
% r and no parent atom.  wd_no_w, clause 4: enter adds parent(p) at r and no
% parenting(r) at p.  wd_sigma_marked, clause 4: enter's p does not forbid
% child.  wd_del_half, clause 4: of_age deletes parent(p) at r and not
% parenting(r) at p.  Each leaves child no guardianship, so wd has no
% introduction with wards.
procedure wd_iota_deleted(Declared).
wd_iota_deleted(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [A?, K?, schema(forget, [rs(guarded, [], [atom(identity, [])], [], [])])], C).

procedure wd_no_iota(Declared).
wd_no_iota(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [A?, K?,
             schema(adopt,
               [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                            [atom(identity, [])], [atom(child, [])]),
                rs(guarded, [atom(parent, [role(1)]), atom(child, []), atom(friend, [role(1)])], [],
                            [atom(identity, [])], [atom(child, [])])])], C).

procedure wd_no_g(Declared).
wd_no_g(C?) :-
    wd_establish(E), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?,
            schema(enter,
              [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                           [atom(identity, [])], [atom(child, [])]),
               rs(guarded, [atom(identity, []), atom(child, []), atom(friend, [role(1)])], [],
                           [], [atom(identity, [])])]),
            O?, B?, [A?, K?], C).

procedure wd_no_w(Declared).
wd_no_w(C?) :-
    wd_establish(E), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?,
            schema(enter,
              [rs(guarded, [atom(friend, [role(2)])], [],
                           [atom(identity, [])], [atom(child, [])]),
               rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                            atom(friend, [role(1)])], [], [], [atom(identity, [])])]),
            O?, B?, [A?, K?], C).

procedure wd_sigma_marked(Declared).
wd_sigma_marked(C?) :-
    wd_establish(E), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?,
            schema(enter,
              [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                           [atom(identity, [])], []),
               rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                            atom(friend, [role(1)])], [], [], [atom(identity, [])])]),
            O?, B?, [A?, K?], C).

procedure wd_del_half(Declared).
wd_del_half(C?) :-
    wd_establish(E), wd_enter(N), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?,
            schema(of_age,
              [rs(guarded,   [atom(released, [role(2)])], [], [atom(identity, [])], []),
               rs(unguarded, [], [atom(parent, [role(1)]), atom(child, [])],
                             [atom(identity, [])], [])]),
            B?, [A?, K?], C).

% --- negative, def:unobstructed-marks ---------------------------------------
% The guardianship stands, and befriend fails: wd_req_unsupplied, clause 1,
% befriend requires vetted at both roles, which vet(p?) : identity, +vetted
% adds while requiring identity; wd_forb_other, clause 2, befriend forbids
% blocked(q) at p and blocked(p) at q, neither a mark nor the atom it adds;
% wd_asymmetric, clause 3, follow(p?, q) adds friend(q) at p, q a friend of p
% already, and no friend(p) at q; wd_two_atoms, befriend adds met with
% friend(q) at p, two atoms at a role.
procedure wd_req_unsupplied(Declared).
wd_req_unsupplied(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?,
            schema(befriend,
              [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(vetted, [])],
                           [atom(child, []), atom(friend, [role(2)])]),
               rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(vetted, [])],
                           [atom(child, []), atom(friend, [role(1)])])]),
            [A?, K?, schema(vet, [rs(guarded, [atom(vetted, [])], [], [atom(identity, [])], [])])],
            C).

procedure wd_forb_other(Declared).
wd_forb_other(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?,
            schema(befriend,
              [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                           [atom(child, []), atom(friend, [role(2)]), atom(blocked, [role(2)])]),
               rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                           [atom(child, []), atom(friend, [role(1)]), atom(blocked, [role(1)])])]),
            [A?, K?], C).

procedure wd_asymmetric(Declared).
wd_asymmetric(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [A?, K?,
             schema(follow,
               [rs(guarded,   [atom(friend, [role(2)])], [], [atom(identity, [])], []),
                rs(unguarded, [atom(followed, [role(1)])], [],
                              [atom(identity, []), atom(friend, [role(1)])], [])])], C).

procedure wd_two_atoms(Declared).
wd_two_atoms(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?,
            schema(befriend,
              [rs(guarded, [atom(friend, [role(2)]), atom(met, [])], [], [atom(identity, [])],
                           [atom(child, []), atom(friend, [role(2)])]),
               rs(guarded, [atom(friend, [role(1)]), atom(met, [])], [], [atom(identity, [])],
                           [atom(child, []), atom(friend, [role(1)])])]),
            [A?, K?], C).

% --- negative, def:relay ---------------------------------------------------
% The guardianship and befriend stand, and a relay act is missing or broken:
% wd_no_adult_relay has no child_adult_befriend, so no relay act with a ward
% role of child and a free role; wd_no_child_relay has no child_befriend, so
% none with two ward roles of child; wd_relay_extra_role, clause 1, gives
% child_adult_befriend a fourth role, a witness who is a friend of the child,
% neither a party nor a guardian role; wd_relay_guard_names, clause 1, has child_befriend's parent p
% add coapproved(q), naming the other guardian role; wd_relay_req, clause 2,
% has the adult of child_adult_befriend require parent(p), none of the atoms
% a free role may require; wd_relay_forb, clause 3, has its parent forbid
% friend(a), which a guardian role may not; wd_relay_unguarded leaves its
% adult's role without the mark ?, so that the two are no parties.
procedure wd_no_adult_relay(Declared).
wd_no_adult_relay(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?, [K?], C).

procedure wd_no_child_relay(Declared).
wd_no_child_relay(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_adult(A),
    wd_with(E?, N?, O?, B?, [A?], C).

procedure wd_relay_extra_role(Declared).
wd_relay_extra_role(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend,
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            [atom(friend, [role(2)])]),
                rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                            [atom(child, []), atom(friend, [role(1)])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, [])]),
                rs(unguarded, [atom(witnessed, [role(1)])], [],
                              [atom(identity, []), atom(friend, [role(1)])], [])]),
             K?], C).

procedure wd_relay_guard_names(Declared).
wd_relay_guard_names(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_adult(A),
    wd_with(E?, N?, O?, B?,
            [A?,
             schema(child_befriend,
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            [atom(friend, [role(2)])]),
                rs(guarded, [atom(friend, [role(1)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(4)])],
                            [atom(friend, [role(1)])]),
                rs(guarded, [atom(approval, []), atom(coapproved, [role(4)])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                            [atom(child, [])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(2)]), atom(friend, [role(3)])],
                            [atom(child, [])])])], C).

procedure wd_relay_req(Declared).
wd_relay_req(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend,
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            [atom(friend, [role(2)])]),
                rs(guarded, [atom(friend, [role(1)])], [],
                            [atom(identity, []), atom(parent, [role(3)])],
                            [atom(child, []), atom(friend, [role(1)])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, [])])]),
             K?], C).

procedure wd_relay_forb(Declared).
wd_relay_forb(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend,
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            [atom(friend, [role(2)])]),
                rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                            [atom(child, []), atom(friend, [role(1)])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, []), atom(friend, [role(2)])])]),
             K?], C).

procedure wd_relay_unguarded(Declared).
wd_relay_unguarded(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend,
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            [atom(friend, [role(2)])]),
                rs(unguarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                              [atom(child, []), atom(friend, [role(1)])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, [])])]),
             K?], C).

% --- wd2: children and AI agents, two marks --------------------------------
% wd with AI agents and their principals besides: enter_agent makes r the
% agent of p, adding agent, identity and principal(p) at r and
% principal_of(r) at p; agent_person_befriend is the relay act of an agent
% and a person, agents_befriend that of two agents, and child_agent_befriend
% that of a child and an agent, their parent and principal the guardian
% roles.  Every role that must be no ward forbids both marks, enter's parent
% included, as clause 4 of def:guardianship asks of the role that gives a
% ward its guardian.  M is {child, agent}, with a guardianship for each, and
% the relay acts of every pair: child with a free role, child with child,
% child with agent, agent with a free role, agent with agent.
% wd_two_marks adds enter_hybrid, which makes r the child and the agent of p
% at once, adding both marks at one role: clause 1 of def:guardianship then
% fails for {child, agent}, and for {child} or {agent} alone befriend forbids
% the other mark, which clause 2 of def:unobstructed-marks allows only of a
% mark in M.
procedure wd2_establish(Schema).
wd2_establish(schema(establish,
    [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])])).

procedure wd2_enter(Schema).
wd2_enter(schema(enter,
    [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                 [atom(identity, [])], [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                  atom(friend, [role(1)])], [], [], [atom(identity, [])])])).

procedure wd2_enter_agent(Schema).
wd2_enter_agent(schema(enter_agent,
    [rs(guarded, [atom(principal_of, [role(2)]), atom(friend, [role(2)])], [],
                 [atom(identity, [])], [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(identity, []), atom(principal, [role(1)]), atom(agent, []),
                  atom(friend, [role(1)])], [], [], [atom(identity, [])])])).

procedure wd2_befriend(Schema).
wd2_befriend(schema(befriend,
    [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, []), atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, []), atom(friend, [role(1)])])])).

procedure wd2_child_adult(Schema).
wd2_child_adult(schema(child_adult_befriend,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 [atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, []), atom(friend, [role(1)])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                 [atom(child, [])])])).

procedure wd2_agent_person(Schema).
wd2_agent_person(schema(agent_person_befriend,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(3)])],
                 [atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, []), atom(friend, [role(1)])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(1)]), atom(friend, [role(2)])],
                 [atom(agent, [])])])).

procedure wd2_agents(Schema).
wd2_agents(schema(agents_befriend,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(3)])],
                 [atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(4)])],
                 [atom(friend, [role(1)])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(1)]), atom(friend, [role(4)])],
                 [atom(agent, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(2)]), atom(friend, [role(3)])],
                 [atom(agent, [])])])).

procedure wd2_child_agent(Schema).
wd2_child_agent(schema(child_agent_befriend,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 [atom(friend, [role(2)])]),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(4)])],
                 [atom(friend, [role(1)])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                 [atom(child, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(2)]), atom(friend, [role(3)])],
                 [atom(agent, [])])])).

procedure wd2_with(Contract?, Declared).
wd2_with(Rest, reflexive([friend], [E?, N?, NA?, O?, B?|C?])) :- ground(Rest?) |
    wd2_establish(E), wd2_enter(N), wd2_enter_agent(NA), wd_of_age(O), wd2_befriend(B),
    wd_unfriends(U),
    wd2_child_adult(A), wd_child_child(K), wd2_child_agent(CA), wd2_agent_person(AP),
    wd2_agents(AA),
    contract_app([A?, K?, CA?, AP?, AA?], Rest?, R),
    contract_app(U?, R?, C).

procedure wd2(Declared).
wd2(C?) :- wd2_with([], C).

procedure wd_two_marks(Declared).
wd_two_marks(C?) :-
    wd2_with([schema(enter_hybrid,
       [rs(guarded, [atom(parenting, [role(2)]), atom(principal_of, [role(2)]),
                     atom(friend, [role(2)])], [],
                    [atom(identity, [])], [atom(child, []), atom(agent, [])]),
        rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(principal, [role(1)]),
                     atom(child, []), atom(agent, []), atom(friend, [role(1)])], [],
                    [], [atom(identity, [])])])], C).
