% A fixture that is a contract changed in one place, by name and the contract
% it changes, which test_gsc.sh reads from the owner's file: GSG's or GSNP's
% for sg_* and sn_*, GKK's for gkk_* (sg_plain's for sg_tri_cschema, GSC's language admitting
% no signed term).  An unknown name is the empty contract.
exported procedure variant(Constant?, WContract?, WDeclared).
variant(sg_imposed, S, C?) :- sg_imposed(S?, C).
variant(sg_gossip, S, C?) :- sg_gossip(S?, C).
variant(sg_chain, S, C?) :- sg_chain(S?, C).
variant(sg_chain_cut, S, C?) :- sg_chain_cut(S?, C).
variant(sg_tri, S, C?) :- sg_tri(S?, C).
variant(sg_tri_cschema, S, C?) :- sg_tri_cschema(S?, C).
variant(sg_svar_loose, S, C?) :- sg_svar_loose(S?, C).
variant(sg_reflexive, S, C?) :- sg_reflexive(S?, C).
variant(sg_refl_malformed, S, C?) :- sg_refl_malformed(S?, C).
variant(sg_inert_role, S, C?) :- sg_inert_role(S?, C).
variant(sg_inert_schema, S, C?) :- sg_inert_schema(S?, C).
variant(sg_added_deleted, S, C?) :- sg_added_deleted(S?, C).
variant(sg_self_required, S, C?) :- sg_self_required(S?, C).
variant(sg_refl_required, S, C?) :- sg_refl_required(S?, C).
variant(sg_refl_forbidden, S, C?) :- sg_refl_forbidden(S?, C).
variant(sn_listed_forbidden, S, C?) :- sn_listed_forbidden(S?, C).
variant(sn_listed_witness, S, C?) :- sn_listed_witness(S?, C).
variant(sn_listed_guard, S, C?) :- sn_listed_guard(S?, C).
variant(sn_listed_inert, S, C?) :- sn_listed_inert(S?, C).
variant(gkk_intro_joined, S, C?) :- gkk_intro_joined(S?, C).
variant(gkk_intro_unjoined, S, C?) :- gkk_intro_unjoined(S?, C).
variant(gkk_intro_loose, S, C?) :- gkk_intro_loose(S?, C).
variant(_, _, []) :- otherwise | true.

% --- the speech-act variables of def:grounded -----------------------------
% Four small contracts of agent roles, some with a name term or a schema
% written cschema.  The first requirement of def:grounded asks after the
% arguments of an added atom outside Y, the second after every speech-act
% variable that is an argument of it or occurs in a name term among its
% arguments.
%
% sign(p?; x) : +item(x, p)        take(p?, q) : +got(q)    item(z, p), +mark(q)
% x is a speech-act variable, so only the second clause asks after it, and it
% occurs in no atom sign requires: item has traceable provenance, and the item
% take's second role requires, naming the first, joins take's role graph.
procedure sv_take(Contract).
sv_take([schema(take, [svar(z)],
       [rs(guarded,   [atom(got, [role(2)])], [], [], []),
        rs(unguarded, [atom(mark, [role(2)])], [],
                      [atom(item, [svar(z), role(1)])], [])])]).

procedure sv_signed(Contract).
sv_signed(C?) :-
    sv_take(T),
    contract_app([cschema(sign, [svar(x)], [],
       [rs(guarded, [atom(item, [svar(x), role(1)])], [], [], [])])], T?, C).

% --- negative: the same speech act carried from an untraceable record ------
% note(p?; x, u) : +tagged(x, u)      tag(p?; x, u) : tagged(x, u), +item(x, p)
% The case of sg_svar_loose, written with a cschema.  u is named by no
% atom note requires, so tagged loses traceable provenance; the x of the item
% tag adds occurs in tagged(x, u), which tag requires, and in no required atom
% of traceable provenance, so the second clause drops item, and take loses the
% edge it rested on.
procedure sv_loose(Contract).
sv_loose(C?) :-
    sv_signed(S),
    contract_app(S?,
      [schema(note, [svar(x), pvar(u)],
         [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
       schema(tag, [svar(x), pvar(u)],
         [rs(guarded, [atom(item, [svar(x), role(1)])], [],
                      [atom(tagged, [svar(x), pvar(u)])], [])])], C).

% --- negative: a speech act in a name term, from an untraceable record -----
% note(p?; x, u) : +tagged(x, u)    found(p?; x, u) : tagged(x, u), +club(<p>.x)
% The x in the name term of the club atom found adds occurs in tagged(x, u),
% which found requires, and in no required atom of traceable provenance, so
% the second clause drops club.
procedure sv_in_name_loose(Contract).
sv_in_name_loose([cschema(note, [svar(x), pvar(u)], [],
       [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
     schema(found, [svar(x), pvar(u)],
       [rs(guarded, [atom(club, [nterm(ext(own(1), x))])], [],
                    [atom(tagged, [svar(x), pvar(u)])], [])])]).

% --- a speech act carried from a name term of a required atom --------------
% found(p?; x) : +club(<p>.x)        cite(p?; x) : club(<p>.x), +cited(x)
% The x that cite adds occurs in a name term among the arguments of
% club(<p>.x), which cite requires and which has traceable provenance, so the
% second clause keeps cited.
procedure sv_in_name_carried(Contract).
sv_in_name_carried([cschema(found, [svar(x)], [],
       [rs(guarded, [atom(club, [nterm(ext(own(1), x))])], [], [], [])]),
     schema(cite, [svar(x)],
       [rs(guarded, [atom(cited, [svar(x)])], [],
                    [atom(club, [nterm(ext(own(1), x))])], [])])]).

% ===========================================================================
% A name term based on an agent variable, which def:role does not admit
% ===========================================================================
% establish(p?) : +identity
% befriend(p?, q?) : identity, not friend(q), +friend(q)   identity, not friend(p), +friend(p)
% tag(p? ; q, y) : identity, friend(q), +tagged(<q>.y)
% <q>.y is based on the agent variable q, no agent role of tag, so it is no
% name term of def:role and the contract is malformed:
% name_term_base(tag, ext(own_var(q), y)).  nn_tag_loose is the same with tag
% requiring no friend(q), and is malformed alike.
procedure nn_social(Contract).
nn_social([schema(establish, [], [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(befriend, [],
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])], [atom(friend, [role(1)])])])]).

procedure nn_tag(Contract).
nn_tag(C?) :-
    nn_social(S),
    contract_app(S?,
      [schema(tag, [pvar(q), svar(y)],
         [rs(guarded, [atom(tagged, [nterm(ext(own_var(q), y))])], [],
                      [atom(identity, []), atom(friend, [pvar(q)])], [])])], C).

procedure nn_tag_loose(Contract).
nn_tag_loose(C?) :-
    nn_social(S),
    contract_app(S?,
      [schema(tag, [pvar(q), svar(y)],
         [rs(guarded, [atom(tagged, [nterm(ext(own_var(q), y))])], [],
                      [atom(identity, [])], [])])], C).

% ===========================================================================
% The signed speech-act term (Sections 3.1 to 3.3; the commit 63b301f)
% ===========================================================================

% --- the social graph with items --------------------------------------------
% The social graph with items of arity one, without identity and groups:
% sign(Alice?; x) adds item(x), and forward(Alice?, Bob; x) requires item(x)
% at Alice, adds sent(x, Bob) there, and adds item(sgn(x, Alice)) at Bob,
% where friend(Alice) is required.  The checker's fixture, the base of
% sg_sgn_loose below; the network with provenance is GSNP, GAI's contract,
% programs/gai/GSNP.glp, which test_gsc.sh reads.
procedure sg_items(Contract).
sg_items([schema(befriend, [],
       [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
    schema(unfriend, [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
    schema(sign, [svar(x)],
       [rs(guarded, [atom(item, [svar(x)])], [], [], [])]),
    schema(forward, [svar(x)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(friend, [role(1)])], [])])]).

% --- an introduction through the signed term alone -------------------------
% exchange(Alice?, Bob?; x, y) :  item(x), +got(sgn(y, Bob))    item(y), +got(sgn(x, Alice))
% over sign.  Each role adds an atom naming the other only as the role of its
% signed term (Section 3.1, what an atom names), so
% exchange is an introductory act (def:introduction); it is unobstructed, the
% item each role requires being added by sign, of arity one, guarded,
% requiring and forbidding nothing (clause 1 of def:unobstructed); got has
% traceable provenance, y being an argument of the item Bob requires
% (def:grounded); and the contract is syntactically grassroots.
% sgn_intro_plain is the same with got(y) and got(x) in place of the signed
% terms: an added atom then names a speech-act variable and not the other
% party, and the contract has no introductory act.
procedure sgn_sign(Schema).
sgn_sign(schema(sign, [svar(x)], [rs(guarded, [atom(item, [svar(x)])], [], [], [])])).

procedure sgn_intro(Contract).
sgn_intro([S?,
    schema(exchange, [svar(x), svar(y)],
       [rs(guarded, [atom(got, [sgn(y, 2)])], [], [atom(item, [svar(x)])], []),
        rs(guarded, [atom(got, [sgn(x, 1)])], [], [atom(item, [svar(y)])], [])])]) :-
    sgn_sign(S).

procedure sgn_intro_plain(Contract).
sgn_intro_plain([S?,
    schema(exchange, [svar(x), svar(y)],
       [rs(guarded, [atom(got, [svar(y)])], [], [atom(item, [svar(x)])], []),
        rs(guarded, [atom(got, [svar(x)])], [], [atom(item, [svar(y)])], [])])]) :-
    sgn_sign(S).

% --- negative: the signed term where GAI's Definition Speech-act schema forbids it
% Contracts of sign and forward, each with its signed term violating one of
% the two requirements GAI's Definition Speech-act schema makes of it, and refused
% as malformed
% (check.glp, sgn_schemas): in sgn_not_added forward requires
% item(sgn(x, Alice)) at Bob, an atom not marked +; in sgn_other_role it adds
% item(sgn(x, Bob)) at Bob, and Bob requires no atom with x among its
% arguments, Alice being the role that requires item(x); in sgn_not_required
% sign adds item(sgn(x, Alice)) with x required at no role.  sgn_community
% writes sign as a cschema, so that the contract has community roles, its
% signed term of an agent role meeting both requirements, and is admitted.
procedure sgn_not_added(Contract).
sgn_not_added([S?,
    schema(forward, [svar(x)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(got, [])], [], [atom(item, [sgn(x, 1)])], [])])]) :-
    sgn_sign(S).

procedure sgn_other_role(Contract).
sgn_other_role([S?,
    schema(forward, [svar(x)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 2)])], [], [atom(friend, [role(1)])], [])])]) :-
    sgn_sign(S).

procedure sgn_not_required(Contract).
sgn_not_required([schema(sign, [svar(x)],
       [rs(guarded, [atom(item, [sgn(x, 1)])], [], [], [])])]).

% --- the signed term of a role that does not guard --------------------------
% forward(Alice, Bob; x) :  item(x), +sent(x, Bob)    friend(Alice), +item(sgn(x, Alice))
% over sign, with neither role guarding.  The signed term's role, Alice,
% requires item(x), an atom with x among its arguments, so def:schema admits
% it whether or not Alice guards; as GSNP's deliver, the leader's forward,
% which no agent wills.  The contract is not malformed; it has no
% introductory act.
procedure sgn_unguarded_signer(Contract).
sgn_unguarded_signer([S?,
    schema(forward, [svar(x)],
       [rs(unguarded, [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [], [atom(friend, [role(1)])], [])])]) :-
    sgn_sign(S).

procedure sgn_community(Contract).
sgn_community([cschema(sign, [svar(x)], [], [rs(guarded, [atom(item, [svar(x)])], [], [], [])]),
    schema(forward, [svar(x)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [], [atom(item, [svar(x)])], []),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [], [atom(friend, [role(1)])], [])])]).

% --- negative: a signed speech act from an untraceable record --------------
% note(p?; x, u) : +tagged(x, u)      tag(p?; x, u) : tagged(x, u), +item(sgn(x, p))
% over the social graph with items.  The case of sg_svar_loose with the item
% tag adds signed: u is named by no atom note requires, so tagged loses
% traceable provenance; the x of tag's signed term occurs in a required atom,
% tagged(x, u), but in none of traceable provenance, so item loses it under
% the clause of def:grounded on speech-act variables, a signed term counting
% as its two arguments, and sent after it.  Befriend stays unobstructed and
% every schema satisfies volition.
procedure sg_sgn_loose(Contract).
sg_sgn_loose(C?) :-
    sg_items(S),
    contract_app(S?,
      [schema(note, [svar(x), pvar(u)],
         [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
       schema(tag, [svar(x), pvar(u)],
         [rs(guarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(tagged, [svar(x), pvar(u)])], [])])], C).

% ===========================================================================
% Contracts with wards (GAI's appendix "Contracts with Wards", GSC's Appendix F
% until GSC 83b951c; the commit 00319cd)
% ===========================================================================

% --- wd: children and their parents ---------------------------------------
% The schemas GAI's appendix describes, in the term form, and nothing else:
% establish gives a person an identity; enter makes r the child of p, adding
% child, identity and parent(p) at r, who had no identity, and parenting(r) at
% p, who has one and is no child; of_age deletes the four together; befriend
% is for the unsupervised, forbidding child at both roles; unfriend is one
% schema per role; child_adult_befriend is the relay act of a child and an
% adult, the child's parent its guardian role, and child_befriend that of two
% children with their two parents, each required to be the friend of the
% other, friend being reflexive.  befriend and the relay acts forbid nothing
% of friend, the introduction predicate: def:unobstructed-marks and def:relay
% admit at a role only a mark in M or a leaving mark among the atoms forbidden
% (GAI ddf0a33), so friend is a multiset, as GKK's knows is.  The guardianship for child is (child,
% identity, parent, parenting); befriend is unobstructed but for {child}; and
% wd has an introduction with wards (def:introduction-wards).  It is not
% syntactically grassroots: establish forbids the identity it adds, which
% clause 1 of def:unobstructed admits (GSC b2bb8be), but enter adds the child
% befriend and enter forbid at a binding that gives the other party no role,
% so clause 2 fails.
% Each fixture below changes it in one place and fails one clause of one
% definition of GAI's appendix, its comment naming which.
procedure wd_establish(Schema).
wd_establish(schema(establish, [],
    [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])])).

procedure wd_enter(Schema).
wd_enter(schema(enter, [],
    [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                 [atom(identity, [])], [atom(child, [])]),
     rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                  atom(friend, [role(1)])], [], [], [atom(identity, [])])])).

procedure wd_of_age(Schema).
wd_of_age(schema(of_age, [],
    [rs(guarded,   [], [atom(parenting, [role(2)])], [atom(identity, [])], []),
     rs(unguarded, [], [atom(parent, [role(1)]), atom(child, [])],
                   [atom(identity, [])], [])])).

procedure wd_befriend(Schema).
wd_befriend(schema(befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                 [atom(child, [])]),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, [])])])).

procedure wd_unfriends(Contract).
wd_unfriends([schema(unfriend_p, [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
     schema(unfriend_q, [],
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(guarded,   [], [atom(friend, [role(1)])], [atom(identity, [])], [])])]).

procedure wd_child_adult(Schema).
wd_child_adult(schema(child_adult_befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                 [atom(child, [])])])).

procedure wd_child_child(Schema).
wd_child_child(schema(child_befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(4)])],
                 []),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                 [atom(child, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(2)]), atom(friend, [role(3)])],
                 [atom(child, [])])])).

% wd_with(Establish, Enter, OfAge, Befriend, Rest, C): the contract from its
% parts, the two unfriend schemas before Rest.
procedure wd_with(Schema?, Schema?, Schema?, Schema?, Contract?, Declared).
wd_with(E, N, O, B, Rest, reflexive([friend], [E?, N?, O?, B?|C?])) :- ground(Rest?) |
    wd_unfriends(U),
    contract_app(U?, Rest?, C).

procedure wd(Declared).
wd(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?, [A?, K?], C).

% --- negative, def:guardianship ---------------------------------------------
% wd_iota_deleted, clause 1: forget(p?) : identity, -identity deletes the
% identity mark.  wd_no_iota, clause 2: adopt(p?, r?) adds child at r without
% adding and forbidding identity there.  wd_no_g, clause 3: enter adds child at
% r and no parent atom.  wd_no_w, clause 4: enter adds parent(p) at r and no
% parenting(r) at p.  wd_sigma_marked, clause 4: enter's p does not forbid
% child.  wd_del_half, clause 4: of_age deletes parent(p) at r and not
% parenting(r) at p.  Each leaves child no guardianship, so wd has no
% introduction with wards.
procedure wd_iota_deleted(Declared).
wd_iota_deleted(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [A?, K?, schema(forget, [], [rs(guarded, [], [atom(identity, [])], [], [])])], C).

procedure wd_no_iota(Declared).
wd_no_iota(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [A?, K?,
             schema(adopt, [],
               [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                            [atom(identity, [])], [atom(child, [])]),
                rs(guarded, [atom(parent, [role(1)]), atom(child, []), atom(friend, [role(1)])], [],
                            [atom(identity, [])], [atom(child, [])])])], C).

procedure wd_no_g(Declared).
wd_no_g(C?) :-
    wd_establish(E), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?,
            schema(enter, [],
              [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                           [atom(identity, [])], [atom(child, [])]),
               rs(guarded, [atom(identity, []), atom(child, []), atom(friend, [role(1)])], [],
                           [], [atom(identity, [])])]),
            O?, B?, [A?, K?], C).

procedure wd_no_w(Declared).
wd_no_w(C?) :-
    wd_establish(E), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?,
            schema(enter, [],
              [rs(guarded, [atom(friend, [role(2)])], [],
                           [atom(identity, [])], [atom(child, [])]),
               rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                            atom(friend, [role(1)])], [], [], [atom(identity, [])])]),
            O?, B?, [A?, K?], C).

procedure wd_sigma_marked(Declared).
wd_sigma_marked(C?) :-
    wd_establish(E), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?,
            schema(enter, [],
              [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                           [atom(identity, [])], []),
               rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                            atom(friend, [role(1)])], [], [], [atom(identity, [])])]),
            O?, B?, [A?, K?], C).

procedure wd_del_half(Declared).
wd_del_half(C?) :-
    wd_establish(E), wd_enter(N), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?,
            schema(of_age, [],
              [rs(guarded,   [atom(released, [role(2)])], [], [atom(identity, [])], []),
               rs(unguarded, [], [atom(parent, [role(1)]), atom(child, [])],
                             [atom(identity, [])], [])]),
            B?, [A?, K?], C).

% --- def:unobstructed-marks --------------------------------------------------
% Two clauses at GAI ddf0a33.  The guardianship stands, and befriend fails:
% wd_req_unsupplied, clause 1, befriend requires vetted at both roles, which
% vet(p?) : identity, +vetted adds while requiring identity; wd_forb_other,
% clause 2, befriend forbids blocked(q) at p and blocked(p) at q, neither a
% mark in M nor a leaving mark; wd_forb_added, clause 2, befriend forbids the
% friend atom it adds, which the clause admitted until GAI ddf0a33 and admits
% no longer; wd_two_atoms, befriend adds met with friend(q) at p, two atoms
% at a role.  The clause on the symmetry of e is gone (GAI ddf0a33), and two
% fixtures it refused are admitted: wd_asymmetric, follow(p?, q) adds
% friend(q) at p, q a friend of p already, and no friend(p) at q; and
% wd_introduce, introduce(p?, q? ; c) adds friend(c) at q, c an agent
% variable, at a role that forbids no mark.
procedure wd_req_unsupplied(Declared).
wd_req_unsupplied(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?,
            schema(befriend, [],
              [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(vetted, [])],
                           [atom(child, [])]),
               rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(vetted, [])],
                           [atom(child, [])])]),
            [A?, K?, schema(vet, [], [rs(guarded, [atom(vetted, [])], [], [atom(identity, [])], [])])],
            C).

procedure wd_forb_other(Declared).
wd_forb_other(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?,
            schema(befriend, [],
              [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                           [atom(child, []), atom(blocked, [role(2)])]),
               rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                           [atom(child, []), atom(blocked, [role(1)])])]),
            [A?, K?], C).

procedure wd_asymmetric(Declared).
wd_asymmetric(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [A?, K?,
             schema(follow, [],
               [rs(guarded,   [atom(friend, [role(2)])], [], [atom(identity, [])], []),
                rs(unguarded, [atom(followed, [role(1)])], [],
                              [atom(identity, []), atom(friend, [role(1)])], [])])], C).

procedure wd_forb_added(Declared).
wd_forb_added(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?,
            schema(befriend, [],
              [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                           [atom(child, []), atom(friend, [role(2)])]),
               rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                           [atom(child, []), atom(friend, [role(1)])])]),
            [A?, K?], C).

procedure wd_introduce(Declared).
wd_introduce(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [A?, K?,
             schema(introduce, [pvar(c)],
               [rs(guarded, [], [],
                            [atom(identity, []), atom(friend, [role(2)]), atom(friend, [pvar(c)])],
                            [atom(child, [])]),
                rs(guarded, [atom(friend, [pvar(c)])], [],
                            [atom(identity, []), atom(friend, [role(1)])], [])])], C).

procedure wd_two_atoms(Declared).
wd_two_atoms(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O),
    wd_child_adult(A), wd_child_child(K),
    wd_with(E?, N?, O?,
            schema(befriend, [],
              [rs(guarded, [atom(friend, [role(2)]), atom(met, [])], [], [atom(identity, [])],
                           [atom(child, [])]),
               rs(guarded, [atom(friend, [role(1)]), atom(met, [])], [], [atom(identity, [])],
                           [atom(child, [])])]),
            [A?, K?], C).

% --- negative, def:relay ---------------------------------------------------
% The guardianship and befriend stand, and a relay act is missing or broken:
% wd_no_adult_relay has no child_adult_befriend, so no relay act with a ward
% role of child and a free role; wd_no_child_relay has no child_befriend, so
% none with two ward roles of child; wd_relay_extra_role, clause 1, gives
% child_adult_befriend a fourth role, a witness who is a friend of the child,
% neither a party nor a guardian role; wd_relay_guard_names, clause 1, has child_befriend's parent p
% add coapproved(q), naming the other guardian role; wd_relay_req, clause 2,
% has the adult of child_adult_befriend require parent(p), none of the atoms
% a free role may require; wd_relay_forb, clause 3, has its parent forbid
% friend(a), which a guardian role may not; wd_relay_unguarded leaves its
% adult's role without the mark ?, so that the two are no parties.
procedure wd_no_adult_relay(Declared).
wd_no_adult_relay(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?, [K?], C).

procedure wd_no_child_relay(Declared).
wd_no_child_relay(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_adult(A),
    wd_with(E?, N?, O?, B?, [A?], C).

procedure wd_relay_extra_role(Declared).
wd_relay_extra_role(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend, [],
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            []),
                rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                            [atom(child, [])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, [])]),
                rs(unguarded, [atom(witnessed, [role(1)])], [],
                              [atom(identity, []), atom(friend, [role(1)])], [])]),
             K?], C).

procedure wd_relay_guard_names(Declared).
wd_relay_guard_names(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_adult(A),
    wd_with(E?, N?, O?, B?,
            [A?,
             schema(child_befriend, [],
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            []),
                rs(guarded, [atom(friend, [role(1)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(4)])],
                            []),
                rs(guarded, [atom(approval, []), atom(coapproved, [role(4)])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                            [atom(child, [])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(2)]), atom(friend, [role(3)])],
                            [atom(child, [])])])], C).

procedure wd_relay_req(Declared).
wd_relay_req(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend, [],
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            []),
                rs(guarded, [atom(friend, [role(1)])], [],
                            [atom(identity, []), atom(parent, [role(3)])],
                            [atom(child, [])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, [])])]),
             K?], C).

procedure wd_relay_forb(Declared).
wd_relay_forb(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend, [],
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            []),
                rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                            [atom(child, [])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, []), atom(friend, [role(2)])])]),
             K?], C).

% wd_relay_forb_ward has child_adult_befriend's child, a ward role, forbid
% friend(a), the atom of e naming the other related role, and
% wd_relay_forb_free has its adult, a free role, forbid friend(r), the atom
% of e naming the ward: clause 3 of def:relay (GAI ddf0a33) admits at a role
% a mark in M or a leaving mark and nothing else, so each is no relay act.
procedure wd_relay_forb_at(Atoms?, Atoms?, Schema).
wd_relay_forb_at(N1, N2, schema(child_adult_befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])], N1?),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])], [atom(child, [])|N2?]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                 [atom(child, [])])])).

procedure wd_relay_forb_ward(Declared).
wd_relay_forb_ward(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_relay_forb_at([atom(friend, [role(2)])], [], A),
    wd_with(E?, N?, O?, B?, [A?, K?], C).

procedure wd_relay_forb_free(Declared).
wd_relay_forb_free(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_relay_forb_at([], [atom(friend, [role(1)])], A),
    wd_with(E?, N?, O?, B?, [A?, K?], C).

procedure wd_relay_unguarded(Declared).
wd_relay_unguarded(C?) :-
    wd_establish(E), wd_enter(N), wd_of_age(O), wd_befriend(B), wd_child_child(K),
    wd_with(E?, N?, O?, B?,
            [schema(child_adult_befriend, [],
               [rs(guarded, [atom(friend, [role(2)])], [],
                            [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                            []),
                rs(unguarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                              [atom(child, [])]),
                rs(guarded, [atom(approval, [])], [],
                            [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                            [atom(child, [])])]),
             K?], C).

% --- wd2: children and AI agents, two marks --------------------------------
% wd with AI agents and their principals besides: enter_agent makes r the
% agent of p, adding agent, identity and principal(p) at r and
% principal_of(r) at p; agent_person_befriend is the relay act of an agent
% and a person, agents_befriend that of two agents, and child_agent_befriend
% that of a child and an agent, their parent and principal the guardian
% roles.  Every role that must be no ward forbids both marks, enter's parent
% included, as clause 4 of def:guardianship asks of the role that gives a
% ward its guardian.  M is {child, agent}, with a guardianship for each, and
% the relay acts of every pair: child with a free role, child with child,
% child with agent, agent with a free role, agent with agent.
% wd_two_marks adds enter_hybrid, which makes r the child and the agent of p
% at once, adding both marks at one role: clause 1 of def:guardianship then
% fails for {child, agent}, and for {child} or {agent} alone befriend forbids
% the other mark, which clause 2 of def:unobstructed-marks allows only of a
% mark in M.
procedure wd2_establish(Schema).
wd2_establish(schema(establish, [],
    [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])])).

procedure wd2_enter(Schema).
wd2_enter(schema(enter, [],
    [rs(guarded, [atom(parenting, [role(2)]), atom(friend, [role(2)])], [],
                 [atom(identity, [])], [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(child, []),
                  atom(friend, [role(1)])], [], [], [atom(identity, [])])])).

procedure wd2_enter_agent(Schema).
wd2_enter_agent(schema(enter_agent, [],
    [rs(guarded, [atom(principal_of, [role(2)]), atom(friend, [role(2)])], [],
                 [atom(identity, [])], [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(identity, []), atom(principal, [role(1)]), atom(agent, []),
                  atom(friend, [role(1)])], [], [], [atom(identity, [])])])).

procedure wd2_befriend(Schema).
wd2_befriend(schema(befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, [])])])).

procedure wd2_child_adult(Schema).
wd2_child_adult(schema(child_adult_befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                 [atom(child, [])])])).

procedure wd2_agent_person(Schema).
wd2_agent_person(schema(agent_person_befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(3)])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                 [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(1)]), atom(friend, [role(2)])],
                 [atom(agent, [])])])).

procedure wd2_agents(Schema).
wd2_agents(schema(agents_befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(3)])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(4)])],
                 []),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(1)]), atom(friend, [role(4)])],
                 [atom(agent, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(2)]), atom(friend, [role(3)])],
                 [atom(agent, [])])])).

procedure wd2_child_agent(Schema).
wd2_child_agent(schema(child_agent_befriend, [],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(4)])],
                 []),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                 [atom(child, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(2)]), atom(friend, [role(3)])],
                 [atom(agent, [])])])).

procedure wd2_with(Contract?, Declared).
wd2_with(Rest, reflexive([friend], [E?, N?, NA?, O?, B?|C?])) :- ground(Rest?) |
    wd2_establish(E), wd2_enter(N), wd2_enter_agent(NA), wd_of_age(O), wd2_befriend(B),
    wd_unfriends(U),
    wd2_child_adult(A), wd_child_child(K), wd2_child_agent(CA), wd2_agent_person(AP),
    wd2_agents(AA),
    contract_app([A?, K?, CA?, AP?, AA?], Rest?, R),
    contract_app(U?, R?, C).

procedure wd2(Declared).
wd2(C?) :- wd2_with([], C).

procedure wd_two_marks(Declared).
wd_two_marks(C?) :-
    wd2_with([schema(enter_hybrid, [],
       [rs(guarded, [atom(parenting, [role(2)]), atom(principal_of, [role(2)]),
                     atom(friend, [role(2)])], [],
                    [atom(identity, [])], [atom(child, []), atom(agent, [])]),
        rs(guarded, [atom(identity, []), atom(parent, [role(1)]), atom(principal, [role(1)]),
                     atom(child, []), atom(agent, []), atom(friend, [role(1)])], [],
                    [], [atom(identity, [])])])], C).

% --- the atom of h (def:relay, clause 2; GSC 410a440) ----------------------
% wd_attest is wd2 with the AI agent's attestation, as GAI writes it: sign(p? ; x) : identity, +item(x); enter_agent(p?, r? ; x) requires item(x) at p and adds attestation(sgn(x, p)) at r, x signed over by p; and each relay act with a ward role of agent requires there attestation(y), y a speech-act variable of the act occurring in no other atom it requires.  enter_agent, the one schema adding agent, adds an atom of attestation there, and no schema deletes one, so clause 2 of def:relay admits attestation(y) at a ward role of agent as an atom of h, h being attestation, and wd_attest is grassroots with wards as wd2 is.  Each fixture after it changes it in one place, so that clause 2 admits an attestation a relay act requires as nothing, that relay act fails, and there is no introduction with wards: wd_attest_unadded, adopt_agent adds agent at r and no attestation; wd_attest_deleted, revoke(p?, r ; y) deletes attestation(y) at r; wd_attest_shared, agents_befriend requires attestation(y) at both agents, so y occurs in another atom it requires; wd_attest_role, agent_person_befriend requires attestation(p) at the agent, an argument that is no speech-act variable; wd_attest_child, child_adult_befriend requires attestation(y) at the child, a ward role of child, and enter, which adds child, adds no attestation; and wd_attest_free, agent_person_befriend requires attestation(y) at the person, a free role, in place of the agent.
procedure wa_sign(Schema).
wa_sign(schema(sign, [svar(x)],
    [rs(guarded, [atom(item, [svar(x)])], [], [atom(identity, [])], [])])).

procedure wa_enter_agent(Schema).
wa_enter_agent(schema(enter_agent, [svar(x)],
    [rs(guarded, [atom(principal_of, [role(2)]), atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(item, [svar(x)])], [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(identity, []), atom(principal, [role(1)]), atom(agent, []),
                  atom(friend, [role(1)]), atom(attestation, [sgn(x, 1)])], [], [],
                 [atom(identity, [])])])).

% agent_person_befriend(r?, q?, p? ; Vs), R1 the atoms it requires at the agent r besides wd2's and R2 those at the person q.
procedure wa_agent_person_at(Atoms?, Atoms?, Args?, Schema).
wa_agent_person_at(R1, R2, Vs, schema(agent_person_befriend, Vs?,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(3)])|R1?],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])|R2?],
                 [atom(child, []), atom(agent, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(1)]), atom(friend, [role(2)])],
                 [atom(agent, [])])])).

procedure wa_agent_person(Schema).
wa_agent_person(S?) :- wa_agent_person_at([atom(attestation, [svar(y)])], [], [svar(y)], S).

% agents_befriend(r?, s?, p?, q? ; Vs), requiring attestation(Y) at r and attestation(Z) at s.
procedure wa_agents_with(Arg?, Arg?, Args?, Schema).
wa_agents_with(Y, Z, Vs, schema(agents_befriend, Vs?,
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(3)]),
                  atom(attestation, [Y?])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(4)]),
                  atom(attestation, [Z?])],
                 []),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(1)]), atom(friend, [role(4)])],
                 [atom(agent, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(2)]), atom(friend, [role(3)])],
                 [atom(agent, [])])])).

procedure wa_agents(Schema).
wa_agents(S?) :- wa_agents_with(svar(y), svar(z), [svar(y), svar(z)], S).

procedure wa_child_agent(Schema).
wa_child_agent(schema(child_agent_befriend, [svar(y)],
    [rs(guarded, [atom(friend, [role(2)])], [],
                 [atom(identity, []), atom(child, []), atom(parent, [role(3)])],
                 []),
     rs(guarded, [atom(friend, [role(1)])], [],
                 [atom(identity, []), atom(agent, []), atom(principal, [role(4)]),
                  atom(attestation, [svar(y)])],
                 []),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(4)])],
                 [atom(child, [])]),
     rs(guarded, [atom(approval, [])], [],
                 [atom(identity, []), atom(principal_of, [role(2)]), atom(friend, [role(3)])],
                 [atom(agent, [])])])).

% wa_with(EnterAgent, ChildAdult, ChildAgent, AgentPerson, Agents, Rest, C): wd2 with these schemas in place of its own, sign after its relay acts, and then the schemas Rest.
procedure wa_with(Schema?, Schema?, Schema?, Schema?, Schema?, Contract?, Declared).
wa_with(NA, A, CA, AP, AA, Rest, reflexive([friend], [E?, N?, NA?, O?, B?|C?])) :-
    ground(A?), ground(CA?), ground(AP?), ground(AA?), ground(Rest?) |
    wd2_establish(E), wd2_enter(N), wd_of_age(O), wd2_befriend(B),
    wd_unfriends(U),
    wd_child_child(K), wa_sign(S),
    contract_app([A?, K?, CA?, AP?, AA?, S?], Rest?, R),
    contract_app(U?, R?, C).

procedure wd_attest(Declared).
wd_attest(C?) :-
    wa_enter_agent(NA), wd2_child_adult(A), wa_child_agent(CA), wa_agent_person(AP), wa_agents(AA),
    wa_with(NA?, A?, CA?, AP?, AA?, [], C).

procedure wd_attest_unadded(Declared).
wd_attest_unadded(C?) :-
    wa_enter_agent(NA), wd2_child_adult(A), wa_child_agent(CA), wa_agent_person(AP), wa_agents(AA),
    wa_with(NA?, A?, CA?, AP?, AA?,
      [schema(adopt_agent, [],
         [rs(guarded, [atom(principal_of, [role(2)]), atom(friend, [role(2)])], [],
                      [atom(identity, [])], [atom(child, []), atom(agent, [])]),
          rs(guarded, [atom(identity, []), atom(principal, [role(1)]), atom(agent, []),
                       atom(friend, [role(1)])], [], [], [atom(identity, [])])])], C).

procedure wd_attest_deleted(Declared).
wd_attest_deleted(C?) :-
    wa_enter_agent(NA), wd2_child_adult(A), wa_child_agent(CA), wa_agent_person(AP), wa_agents(AA),
    wa_with(NA?, A?, CA?, AP?, AA?,
      [schema(revoke, [svar(y)],
         [rs(guarded,   [], [], [atom(identity, []), atom(principal_of, [role(2)])], []),
          rs(unguarded, [], [atom(attestation, [svar(y)])], [atom(identity, [])], [])])], C).

procedure wd_attest_shared(Declared).
wd_attest_shared(C?) :-
    wa_enter_agent(NA), wd2_child_adult(A), wa_child_agent(CA), wa_agent_person(AP),
    wa_agents_with(svar(y), svar(y), [svar(y)], AA),
    wa_with(NA?, A?, CA?, AP?, AA?, [], C).

procedure wd_attest_role(Declared).
wd_attest_role(C?) :-
    wa_enter_agent(NA), wd2_child_adult(A), wa_child_agent(CA), wa_agents(AA),
    wa_agent_person_at([atom(attestation, [role(3)])], [], [], AP),
    wa_with(NA?, A?, CA?, AP?, AA?, [], C).

procedure wd_attest_child(Declared).
wd_attest_child(C?) :-
    wa_enter_agent(NA), wa_child_agent(CA), wa_agent_person(AP), wa_agents(AA),
    wa_with(NA?,
      schema(child_adult_befriend, [svar(y)],
        [rs(guarded, [atom(friend, [role(2)])], [],
                     [atom(identity, []), atom(child, []), atom(parent, [role(3)]),
                      atom(attestation, [svar(y)])],
                     []),
         rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                     [atom(child, []), atom(agent, [])]),
         rs(guarded, [atom(approval, [])], [],
                     [atom(identity, []), atom(parenting, [role(1)]), atom(friend, [role(2)])],
                     [atom(child, [])])]),
      CA?, AP?, AA?, [], C).

procedure wd_attest_free(Declared).
wd_attest_free(C?) :-
    wa_enter_agent(NA), wd2_child_adult(A), wa_child_agent(CA), wa_agents(AA),
    wa_agent_person_at([], [atom(attestation, [svar(y)])], [svar(y)], AP),
    wa_with(NA?, A?, CA?, AP?, AA?, [], C).

% --- leaving marks (def:leaving) -------------------------------------------
% wd_leaving is wd with retirement written with a leaving mark, as GAI's appendix
% writes Wards:4: every guarding role of every schema of wd forbids retired,
% and retire(p?, r) ends the guardianship of p over r, deleting friend(r) and
% parenting(r) at p and friend(p), parent(p) and child at r, and adding
% retired at r.  No schema deletes retired; retire adds it at r, where child
% is required; and enter, the one schema adding parent(p) at r, forbids it at
% p.  So retired is a leaving mark of wd_leaving for {child}, and wd_leaving
% has an introduction with wards naming it.  Each fixture after it changes
% it in one place and fails one clause of def:leaving, so that retired is not
% a leaving mark, befriend forbids an atom that is neither a mark in M nor a
% leaving mark (def:unobstructed-marks, clause 2), and
% there is no introduction with wards: wd_leave_unforbidden, clause 1,
% retire's guarding role p does not forbid retired; wd_leave_deleted, clause
% 1, revive(p?, r) deletes retired at r; wd_leave_unmarked, clause 2,
% quit(p?) adds retired at p, whose role requires no mark in M; and
% wd_leave_guardian, clause 3, adopt(p, r?) adds parent(p) at r and does not
% forbid retired at p, a role that does not guard and so is not held to
% clause 1.
procedure forbid_at_roles(Atom?, RoleSpecs?, RoleSpecs).
forbid_at_roles(_, [], []).
forbid_at_roles(A, [rs(guarded, P, M, K, N)|Rs], [rs(guarded, P?, M?, K?, N1?)|R?]) :-
    ground(A?), ground(N?), ground(Rs?) |
    atoms_app(N?, [A?], N1),
    forbid_at_roles(A?, Rs?, R).
forbid_at_roles(A, [RS|Rs], [RS?|R?]) :- otherwise, ground(A?), ground(Rs?) |
    forbid_at_roles(A?, Rs?, R).

% forbid_at_guards(Phi, C, D): C with Phi forbidden at every guarding role of
% every schema, the roles of C being party roles.
procedure forbid_at_guards(Atom?, Contract?, Contract).
forbid_at_guards(_, [], []).
forbid_at_guards(A, [schema(Nm, Vs, Rs)|Ss], [schema(Nm?, Vs?, Rs1?)|R?]) :-
    ground(A?), ground(Ss?) |
    forbid_at_roles(A?, Rs?, Rs1),
    forbid_at_guards(A?, Ss?, R).
forbid_at_guards(A, [cschema(Nm, Vs, Th, Rs)|Ss], [cschema(Nm?, Vs?, Th?, Rs1?)|R?]) :-
    ground(A?), ground(Ss?) |
    forbid_at_roles(A?, Rs?, Rs1),
    forbid_at_guards(A?, Ss?, R).

procedure wd_retire(Schema).
wd_retire(schema(retire, [],
    [rs(guarded,   [], [atom(friend, [role(2)]), atom(parenting, [role(2)])],
                   [atom(identity, [])], [atom(retired, [])]),
     rs(unguarded, [atom(retired, [])],
                   [atom(friend, [role(1)]), atom(parent, [role(1)]), atom(child, [])],
                   [atom(identity, [])], [])])).

% wd_leaving_with(Retire, Rest, C): wd with retired forbidden at every
% guarding role, then Retire and the schemas Rest as they are given.
procedure leaving_schemas(Contract?, Schema?, Contract?, Contract).
leaving_schemas(Ss, Rt, Rest, C?) :- ground(Ss?), ground(Rt?), ground(Rest?) |
    forbid_at_guards(atom(retired, []), Ss?, Ss1),
    contract_app(Ss1?, [Rt?|Rest?], C).

procedure wd_leaving1(Declared?, Schema?, Contract?, Declared).
wd_leaving1(reflexive(Rf, Ss), Rt, Rest, reflexive(Rf?, C?)) :-
    leaving_schemas(Ss?, Rt?, Rest?, C).
wd_leaving1([], Rt, Rest, C?) :- leaving_schemas([], Rt?, Rest?, C).
wd_leaving1([S|Ss], Rt, Rest, C?) :- leaving_schemas([S?|Ss?], Rt?, Rest?, C).

procedure wd_leaving_with(Schema?, Contract?, Declared).
wd_leaving_with(Rt, Rest, C?) :- ground(Rt?), ground(Rest?) |
    wd(W),
    wd_leaving1(W?, Rt?, Rest?, C).

procedure wd_leaving(Declared).
wd_leaving(C?) :- wd_retire(Rt), wd_leaving_with(Rt?, [], C).

procedure wd_leave_unforbidden(Declared).
wd_leave_unforbidden(C?) :-
    wd_leaving_with(
      schema(retire, [],
        [rs(guarded,   [], [atom(friend, [role(2)]), atom(parenting, [role(2)])],
                       [atom(identity, [])], []),
         rs(unguarded, [atom(retired, [])],
                       [atom(friend, [role(1)]), atom(parent, [role(1)]), atom(child, [])],
                       [atom(identity, [])], [])]),
      [], C).

procedure wd_leave_deleted(Declared).
wd_leave_deleted(C?) :-
    wd_retire(Rt),
    wd_leaving_with(Rt?,
      [schema(revive, [],
         [rs(guarded,   [], [], [atom(identity, []), atom(friend, [role(2)])],
                        [atom(retired, [])]),
          rs(unguarded, [], [atom(retired, [])], [atom(identity, [])], [])])], C).

procedure wd_leave_unmarked(Declared).
wd_leave_unmarked(C?) :-
    wd_retire(Rt),
    wd_leaving_with(Rt?,
      [schema(quit, [],
         [rs(guarded, [atom(retired, [])], [], [atom(identity, [])],
                      [atom(retired, [])])])], C).

procedure wd_leave_guardian(Declared).
wd_leave_guardian(C?) :-
    wd_retire(Rt),
    wd_leaving_with(Rt?,
      [schema(adopt, [],
         [rs(unguarded, [atom(parenting, [role(2)])], [],
                        [atom(identity, []), atom(friend, [role(2)])], [atom(child, [])]),
          rs(guarded,   [atom(identity, []), atom(parent, [role(1)]), atom(child, [])], [],
                        [], [atom(identity, []), atom(retired, [])])])], C).
