% ---------------------------------------------------------------------------
% The checker's fixtures: contracts broken in one place each, or small
% contracts that exercise one clause of a condition, which certify nothing
% but the checker.  Each names in its comment what it changes and which
% fault, if any, it is meant to raise.
%
% The contracts the checker is for are their owners' and live with their
% code, one copy each (claude.md "Sessions", the cascade rule; Coordination
% Appendix C): GSC's are programs/gsc/GSG.glp and GSN.glp, the social
% network of GSC, Section 3.3; GAI's programs/gai/GSNP.glp, the social
% network with provenance, and programs/gai/GAI.glp; the currency's
% programs/currencies/coins/GC.glp (Appendix B), the child-safe social
% network's programs/cssn/CSSN.glp and the federation's
% programs/federation/GFWC.glp.  Each prints its term by contract_named/2 in
% a REPL session on the file, and test_gsc.sh passes the term to check/2,
% traceable_preds/2, compile_contract/2 and compile_schema_in/3.  A fixture that
% changes one of them in one place is a variant: variant/3 takes the owner's
% term and gives the fixture, so no copy of a contract is kept here.  The
% owners write their schemas with their roles' names, schema(Name, Names,
% Vars, Roles) and cschema(Name, Names, Vars, [], Roles) (self.glp,
% WSchema), and so does every variant, for the schemas it adds or changes;
% the fixtures that stand on their own are written without them, which the
% checker reads as before.
%
% rs(Guard, Add, Del, Keep, Forb) is the role's +(i), -(i), =(i), not(i); a
% role is named by its index, so role(1) is the schema's first role.  A
% schema is schema(Name, Vars, Roles) or cschema(Name, Vars, [], Roles),
% Vars its variables, pvar(X) and svar(Y), in the order of its head (GSC
% 0228e79, Definition Speech-act schema); the heads of the fixtures list them in
% the order of their first occurrence, or of the head in the comment above.
% ---------------------------------------------------------------------------

% --- the social graph with items of arity three, no signed term ------------
% The social graph as Section 3.3 printed it before the signed term (GSC
% 63b301f): item(x, a, f), the item x by a as received from f.  A fixture, the
% base of the variant below, sg_tri_cschema, since GSC's language admits no
% signed term and the contract GSNP carries one (programs/gai/GSNP.glp); it
% certifies nothing of GSNP.
procedure sg_plain(Contract).
sg_plain([schema(befriend, [],
       [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
    schema(unfriend, [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
    schema(sign, [svar(x)],
       [rs(guarded, [atom(item, [svar(x), role(1), role(1)])], [], [], [])]),
    schema(forward, [svar(x), pvar(a), pvar(f)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(a), pvar(f)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(a), role(1)])], [],
                      [atom(friend, [role(1)])], [])])]).

% --- negative: befriend guarded in one role only ---------------------------
% Nothing is then an introductory act, and befriend fails volition too.
procedure sg_unguarded(Contract).
sg_unguarded([schema(befriend, [],
       [rs(guarded,   [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
        rs(unguarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
    schema(unfriend, [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
    schema(sign, [svar(x)],
       [rs(guarded, [atom(item, [svar(x), role(1), role(1)])], [], [], [])]),
    schema(forward, [svar(x), pvar(a), pvar(f)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(a), pvar(f)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(a), role(1)])], [],
                      [atom(friend, [role(1)])], [])])]).

% --- negative: befriending done to one of the two ---------------------------
% impose(Alice?, Bob) : +friend(Bob)   +friend(Alice)
% Clause 2 of def:unobstructed excuses it against befriend -- it gives the
% other party a role and the atom it adds names that party -- and volition is
% what rejects it: two roles, guarded at one, and neither requires an atom of
% traceable provenance naming the other.
procedure sg_imposed(WContract?, WContract).
sg_imposed(S, C?) :-
    wcontract_app(S?,
      [schema(impose, ['Alice', 'Bob'], [],
         [rs(guarded,   [atom(friend, [role(2)])], [], [], []),
          rs(unguarded, [atom(friend, [role(1)])], [], [], [])])], C).

% --- negative: a friend atom naming somebody who takes no part -------------
% gossip(Alice?, Bob?; u) : knows(u), +friend(u)   +gossiped
% The atom befriend forbids at p is added at p by an act whose binding sends
% no role to q, so clause 2 of def:unobstructed fails: p can be left holding
% friend(q) without q ever taking part.  friend keeps traceable provenance,
% u being named by the knows atom the role requires, and gossip is guarded in
% both its roles, so volition is not what rejects this one.
procedure sg_gossip(WContract?, WContract).
sg_gossip(S, C?) :-
    wcontract_app(S?,
      [schema(gossip, ['Alice', 'Bob'], [pvar(u)],
         [rs(guarded, [atom(friend, [pvar(u)])], [],
                      [atom(knows, [pvar(u)])], []),
          rs(guarded, [atom(gossiped, [])], [], [], [])])], C).

% --- volition above arity two: a role graph that is a path -----------------
% chain(Alice?, Bob, Carol, Dave) :
%     friend(Bob), +chained(Bob)     friend(Carol), +chained(Carol)
%     friend(Dave), +chained(Dave)   +chained(Carol)
% Guarded at one role, and no pair beyond the path has an edge, so the schema
% passes on connectedness and would fail on every pair.
procedure sg_chain(WContract?, WContract).
sg_chain(S, C?) :-
    wcontract_app(S?,
      [schema(chain, ['Alice', 'Bob', 'Carol', 'Dave'], [],
         [rs(guarded,   [atom(chained, [role(2)])], [],
                        [atom(friend, [role(2)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [],
                        [atom(friend, [role(3)])], []),
          rs(unguarded, [atom(chained, [role(4)])], [],
                        [atom(friend, [role(4)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [], [], [])])], C).

% --- negative: the same schema with one edge of the path removed -----------
% Role 2 requires nothing, so the role graph falls into {1,2} and {3,4}, and
% {3,4} holds no guarding role.
procedure sg_chain_cut(WContract?, WContract).
sg_chain_cut(S, C?) :-
    wcontract_app(S?,
      [schema(chain, ['Alice', 'Bob', 'Carol', 'Dave'], [],
         [rs(guarded,   [atom(chained, [role(2)])], [],
                        [atom(friend, [role(2)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [], [], []),
          rs(unguarded, [atom(chained, [role(4)])], [],
                        [atom(friend, [role(4)])], []),
          rs(unguarded, [atom(chained, [role(3)])], [], [], [])])], C).

% --- volition by connected component (def:volition) -----------------------
% tri(Alice?, Bob, Carol?) :
%     +chained(Bob)    friend(Alice), +chained(Alice)    +chained(Alice)
% q requires friend(p), which joins roles 1 and 2, and nothing joins role 3,
% so the role graph falls into {1,2} and {3}, each holding a guarding role:
% tri is neither guarded in all its roles nor connected, and meets
% def:volition.  sg_tri_cschema is the same contract with tri written as a
% cschema, the form a schema with a listed role may take, and meets it the
% same.
procedure tri_roles(NRoleSpecs).
tri_roles([rs(guarded,   [atom(chained, [role(2)])], [], [], []),
           rs(unguarded, [atom(chained, [role(1)])], [],
                         [atom(friend, [role(1)])], []),
           rs(guarded,   [atom(chained, [role(1)])], [], [], [])]).

procedure sg_tri(WContract?, WContract).
sg_tri(S, C?) :-
    tri_roles(Rs),
    wcontract_app(S?, [schema(tri, ['Alice', 'Bob', 'Carol'], [], Rs?)], C).

procedure sg_tri_cschema(WContract?, WContract).
sg_tri_cschema(S, C?) :-
    tri_roles(Rs),
    wcontract_app(S?, [cschema(tri, ['Alice', 'Bob', 'Carol'], [], [], Rs?)], C).

% --- negative: the currency without mint -----------------------------------
% The swap is still an introductory act, and each role requires a coin of its
% own issue that no act of arity one supplies: clause 1 of def:unobstructed
% fails.
procedure cur_no_mint(Contract).
cur_no_mint([schema(swap, [pvar(v), pvar(u)],
       [rs(guarded, [atom(coin, [pvar(v)])], [atom(coin, [pvar(u)])], [], []),
        rs(guarded, [atom(coin, [pvar(u)])], [atom(coin, [pvar(v)])], [], [])]),
     schema(pay, [],
       [rs(guarded,   [], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [], [], [])]),
     schema(redeem, [pvar(r)],
       [rs(guarded,   [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [], [])])]).

% --- negative: a speech act carried over from an untraceable record --------
% note(Alice?; x, u) : +tagged(x, u)      tag(Alice?; x, u) : tagged(x, u), +item(x)
% u is named by no atom note requires, so tagged loses traceable provenance;
% the x that tag adds in an item occurs in a required atom, tagged(x, u), but
% in none of traceable provenance, so item loses it too under the clause of
% def:grounded on speech-act variables; over GSNP, posted and delivered after
% it, each adding a speech act that the schema requires only in an item, or
% in a posted atom.  Befriend stays unobstructed and every schema
% satisfies volition, so what rejects the contract is the second conjunct of
% def:syntactically-grassroots alone.
procedure sg_svar_loose(WContract?, WContract).
sg_svar_loose(S, C?) :-
    wcontract_app(S?,
      [schema(note, ['Alice'], [svar(x), pvar(u)],
         [rs(guarded, [atom(tagged, [svar(x), pvar(u)])], [], [], [])]),
       schema(tag, ['Alice'], [svar(x), pvar(u)],
         [rs(guarded, [atom(item, [svar(x)])], [],
                      [atom(tagged, [svar(x), pvar(u)])], [])])], C).

% --- negative: minting a coin of somebody else's issue ---------------------
% mint(p?; u) : +coin(u), where u is named by no atom mint requires.  coin
% loses traceable provenance (def:grounded), and pay and redeem, guarded at
% one role and resting on it, then fail def:volition.
procedure cur_loose_mint(Contract).
cur_loose_mint([schema(mint, [pvar(u)],
       [rs(guarded, [atom(coin, [pvar(u)])], [], [], [])]),
     schema(swap, [pvar(v), pvar(u)],
       [rs(guarded, [atom(coin, [pvar(v)])], [atom(coin, [pvar(u)])], [], []),
        rs(guarded, [atom(coin, [pvar(u)])], [atom(coin, [pvar(v)])], [], [])]),
     schema(pay, [],
       [rs(guarded,   [], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [], [], [])]),
     schema(redeem, [pvar(r)],
       [rs(guarded,   [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [], []),
        rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [], [])])]).

% --- reflexive predicates (GAI's appendix "Contracts with Wards") ----------
% The social graph with friend declared reflexive: every state is taken to
% hold friend of its holder, and nothing else changes, so it certifies.
procedure sg_reflexive(WContract?, WDeclared).
sg_reflexive(S, reflexive([friend], S?)).

% The social graph with its befriend changed in one place, for the variants
% of befriend below: at each role, friend of that role is added to what the
% role requires (own_keep) or to what it forbids (own_forb), and every other
% schema, and everything else befriend requires and forbids, is unchanged.
procedure own_friend(Constant?, NRoleSpecs?, Integer?, NRoleSpecs).
own_friend(_, [], _, []).
own_friend(own_keep, [rs(G, P, M, K, N)|Rs], I,
           [rs(G?, P?, M?, [atom(friend, [role(I?)])|K?], N?)|R?]) :-
    integer(I?), ground(Rs?) |
    I1 := I? + 1,
    own_friend(own_keep, Rs?, I1?, R).
own_friend(own_forb, [rs(G, P, M, K, N)|Rs], I,
           [rs(G?, P?, M?, K?, [atom(friend, [role(I?)])|N?])|R?]) :-
    integer(I?), ground(Rs?) |
    I1 := I? + 1,
    own_friend(own_forb, Rs?, I1?, R).
own_friend(W, [RS|Rs], I, [RS?|R?]) :- otherwise, ground(W?), integer(I?), ground(Rs?) |
    I1 := I? + 1,
    own_friend(W?, Rs?, I1?, R).

procedure befriend_own(Constant?, WContract?, WContract).
befriend_own(_, [], []).
befriend_own(W, [schema(befriend, Ns, Vs, Rs)|Ss], [schema(befriend, Ns?, Vs?, Rs1?)|R?]) :-
    ground(W?), ground(Ns?), ground(Vs?), ground(Rs?), ground(Ss?) |
    own_friend(W?, Rs?, 1, Rs1),
    befriend_own(W?, Ss?, R).
befriend_own(W, [S|Ss], [S?|R?]) :- otherwise, ground(W?), ground(Ss?) |
    befriend_own(W?, Ss?, R).

% --- negative: a schema adding or deleting friend of its own role ----------
% self_befriend(Alice?) : +friend(Alice)    self_unfriend(Alice?) : -friend(Alice)
% With friend reflexive no schema adds or deletes, at a role, the friend atom
% naming that role, so the contract is malformed: it is refused, each schema,
% role and atom named, and no condition is decided.
procedure sg_refl_malformed(WContract?, WDeclared).
sg_refl_malformed(S, reflexive([friend], C?)) :-
    wcontract_app(S?,
      [schema(self_befriend, ['Alice'], [],
         [rs(guarded, [atom(friend, [role(1)])], [], [], [])]),
       schema(self_unfriend, ['Alice'], [],
         [rs(guarded, [], [atom(friend, [role(1)])], [], [])])], C).

% --- negative: a role that does not guard and changes nothing --------------
% poke(Alice?, Bob) :  identity, +poked(Bob)        identity, friend(Alice)
% def:schema requires +(i) u -(i) nonempty at every role that is not a
% guarding role; q's role does not guard and adds and deletes nothing, so the
% contract is malformed, the schema and the role named.  GSNP's forward and
% post, whose guarding role adds and deletes nothing, are admitted.
procedure sg_inert_role(WContract?, WContract).
sg_inert_role(S, C?) :-
    wcontract_app(S?,
      [schema(poke, ['Alice', 'Bob'], [],
         [rs(guarded,   [atom(poked, [role(2)])], [], [atom(identity, [])], []),
          rs(unguarded, [], [], [atom(identity, []), atom(friend, [role(1)])], [])])], C).

% --- negative: a schema that changes nothing at any role ------------------
% look(Alice?, Bob?) :  identity, friend(Bob)        identity, friend(Alice)
% Both roles guard and each may add and delete nothing, but def:schema
% requires +(i) u -(i) nonempty at some role, so the contract is malformed,
% the schema named.
procedure sg_inert_schema(WContract?, WContract).
sg_inert_schema(S, C?) :-
    wcontract_app(S?,
      [schema(look, ['Alice', 'Bob'], [],
         [rs(guarded, [], [], [atom(identity, []), atom(friend, [role(2)])], []),
          rs(guarded, [], [], [atom(identity, []), atom(friend, [role(1)])], [])])], C).

% --- negative: an atom added and deleted at one role -----------------------
% toggle(Alice?) :  identity, -flag, +flag
% def:schema requires +(i) and -(i) disjoint, so the contract is malformed,
% the schema, the role and the atom named.
procedure sg_added_deleted(WContract?, WContract).
sg_added_deleted(S, C?) :-
    wcontract_app(S?,
      [schema(toggle, ['Alice'], [],
         [rs(guarded, [atom(flag, [])], [atom(flag, [])], [atom(identity, [])], [])])], C).

% --- befriend requiring friend of each agent at its own role ---------------
% befriend(Alice?, Bob?) :
%     friend(Alice), identity, knows(Bob), not friend(Bob), +friend(Bob)
%     friend(Bob), identity, knows(Alice), not friend(Alice), +friend(Alice)
% No act of arity one adds friend, so clause 1 of def:unobstructed fails at
% both roles of sg_self_required; with friend declared reflexive the clause
% skips those two atoms, and sg_refl_required certifies.
procedure sg_self_required(WContract?, WContract).
sg_self_required(S, C?) :- befriend_own(own_keep, S?, C).

procedure sg_refl_required(WContract?, WDeclared).
sg_refl_required(S, reflexive([friend], C?)) :- sg_self_required(S?, C).

% --- negative: befriend forbidding friend of each agent at its own role ----
% befriend(Alice?, Bob?) :
%     identity, knows(Bob), not friend(Alice), not friend(Bob), +friend(Bob)
%     identity, knows(Alice), not friend(Bob), not friend(Alice), +friend(Alice)
% With friend reflexive every state holds friend of its holder, so clause 3 of
% def:unobstructed fails at both roles of befriend; no act adds at an agent
% friend of that agent, so clause 2 holds.  The verdict names befriend's
% faults, befriend being the contract's first introductory act.
procedure sg_refl_forbidden(WContract?, WDeclared).
sg_refl_forbidden(S, reflexive([friend], C?)) :- befriend_own(own_forb, S?, C).

% --- cs18: a child-safe social contract of eighteen schemas ----------------
% The checker's fixture for expanded schemas, four-party schemas, speech-act
% variables and a schema no party guards, in one contract: eighteen schemas,
% twenty-eight expanded, syntactically grassroots, its introductory act
% parent_child.  It is the child-safe social network's contract as CSSN
% drafted it in Legal's inbox on 2026-08-15 and 2026-08-16 and as it was
% brought to their paper on 2026-10-09 (send, parent_child, friend reflexive,
% the five expanded schemas); CSSN has since revised the contract, and the
% contract is programs/cssn/CSSN.glp, CSSN's, which certifies this
% fixture of nothing.
%
% unfriend, child_unfriend, leave, child_leave and child_leave_2 each stand
% for one schema per role, guarded at that role and differing in nothing
% else, and are written expanded: the one guarded at the role the table
% writes r is named <schema>_r, so unfriend_p and unfriend_q, leave_a and
% leave_q, child_leave_a, _s and _p, child_unfriend_r, _s, _p and _q, and
% child_leave_2_r, _s, _p and _q.  n names a group.  A group is no person,
% so n is a speech-act variable here, member and listed having traceable
% provenance only under that reading.
procedure cs18(Declared).
cs18(reflexive([friend], S?)) :- cs18_schemas(S).

procedure cs18_schemas(Contract).
cs18_schemas([schema(parent_child, [],
       [rs(guarded, [atom(parenting, [role(2)])], [], [],
                    [atom(parent, [role(2)])]),
        rs(guarded, [atom(parent, [role(1)]), atom(child, [])], [], [],
                    [atom(parent, [role(1)])])]),
     schema(end_parenting, [],
       [rs(guarded, [], [atom(parent, [role(2)]), atom(child, [])], [], []),
        rs(guarded, [], [atom(parenting, [role(1)])], [], [])]),
     schema(befriend, [],
       [rs(guarded, [atom(friend, [role(2)])], [], [],
                    [atom(child, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [],
                    [atom(child, []), atom(friend, [role(1)])])]),
     schema(unfriend_p, [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [], [])]),
     schema(unfriend_q, [],
       [rs(unguarded, [], [atom(friend, [role(2)])], [], []),
        rs(guarded,   [], [atom(friend, [role(1)])], [], [])]),
     schema(child_befriend, [],
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(parent, [role(3)])],
                    [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(parent, [role(4)])],
                    [atom(friend, [role(1)])]),
        rs(guarded, [atom(approval, [])], [],
                    [atom(parenting, [role(1)]), atom(friend, [role(4)])], []),
        rs(guarded, [atom(approval, [])], [],
                    [atom(parenting, [role(2)]), atom(friend, [role(3)])], [])]),
     schema(child_unfriend_r, [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_unfriend_s, [],
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(guarded,   [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_unfriend_p, [],
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_unfriend_q, [],
       [rs(unguarded, [], [atom(friend, [role(2)])], [atom(parent, [role(3)])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(parent, [role(4)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(create, [svar(n)],
       [rs(guarded, [atom(member, [role(1), svar(n)]),
                     atom(listed, [role(1), svar(n)])], [], [], [])]),
     schema(join, [svar(n)],
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(member, [role(1), svar(n)]), atom(friend, [role(2)])], []),
        rs(guarded, [atom(member, [role(1), svar(n)])], [],
                    [atom(friend, [role(1)])],
                    [atom(child, []), atom(member, [role(1), svar(n)])])]),
     schema(child_join, [svar(n)],
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(member, [role(1), svar(n)]), atom(friend, [role(3)])], []),
        rs(guarded, [atom(member, [role(1), svar(n)])], [],
                    [atom(parent, [role(3)])],
                    [atom(member, [role(1), svar(n)])]),
        rs(guarded, [atom(approval, [])], [],
                    [atom(parenting, [role(2)]), atom(friend, [role(1)])], [])]),
     schema(child_join2, [svar(n)],
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(member, [role(1), svar(n)]), atom(friend, [role(2)]),
                     atom(parent, [role(3)])], []),
        rs(guarded, [atom(member, [role(1), svar(n)])], [],
                    [atom(parent, [role(4)]), atom(friend, [role(1)])],
                    [atom(member, [role(1), svar(n)])]),
        rs(guarded, [atom(approval, [])], [], [atom(parenting, [role(1)])], []),
        rs(guarded, [atom(approval, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(leave_a, [svar(n)],
       [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], [])]),
     schema(leave_q, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(guarded,   [], [atom(member, [role(1), svar(n)])], [], [])]),
     schema(child_leave_a, [svar(n)],
       [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_s, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(guarded,   [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_p, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(sign, [svar(x)],
       [rs(guarded, [atom(item, [svar(x), role(1), role(1)])], [], [], [])]),
     schema(send, [svar(x), pvar(a), pvar(f)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(a), pvar(f)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(a), role(1)])], [],
                      [atom(friend, [role(1)])], [])]),
     schema(post, [svar(x), pvar(b), pvar(f), svar(n)],
       [rs(guarded,   [atom(sent, [svar(x), role(2)])], [],
                      [atom(item, [svar(x), pvar(b), pvar(f)]),
                       atom(member, [role(2), svar(n)])], []),
        rs(unguarded, [atom(item, [svar(x), pvar(b), role(1)]),
                       atom(posted, [svar(x), svar(n)])], [],
                      [atom(listed, [role(1), svar(n)])], [])]),
     schema(deliver, [svar(x), svar(n), pvar(b), pvar(f)],
       [rs(unguarded, [atom(delivered, [svar(x), role(2), svar(n)])], [],
                      [atom(item, [svar(x), pvar(b), pvar(f)]),
                       atom(posted, [svar(x), svar(n)]),
                       atom(listed, [role(2), svar(n)])],
                      [atom(delivered, [svar(x), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [svar(x), pvar(b), role(1)])], [],
                      [atom(member, [role(1), svar(n)])], [])]),
     schema(child_leave_2_r, [svar(n)],
       [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_2_s, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(guarded,   [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_2_p, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(child_leave_2_q, [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [], []),
        rs(unguarded, [], [atom(member, [role(1), svar(n)])], [], []),
        rs(unguarded, [atom(withdrawal, [])], [], [atom(parenting, [role(1)])], []),
        rs(guarded,   [atom(withdrawal, [])], [], [atom(parenting, [role(2)])], [])]),
     schema(post_own, [svar(x), svar(n), pvar(b), pvar(f)],
       [rs(guarded, [atom(posted, [svar(x), svar(n)])], [],
                    [atom(item, [svar(x), pvar(b), pvar(f)]),
                     atom(listed, [role(1), svar(n)])], [])])]).

% ===========================================================================
% Listed roles and name terms (def:role, def:introduction, def:unobstructed,
% def:grounded)
% ===========================================================================
% Variants of GSNP, a contract with the listed role of close, each with one
% schema more and failing one condition, or refused for a listed role
% carrying the mark ?, and contracts that stand on their own, failing
% def:introduction or clause 1 of def:unobstructed by a name term.

% --- negative: a listed role adding an atom befriend forbids --------------
% befriend_listed(Alice?, Alice[listed(*, n)]; n) :  identity, member(<Alice>.n)
%     at Alice[listed(*, n)]: identity, +friend(Alice)
% Every member a lists becomes a friend of a in one act a wills.  friend is
% forbidden by befriend at both roles, so the first part of clause 2 of
% def:unobstructed fails at each, naming the listed role.
procedure sn_listed_forbidden(WContract?, WContract).
sn_listed_forbidden(S, C?) :-
    wcontract_app(S?,
      [cschema(befriend_listed, ['Alice', 'Alice'], [svar(n)], [],
         [rs(guarded, [], [], [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], []),
          crs(listed(1, listed, [svar(n)]), unguarded,
              [atom(friend, [role(1)])], [], [atom(identity, [])], [])])], C).

% --- negative: a speech act traced through a listed role only -------------
% note_posted(Alice?, Alice[listed(*, n)]; x, n) :  identity, +noted(x)
% x occurs in posted(x, n), required at the listed role and at no agent
% role, and def:grounded traces it through an atom psi required at an agent
% role, so noted has no traceable provenance.  The listed role adds noticed,
% a role that is not guarding adding or deleting an atom (def:schema, GSC
% 70afdc4).
procedure sn_listed_witness(WContract?, WContract).
sn_listed_witness(S, C?) :-
    wcontract_app(S?,
      [cschema(note_posted, ['Alice', 'Alice'], [svar(x), svar(n)], [],
         [rs(guarded, [atom(noted, [svar(x)])], [], [atom(identity, [])], []),
          crs(listed(1, listed, [svar(n)]), unguarded,
              [atom(noticed, [])], [], [atom(identity, []), atom(posted, [svar(x), svar(n)])], [])])], C).

% --- negative: a listed role carrying the mark ? ----------------------------
% split(Alice, Bob?, Alice[listed(*, n)]?; n) :  identity, +split_a    identity, +split_b
%     at Alice[listed(*, n)]: identity, +split_c
% Only an agent role may carry the mark ? (def:schema, GSC f3c4f43), so the
% contract is malformed, the listed role named.
procedure sn_listed_guard(WContract?, WContract).
sn_listed_guard(S, C?) :-
    wcontract_app(S?,
      [cschema(split, ['Alice', 'Bob', 'Alice'], [svar(n)], [],
         [rs(unguarded, [atom(split_a, [])], [], [atom(identity, [])], []),
          rs(guarded,   [atom(split_b, [])], [], [atom(identity, [])], []),
          crs(listed(1, listed, [svar(n)]), guarded,
              [atom(split_c, [])], [], [atom(identity, [])], [])])], C).

% --- negative: a listed role adding and deleting nothing --------------------
% idle(Alice?, Alice[listed(*, n)]; n) :  identity, +idled(n)
%     at Alice[listed(*, n)]: identity
% A role that is not a guarding role adds or deletes an atom (def:schema,
% GSC 70afdc4), and a listed role is no guarding role, so the contract is
% malformed, the listed role named.
procedure sn_listed_inert(WContract?, WContract).
sn_listed_inert(S, C?) :-
    wcontract_app(S?,
      [cschema(idle, ['Alice', 'Alice'], [svar(n)], [],
         [rs(guarded, [atom(idled, [svar(n)])], [], [atom(identity, [])], []),
          crs(listed(1, listed, [svar(n)]), unguarded,
              [], [], [atom(identity, [])], [])])], C).

% --- negative: an introductory act with a name term -----------------------
% befriend(p?, q? ; y) :  identity, not friend(q), +friend(q), +tag(<p>.y)
%                         identity, not friend(p), +friend(p)
% The one schema of arity two guarded in both roles carries a name term, so
% the contract has no introductory act (def:introduction).
procedure an_named_intro(Contract).
an_named_intro([schema(establish, [], [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(befriend, [svar(y)],
       [rs(guarded, [atom(friend, [role(2)]), atom(tag, [nterm(ext(own(1), y))])], [],
                    [atom(identity, [])], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])],
                    [atom(friend, [role(1)])])])]).

% --- negative: identity supplied by a schema with a name term (clause 1) --
% establish(p? ; y) :  +identity, +home(<p>.y)
% befriend requires identity at each role, and the one schema of arity one
% adding it carries a name term, so it supplies nothing under clause 1.
procedure an_named_unary(Contract).
an_named_unary([schema(establish, [svar(y)],
       [rs(guarded, [atom(identity, []), atom(home, [nterm(ext(own(1), y))])], [], [], [])]),
    schema(befriend, [],
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, [])], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, [])], [atom(friend, [role(1)])])])]).

% --- negative: a signed term of a listed role -------------------------------
% note(a?, a[club(*, n)] ; x, n) :  item(x)    at a[club(*, n)]: item(x), +got(sgn(x, a[club(*, n)]))
% A signed term is of an agent role, as GSC admitted sgn(y, pi) for pi an
% agent role until GSC 1a2a5f3, the signed term now GAI's, so the contract is
% malformed.
procedure sgn_listed(Contract).
sgn_listed([cschema(note, [svar(x), svar(n)], [],
       [rs(guarded, [], [], [atom(item, [svar(x)])], []),
        crs(listed(1, club, [svar(n)]), unguarded,
            [atom(got, [sgn(x, 2)])], [], [atom(item, [svar(x)])], [])])]).

% --- negative: listed roles formed otherwise than Definition Role allows ----
% close_b(a?, pi_2[listed(*, n)] ; n) :  identity, +closed(n)
%                                       at pi_2[listed(*, n)]: identity, -member(<a>.n)
%   the listed role, the second, is of pi_2, itself and no agent role
%   (listed_base);
% note_l(a?, a[got(*, sgn(x, a))] ; x) :  item(x)    at a[got(*, sgn(x, a))]: +noted(x)
%   a signed term among the arguments of a listed role, which occurs only in
%   an atom marked + (Definition Speech-act schema; listed_signed);
% close_h(a?, a[listed(*, m)] ; n) :  identity, +closed(n)
%                                     at a[listed(*, m)]: identity, -member(<a>.n)
%   m, an argument of the listed role, is a variable the head does not list
%   (not_in_head).
% So the contract is malformed, each fault named.
procedure ls_faults(Contract).
ls_faults([cschema(close_b, [svar(n)], [],
       [rs(guarded, [atom(closed, [svar(n)])], [], [atom(identity, [])], []),
        crs(listed(2, listed, [svar(n)]), unguarded,
            [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
    cschema(note_l, [svar(x)], [],
       [rs(guarded, [], [], [atom(item, [svar(x)])], []),
        crs(listed(1, got, [sgn(x, 1)]), unguarded,
            [atom(noted, [svar(x)])], [], [], [])]),
    cschema(close_h, [svar(n)], [],
       [rs(guarded, [atom(closed, [svar(n)])], [], [atom(identity, [])], []),
        crs(listed(1, listed, [svar(m)]), unguarded,
            [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])])]).

% --- negative: the head of a schema -----------------------------------------
% sign(p? ; x, x, p) :  +item(y)
% The head lists x twice and the role p, which is no variable, and leaves out
% y, which the schema has (def:schema), so the contract is malformed.
procedure hd_faults(Contract).
hd_faults([schema(sign, [svar(x), svar(x), role(1)],
       [rs(guarded, [atom(item, [svar(y)])], [], [], [])])]).

% ===========================================================================
% Agent-named contracts with wards (def:sg-wards, CSSN's paper)
% ===========================================================================
% wd_leaving with one schema more, gather(p?, p[club(*, n)] ; n), whose
% listed role is the agents p lists in club(q, n) (def:sg-wards clause 2 on
% listed roles): wd_listed's listed role requires child and adds noted,
% which is no mark in M, no leaving mark, no friend atom and no parent or
% parenting atom, so it is syntactically grassroots with wards;
% wd_listed_leaving's adds retired, a leaving mark, and clause 2 of
% def:sg-wards fails.
procedure gather_listed(Constant?, Schema).
gather_listed(A, cschema(gather, [svar(n)], [],
    [rs(guarded, [], [], [atom(identity, [])], [atom(retired, [])]),
     crs(listed(1, club, [svar(n)]), unguarded,
         [atom(A?, [])], [], [atom(child, [])], [])])).

procedure wd_listed(Declared).
wd_listed(C?) :- wd_retire(Rt), gather_listed(noted, G), wd_leaving_with(Rt?, [G?], C).

procedure wd_listed_leaving(Declared).
wd_listed_leaving(C?) :- wd_retire(Rt), gather_listed(retired, G), wd_leaving_with(Rt?, [G?], C).

% ===========================================================================
% GKK's introduce changed in one place (programs/gsc/GKK.glp; GSC, Section
% 7.1: "introduce's role Alice requires knows(Bob) ... an atom of traceable
% provenance naming the other role", and introduce "adds knows(c) at Bob, c
% an argument of knows(c), which Alice requires")
% ===========================================================================
% wcontract_app(S, T, C): the contract S, as its owner writes it, and the
% schemas T after it.
procedure wcontract_app(WContract?, WContract?, WContract).
wcontract_app([], T, T?).
wcontract_app([S|Ss], T, [S?|R?]) :- wcontract_app(Ss?, T?, R).

% schema_set(Name, New, S, C): the contract S, as its owner writes it, with
% its schema Name replaced by New.
procedure schema_set(Constant?, WSchema?, WContract?, WContract).
schema_set(_, _, [], []).
schema_set(Nm, N, [schema(M, _, _, _)|Ss], [N?|Ss?]) :- Nm? =?= M? | true.
schema_set(Nm, N, [S|Ss], [S?|R?]) :-
    otherwise, ground(Nm?), ground(N?), ground(Ss?) |
    schema_set(Nm?, N?, Ss?, R).

% introduce(Alice?, Bob; c) :  identity, knows(Bob), knows(c)    identity, +knows(c)
% Bob does not guard and requires no knows(Alice); Alice requires knows(Bob),
% an atom of traceable provenance naming Bob, which joins the two roles, so volition holds
% (def:volition) and the contract is syntactically grassroots.
procedure gkk_intro_joined(WContract?, WContract).
gkk_intro_joined(S, C?) :-
    schema_set(introduce,
      schema(introduce, ['Alice', 'Bob'], [pvar(c)],
        [rs(guarded,   [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
         rs(unguarded, [atom(knows, [pvar(c)])], [], [atom(identity, [])], [])]), S?, C).

% --- negative: and Alice does not require knows(Bob) -----------------------
% introduce(Alice?, Bob; c) :  identity, knows(c)    identity, +knows(c)
% Nothing joins the two roles and Bob's connected component holds no guarding
% role, so volition fails at introduce, naming its two roles.
procedure gkk_intro_unjoined(WContract?, WContract).
gkk_intro_unjoined(S, C?) :-
    schema_set(introduce,
      schema(introduce, ['Alice', 'Bob'], [pvar(c)],
        [rs(guarded,   [], [], [atom(identity, []), atom(knows, [pvar(c)])], []),
         rs(unguarded, [atom(knows, [pvar(c)])], [], [atom(identity, [])], [])]), S?, C).

% --- negative: knows(c) added at Bob, c known to neither -------------------
% introduce(Alice?, Bob?; c) :  identity, knows(Bob)    identity, knows(Alice), +knows(c)
% c is an argument of no atom required at a role, so knows loses traceable
% provenance (def:grounded).
procedure gkk_intro_loose(WContract?, WContract).
gkk_intro_loose(S, C?) :-
    schema_set(introduce,
      schema(introduce, ['Alice', 'Bob'], [pvar(c)],
        [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)])], []),
         rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]), S?, C).

% ===========================================================================
% Clause 1 of def:unobstructed: a schema of arity one forbidding the atom it
% adds
% ===========================================================================
% Clause 1 admits as the schema of arity one adding an atom the introductory
% act requires one that requires nothing and forbids nothing or only that
% atom, the introductory act then requiring that atom once at the role (GSC,
% Section 3.6).  GKK's establish(Alice?) : not identity, +identity is one.
%
% uo_twice: meet requires identity twice at Alice, and establish, forbidding
% the identity it adds, does not supply it: obstructed(meet, 1, identity,
% unobtainable), once for each copy meet requires.
procedure uo_twice(Contract).
uo_twice([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, []), atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

% uo_twice_free: the same with establish forbidding nothing, which supplies
% identity however many times meet requires it: syntactically grassroots.
procedure uo_twice_free(Contract).
uo_twice_free([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, []), atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

% uo_other: establish(Alice?) : not banned, +identity forbids an atom other
% than the one it adds, so it is no schema of clause 1: obstructed(meet, 1,
% identity, unobtainable), and at role 2 the same.
procedure uo_other(Contract).
uo_other([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(banned, [])])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

% ===========================================================================
% Values (GSC, Section 3.2, and the appendix Values in Speech-Act Schemas)
% ===========================================================================
% "Speech-act schemas allow values of any type: an argument of an atom may be a
% value or a value variable, a schema may carry a constraint on its value
% variables, which every binding satisfies, and an atom added or deleted may
% carry a multiplicity, a count of copies and so a positive whole number ...
% A value names no agent, so the conditions below do not concern it."  In
% the term form of Currencies' GB.glp: num(x) a value variable, or a number
% where x is one; times(num(k), A) the atom A with the multiplicity k;
% nschema(Name, Vars, Constraint, Roles) a schema with a constraint, a
% conjunction of linear equalities and inequalities (and, eq, le, lt, ge,
% gt, succ, over plus, minus and a product by a number; self.glp).  A
% binding sends a value variable to a value, a multiplicity to a positive
% whole number (def:binding-numbers).  The
% fixtures are the checker's and certify nothing of GB, Currencies'
% (programs/currencies/bonds/GB.glp).
%
% establish(Alice?) : +identity
% meet(Alice?, Bob?) : identity, +knows(Bob)    identity, +knows(Alice)
procedure nm_base(NContract).
nm_base([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

procedure ncontract_app(NContract?, NContract?, NContract).
ncontract_app([], T, T?).
ncontract_app([S|Ss], T, [S?|R?]) :- ncontract_app(Ss?, T?, R).

% --- a contract with numbers, syntactically grassroots ---------------------
% mint(Alice?; d, k, t) | d > t, d <= t + 30 : identity, date(t), +k.bond(Alice, d)
% advance(Alice; t, t1) | t1 = t + 1 :      identity, -date(t), +date(t1)
% swap(Alice?, Bob?; u, d, k, v, d1, k1) :
%     identity, knows(Bob), -k.bond(u, d), +k1.bond(v, d1)
%     identity, knows(Alice), -k1.bond(v, d1), +k.bond(u, d)
% mature(Alice?, Bob; d, t) | d <= t :
%     identity, knows(Bob), -bond(Bob, d), +coin(Bob)
%     identity, date(t), +bond(Bob, d)
% Meet is the introductory act, unobstructed; the numbers name no agent, so
% date has traceable provenance, bond has it through the bond the other role
% of the swap deletes, and mature's role graph is joined by the knows(Bob)
% and the bond of Bob that Alice requires.
procedure nm_bonds(NContract).
nm_bonds(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [nschema(mint, [num(d), num(k), num(t)],
               and(gt(num(d), num(t)), le(num(d), plus(num(t), num(30)))),
         [rs(guarded, [times(num(k), atom(bond, [role(1), num(d)]))], [],
                      [atom(identity, []), atom(date, [num(t)])], [])]),
       nschema(advance, [num(t), num(t1)], succ(num(t), num(t1)),
         [rs(unguarded, [atom(date, [num(t1)])], [atom(date, [num(t)])], [atom(identity, [])], [])]),
       schema(swap, [pvar(u), num(d), num(k), pvar(v), num(d1), num(k1)],
         [rs(guarded, [times(num(k1), atom(bond, [pvar(v), num(d1)]))],
                      [times(num(k), atom(bond, [pvar(u), num(d)]))],
                      [atom(identity, []), atom(knows, [role(2)])], []),
          rs(guarded, [times(num(k), atom(bond, [pvar(u), num(d)]))],
                      [times(num(k1), atom(bond, [pvar(v), num(d1)]))],
                      [atom(identity, []), atom(knows, [role(1)])], [])]),
       nschema(mature, [num(d), num(t)], le(num(d), num(t)),
         [rs(guarded,   [atom(coin, [role(2)])], [atom(bond, [role(2), num(d)])],
                        [atom(identity, []), atom(knows, [role(2)])], []),
          rs(unguarded, [atom(bond, [role(2), num(d)])], [],
                        [atom(identity, []), atom(date, [num(t)])], [])])], C).

% --- a number required and supplied ----------------------------------------
% meet as above, but each role requires score(5), which the schema of arity
% one score(Alice?; k) : +score(k) adds, guarded and requiring and forbidding
% nothing, at the binding sending k to 5, which satisfies its constraint,
% true: clause 1 of def:unobstructed holds, a number matched by equality, and
% the contract is syntactically grassroots.
procedure nm_supplied(NContract).
nm_supplied([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(score, [num(k)],
       [rs(guarded, [atom(score, [num(k)])], [], [], [])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, []), atom(score, [num(5)])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, []), atom(score, [num(5)])], [])])]).

% --- negative: a value forbidden, added at a binding of a successor --------
% meet forbids date(0) at Alice, and advance, unguarded and of arity one,
% adds date(t1) there at a binding satisfying t1 = t + 1.  The binding
% sending t1 to 0 and t to -1, a value, satisfies it, Bob in no role, so
% clause 2 of def:unobstructed fails: obstructed(meet, 1, date(0),
% blocked_by(advance, 1, date(t1))).
procedure nm_blocked(NContract).
nm_blocked([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], [atom(date, [num(0)])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
    nschema(advance, [num(t), num(t1)], succ(num(t), num(t1)),
       [rs(unguarded, [atom(date, [num(t1)])], [atom(date, [num(t)])], [atom(identity, [])], [])])]).

% --- a number required, and the constraint of the schema adding it ---------
% meet requiring score(5) at each role (nm_supplied), and a schema of arity
% one adding score(k) at a binding satisfying its constraint
% (def:unobstructed, clause 1; def:binding-numbers).
procedure nm_score_meet(NContract).
nm_score_meet([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, []), atom(score, [num(5)])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, []), atom(score, [num(5)])], [])])]).

% score(Alice?; k) | k > 3 : +score(k): the binding sending k to 5 satisfies
% 5 > 3 and adds score(5), so meet is unobstructed and the contract
% syntactically grassroots.
procedure nm_admits(NContract).
nm_admits(C?) :-
    nm_score_meet(B),
    ncontract_app(B?,
      [nschema(score, [num(k)], gt(num(k), num(3)),
         [rs(guarded, [atom(score, [num(k)])], [], [], [])])], C).

% --- negative: score(Alice?; k) | k <= 4 : +score(k) ------------------------
% The one binding adding score(5) sends k to 5, which 5 <= 4 excludes, so no
% schema of arity one adds score(5): obstructed(meet, 1, score(5),
% unobtainable), and at role 2 the same.
procedure nm_excludes(NContract).
nm_excludes(C?) :-
    nm_score_meet(B),
    ncontract_app(B?,
      [nschema(score, [num(k)], le(num(k), num(4)),
         [rs(guarded, [atom(score, [num(k)])], [], [], [])])], C).

% --- negative: score(Alice?) : +score(4) ------------------------------------
% The schema adds score(4), and 4 is not 5: no schema of arity one adds
% score(5), obstructed at both roles.
procedure nm_other_number(NContract).
nm_other_number(C?) :-
    nm_score_meet(B),
    ncontract_app(B?,
      [schema(score, [],
         [rs(guarded, [atom(score, [num(4)])], [], [], [])])], C).

% --- a number forbidden, and the constraint of the schema adding it --------
% meet forbidding date(0) at Alice (nm_blocked), and set_date(Alice; t),
% unguarded and of arity one, requiring identity and adding date(t) at a
% binding satisfying its constraint (def:unobstructed, clause 2).
procedure nm_date_meet(NContract).
nm_date_meet([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], [atom(date, [num(0)])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

% --- negative: set_date(Alice; t) | t <= 3 : identity, +date(t) -------------
% The binding sending t to 0 satisfies 0 <= 3 and adds date(0) at Alice, and
% set_date has Bob in no role: clause 2 fails, obstructed(meet, 1, date(0),
% blocked_by(set_date, 1, date(t))).
procedure nm_forbid_admits(NContract).
nm_forbid_admits(C?) :-
    nm_date_meet(B),
    ncontract_app(B?,
      [nschema(set_date, [num(t)], le(num(t), num(3)),
         [rs(unguarded, [atom(date, [num(t)])], [], [atom(identity, [])], [])])], C).

% set_date(Alice; t) | t > 3 : identity, +date(t): the one binding adding
% date(0) sends t to 0, which 0 > 3 excludes, so no binding of set_date adds
% the atom meet forbids, clause 2 holds and the contract is syntactically
% grassroots.
procedure nm_forbid_excludes(NContract).
nm_forbid_excludes(C?) :-
    nm_date_meet(B),
    ncontract_app(B?,
      [nschema(set_date, [num(t)], gt(num(t), num(3)),
         [rs(unguarded, [atom(date, [num(t)])], [], [atom(identity, [])], [])])], C).

% --- a number of the introductory act --------------------------------------
% meet(Alice?, Bob?; n) requires score(n) at each role, n its numeric
% variable, whose number its introduction chooses (def:introduction); score
% is as in nm_supplied, or carries the constraint k > 3.
procedure nm_var_meet(NContract).
nm_var_meet([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [num(n)],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, []), atom(score, [num(n)])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, []), atom(score, [num(n)])], [])])]).

% score(Alice?; k) : +score(k) adds score(n) at the binding sending k to n,
% whatever number the introduction sends n to: syntactically grassroots.
procedure nm_intro_var(NContract).
nm_intro_var(C?) :-
    nm_var_meet(B),
    ncontract_app(B?,
      [schema(score, [num(k)],
         [rs(guarded, [atom(score, [num(k)])], [], [], [])])], C).

% score(Alice?; k) | k > 3 : +score(k) adds score(n) where the introduction
% sends n to a value above 3, which it chooses (the appendix "Values in Act
% Schemas"): syntactically grassroots.
procedure nm_intro_var_bounded(NContract).
nm_intro_var_bounded(C?) :-
    nm_var_meet(B),
    ncontract_app(B?,
      [nschema(score, [num(k)], gt(num(k), num(3)),
         [rs(guarded, [atom(score, [num(k)])], [], [], [])])], C).

% --- a number required once, supplied by a schema forbidding it ------------
% meet requiring score(5) at each role (nm_supplied), and
% score(Alice?; k, j) : not score(j), +score(k), which forbids only the atom
% it adds at the binding sending k and j to 5: clause 1 of def:unobstructed
% holds, meet requiring score(5) once at each role, and the contract is
% syntactically grassroots.
procedure nm_once(NContract).
nm_once(C?) :-
    nm_score_meet(B),
    ncontract_app(B?,
      [schema(score, [num(k), num(j)],
         [rs(guarded, [atom(score, [num(k)])], [], [], [atom(score, [num(j)])])])], C).

% --- a multiplicity constrained below one --------------------------------
% meet forbids flag at Alice, and raise(Alice; k) | k <= 0 : identity, +k.flag,
% unguarded and of arity one, adds flag at no binding, a multiplicity being
% a positive whole number at every binding (def:binding-numbers): clause 2 of
% def:unobstructed holds and the contract is syntactically grassroots
% (nm_mult_unsat).  Under k <= 1 the binding sending k to 1 adds flag at
% Alice, Bob in no role, and clause 2 fails (nm_mult_sat).
procedure nm_flag_meet(NContract).
nm_flag_meet([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], [atom(flag, [])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

procedure nm_mult_unsat(NContract).
nm_mult_unsat(C?) :-
    nm_flag_meet(B),
    ncontract_app(B?,
      [nschema(raise, [num(k)], le(num(k), num(0)),
         [rs(unguarded, [times(num(k), atom(flag, []))], [], [atom(identity, [])], [])])], C).

procedure nm_mult_sat(NContract).
nm_mult_sat(C?) :-
    nm_flag_meet(B),
    ncontract_app(B?,
      [nschema(raise, [num(k)], le(num(k), num(1)),
         [rs(unguarded, [times(num(k), atom(flag, []))], [], [atom(identity, [])], [])])], C).

% --- negative: a multiplicity that is no positive whole number -------------
% mint(Alice?) : +0.coin(Alice): a multiplicity written as a number is a
% positive whole number (def:numbers), so the contract is malformed:
% multiplicity_not_whole(mint, 1, coin(Alice)).
procedure nm_mult_zero(NContract).
nm_mult_zero([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(mint, [],
       [rs(guarded, [times(num(0), atom(coin, [role(1)]))], [], [atom(identity, [])], [])])]).

% --- two values of the introductory act, related ---------------------------
% meet(Alice?, Bob?; x, y) | 0 < x, x < y, y < 1 :
%     identity, +knows(Bob), +span(x, y)    identity, +knows(Alice)
% The introduction chooses x and y with 0 < x < y < 1, which 1/4 and 3/4
% satisfy: meet is an introductory act, unobstructed, and the contract is
% syntactically grassroots.  No two of the values within one of a number the
% contract writes, or halfway between two, satisfy the constraint: a search
% of those values finds no introduction.
procedure nm_two_between(NContract).
nm_two_between([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    nschema(meet, [num(x), num(y)],
       and(lt(num(0), num(x)), and(lt(num(x), num(y)), lt(num(y), num(1)))),
       [rs(guarded, [atom(knows, [role(2)]), atom(span, [num(x), num(y)])], [],
                    [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

% --- a value forbidden, every choice of it added -------------------------
% meet(Alice?, Bob?; x) : identity, +knows(Bob), not date(x)    identity, +knows(Alice)
% low(Alice; t) | t <= 5 : identity, +date(t)
% high(Alice; t) | t >= 5 : identity, +date(t)  (nm_cover)
% high(Alice; t) | t >= 6 : identity, +date(t)  (nm_gap)
% Under nm_cover a binding of low or of high adds date(x) at Alice, Bob in
% no role, whatever x the introduction chooses: clause 2 of def:unobstructed
% fails at every introduction, obstructed(meet, 1, date(x), blocked_by(low,
% 1, date(t))), low being the first schema that adds it.  Under nm_gap the
% introduction chooses x strictly between 5 and 6, which no binding adds:
% syntactically grassroots.
procedure nm_date_var_meet(NContract).
nm_date_var_meet([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [num(x)],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], [atom(date, [num(x)])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
    nschema(low, [num(t)], le(num(t), num(5)),
       [rs(unguarded, [atom(date, [num(t)])], [], [atom(identity, [])], [])])]).

procedure nm_cover(NContract).
nm_cover(C?) :-
    nm_date_var_meet(B),
    ncontract_app(B?,
      [nschema(high, [num(t)], ge(num(t), num(5)),
         [rs(unguarded, [atom(date, [num(t)])], [], [atom(identity, [])], [])])], C).

procedure nm_gap(NContract).
nm_gap(C?) :-
    nm_date_var_meet(B),
    ncontract_app(B?,
      [nschema(high, [num(t)], ge(num(t), num(6)),
         [rs(unguarded, [atom(date, [num(t)])], [], [atom(identity, [])], [])])], C).

% --- a multiplicity of the act forbidden, added at whole numbers ----------
% meet(Alice?, Bob?; k) : identity, +knows(Bob), +k.badge, not date(k)
%                         identity, +knows(Alice)
% count(Alice; j, t) | t = 2 * j : identity, +j.tally, +date(t)  (nm_evens)
% count(Alice; j, t) | t = j : identity, +j.tally, +date(t)      (nm_counts)
% k is a multiplicity of meet, a positive whole number, and j of count.
% Under nm_evens count adds date(t) at Alice for each even t of 2 or more,
% and the introduction chooses k = 1: syntactically grassroots; were j a
% rational, j = 1/2 would add date(1).  Under nm_counts count adds date(k)
% for every k: obstructed(meet, 1, date(k), blocked_by(count, 1, date(t))).
procedure nm_badge_meet(NContract).
nm_badge_meet([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [num(k)],
       [rs(guarded, [atom(knows, [role(2)]), times(num(k), atom(badge, []))], [],
                    [atom(identity, [])], [atom(date, [num(k)])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

procedure nm_evens(NContract).
nm_evens(C?) :-
    nm_badge_meet(B),
    ncontract_app(B?,
      [nschema(count, [num(j), num(t)], eq(num(t), mul(num(2), num(j))),
         [rs(unguarded, [times(num(j), atom(tally, [])), atom(date, [num(t)])], [],
                        [atom(identity, [])], [])])], C).

procedure nm_counts(NContract).
nm_counts(C?) :-
    nm_badge_meet(B),
    ncontract_app(B?,
      [nschema(count, [num(j), num(t)], eq(num(t), num(j)),
         [rs(unguarded, [times(num(j), atom(tally, [])), atom(date, [num(t)])], [],
                        [atom(identity, [])], [])])], C).

% --- a multiplicity no whole number meets ----------------------------------
% meet(Alice?, Bob?; k) | 2 * k = 3 : identity, +knows(Bob), +k.badge
%                                     identity, +knows(Alice)
% k is a multiplicity, a positive whole number, and 2k = 3 has no whole
% solution: meet has no introduction, and the contract none:
% not_grassroots([no_introductory_act]).
procedure nm_half(NContract).
nm_half([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    nschema(meet, [num(k)], eq(mul(num(2), num(k)), num(3)),
       [rs(guarded, [atom(knows, [role(2)]), times(num(k), atom(badge, []))], [],
                    [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])]).

% --- each condition met at some value, not all at one ----------------------
% meet(Alice?, Bob?; x) : identity, score(x), +knows(Bob), not date(x)
%                         identity, +knows(Alice)
% score(Alice?; k) | k >= 5 : +score(k)
% set_date(Alice; t) | t >= 5 : identity, +date(t)
% score supplies score(x) where x >= 5, and set_date adds date(x) there:
% clause 1 holds at x >= 5 and clause 2 at x < 5, and no x meets both:
% obstructed_jointly(meet).
procedure nm_joint(NContract).
nm_joint([schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
    schema(meet, [num(x)],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, []), atom(score, [num(x)])],
                    [atom(date, [num(x)])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
    nschema(score, [num(k)], ge(num(k), num(5)),
       [rs(guarded, [atom(score, [num(k)])], [], [], [])]),
    nschema(set_date, [num(t)], ge(num(t), num(5)),
       [rs(unguarded, [atom(date, [num(t)])], [], [atom(identity, [])], [])])]).

% --- negative: a disjunction -----------------------------------------------
% mint(Alice?; d, k, t) | d > t or d <= 0 : identity, date(t), +k.bond(Alice, d)
% A constraint is a conjunction (def:numbers):
% constraint_not_conjunction(mint, or(gt(num(d), num(t)), le(num(d), num(0)))).
procedure nm_or(NContract).
nm_or(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [nschema(mint, [num(d), num(k), num(t)], or(gt(num(d), num(t)), le(num(d), num(0))),
         [rs(guarded, [times(num(k), atom(bond, [role(1), num(d)]))], [],
                      [atom(identity, []), atom(date, [num(t)])], [])])], C).

% --- negative: a product of two value variables ----------------------------
% mint(Alice?; d, k, t) | d * k <= t : identity, date(t), +k.bond(Alice, d)
% A constraint is linear (def:numbers):
% constraint_not_linear(mint, mul(num(d), num(k))).
procedure nm_nonlinear(NContract).
nm_nonlinear(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [nschema(mint, [num(d), num(k), num(t)], le(mul(num(d), num(k)), num(t)),
         [rs(guarded, [times(num(k), atom(bond, [role(1), num(d)]))], [],
                      [atom(identity, []), atom(date, [num(t)])], [])])], C).

% --- negative: a role that reads a number and changes nothing --------------
% mature(Alice?, Bob; d, t) | d <= t : identity, knows(Bob), -bond(Bob, d), +coin(Bob)
%                                      identity, date(t)
% Bob does not guard and adds and deletes nothing, which def:schema forbids,
% numbers or no: changes_nothing(mature, 2).
procedure nm_reading_role(NContract).
nm_reading_role(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [nschema(mature, [num(d), num(t)], le(num(d), num(t)),
         [rs(guarded,   [atom(coin, [role(2)])], [atom(bond, [role(2), num(d)])],
                        [atom(identity, []), atom(knows, [role(2)])], []),
          rs(unguarded, [], [], [atom(identity, []), atom(date, [num(t)])], [])])], C).

% --- negative: a multiplicity on an atom required and not deleted ----------
% spend(Alice?; k) : identity, k.coin(Alice), -coin(Alice)
% multiplicity_not_added(spend, 1, coin(Alice)).
procedure nm_mult_kept(NContract).
nm_mult_kept(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [schema(spend, [num(k)],
         [rs(guarded, [], [atom(coin, [role(1)])],
                      [atom(identity, []), times(num(k), atom(coin, [role(1)]))], [])])], C).

% --- negative: a multiplicity on an atom forbidden -------------------------
% hoard(Alice?; k) : identity, not k.coin(Alice), +coin(Alice)
% multiplicity_not_added(hoard, 1, coin(Alice)).
procedure nm_mult_forbidden(NContract).
nm_mult_forbidden(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [schema(hoard, [num(k)],
         [rs(guarded, [atom(coin, [role(1)])], [], [atom(identity, [])],
                      [times(num(k), atom(coin, [role(1)]))])])], C).

% --- negative: a multiplicity that is not a number -------------------------
% mint(Alice?; u) : identity, +u.coin(Alice), u an agent variable
% multiplicity_not_numeric(mint, 1, coin(Alice)).
procedure nm_mult_agent(NContract).
nm_mult_agent(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [schema(mint, [pvar(u)],
         [rs(guarded, [times(pvar(u), atom(coin, [role(1)]))], [], [atom(identity, [])], [])])], C).

% --- negative: a constraint on an agent ------------------------------------
% mint(Alice?; u, d) | u > d : identity, knows(u), +bond(Alice, d)
% constraint_not_numeric(mint, pvar(u)).
procedure nm_constraint_agent(NContract).
nm_constraint_agent(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [nschema(mint, [pvar(u), num(d)], gt(pvar(u), num(d)),
         [rs(guarded, [atom(bond, [role(1), num(d)])], [],
                      [atom(identity, []), atom(knows, [pvar(u)])], [])])], C).

% --- negative: an atom added and deleted, with a multiplicity --------------
% churn(Alice?; k) : identity, -coin(Alice), +k.coin(Alice)
% added_and_deleted(churn, 1, coin(Alice)).
procedure nm_added_deleted(NContract).
nm_added_deleted(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [schema(churn, [num(k)],
         [rs(guarded, [times(num(k), atom(coin, [role(1)]))], [atom(coin, [role(1)])],
                      [atom(identity, [])], [])])], C).

% --- negative: the head and the value variables --------------------------
% mint(Alice?; 5, k, k) | d > t : identity, date(t), +k.bond(Alice, d)
% The head lists the number 5, which is no variable, and k twice, and leaves
% out d and t, which the atoms and the constraint carry:
% head_not_variable(mint, num(5)), head_repeated(mint, num(k)),
% not_in_head(mint, num(d)), not_in_head(mint, num(t)).
procedure nm_head(NContract).
nm_head(C?) :-
    nm_base(B),
    ncontract_app(B?,
      [nschema(mint, [num(5), num(k), num(k)], gt(num(d), num(t)),
         [rs(guarded, [times(num(k), atom(bond, [role(1), num(d)]))], [],
                      [atom(identity, []), atom(date, [num(t)])], [])])], C).

% --- the contracts by name -------------------------------------------------
% A fixture that stands alone, by name.  An unknown name is the empty
% contract, which has no introductory act.
exported procedure contract(Constant?, NDeclared).
contract(sg_plain, C?) :- sg_plain(C).
contract(sg_unguarded, C?) :- sg_unguarded(C).
contract(cur_no_mint, C?) :- cur_no_mint(C).
contract(cur_loose_mint, C?) :- cur_loose_mint(C).
contract(cs18, C?) :- cs18(C).
contract(sv_signed, C?) :- sv_signed(C).
contract(sv_loose, C?) :- sv_loose(C).
contract(sv_in_name_loose, C?) :- sv_in_name_loose(C).
contract(sv_in_name_carried, C?) :- sv_in_name_carried(C).
contract(sg_items, C?) :- sg_items(C).
contract(sgn_intro, C?) :- sgn_intro(C).
contract(sgn_intro_plain, C?) :- sgn_intro_plain(C).
contract(sgn_not_added, C?) :- sgn_not_added(C).
contract(sgn_other_role, C?) :- sgn_other_role(C).
contract(sgn_unguarded_signer, C?) :- sgn_unguarded_signer(C).
contract(sgn_not_required, C?) :- sgn_not_required(C).
contract(sgn_community, C?) :- sgn_community(C).
contract(sg_sgn_loose, C?) :- sg_sgn_loose(C).
contract(wd, C?) :- wd(C).
contract(wd_iota_deleted, C?) :- wd_iota_deleted(C).
contract(wd_two_marks, C?) :- wd_two_marks(C).
