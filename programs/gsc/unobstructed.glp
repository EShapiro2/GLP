% ---------------------------------------------------------------------------
% The introductory act (def:introduction) and unobstructedness
% (def:unobstructed) of /Grassroots/GSC, Section 3.6, for a contract of agent
% roles and listed roles alike (GSC ac7ad63).
%
% Both definitions quantify over all distinct p and q.  The schemas name no
% person (prop:anonymity), so one pair stands for every pair, and the bindings
% over it are finite: person(0) and person(1) take the two roles, each party
% variable takes one of the two, and each speech-act variable a speech act of
% its own.  intro_bindings enumerates them and keeps the introductions.  An
% introduction chooses its own values (the appendix "Values in Act
% Schemas", after def:binding-numbers): the clauses are decided on the
% contract as written, a value matched by equality at a binding satisfying
% its schema's constraint, and whether some choice of the values meets them
% all is decided exactly, the constraints being linear (values, below;
% linear.glp).
%
% An introductory act is guarded in both its roles, which are therefore
% agent roles, and has no name term (def:introduction); so has each schema
% of arity one of clause 1 of def:unobstructed.  A listed role adds at the
% agents of its extent, which no binding names, so the second part of clause
% 2 of def:unobstructed is asked of the agent roles of a schema, and its
% first part of the listed roles: none adds an atom of the predicate of an
% atom the introductory act forbids at a role.
% ---------------------------------------------------------------------------

imported procedure linear#sat_conj(Conj?, Ans).
imported procedure linear#sat_prod(Conj?, DNFs?, Ans).
imported procedure linear#dnf_and(DNF?, DNF?, DNF).
imported procedure linear#dnf_not(DNF?, DNF).
imported procedure linear#dnf_app(DNF?, DNF?, DNF).
imported procedure linear#conj_app(Conj?, Conj?, Conj).
imported procedure linear#elim_block(Conj?, DNF).
imported procedure linear#cons_conj(Constraint?, VEnv?, Conj).
imported procedure linear#ex_num(Constant?, Ex).
imported procedure linear#ex_var(Var?, Ex).
imported procedure linear#ex_eq(Ex?, Ex?, Conj).
imported procedure linear#decomp_defs(Constants?, Conj).

% --- the introductions of person(0) and person(1) --------------------------

procedure svar_binds(Args?, Integer?, Subst).
svar_binds([], _, []).
svar_binds([A|As], N, [bind(A?, speech(N?))|R?]) :- ground(A?), ground(As?), integer(N?) |
    N1 := N? + 1,
    svar_binds(As?, N1?, R).

procedure extend_each(Substs?, Arg?, Substs).
extend_each([], _, []).
extend_each([S|Ss], A, [[bind(A?, person(0))|S?], [bind(A?, person(1))|S?]|R?]) :-
    ground(S?), ground(A?), ground(Ss?) |
    extend_each(Ss?, A?, R).

procedure pvar_assignments(Args?, Substs).
pvar_assignments([], [[]]).
pvar_assignments([A|As], R?) :- ground(A?), ground(As?) |
    pvar_assignments(As?, Rs),
    extend_each(Rs?, A?, R).

% gatom_has(G, V, R): the image G names V -- V is among its arguments or is
% the person of a signed value among them (Section 3.1: an atom names what is
% among its arguments or is the signer of one, the role of a signed term
% included).
procedure val_names(Val?, Val?, Ans).
val_names(W, V, yes) :- W? =?= V? | true.
val_names(signed(_, P), V, yes) :- P? =?= V? | true.
val_names(_, _, no) :- otherwise | true.

procedure vals_name1(Ans?, Vals?, Val?, Ans).
vals_name1(yes, _, _, yes).
vals_name1(no, Ws, V, R?) :- ground(Ws?), ground(V?) | vals_name(Ws?, V?, R).

procedure vals_name(Vals?, Val?, Ans).
vals_name([], _, no).
vals_name([W|Ws], V, R?) :- ground(W?), ground(Ws?), ground(V?) |
    val_names(W?, V?, A),
    vals_name1(A?, Ws?, V?, R).

procedure gatom_has(GAtom?, Val?, Ans).
gatom_has(gatom(_, Vs), V, R?) :- ground(Vs?), ground(V?) | vals_name(Vs?, V?, R).

procedure atoms_name1(Ans?, Atoms?, Subst?, Val?, Ans).
atoms_name1(yes, _, _, _, yes).
atoms_name1(no, As, B, V, R?) :- ground(As?), ground(B?), ground(V?) |
    atoms_name(As?, B?, V?, R).

% atoms_name(Phis, B, V, R): some atom of B(Phis) has V among its arguments.
procedure atoms_name(Atoms?, Subst?, Val?, Ans).
atoms_name([], _, _, no).
atoms_name([A|As], B, V, R?) :- ground(A?), ground(As?), ground(B?), ground(V?) |
    apply_atom(B?, A?, G),
    gatom_has(G?, V?, H),
    atoms_name1(H?, As?, B?, V?, R).

procedure is_intro_roles(RoleSpecs?, Subst?, Ans).
is_intro_roles([rs(_, P1, _, _, _), rs(_, P2, _, _, _)], B, R?) :-
    ground(P1?), ground(P2?), ground(B?) |
    atoms_name(P1?, B?, person(1), A1),
    atoms_name(P2?, B?, person(0), A2),
    both_yes(A1?, A2?, R).
is_intro_roles(Rs, _, no) :- otherwise, ground(Rs?) | true.

procedure is_intro(Schema?, Subst?, Ans).
is_intro(Sc, B, R?) :- ground(Sc?), ground(B?) |
    sch_roles(Sc?, Rs),
    is_intro_roles(Rs?, B?, R).

procedure intro_keep(Ans?, Subst?, Substs?, Subst?, Schema?, Substs).
intro_keep(yes, B, PAs, SB, Sc, [B?|R?]) :-
    ground(B?), ground(PAs?), ground(SB?), ground(Sc?) |
    intro_filter(PAs?, SB?, Sc?, R).
intro_keep(no, _, PAs, SB, Sc, R?) :- ground(PAs?), ground(SB?), ground(Sc?) |
    intro_filter(PAs?, SB?, Sc?, R).

procedure intro_filter2(Subst?, Schema?, Substs?, Subst?, Substs).
intro_filter2(S0, Sc, PAs, SB, R?) :-
    ground(S0?), ground(Sc?), ground(PAs?), ground(SB?) |
    is_intro(Sc?, [bind(role(1), person(0)), bind(role(2), person(1))|S0?], Ok),
    intro_keep(Ok?, [bind(role(1), person(0)), bind(role(2), person(1))|S0?],
               PAs?, SB?, Sc?, R).

procedure intro_filter(Substs?, Subst?, Schema?, Substs).
intro_filter([], _, _, []).
intro_filter([PA|PAs], SB, Sc, R?) :-
    ground(PA?), ground(PAs?), ground(SB?), ground(Sc?) |
    subst_app(SB?, PA?, S0),
    intro_filter2(S0?, Sc?, PAs?, SB?, R).

procedure intro_bindings(Schema?, Substs).
intro_bindings(Sc, R?) :- ground(Sc?) |
    schema_svars(Sc?, SV),
    svar_binds(SV?, 0, SB),
    schema_pvars(Sc?, PV),
    pvar_assignments(PV?, PAs),
    intro_filter(PAs?, SB?, Sc?, R).

% Arity two, both roles guarded, so agent roles, and no name term
% (def:introduction).
procedure two_guarded(RoleSpecs?, Ans).
two_guarded([rs(guarded, _, _, _, _), rs(guarded, _, _, _, _)], yes).
two_guarded(Rs, no) :- otherwise, ground(Rs?) | true.

procedure is_two_guarded(Schema?, Ans).
is_two_guarded(Sc, R?) :- ground(Sc?) |
    sch_roles(Sc?, Rs),
    two_guarded(Rs?, A1),
    sch_nts(Sc?, Ns),
    nts_empty(Ns?, A2),
    both_yes(A1?, A2?, R).

procedure iab1(Ans?, Schema?, Substs).
iab1(no, _, []).
iab1(yes, Sc, R?) :- ground(Sc?) | intro_bindings(Sc?, R).

% The introductions of a schema, empty unless it is an introductory act.
% The search for an introduction with wards reads it too (wards).
exported procedure intro_act_bindings(Schema?, Substs).
intro_act_bindings(Sc, R?) :- ground(Sc?) |
    is_two_guarded(Sc?, A),
    iab1(A?, Sc?, R).



% --- values (GSC, Section 3.2; the appendix "Values in Speech-Act Schemas") ------
% A binding maps each value variable to a value, "under which gamma holds
% and every multiplicity of tau is a positive whole number"
% (def:binding-numbers), and an introduction chooses its own values (the
% appendix, after def:binding-numbers).  The clauses of def:unobstructed ask
% that an atom be added at a binding of a schema, a value matched by
% equality: the images of the act's atoms carry nfree(X) for its value
% variable X, a match against another schema's atom records the equations
% it rests on (match_atom, self.glp), and the binding of that schema is a
% conjunction of linear atoms over the act's values and its own
% (inst_conj).  Whether some choice of the act's values meets every clause
% is then decided exactly (linear.glp): a supplying schema's binding is
% chosen with the values, and a blocking schema's bindings are eliminated,
% the formula left over the act's values negated.

% The variable of the value variable X of the act: whole where the act uses
% X as a multiplicity (Pw), rational otherwise.
procedure ivar(Constant?, Args?, Var).
ivar(X, Pw, R?) :- ground(X?), ground(Pw?) |
    args_member(Pw?, num(X?), A),
    kind_var(A?, iv(X?), R).

procedure kind_var(Ans?, Name?, Var).
kind_var(yes, N, z(N?)).
kind_var(no, N, q(N?)).

procedure tg_name(Tg?, Constant?, Name).
tg_name(tg_sv(Is), X, sv(Is?, X?)).
tg_name(tg_bv, X, bv(X?)).

% The value of an image, nval or nfree, as an expression.
procedure val_ex(Val?, Args?, Ex).
val_ex(nval(N), _, R?) :- number(N?) | linear # ex_num(N?, R).
val_ex(nfree(X), Pw, R?) :- ground(X?), ground(Pw?) |
    ivar(X?, Pw?, V),
    linear # ex_var(V?, R).
val_ex(_, _, ex_bad) :- otherwise | true.

% The equations a match rests on, as atoms.
procedure eqs_conj(Eqs?, Args?, Conj).
eqs_conj([], _, []).
eqs_conj([eqv(V, W)|Es], Pw, R?) :- ground(V?), ground(W?), ground(Es?), ground(Pw?) |
    val_ex(V?, Pw?, X),
    val_ex(W?, Pw?, Y),
    linear # ex_eq(X?, Y?, A),
    eqs_conj(Es?, Pw?, R1),
    linear # conj_app(A?, R1?, R).

% The value variables of a schema read as variables named by Tg, whole where
% the schema uses them as multiplicities (Pw).
procedure inst_env(Args?, Args?, Tg?, VEnv).
inst_env([], _, _, []).
inst_env([num(X)|Vs], Pw, Tg, [vb(X?, V?)|R?]) :-
    ground(X?), ground(Vs?), ground(Pw?), ground(Tg?) |
    args_member(Pw?, num(X?), A),
    tg_name(Tg?, X?, N),
    kind_var(A?, N?, V),
    inst_env(Vs?, Pw?, Tg?, R).
inst_env([_|Vs], Pw, Tg, R?) :- otherwise | inst_env(Vs?, Pw?, Tg?, R).

% Each whole variable is at least one, a multiplicity being a positive whole
% number (def:binding-numbers).
procedure env_bounds(VEnv?, Conj).
env_bounds([], []).
env_bounds([vb(_, z(N))|E], [geq(lin([t(z(N?), 1)], -1))|R?]) :- env_bounds(E?, R).
env_bounds([vb(_, q(_))|E], R?) :- env_bounds(E?, R).

% Each value variable the match binds equals its image.
procedure env_binds(VEnv?, Subst?, Args?, Conj).
env_binds([], _, _, []).
env_binds([vb(X, V)|E], S, PwI, R?) :-
    ground(X?), ground(V?), ground(E?), ground(S?), ground(PwI?) |
    subst_lookup(S?, num(X?), F),
    env_bind(F?, V?, PwI?, A),
    env_binds(E?, S?, PwI?, R1),
    linear # conj_app(A?, R1?, R).

procedure env_bind(Found?, Var?, Args?, Conj).
env_bind(bound(W), V, PwI, R?) :- ground(W?), ground(V?), ground(PwI?) |
    linear # ex_var(V?, X),
    val_ex(W?, PwI?, Y),
    linear # ex_eq(X?, Y?, R).
env_bind(free, _, _, []).

% inst_conj(NSc, Tg, S, E, PwI, C): a binding of the schema NSc extending
% the match S, E of one of its atoms, its value variables named by Tg: it
% satisfies NSc's constraint, sends each multiplicity to a positive whole
% number, and each value variable S binds to its image, and the equations E
% hold; PwI are the multiplicities of the act.
procedure inst_conj(NSchema?, Tg?, Subst?, Eqs?, Args?, Conj).
inst_conj(NSc, Tg, S, E, PwI, R?) :-
    ground(NSc?), ground(Tg?), ground(S?), ground(E?), ground(PwI?) |
    sch_vvars(NSc?, Vs),
    num_ctx(NSc?, Nx),
    inst_conj1(Vs?, Nx?, Tg?, S?, E?, PwI?, R).

procedure inst_conj1(Args?, NumCtx?, Tg?, Subst?, Eqs?, Args?, Conj).
inst_conj1(Vs, nc(Cn, Pw), Tg, S, E, PwI, R?) :-
    ground(Vs?), ground(Cn?), ground(Pw?), ground(Tg?), ground(S?), ground(E?),
    ground(PwI?) |
    inst_env(Vs?, Pw?, Tg?, Env),
    inst_conj2(Env?, Cn?, S?, E?, PwI?, R).

procedure inst_conj2(VEnv?, Constraint?, Subst?, Eqs?, Args?, Conj).
inst_conj2(Env, Cn, S, E, PwI, R?) :-
    ground(Env?), ground(Cn?), ground(S?), ground(E?), ground(PwI?) |
    env_bounds(Env?, B),
    env_binds(Env?, S?, PwI?, Q),
    linear # cons_conj(Cn?, Env?, C),
    eqs_conj(E?, PwI?, Es),
    linear # conj_app(B?, Q?, BQ),
    linear # conj_app(C?, Es?, CE),
    linear # conj_app(BQ?, CE?, R).

% The value variables of a schema, in the order of its head.
procedure sch_vvars(NSchema?, Args).
sch_vvars(NSc, R?) :- ground(NSc?) |
    nsch_vars(NSc?, Vs),
    filter_nvars(Vs?, R).

% --- clause 1 of def:unobstructed -----------------------------------------
% The atom is added by a schema of arity one, guarded in its role, with no
% name term, requiring and clearing nothing (GSC 327e035: its role's atoms
% marked -, -(i) and the cleared atoms *(i), and its unmarked atoms are
% none), and forbidding nothing or only that atom,
% which the introductory act then requires once at its role, at a binding
% sending its role to the person in question: an atom the schema adds
% equals the atom there, and so does each atom it forbids.  Its role is
% guarded, so an agent role.  The answer is a formula over the act's values
% and the supplying schema's (named by Tg), one conjunction for each atom of
% each such schema that matches; O is the formula saying that the act
% requires the atom once at its role (once_dnf, below), asked where the
% schema forbids an atom.

% Each atom the schema forbids equals the atom in question at a binding
% extending the match of the atom it adds: it matches it, the match binding
% what the first left free.
procedure forb_match(Atoms?, GAtom?, RoleSpecs?, MatchRes?, MatchRes).
forb_match([], _, _, MR, MR?).
forb_match([_|_], _, _, nomatch, nomatch).
forb_match([F|Fs], G, Rs, match(S, E), R?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Rs?), ground(S?), ground(E?) |
    match_atom(F?, G?, Rs?, S?, E?, MR),
    forb_match(Fs?, G?, Rs?, MR?, R).

% A schema that forbids an atom supplies it only where the introductory act
% requires it once.
procedure once_and(Atoms?, DNF?, DNF?, DNF).
once_and([], _, D, D?).
once_and([_|_], O, D, R?) :- ground(O?), ground(D?) | linear # dnf_and(D?, O?, R).

procedure supply_dnf(MatchRes?, NSchema?, Tg?, Args?, DNF).
supply_dnf(nomatch, _, _, _, []).
supply_dnf(match(S, E), NSc, Tg, PwI, [C?]) :-
    ground(S?), ground(E?), ground(NSc?), ground(Tg?), ground(PwI?) |
    inst_conj(NSc?, Tg?, S?, E?, PwI?, C).

procedure mult_supply(Atom?, Atoms?, RoleSpecs?, NSchema?, GAtom?, Val?, DNF?, Tg?, Args?, DNF).
mult_supply(Psi, N, Rs, NSc, G, V, O, Tg, PwI, R?) :-
    ground(Psi?), ground(N?), ground(Rs?), ground(NSc?), ground(G?), ground(V?), ground(O?),
    ground(Tg?), ground(PwI?) |
    match_atom(Psi?, G?, Rs?, [bind(role(1), V?)], [], MR0),
    forb_match(N?, G?, Rs?, MR0?, MR),
    supply_dnf(MR?, NSc?, Tg?, PwI?, D0),
    once_and(N?, O?, D0?, R).

procedure mults_supply(Mults?, Atoms?, RoleSpecs?, NSchema?, GAtom?, Val?, DNF?, Tg?, Args?, DNF).
mults_supply([], _, _, _, _, _, _, _, _, []).
mults_supply([M|Ms], N, Rs, NSc, G, V, O, Tg, PwI, R?) :-
    ground(M?), ground(Ms?), ground(N?), ground(Rs?), ground(NSc?), ground(G?), ground(V?),
    ground(O?), ground(Tg?), ground(PwI?) |
    plain_mult(M?, Psi),
    mult_supply(Psi?, N?, Rs?, NSc?, G?, V?, O?, Tg?, PwI?, D1),
    mults_supply(Ms?, N?, Rs?, NSc?, G?, V?, O?, Tg?, PwI?, D2),
    linear # dnf_app(D1?, D2?, R).

procedure unary_supplies1(RoleSpecs?, NameTerms?, NRoleSpecs?, NSchema?, GAtom?, Val?, DNF?, Tg?, Args?, DNF).
unary_supplies1([rs(guarded, P, [], [], N)], [], [rs(guarded, PM, [], [], _)], NSc, G, V, O, Tg, PwI, R?) :-
    ground(P?), ground(N?), ground(PM?), ground(NSc?), ground(G?), ground(V?), ground(O?),
    ground(Tg?), ground(PwI?) |
    mults_supply(PM?, N?, [rs(guarded, P?, [], [], N?)], NSc?, G?, V?, O?, Tg?, PwI?, R).
unary_supplies1(_, _, _, _, _, _, _, _, _, []) :- otherwise | true.

procedure unary_supplies0(Schema?, NSchema?, GAtom?, Val?, DNF?, Tg?, Args?, DNF).
unary_supplies0(Sc, NSc, G, V, O, Tg, PwI, R?) :-
    ground(Sc?), ground(NSc?), ground(G?), ground(V?), ground(O?), ground(Tg?), ground(PwI?) |
    sch_roles(Sc?, Rs),
    sch_nts(Sc?, Ns),
    nsch_roles(NSc?, NRs),
    unary_supplies1(Rs?, Ns?, NRs?, NSc?, G?, V?, O?, Tg?, PwI?, R).

% obtainable(NC, G, V, O, Tg, PwI, D): D says that some schema of arity one
% of the contract supplies G to V.
procedure obtainable(NContract?, GAtom?, Val?, DNF?, Tg?, Args?, DNF).
obtainable([], _, _, _, _, _, []).
obtainable([S|Ss], G, V, O, Tg, PwI, R?) :-
    ground(S?), ground(Ss?), ground(G?), ground(V?), ground(O?), ground(Tg?), ground(PwI?) |
    plain_schema(S?, Sc),
    unary_supplies0(Sc?, S?, G?, V?, O?, Tg?, PwI?, D1),
    obtainable(Ss?, G?, V?, O?, Tg?, PwI?, D2),
    linear # dnf_app(D1?, D2?, R).

% once_dnf(All, M, G, B, PwI, D): the act requires the atom G once at its
% role at the introduction B -- the images under B of the atoms All the
% role requires, each as many times as its multiplicity, hold G once
% ("which tau then requires once at pi_i", clause 1).  G is the image of
% the atom M of All, which holds it as many times as M's multiplicity: so
% that multiplicity is one, and no other atom of All has an image equal to
% G.
procedure once_dnf(Mults?, Mult?, GAtom?, Subst?, Args?, DNF).
once_dnf(All, M, G, B, PwI, R?) :-
    ground(All?), ground(M?), ground(G?), ground(B?), ground(PwI?) |
    mult_one(M?, B?, PwI?, D0),
    once_others(All?, M?, yes, G?, B?, PwI?, D1),
    linear # dnf_and(D0?, D1?, R).

procedure mult_one(Mult?, Subst?, Args?, DNF).
mult_one(atom(_, _), _, _, [[]]).
mult_one(times(K, _), B, PwI, [C?]) :- ground(K?), ground(B?), ground(PwI?) |
    apply_arg(B?, K?, W),
    val_ex(W?, PwI?, X),
    linear # ex_num(1, Y),
    linear # ex_eq(X?, Y?, C).

procedure once_others(Mults?, Mult?, Ans?, GAtom?, Subst?, Args?, DNF).
once_others([], _, _, _, _, _, [[]]).
once_others([M1|Ms], M, Sk, G, B, PwI, R?) :-
    ground(M1?), ground(Ms?), ground(M?), ground(Sk?), ground(G?), ground(B?), ground(PwI?) |
    same_mult(Sk?, M1?, M?, Sm),
    once_others1(Sm?, M1?, Ms?, M?, Sk?, G?, B?, PwI?, R).

procedure same_mult(Ans?, Mult?, Mult?, Ans).
same_mult(yes, M1, M, yes) :- M1? =?= M? | true.
same_mult(_, _, _, no) :- otherwise | true.

procedure once_others1(Ans?, Mult?, Mults?, Mult?, Ans?, GAtom?, Subst?, Args?, DNF).
once_others1(yes, _, Ms, M, _, G, B, PwI, R?) :- once_others(Ms?, M?, no, G?, B?, PwI?, R).
once_others1(no, M1, Ms, M, Sk, G, B, PwI, R?) :-
    ground(M1?), ground(Ms?), ground(M?), ground(Sk?), ground(G?), ground(B?), ground(PwI?) |
    plain_mult(M1?, A),
    apply_atom(B?, A?, G1),
    gatom_eqf(G1?, G?, PwI?, Q),
    not_equal(Q?, D1),
    once_others(Ms?, M?, Sk?, G?, B?, PwI?, D2),
    linear # dnf_and(D1?, D2?, R).

% The image is not equal to G: true where it cannot be, and otherwise the
% negation of the equations under which it is.
procedure not_equal(EqR?, DNF).
not_equal(eqr_no, [[]]).
not_equal(eqr(C), R?) :- ground(C?) | linear # dnf_not([C?], R).

% gatom_eqf(G1, G2, PwI, Q): the two images are equal where the equations of
% Q hold, or never (eqr_no).
procedure gatom_eqf(GAtom?, GAtom?, Args?, EqR).
gatom_eqf(gatom(P, Vs), gatom(Q, Ws), PwI, R?) :- P? =?= Q?, ground(Vs?), ground(Ws?), ground(PwI?) |
    vals_eqf(Vs?, Ws?, PwI?, R).
gatom_eqf(_, _, _, eqr_no) :- otherwise | true.

procedure vals_eqf(Vals?, Vals?, Args?, EqR).
vals_eqf([], [], _, eqr([])).
vals_eqf([V|Vs], [W|Ws], PwI, R?) :-
    ground(V?), ground(W?), ground(Vs?), ground(Ws?), ground(PwI?) |
    val_eqf(V?, W?, PwI?, R1),
    vals_eqf(Vs?, Ws?, PwI?, R2),
    eqr_and(R1?, R2?, R).
vals_eqf(_, _, _, eqr_no) :- otherwise | true.

procedure eqr_and(EqR?, EqR?, EqR).
eqr_and(eqr_no, _, eqr_no).
eqr_and(eqr(_), eqr_no, eqr_no).
eqr_and(eqr(A), eqr(B), eqr(C?)) :- linear # conj_app(A?, B?, C).

procedure val_eqf(Val?, Val?, Args?, EqR).
val_eqf(V, W, _, eqr([])) :- V? =?= W? | true.
val_eqf(nval(M), nval(N), _, R?) :- otherwise, number(M?), number(N?) | num_eqr(M?, N?, R).
val_eqf(nval(M), nfree(Y), PwI, eqr(C?)) :- number(M?), ground(Y?), ground(PwI?) |
    val_ex(nval(M?), PwI?, X),
    val_ex(nfree(Y?), PwI?, Z),
    linear # ex_eq(X?, Z?, C).
val_eqf(nfree(Y), nval(M), PwI, eqr(C?)) :- number(M?), ground(Y?), ground(PwI?) |
    val_ex(nfree(Y?), PwI?, X),
    val_ex(nval(M?), PwI?, Z),
    linear # ex_eq(X?, Z?, C).
val_eqf(nfree(X), nfree(Y), PwI, eqr(C?)) :- otherwise, ground(X?), ground(Y?), ground(PwI?) |
    val_ex(nfree(X?), PwI?, A),
    val_ex(nfree(Y?), PwI?, B),
    linear # ex_eq(A?, B?, C).
val_eqf(_, _, _, eqr_no) :- otherwise | true.

procedure num_eqr(Constant?, Constant?, EqR).
num_eqr(M, N, eqr([])) :- M? =:= N? | true.
num_eqr(_, _, eqr_no) :- otherwise | true.

% --- clause 2 of def:unobstructed, its second part: the agent roles -------
% Every atom every schema adds at an agent role is matched against the
% forbidden one at that party, a value by equality, and a match is a binding
% adding it where the binding satisfies the schema's constraint and sends
% each multiplicity to a positive whole number.  A binding adding it that the
% clause does not excuse is a block.  excused/4 is the clause's two tests,
% both read off the completed binding, values naming no one: the other
% party of the introduction holds a role, and the multiset added at the
% role in question names it.  A block is blk(Schema, Role, Psi, D), D the
% formula over the act's values saying where some binding of Schema adds
% Psi at Role (linear.glp, elim_block); one with D false is none.

procedure ctx_parts(Ctx?, Val, Integer).
ctx_parts(ctx(O, N), O?, N?).

procedure excused(Subst?, Mults?, Val?, Ans).
excused(S, Plus, O, R?) :- ground(S?), ground(Plus?), ground(O?) |
    subst_role_at(S?, O?, A1),
    plain_mults(Plus?, PA),
    atoms_name(PA?, S?, O?, A2),
    both_yes(A1?, A2?, R).

procedure blks_app(Blks?, Blks?, Blks).
blks_app([], T, T?).
blks_app([B|Bs], T, [B?|R?]) :- blks_app(Bs?, T?, R).

procedure blk_keep(DNF?, Constant?, Integer?, Atom?, Blks).
blk_keep([], _, _, _, []).
blk_keep([C|Cs], Nm, J, Psi, [blk(Nm?, J?, Psi?, [C?|Cs?])]).

procedure block_unexcused(Ans?, Subst?, Eqs?, Atom?, Integer?, Constant?, NSchema?, Args?, Blks).
block_unexcused(yes, _, _, _, _, _, _, _, []).
block_unexcused(no, S, E, Psi, J, Nm, NSc, PwI, R?) :-
    ground(S?), ground(E?), ground(Psi?), integer(J?), ground(Nm?), ground(NSc?), ground(PwI?) |
    inst_conj(NSc?, tg_bv, S?, E?, PwI?, C),
    linear # elim_block(C?, D),
    blk_keep(D?, Nm?, J?, Psi?, R).

procedure block_mr(MatchRes?, Atom?, Mults?, Integer?, Schema?, Constant?, NSchema?, Ctx?, Args?, Blks).
block_mr(nomatch, _, _, _, _, _, _, _, _, []).
block_mr(match(S, E), Psi, Plus, J, Sc, Nm, NSc, Cx, PwI, R?) :-
    ground(S?), ground(E?), ground(Psi?), ground(Plus?), integer(J?), ground(Sc?),
    ground(Nm?), ground(NSc?), ground(Cx?), ground(PwI?) |
    ctx_parts(Cx?, O, N),
    complete(Sc?, S?, N?, S1),
    excused(S1?, Plus?, O?, A),
    block_unexcused(A?, S?, E?, Psi?, J?, Nm?, NSc?, PwI?, R).

procedure plus_blocks(Mults?, Mults?, Integer?, Schema?, RoleSpecs?, Constant?, NSchema?, Ctx?, GAtom?, Val?, Args?, Blks).
plus_blocks([], _, _, _, _, _, _, _, _, _, _, []).
plus_blocks([M|Ms], Plus, J, Sc, Rs, Nm, NSc, Cx, G, P, PwI, R?) :-
    ground(M?), ground(Ms?), ground(Plus?), integer(J?), ground(Sc?), ground(Rs?),
    ground(Nm?), ground(NSc?), ground(Cx?), ground(G?), ground(P?), ground(PwI?) |
    plain_mult(M?, Psi),
    plus_block(Psi?, Plus?, J?, Sc?, Rs?, Nm?, NSc?, Cx?, G?, P?, PwI?, B1),
    plus_blocks(Ms?, Plus?, J?, Sc?, Rs?, Nm?, NSc?, Cx?, G?, P?, PwI?, B2),
    blks_app(B1?, B2?, R).

procedure plus_block(Atom?, Mults?, Integer?, Schema?, RoleSpecs?, Constant?, NSchema?, Ctx?, GAtom?, Val?, Args?, Blks).
plus_block(Psi, Plus, J, Sc, Rs, Nm, NSc, Cx, G, P, PwI, R?) :-
    ground(Psi?), ground(Plus?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?),
    ground(NSc?), ground(Cx?), ground(G?), ground(P?), ground(PwI?) |
    match_atom(Psi?, G?, Rs?, [bind(role(J?), P?)], [], MR),
    block_mr(MR?, Psi?, Plus?, J?, Sc?, Nm?, NSc?, Cx?, PwI?, R).

procedure n_is_party_role(NRoleSpec?, Ans).
n_is_party_role(rs(_, _, _, _, _), yes).
n_is_party_role(crs(_, _, _, _, _, _), no).

% A listed role adds at the agents of its extent, not at a person a binding
% sends it to, and the first part of clause 2 of def:unobstructed asks of it
% what the second asks of an agent role (listed_faults, below): it is passed
% by.
procedure role_blocks2(Ans?, NRoleSpec?, Integer?, Schema?, RoleSpecs?, Constant?, NSchema?, Ctx?, GAtom?, Val?, Args?, Blks).
role_blocks2(yes, NRS, J, Sc, Rs, Nm, NSc, Cx, G, P, PwI, R?) :-
    ground(NRS?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?), ground(NSc?),
    ground(Cx?), ground(G?), ground(P?), ground(PwI?) |
    nrs_add(NRS?, Plus),
    role_blocks_plus(Plus?, J?, Sc?, Rs?, Nm?, NSc?, Cx?, G?, P?, PwI?, R).
role_blocks2(no, _, _, _, _, _, _, _, _, _, _, []).

procedure role_blocks_plus(Mults?, Integer?, Schema?, RoleSpecs?, Constant?, NSchema?, Ctx?, GAtom?, Val?, Args?, Blks).
role_blocks_plus(Plus, J, Sc, Rs, Nm, NSc, Cx, G, P, PwI, R?) :-
    ground(Plus?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?), ground(NSc?),
    ground(Cx?), ground(G?), ground(P?), ground(PwI?) |
    plus_blocks(Plus?, Plus?, J?, Sc?, Rs?, Nm?, NSc?, Cx?, G?, P?, PwI?, R).

procedure role_blocks(NRoleSpecs?, Integer?, Schema?, RoleSpecs?, Constant?, NSchema?, Ctx?, GAtom?, Val?, Args?, Blks).
role_blocks([], _, _, _, _, _, _, _, _, _, []).
role_blocks([NRS|NRs], J, Sc, Rs, Nm, NSc, Cx, G, P, PwI, R?) :-
    ground(NRS?), ground(NRs?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?),
    ground(NSc?), ground(Cx?), ground(G?), ground(P?), ground(PwI?) |
    n_is_party_role(NRS?, A),
    role_blocks2(A?, NRS?, J?, Sc?, Rs?, Nm?, NSc?, Cx?, G?, P?, PwI?, B1),
    J1 := J? + 1,
    role_blocks(NRs?, J1?, Sc?, Rs?, Nm?, NSc?, Cx?, G?, P?, PwI?, B2),
    blks_app(B1?, B2?, R).

procedure schema_blocks0(Schema?, NSchema?, Ctx?, GAtom?, Val?, Args?, Blks).
schema_blocks0(Sc, NSc, Cx, G, P, PwI, R?) :-
    ground(Sc?), ground(NSc?), ground(Cx?), ground(G?), ground(P?), ground(PwI?) |
    sch_roles(Sc?, Rs),
    sch_name(Sc?, Nm),
    nsch_roles(NSc?, NRs),
    role_blocks(NRs?, 1, Sc?, Rs?, Nm?, NSc?, Cx?, G?, P?, PwI?, R).

% blocker(NC, Cx, G, P, PwI, Bs): the blocks of the forbidden atom G at the
% person P, in the order of the contract.
procedure blocker(NContract?, Ctx?, GAtom?, Val?, Args?, Blks).
blocker([], _, _, _, _, []).
blocker([S|Ss], Cx, G, P, PwI, R?) :-
    ground(S?), ground(Ss?), ground(Cx?), ground(G?), ground(P?), ground(PwI?) |
    plain_schema(S?, Sc),
    schema_blocks0(Sc?, S?, Cx?, G?, P?, PwI?, B1),
    blocker(Ss?, Cx?, G?, P?, PwI?, B2),
    blks_app(B1?, B2?, R).

% The formula saying that no block adds the atom.
procedure blks_dnf(Blks?, DNF).
blks_dnf([], []).
blks_dnf([blk(_, _, _, D)|Bs], R?) :- ground(D?), ground(Bs?) |
    blks_dnf(Bs?, R1),
    linear # dnf_app(D?, R1?, R).

procedure blks_not(Blks?, Blks, DNF).
blks_not(Bs, Bs?, N?) :- ground(Bs?) |
    blks_dnf(Bs?, D),
    linear # dnf_not(D?, N).

% --- clause 3 of def:unobstructed -----------------------------------------
% The introductory act forbids at a role no atom of a reflexive predicate
% naming that role; each one it forbids is a fault.

% The atoms as written that the role requires, those of a reflexive predicate
% naming the role left out (refl_keep, self.glp, on the atoms).
procedure n_refl_drop1(Ans?, Mult?, Mults?, Integer?, Preds?, Mults).
n_refl_drop1(yes, _, Ms, I, Rf, R?) :- ground(Ms?), integer(I?), ground(Rf?) |
    n_refl_drop(Ms?, I?, Rf?, R).
n_refl_drop1(no, M, Ms, I, Rf, [M?|R?]) :- ground(Ms?), integer(I?), ground(Rf?) |
    n_refl_drop(Ms?, I?, Rf?, R).

procedure n_refl_drop2(Atom?, Mult?, Mults?, Integer?, Preds?, Mults).
n_refl_drop2(A, M, Ms, I, Rf, R?) :- ground(A?), ground(Ms?), integer(I?), ground(Rf?) |
    own_reflexive(A?, I?, Rf?, B),
    n_refl_drop1(B?, M?, Ms?, I?, Rf?, R).

procedure n_refl_drop(Mults?, Integer?, Preds?, Mults).
n_refl_drop([], _, _, []).
n_refl_drop([M|Ms], I, Rf, R?) :- ground(M?), ground(Ms?), integer(I?), ground(Rf?) |
    plain_mult(M?, A),
    n_refl_drop2(A?, M?, Ms?, I?, Rf?, R).


procedure refl_items(Atoms?, Integer?, Constant?, Items).
refl_items([], _, _, []).
refl_items([A|As], I, Nm, [it_fault(obstructed(Nm?, I?, A?, reflexive))|R?]) :-
    ground(As?), integer(I?), ground(Nm?) |
    refl_items(As?, I?, Nm?, R).

procedure items_app(Items?, Items?, Items).
items_app([], T, T?).
items_app([X|Xs], T, [X?|R?]) :- items_app(Xs?, T?, R).

procedure faults_items(Faults?, Items).
faults_items([], []).
faults_items([F|Fs], [it_fault(F?)|R?]) :- faults_items(Fs?, R).

% --- the conditions at a role ----------------------------------------------
% Clause 1 asks each atom the role requires, but those of a reflexive
% predicate naming the role, to be supplied: it_req(I, A, D), D the formula
% saying that some schema of arity one supplies it, over the act's values
% and that schema's, named sv([I, J]) for the J-th atom.  Clause 2 asks each
% atom the role forbids to be added by no block: it_forb(I, A, Bs, N), N the
% formula saying that no block of Bs adds it.  Clause 3's faults touch no
% value.

procedure unob_req2(GAtom?, Mult?, Mults?, Integer?, Val?, Integer?, Subst?, NContract?, Args?, DNF).
unob_req2(G, M, All, J, V, I, B, NC, PwI, D?) :-
    ground(G?), ground(M?), ground(All?), integer(J?), ground(V?), integer(I?), ground(B?),
    ground(NC?), ground(PwI?) |
    once_dnf(All?, M?, G?, B?, PwI?, O),
    obtainable(NC?, G?, V?, O?, tg_sv([I?, J?]), PwI?, D).

procedure unob_req1(Atom?, Mult?, Mults?, Mults?, Integer?, Val?, Integer?, Subst?, NContract?, Args?, Items).
unob_req1(A, M, Ms, All, J, V, I, B, NC, PwI, [it_req(I?, A?, D?)|R?]) :-
    ground(A?), ground(M?), ground(Ms?), ground(All?), integer(J?), ground(V?), integer(I?),
    ground(B?), ground(NC?), ground(PwI?) |
    apply_atom(B?, A?, G),
    unob_req2(G?, M?, All?, J?, V?, I?, B?, NC?, PwI?, D),
    J1 := J? + 1,
    unob_req(Ms?, All?, J1?, V?, I?, B?, NC?, PwI?, R).

% unob_req(Req, All, J, V, I, B, NC, PwI, Its): All is every atom the role
% requires, which once_dnf counts.
procedure unob_req(Mults?, Mults?, Integer?, Val?, Integer?, Subst?, NContract?, Args?, Items).
unob_req([], _, _, _, _, _, _, _, []).
unob_req([M|Ms], All, J, V, I, B, NC, PwI, R?) :-
    ground(M?), ground(Ms?), ground(All?), integer(J?), ground(V?), integer(I?), ground(B?),
    ground(NC?), ground(PwI?) |
    plain_mult(M?, A),
    unob_req1(A?, M?, Ms?, All?, J?, V?, I?, B?, NC?, PwI?, R).

procedure unob_forb1(Atom?, Mults?, Val?, Integer?, Subst?, NContract?, Ctx?, Args?, Items).
unob_forb1(A, Ms, V, I, B, NC, Cx, PwI, [it_forb(I?, A?, Bl?, N?)|R?]) :-
    ground(A?), ground(Ms?), ground(V?), integer(I?), ground(B?), ground(NC?), ground(Cx?),
    ground(PwI?) |
    apply_atom(B?, A?, G),
    blocker(NC?, Cx?, G?, V?, PwI?, Bl0),
    blks_not(Bl0?, Bl, N),
    unob_forb(Ms?, V?, I?, B?, NC?, Cx?, PwI?, R).

procedure unob_forb(Mults?, Val?, Integer?, Subst?, NContract?, Ctx?, Args?, Items).
unob_forb([], _, _, _, _, _, _, []).
unob_forb([M|Ms], V, I, B, NC, Cx, PwI, R?) :-
    ground(M?), ground(Ms?), ground(V?), integer(I?), ground(B?), ground(NC?), ground(Cx?),
    ground(PwI?) |
    plain_mult(M?, A),
    unob_forb1(A?, Ms?, V?, I?, B?, NC?, Cx?, PwI?, R).

% The person in the role is produced by the body, so the three clauses of
% def:unobstructed are put to it through one call that can guard on it.
% Clause 1 skips a required atom of a reflexive predicate naming the role.
procedure unob_role1(Val?, Mults?, Mults?, Integer?, Constant?, Subst?, NContract?, Ctx?, Preds?, Args?, Items).
unob_role1(V, Req, Forb, I, Nm, B, NC, Cx, Rf, PwI, R?) :-
    ground(V?), ground(Req?), ground(Forb?), integer(I?), ground(Nm?),
    ground(B?), ground(NC?), ground(Cx?), ground(Rf?), ground(PwI?) |
    n_refl_drop(Req?, I?, Rf?, Req1),
    unob_req(Req1?, Req?, 1, V?, I?, B?, NC?, PwI?, F1),
    unob_forb(Forb?, V?, I?, B?, NC?, Cx?, PwI?, F2),
    plain_mults(Forb?, ForbA),
    refl_keep(ForbA?, I?, Rf?, yes, Own),
    refl_items(Own?, I?, Nm?, F3),
    items_app(F2?, F3?, F23),
    items_app(F1?, F23?, R).

% An introductory act has two roles (def:introduction), so the other role of
% the one at I is 3 - I, and clause 2 is decided against the party there.
procedure unob_roles(NRoleSpecs?, Integer?, Constant?, Subst?, NContract?, Integer?, Preds?, Args?, Items).
unob_roles([], _, _, _, _, _, _, _, []).
unob_roles([RS|Rs], I, Nm, B, NC, Fb, Rf, PwI, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(B?), ground(NC?), integer(Fb?),
    ground(Rf?), ground(PwI?) |
    nrs_del(RS?, M),
    nrs_keep(RS?, K),
    nrs_forb(RS?, N),
    apply_arg(B?, role(I?), V),
    O := 3 - I?,
    apply_arg(B?, role(O?), OV),
    mults_app(K?, M?, Req),
    unob_role1(V?, Req?, N?, I?, Nm?, B?, NC?, ctx(OV?, Fb?), Rf?, PwI?, F1),
    I1 := I? + 1,
    unob_roles(Rs?, I1?, Nm?, B?, NC?, Fb?, Rf?, PwI?, F2),
    items_app(F1?, F2?, R).

% --- clause 2 of def:unobstructed, its first part: the listed roles --------
% No listed role of a schema of C adds an atom whose predicate is that of an
% atom the introductory act forbids at a role.  Each atom A the act Nm
% forbids at its role I, and each atom a listed role J of a schema Nm2 adds
% of A's predicate, is a fault obstructed(Nm, I, A, listed_role(Nm2, J,
% Added)).  A contract with no listed role has no such fault.

procedure sh_atoms(Atoms?, Constant?, Constant?, Integer?, Atom?, Constant?, Integer?,
                   Faults?, Faults).
sh_atoms([], _, _, _, _, _, _, T, T?).
sh_atoms([atom(Q, Bs)|Xs], P, Nm2, J, A, Nm, I,
         T, [obstructed(Nm?, I?, A?, listed_role(Nm2?, J?, atom(Q?, Bs?)))|R?]) :-
    Q? =?= P?, ground(Bs?), ground(Xs?), ground(Nm2?), integer(J?), ground(A?),
    ground(Nm?), integer(I?), ground(T?) |
    sh_atoms(Xs?, P?, Nm2?, J?, A?, Nm?, I?, T?, R).
sh_atoms([atom(_, _)|Xs], P, Nm2, J, A, Nm, I, T, R?) :-
    otherwise, ground(Xs?), ground(P?), ground(Nm2?), integer(J?), ground(A?),
    ground(Nm?), integer(I?), ground(T?) |
    sh_atoms(Xs?, P?, Nm2?, J?, A?, Nm?, I?, T?, R).

procedure sh_role(Ans?, RoleSpec?, Constant?, Constant?, Integer?, Atom?, Constant?, Integer?,
                  Faults?, Faults).
sh_role(yes, _, _, _, _, _, _, _, T, T?).
sh_role(no, RS, P, Nm2, J, A, Nm, I, T, R?) :-
    ground(RS?), ground(P?), ground(Nm2?), integer(J?), ground(A?), ground(Nm?),
    integer(I?), ground(T?) |
    rs_add(RS?, Add),
    sh_atoms(Add?, P?, Nm2?, J?, A?, Nm?, I?, T?, R).

procedure sh_roles(RoleSpecs?, Integer?, Constant?, Constant?, Atom?, Constant?, Integer?,
                   Faults?, Faults).
sh_roles([], _, _, _, _, _, _, T, T?).
sh_roles([RS|Rs], J, P, Nm2, A, Nm, I, T, R?) :-
    ground(RS?), ground(Rs?), integer(J?), ground(P?), ground(Nm2?), ground(A?),
    ground(Nm?), integer(I?), ground(T?) |
    is_party_role(RS?, Pa),
    J1 := J? + 1,
    sh_roles(Rs?, J1?, P?, Nm2?, A?, Nm?, I?, T?, R1),
    sh_role(Pa?, RS?, P?, Nm2?, J?, A?, Nm?, I?, R1?, R).

procedure sh_schemas(Contract?, Constant?, Atom?, Constant?, Integer?, Faults?, Faults).
sh_schemas([], _, _, _, _, T, T?).
sh_schemas([S|Ss], P, A, Nm, I, T, R?) :-
    ground(S?), ground(Ss?), ground(P?), ground(A?), ground(Nm?), integer(I?), ground(T?) |
    sch_name(S?, Nm2),
    sch_roles(S?, Rs),
    sh_schemas(Ss?, P?, A?, Nm?, I?, T?, R1),
    sh_roles(Rs?, 1, P?, Nm2?, A?, Nm?, I?, R1?, R).

procedure sh_forb(Atoms?, Contract?, Constant?, Integer?, Faults?, Faults).
sh_forb([], _, _, _, T, T?).
sh_forb([atom(P, As)|Xs], C, Nm, I, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(C?), ground(Nm?), integer(I?), ground(T?) |
    sh_forb(Xs?, C?, Nm?, I?, T?, R1),
    sh_schemas(C?, P?, atom(P?, As?), Nm?, I?, R1?, R).

procedure listed_faults(RoleSpecs?, Integer?, Constant?, Contract?, Faults).
listed_faults([], _, _, _, []).
listed_faults([RS|Rs], I, Nm, C, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(C?) |
    rs_forb(RS?, N),
    I1 := I? + 1,
    listed_faults(Rs?, I1?, Nm?, C?, R1),
    sh_forb(N?, C?, Nm?, I?, R1?, R).



% --- an introduction and its values ---------------------------------------
% An introduction is a binding of the introductory act (def:introduction):
% intro_bindings enumerates the assignments of its agent and speech-act
% variables, and for each the act's values are those the introduction
% chooses (the appendix "Values in Speech-Act Schemas"), each bound to its image
% nfree (sym_binds).  The binding satisfies the act's constraint and sends
% each multiplicity to a positive whole number (def:binding-numbers): the
% base conjunction, with the act's rational values written n + f
% (linear.glp, decomp_defs).  Where the base has no solution the assignment
% is no introduction; otherwise it is one at some values where the base
% and every condition of every role (Items) have a solution together, and
% the clauses fail there otherwise.  The faults reported are then each
% condition that no choice of the values meets with the base, in the order
% of the roles, and the faults the values do not touch; where every
% condition is met at some choice, but none meets them all, the fault is
% obstructed_jointly(Act).

% Each value variable bound to the value the introduction chooses.
procedure sym_binds(Args?, Subst?, Subst).
sym_binds([], B, B?).
sym_binds([num(X)|Vs], B, [bind(num(X?), nfree(X?))|R?]) :-
    ground(X?), ground(Vs?), ground(B?) |
    sym_binds(Vs?, B?, R).
sym_binds([A|Vs], B, R?) :- otherwise, ground(A?), ground(Vs?), ground(B?) |
    sym_binds(Vs?, B?, R).

procedure intro_env(Args?, Args?, VEnv).
intro_env([], _, []).
intro_env([num(X)|Vs], Pw, [vb(X?, V?)|R?]) :- ground(X?), ground(Vs?), ground(Pw?) |
    ivar(X?, Pw?, V),
    intro_env(Vs?, Pw?, R).
intro_env([_|Vs], Pw, R?) :- otherwise | intro_env(Vs?, Pw?, R).

procedure env_qnames(VEnv?, Constants).
env_qnames([], []).
env_qnames([vb(X, q(_))|E], [X?|R?]) :- env_qnames(E?, R).
env_qnames([vb(_, z(_))|E], R?) :- env_qnames(E?, R).

% The base: the act's constraint, its multiplicities at least one, and its
% rational values written n + f.
procedure base_conj(Args?, Constraint?, Args?, Conj).
base_conj(Vs, Cn, Pw, R?) :- ground(Vs?), ground(Cn?), ground(Pw?) |
    intro_env(Vs?, Pw?, Env),
    base_conj1(Env?, Cn?, R).

procedure base_conj1(VEnv?, Constraint?, Conj).
base_conj1(Env, Cn, R?) :- ground(Env?), ground(Cn?) |
    env_bounds(Env?, Bn),
    env_qnames(Env?, Qs),
    linear # decomp_defs(Qs?, Df),
    linear # cons_conj(Cn?, Env?, C),
    linear # conj_app(Bn?, Df?, BD),
    linear # conj_app(BD?, C?, R).

% The formulas the conditions put to the values, and whether a fault the
% values do not touch is among them.
procedure items_dnfs(Items?, DNFs).
items_dnfs([], []).
items_dnfs([it_req(_, _, D)|Is], [D?|R?]) :- items_dnfs(Is?, R).
items_dnfs([it_forb(_, _, _, N)|Is], [N?|R?]) :- items_dnfs(Is?, R).
items_dnfs([it_fault(_)|Is], R?) :- items_dnfs(Is?, R).

procedure items_struct(Items?, Ans).
items_struct([], no).
items_struct([it_fault(_)|_], yes).
items_struct([it_req(_, _, _)|Is], R?) :- items_struct(Is?, R).
items_struct([it_forb(_, _, _, _)|Is], R?) :- items_struct(Is?, R).

% The first block that adds the atom at some choice of the values.  Where
% no choice escapes every block, some block adds it at some choice, so the
% list is never exhausted; were it, the cause would name no schema.
procedure first_blk(Blks?, Conj?, Cause).
first_blk([], _, blocked_by(none, 0, atom(none, []))).
first_blk([blk(Nm, J, Psi, D)|Bs], Base, R?) :-
    ground(Nm?), integer(J?), ground(Psi?), ground(D?), ground(Bs?), ground(Base?) |
    linear # sat_prod(Base?, [D?], A),
    first_blk1(A?, Nm?, J?, Psi?, Bs?, Base?, R).

procedure first_blk1(Ans?, Constant?, Integer?, Atom?, Blks?, Conj?, Cause).
first_blk1(yes, Nm, J, Psi, _, _, blocked_by(Nm?, J?, Psi?)).
first_blk1(no, _, _, _, Bs, Base, R?) :- first_blk(Bs?, Base?, R).

procedure item_fault(Ans?, Item?, Constant?, Conj?, Faults?, Faults).
item_fault(yes, _, _, _, T, T?).
item_fault(no, it_req(I, A, _), Nm, _, T, [obstructed(Nm?, I?, A?, unobtainable)|T?]).
item_fault(no, it_forb(I, A, Bs, _), Nm, Base, T, [obstructed(Nm?, I?, A?, C?)|T?]) :-
    ground(Bs?), ground(Base?) |
    first_blk(Bs?, Base?, C).
item_fault(no, it_fault(F), _, _, T, [F?|T?]).

procedure item_met(Item?, Conj?, Ans).
item_met(it_req(_, _, D), Base, R?) :- ground(D?), ground(Base?) | linear # sat_prod(Base?, [D?], R).
item_met(it_forb(_, _, _, N), Base, R?) :- ground(N?), ground(Base?) | linear # sat_prod(Base?, [N?], R).
item_met(it_fault(_), _, no).

procedure items_faults(Items?, Conj?, Constant?, Faults).
items_faults([], _, _, []).
items_faults([X|Xs], Base, Nm, R?) :- ground(X?), ground(Xs?), ground(Base?), ground(Nm?) |
    item_met(X?, Base?, A),
    items_faults(Xs?, Base?, Nm?, R1),
    item_fault(A?, X?, Nm?, Base?, R1?, R).

procedure joint_fault(Faults?, Constant?, Faults).
joint_fault([], Nm, [obstructed_jointly(Nm?)]).
joint_fault([F|Fs], _, [F?|Fs?]).

procedure decide2(Ans?, Items?, Conj?, Constant?, Try).
decide2(yes, _, _, _, t_ok).
decide2(no, Its, Base, Nm, t_bad(F?)) :- ground(Its?), ground(Base?), ground(Nm?) |
    items_faults(Its?, Base?, Nm?, F0),
    joint_fault(F0?, Nm?, F).

procedure decide1(Ans?, DNFs?, Items?, Conj?, Constant?, Try).
decide1(yes, _, Its, Base, Nm, R?) :- decide2(no, Its?, Base?, Nm?, R).
decide1(no, Ds, Its, Base, Nm, R?) :- ground(Ds?), ground(Its?), ground(Base?), ground(Nm?) |
    linear # sat_prod(Base?, Ds?, A),
    decide2(A?, Its?, Base?, Nm?, R).

procedure decide(Items?, Conj?, Constant?, Try).
decide(Its, Base, Nm, R?) :- ground(Its?), ground(Base?), ground(Nm?) |
    items_struct(Its?, A),
    items_dnfs(Its?, Ds),
    decide1(A?, Ds?, Its?, Base?, Nm?, R).

% The conditions of def:unobstructed at the introduction B of the act Sc,
% written NSc, in the contract written NC, its plain form C, Rf being the
% predicates the contract declares reflexive, those of the listed roles last.
procedure intro_items(Schema?, NSchema?, Subst?, NContract?, Contract?, Preds?, Args?, Items).
intro_items(Sc, NSc, B, NC, C, Rf, PwI, R?) :-
    ground(Sc?), ground(NSc?), ground(B?), ground(NC?), ground(C?), ground(Rf?), ground(PwI?) |
    sch_name(Sc?, Nm),
    sch_roles(Sc?, Rs),
    nsch_roles(NSc?, NRs),
    fresh_base(Sc?, N),
    intro_items1(NRs?, Rs?, Nm?, B?, NC?, C?, N?, Rf?, PwI?, R).

procedure intro_items1(NRoleSpecs?, RoleSpecs?, Constant?, Subst?, NContract?, Contract?, Integer?, Preds?, Args?, Items).
intro_items1(NRs, Rs, Nm, B, NC, C, N, Rf, PwI, R?) :-
    ground(NRs?), ground(Rs?), ground(Nm?), ground(B?), ground(NC?), ground(C?),
    integer(N?), ground(Rf?), ground(PwI?) |
    unob_roles(NRs?, 1, Nm?, B?, NC?, N?, Rf?, PwI?, F1),
    listed_faults(Rs?, 1, Nm?, C?, F2),
    faults_items(F2?, I2),
    items_app(F1?, I2?, R).

% One assignment B of the act's agent and speech-act variables.
procedure intro_b(Subst?, IntroCtx?, Try).
intro_b(B, ic(S, NS, NC, C, Rf), R?) :-
    ground(B?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?) |
    sch_vvars(NS?, Vs),
    num_ctx(NS?, Nx),
    intro_b1(Vs?, Nx?, B?, ic(S?, NS?, NC?, C?, Rf?), R).

procedure intro_b1(Args?, NumCtx?, Subst?, IntroCtx?, Try).
intro_b1(Vs, nc(Cn, Pw), B, Ix, R?) :-
    ground(Vs?), ground(Cn?), ground(Pw?), ground(B?), ground(Ix?) |
    sym_binds(Vs?, B?, Bv),
    base_conj(Vs?, Cn?, Pw?, Base),
    intro_b2(Base?, Bv?, Pw?, Ix?, R).

procedure intro_b2(Conj?, Subst?, Args?, IntroCtx?, Try).
intro_b2(Base, Bv, Pw, Ix, R?) :- ground(Base?), ground(Bv?), ground(Pw?), ground(Ix?) |
    linear # sat_conj(Base?, A),
    intro_b3(A?, Base?, Bv?, Pw?, Ix?, R).

procedure intro_b3(Ans?, Conj?, Subst?, Args?, IntroCtx?, Try).
intro_b3(no, _, _, _, _, t_none).
intro_b3(yes, Base, Bv, Pw, ic(S, NS, NC, C, Rf), R?) :-
    ground(Base?), ground(Bv?), ground(Pw?), ground(S?), ground(NS?), ground(NC?),
    ground(C?), ground(Rf?) |
    sch_name(S?, Nm),
    intro_items(S?, NS?, Bv?, NC?, C?, Rf?, Pw?, Its),
    decide(Its?, Base?, Nm?, R).

% --- def:syntactically-grassroots, first half ------------------------------
% Some schema is an introductory act unobstructed at some introduction.  The
% faults reported are those of the first introductory act at its first
% assignment that fails.

procedure note_cand(Cand?, Faults?, Cand).
note_cand(none, F, some(F?)).
note_cand(some(F), _, some(F?)).

procedure scan_end(Cand?, Faults).
scan_end(some(F), F?).
scan_end(none, [no_introductory_act]).

procedure intro_try1(Try?, Substs?, Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, Cand?, Faults).
intro_try1(t_ok, _, _, _, _, _, _, _, _, []).
intro_try1(t_bad(F), Bs, S, NS, NSs, NC, C, Rf, Ca, R?) :-
    ground(F?), ground(Bs?), ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?),
    ground(Rf?), ground(Ca?) |
    note_cand(Ca?, F?, Ca1),
    intro_try(Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Ca1?, R).
intro_try1(t_none, Bs, S, NS, NSs, NC, C, Rf, Ca, R?) :-
    ground(Bs?), ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?),
    ground(Ca?) |
    intro_try(Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Ca?, R).

procedure intro_try(Substs?, Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, Cand?, Faults).
intro_try([], _, _, NSs, NC, C, Rf, Ca, R?) :-
    ground(NSs?), ground(NC?), ground(C?), ground(Rf?), ground(Ca?) |
    intro_scan(NSs?, NC?, C?, Rf?, Ca?, R).
intro_try([B|Bs], S, NS, NSs, NC, C, Rf, Ca, R?) :-
    ground(B?), ground(Bs?), ground(S?), ground(NS?), ground(NSs?), ground(NC?),
    ground(C?), ground(Rf?), ground(Ca?) |
    intro_b(B?, ic(S?, NS?, NC?, C?, Rf?), T),
    intro_try1(T?, Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Ca?, R).

procedure intro_scan1(Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, Cand?, Faults).
intro_scan1(S, NS, NSs, NC, C, Rf, Ca, R?) :-
    ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?), ground(Ca?) |
    intro_act_bindings(S?, Bs),
    intro_try(Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Ca?, R).

procedure intro_scan(NContract?, NContract?, Contract?, Preds?, Cand?, Faults).
intro_scan([], _, _, _, Ca, R?) :- ground(Ca?) | scan_end(Ca?, R).
intro_scan([NS|NSs], NC, C, Rf, Ca, R?) :-
    ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?), ground(Ca?) |
    plain_schema(NS?, S),
    intro_scan1(S?, NS?, NSs?, NC?, C?, Rf?, Ca?, R).

procedure intro_result1(NContract?, Contract?, Preds?, Faults).
intro_result1(NC, C, Rf, R?) :- ground(NC?), ground(C?), ground(Rf?) |
    intro_scan(NC?, NC?, C?, Rf?, none, R).

% intro_result(NC, Rf, Faults): NC is the contract as written, Rf the
% predicates it declares reflexive.
exported procedure intro_result(NContract?, Preds?, Faults).
intro_result(NC, Rf, R?) :- ground(NC?), ground(Rf?) |
    plain_contract(NC?, C),
    intro_result1(NC?, C?, Rf?, R).

% intro_result_env(NC, Rf, Ev, Faults): as intro_result, the contract naming
% the environment predicates Ev (GSC 25b6b3c, the appendix "Values in Act
% Schemas": "an unobstructed introductory act requires no environment atom,
% clause 1 of Definition unobstructed admitting only atoms a schema adds, and
% forbids none").  A schema requiring or forbidding at a role an atom of a
% predicate of Ev is no candidate, and, where no candidate is unobstructed,
% each such schema that has an introduction adds the fault obstructed(Nm, I,
% A, environment) for each such atom A at its role I.
exported procedure intro_result_env(NContract?, Preds?, Preds?, Faults).
intro_result_env(NC, Rf, [], R?) :- ground(NC?), ground(Rf?) | intro_result(NC?, Rf?, R).
intro_result_env(NC, Rf, [P|Ps], R?) :- ground(NC?), ground(Rf?), ground(P?), ground(Ps?) |
    plain_contract(NC?, C),
    env_split(NC?, [P?|Ps?], NCf, EF),
    intro_scan(NCf?, NC?, C?, Rf?, none, R0),
    env_faults(R0?, EF?, R).
procedure env_faults(Faults?, Faults?, Faults).
env_faults([], _, []).
env_faults([F|Fs], EF, R?) :- ground(F?), ground(Fs?), ground(EF?) | faults_app([F?|Fs?], EF?, R).
% The schemas touching no environment atom at a role they require or forbid it, and the faults of those that do and have an introduction.
procedure env_split(NContract?, Preds?, NContract, Faults).
env_split([], _, [], []).
env_split([NS|NSs], Ev, NCf?, EF?) :- ground(NS?), ground(NSs?), ground(Ev?) |
    plain_schema(NS?, S),
    nsch_name(NS?, Nm),
    nsch_roles(NS?, Rs),
    env_roles(Rs?, 1, Nm?, Ev?, F1),
    env_split(NSs?, Ev?, NCf1, EF1),
    env_keep(F1?, NS?, S?, NCf1?, EF1?, NCf, EF).
procedure env_keep(Faults?, NSchema?, Schema?, NContract?, Faults?, NContract, Faults).
env_keep([], NS, _, NCf, EF, [NS?|NCf?], EF?).
env_keep([F|Fs], _, S, NCf, EF, NCf?, EF2?) :- ground(F?), ground(Fs?), ground(S?), ground(EF?) |
    intro_act_bindings(S?, Bs),
    env_keep1(Bs?, [F?|Fs?], EF?, EF2).
procedure env_keep1(Substs?, Faults?, Faults?, Faults).
env_keep1([], _, EF, EF?).
env_keep1([_|_], F, EF, R?) :- ground(F?), ground(EF?) | faults_app(F?, EF?, R).
procedure env_roles(NRoleSpecs?, Integer?, Constant?, Preds?, Faults).
env_roles([], _, _, _, []).
env_roles([R|Rs], I, Nm, Ev, F?) :- ground(R?), integer(I?), ground(Nm?), ground(Ev?) |
    nrs_kf(R?, K, N),
    env_atoms(K?, I?, Nm?, Ev?, F1),
    env_atoms(N?, I?, Nm?, Ev?, F2),
    I1 := I? + 1,
    env_roles(Rs?, I1?, Nm?, Ev?, F3),
    faults_app(F1?, F2?, F12),
    faults_app(F12?, F3?, F).
procedure nrs_kf(NRoleSpec?, Mults, Mults).
nrs_kf(rs(_, _, _, K, N), K?, N?).
nrs_kf(crs(_, _, _, _, K, N), K?, N?).
procedure env_atoms(Mults?, Integer?, Constant?, Preds?, Faults).
env_atoms([], _, _, _, []).
env_atoms([times(_, A)|As], I, Nm, Ev, F?) :- env_atoms([A?|As?], I?, Nm?, Ev?, F).
env_atoms([atom(P, Xs)|As], I, Nm, Ev, F?) :- ground(P?), ground(Xs?), integer(I?), ground(Nm?), ground(Ev?) |
    pred_member(P?, Ev?, B),
    env_atom(B?, atom(P?, Xs?), I?, Nm?, F1),
    env_atoms(As?, I?, Nm?, Ev?, F2),
    faults_app(F1?, F2?, F).
procedure env_atom(Ans?, Atom?, Integer?, Constant?, Faults).
env_atom(yes, A, I, Nm, [obstructed(Nm?, I?, A?, environment)]).
env_atom(no, _, _, _, []).

% --- the introductory acts, for inspection ---------------------------------
% Each schema of the contract that is an introductory act (def:introduction),
% in the order of the contract: unobstructed where some introduction of it
% meets def:unobstructed, as intro_result decides it, and obstructed(Faults)
% otherwise, the faults of its first assignment, as intro_result reports
% them for the first introductory act.

IAS ::= ia(IntroStatus) ; ia_none.

procedure ia_end(Cand?, IAS).
ia_end(some(F), ia(obstructed(F?))).
ia_end(none, ia_none).

procedure ia_status1(Try?, Substs?, Schema?, NSchema?, NContract?, Contract?, Preds?, Cand?, IAS).
ia_status1(t_ok, _, _, _, _, _, _, _, ia(unobstructed)).
ia_status1(t_bad(F), Bs, S, NS, NC, C, Rf, Ca, R?) :-
    ground(F?), ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?),
    ground(Ca?) |
    note_cand(Ca?, F?, Ca1),
    ia_status(Bs?, S?, NS?, NC?, C?, Rf?, Ca1?, R).
ia_status1(t_none, Bs, S, NS, NC, C, Rf, Ca, R?) :-
    ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?), ground(Ca?) |
    ia_status(Bs?, S?, NS?, NC?, C?, Rf?, Ca?, R).

procedure ia_status(Substs?, Schema?, NSchema?, NContract?, Contract?, Preds?, Cand?, IAS).
ia_status([], _, _, _, _, _, Ca, R?) :- ground(Ca?) | ia_end(Ca?, R).
ia_status([B|Bs], S, NS, NC, C, Rf, Ca, R?) :-
    ground(B?), ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?),
    ground(Rf?), ground(Ca?) |
    intro_b(B?, ic(S?, NS?, NC?, C?, Rf?), T),
    ia_status1(T?, Bs?, S?, NS?, NC?, C?, Rf?, Ca?, R).

% A schema with an introduction is an introductory act, and is listed.
procedure ia_add1(IAS?, Constant?, IntroActs?, IntroActs).
ia_add1(ia(St), Nm, T, [intro_act(Nm?, St?)|T?]).
ia_add1(ia_none, _, T, T?).

procedure ia_add(Substs?, Schema?, NSchema?, NContract?, Contract?, Preds?, IntroActs?, IntroActs).
ia_add(Bs, S, NS, NC, C, Rf, T, R?) :-
    ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?), ground(T?) |
    sch_name(S?, Nm),
    ia_status(Bs?, S?, NS?, NC?, C?, Rf?, none, St),
    ia_add1(St?, Nm?, T?, R).

procedure ia_scan1(Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, IntroActs).
ia_scan1(S, NS, NSs, NC, C, Rf, R?) :-
    ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?) |
    intro_act_bindings(S?, Bs),
    ia_scan(NSs?, NC?, C?, Rf?, R1),
    ia_add(Bs?, S?, NS?, NC?, C?, Rf?, R1?, R).

procedure ia_scan(NContract?, NContract?, Contract?, Preds?, IntroActs).
ia_scan([], _, _, _, []).
ia_scan([NS|NSs], NC, C, Rf, R?) :-
    ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?) |
    plain_schema(NS?, S),
    ia_scan1(S?, NS?, NSs?, NC?, C?, Rf?, R).

procedure intro_acts1(NContract?, Contract?, Preds?, IntroActs).
intro_acts1(NC, C, Rf, R?) :- ground(NC?), ground(C?), ground(Rf?) |
    ia_scan(NC?, NC?, C?, Rf?, R).

% intro_acts(NC, Rf, Acts): NC is the contract as written, Rf the predicates
% it declares reflexive.
exported procedure intro_acts(NContract?, Preds?, IntroActs).
intro_acts(NC, Rf, R?) :- ground(NC?), ground(Rf?) |
    plain_contract(NC?, C),
    intro_acts1(NC?, C?, Rf?, R).
