% ---------------------------------------------------------------------------
% The introductory act (def:introduction) and unobstructedness
% (def:unobstructed) of /Grassroots/GSC, Section 3.6, for a contract of agent
% roles and listed roles alike (GSC ac7ad63).
%
% Both definitions quantify over all distinct p and q.  The schemas name no
% person (prop:anonymity), so one pair stands for every pair, and the bindings
% over it are finite: person(0) and person(1) take the two roles, each party
% variable takes one of the two, and each speech-act variable a speech act of
% its own.  intro_bindings enumerates them and keeps the introductions.  An
% introduction chooses its own values (the appendix "Values in Act
% Schemas", after def:binding-numbers), and the search of introductions
% below chooses them.  The clauses are decided on the contract as written, a
% value matched by equality at a binding satisfying its schema's constraint
% (values, below).
%
% An introductory act is guarded in both its roles, which are therefore
% agent roles, and has no name term (def:introduction); so has each schema
% of arity one of clause 1 of def:unobstructed.  A listed role adds at the
% agents of its extent, which no binding names, so the second part of clause
% 2 of def:unobstructed is asked of the agent roles of a schema, and its
% first part of the listed roles: none adds an atom of the predicate of an
% atom the introductory act forbids at a role.
% ---------------------------------------------------------------------------

% --- the introductions of person(0) and person(1) --------------------------

procedure svar_binds(Args?, Integer?, Subst).
svar_binds([], _, []).
svar_binds([A|As], N, [bind(A?, speech(N?))|R?]) :- ground(A?), ground(As?), integer(N?) |
    N1 := N? + 1,
    svar_binds(As?, N1?, R).

procedure extend_each(Substs?, Arg?, Substs).
extend_each([], _, []).
extend_each([S|Ss], A, [[bind(A?, person(0))|S?], [bind(A?, person(1))|S?]|R?]) :-
    ground(S?), ground(A?), ground(Ss?) |
    extend_each(Ss?, A?, R).

procedure pvar_assignments(Args?, Substs).
pvar_assignments([], [[]]).
pvar_assignments([A|As], R?) :- ground(A?), ground(As?) |
    pvar_assignments(As?, Rs),
    extend_each(Rs?, A?, R).

% gatom_has(G, V, R): the image G names V -- V is among its arguments or is
% the person of a signed value among them (Section 3.1: an atom names what is
% among its arguments or is the signer of one, the role of a signed term
% included).
procedure val_names(Val?, Val?, Ans).
val_names(W, V, yes) :- W? =?= V? | true.
val_names(signed(_, P), V, yes) :- P? =?= V? | true.
val_names(_, _, no) :- otherwise | true.

procedure vals_name1(Ans?, Vals?, Val?, Ans).
vals_name1(yes, _, _, yes).
vals_name1(no, Ws, V, R?) :- ground(Ws?), ground(V?) | vals_name(Ws?, V?, R).

procedure vals_name(Vals?, Val?, Ans).
vals_name([], _, no).
vals_name([W|Ws], V, R?) :- ground(W?), ground(Ws?), ground(V?) |
    val_names(W?, V?, A),
    vals_name1(A?, Ws?, V?, R).

procedure gatom_has(GAtom?, Val?, Ans).
gatom_has(gatom(_, Vs), V, R?) :- ground(Vs?), ground(V?) | vals_name(Vs?, V?, R).

procedure atoms_name1(Ans?, Atoms?, Subst?, Val?, Ans).
atoms_name1(yes, _, _, _, yes).
atoms_name1(no, As, B, V, R?) :- ground(As?), ground(B?), ground(V?) |
    atoms_name(As?, B?, V?, R).

% atoms_name(Phis, B, V, R): some atom of B(Phis) has V among its arguments.
procedure atoms_name(Atoms?, Subst?, Val?, Ans).
atoms_name([], _, _, no).
atoms_name([A|As], B, V, R?) :- ground(A?), ground(As?), ground(B?), ground(V?) |
    apply_atom(B?, A?, G),
    gatom_has(G?, V?, H),
    atoms_name1(H?, As?, B?, V?, R).

procedure is_intro_roles(RoleSpecs?, Subst?, Ans).
is_intro_roles([rs(_, P1, _, _, _), rs(_, P2, _, _, _)], B, R?) :-
    ground(P1?), ground(P2?), ground(B?) |
    atoms_name(P1?, B?, person(1), A1),
    atoms_name(P2?, B?, person(0), A2),
    both_yes(A1?, A2?, R).
is_intro_roles(Rs, _, no) :- otherwise, ground(Rs?) | true.

procedure is_intro(Schema?, Subst?, Ans).
is_intro(Sc, B, R?) :- ground(Sc?), ground(B?) |
    sch_roles(Sc?, Rs),
    is_intro_roles(Rs?, B?, R).

procedure intro_keep(Ans?, Subst?, Substs?, Subst?, Schema?, Substs).
intro_keep(yes, B, PAs, SB, Sc, [B?|R?]) :-
    ground(B?), ground(PAs?), ground(SB?), ground(Sc?) |
    intro_filter(PAs?, SB?, Sc?, R).
intro_keep(no, _, PAs, SB, Sc, R?) :- ground(PAs?), ground(SB?), ground(Sc?) |
    intro_filter(PAs?, SB?, Sc?, R).

procedure intro_filter2(Subst?, Schema?, Substs?, Subst?, Substs).
intro_filter2(S0, Sc, PAs, SB, R?) :-
    ground(S0?), ground(Sc?), ground(PAs?), ground(SB?) |
    is_intro(Sc?, [bind(role(1), person(0)), bind(role(2), person(1))|S0?], Ok),
    intro_keep(Ok?, [bind(role(1), person(0)), bind(role(2), person(1))|S0?],
               PAs?, SB?, Sc?, R).

procedure intro_filter(Substs?, Subst?, Schema?, Substs).
intro_filter([], _, _, []).
intro_filter([PA|PAs], SB, Sc, R?) :-
    ground(PA?), ground(PAs?), ground(SB?), ground(Sc?) |
    subst_app(SB?, PA?, S0),
    intro_filter2(S0?, Sc?, PAs?, SB?, R).

procedure intro_bindings(Schema?, Substs).
intro_bindings(Sc, R?) :- ground(Sc?) |
    schema_svars(Sc?, SV),
    svar_binds(SV?, 0, SB),
    schema_pvars(Sc?, PV),
    pvar_assignments(PV?, PAs),
    intro_filter(PAs?, SB?, Sc?, R).

% Arity two, both roles guarded, so agent roles, and no name term
% (def:introduction).
procedure two_guarded(RoleSpecs?, Ans).
two_guarded([rs(guarded, _, _, _, _), rs(guarded, _, _, _, _)], yes).
two_guarded(Rs, no) :- otherwise, ground(Rs?) | true.

procedure is_two_guarded(Schema?, Ans).
is_two_guarded(Sc, R?) :- ground(Sc?) |
    sch_roles(Sc?, Rs),
    two_guarded(Rs?, A1),
    sch_nts(Sc?, Ns),
    nts_empty(Ns?, A2),
    both_yes(A1?, A2?, R).

procedure iab1(Ans?, Schema?, Substs).
iab1(no, _, []).
iab1(yes, Sc, R?) :- ground(Sc?) | intro_bindings(Sc?, R).

% The introductions of a schema, empty unless it is an introductory act.
% The search for an introduction with wards reads it too (wards).
exported procedure intro_act_bindings(Schema?, Substs).
intro_act_bindings(Sc, R?) :- ground(Sc?) |
    is_two_guarded(Sc?, A),
    iab1(A?, Sc?, R).


% --- values (GSC, Section 3.2; def:numbers, def:binding-numbers) -----------
% "Act schemas allow values of any type: an argument of an atom may be a
% value or a value variable, a schema may carry a constraint on its value
% variables, which every binding satisfies, and an atom added or deleted may
% carry a multiplicity, a count of copies and so a positive whole number"
% (Section 3.2).  A binding maps each value variable to a value, under which
% the constraint holds and every multiplicity is a positive whole number
% (def:binding-numbers); the values are of any type, the contract parametric
% in them, and an introduction chooses its own (the appendix "Values in Act
% Schemas").  The term form writes a value as a number, num(X), and its
% constraints compare numbers, so a value variable a constraint mentions
% ranges over the numbers, and one used as a multiplicity over the positive
% whole numbers.
%
% def:unobstructed asks of an atom that some schema add it at a binding, so
% the binding satisfies that schema's constraint and the atom is in the
% multiset it adds.  The two clauses are decided on the contract as written,
% a value matched by equality (match_num, self.glp).  The value of an
% argument at a binding is known(N), the number N; free(X), the value
% variable X of a schema other than the introductory act, which the match
% leaves free and which that schema's binding chooses; or sym, a value
% variable of the introductory act, which the search of introductions below
% chooses.  A constraint holds at some binding sending its free variables to
% values when one of its disjuncts does, each disjunct comparing two values or
% a value and its successor (cons_sat): a free variable can be made larger or
% smaller than any number, and one used as a multiplicity any positive whole
% number.  Where it rests on sym the answer is unsettled, and the search
% decides it by choosing the values.

procedure num_v(Subst?, Arg?, NumV).
num_v(_, num(X), known(X?)) :- number(X?) | true.
num_v(S, num(X), R?) :- otherwise, ground(S?), ground(X?) |
    subst_lookup(S?, num(X?), F),
    num_v1(F?, X?, R).
num_v(_, A, sym) :- otherwise, ground(A?) | true.

procedure num_v1(Found?, Constant?, NumV).
num_v1(bound(nval(N)), _, known(N?)).
num_v1(bound(nfree(_)), _, sym).
num_v1(free, X, free(num(X?))).
num_v1(bound(V), _, sym) :- otherwise, ground(V?) | true.

procedure tri_and(Tri?, Tri?, Tri).
tri_and(no, _, no).
tri_and(yes, T, T?).
tri_and(unsettled, no, no).
tri_and(unsettled, yes, unsettled).
tri_and(unsettled, unsettled, unsettled).

procedure tri_or(Tri?, Tri?, Tri).
tri_or(yes, _, yes).
tri_or(no, T, T?).
tri_or(unsettled, yes, yes).
tri_or(unsettled, no, unsettled).
tri_or(unsettled, unsettled, unsettled).

procedure ans_tri(Ans?, Tri).
ans_tri(yes, yes).
ans_tri(no, no).

procedure tri_eq(Constant?, Constant?, Tri).
tri_eq(X, Y, yes) :- X? =:= Y? | true.
tri_eq(_, _, no) :- otherwise | true.

% Whether the free variable A ranges over the positive whole numbers, being a
% multiplicity of its schema (Pw), or over the numbers.
procedure is_pw(Args?, Arg?, Ans).
is_pw(Pw, A, R?) :- ground(Pw?), ground(A?) | args_member(Pw?, A?, R).

procedure distinct_tri(Arg?, Arg?, Tri).
distinct_tri(A, B, no) :- A? =?= B? | true.
distinct_tri(_, _, yes) :- otherwise | true.

% Some value below X: any number, or a positive whole number where X > 1.
procedure below_tri(Ans?, Constant?, Tri).
below_tri(no, _, yes).
below_tri(yes, X, yes) :- X? > 1 | true.
below_tri(yes, X, no) :- X? =< 1 | true.

% Some value at most X: any number, or a positive whole number where X >= 1.
procedure atmost_tri(Ans?, Constant?, Tri).
atmost_tri(no, _, yes).
atmost_tri(yes, X, yes) :- X? >= 1 | true.
atmost_tri(yes, X, no) :- X? < 1 | true.

% The value N: any number, or a positive whole number where N is one.
procedure exact_tri(Ans?, Constant?, Tri).
exact_tri(no, _, yes).
exact_tri(yes, N, R?) :- number(N?) |
    pos_whole(N?, A),
    ans_tri(A?, R).

% sat_gt(A, B, Pw, R): some values of the free ones among A and B make A > B.
procedure sat_gt(NumV?, NumV?, Args?, Tri).
sat_gt(known(X), known(Y), _, yes) :- X? > Y? | true.
sat_gt(known(X), known(Y), _, no) :- X? =< Y? | true.
sat_gt(free(_), known(_), _, yes).
sat_gt(known(X), free(B), Pw, R?) :- number(X?), ground(B?), ground(Pw?) |
    is_pw(Pw?, B?, P),
    below_tri(P?, X?, R).
sat_gt(free(A), free(B), _, R?) :- ground(A?), ground(B?) | distinct_tri(A?, B?, R).
sat_gt(_, _, _, unsettled) :- otherwise | true.

% sat_le(A, B, Pw, R): some values make A =< B.
procedure sat_le(NumV?, NumV?, Args?, Tri).
sat_le(known(X), known(Y), _, yes) :- X? =< Y? | true.
sat_le(known(X), known(Y), _, no) :- X? > Y? | true.
sat_le(free(A), known(Y), Pw, R?) :- ground(A?), number(Y?), ground(Pw?) |
    is_pw(Pw?, A?, P),
    atmost_tri(P?, Y?, R).
sat_le(known(_), free(_), _, yes).
sat_le(free(_), free(_), _, yes).
sat_le(_, _, _, unsettled) :- otherwise | true.

% sat_succ(A, B, Pw, R): some values make B = A + 1.
procedure sat_succ(NumV?, NumV?, Args?, Tri).
sat_succ(known(X), known(Y), _, R?) :- number(X?), number(Y?) |
    Z := X? + 1,
    tri_eq(Z?, Y?, R).
sat_succ(free(A), known(Y), Pw, R?) :- ground(A?), number(Y?), ground(Pw?) |
    is_pw(Pw?, A?, P),
    Z := Y? - 1,
    exact_tri(P?, Z?, R).
sat_succ(known(X), free(B), Pw, R?) :- number(X?), ground(B?), ground(Pw?) |
    is_pw(Pw?, B?, P),
    Z := X? + 1,
    exact_tri(P?, Z?, R).
sat_succ(free(A), free(B), _, R?) :- ground(A?), ground(B?) | distinct_tri(A?, B?, R).
sat_succ(_, _, _, unsettled) :- otherwise | true.

% cons_sat(C, S, Pw, R): some binding extending S, sending its free value
% variables to values, the multiplicities among them, Pw, to positive whole
% numbers, satisfies the constraint C.
procedure cons_sat(Constraint?, Subst?, Args?, Tri).
cons_sat(true, _, _, yes).
cons_sat(gt(A, B), S, Pw, R?) :- ground(A?), ground(B?), ground(S?), ground(Pw?) |
    num_v(S?, A?, VA),
    num_v(S?, B?, VB),
    sat_gt(VA?, VB?, Pw?, R).
cons_sat(le(A, B), S, Pw, R?) :- ground(A?), ground(B?), ground(S?), ground(Pw?) |
    num_v(S?, A?, VA),
    num_v(S?, B?, VB),
    sat_le(VA?, VB?, Pw?, R).
cons_sat(succ(A, B), S, Pw, R?) :- ground(A?), ground(B?), ground(S?), ground(Pw?) |
    num_v(S?, A?, VA),
    num_v(S?, B?, VB),
    sat_succ(VA?, VB?, Pw?, R).
cons_sat(or(C1, C2), S, Pw, R?) :- ground(C1?), ground(C2?), ground(S?), ground(Pw?) |
    cons_sat(C1?, S?, Pw?, R1),
    cons_sat(C2?, S?, Pw?, R2),
    tri_or(R1?, R2?, R).

procedure cons_holds(NumCtx?, Subst?, Tri).
cons_holds(nc(C, Pw), S, R?) :- ground(C?), ground(Pw?), ground(S?) |
    cons_sat(C?, S?, Pw?, R).

% mult_holds(M, S, R): the atom M carries no multiplicity, or one that is a
% positive whole number at the binding S.  A free one is sent to one, or, where
% the constraint mentions it, to a positive whole number cons_sat finds.
procedure mult_holds(Mult?, Subst?, Tri).
mult_holds(atom(_, _), _, yes).
mult_holds(times(K, _), S, R?) :- ground(K?), ground(S?) |
    num_v(S?, K?, V),
    mult_value(V?, R).

procedure mult_value(NumV?, Tri).
mult_value(known(X), R?) :- number(X?) |
    pos_whole(X?, A),
    ans_tri(A?, R).
mult_value(free(_), yes).
mult_value(_, unsettled) :- otherwise | true.

% added_at(M, S, NCx, R): some binding extending S satisfies the constraint of
% the schema and adds the atom M.
procedure added_at(Mult?, Subst?, NumCtx?, Tri).
added_at(M, S, NCx, R?) :- ground(M?), ground(S?), ground(NCx?) |
    cons_holds(NCx?, S?, R1),
    mult_holds(M?, S?, R2),
    tri_and(R1?, R2?, R).

% A match resting on the introduction's choice of a value (maybe) settles
% nothing but that the atoms do not match.
procedure maybe_tri(Tri?, Tri).
maybe_tri(no, no).
maybe_tri(yes, unsettled).
maybe_tri(unsettled, unsettled).

procedure match_added(MatchRes?, Mult?, NumCtx?, Tri).
match_added(nomatch, _, _, no).
match_added(match(S), M, NCx, R?) :- ground(S?), ground(M?), ground(NCx?) |
    added_at(M?, S?, NCx?, R).
match_added(maybe(S), M, NCx, R?) :- ground(S?), ground(M?), ground(NCx?) |
    added_at(M?, S?, NCx?, R1),
    maybe_tri(R1?, R).

% --- clause 1 of def:unobstructed -----------------------------------------
% The atom is added by a schema of arity one, guarded in its role, with no
% name term, requiring nothing, and forbidding nothing or only that atom,
% which the introductory act then requires once at its role, at a binding
% sending its role to the person in question, which satisfies the schema's
% constraint: an atom the schema adds equals the atom there, numbers
% included, and so does each atom it forbids.  Its role is guarded, so an
% agent role.  The answer is supplied, unsupplied, or
% supply_unsettled(Schema, Psi), the first atom Psi of a schema whose
% supplying it rests on the values the contract fixes, where no schema
% supplies it.  O is whether the introductory act requires the atom once at
% its role (req_once, below), asked where the schema forbids an atom.

procedure first_unsettled(Supply?, Constant?, Atom?, Supply).
first_unsettled(unsupplied, Nm, Psi, supply_unsettled(Nm?, Psi?)).
first_unsettled(supply_unsettled(N, P), _, _, supply_unsettled(N?, P?)).
first_unsettled(supplied, _, _, supplied).

% Each atom the schema forbids equals the atom in question at a binding
% extending the match of the atom it adds: it matches it, the match binding
% what the first left free.
procedure forb_match(Atoms?, GAtom?, RoleSpecs?, MatchRes?, MatchRes).
forb_match([], _, _, MR, MR?).
forb_match([_|_], _, _, nomatch, nomatch).
forb_match([F|Fs], G, Rs, match(S), R?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Rs?), ground(S?) |
    match_atom(F?, G?, Rs?, S?, MR),
    forb_match(Fs?, G?, Rs?, MR?, R).
forb_match([F|Fs], G, Rs, maybe(S), R?) :-
    ground(F?), ground(Fs?), ground(G?), ground(Rs?), ground(S?) |
    match_atom(F?, G?, Rs?, S?, MR),
    to_maybe(MR?, MR1),
    forb_match(Fs?, G?, Rs?, MR1?, R).

% A schema that forbids an atom supplies it only where the introductory act
% requires it once.
procedure once_and(Atoms?, Tri?, Tri?, Tri).
once_and([], _, T, T?).
once_and([_|_], O, T, R?) :- ground(O?), ground(T?) | tri_and(T?, O?, R).

procedure mults_supply1(Tri?, Atom?, Mults?, Atoms?, Constant?, RoleSpecs?, NumCtx?, GAtom?, Val?, Tri?, Supply?, Supply).
mults_supply1(yes, _, _, _, _, _, _, _, _, _, _, supplied).
mults_supply1(no, _, Ms, N, Nm, Rs, C, G, V, O, Acc, R?) :-
    ground(Ms?), ground(N?), ground(Nm?), ground(Rs?), ground(C?), ground(G?), ground(V?),
    ground(O?), ground(Acc?) |
    mults_supply(Ms?, N?, Nm?, Rs?, C?, G?, V?, O?, Acc?, R).
mults_supply1(unsettled, Psi, Ms, N, Nm, Rs, C, G, V, O, Acc, R?) :-
    ground(Psi?), ground(Ms?), ground(N?), ground(Nm?), ground(Rs?), ground(C?), ground(G?),
    ground(V?), ground(O?), ground(Acc?) |
    first_unsettled(Acc?, Nm?, Psi?, Acc1),
    mults_supply(Ms?, N?, Nm?, Rs?, C?, G?, V?, O?, Acc1?, R).

procedure mult_supply(Atom?, Mult?, Mults?, Atoms?, Constant?, RoleSpecs?, NumCtx?, GAtom?, Val?, Tri?, Supply?, Supply).
mult_supply(Psi, M, Ms, N, Nm, Rs, C, G, V, O, Acc, R?) :-
    ground(Psi?), ground(M?), ground(Ms?), ground(N?), ground(Nm?), ground(Rs?), ground(C?),
    ground(G?), ground(V?), ground(O?), ground(Acc?) |
    match_atom(Psi?, G?, Rs?, [bind(role(1), V?)], MR0),
    forb_match(N?, G?, Rs?, MR0?, MR),
    match_added(MR?, M?, C?, T0),
    once_and(N?, O?, T0?, T),
    mults_supply1(T?, Psi?, Ms?, N?, Nm?, Rs?, C?, G?, V?, O?, Acc?, R).

procedure mults_supply(Mults?, Atoms?, Constant?, RoleSpecs?, NumCtx?, GAtom?, Val?, Tri?, Supply?, Supply).
mults_supply([], _, _, _, _, _, _, _, Acc, Acc?).
mults_supply([M|Ms], N, Nm, Rs, C, G, V, O, Acc, R?) :-
    ground(M?), ground(Ms?), ground(N?), ground(Nm?), ground(Rs?), ground(C?), ground(G?),
    ground(V?), ground(O?), ground(Acc?) |
    plain_mult(M?, Psi),
    mult_supply(Psi?, M?, Ms?, N?, Nm?, Rs?, C?, G?, V?, O?, Acc?, R).

procedure unary_supplies1(RoleSpecs?, NameTerms?, NRoleSpecs?, Constant?, NumCtx?, GAtom?, Val?, Tri?, Supply?, Supply).
unary_supplies1([rs(guarded, P, [], [], N)], [], [rs(guarded, PM, [], [], _)], Nm, C, G, V, O, Acc, R?) :-
    ground(P?), ground(N?), ground(PM?), ground(Nm?), ground(C?), ground(G?), ground(V?),
    ground(O?), ground(Acc?) |
    mults_supply(PM?, N?, Nm?, [rs(guarded, P?, [], [], N?)], C?, G?, V?, O?, Acc?, R).
unary_supplies1(_, _, _, _, _, _, _, _, Acc, Acc?) :- otherwise | true.

procedure unary_supplies0(Schema?, NSchema?, GAtom?, Val?, Tri?, Supply?, Supply).
unary_supplies0(Sc, NSc, G, V, O, Acc, R?) :-
    ground(Sc?), ground(NSc?), ground(G?), ground(V?), ground(O?), ground(Acc?) |
    sch_roles(Sc?, Rs),
    sch_nts(Sc?, Ns),
    sch_name(Sc?, Nm),
    nsch_roles(NSc?, NRs),
    num_ctx(NSc?, C),
    unary_supplies1(Rs?, Ns?, NRs?, Nm?, C?, G?, V?, O?, Acc?, R).

procedure unary_supplies(NSchema?, GAtom?, Val?, Tri?, Supply?, Supply).
unary_supplies(NSc, G, V, O, Acc, R?) :-
    ground(NSc?), ground(G?), ground(V?), ground(O?), ground(Acc?) |
    plain_schema(NSc?, Sc),
    unary_supplies0(Sc?, NSc?, G?, V?, O?, Acc?, R).

procedure obtainable1(Supply?, NContract?, GAtom?, Val?, Tri?, Supply).
obtainable1(supplied, _, _, _, _, supplied).
obtainable1(A, Ss, G, V, O, R?) :-
    otherwise, ground(A?), ground(Ss?), ground(G?), ground(V?), ground(O?) |
    obtainable(Ss?, G?, V?, O?, A?, R).

procedure obtainable(NContract?, GAtom?, Val?, Tri?, Supply?, Supply).
obtainable([], _, _, _, Acc, Acc?).
obtainable([S|Ss], G, V, O, Acc, R?) :-
    ground(S?), ground(Ss?), ground(G?), ground(V?), ground(O?), ground(Acc?) |
    unary_supplies(S?, G?, V?, O?, Acc?, A),
    obtainable1(A?, Ss?, G?, V?, O?, R).

% req_once(Req, B, G, R): the introductory act requires the atom G once at
% its role at the introduction B -- the images under B of the atoms Req the
% role requires, each as many times as its multiplicity, hold G once
% ("which tau then requires once at pi_i", clause 1).  Where an image or a
% multiplicity rests on the numbers the introduction chooses, among the
% values the contract fixes, the answer is unsettled unless the atoms
% certain to equal G already hold it twice.
procedure req_once(Mults?, Subst?, GAtom?, Tri).
req_once(Ms, B, G, R?) :- ground(Ms?), ground(B?), ground(G?) |
    req_count(Ms?, B?, G?, 0, no, R).

procedure req_count(Mults?, Subst?, GAtom?, Integer?, Ans?, Tri).
req_count([], _, _, N, U, R?) :- integer(N?), ground(U?) | once_tri(U?, N?, R).
req_count([M|Ms], B, G, N, U, R?) :-
    ground(M?), ground(Ms?), ground(B?), ground(G?), integer(N?), ground(U?) |
    plain_mult(M?, A),
    req_count1(A?, M?, Ms?, B?, G?, N?, U?, R).

procedure req_count1(Atom?, Mult?, Mults?, Subst?, GAtom?, Integer?, Ans?, Tri).
req_count1(A, M, Ms, B, G, N, U, R?) :-
    ground(A?), ground(M?), ground(Ms?), ground(B?), ground(G?), integer(N?), ground(U?) |
    apply_atom(B?, A?, GA),
    gatom_eq(GA?, G?, E),
    mult_count(M?, B?, K),
    req_count2(E?, K?, Ms?, B?, G?, N?, U?, R).

procedure req_count2(Tri?, NumV?, Mults?, Subst?, GAtom?, Integer?, Ans?, Tri).
req_count2(no, _, Ms, B, G, N, U, R?) :-
    ground(Ms?), ground(B?), ground(G?), integer(N?), ground(U?) |
    req_count(Ms?, B?, G?, N?, U?, R).
req_count2(yes, known(K), Ms, B, G, N, U, R?) :-
    integer(K?), ground(Ms?), ground(B?), ground(G?), integer(N?), ground(U?) |
    N1 := N? + K?,
    req_count(Ms?, B?, G?, N1?, U?, R).
req_count2(_, _, Ms, B, G, N, _, R?) :-
    otherwise, ground(Ms?), ground(B?), ground(G?), integer(N?) |
    req_count(Ms?, B?, G?, N?, yes, R).

% The multiplicity of an atom required at the introduction B: one for an
% atom that carries none.
procedure mult_count(Mult?, Subst?, NumV).
mult_count(atom(_, _), _, known(1)).
mult_count(times(K, _), B, V?) :- ground(K?), ground(B?) | num_v(B?, K?, V).

% U is whether some image or multiplicity rested on a number unchosen.
procedure once_tri(Ans?, Integer?, Tri).
once_tri(no, N, yes) :- N? =:= 1 | true.
once_tri(yes, N, no) :- N? >= 2 | true.
once_tri(yes, N, unsettled) :- N? < 2 | true.
once_tri(no, _, no) :- otherwise | true.

% Two images are equal, unequal, or equal where the numbers the introduction
% chooses are, which rests on the values the contract fixes (unsettled).
procedure val_eq(Val?, Val?, Tri).
val_eq(V, W, yes) :- V? =?= W? | true.
val_eq(nval(M), nval(N), R?) :- otherwise, number(M?), number(N?) | tri_eq(M?, N?, R).
val_eq(nfree(_), nval(_), unsettled) :- otherwise | true.
val_eq(nval(_), nfree(_), unsettled) :- otherwise | true.
val_eq(nfree(_), nfree(_), unsettled) :- otherwise | true.
val_eq(_, _, no) :- otherwise | true.

procedure vals_eq(Vals?, Vals?, Tri).
vals_eq([], [], yes).
vals_eq([V|Vs], [W|Ws], R?) :- ground(V?), ground(W?), ground(Vs?), ground(Ws?) |
    val_eq(V?, W?, T1),
    vals_eq(Vs?, Ws?, T2),
    tri_and(T1?, T2?, R).
vals_eq(_, _, no) :- otherwise | true.

procedure gatom_eq(GAtom?, GAtom?, Tri).
gatom_eq(gatom(P, Vs), gatom(Q, Ws), R?) :- P? =?= Q?, ground(Vs?), ground(Ws?) |
    vals_eq(Vs?, Ws?, R).
gatom_eq(_, _, no) :- otherwise | true.

% Whether the introductory act requires the atom at its introduction B: one
% carrying no multiplicity it requires, and one carrying the multiplicity k
% (an atom deleted) it requires where B sends k to one or more.  The number
% of a value variable of the act is the introduction's to choose, a positive
% whole number (def:binding-numbers): unsettled until the search of
% introductions chooses it.
procedure req_cond(Mult?, Subst?, Tri).
req_cond(atom(_, _), _, yes).
req_cond(times(K, _), B, R?) :- ground(K?), ground(B?) |
    num_v(B?, K?, V),
    req_cond1(V?, R).

procedure req_cond1(NumV?, Tri).
req_cond1(known(X), R?) :- number(X?) |
    pos_whole(X?, A),
    ans_tri(A?, R).
req_cond1(_, unsettled) :- otherwise | true.

procedure req_fault(Tri?, Supply?, Constant?, Integer?, Atom?, Faults?, Faults).
req_fault(no, _, _, _, _, T, T?).
req_fault(yes, supplied, _, _, _, T, T?).
req_fault(unsettled, supplied, _, _, _, T, T?).
req_fault(yes, unsupplied, Nm, I, A, T, [obstructed(Nm?, I?, A?, unobtainable)|T?]).
req_fault(unsettled, unsupplied, Nm, I, A, T, [unsettled(Nm?, I?, A?, multiplicity)|T?]).
req_fault(yes, supply_unsettled(N2, P), Nm, I, A, T,
          [unsettled(Nm?, I?, A?, supplied_by(N2?, P?))|T?]).
req_fault(unsettled, supply_unsettled(N2, P), Nm, I, A, T,
          [unsettled(Nm?, I?, A?, supplied_by(N2?, P?))|T?]).

% The person in the role and the image of the atom are produced by the body,
% so they are put to clause 1 through a call that can guard on them; All is
% every atom the role requires, which req_once counts.
procedure unob_req2(GAtom?, Tri?, Atom?, Mults?, Mults?, Val?, Integer?, Constant?, Subst?, NContract?, Faults).
unob_req2(G, Rq, A, Ms, All, V, I, Nm, B, NC, R?) :-
    ground(G?), ground(Rq?), ground(A?), ground(Ms?), ground(All?), ground(V?), integer(I?),
    ground(Nm?), ground(B?), ground(NC?) |
    req_once(All?, B?, G?, O),
    obtainable(NC?, G?, V?, O?, unsupplied, Sp),
    unob_req(Ms?, All?, V?, I?, Nm?, B?, NC?, R1),
    req_fault(Rq?, Sp?, Nm?, I?, A?, R1?, R).

procedure unob_req1(Atom?, Mult?, Mults?, Mults?, Val?, Integer?, Constant?, Subst?, NContract?, Faults).
unob_req1(A, M, Ms, All, V, I, Nm, B, NC, R?) :-
    ground(A?), ground(M?), ground(Ms?), ground(All?), ground(V?), integer(I?), ground(Nm?),
    ground(B?), ground(NC?) |
    apply_atom(B?, A?, G),
    req_cond(M?, B?, Rq),
    unob_req2(G?, Rq?, A?, Ms?, All?, V?, I?, Nm?, B?, NC?, R).

procedure unob_req(Mults?, Mults?, Val?, Integer?, Constant?, Subst?, NContract?, Faults).
unob_req([], _, _, _, _, _, _, []).
unob_req([M|Ms], All, V, I, Nm, B, NC, R?) :-
    ground(M?), ground(Ms?), ground(All?), ground(V?), integer(I?), ground(Nm?), ground(B?),
    ground(NC?) |
    plain_mult(M?, A),
    unob_req1(A?, M?, Ms?, All?, V?, I?, Nm?, B?, NC?, R).

% --- clause 2 of def:unobstructed, its second part: the agent roles -------
% Every atom every schema adds is matched against the forbidden one at that
% party, the number of a value argument by equality, and a match is a
% binding adding it where it satisfies the schema's constraint and the
% atom's multiplicity is one or more there (added_at).  A binding adding it
% that the clause does not excuse is the fault.  excused/5 is the clause's
% two tests, both read off the completed binding: the other party of the
% introduction holds a role, and the multiset added at the role in question
% names it.  Where it rests on the values the contract fixes whether some
% binding adds the atom, or whether that binding is excused, the answer is
% block_unsettled(Schema, Role, Psi), unless another schema blocks it.

procedure ctx_parts(Ctx?, Val, Integer).
ctx_parts(ctx(O, N), O?, N?).

% The multiplicity of an atom: one for an atom that carries none.
procedure mult_of(Mult?, Arg).
mult_of(atom(_, _), num(1)).
mult_of(times(K, _), K?).

% An atom naming the other party is added at every binding that adds the
% forbidden one: a multiplicity is a positive whole number at every binding
% (def:binding-numbers).
procedure naming_mult(Mult?, Arg?, Subst?, Tri).
naming_mult(_, _, _, yes).

procedure naming_tri1(Ans?, Mult?, Arg?, Subst?, Tri).
naming_tri1(no, _, _, _, no).
naming_tri1(yes, M, Kf, S, R?) :- ground(M?), ground(Kf?), ground(S?) |
    naming_mult(M?, Kf?, S?, R).

procedure naming_tri(Mults?, Subst?, Val?, Arg?, Tri).
naming_tri([], _, _, _, no).
naming_tri([M|Ms], S, O, Kf, R?) :-
    ground(M?), ground(Ms?), ground(S?), ground(O?), ground(Kf?) |
    plain_mult(M?, A),
    naming_tri2(A?, M?, Ms?, S?, O?, Kf?, R).

procedure naming_tri2(Atom?, Mult?, Mults?, Subst?, Val?, Arg?, Tri).
naming_tri2(A, M, Ms, S, O, Kf, R?) :-
    ground(A?), ground(M?), ground(Ms?), ground(S?), ground(O?), ground(Kf?) |
    apply_atom(S?, A?, G),
    gatom_has(G?, O?, H),
    naming_tri1(H?, M?, Kf?, S?, T1),
    naming_tri(Ms?, S?, O?, Kf?, T2),
    tri_or(T1?, T2?, R).

procedure excused(Subst?, Mults?, Val?, Mult?, Tri).
excused(S, Plus, O, M, R?) :- ground(S?), ground(Plus?), ground(O?), ground(M?) |
    subst_role_at(S?, O?, A1),
    ans_tri(A1?, T1),
    mult_of(M?, Kf),
    naming_tri(Plus?, S?, O?, Kf?, T2),
    tri_and(T1?, T2?, R).

% The match's subst, and whether it rests on the introduction's choice.
procedure match_subst(MatchRes?, Subst).
match_subst(match(S), S?).
match_subst(maybe(S), S?).
match_subst(nomatch, []).

% block3(E, T, ...): E whether the binding is excused, T whether it adds the
% forbidden atom (yes where settled).
procedure block3(Tri?, Tri?, Constant?, Integer?, Atom?, Block?, Block).
block3(yes, _, _, _, _, Acc, Acc?).
block3(no, yes, Nm, J, Psi, _, blocked(Nm?, J?, Psi?)).
block3(no, unsettled, Nm, J, Psi, Acc, R?) :- ground(Nm?), integer(J?), ground(Psi?), ground(Acc?) |
    first_block_unsettled(Acc?, Nm?, J?, Psi?, R).
block3(unsettled, _, Nm, J, Psi, Acc, R?) :- ground(Nm?), integer(J?), ground(Psi?), ground(Acc?) |
    first_block_unsettled(Acc?, Nm?, J?, Psi?, R).
block3(no, no, _, _, _, Acc, Acc?).

procedure first_block_unsettled(Block?, Constant?, Integer?, Atom?, Block).
first_block_unsettled(clear, Nm, J, Psi, block_unsettled(Nm?, J?, Psi?)).
first_block_unsettled(block_unsettled(N, I, P), _, _, _, block_unsettled(N?, I?, P?)).
first_block_unsettled(blocked(N, I, P), _, _, _, blocked(N?, I?, P?)).

procedure block2(Tri?, MatchRes?, Mult?, Mults?, Integer?, Schema?, Constant?, Ctx?, Atom?, Block?, Block).
block2(no, _, _, _, _, _, _, _, _, Acc, Acc?).
block2(T, MR, M, Plus, J, Sc, Nm, Cx, Psi, Acc, R?) :-
    otherwise, ground(T?), ground(MR?), ground(M?), ground(Plus?), integer(J?),
    ground(Sc?), ground(Nm?), ground(Cx?), ground(Psi?), ground(Acc?) |
    match_subst(MR?, S),
    ctx_parts(Cx?, O, N),
    complete(Sc?, S?, N?, S1),
    excused(S1?, Plus?, O?, M?, E),
    block3(E?, T?, Nm?, J?, Psi?, Acc?, R).

procedure plus_block1(Block?, Mults?, Mults?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block).
plus_block1(blocked(N, I, P), _, _, _, _, _, _, _, _, _, _, blocked(N?, I?, P?)).
plus_block1(Acc, Ms, Plus, J, Sc, Rs, Nm, C, Cx, G, P, R?) :-
    otherwise, ground(Acc?), ground(Ms?), ground(Plus?), integer(J?), ground(Sc?),
    ground(Rs?), ground(Nm?), ground(C?), ground(Cx?), ground(G?), ground(P?) |
    plus_blocks(Ms?, Plus?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, R).

procedure plus_block(Atom?, Mult?, Mults?, Mults?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block?, Block).
plus_block(Psi, M, Ms, Plus, J, Sc, Rs, Nm, C, Cx, G, P, Acc, R?) :-
    ground(Psi?), ground(M?), ground(Ms?), ground(Plus?), integer(J?), ground(Sc?),
    ground(Rs?), ground(Nm?), ground(C?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    match_atom(Psi?, G?, Rs?, [bind(role(J?), P?)], MR),
    plus_block_mr(MR?, Psi?, M?, Ms?, Plus?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, R).

% The match is read twice, so it is taken ground in a head of its own.
procedure plus_block_mr(MatchRes?, Atom?, Mult?, Mults?, Mults?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block?, Block).
plus_block_mr(MR, Psi, M, Ms, Plus, J, Sc, Rs, Nm, C, Cx, G, P, Acc, R?) :-
    ground(MR?), ground(Psi?), ground(M?), ground(Ms?), ground(Plus?), integer(J?),
    ground(Sc?), ground(Rs?), ground(Nm?), ground(C?), ground(Cx?), ground(G?),
    ground(P?), ground(Acc?) |
    match_added(MR?, M?, C?, T),
    block2(T?, MR?, M?, Plus?, J?, Sc?, Nm?, Cx?, Psi?, Acc?, B),
    plus_block1(B?, Ms?, Plus?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, R).

procedure plus_blocks(Mults?, Mults?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block?, Block).
plus_blocks([], _, _, _, _, _, _, _, _, _, Acc, Acc?).
plus_blocks([M|Ms], Plus, J, Sc, Rs, Nm, C, Cx, G, P, Acc, R?) :-
    ground(M?), ground(Ms?), ground(Plus?), integer(J?), ground(Sc?), ground(Rs?),
    ground(Nm?), ground(C?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    plain_mult(M?, Psi),
    plus_block(Psi?, M?, Ms?, Plus?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, R).

procedure n_is_party_role(NRoleSpec?, Ans).
n_is_party_role(rs(_, _, _, _, _), yes).
n_is_party_role(crs(_, _, _, _, _, _), no).

procedure role_blocks1(Block?, NRoleSpecs?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block).
role_blocks1(blocked(N, I, P), _, _, _, _, _, _, _, _, _, blocked(N?, I?, P?)).
role_blocks1(Acc, NRs, J, Sc, Rs, Nm, C, Cx, G, P, R?) :-
    otherwise, ground(Acc?), ground(NRs?), integer(J?), ground(Sc?), ground(Rs?),
    ground(Nm?), ground(C?), ground(Cx?), ground(G?), ground(P?) |
    J1 := J? + 1,
    role_blocks(NRs?, J1?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, R).

% A listed role adds at the agents of its extent, not at a person a binding
% sends it to, and the first part of clause 2 of def:unobstructed asks of it
% what the second asks of an agent role (listed_faults, below): it is passed
% by.
procedure role_blocks2(Ans?, NRoleSpec?, NRoleSpecs?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block?, Block).
role_blocks2(yes, NRS, NRs, J, Sc, Rs, Nm, C, Cx, G, P, Acc, R?) :-
    ground(NRS?), ground(NRs?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?),
    ground(C?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    nrs_add(NRS?, Plus),
    role_blocks_plus(Plus?, NRs?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, R).
role_blocks2(no, _, NRs, J, Sc, Rs, Nm, C, Cx, G, P, Acc, R?) :-
    ground(NRs?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?), ground(C?),
    ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    role_blocks1(Acc?, NRs?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, R).

procedure role_blocks_plus(Mults?, NRoleSpecs?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block?, Block).
role_blocks_plus(Plus, NRs, J, Sc, Rs, Nm, C, Cx, G, P, Acc, R?) :-
    ground(Plus?), ground(NRs?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?),
    ground(C?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    plus_blocks(Plus?, Plus?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, B),
    role_blocks1(B?, NRs?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, R).

procedure role_blocks(NRoleSpecs?, Integer?, Schema?, RoleSpecs?, Constant?, NumCtx?, Ctx?, GAtom?, Val?, Block?, Block).
role_blocks([], _, _, _, _, _, _, _, _, Acc, Acc?).
role_blocks([NRS|NRs], J, Sc, Rs, Nm, C, Cx, G, P, Acc, R?) :-
    ground(NRS?), ground(NRs?), integer(J?), ground(Sc?), ground(Rs?), ground(Nm?),
    ground(C?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    n_is_party_role(NRS?, A),
    role_blocks2(A?, NRS?, NRs?, J?, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, R).

procedure schema_blocks0(Schema?, NSchema?, Ctx?, GAtom?, Val?, Block?, Block).
schema_blocks0(Sc, NSc, Cx, G, P, Acc, R?) :-
    ground(Sc?), ground(NSc?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    sch_roles(Sc?, Rs),
    sch_name(Sc?, Nm),
    nsch_roles(NSc?, NRs),
    num_ctx(NSc?, C),
    role_blocks(NRs?, 1, Sc?, Rs?, Nm?, C?, Cx?, G?, P?, Acc?, R).

procedure schema_blocks(NSchema?, Ctx?, GAtom?, Val?, Block?, Block).
schema_blocks(NSc, Cx, G, P, Acc, R?) :-
    ground(NSc?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    plain_schema(NSc?, Sc),
    schema_blocks0(Sc?, NSc?, Cx?, G?, P?, Acc?, R).

procedure blocker1(Block?, NContract?, Ctx?, GAtom?, Val?, Block).
blocker1(blocked(Nm, Jx, Psi), _, _, _, _, blocked(Nm?, Jx?, Psi?)).
blocker1(Acc, Ss, Cx, G, P, R?) :-
    otherwise, ground(Acc?), ground(Ss?), ground(Cx?), ground(G?), ground(P?) |
    blocker(Ss?, Cx?, G?, P?, Acc?, R).

procedure blocker(NContract?, Ctx?, GAtom?, Val?, Block?, Block).
blocker([], _, _, _, Acc, Acc?).
blocker([S|Ss], Cx, G, P, Acc, R?) :-
    ground(S?), ground(Ss?), ground(Cx?), ground(G?), ground(P?), ground(Acc?) |
    schema_blocks(S?, Cx?, G?, P?, Acc?, B),
    blocker1(B?, Ss?, Cx?, G?, P?, R).

procedure forb_fault(Block?, Constant?, Integer?, Atom?, Faults?, Faults).
forb_fault(clear, _, _, _, T, T?).
forb_fault(blocked(Nm2, Jx, Psi), Nm, I, A, T,
           [obstructed(Nm?, I?, A?, blocked_by(Nm2?, Jx?, Psi?))|T?]).
forb_fault(block_unsettled(Nm2, Jx, Psi), Nm, I, A, T,
           [unsettled(Nm?, I?, A?, added_by(Nm2?, Jx?, Psi?))|T?]).

procedure unob_forb1(Atom?, Mults?, Val?, Integer?, Constant?, Subst?, NContract?, Ctx?, Faults).
unob_forb1(A, Ms, V, I, Nm, B, NC, Cx, R?) :-
    ground(A?), ground(Ms?), ground(V?), integer(I?), ground(Nm?), ground(B?),
    ground(NC?), ground(Cx?) |
    apply_atom(B?, A?, G),
    blocker(NC?, Cx?, G?, V?, clear, Bl),
    unob_forb(Ms?, V?, I?, Nm?, B?, NC?, Cx?, R1),
    forb_fault(Bl?, Nm?, I?, A?, R1?, R).

procedure unob_forb(Mults?, Val?, Integer?, Constant?, Subst?, NContract?, Ctx?, Faults).
unob_forb([], _, _, _, _, _, _, []).
unob_forb([M|Ms], V, I, Nm, B, NC, Cx, R?) :-
    ground(M?), ground(Ms?), ground(V?), integer(I?), ground(Nm?), ground(B?),
    ground(NC?), ground(Cx?) |
    plain_mult(M?, A),
    unob_forb1(A?, Ms?, V?, I?, Nm?, B?, NC?, Cx?, R).

% --- clause 3 of def:unobstructed -----------------------------------------
% The introductory act forbids at a role no atom of a reflexive predicate
% naming that role; each one it forbids is a fault.

procedure refl_faults(Atoms?, Integer?, Constant?, Faults).
refl_faults([], _, _, []).
refl_faults([A|As], I, Nm, [obstructed(Nm?, I?, A?, reflexive)|R?]) :-
    ground(As?), integer(I?), ground(Nm?) |
    refl_faults(As?, I?, Nm?, R).

% The atoms as written that the role requires, those of a reflexive predicate
% naming the role left out (refl_keep, self.glp, on the atoms).
procedure n_refl_drop1(Ans?, Mult?, Mults?, Integer?, Preds?, Mults).
n_refl_drop1(yes, _, Ms, I, Rf, R?) :- ground(Ms?), integer(I?), ground(Rf?) |
    n_refl_drop(Ms?, I?, Rf?, R).
n_refl_drop1(no, M, Ms, I, Rf, [M?|R?]) :- ground(Ms?), integer(I?), ground(Rf?) |
    n_refl_drop(Ms?, I?, Rf?, R).

procedure n_refl_drop2(Atom?, Mult?, Mults?, Integer?, Preds?, Mults).
n_refl_drop2(A, M, Ms, I, Rf, R?) :- ground(A?), ground(Ms?), integer(I?), ground(Rf?) |
    own_reflexive(A?, I?, Rf?, B),
    n_refl_drop1(B?, M?, Ms?, I?, Rf?, R).

procedure n_refl_drop(Mults?, Integer?, Preds?, Mults).
n_refl_drop([], _, _, []).
n_refl_drop([M|Ms], I, Rf, R?) :- ground(M?), ground(Ms?), integer(I?), ground(Rf?) |
    plain_mult(M?, A),
    n_refl_drop2(A?, M?, Ms?, I?, Rf?, R).

% The person in the role is produced by the body, so the three clauses of
% def:unobstructed are put to it through one call that can guard on it.
% Clause 1 skips a required atom of a reflexive predicate naming the role.
procedure unob_role1(Val?, Mults?, Mults?, Integer?, Constant?, Subst?, NContract?, Ctx?, Preds?, Faults).
unob_role1(V, Req, Forb, I, Nm, B, NC, Cx, Rf, R?) :-
    ground(V?), ground(Req?), ground(Forb?), integer(I?), ground(Nm?),
    ground(B?), ground(NC?), ground(Cx?), ground(Rf?) |
    n_refl_drop(Req?, I?, Rf?, Req1),
    unob_req(Req1?, Req?, V?, I?, Nm?, B?, NC?, F1),
    unob_forb(Forb?, V?, I?, Nm?, B?, NC?, Cx?, F2),
    plain_mults(Forb?, ForbA),
    refl_keep(ForbA?, I?, Rf?, yes, Own),
    refl_faults(Own?, I?, Nm?, F3),
    faults_app(F2?, F3?, F23),
    faults_app(F1?, F23?, R).

% An introductory act has two roles (def:introduction), so the other role of
% the one at I is 3 - I, and clause 2 is decided against the party there.
procedure unob_roles(NRoleSpecs?, Integer?, Constant?, Subst?, NContract?, Integer?, Preds?, Faults).
unob_roles([], _, _, _, _, _, _, []).
unob_roles([RS|Rs], I, Nm, B, NC, Fb, Rf, R?) :-
    ground(RS?), ground(Rs?), integer(I?),
    ground(Nm?), ground(B?), ground(NC?), integer(Fb?), ground(Rf?) |
    nrs_del(RS?, M),
    nrs_keep(RS?, K),
    nrs_forb(RS?, N),
    apply_arg(B?, role(I?), V),
    O := 3 - I?,
    apply_arg(B?, role(O?), OV),
    mults_app(K?, M?, Req),
    unob_role1(V?, Req?, N?, I?, Nm?, B?, NC?, ctx(OV?, Fb?), Rf?, F1),
    I1 := I? + 1,
    unob_roles(Rs?, I1?, Nm?, B?, NC?, Fb?, Rf?, F2),
    faults_app(F1?, F2?, R).

% --- clause 2 of def:unobstructed, its first part: the listed roles --------
% No listed role of a schema of C adds an atom whose predicate is that of an
% atom the introductory act forbids at a role.  Each atom A the act Nm
% forbids at its role I, and each atom a listed role J of a schema Nm2 adds
% of A's predicate, is a fault obstructed(Nm, I, A, listed_role(Nm2, J,
% Added)).  A contract with no listed role has no such fault.

procedure sh_atoms(Atoms?, Constant?, Constant?, Integer?, Atom?, Constant?, Integer?,
                   Faults?, Faults).
sh_atoms([], _, _, _, _, _, _, T, T?).
sh_atoms([atom(Q, Bs)|Xs], P, Nm2, J, A, Nm, I,
         T, [obstructed(Nm?, I?, A?, listed_role(Nm2?, J?, atom(Q?, Bs?)))|R?]) :-
    Q? =?= P?, ground(Bs?), ground(Xs?), ground(Nm2?), integer(J?), ground(A?),
    ground(Nm?), integer(I?), ground(T?) |
    sh_atoms(Xs?, P?, Nm2?, J?, A?, Nm?, I?, T?, R).
sh_atoms([atom(_, _)|Xs], P, Nm2, J, A, Nm, I, T, R?) :-
    otherwise, ground(Xs?), ground(P?), ground(Nm2?), integer(J?), ground(A?),
    ground(Nm?), integer(I?), ground(T?) |
    sh_atoms(Xs?, P?, Nm2?, J?, A?, Nm?, I?, T?, R).

procedure sh_role(Ans?, RoleSpec?, Constant?, Constant?, Integer?, Atom?, Constant?, Integer?,
                  Faults?, Faults).
sh_role(yes, _, _, _, _, _, _, _, T, T?).
sh_role(no, RS, P, Nm2, J, A, Nm, I, T, R?) :-
    ground(RS?), ground(P?), ground(Nm2?), integer(J?), ground(A?), ground(Nm?),
    integer(I?), ground(T?) |
    rs_add(RS?, Add),
    sh_atoms(Add?, P?, Nm2?, J?, A?, Nm?, I?, T?, R).

procedure sh_roles(RoleSpecs?, Integer?, Constant?, Constant?, Atom?, Constant?, Integer?,
                   Faults?, Faults).
sh_roles([], _, _, _, _, _, _, T, T?).
sh_roles([RS|Rs], J, P, Nm2, A, Nm, I, T, R?) :-
    ground(RS?), ground(Rs?), integer(J?), ground(P?), ground(Nm2?), ground(A?),
    ground(Nm?), integer(I?), ground(T?) |
    is_party_role(RS?, Pa),
    J1 := J? + 1,
    sh_roles(Rs?, J1?, P?, Nm2?, A?, Nm?, I?, T?, R1),
    sh_role(Pa?, RS?, P?, Nm2?, J?, A?, Nm?, I?, R1?, R).

procedure sh_schemas(Contract?, Constant?, Atom?, Constant?, Integer?, Faults?, Faults).
sh_schemas([], _, _, _, _, T, T?).
sh_schemas([S|Ss], P, A, Nm, I, T, R?) :-
    ground(S?), ground(Ss?), ground(P?), ground(A?), ground(Nm?), integer(I?), ground(T?) |
    sch_name(S?, Nm2),
    sch_roles(S?, Rs),
    sh_schemas(Ss?, P?, A?, Nm?, I?, T?, R1),
    sh_roles(Rs?, 1, P?, Nm2?, A?, Nm?, I?, R1?, R).

procedure sh_forb(Atoms?, Contract?, Constant?, Integer?, Faults?, Faults).
sh_forb([], _, _, _, T, T?).
sh_forb([atom(P, As)|Xs], C, Nm, I, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), ground(C?), ground(Nm?), integer(I?), ground(T?) |
    sh_forb(Xs?, C?, Nm?, I?, T?, R1),
    sh_schemas(C?, P?, atom(P?, As?), Nm?, I?, R1?, R).

procedure listed_faults(RoleSpecs?, Integer?, Constant?, Contract?, Faults).
listed_faults([], _, _, _, []).
listed_faults([RS|Rs], I, Nm, C, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Nm?), ground(C?) |
    rs_forb(RS?, N),
    I1 := I? + 1,
    listed_faults(Rs?, I1?, Nm?, C?, R1),
    sh_forb(N?, C?, Nm?, I?, R1?, R).


% --- the numbers of an introduction ----------------------------------------
% An introduction is a binding of the introductory act (def:introduction),
% which satisfies the act's constraint, and under it some atom added at each
% role names the other party: one carrying a multiplicity is added, a
% multiplicity being a positive whole number (mult_holds).  intro_bindings
% enumerates the assignments of the act's agent and speech-act variables;
% intro_num asks the rest of them: yes, no (then the assignment is no
% introduction), or unsettled where it rests on a value the introduction has
% not yet chosen (try_vals, below).

procedure names_tri3(Ans?, Mult?, Subst?, NumCtx?, Tri).
names_tri3(no, _, _, _, no).
names_tri3(yes, M, B, _, R?) :- ground(M?), ground(B?) |
    mult_holds(M?, B?, R).

procedure names_tri2(Atom?, Mult?, Mults?, Subst?, Val?, NumCtx?, Tri).
names_tri2(A, M, Ms, B, V, C, R?) :-
    ground(A?), ground(M?), ground(Ms?), ground(B?), ground(V?), ground(C?) |
    apply_atom(B?, A?, G),
    gatom_has(G?, V?, H),
    names_tri3(H?, M?, B?, C?, T1),
    names_tri(Ms?, B?, V?, C?, T2),
    tri_or(T1?, T2?, R).

procedure names_tri(Mults?, Subst?, Val?, NumCtx?, Tri).
names_tri([], _, _, _, no).
names_tri([M|Ms], B, V, C, R?) :-
    ground(M?), ground(Ms?), ground(B?), ground(V?), ground(C?) |
    plain_mult(M?, A),
    names_tri2(A?, M?, Ms?, B?, V?, C?, R).

procedure intro_num1(NRoleSpecs?, NumCtx?, Subst?, Tri).
intro_num1([NR1, NR2], C, B, R?) :- ground(NR1?), ground(NR2?), ground(C?), ground(B?) |
    cons_holds(C?, B?, T0),
    nrs_add(NR1?, P1),
    nrs_add(NR2?, P2),
    names_tri(P1?, B?, person(1), C?, T1),
    names_tri(P2?, B?, person(0), C?, T2),
    tri_and(T1?, T2?, T12),
    tri_and(T0?, T12?, R).
intro_num1(_, _, _, no) :- otherwise | true.

procedure intro_num(NSchema?, Subst?, Tri).
intro_num(NSc, B, R?) :- ground(NSc?), ground(B?) |
    num_ctx(NSc?, C),
    nsch_roles(NSc?, NRs),
    intro_num1(NRs?, C?, B?, R).

% unobstructed(Sc, NSc, B, NC, C, Rf, T, Faults): the faults of
% def:unobstructed at the introduction B of the act Sc, written NSc, in the
% contract written NC, its plain form C, Rf being the predicates the contract
% declares reflexive, those of the listed roles last; empty when it
% satisfies the clauses at every role.  T is intro_num's
% answer, yes or unsettled, and an unsettled one is the fault
% unsettled_introduction(Act) before the others.
procedure intro_fault(Tri?, Constant?, Faults?, Faults).
intro_fault(yes, _, F, F?).
intro_fault(unsettled, Nm, F, [unsettled_introduction(Nm?)|F?]).
intro_fault(no, _, F, F?).

procedure unobstructed(Schema?, NSchema?, Subst?, NContract?, Contract?, Preds?, Tri?, Faults).
unobstructed(Sc, NSc, B, NC, C, Rf, T, R?) :-
    ground(Sc?), ground(NSc?), ground(B?), ground(NC?), ground(C?), ground(Rf?), ground(T?) |
    sch_name(Sc?, Nm),
    sch_roles(Sc?, Rs),
    nsch_roles(NSc?, NRs),
    fresh_base(Sc?, N),
    unobstructed1(NRs?, Rs?, Nm?, B?, NC?, C?, N?, Rf?, F),
    intro_fault(T?, Nm?, F?, R).

procedure unobstructed1(NRoleSpecs?, RoleSpecs?, Constant?, Subst?, NContract?, Contract?, Integer?, Preds?, Faults).
unobstructed1(NRs, Rs, Nm, B, NC, C, N, Rf, R?) :-
    ground(NRs?), ground(Rs?), ground(Nm?), ground(B?), ground(NC?), ground(C?),
    integer(N?), ground(Rf?) |
    unob_roles(NRs?, 1, Nm?, B?, NC?, N?, Rf?, F1),
    listed_faults(Rs?, 1, Nm?, C?, F2),
    faults_app(F1?, F2?, R).

% --- def:syntactically-grassroots, first half ------------------------------
% Some schema is an introductory act unobstructed at some introduction.  An
% introduction is a binding of the act (def:introduction): intro_bindings
% enumerates the assignments of its agent and speech-act variables, and an
% introduction chooses its own values (the appendix "Values in Act
% Schemas").  For each assignment the clauses are asked first with the act's
% value variables unchosen (sym_binds); where no answer rests on them, that
% is the answer.  Where some does, the values are chosen (try_vals), each
% value variable from the candidates of the contract (contract_cands), a
% multiplicity from the positive whole numbers among them: every choice is
% tried until one meets the clauses where every fault rests on the values,
% and only the first where some fault does not, which no choice removes.
% The faults reported are those of the first introductory act at its first
% introduction that fails.

% The value variables of a schema, in the order of its head.
procedure sch_vvars(NSchema?, Args).
sch_vvars(NSc, R?) :- ground(NSc?) |
    nsch_vars(NSc?, Vs),
    filter_nvars(Vs?, R).

% Each value variable bound to the value the introduction has not yet chosen.
procedure sym_binds(Args?, Subst?, Subst).
sym_binds([], B, B?).
sym_binds([num(X)|Vs], B, [bind(num(X?), nfree(X?))|R?]) :-
    ground(X?), ground(Vs?), ground(B?) |
    sym_binds(Vs?, B?, R).
sym_binds([A|Vs], B, R?) :- otherwise, ground(A?), ground(Vs?), ground(B?) |
    sym_binds(Vs?, B?, R).

% The candidate values (README, "Why it terminates"): the numbers the
% contract writes, with 0 and 1, and the numbers within two of each; a number
% between each two consecutive ones; and one below the least and one above
% the greatest, in ascending order.  A value variable of the act is compared
% by its constraints and those of the schemas its atoms match with a number
% or its successor, and matched with a number by equality, so each condition
% on one of them changes only at a number within one of a number the
% contract writes: every interval those numbers bound, and every whole
% number next to one, holds a candidate.
procedure args_numbers(Args?, Nums?, Nums).
args_numbers([], T, T?).
args_numbers([num(X)|As], T, [X?|R?]) :- number(X?), ground(As?), ground(T?) |
    args_numbers(As?, T?, R).
args_numbers([A|As], T, R?) :- otherwise, ground(A?), ground(As?), ground(T?) |
    args_numbers(As?, T?, R).

procedure contract_nums(NContract?, Nums?, Nums).
contract_nums([], T, T?).
contract_nums([S|Ss], T, R?) :- ground(S?), ground(Ss?), ground(T?) |
    plain_schema(S?, P),
    schema_args(P?, As),
    nsch_roles(S?, Rs),
    nroles_margs(Rs?, [], Ms),
    nsch_constraint(S?, C),
    constraint_args(C?, [], Cs),
    args_app(Ms?, Cs?, MC),
    args_app(As?, MC?, All),
    contract_nums(Ss?, T?, R1),
    args_numbers(All?, R1?, R).

procedure near(Constant?, Nums?, Nums).
near(X, T, [A?, B?, X?, C?, D?|T?]) :- number(X?), ground(T?) |
    A := X? - 2,
    B := X? - 1,
    C := X? + 1,
    D := X? + 2.

procedure near_all(Nums?, Nums?, Nums).
near_all([], T, T?).
near_all([X|Xs], T, R?) :- number(X?), ground(Xs?), ground(T?) |
    near_all(Xs?, T?, R1),
    near(X?, R1?, R).

% Ascending, each number once.
procedure nums_insert(Constant?, Nums?, Nums).
nums_insert(X, [], [X?]).
nums_insert(X, [Y|Ys], [X?, Y?|Ys?]) :- X? < Y? | true.
nums_insert(X, [Y|Ys], [Y?|Ys?]) :- X? =:= Y? | true.
nums_insert(X, [Y|Ys], [Y?|R?]) :- X? > Y?, ground(Ys?) | nums_insert(X?, Ys?, R).

procedure nums_sort(Nums?, Nums?, Nums).
nums_sort([], T, T?).
nums_sort([X|Xs], T, R?) :- number(X?), ground(Xs?), ground(T?) |
    nums_insert(X?, T?, T1),
    nums_sort(Xs?, T1?, R).

procedure with_mids(Nums?, Nums).
with_mids([], []).
with_mids([X], [X?]).
with_mids([X, Y|Zs], [X?, M?|R?]) :- number(X?), number(Y?), ground(Zs?) |
    M := (X? + Y?) / 2,
    with_mids([Y?|Zs?], R).

procedure last_plus(Nums?, Nums).
last_plus([], []).
last_plus([X], [X?, Y?]) :- number(X?) | Y := X? + 1.
last_plus([X, Y|Zs], [X?|R?]) :- ground(Y?), ground(Zs?) | last_plus([Y?|Zs?], R).

procedure with_ends(Nums?, Nums).
with_ends([], []).
with_ends([X|Xs], [L?|R?]) :- number(X?), ground(Xs?) |
    L := X? - 1,
    last_plus([X?|Xs?], R).

procedure pw_filter(Nums?, Nums).
pw_filter([], []).
pw_filter([X|Xs], R?) :- number(X?), ground(Xs?) |
    pos_whole(X?, P),
    pw_filter1(P?, X?, Xs?, R).

procedure pw_filter1(Ans?, Constant?, Nums?, Nums).
pw_filter1(yes, X, Xs, [X?|R?]) :- ground(Xs?) | pw_filter(Xs?, R).
pw_filter1(no, _, Xs, R?) :- ground(Xs?) | pw_filter(Xs?, R).

% cands(Cs, PCs): every candidate, and the positive whole numbers among them.
procedure contract_cands(NContract?, Cands).
contract_cands(NC, cands(Cs?, PCs?)) :- ground(NC?) |
    contract_nums(NC?, [], Ls),
    near_all([0, 1|Ls?], [], P0),
    nums_sort(P0?, [], P1),
    with_mids(P1?, P2),
    with_ends(P2?, Cs0),
    cands_pw(Cs0?, Cs, PCs).

procedure cands_pw(Nums?, Nums, Nums).
cands_pw(Cs, Cs?, PCs?) :- ground(Cs?) | pw_filter(Cs?, PCs).

% The act, its plain form, the contract as written and plain, and its
% reflexive predicates.
procedure try_leaf(Subst?, IntroCtx?, Try).
try_leaf(B, ic(S, NS, NC, C, Rf), R?) :-
    ground(B?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?) |
    intro_num(NS?, B?, T),
    try_leaf1(T?, B?, S?, NS?, NC?, C?, Rf?, R).

procedure try_leaf1(Tri?, Subst?, Schema?, NSchema?, NContract?, Contract?, Preds?, Try).
try_leaf1(no, _, _, _, _, _, _, t_none).
try_leaf1(T, B, S, NS, NC, C, Rf, R?) :-
    otherwise, ground(T?), ground(B?), ground(S?), ground(NS?), ground(NC?), ground(C?),
    ground(Rf?) |
    unobstructed(S?, NS?, B?, NC?, C?, Rf?, T?, F),
    leaf_try(F?, R).

procedure leaf_try(Faults?, Try).
leaf_try([], t_ok).
leaf_try([F|Fs], t_bad([F?|Fs?])).

procedure first_bad(Try?, Faults?, Try).
first_bad(t_none, F, t_bad(F?)).
first_bad(t_bad(F0), _, t_bad(F0?)).
first_bad(t_ok, _, t_ok).

% try_vals(Vs, Cd, Pw, B, Md, Ix, R): the values of Vs chosen in turn from
% the candidates Cd, a multiplicity of the act (Pw) from the positive whole
% ones; Md yes tries every choice until one meets the clauses, and no stops at
% the first introduction.
procedure try_vals(Args?, Cands?, Args?, Subst?, Ans?, IntroCtx?, Try).
try_vals([], _, _, B, _, Ix, R?) :- ground(B?), ground(Ix?) | try_leaf(B?, Ix?, R).
try_vals([V|Vs], Cd, Pw, B, Md, Ix, R?) :-
    ground(V?), ground(Vs?), ground(Cd?), ground(Pw?), ground(B?), ground(Md?), ground(Ix?) |
    args_member(Pw?, V?, P),
    var_cands(P?, Cd?, VC),
    try_cands(VC?, V?, Vs?, Cd?, Pw?, B?, Md?, Ix?, t_none, R).

procedure var_cands(Ans?, Cands?, Nums).
var_cands(yes, cands(_, PCs), PCs?).
var_cands(no, cands(Cs, _), Cs?).

procedure try_cands(Nums?, Arg?, Args?, Cands?, Args?, Subst?, Ans?, IntroCtx?, Try?, Try).
try_cands([], _, _, _, _, _, _, _, Acc, Acc?).
try_cands([N|Ns], V, Vs, Cd, Pw, B, Md, Ix, Acc, R?) :-
    number(N?), ground(Ns?), ground(V?), ground(Vs?), ground(Cd?), ground(Pw?), ground(B?),
    ground(Md?), ground(Ix?), ground(Acc?) |
    try_vals(Vs?, Cd?, Pw?, [bind(V?, nval(N?))|B?], Md?, Ix?, R1),
    try_next(R1?, Ns?, V?, Vs?, Cd?, Pw?, B?, Md?, Ix?, Acc?, R).

procedure try_next(Try?, Nums?, Arg?, Args?, Cands?, Args?, Subst?, Ans?, IntroCtx?, Try?, Try).
try_next(t_ok, _, _, _, _, _, _, _, _, _, t_ok).
try_next(t_bad(F), _, _, _, _, _, _, no, _, _, t_bad(F?)).
try_next(t_bad(F), Ns, V, Vs, Cd, Pw, B, yes, Ix, Acc, R?) :-
    ground(F?), ground(Ns?), ground(V?), ground(Vs?), ground(Cd?), ground(Pw?), ground(B?),
    ground(Ix?), ground(Acc?) |
    first_bad(Acc?, F?, Acc1),
    try_cands(Ns?, V?, Vs?, Cd?, Pw?, B?, yes, Ix?, Acc1?, R).
try_next(t_none, Ns, V, Vs, Cd, Pw, B, Md, Ix, Acc, R?) :-
    ground(Ns?), ground(V?), ground(Vs?), ground(Cd?), ground(Pw?), ground(B?), ground(Md?),
    ground(Ix?), ground(Acc?) |
    try_cands(Ns?, V?, Vs?, Cd?, Pw?, B?, Md?, Ix?, Acc?, R).

% One assignment B of the act's agent and speech-act variables: the clauses
% asked with its values unchosen, and, where an answer rests on them, the
% values chosen.
procedure intro_b(Subst?, IntroCtx?, Cands?, Try).
intro_b(B, ic(S, NS, NC, C, Rf), Cd, R?) :-
    ground(B?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?), ground(Cd?) |
    sch_vvars(NS?, Vs),
    num_ctx(NS?, Nx),
    intro_b1(Vs?, Nx?, B?, ic(S?, NS?, NC?, C?, Rf?), Cd?, R).

procedure intro_b1(Args?, NumCtx?, Subst?, IntroCtx?, Cands?, Try).
intro_b1(Vs, nc(_, Pw), B, Ix, Cd, R?) :-
    ground(Vs?), ground(Pw?), ground(B?), ground(Ix?), ground(Cd?) |
    sym_binds(Vs?, B?, Bs),
    try_leaf(Bs?, Ix?, T0),
    intro_b2(T0?, Vs?, Pw?, B?, Ix?, Cd?, R).

procedure intro_b2(Try?, Args?, Args?, Subst?, IntroCtx?, Cands?, Try).
intro_b2(t_ok, _, _, _, _, _, t_ok).
intro_b2(t_none, _, _, _, _, _, t_none).
intro_b2(t_bad(F), Vs, Pw, B, Ix, Cd, R?) :-
    ground(F?), ground(Vs?), ground(Pw?), ground(B?), ground(Ix?), ground(Cd?) |
    some_unsettled(F?, U),
    all_unsettled(F?, A),
    intro_b3(U?, A?, F?, Vs?, Pw?, B?, Ix?, Cd?, R).

procedure intro_b3(Ans?, Ans?, Faults?, Args?, Args?, Subst?, IntroCtx?, Cands?, Try).
intro_b3(no, _, F, _, _, _, _, _, t_bad(F?)).
intro_b3(yes, A, _, Vs, Pw, B, Ix, Cd, R?) :-
    ground(A?), ground(Vs?), ground(Pw?), ground(B?), ground(Ix?), ground(Cd?) |
    try_vals(Vs?, Cd?, Pw?, B?, A?, Ix?, R).

procedure note_cand(Cand?, Faults?, Cand).
note_cand(none, F, some(F?)).
note_cand(some(F), _, some(F?)).

procedure scan_end(Cand?, Faults).
scan_end(some(F), F?).
scan_end(none, [no_introductory_act]).

procedure intro_try1(Try?, Substs?, Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, Cands?, Cand?, Faults).
intro_try1(t_ok, _, _, _, _, _, _, _, _, _, []).
intro_try1(t_bad(F), Bs, S, NS, NSs, NC, C, Rf, Cd, Ca, R?) :-
    ground(F?), ground(Bs?), ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?),
    ground(Rf?), ground(Cd?), ground(Ca?) |
    note_cand(Ca?, F?, Ca1),
    intro_try(Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Cd?, Ca1?, R).
intro_try1(t_none, Bs, S, NS, NSs, NC, C, Rf, Cd, Ca, R?) :-
    ground(Bs?), ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?),
    ground(Cd?), ground(Ca?) |
    intro_try(Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Cd?, Ca?, R).

procedure intro_try(Substs?, Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, Cands?, Cand?, Faults).
intro_try([], _, _, NSs, NC, C, Rf, Cd, Ca, R?) :-
    ground(NSs?), ground(NC?), ground(C?), ground(Rf?), ground(Cd?), ground(Ca?) |
    intro_scan(NSs?, NC?, C?, Rf?, Cd?, Ca?, R).
intro_try([B|Bs], S, NS, NSs, NC, C, Rf, Cd, Ca, R?) :-
    ground(B?), ground(Bs?), ground(S?), ground(NS?), ground(NSs?), ground(NC?),
    ground(C?), ground(Rf?), ground(Cd?), ground(Ca?) |
    intro_b(B?, ic(S?, NS?, NC?, C?, Rf?), Cd?, T),
    intro_try1(T?, Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Cd?, Ca?, R).

procedure intro_scan1(Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, Cands?, Cand?, Faults).
intro_scan1(S, NS, NSs, NC, C, Rf, Cd, Ca, R?) :-
    ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?),
    ground(Cd?), ground(Ca?) |
    intro_act_bindings(S?, Bs),
    intro_try(Bs?, S?, NS?, NSs?, NC?, C?, Rf?, Cd?, Ca?, R).

procedure intro_scan(NContract?, NContract?, Contract?, Preds?, Cands?, Cand?, Faults).
intro_scan([], _, _, _, _, Ca, R?) :- ground(Ca?) | scan_end(Ca?, R).
intro_scan([NS|NSs], NC, C, Rf, Cd, Ca, R?) :-
    ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?), ground(Cd?), ground(Ca?) |
    plain_schema(NS?, S),
    intro_scan1(S?, NS?, NSs?, NC?, C?, Rf?, Cd?, Ca?, R).

procedure intro_result1(NContract?, Contract?, Preds?, Cands?, Faults).
intro_result1(NC, C, Rf, Cd, R?) :- ground(NC?), ground(C?), ground(Rf?), ground(Cd?) |
    intro_scan(NC?, NC?, C?, Rf?, Cd?, none, R).

% intro_result(NC, Rf, Faults): NC is the contract as written, Rf the
% predicates it declares reflexive.
exported procedure intro_result(NContract?, Preds?, Faults).
intro_result(NC, Rf, R?) :- ground(NC?), ground(Rf?) |
    plain_contract(NC?, C),
    contract_cands(NC?, Cd),
    intro_result1(NC?, C?, Rf?, Cd?, R).

% --- the introductory acts, for inspection ---------------------------------
% Each schema of the contract that is an introductory act (def:introduction),
% in the order of the contract: unobstructed where some introduction of it
% meets def:unobstructed, as intro_result decides it, and obstructed(Faults)
% otherwise, the faults of its first introduction, as intro_result reports
% them for the first introductory act.

IAS ::= ia(IntroStatus) ; ia_none.

procedure ia_end(Cand?, IAS).
ia_end(some(F), ia(obstructed(F?))).
ia_end(none, ia_none).

procedure ia_status1(Try?, Substs?, Schema?, NSchema?, NContract?, Contract?, Preds?, Cands?, Cand?, IAS).
ia_status1(t_ok, _, _, _, _, _, _, _, _, ia(unobstructed)).
ia_status1(t_bad(F), Bs, S, NS, NC, C, Rf, Cd, Ca, R?) :-
    ground(F?), ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?),
    ground(Cd?), ground(Ca?) |
    note_cand(Ca?, F?, Ca1),
    ia_status(Bs?, S?, NS?, NC?, C?, Rf?, Cd?, Ca1?, R).
ia_status1(t_none, Bs, S, NS, NC, C, Rf, Cd, Ca, R?) :-
    ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?), ground(Cd?),
    ground(Ca?) |
    ia_status(Bs?, S?, NS?, NC?, C?, Rf?, Cd?, Ca?, R).

procedure ia_status(Substs?, Schema?, NSchema?, NContract?, Contract?, Preds?, Cands?, Cand?, IAS).
ia_status([], _, _, _, _, _, _, Ca, R?) :- ground(Ca?) | ia_end(Ca?, R).
ia_status([B|Bs], S, NS, NC, C, Rf, Cd, Ca, R?) :-
    ground(B?), ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?),
    ground(Rf?), ground(Cd?), ground(Ca?) |
    intro_b(B?, ic(S?, NS?, NC?, C?, Rf?), Cd?, T),
    ia_status1(T?, Bs?, S?, NS?, NC?, C?, Rf?, Cd?, Ca?, R).

% A schema with an introduction is an introductory act, and is listed.
procedure ia_add1(IAS?, Constant?, IntroActs?, IntroActs).
ia_add1(ia(St), Nm, T, [intro_act(Nm?, St?)|T?]).
ia_add1(ia_none, _, T, T?).

procedure ia_add(Substs?, Schema?, NSchema?, NContract?, Contract?, Preds?, Cands?, IntroActs?, IntroActs).
ia_add(Bs, S, NS, NC, C, Rf, Cd, T, R?) :-
    ground(Bs?), ground(S?), ground(NS?), ground(NC?), ground(C?), ground(Rf?), ground(Cd?),
    ground(T?) |
    sch_name(S?, Nm),
    ia_status(Bs?, S?, NS?, NC?, C?, Rf?, Cd?, none, St),
    ia_add1(St?, Nm?, T?, R).

procedure ia_scan1(Schema?, NSchema?, NContract?, NContract?, Contract?, Preds?, Cands?, IntroActs).
ia_scan1(S, NS, NSs, NC, C, Rf, Cd, R?) :-
    ground(S?), ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?), ground(Cd?) |
    intro_act_bindings(S?, Bs),
    ia_scan(NSs?, NC?, C?, Rf?, Cd?, R1),
    ia_add(Bs?, S?, NS?, NC?, C?, Rf?, Cd?, R1?, R).

procedure ia_scan(NContract?, NContract?, Contract?, Preds?, Cands?, IntroActs).
ia_scan([], _, _, _, _, []).
ia_scan([NS|NSs], NC, C, Rf, Cd, R?) :-
    ground(NS?), ground(NSs?), ground(NC?), ground(C?), ground(Rf?), ground(Cd?) |
    plain_schema(NS?, S),
    ia_scan1(S?, NS?, NSs?, NC?, C?, Rf?, Cd?, R).

procedure intro_acts1(NContract?, Contract?, Preds?, Cands?, IntroActs).
intro_acts1(NC, C, Rf, Cd, R?) :- ground(NC?), ground(C?), ground(Rf?), ground(Cd?) |
    ia_scan(NC?, NC?, C?, Rf?, Cd?, R).

% intro_acts(NC, Rf, Acts): NC is the contract as written, Rf the predicates
% it declares reflexive.
exported procedure intro_acts(NContract?, Preds?, IntroActs).
intro_acts(NC, Rf, R?) :- ground(NC?), ground(Rf?) |
    plain_contract(NC?, C),
    contract_cands(NC?, Cd),
    intro_acts1(NC?, C?, Rf?, Cd?, R).
