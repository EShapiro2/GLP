%% gkk_fixture.glp --- a fixture of the checker's tests (programs/gsc/test_gsc.sh): GKK's schemas as a plain list of schemas, establish adding knows of oneself, as the Calculus first published them (2026-11-15, c475902); the tests build their small contracts on it.  It is no contract in force: the contract is GKK.txt, and GKK.glp is printed from it, knows declared reflexive.
procedure contract_named(Constant?, SDeclared).
contract_named(gkk_fixture, [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(knows, ['Alice', 'Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob'])]).
