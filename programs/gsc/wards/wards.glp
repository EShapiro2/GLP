% ---------------------------------------------------------------------------
% Contracts with wards: GSC's Section 8, "Contracts with Wards",
% /Grassroots/GSC, sections/07c-wards.tex at GSC 070c5d1 (7e00aba, eede0fa
% and a885275 before it, 2026-11-10), with def:extent of
% sections/03-schemas.tex;
% and, for an agent-named contract with wards, def:sg-wards of CSSN's paper,
% /Grassroots/CSSN, sections/appendix-schemas.tex.  The papers are the
% specification and no definition of them is restated here; each procedure
% names the definition it decides: def:kinds, def:guardianship,
% def:unobstructed-marks, def:relay, def:introduction-wards and def:sg-wards.
%
% def:introduction-wards is existential over finitely many things the
% contract supplies: its kinds (iota, f, M), iota and f marks, the
% predicates of arity zero, and M a nonempty set of other marks (def:kinds);
% for each mark in M a guardianship (m, v, u), v and u predicates whose first
% argument is an agent and whose other arguments are values
% (def:guardianship); an
% introductory act; and a relay act for each pair of marks of M that are not
% passive.  The pairs (iota, f) of distinct marks are tried in the order of
% the marks, each meeting clauses 1 and 4 of def:kinds, which ask nothing of
% M; for each, the guardianship candidates of each other mark are found
% once, the four clauses of def:guardianship asking of M nothing but the mark
% and of the kinds nothing but f; the nonempty sets M of marks having
% candidates are then tried in turn, each meeting clauses 2 and 3 of
% def:kinds, and each choice of one guardianship per mark with which C has
% guardianships (the last sentence of def:guardianship); the first with an
% introductory act unobstructed among the free and the relay acts of every
% pair of marks that are not passive is the answer.  The answer names
% [iota, f] where it named the leaving marks until GSC 7e00aba removed them.
% ---------------------------------------------------------------------------

% intro_act_bindings/2, the introductions of a schema, is unobstructed.glp's,
% which programs/gsc/self.glp exposes to its subtree: this module sits in the
% child directory wards/ of the checker, GSC's (Coordination Appendix B), and
% a cross-module qualifier names a child of the caller's directory and no
% sibling (TGLP, Section "Module System", "Cross-module type checking").

% ---------------------------------------------------------------------------
% The atoms of a contract and its predicates by arity
% ---------------------------------------------------------------------------

procedure rs_all_atoms(RoleSpec?, Atoms?, Atoms).
rs_all_atoms(RS, T, R?) :- ground(RS?), ground(T?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    rs_keep(RS?, K),
    rs_forb(RS?, N),
    atoms_app(N?, T?, R1),
    atoms_app(K?, R1?, R2),
    atoms_app(M?, R2?, R3),
    atoms_app(P?, R3?, R).

procedure roles_all_atoms(RoleSpecs?, Atoms?, Atoms).
roles_all_atoms([], T, T?).
roles_all_atoms([RS|Rs], T, R?) :- ground(RS?), ground(Rs?), ground(T?) |
    roles_all_atoms(Rs?, T?, R1),
    rs_all_atoms(RS?, R1?, R).

procedure contract_all_atoms(Contract?, Atoms?, Atoms).
contract_all_atoms([], T, T?).
contract_all_atoms([S|Ss], T, R?) :- ground(S?), ground(Ss?), ground(T?) |
    sch_roles(S?, Rs),
    contract_all_atoms(Ss?, T?, R1),
    roles_all_atoms(Rs?, R1?, R).

% The predicates of the atoms of N arguments among As, in order.
procedure atoms_of_arity1(Integer?, Integer?, Constant?, Atoms?, Preds?, Preds).
atoms_of_arity1(L, N, P, Xs, T, [P?|R?]) :-
    L? =:= N?, ground(P?), ground(Xs?), ground(T?) |
    atoms_of_arity(Xs?, N?, T?, R).
atoms_of_arity1(_, N, _, Xs, T, R?) :- otherwise, integer(N?), ground(Xs?), ground(T?) |
    atoms_of_arity(Xs?, N?, T?, R).

procedure atoms_of_arity(Atoms?, Integer?, Preds?, Preds).
atoms_of_arity([], _, T, T?).
atoms_of_arity([atom(P, As)|Xs], N, T, R?) :-
    ground(P?), ground(As?), ground(Xs?), integer(N?), ground(T?) |
    args_len(As?, L),
    atoms_of_arity1(L?, N?, P?, Xs?, T?, R).

% pred_arity(As, P, N, R): every atom of P among As has N arguments.
procedure pred_arity1(Integer?, Integer?, Atoms?, Constant?, Ans).
pred_arity1(L, N, Xs, P, R?) :- L? =:= N?, ground(Xs?), ground(P?) |
    pred_arity(Xs?, P?, N?, R).
pred_arity1(_, _, _, _, no) :- otherwise | true.

procedure pred_arity(Atoms?, Constant?, Integer?, Ans).
pred_arity([], _, _, yes).
pred_arity([atom(Q, As)|Xs], P, N, R?) :-
    Q? =?= P?, ground(As?), ground(Xs?), integer(N?) |
    args_len(As?, L),
    pred_arity1(L?, N?, Xs?, P?, R).
pred_arity([atom(_, _)|Xs], P, N, R?) :- otherwise, ground(Xs?), ground(P?), integer(N?) |
    pred_arity(Xs?, P?, N?, R).

procedure preds_of_arity1(Ans?, Constant?, Preds?, Atoms?, Integer?, Preds).
preds_of_arity1(yes, P, Ps, As, N, [P?|R?]) :- ground(Ps?), ground(As?), integer(N?) |
    preds_of_arity2(Ps?, As?, N?, R).
preds_of_arity1(no, _, Ps, As, N, R?) :- ground(Ps?), ground(As?), integer(N?) |
    preds_of_arity2(Ps?, As?, N?, R).

procedure preds_of_arity2(Preds?, Atoms?, Integer?, Preds).
preds_of_arity2([], _, _, []).
preds_of_arity2([P|Ps], As, N, R?) :- ground(P?), ground(Ps?), ground(As?), integer(N?) |
    pred_arity(As?, P?, N?, A),
    preds_of_arity1(A?, P?, Ps?, As?, N?, R).

% preds_of_arity(C, N, Ps): the predicates of C of arity N, in order of
% first occurrence: a mark is a predicate of arity zero (GSC, Section 8, "Contracts with Wards"), and g
% and w of a guardianship are predicates of arity one (def:guardianship).
procedure preds_of_arity3(Atoms?, Integer?, Preds).
preds_of_arity3(As, N, R?) :- ground(As?), integer(N?) |
    atoms_of_arity(As?, N?, [], P0),
    preds_dedup(P0?, P1),
    preds_of_arity2(P1?, As?, N?, R).

procedure preds_of_arity(Contract?, Integer?, Preds).
preds_of_arity(C, N, R?) :- ground(C?), integer(N?) |
    contract_all_atoms(C?, [], As),
    preds_of_arity3(As?, N?, R).

% ---------------------------------------------------------------------------
% Counting and small tests
% ---------------------------------------------------------------------------

% count_atom(Phis, Phi, N): the multiplicity of Phi in Phis.
procedure count_atom(Atoms?, Atom?, Integer).
count_atom([], _, 0).
count_atom([A|As], B, N?) :- A? =?= B?, ground(As?) |
    count_atom(As?, B?, M),
    N := M? + 1.
count_atom([_|As], B, N?) :- otherwise, ground(As?), ground(B?) |
    count_atom(As?, B?, N).

% count_pred(Phis, P, N): the number of atoms of P in Phis.
procedure count_pred(Atoms?, Constant?, Integer).
count_pred([], _, 0).
count_pred([atom(Q, _)|As], P, N?) :- Q? =?= P?, ground(As?) |
    count_pred(As?, P?, M),
    N := M? + 1.
count_pred([atom(_, _)|As], P, N?) :- otherwise, ground(As?), ground(P?) |
    count_pred(As?, P?, N).

procedure eq_ints(Integer?, Integer?, Ans).
eq_ints(A, B, yes) :- A? =:= B? | true.
eq_ints(_, _, no) :- otherwise | true.

procedure same_ans(Ans?, Ans?, Ans).
same_ans(A, B, yes) :- A? =?= B? | true.
same_ans(_, _, no) :- otherwise | true.

procedure same_atom(Atom?, Atom?, Ans).
same_atom(A, B, yes) :- A? =?= B? | true.
same_atom(_, _, no) :- otherwise | true.

procedure le_one(Integer?, Ans).
le_one(L, yes) :- L? =< 1 | true.
le_one(L, no) :- L? > 1 | true.

% deletes_at(RS, Phi, R): the role marks Phi -, or clears an atom it
% matches, -(i) being rs_del and the cleared atoms *(i) rs_clear
% (programs/gsc/self.glp).  GSC a885275 read deleting so; GSC 7e00aba no
% longer says it, and the answers are the same where deletes_at is asked: a
% mark has no argument and a cleared atom carries the wildcard as one, so no
% cleared atom deletes a mark; and no schema clears an atom of g or of w
% (def:guardianship, clause 1, never_cleared), which the candidates of
% clause 3 meet.
procedure deletes_at(RoleSpec?, Atom?, Ans).
deletes_at(RS, Phi, R?) :- ground(RS?), ground(Phi?) |
    rs_del(RS?, D),
    rs_clear(RS?, K),
    atoms_member(D?, Phi?, A1),
    matches_some_cleared(Phi?, K?, A2),
    or_yes(A1?, A2?, R).

% rs_deletes(RS, Ds): the atoms marked - at the role, cleared or not.
procedure rs_deletes(RoleSpec?, Atoms).
rs_deletes(RS, Ds?) :- ground(RS?) |
    rs_del(RS?, D),
    rs_clear(RS?, K),
    atoms_app(D?, K?, Ds).

% The marks of M among Phis, each once.
procedure marks_in1(Ans?, Constant?, Atoms?, Preds?, Preds).
marks_in1(yes, P, Xs, M, [P?|R?]) :- ground(Xs?), ground(M?) | marks_in(Xs?, M?, R).
marks_in1(no, _, Xs, M, R?) :- ground(Xs?), ground(M?) | marks_in(Xs?, M?, R).

procedure marks_in(Atoms?, Preds?, Preds).
marks_in([], _, []).
marks_in([atom(P, [])|Xs], M, R?) :- ground(P?), ground(Xs?), ground(M?) |
    pred_member(P?, M?, A),
    marks_in1(A?, P?, Xs?, M?, R).
marks_in([atom(_, [_|_])|Xs], M, R?) :- ground(Xs?), ground(M?) |
    marks_in(Xs?, M?, R).

% is_mark_of(Phi, M, R): Phi is the atom of a mark in M.
procedure is_mark_of(Atom?, Preds?, Ans).
is_mark_of(atom(P, []), M, R?) :- ground(P?), ground(M?) | pred_member(P?, M?, R).
is_mark_of(atom(_, [_|_]), _, no).

% rename_atom(Phi, I, Psi): Phi with its role I renamed to the one role of a
% schema of arity one ("up to renaming the role", def:unobstructed-marks).
procedure rename_arg(Arg?, Integer?, Arg).
rename_arg(role(J), I, role(1)) :- J? =:= I? | true.
rename_arg(sgn(Y, J), I, sgn(Y?, 1)) :- J? =:= I? | true.
rename_arg(A, _, A?) :- otherwise, ground(A?) | true.

procedure rename_args(Args?, Integer?, Args).
rename_args([], _, []).
rename_args([A|As], I, [B?|R?]) :- ground(A?), ground(As?), integer(I?) |
    rename_arg(A?, I?, B),
    rename_args(As?, I?, R).

procedure rename_atom(Atom?, Integer?, Atom).
rename_atom(atom(P, As), I, atom(P?, Bs?)) :- ground(P?), ground(As?), integer(I?) |
    rename_args(As?, I?, Bs).

% has_first_arg(Phis, P, A, R): some atom of P among Phis has A as its first
% argument, its other arguments whatever they are: an atom of v or of u naming
% an agent, v(rho, Zs) and u(sigma, Zs) (GSC eede0fa, def:guardianship).
procedure has_first_arg1(Ans?, Atoms?, Constant?, Arg?, Ans).
has_first_arg1(yes, _, _, _, yes).
has_first_arg1(no, Xs, P, A, R?) :- ground(Xs?), ground(P?), ground(A?) |
    has_first_arg(Xs?, P?, A?, R).

procedure has_first_arg(Atoms?, Constant?, Arg?, Ans).
has_first_arg([], _, _, no).
has_first_arg([atom(Q, [B|_])|Xs], P, A, R?) :-
    Q? =?= P?, ground(B?), ground(A?), B? =?= A?, ground(Xs?) |
    has_first_arg1(yes, Xs?, P?, A?, R).
has_first_arg([atom(_, _)|Xs], P, A, R?) :- otherwise, ground(Xs?), ground(P?), ground(A?) |
    has_first_arg(Xs?, P?, A?, R).

% has_pred(Phis, P, R): some atom of P is among Phis.
procedure has_pred(Atoms?, Constant?, Ans).
has_pred(Phis, P, R?) :- ground(Phis?), ground(P?) |
    count_pred(Phis?, P?, N),
    pos_ans(N?, R).

% first_role(As, F): the first argument of an atom where it is a role,
% role(S), and none otherwise.
procedure first_role(Args?, Guardian).
first_role([role(S)|_], guardian(S?)).
first_role(_, no_guardian) :- otherwise | true.

% all_any(As, R): every argument is the wildcard.
procedure all_any(Args?, Ans).
all_any([], yes).
all_any([any|As], R?) :- ground(As?) | all_any(As?, R).
all_any([_|_], no) :- otherwise | true.

% preds_agent_first(C, Ps): the predicates of C whose atoms have a first
% argument that is an agent, a role or an agent variable, or the wildcard of
% a cleared atom, and other arguments that are values, or the wildcard
% (def:guardianship, GSC eede0fa: v and u are "predicates whose first argument is an
% agent and whose other arguments, if any, are values"), in order of first
% occurrence; g and w, of arity one, are among them.
procedure value_args(Args?, Ans).
value_args([], yes).
value_args([num(_)|As], R?) :- ground(As?) | value_args(As?, R).
value_args([real(_)|As], R?) :- ground(As?) | value_args(As?, R).
value_args([any|As], R?) :- ground(As?) | value_args(As?, R).
value_args([_|_], no) :- otherwise | true.

procedure agent_first_args(Args?, Ans).
agent_first_args([role(_)|Zs], R?) :- ground(Zs?) | value_args(Zs?, R).
agent_first_args([pvar(_)|Zs], R?) :- ground(Zs?) | value_args(Zs?, R).
agent_first_args([any|Zs], R?) :- ground(Zs?) | value_args(Zs?, R).
agent_first_args(_, no) :- otherwise | true.

% pred_agent_first(As, P, R): every atom of P among As has such arguments.
procedure pred_agent_first1(Ans?, Atoms?, Constant?, Ans).
pred_agent_first1(no, _, _, no).
pred_agent_first1(yes, Xs, P, R?) :- ground(Xs?), ground(P?) | pred_agent_first(Xs?, P?, R).

procedure pred_agent_first(Atoms?, Constant?, Ans).
pred_agent_first([], _, yes).
pred_agent_first([atom(Q, As)|Xs], P, R?) :- Q? =?= P?, ground(As?), ground(Xs?) |
    agent_first_args(As?, A),
    pred_agent_first1(A?, Xs?, P?, R).
pred_agent_first([atom(_, _)|Xs], P, R?) :- otherwise, ground(Xs?), ground(P?) |
    pred_agent_first(Xs?, P?, R).

procedure preds_agent_first2(Ans?, Constant?, Preds?, Atoms?, Preds).
preds_agent_first2(yes, P, Ps, As, [P?|R?]) :- ground(Ps?), ground(As?) |
    preds_agent_first1(Ps?, As?, R).
preds_agent_first2(no, _, Ps, As, R?) :- ground(Ps?), ground(As?) |
    preds_agent_first1(Ps?, As?, R).

procedure preds_agent_first1(Preds?, Atoms?, Preds).
preds_agent_first1([], _, []).
preds_agent_first1([P|Ps], As, R?) :- ground(P?), ground(Ps?), ground(As?) |
    pred_agent_first(As?, P?, A),
    preds_agent_first2(A?, P?, Ps?, As?, R).

procedure all_preds_of(Atoms?, Preds).
all_preds_of([], []).
all_preds_of([atom(P, _)|Xs], [P?|R?]) :- ground(Xs?) | all_preds_of(Xs?, R).

procedure preds_agent_first(Contract?, Preds).
preds_agent_first(C, R?) :- ground(C?) |
    contract_all_atoms(C?, [], As),
    preds_agent_first0(As?, R).

procedure preds_agent_first0(Atoms?, Preds).
preds_agent_first0(As, R?) :- ground(As?) |
    all_preds_of(As?, P0),
    preds_dedup(P0?, P1),
    preds_agent_first1(P1?, As?, R).

% ---------------------------------------------------------------------------
% Kinds (def:kinds)
% ---------------------------------------------------------------------------

% Clause 1: no schema of C deletes iota or f; the second part of a passive
% mark too (def:guardianship).  A mark is deleted only by an atom marked -,
% no cleared atom matching one (deletes_at).
procedure roles_never_delete(RoleSpecs?, Constant?, Ans).
roles_never_delete([], _, yes).
roles_never_delete([RS|Rs], Io, R?) :- ground(RS?), ground(Rs?), ground(Io?) |
    deletes_at(RS?, atom(Io?, []), A),
    flip(A?, A1),
    roles_never_delete(Rs?, Io?, A2),
    both_yes(A1?, A2?, R).

procedure never_deleted(Contract?, Constant?, Ans).
never_deleted([], _, yes).
never_deleted([S|Ss], Io, R?) :- ground(S?), ground(Ss?), ground(Io?) |
    sch_roles(S?, Rs),
    roles_never_delete(Rs?, Io?, A1),
    never_deleted(Ss?, Io?, A2),
    both_yes(A1?, A2?, R).

procedure nonempty_preds(Preds?, Ans).
nonempty_preds([], no).
nonempty_preds([_|_], yes).

% count_marks(Phis, Ms, N): the atoms of the marks Ms among Phis are N.
procedure count_marks(Atoms?, Preds?, Integer).
count_marks(_, [], 0).
count_marks(P, [Mk|Ms], N?) :- ground(P?), ground(Mk?), ground(Ms?) |
    count_atom(P?, atom(Mk?, []), N1),
    count_marks(P?, Ms?, N2),
    N := N1? + N2?.

% if_then(A, B, R): R is yes unless A is yes and B no.
procedure if_then(Ans?, Ans?, Ans).
if_then(no, _, yes).
if_then(yes, B, B?).

% Clauses 2 and 3 at one role, the atoms it adds, deletes and forbids: where
% it adds iota it forbids iota there and adds there one atom of f and the
% marks in M in all; where it adds a mark in M it adds iota; where it adds f
% it adds iota or deletes a mark in M; and where it deletes a mark in M it
% adds f.  AM and DM answer whether it adds, and deletes, a mark in M: the
% roles of a schema adding one are at most one, and so are those deleting
% one (kinds_roles).
procedure kinds_role(RoleSpec?, Constant?, Constant?, Preds?, Ans, Ans, Ans).
kinds_role(RS, Io, F, M, R?, AM?, DM?) :- ground(RS?), ground(Io?), ground(F?), ground(M?) |
    rs_add(RS?, P),
    rs_del(RS?, D),
    rs_forb(RS?, N),
    kinds_role1(P?, D?, N?, Io?, F?, M?, R, AM, DM).

procedure kinds_role1(Atoms?, Atoms?, Atoms?, Constant?, Constant?, Preds?, Ans, Ans, Ans).
kinds_role1(P, D, N, Io, F, M, R?, AM?, DM?) :-
    ground(P?), ground(D?), ground(N?), ground(Io?), ground(F?), ground(M?) |
    atoms_member(P?, atom(Io?, []), AI),
    atoms_member(P?, atom(F?, []), AF),
    marks_in(P?, M?, PM),
    nonempty_preds(PM?, AM),
    marks_in(D?, M?, DMs),
    nonempty_preds(DMs?, DM),
    atoms_member(N?, atom(Io?, []), NI),
    count_marks(P?, [F?|M?], NF),
    eq_ints(NF?, 1, One),
    both_yes(NI?, One?, C1),
    if_then(AI?, C1?, B1),
    if_then(AM?, AI?, B2),
    or_yes(AI?, DM?, ID),
    if_then(AF?, ID?, B3),
    if_then(DM?, AF?, B4),
    both_yes(B1?, B2?, B12),
    both_yes(B3?, B4?, B34),
    both_yes(B12?, B34?, R).

procedure kinds_roles(RoleSpecs?, Constant?, Constant?, Preds?, Integer?, Integer?, Ans).
kinds_roles([], _, _, _, NA, ND, R?) :- integer(NA?), integer(ND?) |
    le_one(NA?, A1),
    le_one(ND?, A2),
    both_yes(A1?, A2?, R).
kinds_roles([RS|Rs], Io, F, M, NA, ND, R?) :-
    ground(RS?), ground(Rs?), ground(Io?), ground(F?), ground(M?), integer(NA?), integer(ND?) |
    kinds_role(RS?, Io?, F?, M?, A1, AM, DM),
    add_if(AM?, NA?, NA1),
    add_if(DM?, ND?, ND1),
    kinds_roles(Rs?, Io?, F?, M?, NA1?, ND1?, A2),
    both_yes(A1?, A2?, R).

% kinds_schemas(C, Io, F, M, R): clauses 2 and 3 at every schema of C.
procedure kinds_schemas(Contract?, Constant?, Constant?, Preds?, Ans).
kinds_schemas([], _, _, _, yes).
kinds_schemas([S|Ss], Io, F, M, R?) :-
    ground(S?), ground(Ss?), ground(Io?), ground(F?), ground(M?) |
    sch_roles(S?, Rs),
    kinds_roles(Rs?, Io?, F?, M?, 0, 0, A1),
    kinds_schemas(Ss?, Io?, F?, M?, A2),
    both_yes(A1?, A2?, R).

% Clause 4: an establishing act, a schema of arity one, guarded in its role,
% with no name term and with literals for its body and head, that adds iota
% and f, requires and clears nothing and forbids only iota.  A role's
% deletions are among what it requires (rs_req), and its cleared atoms among
% those it marks -, so the role marks nothing -.
procedure establishing1(RoleSpecs?, NameTerms?, Conjuncts?, Forms?, Constant?, Constant?, Ans).
establishing1([rs(guarded, P, [], [], [atom(J, [])])], [], [], [], Io, F, R?) :-
    J? =?= Io?, ground(P?), ground(F?) |
    atoms_member(P?, atom(Io?, []), A1),
    atoms_member(P?, atom(F?, []), A2),
    both_yes(A1?, A2?, R).
establishing1(Rs, _, _, _, _, _, no) :- otherwise, ground(Rs?) | true.

procedure establishing(Schema?, Constant?, Constant?, Ans).
establishing(Sc, Io, F, R?) :- ground(Sc?), ground(Io?), ground(F?) |
    sch_roles(Sc?, Rs),
    sch_nts(Sc?, Ns),
    sch_conjs(Sc?, Cs),
    sch_forms(Sc?, Fs),
    establishing1(Rs?, Ns?, Cs?, Fs?, Io?, F?, R).

procedure has_establishing(Contract?, Constant?, Constant?, Ans).
has_establishing([], _, _, no).
has_establishing([S|Ss], Io, F, R?) :- ground(S?), ground(Ss?), ground(Io?), ground(F?) |
    establishing(S?, Io?, F?, A1),
    has_establishing(Ss?, Io?, F?, A2),
    or_yes(A1?, A2?, R).

% kinds_base(C, Io, F, R): Io and F distinct, with clauses 1 and 4, which
% ask nothing of M.
procedure kinds_base(Contract?, Constant?, Constant?, Ans).
kinds_base(_, Io, F, no) :- Io? =?= F? | true.
kinds_base(C, Io, F, R?) :- otherwise, ground(C?), ground(Io?), ground(F?) |
    never_deleted(C?, Io?, A1),
    never_deleted(C?, F?, A2),
    has_establishing(C?, Io?, F?, A3),
    both_yes(A1?, A2?, A12),
    both_yes(A12?, A3?, R).

% kinds_ok(C, Io, F, M, R): C has kinds (Io, F, M), M a nonempty set of
% marks of C holding neither Io nor F.
procedure kinds_ok(Contract?, Constant?, Constant?, Preds?, Ans).
kinds_ok(C, Io, F, M, R?) :- ground(C?), ground(Io?), ground(F?), ground(M?) |
    kinds_base(C?, Io?, F?, A1),
    kinds_schemas(C?, Io?, F?, M?, A2),
    both_yes(A1?, A2?, R).

% ---------------------------------------------------------------------------
% Guardianship (def:guardianship)
% ---------------------------------------------------------------------------
% GSC 070c5d1: the guardianship is (m, v, u), the records g and w of the
% creation out (no proof uses them).  Clause 1 is the third and last parts of
% eede0fa's clause 1 asked of v and u alone, clause 2 the second part of its
% clause 3, clause 3 its clause 5 with f for iota and M and with passivity,
% and clause 4 its clause 6.  eede0fa's clause 2 and the second part of its
% clause 1 are clauses 2 and 3 of def:kinds, and its clause 7 the last
% sentence of def:guardianship, that C has guardianships.

% Clause 1, first part: no schema clears an atom of v, a cleared atom being one marked - with the wildcard (rs_clear).
procedure roles_never_clear(RoleSpecs?, Constant?, Ans).
roles_never_clear([], _, yes).
roles_never_clear([RS|Rs], P, R?) :- ground(RS?), ground(Rs?), ground(P?) |
    rs_clear(RS?, K),
    count_pred(K?, P?, N),
    eq_ints(N?, 0, A1),
    roles_never_clear(Rs?, P?, A2),
    both_yes(A1?, A2?, R).

procedure never_cleared(Contract?, Constant?, Ans).
never_cleared([], _, yes).
never_cleared([S|Ss], P, R?) :- ground(S?), ground(Ss?), ground(P?) |
    sch_roles(S?, Rs),
    roles_never_clear(Rs?, P?, A1),
    never_cleared(Ss?, P?, A2),
    both_yes(A1?, A2?, R).

% Clause 1, second part: a schema clears an atom of u only with
% a wildcard for each of its arguments.
procedure roles_u_clear(RoleSpecs?, Constant?, Ans).
roles_u_clear([], _, yes).
roles_u_clear([RS|Rs], U, R?) :- ground(RS?), ground(Rs?), ground(U?) |
    rs_clear(RS?, K),
    clears_all_any(K?, U?, A1),
    roles_u_clear(Rs?, U?, A2),
    both_yes(A1?, A2?, R).

procedure clears_all_any(Atoms?, Constant?, Ans).
clears_all_any([], _, yes).
clears_all_any([atom(Q, As)|Xs], U, R?) :- Q? =?= U?, ground(As?), ground(Xs?) |
    all_any(As?, A1),
    clears_all_any(Xs?, U?, A2),
    both_yes(A1?, A2?, R).
clears_all_any([atom(_, _)|Xs], U, R?) :- otherwise, ground(Xs?), ground(U?) |
    clears_all_any(Xs?, U?, R).

procedure u_clear_ok(Contract?, Constant?, Ans).
u_clear_ok([], _, yes).
u_clear_ok([S|Ss], U, R?) :- ground(S?), ground(Ss?), ground(U?) |
    sch_roles(S?, Rs),
    roles_u_clear(Rs?, U?, A1),
    u_clear_ok(Ss?, U?, A2),
    both_yes(A1?, A2?, R).

% Clause 2: a schema that deletes m at a role
% requires an atom of u there.
procedure role_del_m_u(Ans?, Atoms?, Constant?, Ans).
role_del_m_u(no, _, _, yes).
role_del_m_u(yes, Req, U, R?) :- ground(Req?), ground(U?) | has_pred(Req?, U?, R).

procedure roles_del_m_u(RoleSpecs?, Constant?, Constant?, Ans).
roles_del_m_u([], _, _, yes).
roles_del_m_u([RS|Rs], Mk, U, R?) :- ground(RS?), ground(Rs?), ground(Mk?), ground(U?) |
    rs_del(RS?, D),
    rs_req(RS?, Req),
    atoms_member(D?, atom(Mk?, []), A),
    role_del_m_u(A?, Req?, U?, A1),
    roles_del_m_u(Rs?, Mk?, U?, A2),
    both_yes(A1?, A2?, R).

procedure del_m_req_u(Contract?, Constant?, Constant?, Ans).
del_m_req_u([], _, _, yes).
del_m_req_u([S|Ss], Mk, U, R?) :- ground(S?), ground(Ss?), ground(Mk?), ground(U?) |
    sch_roles(S?, Rs),
    roles_del_m_u(Rs?, Mk?, U?, A1),
    del_m_req_u(Ss?, Mk?, U?, A2),
    both_yes(A1?, A2?, R).

% pos_ans(K, R): K is positive.
procedure pos_ans(Integer?, Ans).
pos_ans(K, yes) :- K? > 0 | true.
pos_ans(_, no) :- otherwise | true.

% Clause 3 (GSC 070c5d1): a schema adds u(sigma, Zs) at a role rho if and
% only if it adds v(rho, Zs) at sigma, a role of it at which it requires f;
% and it then adds m at rho, or requires m at rho and forbids u(sigma, Zs)
% there and, unless m is passive, requires an atom of u there.  The roles are
% the schema's by index, a listed role among them (rs_kind: role(I) names
% the listed role at I as it names an agent role); an atom of u or of v added
% whose first argument is no role of the schema fails the clause, there being
% no role to match it at.

% u_adds_ok(Xs, P, Req, N, I, All, Pa, F, Mk, V, U, R): every atom of U
% among Xs, the atoms P the role I adds, Req and N what I requires and
% forbids, meets the clause, Pa answering whether Mk is passive.
procedure u_adds_ok(Atoms?, Atoms?, Atoms?, Atoms?, Integer?, RoleSpecs?, Ans?, Constant?,
                    Constant?, Constant?, Constant?, Ans).
u_adds_ok([], _, _, _, _, _, _, _, _, _, _, yes).
u_adds_ok([atom(Q, As)|Xs], P, Req, N, I, All, Pa, F, Mk, V, U, R?) :-
    Q? =?= U?, ground(As?), ground(Xs?), ground(P?), ground(Req?), ground(N?), integer(I?),
    ground(All?), ground(Pa?), ground(F?), ground(Mk?), ground(V?) |
    first_role(As?, G),
    u_add_ok(G?, As?, P?, Req?, N?, I?, All?, Pa?, F?, Mk?, V?, U?, A1),
    u_adds_ok(Xs?, P?, Req?, N?, I?, All?, Pa?, F?, Mk?, V?, U?, A2),
    both_yes(A1?, A2?, R).
u_adds_ok([atom(_, _)|Xs], P, Req, N, I, All, Pa, F, Mk, V, U, R?) :-
    otherwise, ground(Xs?), ground(P?), ground(Req?), ground(N?), integer(I?), ground(All?),
    ground(Pa?), ground(F?), ground(Mk?), ground(V?), ground(U?) |
    u_adds_ok(Xs?, P?, Req?, N?, I?, All?, Pa?, F?, Mk?, V?, U?, R).

procedure u_add_ok(Guardian?, Args?, Atoms?, Atoms?, Atoms?, Integer?, RoleSpecs?, Ans?,
                   Constant?, Constant?, Constant?, Constant?, Ans).
u_add_ok(no_guardian, _, _, _, _, _, _, _, _, _, _, _, no).
u_add_ok(guardian(S), [_|Zs], P, Req, N, I, All, Pa, F, Mk, V, U, R?) :-
    integer(S?), ground(Zs?), ground(P?), ground(Req?), ground(N?), integer(I?), ground(All?),
    ground(Pa?), ground(F?), ground(Mk?), ground(V?), ground(U?) |
    nth_rs(All?, S?, RS),
    u_sigma_ok(RS?, V?, I?, Zs?, F?, A12),
    atoms_member(P?, atom(Mk?, []), B1),
    atoms_member(Req?, atom(Mk?, []), B2),
    atoms_member(N?, atom(U?, [role(S?)|Zs?]), B3),
    has_pred(Req?, U?, B4),
    or_yes(Pa?, B4?, B4p),
    both_yes(B2?, B3?, B23),
    both_yes(B23?, B4p?, B234),
    or_yes(B1?, B234?, B),
    both_yes(A12?, B?, R).

% The role sigma of clause 3: it adds v(rho, Zs) and requires f.
procedure u_sigma_ok(RoleSpec?, Constant?, Integer?, Args?, Constant?, Ans).
u_sigma_ok(RS, V, I, Zs, F, R?) :- ground(RS?), ground(V?), integer(I?), ground(Zs?), ground(F?) |
    rs_add(RS?, PS),
    rs_req(RS?, ReqS),
    atoms_member(PS?, atom(V?, [role(I?)|Zs?]), A1),
    atoms_member(ReqS?, atom(F?, []), A2),
    both_yes(A1?, A2?, R).

% The converse: every atom of V among Xs, the atoms the role S adds, names a
% role rho of the schema, v(rho, Zs), at which the schema adds u(S, Zs).
procedure v_adds_ok(Atoms?, Integer?, RoleSpecs?, Constant?, Constant?, Ans).
v_adds_ok([], _, _, _, _, yes).
v_adds_ok([atom(Q, As)|Xs], S, All, V, U, R?) :-
    Q? =?= V?, ground(As?), ground(Xs?), integer(S?), ground(All?), ground(U?) |
    first_role(As?, F),
    v_add_ok(F?, As?, S?, All?, U?, A1),
    v_adds_ok(Xs?, S?, All?, V?, U?, A2),
    both_yes(A1?, A2?, R).
v_adds_ok([atom(_, _)|Xs], S, All, V, U, R?) :-
    otherwise, ground(Xs?), integer(S?), ground(All?), ground(V?), ground(U?) |
    v_adds_ok(Xs?, S?, All?, V?, U?, R).

procedure v_add_ok(Guardian?, Args?, Integer?, RoleSpecs?, Constant?, Ans).
v_add_ok(no_guardian, _, _, _, _, no).
v_add_ok(guardian(I), [_|Zs], S, All, U, R?) :-
    integer(I?), ground(Zs?), integer(S?), ground(All?), ground(U?) |
    nth_rs(All?, I?, RS),
    rs_add(RS?, P),
    atoms_member(P?, atom(U?, [role(S?)|Zs?]), R).

procedure roles_uv_added(RoleSpecs?, Integer?, RoleSpecs?, Ans?, Constant?, Constant?,
                         Constant?, Constant?, Ans).
roles_uv_added([], _, _, _, _, _, _, _, yes).
roles_uv_added([RS|Rs], I, All, Pa, F, Mk, V, U, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(All?), ground(Pa?), ground(F?), ground(Mk?),
    ground(V?), ground(U?) |
    rs_add(RS?, P),
    rs_req(RS?, Req),
    rs_forb(RS?, N),
    role_uv_added(P?, Req?, N?, I?, All?, Pa?, F?, Mk?, V?, U?, A12),
    I1 := I? + 1,
    roles_uv_added(Rs?, I1?, All?, Pa?, F?, Mk?, V?, U?, A3),
    both_yes(A12?, A3?, R).

procedure role_uv_added(Atoms?, Atoms?, Atoms?, Integer?, RoleSpecs?, Ans?, Constant?, Constant?,
                        Constant?, Constant?, Ans).
role_uv_added(P, Req, N, I, All, Pa, F, Mk, V, U, R?) :-
    ground(P?), ground(Req?), ground(N?), integer(I?), ground(All?), ground(Pa?), ground(F?),
    ground(Mk?), ground(V?), ground(U?) |
    u_adds_ok(P?, P?, Req?, N?, I?, All?, Pa?, F?, Mk?, V?, U?, A1),
    v_adds_ok(P?, I?, All?, V?, U?, A2),
    both_yes(A1?, A2?, R).

procedure uv_added_roles(RoleSpecs?, Ans?, Constant?, Constant?, Constant?, Constant?, Ans).
uv_added_roles(Rs, Pa, F, Mk, V, U, R?) :-
    ground(Rs?), ground(Pa?), ground(F?), ground(Mk?), ground(V?), ground(U?) |
    roles_uv_added(Rs?, 1, Rs?, Pa?, F?, Mk?, V?, U?, R).

procedure uv_added_ok(Contract?, Ans?, Constant?, Constant?, Constant?, Constant?, Ans).
uv_added_ok([], _, _, _, _, _, yes).
uv_added_ok([S|Ss], Pa, F, Mk, V, U, R?) :-
    ground(S?), ground(Ss?), ground(Pa?), ground(F?), ground(Mk?), ground(V?), ground(U?) |
    sch_roles(S?, Rs),
    uv_added_roles(Rs?, Pa?, F?, Mk?, V?, U?, A1),
    uv_added_ok(Ss?, Pa?, F?, Mk?, V?, U?, A2),
    both_yes(A1?, A2?, R).

% Clause 4 (GSC 070c5d1): a schema deletes u(sigma, Zs) at a role rho if and
% only if it deletes v(rho, Zs) at sigma; and it clears u at rho if and only
% if it has the listed role rho[u(_, Zs)], its conjuncts with no condition,
% and deletes v(rho, Zs) at it.  An atom deleted is one marked - with no
% wildcard (rs_del); an atom cleared one marked - with the wildcard
% (rs_clear).  The first part is decided between agent roles, and between an
% agent role and a listed role that is not rho's listed role over u; the
% deletion of v(rho, Zs) at rho's listed role over u is the second part's,
% matched by the clearing of u at rho.  A listed role with no condition is
% one the reader writes listed/3, or qlisted/4 whose conjuncts, in the head
% and in the body, carry the condition true (programs/gsc/self.glp, sas_kind;
% def:extent at GSC 070c5d1: a condition leaves out of an act those it
% excludes, so a role whose extent a condition cuts is no clearing of u).

% u_dels_ok(Xs, I, All, V, U, R): every atom of U among Xs, those the role I
% marks -, names a role sigma at which the schema marks - v(I, Zs).
procedure u_dels_ok(Atoms?, Integer?, RoleSpecs?, Constant?, Constant?, Ans).
u_dels_ok([], _, _, _, _, yes).
u_dels_ok([atom(Q, As)|Xs], I, All, V, U, R?) :-
    Q? =?= U?, ground(As?), ground(Xs?), integer(I?), ground(All?), ground(V?) |
    first_role(As?, F),
    u_del_ok(F?, As?, I?, All?, V?, A1),
    u_dels_ok(Xs?, I?, All?, V?, U?, A2),
    both_yes(A1?, A2?, R).
u_dels_ok([atom(_, _)|Xs], I, All, V, U, R?) :-
    otherwise, ground(Xs?), integer(I?), ground(All?), ground(V?), ground(U?) |
    u_dels_ok(Xs?, I?, All?, V?, U?, R).

procedure u_del_ok(Guardian?, Args?, Integer?, RoleSpecs?, Constant?, Ans).
u_del_ok(no_guardian, _, _, _, _, no).
u_del_ok(guardian(S), [_|Zs], I, All, V, R?) :-
    integer(S?), ground(Zs?), integer(I?), ground(All?), ground(V?) |
    nth_rs(All?, S?, RS),
    rs_del(RS?, D),
    atoms_member(D?, atom(V?, [role(I?)|Zs?]), R).

% v_dels_ok(Xs, S, All, Sc, V, U, R): every atom of V among Xs, those the
% role S marks -, names a role rho, v(rho, Zs): where S is rho's listed role
% over u with no condition, rho clears u; otherwise rho marks - u(S, Zs).
procedure v_dels_ok(Atoms?, Integer?, RoleSpecs?, Schema?, Constant?, Constant?, Ans).
v_dels_ok([], _, _, _, _, _, yes).
v_dels_ok([atom(Q, As)|Xs], S, All, Sc, V, U, R?) :-
    Q? =?= V?, ground(As?), ground(Xs?), integer(S?), ground(All?), ground(Sc?), ground(U?) |
    first_role(As?, F),
    v_del_ok(F?, As?, S?, All?, Sc?, U?, A1),
    v_dels_ok(Xs?, S?, All?, Sc?, V?, U?, A2),
    both_yes(A1?, A2?, R).
v_dels_ok([atom(_, _)|Xs], S, All, Sc, V, U, R?) :-
    otherwise, ground(Xs?), integer(S?), ground(All?), ground(Sc?), ground(V?), ground(U?) |
    v_dels_ok(Xs?, S?, All?, Sc?, V?, U?, R).

procedure v_del_ok(Guardian?, Args?, Integer?, RoleSpecs?, Schema?, Constant?, Ans).
v_del_ok(no_guardian, _, _, _, _, _, no).
v_del_ok(guardian(I), [_|Zs], S, All, Sc, U, R?) :-
    integer(I?), ground(Zs?), integer(S?), ground(All?), ground(Sc?), ground(U?) |
    nth_rs(All?, S?, RSS),
    listed_of_over(RSS?, I?, U?, Sc?, L),
    nth_rs(All?, I?, RSI),
    v_del_ok1(L?, RSI?, S?, Zs?, U?, R).

procedure v_del_ok1(Ans?, RoleSpec?, Integer?, Args?, Constant?, Ans).
v_del_ok1(yes, RSI, _, _, U, R?) :- ground(RSI?), ground(U?) |
    rs_clear(RSI?, K),
    has_pred(K?, U?, R).
v_del_ok1(no, RSI, S, Zs, U, R?) :- ground(RSI?), integer(S?), ground(Zs?), ground(U?) |
    rs_del(RSI?, D),
    atoms_member(D?, atom(U?, [role(S?)|Zs?]), R).

% listed_of_over(RS, I, U, Sc, R): RS is the listed role of the agent role I
% over the predicate U, rho[u(_, Zs)], with no condition.
procedure listed_of_over(RoleSpec?, Integer?, Constant?, Schema?, Ans).
listed_of_over(crs(listed(J, P, _), _, _, _, _, _), I, U, _, R?) :-
    J? =:= I?, ground(P?), ground(U?), P? =?= U? | R = yes.
listed_of_over(crs(qlisted(J, P, _, _), _, _, _, _, _), I, U, Sc, R?) :-
    J? =:= I?, ground(P?), ground(U?), P? =?= U?, ground(Sc?) |
    sch_conjs(Sc?, Cs),
    sch_forms(Sc?, Fs),
    conjs_no_cond(Cs?, I?, U?, A1),
    forms_no_cond(Fs?, I?, U?, A2),
    both_yes(A1?, A2?, R).
listed_of_over(_, _, _, _, no) :- otherwise | true.

% The conjuncts of the head anchored at I on an atom of U carry the
% condition true; and so do the quantified formulas of the body held by I on
% an atom of U.
procedure no_cond(Form?, Ans).
no_cond(fcons(true), yes).
no_cond(_, no) :- otherwise | true.

procedure conjs_no_cond(Conjuncts?, Integer?, Constant?, Ans).
conjs_no_cond([], _, _, yes).
conjs_no_cond([conjunct(_, J, atom(P, _), Phi, _, _, _)|Cs], I, U, R?) :-
    J? =:= I?, ground(P?), ground(U?), P? =?= U?, ground(Phi?), ground(Cs?) |
    no_cond(Phi?, A1),
    conjs_no_cond(Cs?, I?, U?, A2),
    both_yes(A1?, A2?, R).
conjs_no_cond([_|Cs], I, U, R?) :- otherwise, ground(Cs?), integer(I?), ground(U?) |
    conjs_no_cond(Cs?, I?, U?, R).

procedure forms_no_cond(Forms?, Integer?, Constant?, Ans).
forms_no_cond([], _, _, yes).
forms_no_cond([fforall(_, role(J), atom(P, _), Phi, _)|Fs], I, U, R?) :-
    J? =:= I?, ground(P?), ground(U?), P? =?= U?, ground(Phi?), ground(Fs?) |
    no_cond(Phi?, A1),
    forms_no_cond(Fs?, I?, U?, A2),
    both_yes(A1?, A2?, R).
forms_no_cond([_|Fs], I, U, R?) :- otherwise, ground(Fs?), integer(I?), ground(U?) |
    forms_no_cond(Fs?, I?, U?, R).

% The second part, the clearing: a role I that clears u has a listed role
% over u with no condition at which the schema marks - an atom of v naming I.
procedure clears_u_ok(Ans?, Integer?, RoleSpecs?, Schema?, Constant?, Constant?, Ans).
clears_u_ok(no, _, _, _, _, _, yes).
clears_u_ok(yes, I, All, Sc, V, U, R?) :-
    integer(I?), ground(All?), ground(Sc?), ground(V?), ground(U?) |
    some_listed_dels(All?, I?, Sc?, V?, U?, R).

procedure some_listed_dels(RoleSpecs?, Integer?, Schema?, Constant?, Constant?, Ans).
some_listed_dels([], _, _, _, _, no).
some_listed_dels([RS|Rs], I, Sc, V, U, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Sc?), ground(V?), ground(U?) |
    listed_of_over(RS?, I?, U?, Sc?, L),
    rs_del(RS?, D),
    has_first_arg(D?, V?, role(I?), A),
    both_yes(L?, A?, A1),
    some_listed_dels(Rs?, I?, Sc?, V?, U?, A2),
    or_yes(A1?, A2?, R).

procedure roles_uv_deleted(RoleSpecs?, Integer?, RoleSpecs?, Schema?, Constant?, Constant?, Ans).
roles_uv_deleted([], _, _, _, _, _, yes).
roles_uv_deleted([RS|Rs], I, All, Sc, V, U, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(All?), ground(Sc?), ground(V?), ground(U?) |
    rs_del(RS?, D),
    uv_dels_ok(D?, I?, All?, Sc?, V?, U?, A12),
    rs_clear(RS?, K),
    has_pred(K?, U?, Cl),
    clears_u_ok(Cl?, I?, All?, Sc?, V?, U?, A3),
    I1 := I? + 1,
    roles_uv_deleted(Rs?, I1?, All?, Sc?, V?, U?, A4),
    both_yes(A3?, A4?, A34),
    both_yes(A12?, A34?, R).

procedure uv_dels_ok(Atoms?, Integer?, RoleSpecs?, Schema?, Constant?, Constant?, Ans).
uv_dels_ok(D, I, All, Sc, V, U, R?) :-
    ground(D?), integer(I?), ground(All?), ground(Sc?), ground(V?), ground(U?) |
    u_dels_ok(D?, I?, All?, V?, U?, A1),
    v_dels_ok(D?, I?, All?, Sc?, V?, U?, A2),
    both_yes(A1?, A2?, R).

procedure uv_deleted_roles(RoleSpecs?, Schema?, Constant?, Constant?, Ans).
uv_deleted_roles(Rs, S, V, U, R?) :- ground(Rs?), ground(S?), ground(V?), ground(U?) |
    roles_uv_deleted(Rs?, 1, Rs?, S?, V?, U?, R).

procedure uv_deleted_ok(Contract?, Constant?, Constant?, Ans).
uv_deleted_ok([], _, _, yes).
uv_deleted_ok([S|Ss], V, U, R?) :- ground(S?), ground(Ss?), ground(V?), ground(U?) |
    sch_roles(S?, Rs),
    uv_deleted_roles(Rs?, S?, V?, U?, A1),
    uv_deleted_ok(Ss?, V?, U?, A2),
    both_yes(A1?, A2?, R).

% C has guardianships (GSC 0a30d52, the last sentence of def:guardianship):
% every mark in M has one, and every guarding role pi of every schema of C
% forbids iota, requires f, requires a mark in M and an atom of the u of its
% guardianship, or has in the body of its schema that pi can act, "the safe
% formula f(pi) or, over the marks m of M that are not passive, m(pi) and
% exists x, zs u_m(pi, x, zs)" (can_act).  Decided on a choice Gs of one
% guardianship per mark of M (try_combos).
procedure req_mark_u(Atoms?, Guardianships?, Ans).
req_mark_u(_, [], no).
req_mark_u(Req, [guardianship(Mk, _, U)|Gs], R?) :-
    ground(Req?), ground(Mk?), ground(U?), ground(Gs?) |
    atoms_member(Req?, atom(Mk?, []), A1),
    has_pred(Req?, U?, A2),
    both_yes(A1?, A2?, A12),
    req_mark_u(Req?, Gs?, A3),
    or_yes(A12?, A3?, R).

% gp(Io, F, Gs, AMs): what a guarding role is held to, AMs the marks of M
% that are not passive.
procedure guard_role_ok(Ans?, Atoms?, Atoms?, Forms?, Integer?, GuardParts?, Ans).
guard_role_ok(no, _, _, _, _, _, yes).
guard_role_ok(yes, Req, N, Fs, I, gp(Io, F, Gs, AMs), R?) :-
    ground(Req?), ground(N?), ground(Fs?), integer(I?), ground(Io?), ground(F?), ground(Gs?),
    ground(AMs?) |
    atoms_member(N?, atom(Io?, []), A1),
    atoms_member(Req?, atom(F?, []), A2),
    req_mark_u(Req?, Gs?, A3),
    can_act(Fs?, I?, F?, AMs?, Gs?, A4),
    or_yes(A1?, A2?, A12),
    or_yes(A3?, A4?, A34),
    or_yes(A12?, A34?, R).

procedure roles_guard_ok(RoleSpecs?, Forms?, Integer?, GuardParts?, Ans).
roles_guard_ok([], _, _, _, yes).
roles_guard_ok([RS|Rs], Fs, I, P, R?) :-
    ground(RS?), ground(Rs?), ground(Fs?), integer(I?), ground(P?) |
    is_guarding(RS?, G),
    rs_req(RS?, Req),
    rs_forb(RS?, N),
    guard_role_ok(G?, Req?, N?, Fs?, I?, P?, A1),
    I1 := I? + 1,
    roles_guard_ok(Rs?, Fs?, I1?, P?, A2),
    both_yes(A1?, A2?, R).

procedure guards_ok(Contract?, GuardParts?, Ans).
guards_ok([], _, yes).
guards_ok([S|Ss], P, R?) :- ground(S?), ground(Ss?), ground(P?) |
    sch_roles(S?, Rs),
    sch_forms(S?, Fs0),
    conj_flat(Fs0?, [], Fs),
    roles_guard_ok(Rs?, Fs?, 1, P?, A1),
    guards_ok(Ss?, P?, A2),
    both_yes(A1?, A2?, R).

% guards_ok_k(C, K, Gs, R): the same, K being [iota, f] and Gs one
% guardianship per mark of M.
procedure guards_ok_k(Contract?, Preds?, Guardianships?, Ans).
guards_ok_k(C, [Io, F], Gs, R?) :- ground(C?), ground(Io?), ground(F?), ground(Gs?) |
    gs_marks(Gs?, M),
    active_marks(C?, M?, AMs),
    guards_ok(C?, gp(Io?, F?, Gs?, AMs?), R).
guards_ok_k(_, K, _, no) :- otherwise, ground(K?) | true.

procedure gs_marks(Guardianships?, Preds).
gs_marks([], []).
gs_marks([guardianship(Mk, _, _)|Gs], [Mk?|R?]) :- gs_marks(Gs?, R).

% The conjuncts of the safe formulas of a body, its conjunctions opened.
procedure conj_flat(Forms?, Forms?, Forms).
conj_flat([], T, T?).
conj_flat([fand(A, B)|Fs], T, R?) :- ground(A?), ground(B?), ground(Fs?), ground(T?) |
    conj_flat(Fs?, T?, T1),
    conj_flat([A?, B?], T1?, R).
conj_flat([Fm|Fs], T, [Fm?|R?]) :- otherwise, ground(Fs?), ground(T?) | conj_flat(Fs?, T?, R).

% can_act(Fs, I, F, AMs, Gs, R): some conjunct among Fs is that the role I
% can act: a disjunction, in any order, of f(pi) and, for each mark m of AMs,
% m(pi) and exists Xs u_m(pi, ...), every argument of the atom of u_m but its
% holder a variable Xs binds, the condition true and the conjunction either
% way round; nothing else among its disjuncts, and every one of them there.
procedure can_act(Forms?, Integer?, Constant?, Preds?, Guardianships?, Ans).
can_act([], _, _, _, _, no).
can_act([Fm|Fs], I, F, AMs, Gs, R?) :-
    ground(Fm?), ground(Fs?), integer(I?), ground(F?), ground(AMs?), ground(Gs?) |
    disjuncts(Fm?, [], Ds),
    can_act_ds(Ds?, I?, F?, AMs?, Gs?, A),
    can_act(Fs?, I?, F?, AMs?, Gs?, B),
    or_yes(A?, B?, R).

procedure disjuncts(Form?, Forms?, Forms).
disjuncts(for(A, B), T, R?) :- ground(A?), ground(B?), ground(T?) |
    disjuncts(B?, T?, T1),
    disjuncts(A?, T1?, R).
disjuncts(Fm, T, [Fm?|T?]) :- otherwise | true.

% The disjuncts read as the marks they are of, f's or a mark of M's, each
% being one; then those marks are f and AMs, each once.
procedure can_act_ds(Forms?, Integer?, Constant?, Preds?, Guardianships?, Ans).
can_act_ds(Ds, I, F, AMs, Gs, R?) :-
    ground(Ds?), integer(I?), ground(F?), ground(AMs?), ground(Gs?) |
    disj_keys(Ds?, I?, F?, Gs?, Ok, Ks),
    keys_cover(Ok?, Ks?, [F?|AMs?], R).

procedure disj_keys(Forms?, Integer?, Constant?, Guardianships?, Ans, Preds).
disj_keys([], _, _, _, yes, []).
disj_keys([D|Ds], I, F, Gs, Ok?, Ks?) :- ground(D?), ground(Ds?), integer(I?), ground(F?), ground(Gs?) |
    disj_key(D?, I?, F?, Gs?, A, K),
    disj_keys(Ds?, I?, F?, Gs?, B, Ks1),
    both_yes(A?, B?, Ok),
    keys_cons(A?, K?, Ks1?, Ks).

procedure keys_cons(Ans?, Constant?, Preds?, Preds).
keys_cons(yes, K, T, [K?|T?]).
keys_cons(no, _, T, T?).

% One disjunct: f(pi), or m(pi) and exists Xs u_m(pi, Xs...) for a mark m
% with a guardianship among Gs.
procedure disj_key(Form?, Integer?, Constant?, Guardianships?, Ans, Constant).
disj_key(fa(role(J), atom(P, [])), I, F, _, yes, F?) :- J? =:= I?, ground(P?), ground(F?), P? =?= F? | true.
disj_key(fand(fa(role(J), atom(Mk, [])), E), I, _, Gs, R?, Mk?) :-
    J? =:= I?, ground(Mk?), ground(E?), ground(Gs?) |
    u_of(Gs?, Mk?, U),
    exists_u(E?, I?, U?, R).
disj_key(fand(E, fa(role(J), atom(Mk, []))), I, _, Gs, R?, Mk?) :-
    J? =:= I?, ground(Mk?), ground(E?), ground(Gs?) |
    u_of(Gs?, Mk?, U),
    exists_u(E?, I?, U?, R).
disj_key(_, _, F, _, no, F?) :- otherwise | true.

procedure exists_u(Form?, Integer?, Constant?, Ans).
exists_u(fexists(Xs, role(J), atom(Q, As), fcons(true)), I, U, R?) :-
    J? =:= I?, ground(Xs?), ground(Q?), ground(As?), ground(U?), Q? =?= U? |
    all_bound(As?, Xs?, R).
exists_u(_, _, _, no) :- otherwise | true.

procedure all_bound(Args?, Args?, Ans).
all_bound([], _, yes).
all_bound([A|As], Xs, R?) :- ground(A?), ground(As?), ground(Xs?) |
    args_member(Xs?, A?, R1),
    all_bound(As?, Xs?, R2),
    both_yes(R1?, R2?, R).

% Every key is among Ws and every member of Ws among the keys.
procedure keys_cover(Ans?, Preds?, Preds?, Ans).
keys_cover(no, _, _, no).
keys_cover(yes, Ks, Ws, R?) :- ground(Ks?), ground(Ws?) |
    preds_within(Ks?, Ws?, A),
    preds_within(Ws?, Ks?, B),
    both_yes(A?, B?, R).

procedure preds_within(Preds?, Preds?, Ans).
preds_within([], _, yes).
preds_within([P|Ps], Ws, R?) :- ground(P?), ground(Ps?), ground(Ws?) |
    pred_member(P?, Ws?, A),
    preds_within(Ps?, Ws?, B),
    both_yes(A?, B?, R).

% --- the candidates of a mark (GSC 070c5d1) ---------------------------------
% The vs with clause 1 (first part); and for each v the us with clauses 1
% (second part), 2, 3 and 4.  Clause 3 reads f and whether the mark is
% passive; that C has guardianships is decided on the choice of one
% guardianship per mark (guards_ok_k, try_combos).

% us_ok(C, Us, Pa, Mk, F, V, T, R): the guardianships (Mk, V, U) for U among
% Us, before T.
procedure us_ok1(Ans?, Constant?, Preds?, Contract?, Ans?, Constant?, Constant?, Constant?,
                 Guardianships?, Guardianships).
us_ok1(yes, U, Us, C, Pa, Mk, F, V, T, [guardianship(Mk?, V?, U?)|R?]) :-
    ground(U?), ground(Us?), ground(C?), ground(Pa?), ground(Mk?), ground(F?), ground(V?),
    ground(T?) |
    us_ok(C?, Us?, Pa?, Mk?, F?, V?, T?, R).
us_ok1(no, _, Us, C, Pa, Mk, F, V, T, R?) :-
    ground(Us?), ground(C?), ground(Pa?), ground(Mk?), ground(F?), ground(V?), ground(T?) |
    us_ok(C?, Us?, Pa?, Mk?, F?, V?, T?, R).

procedure us_ok(Contract?, Preds?, Ans?, Constant?, Constant?, Constant?, Guardianships?,
                Guardianships).
us_ok(_, [], _, _, _, _, T, T?).
us_ok(C, [U|Us], Pa, Mk, F, V, T, R?) :-
    ground(C?), ground(U?), ground(Us?), ground(Pa?), ground(Mk?), ground(F?), ground(V?),
    ground(T?) |
    u_clear_ok(C?, U?, A1),
    del_m_req_u(C?, Mk?, U?, A2),
    uv_added_ok(C?, Pa?, F?, Mk?, V?, U?, A3),
    uv_deleted_ok(C?, V?, U?, A4),
    both_yes(A1?, A2?, A12),
    both_yes(A3?, A4?, A34),
    both_yes(A12?, A34?, A),
    us_ok1(A?, U?, Us?, C?, Pa?, Mk?, F?, V?, T?, R).

% vs_ok(C, Vs, AF, Pa, Mk, F, T, R): over the vs Vs, AF being every predicate
% of C with an agent first (preds_agent_first), among which the us are
% sought.
procedure vs_ok1(Ans?, Constant?, Preds?, Contract?, Preds?, Ans?, Constant?, Constant?,
                 Guardianships?, Guardianships).
vs_ok1(yes, V, Vs, C, AF, Pa, Mk, F, T, R?) :-
    ground(V?), ground(Vs?), ground(C?), ground(AF?), ground(Pa?), ground(Mk?), ground(F?),
    ground(T?) |
    vs_ok(C?, Vs?, AF?, Pa?, Mk?, F?, T?, R1),
    us_ok(C?, AF?, Pa?, Mk?, F?, V?, R1?, R).
vs_ok1(no, _, Vs, C, AF, Pa, Mk, F, T, R?) :-
    ground(Vs?), ground(C?), ground(AF?), ground(Pa?), ground(Mk?), ground(F?), ground(T?) |
    vs_ok(C?, Vs?, AF?, Pa?, Mk?, F?, T?, R).

procedure vs_ok(Contract?, Preds?, Preds?, Ans?, Constant?, Constant?, Guardianships?,
                Guardianships).
vs_ok(_, [], _, _, _, _, T, T?).
vs_ok(C, [V|Vs], AF, Pa, Mk, F, T, R?) :-
    ground(C?), ground(V?), ground(Vs?), ground(AF?), ground(Pa?), ground(Mk?), ground(F?),
    ground(T?) |
    never_cleared(C?, V?, A),
    vs_ok1(A?, V?, Vs?, C?, AF?, Pa?, Mk?, F?, T?, R).

% cands_for(C, AF, F, Mk, Gs): every guardianship (Mk, v, u) of the mark Mk in
% C for the mark f F, v and u among AF.
procedure cands_for(Contract?, Preds?, Constant?, Constant?, Guardianships).
cands_for(C, AF, F, Mk, Gs?) :- ground(C?), ground(AF?), ground(F?), ground(Mk?) |
    passive_mark(C?, Mk?, Pa),
    vs_ok(C?, AF?, AF?, Pa?, Mk?, F?, [], Gs).

procedure guardianships_marks(Contract?, Preds?, Constant?, Preds?, Guardianships).
guardianships_marks(_, _, _, [], []).
guardianships_marks(C, AF, F, [Mk|Mks], R?) :-
    ground(C?), ground(AF?), ground(F?), ground(Mk?), ground(Mks?) |
    cands_for(C?, AF?, F?, Mk?, G1),
    guardianships_marks(C?, AF?, F?, Mks?, G2),
    gs_app(G1?, G2?, R).

procedure gs_app(Guardianships?, Guardianships?, Guardianships).
gs_app([], T, T?).
gs_app([G|Gs], T, [G?|R?]) :- gs_app(Gs?, T?, R).

procedure guardianships_for1(Ans?, Contract?, Constant?, Preds?, Guardianships).
guardianships_for1(no, _, _, _, []).
guardianships_for1(yes, C, F, M, R?) :- ground(C?), ground(F?), ground(M?) |
    preds_agent_first(C?, AF),
    guardianships_marks(C?, AF?, F?, M?, R).

% guardianships_for(C, K, M, Gs): every guardianship of every mark of M, K
% being [iota, f]; none unless C has kinds (iota, f, M) (def:kinds), which
% def:guardianship supposes.
exported procedure guardianships_for(Contract?, Preds?, Preds?, Guardianships).
guardianships_for(C, [Io, F], M, R?) :- ground(C?), ground(Io?), ground(F?), ground(M?) |
    kinds_ok(C?, Io?, F?, M?, A),
    guardianships_for1(A?, C?, F?, M?, R).
guardianships_for(_, K, _, []) :- otherwise, ground(K?) | true.

% ---------------------------------------------------------------------------
% Passive marks (def:guardianship)
% ---------------------------------------------------------------------------
% A mark is passive if no guarding role of a schema of C requires it and no
% schema of C deletes it (GSC 7e00aba); a ward of a passive kind takes no
% act, and her kind needs no relay act (def:introduction-wards).  Leaving
% marks are gone at GSC 7e00aba: a ward with no guardian has left.
procedure role_guard_reqs(Ans?, Atoms?, Constant?, Ans).
role_guard_reqs(no, _, _, no).
role_guard_reqs(yes, Req, Mk, R?) :- ground(Req?), ground(Mk?) |
    atoms_member(Req?, atom(Mk?, []), R).

procedure roles_guard_req(RoleSpecs?, Constant?, Ans).
roles_guard_req([], _, no).
roles_guard_req([RS|Rs], Mk, R?) :- ground(RS?), ground(Rs?), ground(Mk?) |
    is_guarding(RS?, G),
    rs_req(RS?, Req),
    role_guard_reqs(G?, Req?, Mk?, A1),
    roles_guard_req(Rs?, Mk?, A2),
    or_yes(A1?, A2?, R).

procedure guards_req(Contract?, Constant?, Ans).
guards_req([], _, no).
guards_req([S|Ss], Mk, R?) :- ground(S?), ground(Ss?), ground(Mk?) |
    sch_roles(S?, Rs),
    roles_guard_req(Rs?, Mk?, A1),
    guards_req(Ss?, Mk?, A2),
    or_yes(A1?, A2?, R).

procedure passive_mark(Contract?, Constant?, Ans).
passive_mark(C, Mk, R?) :- ground(C?), ground(Mk?) |
    guards_req(C?, Mk?, A1),
    flip(A1?, A1n),
    never_deleted(C?, Mk?, A2),
    both_yes(A1n?, A2?, R).

procedure active_marks1(Ans?, Constant?, Preds?, Contract?, Preds).
active_marks1(yes, _, Ms, C, R?) :- ground(Ms?), ground(C?) | active_marks(C?, Ms?, R).
active_marks1(no, Mk, Ms, C, [Mk?|R?]) :- ground(Ms?), ground(C?) | active_marks(C?, Ms?, R).

% active_marks(C, M, Ms): the marks of M that are not passive, in order.
procedure active_marks(Contract?, Preds?, Preds).
active_marks(_, [], []).
active_marks(C, [Mk|Ms], R?) :- ground(C?), ground(Mk?), ground(Ms?) |
    passive_mark(C?, Mk?, A),
    active_marks1(A?, Mk?, Ms?, C?, R).

% ---------------------------------------------------------------------------
% Unobstructed among the free (def:unobstructed-marks)
% ---------------------------------------------------------------------------
% GSC 7e00aba: tau forbids nothing, and every atom it requires at a role is
% iota, f, an atom of a reflexive predicate naming the role, or, up to
% renaming the role, the one atom added by some schema of C of arity one that
% is guarded in its role, has no name term, has literals for its body and
% head, requires nothing but iota and f, clears nothing and forbids nothing
% but that atom.  K is [iota, f] here and in def:relay.

% reqs_kinds(Phis, K, R): every atom of Phis is a mark of K.
procedure reqs_kinds(Atoms?, Preds?, Ans).
reqs_kinds([], _, yes).
reqs_kinds([A|As], K, R?) :- ground(A?), ground(As?), ground(K?) |
    is_mark_of(A?, K?, A1),
    reqs_kinds(As?, K?, A2),
    both_yes(A1?, A2?, R).

% forb_only(Phis, Phi, R): every atom of Phis is Phi.
procedure forb_only(Atoms?, Atom?, Ans).
forb_only([], _, yes).
forb_only([A|As], Phi, R?) :- ground(A?), ground(As?), ground(Phi?) |
    same_atom(A?, Phi?, A1),
    forb_only(As?, Phi?, A2),
    both_yes(A1?, A2?, R).

% unary_one(C, K, Phi, I, R): Phi, required at role I, is that atom.  Its
% schema's one role is an agent role (def:sg-wards, clause 1; for a contract
% of Section 3 it asks nothing), with no name term and no quantifier; it
% marks nothing -, a role's deletions being among what it requires (rs_req)
% and its cleared atoms among those it marks -.
procedure unary_adds1(RoleSpecs?, NameTerms?, Conjuncts?, Forms?, Preds?, Atom?, Ans).
unary_adds1([rs(guarded, [Psi], [], Keep, Forb)], [], [], [], K, Phi, R?) :-
    Psi? =?= Phi?, ground(Keep?), ground(Forb?), ground(K?) |
    reqs_kinds(Keep?, K?, A1),
    forb_only(Forb?, Phi?, A2),
    both_yes(A1?, A2?, R).
unary_adds1(Rs, _, _, _, _, _, no) :- otherwise, ground(Rs?) | true.

procedure unary_adds(Schema?, Preds?, Atom?, Ans).
unary_adds(Sc, K, Phi, R?) :- ground(Sc?), ground(K?), ground(Phi?) |
    sch_roles(Sc?, Rs),
    sch_nts(Sc?, Ns),
    sch_conjs(Sc?, Cs),
    sch_forms(Sc?, Fs),
    unary_adds1(Rs?, Ns?, Cs?, Fs?, K?, Phi?, R).

procedure unary_one1(Ans?, Contract?, Preds?, Atom?, Ans).
unary_one1(yes, _, _, _, yes).
unary_one1(no, Ss, K, Psi, R?) :- ground(Ss?), ground(K?), ground(Psi?) |
    unary_one2(Ss?, K?, Psi?, R).

procedure unary_one2(Contract?, Preds?, Atom?, Ans).
unary_one2([], _, _, no).
unary_one2([S|Ss], K, Psi, R?) :- ground(S?), ground(Ss?), ground(K?), ground(Psi?) |
    unary_adds(S?, K?, Psi?, A),
    unary_one1(A?, Ss?, K?, Psi?, R).

procedure unary_one(Contract?, Preds?, Atom?, Integer?, Ans).
unary_one(C, K, Phi, I, R?) :- ground(C?), ground(K?), ground(Phi?), integer(I?) |
    rename_atom(Phi?, I?, Psi),
    unary_one2(C?, K?, Psi?, R).

% Every atom of Phis, required at role I, is iota, f or supplied so; an atom
% of a reflexive predicate naming the role is left out first.
procedure req_supplied(Contract?, Preds?, Atoms?, Integer?, Ans).
req_supplied(_, _, [], _, yes).
req_supplied(C, K, [A|As], I, R?) :-
    ground(C?), ground(K?), ground(A?), ground(As?), integer(I?) |
    is_mark_of(A?, K?, A0),
    unary_one(C?, K?, A?, I?, A1),
    or_yes(A0?, A1?, A01),
    req_supplied(C?, K?, As?, I?, A2),
    both_yes(A01?, A2?, R).

procedure role_req_supplied(Contract?, Preds?, Preds?, RoleSpec?, Integer?, Ans).
role_req_supplied(C, Rf, K, RS, I, R?) :-
    ground(C?), ground(Rf?), ground(K?), ground(RS?), integer(I?) |
    rs_req(RS?, Req),
    refl_keep(Req?, I?, Rf?, no, Req1),
    req_supplied(C?, K?, Req1?, I?, R).

% tau forbids nothing; nor does a relay act (def:relay).
procedure no_atoms(Atoms?, Ans).
no_atoms([], yes).
no_atoms([_|_], no).

% --- the act -------------------------------------------------------------
% An introductory act (def:introduction: arity two, guarded in both roles,
% with an introduction) that adds one atom at each role, of one predicate e
% of arity one, and meets the definition at both roles.  Nothing in it, nor
% in def:relay, asks of a schema of C anything of an atom of e beyond this
% (GSC 7e00aba).

procedure one_atom_e(Atoms?, Atoms?, Preds).
one_atom_e([atom(E, [_])], [atom(E2, [_])], [E?]) :- E? =?= E2? | true.
one_atom_e(_, _, []) :- otherwise | true.

procedure nonempty_substs(Substs?, Ans).
nonempty_substs([], no).
nonempty_substs([_|_], yes).

procedure intro_marks3(Ans?, Constant?, Constant?, IntroE).
intro_marks3(yes, Nm, E, intro(Nm?, E?)).
intro_marks3(no, _, _, no_intro).

procedure intro_marks2(Preds?, Ans?, Contract?, Preds?, Preds?, Preds?, Constant?, RoleSpec?,
                      RoleSpec?, IntroE).
intro_marks2([], _, _, _, _, _, _, _, _, no_intro).
intro_marks2([_|_], no, _, _, _, _, _, _, _, no_intro).
intro_marks2([E], yes, C, Rf, M, Kn, Nm, RS1, RS2, R?) :-
    ground(E?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Nm?), ground(RS1?),
    ground(RS2?) |
    role_req_supplied(C?, Rf?, Kn?, RS1?, 1, A1),
    role_req_supplied(C?, Rf?, Kn?, RS2?, 2, A2),
    rs_forb(RS1?, N1),
    rs_forb(RS2?, N2),
    no_atoms(N1?, A3),
    no_atoms(N2?, A4),
    both_yes(A1?, A2?, A12),
    both_yes(A3?, A4?, A34),
    both_yes(A12?, A34?, A),
    intro_marks3(A?, Nm?, E?, R).

% intro_act_bindings asks of the act two guarded agent roles and no name
% term (def:introduction; def:sg-wards, clause 1).
procedure intro_marks0(RoleSpecs?, Schema?, Contract?, Preds?, Preds?, Preds?, IntroE).
intro_marks0([RS1, RS2], Sc, C, Rf, M, Kn, R?) :-
    ground(RS1?), ground(RS2?), ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?) |
    sch_name(Sc?, Nm),
    is_guarding(RS1?, G1),
    is_guarding(RS2?, G2),
    both_yes(G1?, G2?, G),
    intro_act_bindings(Sc?, Bs),
    nonempty_substs(Bs?, B),
    both_yes(G?, B?, GB),
    rs_add(RS1?, P1),
    rs_add(RS2?, P2),
    one_atom_e(P1?, P2?, Es),
    intro_marks2(Es?, GB?, C?, Rf?, M?, Kn?, Nm?, RS1?, RS2?, R).
intro_marks0(Rs, _, _, _, _, _, no_intro) :- otherwise, ground(Rs?) | true.

procedure intro_marks(Contract?, Preds?, Preds?, Preds?, Schema?, IntroE).
intro_marks(C, Rf, M, Kn, Sc, R?) :-
    ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Sc?) |
    sch_roles(Sc?, Rs),
    intro_marks0(Rs?, Sc?, C?, Rf?, M?, Kn?, R).

% ---------------------------------------------------------------------------
% Relay act (def:relay)
% ---------------------------------------------------------------------------

% The guardianship of a mark among those chosen, one per mark.
procedure v_of(Guardianships?, Constant?, Constant).
v_of([], _, none).
v_of([guardianship(Mk, V, _)|_], M, V?) :- Mk? =?= M? | true.
v_of([_|Gs], M, R?) :- otherwise, ground(Gs?), ground(M?) | v_of(Gs?, M?, R).

procedure u_of(Guardianships?, Constant?, Constant).
u_of([], _, none).
u_of([guardianship(Mk, _, U)|_], M, U?) :- Mk? =?= M? | true.
u_of([_|Gs], M, R?) :- otherwise, ground(Gs?), ground(M?) | u_of(Gs?, M?, R).

% v_sigmas(Rs, S, I, V, Ss): the roles sigma, from S on, other than I, that
% require an atom of v naming I, v(I, Zs) (def:relay, clause 1, GSC 7e00aba),
% Rs being the roles of the schema from S on.
procedure v_sigmas1(Ans?, Integer?, Ints?, Ints).
v_sigmas1(yes, S, T, [S?|T?]).
v_sigmas1(no, _, T, T?).

procedure v_sigmas(RoleSpecs?, Integer?, Integer?, Constant?, Ints).
v_sigmas([], _, _, _, []).
v_sigmas([_|Rs], S, I, V, R?) :-
    S? =:= I?, ground(Rs?), ground(V?) |
    S1 := S? + 1,
    v_sigmas(Rs?, S1?, I?, V?, R).
v_sigmas([RS|Rs], S, I, V, R?) :-
    otherwise, ground(RS?), ground(Rs?), integer(S?), integer(I?), ground(V?) |
    rs_req(RS?, Req),
    has_first_arg(Req?, V?, role(I?), A),
    S1 := S? + 1,
    v_sigmas(Rs?, S1?, I?, V?, T),
    v_sigmas1(A?, S?, T?, R).

% ward_party(Rs, I, Mk, Gs, Ps): [ward(I, Mk, G)] when the role at I of the
% roles Rs is a ward role of Mk -- requiring Mk, with at most one other role
% sigma requiring an atom of v naming I, v that of Mk's guardianship, G its guardian role,
% guardian(sigma), or no_guardian where no role requires v(I) (def:relay,
% clause 1, GSC a885275: "with at most one other role sigma of chi, its
% guardian role"; GnW:3 and GnW:4) -- and [] otherwise.
procedure ward_party1(Ans?, Ints?, Integer?, Constant?, Parties).
ward_party1(yes, [S], I, Mk, [ward(I?, Mk?, guardian(S?))]).
ward_party1(yes, [], I, Mk, [ward(I?, Mk?, no_guardian)]).
ward_party1(yes, [_, _|_], _, _, []).
ward_party1(no, _, _, _, []).

procedure ward_party0(Atoms?, RoleSpecs?, Integer?, Constant?, Guardianships?, Parties).
ward_party0(Req, Rs, I, Mk, Gs, R?) :-
    ground(Req?), ground(Rs?), integer(I?), ground(Mk?), ground(Gs?) |
    atoms_member(Req?, atom(Mk?, []), A),
    v_of(Gs?, Mk?, V),
    v_sigmas(Rs?, 1, I?, V?, Ss),
    ward_party1(A?, Ss?, I?, Mk?, R).

procedure ward_party(RoleSpecs?, Integer?, Constant?, Guardianships?, Parties).
ward_party(Rs, I, Mk, Gs, R?) :- ground(Rs?), integer(I?), ground(Mk?), ground(Gs?) |
    nth_rs(Rs?, I?, RS),
    rs_req(RS?, Req),
    ward_party0(Req?, Rs?, I?, Mk?, Gs?, R).

% is_free_role(RS, K, R): the role requires f, K being [iota, f] (def:relay,
% clause 1, GSC 7e00aba).
procedure is_free_role(RoleSpec?, Preds?, Ans).
is_free_role(RS, [_, F], R?) :- ground(RS?), ground(F?) |
    rs_req(RS?, Req),
    atoms_member(Req?, atom(F?, []), R).
is_free_role(_, K, no) :- otherwise, ground(K?) | true.

% --- the kinds of the roles, given the two parties -----------------------

procedure party_role(Party?, Integer).
party_role(ward(I, _, _), I?).
party_role(free(I), I?).

procedure party_rk(Party?, RK).
party_rk(ward(_, Mk, S), rk_ward(Mk?, S?)).
party_rk(free(_), rk_free).

% The guardian roles of a party: one for a ward role with a guardian role, none otherwise.
procedure party_sigma(Party?, Ints).
party_sigma(ward(_, _, guardian(S)), [S?]).
party_sigma(ward(_, _, no_guardian), []).
party_sigma(free(_), []).

procedure rk_of(Integer?, Party?, Party?, Ints?, RK).
rk_of(X, P1, P2, Sigmas, R?) :- integer(X?), ground(P1?), ground(P2?), ground(Sigmas?) |
    party_role(P1?, I),
    party_role(P2?, J),
    rk_of1(X?, I?, J?, P1?, P2?, Sigmas?, R).

procedure rk_of1(Integer?, Integer?, Integer?, Party?, Party?, Ints?, RK).
rk_of1(X, I, _, P1, _, _, R?) :- X? =:= I?, ground(P1?) | party_rk(P1?, R).
rk_of1(X, _, J, _, P2, _, R?) :- X? =:= J?, ground(P2?) | party_rk(P2?, R).
rk_of1(X, _, _, _, _, Sigmas, R?) :- otherwise, integer(X?), ground(Sigmas?) |
    ints_member(Sigmas?, X?, A),
    rk_of2(A?, R).

procedure rk_of2(Ans?, RK).
rk_of2(yes, rk_guard).
rk_of2(no, rk_other).

procedure role_kinds(Integer?, Integer?, Party?, Party?, Ints?, RKs).
role_kinds(X, K, _, _, _, []) :- X? > K? | true.
role_kinds(X, K, P1, P2, Sigmas, [RK?|R?]) :-
    X? =< K?, integer(X?), integer(K?), ground(P1?), ground(P2?), ground(Sigmas?) |
    rk_of(X?, P1?, P2?, Sigmas?, RK),
    X1 := X? + 1,
    role_kinds(X1?, K?, P1?, P2?, Sigmas?, R).

procedure nth_rk(RKs?, Integer?, RK).
nth_rk([], _, rk_other).
nth_rk([X|_], I, X?) :- I? =:= 1 | true.
nth_rk([_|Xs], I, R?) :- I? > 1, integer(I?), ground(Xs?) |
    I1 := I? - 1,
    nth_rk(Xs?, I1?, R).

procedure rk_is_guard(RK?, Ans).
rk_is_guard(rk_guard, yes).
rk_is_guard(rk_ward(_, _), no).
rk_is_guard(rk_free, no).
rk_is_guard(rk_other, no).

procedure rk_is_free(RK?, Ans).
rk_is_free(rk_free, yes).
rk_is_free(rk_guard, no).
rk_is_free(rk_ward(_, _), no).
rk_is_free(rk_other, no).

procedure rk_is_other(RK?, Ans).
rk_is_other(rk_other, yes).
rk_is_other(rk_free, no).
rk_is_other(rk_guard, no).
rk_is_other(rk_ward(_, _), no).

% Clause 1: every role is a party or a guardian role.
procedure no_other(RKs?, Ans).
no_other([], yes).
no_other([K|Ks], R?) :- ground(K?), ground(Ks?) |
    rk_is_other(K?, A),
    flip(A?, A1),
    no_other(Ks?, A2),
    both_yes(A1?, A2?, R).

% Clause 1: the schema adds and deletes at a guardian role no atom naming
% another guardian role.  Phis are the atoms the role adds and those it marks
% - with no wildcard; Cl its cleared atoms, each of which deletes every atom
% it matches (GSC a885275, Section 8, before def:guardianship), so it deletes an atom naming role Y where it
% names Y, or carries the wildcard as an argument, which role Y may replace.
procedure any_arg_atoms1(Ans?, Atoms?, Ans).
any_arg_atoms1(yes, _, yes).
any_arg_atoms1(no, Xs, R?) :- ground(Xs?) | any_arg_atoms(Xs?, R).

procedure any_arg_atoms(Atoms?, Ans).
any_arg_atoms([], no).
any_arg_atoms([atom(_, As)|Xs], R?) :- ground(As?), ground(Xs?) |
    args_member(As?, any, A),
    any_arg_atoms1(A?, Xs?, R).

procedure clear_names(Atoms?, Integer?, Ans).
clear_names(Cl, Y, R?) :- ground(Cl?), integer(Y?) |
    names_role(Cl?, Y?, A1),
    any_arg_atoms(Cl?, A2),
    or_yes(A1?, A2?, R).

procedure guards_name_none(Atoms?, Atoms?, Integer?, RKs?, Integer?, Integer?, Ans).
guards_name_none(_, _, _, _, Y, K, yes) :- Y? > K? | true.
guards_name_none(Phis, Cl, X, RKs, Y, K, R?) :-
    Y? =< K?, Y? =:= X?, ground(Phis?), ground(Cl?), ground(RKs?) |
    Y1 := Y? + 1,
    guards_name_none(Phis?, Cl?, X?, RKs?, Y1?, K?, R).
guards_name_none(Phis, Cl, X, RKs, Y, K, R?) :-
    otherwise, Y? =< K?, integer(X?), ground(Phis?), ground(Cl?), ground(RKs?), integer(K?) |
    nth_rk(RKs?, Y?, KY),
    rk_is_guard(KY?, G),
    names_role(Phis?, Y?, N1),
    clear_names(Cl?, Y?, N2),
    or_yes(N1?, N2?, N),
    both_yes(G?, N?, Bad),
    flip(Bad?, A1),
    Y1 := Y? + 1,
    guards_name_none(Phis?, Cl?, X?, RKs?, Y1?, K?, A2),
    both_yes(A1?, A2?, R).

procedure guard_adds_ok(RK?, RoleSpec?, Integer?, RKs?, Integer?, Ans).
guard_adds_ok(rk_guard, RS, X, RKs, K, R?) :-
    ground(RS?), integer(X?), ground(RKs?), integer(K?) |
    rs_add(RS?, P),
    rs_del(RS?, M),
    rs_clear(RS?, Cl),
    atoms_app(P?, M?, PM),
    guards_name_none(PM?, Cl?, X?, RKs?, 1, K?, R).
guard_adds_ok(rk_ward(_, _), _, _, _, _, yes).
guard_adds_ok(rk_free, _, _, _, _, yes).
guard_adds_ok(rk_other, _, _, _, _, yes).

% Clause 2 (GSC 7e00aba): an atom required at a role.  It is iota; or f, at a free role or a guardian role (kind_atom_ok); or an atom of a reflexive predicate naming the role; or, at a free role or a guardian role, the one atom of a schema of arity one as in def:unobstructed-marks (unary_at); or, at a ward role of m, its m, or one atom of the u of its guardianship, naming its guardian role or, where it has none, an agent variable of the schema that occurs in no other atom of the schema, the value arguments of the atom variables of the schema that occur in no other atom it requires but the guardian role's atom of v; or, at a ward role rho of m, an atom of a predicate h whose arguments are distinct speech-act variables of the schema occurring in no other atom it requires but its record, with the conditions on h and its record h' below (records_of); or, at the guardian role sigma of a ward role rho, its atom of v naming rho, or the record, the atom of h' whose arguments are rho and the arguments of the h-atom rho requires; or, at a guardian role or a free role, e(kappa) for another guardian role or free role kappa, e reflexive where both are guardian roles; or, where the schema has two ward roles, at the guardian role of one, e of the other ward role and its record (GnW:4); and the schema adds at a free role the record of each ward role (free_recs_ok below).

procedure req_ward_ok(RK?, Atom?, Integer?, RoleSpecs?, Guardianships?, Ans).
req_ward_ok(rk_ward(Mk, S), Phi, X, Sr, Gs, R?) :-
    ground(Mk?), ground(S?), ground(Phi?), integer(X?), ground(Sr?), ground(Gs?) |
    u_of(Gs?, Mk?, U),
    v_of(Gs?, Mk?, V),
    same_atom(Phi?, atom(Mk?, []), A1),
    req_u_ok(Phi?, S?, U?, V?, X?, Sr?, A2),
    or_yes(A1?, A2?, R).
req_ward_ok(rk_free, _, _, _, _, no).
req_ward_ok(rk_guard, _, _, _, _, no).
req_ward_ok(rk_other, _, _, _, _, no).

% The atom of u at a ward role X whose guardian role is S, or that has none:
% u(A, Zs), A the guardian role, or an agent variable of the schema that
% occurs in no other atom of it; Zs the value arguments, each a value
% variable occurring in no other atom the schema requires but the guardian
% role's atom of v, or a value.
procedure req_u_ok(Atom?, Guardian?, Constant?, Constant?, Integer?, RoleSpecs?, Ans).
req_u_ok(atom(Q, [A|Zs]), S, U, V, X, Sr, R?) :-
    Q? =?= U?, ground(A?), ground(Zs?), ground(S?), ground(V?), integer(X?), ground(Sr?) |
    u_first_ok(A?, S?, Sr?, A1),
    u_values_ok(Zs?, S?, V?, Sr?, A2),
    both_yes(A1?, A2?, R).
req_u_ok(_, _, _, _, _, _, no) :- otherwise | true.

procedure u_first_ok(Arg?, Guardian?, RoleSpecs?, Ans).
u_first_ok(role(T), guardian(S), _, R?) :- integer(T?), integer(S?) | eq_ints(T?, S?, R).
u_first_ok(pvar(Y), no_guardian, Sr, R?) :- ground(Y?), ground(Sr?) |
    roles_all_atoms(Sr?, [], As),
    atoms_with_arg(As?, pvar(Y?), N),
    eq_ints(N?, 1, R).
u_first_ok(_, _, _, no) :- otherwise | true.

% atoms_with_arg(Phis, A, N): N atoms of Phis have A among their arguments.
procedure atoms_with_arg(Atoms?, Arg?, Integer).
atoms_with_arg([], _, 0).
atoms_with_arg([atom(_, As)|Xs], A, N?) :- ground(As?), ground(Xs?), ground(A?) |
    args_member(As?, A?, B),
    atoms_with_arg(Xs?, A?, M),
    add_if(B?, M?, N).

procedure u_values_ok(Args?, Guardian?, Constant?, RoleSpecs?, Ans).
u_values_ok([], _, _, _, yes).
u_values_ok([num(Z)|Zs], S, V, Sr, R?) :- ground(Z?), ground(Zs?), ground(S?), ground(V?), ground(Sr?) |
    req_less_guard_v(Sr?, 1, S?, V?, Req),
    atoms_with_arg(Req?, num(Z?), N),
    eq_ints(N?, 1, A1),
    u_values_ok(Zs?, S?, V?, Sr?, A2),
    both_yes(A1?, A2?, R).
u_values_ok([real(Z)|Zs], S, V, Sr, R?) :- ground(Z?), ground(Zs?), ground(S?), ground(V?), ground(Sr?) |
    req_less_guard_v(Sr?, 1, S?, V?, Req),
    atoms_with_arg(Req?, real(Z?), N),
    eq_ints(N?, 1, A1),
    u_values_ok(Zs?, S?, V?, Sr?, A2),
    both_yes(A1?, A2?, R).
u_values_ok([_|Zs], S, V, Sr, R?) :- otherwise, ground(Zs?), ground(S?), ground(V?), ground(Sr?) |
    u_values_ok(Zs?, S?, V?, Sr?, R).

% The atoms the schema requires at its roles, the guardian role's atoms of
% v left out.
procedure req_less_guard_v(RoleSpecs?, Integer?, Guardian?, Constant?, Atoms).
req_less_guard_v([], _, _, _, []).
req_less_guard_v([RS|Rs], I, guardian(S), V, R?) :-
    I? =:= S?, ground(RS?), ground(Rs?), ground(V?) |
    rs_req(RS?, Q),
    drop_pred(Q?, V?, Q1),
    I1 := I? + 1,
    req_less_guard_v(Rs?, I1?, guardian(S?), V?, R2),
    atoms_app(Q1?, R2?, R).
req_less_guard_v([RS|Rs], I, S, V, R?) :-
    otherwise, ground(RS?), ground(Rs?), integer(I?), ground(S?), ground(V?) |
    rs_req(RS?, Q),
    I1 := I? + 1,
    req_less_guard_v(Rs?, I1?, S?, V?, R2),
    atoms_app(Q?, R2?, R).

procedure drop_pred(Atoms?, Constant?, Atoms).
drop_pred([], _, []).
drop_pred([atom(Q, _)|Xs], P, R?) :- Q? =?= P?, ground(Xs?) | drop_pred(Xs?, P?, R).
drop_pred([X|Xs], P, [X?|R?]) :- otherwise, ground(Xs?), ground(P?) | drop_pred(Xs?, P?, R).

% One atom of u at a ward role (def:relay, clause 2: "one atom of the u of
% its guardianship"): the atoms of u the role requires are at most one.
procedure ward_one_u(RK?, Atoms?, Guardianships?, Ans).
ward_one_u(rk_ward(Mk, _), Req, Gs, R?) :- ground(Mk?), ground(Req?), ground(Gs?) |
    u_of(Gs?, Mk?, U),
    count_pred(Req?, U?, N),
    le_one(N?, R).
ward_one_u(rk_free, _, _, yes).
ward_one_u(rk_guard, _, _, yes).
ward_one_u(rk_other, _, _, yes).

% The atom of v naming rho at X for a ward party rho whose guardian role is X.
procedure req_w_ok(Atom?, Integer?, Party?, Guardianships?, Ans).
req_w_ok(atom(Q, [role(J)|_]), X, ward(Rho, Mk, guardian(S)), Gs, R?) :-
    S? =:= X?, J? =:= Rho?, ground(Q?), ground(Mk?), ground(Gs?) |
    v_of(Gs?, Mk?, V),
    pred_member(Q?, [V?], R).
req_w_ok(_, _, _, _, no) :- otherwise | true.

procedure req_guard_ok(RK?, Atom?, Integer?, Party?, Party?, Guardianships?, Ans).
req_guard_ok(rk_guard, Phi, X, P1, P2, Gs, R?) :-
    ground(Phi?), integer(X?), ground(P1?), ground(P2?), ground(Gs?) |
    req_w_ok(Phi?, X?, P1?, Gs?, A1),
    req_w_ok(Phi?, X?, P2?, Gs?, A2),
    or_yes(A1?, A2?, R).
req_guard_ok(rk_ward(_, _), _, _, _, _, _, no).
req_guard_ok(rk_free, _, _, _, _, _, no).
req_guard_ok(rk_other, _, _, _, _, _, no).

% e(kappa) at a guardian or free role X, kappa another guardian or free role.
procedure req_e_ok2(Ans?, Ans?, Ans?, Ans?, Constant?, Preds?, Ans).
req_e_ok2(no, _, _, _, _, _, no).
req_e_ok2(yes, no, _, _, _, _, no).
req_e_ok2(yes, yes, GX, GK, E, Rf, R?) :- ground(GX?), ground(GK?), ground(E?), ground(Rf?) |
    both_yes(GX?, GK?, Both),
    pred_member(E?, Rf?, Refl),
    flip(Both?, NotBoth),
    or_yes(NotBoth?, Refl?, R).

procedure req_e_ok1(Args?, Integer?, RK?, Constant?, Preds?, RKs?, Ans).
req_e_ok1([role(Kp)], X, KX, E, Rf, RKs, R?) :-
    integer(Kp?), integer(X?), Kp? > X?, ground(KX?), ground(E?), ground(Rf?), ground(RKs?) |
    req_e_ok0(Kp?, KX?, E?, Rf?, RKs?, R).
req_e_ok1([role(Kp)], X, KX, E, Rf, RKs, R?) :-
    integer(Kp?), integer(X?), Kp? < X?, ground(KX?), ground(E?), ground(Rf?), ground(RKs?) |
    req_e_ok0(Kp?, KX?, E?, Rf?, RKs?, R).
req_e_ok1(_, _, _, _, _, _, no) :- otherwise | true.

procedure req_e_ok0(Integer?, RK?, Constant?, Preds?, RKs?, Ans).
req_e_ok0(Kp, KX, E, Rf, RKs, R?) :-
    integer(Kp?), ground(KX?), ground(E?), ground(Rf?), ground(RKs?) |
    nth_rk(RKs?, Kp?, KK),
    req_e_kinds(KK?, KX?, E?, Rf?, R).

procedure req_e_kinds(RK?, RK?, Constant?, Preds?, Ans).
req_e_kinds(KK, KX, E, Rf, R?) :- ground(KK?), ground(KX?), ground(E?), ground(Rf?) |
    rk_is_guard(KX?, GX),
    rk_is_free(KX?, FX),
    or_yes(GX?, FX?, OkX),
    rk_is_guard(KK?, GK),
    rk_is_free(KK?, FK),
    or_yes(GK?, FK?, OkK),
    req_e_ok2(OkX?, OkK?, GX?, GK?, E?, Rf?, R).

procedure req_e_ok(Atom?, Integer?, RK?, Constant?, Preds?, RKs?, Ans).
req_e_ok(atom(Q, As), X, KX, E, Rf, RKs, R?) :-
    Q? =?= E?, ground(As?), integer(X?), ground(KX?), ground(Rf?), ground(RKs?) |
    req_e_ok1(As?, X?, KX?, E?, Rf?, RKs?, R).
req_e_ok(atom(_, _), _, _, _, _, _, no) :- otherwise | true.

% e of the other ward role, at the guardian role of one, where the schema has two ward roles (def:relay, clause 2, GSC a885275; GnW:4, Alice knows Dave).
procedure e_other_ward(Integer?, Integer?, Guardian?, Integer?, Ans).
e_other_ward(X, K, guardian(S), Rho, yes) :- X? =:= S?, K? =:= Rho? | true.
e_other_ward(_, _, _, _, no) :- otherwise | true.

procedure req_e_ward_ok(Atom?, Integer?, Constant?, Party?, Party?, Ans).
req_e_ward_ok(atom(Q, [role(K)]), X, E, ward(R1, _, S1), ward(R2, _, S2), R?) :-
    Q? =?= E?, integer(K?), integer(X?), integer(R1?), ground(S1?), integer(R2?),
    ground(S2?) |
    e_other_ward(X?, K?, S1?, R2?, A1),
    e_other_ward(X?, K?, S2?, R1?, A2),
    or_yes(A1?, A2?, R).
req_e_ward_ok(_, _, _, _, _, no) :- otherwise | true.

% The atom of h, at a ward role of Mk: the tests on its arguments and on the atoms of h a contract deletes; req_h_ok below.
procedure all_svars(Args?, Ans).
all_svars([], yes).
all_svars([svar(_)|As], R?) :- ground(As?) | all_svars(As?, R).
all_svars([_|_], no) :- otherwise | true.

procedure add_if(Ans?, Integer?, Integer).
add_if(yes, M, N?) :- integer(M?) | N := M? + 1.
add_if(no, M, M?).

% atoms_with_svar(Phis, Y, N): N atoms of Phis have the speech-act variable Y among their arguments, in a signed term or a name term too.
procedure atoms_with_svar(Atoms?, Arg?, Integer).
atoms_with_svar([], _, 0).
atoms_with_svar([atom(_, As)|Xs], Y, N?) :- ground(As?), ground(Xs?), ground(Y?) |
    filter_svars(As?, SV),
    args_member(SV?, Y?, A),
    atoms_with_svar(Xs?, Y?, M),
    add_if(A?, M?, N).

procedure svars_once(Args?, Atoms?, Ans).
svars_once([], _, yes).
svars_once([svar(Y)|As], Req, R?) :- ground(Y?), ground(As?), ground(Req?) |
    atoms_with_svar(Req?, svar(Y?), N),
    eq_ints(N?, 1, A1),
    svars_once(As?, Req?, A2),
    both_yes(A1?, A2?, R).
svars_once([_|_], _, no) :- otherwise | true.

% has_pred_atom(Phis, H, N, R): Phis holds an atom of H with N arguments.
procedure has_pred_atom1(Ans?, Atoms?, Constant?, Integer?, Ans).
has_pred_atom1(yes, _, _, _, yes).
has_pred_atom1(no, Xs, H, N, R?) :- ground(Xs?), ground(H?), integer(N?) |
    has_pred_atom(Xs?, H?, N?, R).

procedure has_pred_atom(Atoms?, Constant?, Integer?, Ans).
has_pred_atom([], _, _, no).
has_pred_atom([atom(Q, As)|Xs], H, N, R?) :-
    Q? =?= H?, ground(As?), ground(Xs?), integer(N?) |
    args_len(As?, L),
    eq_ints(L?, N?, A),
    has_pred_atom1(A?, Xs?, H?, N?, R).
has_pred_atom([atom(_, _)|Xs], H, N, R?) :- otherwise, ground(Xs?), ground(H?), integer(N?) |
    has_pred_atom(Xs?, H?, N?, R).

% No schema of C deletes an atom of H: none marks one - and no cleared atom
% of H, with N arguments, matches one (GSC a885275).
procedure roles_h_kept(RoleSpecs?, Constant?, Integer?, Ans).
roles_h_kept([], _, _, yes).
roles_h_kept([RS|Rs], H, N, R?) :- ground(RS?), ground(Rs?), ground(H?), integer(N?) |
    rs_deletes(RS?, M),
    has_pred_atom(M?, H?, N?, A),
    flip(A?, A1),
    roles_h_kept(Rs?, H?, N?, A2),
    both_yes(A1?, A2?, R).

procedure h_kept(Contract?, Constant?, Integer?, Ans).
h_kept([], _, _, yes).
h_kept([S|Ss], H, N, R?) :- ground(S?), ground(Ss?), ground(H?), integer(N?) |
    sch_roles(S?, Rs),
    roles_h_kept(Rs?, H?, N?, A1),
    h_kept(Ss?, H?, N?, A2),
    both_yes(A1?, A2?, R).

% distinct_args(As, R): no argument occurs twice among As.
procedure distinct_args(Args?, Ans).
distinct_args([], yes).
distinct_args([A|As], R?) :- ground(A?), ground(As?) |
    args_member(As?, A?, M),
    flip(M?, A1),
    distinct_args(As?, A2),
    both_yes(A1?, A2?, R).

% svar_sgn_args(As, R): every argument is a speech-act variable or a signed term.
procedure svar_sgn_args(Args?, Ans).
svar_sgn_args([], yes).
svar_sgn_args([svar(_)|As], R?) :- ground(As?) | svar_sgn_args(As?, R).
svar_sgn_args([sgn(_, _)|As], R?) :- ground(As?) | svar_sgn_args(As?, R).
svar_sgn_args([_|_], no) :- otherwise | true.

% The record (def:relay, clause 2, GSC eede0fa).  Every schema of C that adds m at a role rho adds there an atom of h whose arguments are speech-act variables or signed terms, and adds its record, an atom of a predicate h' whose arguments are rho and the arguments of that h-atom, at the role at which it adds an atom of v naming rho (GSC 070c5d1; w(rho) until then); every other schema of C that adds an atom of v naming rho at a role requires a record h'(rho, ...) at a role at which it requires an atom of v naming rho, and adds that record where it adds the atom of v; and no schema of C deletes an atom of h or of h'.  "Other" is read of rho: a schema adding an atom of v naming rho and not m at rho.

% h_at_role(Phis, H, N, R): Phis holds an atom of H with N arguments, each a speech-act variable or a signed term.
procedure h_at_role1(Ans?, Atoms?, Constant?, Integer?, Ans).
h_at_role1(yes, _, _, _, yes).
h_at_role1(no, Xs, H, N, R?) :- ground(Xs?), ground(H?), integer(N?) | h_at_role(Xs?, H?, N?, R).

procedure h_at_role(Atoms?, Constant?, Integer?, Ans).
h_at_role([], _, _, no).
h_at_role([atom(Q, As)|Xs], H, N, R?) :-
    ground(H?), Q? =?= H?, ground(As?), ground(Xs?), integer(N?) |
    args_len(As?, L),
    eq_ints(L?, N?, A1),
    svar_sgn_args(As?, A2),
    both_yes(A1?, A2?, A),
    h_at_role1(A?, Xs?, H?, N?, R).
h_at_role([atom(_, _)|Xs], H, N, R?) :- otherwise, ground(Xs?), ground(H?), integer(N?) |
    h_at_role(Xs?, H?, N?, R).

% h_added_all(C, Mk, H, N, R): every schema of C that adds Mk at a role adds there an atom of H with N arguments, each a speech-act variable or a signed term.
procedure mk_role_h(Ans?, Atoms?, Constant?, Integer?, Ans).
mk_role_h(no, _, _, _, yes).
mk_role_h(yes, P, H, N, R?) :- ground(P?), ground(H?), integer(N?) | h_at_role(P?, H?, N?, R).

procedure roles_h_added(RoleSpecs?, Constant?, Constant?, Integer?, Ans).
roles_h_added([], _, _, _, yes).
roles_h_added([RS|Rs], Mk, H, N, R?) :-
    ground(RS?), ground(Rs?), ground(Mk?), ground(H?), integer(N?) |
    rs_add(RS?, P),
    role_h_added(P?, Mk?, H?, N?, A1),
    roles_h_added(Rs?, Mk?, H?, N?, A2),
    both_yes(A1?, A2?, R).

procedure role_h_added(Atoms?, Constant?, Constant?, Integer?, Ans).
role_h_added(P, Mk, H, N, R?) :- ground(P?), ground(Mk?), ground(H?), integer(N?) |
    atoms_member(P?, atom(Mk?, []), A),
    mk_role_h(A?, P?, H?, N?, R).

procedure h_added_all(Contract?, Constant?, Constant?, Integer?, Ans).
h_added_all([], _, _, _, yes).
h_added_all([S|Ss], Mk, H, N, R?) :-
    ground(S?), ground(Ss?), ground(Mk?), ground(H?), integer(N?) |
    sch_roles(S?, Rs),
    roles_h_added(Rs?, Mk?, H?, N?, A1),
    h_added_all(Ss?, Mk?, H?, N?, A2),
    both_yes(A1?, A2?, R).

% The schemas adding Mk: every role I at which a schema adds Mk adds there an atom H(As), As of N arguments each a speech-act variable or a signed term, whose record Hp(role(I), As) the schema adds at every role at which it adds W(role(I)), the role at which it adds w(rho), which clause 4 of def:guardianship gives.
procedure rec_if(Ans?, Atoms?, Integer?, Args?, Constant?, Ans).
rec_if(no, _, _, _, _, yes).
rec_if(yes, P, I, As, Hp, R?) :- ground(P?), integer(I?), ground(As?), ground(Hp?) |
    atoms_member(P?, atom(Hp?, [role(I?)|As?]), R).

% rec_at_ws(Rs, I, As, W, Hp, R): every role among Rs that adds an atom of W naming role(I) adds Hp(role(I), As); W is the v of the guardianship, the record being added where the atom of v naming rho is (def:relay, clause 2, GSC 070c5d1, for w(rho) until then).
procedure rec_at_ws(RoleSpecs?, Integer?, Args?, Constant?, Constant?, Ans).
rec_at_ws([], _, _, _, _, yes).
rec_at_ws([RS|Rs], I, As, W, Hp, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(As?), ground(W?), ground(Hp?) |
    rs_add(RS?, P),
    rec_at_w(P?, I?, As?, W?, Hp?, A1),
    rec_at_ws(Rs?, I?, As?, W?, Hp?, A2),
    both_yes(A1?, A2?, R).

procedure rec_at_w(Atoms?, Integer?, Args?, Constant?, Constant?, Ans).
rec_at_w(P, I, As, W, Hp, R?) :- ground(P?), integer(I?), ground(As?), ground(W?), ground(Hp?) |
    has_first_arg(P?, W?, role(I?), A),
    rec_if(A?, P?, I?, As?, Hp?, R).

% h_rec_at(Xs, I, Sr, H, N, W, Hp, R): some atom H(As) among Xs, the atoms role I adds, As of N arguments each a speech-act variable or a signed term, whose record rec_at_ws finds where the schema, of roles Sr, adds W(role(I)).
procedure h_rec_at1(Ans?, Atoms?, Integer?, RoleSpecs?, Constant?, Integer?, Constant?, Constant?,
                    Ans).
h_rec_at1(yes, _, _, _, _, _, _, _, yes).
h_rec_at1(no, Xs, I, Sr, H, N, W, Hp, R?) :-
    ground(Xs?), integer(I?), ground(Sr?), ground(H?), integer(N?), ground(W?), ground(Hp?) |
    h_rec_at(Xs?, I?, Sr?, H?, N?, W?, Hp?, R).

procedure h_rec_at(Atoms?, Integer?, RoleSpecs?, Constant?, Integer?, Constant?, Constant?, Ans).
h_rec_at([], _, _, _, _, _, _, no).
h_rec_at([atom(Q, As)|Xs], I, Sr, H, N, W, Hp, R?) :-
    ground(H?), Q? =?= H?, ground(As?), ground(Xs?), integer(I?), ground(Sr?), integer(N?),
    ground(W?), ground(Hp?) |
    args_len(As?, L),
    eq_ints(L?, N?, A1),
    svar_sgn_args(As?, A2),
    rec_at_ws(Sr?, I?, As?, W?, Hp?, A3),
    both_yes(A1?, A2?, A12),
    both_yes(A12?, A3?, A),
    h_rec_at1(A?, Xs?, I?, Sr?, H?, N?, W?, Hp?, R).
h_rec_at([atom(_, _)|Xs], I, Sr, H, N, W, Hp, R?) :-
    otherwise, ground(Xs?), integer(I?), ground(Sr?), ground(H?), integer(N?), ground(W?),
    ground(Hp?) |
    h_rec_at(Xs?, I?, Sr?, H?, N?, W?, Hp?, R).

procedure mk_role_rec(Ans?, Atoms?, Integer?, RoleSpecs?, Constant?, Integer?, Constant?, Constant?,
                      Ans).
mk_role_rec(no, _, _, _, _, _, _, _, yes).
mk_role_rec(yes, P, I, Sr, H, N, W, Hp, R?) :-
    ground(P?), integer(I?), ground(Sr?), ground(H?), integer(N?), ground(W?), ground(Hp?) |
    h_rec_at(P?, I?, Sr?, H?, N?, W?, Hp?, R).

procedure mk_role_rec0(Atoms?, Integer?, RoleSpecs?, Constant?, Constant?, Integer?, Constant?,
                       Constant?, Ans).
mk_role_rec0(P, I, Sr, Mk, H, N, W, Hp, R?) :-
    ground(P?), integer(I?), ground(Sr?), ground(Mk?), ground(H?), integer(N?), ground(W?),
    ground(Hp?) |
    atoms_member(P?, atom(Mk?, []), A),
    mk_role_rec(A?, P?, I?, Sr?, H?, N?, W?, Hp?, R).

procedure mk_roles_rec(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Constant?, Integer?, Constant?,
                       Constant?, Ans).
mk_roles_rec([], _, _, _, _, _, _, _, yes).
mk_roles_rec([RS|Rs], I, Sr, Mk, H, N, W, Hp, R?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Sr?), ground(Mk?), ground(H?), integer(N?),
    ground(W?), ground(Hp?) |
    rs_add(RS?, P),
    mk_role_rec0(P?, I?, Sr?, Mk?, H?, N?, W?, Hp?, A1),
    I1 := I? + 1,
    mk_roles_rec(Rs?, I1?, Sr?, Mk?, H?, N?, W?, Hp?, A2),
    both_yes(A1?, A2?, R).

% The other schemas adding v: an atom V(A, ...) a role adds, where the schema does not add Mk at A, comes with a record Hp(A, As) the role adds, As of N arguments, that the schema requires at a role at which it requires an atom of V naming A.
% rec_req_w(Rs, A, As, Hp, V, R): some role among Rs requires an atom of V naming A and the record Hp(A, As).
procedure rec_req_w1(Ans?, RoleSpecs?, Arg?, Args?, Constant?, Constant?, Ans).
rec_req_w1(yes, _, _, _, _, _, yes).
rec_req_w1(no, Rs, A, As, Hp, W, R?) :-
    ground(Rs?), ground(A?), ground(As?), ground(Hp?), ground(W?) |
    rec_req_w(Rs?, A?, As?, Hp?, W?, R).

procedure rec_req_w(RoleSpecs?, Arg?, Args?, Constant?, Constant?, Ans).
rec_req_w([], _, _, _, _, no).
rec_req_w([RS|Rs], A, As, Hp, W, R?) :-
    ground(RS?), ground(Rs?), ground(A?), ground(As?), ground(Hp?), ground(W?) |
    rs_req(RS?, Q),
    rec_req_at(Q?, A?, As?, Hp?, W?, A12),
    rec_req_w1(A12?, Rs?, A?, As?, Hp?, W?, R).

procedure rec_req_at(Atoms?, Arg?, Args?, Constant?, Constant?, Ans).
rec_req_at(Q, A, As, Hp, V, R?) :- ground(Q?), ground(A?), ground(As?), ground(Hp?), ground(V?) |
    has_first_arg(Q?, V?, A?, A1),
    atoms_member(Q?, atom(Hp?, [A?|As?]), A2),
    both_yes(A1?, A2?, R).

% rec_some(Xs, A, Sr, N, Hp, V, R): some atom Hp(A, As) among Xs, the atoms a role adds, As of N arguments, which the schema, of roles Sr, requires at a role requiring an atom of V naming A.
procedure rec_some1(Ans?, Atoms?, Arg?, RoleSpecs?, Integer?, Constant?, Constant?, Ans).
rec_some1(yes, _, _, _, _, _, _, yes).
rec_some1(no, Xs, A, Sr, N, Hp, W, R?) :-
    ground(Xs?), ground(A?), ground(Sr?), integer(N?), ground(Hp?), ground(W?) |
    rec_some(Xs?, A?, Sr?, N?, Hp?, W?, R).

procedure rec_some(Atoms?, Arg?, RoleSpecs?, Integer?, Constant?, Constant?, Ans).
rec_some([], _, _, _, _, _, no).
rec_some([atom(Q, [B|As])|Xs], A, Sr, N, Hp, W, R?) :-
    ground(Hp?), Q? =?= Hp?, ground(A?), ground(B?), B? =?= A?, ground(As?), ground(Xs?),
    ground(Sr?), integer(N?), ground(W?) |
    args_len(As?, L),
    eq_ints(L?, N?, A1),
    rec_req_w(Sr?, A?, As?, Hp?, W?, A2),
    both_yes(A1?, A2?, A12),
    rec_some1(A12?, Xs?, A?, Sr?, N?, Hp?, W?, R).
rec_some([_|Xs], A, Sr, N, Hp, W, R?) :-
    otherwise, ground(Xs?), ground(A?), ground(Sr?), integer(N?), ground(Hp?), ground(W?) |
    rec_some(Xs?, A?, Sr?, N?, Hp?, W?, R).

% adds_mk_at(A, Sr, Mk, R): A is a role of the schema, of roles Sr, at which it adds Mk.
procedure adds_mk_at(Arg?, RoleSpecs?, Constant?, Ans).
adds_mk_at(role(I), Sr, Mk, R?) :- integer(I?), ground(Sr?), ground(Mk?) |
    nth_rs(Sr?, I?, RS),
    rs_add(RS?, P),
    atoms_member(P?, atom(Mk?, []), R).
adds_mk_at(_, _, _, no) :- otherwise | true.

procedure v_rec(Ans?, Atoms?, Arg?, RoleSpecs?, Integer?, Constant?, Constant?, Ans).
v_rec(yes, _, _, _, _, _, _, yes).
v_rec(no, P, A, Sr, N, Hp, W, R?) :-
    ground(P?), ground(A?), ground(Sr?), integer(N?), ground(Hp?), ground(W?) |
    rec_some(P?, A?, Sr?, N?, Hp?, W?, R).

% vs_recorded(Xs, P, Sr, Mk, V, W, N, Hp, R): for every atom V(A, ...) among Xs, of the atoms P a role adds, the schema adds Mk at A, or the role adds a record rec_some finds.
procedure vs_recorded(Atoms?, Atoms?, RoleSpecs?, Constant?, Constant?, Constant?, Integer?,
                      Constant?, Ans).
vs_recorded([], _, _, _, _, _, _, _, yes).
vs_recorded([atom(Q, [A|_])|Xs], P, Sr, Mk, V, W, N, Hp, R?) :-
    ground(V?), Q? =?= V?, ground(A?), ground(Xs?), ground(P?), ground(Sr?), ground(Mk?),
    ground(W?), integer(N?), ground(Hp?) |
    adds_mk_at(A?, Sr?, Mk?, M),
    v_rec(M?, P?, A?, Sr?, N?, Hp?, V?, A1),
    vs_recorded(Xs?, P?, Sr?, Mk?, V?, W?, N?, Hp?, A2),
    both_yes(A1?, A2?, R).
vs_recorded([_|Xs], P, Sr, Mk, V, W, N, Hp, R?) :-
    otherwise, ground(Xs?), ground(P?), ground(Sr?), ground(Mk?), ground(V?), ground(W?),
    integer(N?), ground(Hp?) |
    vs_recorded(Xs?, P?, Sr?, Mk?, V?, W?, N?, Hp?, R).

procedure roles_recorded(RoleSpecs?, RoleSpecs?, Constant?, Constant?, Constant?, Integer?,
                         Constant?, Ans).
roles_recorded([], _, _, _, _, _, _, yes).
roles_recorded([RS|Rs], Sr, Mk, V, W, N, Hp, R?) :-
    ground(RS?), ground(Rs?), ground(Sr?), ground(Mk?), ground(V?), ground(W?), integer(N?),
    ground(Hp?) |
    rs_add(RS?, P),
    role_recorded(P?, Sr?, Mk?, V?, W?, N?, Hp?, A1),
    roles_recorded(Rs?, Sr?, Mk?, V?, W?, N?, Hp?, A2),
    both_yes(A1?, A2?, R).

procedure role_recorded(Atoms?, RoleSpecs?, Constant?, Constant?, Constant?, Integer?, Constant?,
                        Ans).
role_recorded(P, Sr, Mk, V, W, N, Hp, R?) :-
    ground(P?), ground(Sr?), ground(Mk?), ground(V?), ground(W?), integer(N?), ground(Hp?) |
    vs_recorded(P?, P?, Sr?, Mk?, V?, W?, N?, Hp?, R).

procedure contract_recorded(Contract?, Constant?, Constant?, Constant?, Constant?, Integer?,
                            Constant?, Ans).
contract_recorded([], _, _, _, _, _, _, yes).
contract_recorded([S|Ss], Mk, V, W, H, N, Hp, R?) :-
    ground(S?), ground(Ss?), ground(Mk?), ground(V?), ground(W?), ground(H?), integer(N?),
    ground(Hp?) |
    sch_roles(S?, Rs),
    schema_recorded(Rs?, Mk?, V?, W?, H?, N?, Hp?, A1),
    contract_recorded(Ss?, Mk?, V?, W?, H?, N?, Hp?, A2),
    both_yes(A1?, A2?, R).

procedure schema_recorded(RoleSpecs?, Constant?, Constant?, Constant?, Constant?, Integer?,
                          Constant?, Ans).
schema_recorded(Rs, Mk, V, W, H, N, Hp, R?) :-
    ground(Rs?), ground(Mk?), ground(V?), ground(W?), ground(H?), integer(N?), ground(Hp?) |
    mk_roles_rec(Rs?, 1, Rs?, Mk?, H?, N?, W?, Hp?, A1),
    roles_recorded(Rs?, Rs?, Mk?, V?, W?, N?, Hp?, A2),
    both_yes(A1?, A2?, R).

% records_of(C, Mk, V, W, H, N, Hs): the predicates h' of C, of N + 1 arguments, the records of the atoms of H as above, of which no schema of C deletes an atom.
procedure valid_recs1(Ans?, Constant?, Preds?, Contract?, Constant?, Constant?, Constant?,
                      Constant?, Integer?, Preds).
valid_recs1(yes, Hp, Hps, C, Mk, V, W, H, N, [Hp?|R?]) :-
    ground(Hps?), ground(C?), ground(Mk?), ground(V?), ground(W?), ground(H?), integer(N?) |
    valid_recs(Hps?, C?, Mk?, V?, W?, H?, N?, R).
valid_recs1(no, _, Hps, C, Mk, V, W, H, N, R?) :-
    ground(Hps?), ground(C?), ground(Mk?), ground(V?), ground(W?), ground(H?), integer(N?) |
    valid_recs(Hps?, C?, Mk?, V?, W?, H?, N?, R).

procedure valid_recs(Preds?, Contract?, Constant?, Constant?, Constant?, Constant?, Integer?, Preds).
valid_recs([], _, _, _, _, _, _, []).
valid_recs([Hp|Hps], C, Mk, V, W, H, N, R?) :-
    ground(Hp?), ground(Hps?), ground(C?), ground(Mk?), ground(V?), ground(W?), ground(H?),
    integer(N?) |
    contract_recorded(C?, Mk?, V?, W?, H?, N?, Hp?, A1),
    N1 := N? + 1,
    h_kept(C?, Hp?, N1?, A2),
    both_yes(A1?, A2?, A),
    valid_recs1(A?, Hp?, Hps?, C?, Mk?, V?, W?, H?, N?, R).

% The candidates for h'.  Where some schema adds Mk at a role I and W(role(I)) at a role J, h' is the predicate of an atom h'(role(I), As), As of N arguments, that J adds (mk_seed, the first such I and J of C); else, where some role adds V(A) and its schema does not add Mk at A, of an atom h'(A, As) that role adds (v_seed, the first such of C); else every predicate of C of N + 1 arguments.
procedure recs_beside1(Ans?, Constant?, Atoms?, Arg?, Integer?, Preds).
recs_beside1(yes, Q, Xs, A, N, [Q?|R?]) :- ground(Xs?), ground(A?), integer(N?) |
    recs_beside(Xs?, A?, N?, R).
recs_beside1(no, _, Xs, A, N, R?) :- ground(Xs?), ground(A?), integer(N?) |
    recs_beside(Xs?, A?, N?, R).

procedure recs_beside(Atoms?, Arg?, Integer?, Preds).
recs_beside([], _, _, []).
recs_beside([atom(Q, [B|As])|Xs], A, N, R?) :-
    ground(Q?), ground(B?), ground(A?), B? =?= A?, ground(As?), ground(Xs?), integer(N?) |
    args_len(As?, L),
    eq_ints(L?, N?, E),
    recs_beside1(E?, Q?, Xs?, A?, N?, R).
recs_beside([_|Xs], A, N, R?) :- otherwise, ground(Xs?), ground(A?), integer(N?) |
    recs_beside(Xs?, A?, N?, R).

% first_w_adds(Rs, I, W, F, P): F yes and P the atoms of the first role among Rs adding an atom of W, the v of the guardianship, naming role(I), or F no.
procedure first_w_adds2(Ans?, Atoms?, RoleSpecs?, Integer?, Constant?, Ans, Atoms).
first_w_adds2(yes, Q, _, _, _, yes, Q?).
first_w_adds2(no, _, Rs, I, W, F?, P?) :- ground(Rs?), integer(I?), ground(W?) |
    first_w_adds(Rs?, I?, W?, F, P).

procedure first_w_adds1(Atoms?, RoleSpecs?, Integer?, Constant?, Ans, Atoms).
first_w_adds1(Q, Rs, I, W, F?, P?) :- ground(Q?), ground(Rs?), integer(I?), ground(W?) |
    has_first_arg(Q?, W?, role(I?), A),
    first_w_adds2(A?, Q?, Rs?, I?, W?, F, P).

procedure first_w_adds(RoleSpecs?, Integer?, Constant?, Ans, Atoms).
first_w_adds([], _, _, no, []).
first_w_adds([RS|Rs], I, W, F?, P?) :- ground(RS?), ground(Rs?), integer(I?), ground(W?) |
    rs_add(RS?, Q),
    first_w_adds1(Q?, Rs?, I?, W?, F, P).

procedure mk_seed_role1(Ans?, Atoms?, RoleSpecs?, Integer?, RoleSpecs?, Constant?, Constant?,
                        Integer?, Ans, Preds).
mk_seed_role1(yes, PJ, _, I, _, _, _, N, yes, Hs?) :- ground(PJ?), integer(I?), integer(N?) |
    recs_beside(PJ?, role(I?), N?, Hs).
mk_seed_role1(no, _, Rs, I, Sr, Mk, W, N, F?, Hs?) :-
    ground(Rs?), integer(I?), ground(Sr?), ground(Mk?), ground(W?), integer(N?) |
    I1 := I? + 1,
    mk_seed_roles(Rs?, I1?, Sr?, Mk?, W?, N?, F, Hs).

procedure mk_seed_role(Atoms?, RoleSpecs?, Integer?, RoleSpecs?, Constant?, Constant?, Integer?,
                       Ans, Preds).
mk_seed_role(P, Rs, I, Sr, Mk, W, N, F?, Hs?) :-
    ground(P?), ground(Rs?), integer(I?), ground(Sr?), ground(Mk?), ground(W?), integer(N?) |
    atoms_member(P?, atom(Mk?, []), A),
    first_w_adds(Sr?, I?, W?, FW, PJ),
    both_yes(A?, FW?, B),
    mk_seed_role1(B?, PJ?, Rs?, I?, Sr?, Mk?, W?, N?, F, Hs).

procedure mk_seed_roles(RoleSpecs?, Integer?, RoleSpecs?, Constant?, Constant?, Integer?, Ans,
                        Preds).
mk_seed_roles([], _, _, _, _, _, no, []).
mk_seed_roles([RS|Rs], I, Sr, Mk, W, N, F?, Hs?) :-
    ground(RS?), ground(Rs?), integer(I?), ground(Sr?), ground(Mk?), ground(W?), integer(N?) |
    rs_add(RS?, P),
    mk_seed_role(P?, Rs?, I?, Sr?, Mk?, W?, N?, F, Hs).

procedure mk_seed1(Ans?, Preds?, Contract?, Constant?, Constant?, Integer?, Ans, Preds).
mk_seed1(yes, H1, _, _, _, _, yes, H1?).
mk_seed1(no, _, Ss, Mk, W, N, F?, Hs?) :- ground(Ss?), ground(Mk?), ground(W?), integer(N?) |
    mk_seed(Ss?, Mk?, W?, N?, F, Hs).

procedure mk_seed_s(RoleSpecs?, Contract?, Constant?, Constant?, Integer?, Ans, Preds).
mk_seed_s(Rs, Ss, Mk, W, N, F?, Hs?) :-
    ground(Rs?), ground(Ss?), ground(Mk?), ground(W?), integer(N?) |
    mk_seed_roles(Rs?, 1, Rs?, Mk?, W?, N?, F1, H1),
    mk_seed1(F1?, H1?, Ss?, Mk?, W?, N?, F, Hs).

procedure mk_seed(Contract?, Constant?, Constant?, Integer?, Ans, Preds).
mk_seed([], _, _, _, no, []).
mk_seed([S|Ss], Mk, W, N, F?, Hs?) :- ground(S?), ground(Ss?), ground(Mk?), ground(W?), integer(N?) |
    sch_roles(S?, Rs),
    mk_seed_s(Rs?, Ss?, Mk?, W?, N?, F, Hs).

% v_seed_atoms(Xs, P, Sr, Mk, V, N, F, Hs): the first atom V(A, ...) among Xs, of the atoms P a role adds, whose schema, of roles Sr, does not add Mk at A, and Hs the candidates beside it in P.
procedure v_seed_atom1(Ans?, Arg?, Atoms?, Atoms?, RoleSpecs?, Constant?, Constant?, Integer?, Ans,
                       Preds).
v_seed_atom1(no, A, _, P, _, _, _, N, yes, Hs?) :- ground(A?), ground(P?), integer(N?) |
    recs_beside(P?, A?, N?, Hs).
v_seed_atom1(yes, _, Xs, P, Sr, Mk, V, N, F?, Hs?) :-
    ground(Xs?), ground(P?), ground(Sr?), ground(Mk?), ground(V?), integer(N?) |
    v_seed_atoms(Xs?, P?, Sr?, Mk?, V?, N?, F, Hs).

procedure v_seed_atoms(Atoms?, Atoms?, RoleSpecs?, Constant?, Constant?, Integer?, Ans, Preds).
v_seed_atoms([], _, _, _, _, _, no, []).
v_seed_atoms([atom(Q, [A|_])|Xs], P, Sr, Mk, V, N, F?, Hs?) :-
    ground(V?), Q? =?= V?, ground(A?), ground(Xs?), ground(P?), ground(Sr?), ground(Mk?),
    integer(N?) |
    adds_mk_at(A?, Sr?, Mk?, M),
    v_seed_atom1(M?, A?, Xs?, P?, Sr?, Mk?, V?, N?, F, Hs).
v_seed_atoms([_|Xs], P, Sr, Mk, V, N, F?, Hs?) :-
    otherwise, ground(Xs?), ground(P?), ground(Sr?), ground(Mk?), ground(V?), integer(N?) |
    v_seed_atoms(Xs?, P?, Sr?, Mk?, V?, N?, F, Hs).

procedure v_seed_role(Atoms?, RoleSpecs?, RoleSpecs?, Constant?, Constant?, Integer?, Ans, Preds).
v_seed_role(P, Rs, Sr, Mk, V, N, F?, Hs?) :-
    ground(P?), ground(Rs?), ground(Sr?), ground(Mk?), ground(V?), integer(N?) |
    v_seed_atoms(P?, P?, Sr?, Mk?, V?, N?, F1, H1),
    v_seed_role1(F1?, H1?, Rs?, Sr?, Mk?, V?, N?, F, Hs).

procedure v_seed_role1(Ans?, Preds?, RoleSpecs?, RoleSpecs?, Constant?, Constant?, Integer?, Ans,
                       Preds).
v_seed_role1(yes, H1, _, _, _, _, _, yes, H1?).
v_seed_role1(no, _, Rs, Sr, Mk, V, N, F?, Hs?) :-
    ground(Rs?), ground(Sr?), ground(Mk?), ground(V?), integer(N?) |
    v_seed_roles(Rs?, Sr?, Mk?, V?, N?, F, Hs).

procedure v_seed_roles(RoleSpecs?, RoleSpecs?, Constant?, Constant?, Integer?, Ans, Preds).
v_seed_roles([], _, _, _, _, no, []).
v_seed_roles([RS|Rs], Sr, Mk, V, N, F?, Hs?) :-
    ground(RS?), ground(Rs?), ground(Sr?), ground(Mk?), ground(V?), integer(N?) |
    rs_add(RS?, P),
    v_seed_role(P?, Rs?, Sr?, Mk?, V?, N?, F, Hs).

procedure v_seed1(Ans?, Preds?, Contract?, Constant?, Constant?, Integer?, Ans, Preds).
v_seed1(yes, H1, _, _, _, _, yes, H1?).
v_seed1(no, _, Ss, Mk, V, N, F?, Hs?) :- ground(Ss?), ground(Mk?), ground(V?), integer(N?) |
    v_seed(Ss?, Mk?, V?, N?, F, Hs).

procedure v_seed_s(RoleSpecs?, Contract?, Constant?, Constant?, Integer?, Ans, Preds).
v_seed_s(Rs, Ss, Mk, V, N, F?, Hs?) :-
    ground(Rs?), ground(Ss?), ground(Mk?), ground(V?), integer(N?) |
    v_seed_roles(Rs?, Rs?, Mk?, V?, N?, F1, H1),
    v_seed1(F1?, H1?, Ss?, Mk?, V?, N?, F, Hs).

procedure v_seed(Contract?, Constant?, Constant?, Integer?, Ans, Preds).
v_seed([], _, _, _, no, []).
v_seed([S|Ss], Mk, V, N, F?, Hs?) :- ground(S?), ground(Ss?), ground(Mk?), ground(V?), integer(N?) |
    sch_roles(S?, Rs),
    v_seed_s(Rs?, Ss?, Mk?, V?, N?, F, Hs).

procedure records_seed2(Ans?, Preds?, Contract?, Integer?, Preds).
records_seed2(yes, Hs, _, _, Hs?).
records_seed2(no, _, C, N, R?) :- ground(C?), integer(N?) |
    N1 := N? + 1,
    preds_of_arity(C?, N1?, R).

procedure records_seed1(Ans?, Preds?, Contract?, Constant?, Constant?, Integer?, Preds).
records_seed1(yes, Hs, _, _, _, _, Hs?).
records_seed1(no, _, C, Mk, V, N, R?) :- ground(C?), ground(Mk?), ground(V?), integer(N?) |
    v_seed(C?, Mk?, V?, N?, F, Hs),
    records_seed2(F?, Hs?, C?, N?, R).

procedure records_of(Contract?, Constant?, Constant?, Constant?, Constant?, Integer?, Preds).
records_of(C, Mk, V, W, H, N, R?) :-
    ground(C?), ground(Mk?), ground(V?), ground(W?), ground(H?), integer(N?) |
    mk_seed(C?, Mk?, W?, N?, F, Hs1),
    records_seed1(F?, Hs1?, C?, Mk?, V?, N?, Hs0),
    valid_recs(Hs0?, C?, Mk?, V?, W?, H?, N?, R).

procedure drop_recs1(Ans?, Constant?, Args?, Atoms?, Args?, Preds?, Atoms).
drop_recs1(yes, _, _, Xs, T, Hs, R?) :- ground(Xs?), ground(T?), ground(Hs?) |
    drop_recs(Xs?, T?, Hs?, R).
drop_recs1(no, Q, As, Xs, T, Hs, [atom(Q?, As?)|R?]) :- ground(Xs?), ground(T?), ground(Hs?) |
    drop_recs(Xs?, T?, Hs?, R).

procedure drop_recs(Atoms?, Args?, Preds?, Atoms).
drop_recs([], _, _, []).
drop_recs([atom(Q, As)|Xs], T, Hs, R?) :-
    ground(As?), ground(T?), As? =?= T?, ground(Q?), ground(Xs?), ground(Hs?) |
    pred_member(Q?, Hs?, A),
    drop_recs1(A?, Q?, As?, Xs?, T?, Hs?, R).
drop_recs([X|Xs], T, Hs, [X?|R?]) :- otherwise, ground(Xs?), ground(T?), ground(Hs?) |
    drop_recs(Xs?, T?, Hs?, R).

% The atoms the schema requires at its roles, the records T of a predicate among Hs left out at every role: the record of the ward role, at its guardian role or, where the schema has two ward roles, at the guardian role of the other (def:relay, clause 2, GSC a885275), the alternatives of clause 2 admitting it at no other role.
procedure req_less_recs(RoleSpecs?, Args?, Preds?, Atoms).
req_less_recs([], _, _, []).
req_less_recs([RS|Rs], T, Hs, R?) :- ground(RS?), ground(Rs?), ground(T?), ground(Hs?) |
    rs_req(RS?, Q),
    drop_recs(Q?, T?, Hs?, Q1),
    req_less_recs(Rs?, T?, Hs?, R2),
    atoms_app(Q1?, R2?, R).

% The atom of h at the ward role X of Mk, whose guardian role is S, Sr being the roles of the schema: its arguments distinct speech-act variables of the schema, each occurring in no other atom the schema requires but its record; every schema of C adding Mk at a role adds an atom of h there; no schema of C deletes an atom of h; and there is a predicate h' of its record (records_of).
procedure req_h_ok3(Preds?, Ans?, Guardian?, Args?, Integer?, RoleSpecs?, Ans).
req_h_ok3([], _, _, _, _, _, no).
req_h_ok3([Hp|Hps], A1, S, As, X, Sr, R?) :-
    ground(Hp?), ground(Hps?), ground(A1?), ground(S?), ground(As?), integer(X?), ground(Sr?) |
    req_less_recs(Sr?, [role(X?)|As?], [Hp?|Hps?], Req),
    svars_once(As?, Req?, A2),
    both_yes(A1?, A2?, R).

procedure req_h_ok2(Constant?, Constant?, Integer?, Constant?, Guardian?, Constant?, Args?,
                    Integer?, RoleSpecs?, Contract?, Ans).
req_h_ok2(V, W, N, Mk, S, H, As, X, Sr, C, R?) :-
    ground(V?), ground(W?), integer(N?), ground(Mk?), ground(S?), ground(H?), ground(As?),
    integer(X?), ground(Sr?), ground(C?) |
    h_added_all(C?, Mk?, H?, N?, A0),
    records_of(C?, Mk?, V?, W?, H?, N?, Hs),
    h_kept(C?, H?, N?, A1),
    both_yes(A0?, A1?, A01),
    req_h_ok3(Hs?, A01?, S?, As?, X?, Sr?, R).

procedure req_h_ok1(Ans?, Constant?, Guardian?, Constant?, Args?, Integer?, RoleSpecs?, Contract?,
                    Guardianships?, Ans).
req_h_ok1(no, _, _, _, _, _, _, _, _, no).
req_h_ok1(yes, Mk, S, H, As, X, Sr, C, Gs, R?) :-
    ground(Mk?), ground(S?), ground(H?), ground(As?), integer(X?), ground(Sr?), ground(C?),
    ground(Gs?) |
    v_of(Gs?, Mk?, V),
    v_of(Gs?, Mk?, W),
    args_len(As?, N),
    req_h_ok2(V?, W?, N?, Mk?, S?, H?, As?, X?, Sr?, C?, R).

procedure req_h_ok(RK?, Atom?, Integer?, RoleSpecs?, Contract?, Guardianships?, Ans).
req_h_ok(rk_ward(Mk, S), atom(H, As), X, Sr, C, Gs, R?) :-
    ground(Mk?), ground(S?), ground(H?), ground(As?), integer(X?), ground(Sr?), ground(C?),
    ground(Gs?) |
    all_svars(As?, A1),
    distinct_args(As?, A2),
    both_yes(A1?, A2?, A),
    req_h_ok1(A?, Mk?, S?, H?, As?, X?, Sr?, C?, Gs?, R).
req_h_ok(rk_free, _, _, _, _, _, no).
req_h_ok(rk_guard, _, _, _, _, _, no).
req_h_ok(rk_other, _, _, _, _, _, no).

% The record at the guardian role X of a ward role Rho: h'(Rho, As), for an atom h(As) the schema requires at Rho that clause 2 admits as an atom of h, h' a predicate of its record (records_of).
procedure req_rec_hs(Atoms?, Constant?, Args?, Integer?, Constant?, Guardian?, RoleSpecs?,
                     Contract?, Guardianships?, Ans).
req_rec_hs([], _, _, _, _, _, _, _, _, no).
req_rec_hs([atom(H, Bs)|Xs], Hp, As, Rho, Mk, S, Sr, C, Gs, R?) :-
    ground(Bs?), ground(As?), Bs? =?= As?, ground(H?), ground(Xs?), ground(Hp?), integer(Rho?),
    ground(Mk?), ground(S?), ground(Sr?), ground(C?), ground(Gs?) |
    req_h_ok(rk_ward(Mk?, S?), atom(H?, Bs?), Rho?, Sr?, C?, Gs?, A1),
    v_of(Gs?, Mk?, V),
    v_of(Gs?, Mk?, W),
    args_len(As?, N),
    records_of(C?, Mk?, V?, W?, H?, N?, Hs),
    pred_member(Hp?, Hs?, A2),
    both_yes(A1?, A2?, A),
    req_rec_hs(Xs?, Hp?, As?, Rho?, Mk?, S?, Sr?, C?, Gs?, A3),
    or_yes(A?, A3?, R).
req_rec_hs([_|Xs], Hp, As, Rho, Mk, S, Sr, C, Gs, R?) :-
    otherwise, ground(Xs?), ground(Hp?), ground(As?), integer(Rho?), ground(Mk?), ground(S?),
    ground(Sr?), ground(C?), ground(Gs?) |
    req_rec_hs(Xs?, Hp?, As?, Rho?, Mk?, S?, Sr?, C?, Gs?, R).

% req_rec_of(Phi, P, ...): Phi is the record of the ward role P, whatever role holds it.
procedure req_rec_of(Atom?, Party?, RoleSpecs?, Contract?, Guardianships?, Ans).
req_rec_of(atom(Hp, [role(R1)|As]), ward(Rho, Mk, S), Sr, C, Gs, R?) :-
    integer(Rho?), integer(R1?), R1? =:= Rho?,
    ground(Hp?), ground(As?), ground(Mk?), ground(S?), ground(Sr?), ground(C?), ground(Gs?) |
    nth_rs(Sr?, Rho?, RS),
    rs_req(RS?, Q),
    req_rec_hs(Q?, Hp?, As?, Rho?, Mk?, S?, Sr?, C?, Gs?, R).
req_rec_of(_, _, _, _, _, no) :- otherwise | true.

% The record at X of the ward role whose guardian role X is.
procedure req_rec_party(Atom?, Integer?, Party?, RoleSpecs?, Contract?, Guardianships?, Ans).
req_rec_party(Phi, X, ward(Rho, Mk, guardian(S)), Sr, C, Gs, R?) :-
    integer(X?), integer(S?), S? =:= X?,
    ground(Phi?), integer(Rho?), ground(Mk?), ground(Sr?), ground(C?), ground(Gs?) |
    req_rec_of(Phi?, ward(Rho?, Mk?, guardian(S?)), Sr?, C?, Gs?, R).
req_rec_party(_, _, _, _, _, _, no) :- otherwise | true.

% The record of the other ward role, at the guardian role X of one, where the schema has two ward roles (def:relay, clause 2, GSC a885275; GnW:4, Alice holding her record of Dave): the record req_rec_party admits at the guardian role of the other.
procedure req_rec_other(Atom?, Integer?, Party?, Party?, RoleSpecs?, Contract?, Guardianships?, Ans).
req_rec_other(Phi, X, ward(_, _, guardian(S1)), P2, Sr, C, Gs, R?) :-
    integer(X?), integer(S1?), S1? =:= X?, ground(P2?),
    ground(Phi?), ground(Sr?), ground(C?), ground(Gs?) |
    req_rec_of(Phi?, P2?, Sr?, C?, Gs?, R).
req_rec_other(_, _, _, _, _, _, _, no) :- otherwise | true.

procedure req_rec_ok(RK?, Atom?, Integer?, Party?, Party?, RoleSpecs?, Contract?, Guardianships?,
                     Ans).
req_rec_ok(rk_guard, Phi, X, P1, P2, Sr, C, Gs, R?) :-
    ground(Phi?), integer(X?), ground(P1?), ground(P2?), ground(Sr?), ground(C?), ground(Gs?) |
    req_rec_party(Phi?, X?, P1?, Sr?, C?, Gs?, A1),
    req_rec_party(Phi?, X?, P2?, Sr?, C?, Gs?, A2),
    req_rec_other(Phi?, X?, P1?, P2?, Sr?, C?, Gs?, A3),
    req_rec_other(Phi?, X?, P2?, P1?, Sr?, C?, Gs?, A4),
    or_yes(A1?, A2?, A12),
    or_yes(A3?, A4?, A34),
    or_yes(A12?, A34?, R).
req_rec_ok(rk_ward(_, _), _, _, _, _, _, _, _, no).
req_rec_ok(rk_free, _, _, _, _, _, _, _, no).
req_rec_ok(rk_other, _, _, _, _, _, _, _, no).

% Every alternative of clause 2 but the atom of h.
procedure req_atom_other(Atom?, Integer?, RK?, Contract?, Preds?, Preds?, Constant?,
                         Guardianships?, RKs?, Party?, Party?, RoleSpecs?, Ans).
req_atom_other(Phi, X, KX, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    ground(Phi?), integer(X?), ground(KX?), ground(C?), ground(Rf?), ground(Kn?), ground(E?),
    ground(Gs?), ground(RKs?), ground(P1?), ground(P2?), ground(Sr?) |
    own_reflexive(Phi?, X?, Rf?, A1),
    unary_at(KX?, C?, Kn?, Phi?, X?, A2),
    req_ward_ok(KX?, Phi?, X?, Sr?, Gs?, A3),
    req_guard_ok(KX?, Phi?, X?, P1?, P2?, Gs?, A4),
    req_e_ok(Phi?, X?, KX?, E?, Rf?, RKs?, A5),
    req_rec_ok(KX?, Phi?, X?, P1?, P2?, Sr?, C?, Gs?, A6),
    req_e_ward_ok(Phi?, X?, E?, P1?, P2?, A7),
    kind_atom_ok(KX?, Phi?, Kn?, A8),
    or_yes(A1?, A2?, A12),
    or_yes(A3?, A4?, A34),
    or_yes(A12?, A34?, A1234),
    or_yes(A5?, A6?, A56),
    or_yes(A7?, A8?, A78),
    or_yes(A56?, A78?, A5678),
    or_yes(A1234?, A5678?, R).

% iota at any role, and f at a free role or a guardian role (def:relay,
% clause 2, GSC 7e00aba), K being [iota, f].
procedure kind_atom_ok(RK?, Atom?, Preds?, Ans).
kind_atom_ok(KX, Phi, [Io, F], R?) :- ground(KX?), ground(Phi?), ground(Io?), ground(F?) |
    same_atom(Phi?, atom(Io?, []), A1),
    same_atom(Phi?, atom(F?, []), A2),
    rk_free_or_guard(KX?, A3),
    both_yes(A2?, A3?, A23),
    or_yes(A1?, A23?, R).
kind_atom_ok(_, _, K, no) :- otherwise, ground(K?) | true.

procedure rk_free_or_guard(RK?, Ans).
rk_free_or_guard(rk_free, yes).
rk_free_or_guard(rk_guard, yes).
rk_free_or_guard(rk_ward(_, _), no).
rk_free_or_guard(rk_other, no).

% The one atom of a schema of arity one as in def:unobstructed-marks, at a
% free role or a guardian role (def:relay, clause 2, GSC 7e00aba).
procedure unary_at1(Ans?, Contract?, Preds?, Atom?, Integer?, Ans).
unary_at1(no, _, _, _, _, no).
unary_at1(yes, C, K, Phi, X, R?) :- ground(C?), ground(K?), ground(Phi?), integer(X?) |
    unary_one(C?, K?, Phi?, X?, R).

procedure unary_at(RK?, Contract?, Preds?, Atom?, Integer?, Ans).
unary_at(KX, C, K, Phi, X, R?) :-
    ground(KX?), ground(C?), ground(K?), ground(Phi?), integer(X?) |
    rk_free_or_guard(KX?, A),
    unary_at1(A?, C?, K?, Phi?, X?, R).

procedure req_atom_ok(Atom?, Integer?, RK?, Contract?, Preds?, Preds?, Constant?, Guardianships?,
                      RKs?, Party?, Party?, RoleSpecs?, Ans).
req_atom_ok(Phi, X, KX, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    ground(Phi?), integer(X?), ground(KX?), ground(C?), ground(Rf?), ground(Kn?), ground(E?),
    ground(Gs?), ground(RKs?), ground(P1?), ground(P2?), ground(Sr?) |
    req_atom_other(Phi?, X?, KX?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A1),
    req_h_ok(KX?, Phi?, X?, Sr?, C?, Gs?, A2),
    or_yes(A1?, A2?, R).

procedure req_atoms_ok(Atoms?, Integer?, RK?, Contract?, Preds?, Preds?, Constant?, Guardianships?,
                       RKs?, Party?, Party?, RoleSpecs?, Ans).
req_atoms_ok([], _, _, _, _, _, _, _, _, _, _, _, yes).
req_atoms_ok([Phi|Phis], X, KX, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    ground(Phi?), ground(Phis?), integer(X?), ground(KX?), ground(C?), ground(Rf?), ground(Kn?),
    ground(E?), ground(Gs?), ground(RKs?), ground(P1?), ground(P2?), ground(Sr?) |
    req_atom_ok(Phi?, X?, KX?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A1),
    req_atoms_ok(Phis?, X?, KX?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A2),
    both_yes(A1?, A2?, R).

% The atoms a schema requires at its roles, in role order.
procedure roles_req(RoleSpecs?, Atoms).
roles_req([], []).
roles_req([RS|Rs], R?) :- ground(RS?), ground(Rs?) |
    rs_req(RS?, Q),
    roles_req(Rs?, T),
    atoms_app(Q?, T?, R).

% The end of clause 2 (GSC a885275): the schema adds at a free role the record of each ward role, for every atom h(As) the ward role Rho requires that clause 2 admits as an atom of h and as nothing else, as relay_h_for reads it, an atom h'(Rho, As) among the atoms the free role adds, h' a predicate of its record (records_of).  A ward role requiring no atom of h has no record, and asks nothing of the free role.
procedure has_rec_added(Atoms?, Preds?, Args?, Ans).
has_rec_added([], _, _, no).
has_rec_added([atom(Q, As)|Xs], Hs, T, R?) :-
    ground(As?), ground(T?), As? =?= T?, ground(Q?), ground(Hs?), ground(Xs?) |
    pred_member(Q?, Hs?, A1),
    has_rec_added(Xs?, Hs?, T?, A2),
    or_yes(A1?, A2?, R).
has_rec_added([_|Xs], Hs, T, R?) :- otherwise, ground(Xs?), ground(Hs?), ground(T?) |
    has_rec_added(Xs?, Hs?, T?, R).

procedure free_rec_one(Ans?, Atom?, Atoms?, Integer?, RK?, Contract?, Guardianships?, Ans).
free_rec_one(no, _, _, _, _, _, _, yes).
free_rec_one(yes, atom(H, As), Ad, Rho, rk_ward(Mk, _), C, Gs, R?) :-
    ground(H?), ground(As?), ground(Ad?), integer(Rho?), ground(Mk?), ground(C?), ground(Gs?) |
    v_of(Gs?, Mk?, V),
    v_of(Gs?, Mk?, W),
    args_len(As?, N),
    records_of(C?, Mk?, V?, W?, H?, N?, Hs),
    has_rec_added(Ad?, Hs?, [role(Rho?)|As?], R).
free_rec_one(_, _, _, _, _, _, _, no) :- otherwise | true.

procedure free_rec_atoms(Atoms?, Atoms?, Integer?, RK?, Contract?, Preds?, Preds?, Constant?,
                         Guardianships?, RKs?, Party?, Party?, RoleSpecs?, Ans).
free_rec_atoms([], _, _, _, _, _, _, _, _, _, _, _, _, yes).
free_rec_atoms([Phi|Phis], Ad, Rho, KR, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    ground(Phi?), ground(Phis?), ground(Ad?), integer(Rho?), ground(KR?), ground(C?),
    ground(Rf?), ground(Kn?), ground(E?), ground(Gs?), ground(RKs?), ground(P1?), ground(P2?),
    ground(Sr?) |
    req_atom_other(Phi?, Rho?, KR?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A1),
    req_h_ok(KR?, Phi?, Rho?, Sr?, C?, Gs?, A2),
    flip(A1?, N1),
    both_yes(N1?, A2?, A),
    free_rec_one(A?, Phi?, Ad?, Rho?, KR?, C?, Gs?, A3),
    free_rec_atoms(Phis?, Ad?, Rho?, KR?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A4),
    both_yes(A3?, A4?, R).

procedure free_recs_party(Party?, Atoms?, Contract?, Preds?, Preds?, Constant?, Guardianships?,
                          RKs?, Party?, Party?, RoleSpecs?, Ans).
free_recs_party(ward(Rho, _, _), Ad, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    integer(Rho?), ground(Ad?), ground(C?), ground(Rf?), ground(Kn?), ground(E?), ground(Gs?),
    ground(RKs?), ground(P1?), ground(P2?), ground(Sr?) |
    nth_rs(Sr?, Rho?, RS),
    rs_req(RS?, Q),
    nth_rk(RKs?, Rho?, KR),
    free_rec_atoms(Q?, Ad?, Rho?, KR?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, R).
free_recs_party(free(_), _, _, _, _, _, _, _, _, _, _, yes).

procedure free_recs_ok1(Atoms?, Contract?, Preds?, Preds?, Constant?, Guardianships?, RKs?,
                        Party?, Party?, RoleSpecs?, Ans).
free_recs_ok1(Ad, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    ground(Ad?), ground(C?), ground(Rf?), ground(Kn?), ground(E?), ground(Gs?), ground(RKs?),
    ground(P1?), ground(P2?), ground(Sr?) |
    free_recs_party(P1?, Ad?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A1),
    free_recs_party(P2?, Ad?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A2),
    both_yes(A1?, A2?, R).

procedure free_recs_ok(RK?, RoleSpec?, Contract?, Preds?, Preds?, Constant?, Guardianships?,
                       RKs?, Party?, Party?, RoleSpecs?, Ans).
free_recs_ok(rk_free, RS, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    ground(RS?), ground(C?), ground(Rf?), ground(Kn?), ground(E?), ground(Gs?), ground(RKs?),
    ground(P1?), ground(P2?), ground(Sr?) |
    rs_add(RS?, Ad),
    free_recs_ok1(Ad?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, R).
free_recs_ok(rk_ward(_, _), _, _, _, _, _, _, _, _, _, _, yes).
free_recs_ok(rk_guard, _, _, _, _, _, _, _, _, _, _, yes).
free_recs_ok(rk_other, _, _, _, _, _, _, _, _, _, _, yes).

% The schema forbids nothing (def:relay, GSC 7e00aba), no_atoms above.

% --- the definition at every role -----------------------------------------

procedure relay_roles(RoleSpecs?, Integer?, Integer?, RKs?, Contract?, Preds?, Preds?, Preds?,
                      Constant?, Guardianships?, Party?, Party?, RoleSpecs?, Ans).
relay_roles([], _, _, _, _, _, _, _, _, _, _, _, _, yes).
relay_roles([RS|Rs], X, K, RKs, C, Rf, M, Kn, E, Gs, P1, P2, Sr, R?) :-
    ground(RS?), ground(Rs?), integer(X?), integer(K?), ground(RKs?), ground(C?), ground(Rf?),
    ground(M?), ground(Kn?), ground(E?), ground(Gs?), ground(P1?), ground(P2?), ground(Sr?) |
    nth_rk(RKs?, X?, KX),
    relay_role(RS?, X?, K?, KX?, RKs?, C?, Rf?, M?, Kn?, E?, Gs?, P1?, P2?, Sr?, A123),
    X1 := X? + 1,
    relay_roles(Rs?, X1?, K?, RKs?, C?, Rf?, M?, Kn?, E?, Gs?, P1?, P2?, Sr?, A4),
    both_yes(A123?, A4?, R).

% One role, of kind KX; Sr is every role of the schema.
procedure relay_role(RoleSpec?, Integer?, Integer?, RK?, RKs?, Contract?, Preds?, Preds?, Preds?,
                     Constant?, Guardianships?, Party?, Party?, RoleSpecs?, Ans).
relay_role(RS, X, K, KX, RKs, C, Rf, M, Kn, E, Gs, P1, P2, Sr, R?) :-
    ground(RS?), integer(X?), integer(K?), ground(KX?), ground(RKs?), ground(C?), ground(Rf?),
    ground(M?), ground(Kn?), ground(E?), ground(Gs?), ground(P1?), ground(P2?), ground(Sr?) |
    guard_adds_ok(KX?, RS?, X?, RKs?, K?, A1),
    rs_req(RS?, Req),
    relay_req_ok(Req?, X?, KX?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A2, A5),
    rs_forb(RS?, N),
    no_atoms(N?, A3),
    free_recs_ok(KX?, RS?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A4),
    both_yes(A1?, A2?, A12),
    both_yes(A3?, A4?, A34),
    both_yes(A12?, A34?, A1234),
    both_yes(A1234?, A5?, R).

% The atoms the role requires: each admitted by clause 2, one atom of u at
% most at a ward role.
procedure relay_req_ok(Atoms?, Integer?, RK?, Contract?, Preds?, Preds?, Constant?,
                       Guardianships?, RKs?, Party?, Party?, RoleSpecs?, Ans, Ans).
relay_req_ok(Req, X, KX, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, A2?, A5?) :-
    ground(Req?), integer(X?), ground(KX?), ground(C?), ground(Rf?), ground(Kn?), ground(E?),
    ground(Gs?), ground(RKs?), ground(P1?), ground(P2?), ground(Sr?) |
    req_atoms_ok(Req?, X?, KX?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A2),
    ward_one_u(KX?, Req?, Gs?, A5).

% adds_e_naming(Phis, E, J, R): some atom of e among Phis names role J.
procedure adds_e_naming(Atoms?, Constant?, Integer?, Ans).
adds_e_naming([], _, _, no).
adds_e_naming([atom(Q, As)|Xs], E, J, R?) :-
    Q? =?= E?, ground(As?), ground(Xs?), integer(J?) |
    args_name_role(As?, J?, A1),
    adds_e_naming(Xs?, E?, J?, A2),
    or_yes(A1?, A2?, R).
adds_e_naming([atom(_, _)|Xs], E, J, R?) :- otherwise, ground(Xs?), ground(E?), integer(J?) |
    adds_e_naming(Xs?, E?, J?, R).

% The two parties: distinct, guarded, each adding an atom of e naming the
% other.
procedure parties_ok1(RoleSpec?, RoleSpec?, Integer?, Integer?, Constant?, Ans).
parties_ok1(RI, RJ, I, J, E, R?) :-
    ground(RI?), ground(RJ?), integer(I?), integer(J?), ground(E?) |
    is_guarding(RI?, G1),
    is_guarding(RJ?, G2),
    rs_add(RI?, PI),
    rs_add(RJ?, PJ),
    adds_e_naming(PI?, E?, J?, N1),
    adds_e_naming(PJ?, E?, I?, N2),
    both_yes(G1?, G2?, G),
    both_yes(N1?, N2?, N),
    both_yes(G?, N?, R).

procedure parties_ok0(Integer?, Integer?, RoleSpecs?, Constant?, Ans).
parties_ok0(I, J, Rs, E, R?) :- integer(I?), integer(J?), ground(Rs?), ground(E?) |
    nth_rs(Rs?, I?, RI),
    nth_rs(Rs?, J?, RJ),
    parties_ok1(RI?, RJ?, I?, J?, E?, R).

procedure parties_ok(RoleSpecs?, Constant?, Party?, Party?, Ans).
parties_ok(Rs, E, P1, P2, R?) :- ground(Rs?), ground(E?), ground(P1?), ground(P2?) |
    party_role(P1?, I),
    party_role(P2?, J),
    parties_ok0(I?, J?, Rs?, E?, R).

% relay_with(Sc, C, Rf, M, Gs, E, P1, P2, R): the schema is a relay act with
% the parties P1 and P2.
procedure relay_with1(Ans?, Schema?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?,
                      Party?, Party?, Ans).
relay_with1(no, _, _, _, _, _, _, _, _, _, no).
relay_with1(yes, Sc, C, Rf, M, Kn, Gs, E, P1, P2, R?) :-
    ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?),
    ground(P1?), ground(P2?) |
    sch_roles(Sc?, Rs),
    relay_with2(Rs?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, P2?, R).

procedure relay_with2(RoleSpecs?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?,
                      Party?, Party?, Ans).
relay_with2(Rs, C, Rf, M, Kn, Gs, E, P1, P2, R?) :-
    ground(Rs?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?),
    ground(P1?), ground(P2?) |
    roles_len(Rs?, K),
    party_sigma(P1?, S1),
    party_sigma(P2?, S2),
    ints_app(S1?, S2?, Sigmas),
    role_kinds(1, K?, P1?, P2?, Sigmas?, RKs),
    relay_with3(RKs?, Rs?, K?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, P2?, R).

procedure relay_with3(RKs?, RoleSpecs?, Integer?, Contract?, Preds?, Preds?, Preds?, Guardianships?,
                      Constant?, Party?, Party?, Ans).
relay_with3(RKs, Rs, K, C, Rf, M, Kn, Gs, E, P1, P2, R?) :-
    ground(RKs?), ground(Rs?), integer(K?), ground(C?), ground(Rf?), ground(M?), ground(Kn?),
    ground(Gs?), ground(E?), ground(P1?), ground(P2?) |
    no_other(RKs?, A1),
    relay_roles(Rs?, 1, K?, RKs?, C?, Rf?, M?, Kn?, E?, Gs?, P1?, P2?, Rs?, A2),
    both_yes(A1?, A2?, R).

procedure ints_app(Ints?, Ints?, Ints).
ints_app([], T, T?).
ints_app([I|Is], T, [I?|R?]) :- ints_app(Is?, T?, R).

procedure relay_with(Schema?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?, Party?,
                     Party?, Ans).
relay_with(Sc, C, Rf, M, Kn, Gs, E, P1, P2, R?) :-
    ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?),
    ground(P1?), ground(P2?) |
    sch_roles(Sc?, Rs),
    parties_ok(Rs?, E?, P1?, P2?, A),
    relay_with1(A?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, P2?, R).

% --- the parties sought ----------------------------------------------------
% The readings of the role at J as the second party: free when a free role
% is sought, a ward of the mark when a ward of it is.

procedure second_parties(Kind?, RoleSpecs?, Integer?, Preds?, Guardianships?, Parties).
second_parties(free_party, Rs, J, K, _, R?) :- ground(Rs?), integer(J?), ground(K?) |
    nth_rs(Rs?, J?, RS),
    is_free_role(RS?, K?, A),
    free_party_at(A?, J?, R).
second_parties(ward_party(Mk), Rs, J, _, Gs, R?) :- ground(Rs?), integer(J?), ground(Mk?), ground(Gs?) |
    ward_party(Rs?, J?, Mk?, Gs?, R).

procedure free_party_at(Ans?, Integer?, Parties).
free_party_at(yes, J, [free(J?)]).
free_party_at(no, _, []).

% Over the second party's readings at J, then over J, then over I.
procedure try_p2s(Parties?, Schema?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?,
                  Party?, Relays).
try_p2s([], _, _, _, _, _, _, _, _, []).
try_p2s([P2|P2s], Sc, C, Rf, M, Kn, Gs, E, P1, R?) :-
    ground(P2?), ground(P2s?), ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?),
    ground(Gs?), ground(E?), ground(P1?) |
    relay_with(Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, P2?, A),
    try_p2s1(A?, P2?, P2s?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, R).

procedure try_p2s1(Ans?, Party?, Parties?, Schema?, Contract?, Preds?, Preds?, Preds?,
                   Guardianships?, Constant?, Party?, Relays).
try_p2s1(yes, P2, _, Sc, _, _, _, _, _, _, P1, [relay(Nm?, P1?, P2?)]) :- ground(Sc?) |
    sch_name(Sc?, Nm).
try_p2s1(no, _, P2s, Sc, C, Rf, M, Kn, Gs, E, P1, R?) :-
    ground(P2s?), ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?),
    ground(E?), ground(P1?) |
    try_p2s(P2s?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, R).

procedure try_js(Integer?, Integer?, Schema?, Contract?, Preds?, Preds?, Preds?, Guardianships?,
                 Constant?, Party?, Kind?, Relays).
try_js(J, K, _, _, _, _, _, _, _, _, _, []) :- J? > K? | true.
try_js(J, K, Sc, C, Rf, M, Kn, Gs, E, P1, Kind, R?) :-
    J? =< K?, integer(J?), integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?),
    ground(Kn?), ground(Gs?), ground(E?), ground(P1?), ground(Kind?) |
    party_role(P1?, I),
    try_js1(I?, J?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, Kind?, R).

procedure try_js1(Integer?, Integer?, Integer?, Schema?, Contract?, Preds?, Preds?, Preds?,
                  Guardianships?, Constant?, Party?, Kind?, Relays).
try_js1(I, J, K, Sc, C, Rf, M, Kn, Gs, E, P1, Kind, R?) :-
    I? =:= J?, integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?),
    ground(Gs?), ground(E?), ground(P1?), ground(Kind?) |
    J1 := J? + 1,
    try_js(J1?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, Kind?, R).
try_js1(_, J, K, Sc, C, Rf, M, Kn, Gs, E, P1, Kind, R?) :-
    otherwise, integer(J?), integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?),
    ground(Kn?), ground(Gs?), ground(E?), ground(P1?), ground(Kind?) |
    sch_roles(Sc?, Rs),
    second_parties(Kind?, Rs?, J?, Kn?, Gs?, P2s),
    try_p2s(P2s?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, R1),
    try_js2(R1?, J?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, Kind?, R).

procedure try_js2(Relays?, Integer?, Integer?, Schema?, Contract?, Preds?, Preds?, Preds?,
                  Guardianships?, Constant?, Party?, Kind?, Relays).
try_js2([X|Xs], _, _, _, _, _, _, _, _, _, _, _, [X?|Xs?]).
try_js2([], J, K, Sc, C, Rf, M, Kn, Gs, E, P1, Kind, R?) :-
    integer(J?), integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?),
    ground(Gs?), ground(E?), ground(P1?), ground(Kind?) |
    J1 := J? + 1,
    try_js(J1?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, Kind?, R).

procedure try_is(Integer?, Integer?, Schema?, Contract?, Preds?, Preds?, Preds?, Guardianships?,
                 Constant?, Constant?, Kind?, Relays).
try_is(I, K, _, _, _, _, _, _, _, _, _, []) :- I? > K? | true.
try_is(I, K, Sc, C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    I? =< K?, integer(I?), integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?),
    ground(Kn?), ground(Gs?), ground(E?), ground(Mk?), ground(Kind?) |
    sch_roles(Sc?, Rs),
    ward_party(Rs?, I?, Mk?, Gs?, P1s),
    try_is1(P1s?, I?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).

procedure try_is1(Parties?, Integer?, Integer?, Schema?, Contract?, Preds?, Preds?, Preds?,
                  Guardianships?, Constant?, Constant?, Kind?, Relays).
try_is1([], I, K, Sc, C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    integer(I?), integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?),
    ground(Gs?), ground(E?), ground(Mk?), ground(Kind?) |
    I1 := I? + 1,
    try_is(I1?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).
try_is1([P1|_], I, K, Sc, C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    ground(P1?), integer(I?), integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?),
    ground(Kn?), ground(Gs?), ground(E?), ground(Mk?), ground(Kind?) |
    try_js(1, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, P1?, Kind?, R1),
    try_is2(R1?, I?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).

procedure try_is2(Relays?, Integer?, Integer?, Schema?, Contract?, Preds?, Preds?, Preds?,
                  Guardianships?, Constant?, Constant?, Kind?, Relays).
try_is2([X|Xs], _, _, _, _, _, _, _, _, _, _, _, [X?|Xs?]).
try_is2([], I, K, Sc, C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    integer(I?), integer(K?), ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?),
    ground(Gs?), ground(E?), ground(Mk?), ground(Kind?) |
    I1 := I? + 1,
    try_is(I1?, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).

% relay_in(Sc, ...): the schema as a relay act with a ward role of Mk as its
% first party and a party of the kind sought as its second, if it is one.
% A relay act has agent roles and no name term (def:sg-wards, clause 1; for
% a contract of Section 3 it asks nothing).
procedure relay_in1(Ans?, Schema?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?,
                    Constant?, Kind?, Relays).
relay_in1(no, _, _, _, _, _, _, _, _, _, []).
relay_in1(yes, Sc, C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?),
    ground(Mk?), ground(Kind?) |
    sch_roles(Sc?, Rs),
    roles_len(Rs?, K),
    try_is(1, K?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).

procedure agent_plain1(RoleSpecs?, NameTerms?, Ans).
agent_plain1(Rs, Ns, R?) :- ground(Rs?), ground(Ns?) |
    roles_community(Rs?, A1),
    flip(A1?, A2),
    nts_empty(Ns?, A3),
    both_yes(A2?, A3?, R).

procedure relay_in(Schema?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?, Constant?,
                   Kind?, Relays).
relay_in(Sc, C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    ground(Sc?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?),
    ground(Mk?), ground(Kind?) |
    sch_roles(Sc?, Rs),
    sch_nts(Sc?, Ns),
    agent_plain1(Rs?, Ns?, A),
    relay_in1(A?, Sc?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).

% find_relay(Schemas, ...): the first schema of C that is such a relay act.
procedure find_relay1(Relays?, Contract?, Contract?, Preds?, Preds?, Preds?, Guardianships?,
                      Constant?, Constant?, Kind?, Relays).
find_relay1([X|Xs], _, _, _, _, _, _, _, _, _, [X?|Xs?]).
find_relay1([], Ss, C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    ground(Ss?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?),
    ground(Mk?), ground(Kind?) |
    find_relay(Ss?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).

procedure find_relay(Contract?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?,
                     Constant?, Kind?, Relays).
find_relay([], _, _, _, _, _, _, _, _, []).
find_relay([S|Ss], C, Rf, M, Kn, Gs, E, Mk, Kind, R?) :-
    ground(S?), ground(Ss?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?),
    ground(E?), ground(Mk?), ground(Kind?) |
    relay_in(S?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R1),
    find_relay1(R1?, Ss?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Kind?, R).

% ---------------------------------------------------------------------------
% Introduction with wards (def:introduction-wards)
% ---------------------------------------------------------------------------
% For every mark m of M that is not passive a relay act with a ward role of m
% and a free role, and for every such m and m' a relay act with a ward role of
% each, m' running from m on in the order of M (GSC eede0fa); the relay acts
% found are listed in that order.

procedure relays_app(Relays?, Relays?, Relays).
relays_app([], T, T?).
relays_app([X|Xs], T, [X?|R?]) :- relays_app(Xs?, T?, R).

procedure nonempty_relays(Relays?, Ans).
nonempty_relays([], no).
nonempty_relays([_|_], yes).

% relays_join(R1, R2, A2, R, A): R1 before R2, found when R1 is nonempty
% and A2 holds.
procedure relays_join(Relays?, Relays?, Ans?, Relays, Ans).
relays_join(R1, R2, A2, R?, A?) :- ground(R1?), ground(R2?), ground(A2?) |
    nonempty_relays(R1?, A1),
    relays_app(R1?, R2?, R),
    both_yes(A1?, A2?, A).

procedure relays_pairs(Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?, Constant?,
                       Preds?, Relays, Ans).
relays_pairs(_, _, _, _, _, _, _, [], [], yes).
relays_pairs(C, Rf, M, Kn, Gs, E, Mk, [Mk2|Mks], R?, A?) :-
    ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?), ground(Mk?),
    ground(Mk2?), ground(Mks?) |
    find_relay(C?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, ward_party(Mk2?), R1),
    relays_pairs(C?, Rf?, M?, Kn?, Gs?, E?, Mk?, Mks?, R2, A2),
    relays_join(R1?, R2?, A2?, R, A).

procedure relays_for(Contract?, Preds?, Preds?, Preds?, Guardianships?, Constant?, Preds?, Relays,
                     Ans).
relays_for(_, _, _, _, _, _, [], [], yes).
relays_for(C, Rf, M, Kn, Gs, E, [Mk|Mks], R?, A?) :-
    ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?), ground(E?), ground(Mk?),
    ground(Mks?) |
    find_relay(C?, C?, Rf?, M?, Kn?, Gs?, E?, Mk?, free_party, R1),
    relays_pairs(C?, Rf?, M?, Kn?, Gs?, E?, Mk?, [Mk?|Mks?], R2, A2),
    relays_for(C?, Rf?, M?, Kn?, Gs?, E?, Mks?, R3, A3),
    relays_app(R2?, R3?, R23),
    both_yes(A2?, A3?, A23),
    relays_join(R1?, R23?, A23?, R, A).

% --- over the introductory acts ------------------------------------------

procedure try_intros2(Ans?, Constant?, Preds?, Preds?, Guardianships?, Relays?, Contract?,
                      Contract?, Preds?, Wards).
try_intros2(yes, Nm, M, Kn, Gs, Rs, _, _, _, introduction_with_wards(Nm?, M?, Gs?, Rs?, Kn?)).
try_intros2(no, _, M, Kn, Gs, _, Ss, C, Rf, W?) :-
    ground(M?), ground(Kn?), ground(Gs?), ground(Ss?), ground(C?), ground(Rf?) |
    try_intros(Ss?, C?, Rf?, M?, Kn?, Gs?, W).

% --- clause 2 of def:sg-wards ----------------------------------------------
% No listed role of a schema of C adds or deletes a mark in M, a leaving mark
% of C, an atom of the predicate e the introductory act adds, or an atom of g
% or of w for the guardianship of a mark in M (CSSN's paper, def:sg-wards);
% Ps holds those predicates.  GSC 7e00aba has no leaving marks, and GSC
% 070c5d1 no g and no w in a guardianship, so Ps is M and e.
% A contract of Section 3 has no listed role.

procedure atoms_avoid1(Ans?, Atoms?, Preds?, Ans).
atoms_avoid1(yes, _, _, no).
atoms_avoid1(no, Xs, Ps, R?) :- ground(Xs?), ground(Ps?) | atoms_avoid(Xs?, Ps?, R).

procedure atoms_avoid(Atoms?, Preds?, Ans).
atoms_avoid([], _, yes).
atoms_avoid([atom(Q, _)|Xs], Ps, R?) :- ground(Q?), ground(Xs?), ground(Ps?) |
    pred_member(Q?, Ps?, A),
    atoms_avoid1(A?, Xs?, Ps?, R).

procedure role_listed_avoid(Ans?, RoleSpec?, Preds?, Ans).
role_listed_avoid(yes, _, _, yes).
role_listed_avoid(no, RS, Ps, R?) :- ground(RS?), ground(Ps?) |
    rs_add(RS?, Add),
    rs_del(RS?, Del),
    atoms_app(Add?, Del?, AD),
    atoms_avoid(AD?, Ps?, R).

procedure roles_listed_avoid1(Ans?, RoleSpecs?, Preds?, Ans).
roles_listed_avoid1(no, _, _, no).
roles_listed_avoid1(yes, Rs, Ps, R?) :- ground(Rs?), ground(Ps?) | roles_listed_avoid(Rs?, Ps?, R).

procedure roles_listed_avoid(RoleSpecs?, Preds?, Ans).
roles_listed_avoid([], _, yes).
roles_listed_avoid([RS|Rs], Ps, R?) :- ground(RS?), ground(Rs?), ground(Ps?) |
    is_party_role(RS?, P),
    role_listed_avoid(P?, RS?, Ps?, A),
    roles_listed_avoid1(A?, Rs?, Ps?, R).

procedure listed_avoid1(Ans?, Contract?, Preds?, Ans).
listed_avoid1(no, _, _, no).
listed_avoid1(yes, Ss, Ps, R?) :- ground(Ss?), ground(Ps?) | listed_avoid(Ss?, Ps?, R).

procedure listed_avoid(Contract?, Preds?, Ans).
listed_avoid([], _, yes).
listed_avoid([S|Ss], Ps, R?) :- ground(S?), ground(Ss?), ground(Ps?) |
    sch_roles(S?, Rs),
    roles_listed_avoid(Rs?, Ps?, A),
    listed_avoid1(A?, Ss?, Ps?, R).

procedure listed_clear(Contract?, Preds?, Preds?, Constant?, Guardianships?, Ans).
listed_clear(C, M, Kn, E, Gs, R?) :- ground(C?), ground(M?), ground(Kn?), ground(E?), ground(Gs?) |
    preds_app(M?, [E?], Ps),
    listed_avoid(C?, Ps?, R).

procedure try_intros1(IntroE?, Contract?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Wards).
try_intros1(no_intro, Ss, C, Rf, M, Kn, Gs, W?) :-
    ground(Ss?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?) |
    try_intros(Ss?, C?, Rf?, M?, Kn?, Gs?, W).
try_intros1(intro(Nm, E), Ss, C, Rf, M, Kn, Gs, W?) :-
    ground(Nm?), ground(E?), ground(Ss?), ground(C?), ground(Rf?), ground(M?), ground(Kn?),
    ground(Gs?) |
    active_marks(C?, M?, Mn),
    relays_for(C?, Rf?, M?, Kn?, Gs?, E?, Mn?, Rs, A1),
    listed_clear(C?, M?, Kn?, E?, Gs?, A2),
    both_yes(A1?, A2?, A),
    try_intros2(A?, Nm?, M?, Kn?, Gs?, Rs?, Ss?, C?, Rf?, W).

procedure try_intros(Contract?, Contract?, Preds?, Preds?, Preds?, Guardianships?, Wards).
try_intros([], _, _, _, _, _, no_introduction_with_wards).
try_intros([S|Ss], C, Rf, M, Kn, Gs, W?) :-
    ground(S?), ground(Ss?), ground(C?), ground(Rf?), ground(M?), ground(Kn?), ground(Gs?) |
    intro_marks(C?, Rf?, M?, Kn?, S?, I),
    try_intros1(I?, Ss?, C?, Rf?, M?, Kn?, Gs?, W).

% --- over the guardianships chosen, one per mark --------------------------

procedure cands_lists(Contract?, Preds?, Constant?, Preds?, GuardLists).
cands_lists(_, _, _, [], []).
cands_lists(C, AF, F, [Mk|Mks], [G?|R?]) :-
    ground(C?), ground(AF?), ground(F?), ground(Mk?), ground(Mks?) |
    cands_for(C?, AF?, F?, Mk?, G),
    cands_lists(C?, AF?, F?, Mks?, R).

% The combinations: one guardianship per mark, in the order of M.
procedure prepend_each(Guardianship?, GuardLists?, GuardLists?, GuardLists).
prepend_each(_, [], T, T?).
prepend_each(G, [Cb|Cbs], T, [[G?|Cb?]|R?]) :- ground(G?), ground(Cbs?), ground(T?) |
    prepend_each(G?, Cbs?, T?, R).

procedure prepend_all(Guardianships?, GuardLists?, GuardLists).
prepend_all([], _, []).
prepend_all([G|Gs], Cbs, R?) :- ground(G?), ground(Gs?), ground(Cbs?) |
    prepend_all(Gs?, Cbs?, R1),
    prepend_each(G?, Cbs?, R1?, R).

procedure combos(GuardLists?, GuardLists).
combos([], [[]]).
combos([L|Ls], R?) :- ground(L?), ground(Ls?) |
    combos(Ls?, Cbs),
    prepend_all(L?, Cbs?, R).

procedure try_combos1(Wards?, GuardLists?, Contract?, Preds?, Preds?, Preds?, Wards).
try_combos1(introduction_with_wards(Nm, M, Gs, Rs, K), _, _, _, _, _,
            introduction_with_wards(Nm?, M?, Gs?, Rs?, K?)).
try_combos1(no_introduction_with_wards, Cbs, C, Rf, M, K, W?) :-
    ground(Cbs?), ground(C?), ground(Rf?), ground(M?), ground(K?) |
    try_combos(Cbs?, C?, Rf?, M?, K?, W).

% Each choice Gs of a guardianship per mark with which C has guardianships
% (guards_ok_k) is tried, K being [iota, f].
procedure try_combos(GuardLists?, Contract?, Preds?, Preds?, Preds?, Wards).
try_combos([], _, _, _, _, no_introduction_with_wards).
try_combos([Gs|Cbs], C, Rf, M, K, W?) :-
    ground(Gs?), ground(Cbs?), ground(C?), ground(Rf?), ground(M?), ground(K?) |
    guards_ok_k(C?, K?, Gs?, A),
    try_combo(A?, Gs?, C?, Rf?, M?, K?, W1),
    try_combos1(W1?, Cbs?, C?, Rf?, M?, K?, W).

procedure try_combo(Ans?, Guardianships?, Contract?, Preds?, Preds?, Preds?, Wards).
try_combo(no, _, _, _, _, _, no_introduction_with_wards).
try_combo(yes, Gs, C, Rf, M, K, W?) :-
    ground(Gs?), ground(C?), ground(Rf?), ground(M?), ground(K?) |
    try_intros(C?, C?, Rf?, M?, K?, Gs?, W).

% --- over the sets of marks, for the kinds (iota, f, M) ---------------------

procedure try_set1(Ans?, Preds?, PredSets?, Contract?, Preds?, Preds?, Constant?, Constant?,
                   Wards).
try_set1(no, _, Ms, C, Rf, AF, Io, F, W?) :-
    ground(Ms?), ground(C?), ground(Rf?), ground(AF?), ground(Io?), ground(F?) |
    try_sets(Ms?, C?, Rf?, AF?, Io?, F?, W).
try_set1(yes, M, Ms, C, Rf, AF, Io, F, W?) :-
    ground(M?), ground(Ms?), ground(C?), ground(Rf?), ground(AF?), ground(Io?),
    ground(F?) |
    cands_lists(C?, AF?, F?, M?, Ls),
    combos(Ls?, Cbs),
    try_combos(Cbs?, C?, Rf?, M?, [Io?, F?], W1),
    try_set2(W1?, Ms?, C?, Rf?, AF?, Io?, F?, W).

procedure try_set2(Wards?, PredSets?, Contract?, Preds?, Preds?, Constant?, Constant?, Wards).
try_set2(introduction_with_wards(Nm, M, Gs, Rs, K), _, _, _, _, _, _,
         introduction_with_wards(Nm?, M?, Gs?, Rs?, K?)).
try_set2(no_introduction_with_wards, Ms, C, Rf, AF, Io, F, W?) :-
    ground(Ms?), ground(C?), ground(Rf?), ground(AF?), ground(Io?), ground(F?) |
    try_sets(Ms?, C?, Rf?, AF?, Io?, F?, W).

% Each set M meeting clauses 2 and 3 of def:kinds (kinds_schemas), clauses 1
% and 4 holding for Io and F (kinds_base, try_fs).
procedure try_sets(PredSets?, Contract?, Preds?, Preds?, Constant?, Constant?, Wards).
try_sets([], _, _, _, _, _, no_introduction_with_wards).
try_sets([M|Ms], C, Rf, AF, Io, F, W?) :-
    ground(M?), ground(Ms?), ground(C?), ground(Rf?), ground(AF?), ground(Io?),
    ground(F?) |
    kinds_schemas(C?, Io?, F?, M?, A),
    try_set1(A?, M?, Ms?, C?, Rf?, AF?, Io?, F?, W).

% The nonempty subsets of a list of marks, those holding its first mark
% first.
procedure prepend_mark(Constant?, PredSets?, PredSets?, PredSets).
prepend_mark(_, [], T, T?).
prepend_mark(P, [S|Ss], T, [[P?|S?]|R?]) :- ground(Ss?), ground(T?) |
    prepend_mark(P?, Ss?, T?, R).

procedure subsets1(PredSets?, Constant?, PredSets).
subsets1(Ss, P, R?) :- ground(Ss?), ground(P?) |
    prepend_mark(P?, Ss?, Ss?, R).

procedure subsets(Preds?, PredSets).
subsets([], [[]]).
subsets([P|Ps], R?) :- ground(P?), ground(Ps?) |
    subsets(Ps?, Ss),
    subsets1(Ss?, P?, R).

procedure nonempty_sets(PredSets?, PredSets).
nonempty_sets([], []).
nonempty_sets([[]|Ss], R?) :- ground(Ss?) | nonempty_sets(Ss?, R).
nonempty_sets([[P|Ps]|Ss], [[P?|Ps?]|R?]) :- ground(Ss?) | nonempty_sets(Ss?, R).

% The marks with a guardianship candidate on their own, for the mark f F.
procedure marks_with_cands1(Guardianships?, Constant?, Preds?, Contract?, Preds?, Constant?,
                            Preds).
marks_with_cands1([], _, Ms, C, AF, F, R?) :-
    ground(Ms?), ground(C?), ground(AF?), ground(F?) |
    marks_with_cands(Ms?, C?, AF?, F?, R).
marks_with_cands1([_|_], Mk, Ms, C, AF, F, [Mk?|R?]) :-
    ground(Ms?), ground(C?), ground(AF?), ground(F?) |
    marks_with_cands(Ms?, C?, AF?, F?, R).

procedure marks_with_cands(Preds?, Contract?, Preds?, Constant?, Preds).
marks_with_cands([], _, _, _, []).
marks_with_cands([Mk|Ms], C, AF, F, R?) :-
    ground(Mk?), ground(Ms?), ground(C?), ground(AF?), ground(F?) |
    cands_for(C?, AF?, F?, Mk?, Gs),
    marks_with_cands1(Gs?, Mk?, Ms?, C?, AF?, F?, R).

% --- over the kinds' iota and f ----------------------------------------------
% The pairs (iota, f) of distinct marks of C, iota running over its marks in
% their order and f within it, meeting clauses 1 and 4 of def:kinds
% (kinds_base); for each, the nonempty sets M of the other marks having
% guardianship candidates.

procedure try_f(Ans?, Constant?, Constant?, Preds?, Contract?, Preds?, Preds?, Wards).
try_f(no, _, _, _, _, _, _, no_introduction_with_wards).
try_f(yes, Io, F, Marks, C, Rf, AF, W?) :-
    ground(Io?), ground(F?), ground(Marks?), ground(C?), ground(Rf?),
    ground(AF?) |
    preds_diff(Marks?, [Io?, F?], Rest),
    marks_with_cands(Rest?, C?, AF?, F?, MC),
    subsets(MC?, Ss),
    nonempty_sets(Ss?, Sets),
    try_sets(Sets?, C?, Rf?, AF?, Io?, F?, W).

procedure try_fs1(Wards?, Preds?, Constant?, Preds?, Contract?, Preds?, Preds?, Wards).
try_fs1(introduction_with_wards(Nm, M, Gs, Rs, K), _, _, _, _, _, _,
        introduction_with_wards(Nm?, M?, Gs?, Rs?, K?)).
try_fs1(no_introduction_with_wards, Fs, Io, Marks, C, Rf, AF, W?) :-
    ground(Fs?), ground(Io?), ground(Marks?), ground(C?), ground(Rf?),
    ground(AF?) |
    try_fs(Fs?, Io?, Marks?, C?, Rf?, AF?, W).

procedure try_fs(Preds?, Constant?, Preds?, Contract?, Preds?, Preds?, Wards).
try_fs([], _, _, _, _, _, no_introduction_with_wards).
try_fs([F|Fs], Io, Marks, C, Rf, AF, W?) :-
    ground(F?), ground(Fs?), ground(Io?), ground(Marks?), ground(C?), ground(Rf?),
    ground(AF?) |
    kinds_base(C?, Io?, F?, A),
    try_f(A?, Io?, F?, Marks?, C?, Rf?, AF?, W1),
    try_fs1(W1?, Fs?, Io?, Marks?, C?, Rf?, AF?, W).

procedure try_ios1(Wards?, Preds?, Preds?, Contract?, Preds?, Preds?, Wards).
try_ios1(introduction_with_wards(Nm, M, Gs, Rs, K), _, _, _, _, _,
         introduction_with_wards(Nm?, M?, Gs?, Rs?, K?)).
try_ios1(no_introduction_with_wards, Is, Marks, C, Rf, AF, W?) :-
    ground(Is?), ground(Marks?), ground(C?), ground(Rf?), ground(AF?) |
    try_ios(Is?, Marks?, C?, Rf?, AF?, W).

procedure try_ios(Preds?, Preds?, Contract?, Preds?, Preds?, Wards).
try_ios([], _, _, _, _, no_introduction_with_wards).
try_ios([Io|Is], Marks, C, Rf, AF, W?) :-
    ground(Io?), ground(Is?), ground(Marks?), ground(C?), ground(Rf?),
    ground(AF?) |
    try_fs(Marks?, Io?, Marks?, C?, Rf?, AF?, W1),
    try_ios1(W1?, Is?, Marks?, C?, Rf?, AF?, W).

% wards(C, Rf, W): the introduction with wards of C, Rf being the predicates
% it declares reflexive, or that it has none (def:introduction-wards).
procedure wards1(Preds?, Contract?, Preds?, Wards).
wards1(Marks, C, Rf, W?) :- ground(Marks?), ground(C?), ground(Rf?) |
    preds_agent_first(C?, AF),
    try_ios(Marks?, Marks?, C?, Rf?, AF?, W).

exported procedure wards(Contract?, Preds?, Wards).
wards(C, Rf, W?) :- ground(C?), ground(Rf?) |
    preds_of_arity(C?, 0, Marks),
    wards1(Marks?, C?, Rf?, W).

% ---------------------------------------------------------------------------
% The atoms of h (def:relay, clause 2; GSC 410a440)
% ---------------------------------------------------------------------------
% For the introduction with wards found, every atom a relay act of it requires at a ward role that clause 2 of def:relay admits as an atom of a predicate h and as nothing else, h(Schema, Role, H), in the order of the relay acts and of their roles; none where there is no introduction with wards.

procedure schema_named1(Constant?, Constant?, Schema?, Contract?, FoundS).
schema_named1(N, Nm, S, _, found(S?)) :- N? =?= Nm? | true.
schema_named1(_, Nm, _, Ss, R?) :- otherwise, ground(Nm?), ground(Ss?) | schema_named(Ss?, Nm?, R).

procedure schema_named(Contract?, Constant?, FoundS).
schema_named([], _, not_found).
schema_named([S|Ss], Nm, R?) :- ground(S?), ground(Ss?), ground(Nm?) |
    sch_name(S?, N),
    schema_named1(N?, Nm?, S?, Ss?, R).

% The predicate e of the introductory act, the one atom it adds at each role.
procedure first_pred(Preds?, Constant).
first_pred([P|_], P?).
first_pred([], none).

procedure intro_e2(RoleSpecs?, Constant).
intro_e2([RS1, RS2], E?) :- ground(RS1?), ground(RS2?) |
    rs_add(RS1?, P1),
    rs_add(RS2?, P2),
    one_atom_e(P1?, P2?, Es),
    first_pred(Es?, E).
intro_e2(Rs, none) :- otherwise, ground(Rs?) | true.

procedure intro_e1(FoundS?, Constant).
intro_e1(found(S), E?) :- ground(S?) | sch_roles(S?, Rs), intro_e2(Rs?, E).
intro_e1(not_found, none).

procedure hs_app(RelayHs?, RelayHs?, RelayHs).
hs_app([], T, T?).
hs_app([X|Xs], T, [X?|R?]) :- hs_app(Xs?, T?, R).

procedure atom_h(Ans?, Constant?, Integer?, Atom?, RelayHs).
atom_h(yes, Sn, X, atom(H, _), [h(Sn?, X?, H?)]).
atom_h(no, _, _, _, []).

procedure atoms_h(Atoms?, Integer?, RK?, Constant?, Contract?, Preds?, Preds?, Constant?,
                  Guardianships?, RKs?, Party?, Party?, RoleSpecs?, RelayHs).
atoms_h([], _, _, _, _, _, _, _, _, _, _, _, _, []).
atoms_h([Phi|Phis], X, KX, Sn, C, Rf, Kn, E, Gs, RKs, P1, P2, Sr, R?) :-
    ground(Phi?), ground(Phis?), integer(X?), ground(KX?), ground(Sn?), ground(C?), ground(Rf?),
    ground(Kn?), ground(E?), ground(Gs?), ground(RKs?), ground(P1?), ground(P2?), ground(Sr?) |
    req_atom_other(Phi?, X?, KX?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, A1),
    req_h_ok(KX?, Phi?, X?, Sr?, C?, Gs?, A2),
    flip(A1?, N1),
    both_yes(N1?, A2?, A),
    atom_h(A?, Sn?, X?, Phi?, H1),
    atoms_h(Phis?, X?, KX?, Sn?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, H2),
    hs_app(H1?, H2?, R).

procedure roles_h(RoleSpecs?, Integer?, Constant?, RKs?, Contract?, Preds?, Preds?, Constant?,
                  Guardianships?, Party?, Party?, RoleSpecs?, RelayHs).
roles_h([], _, _, _, _, _, _, _, _, _, _, _, []).
roles_h([RS|Rs], X, Sn, RKs, C, Rf, Kn, E, Gs, P1, P2, Sr, R?) :-
    ground(RS?), ground(Rs?), integer(X?), ground(Sn?), ground(RKs?), ground(C?), ground(Rf?),
    ground(Kn?), ground(E?), ground(Gs?), ground(P1?), ground(P2?), ground(Sr?) |
    nth_rk(RKs?, X?, KX),
    rs_req(RS?, Req),
    atoms_h(Req?, X?, KX?, Sn?, C?, Rf?, Kn?, E?, Gs?, RKs?, P1?, P2?, Sr?, H1),
    X1 := X? + 1,
    roles_h(Rs?, X1?, Sn?, RKs?, C?, Rf?, Kn?, E?, Gs?, P1?, P2?, Sr?, H2),
    hs_app(H1?, H2?, R).

procedure relay_h_in(FoundS?, Constant?, Party?, Party?, Contract?, Preds?, Preds?, Constant?,
                     Guardianships?, RelayHs).
relay_h_in(not_found, _, _, _, _, _, _, _, _, []).
relay_h_in(found(Sc), Sn, P1, P2, C, Rf, Kn, E, Gs, R?) :-
    ground(Sc?), ground(Sn?), ground(P1?), ground(P2?), ground(C?), ground(Rf?), ground(Kn?),
    ground(E?), ground(Gs?) |
    sch_roles(Sc?, Rs),
    relay_h_in1(Rs?, Sn?, P1?, P2?, C?, Rf?, Kn?, E?, Gs?, R).

procedure relay_h_in1(RoleSpecs?, Constant?, Party?, Party?, Contract?, Preds?, Preds?, Constant?,
                      Guardianships?, RelayHs).
relay_h_in1(Rs, Sn, P1, P2, C, Rf, Kn, E, Gs, R?) :-
    ground(Rs?), ground(Sn?), ground(P1?), ground(P2?), ground(C?), ground(Rf?), ground(Kn?),
    ground(E?), ground(Gs?) |
    roles_len(Rs?, K),
    party_sigma(P1?, S1),
    party_sigma(P2?, S2),
    ints_app(S1?, S2?, Sigmas),
    role_kinds(1, K?, P1?, P2?, Sigmas?, RKs),
    roles_h(Rs?, 1, Sn?, RKs?, C?, Rf?, Kn?, E?, Gs?, P1?, P2?, Rs?, R).

procedure relays_h(Relays?, Contract?, Preds?, Preds?, Constant?, Guardianships?, RelayHs).
relays_h([], _, _, _, _, _, []).
relays_h([relay(Sn, P1, P2)|Xs], C, Rf, Kn, E, Gs, R?) :-
    ground(Sn?), ground(P1?), ground(P2?), ground(Xs?), ground(C?), ground(Rf?), ground(Kn?),
    ground(E?), ground(Gs?) |
    schema_named(C?, Sn?, F),
    relay_h_in(F?, Sn?, P1?, P2?, C?, Rf?, Kn?, E?, Gs?, H1),
    relays_h(Xs?, C?, Rf?, Kn?, E?, Gs?, H2),
    hs_app(H1?, H2?, R).

exported procedure relay_h_for(Contract?, Preds?, Wards?, RelayHs).
relay_h_for(_, _, no_introduction_with_wards, []).
relay_h_for(C, Rf, introduction_with_wards(Nm, _, Gs, Rs, Kn), R?) :-
    ground(C?), ground(Rf?), ground(Nm?), ground(Gs?), ground(Rs?), ground(Kn?) |
    schema_named(C?, Nm?, F),
    intro_e1(F?, E),
    relays_h(Rs?, C?, Rf?, Kn?, E?, Gs?, R).
