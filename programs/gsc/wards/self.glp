% ---------------------------------------------------------------------------
% The condition on a contract with wards, GAI's (Coordination Appendix B;
% Udi, 2026-10-20): GSC's Section 8, "Contracts with Wards", /Grassroots/GSC,
% sections/07c-wards.tex at GSC 070c5d1, and def:sg-wards of CSSN's paper.  This directory is a
% child of the checker, programs/gsc, so that the checker's modules may call
% it, a cross-module qualifier naming a child directory of the caller's
% directory (TGLP, Section "Module System", "Cross-module type checking"),
% and so that wards.glp sees the representation of a contract and the
% matching machinery of programs/gsc/self.glp, its ancestor scope.  This
% file is the directory's interface: it exports the procedures check.glp
% calls, each forwarded to wards.glp (TGLP, "External access").
% ---------------------------------------------------------------------------

imported procedure wards#wards(Contract?, Preds?, Wards).
exported procedure wards(Contract?, Preds?, Wards).
wards(C, Rf, W?) :- wards # wards(C?, Rf?, W).

imported procedure wards#guardianships_for(Contract?, Preds?, Preds?, Guardianships).
exported procedure guardianships_for(Contract?, Preds?, Preds?, Guardianships).
guardianships_for(C, K, M, G?) :- wards # guardianships_for(C?, K?, M?, G).

imported procedure wards#relay_h_for(Contract?, Preds?, Wards?, RelayHs).
exported procedure relay_h_for(Contract?, Preds?, Wards?, RelayHs).
relay_h_for(C, Rf, W, H?) :- wards # relay_h_for(C?, Rf?, W?, H).
