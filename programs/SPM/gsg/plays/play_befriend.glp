%% gsg/plays/play_befriend.glp -- two-agent offer/accept handshake.
%%
%% Alice wills: discover bob, then offer_friendship(bob).
%% Bob does no volitional action; he reactively accepts the friend_request.
%%
%% Expected at quiescence:
%%   alice's FMap has fme(bob, 1)
%%   bob's FMap has fme(alice, 1)

-module(play_befriend).

%% Cross-module calls.  Types from gsg/self.glp visible via ancestor scoping.

imported procedure gsg_agent # agent(Agent?, IdentityRecord?,
                                      Stream(UserEvent(GsgVolition, GsgQuery, GsgAnswer))?,
                                      Stream(InMsg(GsgCargo))?,
                                      Stream(NetMsg(GsgCargo)),
                                      Integer?,
                                      GsgPlatform?).

imported procedure cva # network(NetEndList(GsgCargo)?).

%% NetEndList for GsgCargo — redefined locally since cva/'s types aren't
%% visible across sibling directories.
NetEnd(C) ::= net_end(Agent, Stream(NetMsg(C)), Stream(InMsg(C))?).
NetEndList(C) ::= [] ; [NetEnd(C) | NetEndList(C)].

exported procedure play_befriend(Integer, Integer).

play_befriend(AliceFinalEpoch?, BobFinalEpoch?) :-
    %% Phase 1 limitation: queries fire before NetIn round-trip, so AliceFinalEpoch
    %% and BobFinalEpoch will be 0 (the pre-protocol value).  Verify protocol
    %% success via REPL `:trace` mode: look for set_epoch(alice, 1, [], ...) at
    %% bob and set_epoch(bob, 1, [], ...) at alice in the trace output.
    %% Final outcome: → suspended (no clean termination signal).
    gsg_agent # agent(alice, ir([], 51),
          [will(discover(bob)), will(offer_friendship(bob)),
           query(q_epoch(bob), a_epoch(AliceFinalEpoch?))],
          AliceIn?, AliceOut, 0,
          gsg([], [], [], [], [])),
    gsg_agent # agent(bob, ir([], 51),
          [query(q_epoch(alice), a_epoch(BobFinalEpoch?))],
          BobIn?, BobOut, 0,
          gsg([], [], [], [], [])),
    cva # network([net_end(alice, AliceOut?, AliceIn),
                   net_end(bob,   BobOut?,   BobIn)]).
