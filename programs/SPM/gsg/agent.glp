%% gsg/agent.glp -- GSG agent process: input absorption + CVA transactions.
%%
%% PASS 1 scope (architecture §3.3 reply-variable sync, offerer side):
%%   - Each `will(V)` carries a Reply Constant the agent binds to `ok`
%%     when V's CVA transaction has completed end-to-end.
%%   - For offerer-side round-trip (offer_friendship): the agent emits
%%     friend_request and installs a `pending_offer(Q, X, R)` in the
%%     Platform's Pending field; R is bound only when Integrate accept
%%     fires on a matching `accept(X)` from Q.
%%   - For one-shot local transactions (discover, end_friendship): the
%%     agent binds Reply at absorption via the head-literal trick.
%%   - `await(R)` UserIn event: pure synchroniser; suspends UserIn
%%     consumption until R is ground.
%%
%% PASS 1 limitations (to revisit):
%%   - Accept offer is reactive on NetIn head (paper §6.3 says volitional).
%%     Made volitional in PASS 2, which introduces a real Inbox.
%%   - Resolve simultaneous offer not implemented (paper §6.3, PASS 3).
%%   - Q ∈ Known check on Offer friendship still absent (responsibility
%%     of test play to discover before offering).
%%   - Integer parity not asserted at agent level; accepted as-is.

-module(gsg_agent).

%% =============================================================================
%% AGENT (paper §5: CVA agent process)
%% =============================================================================

exported procedure agent(Agent?, IdentityRecord?,
                          Stream(UserEvent(GsgVolition, GsgQuery, GsgAnswer))?,
                          Stream(InMsg(GsgCargo))?,
                          Stream(NetMsg(GsgCargo)),
                          Integer?,
                          GsgPlatform?).

%% Termination: configuration is final when both input streams are closed.
agent(_, _, [], [], [], _, _).

%% Shutdown (PASS 1 test-harness event): closes NetOut.  Implementation
%% hack to break agent ↔ network mutual-wait deadlock.
agent(_, _, [shutdown | _], _, [], _, _).

%% =============================================================================
%% USERIN ABSORPTION
%% =============================================================================

%% await(R) synchroniser (architecture §3.3): suspend UserIn until R is
%% bound by a prior protocol completion (e.g. Integrate accept binding
%% the matching pending_offer's Reply slot via bind_ok).  R appears as
%% writer in head (Constant at ↓) and as reader in guard `ground(R?)`
%% (guard occurrences don't count toward SRSW per §3.4); Constant
%% relaxation §3.1 covers the remaining count.
agent(Id, IRec, [await(R) | UserIn], NetIn, NetOut?, Date, Platform) :-
    ground(R?) |
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?, Platform?).

%% Discover (paper §5.2): add Q to Known, bind Reply via bind_ok helper.
%% R appears as writer R in head (Constant at ↓ → writer) and as writer R
%% in body call to bind_ok (Constant at ↓ → writer); Constant relaxation
%% §3.1 permits the multi-writer occurrence.
agent(Id, IRec, [will(discover(Q, R)) | UserIn], NetIn, NetOut?, Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(Q?) |
    add_known(Q?, Known?, Known1),
    bind_ok(R),
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?,
          gsg(Known1?, Vols?, Inbox?, FMap?, FoFMap?, Pending?)).

%% Offer friendship (paper §6.3): emit friend_request(epoch_p(Q)+1) to Q,
%% install pending_offer(Q, X, R) in Pending.  Reply R is NOT bound here;
%% Integrate accept binds it on receipt of accept(X) from Q.
%%
%% R is a Constant: writer in head; reader R? stored inside pending_offer
%% (recursive agent call's Pending field).  Multi-occurrence allowed by
%% Constant relaxation §3.1.
agent(Id, IRec, [will(offer_friendship(Q, R)) | UserIn], NetIn,
      [msg(Id?, Q?, friend_request(X?)) | NetOut1?], Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(Q?), ground(Id?), ground(FMap?) |
    epoch_of(Q?, FMap?, E),
    X := E? + 1,
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut1, Date?,
          gsg(Known?, Vols?, Inbox?, FMap?, FoFMap?,
              [pending_offer(Q?, X?, R?) | Pending?])).

%% End friendship (paper §6.4): bump epoch to next even, emit unfriend,
%% bind Reply via bind_ok (local transaction, no round-trip).
agent(Id, IRec, [will(end_friendship(Q, R)) | UserIn], NetIn,
      [msg(Id?, Q?, unfriend(X?)) | NetOut1?], Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(Q?), ground(Id?) |
    bump_epoch(Q?, FMap?, FMap1, X),
    bind_ok(R),
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut1, Date?,
          gsg(Known?, Vols?, Inbox?, FMap1?, FoFMap?, Pending?)).

%% Accept offer (paper §6.3, volitional): body-dispatch on whether Inbox
%% already has a matching friend_request from P.  If yes: fire (bind R via
%% bind_ok in the step's `true` branch).  If no: store accept_offer(P, R)
%% in Vols; will fire later when the matching friend_request arrives via
%% NetIn absorption.  R is the writer the person will see bound on
%% completion (via subsequent `await(R?)`).
agent(Id, IRec, [will(accept_offer(P, R)) | UserIn], NetIn, NetOut?, Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(P?), ground(Id?) |
    try_take_friend_request_from(P?, Inbox?, Inbox1, Matched, X),
    accept_offer_step(Matched?, Id?, IRec?, P?, R, X?, UserIn?, NetIn?,
                      NetOut, Date?, Known?, Vols?, Inbox1?, FMap?, FoFMap?, Pending?).

%% Tick (architecture §2.3): advance local date.
agent(Id, IRec, [tick | UserIn], NetIn, NetOut?, Date, Platform) :-
    Date1 := Date? + 1 |
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date1?, Platform?).

%% Query: q_epoch(Q) -- answer with epoch_p(Q).
agent(Id, IRec, [query(q_epoch(Q), a_epoch(E)) | UserIn], NetIn, NetOut?, Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(Q?), ground(FMap?) |
    epoch_of(Q?, FMap?, E),
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?,
          gsg(Known?, Vols?, Inbox?, FMap?, FoFMap?, Pending?)).

%% Catch-all for unmatched UserIn events: drop and continue.
agent(Id, IRec, [_ | UserIn], NetIn, NetOut?, Date, Platform) :-
    otherwise | agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?, Platform?).

%% =============================================================================
%% NETIN ABSORPTION (reactive Phase 1; PASS 2 moves to Inbox absorb-then-fire)
%% =============================================================================

%% Friend request received (paper §6.3 Accept offer, PASS 2 -- volitional):
%% body-dispatch on whether Vols already has matching accept_offer(P, R).
%% If yes: fire Accept offer (set_epoch, emit accept, broadcast, snapshot,
%% bind R via bind_ok inside try_take_accept_offer_vol).  If no: stash msg
%% in Inbox; will fire later when the person wills accept_offer(P, _).
agent(Id, IRec, UserIn, [msg(P, friend_request(X)) | NetIn], NetOut?, Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(P?), ground(X?), ground(Id?) |
    try_take_accept_offer_vol(P?, Vols?, Vols1, Matched),
    friend_request_step(Matched?, Id?, IRec?, P?, X?, UserIn?, NetIn?,
                        NetOut, Date?, Known?, Vols1?, Inbox?, FMap?, FoFMap?, Pending?).

%% Accept received (paper §6.3 Integrate accept): set_epoch + broadcast +
%% snapshot.  take_pending_offer binds the matching pending offer's Reply
%% to `ok` (releasing any awaiting query); for stale/duplicate accepts
%% with no pending offer, take_pending_offer returns Pending unchanged
%% (R remains unbound, which is the correct semantics -- no one is
%% waiting on it).
%%
%% PASS 1 simplification: paper §6.3 precondition `epoch_p(q) < x` is
%% not enforced; stale accepts still trigger broadcast/snapshot.  PASS 2
%% adds the precondition check.
agent(Id, IRec, UserIn, [msg(P, accept(X)) | NetIn], NetOut?, Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(P?), ground(X?), ground(Id?) |
    take_pending_offer(P?, X?, Pending?, Pending1),
    set_epoch(P?, X?, FMap?, FMap1),
    activate(Id?, IRec?, P?, X?, UserIn?, NetIn?,
             NetOut, Date?, Known?, Vols?, Inbox?, FMap1?, FoFMap?, Pending1?).

%% Unfriend received (paper §6.4): record FMap[P] := X.  Pass Pending through.
agent(Id, IRec, UserIn, [msg(P, unfriend(X)) | NetIn], NetOut?, Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(P?), ground(X?) |
    set_epoch(P?, X?, FMap?, FMap1),
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?,
          gsg(Known?, Vols?, Inbox?, FMap1?, FoFMap?, Pending?)).

%% Stream update received (paper §6.5): record FoFMap[P][F] := X
%% and symmetric mirror FoFMap[F][P] := X.  Pass Pending through.
agent(Id, IRec, UserIn, [msg(P, stream_update(F, X)) | NetIn], NetOut?, Date,
      gsg(Known, Vols, Inbox, FMap, FoFMap, Pending)) :-
    ground(P?), ground(F?), ground(X?) |
    set_fof_epoch(P?, F?, X?, FoFMap?, FoFMap1),
    set_fof_epoch(F?, P?, X?, FoFMap1?, FoFMap2),
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?,
          gsg(Known?, Vols?, Inbox?, FMap?, FoFMap2?, Pending?)).

%% Catch-all for unmatched NetIn messages.
agent(Id, IRec, UserIn, [_ | NetIn], NetOut?, Date, Platform) :-
    otherwise | agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?, Platform?).

%% =============================================================================
%% ACTIVATE: helper run on each Befriend activation (Accept offer, Resolve
%% simultaneous offer, Integrate accept).  Broadcasts stream_update(P, X) to
%% all existing friends and sends snapshot to the new friend P, then
%% recurses into agent/7 with the threaded NetOut continuation.
%% =============================================================================

exported procedure activate(Agent?, IdentityRecord?, Agent?, Integer?,
                             Stream(UserEvent(GsgVolition, GsgQuery, GsgAnswer))?,
                             Stream(InMsg(GsgCargo))?,
                             Stream(NetMsg(GsgCargo)),
                             Integer?,
                             Stream(Agent)?, Stream(GsgVolition)?,
                             Stream(InMsg(GsgCargo))?,
                             FMap?, FoFMap?, PendingList?).

activate(Id, IRec, P, X, UserIn, NetIn, NetOut?, Date,
         Known, Vols, Inbox, FMap, FoFMap, Pending) :-
    ground(FMap?) |
    broadcast_update(Id?, P?, X?, FMap?, NetOut, NetOut1?),
    send_snapshot(Id?, P?, FMap?, NetOut1, NetOut2?),
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut2, Date?,
          gsg(Known?, Vols?, Inbox?, FMap?, FoFMap?, Pending?)).

%% =============================================================================
%% PASS 2 step procedures: 2-clause dispatchers on Matched (true/false).
%%
%% friend_request_step: called from NetIn friend_request absorption.
%%   true  -> fire Accept offer (volition already in Vols, bound by
%%            try_take_accept_offer_vol; here we emit accept(X), set_epoch,
%%            broadcast, snapshot).
%%   false -> stash msg in Inbox; wait for person to will accept_offer.
%% =============================================================================

exported procedure friend_request_step(Constant?, Agent?, IdentityRecord?,
                                         Agent?, Integer?,
                                         Stream(UserEvent(GsgVolition, GsgQuery, GsgAnswer))?,
                                         Stream(InMsg(GsgCargo))?,
                                         Stream(NetMsg(GsgCargo)),
                                         Integer?,
                                         Stream(Agent)?, Stream(GsgVolition)?,
                                         Stream(InMsg(GsgCargo))?,
                                         FMap?, FoFMap?, PendingList?).

friend_request_step(true, Id, IRec, P, X, UserIn, NetIn,
                    [msg(Id?, P?, accept(X?)) | NetOut1?], Date,
                    Known, Vols, Inbox, FMap, FoFMap, Pending) :-
    ground(X?) |
    set_epoch(P?, X?, FMap?, FMap1),
    activate(Id?, IRec?, P?, X?, UserIn?, NetIn?,
             NetOut1, Date?, Known?, Vols?, Inbox?, FMap1?, FoFMap?, Pending?).

friend_request_step(false, Id, IRec, P, X, UserIn, NetIn, NetOut?, Date,
                    Known, Vols, Inbox, FMap, FoFMap, Pending) :-
    otherwise |
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?,
          gsg(Known?, Vols?, [msg(P?, friend_request(X?)) | Inbox?],
              FMap?, FoFMap?, Pending?)).

%% accept_offer_step: called from will(accept_offer) absorption.
%%   true  -> fire (R bound here via bind_ok; X is the extracted epoch from
%%            the matched friend_request).
%%   false -> store volition; wait for friend_request to arrive via NetIn.
%% =============================================================================

exported procedure accept_offer_step(Constant?, Agent?, IdentityRecord?,
                                       Agent?, Constant, Integer?,
                                       Stream(UserEvent(GsgVolition, GsgQuery, GsgAnswer))?,
                                       Stream(InMsg(GsgCargo))?,
                                       Stream(NetMsg(GsgCargo)),
                                       Integer?,
                                       Stream(Agent)?, Stream(GsgVolition)?,
                                       Stream(InMsg(GsgCargo))?,
                                       FMap?, FoFMap?, PendingList?).

accept_offer_step(true, Id, IRec, P, R?, X, UserIn, NetIn,
                  [msg(Id?, P?, accept(X?)) | NetOut1?], Date,
                  Known, Vols, Inbox, FMap, FoFMap, Pending) :-
    ground(X?) |
    set_epoch(P?, X?, FMap?, FMap1),
    bind_ok(R),
    activate(Id?, IRec?, P?, X?, UserIn?, NetIn?,
             NetOut1, Date?, Known?, Vols?, Inbox?, FMap1?, FoFMap?, Pending?).

accept_offer_step(false, Id, IRec, P, R?, _, UserIn, NetIn, NetOut?, Date,
                  Known, Vols, Inbox, FMap, FoFMap, Pending) :-
    otherwise |
    agent(Id?, IRec?, UserIn?, NetIn?, NetOut, Date?,
          gsg(Known?, [accept_offer(P?, R?) | Vols?], Inbox?,
              FMap?, FoFMap?, Pending?)).
