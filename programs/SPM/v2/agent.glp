%% agent.glp — CSSN social agent module (v2)
%%
%% Exports: agent/4
%% Types and helpers (merge, setup_group_*): from self.glp (ancestor scoping)
%% bind_response, handle_response, await_group_channel: local (call agent recursively)
%%
%% v2 changes:
%%   - Helpers moved to self.glp (except merge-dependent ones)
%%   - Added parent consent clauses: group_consent_req, approve/reject_child_group

-module(agent).
-mode(system).

%% =============================================================================
%% AWAIT_GROUP_CHANNEL — local (calls merge and agent)
%% =============================================================================

procedure await_group_channel(Constant?, GroupId?, Stream(GroupSetupResponse)?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, FMap?, FoFMap?, IdentityRecord?).
await_group_channel(Id, GroupId, [group_channel(ch(FromHub, ToHub?))|_],
        UserIn, NetIn, Outs, FMap, FoFMap, IR) :-
    ground(Id?), ground(GroupId?) |
    add_group_output(group(GroupId?), ToHub, Outs?, Outs1),
    merge(NetIn?, FromHub?, NetIn1),
    lookup_send('_user', msg(agent, '_user', group_joined(GroupId?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, FMap?, FoFMap?, IR?).
await_group_channel(_, _, [], _, _, _, _, _, _) :- true.

%% =============================================================================
%% RESPONSE HANDLING — local (calls merge)
%% =============================================================================

%% bind_response now takes own IR (IRSelf) for building the accept response
%% and peer IR (IRThem) to forward via the local-side accept(LocalCh, IRThem)
%% into handle_response, which extracts ir(K, S) for FMap storage.
procedure bind_response(Constant?, Decision?, Constant?, IdentityRecord?, IdentityRecord?, Response, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg), FMap?, FMap, FoFMap?, FoFMap).
bind_response(Id, yes, From, IRSelf, IRThem, accept(RetCh?, IRSelf?), Outs, Outs1?, In, In1?, FMap, FMap1?, FoFMap, FoFMap1?) :-
    new_channel(RetCh, LocalCh) |
    handle_response(Id?, accept(LocalCh?, IRThem?), From?, Outs?, Outs1, In?, In1, FMap?, FMap1, FoFMap?, FoFMap1).
bind_response(_, no, _, _, _, no, Outs, Outs1?, In, In?, FMap, FMap?, FoFMap, FoFMap?) :-
    lookup_send('_user', msg(agent, '_user', rejected), Outs?, Outs1).

%% handle_response decomposes accept(Ch, ir(K, S)) in head; yes branch uses
%% install_full to store full(From, NewEpoch, K, S) in FMap.
procedure handle_response(Constant?, Response?, Constant?, Stream(OutputEntry)?, Stream(OutputEntry), Stream(NetInMsg)?, Stream(NetInMsg), FMap?, FMap, FoFMap?, FoFMap).
handle_response(Id, accept(Ch, ir(K, S)), From, Outs, Outs1?, In, In1?, FMap, FMap1?, FoFMap, FoFMap?) :-
    ground(From?), ground(K?), ground(S?), ground(FMap?) |
    install_full(From?, K?, S?, FMap?, FMap1, Epoch),
    befriend_commit(Id?, From?, Ch?, Outs?, OutsA, In?, In1),
    send_all_friends(Id?, stream_update(From?, Epoch?), OutsA?, OutsB),
    send_snapshot(Id?, From?, FMap?, OutsB?, Outs1).
handle_response(_, no, From, Outs, Outs1?, In, In?, FMap, FMap?, FoFMap, FoFMap?) :-
    ground(From?) |
    lookup_send('_user', msg(agent, '_user', rejected(From?)), Outs?, Outs1).

%% =============================================================================
%% AGENT/6 (paper §6.1, §6.5 — adds FMap and FoFMap to platform state)
%% =============================================================================

exported procedure agent(Constant?, Stream(UserInMsg)?, Stream(NetInMsg)?, Stream(OutputEntry)?, FMap?, FoFMap?, IdentityRecord?).

%% --- User messages ---

%% User initiates cold call (paper §8.2): carries own IR alongside the
%% response reply variable.
agent(Id, [msg('_user', Id1, connect(Target))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Target?), ground(IR?) |
    lookup_send('_net', msg(Target?, intro(Id?, IR?, Resp)), Outs?, Outs1),
    inject_msg(Resp?, Target?, Id?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% User decision on cold-call (paper §8.2): PendingValue is response_secure,
%% carrying both the response writer and the peer's IR captured at intro time.
agent(Id, [msg('_user', Id1, decision(Dec, From, response_secure(Resp?, IRThem)))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(IR?) |
    bind_response(Id?, Dec?, From?, IR?, IRThem?, Resp, Outs?, Outs1, NetIn?, NetIn1, FMap?, FMap1, FoFMap?, FoFMap1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, FMap1?, FoFMap1?, IR?).

%% User sends text message to friend
agent(Id, [msg('_user', Id1, send(Target, Text))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Target?) |
    lookup_send(friend(Target?), msg(Id?, Target?, text(Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% User introduces friend P to friend Q
agent(Id, [msg('_user', Id1, introduce(P, Q))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(P?), ground(Q?), new_channel(PQCh, QPCh) |
    lookup_send(friend(P?), msg(Id?, P?, intro(Q?, QPCh?)), Outs?, Outs1),
    lookup_send(friend(Q?), msg(Id?, Q?, intro(P?, PQCh?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, FMap?, FoFMap?, IR?).

%% User accepts intro — send ack, spawn peer-wait, inject result
agent(Id, [msg('_user', Id1, accept_intro(Other, channel(Ch)))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% User rejects intro — send nack on channel, close it
agent(Id, [msg('_user', Id1, reject_intro(_, channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% Intro result: peer acked — idempotent befriend commit with smaller-name tie-break.
agent(Id, [intro_result(Other, Ch)|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    ground(Id?), ground(Other?), ground(FMap?) |
    bump_epoch(Other?, FMap?, FMap1, Epoch),
    befriend_commit(Id?, Other?, Ch?, Outs?, OutsA, NetIn?, NetIn1),
    send_all_friends(Id?, stream_update(Other?, Epoch?), OutsA?, OutsB),
    send_snapshot(Id?, Other?, FMap?, OutsB?, Outs1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, FMap1?, FoFMap?, IR?).

%% Intro result: peer nacked — notify rejected
agent(Id, [intro_rejected(Other)|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    ground(Id?) |
    lookup_send('_user', msg(agent, '_user', rejected(Other?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Response to cold-call (injected by inject_msg).  Peer's IR rides inside
%% the accept(Ch, IR) variant of Response; handle_response decomposes it.
agent(Id, [msg(From, Id1, response(Resp))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    handle_response(Id?, Resp?, From?, Outs?, Outs1, NetIn?, NetIn1, FMap?, FMap1, FoFMap?, FoFMap1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, FMap1?, FoFMap1?, IR?).

%% Query FoFMap[P][F] (paper §6.5, read-only): look up p's view of F's
%% epoch in P's friend list and emit fof_result back to user via mediator.
agent(Id, [msg('_user', Id1, q_fof(P, F))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(P?), ground(F?), ground(FoFMap?) |
    fof_epoch_of(P?, F?, FoFMap?, E),
    lookup_send('_user', msg(agent, '_user', fof_result(P?, F?, E?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% --- CSSG: Child-safe social graph ---

%% Sibling case: parent introduces own children to each other (Friend =?= Id)
agent(Id, [msg('_user', Id1, child_introduce(Child1, Friend, Child2))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, Friend? =?= Id?,
    ground(Child1?), ground(Child2?),
    new_channel(C1Ch, C2Ch) |
    lookup_send(child(Child1?), msg(Id?, Child1?, child_intro(Child2?, C1Ch?)), Outs?, Outs1),
    lookup_send(child(Child2?), msg(Id?, Child2?, child_intro(Child1?, C2Ch?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, FMap?, FoFMap?, IR?).

%% Non-sibling case: parent introduces own child to friend's child (otherwise)
agent(Id, [msg('_user', Id1, child_introduce(MyChild, Friend, FriendChild))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(MyChild?), ground(Friend?), ground(FriendChild?),
    otherwise,
    new_channel(C1Ch, C2Ch) |
    lookup_send(child(MyChild?), msg(Id?, MyChild?, child_intro(FriendChild?, C1Ch?)), Outs?, Outs1),
    lookup_send(friend(Friend?), msg(Id?, Friend?, child_intro(MyChild?, C2Ch?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, FMap?, FoFMap?, IR?).

%% Child (or parent) accepts child_intro — send ack, spawn peer-wait, inject result
agent(Id, [msg('_user', Id1, accept_child_intro(Other, channel(Ch)))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Other?),
    send(ack(Id?), Ch?, Ch1) |
    intro_await_peer(Other?, Ch1?, Result),
    inject_intro_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% Child (or parent) rejects child_intro — send nack on channel, close it
agent(Id, [msg('_user', Id1, reject_child_intro(_, channel(ch(_, [nack|[]]))))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% Parent approves child_intro — forward to own child
agent(Id, [msg('_user', Id1, approve_child_intro(OtherChild, MyChild, channel(Ch)))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(OtherChild?), ground(MyChild?) |
    lookup_send(child(MyChild?), msg(Id?, MyChild?, child_intro(OtherChild?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% --- CSSN: Child-safe social networking (groups) ---

%% User creates a group — creator sets up member-side write (no hub self-loop)
agent(Id, [msg('_user', Id1, create_group(Name))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Name?) |
    setup_group_creator(group_id(Id?, Name?),
        Outs?, Outs1, NetIn?, NetIn1),
    lookup_send('_user', msg(agent, '_user', group_joined(group_id(Id?, Name?))),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, FMap?, FoFMap?, IR?).

%% User invites member to group
agent(Id, [msg('_user', Id1, invite_group(GroupId, Invitee))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?), ground(Invitee?),
    new_channel(InviteeCh, CreatorCh) |
    lookup_send(friend(Invitee?),
        msg(Id?, Invitee?, group_invite(GroupId?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Invitee?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% User invites child to group via parent
agent(Id, [msg('_user', Id1, invite_group(GroupId, Child, Parent))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?), ground(Parent?),
    new_channel(InviteeCh, CreatorCh) |
    lookup_send(friend(Parent?),
        msg(Id?, Parent?, group_invite_child(GroupId?, Child?, InviteeCh?)), Outs?, Outs1),
    group_await_join(GroupId?, Child?, CreatorCh?, Result),
    inject_group_result(Result?, UserIn?, UserIn1),
    agent(Id?, UserIn1?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% User accepts group invite
agent(Id, [msg('_user', Id1, accept_group(GroupId,
        group_channel(ch(ChRead, [ack(Id?)|[]]))))|UserIn],
        NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?) |
    await_group_channel(Id?, GroupId?, ChRead?, UserIn?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% User rejects group invite — send nack, close channel
agent(Id, [msg('_user', Id1, reject_group(_, group_channel(ch(_, [nack|[]]))))|UserIn],
        NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% Injected group_join_ack — creator wires hub-side, sends member-end channel
agent(Id, [group_join_ack(GroupId, Invitee, ch(_, [group_channel(MemberEnd?)|[]]))|UserIn],
        NetIn, Outs, FMap, FoFMap, IR) :-
    ground(Id?), ground(GroupId?), ground(Invitee?) |
    setup_group_hub_side(GroupId?, Invitee?, Outs?, Outs1, NetIn?, NetIn1, MemberEnd),
    lookup_send('_user', msg(agent, '_user', group_joined_member(GroupId?, Invitee?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn1?, Outs2?, FMap?, FoFMap?, IR?).

%% Injected group_join_nack — nothing to clean up
agent(Id, [group_join_nack(_, _)|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    ground(Id?) |
    agent(Id?, UserIn?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% User sends group message — send on member-to-hub channel
agent(Id, [msg('_user', Id1, send_group(GroupId, Text))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?), ground(Text?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_msg(GroupId?, Id?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Parent approves group invite for child — forward group_invite to child channel
agent(Id, [msg('_user', Id1, approve_group(Child, GroupId, group_channel(Ch)))|UserIn],
        NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    lookup_send(child(Child?), msg(Id?, Child?, group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% --- Leave group (v3) ---

%% Member leaves group (own choice)
agent(Id, [msg('_user', Id1, leave_group(GroupId))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?) |
    lookup_send_group(group(GroupId?),
        msg(Id?, Id?, group_leave(GroupId?, Id?)), Outs?, Outs1),
    close_output(group(GroupId?), Outs1?, Outs2),
    lookup_send('_user', msg(agent, '_user', group_left(GroupId?)), Outs2?, Outs3),
    agent(Id?, UserIn?, NetIn?, Outs3?, FMap?, FoFMap?, IR?).

%% Parent tells child to leave group
agent(Id, [msg('_user', Id1, leave_child_group(Child, GroupId))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Child?), ground(GroupId?) |
    lookup_send(child(Child?), msg(Id?, Child?, leave_group(GroupId?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Creator removes member from group
agent(Id, [msg('_user', Id1, remove_from_group(GroupId, Member))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?), ground(Member?) |
    lookup_send_group(group_member(GroupId?, Member?),
        msg(Id?, Member?, group_removed(GroupId?)), Outs?, Outs1),
    close_output(group_member(GroupId?, Member?), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, FMap?, FoFMap?, IR?).

%% --- Parent consent for child-managed groups (v2) ---

%% Parent approves child group consent — binds Decision to yes
agent(Id, [msg('_user', Id1, approve_child_group(_, _, consent(yes)))|UserIn],
        NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% Parent rejects child group consent — binds Decision to no
agent(Id, [msg('_user', Id1, reject_child_group(_, _, consent(no)))|UserIn],
        NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    agent(Id?, UserIn?, NetIn?, Outs?, FMap?, FoFMap?, IR?).

%% --- Unfriend (v3) ---

%% Parent initiates unfriend on behalf of child
agent(Id, [msg('_user', Id1, unfriend_child_of(MyChild, Target))|UserIn], NetIn, Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(MyChild?), ground(Target?) |
    lookup_send(child(MyChild?), msg(Id?, MyChild?, unfriend_child(Target?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% --- Network messages ---

%% Cold-call from network (paper §8.2): cargo carries offerer's IR.
agent(Id, UserIn, [msg(Id1, intro(From, IRThem, Resp?))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', befriend(From?, IRThem?, Resp)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Response to cold-call from network: handle_response decomposes accept(Ch, IR).
agent(Id, UserIn, [msg(From, Id1, response(Resp))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    handle_response(Id?, Resp?, From?, Outs?, Outs1, NetIn?, NetIn1, FMap?, FMap1, FoFMap?, FoFMap1),
    agent(Id?, UserIn?, NetIn1?, Outs1?, FMap1?, FoFMap1?, IR?).

%% Text from friend
agent(Id, UserIn, [msg(From, Id1, text(Text))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1? |
    lookup_send('_user', msg(agent, '_user', received(From?, Text?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Introduction from friend — pass channel to user via mediator
agent(Id, UserIn, [msg(From, Id1, intro(Other, Ch))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send('_user', msg(agent, '_user', befriend_intro(From?, Other?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% --- CSSG network messages ---

%% Child receives child_intro from parent (or parent forwards from friend)
agent(Id, UserIn, [msg(From, Id1, child_intro(Other, Ch))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Other?) |
    lookup_send('_user', msg(agent, '_user', child_befriend(From?, Other?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% --- CSSN network messages ---

%% Group invite from friend — forward to user via mediator
agent(Id, UserIn, [msg(_, Id1, group_invite(GroupId, Ch))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?) |
    lookup_send('_user', msg(agent, '_user', group_invite(GroupId?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Group invite for child from friend — forward to parent user via mediator
agent(Id, UserIn, [msg(_, Id1, group_invite_child(GroupId, Child, Ch))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?), ground(Child?) |
    lookup_send('_user', msg(agent, '_user', group_invite_child(GroupId?, Child?, Ch?)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Consent request from child — forward to parent user via mediator (v2)
agent(Id, UserIn, [msg(Child, Id1, group_consent_req(GroupId, Consent?))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(Child?), ground(GroupId?) |
    lookup_send('_user', msg(agent, '_user',
        child_group_consent(Child?, GroupId?, Consent)), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Group message from group channel — distribute to all members and notify user
agent(Id, UserIn, [msg(_, _, group_msg(GroupId, Author, Text))|NetIn], Outs, FMap, FoFMap, IR) :-
    ground(Id?), ground(GroupId?), ground(Author?), ground(Text?) |
    distribute_group_msg(GroupId?,
        msg(Author?, Author?, group_msg(GroupId?, Author?, Text?)), Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', group_received(GroupId?, Author?, Text?)),
        Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, FMap?, FoFMap?, IR?).

%% Creator receives leave notification from member
agent(Id, UserIn, [msg(Member, _, group_leave(GroupId, Member1))|NetIn], Outs, FMap, FoFMap, IR) :-
    ground(Id?), ground(GroupId?), ground(Member?), Member? =?= Member1? |
    close_output(group_member(GroupId?, Member?), Outs?, Outs1),
    agent(Id?, UserIn?, NetIn?, Outs1?, FMap?, FoFMap?, IR?).

%% Member receives removal notification from creator
agent(Id, UserIn, [msg(_, Id1, group_removed(GroupId))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(GroupId?) |
    close_output(group(GroupId?), Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', group_removed(GroupId?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, FMap?, FoFMap?, IR?).

%% Receive stream_update from friend (paper §6.5): record FoFMap[From][Who] := Epoch.
agent(Id, UserIn, [msg(From, Id1, stream_update(Who, Epoch))|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(From?), ground(Who?), ground(Epoch?) |
    set_fof_epoch(From?, Who?, Epoch?, FoFMap?, FoFMap1),
    agent(Id?, UserIn?, NetIn?, Outs?, FMap?, FoFMap1?, IR?).

%% Receive unfriend from friend — bump epoch (now inactive), close friend channel, notify UI
agent(Id, UserIn, [msg(From, Id1, unfriend)|NetIn], Outs, FMap, FoFMap, IR) :-
    Id? =?= Id1?, ground(From?) |
    bump_epoch(From?, FMap?, FMap1, _),
    close_output(friend(From?), Outs?, Outs1),
    lookup_send('_user', msg(agent, '_user', unfriended(From?)), Outs1?, Outs2),
    agent(Id?, UserIn?, NetIn?, Outs2?, FMap1?, FoFMap?, IR?).

%% --- Termination ---

agent(_, [], _, Outs, _, _, _) :- close_outputs(Outs?).
agent(_, _, [], Outs, _, _, _) :- close_outputs(Outs?).
