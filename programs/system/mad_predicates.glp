%% madGLP System Predicates
%%
%% GLP procedures for madGLP network communication.
%% These call Dart kernel predicates for low-level operations.
%%
%% See: madGLP-spec.md Section 4 and Section 12

%% Primitive-layer module: it names the '_w'/'_r'/'_send' kernels, so it must
%% declare -mode(system). Permitted here because it lives under programs/system/
%% (TGLP appendix, "Admission to the Primitive Layer").
-mode(system).

%% =============================================================================
%% TYPE DEFINITIONS
%% =============================================================================

%% Network message: msg(Destination, Content)
NetMsg ::= msg(Constant, _).
NetStream ::= [] ; [NetMsg|NetStream].

%% Global name for cross-isolate communication
GlobalName ::= '_w'(Constant, Integer) ; '_r'(Constant, Integer).

%% =============================================================================
%% send_to_net/1 - Process network output stream
%% =============================================================================
%%
%% Iterates over a stream of msg(Q, T) terms and sends each to the
%% destination agent Q via global_send with the serializer address _w(Q,0).
%%
%% Per madGLP-spec.md Section 12.2
%%
%% Note: Q is used multiple times, but this is safe because messages in the
%% network output stream contain ground destination agents.

procedure send_to_net(NetStream?).
send_to_net([msg(Q, T) | In]) :- ground(Q?) | global_send(msg(Q?, T?), '_w'(Q?, 0), Q?), send_to_net(In?).
send_to_net([]).

%% =============================================================================
%% global_send/3 - Send via global link
%% =============================================================================
%%
%% Sends term T via global name G to agent Q.
%% Used for both cold-calls (index 0) and established links (index > 0).
%%
%% Per madGLP-spec.md Section 4 and Section 11.5:
%% - If G = _w(q, 0) (serializer): wraps T in list [T | _w(q,0)]
%% - If G has index > 0: sends T directly
%%
%% The '_send'/3 kernel handles both cases based on the index.

procedure global_send(NetMsg?, GlobalName?, Constant?).
global_send(T, G, Q) :- known(T?) | '_send'(T?, G?, Q?).
