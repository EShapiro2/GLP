%% madGLP System Predicates
%%
%% GLP procedures for madGLP network communication.
%% These call Dart kernel predicates for low-level operations.
%%
%% See: madGLP-spec.md Section 4 and Section 12

%% =============================================================================
%% send_to_net/1 - Process network output stream
%% =============================================================================
%%
%% Iterates over a stream of msg(Q, T) terms and sends each to the
%% destination agent Q via global_send.
%%
%% Per madGLP-spec.md Section 12.2

procedure send_to_net(Stream?).
send_to_net([msg(Q, T) | In]) :- global_send(T?, Q?), send_to_net(In?).
send_to_net([]).

%% =============================================================================
%% global_send/2 - Cold-call send (allocates fresh global name)
%% =============================================================================
%%
%% For cold-call messages where no global link exists yet.
%% The kernel '_cold_send' allocates a fresh global name internally.
%%
%% Per madGLP-spec.md Section 12.2

procedure global_send(_?, _?).
global_send(T, Q) :- known(T?) | '_cold_send'(T?, Q?).

%% =============================================================================
%% global_send/3 - Established link send (uses existing global name)
%% =============================================================================
%%
%% For messages on established global links (e.g., forwarding, responses).
%% The global name G was allocated during globalize/localize.
%%
%% Per madGLP-spec.md Section 4

procedure global_send(_?, _?, _?).
global_send(T, G, Q) :- known(T?) | '_send'(T?, G?, Q?).
