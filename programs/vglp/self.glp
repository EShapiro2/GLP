%% self.glp — the vocabulary of the vGLP mediator.
%%
%% The mediator of vGLP's Definition "Canonical Compilation" (paper
%% "Volition Elicitation", Section "Elicitation", subsection "The
%% Implementation: Compiling vGLP onto GLP"), generic in the compiled
%% program's answer type A and context type X.
%%
%% A compiled program supplies both: A is the program's answer type
%%   A ::= Xs_C1 ; ... ; Xs_Ck
%% over its volition-guarded clauses, and X its context type
%%   X ::= ctx_C1 ; ... ; ctx_Ck.
%% The paper's types item names A and leaves the context's type unstated; the
%% card carries the context to the person, so the mediator is generic in it
%% too, on the same construction.
%%
%% The vocabulary is the Definition's types item, letter for letter: one
%% escrowed writer, the reply, bound once to then(A) or else, so a compiled
%% clause selects its branch by head unification; and one slot type over the
%% program's answer type, so aborts/3 takes the slot list of a clause whose
%% slots belong to different clauses, and one mediator serves every program.

%% The identifier the mediator assigns an ask.
ReqId ::= req(Integer).

%% What the mediator binds when the ask is answered: the then-branch with the
%% answer's values, or the else-branch, which carries none.
Reply(A) ::= then(A) ; else.

%% A slot of a compiled goal: no open ask, or one whose reply and identifier
%% the goal holds the READERS of — their writers went to the mediator with the
%% ask.
Slot(A) ::= none ; ask(Reply(A), ReqId).
Slots(A) ::= [] ; [Slot(A) | Slots(A)].

%% Whether an ask carries a deadline: it does iff its clause has an
%% else-branch, which is what the machine answers on the deadline.
Deadline ::= deadline ; no_deadline.

%% Agent to mediator: an ask posed, carrying the writers the mediator binds,
%% or an ask aborted because another clause reduced the goal.
AgentMsg(A, X) ::= ask(Constant, X, Reply(A)?, ReqId?, Deadline)
                 ; abort(ReqId).

%% Mediator to person: the card of an open ask, and its removal.
Card(X) ::= card(Constant, X, ReqId) ; closed(ReqId).

%% Person to mediator: the grant of a construct's tap or submission.
UserAnswer(A) ::= answer(ReqId, A).

%% The pending table: one entry per open ask, carrying the WRITER of its
%% reply, which answer/4 or close/3 binds in place.
PendingEntry(A) ::= pending(ReqId, Reply(A)?).
PendingList(A) ::= [] ; [PendingEntry(A) | PendingList(A)].

%% The timer stream: one timeout per ask, on its deadline.
Timeout ::= timeout(ReqId).
TimerStream ::= [] ; [Timeout | TimerStream].
