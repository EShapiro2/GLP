%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract gnudge
%% (../contracts.glp, contract_named(gnudge, C): nudge with a second schema g,
%% nudge(a, b) and g(b?, a) determining the same transactions), platform.vglp,
%% which programs/vglp/cva/compile.sh prints from it: two-phase commit
%% coordinated by the initiating agent (vGLP, Section 3.2, Definition
%% "Canonical CVA Platform").  It runs two agents, alice and bob, alice
%% preceding bob in the order of identifiers, their persons scripted and paced
%% on their screens (../self.glp), and gives each person's log, the views with
%% gave(K, A) where the person answers an approval question, and the network's log of the
%% cargoes it carries.
%%
%% play_gnudge: alice proposes befriending bob, bob is asked and answers yes, and it commits.  The class of nudge(bob, alice) then has two parts, each schema-binding determining a part with the people in its marked roles as its guard set (vGLP 099f876, Section 5.4, "Act schemas as local specifications"): nudge(bob, alice)'s, unguarded, and g(alice, bob)'s, guarded by alice, which the request type proposes.  The opener of the unguarded part is bob, the least person in the first role of its schema-bindings, though alice precedes him: bob's machine proposes it as an own transaction, the attempt asking nobody and alice's machine voting on its start.  alice opens the unguarded part of nudge(alice, bob) likewise, both at once, and as in the play of nudge bob, holding his own attempt prepared, wounds it in favour of alice's, and both nudges commit in turn, his retried at the wounded rank (vGLP 49cd9f7, wound-wait).
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; nudge(Peer, Peer) ; g(Peer, Peer).
Proposal ::= befriend(Peer, Peer) ; g(Peer, Peer).
Request  ::= propose(Proposal).
YesNo    ::= yes ; no.
Reason   ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote     ::= yes ; no(Reason).
Decision ::= commit ; abort(Peer, Reason) ; yield.
Rho      ::= one(Class) ; rho(Proposal).
Names    ::= none ; request(Rho, Integer).
Attempt  ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo    ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
           ; yield(Attempt) ; request(Rho, Integer).
Content  ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= friend(Peer) ; nudged(Peer) ; nudged_by(Peer).
Approved ::= Proposal ; Attempt.
Output   ::= view(List(Atom), List(Key), List(Approved)) ; refused(Class, Key, Reason).
Asking   ::= Attempt ; hello(Peer, Proposal).
Approval ::= approval(Asking, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_gnudge(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_gnudge(LA?, LB?, N?) :-
    pair([own([A1], propose(befriend(A1?, bob)))],
         [approval(befriend(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks
%% joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
