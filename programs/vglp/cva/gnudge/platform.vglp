%% Printed by programs/vglp/cva/compiler from the contract named below, in the
%% term form programs/jurix reads (Jurix, Sections 3 and 5): the canonical CVA
%% platform of the contract (vGLP, Section 3.2, Definition "Canonical CVA
%% Platform"), two-phase commit coordinated by the initiating agent, in the
%% structured form of vGLP Section 5.4 and written in vGLP (Section 5.4, the
%% paragraph on act schemas).  Edit the contract or the compiler and run
%% programs/vglp/cva/compile.sh, not this file.
%% the canonical CVA platform of the contract(gnudge)

%% ===========================================================================
%% The contract
%% ===========================================================================

Class ::=
befriend(Peer, Peer)
;
nudge(Peer, Peer)
;
g(Peer, Peer)
.

procedure contract_schemas(Schemas).
contract_schemas([schema(befriend, [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]), rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]), schema(nudge, [rs(unguarded, [atom(nudged, [role(2)])], [], [atom(friend, [role(2)])], [atom(nudged, [role(2)])]), rs(unguarded, [atom(nudged_by, [role(1)])], [], [atom(friend, [role(1)])], [])]), schema(g, [rs(guarded, [atom(nudged_by, [role(2)])], [], [atom(friend, [role(2)])], []), rs(unguarded, [atom(nudged, [role(1)])], [], [atom(friend, [role(1)])], [atom(nudged, [role(1)])])])])
.

procedure reflexive_preds(Preds).
reflexive_preds([])
.

procedure binding_of(Class?, Constant, Binding).
binding_of(befriend(V1, V2), befriend, [b(role(1), p(V1?)), b(role(2), p(V2?))])
.
binding_of(nudge(V1, V2), nudge, [b(role(1), p(V1?)), b(role(2), p(V2?))])
.
binding_of(g(V1, V2), g, [b(role(1), p(V1?)), b(role(2), p(V2?))])
.

procedure class_of(Constant?, Binding?, Peer?, Class).
class_of(befriend, B, D, befriend(V1?, V2?))
:-
ground(B?)
,
ground(D?)
|
val_peer(role(1), B?, D?, V1)
,
val_peer(role(2), B?, D?, V2)
.
class_of(nudge, B, D, nudge(V1?, V2?))
:-
ground(B?)
,
ground(D?)
|
val_peer(role(1), B?, D?, V1)
,
val_peer(role(2), B?, D?, V2)
.
class_of(g, B, D, g(V1?, V2?))
:-
ground(B?)
,
ground(D?)
|
val_peer(role(1), B?, D?, V1)
,
val_peer(role(2), B?, D?, V2)
.

%% ===========================================================================
%% The agent (Definition "Compilation of a Structured Platform"): a volitional
%% procedure whose question is a pair, the stream of the person's requests and
%% the thread, which the agent goal writes.  It asks once and calls the agent
%% goal on the fair merge of the requests, the arriving messages, the answers
%% of its responders and the ticks of its clock.
%% ===========================================================================

%% An attempt (i, k, [t]) (Definition "Attempt, Message, App State, Question,
%% Ready"): its initiator, its number and a term of the request type naming its
%% class.  The cargoes are its start, a vote on it and its outcome; the thread
%% names each app transaction by its schema applied to its attempt, and
%% discover(Q) for each peer Q the agent comes to know.
Peer      ::= Key.
Speech    ::= speech(String, Peer).
Request   ::= propose(Class) ; known(Peer).
YesNo     ::= yes ; no.
Decision  ::= commit ; abort.
Attempt   ::= attempt(Peer, Integer, Class).
Cargo     ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision).
Content   ::= hello(Peer) ; cargo(Peer, Integer, Cargo).
Net       ::= msg(Peer, Content).
Txn       ::= propose(Attempt) ; start(Attempt) ; answer(Attempt)
            ; tally(Attempt) ; outcome(Attempt) ; discover(Peer).
Session   ::= session(Stream(Request)?, Stream(Txn)).
Card      ::= card(Attempt, YesNo?).
Close     ::= close.
Demand    ::= more.
Trigger   ::= req(Request) ; net(Net) ; tick ; answered(Attempt, YesNo).

%% The contract, as programs/jurix writes it: a schema's roles, each rs(Guard,
%% Add, Del, Keep, Forb), a role named by its index.
Var       ::= role(Integer) ; pvar(Constant) ; svar(Constant).
Vars      ::= [] ; [Var | Vars].
SAtom     ::= atom(Constant, Vars).
SAtoms    ::= [] ; [SAtom | SAtoms].
Guard     ::= guarded ; unguarded.
RoleSpec  ::= rs(Guard, SAtoms, SAtoms, SAtoms, SAtoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Schema    ::= schema(Constant, RoleSpecs).
Schemas   ::= [] ; [Schema | Schemas].
Preds     ::= [] ; [Constant | Preds].

%% A machine state is a multiset of ground atoms, a list; an atom's arguments
%% are people and speech acts.  A binding sends roles and party variables to
%% people and speech-act variables to speech acts.
Val       ::= p(Peer) ; s(Speech).
Vals      ::= [] ; [Val | Vals].
GAtom     ::= g(Constant, Vals).
GAtoms    ::= [] ; [GAtom | GAtoms].
Bind      ::= b(Var, Val).
Binding   ::= [] ; [Bind | Binding].
Bindings  ::= [] ; [Binding | Bindings].
Found     ::= found(Val) ; free.
Match     ::= match(Binding) ; nomatch.
Peers     ::= [] ; [Peer | Peers].
PeerSets  ::= [] ; [Peers | PeerSets].
Nets      ::= [] ; [Net | Nets].
Ints      ::= [] ; [Integer | Ints].

%% A class: its participants and the atoms each deletes and adds, part(P, D,
%% A); its schema-bindings, each mate(Schema, Binding, GuardSet, FirstPerson),
%% the binding leaving free a variable of no deleted or added atom; and what
%% they give, the guard sets, the inclusion-minimal sets among those of its
%% schema-bindings, and, for an unguarded class, the opener.  ci(C, Parts,
%% Participants, GuardSets, Opener, Mates), C the term that names it, the first
%% the agent met.
Part      ::= part(Peer, GAtoms, GAtoms).
Parts     ::= [] ; [Part | Parts].
Mate      ::= mate(Constant, Binding, Peers, Peer).
Mates     ::= [] ; [Mate | Mates].
Opener    ::= opener(Peer) ; guarded_class.
Info      ::= ci(Class, Parts, Peers, PeerSets, Opener, Mates).
Infos     ::= [] ; [Info | Infos].
ClassRes  ::= cls(Info) ; nocls.

%% The app state (s, k, L, R): the machine state, the number of attempts the
%% agent has initiated, the lock, unlocked or the attempt it holds prepared,
%% and the record.  The agent state: its identifier, the app state, the local
%% date, the peers hello has been sent to and received from, the number of the
%% next message, the tick since which each opening class its ticks have met has
%% waited, the classes met, and the messages pending: on a peer not yet known,
%% pend(Q, M), or a start deferred, deferred(M).
Lock      ::= unlocked ; held(Attempt).
Rec       ::= asked(Attempt) ; voted(Attempt, YesNo) ; got(Attempt, Peer, YesNo)
            ; closed(Attempt).
Recs      ::= [] ; [Rec | Recs].
App       ::= app(GAtoms, Integer, Lock, Recs).
Pend      ::= pend(Peer, Net) ; deferred(Net).
Pends     ::= [] ; [Pend | Pends].
WKey      ::= op(Class).
Wait      ::= w(WKey, Integer).
Waits     ::= [] ; [Wait | Waits].
WFound    ::= at(Integer) ; unseen.
St        ::= st(Peer, App, Integer, Peers, Peers, Integer, Waits, Infos, Pends).
OpenCard  ::= oc(Attempt, Close?).
OpenCards ::= [] ; [OpenCard | OpenCards].
Send      ::= to(Peer, Cargo).
Sends     ::= [] ; [Send | Sends].
Cand      ::= cand(WKey, Info).
Cands     ::= [] ; [Cand | Cands].
Choice    ::= take(Info) ; none.
PKey      ::= key(WKey) ; nokey.
Cond      ::= go(Info) ; drop.
MCond     ::= mgo(Info) ; mpend(Peer) ; mdefer ; mdrop.
Known     ::= allknown ; unknown(Peer).
Then      ::= own ; done.
CardRes   ::= card_for(Attempt) ; nocard.

exported procedure (Session)*agent(Peer?, Stream(Net)?, Stream(Net)).
(session(Reqs, Thr?))*agent(Id, NetIn, Out?) :- ground(Id?) |
    tag_requests(Reqs?, Rq),
    tag_net(NetIn?, Nt),
    clock(Dem?, Tk),
    merge(Rq?, Nt?, M1),
    merge(Tk?, Ans?, M2),
    merge(M1?, M2?, In),
    agent_goal([], In?, Ans, Dem, Thr, Out, [],
        st(Id?, app([], 0, unlocked, []), 0, [], [], 0, [], [], [])).

procedure tag_requests(Stream(Request)?, Stream(Trigger)).
tag_requests([R|Rs], [req(R?)|Ts?]) :- tag_requests(Rs?, Ts).
tag_requests([], []).

procedure tag_net(Stream(Net)?, Stream(Trigger)).
tag_net([M|Ms], [net(M?)|Ts?]) :- tag_net(Ms?, Ts).
tag_net([], []).

%% The clock writes ticks without end, the next once the agent goal has read
%% the last.
procedure clock(Stream(Demand)?, Stream(Trigger)).
clock(Ds, [tick|Ts?]) :- clock1(Ds?, Ts).
procedure clock1(Stream(Demand)?, Stream(Trigger)).
clock1([more|Ds], [tick|Ts?]) :- clock1(Ds?, Ts).
clock1([], []).

%% A responder: the card Start raises shows the attempt and takes yes or no.
%% The agent goal holds the writer of its close signal and closes it once the
%% question is no longer pending, as when Outcome closes the attempt first; the
%% responder then reduces without the answer, dropping the person's reader on
%% it.
procedure (Card)*respond(Attempt?, Close?, Stream(Trigger)).
(card(At?, YN))*respond(At, Cl, Out?) :- ground(At?) |
    await(At?, YN?, Cl?, Out).
procedure await(Attempt?, YesNo?, Close?, Stream(Trigger)).
await(At, yes, _, [answered(At?, yes)]).
await(At, no, _, [answered(At?, no)]).
await(_, _, close, []).

%% ===========================================================================
%% The agent goal: one clause per kind of trigger, which computes the
%% conditions of the schemas the trigger puts up and calls the dispatch.  It
%% reads first what it has put up itself, its own tick after every other
%% trigger it reads and the messages pending put up again, and then
%% its input stream.
%% ===========================================================================

procedure agent_goal(Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger),
    Stream(Demand), Stream(Txn), Stream(Net), OpenCards?, St?).
agent_goal([T|Ls], In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    step(T?, done, Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).
agent_goal([], [T|In], Ans?, Dem?, Thr?, Out?, Cards, St) :-
    step(T?, own, [], In?, Ans, Dem, Thr, Out, Cards?, St?).
agent_goal([], [], [], [], [], [], _, _).

procedure step(Trigger?, Then?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger), Stream(Demand), Stream(Txn), Stream(Net), OpenCards?, St?).
step(req(propose(C)), Th, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    ground(C?), ground(St?) |
    st_app(St?, Ap0),
    propose_cond(C?, St?, Cd, St1),
    dispatch_propose(Cd?, C?, Th?, Ap0?, Ls?, In?, Ans, Dem, Thr, Out, Cards?, St1?).
step(req(known(Q)), Th, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    ground(Q?), ground(St?) |
    st_app(St?, Ap0),
    known_cond(Q?, St?, Cd),
    dispatch_known(Cd?, Q?, Th?, Ap0?, Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).
step(net(msg(_, hello(P))), Th, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    ground(P?), ground(St?) |
    st_app(St?, Ap0),
    hello_cond(P?, St?, Cd),
    dispatch_hello(Cd?, P?, Th?, Ap0?, Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).
step(net(msg(To, cargo(F, N, X))), Th, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    ground(To?), ground(F?), ground(N?), ground(X?), ground(St?) |
    st_app(St?, Ap0),
    message_cond(X?, St?, Cd, St1),
    dispatch_message(Cd?, msg(To?, cargo(F?, N?, X?)), F?, X?, Th?, Ap0?, Ls?,
        In?, Ans, Dem, Thr, Out, Cards?, St1?).
step(answered(At, YN), Th, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    ground(At?), ground(YN?), ground(St?) |
    st_app(St?, Ap0),
    close_card(At?, Cards?, Cards1),
    answer_cond(At?, St?, Cd, St1),
    dispatch_answer(Cd?, YN?, At?, Th?, Ap0?, Ls?, In?, Ans, Dem, Thr, Out,
        Cards1?, St1?).
step(tick, own, Ls, In, Ans?, [more|Dem?], Thr?, Out?, Cards, St) :-
    tick(Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).
step(tick, done, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    tick(Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).

%% After a dispatch: the cards whose question the new app state no longer holds
%% pending are closed; where the app state or the date has changed, the
%% messages pending on a peer are put up again, and where the app state has
%% changed, the starts deferred; and after a trigger read from the input
%% stream, a tick excepted, the agent goal takes a tick of its own.
procedure next(Then?, YesNo?, App?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Demand), Stream(Txn), Stream(Net),
    OpenCards?, St?).
next(Th, Dt, Ap0, Ag, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    ground(Ap0?), ground(St?) |
    app_changed(Ap0?, St?, Ca1),
    app_changed(Ap0?, St?, Ca2),
    app_changed(Ap0?, St?, Ca3),
    or(Dt?, Ca1?, Ch),
    close_falsified(Ca2?, Cards?, St?, Cards1),
    repend(Ch?, Ca3?, St?, Ag1, St1),
    own_after(Th?, Ow),
    app(Ag?, Ag1?, Ag2),
    app(Ag2?, Ls?, L1),
    app(L1?, Ow?, L2),
    agent_goal(L2?, In?, Ans, Dem, Thr, Out, Cards1?, St1?).

procedure app_changed(App?, St?, YesNo).
app_changed(Ap0, St, C?) :- ground(Ap0?), ground(St?) |
    st_app(St?, Ap1),
    same(Ap0?, Ap1?, Sm),
    neg(Sm?, C).

procedure own_after(Then?, Stream(Trigger)).
own_after(own, [tick]).
own_after(done, []).

%% repend(Changed?, AppChanged?, St?, Ag, St1): the messages pending on a peer
%% put up again where the app state or the date has changed, and the starts
%% deferred where the app state has.
procedure repend(YesNo?, YesNo?, St?, Stream(Trigger), St).
repend(no, _, St, [], St?).
repend(yes, Ca, St, Ag?, St1?) :- ground(St?) |
    st_pends(St?, Pd),
    pend_triggers(Pd?, Ca?, Ag, Rest),
    set_pends(St?, Rest?, St1).
procedure pend_triggers(Pends?, YesNo?, Stream(Trigger), Pends).
pend_triggers([], _, [], []).
pend_triggers([pend(_, M)|Ps], Ca, [net(M?)|Ts?], R?) :-
    pend_triggers(Ps?, Ca?, Ts, R).
pend_triggers([deferred(M)|Ps], yes, [net(M?)|Ts?], R?) :-
    pend_triggers(Ps?, yes, Ts, R).
pend_triggers([deferred(M)|Ps], no, Ts?, [deferred(M?)|R?]) :-
    pend_triggers(Ps?, no, Ts, R).

%% --- Propose of a guarded class, on the request propose([t]) ---------------
%% Its condition: the class is guarded, the agent a guard of it, ready for it
%% and knowing every other participant, and no start of an initiator
%% preceding the agent waiting among its pending messages.
procedure propose_cond(Class?, St?, Cond, St).
propose_cond(C, St, Cd?, St2?) :- ground(C?), ground(St?) |
    st_class(C?, St?, R, St1),
    propose_cond1(R?, St1?, Cd, St2).
procedure propose_cond1(ClassRes?, St?, Cond, St).
propose_cond1(nocls, St, drop, St?).
propose_cond1(cls(I), St, Cd?, St?) :- ground(I?), ground(St?) |
    unguarded_i(I?, Ug),
    neg(Ug?, Gd),
    guard_of_i(I?, St?, IsG),
    ready_i(I?, St?, Rd),
    others_known(I?, St?, K),
    known_ok(K?, Kn),
    no_prior_start(St?, Np),
    and(Gd?, IsG?, B1),
    and(B1?, Rd?, B2),
    and(B2?, Kn?, B3),
    and(B3?, Np?, B),
    go_or_drop(B?, I?, Cd).

procedure dispatch_propose(Cond?, Class?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Demand), Stream(Txn), Stream(Net),
    OpenCards?, St?).
dispatch_propose(go(I), C, Th, Ap0, Ls, In, Ans?, Dem?, [propose(At?)|Thr?], Out?,
        Cards, St) :-
    ground(I?), ground(C?), ground(St?) |
    propose_effect(I?, C?, St?, At, Ss, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out1, Cards?, St2?).
dispatch_propose(drop, _, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).

%% --- Discover: the hellos ---------------------------------------------------
%% On the request known(Q) the agent sends Q hello, unless it already has or Q
%% is itself; on an arriving hello it records its sender; on whichever of the
%% two comes second it writes discover(Q) on the thread and puts up again the
%% messages pending on Q.
procedure known_cond(Peer?, St?, YesNo).
known_cond(Q, St, R?) :- ground(Q?), ground(St?) |
    st_id(St?, Id),
    st_sent(St?, Se),
    same(Q?, Id?, S1),
    mem(Q?, Se?, S2),
    or(S1?, S2?, S),
    neg(S?, R).

procedure dispatch_known(YesNo?, Peer?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Demand), Stream(Txn), Stream(Net),
    OpenCards?, St?).
dispatch_known(yes, Q, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, [msg(Q?, hello(Id?))|Out?],
        Cards, St) :-
    ground(Q?), ground(St?) |
    st_id(St?, Id),
    add_sent(Q?, St?, St1),
    discovered(Q?, St1?, Thr, Thr1?, Ag, St2),
    next(Th?, no, Ap0?, Ag?, Ls?, In?, Ans, Dem, Thr1, Out, Cards?, St2?).
dispatch_known(no, _, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).

procedure hello_cond(Peer?, St?, YesNo).
hello_cond(P, St, R?) :- ground(St?) |
    st_recd(St?, Rc),
    mem(P?, Rc?, B),
    neg(B?, R).

procedure dispatch_hello(YesNo?, Peer?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Demand), Stream(Txn), Stream(Net),
    OpenCards?, St?).
dispatch_hello(yes, P, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    ground(P?) |
    add_recd(P?, St?, St1),
    discovered(P?, St1?, Thr, Thr1?, Ag, St2),
    next(Th?, no, Ap0?, Ag?, Ls?, In?, Ans, Dem, Thr1, Out, Cards?, St2?).
dispatch_hello(no, _, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).

procedure discovered(Peer?, St?, Stream(Txn), Stream(Txn)?, Stream(Trigger), St).
discovered(Q, St, Thr?, Thr1, Ag?, St1?) :- ground(Q?), ground(St?) |
    second(Q?, St?, Sc),
    discover_q(Sc?, Q?, St?, Thr, Thr1?, Ag, St1).
procedure second(Peer?, St?, YesNo).
second(Q, St, B?) :- ground(St?) |
    st_sent(St?, Se),
    st_recd(St?, Rc),
    known_peer(Q?, Se?, Rc?, B).
procedure discover_q(YesNo?, Peer?, St?, Stream(Txn), Stream(Txn)?,
    Stream(Trigger), St).
discover_q(yes, Q, St, [discover(Q?)|Thr1?], Thr1, Ag?, St1?) :- ground(Q?) |
    take_pending(Q?, St?, Ag, St1).
discover_q(no, _, St, Thr1?, Thr1, [], St?).

procedure take_pending(Peer?, St?, Stream(Trigger), St).
take_pending(Q, St, Ag?, St1?) :- ground(St?) |
    st_pends(St?, Pd),
    split_pends(Pd?, Q?, Ag, Rest),
    set_pends(St?, Rest?, St1).
procedure split_pends(Pends?, Peer?, Stream(Trigger), Pends).
split_pends([], _, [], []).
split_pends([pend(P, M)|Ps], Q, [net(M?)|Ag?], R?) :- P? =?= Q? |
    split_pends(Ps?, Q?, Ag, R).
split_pends([X|Ps], Q, Ag?, [X?|R?]) :- otherwise |
    split_pends(Ps?, Q?, Ag, R).

%% --- Start, Tally and Outcome, on the arriving message ----------------------
%% One schema to a cargo.  Start's condition is that the attempt's initiator is
%% known, Tally's that every other participant is, Outcome's none; a message
%% whose schema's condition fails on a peer not yet known is pending on it, and
%% one whose class the agent does not take part in is dropped.  Start defers,
%% and does not refuse, the start of an initiator that precedes the agent in
%% the order of identifiers while the agent holds prepared an attempt it
%% initiated, the attempt not closed: the message waits among the pending,
%% put up again when the app state changes (vGLP 2026-10-12 08:26 UTC, Q-A).
procedure message_cond(Cargo?, St?, MCond, St).
message_cond(X, St, Cd?, St2?) :- ground(X?), ground(St?) |
    cargo_class(X?, C),
    st_class(C?, St?, R, St1),
    message_cond1(R?, X?, St1?, Cd, St2).
procedure message_cond1(ClassRes?, Cargo?, St?, MCond, St).
message_cond1(nocls, _, St, mdrop, St?).
message_cond1(cls(I), start(At), St, Cd?, St?) :- ground(At?), ground(St?) |
    attempt_id(At?, P),
    peer_cond(P?, St?, I?, Cd0),
    defer_cond(Cd0?, At?, St?, Cd).
message_cond1(cls(I), vote(_, _), St, Cd?, St?) :- ground(I?), ground(St?) |
    others_known(I?, St?, K),
    known_cond2(K?, I?, Cd).
message_cond1(cls(I), outcome(_, _), St, mgo(I?), St?).
procedure peer_cond(Peer?, St?, Info?, MCond).
peer_cond(P, St, I, Cd?) :- ground(P?), ground(St?) |
    st_sent(St?, Se),
    st_recd(St?, Rc),
    known_peer(P?, Se?, Rc?, Kn),
    peer_cond1(Kn?, P?, I?, Cd).
procedure peer_cond1(YesNo?, Peer?, Info?, MCond).
peer_cond1(yes, _, I, mgo(I?)).
peer_cond1(no, P, _, mpend(P?)).
procedure known_cond2(Known?, Info?, MCond).
known_cond2(allknown, I, mgo(I?)).
known_cond2(unknown(P), _, mpend(P?)).
procedure defer_cond(MCond?, Attempt?, St?, MCond).
defer_cond(mpend(P), _, _, mpend(P?)).
defer_cond(mdefer, _, _, mdefer).
defer_cond(mdrop, _, _, mdrop).
defer_cond(mgo(I), At, St, Cd?) :- ground(At?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    defers(At?, Id?, Ap?, D),
    defer_cond1(D?, I?, Cd).
procedure defer_cond1(YesNo?, Info?, MCond).
defer_cond1(yes, _, mdefer).
defer_cond1(no, I, mgo(I?)).
procedure defers(Attempt?, Peer?, App?, YesNo).
defers(At, Id, app(_, _, L, R), D?) :- ground(At?), ground(Id?), ground(R?) |
    mem(closed(At?), R?, Cl),
    neg(Cl?, Open),
    own_held(L?, Id?, Own),
    attempt_id(At?, P),
    precedes(P?, Id?, Pr),
    and(Open?, Own?, D1),
    and(D1?, Pr?, D).
procedure own_held(Lock?, Peer?, YesNo).
own_held(unlocked, _, no).
own_held(held(A), Id, B?) :- attempt_id(A?, P), same(P?, Id?, B).
procedure cargo_class(Cargo?, Class).
cargo_class(start(attempt(_, _, C)), C?).
cargo_class(vote(attempt(_, _, C), _), C?).
cargo_class(outcome(attempt(_, _, C), _), C?).

procedure dispatch_message(MCond?, Net?, Peer?, Cargo?, Then?, App?,
    Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Demand),
    Stream(Txn), Stream(Net), OpenCards?, St?).
dispatch_message(mdrop, _, _, _, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).
dispatch_message(mpend(P), M, _, _, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards,
        St) :-
    add_pend(pend(P?, M?), St?, St1),
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St1?).
dispatch_message(mdefer, M, _, _, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards,
        St) :-
    add_pend(deferred(M?), St?, St1),
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St1?).
dispatch_message(mgo(I), _, _, start(At), Th, Ap0, Ls, In, Ans?, Dem?,
        [start(At?)|Thr?], Out?, Cards, St) :-
    ground(At?) |
    start_effect(I?, At?, St?, Ss, Cr, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    spawn(Cr?, Cards?, Cards1, Ans, Ans1?),
    next(Th?, no, Ap0?, [], Ls?, In?, Ans1, Dem, Thr, Out1, Cards1?, St2?).
dispatch_message(mgo(I), _, F, vote(At, Y), Th, Ap0, Ls, In, Ans?, Dem?,
        [tally(At?)|Thr?], Out?, Cards, St) :-
    ground(At?) |
    tally_effect(I?, At?, F?, Y?, St?, Ss, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out1, Cards?, St2?).
dispatch_message(mgo(I), _, _, outcome(At, Z), Th, Ap0, Ls, In, Ans?, Dem?,
        [outcome(At?)|Thr?], Out?, Cards, St) :-
    ground(At?) |
    outcome_effect(I?, At?, Z?, St?, St1),
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St1?).

%% Start raises the card, whose answers join the agent goal's input.
procedure spawn(CardRes?, OpenCards?, OpenCards, Stream(Trigger),
    Stream(Trigger)?).
spawn(nocard, Cs, Cs?, Ans?, Ans).
spawn(card_for(At), Cs, [oc(At?, Cl)|Cs?], Ans?, Ans1) :- ground(At?) |
    respond(At?, Cl?, R),
    merge(R?, Ans1?, Ans).

%% --- Answer, on the person's answer to the card Start raises ---------------
%% Its condition: the attempt a question pending at the agent, its initiator
%% known, as Start's condition made it.
procedure answer_cond(Attempt?, St?, Cond, St).
answer_cond(At, St, Cd?, St2?) :- ground(At?), ground(St?) |
    attempt_class(At?, C),
    st_class(C?, St?, R, St1),
    answer_cond1(R?, At?, St1?, Cd, St2).
procedure answer_cond1(ClassRes?, Attempt?, St?, Cond, St).
answer_cond1(nocls, _, St, drop, St?).
answer_cond1(cls(I), At, St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, R),
    pending_rec(At?, R?, P),
    attempt_id(At?, Q),
    st_sent(St?, Se),
    st_recd(St?, Rc),
    known_peer(Q?, Se?, Rc?, Kn),
    and(P?, Kn?, Ok),
    go_or_drop(Ok?, I?, Cd).

procedure dispatch_answer(Cond?, YesNo?, Attempt?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Demand), Stream(Txn), Stream(Net),
    OpenCards?, St?).
dispatch_answer(go(I), YN, At, Th, Ap0, Ls, In, Ans?, Dem?, [answer(At?)|Thr?],
        Out?, Cards, St) :-
    ground(At?) |
    answer_effect(I?, YN?, At?, St?, Ss, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out1, Cards?, St2?).
dispatch_answer(drop, _, _, Th, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    next(Th?, no, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).

%% A card is closed by binding its close signal, which also forgets it.
procedure close_card(Attempt?, OpenCards?, OpenCards).
close_card(_, [], []).
close_card(At, [oc(B, close)|Cs], Cs?) :- At? =?= B? | true.
close_card(At, [oc(B, Cl?)|Cs], [oc(B?, Cl)|Cs1?]) :- otherwise |
    close_card(At?, Cs?, Cs1).

%% The cards whose question is no longer pending, closed, where the app state
%% has changed.
procedure close_falsified(YesNo?, OpenCards?, St?, OpenCards).
close_falsified(no, Cs, _, Cs?).
close_falsified(yes, Cs, St, Cs1?) :- ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, R),
    close_cards(Cs?, R?, Cs1).
procedure close_cards(OpenCards?, Recs?, OpenCards).
close_cards([], _, []).
close_cards([oc(At, Cl?)|Cs], R, Cs1?) :- ground(At?), ground(R?) |
    pending_rec(At?, R?, P),
    close_one(P?, At?, Cl, Cs?, R?, Cs1).
procedure close_one(YesNo?, Attempt?, Close, OpenCards?, Recs?, OpenCards).
close_one(no, _, close, Cs, R, Cs1?) :- close_cards(Cs?, R?, Cs1).
close_one(yes, At, Cl?, Cs, R, [oc(At?, Cl)|Cs1?]) :- close_cards(Cs?, R?, Cs1).

%% --- The tick: Propose of the opening classes ------------------------------
%% It advances the date and takes, among the opening classes of the agent
%% whose Propose's condition holds, one of the class that has waited longest,
%% ties broken in the order the classes are opened.
procedure tick(Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger),
    Stream(Demand), Stream(Txn), Stream(Net), OpenCards?, St?).
tick(Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :- ground(St?) |
    st_app(St?, Ap0),
    advance(St?, St1),
    tick_cond(St1?, Ch, St2),
    dispatch_tick(Ch?, Ap0?, Ls?, In?, Ans, Dem, Thr, Out, Cards?, St2?).

procedure tick_cond(St?, Choice, St).
tick_cond(St, Ch?, St2?) :- ground(St?) |
    opening(St?, Is, St1),
    tick_cond1(Is?, St1?, Ch, St2).
procedure tick_cond1(Infos?, St?, Choice, St).
tick_cond1(Is, St, Ch?, St1?) :- ground(Is?), ground(St?) |
    op_cands(Is?, St?, Cs),
    st_waits(St?, W),
    st_date(St?, D),
    choose(Cs?, W?, D?, Ch, W1),
    set_waits(St?, W1?, St1).

%% Propose of an unguarded class, by its opener: the class unguarded, the agent
%% its opener, ready for it and knowing every other participant, and no start
%% of an initiator preceding the agent waiting among its pending messages.
procedure op_cands(Infos?, St?, Cands).
op_cands([], _, []).
op_cands([I|Is], St, Cs?) :- ground(I?), ground(St?) |
    unguarded_i(I?, Ug),
    opener_i(I?, St?, Op),
    ready_i(I?, St?, Rd),
    others_known(I?, St?, K),
    known_ok(K?, Kn),
    no_prior_start(St?, Np),
    and(Ug?, Op?, B1),
    and(B1?, Rd?, B2),
    and(B2?, Kn?, B3),
    and(B3?, Np?, B),
    op_cands(Is?, St?, Cs1),
    keep_cand(B?, I?, Cs1?, Cs).
procedure keep_cand(YesNo?, Info?, Cands?, Cands).
keep_cand(yes, I, Cs, [cand(op(C?), I?)|Cs?]) :- ground(I?) | info_name(I?, C).
keep_cand(no, _, Cs, Cs?).

procedure dispatch_tick(Choice?, App?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger), Stream(Demand), Stream(Txn), Stream(Net), OpenCards?, St?).
dispatch_tick(none, Ap0, Ls, In, Ans?, Dem?, Thr?, Out?, Cards, St) :-
    next(done, yes, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out, Cards?, St?).
dispatch_tick(take(I), Ap0, Ls, In, Ans?, Dem?, [propose(At?)|Thr?], Out?, Cards,
        St) :-
    ground(I?) |
    info_name(I?, C),
    propose_effect(I?, C?, St?, At, Ss, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next(done, yes, Ap0?, [], Ls?, In?, Ans, Dem, Thr, Out1, Cards?, St2?).

%% The unguarded classes the agent opens at its state: each unguarded schema at
%% the bindings that send its first role to the agent and meet that role's
%% requirements, its other variables named by the agent; each class of them
%% joins the classes met.
procedure opening(St?, Infos, St).
opening(St, Is?, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    app_state(Ap?, S),
    contract_schemas(Ss),
    reflexive_preds(Rf),
    opening1(Ss?, Rf?, Id?, S?, St?, Is, St1).
procedure opening1(Schemas?, Preds?, Peer?, GAtoms?, St?, Infos, St).
opening1(Ss, Rf, Id, S, St, Is?, St1?) :- ground(Id?), ground(S?) |
    hat(Rf?, Id?, S?, Sh),
    opened(Ss?, Id?, Sh?, Cs),
    meet_all(Cs?, St?, [], Is0, St1),
    dedup(Is0?, Is).
procedure opened(Schemas?, Peer?, GAtoms?, Stream(Class)).
opened([], _, _, []).
opened([schema(Nm, Rs)|Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) |
    guard_roles(Rs?, 1, Gs),
    opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1),
    opened(Ss?, Id?, Sh?, C2),
    app(C1?, C2?, Cs).
procedure opened1(Ints?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened1([_|_], _, _, _, _, []).
opened1([], _, [], _, _, []).
opened1([], Nm, [R|Rs], Id, Sh, Cs?) :- ground(R?), ground(Id?), ground(Sh?) |
    rs_req(R?, Q),
    match_all(Q?, Sh?, [b(role(1), p(Id?))], Bs),
    opened2(Bs?, Nm?, [R?|Rs?], Id?, Sh?, Cs).
procedure opened2(Bindings?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened2([], _, _, _, _, []).
opened2([B|Bs], Nm, Rs, Id, Sh, Cs?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) |
    first_spec(Rs?, R1),
    cand_ok([R1?], B?, Sh?, Ok),
    opened3(Ok?, Nm?, B?, Id?, C1),
    opened2(Bs?, Nm?, Rs?, Id?, Sh?, C2),
    app(C1?, C2?, Cs).
procedure opened3(YesNo?, Constant?, Binding?, Peer?, Stream(Class)).
opened3(no, _, _, _, []).
opened3(yes, Nm, B, Id, [C?]) :- class_of(Nm?, B?, Id?, C).
procedure first_spec(RoleSpecs?, RoleSpec).
first_spec([R|_], R?).
first_spec([], rs(unguarded, [], [], [], [])).

procedure meet_all(Stream(Class)?, St?, Infos?, Infos, St).
meet_all([], St, Is, Is?, St?).
meet_all([C|Cs], St, Is, Is2?, St2?) :- ground(C?), ground(St?) |
    st_class(C?, St?, R, St1),
    add_cls(R?, Is?, Is1),
    meet_all(Cs?, St1?, Is1?, Is2, St2).
procedure add_cls(ClassRes?, Infos?, Infos).
add_cls(nocls, Is, Is?).
add_cls(cls(I), Is, Is1?) :- app(Is?, [I?], Is1).

%% --- Choosing the instance of the class that has waited longest -----------
procedure choose(Cands?, Waits?, Integer?, Choice, Waits).
choose(Cs, W, D, Ch?, W2?) :- ground(Cs?), ground(W?), integer(D?) |
    ensure_waits(Cs?, W?, D?, W1),
    choose1(Cs?, W1?, D?, Ch, W2).
procedure choose1(Cands?, Waits?, Integer?, Choice, Waits).
choose1(Cs, W1, D, Ch?, W2?) :- ground(W1?) |
    pick(Cs?, W1?, Ch, Ky),
    retake(Ky?, W1?, D?, W2).
procedure ensure_waits(Cands?, Waits?, Integer?, Waits).
ensure_waits([], W, _, W?).
ensure_waits([cand(K, _)|Cs], W, D, W2?) :- ground(K?), ground(W?), integer(D?) |
    wait_of(K?, W?, F),
    ensure1(F?, K?, W?, D?, W1),
    ensure_waits(Cs?, W1?, D?, W2).
procedure ensure1(WFound?, WKey?, Waits?, Integer?, Waits).
ensure1(at(_), _, W, _, W?).
ensure1(unseen, K, W, D, [w(K?, D?)|W?]).
procedure wait_of(WKey?, Waits?, WFound).
wait_of(_, [], unseen).
wait_of(K, [w(K1, T)|_], at(T?)) :- K? =?= K1? | true.
wait_of(K, [_|Ws], F?) :- otherwise | wait_of(K?, Ws?, F).
procedure pick(Cands?, Waits?, Choice, PKey).
pick([], _, none, nokey).
pick([cand(K, I)|Cs], W, Ch?, Ky?) :- ground(K?), ground(W?) |
    tick_at(K?, W?, T),
    best(Cs?, W?, T?, K?, I?, Ch, Ky).
procedure best(Cands?, Waits?, Integer?, WKey?, Info?, Choice, PKey).
best([], _, _, K, I, take(I?), key(K?)).
best([cand(K2, I2)|Cs], W, T, K, I, Ch?, Ky?) :- ground(K2?), ground(W?) |
    tick_at(K2?, W?, T2),
    best1(T2?, T?, K2?, I2?, K?, I?, Cs?, W?, Ch, Ky).
procedure best1(Integer?, Integer?, WKey?, Info?, WKey?, Info?, Cands?, Waits?,
    Choice, PKey).
best1(T2, T, K2, I2, _, _, Cs, W, Ch?, Ky?) :- T2? < T? |
    best(Cs?, W?, T2?, K2?, I2?, Ch, Ky).
best1(T2, T, _, _, K, I, Cs, W, Ch?, Ky?) :- T2? >= T? |
    best(Cs?, W?, T?, K?, I?, Ch, Ky).
procedure tick_at(WKey?, Waits?, Integer).
tick_at(K, W, T?) :- wait_of(K?, W?, F), tick_of(F?, T).
procedure tick_of(WFound?, Integer).
tick_of(at(T), T?).
tick_of(unseen, 0).
procedure retake(PKey?, Waits?, Integer?, Waits).
retake(nokey, W, _, W?).
retake(key(K), W, D, W1?) :- set_wait(K?, D?, W?, W1).
procedure set_wait(WKey?, Integer?, Waits?, Waits).
set_wait(K, D, [], [w(K?, D?)]).
set_wait(K, D, [w(K1, _)|Ws], [w(K1?, D?)|Ws?]) :- K? =?= K1? | true.
set_wait(K, D, [X|Ws], [X?|Ws1?]) :- otherwise | set_wait(K?, D?, Ws?, Ws1).

%% ===========================================================================
%% The app transactions' effects (Definition "Canonical CVA Platform")
%% ===========================================================================

%% Propose: the attempt's number one more than the agent's, recorded voted
%% yes; applied and closed at once where the agent is the class's only
%% participant, and otherwise held prepared and its start told to every other
%% participant.
procedure propose_effect(Info?, Class?, St?, Attempt, Sends, St).
propose_effect(I, C, St, At?, Ss?, St1?) :- ground(C?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    st_app(St?, Ap0),
    app_count(Ap0?, K),
    K1 := K? + 1,
    propose_app(I?, attempt(Id?, K1?, C?), Ap?, At, Ss, Ap1),
    set_app(St?, Ap1?, St1).
procedure propose_app(Info?, Attempt?, App?, Attempt, Sends, App).
propose_app(I, At, Ap, At?, Ss?, Ap1?) :- ground(I?), ground(At?) |
    attempt_id(At?, Id),
    info_q(I?, Q),
    only_me(Q?, Id?, One),
    propose_app1(One?, I?, At?, Ap?, Ss, Ap1).
procedure propose_app1(YesNo?, Info?, Attempt?, App?, Sends, App).
propose_app1(yes, I, At, app(S, _, L, R), [],
        app(S1?, K?, L?, [closed(At?), voted(At?, yes)|R?])) :-
    ground(At?) |
    attempt_id(At?, Id),
    attempt_k(At?, K),
    apply_info(I?, Id?, S?, S1).
propose_app1(no, I, At, app(S, _, _, R), Ss?,
        app(S?, K?, held(At?), [voted(At?, yes)|R?])) :-
    ground(At?), ground(I?) |
    attempt_id(At?, Id),
    attempt_k(At?, K),
    info_q(I?, Q),
    tell(Q?, Id?, start(At?), Ss).
procedure only_me(Peers?, Peer?, YesNo).
only_me([P], Id, yes) :- P? =?= Id? | true.
only_me(_, _, no) :- otherwise | true.

%% Tell: the cargo to every participant other than the agent.
procedure tell(Peers?, Peer?, Cargo?, Sends).
tell([], _, _, []).
tell([Q|Qs], Id, X, Ss?) :- ground(Q?), ground(Id?), ground(X?) |
    same(Q?, Id?, Me),
    tell1(Me?, Q?, X?, Ss1?, Ss),
    tell(Qs?, Id?, X?, Ss1).
procedure tell1(YesNo?, Peer?, Cargo?, Sends?, Sends).
tell1(yes, _, _, Ss, Ss?).
tell1(no, Q, X, Ss, [to(Q?, X?)|Ss?]).

%% Vote: record the vote, send it to the initiator, and on yes hold the
%% attempt prepared.
procedure vote_app(Attempt?, YesNo?, App?, Sends, App).
vote_app(At, yes, app(S, K, _, R), [to(I?, vote(At?, yes))],
        app(S?, K?, held(At?), [voted(At?, yes)|R?])) :-
    ground(At?) |
    attempt_id(At?, I).
vote_app(At, no, app(S, K, L, R), [to(I?, vote(At?, no))],
        app(S?, K?, L?, [voted(At?, no)|R?])) :-
    ground(At?) |
    attempt_id(At?, I).

%% Start: nothing more where the attempt is closed; otherwise no where the
%% agent is not ready for the class, and, where it is, the question recorded
%% and the card raised where the agent is asked, and yes where it is not.
procedure start_effect(Info?, Attempt?, St?, Sends, CardRes, St).
start_effect(I, At, St, Ss?, Cr?, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    start_app(I?, At?, Id?, Ap?, Ss, Cr, Ap1),
    set_app(St?, Ap1?, St1).
procedure start_app(Info?, Attempt?, Peer?, App?, Sends, CardRes, App).
start_app(I, At, Id, Ap, Ss?, Cr?, Ap1?) :- ground(At?), ground(Ap?) |
    app_recs(Ap?, R),
    mem(closed(At?), R?, Cl),
    start_app1(Cl?, I?, At?, Id?, Ap?, Ss, Cr, Ap1).
procedure start_app1(YesNo?, Info?, Attempt?, Peer?, App?, Sends, CardRes, App).
start_app1(yes, _, _, _, Ap, [], nocard, Ap?).
start_app1(no, I, At, Id, Ap, Ss?, Cr?, Ap1?) :-
    ground(I?), ground(At?), ground(Id?), ground(Ap?) |
    ready_app(I?, Id?, Ap?, Rd),
    asked_by(I?, At?, Id?, Ak),
    start_app2(Rd?, Ak?, At?, Ap?, Ss, Cr, Ap1).
procedure start_app2(YesNo?, YesNo?, Attempt?, App?, Sends, CardRes, App).
start_app2(no, _, At, Ap, Ss?, nocard, Ap1?) :- vote_app(At?, no, Ap?, Ss, Ap1).
start_app2(yes, yes, At, app(S, K, L, R), [], card_for(At?),
        app(S?, K?, L?, [asked(At?)|R?])) :-
    ground(At?) | true.
start_app2(yes, no, At, Ap, Ss?, nocard, Ap1?) :- vote_app(At?, yes, Ap?, Ss, Ap1).

%% The agent is asked by an attempt where it is in the attempt's guard set,
%% the guard set of the class containing the initiator, and is not the
%% initiator; an unguarded class's attempt asks nobody.
procedure asked_by(Info?, Attempt?, Peer?, YesNo).
asked_by(I, At, Id, B?) :- ground(At?) |
    attempt_id(At?, P),
    asked_by1(I?, P?, Id?, B).
procedure asked_by1(Info?, Peer?, Peer?, YesNo).
asked_by1(I, P, Id, B?) :- ground(P?), ground(Id?) |
    info_gsets(I?, G),
    gset_of(G?, P?, Gs),
    mem(Id?, Gs?, In),
    same(Id?, P?, Me),
    neg(Me?, NotMe),
    and(In?, NotMe?, B).
procedure gset_of(PeerSets?, Peer?, Peers).
gset_of([], _, []).
gset_of([G|Gs], P, R?) :- ground(G?), ground(P?) |
    mem(P?, G?, B),
    gset_of1(B?, G?, Gs?, P?, R).
procedure gset_of1(YesNo?, Peers?, PeerSets?, Peer?, Peers).
gset_of1(yes, G, _, _, G?).
gset_of1(no, _, Gs, P, R?) :- gset_of(Gs?, P?, R).

%% Answer: on yes, yes where the agent holds nothing prepared and its state is
%% in the domain of its effect, and no otherwise; on no, its else-branch, no.
procedure answer_effect(Info?, YesNo?, Attempt?, St?, Sends, St).
answer_effect(I, YN, At, St, Ss?, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    answer_app(YN?, I?, At?, Id?, Ap?, Ss, Ap1),
    set_app(St?, Ap1?, St1).
procedure answer_app(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
answer_app(yes, I, At, Id, Ap, Ss?, Ap1?) :- ground(Ap?) |
    answer_yes(I?, Id?, Ap?, Y),
    vote_app(At?, Y?, Ap?, Ss, Ap1).
answer_app(no, _, At, _, Ap, Ss?, Ap1?) :- vote_app(At?, no, Ap?, Ss, Ap1).
procedure answer_yes(Info?, Peer?, App?, YesNo).
answer_yes(I, Id, app(S, _, L, _), Y?) :-
    unlocked(L?, B1),
    dom_ok(I?, Id?, S?, B2),
    and(B1?, B2?, Y).

%% Tally: nothing more where the attempt is closed; otherwise the vote
%% recorded, and on no the lock released, the attempt closed and abort told to
%% every other participant, and where a yes of every other participant is now
%% recorded the effect applied, the lock released, the attempt closed and
%% commit told.
procedure tally_effect(Info?, Attempt?, Peer?, YesNo?, St?, Sends, St).
tally_effect(I, At, F, Y, St, Ss?, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    tally_app(I?, At?, F?, Y?, Id?, Ap?, Ss, Ap1),
    set_app(St?, Ap1?, St1).
procedure tally_app(Info?, Attempt?, Peer?, YesNo?, Peer?, App?, Sends, App).
tally_app(I, At, F, Y, Id, Ap, Ss?, Ap1?) :- ground(At?), ground(Ap?) |
    app_recs(Ap?, R),
    mem(closed(At?), R?, Cl),
    tally_app1(Cl?, I?, At?, F?, Y?, Id?, Ap?, Ss, Ap1).
procedure tally_app1(YesNo?, Info?, Attempt?, Peer?, YesNo?, Peer?, App?, Sends,
    App).
tally_app1(yes, _, _, _, _, _, Ap, [], Ap?).
tally_app1(no, I, At, F, no, Id, app(S, K, _, R), Ss?,
        app(S?, K?, unlocked, [closed(At?), got(At?, F?, no)|R?])) :-
    ground(At?), ground(I?) |
    info_q(I?, Q),
    tell(Q?, Id?, outcome(At?, abort), Ss).
tally_app1(no, I, At, F, yes, Id, app(S, K, L, R), Ss?, Ap1?) :-
    ground(I?), ground(At?), ground(F?), ground(Id?), ground(R?) |
    all_yes(I?, At?, Id?, [got(At?, F?, yes)|R?], All),
    tally_app2(All?, I?, At?, Id?, app(S?, K?, L?, [got(At?, F?, yes)|R?]), Ss, Ap1).
procedure tally_app2(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
tally_app2(no, _, _, _, Ap, [], Ap?).
tally_app2(yes, I, At, Id, app(S, K, _, R), Ss?,
        app(S1?, K?, unlocked, [closed(At?)|R?])) :-
    ground(I?), ground(At?), ground(Id?) |
    apply_info(I?, Id?, S?, S1),
    info_q(I?, Q),
    tell(Q?, Id?, outcome(At?, commit), Ss).
procedure all_yes(Info?, Attempt?, Peer?, Recs?, YesNo).
all_yes(I, At, Id, R, B?) :- ground(At?), ground(Id?), ground(R?) |
    info_q(I?, Q),
    all_yes1(Q?, At?, Id?, R?, B).
procedure all_yes1(Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes1([], _, _, _, yes).
all_yes1([P|Ps], At, Id, R, B?) :- ground(P?), ground(At?), ground(Id?), ground(R?) |
    same(P?, Id?, Me),
    mem(got(At?, P?, yes), R?, G),
    or(Me?, G?, Ok),
    all_yes2(Ok?, Ps?, At?, Id?, R?, B).
procedure all_yes2(YesNo?, Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes2(no, _, _, _, _, no).
all_yes2(yes, Ps, At, Id, R, B?) :- all_yes1(Ps?, At?, Id?, R?, B).

%% Outcome: the effect applied on commit, the lock released where it holds the
%% attempt, and the attempt closed.
procedure outcome_effect(Info?, Attempt?, Decision?, St?, St).
outcome_effect(I, At, Z, St, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    outcome_app(I?, At?, Z?, Id?, Ap?, Ap1),
    set_app(St?, Ap1?, St1).
procedure outcome_app(Info?, Attempt?, Decision?, Peer?, App?, App).
outcome_app(I, At, commit, Id, app(S, K, L, R), app(S1?, K?, L1?, [closed(At?)|R?])) :-
    ground(At?) |
    apply_info(I?, Id?, S?, S1),
    release(L?, At?, L1).
outcome_app(_, At, abort, _, app(S, K, L, R), app(S?, K?, L1?, [closed(At?)|R?])) :-
    ground(At?) |
    release(L?, At?, L1).
procedure release(Lock?, Attempt?, Lock).
release(unlocked, _, unlocked).
release(held(A), At, unlocked) :- A? =?= At? | true.
release(held(A), _, held(A?)) :- otherwise | true.

%% The messages a transaction sends, each numbered by its sender.
procedure send_all(Sends?, St?, Nets, St).
send_all(Ss, st(Id, Ap, D, Se, Rc, N, W, Ca, Pd), Ms?,
        st(Id?, Ap?, D?, Se?, Rc?, N1?, W?, Ca?, Pd?)) :-
    ground(Id?) |
    number_msgs(Ss?, Id?, N?, Ms, N1).
procedure number_msgs(Sends?, Peer?, Integer?, Nets, Integer).
number_msgs([], _, N, [], N?).
number_msgs([to(T, X)|Ss], Id, N, [msg(T?, cargo(Id?, N?, X?))|Ms?], N2?) :-
    ground(Id?), integer(N?) |
    N1 := N? + 1,
    number_msgs(Ss?, Id?, N1?, Ms, N2).

procedure put_all(Nets?, Stream(Net), Stream(Net)?).
put_all([], Out?, Out).
put_all([M|Ms], [M?|Out?], Cont) :- put_all(Ms?, Out, Cont?).

%% ===========================================================================
%% Conditions, over the app state (Definition "Attempt, Message, App State,
%% Question, Ready")
%% ===========================================================================

%% Ready for [t]: free for it, the lock unlocked and no question of [t]
%% pending, and the state in the domain of the agent's effect.
procedure ready_i(Info?, St?, YesNo).
ready_i(I, St, B?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    ready_app(I?, Id?, Ap?, B).
procedure ready_app(Info?, Peer?, App?, YesNo).
ready_app(I, Id, app(S, _, L, R), B?) :- ground(I?), ground(R?) |
    unlocked(L?, B1),
    no_question(I?, R?, R?, B2),
    dom_ok(I?, Id?, S?, B3),
    and(B1?, B2?, B12),
    and(B12?, B3?, B).
procedure unlocked(Lock?, YesNo).
unlocked(unlocked, yes).
unlocked(held(_), no).

%% No question of the class pending: no attempt of it recorded asked, with no
%% vote on it and not closed.
procedure no_question(Info?, Recs?, Recs?, YesNo).
no_question(_, [], _, yes).
no_question(I, [asked(At)|Rs], R, B?) :- ground(I?), ground(At?), ground(R?) |
    pending_rec(At?, R?, P),
    of_class(At?, I?, Cl),
    and(P?, Cl?, Q),
    no_question1(Q?, I?, Rs?, R?, B).
no_question(I, [_|Rs], R, B?) :- otherwise | no_question(I?, Rs?, R?, B).
procedure no_question1(YesNo?, Info?, Recs?, Recs?, YesNo).
no_question1(yes, _, _, _, no).
no_question1(no, I, Rs, R, B?) :- no_question(I?, Rs?, R?, B).

%% A question pending: recorded asked, with no vote and not closed.
procedure pending_rec(Attempt?, Recs?, YesNo).
pending_rec(At, R, B?) :- ground(At?), ground(R?) |
    mem(asked(At?), R?, B1),
    has_vote(At?, R?, B2),
    mem(closed(At?), R?, B3),
    or(B2?, B3?, B23),
    neg(B23?, B4),
    and(B1?, B4?, B).
procedure has_vote(Attempt?, Recs?, YesNo).
has_vote(_, [], no).
has_vote(At, [voted(A, _)|_], yes) :- At? =?= A? | true.
has_vote(At, [_|Rs], B?) :- otherwise | has_vote(At?, Rs?, B).

%% Whether an attempt's class is the class of an entry: the same participants
%% and the same atoms deleted and added at each.
procedure of_class(Attempt?, Info?, YesNo).
of_class(attempt(_, _, C), ci(_, Ps, _, _, _, _), B?) :- ground(C?), ground(Ps?) |
    class_parts(C?, Ps1),
    parts_eq(Ps?, Ps1?, B).
procedure class_parts(Class?, Parts).
class_parts(C, Ps?) :- ground(C?) |
    binding_of(C?, Nm, B),
    class_parts1(Nm?, B?, Ps).
procedure class_parts1(Constant?, Binding?, Parts).
class_parts1(Nm, B, Ps?) :- ground(Nm?) |
    schema_spec(Nm?, Rs),
    sig_of(Rs?, B?, Ps).

%% The participants other than the agent known, or the first that is not.
procedure others_known(Info?, St?, Known).
others_known(I, St, K?) :- ground(St?) |
    info_q(I?, Q),
    st_id(St?, Id),
    st_sent(St?, Se),
    st_recd(St?, Rc),
    first_unknown(Q?, Id?, Se?, Rc?, K).
procedure first_unknown(Peers?, Peer?, Peers?, Peers?, Known).
first_unknown([], _, _, _, allknown).
first_unknown([P|Ps], Id, Se, Rc, K?) :- ground(P?), ground(Id?), ground(Se?), ground(Rc?) |
    same(P?, Id?, Me),
    known_peer(P?, Se?, Rc?, Kn),
    or(Me?, Kn?, Ok),
    first_unknown1(Ok?, P?, Ps?, Id?, Se?, Rc?, K).
procedure first_unknown1(YesNo?, Peer?, Peers?, Peer?, Peers?, Peers?, Known).
first_unknown1(yes, _, Ps, Id, Se, Rc, K?) :- first_unknown(Ps?, Id?, Se?, Rc?, K).
first_unknown1(no, P, _, _, _, _, unknown(P?)).
procedure known_peer(Peer?, Peers?, Peers?, YesNo).
known_peer(P, Se, Rc, B?) :- ground(P?) |
    mem(P?, Se?, B1),
    mem(P?, Rc?, B2),
    and(B1?, B2?, B).
procedure known_ok(Known?, YesNo).
known_ok(allknown, yes).
known_ok(unknown(_), no).
procedure go_or_drop(YesNo?, Info?, Cond).
go_or_drop(yes, I, go(I?)).
go_or_drop(no, _, drop).

%% An agent proposes only where no start of an initiator preceding it waits
%% among its pending messages, deferred or pending on a peer not yet known, so
%% that it handles such a start before it proposes again (vGLP 2026-10-12
%% 08:26 UTC, Q-A).
procedure no_prior_start(St?, YesNo).
no_prior_start(St, B?) :- ground(St?) |
    st_id(St?, Id),
    st_pends(St?, Pd),
    prior_start(Pd?, Id?, P),
    neg(P?, B).
procedure prior_start(Pends?, Peer?, YesNo).
prior_start([], _, no).
prior_start([X|Ps], Id, B?) :- ground(Id?) |
    pend_net(X?, M),
    net_prior(M?, Id?, B1),
    prior_start1(B1?, Ps?, Id?, B).
procedure prior_start1(YesNo?, Pends?, Peer?, YesNo).
prior_start1(yes, _, _, yes).
prior_start1(no, Ps, Id, B?) :- prior_start(Ps?, Id?, B).
procedure pend_net(Pend?, Net).
pend_net(pend(_, M), M?).
pend_net(deferred(M), M?).
procedure net_prior(Net?, Peer?, YesNo).
net_prior(msg(_, cargo(_, _, start(attempt(P, _, _)))), Id, B?) :- precedes(P?, Id?, B).
net_prior(_, _, no) :- otherwise | true.
procedure precedes(Peer?, Peer?, YesNo).
precedes(P, Q, yes) :- P? @< Q? | true.
precedes(_, _, no) :- otherwise | true.

procedure guard_of_i(Info?, St?, YesNo).
guard_of_i(I, St, B?) :- info_gsets(I?, G), st_id(St?, Id), in_some(Id?, G?, B).
procedure unguarded_i(Info?, YesNo).
unguarded_i(I, B?) :- info_gsets(I?, G), only_empty(G?, B).
procedure opener_i(Info?, St?, YesNo).
opener_i(ci(_, _, _, _, Op, _), St, B?) :- st_id(St?, Id), is_opener(Op?, Id?, B).
procedure is_opener(Opener?, Peer?, YesNo).
is_opener(opener(P), Id, B?) :- same(P?, Id?, B).
is_opener(guarded_class, _, no).
procedure only_empty(PeerSets?, YesNo).
only_empty([[]], yes).
only_empty(_, no) :- otherwise | true.
procedure in_some(Peer?, PeerSets?, YesNo).
in_some(_, [], no).
in_some(P, [G|Gs], B?) :- ground(P?) | mem(P?, G?, B1), in_some1(B1?, P?, Gs?, B).
procedure in_some1(YesNo?, Peer?, PeerSets?, YesNo).
in_some1(yes, _, _, yes).
in_some1(no, P, Gs, B?) :- in_some(P?, Gs?, B).
procedure all_in(Peers?, Peers?, YesNo).
all_in([], _, yes).
all_in([P|Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).
procedure all_in1(YesNo?, Peers?, Peers?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).
%% f^[t]_p is defined at d iff some schema-binding of the class has the atoms
%% it requires at p in d (with the atom of each reflexive predicate naming p)
%% and those it forbids there not; it yields d less the deleted atoms plus the
%% added ones.
procedure dom_ok(Info?, Peer?, GAtoms?, YesNo).
dom_ok(ci(_, _, _, _, _, Ms), Id, S, B?) :- ground(Id?), ground(S?) |
    reflexive_preds(Rf),
    hat(Rf?, Id?, S?, Sh),
    mates_dom(Ms?, Id?, Sh?, B).
procedure hat(Preds?, Peer?, GAtoms?, GAtoms).
hat([], _, S, S?).
hat([P|Ps], Id, S, [g(P?, [p(Id?)])|R?]) :- ground(Id?) | hat(Ps?, Id?, S?, R).
procedure mates_dom(Mates?, Peer?, GAtoms?, YesNo).
mates_dom([], _, _, no).
mates_dom([mate(Nm, B, _, _)|Ms], Id, Sh, R?) :- ground(Id?), ground(Sh?) |
    schema_spec(Nm?, Rs),
    mate_dom(Rs?, B?, Id?, Sh?, R1),
    mates_dom1(R1?, Ms?, Id?, Sh?, R).
procedure mates_dom1(YesNo?, Mates?, Peer?, GAtoms?, YesNo).
mates_dom1(yes, _, _, _, yes).
mates_dom1(no, Ms, Id, Sh, R?) :- mates_dom(Ms?, Id?, Sh?, R).
procedure mate_dom(RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
mate_dom(Rs, B, Id, Sh, R?) :- ground(Rs?), ground(B?), ground(Id?), ground(Sh?) |
    specs_at(Rs?, 1, B?, Id?, RsP),
    mate_dom1(RsP?, B?, Sh?, R).
procedure mate_dom1(RoleSpecs?, Binding?, GAtoms?, YesNo).
mate_dom1(RsP, B, Sh, R?) :- ground(RsP?), ground(Sh?) |
    reqs_of(RsP?, Q),
    match_all(Q?, Sh?, B?, Bs),
    cands_ok(Bs?, RsP?, Sh?, R).
procedure reqs_of(RoleSpecs?, SAtoms).
reqs_of([], []).
reqs_of([R|Rs], Q?) :- ground(R?) | rs_req(R?, Q1), reqs_of(Rs?, Q2), app(Q1?, Q2?, Q).
procedure cands_ok(Bindings?, RoleSpecs?, GAtoms?, YesNo).
cands_ok([], _, _, no).
cands_ok([B|Bs], RsP, Sh, R?) :- ground(RsP?), ground(Sh?) |
    cand_ok(RsP?, B?, Sh?, R1),
    cands_ok1(R1?, Bs?, RsP?, Sh?, R).
procedure cands_ok1(YesNo?, Bindings?, RoleSpecs?, GAtoms?, YesNo).
cands_ok1(yes, _, _, _, yes).
cands_ok1(no, Bs, RsP, Sh, R?) :- cands_ok(Bs?, RsP?, Sh?, R).
%% Each role's required atoms, as a multiset, in the state, and no forbidden
%% atom whose variables are all bound in it; one with a variable free is met
%% by a binding sending it to a person or speech act the state does not name.
procedure cand_ok(RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok([], _, _, yes).
cand_ok([R|Rs], B, Sh, Out?) :- ground(R?), ground(B?), ground(Sh?) |
    rs_req(R?, Q),
    img_atoms(Q?, B?, G),
    ms_sub(G?, Sh?, B1),
    rs_forb(R?, F),
    forb_ok(F?, B?, Sh?, B2),
    and(B1?, B2?, B3),
    cand_ok1(B3?, Rs?, B?, Sh?, Out).
procedure cand_ok1(YesNo?, RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok1(no, _, _, _, no).
cand_ok1(yes, Rs, B, Sh, Out?) :- cand_ok(Rs?, B?, Sh?, Out).
procedure forb_ok(SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok([], _, _, yes).
forb_ok([A|As], B, Sh, R?) :- ground(A?), ground(B?), ground(Sh?) |
    atom_bound(A?, B?, Bd),
    forb_one(Bd?, A?, B?, Sh?, R1),
    forb_ok1(R1?, As?, B?, Sh?, R).
procedure forb_one(YesNo?, SAtom?, Binding?, GAtoms?, YesNo).
forb_one(no, _, _, _, yes).
forb_one(yes, A, B, Sh, R?) :- ground(Sh?) |
    img_atom(A?, B?, G),
    mem(G?, Sh?, In),
    neg(In?, R).
procedure forb_ok1(YesNo?, SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok1(no, _, _, _, no).
forb_ok1(yes, As, B, Sh, R?) :- forb_ok(As?, B?, Sh?, R).

procedure apply_info(Info?, Peer?, GAtoms?, GAtoms).
apply_info(ci(_, Ps, _, _, _, _), Id, S, S1?) :- ground(Id?) |
    part_at(Ps?, Id?, D, A),
    ms_diff(S?, D?, S0),
    app(A?, S0?, S1).
procedure part_at(Parts?, Peer?, GAtoms, GAtoms).
part_at([], _, [], []).
part_at([part(P, D, A)|_], Id, D?, A?) :- P? =?= Id? | true.
part_at([_|Ps], Id, D?, A?) :- otherwise | part_at(Ps?, Id?, D, A).

%% ===========================================================================
%% Classes: from a term of the request type to the class it names
%% ===========================================================================

%% The class a term names, the agent's entry for it, met or new; nocls where
%% the binding is not one (Definition "Binding": two roles share a person only
%% if neither adds or deletes an atom naming the other; admissible), where it
%% determines nothing, or where the agent is no participant.
procedure st_class(Class?, St?, ClassRes, St).
st_class(C, st(Id, Ap, D, Se, Rc, N, W, Ca, Pd), R?,
        st(Id?, Ap?, D?, Se?, Rc?, N?, W?, Ca1?, Pd?)) :-
    ground(Id?) |
    class_info(C?, Id?, Ca?, R, Ca1).
procedure class_info(Class?, Peer?, Infos?, ClassRes, Infos).
class_info(C, Id, Ca, R?, Ca1?) :- ground(C?) |
    binding_of(C?, Nm, B),
    class_info1(Nm?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info1(Constant?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info1(Nm, B, C, Id, Ca, R?, Ca1?) :- ground(B?) |
    schema_spec(Nm?, Rs),
    class_info2(Rs?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info2(RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info2(Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) |
    rule_ok(Rs?, B?, V1),
    admissible(Rs?, B?, V2),
    and(V1?, V2?, V),
    class_info3(V?, Rs?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info3(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info3(no, _, _, _, _, Ca, nocls, Ca?).
class_info3(yes, Rs, B, C, Id, Ca, R?, Ca1?) :-
    sig_of(Rs?, B?, Ps),
    class_info4(Ps?, C?, Id?, Ca?, R, Ca1).
procedure class_info4(Parts?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info4(Ps, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Id?) |
    parts_valid(Ps?, V1),
    parts_peers(Ps?, Q),
    mem(Id?, Q?, V2),
    and(V1?, V2?, V),
    class_info5(V?, Ps?, C?, Ca?, R, Ca1).
procedure class_info5(YesNo?, Parts?, Class?, Infos?, ClassRes, Infos).
class_info5(no, _, _, Ca, nocls, Ca?).
class_info5(yes, Ps, C, Ca, R?, Ca1?) :- ground(Ps?), ground(Ca?) |
    cache_find(Ps?, Ca?, F),
    class_info6(F?, Ps?, C?, Ca?, R, Ca1).
procedure class_info6(ClassRes?, Parts?, Class?, Infos?, ClassRes, Infos).
class_info6(cls(I), _, _, Ca, cls(I?), Ca?).
class_info6(nocls, Ps, C, Ca, R?, Ca1?) :-
    new_info(C?, Ps?, I),
    add_info(I?, Ca?, R, Ca1).
procedure add_info(Info?, Infos?, ClassRes, Infos).
add_info(I, Ca, cls(I?), Ca1?) :- ground(I?) | app(Ca?, [I?], Ca1).

procedure cache_find(Parts?, Infos?, ClassRes).
cache_find(_, [], nocls).
cache_find(Ps, [ci(C, Ps1, Q, G, Op, Ms)|Is], R?) :- ground(Ps?), ground(Ps1?) |
    parts_eq(Ps?, Ps1?, E),
    cache_find1(E?, ci(C?, Ps1?, Q?, G?, Op?, Ms?), Ps?, Is?, R).
procedure cache_find1(YesNo?, Info?, Parts?, Infos?, ClassRes).
cache_find1(yes, I, _, _, cls(I?)).
cache_find1(no, _, Ps, Is, R?) :- cache_find(Ps?, Is?, R).

procedure new_info(Class?, Parts?, Info).
new_info(C, Ps, I?) :- ground(Ps?) |
    contract_schemas(Ss),
    mates_of(Ss?, Ps?, Ms0),
    dedup_mates(Ms0?, Ms),
    new_info1(C?, Ps?, Ms?, I).
procedure new_info1(Class?, Parts?, Mates?, Info).
new_info1(C, Ps, Ms, ci(C?, Ps?, Q?, G?, Op?, Ms?)) :- ground(Ps?), ground(Ms?) |
    parts_peers(Ps?, Q),
    mates_gsets(Ms?, G),
    mates_opener(Ms?, Op).

procedure info_name(Info?, Class).
info_name(ci(C, _, _, _, _, _), C?).
procedure info_q(Info?, Peers).
info_q(ci(_, _, Q, _, _, _), Q?).
procedure info_gsets(Info?, PeerSets).
info_gsets(ci(_, _, _, G, _, _), G?).

%% The participants of a class and the atoms each deletes and adds: the join
%% of those of the roles sent to it (Jurix, Definition "Compilation").
procedure sig_of(RoleSpecs?, Binding?, Parts).
sig_of(Rs, B, Ps?) :- ground(Rs?), ground(B?) |
    role_persons(Rs?, 1, B?, Ws),
    dedup(Ws?, Q),
    parts_for(Q?, Rs?, B?, Ps).
procedure role_persons(RoleSpecs?, Integer?, Binding?, Peers).
role_persons([], _, _, []).
role_persons([_|Rs], I, B, [P?|Ps?]) :- integer(I?), ground(B?) |
    role_person(I?, B?, P),
    I1 := I? + 1,
    role_persons(Rs?, I1?, B?, Ps).
procedure parts_for(Peers?, RoleSpecs?, Binding?, Parts).
parts_for([], _, _, []).
parts_for([P|Ps], Rs, B, [part(P?, D?, A?)|Xs?]) :- ground(P?), ground(Rs?), ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    joins(RsP?, B?, D, A),
    parts_for(Ps?, Rs?, B?, Xs).
procedure joins(RoleSpecs?, Binding?, GAtoms, GAtoms).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) |
    dels_join(RsP?, B?, [], D),
    adds_join(RsP?, B?, [], A).
procedure dels_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
dels_join([], _, Acc, Acc?).
dels_join([R|Rs], B, Acc, Out?) :- ground(B?) |
    rs_del(R?, D),
    img_atoms(D?, B?, G),
    ms_join(Acc?, G?, Acc1),
    dels_join(Rs?, B?, Acc1?, Out).
procedure adds_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
adds_join([], _, Acc, Acc?).
adds_join([R|Rs], B, Acc, Out?) :- ground(B?) |
    rs_add(R?, A),
    img_atoms(A?, B?, G),
    ms_join(Acc?, G?, Acc1),
    adds_join(Rs?, B?, Acc1?, Out).
procedure specs_at(RoleSpecs?, Integer?, Binding?, Peer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R|Rs], I, B, P, Out?) :- integer(I?), ground(B?), ground(P?) |
    role_person(I?, B?, Q),
    I1 := I? + 1,
    specs_at(Rs?, I1?, B?, P?, Rest),
    keep_spec(Q?, P?, R?, Rest?, Out).
procedure keep_spec(Peer?, Peer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R?|Rest?]) :- Q? =?= P? | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.
procedure parts_valid(Parts?, YesNo).
parts_valid([], yes).
parts_valid([part(_, D, A)|Ps], B?) :- ground(A?) |
    ms_meets(D?, A?, M),
    neg(M?, B1),
    parts_valid1(B1?, Ps?, B).
procedure parts_valid1(YesNo?, Parts?, YesNo).
parts_valid1(no, _, no).
parts_valid1(yes, Ps, B?) :- parts_valid(Ps?, B).
procedure parts_peers(Parts?, Peers).
parts_peers([], []).
parts_peers([part(P, _, _)|Ps], [P?|Qs?]) :- parts_peers(Ps?, Qs).
procedure parts_eq(Parts?, Parts?, YesNo).
parts_eq(A, B, E?) :- ground(A?), ground(B?) |
    len_parts(A?, La),
    len_parts(B?, Lb),
    same_int(La?, Lb?, E1),
    parts_in(A?, B?, E2),
    and(E1?, E2?, E).
procedure len_parts(Parts?, Integer).
len_parts([], 0).
len_parts([_|Ps], N?) :- len_parts(Ps?, M), N := M? + 1.
procedure parts_in(Parts?, Parts?, YesNo).
parts_in([], _, yes).
parts_in([X|Xs], B, E?) :- ground(B?) |
    part_in(X?, B?, E1),
    parts_in1(E1?, Xs?, B?, E).
procedure parts_in1(YesNo?, Parts?, Parts?, YesNo).
parts_in1(no, _, _, no).
parts_in1(yes, Xs, B, E?) :- parts_in(Xs?, B?, E).
procedure part_in(Part?, Parts?, YesNo).
part_in(_, [], no).
part_in(part(P, D, A), [part(Q, D1, A1)|Ps], E?) :- P? =?= Q?, ground(D?), ground(A?) |
    ms_eq(D?, D1?, E1),
    ms_eq(A?, A1?, E2),
    and(E1?, E2?, E3),
    part_in1(E3?, part(P?, D?, A?), Ps?, E).
part_in(X, [_|Ps], E?) :- otherwise | part_in(X?, Ps?, E).
procedure part_in1(YesNo?, Part?, Parts?, YesNo).
part_in1(yes, _, _, yes).
part_in1(no, X, Ps, E?) :- part_in(X?, Ps?, E).

%% Definition "Binding": two roles sent to one person only if neither adds or
%% deletes an atom naming the other.
procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) |
    rs_len(Rs?, K),
    pairs_ok(1, K?, Rs?, B?, R).
procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- I? > K? | true.
pairs_ok(I, K, Rs, B, R?) :- I? =< K?, ground(Rs?), ground(B?) |
    J := I? + 1,
    pair_row(I?, J?, K?, Rs?, B?, R1),
    I1 := I? + 1,
    pairs_ok1(R1?, I1?, K?, Rs?, B?, R).
procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).
procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- J? > K? | true.
pair_row(I, J, K, Rs, B, R?) :- J? =< K?, ground(Rs?), ground(B?) |
    role_person(I?, B?, P),
    role_person(J?, B?, Q),
    nth_spec(Rs?, I?, RI),
    nth_spec(Rs?, J?, RJ),
    pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1),
    J1 := J? + 1,
    pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).
procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).
procedure pair_ok(Peer?, Peer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- P? =?= Q? |
    role_names(RI?, J?, A1),
    role_names(RJ?, I?, A2),
    or(A1?, A2?, A),
    neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.
procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(rs(_, A, D, _, _), J, R?) :- integer(J?) |
    names_role(A?, J?, R1),
    names_role(D?, J?, R2),
    or(R1?, R2?, R).
procedure names_role(SAtoms?, Integer?, YesNo).
names_role([], _, no).
names_role([atom(_, Vs)|As], J, R?) :- integer(J?) |
    mem(role(J?), Vs?, R1),
    names_role1(R1?, As?, J?, R).
procedure names_role1(YesNo?, SAtoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, As, J, R?) :- names_role(As?, J?, R).

%% Definition "Binding", admissible: a speech-act variable in an atom added at
%% a role and in no atom required at a role is sent to a speech act signed by
%% the person in a guarding role.
procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) |
    adds_of(Rs?, Ad),
    reqs_of(Rs?, Rq),
    guard_roles(Rs?, 1, Gi),
    persons_of(Gi?, B?, Gp),
    atoms_vars(Ad?, Av),
    adm_each(Av?, Rq?, B?, Gp?, R).
procedure adm_each(Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V|Vs], Rq, B, Gp, R?) :- ground(V?), ground(Rq?), ground(B?), ground(Gp?) |
    adm_var(V?, Rq?, B?, Gp?, R1),
    adm_each1(R1?, Vs?, Rq?, B?, Gp?, R).
procedure adm_each1(YesNo?, Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Rq, B, Gp, R?) :- adm_each(Vs?, Rq?, B?, Gp?, R).
procedure adm_var(Var?, SAtoms?, Binding?, Peers?, YesNo).
adm_var(svar(X), Rq, B, Gp, R?) :- ground(X?), ground(B?) |
    atoms_vars(Rq?, Qv),
    mem(svar(X?), Qv?, InReq),
    lookup(svar(X?), B?, F),
    adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
procedure adm_var1(YesNo?, Found?, Peers?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(s(speech(_, P))), Gp, R?) :- mem(P?, Gp?, R).
adm_var1(no, found(p(_)), _, no).
adm_var1(no, free, _, no).
procedure adds_of(RoleSpecs?, SAtoms).
adds_of([], []).
adds_of([R|Rs], A?) :- rs_add(R?, A1), adds_of(Rs?, A2), app(A1?, A2?, A).
procedure atoms_vars(SAtoms?, Vars).
atoms_vars([], []).
atoms_vars([atom(_, Vs)|As], R?) :- atoms_vars(As?, R1), app(Vs?, R1?, R).
procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([rs(guarded, _, _, _, _)|Rs], I, [I?|Is?]) :- integer(I?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, Is).
guard_roles([rs(unguarded, _, _, _, _)|Rs], I, Is?) :- integer(I?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, Is).
procedure persons_of(Ints?, Binding?, Peers).
persons_of([], _, []).
persons_of([I|Is], B, [P?|Ps?]) :- ground(B?) |
    role_person(I?, B?, P),
    persons_of(Is?, B?, Ps).

%% --- The class's schema-bindings: those of every schema whose roles, sent
%% --- onto the participants, delete and add exactly the class's atoms -------
procedure mates_of(Schemas?, Parts?, Mates).
mates_of([], _, []).
mates_of([schema(Nm, Rs)|Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Ps?) |
    parts_peers(Ps?, Q),
    rs_len(Rs?, K),
    assigns(K?, Q?, As),
    mates_assigns(As?, Nm?, Rs?, Ps?, M1),
    mates_of(Ss?, Ps?, M2),
    app(M1?, M2?, M).
procedure assigns(Integer?, Peers?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).
procedure assigns1(Integer?, Integer?, Peers?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- I? > K? | true.
assigns1(I, K, Q, Acc, R?) :- I? =< K?, ground(Q?) |
    extend_role(Acc?, I?, Q?, Acc1),
    I1 := I? + 1,
    assigns1(I1?, K?, Q?, Acc1?, R).
procedure extend_role(Bindings?, Integer?, Peers?, Bindings).
extend_role([], _, _, []).
extend_role([B|Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) |
    extend_one(Q?, I?, B?, R1),
    extend_role(Bs?, I?, Q?, R2),
    app(R1?, R2?, R).
procedure extend_one(Peers?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P|Ps], I, B, [[b(role(I?), p(P?))|B?]|R?]) :- ground(B?), integer(I?) |
    extend_one(Ps?, I?, B?, R).
procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Parts?, Mates).
mates_assigns([], _, _, _, []).
mates_assigns([B|Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) |
    parts_peers(Ps?, Q),
    role_persons(Rs?, 1, B?, Ws),
    all_in(Q?, Ws?, Onto),
    rule_ok(Rs?, B?, Ok),
    and(Onto?, Ok?, Go),
    mates_assign(Go?, B?, Nm?, Rs?, Ps?, M1),
    mates_assigns(Bs?, Nm?, Rs?, Ps?, M2),
    app(M1?, M2?, M).
procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Parts?, Mates).
mates_assign(no, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Ps, M?) :- ground(Rs?), ground(Ps?) |
    match_parts(Ps?, Rs?, [B?], Bs),
    mates_check(Bs?, Nm?, Rs?, Ps?, M).
procedure match_parts(Parts?, RoleSpecs?, Bindings?, Bindings).
match_parts([], _, Bs, Bs?).
match_parts([part(P, D, A)|Ps], Rs, Bs, R?) :- ground(P?), ground(D?), ground(A?), ground(Rs?) |
    match_part(Bs?, P?, D?, A?, Rs?, Bs1),
    match_parts(Ps?, Rs?, Bs1?, R).
procedure match_part(Bindings?, Peer?, GAtoms?, GAtoms?, RoleSpecs?, Bindings).
match_part([], _, _, _, _, []).
match_part([B|Bs], P, D, A, Rs, R?) :- ground(B?), ground(P?), ground(D?), ground(A?), ground(Rs?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    match_part1(RsP?, B?, D?, A?, B2),
    match_part(Bs?, P?, D?, A?, Rs?, R2),
    app(B2?, R2?, R).
procedure match_part1(RoleSpecs?, Binding?, GAtoms?, GAtoms?, Bindings).
match_part1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) |
    dels_of(RsP?, Dp),
    adds_of(RsP?, Ap),
    match_all(Dp?, D?, B?, B1),
    match_all_each(B1?, Ap?, A?, R).
procedure dels_of(RoleSpecs?, SAtoms).
dels_of([], []).
dels_of([R|Rs], A?) :- rs_del(R?, A1), dels_of(Rs?, A2), app(A1?, A2?, A).
procedure mates_check(Bindings?, Constant?, RoleSpecs?, Parts?, Mates).
mates_check([], _, _, _, []).
mates_check([B|Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) |
    sig_of(Rs?, B?, Ps1),
    parts_eq(Ps?, Ps1?, E1),
    admissible(Rs?, B?, E2),
    and(E1?, E2?, E),
    mate_of(E?, B?, Nm?, Rs?, M1),
    mates_check(Bs?, Nm?, Rs?, Ps?, M2),
    app(M1?, M2?, M).
procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, B?, G?, F?)]) :- ground(B?), ground(Rs?) |
    guard_roles(Rs?, 1, Gi),
    persons_of(Gi?, B?, Gp),
    sort_peers(Gp?, Gs),
    dedup(Gs?, G),
    role_person(1, B?, F).
procedure dedup_mates(Mates?, Mates).
dedup_mates([], []).
dedup_mates([M|Ms], [M?|R?]) :- ground(M?) |
    drop_mate(M?, Ms?, Ms1),
    dedup_mates(Ms1?, R).
procedure drop_mate(Mate?, Mates?, Mates).
drop_mate(_, [], []).
drop_mate(mate(N, B, G, F), [mate(N1, B1, G1, F1)|Ms], R?) :-
    ground(N?), ground(B?), ground(G?), ground(F?), ground(N1?), ground(B1?) |
    same(N?, N1?, E1),
    ms_eq(B?, B1?, E2),
    and(E1?, E2?, E),
    drop_mate1(E?, mate(N?, B?, G?, F?), mate(N1?, B1?, G1?, F1?), Ms?, R).
procedure drop_mate1(YesNo?, Mate?, Mate?, Mates?, Mates).
drop_mate1(yes, M, _, Ms, R?) :- drop_mate(M?, Ms?, R).
drop_mate1(no, M, M1, Ms, [M1?|R?]) :- drop_mate(M?, Ms?, R).
%% The guard sets of a class: the inclusion-minimal sets among the people in
%% the marked roles of its schema-bindings (Definition "Volition-Guarded
%% Specification, Participants, Guard Sets, Simple Guards"; Section 5.4, the
%% paragraph on act schemas).
procedure mates_gsets(Mates?, PeerSets).
mates_gsets(Ms, G?) :- mates_gsets1(Ms?, G0), dedup(G0?, G1), minimal_sets(G1?, G).
procedure mates_gsets1(Mates?, PeerSets).
mates_gsets1([], []).
mates_gsets1([mate(_, _, G, _)|Ms], [G?|Gs?]) :- mates_gsets1(Ms?, Gs).
procedure minimal_sets(PeerSets?, PeerSets).
minimal_sets(G, M?) :- ground(G?) | minimal1(G?, G?, M).
procedure minimal1(PeerSets?, PeerSets?, PeerSets).
minimal1([], _, []).
minimal1([X|Xs], G, M?) :- ground(X?), ground(G?) |
    has_smaller(G?, X?, B),
    minimal1(Xs?, G?, M1),
    keep_set(B?, X?, M1?, M).
procedure has_smaller(PeerSets?, Peers?, YesNo).
has_smaller([], _, no).
has_smaller([Y|Ys], X, B?) :- ground(Y?), ground(X?) |
    same(Y?, X?, Eq),
    neg(Eq?, Ne),
    all_in(Y?, X?, Sub),
    and(Ne?, Sub?, B1),
    has_smaller1(B1?, Ys?, X?, B).
procedure has_smaller1(YesNo?, PeerSets?, Peers?, YesNo).
has_smaller1(yes, _, _, yes).
has_smaller1(no, Ys, X, B?) :- has_smaller(Ys?, X?, B).
procedure keep_set(YesNo?, Peers?, PeerSets?, PeerSets).
keep_set(yes, _, M, M?).
keep_set(no, X, M, [X?|M?]).
%% The opener of an unguarded class: the least, in the order of identifiers,
%% of the people in the first role of its unguarded schema-bindings, those
%% with no marked role (vGLP 2026-10-12 08:26 UTC, Q-B), so that the tick,
%% which finds the classes of the unguarded schemas with the agent in their
%% first role, finds every class its agent opens.
procedure mates_opener(Mates?, Opener).
mates_opener(Ms, Op?) :- ground(Ms?) |
    mates_gsets(Ms?, G),
    only_empty(G?, Ug),
    unguarded_firsts(Ms?, Fs),
    sort_peers(Fs?, Ss),
    mates_opener1(Ug?, Ss?, Op).
procedure mates_opener1(YesNo?, Peers?, Opener).
mates_opener1(yes, [P|_], opener(P?)).
mates_opener1(yes, [], guarded_class).
mates_opener1(no, _, guarded_class).
procedure unguarded_firsts(Mates?, Peers).
unguarded_firsts([], []).
unguarded_firsts([mate(_, _, [], F)|Ms], [F?|Fs?]) :- unguarded_firsts(Ms?, Fs).
unguarded_firsts([mate(_, _, [_|_], _)|Ms], Fs?) :- unguarded_firsts(Ms?, Fs).

%% ===========================================================================
%% Atoms, bindings and matching
%% ===========================================================================

procedure schema_spec(Constant?, RoleSpecs).
schema_spec(Nm, Rs?) :- contract_schemas(Ss), find_schema(Ss?, Nm?, Rs).
procedure find_schema(Schemas?, Constant?, RoleSpecs).
find_schema([], _, []).
find_schema([schema(M, Rs)|_], Nm, Rs?) :- M? =?= Nm? | true.
find_schema([_|Ss], Nm, Rs?) :- otherwise | find_schema(Ss?, Nm?, Rs).
procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R|_], I, R?) :- I? =:= 1 | true.
nth_spec([_|Rs], I, R?) :- I? > 1 | I1 := I? - 1, nth_spec(Rs?, I1?, R).
procedure rs_len(RoleSpecs?, Integer).
rs_len([], 0).
rs_len([_|Rs], N?) :- rs_len(Rs?, M), N := M? + 1.
procedure rs_add(RoleSpec?, SAtoms).
rs_add(rs(_, A, _, _, _), A?).
procedure rs_del(RoleSpec?, SAtoms).
rs_del(rs(_, _, D, _, _), D?).
procedure rs_req(RoleSpec?, SAtoms).
rs_req(rs(_, _, D, K, _), R?) :- app(K?, D?, R).
procedure rs_forb(RoleSpec?, SAtoms).
rs_forb(rs(_, _, _, _, F), F?).

procedure role_person(Integer?, Binding?, Peer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), found_peer(F?, P).
procedure found_peer(Found?, Peer).
found_peer(found(p(P)), P?).
found_peer(found(s(_)), unbound).
found_peer(free, unbound).
procedure lookup(Var?, Binding?, Found).
lookup(_, [], free).
lookup(V, [b(W, X)|_], found(X?)) :- V? =?= W? | true.
lookup(V, [_|Bs], F?) :- otherwise | lookup(V?, Bs?, F).
procedure img_atoms(SAtoms?, Binding?, GAtoms).
img_atoms([], _, []).
img_atoms([A|As], B, [G?|Gs?]) :- ground(B?) |
    img_atom(A?, B?, G),
    img_atoms(As?, B?, Gs).
procedure img_atom(SAtom?, Binding?, GAtom).
img_atom(atom(P, Vs), B, g(P?, Xs?)) :- img_args(Vs?, B?, Xs).
procedure img_args(Vars?, Binding?, Vals).
img_args([], _, []).
img_args([V|Vs], B, [X?|Xs?]) :- ground(B?) |
    lookup(V?, B?, F),
    img_val(F?, X),
    img_args(Vs?, B?, Xs).
procedure img_val(Found?, Val).
img_val(found(X), X?).
img_val(free, p(unbound)).
procedure atom_bound(SAtom?, Binding?, YesNo).
atom_bound(atom(_, Vs), B, R?) :- vars_bound(Vs?, B?, R).
procedure vars_bound(Vars?, Binding?, YesNo).
vars_bound([], _, yes).
vars_bound([V|Vs], B, R?) :- ground(B?) |
    lookup(V?, B?, F),
    vars_bound1(F?, Vs?, B?, R).
procedure vars_bound1(Found?, Vars?, Binding?, YesNo).
vars_bound1(free, _, _, no).
vars_bound1(found(_), Vs, B, R?) :- vars_bound(Vs?, B?, R).

%% The bindings extending B under which every atom of As is one of Gs.
procedure match_all(SAtoms?, GAtoms?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A|As], Gs, B, R?) :- ground(Gs?) |
    match_into(A?, Gs?, B?, Bs),
    match_all_each(Bs?, As?, Gs?, R).
procedure match_all_each(Bindings?, SAtoms?, GAtoms?, Bindings).
match_all_each([], _, _, []).
match_all_each([B|Bs], As, Gs, R?) :- ground(As?), ground(Gs?) |
    match_all(As?, Gs?, B?, R1),
    match_all_each(Bs?, As?, Gs?, R2),
    app(R1?, R2?, R).
procedure match_into(SAtom?, GAtoms?, Binding?, Bindings).
match_into(_, [], _, []).
match_into(A, [G|Gs], B, R?) :- ground(A?), ground(B?) |
    match_atom(A?, G?, B?, M),
    match_into1(M?, A?, Gs?, B?, R).
procedure match_into1(Match?, SAtom?, GAtoms?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1?|R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).
procedure match_atom(SAtom?, GAtom?, Binding?, Match).
match_atom(atom(P, Vs), g(Q, Xs), B, R?) :- P? =?= Q? | match_args(Vs?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.
procedure match_args(Vars?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_|_], _, nomatch).
match_args([_|_], [], _, nomatch).
match_args([V|Vs], [X|Xs], B, R?) :- ground(V?), ground(X?), ground(B?) |
    lookup(V?, B?, F),
    kind_ok(V?, X?, K),
    match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).
procedure match_one(Found?, YesNo?, Var?, Val?, Vars?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- W? =?= X? | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(free, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [b(V?, X?)|B?], R).
match_one(free, no, _, _, _, _, _, nomatch).
procedure kind_ok(Var?, Val?, YesNo).
kind_ok(role(_), p(_), yes).
kind_ok(role(_), s(_), no).
kind_ok(pvar(_), p(_), yes).
kind_ok(pvar(_), s(_), no).
kind_ok(svar(_), p(_), no).
kind_ok(svar(_), s(_), yes).

%% The value a binding gives a variable, the agent's own name for one it
%% leaves free.
procedure val_peer(Var?, Binding?, Peer?, Peer).
val_peer(V, B, D, P?) :- lookup(V?, B?, F), val_peer1(F?, D?, P).
procedure val_peer1(Found?, Peer?, Peer).
val_peer1(found(p(P)), _, P?).
val_peer1(found(s(_)), D, D?).
val_peer1(free, D, D?).
procedure val_speech(Var?, Binding?, Peer?, Speech).
val_speech(V, B, D, S?) :- lookup(V?, B?, F), val_speech1(F?, D?, S).
procedure val_speech1(Found?, Peer?, Speech).
val_speech1(found(s(S)), _, S?).
val_speech1(found(p(_)), D, speech(none, D?)).
val_speech1(free, D, speech(none, D?)).

%% ===========================================================================
%% The agent state's fields, booleans, lists and multisets
%% ===========================================================================

procedure st_id(St?, Peer).
st_id(st(Id, _, _, _, _, _, _, _, _), Id?).
procedure st_app(St?, App).
st_app(st(_, Ap, _, _, _, _, _, _, _), Ap?).
procedure st_date(St?, Integer).
st_date(st(_, _, D, _, _, _, _, _, _), D?).
procedure st_sent(St?, Peers).
st_sent(st(_, _, _, Se, _, _, _, _, _), Se?).
procedure st_recd(St?, Peers).
st_recd(st(_, _, _, _, Rc, _, _, _, _), Rc?).
procedure st_waits(St?, Waits).
st_waits(st(_, _, _, _, _, _, W, _, _), W?).
procedure st_pends(St?, Pends).
st_pends(st(_, _, _, _, _, _, _, _, Pd), Pd?).
procedure set_app(St?, App?, St).
set_app(st(Id, _, D, Se, Rc, N, W, Ca, Pd), Ap, st(Id?, Ap?, D?, Se?, Rc?, N?, W?, Ca?, Pd?)).
procedure set_waits(St?, Waits?, St).
set_waits(st(Id, Ap, D, Se, Rc, N, _, Ca, Pd), W, st(Id?, Ap?, D?, Se?, Rc?, N?, W?, Ca?, Pd?)).
procedure set_pends(St?, Pends?, St).
set_pends(st(Id, Ap, D, Se, Rc, N, W, Ca, _), Pd, st(Id?, Ap?, D?, Se?, Rc?, N?, W?, Ca?, Pd?)).
procedure add_pend(Pend?, St?, St).
add_pend(X, st(Id, Ap, D, Se, Rc, N, W, Ca, Pd),
        st(Id?, Ap?, D?, Se?, Rc?, N?, W?, Ca?, Pd1?)) :-
    app(Pd?, [X?], Pd1).
procedure add_sent(Peer?, St?, St).
add_sent(Q, st(Id, Ap, D, Se, Rc, N, W, Ca, Pd),
        st(Id?, Ap?, D?, [Q?|Se?], Rc?, N?, W?, Ca?, Pd?)).
procedure add_recd(Peer?, St?, St).
add_recd(P, st(Id, Ap, D, Se, Rc, N, W, Ca, Pd),
        st(Id?, Ap?, D?, Se?, [P?|Rc?], N?, W?, Ca?, Pd?)).
procedure advance(St?, St).
advance(st(Id, Ap, D, Se, Rc, N, W, Ca, Pd), st(Id?, Ap?, D1?, Se?, Rc?, N?, W?, Ca?, Pd?)) :-
    D1 := D? + 1.
procedure app_recs(App?, Recs).
app_recs(app(_, _, _, R), R?).
procedure app_count(App?, Integer).
app_count(app(_, K, _, _), K?).
procedure app_state(App?, GAtoms).
app_state(app(S, _, _, _), S?).
procedure attempt_id(Attempt?, Peer).
attempt_id(attempt(I, _, _), I?).
procedure attempt_k(Attempt?, Integer).
attempt_k(attempt(_, K, _), K?).
procedure attempt_class(Attempt?, Class).
attempt_class(attempt(_, _, C), C?).

procedure and(YesNo?, YesNo?, YesNo).
and(yes, B, B?).
and(no, _, no).
procedure or(YesNo?, YesNo?, YesNo).
or(yes, _, yes).
or(no, B, B?).
procedure neg(YesNo?, YesNo).
neg(yes, no).
neg(no, yes).
procedure(X) same(X?, X?, YesNo).
same(P, Q, yes) :- P? =?= Q? | true.
same(_, _, no) :- otherwise | true.
procedure same_int(Integer?, Integer?, YesNo).
same_int(M, N, yes) :- M? =:= N? | true.
same_int(_, _, no) :- otherwise | true.

procedure sort_peers(Peers?, Peers).
sort_peers([], []).
sort_peers([P|Ps], S?) :- sort_peers(Ps?, S1), insert_peer(P?, S1?, S).
procedure insert_peer(Peer?, Peers?, Peers).
insert_peer(P, [], [P?]).
insert_peer(P, [Q|Qs], [P?, Q?|Qs?]) :- P? @< Q? | true.
insert_peer(P, [Q|Qs], [Q?|R?]) :- otherwise | insert_peer(P?, Qs?, R).

procedure(X) app(Stream(X)?, Stream(X)?, Stream(X)).
app([], Ys, Ys?).
app([X|Xs], Ys, [X?|Zs?]) :- app(Xs?, Ys?, Zs).
procedure(X) mem(X?, Stream(X)?, YesNo).
mem(_, [], no).
mem(X, [Y|_], yes) :- X? =?= Y? | true.
mem(X, [_|Ys], R?) :- otherwise | mem(X?, Ys?, R).
procedure(X) dedup(Stream(X)?, Stream(X)).
dedup([], []).
dedup([X|Xs], [X?|Ys?]) :- ground(X?) | remove_all(X?, Xs?, Xs1), dedup(Xs1?, Ys).
procedure(X) remove_all(X?, Stream(X)?, Stream(X)).
remove_all(_, [], []).
remove_all(X, [Y|Ys], Zs?) :- X? =?= Y? | remove_all(X?, Ys?, Zs).
remove_all(X, [Y|Ys], [Y?|Zs?]) :- otherwise | remove_all(X?, Ys?, Zs).
procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y|Ys], yes, Ys?) :- X? =?= Y? | true.
ms_remove(X, [Y|Ys], F?, [Y?|Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).
procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X|Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).
procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X|Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).
procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).
procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) |
    ms_sub(A?, B?, R1),
    ms_sub(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).
procedure(X) ms_meets(Stream(X)?, Stream(X)?, YesNo).
ms_meets([], _, no).
ms_meets([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), ms_meets1(R1?, Xs?, B?, R).
procedure(X) ms_meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_meets1(yes, _, _, yes).
ms_meets1(no, Xs, B, R?) :- ms_meets(Xs?, B?, R).
