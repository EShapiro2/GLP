%% Printed by programs/vglp/cva/compiler from the contract named below, in the
%% term form programs/gsc reads (GSC, Sections 3 and 5, Appendix D): the canonical CVA
%% platform of the contract (vGLP, Section 3.2, Definition "Canonical CVA
%% Platform"), two-phase commit coordinated by the initiating agent, compiled
%% into vGLP by its compilation (Section 5.4, "The compilation").  Edit the
%% contract or the compiler and run
%% programs/vglp/cva/compile.sh, not this file.
%% the canonical CVA platform of the contract(merges)

%% ===========================================================================
%% The contract
%% ===========================================================================

Class ::=
befriend(Peer, Peer)
;
create(Peer, Speech)
;
join(Peer, Peer, Speech)
;
merge(Peer, List(Peer), List(Peer), Speech, Speech)
.

Proposal ::=
befriend(Peer, Peer)
;
create(Peer, Speech)
;
join(Peer, Peer, Speech)
;
merge(Peer, Speech, Speech)
.

Request ::= propose(Proposal).

%% The widget declarations of the platform (vGLP, Section 6.2, Definition "Widget Declaration"): its approval question drawn by the construct family's approval_sentence, and its request question by its social_menu.
Approval =::= approval_sentence.
Menu =::= social_menu.

%% The atoms of the contract at their argument types: a machine state is a list of them, in the view the agent writes, Output ::= view(List(Atom), List(Key), List(Approved)), and the agent writes each atom it holds, g(Name, Vals), as atom_of gives it (vGLP, Section 5.4, "The compilation"); the day, today(d), is no atom of the machine state the view shows (Section 5.4, "Act schemas as local specifications").
Atom ::=
friend(Peer)
;
leads(Speech)
;
listed(Peer, Speech)
;
member(Peer, Speech)
;
merged(Speech, Speech)
.

procedure atom_of(GAtom?, Shown).
atom_of(g(friend, [p(V1)]), shown(friend(V1?)))
.
atom_of(g(leads, [s(V1)]), shown(leads(V1?)))
.
atom_of(g(listed, [p(V1), s(V2)]), shown(listed(V1?, V2?)))
.
atom_of(g(member, [p(V1), s(V2)]), shown(member(V1?, V2?)))
.
atom_of(g(merged, [s(V1), s(V2)]), shown(merged(V1?, V2?)))
.
atom_of(_, unshown) :- otherwise | true.

procedure contract_schemas(Schemas).
contract_schemas([schema(befriend, [], [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]), rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]), schema(create, [svar(n)], [rs(guarded, [atom(leads, [svar(n)])], [], [], [atom(leads, [svar(n)])])]), schema(join, [svar(n)], [rs(guarded, [atom(listed, [role(2), svar(n)])], [], [atom(leads, [svar(n)]), atom(friend, [role(2)])], []), rs(guarded, [atom(member, [role(1), svar(n)])], [], [atom(friend, [role(1)])], [atom(member, [role(1), svar(n)])])]), lschema(merge, [svar(n1), svar(n2)], [rs(guarded, [atom(merged, [svar(n2), svar(n1)])], [atom(leads, [svar(n2)])], [atom(leads, [svar(n1)])], []), rs(unguarded, [atom(merged, [svar(n2), svar(n1)])], [], [atom(member, [role(1), svar(n1)])], []), rs(unguarded, [atom(member, [role(1), svar(n1)])], [atom(member, [role(1), svar(n2)])], [], [])], [listing(2, 1, listed, [svar(n1)]), listing(3, 1, listed, [svar(n2)])])])
.

procedure schema_entry(Constant?, Schema).
schema_entry(befriend, schema(befriend, [], [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]), rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]))
.
schema_entry(create, schema(create, [svar(n)], [rs(guarded, [atom(leads, [svar(n)])], [], [], [atom(leads, [svar(n)])])]))
.
schema_entry(join, schema(join, [svar(n)], [rs(guarded, [atom(listed, [role(2), svar(n)])], [], [atom(leads, [svar(n)]), atom(friend, [role(2)])], []), rs(guarded, [atom(member, [role(1), svar(n)])], [], [atom(friend, [role(1)])], [atom(member, [role(1), svar(n)])])]))
.
schema_entry(merge, lschema(merge, [svar(n1), svar(n2)], [rs(guarded, [atom(merged, [svar(n2), svar(n1)])], [atom(leads, [svar(n2)])], [atom(leads, [svar(n1)])], []), rs(unguarded, [atom(merged, [svar(n2), svar(n1)])], [], [atom(member, [role(1), svar(n1)])], []), rs(unguarded, [atom(member, [role(1), svar(n1)])], [atom(member, [role(1), svar(n2)])], [], [])], [listing(2, 1, listed, [svar(n1)]), listing(3, 1, listed, [svar(n2)])]))
.
schema_entry(Nm, schema(Nm?, [], [])) :- otherwise | true.

procedure schema_numeric(Constant?, Numeric).
schema_numeric(_, numeric(true, [], every)) :- otherwise | true.

procedure reflexive_preds(Preds).
reflexive_preds([])
.

procedure introduction_preds(Preds).
introduction_preds([])
.

procedure binding_of(Class?, Constant, Binding).
binding_of(befriend(V1, V2), befriend, [b(role(1), p(V1?)), b(role(2), p(V2?))])
.
binding_of(create(V1, V2), create, [b(role(1), p(V1?)), b(svar(n), s(V2?))])
.
binding_of(join(V1, V2, V3), join, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(n), s(V3?))])
.
binding_of(merge(V1, V2, V3, V4, V5), merge, B?)
:-
listed_binding(merge, [b(role(1), p(V1?)), b(svar(n1), s(V4?)), b(svar(n2), s(V5?))], [V2?, V3?], B)
.

procedure class_of(Constant?, Binding?, Peer?, Class).
class_of(befriend, B, D, befriend(V1?, V2?))
:-
ground(B?)
,
ground(D?)
|
val_peer(role(1), B?, D?, V1)
,
val_peer(role(2), B?, D?, V2)
.
class_of(create, B, D, create(V1?, V2?))
:-
ground(B?)
,
ground(D?)
|
val_peer(role(1), B?, D?, V1)
,
val_speech(svar(n), B?, D?, V2)
.
class_of(join, B, D, join(V1?, V2?, V3?))
:-
ground(B?)
,
ground(D?)
|
val_peer(role(1), B?, D?, V1)
,
val_peer(role(2), B?, D?, V2)
,
val_speech(svar(n), B?, D?, V3)
.
class_of(merge, B, D, merge(V1?, V2?, V3?, V4?, V5?))
:-
ground(B?)
,
ground(D?)
|
val_peer(role(1), B?, D?, V1)
,
copies_of(B?, 2, V2)
,
copies_of(B?, 3, V3)
,
val_speech(svar(n1), B?, D?, V4)
,
val_speech(svar(n2), B?, D?, V5)
.

procedure name_class(Proposal?, GAtoms?, Class).
name_class(befriend(V1, V2), _, befriend(V1?, V2?))
.
name_class(create(V1, V2), _, create(V1?, V2?))
.
name_class(join(V1, V2, V3), _, join(V1?, V2?, V3?))
.
name_class(merge(V1, V4, V5), St, C?)
:-
listed_class(merge, [b(role(1), p(V1?)), b(svar(n1), s(V4?)), b(svar(n2), s(V5?))], St?, C)
.

procedure request_name(Class?, PName).
request_name(befriend(V1, V2), pname(befriend(V1?, V2?)))
.
request_name(create(V1, V2), pname(create(V1?, V2?)))
.
request_name(join(V1, V2, V3), pname(join(V1?, V2?, V3?)))
.
request_name(merge(V1, _, _, V4, V5), pname(merge(V1?, V4?, V5?)))
.
request_name(_, nopname) :- otherwise | true.

%% The peer a request name N of a meeting part names beside the agent Me, peer(Q), or none, nopeer: the meeting schemas, each of two roles, both guarding, that requires at neither role an atom naming the other (vGLP, Section 5.4, "The compilation").
procedure meeting_peer(Proposal?, Peer?, MeetPeer).
meeting_peer(befriend(V1, V2), Me, P?)
:-
ground(V1?)
,
ground(V2?)
,
ground(Me?)
|
meet_other(V1?, V2?, Me?, P)
.
meeting_peer(_, _, nopeer) :- otherwise | true.

%% ===========================================================================
%% The agent (vGLP, Section 5.4, "The compilation"): it calls the agent goal on the fair merge of the answers to its request questions, the arriving messages, the answers of its responders and its own triggers, which the agent goal writes on a stream of its own, one at a time (vGLP 6c8c663, Section 5.4, "The compilation").  A request question is a goal of a volitional procedure whose question, Menu, shows the agent's own key and the persons it knows and takes one request (vGLP 321127a, Section 5.4); the agent asks one when it starts and the agent goal the next when it reads the answer to the last.  On the request propose(N) the agent takes a Request, its person's approval, which stands until the transaction is taken or refused; its machine proposes, and proposes again an attempt that yields, with no further question to its person; and a machine that cannot carry out a transaction its person approved refuses it (vGLP f0acbc1, Section 5.4, "Triggers").  On the program's output to its person, Output, construct 0, the agent goal writes its view, view(S, K), the machine state S of its app state and the persons K it knows, when it starts and whenever either changes, and the person's screen shows the last view written (vGLP b7e3517, Section 5.4, "The compilation"); and, when an approval its person made, by a request or by an answer yes, ends by a refusal, a notice refused(Part, Q, D), Part the part of the refused attempt, Q its refuser and D the reason, declined or unable, from the abort outcome, or from its own vote where its own vote no refused the attempt (vGLP f0acbc1, Section 5.4, "The compilation").
%% ===========================================================================

%% An attempt (i, k, pi, [t]_j, r) (vGLP f0acbc1, Definition "Attempt"): its initiator, its number, its rank, its part, named by a term of Class, a schema-binding of the part, of the attempt's class (Section 5.4, "Act schemas as local specifications": "each schema-binding determines a part [t]_j of its class"), the part's guard set the people in the schema-binding's marked roles, and the request it names, request(Rho, K), where its part is guarded and has an opener, and none otherwise.  The cargoes (Definition "Cargo, App State, Question, Approval, Free, Ready") are its start; a vote on it, a vote no carrying its reason, declined or unable; its outcome, an abort carrying its refuser, the participant whose vote no refused it, with that vote's reason; a yield of it; and a request, request(Rho, K).  A message carries its sender and a cargo, a hello, an ihello, or an introduction, intro(P, Q), P's cargo intro(Q), which Commit and Introduce peers send (Definitions "CVA Platform", "Deciding" and "Introduction Rule, Introduce Peers").  A request is a set of classes (Definition "Local Specification, Part, Guard Set, Opener, Request"): one(C), the class of a guarded part with no opener that the agent guards, C the term naming the class at the agent, a request of the agent to itself; or rho(N), rho_N, the classes of the guarded parts with an opener named N, a request to their opener, the message of the Request carrying N (Section 5.4, "The compilation").  A vote unable of the compiled program carries the atoms the schema requires at the voter that its state lacks and those it forbids that its state has, as the contract writes them (Section 5.4, "Act schemas").
Peer      ::= Key.
%% A speech act is an utterance or a speech act, signed by a person (GSC,
%% Section 3): "A speech act forwarded with its provenance is signed again at
%% each forward, so its type is recursive, and a request to forward it carries
%% it.  With no mode inversion, a recursive type is written whole by the
%% program or whole by the person" (vGLP, Section 5.1, Definition "Volitional
%% Procedure, Interactive Type" and the paragraph after it).
Speech    ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
YesNo     ::= yes ; no.
%% A notice of a request dropped because the agent can carry out no part it names carries the reason unable alone (vGLP, Section 5.4, "The compilation": "with a notice refused(N, p, unable)").
Reason    ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote      ::= yes ; no(Reason).
Decision  ::= commit ; abort(Peer, Reason) ; yield.
Rho       ::= one(Class) ; rho(Proposal).
Names     ::= none ; request(Rho, Integer).
Attempt   ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo     ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
            ; yield(Attempt) ; request(Rho, Integer).
%% A hello carries the request name N of the meeting part its sender requested, hello(P, N), P the sender (vGLP, Section 5.4, "The compilation": "On the request propose(N), N the request name of a meeting part with a peer Q, the agent goal, besides what it does on any request, sends Q hello carrying N"); a contract with no guarded part has no meeting part, and its agents send no hello.
Content   ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net       ::= msg(Peer, Content).
%% An approval question asks of an attempt, the question Start raises, or of the meeting a hello carries, hello(Q, N), Q its sender and N the request name of the meeting part (vGLP, Section 5.4, "The compilation": an arriving hello from Q "asks its person the approval question of the clause of N, with its pragma, by a goal that shows Q and takes yes or no").
Asking    ::= Attempt ; hello(Peer, Proposal).
Approval  ::= approval(Asking, YesNo?).
Menu      ::= menu(Key, List(Key), Request?).
Close     ::= close.
Trigger   ::= req(Request) ; again(Proposal) ; net(Net) ; answered(Attempt, YesNo) ; recheck ; own ; day(Integer).
%% The peer a meeting part names beside the agent, peer(Q), or none, nopeer (meeting_peer, which the compiler prints from the contract's meeting schemas).
MeetPeer  ::= peer(Peer) ; nopeer.

%% The contract, as programs/gsc writes it: a schema's roles, each rs(Guard,
%% Add, Del, Keep, Forb), a role named by its index; sgn(y, i) is the signed
%% term of an added atom: "a signed term sgn(y, i) in an added atom is the
%% speech act bound to y, signed by the person in role i" (vGLP, Section
%% 5.4, "Act schemas as local specifications"; GSC, Definition "Act schema").
%% A name term <u>.y_1...y_n, nterm(N): N is own(I), <pi_I>, or own_var(X), <x>, followed by ext(N, Y) for each y; "a name term <u>.y_1...y_n is the community name of the person bound to u followed by the speech acts bound to y_1, ..., y_n, as <a>.n names the group n led by a" (vGLP c649c0d, Section 5.4, "Act schemas as local specifications"; GSC, Appendix D).
Var       ::= role(Integer) ; pvar(Constant) ; svar(Constant)
            ; sgn(Constant, Integer) ; nterm(NTerm) ; num(Constant).
NTerm     ::= own(Integer) ; own_var(Constant) ; ext(NTerm, Constant).
Vars      ::= [] ; [Var | Vars].
%% An atom a schema adds or deletes may carry a multiplicity, times(K, A), K a number or a numeric variable, for that many copies of A (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications").
SAtom     ::= atom(Constant, Vars) ; times(Var, SAtom).
SAtoms    ::= [] ; [SAtom | SAtoms].
Guard     ::= guarded ; unguarded.
RoleSpec  ::= rs(Guard, SAtoms, SAtoms, SAtoms, SAtoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
%% A schema's second argument is its variables, in the order of its head (GSC 0228e79, Definition "Act schema"; programs/gsc/README.md, "Writing a contract").
Schema    ::= schema(Constant, Vars, RoleSpecs) ; lschema(Constant, Vars, RoleSpecs, Listings).
%% A schema with listed roles pi[rho(*, u_2, ..., u_r)], lschema(Name, Vars, Roles, Listings): each listed role written as a party role of its atoms, and listing(I, Base, Rho, Args) in Listings, in the order of the roles, I its index, Base the index of its base, an agent role, Rho the predicate rho and Args its arguments u_2, ..., u_r; "A listed role ... has as its people at a schema-binding the persons q with rho(q, u_2, ..., u_r), so bound, in the state of the person in pi", and "the listed roles of a schema have one base" (vGLP c649c0d, Section 5.4, "Act schemas as local specifications").  A schema-binding of it with the lists L_1, ..., L_m of the people of its listed roles, in the order of the roles, is carried as a schema-binding of its roles, each listed role's place bound to the base person and its atoms at none; of one role more for each person of each list, of that listed role's atoms, the roles after its own, the people of L_1 first; and of an entry b(role(-I), p(Q)) for each person Q of the list of the listed role of index I, which names its people (bound_spec, listed_binding, copies_of): "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles: the set of transactions it determines with L in those roles" (ibid.).
Listing   ::= listing(Integer, Integer, Constant, Vars).
Listings  ::= [] ; [Listing | Listings].
PeerLists ::= [] ; [Peers | PeerLists].
ListTuples ::= [] ; [PeerLists | ListTuples].
Schemas   ::= [] ; [Schema | Schemas].
Preds     ::= [] ; [Constant | Preds].
%% Numbers (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications"): an argument of an atom may be a number or a numeric variable, num(X), the number X where X is a number and the variable X otherwise; a schema may carry a constraint on its numeric variables, "a conjunction of linear equalities and inequalities over its value variables and values" (GSC bcc1891, Definition "Schema with values"), as programs/gsc writes it: true, and(C1, C2), eq, le, lt, ge and gt of two expressions (X = Y, X =< Y, X < Y, X >= Y, X > Y), succ(X, Y) (Y = X + 1) and or(C1, C2); an expression is a numeric argument, plus(X, Y), minus(X, Y) or mul(X, Y).  The values are whole numbers, Integer, the realisation's type (GSC, ibid.: "Which types the values have --- numbers, strings, dates --- is the realisation's").  schema_numeric(Name, numeric(C, Ls, R)), which the compiler prints from the contract, gives a schema's constraint C, its variables local to a role, Ls, and the role whose local variables the constraint names, at(I), or every where it names none: "a constraint is local to the role whose local variables it names, and to every role where it names none, which each checks" (ibid.).
Constraint ::= true ; and(Constraint, Constraint) ; eq(Expr, Expr) ; le(Expr, Expr) ; lt(Expr, Expr) ; ge(Expr, Expr) ; gt(Expr, Expr) ; succ(Var, Var) ; or(Constraint, Constraint).
Expr      ::= Var ; plus(Expr, Expr) ; minus(Expr, Expr) ; mul(Expr, Expr).
CRole     ::= every ; at(Integer).
Numeric   ::= numeric(Constraint, Vars, CRole).
NumRes    ::= num_is(Integer) ; no_num.
LNorm     ::= norm(Binding) ; badnorm.

%% A machine state is a multiset of ground atoms, a list; an atom's arguments
%% are people and speech acts.  A binding sends roles and party variables to
%% people and speech-act variables to speech acts.
%% The value of a name term is a community name, c(N): community(P) the community name of the person P, dot(N, S) the community name N followed by the speech act S, as dot(community(a), n) names the group n led by a.
CName     ::= community(Peer) ; dot(CName, Speech).
%% A number, n(K); and lv(S, X), the value a schema-binding of the schema S gives a numeric variable X local to a role, which it does not bind: it stands for the variable, which the state of the person in that role binds (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "A numeric variable that occurs only in atoms the schema requires or deletes at one role, and in the constraint, is local to that role: the schema-binding does not bind it").
Val       ::= p(Peer) ; s(Speech) ; c(CName) ; n(Integer) ; lv(Constant, Constant).
NameParts ::= parts(Vars, Vals) ; noparts.
Vals      ::= [] ; [Val | Vals].
GAtom     ::= g(Constant, Vals).
GAtoms    ::= [] ; [GAtom | GAtoms].
%% The program's output to its person is of the type of the views, view(S, K): S a machine state, a list of the contract's atoms, each of the type Atom the compiler prints from the contract and written as the contract writes it, and K the persons the agent knows, in the order of identifiers, so that no Stream or List is under another (Definition "Volitional Procedure, Interactive Type": "never under another Stream or List"); and the notices, refused(P, Q, D), P the term of the part of the refused attempt, Q its refuser and D the reason, declined, or unable(Lacks, Has), the atoms the schema requires at the voter that its state lacks and those it forbids that its state has, as the contract writes them: "when an approval its person made, by a request or by an answer yes, ends by a refusal, a notice refused([t]_j, q, d)"; "The compilation defines Output as the type of the views and the notices, and declares for the type Stream(Output) of the output a widget that draws the last view written and the notices written after it" (vGLP f0acbc1, Section 5.4, "The compilation" and "Act schemas"; Definition "Widget Declaration").
%% The view carries also the approvals the person made that are pending, the requests by their names and the answers yes by their attempts, view(S, K, A) (vGLP, Section 5.4, "The compilation": "the agent goal writes its view view(s, K, A), the machine state s of its app state, the persons K it knows and the approvals A its person made that are pending, the requests by their names and the answers yes by their attempts, when it starts and whenever any changes").
Approved  ::= Proposal ; Attempt.
Output    ::= view(List(Atom), List(Key), List(Approved)) ; refused(Class, Key, Reason).
Shown     ::= shown(Atom) ; unshown.
Stream(Output) =::= last_state.
Bind      ::= b(Var, Val).
Binding   ::= [] ; [Bind | Binding].
Bindings  ::= [] ; [Binding | Bindings].
Found     ::= found(Val) ; free.
Match     ::= match(Binding) ; nomatch.
SgnParts  ::= signed(Val, Peer) ; unsigned.
Peers     ::= [] ; [Peer | Peers].
Nets      ::= [] ; [Net | Nets].
Ints      ::= [] ; [Integer | Ints].

%% A class, as the paper defines it: "The classes are those of the contract's equivalence, generated by relating two transactions when one schema-binding determines both" (vGLP 099f876, Section 5.4, "Act schemas as local specifications").  Two schema-bindings of the same participants and the same atoms deleted and added at each determine a common transaction, and are linked, when no atom one requires at a participant the other forbids there; a class is what a chain of links joins.  Each schema-binding determines a part of its class, the set of transactions it determines, with the people in its marked roles as its guard set (ibid.), and two schema-bindings determine one part where they require the same atoms, as multisets, and forbid the same atoms at every participant, and mark the same people (same_part; vGLP #15, Code_inbox.md, 2026-10-19 10:50 UTC, item 1).  An entry for a class holds its participants and the atoms each deletes and adds, delta(P, D, A); its parts, each pt(T, GuardSet, Opener), named by the term T of the first of its schema-bindings in the order of the entry's, with its guard set and, for an unguarded part, its opener, opener(P), "the least, in the order of identifiers, of the people in the first role of the schema-bindings that determine it" (ibid.); for a guarded part determined by a schema with a listed role whose base is not a guarding role, its opener likewise, opener(P), P the least person in the first role of those schema-bindings, that person not a guard of the part (vGLP a890465, ibid.: "and so is the opener of a guarded part determined by a schema with a listed role whose base is not a guarding role, where that person is not a guard of the part"); and guarded_part for every other guarded part, which has no opener; and its schema-bindings, each mate(Schema, Binding, GuardSet, FirstPerson), every variable bound, the contract being effective (local.glp: every variable of an atom a schema requires or forbids is a variable of an atom it deletes or adds).  ci(C, Deltas, Participants, Parts, Mates), C the term that names it, the first the agent met.
Delta     ::= delta(Peer, GAtoms, GAtoms).
Deltas    ::= [] ; [Delta | Deltas].
Mate      ::= mate(Constant, Binding, Peers, Peer).
Mates     ::= [] ; [Mate | Mates].
Opener    ::= opener(Peer) ; guarded_part.
Part      ::= pt(Class, Peers, Opener).
Parts     ::= [] ; [Part | Parts].
Info      ::= ci(Class, Deltas, Peers, Parts, Mates).
Infos     ::= [] ; [Info | Infos].
ClassRes  ::= cls(Info) ; nocls.
%% An atom of a schema-binding as it is compared, within the schema-binding and with another's: a variable the binding leaves free stands for itself, cmp_free(V), one person or speech act in every atom it occurs in and named by no other variable.
CVal      ::= cmp_val(Val) ; cmp_free(Var).
CVals     ::= [] ; [CVal | CVals].
CAtom     ::= cmp_atom(Constant, CVals).
CAtoms    ::= [] ; [CAtom | CAtoms].

%% The app state (s, k, L, R) (vGLP f0acbc1, Definition "Cargo, App State, Question, Approval, Free, Ready"): the machine state; the agent's number, the largest number of an attempt it has proposed or read a start of, or of a request it has made; the lock, unlocked or the attempt it holds prepared; and the record, which holds besides requested(Rho, K), a request it has made, and ended(Rho, K) and ended(At), the end of an approval, a request or an answer yes.  The agent state (Section 5.4, "The compilation"): its identifier, the app state, the count of the own transactions it has taken, the peers hello has been sent to and received from, and ihello, the count at which each class of its own transactions it has met began to wait --- the proposing class op([t]_j) of a part, named by the part's term, the Vote vt(At) and the Commit cm(At) on an attempt, the Wound wd(A, B) of A against B, and the Introduce peers ip(Q, R) of a pair, Q preceding R --- the classes met, the starts it holds waiting, deferred(M), the requests it has made, in the order it last made them, the least recent first, and the requests it holds, held(Q, Rho, K), each a message request(Rho, K) from Q (Definition "Equivalence of the Canonical Platform": "for a part [t]_j and an agent p, p's proposing class on [t]_j").
Lock      ::= unlocked ; held(Attempt).
Rec       ::= asked(Attempt) ; answered(Attempt, YesNo) ; voted(Attempt, YesNo)
            ; got(Attempt, Peer, YesNo) ; closed(Attempt) ; wounded(Attempt)
            ; yielded(Attempt) ; requested(Rho, Integer) ; ended(Rho, Integer)
            ; ended(Attempt) ; introduced(Peer, Peer).
Recs      ::= [] ; [Rec | Recs].
App       ::= app(GAtoms, Integer, Lock, Recs).
Pend      ::= deferred(Net).
Pends     ::= [] ; [Pend | Pends].
WKey      ::= op(Class) ; vt(Attempt) ; cm(Attempt) ; wd(Attempt, Attempt)
            ; ip(Peer, Peer).
Wait      ::= w(WKey, Integer).
Waits     ::= [] ; [Wait | Waits].
WFound    ::= at(Integer) ; unseen.
Held      ::= held(Peer, Rho, Integer).
Helds     ::= [] ; [Held | Helds].
Rhos      ::= [] ; [Rho | Rhos].
%% The record indexed by attempt (Code #12's change 2 of 2026-10-20 11:55 UTC, approved by vGLP #18 Cowork as implementation, Code_inbox.md 12:03 UTC: "index the record by attempt, so that no own trigger and no condition scans a closed attempt's terms, and only open attempts are examined.  Memory stays as the specification's"): the record R of the app state is whole and append-only (Definition "Cargo, App State, Question, Approval, Free, Ready"), and the agent goal holds it in three parts, which no entry leaves.  The live record, the fourth field of App, holds the entries of the attempts not closed at the agent, the answers yes whose approval has not ended, the requests not ended, newest first, the record's own order; once a dispatch closes an attempt or ends a request, its entries leave the live record for the record of the closed attempts, which the agent goal holds beside its state and no trigger and no condition reads (spend); and the index, the agent state's last field, holds the introductions recorded, introduced(Q, R), and what a condition asks of the entries that have left: which attempts are closed and which requests ended, a trie keyed by the attempt's number or the request's, the attempt by its initiator, a(I), the request by itself, r(Rho), and the agent's own attempts recorded wounded that are the last it proposed of their parts, of which Propose takes the rank (Definition "Proposing", Propose).
Tag       ::= a(Peer) ; r(Rho).
Tags      ::= [] ; [Tag | Tags].
Trie      ::= nil ; t(Tags, Trie, Trie).
Attempts  ::= [] ; [Attempt | Attempts].
%% The pairs the introduction rule gives the agent that it has not introduced, computed where its friends change and not on every own trigger (Code #12's change 4, vGLP #18 Cowork, Code_inbox.md 2026-10-20 12:03 UTC): ic(S, Ns, Pend), the machine state S they were computed at, the persons Ns its introduction predicates name there, in the order of identifiers, and the pairs of Ns not recorded introduced, Pend, in the order Introduce peers forms them; a pair recorded introduced leaves Pend.
IC        ::= ic(GAtoms, Peers, Pairs).
Ix        ::= ix(Trie, Attempts, Recs, IC).
Fate      ::= keep ; move ; intro.
%% The parts of the agent state a condition tests (Code #12's change 3, vGLP #18 Cowork, Code_inbox.md 2026-10-20 12:03 UTC: "a condition reads only the parts of the state it tests"): the agent's identifier, its machine state, the lock, the live record, the starts it holds waiting and the hellos and ihellos sent and received, kn(Sent, Received, ISent, IReceived).  A condition taken for each record, pair, participant, start held or class reads these, and not the whole state; the classes it needs it reads from the state, which it gives back.
Kn        ::= kn(Peers, Peers, Peers, Peers).
V         ::= v(Peer, GAtoms, Lock, Recs, Pends, Kn).
Proposals ::= [] ; [Proposal | Proposals].
St        ::= st(Peer, App, Integer, Peers, Peers, Peers, Peers, Waits, Infos, Pends, Rhos, Helds, Ix, Proposals).
OpenApproval ::= oc(Attempt, Close?).
OpenApprovals ::= [] ; [OpenApproval | OpenApprovals].
Send      ::= to(Peer, Cargo).
Sends     ::= [] ; [Send | Sends].
Subj      ::= sub(Info) ; pair ; prop(Info, Class, Names).
Cand      ::= cand(WKey, Subj).
Cands     ::= [] ; [Cand | Cands].
Choice    ::= take(WKey, Subj) ; none.
Pair      ::= pr(Peer, Peer).
Pairs     ::= [] ; [Pair | Pairs].
PKey      ::= key(WKey) ; nokey.
Cond      ::= go(Info) ; drop.
PCond     ::= pgo(Info, Class, Names) ; pdrop.
RCond     ::= rgo(Rho, Peer) ; rdrop ; rhold(Proposal) ; rrefuse(Class).
RQ        ::= rq(RCands, YesNo, YesNo).
RCand     ::= rc(Rho, Peer).
RCands    ::= [] ; [RCand | RCands].
PName     ::= pname(Proposal) ; nopname.
PartRes   ::= part(Part) ; nopart.
Mine      ::= mine(Rho, Integer) ; notmine.
Outputs   ::= [] ; [Output | Outputs].
Classes   ::= [] ; [Class | Classes].
MCond     ::= mgo(Info) ; mdefer ; mhold ; noparticipant.
Blocker   ::= blk(Attempt) ; noblk.
FoundNet  ::= found(Net) ; nonefound.
Last      ::= last(Attempt) ; nolast.
Known     ::= allknown ; unknown(Peer).
Then      ::= write_own ; own_unread ; no_own.
ApprovalRes ::= approval_for(Attempt) ; noapproval.

%% When it starts, its view is written on the output: the machine state of the initial app state, the empty multiset, and no person known; and an own trigger on its stream of own triggers, which the agent goal reads in the fair merge of the answers to its request questions, the arriving messages, the answers to its approval questions and its own triggers (vGLP 6c8c663, Section 5.4, "The compilation").
%% Where the contract requires the day, the agent reads also the calendar, a stream of dates the device writes, one a day, merged with its triggers (vGLP, Section 5.4, "The compilation": "the fair merge ... of the answers to its request questions, the messages arriving on the network, the answers to its approval questions, its own triggers and, where the contract requires the day, the calendar").
exported procedure agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output)).
agent(Id, NetIn, Out?, [view([], [], [])|Thr?]) :- ground(Id?) |
    request(Id?, [], Rq),
    tag_net(NetIn?, Nt),
    merge(Rq?, Nt?, M1),
    merge(M1?, Ans?, M2),
    merge(M2?, [own|Ow?], In),
    agent_goal([], In?, yes, Ans, Thr, Out, Ow, [], [],
        st(Id?, app([], 0, unlocked, []), 0, [], [], [], [], [], [], [], [], [], ix(nil, [], [], ic([], [], [])), [])).

%% A request question: the agent's own key, its identifier, the persons the
%% agent knows, in the order of identifiers, and the person's one request,
%% put up once it is made, of a type with the alternative propose(N) for the request name N of each guarded part (vGLP, Section 5.4, "The compilation").  A contract with no guarded part has no request, and its agent asks no request question.
procedure (Menu)*request(Key?, List(Key)?, Stream(Trigger)).
(menu(Id?, Ks?, R))*request(Id, Ks, Out?) :- ground(Id?), ground(Ks?) |
    await_request(R?, Out).
procedure await_request(Request?, Stream(Trigger)).
await_request(propose(C), [req(propose(C?))]).

%% The next request question, asked on reading the answer to the last, its
%% answers joining the agent goal's input.
procedure ask_next(St?, Stream(Trigger), Stream(Trigger)?).
ask_next(St, Ans?, Ans1) :- ground(St?) |
    st_id(St?, Id),
    st_known(St?, Ks),
    request(Id?, Ks?, R),
    merge(R?, Ans1?, Ans).

procedure tag_net(Stream(Net)?, Stream(Trigger)).
tag_net([M|Ms], [net(M?)|Ts?]) :- tag_net(Ms?, Ts).
tag_net([], []).

%% A responder: the approval question Start raises shows the attempt and takes yes or no.
%% The agent goal holds the writer of its close signal and closes it once the
%% question is no longer pending, as when Outcome closes the attempt first; the
%% responder then reduces without the answer, dropping the person's reader on
%% it.
procedure (Approval)*respond(Attempt?, Close?, Stream(Trigger)).
(approval(At?, YN))*respond(At, Cl, Out?) :- ground(At?) |
    await(At?, YN?, Cl?, Out).
procedure await(Attempt?, YesNo?, Close?, Stream(Trigger)).
await(At, yes, _, [answered(At?, yes)]).
await(At, no, _, [answered(At?, no)]).
await(_, _, close, []).

%% The approval question an arriving hello from Q asks: the clause of the meeting part N that hello carries, with its pragma, showing Q and taking yes or no; the person's yes is their request propose(N), which the agent goal reads as any request, and their no does nothing (vGLP, Section 5.4, "The compilation").
procedure (Approval)*greet(Peer?, Proposal?, Stream(Trigger)).
(approval(hello(Q?, N?), YN))*greet(Q, N, Out?) :- ground(Q?), ground(N?) |
    await_greet(N?, YN?, Out).
procedure await_greet(Proposal?, YesNo?, Stream(Trigger)).
await_greet(N, yes, [req(propose(N?))]).
await_greet(_, no, []).

%% ===========================================================================
%% The agent goal: one clause per kind of trigger, which computes the conditions of the schemas the trigger puts up and calls the dispatch.  It reads first the recheck of the starts it holds waiting, which a dispatch puts up, and then its input stream, the fair merge of the answers to its request questions, the arriving messages, the answers to its approval questions and its own triggers.  It holds the writer of its stream of own triggers, Ow, and whether an own trigger it has written is still unread, U; and, beside its state St, the record of the closed attempts, H, the entries of the attempts closed at the agent and of the requests it has ended, which leave the live record of its app state after the dispatch that closes or ends them (spend) and which no trigger and no condition reads.  It takes its own transactions one at a time, one on each own trigger it reads; it writes an own trigger when it starts, after each other trigger it reads unless an own trigger it has written is still unread, and after each own transaction it takes, so that it reads its other triggers between its own transactions and writes none once none holds (vGLP 6c8c663, Section 5.4, "The compilation").
%% ===========================================================================

procedure agent_goal(Stream(Trigger)?, Stream(Trigger)?, YesNo?, Stream(Trigger),
    Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
agent_goal([T|Ls], In, U, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    then_local(U?, Th),
    step(T?, Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
agent_goal([], [T|In], U, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    then_read(U?, Th),
    step(T?, Th?, [], In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
agent_goal([], [], _, [], [], [], [], _, _, _).

%% After a recheck, read from the agent goal's own list, an own trigger is unread exactly when one was before it (own_unread, no_own); after another trigger, read from the input stream, an own trigger is written unless one is unread (write_own, own_unread).  An own trigger is read from the input stream, and its clause, step(own, ...), takes no Then: dispatch_own writes the next own trigger after an own transaction taken, and none where none holds.
procedure then_local(YesNo?, Then).
then_local(yes, own_unread).
then_local(no, no_own).
procedure then_read(YesNo?, Then).
then_read(yes, own_unread).
then_read(no, write_own).

procedure step(Trigger?, Then?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
step(req(propose(N)), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(N?), ground(St?) |
    st_app(St?, Ap0),
    ask_next(St?, Ans, Ans1?),
    st_id(St?, Id),
    meeting_peer(N?, Id?, Mp),
    meet_hello(Mp?, N?, St?, Out, Out1?, Thr, Thr1?, St0),
    request_cond(N?, St0?, Cd, St1),
    dispatch_request(Cd?, Th?, Ap0?, Ls?, In?, Ans1, Thr1, Out1, Ow, Approvals?, H?, St1?).
%% A request of the person the agent held, put up again: read as the request, its hello sent and its next request question asked when it was first read (vGLP, Section 5.4, "The compilation": "it holds the request and puts it up again after every dispatch").
step(again(N), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(N?), ground(St?) |
    st_app(St?, Ap0),
    request_cond(N?, St?, Cd, St1),
    dispatch_request(Cd?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
step(net(msg(_, hello(P, N))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(P?), ground(N?), ground(St?) |
    st_app(St?, Ap0),
    hello_cond(P?, St?, Cd),
    dispatch_hello(Cd?, P?, N?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
step(net(msg(_, ihello(P))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(P?), ground(St?) |
    st_app(St?, Ap0),
    ihello_cond(P?, St?, Cd),
    dispatch_ihello(Cd?, P?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
step(net(msg(_, intro(_, Q))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(Q?), ground(St?) |
    st_app(St?, Ap0),
    intro_cond(Q?, St?, Cd),
    dispatch_intro(Cd?, Q?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
step(net(msg(To, cargo(F, X))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(To?), ground(F?), ground(X?), ground(St?) |
    st_app(St?, Ap0),
    message_cond(X?, St?, Cd, St1),
    dispatch_message(Cd?, msg(To?, cargo(F?, X?)), F?, X?, Th?, Ap0?, Ls?,
        In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
step(answered(At, YN), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?), ground(YN?), ground(St?) |
    st_app(St?, Ap0),
    close_approval(At?, Approvals?, Approvals1),
    answer_cond(At?, St?, Cd, St1),
    dispatch_answer(Cd?, YN?, At?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out,
        Ow, Approvals1?, H?, St1?).
step(recheck, Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :- ground(St?) |
    st_pends(St?, Pd),
    st_view(St?, V),
    st_trie(St?, Tr),
    recheck_find(Pd?, V?, Tr?, St?, F),
    recheck1(F?, Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
%% A date of the calendar: today(d) replaced in the state beside the app state, which the conditions read and the view does not show; the app state changing, the starts and the requests the agent holds are put up again (vGLP, Section 5.4, "The compilation": "on each date of which it replaces today(d) and puts up again the starts and requests it holds").  The agent holds today(d) as an atom of the machine state of its app state, which no schema adds or deletes, which atom_of does not show and show_state does not compare.
step(day(D), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    integer(D?), ground(St?) |
    st_app(St?, Ap0),
    st_app(St?, Ap),
    set_today(D?, Ap?, Ap1),
    set_app(St?, Ap1?, St1),
    next(Th?, yes, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
step(own, _, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    take_own(Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).

%% After a dispatch: where the machine state has changed, the new view is written on the output (vGLP b7e3517, Section 5.4, "The compilation": "where the machine state changes, it writes the new view on the output"); where the app state has changed, the approval questions whose question the new app state no longer holds pending are closed; where it has, or the dispatch consumed a start (Kick), the starts held waiting are put up again, by a recheck; and the agent goal writes an own trigger on its stream of own triggers after another trigger read from the input stream, unless an own trigger it has written is still unread, and after an own transaction taken (Then write_own), and none after an own trigger on which none holds (no_own) or while one is unread (own_unread), so that at most one own trigger it has written is unread (vGLP 6c8c663, Section 5.4, "The compilation").
procedure next(Then?, YesNo?, App?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
next(Th, Kick, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next_n(Th?, Kick?, Ap0?, [], Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
%% The same, with the notices Ns the dispatch gives, written after the view (put_notices).
procedure next_n(Then?, YesNo?, App?, Outputs?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
next_n(Th, Kick, Ap0, Ns, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(Ap0?), ground(St?) |
    app_changed(Ap0?, St?, Ca1),
    app_changed(Ap0?, St?, Ca2),
    app_changed(Ap0?, St?, Ca3),
    or(Ca2?, Kick?, Re),
    close_falsified(Ca1?, Approvals?, St?, Approvals1),
    spend(Ca3?, St?, H?, St0, H1),
    repend(Re?, St0?, Ag, St1),
    own_after(Th?, Ow, Ow1?, U),
    app(Ag?, Ls?, L1),
    show_state(Ap0?, St?, Thr, Thr1?),
    put_notices(Ns?, Thr1, Thr2?),
    agent_goal(L1?, In?, U?, Ans, Thr2, Out, Ow1, Approvals1?, H1?, St1?).

%% The view after the dispatch, written where the machine state differs, as a multiset, from that before it, or the approvals pending differ.
procedure show_state(App?, St?, Stream(Output), Stream(Output)?).
show_state(Ap0, St, Thr?, Thr1) :- ground(Ap0?), ground(St?) |
    app_ms(Ap0?, S00),
    st_ms(St?, S10),
    not_today(S00?, S0),
    not_today(S10?, S1),
    ms_eq(S0?, S1?, Sm),
    neg(Sm?, Ch1),
    app_recs(Ap0?, R0),
    approvals_of(R0?, A0),
    st_app(St?, Ap1),
    app_recs(Ap1?, R1),
    approvals_of(R1?, A1),
    same(A0?, A1?, Sa),
    neg(Sa?, Ch2),
    or(Ch1?, Ch2?, Ch),
    show_view(Ch?, St?, Thr, Thr1?).
%% The view after a hello or an ihello is sent or recorded, written where the peer Q, not known before, is known now: on whichever of the two hellos, or of the two ihellos, comes second (vGLP b7e3517, Section 5.4, "The compilation": "when a peer becomes known, the agent goal writes the new view on the output").
procedure show_known(Peer?, St?, St?, Stream(Output), Stream(Output)?, St).
show_known(Q, St0, St, Thr?, Thr1, St?) :- ground(Q?), ground(St0?), ground(St?) |
    known_st(Q?, St0?, B0),
    known_st(Q?, St?, B1),
    neg(B0?, N0),
    and(N0?, B1?, B),
    show_view(B?, St?, Thr, Thr1?).
procedure show_view(YesNo?, St?, Stream(Output), Stream(Output)?).
show_view(no, _, Thr1?, Thr1).
show_view(yes, St, [V?|Thr1?], Thr1) :- view_of(St?, V).
%% The view at the agent state: its machine state, the contract's atoms; the persons it knows, in the order of identifiers; and the approvals its person made that are pending, in the order they were made.
procedure view_of(St?, Output).
view_of(St, view(A?, Ks?, Ps?)) :- ground(St?) |
    st_ms(St?, S),
    atoms_of(S?, A),
    st_known(St?, Ks),
    st_app(St?, Ap),
    app_recs(Ap?, R),
    approvals_of(R?, Ps).
%% The approvals pending in the record R, newest first: each request requested(Rho, K) not ended, by its name, and each answer yes answered(At, yes) not ended, by its attempt; given oldest first.
procedure approvals_of(Recs?, List(Approved)).
approvals_of(R, As?) :- ground(R?) | approvals1(R?, R?, [], As).
procedure approvals1(Recs?, Recs?, List(Approved)?, List(Approved)).
approvals1([], _, Acc, Acc?).
approvals1([requested(Rr, K)|Rs], R, Acc, As?) :- ground(Rr?), integer(K?), ground(R?) |
    mem(ended(Rr?, K?), R?, En),
    rho_name(Rr?, Pn),
    keep_pname(En?, Pn?, Acc?, Acc1),
    approvals1(Rs?, R?, Acc1?, As).
approvals1([answered(At, yes)|Rs], R, Acc, As?) :- ground(At?), ground(R?) |
    mem(ended(At?), R?, En),
    keep_attempt(En?, At?, Acc?, Acc1),
    approvals1(Rs?, R?, Acc1?, As).
approvals1([_|Rs], R, Acc, As?) :- otherwise | approvals1(Rs?, R?, Acc?, As).
procedure rho_name(Rho?, PName).
rho_name(one(C), Pn?) :- request_name(C?, Pn).
rho_name(rho(N), pname(N?)).
procedure keep_pname(YesNo?, PName?, List(Approved)?, List(Approved)).
keep_pname(no, pname(N), Acc, [N?|Acc?]).
keep_pname(_, _, Acc, Acc?) :- otherwise | true.
procedure keep_attempt(YesNo?, Attempt?, List(Approved)?, List(Approved)).
keep_attempt(no, At, Acc, [At?|Acc?]).
keep_attempt(yes, _, Acc, Acc?).
procedure set_today(Integer?, App?, App).
set_today(D, app(S, K, L, R), app([g(today, [n(D?)])|S1?], K?, L?, R?)) :- not_today(S?, S1).
%% The machine state less the day, today(d).
procedure not_today(GAtoms?, GAtoms).
not_today([], []).
not_today([g(today, _)|S], S1?) :- not_today(S?, S1).
not_today([G|S], [G?|S1?]) :- otherwise | not_today(S?, S1).
procedure app_ms(App?, GAtoms).
app_ms(app(S, _, _, _), S?).
procedure st_ms(St?, GAtoms).
st_ms(st(_, app(S, _, _, _), _, _, _, _, _, _, _, _, _, _, _, _), S?).
%% The machine state as the contract writes its atoms, each by atom_of, which the compiler prints from the contract and whose last clause, giving unshown for an atom of no alternative of Atom, covers the type and is never reached.
procedure atoms_of(GAtoms?, List(Atom)).
atoms_of([], []).
atoms_of([G|Gs], As?) :- atom_of(G?, Sh), atoms_of(Gs?, As1), shown_cons(Sh?, As1?, As).
procedure shown_cons(Shown?, List(Atom)?, List(Atom)).
shown_cons(shown(A), As, [A?|As?]).
shown_cons(unshown, As, As?).

%% The notices a dispatch writes on the output, after the view it writes, if any (vGLP f0acbc1, Section 5.4, "The compilation": "when an approval its person made, by a request or by an answer yes, ends by a refusal, a notice refused([t]_j, q, d): [t]_j the part of the refused attempt, q its refuser and d the reason, from the abort outcome, or from the vote where the agent's own vote no refused it").  The effects of the transactions that end an approval by a refusal give the notice, one for each such end: the Propose that refuses at once, a guard's vote no, by Start or by Vote, the Tally that records a no, and the Outcome of an abort (ended_notice).
procedure put_notices(Outputs?, Stream(Output), Stream(Output)?).
put_notices([], Thr1?, Thr1).
put_notices([N|Ns], [N?|Thr?], Thr1) :- put_notices(Ns?, Thr, Thr1?).
%% ended_notice(Ended?, Part?, Refuser?, Reason?, Notices): the notice refused(Part, Q, D) where an approval ended, and none where none did.
procedure ended_notice(YesNo?, Class?, Peer?, Reason?, Outputs).
ended_notice(yes, C, Q, D, [refused(C?, Q?, D?)]).
ended_notice(no, _, _, _, []).
procedure some_peer(Peers?, YesNo).
some_peer([], no).
some_peer([_|_], yes).

procedure app_changed(App?, St?, YesNo).
app_changed(Ap0, St, C?) :- ground(Ap0?), ground(St?) |
    st_app(St?, Ap1),
    same(Ap0?, Ap1?, Sm),
    neg(Sm?, C).

%% own_after(Then?, Ow, Ow1?, U): an own trigger written on Ow, or none, Ow1 the rest of the stream of own triggers, and U whether an own trigger written is unread after it.
procedure own_after(Then?, Stream(Trigger), Stream(Trigger)?, YesNo).
own_after(write_own, [own|Ow1?], Ow1, yes).
own_after(own_unread, Ow1?, Ow1, yes).
own_after(no_own, Ow1?, Ow1, no).

%% repend(Again?, St?, Ag, St1): where the dispatch changed the app state or consumed a start, the requests of its person the agent holds, each put up again, and then a recheck of the starts held waiting, where there are any (vGLP, Section 5.4, "The compilation": "After every dispatch the agent goal puts up again the starts and the requests of its person it holds").  The requests come first, so that a request held while the agent was busy is an approval again before a start of its class is taken, and the person who made it is not asked on that start: "The two-phase commit of the meet then runs with both approvals standing, so no second question is asked" (vGLP #20 Cowork to Code, 2026-10-23 22:09 UTC, item 1).
procedure repend(YesNo?, St?, Stream(Trigger), St).
repend(no, St, [], St?).
repend(yes, St, Ag?, St1?) :- ground(St?) |
    st_pends(St?, Pd),
    pend_triggers(Pd?, Ag0),
    st_reqs(St?, Rq),
    again_triggers(Rq?, Ag1),
    app(Ag1?, Ag0?, Ag),
    set_reqs(St?, [], St1).
%% The requests of its person the agent holds, each put up again, again(N), and taken, held again or dropped on its reading as a request read is.
procedure again_triggers(Proposals?, Stream(Trigger)).
again_triggers([], []).
again_triggers([N|Ns], [again(N?)|Ts?]) :- again_triggers(Ns?, Ts).
procedure pend_triggers(Pends?, Stream(Trigger)).
pend_triggers([], []).
pend_triggers([_|_], [recheck]).

%% --- Request, on the request propose(N) ------------------------------------
%% On the answer propose(N) to a request question, N the request name of a guarded part, the dispatch takes, among the Request of {[t]} to the agent itself for each class [t] of a guarded part with no opener named N that it guards and is ready for, where it is free for [t] and no such request is pending at it, and the Request of rho_N to the opener of the guarded parts with an opener named N, where the agent is free for every class of rho_N, guards one of those parts it is ready for, and rho_N is not pending at it, the one it has taken least recently, where there is one, and drops the request otherwise; the message of the Request carries N for rho_N (vGLP f0acbc1, Section 5.4, "Triggers" and "The compilation"; Definition "Proposing", Request).  The part named N at the agent is the part of the class term that N names at its state (name_class: for a schema with listed roles, with the people its state lists at the place of each), and its class is the class [t] of the Request; for rho_N, the agent's precondition is the same in every part named N, the agent not being the base of its listed roles, whose opener lists their people.  A Request to another agent sends request(rho(N), K), so that agent is known.  The Request is the agent's person's approval of each class of the request, pending until ended (Definition "Cargo, App State, Question, Approval, Free, Ready").
procedure request_cond(Proposal?, St?, RCond, St).
request_cond(N, St, Cd?, St2?) :- ground(N?), ground(St?) |
    st_ms(St?, S),
    name_class(N?, S?, C),
    request_cond0(C?, N?, St?, Cd, St2).
procedure request_cond0(Class?, Proposal?, St?, RCond, St).
request_cond0(C, N, St, Cd?, St2?) :- ground(C?), ground(N?), ground(St?) |
    st_class(C?, St?, R, St1),
    request_cond1(R?, N?, C?, St1?, Cd, St2).
procedure request_cond1(ClassRes?, Proposal?, Class?, St?, RCond, St).
request_cond1(nocls, _, C, St, rrefuse(C?), St?).
request_cond1(cls(I), N, C, St, Cd?, St?) :- ground(I?), ground(N?), ground(C?), ground(St?) |
    term_part_of(I?, C?, Pr),
    request_cands(Pr?, I?, N?, C?, St?, Rq),
    st_made(St?, Md),
    pick_request(Rq?, N?, C?, Md?, Cd).
%% The candidate Request of the part Pr that the request name names, where its condition holds: for a guarded part with no opener, the Request of {[t]} to the agent itself, one(C0), C0 the term that names the class at the agent, where it is free for [t], ready for the part named N, which it guards, and has no request of {[t]} pending (vGLP, Section 5.4, "The compilation": "the Request of {[t]} to itself for each class [t] of a guarded part with no opener named N that it guards and is ready for"); for a guarded part with an opener, the Request of rho_N to the opener, where the agent is a guard of the part and not its opener, is free for every class of rho_N, its state is in the domain of its effect in the part, rho_N is not pending at it, and the opener is known.  With the candidates, rq(Cs, Busy, Ready): Busy, whether the agent, a guard of the part and not its opener, is not free for a class of its Request, and Ready, whether it is ready for the part, which it guards or opens.
procedure request_cands(PartRes?, Info?, Proposal?, Class?, St?, RQ).
request_cands(nopart, _, _, _, _, rq([], no, no)).
request_cands(part(pt(_, G, guarded_part)), I, _, C, St, rq(Cs?, Bz?, RdN?)) :- ground(G?), ground(I?), ground(C?), ground(St?) |
    st_id(St?, Id),
    mem(Id?, G?, Gd),
    free_i(I?, St?, Fr),
    st_ms(St?, S),
    part_dom(C?, Id?, S?, Dm),
    self_request(I?, St?, NPd),
    and(Gd?, Fr?, B1),
    and(B1?, Dm?, B2),
    and(B2?, NPd?, B),
    self_cand(B?, C?, Id?, Cs),
    neg(Fr?, NFr),
    and(Gd?, NFr?, Bz),
    and(Gd?, Dm?, RdN).
request_cands(part(pt(_, G, opener(O))), _, N, C, St, rq(Cs?, Bz?, RdN?)) :-
    ground(G?), ground(N?), ground(C?), ground(St?) |
    st_id(St?, Id),
    mem(Id?, G?, Gd),
    same(O?, Id?, Me),
    neg(Me?, NMe),
    free_rho(N?, St?, Fr),
    st_ms(St?, S),
    part_dom(C?, Id?, S?, Rd),
    st_app(St?, Ap),
    app_recs(Ap?, Rc),
    pending_request(rho(N?), Rc?, Pd),
    neg(Pd?, NPd),
    known_st(O?, St?, Kn),
    and(Gd?, NMe?, B1),
    and(B1?, Fr?, B2),
    and(B2?, Rd?, B3),
    and(B3?, NPd?, B4),
    and(B4?, Kn?, B),
    rho_cand(B?, N?, O?, Cs),
    neg(Fr?, NFr),
    and(B1?, NFr?, Bz),
    or(Gd?, Me?, GO),
    st_ms(St?, S2),
    part_dom(C?, Id?, S2?, Dm),
    and(GO?, Dm?, RdN).
procedure rho_cand(YesNo?, Proposal?, Peer?, RCands).
rho_cand(yes, N, O, [rc(rho(N?), O?)]).
rho_cand(no, _, _, []).
%% Whether no request of the agent to itself of the class I is pending: "where it is free for [t] and no such request is pending at it" (vGLP, Section 5.4, "The compilation").  A request of {[t]} is recorded by the term of the part it names, one(C), so that it is proposed on, and shown in the view, by its name (Section 5.4: "the requests by their names"; "of the class of a pending request, only the parts that request names"), and it is of the class of that term.
procedure self_request(Info?, St?, YesNo).
self_request(I, St, NPd?) :- ground(I?), ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, Rc),
    class_request0(Rc?, I?, Pd),
    neg(Pd?, NPd).
procedure class_request0(Recs?, Info?, YesNo).
class_request0(R, I, B?) :- ground(R?) | class_request(R?, I?, R?, B).
procedure class_request(Recs?, Info?, Recs?, YesNo).
class_request([], _, _, no).
class_request([requested(one(C), K)|Rs], I, R, B?) :- ground(C?), ground(I?), ground(R?), integer(K?) |
    mem(ended(one(C?), K?), R?, Done),
    neg(Done?, Open),
    term_of_class(C?, I?, Of),
    and(Open?, Of?, P),
    class_request1(P?, Rs?, I?, R?, B).
class_request([_|Rs], I, R, B?) :- otherwise | class_request(Rs?, I?, R?, B).
procedure class_request1(YesNo?, Recs?, Info?, Recs?, YesNo).
class_request1(yes, _, _, _, yes).
class_request1(no, Rs, I, R, B?) :- class_request(Rs?, I?, R?, B).
procedure self_cand(YesNo?, Class?, Peer?, RCands).
self_cand(yes, C, Id, [rc(one(C?), Id?)]).
self_cand(no, _, _, []).
%% A request pending at the agent: recorded requested(Rho, K) and not ended(Rho, K).
procedure pending_request(Rho?, Recs?, YesNo).
pending_request(R, Rc, B?) :- ground(Rc?) | pending_request1(Rc?, R?, Rc?, B).
procedure pending_request1(Recs?, Rho?, Recs?, YesNo).
pending_request1([], _, _, no).
pending_request1([requested(R1, K)|Rs], R, Rc, B?) :- ground(R1?), ground(R?), ground(Rc?), integer(K?) |
    same(R1?, R?, Sm),
    mem(ended(R1?, K?), Rc?, En),
    neg(En?, NEn),
    and(Sm?, NEn?, P),
    pending_request2(P?, Rs?, R?, Rc?, B).
pending_request1([_|Rs], R, Rc, B?) :- otherwise | pending_request1(Rs?, R?, Rc?, B).
procedure pending_request2(YesNo?, Recs?, Rho?, Recs?, YesNo).
pending_request2(yes, _, _, _, yes).
pending_request2(no, Rs, R, Rc, B?) :- pending_request1(Rs?, R?, Rc?, B).
%% Free for every class of rho_N: the lock unset and no question pending of a class of rho_N.
procedure free_rho(Proposal?, St?, YesNo).
free_rho(N, St, B?) :- ground(N?), ground(St?) |
    st_app(St?, Ap),
    app_lock_recs(Ap?, L, R),
    st_id(St?, Id),
    free_rho1(L?, R?, N?, Id?, St?, B).
procedure free_rho1(Lock?, Recs?, Proposal?, Peer?, St?, YesNo).
free_rho1(L, R, N, Id, St, B?) :- ground(R?) |
    unlocked(L?, U),
    no_rho_question(R?, N?, Id?, St?, R?, Q),
    and(U?, Q?, B).
procedure no_rho_question(Recs?, Proposal?, Peer?, St?, Recs?, YesNo).
no_rho_question([], _, _, _, _, yes).
no_rho_question([asked(At)|Rs], N, Id, St, R, B?) :- ground(At?), ground(N?), ground(Id?), ground(R?) |
    pending_rec(At?, R?, P),
    rho_question(P?, At?, N?, Id?, St?, Q, St1),
    no_rho_question1(Q?, Rs?, N?, Id?, St1?, R?, B).
no_rho_question([_|Rs], N, Id, St, R, B?) :- otherwise | no_rho_question(Rs?, N?, Id?, St?, R?, B).
%% A question pending, and only then its class, which Start found and the state keeps, read from the state, which is given back: whether it is a class of rho_N.
procedure rho_question(YesNo?, Attempt?, Proposal?, Peer?, St?, YesNo, St).
rho_question(no, _, _, _, St, no, St?).
rho_question(yes, At, N, Id, St, Q?, St1?) :-
    attempt_class(At?, C),
    st_class(C?, St?, Cr, St1),
    cls_in_rho(Cr?, N?, Id?, Q).
procedure no_rho_question1(YesNo?, Recs?, Proposal?, Peer?, St?, Recs?, YesNo).
no_rho_question1(yes, _, _, _, _, _, no).
no_rho_question1(no, Rs, N, Id, St, R, B?) :- no_rho_question(Rs?, N?, Id?, St?, R?, B).
procedure cls_in_rho(ClassRes?, Proposal?, Peer?, YesNo).
cls_in_rho(nocls, _, _, no).
cls_in_rho(cls(I), N, Id, B?) :- in_rho(I?, N?, Id?, B).
%% Whether the class I is a class of rho_N: a guarded part of it with an opener is named N, one of the schema-bindings that determine the part having the request name N (request_name; Definition "Effective Local Specification": "whether a class is in rho_N being decidable from a part of it and N").
procedure in_rho(Info?, Proposal?, Peer?, YesNo).
in_rho(ci(_, _, Q, Pts, Ms), N, Id, B?) :- ground(Q?), ground(Ms?), ground(N?) |
    opener_parts(Pts?, Q?, Ms?, N?, Id?, B).
procedure opener_parts(Parts?, Peers?, Mates?, Proposal?, Peer?, YesNo).
opener_parts([], _, _, _, _, no).
opener_parts([pt(T, G, opener(_))|Ps], Q, Ms, N, Id, B?) :-
    ground(T?), ground(G?), ground(Q?), ground(Ms?), ground(N?) |
    part_named(Ms?, T?, G?, Q?, N?, Id?, B1),
    opener_parts1(B1?, Ps?, Q?, Ms?, N?, Id?, B).
opener_parts([pt(_, _, guarded_part)|Ps], Q, Ms, N, Id, B?) :- opener_parts(Ps?, Q?, Ms?, N?, Id?, B).
procedure opener_parts1(YesNo?, Parts?, Peers?, Mates?, Proposal?, Peer?, YesNo).
opener_parts1(yes, _, _, _, _, _, yes).
opener_parts1(no, Ps, Q, Ms, N, Id, B?) :- opener_parts(Ps?, Q?, Ms?, N?, Id?, B).
procedure part_named(Mates?, Class?, Peers?, Peers?, Proposal?, Peer?, YesNo).
part_named([], _, _, _, _, _, no).
part_named([mate(Nm, Bn, G1, _)|Ms], T, G, Q, N, Id, B?) :-
    ground(Nm?), ground(Bn?), ground(G1?), ground(T?), ground(G?), ground(Q?), ground(N?) |
    binding_of(T?, Nm2, Bn2),
    same_bpart(Q?, Nm?, Bn?, G1?, Nm2?, Bn2?, G?, Sp),
    class_of(Nm?, Bn?, Id?, C),
    request_name(C?, Pn),
    pname_is(Pn?, N?, Nn),
    and(Sp?, Nn?, B1),
    part_named1(B1?, Ms?, T?, G?, Q?, N?, Id?, B).
procedure part_named1(YesNo?, Mates?, Class?, Peers?, Peers?, Proposal?, Peer?, YesNo).
part_named1(yes, _, _, _, _, _, _, yes).
part_named1(no, Ms, T, G, Q, N, Id, B?) :- part_named(Ms?, T?, G?, Q?, N?, Id?, B).
procedure pname_is(PName?, Proposal?, YesNo).
pname_is(pname(M), N, B?) :- same(M?, N?, B).
pname_is(nopname, _, no).
%% The part of the class I that the schema-binding the term C names determines.
procedure term_part_of(Info?, Class?, PartRes).
term_part_of(I, C, Pr?) :- ground(I?), ground(C?) |
    info_parts(I?, Pts),
    term_part_of1(Pts?, I?, C?, Pr).
procedure term_part_of1(Parts?, Info?, Class?, PartRes).
term_part_of1([], _, _, nopart).
term_part_of1([pt(T, G, Op)|Ps], I, C, Pr?) :- ground(T?), ground(G?), ground(Op?), ground(I?), ground(C?) |
    same_part(I?, C?, T?, B),
    term_part_of2(B?, pt(T?, G?, Op?), Ps?, I?, C?, Pr).
procedure term_part_of2(YesNo?, Part?, Parts?, Info?, Class?, PartRes).
term_part_of2(yes, P, _, _, _, part(P?)).
term_part_of2(no, _, Ps, I, C, Pr?) :- term_part_of1(Ps?, I?, C?, Pr).
%% Of the candidate Requests, the one the agent has taken least recently: one never taken before one taken, and of those taken, the one taken longest ago, the requests the agent has made being in the order it last made them; ties to the first.  Where there is none: the request held, rhold(N), where the agent is not free for a class of its Request; and otherwise dropped, rdrop, or, where the agent is ready for no part named N that it guards or opens, dropped with the notice refused(C, p, unable), rrefuse(C), C the part N names at the agent (vGLP, Section 5.4, "The compilation": "where the agent is not free for a class of such a Request, it holds the request and puts it up again after every dispatch; and it drops the request where the agent is free and none is enabled, with a notice refused(N, p, unable) where the agent is ready for no part named N that it guards or opens").
procedure pick_request(RQ?, Proposal?, Class?, Rhos?, RCond).
pick_request(rq([X|Xs], _, _), _, _, Md, Cd?) :- ground(Md?) |
    least_rcand(Xs?, Md?, X?, Y),
    rcand_go(Y?, Cd).
pick_request(rq([], yes, _), N, _, _, rhold(N?)).
pick_request(rq([], no, yes), _, _, _, rdrop).
pick_request(rq([], no, no), _, C, _, rrefuse(C?)).
procedure least_rcand(RCands?, Rhos?, RCand?, RCand).
least_rcand([], _, Y, Y?).
least_rcand([X|Xs], Md, Y, Z?) :- ground(X?), ground(Y?), ground(Md?) |
    rcand_place(X?, Md?, AX),
    rcand_place(Y?, Md?, AY),
    less_int(AX?, AY?, L),
    least_rcand1(L?, X?, Y?, Xs?, Md?, Z).
procedure least_rcand1(YesNo?, RCand?, RCand?, RCands?, Rhos?, RCand).
least_rcand1(yes, X, _, Xs, Md, Z?) :- least_rcand(Xs?, Md?, X?, Z).
least_rcand1(no, _, Y, Xs, Md, Z?) :- least_rcand(Xs?, Md?, Y?, Z).
procedure rcand_place(RCand?, Rhos?, Integer).
rcand_place(rc(R, _), Md, A?) :- rho_place(Md?, R?, 1, A).
procedure rho_place(Rhos?, Rho?, Integer?, Integer).
rho_place([], _, _, 0).
rho_place([X|Xs], R, K, A?) :- ground(X?), ground(R?), integer(K?) |
    same(X?, R?, Sm),
    rho_place1(Sm?, Xs?, R?, K?, A).
procedure rho_place1(YesNo?, Rhos?, Rho?, Integer?, Integer).
rho_place1(yes, _, _, K, K?).
rho_place1(no, Xs, R, K, A?) :- K1 := K? + 1, rho_place(Xs?, R?, K1?, A).
procedure less_int(Integer?, Integer?, YesNo).
less_int(A, B, yes) :- A? < B? | true.
less_int(A, B, no) :- A? >= B? | true.
procedure rcand_go(RCand?, RCond).
rcand_go(rc(R, O), rgo(R?, O?)).

procedure dispatch_request(RCond?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net),
    Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_request(rgo(R, O), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(R?), ground(St?) |
    request_effect(R?, O?, St?, Ss, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?).
dispatch_request(rdrop, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
dispatch_request(rhold(N), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(N?), ground(St?) |
    st_reqs(St?, Rq),
    remove_all(N?, Rq?, Rq1),
    app(Rq1?, [N?], Rq2),
    set_reqs(St?, Rq2?, St1),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
dispatch_request(rrefuse(C), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(C?), ground(St?) |
    st_id(St?, Id),
    next_n(Th?, no, Ap0?, [refused(C?, Id?, unable)], Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).

%% Request rho to O: the agent's number one more, the new value the request's number K; requested(rho, K) recorded; the request noted last among those the agent has made; and, where O is not the agent, request(rho, K) sent to O (Definition "Proposing", Request).
procedure request_effect(Rho?, Peer?, St?, Sends, St).
request_effect(R, O, St, Ss?, St2?) :- ground(R?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    request_app(R?, Ap?, K, Ap1),
    request_sends(O?, Id?, R?, K?, Ss),
    set_app(St?, Ap1?, St1),
    note_made(R?, St1?, St2).
procedure request_app(Rho?, App?, Integer, App).
request_app(R, app(S, K, L, Rc), K1?, app(S?, K2?, L?, [requested(R?, K3?)|Rc?])) :- integer(K?) |
    K1 := K? + 1,
    K2 := K? + 1,
    K3 := K? + 1.
procedure request_sends(Peer?, Peer?, Rho?, Integer?, Sends).
request_sends(O, Id, _, _, []) :- O? =?= Id? | true.
request_sends(O, _, R, K, [to(O?, request(R?, K?))]) :- otherwise | true.
%% The requests the agent has made, R put last and its earlier place dropped.
procedure note_made(Rho?, St?, St).
note_made(R, St, St1?) :- ground(R?), ground(St?) |
    st_made(St?, Md),
    remove_all(R?, Md?, Md1),
    app(Md1?, [R?], Md2),
    set_made(St?, Md2?, St1).

%% --- Propose, an own transaction ---------------------------------------------
%% The Propose of the part P of the class I, its attempt naming Nm (Definition "Proposing", Propose), taken on an own trigger (own_cond): its effect, and on it the views and notices written.
procedure dispatch_propose(PCond?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net),
    Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_propose(pgo(I, P, Nm), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(I?), ground(P?), ground(Nm?), ground(St?) |
    propose_effect(I?, P?, Nm?, St?, Ss, Ns, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next_n(Th?, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?).
dispatch_propose(pdrop, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).


%% --- Discover: the hellos ---------------------------------------------------
%% A peer is known once hello has been sent to it and received from it.  On the request propose(N), N the request name of a meeting part with a peer Q, the agent goal, besides what it does on any request, sends Q hello carrying N and records Q as sent to, unless Q is known or already sent to (meet_hello).  On an arriving hello from Q it records Q as received from and, unless it has sent Q a hello, asks its person the approval question of the clause of N, with its pragma, by a goal that shows Q and takes yes or no: the person's yes is their request propose(N) with Q, which the agent goal reads as any request, and on their no it does nothing (greet_unless).  Where a peer becomes known the agent goal writes the new view on the output (vGLP, Section 5.4, "The compilation").  A contract with no guarded part has no meeting part, and its agents send no hello.
procedure meet_hello(MeetPeer?, Proposal?, St?, Stream(Net), Stream(Net)?,
    Stream(Output), Stream(Output)?, St).
meet_hello(nopeer, _, St, Out1?, Out1, Thr1?, Thr1, St?).
meet_hello(peer(Q), N, St, Out?, Out1, Thr?, Thr1, St1?) :- ground(Q?), ground(N?), ground(St?) |
    known_st(Q?, St?, K),
    st_sent(St?, Se),
    mem(Q?, Se?, S),
    or(K?, S?, B),
    meet_hello1(B?, Q?, N?, St?, Out, Out1?, Thr, Thr1?, St1).
procedure meet_hello1(YesNo?, Peer?, Proposal?, St?, Stream(Net), Stream(Net)?,
    Stream(Output), Stream(Output)?, St).
meet_hello1(yes, _, _, St, Out1?, Out1, Thr1?, Thr1, St?).
meet_hello1(no, Q, N, St, [msg(Q?, hello(Id?, N?))|Out1?], Out1, Thr?, Thr1, St2?) :-
    ground(Q?), ground(N?), ground(St?) |
    st_id(St?, Id),
    add_sent(Q?, St?, St1),
    show_known(Q?, St?, St1?, Thr, Thr1?, St2).
%% The peer of a meeting part whose two roles hold A and B, beside the agent Me (meeting_peer): the other, where Me holds one of them and another person the other; none otherwise.
procedure meet_other(Peer?, Peer?, Peer?, MeetPeer).
meet_other(A, B, Me, P?) :- ground(A?), ground(B?), ground(Me?) |
    same(A?, Me?, SA),
    same(B?, Me?, SB),
    meet_other1(SA?, SB?, A?, B?, P).
procedure meet_other1(YesNo?, YesNo?, Peer?, Peer?, MeetPeer).
meet_other1(yes, no, _, B, peer(B?)).
meet_other1(no, yes, A, _, peer(A?)).
meet_other1(yes, yes, _, _, nopeer).
meet_other1(no, no, _, _, nopeer).

%% An arriving hello, recorded unless recorded already.
procedure hello_cond(Peer?, St?, YesNo).
hello_cond(P, St, R?) :- ground(St?) |
    st_recd(St?, Rc),
    mem(P?, Rc?, B),
    neg(B?, R).

procedure dispatch_hello(YesNo?, Peer?, Proposal?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net),
    Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_hello(yes, P, N, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(P?), ground(N?), ground(St?) |
    st_sent(St?, Se),
    mem(P?, Se?, Sent),
    add_recd(P?, St?, St1),
    show_known(P?, St?, St1?, Thr, Thr1?, St2),
    greet_unless(Sent?, P?, N?, St2?, Ans, Ans1?, St3),
    next(Th?, no, Ap0?, Ls?, In?, Ans1, Thr1, Out, Ow, Approvals?, H?, St3?).
dispatch_hello(no, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
%% The approval question of the meeting a hello from P carries, N, asked unless the agent has sent P a hello, its answers joining the agent goal's input; with pragmas, with the sentence of the clause of N, Me the agent, as sentence_of gives it for the class N names at its machine state.
procedure greet_unless(YesNo?, Peer?, Proposal?, St?, Stream(Trigger), Stream(Trigger)?, St).
greet_unless(yes, _, _, St, Ans1?, Ans1, St?).
greet_unless(no, P, N, St, Ans?, Ans1, St?) :- ground(P?), ground(N?) |
    greet(P?, N?, R),
    merge(R?, Ans1?, Ans).

%% --- Introduce: the ihellos --------------------------------------------------
%% On reading an introduction intro(Q) the agent sends Q ihello, unless Q is itself or known or it has sent one; an arriving ihello is recorded; and where a peer becomes known by the two the agent writes the new view on the output (Section 5.4).
procedure intro_cond(Peer?, St?, YesNo).
intro_cond(Q, St, R?) :- ground(Q?), ground(St?) |
    st_id(St?, Id),
    st_isent(St?, ISe),
    same(Q?, Id?, S1),
    mem(Q?, ISe?, S2),
    known_st(Q?, St?, S3),
    or(S1?, S2?, S12),
    or(S12?, S3?, S),
    neg(S?, R).

procedure dispatch_intro(YesNo?, Peer?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net),
    Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_intro(yes, Q, Th, Ap0, Ls, In, Ans?, Thr?, [msg(Q?, ihello(Id?))|Out?],
        Ow?, Approvals, H, St) :-
    ground(Q?), ground(St?) |
    st_id(St?, Id),
    add_isent(Q?, St?, St1),
    show_known(Q?, St?, St1?, Thr, Thr1?, St2),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, H?, St2?).
dispatch_intro(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).

procedure ihello_cond(Peer?, St?, YesNo).
ihello_cond(P, St, R?) :- ground(St?) |
    st_irecd(St?, Rc),
    mem(P?, Rc?, B),
    neg(B?, R).

procedure dispatch_ihello(YesNo?, Peer?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net),
    Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_ihello(yes, P, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(P?), ground(St?) |
    add_irecd(P?, St?, St1),
    show_known(P?, St?, St1?, Thr, Thr1?, St2),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, H?, St2?).
dispatch_ihello(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).

%% --- Start, Tally, Yield and Outcome, on the arriving message ---------------
%% One schema to a cargo, none needing a peer known: the initiator's hello
%% precedes its start on one stream, and an initiator knows every other
%% participant from its Propose.  Start is taken where the
%% start does not wait or its attempt is closed at the agent, and otherwise
%% the agent holds it waiting (Definition "Priority, Waiting, Blocked,
%% Clear"), putting it up again, by a
%% recheck, after every dispatch that changes the app state or consumes a
%% start.  A request, request(Rho, K), is held, mhold, until the refusal of an
%% attempt naming it or a commit of its class (vGLP f0acbc1, Section 5.4,
%% "The compilation": "On a message request(rho, k) it holds the request until
%% it deletes it").
procedure message_cond(Cargo?, St?, MCond, St).
message_cond(request(_, _), St, mhold, St?).
message_cond(start(At), St, Cd?, St1?) :- ground(At?), ground(St?) |
    attempt_class(At?, C),
    st_class(C?, St?, R, St0),
    message_cond1(R?, start(At?), St0?, Cd, St1).
message_cond(vote(At, V), St, Cd?, St1?) :- ground(At?), ground(St?) |
    attempt_class(At?, C),
    st_class(C?, St?, R, St0),
    message_cond1(R?, vote(At?, V?), St0?, Cd, St1).
message_cond(yield(At), St, Cd?, St1?) :- ground(At?), ground(St?) |
    attempt_class(At?, C),
    st_class(C?, St?, R, St0),
    message_cond1(R?, yield(At?), St0?, Cd, St1).
message_cond(outcome(At, Z), St, Cd?, St1?) :- ground(At?), ground(St?) |
    attempt_class(At?, C),
    st_class(C?, St?, R, St0),
    message_cond1(R?, outcome(At?, Z?), St0?, Cd, St1).
procedure message_cond1(ClassRes?, Cargo?, St?, MCond, St).
%% A cargo reaches only a participant of its attempt, so its class is always
%% one the agent takes part in; noparticipant, the other alternative of ClassRes,
%% which the type requires covered, is never reached; nor is a request, which
%% message_cond holds.
message_cond1(nocls, _, St, noparticipant, St?).
message_cond1(_, request(_, _), St, mhold, St?).
message_cond1(cls(I), start(At), St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) |
    st_closed(At?, St?, Cl),
    start_cond(Cl?, I?, At?, St?, Cd).
message_cond1(cls(I), vote(_, _), St, mgo(I?), St?).
message_cond1(cls(I), yield(_), St, mgo(I?), St?).
message_cond1(cls(I), outcome(_, _), St, mgo(I?), St?).
procedure start_cond(YesNo?, Info?, Attempt?, St?, MCond).
start_cond(yes, I, _, _, mgo(I?)).
start_cond(no, I, At, St, Cd?) :- ground(I?) |
    start_waits(I?, At?, St?, W),
    defer_cond1(W?, I?, Cd).
procedure defer_cond1(YesNo?, Info?, MCond).
defer_cond1(yes, _, mdefer).
defer_cond1(no, I, mgo(I?)).

%% A start of A, of the class I, waits while a start of an attempt with
%% priority over A is held, or a question with priority over A and answered
%% yes is pending, or while the agent is not free for the class.
procedure start_waits(Info?, Attempt?, St?, YesNo).
start_waits(I, A, St, W?) :- st_view(St?, V), start_waits_v(I?, A?, V?, W).
procedure start_waits_v(Info?, Attempt?, V?, YesNo).
start_waits_v(I, A, V, W?) :- ground(A?), ground(V?) |
    v_pends(V?, Pd),
    held_prior(Pd?, A?, W1),
    v_recs(V?, R),
    question_prior(R?, A?, W2),
    free_v(I?, V?, Fr),
    neg(Fr?, W3),
    or(W1?, W2?, W12),
    or(W12?, W3?, W).
procedure held_prior(Pends?, Attempt?, YesNo).
held_prior([], _, no).
held_prior([deferred(msg(_, cargo(_, start(B))))|Ps], A, W?) :- ground(A?), ground(B?) |
    same(A?, B?, Sm),
    prio(B?, A?, Pr),
    neg(Sm?, NSm),
    and(NSm?, Pr?, W1),
    held_prior1(W1?, Ps?, A?, W).
held_prior([_|Ps], A, W?) :- otherwise | held_prior(Ps?, A?, W).
procedure held_prior1(YesNo?, Pends?, Attempt?, YesNo).
held_prior1(yes, _, _, yes).
held_prior1(no, Ps, A, W?) :- held_prior(Ps?, A?, W).
%% A question pending, answered yes, other than A and with priority over it.
procedure question_prior(Recs?, Attempt?, YesNo).
question_prior(R, A, W?) :- ground(R?) | question_prior1(R?, R?, A?, W).
procedure question_prior1(Recs?, Recs?, Attempt?, YesNo).
question_prior1([], _, _, no).
question_prior1([answered(G, yes)|Rs], R, A, W?) :- ground(G?), ground(R?), ground(A?) |
    pending_rec(G?, R?, P),
    same(G?, A?, Sm),
    neg(Sm?, NSm),
    prio(G?, A?, Pr),
    and(P?, NSm?, W0),
    and(W0?, Pr?, W1),
    question_prior2(W1?, Rs?, R?, A?, W).
question_prior1([_|Rs], R, A, W?) :- otherwise | question_prior1(Rs?, R?, A?, W).
procedure question_prior2(YesNo?, Recs?, Recs?, Attempt?, YesNo).
question_prior2(yes, _, _, _, yes).
question_prior2(no, Rs, R, A, W?) :- question_prior1(Rs?, R?, A?, W).
%% A question pending and answered yes waits while one with priority over it
%% and answered yes is pending, or while the lock is set.
procedure question_waits(Attempt?, V?, YesNo).
question_waits(A, v(_, _, L, R, _, _), W?) :-
    question_prior(R?, A?, W1),
    unlocked(L?, U),
    neg(U?, W2),
    or(W1?, W2?, W).
procedure app_lock_recs(App?, Lock, Recs).
app_lock_recs(app(_, _, L, R), L?, R?).
%% Free for the class: the lock unset and no question of the class pending.
procedure free_i(Info?, St?, YesNo).
free_i(I, st(_, app(_, _, L, R), _, _, _, _, _, _, _, _, _, _, _, _), B?) :- free_lr(I?, L?, R?, B).
procedure free_v(Info?, V?, YesNo).
free_v(I, v(_, _, L, R, _, _), B?) :- free_lr(I?, L?, R?, B).
procedure free_lr(Info?, Lock?, Recs?, YesNo).
free_lr(I, L, R, B?) :- ground(R?) |
    unlocked(L?, B1),
    no_question(I?, R?, R?, B2),
    and(B1?, B2?, B).
%% What blocks a waiting start of the class I: the lock where set, and
%% otherwise the question of I pending; and a question answered yes: the lock.
procedure start_blocker(YesNo?, Info?, V?, Blocker).
start_blocker(no, _, _, noblk).
start_blocker(yes, I, v(_, _, L, R, _, _), Bk?) :- start_blocker1(L?, I?, R?, Bk).
procedure start_blocker1(Lock?, Info?, Recs?, Blocker).
start_blocker1(held(B), _, _, blk(B?)).
start_blocker1(unlocked, I, R, Bk?) :- ground(R?) | class_question(R?, I?, R?, Bk).
procedure class_question(Recs?, Info?, Recs?, Blocker).
class_question([], _, _, noblk).
class_question([asked(G)|Rs], I, R, Bk?) :- ground(G?), ground(I?), ground(R?) |
    pending_rec(G?, R?, P),
    of_class(G?, I?, Cl),
    and(P?, Cl?, B),
    class_question1(B?, G?, Rs?, I?, R?, Bk).
class_question([_|Rs], I, R, Bk?) :- otherwise | class_question(Rs?, I?, R?, Bk).
procedure class_question1(YesNo?, Attempt?, Recs?, Info?, Recs?, Blocker).
class_question1(yes, G, _, _, _, blk(G?)).
class_question1(no, _, Rs, I, R, Bk?) :- class_question(Rs?, I?, R?, Bk).
procedure question_blocker(YesNo?, V?, Blocker).
question_blocker(no, _, noblk).
question_blocker(yes, v(_, _, L, _, _, _), Bk?) :- lock_blocker(L?, Bk).
procedure lock_blocker(Lock?, Blocker).
lock_blocker(held(B), blk(B?)).
lock_blocker(unlocked, noblk).
%% Priority: the smaller rank first, ties broken by the order of identifiers.
procedure prio(Attempt?, Attempt?, YesNo).
prio(A, B, P?) :- ground(A?), ground(B?) |
    attempt_rank(A?, RA),
    attempt_rank(B?, RB),
    attempt_id(A?, IA),
    attempt_id(B?, IB),
    prio1(RA?, RB?, IA?, IB?, P).
procedure prio1(Integer?, Integer?, Peer?, Peer?, YesNo).
prio1(RA, RB, _, _, yes) :- RA? < RB? | true.
prio1(RA, RB, _, _, no) :- RA? > RB? | true.
prio1(RA, RB, IA, IB, P?) :- RA? =:= RB? | precedes(IA?, IB?, P).



%% The recheck, after a dispatch that changes the app state or consumes a
%% start: the first start held that does not wait, or whose attempt is
%% closed, is put up, and taken; none, nothing.
procedure recheck_find(Pends?, V?, Trie?, St?, FoundNet).
recheck_find([], _, _, _, nonefound).
recheck_find([deferred(M)|Ps], V, Tr, St, F?) :- ground(M?), ground(V?) |
    held_takeable(M?, V?, Tr?, St?, T, Tr1, St1),
    recheck_find1(T?, M?, Ps?, V?, Tr1?, St1?, F).
recheck_find([_|Ps], V, Tr, St, F?) :- otherwise | recheck_find(Ps?, V?, Tr?, St?, F).
procedure recheck_find1(YesNo?, Net?, Pends?, V?, Trie?, St?, FoundNet).
recheck_find1(yes, M, _, _, _, _, found(M?)).
recheck_find1(no, _, Ps, V, Tr, St, F?) :- recheck_find(Ps?, V?, Tr?, St?, F).
%% A start held is taken where its attempt is closed or it does not wait; its class, which Start found and the state keeps, read from the state, which is given back.
procedure held_takeable(Net?, V?, Trie?, St?, YesNo, Trie, St).
held_takeable(msg(_, cargo(_, start(A))), V, Tr, St, T?, Tr1?, St1?) :- ground(A?) |
    attempt_class(A?, C),
    st_class(C?, St?, Cr, St1),
    held_takeable1(Cr?, A?, V?, Tr?, T, Tr1).
held_takeable(_, _, Tr, St, no, Tr?, St?) :- otherwise | true.
procedure held_takeable1(ClassRes?, Attempt?, V?, Trie?, YesNo, Trie).
held_takeable1(nocls, _, _, Tr, no, Tr?).
held_takeable1(cls(I), A, V, Tr, T?, Tr1?) :- ground(A?), ground(V?) |
    v_recs(V?, R),
    trie_closed(A?, R?, Tr?, Cl, Tr1),
    start_waits_v(I?, A?, V?, W),
    neg(W?, NW),
    or(Cl?, NW?, T).
procedure recheck1(FoundNet?, Then?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
recheck1(found(M), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    step(net(M?), Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
recheck1(nonefound, Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :- ground(St?) |
    st_app(St?, Ap0),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).

procedure dispatch_message(MCond?, Net?, Peer?, Cargo?, Then?, App?,
    Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger),
    Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_message(noparticipant, _, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
dispatch_message(mdefer, M, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H,
        St) :-
    add_pend_once(deferred(M?), St?, St1),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
dispatch_message(mgo(I), M, _, start(At), Th, Ap0, Ls, In, Ans?,
        Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?) |
    drop_pend(deferred(M?), St?, St0),
    start_effect(I?, At?, St0?, Ss, Cr, Ns, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    spawn(Cr?, Approvals?, Approvals1, Ans, Ans1?),
    next_n(Th?, yes, Ap0?, Ns?, Ls?, In?, Ans1, Thr, Out1, Ow, Approvals1?, H?, St2?).
dispatch_message(mgo(I), _, F, vote(At, V), Th, Ap0, Ls, In, Ans?,
        Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?) |
    tally_effect(I?, At?, F?, V?, St?, Ss, Ns, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next_n(Th?, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?).
dispatch_message(mgo(I), _, _, yield(At), Th, Ap0, Ls, In, Ans?,
        Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?) |
    yield_effect(I?, At?, St?, Ss, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?).
dispatch_message(mgo(I), _, _, outcome(At, Z), Th, Ap0, Ls, In, Ans?,
        Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?) |
    outcome_effect(I?, At?, Z?, St?, Ns, Ms, St1),
    put_all(Ms?, Out, Out1?),
    next_n(Th?, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St1?).
dispatch_message(mhold, _, F, request(R, K), Th, Ap0, Ls, In, Ans?,
        Thr?, Out?, Ow?, Approvals, H, St) :-
    hold_request(F?, R?, K?, St?, St1),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
%% A request held, held(Q, Rho, K), once, after those held before it.
procedure hold_request(Peer?, Rho?, Integer?, St?, St).
hold_request(F, R, K, St, St1?) :- ground(R?), ground(St?) |
    st_held(St?, Hd),
    hold_once(held(F?, R?, K?), Hd?, Hd1),
    set_held(St?, Hd1?, St1).
procedure hold_once(Held?, Helds?, Helds).
hold_once(X, Hd, Hd1?) :- ground(X?), ground(Hd?) |
    mem(X?, Hd?, In),
    hold_once1(In?, X?, Hd?, Hd1).
procedure hold_once1(YesNo?, Held?, Helds?, Helds).
hold_once1(yes, _, Hd, Hd?).
hold_once1(no, X, Hd, Hd1?) :- app(Hd?, [X?], Hd1).

%% Start raises the approval question, whose answers join the agent goal's input.
procedure spawn(ApprovalRes?, OpenApprovals?, OpenApprovals, Stream(Trigger),
    Stream(Trigger)?).
spawn(noapproval, Cs, Cs?, Ans?, Ans).
spawn(approval_for(At), Cs, [oc(At?, Cl)|Cs?], Ans?, Ans1) :- ground(At?) |
    respond(At?, Cl?, R),
    merge(R?, Ans1?, Ans).

%% --- Answer, on the person's answer to the approval question Start raises ---------------
%% Its condition: the attempt a question pending at the agent, and no answer
%% to it recorded.  It sends nothing, so it needs no peer known.  It is taken
%% where its condition holds, and the answer dropped otherwise.
procedure answer_cond(Attempt?, St?, Cond, St).
answer_cond(At, St, Cd?, St2?) :- ground(At?), ground(St?) |
    attempt_class(At?, C),
    st_class(C?, St?, R, St1),
    answer_cond1(R?, At?, St1?, Cd, St2).
procedure answer_cond1(ClassRes?, Attempt?, St?, Cond, St).
answer_cond1(nocls, _, St, drop, St?).
answer_cond1(cls(I), At, St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, R),
    unanswered(At?, R?, Ok),
    go_or_drop(Ok?, I?, Cd).
procedure unanswered(Attempt?, Recs?, YesNo).
unanswered(At, R, B?) :- ground(At?), ground(R?) |
    pending_rec(At?, R?, P),
    has_answer(At?, R?, H),
    neg(H?, Un),
    and(P?, Un?, B).

procedure dispatch_answer(Cond?, YesNo?, Attempt?, Then?, App?, Stream(Trigger)?,
    Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net),
    Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_answer(go(_), YN, At, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?) |
    answer_effect(YN?, At?, St?, St1),
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
dispatch_answer(drop, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).

%% An approval question is closed by binding its close signal, which also forgets it.
procedure close_approval(Attempt?, OpenApprovals?, OpenApprovals).
close_approval(_, [], []).
close_approval(At, [oc(B, close)|Cs], Cs?) :- At? =?= B? | true.
close_approval(At, [oc(B, Cl?)|Cs], [oc(B?, Cl)|Cs1?]) :- otherwise |
    close_approval(At?, Cs?, Cs1).

%% The approval questions whose question is no longer pending, closed, where the app state
%% has changed.
procedure close_falsified(YesNo?, OpenApprovals?, St?, OpenApprovals).
close_falsified(no, Cs, _, Cs?).
close_falsified(yes, Cs, St, Cs1?) :- ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, R),
    close_approvals(Cs?, R?, Cs1).
procedure close_approvals(OpenApprovals?, Recs?, OpenApprovals).
close_approvals([], _, []).
close_approvals([oc(At, Cl?)|Cs], R, Cs1?) :- ground(At?), ground(R?) |
    pending_rec(At?, R?, P),
    close_one(P?, At?, Cl, Cs?, R?, Cs1).
procedure close_one(YesNo?, Attempt?, Close, OpenApprovals?, Recs?, OpenApprovals).
close_one(no, _, close, Cs, R, Cs1?) :- close_approvals(Cs?, R?, Cs1).
close_one(yes, At, Cl?, Cs, R, [oc(At?, Cl)|Cs1?]) :- close_approvals(Cs?, R?, Cs1).

%% --- The own transactions: Propose, Vote, Commit, Wound, Introduce peers ---
%% On own the agent goal puts up the Propose of each unguarded part the agent opens, and of each guarded part with no opener that it guards of the class of an approval pending at it, where its machine state is in the part's domain, or, where it is in the domain of no such part of that class, of one of them, which it refuses at once; for each request it holds, the Propose of each guarded part named by the request's name that it opens and whose domain holds its machine state, naming that request, or, where there is none, of one such part, which it refuses at once; the Vote on each answered question pending at it, the Commit of each attempt it initiated with a yes of every other participant recorded, the Wound of each start it holds waiting, or answered question, blocked by an attempt over which it has priority, and the Introduce peers of each pair the introduction rule gives it at its machine state; the dispatch takes, among those whose condition holds, one of the class that has waited longest --- since it was last taken or, never taken, since its condition was first found holding --- ties broken in a fixed order: the Proposes of the unguarded parts in the order they are opened, of the guarded parts in the order of the approvals, the oldest first, and on the requests held, in the order they arrived, then the Votes, the Commits, the Wounds and the introductions, each in the order of the record, of the starts held or of identifiers; and counts it, and writes an own trigger on its stream of own triggers; and where none holds, takes nothing and writes none (vGLP f0acbc1, Section 5.4, "The compilation"; Definition "Equivalence of the Canonical Platform": "for a part [t]_j and an agent p, p's proposing class on [t]_j").
procedure take_own(Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger),
    Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
take_own(Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :- ground(St?) |
    st_app(St?, Ap0),
    own_cond(St?, Ch, St1),
    dispatch_own(Ch?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).

procedure own_cond(St?, Choice, St).
own_cond(St, Ch?, St2?) :- ground(St?) |
    opening(St?, Is, St1),
    own_cond1(Is?, St1?, Ch, St2).
procedure own_cond1(Infos?, St?, Choice, St).
own_cond1(Is, St, Ch?, St3?) :- ground(Is?), ground(St?) |
    st_view(St?, V),
    op_cands(Is?, V?, Cs1),
    guard_cands(St?, Csg, St1),
    held_cands(St1?, Csh, St2),
    own_cond1a(St2?, Cs1?, Csg?, Csh?, Ch, St3).
procedure own_cond1a(St?, Cands?, Cands?, Cands?, Choice, St).
own_cond1a(St, Cs1, Csg, Csh, Ch?, St5?) :- ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, R),
    st_view(St?, V),
    vote_cands0(R?, V?, St?, Cs2, St2),
    commit_cands_st(St2?, Cs3, St3),
    wound_cands0(St3?, Cs4, St4),
    intro_cands(St4?, Cs5, St6),
    app(Cs1?, Csg?, Ca),
    app(Ca?, Csh?, Cb),
    app(Cb?, Cs2?, C12),
    app(C12?, Cs3?, C123),
    app(C123?, Cs4?, C1234),
    app(C1234?, Cs5?, Cs),
    own_cond2(Cs?, St6?, Ch, St5).
procedure own_cond2(Cands?, St?, Choice, St).
own_cond2(Cs, St, Ch?, St2?) :- ground(St?) |
    st_waits(St?, W),
    st_app(St?, Ap),
    app_recs(Ap?, R),
    st_ix(St?, Ix),
    prune_waits(W?, R?, Ix?, W0),
    st_count(St?, D),
    choose(Cs?, W0?, D?, Ch0, W1),
    set_waits(St?, W1?, St1),
    count_own(Ch0?, St1?, Ch, St2).
%% The own transaction taken, counted.
procedure count_own(Choice?, St?, Choice, St).
count_own(none, St, none, St?).
count_own(take(K, S), St, take(K?, S?), St1?) :- advance(St?, St1).

%% Propose of an unguarded part, by its opener: each unguarded part of the class I that the agent opens (opening_parts), where Propose's condition holds on the agent (may_propose) and its machine state is in the part's domain; each part the proposing class op(P), P the part's term, and the attempt naming none.
procedure op_cands(Infos?, V?, Cands).
op_cands([], _, []).
op_cands([I|Is], V, Cs?) :- ground(I?), ground(V?) |
    v_id(V?, Id),
    info_parts(I?, Pts),
    opening_parts(Pts?, Id?, Ps),
    part_cands(Ps?, I?, V?, Cs1),
    op_cands(Is?, V?, Cs2),
    app(Cs1?, Cs2?, Cs).
procedure part_cands(Classes?, Info?, V?, Cands).
part_cands([], _, _, []).
part_cands([P|Ps], I, V, Cs?) :- ground(P?), ground(I?), ground(V?) |
    may_propose(I?, V?, B1),
    v_id(V?, Id),
    v_ms(V?, S),
    part_dom(P?, Id?, S?, B2),
    and(B1?, B2?, B),
    part_cands(Ps?, I?, V?, Cs1),
    keep_pcand(B?, I?, P?, none, Cs1?, Cs).
procedure keep_pcand(YesNo?, Info?, Class?, Names?, Cands?, Cands).
keep_pcand(yes, I, P, Nm, Cs, [cand(op(P?), prop(I?, P?, Nm?))|Cs?]) :- ground(P?) | true.
keep_pcand(no, _, _, _, Cs, Cs?).
%% Propose's condition on the agent, the part's domain aside (Definition "Proposing", Propose): free for the class, so unlocked, and clear, and knowing every other participant, to each of whom it tells the start, or the outcome where it refuses at once.
procedure may_propose(Info?, V?, YesNo).
may_propose(I, V, B?) :- ground(I?), ground(V?) |
    free_v(I?, V?, Fr),
    no_prior_start(V?, Np),
    others_known(I?, V?, K),
    known_ok(K?, Kn),
    and(Fr?, Np?, B1),
    and(B1?, Kn?, B).

%% Propose of a guarded part with no opener that the agent guards, of the class of an approval pending at it, a request of the class or an answer yes to an attempt of it, neither ended (Definition "Cargo, App State, Question, Approval, Free, Ready"): of the class of a request, the parts the request names, and of the class of an answer yes, each such part (vGLP, Section 5.4, "The compilation": "On an own trigger it puts up the Propose ... of each guarded part with no opener that it guards of the class of an approval pending at it, named by that approval where the approval is a request"); where Propose's condition holds on the agent, each of those parts whose domain holds its machine state, or, where none does, one of them, the first, which propose_effect refuses at once (Definition "Proposing", Propose: "an approval of [t] is pending at p, and s in dom(f^[t]_j_p) or s not in dom(f^[t]_j'_p) for every guarded part [t]_j' of [t] with no opener that p guards").  A request rho_N is of classes whose guarded parts that the agent guards have an opener, which proposes them (Definition "Local Specification, Part, Guard Set, Opener, Request"), so it is no approval the agent proposes on.  The approvals in their order, the oldest first, each class and its parts once.
%% An approval's class and the parts of it the agent proposes on it: ap(I, by_name(C)) for a request, the parts named as the part of the class term C is named, and ap(I, any_part) for an answer yes, every part.
Appr      ::= ap(Info, PartsOf).
Apprs     ::= [] ; [Appr | Apprs].
PartsOf   ::= by_name(Class) ; any_part.
procedure guard_cands(St?, Cands, St).
guard_cands(St, Cs?, St1?) :- ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, R),
    st_view(St?, V),
    approval_classes(R?, St?, Is, St1),
    guard_cands1(Is?, V?, Cs).
procedure approval_classes(Recs?, St?, Apprs, St).
approval_classes(R, St, Is?, St1?) :- ground(R?) | approval_classes1(R?, R?, St?, [], Is, St1).
procedure approval_classes1(Recs?, Recs?, St?, Apprs?, Apprs, St).
approval_classes1([], _, St, Acc, Is?, St?) :- dedup(Acc?, Is).
approval_classes1([requested(one(C), K)|Rs], R, St, Acc, Is?, St2?) :- ground(C?), ground(R?) |
    mem(ended(one(C?), K?), R?, Done),
    approval_class(Done?, C?, by_name(C?), St?, Acc?, Acc1, St1),
    approval_classes1(Rs?, R?, St1?, Acc1?, Is, St2).
approval_classes1([answered(At, yes)|Rs], R, St, Acc, Is?, St2?) :- ground(At?), ground(R?) |
    mem(ended(At?), R?, Done),
    attempt_class(At?, C),
    approval_class(Done?, C?, any_part, St?, Acc?, Acc1, St1),
    approval_classes1(Rs?, R?, St1?, Acc1?, Is, St2).
approval_classes1([_|Rs], R, St, Acc, Is?, St1?) :- otherwise | approval_classes1(Rs?, R?, St?, Acc?, Is, St1).
%% The class of an approval, computed only where the approval has not ended.
procedure approval_class(YesNo?, Class?, PartsOf?, St?, Apprs?, Apprs, St).
approval_class(yes, _, _, St, Acc, Acc?, St?).
approval_class(no, C, F, St, Acc, Acc1?, St1?) :-
    st_class(C?, St?, Cr, St1),
    open_class(no, Cr?, F?, Acc?, Acc1).
procedure open_class(YesNo?, ClassRes?, PartsOf?, Apprs?, Apprs).
open_class(no, cls(I), F, Acc, [ap(I?, F?)|Acc?]).
open_class(no, nocls, _, Acc, Acc?).
open_class(yes, _, _, Acc, Acc?).
procedure guard_cands1(Apprs?, V?, Cands).
guard_cands1([], _, []).
guard_cands1([ap(I, F)|Is], V, Cs?) :- ground(I?), ground(F?), ground(V?) |
    v_id(V?, Id),
    v_ms(V?, S),
    info_parts(I?, Pts),
    guarding_parts(Pts?, Id?, Ps0),
    parts_of(F?, Ps0?, Ps),
    may_propose(I?, V?, B),
    guard_parts_cands(B?, Ps?, I?, Id?, S?, Cs1),
    guard_cands1(Is?, V?, Cs2),
    app(Cs1?, Cs2?, Cs).
%% The parts an approval proposes: of a request, those whose request name is that of the part the request named, its schema-binding (request_name); of an answer yes, all.
procedure parts_of(PartsOf?, Classes?, Classes).
parts_of(any_part, Ps, Ps?).
parts_of(by_name(C), Ps, Ps1?) :- ground(C?) |
    request_name(C?, N),
    parts_named(Ps?, N?, Ps1).
procedure parts_named(Classes?, PName?, Classes).
parts_named([], _, []).
parts_named([P|Ps], N, R?) :- ground(P?), ground(N?) |
    request_name(P?, M),
    same(M?, N?, B),
    parts_named(Ps?, N?, R1),
    keep_class(B?, P?, R1?, R).
procedure guard_parts_cands(YesNo?, Classes?, Info?, Peer?, GAtoms?, Cands).
guard_parts_cands(no, _, _, _, _, []).
guard_parts_cands(yes, Ps, I, Id, S, Cs?) :- ground(Ps?), ground(I?), ground(S?) |
    ready_parts(Ps?, Id?, S?, Rs),
    guard_ready(Rs?, Ps?, I?, Cs).
procedure guard_ready(Classes?, Classes?, Info?, Cands).
guard_ready([], [], _, []).
guard_ready([], [P|_], I, [cand(op(P?), prop(I?, P?, none))]) :- ground(P?) | true.
guard_ready([R|Rs], _, I, Cs?) :- part_pcands([R?|Rs?], I?, Cs).
procedure part_pcands(Classes?, Info?, Cands).
part_pcands([], _, []).
part_pcands([P|Ps], I, [cand(op(P?), prop(I?, P?, none))|Cs?]) :- ground(P?), ground(I?) | part_pcands(Ps?, I?, Cs).

%% Propose on a request the agent holds, held(Q, rho(N), K): the guarded part named N at its state (name_class), where the agent is its opener and Q its guard and Propose's condition holds on the agent, naming the request request(rho(N), K); propose_effect proposes it where the part's domain holds the agent's state, the parts named N whose opener lists the people of its listed roles exactly being that part, and refuses it at once otherwise (Section 5.4, "The compilation").  The requests in the order they arrived.
procedure held_cands(St?, Cands, St).
held_cands(St, Cs?, St1?) :- ground(St?) |
    st_held(St?, Hd),
    st_view(St?, V),
    held_cands1(Hd?, V?, St?, Cs, St1).
procedure held_cands1(Helds?, V?, St?, Cands, St).
held_cands1([], _, St, [], St?).
held_cands1([held(F, rho(N), K)|Hs], V, St, Cs?, St2?) :- ground(N?), ground(V?) |
    v_ms(V?, S),
    name_class(N?, S?, C),
    held_cand0(C?, F?, N?, K?, V?, St?, Cs1, St1),
    held_cands1(Hs?, V?, St1?, Cs2, St2),
    app(Cs1?, Cs2?, Cs).
held_cands1([held(_, one(_), _)|Hs], V, St, Cs?, St1?) :- held_cands1(Hs?, V?, St?, Cs, St1).
procedure held_cand0(Class?, Peer?, Proposal?, Integer?, V?, St?, Cands, St).
held_cand0(C, F, N, K, V, St, Cs?, St1?) :- ground(C?), ground(N?) |
    st_class(C?, St?, Cr, St1),
    held_cand(Cr?, F?, C?, request(rho(N?), K?), V?, Cs).
procedure held_cand(ClassRes?, Peer?, Class?, Names?, V?, Cands).
held_cand(nocls, _, _, _, _, []).
held_cand(cls(I), F, C, Nm, V, Cs?) :- ground(I?), ground(C?), ground(V?) |
    term_part_of(I?, C?, Pr),
    v_id(V?, Id),
    opens_for(Pr?, Id?, F?, Op),
    may_propose(I?, V?, B1),
    and(Op?, B1?, B),
    keep_pcand(B?, I?, C?, Nm?, [], Cs).
%% Whether the part has the agent as its opener and Q as a guard.
procedure opens_for(PartRes?, Peer?, Peer?, YesNo).
opens_for(part(pt(_, G, opener(O))), Id, F, B?) :- ground(G?) |
    same(O?, Id?, B1),
    mem(F?, G?, B2),
    and(B1?, B2?, B).
opens_for(part(pt(_, _, guarded_part)), _, _, no).
opens_for(nopart, _, _, no).

%% Vote on an attempt: a question pending at the agent, its answer y recorded,
%% its initiator, to whom Vote sends, known, and y no or the question not
%% waiting.  The record is newest first, so the instances are gathered oldest
%% answer first.
procedure vote_cands0(Recs?, V?, St?, Cands, St).
vote_cands0(R, V, St, Cs?, St1?) :- ground(R?) | vote_cands(R?, R?, V?, St?, [], Cs, St1).
procedure vote_cands(Recs?, Recs?, V?, St?, Cands?, Cands, St).
vote_cands([], _, _, St, Cs, Cs?, St?).
vote_cands([answered(At, Y)|Rs], R, V, St, Acc, Cs?, St2?) :-
    ground(At?), ground(R?), ground(V?) |
    pending_rec(At?, R?, P),
    vote_go(P?, At?, Y?, V?, St?, Acc?, Acc1, St1),
    vote_cands(Rs?, R?, V?, St1?, Acc1?, Cs, St2).
vote_cands([_|Rs], R, V, St, Acc, Cs?, St1?) :- otherwise |
    vote_cands(Rs?, R?, V?, St?, Acc?, Cs, St1).
%% The Vote on a question pending: its initiator known and its answer no or the question not waiting, and only then its class.
procedure vote_go(YesNo?, Attempt?, YesNo?, V?, St?, Cands?, Cands, St).
vote_go(no, _, _, _, St, Acc, Acc?, St?).
vote_go(yes, At, Y, V, St, Acc, Acc1?, St1?) :- ground(At?), ground(V?) |
    attempt_id(At?, Q),
    v_kn(V?, Kv),
    known_kn(Q?, Kv?, Kn),
    question_waits(At?, V?, Wt),
    vote_free(Y?, Wt?, Fr),
    and(Kn?, Fr?, B),
    vote_go1(B?, At?, St?, Acc?, Acc1, St1).
procedure vote_go1(YesNo?, Attempt?, St?, Cands?, Cands, St).
vote_go1(no, _, St, Acc, Acc?, St?).
vote_go1(yes, At, St, Acc, Acc1?, St1?) :- ground(At?) |
    attempt_class(At?, C),
    st_class(C?, St?, Cr, St1),
    vote_cand(yes, Cr?, vt(At?), Acc?, Acc1).
procedure vote_free(YesNo?, YesNo?, YesNo).
vote_free(no, _, yes).
vote_free(yes, W, F?) :- neg(W?, F).
procedure vote_cand(YesNo?, ClassRes?, WKey?, Cands?, Cands).
vote_cand(yes, cls(I), K, Acc, [cand(K?, sub(I?))|Acc?]).
vote_cand(yes, nocls, _, Acc, Acc?).
vote_cand(no, _, _, Acc, Acc?).

%% Commit of an attempt the agent initiated, not closed, with a yes of every
%% other participant recorded.
procedure commit_cands_st(St?, Cands, St).
commit_cands_st(St, Cs?, St1?) :- ground(St?) |
    st_app(St?, Ap),
    app_recs(Ap?, R),
    st_id(St?, Id),
    commit_cands0(R?, Id?, St?, Cs, St1).
procedure commit_cands0(Recs?, Peer?, St?, Cands, St).
commit_cands0(R, Id, St, Cs?, St1?) :- ground(R?) | commit_cands(R?, R?, Id?, St?, [], Cs, St1).
procedure commit_cands(Recs?, Recs?, Peer?, St?, Cands?, Cands, St).
commit_cands([], _, _, St, Cs, Cs?, St?).
commit_cands([voted(At, yes)|Rs], R, Id, St, Acc, Cs?, St2?) :-
    ground(At?), ground(R?), ground(Id?) |
    attempt_id(At?, P),
    same(P?, Id?, Own),
    mem(closed(At?), R?, Cl),
    neg(Cl?, Open),
    and(Own?, Open?, Go),
    commit_go(Go?, At?, R?, Id?, St?, Acc?, Acc1, St1),
    commit_cands(Rs?, R?, Id?, St1?, Acc1?, Cs, St2).
commit_cands([_|Rs], R, Id, St, Acc, Cs?, St1?) :- otherwise |
    commit_cands(Rs?, R?, Id?, St?, Acc?, Cs, St1).
%% The Commit of an attempt the agent initiated and has not closed, and only then its class.
procedure commit_go(YesNo?, Attempt?, Recs?, Peer?, St?, Cands?, Cands, St).
commit_go(no, _, _, _, St, Acc, Acc?, St?).
commit_go(yes, At, R, Id, St, Acc, Acc1?, St1?) :- ground(At?) |
    attempt_class(At?, C),
    st_class(C?, St?, Cr, St1),
    commit_cand(yes, Cr?, At?, Id?, R?, Acc?, Acc1).
procedure commit_cand(YesNo?, ClassRes?, Attempt?, Peer?, Recs?, Cands?, Cands).
commit_cand(yes, cls(I), At, Id, R, Acc, Cs?) :- ground(I?), ground(At?), ground(R?) |
    mem(closed(At?), R?, Cl),
    neg(Cl?, Open),
    all_yes(I?, At?, Id?, R?, All),
    and(Open?, All?, B),
    vote_cand(B?, cls(I?), cm(At?), Acc?, Cs).
commit_cand(_, _, _, _, _, Acc, Acc?) :- otherwise | true.

%% Wound: a start the agent holds waiting, or a question pending at it and
%% answered yes, of an attempt A blocked by an attempt B over which A has
%% priority, yielded(B) not recorded and, where the agent initiated B, a yes
%% of every other participant of B not recorded.  The instance is wd(A, B),
%% with the entry of B's class.
procedure wound_cands0(St?, Cands, St).
wound_cands0(St, Cs?, St3?) :- ground(St?) |
    st_pends(St?, Pd),
    st_view(St?, V),
    st_trie(St?, Tr),
    wound_starts(Pd?, V?, Tr?, St?, [], Cs1, St1),
    st_view(St?, V1),
    wound_cands1(Cs1?, V1?, St1?, Cs, St3).
procedure wound_cands1(Cands?, V?, St?, Cands, St).
wound_cands1(Acc, V, St, Cs?, St1?) :- ground(V?) |
    v_recs(V?, R),
    wound_questions0(R?, V?, St?, Acc?, Cs, St1).
procedure wound_starts(Pends?, V?, Trie?, St?, Cands?, Cands, St).
wound_starts([], _, _, St, Acc, Acc?, St?).
wound_starts([deferred(msg(_, cargo(_, start(A))))|Ps], V, Tr, St, Acc, Cs?, St3?) :-
    ground(A?), ground(V?) |
    v_recs(V?, R),
    trie_closed(A?, R?, Tr?, Cl, Tr1),
    wound_open(Cl?, A?, V?, St?, Acc?, Acc1, St2),
    wound_starts(Ps?, V?, Tr1?, St2?, Acc1?, Cs, St3).
wound_starts([_|Ps], V, Tr, St, Acc, Cs?, St1?) :- otherwise |
    wound_starts(Ps?, V?, Tr?, St?, Acc?, Cs, St1).
%% A start held of an attempt not closed at the agent, and only then its class.
procedure wound_open(YesNo?, Attempt?, V?, St?, Cands?, Cands, St).
wound_open(yes, _, _, St, Acc, Acc?, St?).
wound_open(no, A, V, St, Acc, Cs?, St2?) :- ground(A?) |
    attempt_class(A?, C),
    st_class(C?, St?, Cr, St1),
    wound_start(Cr?, A?, V?, St1?, Acc?, Cs, St2).
procedure wound_start(ClassRes?, Attempt?, V?, St?, Cands?, Cands, St).
wound_start(nocls, _, _, St, Acc, Acc?, St?).
wound_start(cls(I), A, V, St, Acc, Cs?, St1?) :- ground(I?), ground(A?), ground(V?) |
    start_waits_v(I?, A?, V?, W),
    start_blocker(W?, I?, V?, Bk),
    wound_by(Bk?, A?, V?, St?, Acc?, Cs, St1).
procedure wound_questions0(Recs?, V?, St?, Cands?, Cands, St).
wound_questions0(R, V, St, Acc, Cs?, St1?) :- ground(R?) |
    wound_questions(R?, R?, V?, St?, Acc?, Cs, St1).
procedure wound_questions(Recs?, Recs?, V?, St?, Cands?, Cands, St).
wound_questions([], _, _, St, Acc, Acc?, St?).
wound_questions([answered(A, yes)|Rs], R, V, St, Acc, Cs?, St2?) :-
    ground(A?), ground(R?), ground(V?) |
    pending_rec(A?, R?, P),
    question_blocker(P?, V?, Bk),
    wound_by(Bk?, A?, V?, St?, Acc?, Acc1, St1),
    wound_questions(Rs?, R?, V?, St1?, Acc1?, Cs, St2).
wound_questions([_|Rs], R, V, St, Acc, Cs?, St1?) :- otherwise |
    wound_questions(Rs?, R?, V?, St?, Acc?, Cs, St1).
%% wound_by(Blocker?, A?, V?, St?, Cands?, Cands, St1): the instance wd(A, B) where A
%% has priority over its blocker B and the rest of Wound's condition holds; the class of B, which the state keeps since the agent voted on B, proposed it or was asked by it, read from the state, which is given back.
procedure wound_by(Blocker?, Attempt?, V?, St?, Cands?, Cands, St).
wound_by(noblk, _, _, St, Acc, Acc?, St?).
wound_by(blk(B), A, V, St, Acc, Cs?, St1?) :- ground(B?), ground(A?), ground(V?) |
    prio(A?, B?, Pr),
    v_recs(V?, R),
    mem(yielded(B?), R?, Yd),
    neg(Yd?, NYd),
    and(Pr?, NYd?, Go),
    wound_by1(Go?, A?, B?, V?, St?, Acc?, Cs, St1).
%% Only an attempt over which A has priority, and which the agent has not yielded, asks its class.
procedure wound_by1(YesNo?, Attempt?, Attempt?, V?, St?, Cands?, Cands, St).
wound_by1(no, _, _, _, St, Acc, Acc?, St?).
wound_by1(yes, A, B, V, St, Acc, Cs?, St1?) :- ground(B?) |
    attempt_class(B?, C),
    st_class(C?, St?, Cr, St1),
    wound_by_c(Cr?, A?, B?, V?, Acc?, Cs).
procedure wound_by_c(ClassRes?, Attempt?, Attempt?, V?, Cands?, Cands).
wound_by_c(nocls, _, _, _, Acc, Acc?).
wound_by_c(cls(I), A, B, V, Acc, Cs?) :- ground(I?), ground(A?), ground(B?), ground(V?) |
    v_id(V?, Id),
    v_recs(V?, R),
    wound_rec(I?, A?, B?, Id?, R?, Ok),
    vote_cand(Ok?, cls(I?), wd(A?, B?), Acc?, Cs).
%% A over B, yielded(B) not recorded, and, where the agent initiated B, a yes
%% of every other participant of B not recorded.
procedure wound_rec(Info?, Attempt?, Attempt?, Peer?, Recs?, YesNo).
wound_rec(I, A, B, Id, R, Ok?) :- ground(I?), ground(B?), ground(Id?), ground(R?) |
    prio(A?, B?, Pr),
    mem(yielded(B?), R?, Yd),
    neg(Yd?, NYd),
    attempt_id(B?, P),
    same(P?, Id?, Own),
    all_yes(I?, B?, Id?, R?, All),
    wound_by2(Own?, All?, Ok1),
    and(Pr?, NYd?, B1),
    and(B1?, Ok1?, Ok).
procedure wound_by2(YesNo?, YesNo?, YesNo).
wound_by2(no, _, yes).
wound_by2(yes, All, Ok?) :- neg(All?, Ok).

%% Introduce peers {Q, R}, Q preceding R: the introduction rule gives the pair
%% at the agent's machine state, the introduction predicates of the contract
%% naming each of them there, both other than the agent; both known; and
%% introduced(Q, R) not recorded.  The pairs not recorded introduced are kept in the index, computed anew where the machine state has changed and its persons named with it (IC); on each own trigger those of them both known are put up.
procedure intro_cands(St?, Cands, St).
intro_cands(St, Cs?, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_ms(St?, S),
    st_kn(St?, Kn),
    st_ix(St?, Ix),
    intro_pend(Ix?, Id?, S?, Ix1),
    intro_known(Ix1?, Kn?, Cs, Ix2),
    set_ix(St?, Ix2?, St1).
procedure intro_pend(Ix?, Peer?, GAtoms?, Ix).
intro_pend(ix(Tr, Wl, In, ic(S0, Ns0, Pe)), Id, S, ix(Tr?, Wl?, In1?, Ic?)) :- ground(S?), ground(S0?) |
    same(S?, S0?, Sm),
    intro_pend1(Sm?, S?, Ns0?, Pe?, Id?, In?, Ic, In1).
procedure intro_pend1(YesNo?, GAtoms?, Peers?, Pairs?, Peer?, Recs?, IC, Recs).
intro_pend1(yes, S, Ns0, Pe, _, In, ic(S?, Ns0?, Pe?), In?).
intro_pend1(no, S, Ns0, Pe, Id, In, Ic?, In1?) :- ground(S?) |
    introduction_preds(E),
    named_by(E?, S?, Id?, Ns1),
    dedup(Ns1?, Ns2),
    sort_peers(Ns2?, Ns),
    intro_pend2(Ns?, Ns0?, Pe?, S?, In?, Ic, In1).
procedure intro_pend2(Peers?, Peers?, Pairs?, GAtoms?, Recs?, IC, Recs).
intro_pend2(Ns, Ns0, Pe, S, In, Ic?, In1?) :- ground(Ns?), ground(Ns0?) |
    same(Ns?, Ns0?, Sm),
    intro_pend3(Sm?, Ns?, Pe?, S?, In?, Ic, In1).
procedure intro_pend3(YesNo?, Peers?, Pairs?, GAtoms?, Recs?, IC, Recs).
intro_pend3(yes, Ns, Pe, S, In, ic(S?, Ns?, Pe?), In?).
intro_pend3(no, Ns, _, S, In, ic(S?, Ns?, Pe?), In?) :- ground(Ns?), ground(In?) |
    pairs_of(Ns?, Ps),
    not_introduced(Ps?, In?, Pe).
procedure not_introduced(Pairs?, Recs?, Pairs).
not_introduced([], _, []).
not_introduced([pr(Q, R)|Ps], In, Pe?) :- ground(Q?), ground(R?), ground(In?) |
    mem(introduced(Q?, R?), In?, D),
    not_introduced(Ps?, In?, Pe1),
    keep_pair(D?, pr(Q?, R?), Pe1?, Pe).
procedure keep_pair(YesNo?, Pair?, Pairs?, Pairs).
keep_pair(yes, _, Pe, Pe?).
keep_pair(no, P, Pe, [P?|Pe?]).
%% The pairs pending both known, put up, the pairs given back.
procedure intro_known(Ix?, Kn?, Cands, Ix).
intro_known(ix(Tr, Wl, In, ic(S, Ns, Pe)), Kn, Cs?, ix(Tr?, Wl?, In?, ic(S?, Ns?, Pe1?))) :-
    intro_keep(Pe?, Kn?, Cs, Pe1).
procedure named_by(Preds?, GAtoms?, Peer?, Peers).
named_by(_, [], _, []).
named_by(E, [g(P, [p(Q)])|Gs], Id, Ns?) :- ground(E?), ground(Q?), ground(Id?) |
    mem(P?, E?, In),
    same(Q?, Id?, Me),
    neg(Me?, NMe),
    and(In?, NMe?, B),
    named_by(E?, Gs?, Id?, N1),
    keep_peer(B?, Q?, N1?, Ns).
named_by(E, [_|Gs], Id, Ns?) :- otherwise | named_by(E?, Gs?, Id?, Ns).
procedure pairs_of(Peers?, Pairs).
pairs_of([], []).
pairs_of([Q|Qs], Ps?) :- ground(Q?), ground(Qs?) |
    pairs_with(Q?, Qs?, P1),
    pairs_of(Qs?, P2),
    app(P1?, P2?, Ps).
procedure pairs_with(Peer?, Peers?, Pairs).
pairs_with(_, [], []).
pairs_with(Q, [R|Rs], [pr(Q?, R?)|Ps?]) :- ground(Q?) | pairs_with(Q?, Rs?, Ps).
procedure intro_keep(Pairs?, Kn?, Cands, Pairs).
intro_keep([], _, [], []).
intro_keep([pr(Q, R)|Ps], Kn, Cs?, [pr(Q?, R?)|Ps1?]) :- ground(Q?), ground(R?), ground(Kn?) |
    known_kn(Q?, Kn?, K1),
    known_kn(R?, Kn?, K2),
    and(K1?, K2?, B),
    intro_keep(Ps?, Kn?, C1, Ps1),
    keep_icand(B?, Q?, R?, C1?, Cs).
procedure keep_icand(YesNo?, Peer?, Peer?, Cands?, Cands).
keep_icand(yes, Q, R, Cs, [cand(ip(Q?, R?), pair)|Cs?]).
keep_icand(no, _, _, Cs, Cs?).

%% The waits whose instances never hold again are forgotten: a Vote once its
%% attempt is voted on or closed, a Commit once its attempt is closed, a Wound
%% once the attempt it would wound is closed or yielded, an Introduce peers
%% once its pair is recorded introduced.
procedure prune_waits(Waits?, Recs?, Ix?, Waits).
prune_waits([], _, _, []).
prune_waits([w(K, T)|Ws], R, Ix, Ws1?) :- ground(K?), ground(R?), ground(Ix?) |
    dead_key(K?, R?, Ix?, Dd),
    prune_waits(Ws?, R?, Ix?, Rest),
    prune_wait(Dd?, w(K?, T?), Rest?, Ws1).
procedure prune_wait(YesNo?, Wait?, Waits?, Waits).
prune_wait(no, X, Ws, [X?|Ws?]).
prune_wait(yes, _, Ws, Ws?).
procedure dead_key(WKey?, Recs?, Ix?, YesNo).
dead_key(op(_), _, _, no).
dead_key(vt(A), R, ix(Tr, _, _, _), D?) :- ground(A?), ground(R?) |
    has_vote(A?, R?, V),
    rec_closed(A?, R?, Tr?, Cl),
    or(V?, Cl?, D).
dead_key(cm(A), R, ix(Tr, _, _, _), D?) :- rec_closed(A?, R?, Tr?, D).
dead_key(wd(_, B), R, ix(Tr, _, _, _), D?) :- ground(B?), ground(R?) |
    rec_closed(B?, R?, Tr?, Cl),
    mem(yielded(B?), R?, Yd),
    or(Cl?, Yd?, D).
dead_key(ip(Q, R1), R, ix(_, _, In, _), D?) :- ground(Q?), ground(R1?) |
    mem(introduced(Q?, R1?), R?, D1),
    mem(introduced(Q?, R1?), In?, D2),
    or(D1?, D2?, D).

%% The own transaction chosen, taken, and an own trigger written (write_own); none, and no own trigger written (no_own).
procedure dispatch_own(Choice?, App?, Stream(Trigger)?, Stream(Trigger)?,
    Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?).
dispatch_own(none, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    next(no_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
dispatch_own(take(op(_), prop(I, P, Nm)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    dispatch_propose(pgo(I?, P?, Nm?), write_own, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).
dispatch_own(take(vt(At), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?), ground(I?) |
    vote_effect(I?, At?, St?, Ss, Ns, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next_n(write_own, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?).
dispatch_own(take(cm(At), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(At?), ground(I?) |
    commit_effect(I?, At?, St?, Ss, Is, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    put_all(Is?, Out1, Out2?),
    next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out2, Ow, Approvals?, H?, St2?).
dispatch_own(take(wd(_, B), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :-
    ground(B?), ground(I?) |
    wound_effect(I?, B?, St?, Ss, St1),
    send_all(Ss?, St1?, Ms, St2),
    put_all(Ms?, Out, Out1?),
    next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?).
dispatch_own(take(ip(Q, R), pair), Ap0, Ls, In, Ans?, Thr?,
        [msg(Q?, intro(Id?, R?)), msg(R?, intro(Id?, Q?))|Out?], Ow?, Approvals, H, St) :-
    ground(Q?), ground(R?), ground(St?) |
    st_id(St?, Id),
    introduce_effect(Q?, R?, St?, St1),
    next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?).
dispatch_own(take(_, _), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St) :- otherwise |
    next(no_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?).

%% The classes of the unguarded parts the agent opens at its state: each unguarded schema at the bindings that send its first role to the agent and meet that role's requirements, its other variables named by the agent; each class of them joins the classes met, and op_cands puts up the Propose of each of its unguarded parts the agent opens.  Every unguarded part the agent opens and is ready for is found so: the agent is in the first role of one of the part's schema-bindings, whose first role's requirements its state then holds, and the contract being effective, they name every other role and every variable of the schema-binding's deleted and added atoms (vGLP 099f876, Section 5.4, "Act schemas as local specifications").
procedure opening(St?, Infos, St).
opening(St, Is?, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    app_state(Ap?, S),
    contract_schemas(Ss),
    reflexive_preds(Rf),
    opening1(Ss?, Rf?, Id?, S?, St?, Is, St1).
procedure opening1(Schemas?, Preds?, Peer?, GAtoms?, St?, Infos, St).
opening1(Ss, Rf, Id, S, St, Is?, St1?) :- ground(Id?), ground(S?) |
    hat(Rf?, Id?, S?, Sh),
    opened(Ss?, Id?, Sh?, Cs),
    meet_all(Cs?, St?, [], Is0, St1),
    dedup(Is0?, Is).
procedure opened(Schemas?, Peer?, GAtoms?, Stream(Class)).
opened([], _, _, []).
opened([schema(Nm, _, Rs)|Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) |
    guard_roles(Rs?, 1, Gs),
    opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1),
    opened(Ss?, Id?, Sh?, C2),
    app(C1?, C2?, Cs).
%% An unguarded schema with listed roles has their one base as its first role (local.glp), so its opener lists the people of each (opened3).
opened([lschema(Nm, _, Rs, _)|Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) |
    guard_roles(Rs?, 1, Gs),
    opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1),
    opened(Ss?, Id?, Sh?, C2),
    app(C1?, C2?, Cs).
procedure opened1(Ints?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened1([_|_], _, _, _, _, []).
opened1([], _, [], _, _, []).
opened1([], Nm, [R|Rs], Id, Sh, Cs?) :- ground(Nm?), ground(R?), ground(Id?), ground(Sh?) |
    rs_req(R?, Q),
    match_all(Q?, Sh?, [b(role(1), p(Id?))], Bs0),
    schema_numeric(Nm?, N),
    num_extend(N?, Bs0?, Bs),
    opened2(Bs?, Nm?, [R?|Rs?], Id?, Sh?, Cs).
%% A variable of a deleted or added atom that the atoms the first role requires do not name is given its values by the constraint once those are bound (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "or the constraint gives the variable finitely many values once those are bound"; con_extend); the schema-binding is taken where each of its numeric variables is bound to a number (nums_bound), its first role's required atoms are in the state and its forbidden ones not, and the constraint, where it is local to the first role or to every role, holds.
procedure num_extend(Numeric?, Bindings?, Bindings).
num_extend(numeric(C, _, _), Bs, R?) :- ground(C?) | extend_each(Bs?, C?, R).
procedure extend_each(Bindings?, Constraint?, Bindings).
extend_each([], _, []).
extend_each([B|Bs], C, R?) :- ground(C?) |
    con_extend(C?, B?, R1),
    extend_each(Bs?, C?, R2),
    app(R1?, R2?, R).
procedure opened2(Bindings?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened2([], _, _, _, _, []).
opened2([B|Bs], Nm, Rs, Id, Sh, Cs?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) |
    first_spec(Rs?, R1),
    cand_ok([R1?], B?, Sh?, Ok1),
    con_at(Nm?, B?, Id?, Con),
    con_holds(Con?, B?, Ok2),
    nums_bound(Nm?, B?, Ok3),
    and(Ok1?, Ok2?, Ok12),
    and(Ok12?, Ok3?, Ok),
    opened3(Ok?, Nm?, B?, Id?, Sh?, C1),
    opened2(Bs?, Nm?, Rs?, Id?, Sh?, C2),
    app(C1?, C2?, Cs).
procedure opened3(YesNo?, Constant?, Binding?, Peer?, GAtoms?, Stream(Class)).
opened3(no, _, _, _, _, []).
opened3(yes, Nm, B, Id, Sh, [C?]) :- ground(Nm?), ground(B?) |
    listed_people(Nm?, B?, Sh?, Ls),
    listed_binding(Nm?, B?, Ls?, B1),
    class_of(Nm?, B1?, Id?, C).
procedure first_spec(RoleSpecs?, RoleSpec).
first_spec([R|_], R?).
first_spec([], rs(unguarded, [], [], [], [])).

procedure meet_all(Stream(Class)?, St?, Infos?, Infos, St).
meet_all([], St, Is, Is?, St?).
meet_all([C|Cs], St, Is, Is2?, St2?) :- ground(C?) |
    st_class(C?, St?, R, St1),
    add_cls(R?, Is?, Is1),
    meet_all(Cs?, St1?, Is1?, Is2, St2).
procedure add_cls(ClassRes?, Infos?, Infos).
add_cls(nocls, Is, Is?).
add_cls(cls(I), Is, Is1?) :- app(Is?, [I?], Is1).

%% --- Choosing the instance of the class that has waited longest -----------
procedure choose(Cands?, Waits?, Integer?, Choice, Waits).
choose(Cs, W, D, Ch?, W2?) :- ground(Cs?), ground(W?), integer(D?) |
    ensure_waits(Cs?, W?, D?, W1),
    choose1(Cs?, W1?, D?, Ch, W2).
procedure choose1(Cands?, Waits?, Integer?, Choice, Waits).
choose1(Cs, W1, D, Ch?, W2?) :- ground(W1?), integer(D?) |
    pick(Cs?, W1?, Ch, Ky),
    D1 := D? + 1,
    retake(Ky?, W1?, D1?, W2).
procedure ensure_waits(Cands?, Waits?, Integer?, Waits).
ensure_waits([], W, _, W?).
ensure_waits([cand(K, _)|Cs], W, D, W2?) :- ground(K?), ground(W?), integer(D?) |
    wait_of(K?, W?, F),
    ensure1(F?, K?, W?, D?, W1),
    ensure_waits(Cs?, W1?, D?, W2).
procedure ensure1(WFound?, WKey?, Waits?, Integer?, Waits).
ensure1(at(_), _, W, _, W?).
ensure1(unseen, K, W, D, [w(K?, D?)|W?]).
procedure wait_of(WKey?, Waits?, WFound).
wait_of(_, [], unseen).
wait_of(K, [w(K1, T)|_], at(T?)) :- K? =?= K1? | true.
wait_of(K, [_|Ws], F?) :- otherwise | wait_of(K?, Ws?, F).
procedure pick(Cands?, Waits?, Choice, PKey).
pick([], _, none, nokey).
pick([cand(K, I)|Cs], W, Ch?, Ky?) :- ground(K?), ground(W?) |
    began_at(K?, W?, T),
    best(Cs?, W?, T?, K?, I?, Ch, Ky).
procedure best(Cands?, Waits?, Integer?, WKey?, Subj?, Choice, PKey).
best([], _, _, K, I, take(K?, I?), key(K?)) :- ground(K?) | true.
best([cand(K2, I2)|Cs], W, T, K, I, Ch?, Ky?) :- ground(K2?), ground(W?) |
    began_at(K2?, W?, T2),
    best1(T2?, T?, K2?, I2?, K?, I?, Cs?, W?, Ch, Ky).
procedure best1(Integer?, Integer?, WKey?, Subj?, WKey?, Subj?, Cands?, Waits?,
    Choice, PKey).
best1(T2, T, K2, I2, _, _, Cs, W, Ch?, Ky?) :- T2? < T? |
    best(Cs?, W?, T2?, K2?, I2?, Ch, Ky).
best1(T2, T, _, _, K, I, Cs, W, Ch?, Ky?) :- T2? >= T? |
    best(Cs?, W?, T?, K?, I?, Ch, Ky).
procedure began_at(WKey?, Waits?, Integer).
began_at(K, W, T?) :- wait_of(K?, W?, F), began_of(F?, T).
procedure began_of(WFound?, Integer).
began_of(at(T), T?).
began_of(unseen, 0).
procedure retake(PKey?, Waits?, Integer?, Waits).
retake(nokey, W, _, W?).
retake(key(K), W, D, W1?) :- set_wait(K?, D?, W?, W1).
procedure set_wait(WKey?, Integer?, Waits?, Waits).
set_wait(K, D, [], [w(K?, D?)]).
set_wait(K, D, [w(K1, _)|Ws], [w(K1?, D?)|Ws?]) :- K? =?= K1? | true.
set_wait(K, D, [X|Ws], [X?|Ws1?]) :- otherwise | set_wait(K?, D?, Ws?, Ws1).

%% ===========================================================================
%% The app transactions' effects (Definition "Canonical CVA Platform")
%% ===========================================================================

%% Propose (Definition "Proposing", Propose): the attempt's number one more than the agent's, its rank that of the agent's last attempt of the part where it recorded that one wounded, and its number otherwise, and the request it names, Nm.  Where the agent's state is in the domain of its effect in the part, the attempt is recorded voted yes, and is applied and closed at once where the agent is the class's only participant, ending every approval of the class pending at it, as Commit does (Definition "Decided, Committed, Aborted, Settled State": an attempt of one participant is decided once proposed), and is otherwise held prepared and its start told to every other participant.  Where it is not, the agent refuses it at once: it records voted no and closed, tells outcome(At, abort(Id, D)), D unable, with the atoms the schema requires at the agent that its state lacks and those it forbids that its state has, and, the attempt naming a request, deletes the request it holds, or, naming none, ends every approval of the class pending at it, and writes the notice where one ends.
procedure propose_effect(Info?, Class?, Names?, St?, Sends, Outputs, St).
propose_effect(I, P, Nm, St, Ss?, Ns?, St1?) :- ground(I?), ground(P?), ground(Nm?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    app_count(Ap?, K),
    K1 := K? + 1,
    st_ix(St?, Ix),
    rank_of(I?, P?, Ix?, K1?, Pi, Ix1),
    set_ix(St?, Ix1?, St0),
    st_ms(St?, S),
    part_dom(P?, Id?, S?, Dm),
    propose_app(Dm?, I?, attempt(Id?, K1?, Pi?, P?, Nm?), St0?, Ss, Ns, St1).
%% The rank of the attempt: that of the agent's last attempt of the part P where it recorded that one wounded, and its number K1 otherwise (Definition "Proposing", Propose).  The index holds the agent's own attempts recorded wounded that are the last it proposed of their parts (spend); the one of the part P, if any, is the last of P, and leaves the index, the attempt proposed now being the last of P.
procedure rank_of(Info?, Class?, Ix?, Integer?, Integer, Ix).
rank_of(I, P, ix(Tr, Wl, In, Ic), K1, Pi?, ix(Tr?, Wl1?, In?, Ic?)) :- integer(K1?) |
    wl_take(Wl?, I?, P?, Wl1, L),
    rank_of1(L?, K1?, Pi).
procedure rank_of1(Last?, Integer?, Integer).
rank_of1(nolast, K1, K1?).
rank_of1(last(A), _, P?) :- attempt_rank(A?, P).
%% wl_take(Wl, I, P, Wl1, L): the attempt of Wl whose term names the part P of the class I, last(A), taken out of Wl, or nolast.
procedure wl_take(Attempts?, Info?, Class?, Attempts, Last).
wl_take([], _, _, [], nolast).
wl_take([A|As], I, P, As1?, L?) :- ground(A?), ground(I?), ground(P?) |
    attempt_class(A?, C),
    term_part(C?, I?, P?, Pt),
    wl_take1(Pt?, A?, As?, I?, P?, As1, L).
procedure wl_take1(YesNo?, Attempt?, Attempts?, Info?, Class?, Attempts, Last).
wl_take1(yes, A, As, _, _, As?, last(A?)).
wl_take1(no, A, As, I, P, [A?|As1?], L?) :- wl_take(As?, I?, P?, As1, L).
procedure propose_app(YesNo?, Info?, Attempt?, St?, Sends, Outputs, St).
propose_app(yes, I, At, St, Ss?, [], St1?) :- ground(I?), ground(At?), ground(St?) |
    st_id(St?, Id),
    info_q(I?, Q),
    only_me(Q?, Id?, One),
    st_app(St?, Ap),
    propose_go(One?, I?, At?, Id?, Ap?, Ss, Ap1),
    set_app(St?, Ap1?, St1).
propose_app(no, I, At, St, Ss?, Ns?, St1?) :- ground(At?), ground(St?) |
    st_id(St?, Id),
    st_ms(St?, S),
    attempt_class(At?, P),
    unable_reason(P?, Id?, S?, D),
    refuse_at_once(I?, At?, D?, St?, Ss, Ns, St1).
procedure propose_go(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
propose_go(yes, I, At, Id, app(S, _, L, R), [], app(S1?, K?, L?, R2?)) :-
    ground(I?), ground(At?), ground(R?) |
    attempt_k(At?, K),
    attempt_class(At?, P),
    apply_part(P?, Id?, S?, S1),
    end_approvals(I?, Id?, [closed(At?), voted(At?, yes)|R?], R2, _).
propose_go(no, I, At, Id, app(S, _, _, R), Ss?, app(S?, K?, held(At?), [voted(At?, yes)|R?])) :-
    ground(At?), ground(I?) |
    attempt_k(At?, K),
    info_q(I?, Q),
    tell(Q?, Id?, start(At?), Ss).
procedure refuse_at_once(Info?, Attempt?, Reason?, St?, Sends, Outputs, St).
refuse_at_once(I, At, D, St, Ss?, Ns?, St2?) :- ground(I?), ground(At?), ground(D?), ground(St?) |
    st_id(St?, Id),
    info_q(I?, Q),
    tell(Q?, Id?, outcome(At?, abort(Id?, D?)), Ss),
    st_app(St?, Ap),
    attempt_names(At?, Nm1),
    refuse_app(Nm1?, I?, At?, Id?, Ap?, En, Ap1),
    attempt_class(At?, P),
    ended_notice(En?, P?, Id?, D?, Ns),
    set_app(St?, Ap1?, St1),
    st_held(St?, Hd),
    attempt_names(At?, Nm2),
    drop_named(Nm2?, Hd?, Hd1),
    set_held(St1?, Hd1?, St2).
%% The record of a refusal at once: voted no and closed, and, the attempt naming none, the agent a guard of its part, every approval of the class pending at it ended.
procedure refuse_app(Names?, Info?, Attempt?, Peer?, App?, YesNo, App).
refuse_app(request(_, _), _, At, _, app(S, _, _, R), no, app(S?, K1?, unlocked, [closed(At?), voted(At?, no)|R?])) :-
    ground(At?) |
    attempt_k(At?, K1).
refuse_app(none, I, At, Id, app(S, _, _, R), En?, app(S?, K1?, unlocked, R1?)) :- ground(At?) |
    attempt_k(At?, K1),
    end_approvals(I?, Id?, [closed(At?), voted(At?, no)|R?], R1, En).
procedure only_me(Peers?, Peer?, YesNo).
only_me([P], Id, yes) :- P? =?= Id? | true.
only_me(_, _, no) :- otherwise | true.

%% Tell: the cargo to every participant other than the agent.
procedure tell(Peers?, Peer?, Cargo?, Sends).
tell([], _, _, []).
tell([Q|Qs], Id, X, Ss?) :- ground(Q?), ground(Id?), ground(X?) |
    same(Q?, Id?, Me),
    tell1(Me?, Q?, X?, Ss1?, Ss),
    tell(Qs?, Id?, X?, Ss1).
procedure tell1(YesNo?, Peer?, Cargo?, Sends?, Sends).
tell1(yes, _, _, Ss, Ss?).
tell1(no, Q, X, Ss, [to(Q?, X?)|Ss?]).

%% Vote yes: recorded, sent to the initiator, and the attempt held prepared.
procedure vote_yes_app(Attempt?, App?, Sends, App).
vote_yes_app(At, app(S, K, _, R), [to(I?, vote(At?, yes))],
        app(S?, K?, held(At?), [voted(At?, yes)|R?])) :-
    ground(At?) |
    attempt_id(At?, I).
%% Vote no, of reason D (Section 3.2, before Definition "Proposing": "vote y records voted(alpha, y), adds message(p, i, vote(alpha, y)) to o_p, ... and, if y = no and p is a guard of [t]_j, ends every approval of [t] pending at p; the reason of a vote no is declined where p has recorded answered(alpha, no) and unable otherwise"): recorded, sent to the initiator with its reason, and, the agent a guard of the attempt's part, every approval of the class pending at it ended, with the notice, the agent its refuser (vGLP f0acbc1, Section 5.4, "The compilation": "or from the vote where the agent's own vote no refused it").
procedure vote_no(Info?, Attempt?, Peer?, Reason?, App?, Sends, Outputs, App).
vote_no(I, At, Id, D, app(S, K, L, R), [to(P?, vote(At?, no(D?)))], Ns?, app(S?, K?, L?, R2?)) :-
    ground(At?), ground(D?), ground(R?) |
    attempt_id(At?, P),
    attempt_class(At?, C),
    guards_part(C?, Id?, Gd),
    guard_ends(Gd?, I?, Id?, [voted(At?, no)|R?], R2, En),
    attempt_class(At?, C2),
    ended_notice(En?, C2?, Id?, D?, Ns).
%% guard_ends(Guard?, I?, Id?, R?, R1, En): where the agent is a guard of the part, every approval of the class I pending at it ended.
procedure guard_ends(YesNo?, Info?, Peer?, Recs?, Recs, YesNo).
guard_ends(no, _, _, R, R?, no).
guard_ends(yes, I, Id, R, R1?, En?) :- end_approvals(I?, Id?, R?, R1, En).
%% Whether the agent is a guard of the part the term names, a person in the marked roles of its schema-binding.
procedure guards_part(Class?, Peer?, YesNo).
guards_part(C, Id, B?) :- ground(C?) |
    binding_of(C?, Nm, Bn),
    marked_people(Nm?, Bn?, G),
    mem(Id?, G?, B).

%% Start (Definition "Starting and Wounding", Start): its number the larger of the agent's and the attempt's; nothing more where the attempt is closed; otherwise, where the agent's state is not in the domain of its effect in the attempt's part, a vote no, unable; and where it is, where the attempt names a request of the agent, yes if the request is pending and no if not; where the agent is asked by the attempt, which names none, and no approval of the class is pending at it, the question recorded and the approval question raised; and else yes, a guard whose approval stands voting on its own precondition without asking its person.
procedure start_effect(Info?, Attempt?, St?, Sends, ApprovalRes, Outputs, St).
start_effect(I, At, St, Ss?, Cr?, Ns?, St1?) :- ground(At?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    st_closed(At?, St?, Cl),
    st_req(At?, St?, Mi, En),
    start_app(I?, At?, Id?, Cl?, Mi?, En?, Ap?, Ss, Cr, Ns, Ap1),
    set_app(St?, Ap1?, St1).
procedure start_app(Info?, Attempt?, Peer?, YesNo?, YesNo?, YesNo?, App?, Sends, ApprovalRes, Outputs, App).
start_app(I, At, Id, Cl, Mi, En, app(S, K, L, R), Ss?, Cr?, Ns?, Ap1?) :- ground(At?), integer(K?) |
    attempt_k(At?, KA),
    max_int(K?, KA?, K1),
    start_app1(Cl?, I?, At?, Id?, Mi?, En?, app(S?, K1?, L?, R?), Ss, Cr, Ns, Ap1).
procedure max_int(Integer?, Integer?, Integer).
max_int(A, B, A?) :- A? >= B? | true.
max_int(A, B, B?) :- A? < B? | true.
procedure start_app1(YesNo?, Info?, Attempt?, Peer?, YesNo?, YesNo?, App?, Sends, ApprovalRes, Outputs, App).
start_app1(yes, _, _, _, _, _, Ap, [], noapproval, [], Ap?).
start_app1(no, I, At, Id, Mi, En, Ap, Ss?, Cr?, Ns?, Ap1?) :-
    ground(At?), ground(Ap?) |
    app_state(Ap?, S),
    attempt_class(At?, C),
    part_dom(C?, Id?, S?, Rd),
    start_app2(Rd?, I?, At?, Id?, Mi?, En?, Ap?, Ss, Cr, Ns, Ap1).
procedure start_app2(YesNo?, Info?, Attempt?, Peer?, YesNo?, YesNo?, App?, Sends, ApprovalRes, Outputs, App).
start_app2(no, I, At, Id, _, _, Ap, Ss?, noapproval, Ns?, Ap1?) :- ground(At?), ground(Ap?) |
    app_state(Ap?, S),
    attempt_class(At?, C),
    unable_reason(C?, Id?, S?, D),
    vote_no(I?, At?, Id?, D?, Ap?, Ss, Ns, Ap1).
start_app2(yes, I, At, Id, Mi, En, Ap, Ss?, Cr?, Ns?, Ap1?) :- ground(At?) |
    names_mine(At?, Mi?, Mn),
    start_app3(Mn?, En?, I?, At?, Id?, Ap?, Ss, Cr, Ns, Ap1).
procedure start_app3(Mine?, YesNo?, Info?, Attempt?, Peer?, App?, Sends, ApprovalRes, Outputs, App).
start_app3(mine(_, _), En, I, At, Id, Ap, Ss?, noapproval, Ns?, Ap1?) :-
    start_named(En?, I?, At?, Id?, Ap?, Ss, Ns, Ap1).
start_app3(notmine, _, I, At, Id, Ap, Ss?, Cr?, Ns?, Ap1?) :- ground(I?), ground(At?), ground(Ap?) |
    asked_by(At?, Id?, Ak),
    app_recs(Ap?, R),
    approval_of(I?, Id?, R?, Apv),
    start_asked(Ak?, Apv?, At?, Ap?, Ss, Cr, Ns, Ap1).
procedure start_named(YesNo?, Info?, Attempt?, Peer?, App?, Sends, Outputs, App).
start_named(no, _, At, _, Ap, Ss?, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).
start_named(yes, I, At, Id, Ap, Ss?, Ns?, Ap1?) :- vote_no(I?, At?, Id?, unable([], []), Ap?, Ss, Ns, Ap1).
procedure start_asked(YesNo?, YesNo?, Attempt?, App?, Sends, ApprovalRes, Outputs, App).
start_asked(yes, no, At, app(S, K, L, R), [], approval_for(At?), [], app(S?, K?, L?, [asked(At?)|R?])) :-
    ground(At?) | true.
start_asked(yes, yes, At, Ap, Ss?, noapproval, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).
start_asked(no, _, At, Ap, Ss?, noapproval, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).
%% Whether the attempt names a request the agent made, requested(Rho, K) in its record (st_req).
procedure names_mine(Attempt?, YesNo?, Mine).
names_mine(attempt(_, _, _, _, none), _, notmine).
names_mine(attempt(_, _, _, _, request(Rr, K)), B, Mn?) :- mine_of(B?, Rr?, K?, Mn).
procedure mine_of(YesNo?, Rho?, Integer?, Mine).
mine_of(yes, Rr, K, mine(Rr?, K?)).
mine_of(no, _, _, notmine).

%% The agent is asked by an attempt where it is in the attempt's guard set, its part's, the people in the marked roles of the schema-binding its term names, and is not the initiator (vGLP f0acbc1, Definition "Attempt": its guard set G_alpha is G([t]_j), and the members of G_alpha other than its initiator are asked by it); an attempt of an unguarded part asks nobody.  Start asks it where no approval of the class is pending at it (Definition "Starting and Wounding").
procedure asked_by(Attempt?, Peer?, YesNo).
asked_by(At, Id, B?) :- ground(At?), ground(Id?) |
    attempt_id(At?, P),
    attempt_class(At?, C),
    binding_of(C?, Nm, Bn),
    marked_people(Nm?, Bn?, G),
    mem(Id?, G?, In),
    same(Id?, P?, Me),
    neg(Me?, NotMe),
    and(In?, NotMe?, B).

%% Answer: the person's answer recorded, answered(At, yes) by its then-branch
%% and answered(At, no) by its else-branch; it sends nothing and votes nothing.
procedure answer_effect(YesNo?, Attempt?, St?, St).
answer_effect(YN, At, St, St1?) :- ground(St?) |
    st_app(St?, Ap),
    answer_app(YN?, At?, Ap?, Ap1),
    set_app(St?, Ap1?, St1).
procedure answer_app(YesNo?, Attempt?, App?, App).
answer_app(YN, At, app(S, K, L, R), app(S?, K?, L?, [answered(At?, YN?)|R?])).

%% Vote, an own transaction (Definition "Answering and Voting", Vote): yes where the answer is yes and the agent's state is in the domain of its effect in the attempt's part; no otherwise, declined where the person answered no and unable otherwise; a yes is taken only where the question does not wait, so with nothing prepared.
procedure vote_effect(Info?, Attempt?, St?, Sends, Outputs, St).
vote_effect(I, At, St, Ss?, Ns?, St1?) :- ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    vote_app0(I?, At?, Id?, Ap?, Ss, Ns, Ap1),
    set_app(St?, Ap1?, St1).
procedure vote_app0(Info?, Attempt?, Peer?, App?, Sends, Outputs, App).
vote_app0(I, At, Id, Ap, Ss?, Ns?, Ap1?) :- ground(At?), ground(Ap?) |
    app_recs(Ap?, R),
    answer_of(At?, R?, YN),
    app_state(Ap?, S),
    attempt_class(At?, C),
    part_dom(C?, Id?, S?, Dm),
    vote_on(YN?, Dm?, I?, At?, Id?, Ap?, Ss, Ns, Ap1).
procedure vote_on(YesNo?, YesNo?, Info?, Attempt?, Peer?, App?, Sends, Outputs, App).
vote_on(yes, yes, _, At, _, Ap, Ss?, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).
vote_on(yes, no, I, At, Id, Ap, Ss?, Ns?, Ap1?) :- ground(At?), ground(Ap?) |
    app_state(Ap?, S),
    attempt_class(At?, C),
    unable_reason(C?, Id?, S?, D),
    vote_no(I?, At?, Id?, D?, Ap?, Ss, Ns, Ap1).
vote_on(no, _, I, At, Id, Ap, Ss?, Ns?, Ap1?) :- vote_no(I?, At?, Id?, declined, Ap?, Ss, Ns, Ap1).

%% Tally (Definition "Deciding", Tally): nothing more where the attempt is closed; otherwise the vote recorded, and on a no the lock released, the attempt closed, the outcome abort told to every other participant with the voter as refuser and its vote's reason, every approval of the class pending at the agent ended where it is a guard of the part, with the notice, and the request the attempt names, if any, deleted from the requests it holds.
procedure tally_effect(Info?, Attempt?, Peer?, Vote?, St?, Sends, Outputs, St).
tally_effect(I, At, F, V, St, Ss?, Ns?, St1?) :- ground(At?), ground(St?) |
    st_closed(At?, St?, Cl),
    tally1(Cl?, I?, At?, F?, V?, St?, Ss, Ns, St1).
procedure tally1(YesNo?, Info?, Attempt?, Peer?, Vote?, St?, Sends, Outputs, St).
tally1(yes, _, _, _, _, St, [], [], St?).
tally1(no, _, At, F, yes, St, [], [], St1?) :- ground(St?) |
    st_app(St?, Ap),
    add_rec(got(At?, F?, yes), Ap?, Ap1),
    set_app(St?, Ap1?, St1).
tally1(no, I, At, F, no(D), St, Ss?, Ns?, St3?) :- ground(I?), ground(At?), ground(D?), ground(St?) |
    st_id(St?, Id),
    info_q(I?, Q),
    tell(Q?, Id?, outcome(At?, abort(F?, D?)), Ss),
    st_app(St?, Ap),
    app_recs(Ap?, R),
    attempt_class(At?, C),
    guards_part(C?, Id?, Gd),
    guard_ends(Gd?, I?, Id?, [closed(At?), got(At?, F?, no)|R?], R1, En),
    attempt_class(At?, C2),
    ended_notice(En?, C2?, F?, D?, Ns),
    st_app(St?, Ap2),
    unlock_recs(Ap2?, R1?, Ap3),
    set_app(St?, Ap3?, St2),
    st_held(St?, Hd),
    attempt_names(At?, Nm),
    drop_named(Nm?, Hd?, Hd1),
    set_held(St2?, Hd1?, St3).
procedure add_rec(Rec?, App?, App).
add_rec(X, app(S, K, L, R), app(S?, K?, L?, [X?|R?])).
procedure unlock_recs(App?, Recs?, App).
unlock_recs(app(S, K, _, _), R, app(S?, K?, unlocked, R?)).

%% Commit, an own transaction, of an attempt the agent initiated with a yes of every
%% other participant recorded (vGLP f0acbc1, Definition "Deciding", Commit): the effect applied, the lock released, the
%% attempt closed and commit told; every approval of the class pending at the agent ended and every request of the class it holds deleted; and the other participants of the attempt introduced to each other, once per pair (vGLP e2bc4f4, Definition "Deciding", Commit: "for every two participants q != r of alpha other than p for which p has not recorded introduced(q, r), p adds message(p, q, intro(r)) and message(p, r, intro(q)) to o_p and records introduced(q, r)"): for each pair {Q, R}, Q preceding R, introduced(Q, R) not recorded, intro(R) sent to Q and intro(Q) to R, each carrying its sender, msg(Q, intro(P, R)), after the outcome, and introduced(Q, R) recorded, the record Introduce peers keeps (commit_pairs, commit_intros).  The participants of a binary transaction other than its initiator are one, so its Commit introduces no one among them.  And the introduction rule's pairs of the part (vGLP 613ee8d, Definition "Introduction Rule, Introduce Peers": "Commit, and Outcome on a commit, of an attempt of [t]_j at p add the same messages and record for every {q, r} in iota_p([t]_j) with q, r in known_p for which p has not recorded introduced(q, r)"), iota_known: for act schemas, "a schema-binding in which p's role requires an atom naming an agent c bound to a variable and the person q in another role gains an atom naming c" gives p the pair {q, c} (Section 5.4, "Act schemas as local specifications"; iota_pairs).
procedure commit_effect(Info?, Attempt?, St?, Sends, Nets, St).
commit_effect(I, At, St, Ss?, Ms?, St2?) :- ground(I?), ground(At?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    commit_app(I?, At?, Id?, Ap?, Ss, Ap1),
    commit_pairs(I?, Id?, Ps1),
    attempt_class(At?, P),
    iota_known(P?, Id?, St?, Ps2),
    app(Ps1?, Ps2?, Ps0),
    dedup(Ps0?, Ps),
    st_ix(St?, Ix),
    ix_intros(Ix?, In),
    commit_intros(Ps?, Id?, In?, Ap1?, Ms, Ap2),
    set_app(St?, Ap2?, St1),
    st_held(St?, Hd),
    drop_held_class(Hd?, I?, Id?, Hd1),
    set_held(St1?, Hd1?, St2).
%% The pairs of the participants of the attempt other than the agent, those of its class (Definition "Attempt"), each pr(Q, R), Q preceding R in the order of identifiers, as Introduce peers forms its pairs (intro_cands).
procedure commit_pairs(Info?, Peer?, Pairs).
commit_pairs(I, Id, Ps?) :- ground(I?) |
    info_q(I?, Q),
    remove_all(Id?, Q?, Q1),
    dedup(Q1?, Q2),
    sort_peers(Q2?, Q3),
    pairs_of(Q3?, Ps).
%% Each pair not recorded introduced: intro(R) to Q and intro(Q) to R, and introduced(Q, R) recorded (introduce_app).
procedure commit_intros(Pairs?, Peer?, Recs?, App?, Nets, App).
commit_intros([], _, _, Ap, [], Ap?).
commit_intros([pr(Q, R)|Ps], Id, In, Ap, Ms?, Ap2?) :- ground(Q?), ground(R?), ground(In?), ground(Ap?) |
    app_recs(Ap?, Rc),
    mem(introduced(Q?, R?), Rc?, D1),
    mem(introduced(Q?, R?), In?, D2),
    or(D1?, D2?, Done),
    commit_intro(Done?, Q?, R?, Id?, Ap?, Ms, Ms1?, Ap1),
    commit_intros(Ps?, Id?, In?, Ap1?, Ms1, Ap2).
procedure commit_intro(YesNo?, Peer?, Peer?, Peer?, App?, Nets, Nets?, App).
commit_intro(yes, _, _, _, Ap, Ms?, Ms, Ap?).
commit_intro(no, Q, R, Id, Ap, [msg(Q?, intro(Id?, R?)), msg(R?, intro(Id?, Q?))|Ms?], Ms, Ap1?) :-
    ground(Q?), ground(R?), ground(Id?) |
    introduce_app(Q?, R?, Ap?, Ap1).
%% iota_p([t]_j), the pairs the introduction rule gives the agent p for the part of the term P (vGLP 613ee8d, Definition "Introduction Rule, Introduce Peers"): "a schema-binding in which p's role requires an atom naming an agent c bound to a variable, not a role, and the person q in another role gains an atom naming c gives p the pair {q, c}" (Section 5.4, "Act schemas as local specifications"): for each role of the schema-binding sent to p, each person c an agent variable of an atom the role requires, kept or deleted, is bound to, and each other role, sent to q, that adds an atom naming c, the pair {q, c}, where q, c and p are three; each pr(Q, R), Q preceding R in the order of identifiers.  iota_known keeps the pairs both of whose persons the agent knows.
procedure iota_known(Class?, Peer?, St?, Pairs).
iota_known(P, Id, St, Ps?) :- ground(St?) |
    iota_pairs(P?, Id?, Ps0),
    known_pairs(Ps0?, St?, Ps).
procedure known_pairs(Pairs?, St?, Pairs).
known_pairs([], _, []).
known_pairs([pr(Q, R)|Ps], St, Ks?) :- ground(Q?), ground(R?), ground(St?) |
    known_st(Q?, St?, K1),
    known_st(R?, St?, K2),
    and(K1?, K2?, K),
    known_pairs(Ps?, St?, Ks1),
    keep_known_pair(K?, pr(Q?, R?), Ks1?, Ks).
procedure keep_known_pair(YesNo?, Pair?, Pairs?, Pairs).
keep_known_pair(yes, P, Ps, [P?|Ps?]).
keep_known_pair(no, _, Ps, Ps?).
procedure iota_pairs(Class?, Peer?, Pairs).
iota_pairs(P, Id, Ps?) :- ground(P?), ground(Id?) |
    term_spec(P?, _, Rs, Bn),
    iota_rs(Rs?, Bn?, Id?, Ps0),
    dedup(Ps0?, Ps).
procedure iota_rs(RoleSpecs?, Binding?, Peer?, Pairs).
iota_rs(Rs, Bn, Id, Ps?) :- ground(Rs?), ground(Bn?) |
    rs_len(Rs?, K),
    iota_from(1, K?, Rs?, Bn?, Id?, Ps).
procedure iota_from(Integer?, Integer?, RoleSpecs?, Binding?, Peer?, Pairs).
iota_from(I, K, _, _, _, []) :- I? > K? | true.
iota_from(I, K, Rs, Bn, Id, Ps?) :- I? =< K?, ground(Rs?), ground(Bn?), ground(Id?) |
    role_person(I?, Bn?, P),
    same(P?, Id?, Mine),
    iota_role(Mine?, I?, K?, Rs?, Bn?, Id?, Ps1),
    I1 := I? + 1,
    iota_from(I1?, K?, Rs?, Bn?, Id?, Ps2),
    app(Ps1?, Ps2?, Ps).
procedure iota_role(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, Peer?, Pairs).
iota_role(no, _, _, _, _, _, []).
iota_role(yes, I, K, Rs, Bn, Id, Ps?) :- integer(I?), ground(Rs?), ground(Bn?) |
    nth_spec(Rs?, I?, R),
    rs_req(R?, Q),
    atoms_vars(Q?, Vs),
    var_agents(Vs?, Bn?, Cs),
    iota_gainers(1, K?, I?, Rs?, Bn?, Id?, Cs?, Ps).
%% The persons the agent variables among Vs are bound to.
procedure var_agents(Vars?, Binding?, Peers).
var_agents([], _, []).
var_agents([pvar(X)|Vs], B, [C?|Cs?]) :- ground(B?) |
    val_peer(pvar(X?), B?, unbound, C),
    var_agents(Vs?, B?, Cs).
var_agents([_|Vs], B, Cs?) :- otherwise | var_agents(Vs?, B?, Cs).
procedure iota_gainers(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, Peer?, Peers?, Pairs).
iota_gainers(J, K, _, _, _, _, _, []) :- J? > K? | true.
iota_gainers(J, K, I, Rs, Bn, Id, Cs, Ps?) :- J? =< K?, integer(I?), ground(Rs?), ground(Bn?), ground(Id?), ground(Cs?) |
    same_int(J?, I?, Self),
    iota_gainer(Self?, J?, Rs?, Bn?, Id?, Cs?, Ps1),
    J1 := J? + 1,
    iota_gainers(J1?, K?, I?, Rs?, Bn?, Id?, Cs?, Ps2),
    app(Ps1?, Ps2?, Ps).
procedure iota_gainer(YesNo?, Integer?, RoleSpecs?, Binding?, Peer?, Peers?, Pairs).
iota_gainer(yes, _, _, _, _, _, []).
iota_gainer(no, J, Rs, Bn, Id, Cs, Ps?) :- integer(J?), ground(Rs?), ground(Bn?) |
    role_person(J?, Bn?, Q),
    nth_spec(Rs?, J?, R),
    rs_add(R?, A),
    img_atoms(A?, Bn?, G),
    iota_named(Cs?, G?, Q?, Id?, Ps).
procedure iota_named(Peers?, GAtoms?, Peer?, Peer?, Pairs).
iota_named([], _, _, _, []).
iota_named([C|Cs], G, Q, Id, Ps?) :- ground(G?), ground(C?), ground(Q?), ground(Id?) |
    names_peer(G?, C?, N),
    same(Q?, C?, E1),
    same(Q?, Id?, E2),
    same(C?, Id?, E3),
    or(E1?, E2?, E12),
    or(E12?, E3?, E),
    neg(E?, NE),
    and(N?, NE?, B),
    iota_named(Cs?, G?, Q?, Id?, Ps1),
    keep_ipair(B?, Q?, C?, Ps1?, Ps).
procedure keep_ipair(YesNo?, Peer?, Peer?, Pairs?, Pairs).
keep_ipair(no, _, _, Ps, Ps?).
keep_ipair(yes, Q, C, Ps, [Pr?|Ps?]) :- ordered_pair(Q?, C?, Pr).
procedure ordered_pair(Peer?, Peer?, Pair).
ordered_pair(Q, C, pr(Q?, C?)) :- Q? @< C? | true.
ordered_pair(Q, C, pr(C?, Q?)) :- otherwise | true.
%% An atom names what is among its arguments or is the signer of one (GSC, Section 3): a person, a speech act signed by the person, or a community name built on the person.
procedure names_peer(GAtoms?, Peer?, YesNo).
names_peer([], _, no).
names_peer([g(_, Vs)|Gs], C, B?) :- ground(Vs?), ground(C?) |
    vals_name(Vs?, C?, B1),
    names_peer1(B1?, Gs?, C?, B).
procedure names_peer1(YesNo?, GAtoms?, Peer?, YesNo).
names_peer1(yes, _, _, yes).
names_peer1(no, Gs, C, B?) :- names_peer(Gs?, C?, B).
procedure vals_name(Vals?, Peer?, YesNo).
vals_name([], _, no).
vals_name([X|Xs], C, B?) :- ground(X?), ground(C?) |
    val_names(X?, C?, B1),
    vals_name1(B1?, Xs?, C?, B).
procedure vals_name1(YesNo?, Vals?, Peer?, YesNo).
vals_name1(yes, _, _, yes).
vals_name1(no, Xs, C, B?) :- vals_name(Xs?, C?, B).
procedure val_names(Val?, Peer?, YesNo).
val_names(p(Q), C, B?) :- same(Q?, C?, B).
val_names(s(speech(_, Q)), C, B?) :- same(Q?, C?, B).
val_names(c(N), C, B?) :- cname_base(N?, Q), same(Q?, C?, B).
val_names(n(_), _, no).
val_names(lv(_, _), _, no).
procedure cname_base(CName?, Peer).
cname_base(community(Q), Q?).
cname_base(dot(N, _), Q?) :- cname_base(N?, Q).
procedure commit_app(Info?, Attempt?, Peer?, App?, Sends, App).
commit_app(I, At, Id, app(S, K, _, R), Ss?, app(S1?, K?, unlocked, R1?)) :-
    ground(I?), ground(At?), ground(Id?) |
    attempt_class(At?, P),
    apply_part(P?, Id?, S?, S1),
    info_q(I?, Q),
    tell(Q?, Id?, outcome(At?, commit), Ss),
    end_approvals(I?, Id?, [closed(At?)|R?], R1, _).

%% Yield, at the initiator, on yield(At): nothing more where the attempt is
%% closed or a yes of every other participant is recorded; otherwise the lock
%% released, the attempt closed and recorded wounded, and the outcome yield
%% told (Definition "Deciding", Yield).  An attempt that yields ends no
%% approval, and its initiator proposes it again, keeping its rank.
procedure yield_effect(Info?, Attempt?, St?, Sends, St).
yield_effect(I, At, St, Ss?, St1?) :- ground(I?), ground(At?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    st_closed(At?, St?, Cl),
    yield_app(I?, At?, Id?, Cl?, Ap?, Ss, Ap1),
    set_app(St?, Ap1?, St1).
procedure yield_app(Info?, Attempt?, Peer?, YesNo?, App?, Sends, App).
yield_app(I, At, Id, Cl, Ap, Ss?, Ap1?) :- ground(I?), ground(At?), ground(Id?), ground(Ap?) |
    app_recs(Ap?, R),
    closed_or_all(I?, At?, Id?, Cl?, R?, Done),
    yield_app1(Done?, I?, At?, Id?, Ap?, Ss, Ap1).
procedure closed_or_all(Info?, Attempt?, Peer?, YesNo?, Recs?, YesNo).
closed_or_all(I, At, Id, Cl, R, Done?) :-
    all_yes(I?, At?, Id?, R?, All),
    or(Cl?, All?, Done).
procedure yield_app1(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
yield_app1(yes, _, _, _, Ap, [], Ap?).
yield_app1(no, I, At, Id, Ap, Ss?, Ap1?) :- abort_own(I?, At?, Id?, Ap?, Ss, Ap1).
%% The agent's own attempt aborted, wounded: the lock released, the attempt
%% closed and recorded wounded, and the outcome yield told to every other
%% participant (Definition "Starting and Wounding", Wound; Definition
%% "Deciding", Yield).
procedure abort_own(Info?, Attempt?, Peer?, App?, Sends, App).
abort_own(I, At, Id, app(S, K, _, R), Ss?,
        app(S?, K?, unlocked, [wounded(At?), closed(At?)|R?])) :-
    ground(I?), ground(At?), ground(Id?) |
    info_q(I?, Q),
    tell(Q?, Id?, outcome(At?, yield), Ss).

%% Wound of A against B, an own transaction: where the agent initiated B, B aborted,
%% wounded; otherwise yield(B) sent to B's initiator and yielded(B) recorded.
procedure wound_effect(Info?, Attempt?, St?, Sends, St).
wound_effect(I, B, St, Ss?, St1?) :- ground(I?), ground(B?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    attempt_id(B?, P),
    same(P?, Id?, Own),
    wound_app(Own?, I?, B?, Id?, Ap?, Ss, Ap1),
    set_app(St?, Ap1?, St1).
procedure wound_app(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
wound_app(yes, I, B, Id, Ap, Ss?, Ap1?) :- abort_own(I?, B?, Id?, Ap?, Ss, Ap1).
wound_app(no, _, B, _, app(S, K, L, R), [to(J?, yield(B?))],
        app(S?, K?, L?, [yielded(B?)|R?])) :-
    ground(B?) |
    attempt_id(B?, J).

%% Introduce peers {Q, R}: intro(R) sent to Q and intro(Q) to R, each carrying
%% its sender, msg(Q, intro(P, R)), by the dispatch, and introduced(Q, R)
%% recorded.
procedure introduce_effect(Peer?, Peer?, St?, St).
introduce_effect(Q, R, St, St1?) :- ground(St?) |
    st_app(St?, Ap),
    introduce_app(Q?, R?, Ap?, Ap1),
    set_app(St?, Ap1?, St1).
procedure introduce_app(Peer?, Peer?, App?, App).
introduce_app(Q, R, app(S, K, L, Rc), app(S?, K?, L?, [introduced(Q?, R?)|Rc?])).

procedure all_yes(Info?, Attempt?, Peer?, Recs?, YesNo).
all_yes(I, At, Id, R, B?) :- ground(At?), ground(Id?), ground(R?) |
    info_q(I?, Q),
    all_yes1(Q?, At?, Id?, R?, B).
procedure all_yes1(Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes1([], _, _, _, yes).
all_yes1([P|Ps], At, Id, R, B?) :- ground(P?), ground(At?), ground(Id?), ground(R?) |
    same(P?, Id?, Me),
    mem(got(At?, P?, yes), R?, G),
    or(Me?, G?, Ok),
    all_yes2(Ok?, Ps?, At?, Id?, R?, B).
procedure all_yes2(YesNo?, Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes2(no, _, _, _, _, no).
all_yes2(yes, Ps, At, Id, R, B?) :- all_yes1(Ps?, At?, Id?, R?, B).

%% Outcome (Definition "Deciding", Outcome): the effect applied on commit, the lock released where it holds the attempt, and the attempt closed.  On commit, every approval of the class pending at the agent ended and every request of the class it holds deleted.  On abort, the request the attempt names ended where it is the agent's, and, where the attempt names none, every approval of the class pending at the agent ended where it is a guard of the part that recorded voted yes or answered yes on the attempt; and the notice written where an approval ends, its refuser and reason the outcome's.  On yield, nothing more.
procedure outcome_effect(Info?, Attempt?, Decision?, St?, Outputs, Nets, St).
outcome_effect(I, At, Z, St, Ns?, Ms?, St2?) :- ground(I?), ground(At?), ground(Z?), ground(St?) |
    st_id(St?, Id),
    st_app(St?, Ap),
    st_req(At?, St?, Mi, En),
    outcome_app(I?, At?, Z?, Id?, Mi?, En?, Ap?, Ns, Ap1),
    outcome_intros(Z?, At?, Id?, St?, Ap1?, Ms, Ap2),
    set_app(St?, Ap2?, St1),
    st_held(St?, Hd),
    outcome_held(Z?, I?, Id?, Hd?, Hd1),
    set_held(St1?, Hd1?, St2).
%% On a commit, the introduction rule's pairs of the attempt's part at the agent, both known and not recorded introduced, introduced as Commit introduces them (vGLP 613ee8d, Definition "Introduction Rule, Introduce Peers": "Commit, and Outcome on a commit, of an attempt of [t]_j at p add the same messages and record"); on an abort or a yield, none.
procedure outcome_intros(Decision?, Attempt?, Peer?, St?, App?, Nets, App).
outcome_intros(commit, At, Id, St, Ap, Ms?, Ap1?) :- ground(At?), ground(St?) |
    attempt_class(At?, P),
    iota_known(P?, Id?, St?, Ps),
    st_ix(St?, Ix),
    ix_intros(Ix?, In),
    commit_intros(Ps?, Id?, In?, Ap?, Ms, Ap1).
outcome_intros(abort(_, _), _, _, _, Ap, [], Ap?).
outcome_intros(yield, _, _, _, Ap, [], Ap?).
procedure outcome_app(Info?, Attempt?, Decision?, Peer?, YesNo?, YesNo?, App?, Outputs, App).
outcome_app(I, At, commit, Id, _, _, app(S, K, L, R), [], app(S1?, K?, L1?, R1?)) :-
    ground(I?), ground(At?) |
    attempt_class(At?, P),
    apply_part(P?, Id?, S?, S1),
    release(L?, At?, L1),
    end_approvals(I?, Id?, [closed(At?)|R?], R1, _).
outcome_app(I, At, abort(Q, D), Id, Mi, Ed, app(S, K, L, R), Ns?, app(S?, K?, L1?, R1?)) :-
    ground(At?), ground(D?) |
    release(L?, At?, L1),
    attempt_names(At?, Nm),
    abort_ends(Nm?, Mi?, Ed?, I?, At?, Id?, [closed(At?)|R?], R1, En),
    attempt_class(At?, C),
    ended_notice(En?, C?, Q?, D?, Ns).
outcome_app(_, At, yield, _, _, _, app(S, K, L, R), [], app(S?, K?, L1?, [closed(At?)|R?])) :-
    ground(At?) |
    release(L?, At?, L1).
procedure outcome_held(Decision?, Info?, Peer?, Helds?, Helds).
outcome_held(commit, I, Id, Hd, Hd1?) :- drop_held_class(Hd?, I?, Id?, Hd1).
outcome_held(abort(_, _), _, _, Hd, Hd?).
outcome_held(yield, _, _, Hd, Hd?).
%% The approvals an abort ends at a participant: the request the attempt names, where the agent made it; and, where it names none, every approval of the class pending at the agent, where it is a guard of the part that voted yes or answered yes on the attempt.
procedure abort_ends(Names?, YesNo?, YesNo?, Info?, Attempt?, Peer?, Recs?, Recs, YesNo).
abort_ends(request(Rr, K), Mi, Ed, _, _, _, R, R1?, En?) :- end_request(Rr?, K?, Mi?, Ed?, R?, R1, En).
abort_ends(none, _, _, I, At, Id, R, R1?, En?) :- ground(At?), ground(R?) |
    attempt_class(At?, C),
    guards_part(C?, Id?, Gd),
    mem(voted(At?, yes), R?, Vy),
    mem(answered(At?, yes), R?, Ay),
    or(Vy?, Ay?, Said),
    and(Gd?, Said?, B),
    guard_ends(B?, I?, Id?, R?, R1, En).
%% The request the attempt names ended, where the agent made it, Mine, and has not ended it, Done (st_req).
procedure end_request(Rho?, Integer?, YesNo?, YesNo?, Recs?, Recs, YesNo).
end_request(Rr, K, Mine, Done, R, R1?, En?) :-
    neg(Done?, Open),
    and(Mine?, Open?, B),
    end_request1(B?, Rr?, K?, R?, R1, En).
procedure end_request1(YesNo?, Rho?, Integer?, Recs?, Recs, YesNo).
end_request1(yes, Rr, K, R, [ended(Rr?, K?)|R?], yes).
end_request1(no, _, _, R, R?, no).

%% --- Approvals ------------------------------------------------------------------
%% The approvals of the agent (vGLP f0acbc1, Definition "Cargo, App State, Question, Approval, Free, Ready"): "the requests requested(rho, k) it has recorded, approvals of each class of rho, and its answers answered(alpha, yes), approvals of the class of alpha; an approval is pending at p until p ends it, recording ended(rho, k) or ended(alpha)".  end_approvals ends every approval of the class I pending at the agent, En yes where it ended any; approval_of says whether one is pending.
procedure end_approvals(Info?, Peer?, Recs?, Recs, YesNo).
end_approvals(I, Id, R, R1?, En?) :- ground(R?) |
    pending_approvals(R?, I?, Id?, R?, Es),
    end_all(Es?, R?, R1, En).
procedure approval_of(Info?, Peer?, Recs?, YesNo).
approval_of(I, Id, R, B?) :- ground(R?) |
    pending_approvals(R?, I?, Id?, R?, Es),
    some_rec(Es?, B).
%% pending_approvals(Rs, I, Id, R, Es): for each approval of the class I in Rs pending in the record R, the record of its end, ended(Rho, K) or ended(At).
procedure pending_approvals(Recs?, Info?, Peer?, Recs?, Recs).
pending_approvals([], _, _, _, []).
pending_approvals([requested(Rr, K)|Rs], I, Id, R, Es?) :- ground(Rr?), ground(I?), ground(R?), integer(K?) |
    mem(ended(Rr?, K?), R?, Done),
    neg(Done?, Open),
    rho_of_class(Rr?, I?, Id?, Of),
    and(Open?, Of?, B),
    pending_approvals(Rs?, I?, Id?, R?, Es1),
    keep_rec(B?, ended(Rr?, K?), Es1?, Es).
pending_approvals([answered(At, yes)|Rs], I, Id, R, Es?) :- ground(At?), ground(I?), ground(R?) |
    mem(ended(At?), R?, Done),
    neg(Done?, Open),
    of_class(At?, I?, Of),
    and(Open?, Of?, B),
    pending_approvals(Rs?, I?, Id?, R?, Es1),
    keep_rec(B?, ended(At?), Es1?, Es).
pending_approvals([_|Rs], I, Id, R, Es?) :- otherwise | pending_approvals(Rs?, I?, Id?, R?, Es).
procedure keep_rec(YesNo?, Rec?, Recs?, Recs).
keep_rec(yes, X, Es, [X?|Es?]).
keep_rec(no, _, Es, Es?).
procedure end_all(Recs?, Recs?, Recs, YesNo).
end_all([], R, R?, no).
end_all([E|Es], R, R1?, yes) :- app([E?|Es?], R?, R1).
procedure some_rec(Recs?, YesNo).
some_rec([], no).
some_rec([_|_], yes).
%% Whether the class I is a class of the request: one(C), the class of the term C; rho(N), a class of rho_N (in_rho).
procedure rho_of_class(Rho?, Info?, Peer?, YesNo).
rho_of_class(one(C), I, _, B?) :- term_of_class(C?, I?, B).
rho_of_class(rho(N), I, Id, B?) :- in_rho(I?, N?, Id?, B).
%% The requests the agent holds of a class of which the class I is one, deleted; the one an attempt names, request(Rho, K), deleted; and none for an attempt naming none.
procedure drop_held_class(Helds?, Info?, Peer?, Helds).
drop_held_class([], _, _, []).
drop_held_class([held(F, Rr, K)|Hs], I, Id, Hs1?) :- ground(Rr?), ground(I?) |
    rho_of_class(Rr?, I?, Id?, Of),
    drop_held_class(Hs?, I?, Id?, Hs0),
    keep_held(Of?, held(F?, Rr?, K?), Hs0?, Hs1).
procedure keep_held(YesNo?, Held?, Helds?, Helds).
keep_held(yes, _, Hs, Hs?).
keep_held(no, H, Hs, [H?|Hs?]).
procedure drop_named(Names?, Helds?, Helds).
drop_named(none, Hd, Hd?).
drop_named(request(Rr, K), Hd, Hd1?) :- drop_req(Hd?, Rr?, K?, Hd1).
procedure drop_req(Helds?, Rho?, Integer?, Helds).
drop_req([], _, _, []).
drop_req([held(F, Rr1, K1)|Hs], Rr, K, Hs1?) :- ground(Rr1?), ground(Rr?), integer(K1?), integer(K?) |
    same(Rr1?, Rr?, E1),
    same_int(K1?, K?, E2),
    and(E1?, E2?, E),
    drop_req(Hs?, Rr?, K?, Hs0),
    keep_held(E?, held(F?, Rr1?, K1?), Hs0?, Hs1).
procedure release(Lock?, Attempt?, Lock).
release(unlocked, _, unlocked).
release(held(A), At, unlocked) :- A? =?= At? | true.
release(held(A), _, held(A?)) :- otherwise | true.

%% The messages a transaction sends, each carrying its sender; an agent sends
%% a cargo to a recipient at most once, so a message needs no number.
procedure send_all(Sends?, St?, Nets, St).
send_all(Ss, St, Ms?, St?) :- ground(St?) |
    st_id(St?, Id),
    cargo_msgs(Ss?, Id?, Ms).
procedure cargo_msgs(Sends?, Peer?, Nets).
cargo_msgs([], _, []).
cargo_msgs([to(T, X)|Ss], Id, [msg(T?, cargo(Id?, X?))|Ms?]) :- ground(Id?) |
    cargo_msgs(Ss?, Id?, Ms).

procedure put_all(Nets?, Stream(Net), Stream(Net)?).
put_all([], Out?, Out).
put_all([M|Ms], [M?|Out?], Cont) :- put_all(Ms?, Out, Cont?).

%% ===========================================================================
%% The record, indexed by attempt (Code #12's change 2, vGLP #18 Cowork, Code_inbox.md 2026-10-20 12:03 UTC; the types St and Ix above)
%% ===========================================================================

%% spend(Changed?, St?, H?, St1, H1): where a dispatch changed the app state, the entries of each attempt it closed, closed(A) in the live record, and of each request it ended, ended(Rho, K), leave the live record for the record of the closed attempts H, which the agent goal holds and no trigger and no condition reads; an answer yes whose approval is pending stays until the approval ends, and then leaves with its end; each introduction recorded, introduced(Q, R), goes to the index; and the index notes the attempts closed, the requests ended and the agent's own attempts closed wounded.  No entry is dropped: the record is the live record, the record of the closed attempts and the introductions of the index together.
procedure spend(YesNo?, St?, Recs?, St, Recs).
spend(no, St, H, St?, H?).
spend(yes, St, H, St2?, H1?) :- ground(St?) |
    st_app(St?, Ap),
    st_ix(St?, Ix),
    st_id(St?, Id),
    spend_app(Ap?, Ix?, Id?, Ap1, Ix1, Ms),
    set_app(St?, Ap1?, St1),
    set_ix(St1?, Ix1?, St2),
    app(Ms?, H?, H1).
procedure spend_app(App?, Ix?, Peer?, App, Ix, Recs).
spend_app(app(S, K, L, R), Ix, Id, app(S?, K?, L?, R1?), Ix2?, Ms?) :- ground(R?) |
    closed_of(R?, Cl),
    ends_of(R?, Ea),
    spend_ix(R?, R?, Id?, Ix?, Ix1),
    spend_app1(R?, Cl?, Ea?, Ix1?, R1, Ms, Ix2).
procedure spend_app1(Recs?, Attempts?, Recs?, Ix?, Recs, Recs, Ix).
spend_app1(R, Cl, Ea, ix(Tr, Wl, In, ic(S0, Ns0, Pe)), R1?, Ms?, ix(Tr1?, Wl?, In1?, ic(S0?, Ns0?, Pe1?))) :-
    spend_split(R?, Cl?, Ea?, Tr?, R1, Ms, Is, Tr1),
    intros_out(Is?, Pe?, Pe1, Is1),
    app(Is1?, In?, In1).
%% The pairs recorded introduced leave the pairs pending; the introductions given back.
procedure intros_out(Recs?, Pairs?, Pairs, Recs).
intros_out([], Pe, Pe?, []).
intros_out([introduced(Q, R)|Is], Pe, Pe1?, [introduced(Q?, R?)|Is1?]) :- ground(Q?), ground(R?) |
    remove_all(pr(Q?, R?), Pe?, Pe0),
    intros_out(Is?, Pe0?, Pe1, Is1).
intros_out([X|Is], Pe, Pe1?, [X?|Is1?]) :- otherwise | intros_out(Is?, Pe?, Pe1, Is1).
%% The attempts the live record records closed, and the ends it records, of approvals and of requests.
procedure closed_of(Recs?, Attempts).
closed_of([], []).
closed_of([closed(A)|Rs], [A?|Cl?]) :- closed_of(Rs?, Cl).
closed_of([_|Rs], Cl?) :- otherwise | closed_of(Rs?, Cl).
procedure ends_of(Recs?, Recs).
ends_of([], []).
ends_of([ended(A)|Rs], [ended(A?)|Es?]) :- ends_of(Rs?, Es).
ends_of([ended(Rr, K)|Rs], [ended(Rr?, K?)|Es?]) :- ends_of(Rs?, Es).
ends_of([_|Rs], Es?) :- otherwise | ends_of(Rs?, Es).
%% The index of the attempts closed and the requests ended, and of the agent's own attempts closed wounded.
procedure spend_ix(Recs?, Recs?, Peer?, Ix?, Ix).
spend_ix([], _, _, Ix, Ix?).
spend_ix([closed(A)|Rs], R, Id, ix(Tr, Wl, In, Ic), Ix1?) :- ground(A?), ground(R?), ground(Id?) |
    attempt_id(A?, I),
    attempt_k(A?, K),
    trie_put(K?, a(I?), Tr?, Tr1),
    attempt_id(A?, P),
    same(P?, Id?, Own),
    mem(wounded(A?), R?, Wd),
    and(Own?, Wd?, W),
    wl_add(W?, A?, Wl?, Wl1),
    spend_ix(Rs?, R?, Id?, ix(Tr1?, Wl1?, In?, Ic?), Ix1).
spend_ix([ended(Rr, K)|Rs], R, Id, ix(Tr, Wl, In, Ic), Ix1?) :- ground(Rr?), integer(K?) |
    trie_put(K?, r(Rr?), Tr?, Tr1),
    spend_ix(Rs?, R?, Id?, ix(Tr1?, Wl?, In?, Ic?), Ix1).
spend_ix([_|Rs], R, Id, Ix, Ix1?) :- otherwise | spend_ix(Rs?, R?, Id?, Ix?, Ix1).
procedure wl_add(YesNo?, Attempt?, Attempts?, Attempts).
wl_add(yes, A, Wl, [A?|Wl?]).
wl_add(no, _, Wl, Wl?).
%% spend_split(R, Cl, Ea, Tr, Keep, Moved, Intros, Tr1): the entries of R kept in the live record, those moved to the record of the closed attempts and the introductions, in the order of R; the trie Tr read and given back, Tr1.
procedure spend_split(Recs?, Attempts?, Recs?, Trie?, Recs, Recs, Recs, Trie).
spend_split([], _, _, Tr, [], [], [], Tr?).
spend_split([E|Es], Cl, Ea, Tr, Ks?, Ms?, Is?, Tr2?) :- ground(E?), ground(Cl?), ground(Ea?) |
    spent_rec(E?, Cl?, Ea?, Tr?, F, Tr1),
    spend_split(Es?, Cl?, Ea?, Tr1?, Ks1, Ms1, Is1, Tr2),
    spend_one(F?, E?, Ks1?, Ms1?, Is1?, Ks, Ms, Is).
procedure spend_one(Fate?, Rec?, Recs?, Recs?, Recs?, Recs, Recs, Recs).
spend_one(keep, E, Ks, Ms, Is, [E?|Ks?], Ms?, Is?).
spend_one(move, E, Ks, Ms, Is, Ks?, [E?|Ms?], Is?).
spend_one(intro, E, Ks, Ms, Is, Ks?, Ms?, [E?|Is?]).
%% The fate of an entry: an entry of an attempt closed leaves the live record, but an answer yes whose approval has not ended; an answer yes and the end of its approval leave it once the attempt is closed; a request and its end leave it once it is ended; an introduction goes to the index.
procedure spent_rec(Rec?, Attempts?, Recs?, Trie?, Fate, Trie).
spent_rec(asked(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(answered(A, no), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(answered(A, yes), _, Ea, Tr, F?, Tr1?) :- ground(A?) |
    mem(ended(A?), Ea?, En),
    attempt_id(A?, I),
    attempt_k(A?, K),
    trie_look(K?, a(I?), Tr?, Cd, Tr1),
    and(En?, Cd?, B),
    fate_of(B?, F).
spent_rec(voted(A, _), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(got(A, _, _), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(closed(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(wounded(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(yielded(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(ended(A), _, _, Tr, F?, Tr1?) :- ground(A?) |
    attempt_id(A?, I),
    attempt_k(A?, K),
    trie_look(K?, a(I?), Tr?, Cd, Tr1),
    fate_of(Cd?, F).
spent_rec(requested(Rr, K), _, Ea, Tr, F?, Tr?) :- mem(ended(Rr?, K?), Ea?, B), fate_of(B?, F).
spent_rec(ended(_, _), _, _, Tr, move, Tr?).
spent_rec(introduced(_, _), _, _, Tr, intro, Tr?).
procedure in_closed(Attempt?, Attempts?, Fate).
in_closed(A, Cl, F?) :- mem(A?, Cl?, B), fate_of(B?, F).
procedure fate_of(YesNo?, Fate).
fate_of(yes, move).
fate_of(no, keep).

%% The trie of the attempts closed and the requests ended, keyed by a number K >= 1: at the root for K = 1, and otherwise under the root's first subtrie for K even and its second for K odd, at K // 2.
procedure trie_put(Integer?, Tag?, Trie?, Trie).
trie_put(K, G, nil, T?) :- trie_put(K?, G?, t([], nil, nil), T).
trie_put(K, G, t(Gs, Z, O), t([G?|Gs?], Z?, O?)) :- K? =< 1 | true.
trie_put(K, G, t(Gs, Z, O), T?) :- K? > 1 |
    M := K? mod 2,
    K1 := K? // 2,
    trie_put1(M?, K1?, G?, Gs?, Z?, O?, T).
procedure trie_put1(Integer?, Integer?, Tag?, Tags?, Trie?, Trie?, Trie).
trie_put1(M, K1, G, Gs, Z, O, t(Gs?, Z1?, O?)) :- M? =:= 0 | trie_put(K1?, G?, Z?, Z1).
trie_put1(M, K1, G, Gs, Z, O, t(Gs?, Z?, O1?)) :- M? =\= 0 | trie_put(K1?, G?, O?, O1).
procedure trie_has(Integer?, Tag?, Trie?, YesNo).
trie_has(_, _, nil, no).
trie_has(K, G, t(Gs, _, _), B?) :- K? =< 1 | mem(G?, Gs?, B).
trie_has(K, G, t(_, Z, O), B?) :- K? > 1 |
    M := K? mod 2,
    K1 := K? // 2,
    trie_has1(M?, K1?, G?, Z?, O?, B).
procedure trie_has1(Integer?, Integer?, Tag?, Trie?, Trie?, YesNo).
trie_has1(M, K1, G, Z, _, B?) :- M? =:= 0 | trie_has(K1?, G?, Z?, B).
trie_has1(M, K1, G, _, O, B?) :- M? =\= 0 | trie_has(K1?, G?, O?, B).
%% The same, the trie given back.
procedure trie_look(Integer?, Tag?, Trie?, YesNo, Trie).
trie_look(_, _, nil, no, nil).
trie_look(K, G, t(Gs, Z, O), B?, t(Gs?, Z?, O?)) :- K? =< 1, ground(Gs?) | mem(G?, Gs?, B).
trie_look(K, G, t(Gs, Z, O), B?, T?) :- K? > 1 |
    M := K? mod 2,
    K1 := K? // 2,
    trie_look1(M?, K1?, G?, Gs?, Z?, O?, B, T).
procedure trie_look1(Integer?, Integer?, Tag?, Tags?, Trie?, Trie?, YesNo, Trie).
trie_look1(M, K1, G, Gs, Z, O, B?, t(Gs?, Z1?, O?)) :- M? =:= 0 | trie_look(K1?, G?, Z?, B, Z1).
trie_look1(M, K1, G, Gs, Z, O, B?, t(Gs?, Z?, O1?)) :- M? =\= 0 | trie_look(K1?, G?, O?, B, O1).

%% Whether the attempt is closed at the agent: closed(A) in the live record, or noted in the trie once its entries have left it.
procedure rec_closed(Attempt?, Recs?, Trie?, YesNo).
rec_closed(A, R, Tr, B?) :- ground(A?) |
    mem(closed(A?), R?, B1),
    attempt_id(A?, I),
    attempt_k(A?, K),
    trie_has(K?, a(I?), Tr?, B2),
    or(B1?, B2?, B).
procedure st_closed(Attempt?, St?, YesNo).
st_closed(A, st(_, app(_, _, _, R), _, _, _, _, _, _, _, _, _, _, ix(Tr, _, _, _), _), B?) :-
    rec_closed(A?, R?, Tr?, B).
%% The same, the trie given back.
procedure trie_closed(Attempt?, Recs?, Trie?, YesNo, Trie).
trie_closed(A, R, Tr, B?, Tr1?) :- ground(A?) |
    mem(closed(A?), R?, B1),
    attempt_id(A?, I),
    attempt_k(A?, K),
    trie_look(K?, a(I?), Tr?, B2, Tr1),
    or(B1?, B2?, B).
%% Of the request an attempt names: whether the agent made it, requested(Rho, K) recorded, and whether it has ended it, ended(Rho, K) recorded; no and no where it names none.
procedure st_req(Attempt?, St?, YesNo, YesNo).
st_req(attempt(_, _, _, _, none), _, no, no).
st_req(attempt(_, _, _, _, request(Rr, K)), st(_, app(_, _, _, R), _, _, _, _, _, _, _, _, _, _, ix(Tr, _, _, _), _), B?, E?) :-
    ground(Rr?), integer(K?) |
    req_scan(R?, Rr?, K?, no, no, B1, E1),
    trie_has(K?, r(Rr?), Tr?, T),
    req_or(B1?, E1?, T?, B, E).
procedure req_or(YesNo?, YesNo?, YesNo?, YesNo, YesNo).
req_or(_, _, yes, yes, yes).
req_or(B1, E1, no, B1?, E1?).
procedure req_scan(Recs?, Rho?, Integer?, YesNo?, YesNo?, YesNo, YesNo).
req_scan([], _, _, B, E, B?, E?).
req_scan([requested(R1, K1)|Rs], Rr, K, _, E, B1?, E1?) :- R1? =?= Rr?, K1? =:= K? |
    req_scan(Rs?, Rr?, K?, yes, E?, B1, E1).
req_scan([ended(R1, K1)|Rs], Rr, K, B, _, B1?, E1?) :- R1? =?= Rr?, K1? =:= K? |
    req_scan(Rs?, Rr?, K?, B?, yes, B1, E1).
req_scan([_|Rs], Rr, K, B, E, B1?, E1?) :- otherwise | req_scan(Rs?, Rr?, K?, B?, E?, B1, E1).
%% Whether introduced(Q, R) is recorded: in the live record, or in the index.
procedure st_introduced(Peer?, Peer?, St?, YesNo).
st_introduced(Q, R, st(_, app(_, _, _, Rc), _, _, _, _, _, _, _, _, _, _, ix(_, _, In, _), _), B?) :- ground(Q?), ground(R?) |
    mem(introduced(Q?, R?), Rc?, B1),
    mem(introduced(Q?, R?), In?, B2),
    or(B1?, B2?, B).
procedure ix_intros(Ix?, Recs).
ix_intros(ix(_, _, In, _), In?).

%% ===========================================================================
%% Conditions, over the app state (Definitions "Cargo, App State, Question,
%% Free, Ready" and "Priority, Waiting, Blocked, Clear")
%% ===========================================================================

%% Ready for a part [t]_j of [t] (Definition "Cargo, App State, Question,
%% Free, Ready"): free for [t], the lock unlocked and no question of [t]
%% pending (free_i), and the state in the domain of the agent's effect in the
%% part (ready_parts).
procedure unlocked(Lock?, YesNo).
unlocked(unlocked, yes).
unlocked(held(_), no).

%% No question of the class pending: no attempt of it recorded asked, with no
%% vote on it and not closed.
procedure no_question(Info?, Recs?, Recs?, YesNo).
no_question(_, [], _, yes).
no_question(I, [asked(At)|Rs], R, B?) :- ground(I?), ground(At?), ground(R?) |
    pending_rec(At?, R?, P),
    of_class(At?, I?, Cl),
    and(P?, Cl?, Q),
    no_question1(Q?, I?, Rs?, R?, B).
no_question(I, [_|Rs], R, B?) :- otherwise | no_question(I?, Rs?, R?, B).
procedure no_question1(YesNo?, Info?, Recs?, Recs?, YesNo).
no_question1(yes, _, _, _, no).
no_question1(no, I, Rs, R, B?) :- no_question(I?, Rs?, R?, B).

%% A question pending: recorded asked, with no vote and not closed.
procedure pending_rec(Attempt?, Recs?, YesNo).
pending_rec(At, R, B?) :- ground(At?), ground(R?) |
    mem(asked(At?), R?, B1),
    has_vote(At?, R?, B2),
    mem(closed(At?), R?, B3),
    or(B2?, B3?, B23),
    neg(B23?, B4),
    and(B1?, B4?, B).
procedure has_vote(Attempt?, Recs?, YesNo).
has_vote(_, [], no).
has_vote(At, [voted(A, _)|_], yes) :- At? =?= A? | true.
has_vote(At, [_|Rs], B?) :- otherwise | has_vote(At?, Rs?, B).

%% An answer recorded to an attempt, and which.
procedure has_answer(Attempt?, Recs?, YesNo).
has_answer(_, [], no).
has_answer(At, [answered(A, _)|_], yes) :- At? =?= A? | true.
has_answer(At, [_|Rs], B?) :- otherwise | has_answer(At?, Rs?, B).
procedure answer_of(Attempt?, Recs?, YesNo).
answer_of(_, [], no).
answer_of(At, [answered(A, Y)|_], Y?) :- At? =?= A? | true.
answer_of(At, [_|Rs], Y?) :- otherwise | answer_of(At?, Rs?, Y).

%% Whether an attempt's class is the class of an entry: the schema-binding of its part has the entry's participants and the same atoms deleted and added at each, and is linked to one of the entry's schema-bindings (in_class).  Its term met st_class when the agent first read it, or is a schema-binding of an entry's class, so the schema-binding determines a transaction.
procedure of_class(Attempt?, Info?, YesNo).
of_class(attempt(_, _, _, C, _), I, B?) :- term_of_class(C?, I?, B).
procedure term_of_class(Class?, Info?, YesNo).
term_of_class(C, ci(_, Ps, Q, _, Ms), B?) :- ground(C?) |
    term_spec(C?, _, Rs, Bn),
    of_class1(Rs?, Bn?, Ps?, Q?, Ms?, B).
procedure of_class1(RoleSpecs?, Binding?, Deltas?, Peers?, Mates?, YesNo).
of_class1(Rs, Bn, Ps, Q, Ms, B?) :- ground(Rs?), ground(Bn?) |
    sig_of(Rs?, Bn?, Ps1),
    in_class(Rs?, Bn?, Ps1?, Ps?, Q?, Ms?, B).

%% The participants other than the agent known, or the first that is not.
procedure others_known(Info?, V?, Known).
others_known(I, v(Id, _, _, _, _, Kn), K?) :-
    info_q(I?, Q),
    first_unknown(Q?, Id?, Kn?, K).
procedure first_unknown(Peers?, Peer?, Kn?, Known).
first_unknown([], _, _, allknown).
first_unknown([P|Ps], Id, Kn, K?) :- ground(P?), ground(Id?), ground(Kn?) |
    same(P?, Id?, Me),
    known_kn(P?, Kn?, Kp),
    or(Me?, Kp?, Ok),
    first_unknown1(Ok?, P?, Ps?, Id?, Kn?, K).
procedure first_unknown1(YesNo?, Peer?, Peers?, Peer?, Kn?, Known).
first_unknown1(yes, _, Ps, Id, Kn, K?) :- first_unknown(Ps?, Id?, Kn?, K).
first_unknown1(no, P, _, _, _, unknown(P?)).
%% A peer is known when hello, or ihello, has been sent to it and received
%% from it (Section 5.4); a condition's test that a peer is known is of these.
procedure known_st(Peer?, St?, YesNo).
known_st(P, st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), B?) :- known_kn(P?, kn(Se?, Rc?, ISe?, IRc?), B).
procedure known_kn(Peer?, Kn?, YesNo).
known_kn(P, kn(Se, Rc, ISe, IRc), B?) :- ground(P?) |
    known_peer(P?, Se?, Rc?, B1),
    known_peer(P?, ISe?, IRc?, B2),
    or(B1?, B2?, B).
procedure known_peer(Peer?, Peers?, Peers?, YesNo).
known_peer(P, Se, Rc, B?) :- ground(P?) |
    mem(P?, Se?, B1),
    mem(P?, Rc?, B2),
    and(B1?, B2?, B).
procedure known_ok(Known?, YesNo).
known_ok(allknown, yes).
known_ok(unknown(_), no).
procedure go_or_drop(YesNo?, Info?, Cond).
go_or_drop(yes, I, go(I?)).
go_or_drop(no, _, drop).

%% Clear: no start held waiting and no question answered yes pending
%% (Definition "Priority, Waiting, Blocked, Clear").  Propose requires it.
procedure no_prior_start(V?, YesNo).
no_prior_start(v(_, _, _, R, Pd, _), B?) :-
    any_answered_yes(R?, Q),
    empty_pends(Pd?, E),
    neg(Q?, NQ),
    and(E?, NQ?, B).
procedure empty_pends(Pends?, YesNo).
empty_pends([], yes).
empty_pends([_|_], no).
procedure any_answered_yes(Recs?, YesNo).
any_answered_yes(R, B?) :- ground(R?) | any_answered_yes1(R?, R?, B).
procedure any_answered_yes1(Recs?, Recs?, YesNo).
any_answered_yes1([], _, no).
any_answered_yes1([answered(G, yes)|Rs], R, B?) :- ground(G?), ground(R?) |
    pending_rec(G?, R?, P),
    any_answered_yes2(P?, Rs?, R?, B).
any_answered_yes1([_|Rs], R, B?) :- otherwise | any_answered_yes1(Rs?, R?, B).
procedure any_answered_yes2(YesNo?, Recs?, Recs?, YesNo).
any_answered_yes2(yes, _, _, yes).
any_answered_yes2(no, Rs, R, B?) :- any_answered_yes1(Rs?, R?, B).
procedure precedes(Peer?, Peer?, YesNo).
precedes(P, Q, yes) :- P? @< Q? | true.
precedes(_, _, no) :- otherwise | true.

%% The guarded parts of a class with no opener whose guard set holds the agent, each named by its term; and the unguarded parts whose opener is the agent (vGLP f0acbc1, Definition "Attempt": "The initiator is the opener o([t]_j) of [t]_j if [t]_j has one, and a guard of [t]_j if not"; Section 3.2, "The protocol": "A part with an opener is proposed by its opener, an unguarded one whenever the opener can carry out its effect, and a guarded one on a request of its guard, which the attempt names ... A guarded part with no opener is proposed by one of its guards whose approval stands").  A guarded part with an opener its opener proposes on a request it holds (held_cands).
procedure guarding_parts(Parts?, Peer?, Classes).
guarding_parts([], _, []).
guarding_parts([pt(T, G, Op)|Ps], Id, R?) :- ground(Id?) |
    mem(Id?, G?, B1),
    no_opener(Op?, B2),
    and(B1?, B2?, B),
    guarding_parts(Ps?, Id?, R1),
    keep_class(B?, T?, R1?, R).
procedure no_opener(Opener?, YesNo).
no_opener(opener(_), no).
no_opener(guarded_part, yes).
procedure opening_parts(Parts?, Peer?, Classes).
opening_parts([], _, []).
opening_parts([pt(T, G, Op)|Ps], Id, R?) :- ground(Id?) |
    is_opener(Op?, Id?, B1),
    some_peer(G?, B2),
    neg(B2?, B3),
    and(B1?, B3?, B),
    opening_parts(Ps?, Id?, R1),
    keep_class(B?, T?, R1?, R).
procedure is_opener(Opener?, Peer?, YesNo).
is_opener(opener(P), Id, B?) :- same(P?, Id?, B).
is_opener(guarded_part, _, no).
procedure all_in(Peers?, Peers?, YesNo).
all_in([], _, yes).
all_in([P|Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).
procedure all_in1(YesNo?, Peers?, Peers?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).
%% For the part [t]_j of a schema-binding, f^[t]_j_p is defined at d_p iff
%% the schema-binding has the atoms it requires at p in d_p, with the atoms of
%% the reflexive predicates naming p and the variables local to p's role bound
%% by them in one way, those it forbids there not, and a constraint local to the
%% role holding under that binding, and yields d_p less the deleted atoms plus
%% the added ones, as multisets, under that binding, a multiplicity k deleting
%% or adding k copies (vGLP 613ee8d, Section 5.4, "Act schemas as local
%% specifications"; dom_bindings, apply_part).  The part
%% named by the term P: whether the state S is in the domain of its effect at
%% the agent.
procedure part_dom(Class?, Peer?, GAtoms?, YesNo).
part_dom(P, Id, S, B?) :- ground(P?), ground(Id?), ground(S?) |
    term_spec(P?, Nm, Rs, Bn),
    part_dom1(Nm?, Rs?, Bn?, Id?, S?, B).
procedure part_dom1(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
part_dom1(Nm, Rs, Bn, Id, S, B?) :- ground(Nm?), ground(Bn?), ground(Id?), ground(S?) |
    reflexive_preds(Rf),
    hat(Rf?, Id?, S?, Sh),
    mate_dom(Nm?, Rs?, Bn?, Id?, Sh?, B1),
    listing_ok(Nm?, Bn?, Id?, S?, B2),
    and(B1?, B2?, B).
procedure hat(Preds?, Peer?, GAtoms?, GAtoms).
hat([], _, S, S?).
hat([P|Ps], Id, S, [g(P?, [p(Id?)])|R?]) :- ground(Id?) | hat(Ps?, Id?, S?, R).
%% The reason of a vote unable of the compiled program, unable(Lacks, Has): "the atoms the schema requires at the voter that its state lacks and those it forbids that its state has" (vGLP f0acbc1, Section 5.4, "Act schemas"), as the contract writes them, the atoms of the reflexive predicates naming the voter holding there; and, for the person in the base of a listed role, who "lists in d_p exactly the people of that role in L" (Section 5.4, "Act schemas as local specifications"), the listing atoms of the people of the role its state lacks, and those of others it has.
procedure unable_reason(Class?, Peer?, GAtoms?, Reason).
unable_reason(P, Id, S, unable(L?, H?)) :- ground(P?), ground(S?) |
    term_spec(P?, Nm, Rs, Bn),
    unable_atoms(Nm?, Rs?, Bn?, Id?, S?, L0, H0),
    atoms_of(L0?, L),
    atoms_of(H0?, H).
procedure unable_atoms(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
unable_atoms(Nm, Rs, Bn, Id, S, L?, H?) :- ground(Nm?), ground(Rs?), ground(Bn?), ground(S?) |
    reflexive_preds(Rf),
    hat(Rf?, Id?, S?, Sh),
    specs_at(Rs?, 1, Bn?, Id?, RsP),
    unlocal(Bn?, B0),
    unable_at(RsP?, B0?, Sh?, L1, H1),
    listing_gaps(Nm?, Bn?, Id?, S?, L2, H2),
    app(L1?, L2?, L),
    app(H1?, H2?, H).
%% The variables local to the voter's roles bound by the first way the required atoms bind them, where they bind them at all, and left standing for themselves otherwise, an atom of one shown by no Atom (atom_of).
procedure unable_at(RoleSpecs?, Binding?, GAtoms?, GAtoms, GAtoms).
unable_at(RsP, B0, Sh, L?, H?) :- ground(RsP?), ground(B0?), ground(Sh?) |
    reqs_of(RsP?, Q0),
    match_all(Q0?, Sh?, B0?, Cs),
    first_or(Cs?, B0?, Bn),
    unable_at1(RsP?, Bn?, Sh?, L, H).
procedure first_or(Bindings?, Binding?, Binding).
first_or([B|_], _, B?).
first_or([], B, B?).
procedure unable_at1(RoleSpecs?, Binding?, GAtoms?, GAtoms, GAtoms).
unable_at1(RsP, Bn, Sh, L?, H?) :- ground(RsP?), ground(Bn?), ground(Sh?) |
    reqs_of(RsP?, Q),
    img_atoms(Q?, Bn?, G),
    ms_diff(G?, Sh?, L),
    forbs_of(RsP?, F),
    img_atoms(F?, Bn?, Fg),
    held_in(Fg?, Sh?, H0),
    dedup(H0?, H).
procedure held_in(GAtoms?, GAtoms?, GAtoms).
held_in([], _, []).
held_in([G|Gs], Sh, H?) :- ground(G?), ground(Sh?) |
    mem(G?, Sh?, In),
    held_in(Gs?, Sh?, H1),
    keep_g(In?, G?, H1?, H).
procedure keep_g(YesNo?, GAtom?, GAtoms?, GAtoms).
keep_g(yes, G, H, [G?|H?]).
keep_g(no, _, H, H?).
procedure listing_gaps(Constant?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
listing_gaps(Nm, Bn, Id, S, L?, H?) :- schema_entry(Nm?, E), listing_gaps1(E?, Bn?, Id?, S?, L, H).
procedure listing_gaps1(Schema?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
listing_gaps1(schema(_, _, _), _, _, _, [], []).
listing_gaps1(lschema(_, _, _, Lsts), Bn, Id, S, L?, H?) :- gaps_of(Lsts?, Bn?, Id?, S?, L, H).
procedure gaps_of(Listings?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
gaps_of([], _, _, _, [], []).
gaps_of([listing(I, Bi, Rho, As)|Lsts], Bn, Id, S, L?, H?) :- ground(Bn?), ground(S?) |
    role_person(Bi?, Bn?, P),
    same(P?, Id?, Base),
    gaps_one(Base?, I?, Rho?, As?, Bn?, S?, L1, H1),
    gaps_of(Lsts?, Bn?, Id?, S?, L2, H2),
    app(L1?, L2?, L),
    app(H1?, H2?, H).
procedure gaps_one(YesNo?, Integer?, Constant?, Vars?, Binding?, GAtoms?, GAtoms, GAtoms).
gaps_one(no, _, _, _, _, _, [], []).
gaps_one(yes, I, Rho, As, Bn, S, L?, H?) :- ground(Rho?), ground(As?), ground(Bn?), ground(S?) |
    copies_of(Bn?, I?, Want),
    list_at(Rho?, As?, Bn?, S?, Have),
    img_args(As?, Bn?, Vs),
    gaps_two(Want?, Have?, Rho?, Vs?, L, H).
procedure gaps_two(Peers?, Peers?, Constant?, Vals?, GAtoms, GAtoms).
gaps_two(Want, Have, Rho, Vs, L?, H?) :- ground(Want?), ground(Have?), ground(Rho?), ground(Vs?) |
    peers_minus(Want?, Have?, Lp),
    peers_minus(Have?, Want?, Hp),
    listing_atoms(Lp?, Rho?, Vs?, L),
    listing_atoms(Hp?, Rho?, Vs?, H).
procedure peers_minus(Peers?, Peers?, Peers).
peers_minus([], _, []).
peers_minus([P|Ps], Qs, R?) :- ground(Qs?) |
    mem(P?, Qs?, In),
    peers_minus(Ps?, Qs?, R1),
    keep_out(In?, P?, R1?, R).
procedure keep_out(YesNo?, Peer?, Peers?, Peers).
keep_out(yes, _, R, R?).
keep_out(no, P, R, [P?|R?]).
procedure listing_atoms(Peers?, Constant?, Vals?, GAtoms).
listing_atoms([], _, _, []).
listing_atoms([Q|Qs], Rho, Vs, [g(Rho?, [p(Q?)|Vs?])|Gs?]) :- ground(Rho?), ground(Vs?) |
    listing_atoms(Qs?, Rho?, Vs?, Gs).
%% The parts whose domain at the agent holds its state.
procedure ready_parts(Classes?, Peer?, GAtoms?, Classes).
ready_parts([], _, _, []).
ready_parts([P|Ps], Id, S, R?) :- ground(P?), ground(Id?), ground(S?) |
    part_dom(P?, Id?, S?, B),
    ready_parts(Ps?, Id?, S?, R1),
    keep_class(B?, P?, R1?, R).
procedure keep_class(YesNo?, Class?, Classes?, Classes).
keep_class(yes, P, R, [P?|R?]).
keep_class(no, _, R, R?).
%% Whether the schema-bindings two terms name, of the class of the entry I, determine one part: the same people marked, and the same atoms required, as multisets, and the same atoms forbidden, at every participant, the deleted and added atoms being the class's (vGLP #15, Code_inbox.md, 2026-10-19 10:50 UTC, item 1).
procedure same_part(Info?, Class?, Class?, YesNo).
same_part(I, C1, C2, B?) :- ground(I?), ground(C1?), ground(C2?) |
    info_q(I?, Q),
    binding_of(C1?, N1, B1),
    binding_of(C2?, N2, B2),
    same_part1(Q?, N1?, B1?, N2?, B2?, B).
procedure same_part1(Peers?, Constant?, Binding?, Constant?, Binding?, YesNo).
same_part1(Q, N1, B1, N2, B2, B?) :- ground(N1?), ground(B1?), ground(N2?), ground(B2?) |
    marked_people(N1?, B1?, G1),
    marked_people(N2?, B2?, G2),
    same_bpart(Q?, N1?, B1?, G1?, N2?, B2?, G2?, B).
%% The same, of two schema-bindings with the people they mark.
procedure same_bpart(Peers?, Constant?, Binding?, Peers?, Constant?, Binding?, Peers?, YesNo).
same_bpart(Q, N1, B1, G1, N2, B2, G2, B?) :- ground(B1?), ground(B2?) |
    same(G1?, G2?, E1),
    bound_spec(N1?, B1?, Rs1),
    bound_spec(N2?, B2?, Rs2),
    reflexive_preds(Rf),
    same_doms(Q?, Rs1?, B1?, Rs2?, B2?, Rf?, E2),
    and(E1?, E2?, B).
%% The people in the marked roles of a schema-binding, a set, in the order of identifiers.
procedure marked_people(Constant?, Binding?, Peers).
marked_people(Nm, B, G?) :- ground(B?) |
    bound_spec(Nm?, B?, Rs),
    marked_of(Rs?, B?, G).
procedure marked_of(RoleSpecs?, Binding?, Peers).
marked_of(Rs, B, G?) :- ground(Rs?) |
    guard_roles(Rs?, 1, Gi),
    persons_of(Gi?, B?, Gp),
    sort_peers(Gp?, Gs),
    dedup(Gs?, G).
procedure same_doms(Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
same_doms([], _, _, _, _, _, yes).
same_doms([P|Ps], Rs1, B1, Rs2, B2, Rf, B?) :-
    ground(P?), ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?) |
    reqs_at(Rs1?, B1?, P?, Rf?, R1),
    reqs_at(Rs2?, B2?, P?, Rf?, R2),
    forbs_at(Rs1?, B1?, P?, F1),
    forbs_at(Rs2?, B2?, P?, F2),
    dedup(F1?, F1s),
    dedup(F2?, F2s),
    ms_eq(R1?, R2?, E1),
    ms_eq(F1s?, F2s?, E2),
    and(E1?, E2?, E),
    same_doms1(E?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, B).
procedure same_doms1(YesNo?, Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
same_doms1(no, _, _, _, _, _, _, no).
same_doms1(yes, Ps, Rs1, B1, Rs2, B2, Rf, B?) :- same_doms(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, B).
%% Whether the term E names a part of the class of the entry I, the part P.
procedure term_part(Class?, Info?, Class?, YesNo).
term_part(E, I, P, B?) :- ground(E?), ground(I?), ground(P?) |
    term_of_class(E?, I?, In),
    term_part1(In?, E?, I?, P?, B).
procedure term_part1(YesNo?, Class?, Info?, Class?, YesNo).
term_part1(no, _, _, _, no).
term_part1(yes, E, I, P, B?) :- same_part(I?, E?, P?, B).
procedure mate_dom(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
mate_dom(Nm, Rs, B, Id, Sh, R?) :- ground(Rs?), ground(B?), ground(Id?), ground(Sh?) |
    dom_bindings(Nm?, Rs?, B?, Id?, Sh?, Bs),
    some_binding(Bs?, R).
%% The bindings under which the precondition at Id of the schema-binding B holds in the state Sh: "the binding's precondition at that role holds in a state if the required atoms are in it with the local variables bound by them in one way, the forbidden ones are not, and a constraint local to the role holds under that binding; its effect there is with that binding" (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications"; vGLP #18 Cowork to Code, Code_inbox.md, 2026-10-20 21:11 UTC, item 1): the atoms the roles sent to Id require, as a multiset, in Sh, the variables local to those roles, which B leaves standing for themselves (lv), bound by them; those they forbid not in Sh; and the constraint, where it is local to a role sent to Id (con_at), holding under that binding.  Each binding of the local variables by the required atoms is one way, the first of them giving the effect (apply_part).
procedure dom_bindings(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, Bindings).
dom_bindings(Nm, Rs, B, Id, Sh, Bs?) :- ground(Nm?), ground(Rs?), ground(B?), ground(Id?), ground(Sh?) |
    specs_at(Rs?, 1, B?, Id?, RsP),
    unlocal(B?, B0),
    con_at(Nm?, B?, Id?, Con),
    dom_bindings1(RsP?, B0?, Sh?, Con?, Bs).
procedure dom_bindings1(RoleSpecs?, Binding?, GAtoms?, Constraint?, Bindings).
dom_bindings1(RsP, B0, Sh, Con, Bs?) :- ground(RsP?), ground(Sh?), ground(Con?) |
    reqs_of(RsP?, Q),
    match_all(Q?, Sh?, B0?, Cs),
    dom_keep(Cs?, RsP?, Sh?, Con?, Bs).
procedure dom_keep(Bindings?, RoleSpecs?, GAtoms?, Constraint?, Bindings).
dom_keep([], _, _, _, []).
dom_keep([B|Bs], RsP, Sh, Con, R?) :- ground(B?), ground(RsP?), ground(Sh?), ground(Con?) |
    cand_ok(RsP?, B?, Sh?, O1),
    con_holds(Con?, B?, O2),
    and(O1?, O2?, Ok),
    dom_keep(Bs?, RsP?, Sh?, Con?, R1),
    keep_binding(Ok?, B?, R1?, R).
procedure reqs_of(RoleSpecs?, SAtoms).
reqs_of([], []).
reqs_of([R|Rs], Q?) :- ground(R?) | rs_req(R?, Q1), reqs_of(Rs?, Q2), app(Q1?, Q2?, Q).
%% Each role's required atoms, as a multiset, in the state, and no forbidden
%% atom whose variables are all bound in it; one with a variable free is met
%% by a binding sending it to a person or speech act the state does not name.
procedure cand_ok(RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok([], _, _, yes).
cand_ok([R|Rs], B, Sh, Out?) :- ground(R?), ground(B?), ground(Sh?) |
    rs_req(R?, Q),
    img_atoms(Q?, B?, G),
    ms_sub(G?, Sh?, B1),
    rs_forb(R?, F),
    forb_ok(F?, B?, Sh?, B2),
    and(B1?, B2?, B3),
    cand_ok1(B3?, Rs?, B?, Sh?, Out).
procedure cand_ok1(YesNo?, RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok1(no, _, _, _, no).
cand_ok1(yes, Rs, B, Sh, Out?) :- cand_ok(Rs?, B?, Sh?, Out).
procedure forb_ok(SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok([], _, _, yes).
forb_ok([A|As], B, Sh, R?) :- ground(A?), ground(B?), ground(Sh?) |
    atom_bound(A?, B?, Bd),
    forb_one(Bd?, A?, B?, Sh?, R1),
    forb_ok1(R1?, As?, B?, Sh?, R).
procedure forb_one(YesNo?, SAtom?, Binding?, GAtoms?, YesNo).
forb_one(no, _, _, _, yes).
forb_one(yes, A, B, Sh, R?) :- ground(Sh?) |
    img_atom(A?, B?, G),
    mem(G?, Sh?, In),
    neg(In?, R).
procedure forb_ok1(YesNo?, SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok1(no, _, _, _, no).
forb_ok1(yes, As, B, Sh, R?) :- forb_ok(As?, B?, Sh?, R).

%% The effect at the agent Id of the part the term P names: its state less the atoms the schema-binding deletes there, plus those it adds, the join of those of the roles sent to Id, as multisets (GSC, Definition "Compilation"), a multiplicity k deleting or adding k copies, under the binding under which its precondition there holds, its variables local to Id's roles bound by the state: "its effect there is with that binding" (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications"; dom_bindings), the first of them.  The effect is applied only where the precondition holds, by the Propose of an attempt of one participant, which tests it, and by the Commit and the Outcome of an attempt the agent voted yes on, holding it prepared since, so that its state has not changed; the second clause covers the type.
procedure apply_part(Class?, Peer?, GAtoms?, GAtoms).
apply_part(P, Id, S, S1?) :- ground(P?), ground(Id?), ground(S?) |
    term_spec(P?, Nm, Rs, Bn),
    reflexive_preds(Rf),
    hat(Rf?, Id?, S?, Sh),
    dom_bindings(Nm?, Rs?, Bn?, Id?, Sh?, Bs),
    term_spec(P?, _, Rs2, Bn2),
    apply_with(Bs?, Rs2?, Bn2?, Id?, S?, S1).
procedure apply_with(Bindings?, RoleSpecs?, Binding?, Peer?, GAtoms?, GAtoms).
apply_with([B|_], Rs, _, Id, S, S1?) :- ground(Rs?), ground(B?), ground(Id?) |
    specs_at(Rs?, 1, B?, Id?, RsP),
    joins(RsP?, B?, D, A),
    ms_diff(S?, D?, S0),
    app(A?, S0?, S1).
apply_with([], Rs, Bn, Id, S, S1?) :- ground(Rs?), ground(Bn?), ground(Id?) |
    specs_at(Rs?, 1, Bn?, Id?, RsP),
    joins(RsP?, Bn?, D, A),
    ms_diff(S?, D?, S0),
    app(A?, S0?, S1).
procedure delta_at(Deltas?, Peer?, GAtoms, GAtoms).
delta_at([], _, [], []).
delta_at([delta(P, D, A)|_], Id, D?, A?) :- P? =?= Id? | true.
delta_at([_|Ps], Id, D?, A?) :- otherwise | delta_at(Ps?, Id?, D, A).

%% ===========================================================================
%% Classes: from a term of the request type to the class it names
%% ===========================================================================

%% The class a term names, the agent's entry for it, met or new; nocls where the binding is not one (Definition "Binding": two roles share a person only if neither adds or deletes an atom naming the other; admissible), where it determines no transaction, its deleted and added atoms meeting at a participant (deltas_valid) or an atom required and forbidden there (live_at), or where the agent is no participant.  A schema-binding that determines no transaction relates no two transactions, so it is of no class (Section 5.4, the paragraph on act schemas).
procedure st_class(Class?, St?, ClassRes, St).
st_class(C, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), R?,
        st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca1?, Pd?, Pr?, Hd?, Ix?, Rq?)) :-
    ground(Id?) |
    class_info(C?, Id?, Ca?, R, Ca1).
procedure class_info(Class?, Peer?, Infos?, ClassRes, Infos).
class_info(C, Id, Ca, R?, Ca1?) :- ground(C?) |
    binding_of(C?, Nm, B),
    class_info1(Nm?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info1(Constant?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info1(Nm, B, C, Id, Ca, R?, Ca1?) :- ground(Nm?), ground(B?) |
    bound_spec(Nm?, B?, Rs),
    rule_spec_ok(Nm?, B?, V0),
    con_live(Nm?, B?, Vc),
    and(V0?, Vc?, V1),
    class_info2(V1?, Rs?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info2(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info2(V1, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) |
    admissible(Rs?, B?, V2),
    and(V1?, V2?, V),
    class_info3(V?, Rs?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info3(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info3(no, _, _, _, _, Ca, nocls, Ca?).
class_info3(yes, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) |
    sig_of(Rs?, B?, Ps),
    class_info4(Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info4(Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info4(Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Id?), ground(Rs?), ground(B?) |
    deltas_valid(Ps?, V1),
    deltas_peers(Ps?, Q),
    mem(Id?, Q?, V2),
    deltas_peers(Ps?, Q1),
    reflexive_preds(Rf),
    live_at(Q1?, Rs?, B?, Rf?, V3),
    and(V1?, V2?, V12),
    and(V12?, V3?, V),
    class_info5(V?, Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).
procedure class_info5(YesNo?, Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info5(no, _, _, _, _, _, Ca, nocls, Ca?).
class_info5(yes, Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Ca?) |
    cache_find(Rs?, B?, Ps?, Ca?, F),
    class_info6(F?, Ps?, C?, Id?, Ca?, R, Ca1).
procedure class_info6(ClassRes?, Deltas?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info6(cls(I), _, _, _, Ca, cls(I?), Ca?).
class_info6(nocls, Ps, C, Id, Ca, R?, Ca1?) :-
    new_info(C?, Ps?, Id?, I),
    add_info(I?, Ca?, R, Ca1).
procedure add_info(Info?, Infos?, ClassRes, Infos).
add_info(I, Ca, cls(I?), Ca1?) :- ground(I?) | app(Ca?, [I?], Ca1).

%% The agent's entry for the class of a schema-binding of the participants and atoms Ps: the entry one of whose schema-bindings it is linked to (in_class), and nocls where none is.
procedure cache_find(RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find(_, _, _, [], nocls).
cache_find(Rs, B, Ps, [ci(C, Ps1, Q, Pts, Ms)|Is], R?) :-
    ground(Rs?), ground(B?), ground(Ps?), ground(Ps1?), ground(Q?), ground(Ms?) |
    in_class(Rs?, B?, Ps?, Ps1?, Q?, Ms?, E),
    cache_find1(E?, ci(C?, Ps1?, Q?, Pts?, Ms?), Rs?, B?, Ps?, Is?, R).
procedure cache_find1(YesNo?, Info?, RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find1(yes, I, _, _, _, _, cls(I?)).
cache_find1(no, _, Rs, B, Ps, Is, R?) :- cache_find(Rs?, B?, Ps?, Is?, R).

%% A new entry, for the class of the term C at the agent Id: the schema-bindings of the participants and atoms Ps that determine a transaction (mates_of, live_mates), and among them the class of C's schema-binding, those a chain of links joins to it (class_mates), with the parts they determine (info_parts_of).
procedure new_info(Class?, Deltas?, Peer?, Info).
new_info(C, Ps, Id, I?) :- ground(Ps?) |
    contract_schemas(Ss),
    reflexive_preds(Rf),
    mates_of(Ss?, Ps?, Ms0),
    dedup_mates(Ms0?, Ms1),
    deltas_peers(Ps?, Q),
    new_info0(C?, Ps?, Ms1?, Q?, Rf?, Id?, I).
procedure new_info0(Class?, Deltas?, Mates?, Peers?, Preds?, Peer?, Info).
new_info0(C, Ps, Ms1, Q, Rf, Id, I?) :- ground(C?), ground(Q?), ground(Rf?) |
    live_mates(Ms1?, Q?, Rf?, Ms2),
    binding_of(C?, Nm, B),
    class_mates(Nm?, B?, Ms2?, Q?, Rf?, Ms),
    new_info1(C?, Ps?, Ms?, Id?, I).
procedure new_info1(Class?, Deltas?, Mates?, Peer?, Info).
new_info1(C, Ps, Ms, Id, ci(C?, Ps?, Q?, Pts?, Ms?)) :- ground(Ps?), ground(Ms?) |
    deltas_peers(Ps?, Q),
    deltas_peers(Ps?, Q1),
    info_parts_of(Ms?, Q1?, Id?, Pts).

procedure info_q(Info?, Peers).
info_q(ci(_, _, Q, _, _), Q?).
procedure info_parts(Info?, Parts).
info_parts(ci(_, _, _, Pts, _), Pts?).

%% The participants of a class and the atoms each deletes and adds: the join
%% of those of the roles sent to it (GSC, Definition "Compilation").
procedure sig_of(RoleSpecs?, Binding?, Deltas).
sig_of(Rs, B, Ps?) :- ground(Rs?), ground(B?) |
    role_persons(Rs?, 1, B?, Ws),
    dedup(Ws?, Q),
    deltas_for(Q?, Rs?, B?, Ps).
procedure role_persons(RoleSpecs?, Integer?, Binding?, Peers).
role_persons([], _, _, []).
role_persons([_|Rs], I, B, [P?|Ps?]) :- integer(I?), ground(B?) |
    role_person(I?, B?, P),
    I1 := I? + 1,
    role_persons(Rs?, I1?, B?, Ps).
procedure deltas_for(Peers?, RoleSpecs?, Binding?, Deltas).
deltas_for([], _, _, []).
deltas_for([P|Ps], Rs, B, [delta(P?, D?, A?)|Xs?]) :- ground(P?), ground(Rs?), ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    joins(RsP?, B?, D, A),
    deltas_for(Ps?, Rs?, B?, Xs).
procedure joins(RoleSpecs?, Binding?, GAtoms, GAtoms).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) |
    dels_join(RsP?, B?, [], D),
    adds_join(RsP?, B?, [], A).
procedure dels_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
dels_join([], _, Acc, Acc?).
dels_join([R|Rs], B, Acc, Out?) :- ground(B?) |
    rs_del(R?, D),
    img_atoms(D?, B?, G),
    ms_join(Acc?, G?, Acc1),
    dels_join(Rs?, B?, Acc1?, Out).
procedure adds_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
adds_join([], _, Acc, Acc?).
adds_join([R|Rs], B, Acc, Out?) :- ground(B?) |
    rs_add(R?, A),
    img_atoms(A?, B?, G),
    ms_join(Acc?, G?, Acc1),
    adds_join(Rs?, B?, Acc1?, Out).
procedure specs_at(RoleSpecs?, Integer?, Binding?, Peer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R|Rs], I, B, P, Out?) :- integer(I?), ground(B?), ground(P?) |
    role_person(I?, B?, Q),
    I1 := I? + 1,
    specs_at(Rs?, I1?, B?, P?, Rest),
    keep_spec(Q?, P?, R?, Rest?, Out).
procedure keep_spec(Peer?, Peer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R?|Rest?]) :- Q? =?= P? | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.
procedure deltas_valid(Deltas?, YesNo).
deltas_valid([], yes).
deltas_valid([delta(_, D, A)|Ps], B?) :- ground(A?) |
    ms_meets(D?, A?, M),
    neg(M?, B1),
    deltas_valid1(B1?, Ps?, B).
procedure deltas_valid1(YesNo?, Deltas?, YesNo).
deltas_valid1(no, _, no).
deltas_valid1(yes, Ps, B?) :- deltas_valid(Ps?, B).
procedure deltas_peers(Deltas?, Peers).
deltas_peers([], []).
deltas_peers([delta(P, _, _)|Ps], [P?|Qs?]) :- deltas_peers(Ps?, Qs).
procedure deltas_eq(Deltas?, Deltas?, YesNo).
deltas_eq(A, B, E?) :- ground(A?), ground(B?) |
    len_deltas(A?, La),
    len_deltas(B?, Lb),
    same_int(La?, Lb?, E1),
    deltas_in(A?, B?, E2),
    and(E1?, E2?, E).
procedure len_deltas(Deltas?, Integer).
len_deltas([], 0).
len_deltas([_|Ps], N?) :- len_deltas(Ps?, M), N := M? + 1.
procedure deltas_in(Deltas?, Deltas?, YesNo).
deltas_in([], _, yes).
deltas_in([X|Xs], B, E?) :- ground(B?) |
    delta_in(X?, B?, E1),
    deltas_in1(E1?, Xs?, B?, E).
procedure deltas_in1(YesNo?, Deltas?, Deltas?, YesNo).
deltas_in1(no, _, _, no).
deltas_in1(yes, Xs, B, E?) :- deltas_in(Xs?, B?, E).
procedure delta_in(Delta?, Deltas?, YesNo).
delta_in(_, [], no).
delta_in(delta(P, D, A), [delta(Q, D1, A1)|Ps], E?) :- P? =?= Q?, ground(D?), ground(A?) |
    ms_eq(D?, D1?, E1),
    ms_eq(A?, A1?, E2),
    and(E1?, E2?, E3),
    delta_in1(E3?, delta(P?, D?, A?), Ps?, E).
delta_in(X, [_|Ps], E?) :- otherwise | delta_in(X?, Ps?, E).
procedure delta_in1(YesNo?, Delta?, Deltas?, YesNo).
delta_in1(yes, _, _, yes).
delta_in1(no, X, Ps, E?) :- delta_in(X?, Ps?, E).

%% Definition "Binding": two roles sent to one person only if neither adds or
%% deletes an atom naming the other.
procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) |
    rs_len(Rs?, K),
    pairs_ok(1, K?, Rs?, B?, R).
procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- I? > K? | true.
pairs_ok(I, K, Rs, B, R?) :- I? =< K?, ground(Rs?), ground(B?) |
    J := I? + 1,
    pair_row(I?, J?, K?, Rs?, B?, R1),
    I1 := I? + 1,
    pairs_ok1(R1?, I1?, K?, Rs?, B?, R).
procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).
procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- J? > K? | true.
pair_row(I, J, K, Rs, B, R?) :- J? =< K?, ground(Rs?), ground(B?) |
    role_person(I?, B?, P),
    role_person(J?, B?, Q),
    nth_spec(Rs?, I?, RI),
    nth_spec(Rs?, J?, RJ),
    pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1),
    J1 := J? + 1,
    pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).
procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).
procedure pair_ok(Peer?, Peer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- P? =?= Q? |
    role_names(RI?, J?, A1),
    role_names(RJ?, I?, A2),
    or(A1?, A2?, A),
    neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.
procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(rs(_, A, D, _, _), J, R?) :- integer(J?) |
    names_role(A?, J?, R1),
    names_role(D?, J?, R2),
    or(R1?, R2?, R).
%% An atom names a role among its arguments, the base of a name term among them, or the role of a signed term
%% among them (GSC, Section 3: "An atom names what is among its arguments or
%% is the signer of one: ... in a schema a role or a variable, the role of a
%% signed term included").
procedure names_role(SAtoms?, Integer?, YesNo).
names_role([], _, no).
names_role([times(_, A)|As], J, R?) :- names_role([A?|As?], J?, R).
names_role([atom(_, Vs)|As], J, R?) :- integer(J?), ground(Vs?) |
    flat_names(Vs?, Fs),
    mem(role(J?), Fs?, R1),
    sgn_names(Vs?, J?, R2),
    or(R1?, R2?, R12),
    names_role1(R12?, As?, J?, R).
procedure names_role1(YesNo?, SAtoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, As, J, R?) :- names_role(As?, J?, R).
procedure sgn_names(Vars?, Integer?, YesNo).
sgn_names([], _, no).
sgn_names([sgn(_, I)|_], J, yes) :- I? =:= J? | true.
sgn_names([_|Vs], J, R?) :- otherwise | sgn_names(Vs?, J?, R).

%% Definition "Binding", admissible: a speech-act variable in an atom added at
%% a role and in no atom required at a role is sent to a speech act signed by
%% the person in a guarding role.
procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) |
    adds_of(Rs?, Ad),
    reqs_of(Rs?, Rq),
    guard_roles(Rs?, 1, Gi),
    persons_of(Gi?, B?, Gp),
    atoms_vars(Ad?, Av),
    adm_each(Av?, Rq?, B?, Gp?, R).
procedure adm_each(Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V|Vs], Rq, B, Gp, R?) :- ground(V?), ground(Rq?), ground(B?), ground(Gp?) |
    adm_var(V?, Rq?, B?, Gp?, R1),
    adm_each1(R1?, Vs?, Rq?, B?, Gp?, R).
procedure adm_each1(YesNo?, Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Rq, B, Gp, R?) :- adm_each(Vs?, Rq?, B?, Gp?, R).
procedure adm_var(Var?, SAtoms?, Binding?, Peers?, YesNo).
adm_var(svar(X), Rq, B, Gp, R?) :- ground(X?), ground(B?) |
    atoms_vars(Rq?, Qv),
    mem(svar(X?), Qv?, InReq),
    lookup(svar(X?), B?, F),
    adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
%% The variables of a name term are taken apart (atoms_vars); the clause covers the type.
adm_var(nterm(_), _, _, _, yes).
%% A signed term's speech-act variable occurs in an atom some role requires
%% (GSC, Definition "Act schema"), so it asks nothing of the binding.
adm_var(sgn(_, _), _, _, _, yes).
%% A number names no agent, so admissibility does not concern it (GSC, Section 3.2).
adm_var(num(_), _, _, _, yes).
procedure adm_var1(YesNo?, Found?, Peers?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(s(speech(_, P))), Gp, R?) :- mem(P?, Gp?, R).
adm_var1(no, found(p(_)), _, no).
adm_var1(no, found(c(_)), _, no).
adm_var1(no, found(n(_)), _, no).
adm_var1(no, found(lv(_, _)), _, no).
adm_var1(no, free, _, no).
procedure adds_of(RoleSpecs?, SAtoms).
adds_of([], []).
adds_of([R|Rs], A?) :- rs_add(R?, A1), adds_of(Rs?, A2), app(A1?, A2?, A).
procedure atoms_vars(SAtoms?, Vars).
atoms_vars([], []).
atoms_vars([atom(_, Vs)|As], R?) :- flat_names(Vs?, Ws), atoms_vars(As?, R1), app(Ws?, R1?, R).
atoms_vars([times(V, A)|As], [V?|R?]) :- atoms_vars([A?|As?], R).
procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([rs(guarded, _, _, _, _)|Rs], I, [I?|Is?]) :- integer(I?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, Is).
guard_roles([rs(unguarded, _, _, _, _)|Rs], I, Is?) :- integer(I?) |
    I1 := I? + 1,
    guard_roles(Rs?, I1?, Is).
procedure persons_of(Ints?, Binding?, Peers).
persons_of([], _, []).
persons_of([I|Is], B, [P?|Ps?]) :- ground(B?) |
    role_person(I?, B?, P),
    persons_of(Is?, B?, Ps).

%% --- The schema-bindings of a class's participants and atoms: those of every
%% --- schema whose roles, sent onto the participants, delete and add exactly
%% --- the class's atoms; the class is those a chain of links joins (below) ---
procedure mates_of(Schemas?, Deltas?, Mates).
mates_of([], _, []).
mates_of([schema(Nm, _, Rs)|Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Ps?) |
    deltas_peers(Ps?, Q),
    rs_len(Rs?, K),
    fit_assigns(K?, Q?, Rs?, Ps?, As),
    mates_assigns(As?, Nm?, Rs?, Ps?, M1),
    mates_of(Ss?, Ps?, M2),
    app(M1?, M2?, M).
%% A schema with listed roles: each assignment of its roles to the participants, each listed role's place sent to its base person, extended by each choice, for each listed role, of a list of participants as its people, a set, in the order of identifiers, its roles of that list (bound_spec, tuple_binds).
mates_of([lschema(Nm, _, Rs, Lsts)|Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Lsts?), ground(Ps?) |
    deltas_peers(Ps?, Q),
    rs_len(Rs?, K),
    blank_listed(Lsts?, Rs?, Rs0),
    fit_assigns(K?, Q?, Rs0?, Ps?, As0),
    on_base(As0?, Lsts?, As),
    deltas_peers(Ps?, Q1),
    sort_peers(Q1?, Q2),
    subsets(Q2?, Ls),
    tuples(Lsts?, Ls?, Ts),
    listed_mates(Ts?, As?, Nm?, Rs?, Lsts?, Ps?, M1),
    mates_of(Ss?, Ps?, M2),
    app(M1?, M2?, M).
procedure on_base(Bindings?, Listings?, Bindings).
on_base([], _, []).
on_base([B|Bs], Lsts, R?) :- ground(B?), ground(Lsts?) |
    on_bases(Lsts?, B?, E),
    on_base(Bs?, Lsts?, R1),
    keep_binding(E?, B?, R1?, R).
%% Whether each listed role's place is sent to its base person.
procedure on_bases(Listings?, Binding?, YesNo).
on_bases([], _, yes).
on_bases([listing(I, Bi, _, _)|Lsts], B, E?) :- ground(B?) |
    role_person(I?, B?, P),
    role_person(Bi?, B?, Q),
    same(P?, Q?, E1),
    on_bases(Lsts?, B?, E2),
    and(E1?, E2?, E).
procedure keep_binding(YesNo?, Binding?, Bindings?, Bindings).
keep_binding(yes, B, R, [B?|R?]).
keep_binding(no, _, R, R?).
procedure subsets(Peers?, PeerLists).
subsets([], [[]]).
subsets([P|Ps], R?) :- ground(P?), ground(Ps?) |
    subsets(Ps?, S1),
    with_first(S1?, P?, S2),
    subsets(Ps?, S3),
    app(S2?, S3?, R).
procedure with_first(PeerLists?, Peer?, PeerLists).
with_first([], _, []).
with_first([L|Ls], P, [[P?|L?]|R?]) :- ground(P?) | with_first(Ls?, P?, R).
%% Each choice of one list of Ls for each listed role of Lsts, in the order of the roles.
procedure tuples(Listings?, PeerLists?, ListTuples).
tuples([], _, [[]]).
tuples([_|Lsts], Ls, R?) :- ground(Ls?) |
    tuples(Lsts?, Ls?, R1),
    prepend_each(Ls?, R1?, R).
procedure prepend_each(PeerLists?, ListTuples?, ListTuples).
prepend_each([], _, []).
prepend_each([L|Ls], Ts, R?) :- ground(L?), ground(Ts?) |
    with_head(Ts?, L?, R1),
    prepend_each(Ls?, Ts?, R2),
    app(R1?, R2?, R).
procedure with_head(ListTuples?, Peers?, ListTuples).
with_head([], _, []).
with_head([T|Ts], L, [[L?|T?]|R?]) :- ground(L?) | with_head(Ts?, L?, R).
procedure listed_mates(ListTuples?, Bindings?, Constant?, RoleSpecs?, Listings?, Deltas?, Mates).
listed_mates([], _, _, _, _, _, []).
listed_mates([T|Ts], As, Nm, Rs, Lsts, Ps, M?) :-
    ground(T?), ground(As?), ground(Nm?), ground(Rs?), ground(Lsts?), ground(Ps?) |
    rs_len(Rs?, K),
    K1 := K? + 1,
    tuple_binds(Lsts?, T?, K1?, Cs),
    extend_all(As?, Cs?, Bs),
    spec_for(Rs?, Lsts?, T?, Rs1),
    mates_assigns(Bs?, Nm?, Rs1?, Ps?, M1),
    listed_mates(Ts?, As?, Nm?, Rs?, Lsts?, Ps?, M2),
    app(M1?, M2?, M).
procedure extend_all(Bindings?, Binding?, Bindings).
extend_all([], _, []).
extend_all([B|Bs], Cs, [B1?|R?]) :- ground(Cs?) | app(B?, Cs?, B1), extend_all(Bs?, Cs?, R).
%% fit_assigns(K, Q, Rs, Ps, As): the assignments of the roles 1..K, of the role specifications Rs, to the participants Q, each binding b(role(I), p(P)) put in front, in the order assigns gives them (role 1 the outermost), but only those whose every role's deleted and added atoms match, under the roles assigned before it and itself, into the atoms the class's changes Ps delete and add at its person: an assignment where some role's do not determines no schema-binding of the class, its match_deltas finding none, and it is not tried (Code #12's change 5, vGLP #18 Cowork, Code_inbox.md 2026-10-20 12:03 UTC: "found by matching each schema's deleted and added atoms against the class's changes at each participant, not by trying every assignment of participants to roles").  So the schema-bindings found, and their order, are those of every assignment.
procedure fit_assigns(Integer?, Peers?, RoleSpecs?, Deltas?, Bindings).
fit_assigns(K, Q, Rs, Ps, As?) :- fit_roles(1, K?, Q?, Rs?, Ps?, [], As).
procedure fit_roles(Integer?, Integer?, Peers?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_roles(I, K, _, _, _, B, [B?]) :- I? > K? | true.
fit_roles(I, K, Q, Rs, Ps, B, As?) :- I? =< K?, ground(Q?), ground(Rs?) |
    nth_spec(Rs?, I?, R),
    fit_one(Q?, I?, K?, Q?, R?, Rs?, Ps?, B?, As).
procedure fit_one(Peers?, Integer?, Integer?, Peers?, RoleSpec?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_one([], _, _, _, _, _, _, _, []).
fit_one([P|Qs], I, K, Q, R, Rs, Ps, B, As?) :-
    ground(P?), integer(I?), ground(Q?), ground(R?), ground(Rs?), ground(Ps?), ground(B?) |
    fits(R?, [b(role(I?), p(P?))|B?], P?, Ps?, Ok),
    I1 := I? + 1,
    fit_next(Ok?, I1?, K?, Q?, Rs?, Ps?, [b(role(I?), p(P?))|B?], As1),
    fit_one(Qs?, I?, K?, Q?, R?, Rs?, Ps?, B?, As2),
    app(As1?, As2?, As).
procedure fit_next(YesNo?, Integer?, Integer?, Peers?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_next(no, _, _, _, _, _, _, []).
fit_next(yes, I, K, Q, Rs, Ps, B, As?) :- fit_roles(I?, K?, Q?, Rs?, Ps?, B?, As).
%% Whether the deleted and added atoms of the role R, sent to the participant P, match under the binding B into the atoms P deletes and adds, as match_delta1 matches them.
procedure fits(RoleSpec?, Binding?, Peer?, Deltas?, YesNo).
fits(R, B, P, Ps, Ok?) :- ground(R?) |
    delta_at(Ps?, P?, D, A),
    rs_del(R?, Dr),
    rs_add(R?, Ar),
    match_all(Dr?, D?, B?, Bs),
    match_all_each(Bs?, Ar?, A?, Ms),
    some_binding(Ms?, Ok).
procedure some_binding(Bindings?, YesNo).
some_binding([], no).
some_binding([_|_], yes).
procedure assigns(Integer?, Peers?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).
procedure assigns1(Integer?, Integer?, Peers?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- I? > K? | true.
assigns1(I, K, Q, Acc, R?) :- I? =< K?, ground(Q?) |
    extend_role(Acc?, I?, Q?, Acc1),
    I1 := I? + 1,
    assigns1(I1?, K?, Q?, Acc1?, R).
procedure extend_role(Bindings?, Integer?, Peers?, Bindings).
extend_role([], _, _, []).
extend_role([B|Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) |
    extend_one(Q?, I?, B?, R1),
    extend_role(Bs?, I?, Q?, R2),
    app(R1?, R2?, R).
procedure extend_one(Peers?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P|Ps], I, B, [[b(role(I?), p(P?))|B?]|R?]) :- ground(B?), integer(I?) |
    extend_one(Ps?, I?, B?, R).
procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_assigns([], _, _, _, []).
mates_assigns([B|Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) |
    deltas_peers(Ps?, Q),
    role_persons(Rs?, 1, B?, Ws),
    all_in(Q?, Ws?, Onto),
    rule_spec_ok(Nm?, B?, Ok),
    and(Onto?, Ok?, Go),
    mates_assign(Go?, B?, Nm?, Rs?, Ps?, M1),
    mates_assigns(Bs?, Nm?, Rs?, Ps?, M2),
    app(M1?, M2?, M).
procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_assign(no, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Ps, M?) :- ground(Rs?), ground(Ps?) |
    match_deltas(Ps?, Rs?, [B?], Bs),
    mates_check(Bs?, Nm?, Rs?, Ps?, M).
procedure match_deltas(Deltas?, RoleSpecs?, Bindings?, Bindings).
match_deltas([], _, Bs, Bs?).
match_deltas([delta(P, D, A)|Ps], Rs, Bs, R?) :- ground(P?), ground(D?), ground(A?), ground(Rs?) |
    match_delta(Bs?, P?, D?, A?, Rs?, Bs1),
    match_deltas(Ps?, Rs?, Bs1?, R).
procedure match_delta(Bindings?, Peer?, GAtoms?, GAtoms?, RoleSpecs?, Bindings).
match_delta([], _, _, _, _, []).
match_delta([B|Bs], P, D, A, Rs, R?) :- ground(B?), ground(P?), ground(D?), ground(A?), ground(Rs?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    match_delta1(RsP?, B?, D?, A?, B2),
    match_delta(Bs?, P?, D?, A?, Rs?, R2),
    app(B2?, R2?, R).
procedure match_delta1(RoleSpecs?, Binding?, GAtoms?, GAtoms?, Bindings).
match_delta1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) |
    dels_of(RsP?, Dp),
    adds_of(RsP?, Ap),
    match_all(Dp?, D?, B?, B1),
    match_all_each(B1?, Ap?, A?, R).
procedure dels_of(RoleSpecs?, SAtoms).
dels_of([], []).
dels_of([R|Rs], A?) :- rs_del(R?, A1), dels_of(Rs?, A2), app(A1?, A2?, A).
procedure mates_check(Bindings?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_check([], _, _, _, []).
mates_check([B|Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) |
    local_norm(Nm?, B?, Nb),
    mates_check1(Nb?, Nm?, Rs?, Ps?, M1),
    mates_check(Bs?, Nm?, Rs?, Ps?, M2),
    app(M1?, M2?, M).
procedure mates_check1(LNorm?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_check1(badnorm, _, _, _, []).
mates_check1(norm(B), Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) |
    sig_of(Rs?, B?, Ps1),
    deltas_eq(Ps?, Ps1?, E1),
    admissible(Rs?, B?, E2),
    and(E1?, E2?, E),
    mate_of(E?, B?, Nm?, Rs?, M).
%% A schema-binding found by matching a schema's deleted and added atoms with a class's: the variables local to a role are not bound by it, and stand for themselves, lv(S, X) (the type Val), so a local variable matched with lv(S, X) of its own schema S, or with nothing, is left so, and a binding that sends a local variable to anything else, or a variable that is not local to lv, is no schema-binding of the class (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "A numeric variable that occurs only in atoms the schema requires or deletes at one role, and in the constraint, is local to that role: the schema-binding does not bind it").  A class whose schema-binding deletes or adds an atom with a local variable so holds the schema-bindings of its own schema of those atoms.
procedure local_norm(Constant?, Binding?, LNorm).
local_norm(Nm, B, R?) :- ground(Nm?), ground(B?) |
    schema_numeric(Nm?, N),
    local_norm1(N?, Nm?, B?, R).
procedure local_norm1(Numeric?, Constant?, Binding?, LNorm).
local_norm1(numeric(_, Ls, _), Nm, B, R?) :- ground(Ls?), ground(Nm?), ground(B?) |
    lv_wrong(B?, Ls?, Nm?, W),
    locals_put(Ls?, Nm?, B?, B1),
    norm_or_bad(W?, B1?, R).
procedure norm_or_bad(YesNo?, Binding?, LNorm).
norm_or_bad(no, B, norm(B?)).
norm_or_bad(yes, _, badnorm).
procedure lv_wrong(Binding?, Vars?, Constant?, YesNo).
lv_wrong([], _, _, no).
lv_wrong([b(V, X)|Bs], Ls, Nm, W?) :- ground(V?), ground(X?), ground(Ls?), ground(Nm?) |
    mem(V?, Ls?, IsL),
    entry_wrong(IsL?, V?, X?, Nm?, W1),
    lv_wrong(Bs?, Ls?, Nm?, W2),
    or(W1?, W2?, W).
procedure entry_wrong(YesNo?, Var?, Val?, Constant?, YesNo).
entry_wrong(yes, V, X, Nm, W?) :- local_wrong(V?, X?, Nm?, W).
entry_wrong(no, _, X, _, W?) :- is_lv(X?, W).
procedure local_wrong(Var?, Val?, Constant?, YesNo).
local_wrong(num(Xn), X, Nm, W?) :- ground(Xn?), ground(Nm?) | same(X?, lv(Nm?, Xn?), S), neg(S?, W).
local_wrong(_, _, _, yes) :- otherwise | true.
procedure is_lv(Val?, YesNo).
is_lv(lv(_, _), yes).
is_lv(p(_), no).
is_lv(s(_), no).
is_lv(c(_), no).
is_lv(n(_), no).
procedure locals_put(Vars?, Constant?, Binding?, Binding).
locals_put([], _, B, B?).
locals_put([V|Vs], Nm, B, B2?) :- ground(V?), ground(Nm?), ground(B?) |
    lookup(V?, B?, F),
    local_put(F?, V?, Nm?, B?, B1),
    locals_put(Vs?, Nm?, B1?, B2).
procedure local_put(Found?, Var?, Constant?, Binding?, Binding).
local_put(free, num(X), Nm, B, [b(num(X?), lv(Nm?, X?))|B?]) :- ground(X?), ground(Nm?) | true.
local_put(found(_), _, _, B, B?).
local_put(free, V, _, B, B?) :- otherwise, ground(V?) | true.
procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, B?, G?, F?)]) :- ground(B?), ground(Rs?) |
    guard_roles(Rs?, 1, Gi),
    persons_of(Gi?, B?, Gp),
    sort_peers(Gp?, Gs),
    dedup(Gs?, G),
    role_person(1, B?, F).
procedure dedup_mates(Mates?, Mates).
dedup_mates([], []).
dedup_mates([M|Ms], [M?|R?]) :- ground(M?) |
    drop_mate(M?, Ms?, Ms1),
    dedup_mates(Ms1?, R).
procedure drop_mate(Mate?, Mates?, Mates).
drop_mate(_, [], []).
drop_mate(mate(N, B, G, F), [mate(N1, B1, G1, F1)|Ms], R?) :-
    ground(N?), ground(B?), ground(G?), ground(F?), ground(N1?), ground(B1?) |
    same(N?, N1?, E1),
    ms_eq(B?, B1?, E2),
    and(E1?, E2?, E),
    drop_mate1(E?, mate(N?, B?, G?, F?), mate(N1?, B1?, G1?, F1?), Ms?, R).
procedure drop_mate1(YesNo?, Mate?, Mate?, Mates?, Mates).
drop_mate1(yes, M, _, Ms, R?) :- drop_mate(M?, Ms?, R).
drop_mate1(no, M, M1, Ms, [M1?|R?]) :- drop_mate(M?, Ms?, R).
%% The parts the schema-bindings Ms of a class determine, each pt(T, G, Op), in the order of Ms: named by the term T of the first of its schema-bindings, a schema-binding of the part of one before it naming no other part; its guard set G, the people in the marked roles of its schema-bindings; and, for an unguarded part, its opener, opener(P), P "the least, in the order of identifiers, of the people in the first role of the schema-bindings that determine it"; for a guarded part determined by a schema with a listed role whose base is not a guarding role, opener(P), P the least of the people in the first role of those schema-bindings that is not a guard of the part, "and so is the opener of a guarded part determined by a schema with a listed role whose base is not a guarding role, where that person is not a guard of the part" (vGLP a890465, Section 5.4, "Act schemas as local specifications"); and for every other guarded part guarded_part.  An opener per part is one the agent finds: an unguarded part has its opener in the first role of one of its schema-bindings, so the agent, which finds among its own transactions the classes of the unguarded schemas with it in their first role, finds every part it opens (vGLP #15, Code_inbox.md, 2026-10-19 10:50 UTC, item 3).
procedure info_parts_of(Mates?, Peers?, Peer?, Parts).
info_parts_of(Ms, Q, Id, Pts?) :- ground(Ms?) | parts_of(Ms?, Ms?, Q?, Id?, [], Pts).
%% parts_of(Ms, All, Q, Id, Seen, Pts): the parts of the schema-bindings Ms that are not the part of one of Seen, the openers taken over All.
procedure parts_of(Mates?, Mates?, Peers?, Peer?, Mates?, Parts).
parts_of([], _, _, _, _, []).
parts_of([M|Ms], All, Q, Id, Seen, Pts?) :- ground(M?), ground(Q?), ground(Seen?) |
    part_seen(Seen?, M?, Q?, Old),
    parts_of1(Old?, M?, Ms?, All?, Q?, Id?, Seen?, Pts).
procedure parts_of1(YesNo?, Mate?, Mates?, Mates?, Peers?, Peer?, Mates?, Parts).
parts_of1(yes, _, Ms, All, Q, Id, Seen, Pts?) :- parts_of(Ms?, All?, Q?, Id?, Seen?, Pts).
parts_of1(no, mate(N, B, G, F), Ms, All, Q, Id, Seen, [pt(T?, G?, Op?)|Pts?]) :-
    ground(N?), ground(B?), ground(G?), ground(F?), ground(All?), ground(Q?), ground(Id?) |
    class_of(N?, B?, Id?, T),
    part_firsts(All?, mate(N?, B?, G?, F?), Q?, Fs),
    part_gfirsts(All?, mate(N?, B?, G?, F?), Q?, G?, Fo),
    part_opener(G?, Fs?, Fo?, Op),
    parts_of(Ms?, All?, Q?, Id?, [mate(N?, B?, G?, F?)|Seen?], Pts).
procedure part_seen(Mates?, Mate?, Peers?, YesNo).
part_seen([], _, _, no).
part_seen([S|Ss], M, Q, B?) :- ground(M?), ground(Q?) |
    same_mpart(Q?, S?, M?, B1),
    part_seen1(B1?, Ss?, M?, Q?, B).
procedure part_seen1(YesNo?, Mates?, Mate?, Peers?, YesNo).
part_seen1(yes, _, _, _, yes).
part_seen1(no, Ss, M, Q, B?) :- part_seen(Ss?, M?, Q?, B).
%% The people in the first role of the schema-bindings of All that determine the part of M.
procedure part_firsts(Mates?, Mate?, Peers?, Peers).
part_firsts([], _, _, []).
part_firsts([mate(N, B, G, F)|Ms], M, Q, Fs?) :- ground(F?), ground(M?), ground(Q?) |
    same_mpart(Q?, mate(N?, B?, G?, F?), M?, S),
    part_firsts(Ms?, M?, Q?, Fs1),
    keep_peer(S?, F?, Fs1?, Fs).
%% The people in the first role of the schema-bindings of All that determine the part of M, of a schema with a listed role whose base is not a guarding role, and that are not guards of the part, G (vGLP a890465, Section 5.4, "Act schemas as local specifications").
procedure part_gfirsts(Mates?, Mate?, Peers?, Peers?, Peers).
part_gfirsts([], _, _, _, []).
part_gfirsts([mate(N, B, G1, F)|Ms], M, Q, G, Fs?) :- ground(N?), ground(F?), ground(M?), ground(Q?), ground(G?) |
    same_mpart(Q?, mate(N?, B?, G1?, F?), M?, S),
    opens_guarded(N?, O),
    mem(F?, G?, InG),
    neg(InG?, NotG),
    and(S?, O?, S1),
    and(S1?, NotG?, K),
    part_gfirsts(Ms?, M?, Q?, G?, Fs1),
    keep_peer(K?, F?, Fs1?, Fs).
%% Whether a schema is one with a listed role whose base is not a guarding role: its listed roles have one base (local.glp), its first role.
procedure opens_guarded(Constant?, YesNo).
opens_guarded(Nm, B?) :- schema_entry(Nm?, E), opens_guarded1(E?, B).
procedure opens_guarded1(Schema?, YesNo).
opens_guarded1(schema(_, _, _), no).
opens_guarded1(lschema(_, _, _, []), no).
opens_guarded1(lschema(_, _, Rs, [listing(_, Bi, _, _)|_]), B?) :- ground(Rs?), integer(Bi?) |
    nth_spec(Rs?, Bi?, R),
    spec_unguarded(R?, B).
procedure spec_unguarded(RoleSpec?, YesNo).
spec_unguarded(rs(unguarded, _, _, _, _), yes).
spec_unguarded(rs(guarded, _, _, _, _), no).
%% The opener of an unguarded part, from the people Fs in the first role of its schema-bindings, and of a guarded part, from those of Fo.
procedure part_opener(Peers?, Peers?, Peers?, Opener).
part_opener([], Fs, _, Op?) :- sort_peers(Fs?, Ss), least_opener(Ss?, Op).
part_opener([_|_], _, Fo, Op?) :- sort_peers(Fo?, Ss), least_opener(Ss?, Op).
%% A schema-binding is of its own part, so the people of an unguarded part are never none; a guarded part none of whose schema-bindings opens it has no opener, guarded_part.
procedure least_opener(Peers?, Opener).
least_opener([P|_], opener(P?)).
least_opener([], guarded_part).
%% Whether two schema-bindings of a class, each with the people it marks, determine one part.
procedure same_mpart(Peers?, Mate?, Mate?, YesNo).
same_mpart(Q, mate(N1, B1, G1, _), mate(N2, B2, G2, _), B?) :-
    same_bpart(Q?, N1?, B1?, G1?, N2?, B2?, G2?, B).

%% --- The class of a schema-binding: what a chain of links joins -----------
%% "The classes are those of the contract's equivalence, generated by relating two transactions when one schema-binding determines both" (vGLP 099f876, Section 5.4, "Act schemas as local specifications").  A schema-binding determines a transaction where its deleted and added atoms are disjoint at each participant and, at each, no atom is both required and forbidden and no atom of a reflexive predicate naming the participant is forbidden (live_at).  Two such schema-bindings of the same participants and the same atoms deleted and added at each determine a common transaction, and are linked, where no atom one requires at a participant the other forbids there (linked).  The contract being effective, every variable of an atom a schema requires or forbids is a variable of an atom it deletes or adds (local.glp), so matching the deleted and added atoms binds every variable of a schema-binding, and a variable left free, cmp_free, is never met: the clauses on it cover the type.  The class of a schema-binding is the schema-bindings a chain of links joins to it (class_mates); one that determines a transaction is of the class of an entry exactly when it is linked to one of the entry's schema-bindings (in_class).  The entry's parts are taken over it, the domain of each part being that of its schema-binding (part_dom).

%% in_class(Rs, B, Ps, Ps1, Q, Ms, R): whether the schema-binding of the role specifications Rs at the binding B, of the participants and atoms Ps, is of the class of an entry of the participants and atoms Ps1, the participants Q and the schema-bindings Ms.
procedure in_class(RoleSpecs?, Binding?, Deltas?, Deltas?, Peers?, Mates?, YesNo).
in_class(Rs, B, Ps, Ps1, Q, Ms, R?) :-
    deltas_eq(Ps?, Ps1?, E),
    in_class1(E?, Rs?, B?, Q?, Ms?, R).
procedure in_class1(YesNo?, RoleSpecs?, Binding?, Peers?, Mates?, YesNo).
in_class1(no, _, _, _, _, no).
in_class1(yes, Rs, B, Q, Ms, R?) :-
    reflexive_preds(Rf),
    linked_any(Ms?, Rs?, B?, Q?, Rf?, R).
procedure linked_any(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any([], _, _, _, _, no).
linked_any([mate(N, B2, _, _)|Ms], Rs, B, Q, Rf, L?) :-
    ground(Rs?), ground(B?), ground(B2?), ground(Q?), ground(Rf?) |
    bound_spec(N?, B2?, Rs2),
    linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L1),
    linked_any1(L1?, Ms?, Rs?, B?, Q?, Rf?, L).
procedure linked_any1(YesNo?, Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any1(yes, _, _, _, _, _, yes).
linked_any1(no, Ms, Rs, B, Q, Rf, L?) :- linked_any(Ms?, Rs?, B?, Q?, Rf?, L).

%% class_mates(Nm, B, Ms, Q, Rf, Cls): the class of the schema-binding of the schema Nm at the binding B among the schema-bindings Ms of its participants Q and its atoms, those a chain of links joins to it, in the order of Ms.
procedure class_mates(Constant?, Binding?, Mates?, Peers?, Preds?, Mates).
class_mates(Nm, B, Ms, Q, Rf, Cls?) :- ground(Nm?), ground(B?), ground(Ms?) |
    bound_spec(Nm?, B?, Rs),
    mate_of(yes, B?, Nm?, Rs?, M0),
    grow(M0?, Ms?, Q?, Rf?, [], In),
    keep_mates(Ms?, In?, Cls).
%% grow(Front, Rest, Q, Rf, Done, Out): Out is Done, Front and every schema-binding of Rest that a chain through those of Front reaches; one of Front is moved to Done once those of Rest linked to it have joined Front.
procedure grow(Mates?, Mates?, Peers?, Preds?, Mates?, Mates).
grow([], _, _, _, Done, Done?).
grow([mate(N, B, G, F)|Fs], Rest, Q, Rf, Done, Out?) :-
    ground(N?), ground(B?), ground(Rest?), ground(Q?), ground(Rf?) |
    bound_spec(N?, B?, Rs),
    split_linked(Rest?, Rs?, B?, Q?, Rf?, New, Keep),
    app(Fs?, New?, Fs1),
    grow(Fs1?, Keep?, Q?, Rf?, [mate(N?, B?, G?, F?)|Done?], Out).
procedure split_linked(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, Mates, Mates).
split_linked([], _, _, _, _, [], []).
split_linked([mate(N2, B2, G2, F2)|Ms], Rs, B, Q, Rf, New?, Keep?) :-
    ground(N2?), ground(B2?), ground(Rs?), ground(B?), ground(Q?), ground(Rf?) |
    bound_spec(N2?, B2?, Rs2),
    linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L),
    split_linked(Ms?, Rs?, B?, Q?, Rf?, New1, Keep1),
    split_one(L?, mate(N2?, B2?, G2?, F2?), New1?, Keep1?, New, Keep).
procedure split_one(YesNo?, Mate?, Mates?, Mates?, Mates, Mates).
split_one(yes, M, New, Keep, [M?|New?], Keep?).
split_one(no, M, New, Keep, New?, [M?|Keep?]).
procedure keep_mates(Mates?, Mates?, Mates).
keep_mates([], _, []).
keep_mates([M|Ms], In, R?) :- ground(M?), ground(In?) |
    mem(M?, In?, B),
    keep_mates(Ms?, In?, R1),
    keep_mate(B?, M?, R1?, R).
procedure keep_mate(YesNo?, Mate?, Mates?, Mates).
keep_mate(yes, M, R, [M?|R?]).
keep_mate(no, _, R, R?).

%% The schema-bindings Ms of the participants Q that determine a transaction.
procedure live_mates(Mates?, Peers?, Preds?, Mates).
live_mates([], _, _, []).
live_mates([mate(N, B, G, F)|Ms], Q, Rf, R?) :- ground(N?), ground(B?), ground(Q?), ground(Rf?) |
    bound_spec(N?, B?, Rs),
    live_at(Q?, Rs?, B?, Rf?, L0),
    con_live(N?, B?, Lc),
    and(L0?, Lc?, L),
    live_mates(Ms?, Q?, Rf?, R1),
    keep_mate(L?, mate(N?, B?, G?, F?), R1?, R).

%% live_at(Q, Rs, B, Rf, Ok): at each participant of Q, no atom both required and forbidden, and no atom of a reflexive predicate naming the participant forbidden.
procedure live_at(Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at([], _, _, _, yes).
live_at([P|Ps], Rs, B, Rf, Ok?) :- ground(P?), ground(Rs?), ground(B?), ground(Rf?) |
    reqs_at(Rs?, B?, P?, Rf?, R),
    forbs_at(Rs?, B?, P?, F),
    live_one(R?, F?, P?, Rf?, Ok1),
    live_at1(Ok1?, Ps?, Rs?, B?, Rf?, Ok).
procedure live_at1(YesNo?, Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at1(no, _, _, _, _, no).
live_at1(yes, Ps, Rs, B, Rf, Ok?) :- live_at(Ps?, Rs?, B?, Rf?, Ok).
procedure live_one(CAtoms?, CAtoms?, Peer?, Preds?, YesNo).
live_one(R, F, P, Rf, Ok?) :- ground(F?) |
    ms_meets(R?, F?, M1),
    own_reflexive_in(F?, P?, Rf?, M2),
    or(M1?, M2?, M),
    neg(M?, Ok).

%% linked(Q, Rs1, B1, Rs2, B2, Rf, L): whether two schema-bindings of the participants Q, of the same atoms deleted and added at each, are linked: no atom one requires at a participant the other forbids there.
procedure linked(Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked([], _, _, _, _, _, yes).
linked([P|Ps], Rs1, B1, Rs2, B2, Rf, L?) :-
    ground(P?), ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?) |
    reqs_at(Rs1?, B1?, P?, Rf?, R1),
    reqs_at(Rs2?, B2?, P?, Rf?, R2),
    forbs_at(Rs1?, B1?, P?, F1),
    forbs_at(Rs2?, B2?, P?, F2),
    bound_cs(R1?, Rb1),
    bound_cs(R2?, Rb2),
    ms_meets(Rb1?, F2?, C1),
    ms_meets(Rb2?, F1?, C2),
    or(C1?, C2?, C),
    linked1(C?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).
procedure linked1(YesNo?, Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked1(yes, _, _, _, _, _, _, no).
linked1(no, Ps, Rs1, B1, Rs2, B2, Rf, L?) :- linked(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

%% The atoms the roles sent to P require, less those of a reflexive predicate naming P, which hold at every person of that person (Section 5.4, the paragraph on act schemas); and those they forbid.
procedure reqs_at(RoleSpecs?, Binding?, Peer?, Preds?, CAtoms).
reqs_at(Rs, B, P, Rf, R?) :- ground(B?), ground(P?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    reqs_of(RsP?, Q),
    cimg_atoms(Q?, B?, R0),
    drop_own_reflexive(R0?, P?, Rf?, R).
procedure forbs_at(RoleSpecs?, Binding?, Peer?, CAtoms).
forbs_at(Rs, B, P, F?) :- ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    forbs_of(RsP?, Fs),
    cimg_atoms(Fs?, B?, F).
procedure forbs_of(RoleSpecs?, SAtoms).
forbs_of([], []).
forbs_of([R|Rs], F?) :- rs_forb(R?, F1), forbs_of(Rs?, F2), app(F1?, F2?, F).
procedure drop_own_reflexive(CAtoms?, Peer?, Preds?, CAtoms).
drop_own_reflexive([], _, _, []).
drop_own_reflexive([A|As], P, Rf, R?) :- ground(A?), ground(P?), ground(Rf?) |
    own_atom(A?, P?, Rf?, Own),
    drop_own_reflexive(As?, P?, Rf?, R1),
    keep_c(Own?, A?, R1?, R).
procedure own_reflexive_in(CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in([], _, _, no).
own_reflexive_in([A|As], P, Rf, B?) :- ground(P?), ground(Rf?) |
    own_atom(A?, P?, Rf?, B1),
    own_reflexive_in1(B1?, As?, P?, Rf?, B).
procedure own_reflexive_in1(YesNo?, CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in1(yes, _, _, _, yes).
own_reflexive_in1(no, As, P, Rf, B?) :- own_reflexive_in(As?, P?, Rf?, B).
%% An atom of a reflexive predicate naming P.
procedure own_atom(CAtom?, Peer?, Preds?, YesNo).
own_atom(cmp_atom(N, [cmp_val(p(Q))]), P, Rf, B?) :- Q? =?= P? | mem(N?, Rf?, B).
own_atom(_, _, _, no) :- otherwise | true.
procedure bound_cs(CAtoms?, CAtoms).
bound_cs([], []).
bound_cs([A|As], R?) :- ground(A?) |
    has_free(A?, Fr),
    bound_cs(As?, R1),
    keep_c(Fr?, A?, R1?, R).
procedure has_free(CAtom?, YesNo).
has_free(cmp_atom(_, Xs), B?) :- has_free1(Xs?, B).
procedure has_free1(CVals?, YesNo).
has_free1([], no).
has_free1([cmp_free(_)|_], yes).
has_free1([cmp_val(_)|Xs], B?) :- has_free1(Xs?, B).
%% keep_c(Drop?, A?, R?, R1): R with A in front, where A is not dropped.
procedure keep_c(YesNo?, CAtom?, CAtoms?, CAtoms).
keep_c(no, A, R, [A?|R?]).
keep_c(yes, _, R, R?).

%% The atoms of a schema-binding as compared (CAtom): a variable the binding leaves free stands for itself, cmp_free(V); a signed term sgn(y, i) for the speech act bound to y, signed by the person in role i (GSC, Definition "Binding").
procedure cimg_atoms(SAtoms?, Binding?, CAtoms).
cimg_atoms([], _, []).
cimg_atoms([A|As], B, Cs?) :- ground(B?) |
    cimg_one(A?, B?, C1),
    cimg_atoms(As?, B?, C2),
    app(C1?, C2?, Cs).
procedure cimg_one(SAtom?, Binding?, CAtoms).
cimg_one(atom(P, Vs), B, [cmp_atom(P?, Xs?)]) :- cimg_args(Vs?, B?, Xs).
cimg_one(times(V, A), B, Cs?) :- ground(B?) |
    num_of(V?, B?, K),
    cimg_one(A?, B?, C1),
    copies(K?, C1?, Cs).
procedure cimg_args(Vars?, Binding?, CVals).
cimg_args([], _, []).
cimg_args([sgn(Y, I)|Vs], B, [X?|Xs?]) :- ground(B?), ground(Y?), ground(I?) |
    lookup(svar(Y?), B?, F),
    role_person(I?, B?, P),
    cimg_sgn(F?, P?, sgn(Y?, I?), X),
    cimg_args(Vs?, B?, Xs).
cimg_args([num(X)|Vs], B, [cmp_val(n(N?))|Xs?]) :- integer(X?) | N := X?, cimg_args(Vs?, B?, Xs).
cimg_args([nterm(N)|Vs], B, [X?|Xs?]) :- ground(B?), ground(N?) |
    nt_vars(N?, Ws),
    vars_bound(Ws?, B?, Bd),
    cimg_name(Bd?, N?, B?, X),
    cimg_args(Vs?, B?, Xs).
cimg_args([V|Vs], B, [X?|Xs?]) :- otherwise, ground(B?), ground(V?) |
    lookup(V?, B?, F),
    cimg_val(F?, V?, X),
    cimg_args(Vs?, B?, Xs).
procedure cimg_val(Found?, Var?, CVal).
cimg_val(found(X), _, cmp_val(X?)).
cimg_val(free, V, cmp_free(V?)).
procedure cimg_name(YesNo?, NTerm?, Binding?, CVal).
cimg_name(yes, N, B, cmp_val(c(C?))) :- nt_img(N?, B?, C).
cimg_name(no, N, _, cmp_free(nterm(N?))).
procedure cimg_sgn(Found?, Peer?, Var?, CVal).
cimg_sgn(found(s(S)), P, _, cmp_val(s(speech(S?, P?)))).
cimg_sgn(_, _, V, cmp_free(V?)) :- otherwise | true.

%% ===========================================================================
%% Atoms, bindings and matching
%% ===========================================================================

%% The roles of a schema-binding, each with its atoms: those of the schema, and, for a schema with listed roles, each listed role's place bound to the base person with no atom, and one role more for each person of the list of each listed role, of that listed role's atoms, the roles after its own, the lists in the order of the roles.
procedure bound_spec(Constant?, Binding?, RoleSpecs).
bound_spec(Nm, B, Rs?) :- schema_entry(Nm?, E), bound_spec1(E?, B?, Rs).
procedure bound_spec1(Schema?, Binding?, RoleSpecs).
bound_spec1(schema(_, _, Rs), _, Rs?).
bound_spec1(lschema(_, _, Rs, Lsts), B, Rs1?) :- ground(Rs?), ground(B?), ground(Lsts?) |
    lists_of(Lsts?, B?, Ls),
    spec_for(Rs?, Lsts?, Ls?, Rs1).
%% The lists of the people of a schema-binding's listed roles, in the order of the roles.
procedure lists_of(Listings?, Binding?, PeerLists).
lists_of([], _, []).
lists_of([listing(I, _, _, _)|Lsts], B, [L?|Ls?]) :- ground(B?) |
    copies_of(B?, I?, L),
    lists_of(Lsts?, B?, Ls).
%% The roles of the schema, each listed role's place blanked, and then, for each listed role in the order of the roles, a copy of it for each person of its list.
procedure spec_for(RoleSpecs?, Listings?, PeerLists?, RoleSpecs).
spec_for(Rs, Lsts, Ls, Rs1?) :- ground(Rs?), ground(Lsts?) |
    blank_listed(Lsts?, Rs?, Rs0),
    listed_copies(Lsts?, Ls?, Rs?, Cs),
    app(Rs0?, Cs?, Rs1).
procedure blank_listed(Listings?, RoleSpecs?, RoleSpecs).
blank_listed([], Rs, Rs?).
blank_listed([listing(I, _, _, _)|Lsts], Rs, Rs2?) :-
    blank_at(Rs?, I?, 1, Rs1),
    blank_listed(Lsts?, Rs1?, Rs2).
procedure listed_copies(Listings?, PeerLists?, RoleSpecs?, RoleSpecs).
listed_copies([], _, _, []).
listed_copies([listing(I, _, _, _)|Lsts], [L|Ls], Rs, Cs?) :- ground(Rs?) |
    nth_spec(Rs?, I?, R),
    spec_copies(L?, R?, C1),
    listed_copies(Lsts?, Ls?, Rs?, C2),
    app(C1?, C2?, Cs).
listed_copies([_|_], [], _, []).
procedure blank_at(RoleSpecs?, Integer?, Integer?, RoleSpecs).
blank_at([], _, _, []).
blank_at([R|Rs], I, J, [X?|Xs?]) :- integer(I?), integer(J?) |
    blank_one(I?, J?, R?, X),
    J1 := J? + 1,
    blank_at(Rs?, I?, J1?, Xs).
procedure blank_one(Integer?, Integer?, RoleSpec?, RoleSpec).
blank_one(I, J, _, rs(unguarded, [], [], [], [])) :- I? =:= J? | true.
blank_one(_, _, R, R?) :- otherwise | true.
procedure spec_copies(Peers?, RoleSpec?, RoleSpecs).
spec_copies([], _, []).
spec_copies([_|Ps], R, [R?|Rs?]) :- ground(R?) | spec_copies(Ps?, R?, Rs).
%% The people of the listed role of index I at a schema-binding B, those B binds to role(-I), in the order of identifiers, its place in the class term (class_of).
procedure copies_of(Binding?, Integer?, List(Peer)).
copies_of(B, I, L?) :- ground(B?), integer(I?) |
    NI := 0 - I?,
    neg_people(B?, NI?, Ps0),
    sort_peers(Ps0?, Ps1),
    dedup(Ps1?, L).
procedure neg_people(Binding?, Integer?, Peers).
neg_people([], _, []).
neg_people([b(role(J), p(Q))|Bs], NI, [Q?|Ps?]) :- J? =:= NI? | neg_people(Bs?, NI?, Ps).
neg_people([_|Bs], NI, Ps?) :- otherwise | neg_people(Bs?, NI?, Ps).
%% The binding of a class term of a schema with listed roles: the binding B0 of its other roles and its variables; each listed role's place bound to the base person; and, for the lists Ls of the people of the listed roles, in the order of the roles, a role after the schema's own for each person of each list, in the order of identifiers, and the entries naming the people of each listed role (tuple_binds).
procedure listed_binding(Constant?, Binding?, PeerLists?, Binding).
listed_binding(Nm, B0, Ls, B?) :- schema_entry(Nm?, E), listed_binding1(E?, B0?, Ls?, B).
procedure listed_binding1(Schema?, Binding?, PeerLists?, Binding).
listed_binding1(schema(_, _, _), B0, _, B0?).
listed_binding1(lschema(_, _, Rs, Lsts), B0, Ls, B?) :- ground(Rs?), ground(B0?), ground(Lsts?) |
    rs_len(Rs?, K),
    base_binds(Lsts?, B0?, Bb),
    sorted_lists(Ls?, Ls1),
    K1 := K? + 1,
    tuple_binds(Lsts?, Ls1?, K1?, Cs),
    app(Bb?, Cs?, Bc),
    app(B0?, Bc?, B).
%% Each listed role's place bound to its base person.
procedure base_binds(Listings?, Binding?, Binding).
base_binds([], _, []).
base_binds([listing(I, Bi, _, _)|Lsts], B0, [b(role(I?), p(P?))|Bs?]) :- ground(B0?) |
    role_person(Bi?, B0?, P),
    base_binds(Lsts?, B0?, Bs).
procedure sorted_lists(PeerLists?, PeerLists).
sorted_lists([], []).
sorted_lists([L|Ls], [L1?|Ls1?]) :-
    sort_peers(L?, L0),
    dedup(L0?, L1),
    sorted_lists(Ls?, Ls1).
%% For the lists Ls of the people of the listed roles Lsts, in the order of the roles: the roles of index J, J+1, ..., one for each person of each list, the first list first, and the entries b(role(-I), p(Q)) naming the people Q of the listed role of index I.
procedure tuple_binds(Listings?, PeerLists?, Integer?, Binding).
tuple_binds([], _, _, []).
tuple_binds([listing(I, _, _, _)|Lsts], [L|Ls], J, Bs?) :- ground(L?), integer(I?) |
    copy_binds(L?, J?, Cs, J1),
    NI := 0 - I?,
    neg_binds(L?, NI?, Ns),
    tuple_binds(Lsts?, Ls?, J1?, Bs1),
    app(Ns?, Bs1?, Bs2),
    app(Cs?, Bs2?, Bs).
tuple_binds([_|_], [], _, []).
procedure copy_binds(Peers?, Integer?, Binding, Integer).
copy_binds([], J, [], J?).
copy_binds([Q|Qs], J, [b(role(J?), p(Q?))|Bs?], J2?) :- integer(J?) | J1 := J? + 1, copy_binds(Qs?, J1?, Bs, J2).
procedure neg_binds(Peers?, Integer?, Binding).
neg_binds([], _, []).
neg_binds([Q|Qs], NI, [b(role(NI?), p(Q?))|Bs?]) :- integer(NI?) | neg_binds(Qs?, NI?, Bs).
%% The people of each listed role at the state S of its base person, in the order of the roles: the persons q with rho(q, u_2, ..., u_r) in S, u_2, ..., u_r as the binding B0 binds them, in the order of identifiers (vGLP c649c0d, Section 5.4, "Act schemas as local specifications").
procedure listed_people(Constant?, Binding?, GAtoms?, PeerLists).
listed_people(Nm, B0, S, Ls?) :- schema_entry(Nm?, E), listed_people1(E?, B0?, S?, Ls).
procedure listed_people1(Schema?, Binding?, GAtoms?, PeerLists).
listed_people1(schema(_, _, _), _, _, []).
listed_people1(lschema(_, _, _, Lsts), B0, S, Ls?) :- lists_at(Lsts?, B0?, S?, Ls).
procedure lists_at(Listings?, Binding?, GAtoms?, PeerLists).
lists_at([], _, _, []).
lists_at([listing(_, _, Rho, As)|Lsts], B0, S, [L?|Ls?]) :- ground(B0?), ground(S?) |
    list_at(Rho?, As?, B0?, S?, L),
    lists_at(Lsts?, B0?, S?, Ls).
procedure list_at(Constant?, Vars?, Binding?, GAtoms?, List(Peer)).
list_at(Rho, As, B0, S, L?) :- ground(As?), ground(B0?), ground(S?) |
    img_args(As?, B0?, Vs),
    listing_in(S?, Rho?, Vs?, Ps0),
    sort_peers(Ps0?, Ps1),
    dedup(Ps1?, L).
procedure listing_in(GAtoms?, Constant?, Vals?, Peers).
listing_in([], _, _, []).
listing_in([g(F, [p(Q)|Xs])|Gs], Rho, Vs, Ps?) :- ground(F?), ground(Xs?), ground(Rho?), ground(Vs?) |
    same(F?, Rho?, E1),
    same(Xs?, Vs?, E2),
    and(E1?, E2?, E),
    listing_in(Gs?, Rho?, Vs?, Ps1),
    keep_peer(E?, Q?, Ps1?, Ps).
listing_in([_|Gs], Rho, Vs, Ps?) :- otherwise | listing_in(Gs?, Rho?, Vs?, Ps).
%% The class term a request name of a schema with listed roles names at an agent of the state S: the binding B0 of the name, and the people its state lists at the place of each listed role, "so the base agent of close completes L from its listed atoms" (vGLP #15 Cowork to Code, 2026-10-19 14:24 UTC, item 2), "the base agent filling in each from its own listed atoms" (vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC).
procedure listed_class(Constant?, Binding?, GAtoms?, Class).
listed_class(Nm, B0, S, C?) :- ground(Nm?), ground(B0?) |
    listed_people(Nm?, B0?, S?, Ls),
    listed_binding(Nm?, B0?, Ls?, B),
    role_person(1, B0?, D),
    class_of(Nm?, B?, D?, C).
%% For the person p in the base of each listed role, the domain of the effect asks besides the atoms that "p lists in d_p exactly the people of that role in L" (vGLP c649c0d, Section 5.4, "Act schemas as local specifications").
procedure listing_ok(Constant?, Binding?, Peer?, GAtoms?, YesNo).
listing_ok(Nm, B, Id, S, Ok?) :- schema_entry(Nm?, E), listing_ok1(E?, B?, Id?, S?, Ok).
procedure listing_ok1(Schema?, Binding?, Peer?, GAtoms?, YesNo).
listing_ok1(schema(_, _, _), _, _, _, yes).
listing_ok1(lschema(_, _, _, Lsts), B, Id, S, Ok?) :- listings_ok(Lsts?, B?, Id?, S?, Ok).
procedure listings_ok(Listings?, Binding?, Peer?, GAtoms?, YesNo).
listings_ok([], _, _, _, yes).
listings_ok([listing(I, Bi, Rho, As)|Lsts], B, Id, S, Ok?) :- ground(B?), ground(Id?), ground(S?) |
    role_person(Bi?, B?, P),
    same(P?, Id?, Base),
    listing_one(Base?, I?, Rho?, As?, B?, S?, Ok1),
    listings_ok1(Ok1?, Lsts?, B?, Id?, S?, Ok).
procedure listing_one(YesNo?, Integer?, Constant?, Vars?, Binding?, GAtoms?, YesNo).
listing_one(no, _, _, _, _, _, yes).
listing_one(yes, I, Rho, As, B, S, Ok?) :- ground(B?) |
    copies_of(B?, I?, L),
    list_at(Rho?, As?, B?, S?, L1),
    same(L?, L1?, Ok).
procedure listings_ok1(YesNo?, Listings?, Binding?, Peer?, GAtoms?, YesNo).
listings_ok1(no, _, _, _, _, no).
listings_ok1(yes, Lsts, B, Id, S, Ok?) :- listings_ok(Lsts?, B?, Id?, S?, Ok).
%% The roles Definition "Binding" constrains (rule_ok): the schema's own, each listed role's place with no atom, a listed role's people being no roles a binding sends to people.
procedure rule_spec_ok(Constant?, Binding?, YesNo).
rule_spec_ok(Nm, B, Ok?) :- schema_entry(Nm?, E), rule_spec(E?, Rs0), rule_ok(Rs0?, B?, Ok).
procedure rule_spec(Schema?, RoleSpecs).
rule_spec(schema(_, _, Rs), Rs?).
rule_spec(lschema(_, _, Rs, Lsts), Rs0?) :- blank_listed(Lsts?, Rs?, Rs0).
%% A class term's schema, its roles with their atoms and its binding.
procedure term_spec(Class?, Constant, RoleSpecs, Binding).
term_spec(C, Nm?, Rs?, B?) :- ground(C?) |
    binding_of(C?, Nm0, B0),
    term_spec1(Nm0?, B0?, Nm, Rs, B).
procedure term_spec1(Constant?, Binding?, Constant, RoleSpecs, Binding).
term_spec1(Nm0, B0, Nm0?, Rs?, B0?) :- ground(Nm0?), ground(B0?) | bound_spec(Nm0?, B0?, Rs).
procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R|_], I, R?) :- I? =:= 1 | true.
nth_spec([_|Rs], I, R?) :- I? > 1 | I1 := I? - 1, nth_spec(Rs?, I1?, R).
procedure rs_len(RoleSpecs?, Integer).
rs_len([], 0).
rs_len([_|Rs], N?) :- rs_len(Rs?, M), N := M? + 1.
procedure rs_add(RoleSpec?, SAtoms).
rs_add(rs(_, A, _, _, _), A?).
procedure rs_del(RoleSpec?, SAtoms).
rs_del(rs(_, _, D, _, _), D?).
procedure rs_req(RoleSpec?, SAtoms).
rs_req(rs(_, _, D, K, _), R?) :- app(K?, D?, R).
procedure rs_forb(RoleSpec?, SAtoms).
rs_forb(rs(_, _, _, _, F), F?).

procedure role_person(Integer?, Binding?, Peer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), found_peer(F?, P).
procedure found_peer(Found?, Peer).
found_peer(found(p(P)), P?).
found_peer(found(s(_)), unbound).
found_peer(found(c(_)), unbound).
found_peer(found(n(_)), unbound).
found_peer(found(lv(_, _)), unbound).
found_peer(free, unbound).
procedure lookup(Var?, Binding?, Found).
lookup(_, [], free).
lookup(V, [b(W, X)|_], found(X?)) :- V? =?= W? | true.
lookup(V, [_|Bs], F?) :- otherwise | lookup(V?, Bs?, F).
%% The atoms under a binding, a multiplicity k giving k copies of its atom (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "a multiplicity k deleting or adding k copies"); a multiplicity no number is bound to, a variable a binding leaves free, gives one, and is met only where a class's atoms are matched (count_bind).
procedure img_atoms(SAtoms?, Binding?, GAtoms).
img_atoms([], _, []).
img_atoms([A|As], B, Gs?) :- ground(B?) |
    img_one(A?, B?, G1),
    img_atoms(As?, B?, G2),
    app(G1?, G2?, Gs).
procedure img_one(SAtom?, Binding?, GAtoms).
img_one(atom(P, Vs), B, [g(P?, Xs?)]) :- img_args(Vs?, B?, Xs).
img_one(times(V, A), B, Gs?) :- ground(B?) |
    num_of(V?, B?, K),
    img_one(A?, B?, G1),
    copies(K?, G1?, Gs).
procedure(X) copies(NumRes?, Stream(X)?, Stream(X)).
copies(num_is(K), G, Gs?) :- K? > 0, ground(G?) |
    K1 := K? - 1,
    copies(num_is(K1?), G?, Gs1),
    app(G?, Gs1?, Gs).
copies(num_is(K), _, []) :- K? =< 0 | true.
copies(no_num, G, G?).
procedure img_atom(SAtom?, Binding?, GAtom).
img_atom(atom(P, Vs), B, g(P?, Xs?)) :- img_args(Vs?, B?, Xs).
img_atom(times(_, A), B, G?) :- img_atom(A?, B?, G).
procedure img_args(Vars?, Binding?, Vals).
img_args([], _, []).
img_args([sgn(Y, I)|Vs], B, [X?|Xs?]) :- ground(B?), ground(Y?), ground(I?) |
    lookup(svar(Y?), B?, F),
    role_person(I?, B?, P),
    img_sgn(F?, P?, X),
    img_args(Vs?, B?, Xs).
img_args([nterm(N)|Vs], B, [c(C?)|Xs?]) :- ground(B?), ground(N?) |
    nt_img(N?, B?, C),
    img_args(Vs?, B?, Xs).
img_args([num(X)|Vs], B, [n(N?)|Xs?]) :- integer(X?) | N := X?, img_args(Vs?, B?, Xs).
img_args([V|Vs], B, [X?|Xs?]) :- otherwise, ground(B?) |
    lookup(V?, B?, F),
    img_val(F?, X),
    img_args(Vs?, B?, Xs).
%% The community name a name term denotes at a binding (vGLP c649c0d, Section 5.4, "Act schemas as local specifications").
procedure nt_img(NTerm?, Binding?, CName).
nt_img(own(I), B, community(P?)) :- role_person(I?, B?, P).
nt_img(own_var(X), B, community(P?)) :- val_peer(pvar(X?), B?, unbound, P).
nt_img(ext(N, Y), B, dot(C?, S?)) :- ground(B?) |
    nt_img(N?, B?, C),
    val_speech(svar(Y?), B?, unbound, S).
%% The variables of a name term: its base, a role or an agent variable, and its speech-act variables; "a variable inside a name term counts" for effectiveness, as one inside a signed term does (vGLP c649c0d, Section 5.4).
procedure nt_vars(NTerm?, Vars).
nt_vars(own(I), [role(I?)]).
nt_vars(own_var(X), [pvar(X?)]).
nt_vars(ext(N, Y), Vs?) :- nt_vars(N?, Vs0), app(Vs0?, [svar(Y?)], Vs).
%% The arguments with each name term taken as its variables.
procedure flat_names(Vars?, Vars).
flat_names([], []).
flat_names([nterm(N)|Vs], R?) :- nt_vars(N?, Ws), flat_names(Vs?, R1), app(Ws?, R1?, R).
flat_names([V|Vs], [V?|R?]) :- otherwise | flat_names(Vs?, R).
procedure img_val(Found?, Val).
img_val(found(X), X?).
img_val(free, p(unbound)).
%% The image of a signed term sgn(y, i): the speech act bound to y, signed by
%% the person in role i (GSC, Definition "Binding": beta(sgn(y, pi)) :=
%% (beta(y), beta(pi))).  A signed term occurs only in an added atom (GSC,
%% Definition "Act schema"), whose matching binds y to a speech act, so the
%% second clause, a free variable's image as img_val gives it, covers the type
%% and is never reached.
procedure img_sgn(Found?, Peer?, Val).
img_sgn(found(s(S)), P, s(speech(S?, P?))).
img_sgn(_, _, p(unbound)) :- otherwise | true.
procedure atom_bound(SAtom?, Binding?, YesNo).
atom_bound(atom(_, Vs), B, R?) :- vars_bound(Vs?, B?, R).
atom_bound(times(_, A), B, R?) :- atom_bound(A?, B?, R).
procedure vars_bound(Vars?, Binding?, YesNo).
vars_bound([], _, yes).
vars_bound([num(X)|Vs], B, R?) :- integer(X?) | vars_bound(Vs?, B?, R).
vars_bound([nterm(N)|Vs], B, R?) :- ground(N?) |
    nt_vars(N?, Ws),
    app(Ws?, Vs?, Vs1),
    vars_bound(Vs1?, B?, R).
vars_bound([V|Vs], B, R?) :- otherwise, ground(B?) |
    lookup(V?, B?, F),
    vars_bound1(F?, Vs?, B?, R).
procedure vars_bound1(Found?, Vars?, Binding?, YesNo).
vars_bound1(free, _, _, no).
vars_bound1(found(_), Vs, B, R?) :- vars_bound(Vs?, B?, R).

%% The bindings extending B under which every atom of As is one of Gs.
procedure match_all(SAtoms?, GAtoms?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A|As], Gs, B, R?) :- ground(Gs?) |
    match_into(A?, Gs?, B?, Bs),
    match_all_each(Bs?, As?, Gs?, R).
procedure match_all_each(Bindings?, SAtoms?, GAtoms?, Bindings).
match_all_each([], _, _, []).
match_all_each([B|Bs], As, Gs, R?) :- ground(As?), ground(Gs?) |
    match_all(As?, Gs?, B?, R1),
    match_all_each(Bs?, As?, Gs?, R2),
    app(R1?, R2?, R).
procedure match_into(SAtom?, GAtoms?, Binding?, Bindings).
match_into(times(V, A), Gs, B, R?) :- ground(V?), ground(A?), ground(Gs?), ground(B?) |
    match_into(A?, Gs?, B?, Bs),
    count_bind(Bs?, V?, A?, Gs?, R).
match_into(_, [], _, []).
match_into(A, [G|Gs], B, R?) :- ground(A?), ground(B?) |
    match_atom(A?, G?, B?, M),
    match_into1(M?, A?, Gs?, B?, R).
procedure match_into1(Match?, SAtom?, GAtoms?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1?|R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).
procedure match_atom(SAtom?, GAtom?, Binding?, Match).
match_atom(atom(P, Vs), g(Q, Xs), B, R?) :- P? =?= Q? | match_args(Vs?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.
procedure match_args(Vars?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_|_], _, nomatch).
match_args([_|_], [], _, nomatch).
%% A signed term sgn(y, i) matches a speech act whose utterance is a speech
%% act, y matching that speech act and role i its signer (GSC, Definition
%% "Binding": beta(sgn(y, pi)) := (beta(y), beta(pi))); an utterance signed
%% once, or a person, it does not match.
match_args([sgn(Y, I)|Vs], [X|Xs], B, R?) :- ground(Y?), ground(I?), ground(X?), ground(B?) |
    sgn_parts(X?, Ps),
    match_sgn(Ps?, Y?, I?, Vs?, Xs?, B?, R).
%% A name term matches a community name of its form, its base its person and each speech-act variable its speech act.
match_args([nterm(N)|Vs], [X|Xs], B, R?) :- ground(N?), ground(X?), ground(B?) |
    name_parts(N?, X?, Ps),
    match_name(Ps?, Vs?, Xs?, B?, R).
match_args([num(X)|Vs], [Y|Ys], B, R?) :- integer(X?), ground(Y?), ground(B?) |
    lit_val(X?, Y?, E),
    lit_then(E?, Vs?, Ys?, B?, R).
match_args([V|Vs], [X|Xs], B, R?) :- otherwise, ground(V?), ground(X?), ground(B?) |
    lookup(V?, B?, F),
    kind_ok(V?, X?, K),
    match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).
%% A number in an atom of a schema matches that number.
procedure lit_val(Integer?, Val?, YesNo).
lit_val(X, n(K), yes) :- X? =:= K? | true.
lit_val(_, _, no) :- otherwise | true.
procedure lit_then(YesNo?, Vars?, Vals?, Binding?, Match).
lit_then(yes, Vs, Ys, B, R?) :- match_args(Vs?, Ys?, B?, R).
lit_then(no, _, _, _, nomatch).
%% An atom with a multiplicity k matched with the atoms Gs: where no number is bound to k, k is bound to the number of copies of its atom in Gs, which are its copies there (count_g).
procedure count_bind(Bindings?, Var?, SAtom?, GAtoms?, Bindings).
count_bind([], _, _, _, []).
count_bind([B|Bs], V, A, Gs, [B1?|R?]) :- ground(B?), ground(V?), ground(A?), ground(Gs?) |
    num_of(V?, B?, K),
    count_bind1(K?, V?, A?, Gs?, B?, B1),
    count_bind(Bs?, V?, A?, Gs?, R).
procedure count_bind1(NumRes?, Var?, SAtom?, GAtoms?, Binding?, Binding).
count_bind1(num_is(_), _, _, _, B, B?).
count_bind1(no_num, V, A, Gs, B, [b(V?, n(N?))|B?]) :- ground(B?), ground(V?) |
    img_atom(A?, B?, G),
    count_g(G?, Gs?, N).
procedure count_g(GAtom?, GAtoms?, Integer).
count_g(_, [], 0).
count_g(G, [H|Hs], N?) :- G? =?= H? | count_g(G?, Hs?, M), N := M? + 1.
count_g(G, [_|Hs], N?) :- otherwise | count_g(G?, Hs?, N).
procedure name_parts(NTerm?, Val?, NameParts).
name_parts(N, c(C), Ps?) :- nt_parts(N?, C?, Ps).
name_parts(_, p(_), noparts).
name_parts(_, s(_), noparts).
name_parts(_, n(_), noparts).
name_parts(_, lv(_, _), noparts).
procedure nt_parts(NTerm?, CName?, NameParts).
nt_parts(own(I), community(P), parts([role(I?)], [p(P?)])).
nt_parts(own_var(X), community(P), parts([pvar(X?)], [p(P?)])).
nt_parts(ext(N, Y), dot(C, S), Ps?) :- nt_parts(N?, C?, Ps0), nt_more(Ps0?, Y?, S?, Ps).
nt_parts(_, _, noparts) :- otherwise | true.
procedure nt_more(NameParts?, Constant?, Speech?, NameParts).
nt_more(parts(Vs, Xs), Y, S, parts(Vs1?, Xs1?)) :- app(Vs?, [svar(Y?)], Vs1), app(Xs?, [s(S?)], Xs1).
nt_more(noparts, _, _, noparts).
procedure match_name(NameParts?, Vars?, Vals?, Binding?, Match).
match_name(parts(Ws, Ys), Vs, Xs, B, R?) :- app(Ws?, Vs?, Vs1), app(Ys?, Xs?, Xs1), match_args(Vs1?, Xs1?, B?, R).
match_name(noparts, _, _, _, nomatch).
procedure sgn_parts(Val?, SgnParts).
sgn_parts(s(speech(speech(U, Q), P)), signed(s(speech(U?, Q?)), P?)).
sgn_parts(s(speech(utterance(_), _)), unsigned).
sgn_parts(p(_), unsigned).
sgn_parts(c(_), unsigned).
sgn_parts(n(_), unsigned).
sgn_parts(lv(_, _), unsigned).
procedure match_sgn(SgnParts?, Constant?, Integer?, Vars?, Vals?, Binding?, Match).
match_sgn(signed(S, P), Y, I, Vs, Xs, B, R?) :-
    match_args([svar(Y?), role(I?)|Vs?], [S?, p(P?)|Xs?], B?, R).
match_sgn(unsigned, _, _, _, _, _, nomatch).
procedure match_one(Found?, YesNo?, Var?, Val?, Vars?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- W? =?= X? | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(free, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [b(V?, X?)|B?], R).
match_one(free, no, _, _, _, _, _, nomatch).
procedure kind_ok(Var?, Val?, YesNo).
kind_ok(role(_), p(_), yes).
kind_ok(role(_), s(_), no).
kind_ok(pvar(_), p(_), yes).
kind_ok(pvar(_), s(_), no).
kind_ok(svar(_), p(_), no).
kind_ok(svar(_), s(_), yes).
%% A signed term is matched by its parts (match_sgn); the clauses cover the type.
kind_ok(sgn(_, _), p(_), no).
kind_ok(sgn(_, _), s(_), no).
%% A name term is matched by its parts (match_name), and a community name matches no variable; the clauses cover the type.
kind_ok(sgn(_, _), c(_), no).
kind_ok(nterm(_), _, no).
kind_ok(role(_), c(_), no).
kind_ok(pvar(_), c(_), no).
kind_ok(svar(_), c(_), no).
%% A numeric variable matches a number, and lv(S, X), which a schema-binding gives a variable local to a role (local_norm); and nothing else matches either.
kind_ok(num(_), n(_), yes).
kind_ok(num(_), lv(_, _), yes).
kind_ok(num(_), p(_), no).
kind_ok(num(_), s(_), no).
kind_ok(num(_), c(_), no).
kind_ok(role(_), n(_), no).
kind_ok(role(_), lv(_, _), no).
kind_ok(pvar(_), n(_), no).
kind_ok(pvar(_), lv(_, _), no).
kind_ok(svar(_), n(_), no).
kind_ok(svar(_), lv(_, _), no).
kind_ok(sgn(_, _), n(_), no).
kind_ok(sgn(_, _), lv(_, _), no).

%% The value a binding gives a variable, the agent's own name for one it
%% leaves free.
procedure val_peer(Var?, Binding?, Peer?, Peer).
val_peer(V, B, D, P?) :- lookup(V?, B?, F), val_peer1(F?, D?, P).
procedure val_peer1(Found?, Peer?, Peer).
val_peer1(found(p(P)), _, P?).
val_peer1(found(s(_)), D, D?).
val_peer1(found(c(_)), D, D?).
val_peer1(found(n(_)), D, D?).
val_peer1(found(lv(_, _)), D, D?).
val_peer1(free, D, D?).
procedure val_speech(Var?, Binding?, Peer?, Speech).
val_speech(V, B, D, S?) :- lookup(V?, B?, F), val_speech1(F?, D?, S).
procedure val_speech1(Found?, Peer?, Speech).
val_speech1(found(s(S)), _, S?).
val_speech1(found(p(_)), D, speech(utterance(none), D?)).
val_speech1(found(c(_)), D, speech(utterance(none), D?)).
val_speech1(found(n(_)), D, speech(utterance(none), D?)).
val_speech1(found(lv(_, _)), D, speech(utterance(none), D?)).
val_speech1(free, D, speech(utterance(none), D?)).

%% ===========================================================================
%% Numbers (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications")
%% ===========================================================================

%% The number a binding gives a numeric argument: the number itself, n(K) bound to the variable, or none.
procedure num_of(Var?, Binding?, NumRes).
num_of(num(X), _, num_is(N?)) :- integer(X?) | N := X?.
num_of(V, B, R?) :- otherwise, ground(B?) | lookup(V?, B?, F), num_found(F?, R).
procedure num_found(Found?, NumRes).
num_found(found(n(K)), num_is(K?)).
num_found(found(p(_)), no_num).
num_found(found(s(_)), no_num).
num_found(found(c(_)), no_num).
num_found(found(lv(_, _)), no_num).
num_found(free, no_num).
%% The number of a numeric variable of a class term, written in the term (class_of); 0 where none is bound, which a schema-binding of a class never leaves.
procedure val_num(Var?, Binding?, Integer).
val_num(V, B, K?) :- num_of(V?, B?, R), num_val(R?, K).
procedure num_val(NumRes?, Integer).
num_val(num_is(K), K?).
num_val(no_num, 0).
%% Whether the constraint holds under the binding, every number it names bound: and(C1, C2), C1 and C2; eq(X, Y), X = Y; le(X, Y), X =< Y; lt(X, Y), X < Y; ge(X, Y), X >= Y; gt(X, Y), X > Y; succ(X, Y), Y = X + 1; or(C1, C2), C1 or C2, X and Y the values of the expressions under the binding.  A number not bound makes a comparison false.
procedure con_holds(Constraint?, Binding?, YesNo).
con_holds(true, _, yes).
con_holds(and(C1, C2), B, R?) :- ground(B?) | con_holds(C1?, B?, R1), con_holds(C2?, B?, R2), and(R1?, R2?, R).
con_holds(eq(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_eq(A?, C?, R).
con_holds(le(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_le(A?, C?, R).
con_holds(lt(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_gt(C?, A?, R).
con_holds(ge(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_le(C?, A?, R).
con_holds(gt(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_gt(A?, C?, R).
con_holds(succ(X, Y), B, R?) :- ground(B?) | num_of(X?, B?, A), num_of(Y?, B?, C), num_succ(A?, C?, R).
con_holds(or(C1, C2), B, R?) :- ground(B?) | con_holds(C1?, B?, R1), con_holds(C2?, B?, R2), or(R1?, R2?, R).
%% The value of an expression under the binding, num_is(K), or no_num where a number it names is not bound.
procedure expr_val(Expr?, Binding?, NumRes).
expr_val(plus(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(plus, A?, C?, R).
expr_val(minus(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(minus, A?, C?, R).
expr_val(mul(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(mul, A?, C?, R).
expr_val(num(X), B, R?) :- ground(B?) | num_of(num(X?), B?, R).
expr_val(role(_), _, no_num).
expr_val(pvar(_), _, no_num).
expr_val(svar(_), _, no_num).
expr_val(sgn(_, _), _, no_num).
expr_val(nterm(_), _, no_num).
procedure num_op(Constant?, NumRes?, NumRes?, NumRes).
num_op(plus, num_is(A), num_is(C), num_is(K?)) :- integer(A?), integer(C?) | K := A? + C?.
num_op(minus, num_is(A), num_is(C), num_is(K?)) :- integer(A?), integer(C?) | K := A? - C?.
num_op(mul, num_is(A), num_is(C), num_is(K?)) :- integer(A?), integer(C?) | K := A? * C?.
num_op(_, _, _, no_num) :- otherwise | true.
procedure num_eq(NumRes?, NumRes?, YesNo).
num_eq(num_is(A), num_is(C), yes) :- A? =:= C? | true.
num_eq(_, _, no) :- otherwise | true.
procedure num_gt(NumRes?, NumRes?, YesNo).
num_gt(num_is(A), num_is(C), yes) :- A? > C? | true.
num_gt(_, _, no) :- otherwise | true.
procedure num_le(NumRes?, NumRes?, YesNo).
num_le(num_is(A), num_is(C), yes) :- A? =< C? | true.
num_le(_, _, no) :- otherwise | true.
procedure num_succ(NumRes?, NumRes?, YesNo).
num_succ(num_is(A), num_is(C), R?) :- integer(A?), integer(C?) | A1 := A? + 1, same_int(A1?, C?, R).
num_succ(_, _, no) :- otherwise | true.
%% The constraint the agent Id checks for the schema-binding B: "a constraint is local to the role whose local variables it names, and to every role where it names none, which each checks" (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications"): the constraint where it is local to every role, or to a role sent to Id, and true otherwise.
procedure con_at(Constant?, Binding?, Peer?, Constraint).
con_at(Nm, B, Id, C?) :- ground(Nm?), ground(B?) |
    schema_numeric(Nm?, N),
    con_at0(N?, B?, Id?, C).
procedure con_at0(Numeric?, Binding?, Peer?, Constraint).
con_at0(numeric(C, _, every), _, _, C?).
con_at0(numeric(C, _, at(I)), B, Id, C1?) :- ground(B?) |
    role_person(I?, B?, P),
    same(P?, Id?, Me),
    con_if(Me?, C?, C1).
procedure con_if(YesNo?, Constraint?, Constraint).
con_if(yes, C, C?).
con_if(no, _, true).
%% Whether the schema-binding B can hold its constraint: where the constraint names no variable local to a role, every number it names is bound by B, and it holds under B or the schema-binding determines no transaction; where it names some, a state binds them, and that is asked of the state (dom_bindings).
procedure con_live(Constant?, Binding?, YesNo).
con_live(Nm, B, V?) :- ground(Nm?) | schema_numeric(Nm?, N), con_live1(N?, B?, V).
procedure con_live1(Numeric?, Binding?, YesNo).
con_live1(numeric(C, _, every), B, V?) :- con_holds(C?, B?, V).
con_live1(numeric(_, _, at(_)), _, yes).
%% The binding less the values lv(S, X) of the variables local to a role, which the state binds (dom_bindings).
procedure unlocal(Binding?, Binding).
unlocal([], []).
unlocal([b(_, lv(_, _))|Bs], R?) :- unlocal(Bs?, R).
unlocal([E|Bs], [E?|R?]) :- otherwise | unlocal(Bs?, R).
%% The bindings extending B by the numbers the constraint gives the numeric variables B leaves free once those it binds are bound, taken again on each extension until it binds no variable more: succ(X, Y) gives Y = X + 1 where X is bound and Y not, and X = Y - 1 where Y is bound and X not; eq(X, Y) gives its one variable B leaves free, where it has one, the whole number at which the two expressions are equal, where there is one (eq_ext); and(C1, C2) the extensions by C1 of the extensions by C2; or(C1, C2) the extensions of each; true and the inequalities give none, B itself.
procedure con_extend(Constraint?, Binding?, Bindings).
con_extend(C, B, Bs?) :- ground(C?), ground(B?) | con_ext1(C?, B?, Bs1), con_again(Bs1?, C?, B?, Bs).
procedure con_again(Bindings?, Constraint?, Binding?, Bindings).
con_again([], _, _, []).
con_again([B1|Bs], C, B, R?) :- ground(B1?), ground(B?), ground(C?) |
    blen(B1?, N1),
    blen(B?, N),
    con_again1(N1?, N?, B1?, C?, R1),
    con_again(Bs?, C?, B?, R2),
    app(R1?, R2?, R).
procedure con_again1(Integer?, Integer?, Binding?, Constraint?, Bindings).
con_again1(N1, N, B1, C, R?) :- N1? > N? | con_extend(C?, B1?, R).
con_again1(_, _, B1, _, [B1?]) :- otherwise | true.
procedure blen(Binding?, Integer).
blen([], 0).
blen([_|Bs], N?) :- blen(Bs?, M), N := M? + 1.
procedure con_ext1(Constraint?, Binding?, Bindings).
con_ext1(true, B, [B?]).
con_ext1(and(C1, C2), B, Bs?) :- ground(B?) | con_ext1(C2?, B?, Bs2), ext_by(Bs2?, C1?, Bs).
con_ext1(eq(X, Y), B, Bs?) :- ground(X?), ground(Y?), ground(B?) | eq_ext(X?, Y?, B?, Bs).
con_ext1(le(_, _), B, [B?]).
con_ext1(lt(_, _), B, [B?]).
con_ext1(ge(_, _), B, [B?]).
con_ext1(gt(_, _), B, [B?]).
con_ext1(succ(X, Y), B, Bs?) :- ground(B?), ground(X?), ground(Y?) |
    num_of(X?, B?, A),
    num_of(Y?, B?, C),
    succ_ext(A?, C?, X?, Y?, B?, Bs).
con_ext1(or(C1, C2), B, Bs?) :- ground(B?) |
    con_ext1(C1?, B?, Bs1),
    con_ext1(C2?, B?, Bs2),
    app(Bs1?, Bs2?, Bs).
procedure ext_by(Bindings?, Constraint?, Bindings).
ext_by([], _, []).
ext_by([B|Bs], C, R?) :- ground(C?) | con_ext1(C?, B?, R1), ext_by(Bs?, C?, R2), app(R1?, R2?, R).
%% An equality of two linear expressions gives its one numeric variable V that the binding leaves free the number K at which X - Y is 0: with D0 and D1 the values of X - Y at V = 0 and at V = 1, K = -D0 / (D1 - D0), where D1 - D0 is not 0 and divides D0; otherwise it gives none.
procedure eq_ext(Expr?, Expr?, Binding?, Bindings).
eq_ext(X, Y, B, Bs?) :- ground(X?), ground(Y?), ground(B?) |
    expr_free(X?, B?, [], F1),
    expr_free(Y?, B?, F1?, F),
    eq_ext1(F?, X?, Y?, B?, Bs).
procedure eq_ext1(Vars?, Expr?, Expr?, Binding?, Bindings).
eq_ext1([V], X, Y, B, Bs?) :- ground(V?), ground(X?), ground(Y?), ground(B?) |
    expr_val(minus(X?, Y?), [b(V?, n(0))|B?], D0),
    expr_val(minus(X?, Y?), [b(V?, n(1))|B?], D1),
    eq_solve(D0?, D1?, V?, B?, Bs).
eq_ext1(_, _, _, B, [B?]) :- otherwise | true.
procedure eq_solve(NumRes?, NumRes?, Var?, Binding?, Bindings).
eq_solve(num_is(D0), num_is(D1), V, B, Bs?) :- integer(D0?), integer(D1?) |
    C := D1? - D0?,
    eq_solve1(C?, D0?, V?, B?, Bs).
eq_solve(_, _, _, B, [B?]) :- otherwise | true.
procedure eq_solve1(Integer?, Integer?, Var?, Binding?, Bindings).
eq_solve1(C, D0, V, B, [[b(V?, n(K?))|B?]]) :- C? =\= 0, D0? mod C? =:= 0 | K := (0 - D0?) // C?.
eq_solve1(_, _, _, B, [B?]) :- otherwise | true.
%% The numeric variables of an expression that the binding leaves free, each once, added to F0.
procedure expr_free(Expr?, Binding?, Vars?, Vars).
expr_free(plus(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(minus(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(mul(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(num(X), _, F0, F0?) :- integer(X?) | true.
expr_free(num(X), B, F0, F?) :- otherwise, ground(X?), ground(B?), ground(F0?) |
    num_of(num(X?), B?, R),
    leaf_free1(R?, num(X?), F0?, F).
expr_free(role(_), _, F0, F0?).
expr_free(pvar(_), _, F0, F0?).
expr_free(svar(_), _, F0, F0?).
expr_free(sgn(_, _), _, F0, F0?).
expr_free(nterm(_), _, F0, F0?).
procedure leaf_free1(NumRes?, Var?, Vars?, Vars).
leaf_free1(num_is(_), _, F0, F0?).
leaf_free1(no_num, V, F0, F?) :- ground(V?), ground(F0?) | var_in(V?, F0?, In), add_var(In?, V?, F0?, F).
procedure var_in(Var?, Vars?, YesNo).
var_in(_, [], no).
var_in(V, [W|_], yes) :- V? =?= W? | true.
var_in(V, [_|Ws], R?) :- otherwise | var_in(V?, Ws?, R).
procedure add_var(YesNo?, Var?, Vars?, Vars).
add_var(yes, _, F0, F0?).
add_var(no, V, F0, [V?|F0?]).
procedure succ_ext(NumRes?, NumRes?, Var?, Var?, Binding?, Bindings).
succ_ext(num_is(A), no_num, _, Y, B, [[b(Y?, n(A1?))|B?]]) :- integer(A?) | A1 := A? + 1.
succ_ext(no_num, num_is(C), X, _, B, [[b(X?, n(C1?))|B?]]) :- integer(C?) | C1 := C? - 1.
succ_ext(_, _, _, _, B, [B?]) :- otherwise | true.
%% Whether the binding binds a number to every numeric variable of the schema's head, its variables local to a role apart, which the compiler leaves out of it.
procedure nums_bound(Constant?, Binding?, YesNo).
nums_bound(Nm, B, Ok?) :- ground(Nm?) | schema_entry(Nm?, E), schema_head(E?, Hd), hd_nums_bound(Hd?, B?, Ok).
procedure schema_head(Schema?, Vars).
schema_head(schema(_, Hd, _), Hd?).
schema_head(lschema(_, Hd, _, _), Hd?).
procedure hd_nums_bound(Vars?, Binding?, YesNo).
hd_nums_bound([], _, yes).
hd_nums_bound([num(X)|Vs], B, Ok?) :- ground(X?), ground(B?) |
    num_of(num(X?), B?, K),
    is_num(K?, O1),
    hd_nums_bound(Vs?, B?, O2),
    and(O1?, O2?, Ok).
hd_nums_bound([_|Vs], B, Ok?) :- otherwise | hd_nums_bound(Vs?, B?, Ok).
procedure is_num(NumRes?, YesNo).
is_num(num_is(_), yes).
is_num(no_num, no).

%% ===========================================================================
%% The agent state's fields, booleans, lists and multisets
%% ===========================================================================

procedure st_id(St?, Peer).
st_id(st(Id, _, _, _, _, _, _, _, _, _, _, _, _, _), Id?).
procedure st_app(St?, App).
st_app(st(_, Ap, _, _, _, _, _, _, _, _, _, _, _, _), Ap?).
procedure st_count(St?, Integer).
st_count(st(_, _, D, _, _, _, _, _, _, _, _, _, _, _), D?).
procedure st_sent(St?, Peers).
st_sent(st(_, _, _, Se, _, _, _, _, _, _, _, _, _, _), Se?).
procedure st_recd(St?, Peers).
st_recd(st(_, _, _, _, Rc, _, _, _, _, _, _, _, _, _), Rc?).
%% The persons the agent knows, in the order of identifiers.
procedure st_known(St?, List(Key)).
st_known(st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), Ks?) :- ground(Se?), ground(ISe?) |
    app(Se?, ISe?, Ps),
    known_sorted(Ps?, kn(Se?, Rc?, ISe?, IRc?), Ks).
procedure known_sorted(Peers?, Kn?, List(Key)).
known_sorted(Ps, Kn, Ks?) :- ground(Ps?) |
    dedup(Ps?, Ps1),
    known_of(Ps1?, Kn?, K0),
    sort_peers(K0?, Ks).
procedure known_of(Peers?, Kn?, Peers).
known_of([], _, []).
known_of([P|Ps], Kn, Ks?) :- ground(P?), ground(Kn?) |
    known_kn(P?, Kn?, B),
    known_of(Ps?, Kn?, K1),
    keep_peer(B?, P?, K1?, Ks).
procedure keep_peer(YesNo?, Peer?, Peers?, Peers).
keep_peer(yes, P, Ks, [P?|Ks?]).
keep_peer(no, _, Ks, Ks?).
procedure st_isent(St?, Peers).
st_isent(st(_, _, _, _, _, ISe, _, _, _, _, _, _, _, _), ISe?).
procedure st_irecd(St?, Peers).
st_irecd(st(_, _, _, _, _, _, IRc, _, _, _, _, _, _, _), IRc?).
procedure st_waits(St?, Waits).
st_waits(st(_, _, _, _, _, _, _, W, _, _, _, _, _, _), W?).
procedure st_pends(St?, Pends).
st_pends(st(_, _, _, _, _, _, _, _, _, Pd, _, _, _, _), Pd?).
procedure st_ix(St?, Ix).
st_ix(st(_, _, _, _, _, _, _, _, _, _, _, _, Ix, _), Ix?).
procedure set_ix(St?, Ix?, St).
set_ix(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, _, Rq), Ix, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure st_trie(St?, Trie).
st_trie(st(_, _, _, _, _, _, _, _, _, _, _, _, ix(Tr, _, _, _), _), Tr?).
procedure st_kn(St?, Kn).
st_kn(st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), kn(Se?, Rc?, ISe?, IRc?)).
%% The parts of the state a condition tests (V).
procedure st_view(St?, V).
st_view(st(Id, app(S, _, L, R), _, Se, Rc, ISe, IRc, _, _, Pd, _, _, _, _), v(Id?, S?, L?, R?, Pd?, kn(Se?, Rc?, ISe?, IRc?))).
procedure v_id(V?, Peer).
v_id(v(Id, _, _, _, _, _), Id?).
procedure v_ms(V?, GAtoms).
v_ms(v(_, S, _, _, _, _), S?).
procedure v_recs(V?, Recs).
v_recs(v(_, _, _, R, _, _), R?).
procedure v_pends(V?, Pends).
v_pends(v(_, _, _, _, Pd, _), Pd?).
procedure v_kn(V?, Kn).
v_kn(v(_, _, _, _, _, Kn), Kn?).
procedure set_app(St?, App?, St).
set_app(st(Id, _, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), Ap, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure set_waits(St?, Waits?, St).
set_waits(st(Id, Ap, D, Se, Rc, ISe, IRc, _, Ca, Pd, Pr, Hd, Ix, Rq), W, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
%% The requests the agent has made, in the order it last made them, and the requests it holds.
procedure st_made(St?, Rhos).
st_made(st(_, _, _, _, _, _, _, _, _, _, Pr, _, _, _), Pr?).
procedure set_made(St?, Rhos?, St).
set_made(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, _, Hd, Ix, Rq), Pr, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure st_held(St?, Helds).
st_held(st(_, _, _, _, _, _, _, _, _, _, _, Hd, _, _), Hd?).
procedure set_held(St?, Helds?, St).
set_held(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, _, Ix, Rq), Hd, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
%% The requests of its person the agent holds while it is not free for their classes (vGLP, Section 5.4, "The compilation": "where the agent is not free for a class of such a Request, it holds the request and puts it up again after every dispatch").
procedure st_reqs(St?, Proposals).
st_reqs(st(_, _, _, _, _, _, _, _, _, _, _, _, _, Rq), Rq?).
procedure set_reqs(St?, Proposals?, St).
set_reqs(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, _), Rq, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure set_pends(St?, Pends?, St).
set_pends(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, _, Pr, Hd, Ix, Rq), Pd, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
%% A start held waiting, once: added where not held already; and dropped.
procedure add_pend_once(Pend?, St?, St).
add_pend_once(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq),
        st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?, Pr?, Hd?, Ix?, Rq?)) :-
    ground(X?), ground(Pd?) |
    mem(X?, Pd?, In),
    add_pend1(In?, X?, Pd?, Pd1).
procedure add_pend1(YesNo?, Pend?, Pends?, Pends).
add_pend1(yes, _, Pd, Pd?).
add_pend1(no, X, Pd, Pd1?) :- app(Pd?, [X?], Pd1).
procedure drop_pend(Pend?, St?, St).
drop_pend(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq),
        st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?, Pr?, Hd?, Ix?, Rq?)) :-
    remove_all(X?, Pd?, Pd1).
procedure add_sent(Peer?, St?, St).
add_sent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq),
        st(Id?, Ap?, D?, [Q?|Se?], Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure add_isent(Peer?, St?, St).
add_isent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq),
        st(Id?, Ap?, D?, Se?, Rc?, [Q?|ISe?], IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure add_irecd(Peer?, St?, St).
add_irecd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq),
        st(Id?, Ap?, D?, Se?, Rc?, ISe?, [P?|IRc?], W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure add_recd(Peer?, St?, St).
add_recd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq),
        st(Id?, Ap?, D?, Se?, [P?|Rc?], ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).
procedure advance(St?, St).
advance(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D1?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)) :-
    D1 := D? + 1.
procedure app_recs(App?, Recs).
app_recs(app(_, _, _, R), R?).
procedure app_count(App?, Integer).
app_count(app(_, K, _, _), K?).
procedure app_state(App?, GAtoms).
app_state(app(S, _, _, _), S?).
procedure attempt_id(Attempt?, Peer).
attempt_id(attempt(I, _, _, _, _), I?).
procedure attempt_k(Attempt?, Integer).
attempt_k(attempt(_, K, _, _, _), K?).
procedure attempt_rank(Attempt?, Integer).
attempt_rank(attempt(_, _, P, _, _), P?).
procedure attempt_class(Attempt?, Class).
attempt_class(attempt(_, _, _, C, _), C?).
procedure attempt_names(Attempt?, Names).
attempt_names(attempt(_, _, _, _, Nm), Nm?).

procedure and(YesNo?, YesNo?, YesNo).
and(yes, B, B?).
and(no, _, no).
procedure or(YesNo?, YesNo?, YesNo).
or(yes, _, yes).
or(no, B, B?).
procedure neg(YesNo?, YesNo).
neg(yes, no).
neg(no, yes).
procedure(X) same(X?, X?, YesNo).
same(P, Q, yes) :- P? =?= Q? | true.
same(_, _, no) :- otherwise | true.
procedure same_int(Integer?, Integer?, YesNo).
same_int(M, N, yes) :- M? =:= N? | true.
same_int(_, _, no) :- otherwise | true.

procedure sort_peers(Peers?, Peers).
sort_peers([], []).
sort_peers([P|Ps], S?) :- sort_peers(Ps?, S1), insert_peer(P?, S1?, S).
procedure insert_peer(Peer?, Peers?, Peers).
insert_peer(P, [], [P?]).
insert_peer(P, [Q|Qs], [P?, Q?|Qs?]) :- P? @< Q? | true.
insert_peer(P, [Q|Qs], [Q?|R?]) :- otherwise | insert_peer(P?, Qs?, R).

procedure(X) app(Stream(X)?, Stream(X)?, Stream(X)).
app([], Ys, Ys?).
app([X|Xs], Ys, [X?|Zs?]) :- app(Xs?, Ys?, Zs).
procedure(X) mem(X?, Stream(X)?, YesNo).
mem(_, [], no).
mem(X, [Y|_], yes) :- X? =?= Y? | true.
mem(X, [_|Ys], R?) :- otherwise | mem(X?, Ys?, R).
procedure(X) dedup(Stream(X)?, Stream(X)).
dedup([], []).
dedup([X|Xs], [X?|Ys?]) :- ground(X?) | remove_all(X?, Xs?, Xs1), dedup(Xs1?, Ys).
procedure(X) remove_all(X?, Stream(X)?, Stream(X)).
remove_all(_, [], []).
remove_all(X, [Y|Ys], Zs?) :- X? =?= Y? | remove_all(X?, Ys?, Zs).
remove_all(X, [Y|Ys], [Y?|Zs?]) :- otherwise | remove_all(X?, Ys?, Zs).
procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y|Ys], yes, Ys?) :- X? =?= Y? | true.
ms_remove(X, [Y|Ys], F?, [Y?|Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).
procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X|Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).
procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X|Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).
procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).
procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) |
    ms_sub(A?, B?, R1),
    ms_sub(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).
procedure(X) ms_meets(Stream(X)?, Stream(X)?, YesNo).
ms_meets([], _, no).
ms_meets([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), ms_meets1(R1?, Xs?, B?, R).
procedure(X) ms_meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_meets1(yes, _, _, yes).
ms_meets1(no, Xs, B, R?) :- ms_meets(Xs?, B?, R).
