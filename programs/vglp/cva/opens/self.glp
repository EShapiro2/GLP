%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract opens (../contracts.glp, contract_named(opens, C)), platform.vglp, which programs/vglp/cva/compile.sh prints from it: two-phase commit coordinated by the initiating agent (vGLP, Section 3.2, Definition "Canonical CVA Platform").  It runs two agents, alice and bob, alice preceding bob in the order of identifiers, their persons scripted and paced on their screens (../self.glp), and gives each person's log, the views with gave(K, A) where the person answers an approval question, and the network's log of the cargoes it carries.
%%
%% u1(alice, bob) and u2(bob, alice) are one class of two unguarded parts, u1(alice, bob)'s opened by alice and u2(bob, alice)'s by bob, each part's opener "the least, in the order of identifiers, of the people in the first role of the schema-bindings that determine it" (vGLP 099f876, Section 5.4, "Act schemas as local specifications"; vGLP #15, Code_inbox.md, 2026-10-19 10:50 UTC, item 3).
%%
%% play_opens: alice and bob come to know each other and befriend, attempt 1.  bob marks alice, attempt 2, adding w(alice) at him, and alice's machine votes on it unasked.  The part of u2(bob, alice) then holds, and bob, its opener, proposes it as an own transaction, attempt 3, the attempt asking nobody and alice's machine voting yes; it commits.  alice holds no r(bob), so the part of u1(alice, bob), hers to open, does not hold, and she proposes nothing of the class.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; mark(Peer, Peer) ; rmark(Peer, Peer) ; u1(Peer, Peer) ; u2(Peer, Peer).
Proposal ::= befriend(Peer, Peer) ; mark(Peer, Peer) ; rmark(Peer, Peer).
Request  ::= propose(Proposal) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= friend(Peer) ; w(Peer) ; marked_by(Peer) ; r(Peer) ; rmarked_by(Peer) ; x(Peer) ; y(Peer).
Output   ::= view(List(Atom), List(Key)) ; refused(Class, Key) ; yielded(Class).
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_opens(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_opens(LA?, LB?, N?) :-
    pair([req(known(bob)), wait(known(bob)),
          own([A1], propose(befriend(A1?, bob)))],
         [req(known(alice)), wait(known(alice)),
          approval(befriend(alice, bob), yes),
          wait(holds(friend(alice))),
          own([B1], propose(mark(B1?, alice)))],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
