%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract waves (../contracts.glp, contract_named(waves, C)), platform.vglp, which programs/vglp/cva/compile.sh prints from it: two-phase commit coordinated by the initiating agent (vGLP, Section 3.2, Definition "Canonical CVA Platform").  It runs two agents, alice and bob, their persons scripted and paced on their threads (../self.glp), and gives each person's log, the thread with gave(K, A) where the person answers an approval question, and the network's log of the cargoes it carries.
%%
%% wave(alice, bob) and hail(alice, bob) delete and add the same atoms at alice and at bob, and are of two classes: "The classes are those of the contract's equivalence, generated by relating two transactions when one schema-binding determines both" (vGLP 9c819f5, Section 5.4, "Act schemas as local specifications"), and wave requires friend(bob) at alice where hail forbids it, so no transaction is determined by both.  The class of hail is guarded by both, its guard set {alice, bob}, and the class of wave by alice.  The printed program takes the domain of each participant's effect, the guard sets and the opener over the one class an attempt's term names.
%%
%% play_waves: alice and bob, strangers, come to know each other, and alice proposes hail(alice, bob): bob, in its guard set, is asked, answers yes, and it commits.  They befriend.  alice then requests hail(alice, bob) again, and the request is dropped, taking no number, friend(bob) being in her state, outside the domain of her effect in the class of hail; she requests wave(alice, bob), attempt 3, guarded by her, and bob's machine votes on it unasked, friend(alice) being in his state, and it commits.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; wave(Peer, Peer) ; hail(Peer, Peer).
Request  ::= propose(Class) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Txn      ::= propose(Attempt) ; start(Attempt) ; answer(Attempt) ; vote(Attempt)
           ; tally(Attempt) ; commit(Attempt) ; yield(Attempt) ; wound(Attempt, Attempt) ; outcome(Attempt)
           ; introduce_peers(Peer, Peer) ; discover(Peer).
Output   ::= Txn.
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_waves(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_waves(LA?, LB?, N?) :-
    pair([req(known(bob)), wait(discover(bob)),
          req(propose(hail(alice, bob))),
          wait(commit(attempt(alice, 1, 1, hail(alice, bob)))),
          req(propose(befriend(alice, bob))),
          wait(commit(attempt(alice, 2, 2, befriend(alice, bob)))),
          req(propose(hail(alice, bob))),
          req(propose(wave(alice, bob)))],
         [req(known(alice)), wait(discover(alice)),
          approval(hail(alice, bob), yes),
          approval(befriend(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
