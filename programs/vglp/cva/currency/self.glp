%% ---------------------------------------------------------------------------
%% The plays of the canonical CVA platform of GSC's currency
%% (Currencies', programs/currencies/coins/GC.glp; GSC, Section 3.4, the cent
%% sign written coin), platform.vglp, which programs/vglp/cva/compile.sh prints
%% from it: two-phase commit coordinated by the initiating agent (vGLP, Section
%% 3.2, Definition "Canonical CVA Platform").  Each runs two agents, alice and
%% bob, their persons scripted and paced on their threads (../self.glp), and
%% gives each person's log, the thread with gave(K, A) where the person answers
%% an approval question, and the network's log of the cargoes it carries.  swap(P, Q, V, U):
%% P gives a coin of U and takes one of V, Q the converse.
%%
%% play_pay_swap: each mints a coin of its own, a class of one participant,
%%   applied at once; alice proposes swapping hers for bob's, bob is asked and
%%   answers yes, and it commits; alice then pays bob his coin back, guarded by
%%   her alone, and bob's machine votes yes.
%% play_redeem: swapped as above, alice requests the swap back, swap(alice, bob, alice, bob), whose class redeem(alice, bob, alice) and redeem(bob, alice, bob) also determine, each schema-binding a part with the people in its marked roles as its guard set (vGLP 099f876, Section 5.4, "Act schemas as local specifications"): the swaps' part, guarded by alice and bob, and the two redeems', guarded by alice and by bob.  Of the guarded parts she guards and is ready for, the swaps' and her redeem's, neither proposed before, she proposes the one her request names, the swaps', attempt 3, which asks bob, its other guard (Definition "Attempt"); he answers yes and it commits.  She swaps again, attempt 4, and requests the swap back again: she now proposes her redeem's part, the one she has proposed less recently (Section 5.4, "The compilation"), attempt 5, redeem(alice, bob, alice), which asks nobody, and bob's machine votes yes.
%% play_busy: bob having minted twice, swapped as above and alice minted
%%   again, alice proposes a swap and bob, asked, leaves his approval question open, alice
%%   holding her attempt prepared; bob proposes paying alice her coin back, and
%%   alice holds the pay's start waiting, her lock set by her swap, which has
%%   priority over the pay, so she wounds nothing and votes no on nothing for
%%   contention (vGLP 49cd9f7, wound-wait); bob answers alice's approval question no, the
%%   else-branch, his Vote, an own transaction, votes no, and her swap aborts;
%%   alice then takes the pay's start, her machine votes yes, and the pay
%%   commits at its first attempt.
%% play_declined: alice proposes a swap for a coin bob does not hold; bob, not
%%   ready, votes no without asking his person, and it aborts at both.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= mint(Peer) ; swap(Peer, Peer, Peer, Peer) ; pay(Peer, Peer)
           ; redeem(Peer, Peer, Peer).
Proposal ::= mint(Peer) ; swap(Peer, Peer, Peer, Peer) ; pay(Peer, Peer)
           ; redeem(Peer, Peer, Peer).
Request  ::= propose(Proposal) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Speech   ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
Val      ::= p(Peer) ; s(Speech).
Vals     ::= [] ; [Val | Vals].
GAtom    ::= g(Constant, Vals).
GAtoms   ::= [] ; [GAtom | GAtoms].
Output   ::= GAtoms.
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_pay_swap(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_pay_swap(LA?, LB?, N?) :-
    pair([own([A1], propose(mint(A1?))), wait(propose(attempt(alice, 1, 1, mint(alice)))),
          req(known(bob)), wait(discover(bob)),
          own([A2, A3], propose(swap(A2?, bob, bob, A3?))),
          wait(commit(attempt(alice, 2, 2, swap(alice, bob, bob, alice)))),
          own([A4], propose(pay(A4?, bob)))],
         [own([B1], propose(mint(B1?))), wait(propose(attempt(bob, 1, 1, mint(bob)))),
          req(known(alice)), wait(discover(alice)),
          approval(swap(alice, bob, bob, alice), yes)],
         LA, LB, N).

exported procedure play_redeem(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_redeem(LA?, LB?, N?) :-
    pair([own([A1], propose(mint(A1?))), wait(propose(attempt(alice, 1, 1, mint(alice)))),
          req(known(bob)), wait(discover(bob)),
          own([A2, A3], propose(swap(A2?, bob, bob, A3?))),
          wait(commit(attempt(alice, 2, 2, swap(alice, bob, bob, alice)))),
          own([A4, A5], propose(swap(A4?, bob, A5?, bob))),
          wait(commit(attempt(alice, 3, 3, swap(alice, bob, alice, bob)))),
          own([A6, A7], propose(swap(A6?, bob, bob, A7?))),
          wait(commit(attempt(alice, 4, 4, swap(alice, bob, bob, alice)))),
          own([A8, A9], propose(swap(A8?, bob, A9?, bob)))],
         [own([B1], propose(mint(B1?))), wait(propose(attempt(bob, 1, 1, mint(bob)))),
          req(known(alice)), wait(discover(alice)),
          approval(swap(alice, bob, bob, alice), yes),
          approval(swap(alice, bob, alice, bob), yes),
          approval(swap(alice, bob, bob, alice), yes)],
         LA, LB, N).

exported procedure play_busy(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_busy(LA?, LB?, N?) :-
    pair([own([A1], propose(mint(A1?))), wait(propose(attempt(alice, 1, 1, mint(alice)))),
          req(known(bob)), wait(discover(bob)),
          own([A2, A3], propose(swap(A2?, bob, bob, A3?))),
          wait(commit(attempt(alice, 2, 2, swap(alice, bob, bob, alice)))),
          own([A4], propose(mint(A4?))), wait(propose(attempt(alice, 3, 3, mint(alice)))),
          own([A5, A6], propose(swap(A5?, bob, bob, A6?)))],
         [own([B1], propose(mint(B1?))), wait(propose(attempt(bob, 1, 1, mint(bob)))),
          own([B2], propose(mint(B2?))), wait(propose(attempt(bob, 2, 2, mint(bob)))),
          req(known(alice)), wait(discover(alice)),
          approval(swap(alice, bob, bob, alice), yes),
          wait(start(attempt(alice, 4, 4, swap(alice, bob, bob, alice)))),
          own([B3], propose(pay(B3?, alice))),
          wait(propose(attempt(bob, 5, 5, pay(bob, alice)))),
          approval(attempt(alice, 4, 4, swap(alice, bob, bob, alice)), no)],
         LA, LB, N).

exported procedure play_declined(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_declined(LA?, LB?, N?) :-
    pair([own([A1], propose(mint(A1?))), wait(propose(attempt(alice, 1, 1, mint(alice)))),
          req(known(bob)), wait(discover(bob)),
          own([A2, A3], propose(swap(A2?, bob, carol, A3?)))],
         [req(known(alice))],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks
%% joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
