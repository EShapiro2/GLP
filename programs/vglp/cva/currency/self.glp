%% ---------------------------------------------------------------------------
%% The plays of the canonical CVA platform of GC, the grassroots currencies
%% contract (Currencies', programs/currencies/coins/GC.glp; GC, Section 2.1 and
%% Appendix A, the cent sign written coin), platform.vglp, which
%% programs/vglp/cva/compile.sh prints from it: two-phase commit coordinated by
%% the initiating agent, a person's request its standing approval (vGLP
%% f0acbc1, Section 3.2, "The protocol" and Definitions "Proposing" to
%% "Deciding"; Section 5.4, "Triggers" and "The compilation").  GC extends GKK,
%% so each person first establishes their identity, which every other role
%% requires, and alice and bob meet, each then knowing the other, before
%% they swap, pay or redeem (GC:2 to GC:4).  Each play runs two agents, alice
%% and bob, their persons scripted and paced on their screens (../self.glp), and
%% gives each person's log, the views and the notices, with gave(K, A) where
%% the person answers an approval question, and the network's log of the
%% cargoes it carries.  swap(P, Q, U, V): P gives a coin of U and takes one of
%% V, Q the converse; redeem(P, Q, R): P gives Q a coin of Q and takes a coin
%% of R that Q holds.
%%
%% Each play opens alike: each person establishes their identity and mints a
%% coin of their own, each a class of one participant, applied at once; each
%% comes to know the other's agent; and alice requests meeting bob, who is
%% asked and answers yes, and once it commits each knows the other.
%%
%% play_pay_swap: alice requests swapping her coin for bob's, swap(alice, bob,
%%   alice, bob); bob is asked and answers yes, and it commits; alice then pays
%%   bob his coin back, pay(alice, bob), guarded by her, and bob's machine
%%   votes yes, unasked.
%% play_redeem: swapped as above, alice requests the swap back, swap(alice,
%%   bob, bob, alice), whose class redeem(alice, bob, alice) and redeem(bob,
%%   alice, bob) also determine, each schema-binding a part with the people in
%%   its marked roles as its guard set (vGLP, Section 5.4, "Act schemas as
%%   local specifications"): the swaps' part, guarded by alice and bob, and the
%%   two redeems', guarded by alice and by bob.  Her machine proposes the part
%%   her request names, the swaps', which asks bob; he answers yes and it
%%   commits.  She swaps again and requests the swap back again; her machine
%%   now proposes her redeem's part, the one it has proposed less recently
%%   (Section 5.4, "The compilation"), which asks nobody, and bob's machine
%%   votes yes.
%% play_busy: bob having minted twice, swapped as above and alice minted
%%   again, alice requests a swap and bob, asked, leaves his approval question
%%   open, alice's machine holding her attempt prepared; bob requests paying
%%   alice her coin back, and alice's machine holds the pay's start waiting,
%%   her lock set by her swap, which has priority over the pay, so it wounds
%%   nothing and votes no on nothing for contention (vGLP 49cd9f7,
%%   wound-wait); bob answers alice's approval question no, his vote no
%%   declined, and her swap aborts, bob its refuser; alice's machine then takes
%%   the pay's start, votes yes, and the pay commits at its first attempt.
%% play_declined: alice requests a swap for a coin of carol's, which bob does
%%   not hold; bob's machine, its state not in the domain of its part, votes
%%   no without asking his person, unable, the coin it lacks named, and it
%%   aborts at both; alice's screen shows the notice of her approval ended by
%%   bob's refusal.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= establish(Peer) ; meet(Peer, Peer) ; introduce(Peer, Peer, Peer)
           ; mint(Peer) ; swap(Peer, Peer, Peer, Peer) ; pay(Peer, Peer)
           ; redeem(Peer, Peer, Peer).
Proposal ::= establish(Peer) ; meet(Peer, Peer) ; introduce(Peer, Peer, Peer)
           ; mint(Peer) ; swap(Peer, Peer, Peer, Peer) ; pay(Peer, Peer)
           ; redeem(Peer, Peer, Peer).
Request  ::= propose(Proposal) ; known(Peer).
YesNo    ::= yes ; no.
Reason   ::= declined ; unable(List(Atom), List(Atom)).
Vote     ::= yes ; no(Reason).
Decision ::= commit ; abort(Peer, Reason) ; yield.
Rho      ::= one(Class) ; rho(Proposal).
Names    ::= none ; request(Rho, Integer).
Attempt  ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo    ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
           ; yield(Attempt) ; request(Rho, Integer).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= identity ; knows(Peer) ; coin(Peer).
Output   ::= view(List(Atom), List(Key)) ; refused(Class, Key, Reason).
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_pay_swap(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_pay_swap(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(mint(A2?))), wait(holds(coin(alice))),
          req(known(bob)), wait(known(bob)),
          own([A3], propose(meet(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, bob))),
          wait(holds(coin(bob))),
          own([A6], propose(pay(A6?, bob)))],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          own([B2], propose(mint(B2?))), wait(holds(coin(bob))),
          req(known(alice)), wait(known(alice)),
          approval(meet(alice, bob), yes),
          approval(swap(alice, bob, alice, bob), yes)],
         LA, LB, N).

exported procedure play_redeem(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_redeem(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(mint(A2?))), wait(holds(coin(alice))),
          req(known(bob)), wait(known(bob)),
          own([A3], propose(meet(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, bob))),
          wait(holds(coin(bob))),
          own([A6, A7], propose(swap(A6?, bob, bob, A7?))),
          wait(holds(coin(alice))),
          own([A8, A9], propose(swap(A8?, bob, A9?, bob))),
          wait(holds(coin(bob))),
          own([A10, A11], propose(swap(A10?, bob, bob, A11?)))],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          own([B2], propose(mint(B2?))), wait(holds(coin(bob))),
          req(known(alice)), wait(known(alice)),
          approval(meet(alice, bob), yes),
          approval(swap(alice, bob, alice, bob), yes),
          approval(swap(alice, bob, bob, alice), yes),
          approval(swap(alice, bob, alice, bob), yes)],
         LA, LB, N).

exported procedure play_busy(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_busy(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(mint(A2?))), wait(holds(coin(alice))),
          req(known(bob)), wait(known(bob)),
          own([A3], propose(meet(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, bob))),
          wait(holds(coin(bob))),
          own([A6], propose(mint(A6?))), wait(holds(coin(alice))),
          own([A7, A8], propose(swap(A7?, bob, A8?, bob)))],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          own([B2], propose(mint(B2?))), wait(has(coin(bob), 1)),
          own([B3], propose(mint(B3?))), wait(has(coin(bob), 2)),
          req(known(alice)), wait(known(alice)),
          approval(meet(alice, bob), yes),
          approval(swap(alice, bob, alice, bob), yes),
          wait(asked(swap(alice, bob, alice, bob))),
          own([B4], propose(pay(B4?, alice))),
          wait(asking),
          approval(swap(alice, bob, alice, bob), no)],
         LA, LB, N).

exported procedure play_declined(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_declined(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(mint(A2?))), wait(holds(coin(alice))),
          req(known(bob)), wait(known(bob)),
          own([A3], propose(meet(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, carol)))],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          req(known(alice)), wait(known(alice)),
          approval(meet(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks
%% joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
