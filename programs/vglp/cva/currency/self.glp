%% ---------------------------------------------------------------------------
%% The plays of the canonical CVA platform of Coins, the grassroots coins contract (Currencies', programs/currencies/coins/Coins.txt and Coins.glp, which relaxes and extends Notes, programs/gsc/Notes.txt, which extends GKK), platform.vglp, which
%% programs/vglp/cva/compile.sh prints from it: two-phase commit coordinated by
%% the initiating agent, a person's request its standing approval (vGLP
%% f0acbc1, Section 3.2, "The protocol" and Definitions "Proposing" to
%% "Deciding"; Section 5.4, "Triggers" and "The compilation").  Coins extends GKK through Notes,
%% so each person first establishes their identity, which every other role
%% requires, and alice and bob come to know each other by GKK:2,
%% Acquaint, acquaint(p?, q?), before
%% they swap, pay or redeem (Notes:2 and 3, Coins:1 and 2).  Each play runs two agents, alice
%% and bob, their persons scripted and paced on their screens (../self.glp), and
%% gives each person's log, the views and the notices, with gave(K, A) where
%% the person answers an approval question, and the network's log of the
%% cargoes it carries.
%%
%% The schemas carry sets of notes, GSC's set variables (GSC 4a9175a, set(N) of type Set(A); Currencies 57fa953): each note is note(P, T, N), its holder P, its type T and its identifier N, and a set variable names the notes a request moves, an atom with it standing for one atom per element, size(N) the number of its elements.  The request names each set as the list of its notes, and the amount, the set's size, as a number (vGLP decisions 5 and 7, 2026-11-24).  The classes, as the platform names them, T the type of the notes, coin in each play (Notes; Coins: "A *coin* is a note that is a unit of its issuer's debt"): issue(P, T, Ns, K), P issues the K notes Ns of P of type T; swap(P, Q, U, T, Ns, K, V, T1, Ms, K1), P gives the K notes Ns of U and takes the K1 notes Ms of V, Q the converse; pay(P, Q, U, T, Ns, K), P pays Q the K notes Ns of U, with Q's consent (Notes:3); pay_issuer(P, Q, T, Ns, K), P pays Q the K notes Ns of Q, guarded by P, without the consent of Q (Coins:1, Pay issuer); redeem(P, Q, [B], R, [C]), P gives Q the Q-coin B and takes the R-coin C that Q holds (Coins:2, Redeem).
%%
%% Each play opens alike: each person establishes their identity and issues
%% coins of their own, each a class of one participant, applied at once; each
%% comes to know the other's agent by alice's request acquaint(alice, bob), a cold
%% call, the hello, on which bob is asked and answers yes, his request of it
%% (vGLP, Section 5.4, "The compilation"), and once it commits each knows the
%% other.
%%
%% play_pay_swap: alice issues 2 coins and bob 3; alice requests swapping 2 of
%%   hers for 3 of bob's, swap(alice, bob, alice, coin, [a1, a2], 2, bob, coin, [b1, b2, b3], 3); bob is asked and
%%   answers yes, and it commits; alice then pays bob 2 of his coins back,
%%   pay_issuer(alice, bob, coin, [b1, b2], 2), guarded by her, and bob's machine votes yes, unasked.
%% play_redeem: each issues one coin and they swap them one for one,
%%   swap(alice, bob, alice, coin, [a1], 1, bob, coin, [b1], 1); bob is asked
%%   and answers yes, and it commits.  alice then swaps them back and swaps
%%   again, and requests the redemption, redeem(alice, bob, [b1], alice, [a1]),
%%   the Bob-coin b1 given back for the Alice-coin a1 bob holds, guarded by her:
%%   her machine proposes it, which asks nobody, bob's machine votes yes, and
%%   it commits, alice holding a1.
%% play_busy: each having issued 2 coins and swapped one coin for one,
%%   alice requests a second swap and bob, asked, leaves his approval question
%%   open, alice's machine holding her attempt prepared; bob requests paying
%%   alice her coin back, pay_issuer(bob, alice, coin, [a1], 1), and alice's machine holds the pay's start waiting,
%%   her lock set by her swap, which has priority over the pay, so it wounds
%%   nothing and votes no on nothing for contention (vGLP 49cd9f7,
%%   wound-wait); bob answers alice's approval question no, his vote no
%%   declined, and her swap aborts, bob its refuser; alice's machine then takes
%%   the pay's start, votes yes, and the pay commits at its first attempt.
%% play_declined: alice requests swapping a coin of hers for a coin of
%%   carol's, which bob does not hold; bob's machine, its state not in the
%%   domain of its part, votes no without asking his person, unable, the coin
%%   it lacks named, and it aborts at both; alice's screen shows the notice of
%%   her approval ended by bob's refusal.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------


%% The scripted person's steps and log on this platform (../self.glp): the grants of its Drawn, an approval step naming a class, the atoms of its machine state, the approvals pending and the reasons of its views, and its tabs.
ScriptSteps ::= Steps(Drawn, Class, Atom, Approved, Reason).
ScriptLog   ::= Logged(Class, Drawn, Atom, Approved, Reason, Tab).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

exported procedure play_pay_swap(Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
play_pay_swap(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(issue(A2?, coin, [a1, a2], 2)), [at(3, [a1, a2, [end]])]), wait(holds(note(alice, coin, a2))),
          own([A3], propose(acquaint(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, coin, [a1, a2], 2, bob, coin, [b1, b2, b3], 3)), [at(5, [a1, a2, [end]]), at(9, [b1, b2, b3, [end]])]),
          wait(holds(note(bob, coin, b3))),
          own([A6], propose(pay_issuer(A6?, bob, coin, [b1, b2], 2)), [at(4, [b1, b2, [end]])])],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          own([B2], propose(issue(B2?, coin, [b1, b2, b3], 3)), [at(3, [b1, b2, b3, [end]])]), wait(holds(note(bob, coin, b3))),
          approval(acquaint(alice, bob), yes),
          approval(swap(alice, bob, alice, coin, [a1, a2], 2, bob, coin, [b1, b2, b3], 3), yes)],
         LA, LB, N).

exported procedure play_redeem(Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
play_redeem(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(issue(A2?, coin, [a1], 1)), [at(3, [a1, [end]])]), wait(holds(note(alice, coin, a1))),
          
          own([A3], propose(acquaint(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, coin, [a1], 1, bob, coin, [b1], 1)), [at(5, [a1, [end]]), at(9, [b1, [end]])]),
          wait(holds(note(bob, coin, b1))),
          own([A6, A7], propose(swap(A6?, bob, bob, coin, [b1], 1, A7?, coin, [a1], 1)), [at(5, [b1, [end]]), at(9, [a1, [end]])]),
          wait(holds(note(alice, coin, a1))),
          own([A8, A9], propose(swap(A8?, bob, A9?, coin, [a1], 1, bob, coin, [b1], 1)), [at(5, [a1, [end]]), at(9, [b1, [end]])]),
          wait(holds(note(bob, coin, b1))),
          own([A10, A11], propose(redeem(A10?, bob, [b1], A11?, [a1])), [at(3, [b1, [end]]), at(5, [a1, [end]])])],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          own([B2], propose(issue(B2?, coin, [b1], 1)), [at(3, [b1, [end]])]), wait(holds(note(bob, coin, b1))),
          
          approval(acquaint(alice, bob), yes),
          approval(swap(alice, bob, alice, coin, [a1], 1, bob, coin, [b1], 1), yes),
          approval(swap(alice, bob, bob, coin, [b1], 1, alice, coin, [a1], 1), yes),
          approval(swap(alice, bob, alice, coin, [a1], 1, bob, coin, [b1], 1), yes)],
         LA, LB, N).

exported procedure play_busy(Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
play_busy(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(issue(A2?, coin, [a1, a2], 2)), [at(3, [a1, a2, [end]])]), wait(holds(note(alice, coin, a2))),
          own([A3], propose(acquaint(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, coin, [a1], 1, bob, coin, [b1], 1)), [at(5, [a1, [end]]), at(9, [b1, [end]])]),
          wait(holds(note(bob, coin, b1))),
          own([A6, A7], propose(swap(A6?, bob, A7?, coin, [a2], 1, bob, coin, [b2], 1)), [at(5, [a2, [end]]), at(9, [b2, [end]])])],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          own([B2], propose(issue(B2?, coin, [b1, b2], 2)), [at(3, [b1, b2, [end]])]), wait(holds(note(bob, coin, b2))),
          approval(acquaint(alice, bob), yes),
          approval(swap(alice, bob, alice, coin, [a1], 1, bob, coin, [b1], 1), yes),
          wait(asked(swap(alice, bob, alice, coin, [a2], 1, bob, coin, [b2], 1))),
          own([B3], propose(pay_issuer(B3?, alice, coin, [a1], 1)), [at(4, [a1, [end]])]),
          wait(asking),
          approval(swap(alice, bob, alice, coin, [a2], 1, bob, coin, [b2], 1), no)],
         LA, LB, N).

exported procedure play_declined(Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
play_declined(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), wait(holds(identity)),
          own([A2], propose(issue(A2?, coin, [a1], 1)), [at(3, [a1, [end]])]), wait(holds(note(alice, coin, a1))),
          
          own([A3], propose(acquaint(A3?, bob))), wait(holds(knows(bob))),
          own([A4, A5], propose(swap(A4?, bob, A5?, coin, [a1], 1, carol, coin, [c1], 1)), [at(5, [a1, [end]]), at(9, [c1, [end]])])],
         [own([B1], propose(establish(B1?))), wait(holds(identity)),
          
          approval(acquaint(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks
%% joined.
procedure pair(ScriptSteps?, ScriptSteps?, Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
