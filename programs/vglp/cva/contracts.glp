%% ---------------------------------------------------------------------------
%% vGLP's contracts for the compiler from an act-schema contract to its
%% canonical CVA platform (compiler/, compile.sh), beside the social graph's
%% and the currency's, which their owners hold (programs/gsc/GSG.glp,
%% programs/currencies/coins/GC.glp).  Each is a contract in the term
%% form programs/gsc reads (its README, "Writing a contract"), and compile.sh
%% has GSC's checker, check/2, certify it before it compiles it, as it does
%% GSC's.  These are test code.
%%
%% nudge is the grassroots social network's befriend with an unguarded act of
%% its own, so that a contract compiled here has an unguarded class, which
%% neither of GSC's two has.  Written as GSC writes a contract:
%%
%%   befriend(p?, q?) :  not friend(q), +friend(q)    not friend(p), +friend(p)
%%   nudge(p, q)      :  friend(q), not nudged(q),    friend(p), +nudged_by(p)
%%                       +nudged(q)
%%
%% nudge is guarded at neither role, its role graph joined by the friend atom its first role requires, so it meets volition; its first role requires friend(q), naming the other role and every variable of the atoms it deletes and adds, so the contract is effective (vGLP 099f876, Section 5.4, "Act schemas as local specifications").  Its schema-binding at a binding determines an unguarded part, its opener the person in its first role (ibid.), whose machine proposes it as an own transaction, the attempt asking nobody and the other participant voting by its machine (Section 5.4, "The compilation"; Definitions "Proposing" and "Starting and Wounding").  nudge/self.glp plays it.
%%
%% introduce is befriend with a three-party act, by which a person introduces
%% two of its friends to each other, so that a contract compiled here has a
%% class of three participants, an attempt that asks two (vGLP 2026-10-11 22:59
%% UTC, Q3, Udi approved):
%%
%%   befriend(p?, q?)      :  at p  not friend(q), +friend(q)
%%                             at q  not friend(p), +friend(p)
%%   introduce(p?, q?, r?) :  at p  friend(q), friend(r), +introduced(q, r)
%%                             at q  not friend(r), +friend(r)
%%                             at r  not friend(q), +friend(q)
%%
%% introduce is guarded at every role, so the guard set of each of its parts is its three participants; the friend atoms its first role requires join its role graph.  introduce/self.glp plays it among three agents.
%%
%% gnudge is nudge with a second schema g determining the same transactions, nudge(a, b) and g(b?, a), g guarded at its first role, so that a class with an unguarded part has a guarded part whose first role is another person (vGLP 2026-10-12 08:26 UTC, Q-B; vGLP #15, Code_inbox.md, 2026-10-19 10:50 UTC, item 4):
%%
%%   befriend(p?, q?) :  not friend(q), +friend(q)    not friend(p), +friend(p)
%%   nudge(p, q)      :  friend(q), not nudged(q),    friend(p), +nudged_by(p)
%%                       +nudged(q)
%%   g(q?, p)         :  friend(p), +nudged_by(p)     friend(q), not nudged(q),
%%                                                    +nudged(q)
%%
%% The schema-bindings nudge(a, b) and g(b, a) require and forbid the same atoms at each participant and mark different people, so the class of nudge(a, b) has two parts: nudge(a, b)'s, unguarded, and g(b, a)'s, guarded by b, which the request type proposes (vGLP 099f876, Section 5.4, "Act schemas as local specifications" and "The compilation").  The opener of the unguarded part is the least person in the first role of its schema-bindings, a, and not the least of a and b, which the person in g's first role would make b where b precedes a: b's agent, which finds among its own transactions the unguarded parts of the unguarded schemas with b in their first role, would never find it, and no agent would open it.  gnudge/self.glp plays it.
%%
%% childsafe is a child-safe-like contract (vGLP, Appendix A, "An Example:
%% Child-Safe Befriending"), so that a contract compiled here has a class of
%% four participants: a parent enrols a child, and two children befriend under
%% their two parents, who are friends, guarded by all four (vGLP 2026-10-13 12:05 UTC, item 5):
%%
%%   befriend(p?, q?)      :  at p  not friend(q), +friend(q)
%%                             at q  not friend(p), +friend(p)
%%   enrol(p?, r?)         :  at p  not child(r), +child(r)
%%                             at r  not parent(p), +parent(p)
%%   cbefriend(r?, s?, p?, q?) :
%%                             at r  parent(p), not friend(s), +friend(s)
%%                             at s  parent(q), not friend(r), +friend(r)
%%                             at p  child(r), friend(q), +approved(r, s)
%%                             at q  child(s), friend(p), +approved(s, r)
%%
%%   acquaint(p?, q?)      :  at p  +knows(q)
%%                             at q  +knows(p)
%%
%% acquaint is GKK's Acquaintance (programs/gsc/GKK.glp) without its identity atoms, which childsafe has not, adding no friend atom, so that the proposer of cbefriend, the child in its first role, which its pragma names before its button and so its base (vGLP 0b51a60, Section 5.4), comes to know the other child and the other parent before it proposes: "Propose ... is taken only where p knows every agent it sends a message to" (vGLP, Definition "Proposing"), and befriending them would add the friend atom cbefriend forbids (vGLP #24, Code_inbox.md, 2026-11-07 18:52 UTC, Red 1).  childsafe/self.glp plays it.
%%
%% link is a three-party act guarded at its initiator alone, so that two
%% initiators can propose attempts whose participants meet in two agents
%% outside both initiators, each prepared on another's attempt: the deadlock
%% that wound-wait resolves (vGLP 2026-10-13 17:53 UTC, item 7; vGLP 49cd9f7,
%% Definition "Canonical CVA Platform", Wound and Yield):
%%
%%   befriend(p?, q?) :  at p  not friend(q), +friend(q)
%%                       at q  not friend(p), +friend(p)
%%   link(p?, q, r)   :  at p  friend(q), friend(r), +linked(q, r)
%%                       at q  friend(p), +via(p, r)
%%                       at r  friend(p), +via(p, q)
%%
%% The persons in q and r are not asked: their machines vote, the friendship
%% each required of p its consent.  link/self.glp
%% plays it.
%%
%% friends is befriend with friend declared reflexive and named the contract's
%% introduction predicate, so that a contract compiled here has an
%% introduction rule: it gives each person p every two persons q and r other
%% than p with friend(q) and friend(r) in p's state, whose agents p's agent
%% introduces to each other by Introduce peers (vGLP, Section 3.2, Definition
%% "Introduction Rule, Introduce Peers"; Section 5.4, the paragraph on act
%% schemas; vGLP 2026-10-16 13:53 UTC, C.3):
%%
%%   befriend(p?, q?) :  at p  not friend(q), +friend(q)
%%                       at q  not friend(p), +friend(p)
%%   greet(p?, q)     :  at p  friend(q), +greeted
%%                       at q  +greeting
%%   cheer(p?)        :  at p  -greeted, +cheered
%%
%% greeted, greeting and cheered are of arity zero, so a state holds a count
%% of each; greet(p, p) sends its two roles to one person, neither adding or
%% deleting an atom naming the other, so they act together there, friend(p)
%% holding at p, friend being reflexive, and greeted and greeting both added;
%% and each cheer deletes one greeted (vGLP, Section 5.4, the paragraph on act
%% schemas; vGLP 2026-10-16 13:53 UTC, C.4).
%%
%% friends/self.glp plays it.
%%
%% waves is befriend with two schemas that delete and add the same atoms at the same participants and are of two classes, so that a contract compiled here has two classes of the same participants and atoms, each with its own parts, guard sets and domains (vGLP 9c819f5, Section 5.4, "Act schemas as local specifications": "The classes are those of the contract's equivalence, generated by relating two transactions when one schema-binding determines both"; vGLP #14, Code_inbox.md, 2026-10-18 13:35 UTC):
%%
%%   befriend(p?, q?) :  at p  not friend(q), +friend(q)
%%                       at q  not friend(p), +friend(p)
%%   wave(p?, q)      :  at p  friend(q), +waved(q)
%%                       at q  friend(p), +waved_at(p)
%%   hail(p?, q?)     :  at p  not friend(q), +waved(q)
%%                       at q  not friend(p), +waved_at(p)
%%
%% wave requires friend(q) at p and hail forbids it, so no transaction is determined by both: a friend waves guarded by themselves, and a stranger hails guarded by both.  waves/self.glp plays it.
%%
%% parts is befriend with a class of two parts, so that a contract compiled here has a class whose parts have different domains: "every class [t] is the union of sets of its members, its parts", and "each schema-binding determines a part [t]_j of its class" (vGLP 099f876, Definition "Local Specification, Part, Guard Set, Opener" and Section 5.4, "Act schemas as local specifications"):
%%
%%   befriend(p?, q?) :  at p  not friend(q), +friend(q)
%%                       at q  not friend(p), +friend(p)
%%   mint(p?)         :  at p  +coin
%%   tap(p?, q)       :  at p  friend(q), +tapped(q)
%%                       at q  friend(p), +tapped_by(p)
%%   pat(p?, q)       :  at p  friend(q), coin, +tapped(q)
%%                       at q  friend(p), coin, +tapped_by(p)
%%
%% tap and pat delete and add the same atoms and neither forbids an atom the other requires, so they are one class, of two parts, each guarded by p, the person its schema-binding marks: tap's, and pat's, which requires a coin at both.  The request propose([t]_j) names the class by a guarded part, and the agent proposes, among the guarded parts of [t] it guards and is ready for, the one it has proposed least recently; each participant checks its precondition in the attempt's part (Section 5.4, "The compilation"; Definition "Proposing", Start).  parts/self.glp plays it.
%%
%% opens is befriend with two unguarded schemas u1 and u2 that determine the same transactions, u1(a, b) and u2(b, a), so that a contract compiled here has a class of two unguarded parts with different openers: "The opener of an unguarded part is the least, in the order of identifiers, of the people in the first role of the schema-bindings that determine it" (vGLP 099f876, Section 5.4, "Act schemas as local specifications"; vGLP #15, Code_inbox.md, 2026-10-19 10:50 UTC, item 3, answering the fault Code #10 reported at 10:16 UTC):
%%
%%   befriend(p?, q?) :  at p  not friend(q), +friend(q)
%%                       at q  not friend(p), +friend(p)
%%   mark(p?, q)      :  at p  friend(q), not w(q), +w(q)
%%                       at q  friend(p), +marked_by(p)
%%   rmark(p?, q)     :  at p  friend(q), not r(q), +r(q)
%%                       at q  friend(p), +rmarked_by(p)
%%   u1(p, q)         :  at p  r(q), not x(q), +x(q)
%%                       at q  w(p), +y(p)
%%   u2(p, q)         :  at p  w(q), not y(q), +y(q)
%%                       at q  +x(p)
%%
%% u1(a, b) and u2(b, a) delete and add the same atoms and neither forbids an atom the other requires, so they are one class, of two unguarded parts: u1(a, b)'s, opened by a, and u2(b, a)'s, opened by b.  Each unguarded schema's first role requires an atom naming the other role, so the contract is effective.  Where bob, after alice in the order of identifiers, holds w(alice) and alice holds no r(bob), the part of u2(bob, alice) holds and the part of u1(alice, bob) does not: bob opens u2(bob, alice)'s part, which his agent finds through u2's first role, requiring w(alice) at him.  An opener taken over the class would be alice, the least person in the first role of its schema-bindings, whose agent finds the class only through u1's first role, requiring r(bob) at her, and nobody would open it.  opens/self.glp plays it.
%% groups is befriend with a group whose closing is one act of its leader and of every member the leader lists, GSC's listed role a[listed(*, n)] (GSC 8064cfb, Appendix D, Definition "Role"), so that a contract compiled here has a listed role (vGLP f5f1644, Section 5.4, "Act schemas as local specifications"); a group is named by its leader and n, a speech act, with no name term:
%%
%%   befriend(p?, q?)   :  at p  not friend(q), +friend(q)
%%                         at q  not friend(p), +friend(p)
%%   create(a? ; n)     :  at a  not member(a, n), not closed(n), +member(a, n),
%%                               +listed(a, n)
%%   join(a?, q? ; n)   :  at a  member(a, n), friend(q), +listed(q, n)
%%                         at q  friend(a), not member(a, n), +member(a, n)
%%   close(a?, a[listed(*, n)] ; n) :
%%                         at a                 -listed(a, n), +closed(n)
%%                         at a[listed(*, n)]   -member(a, n)
%%
%% A schema-binding of close determines a part for each list L of the people of its listed role, the persons q with listed(q, n) in the state of the person in a, and the base person requires that it list exactly the people of L (ibid.).  Its request name is close(a, n), and the base agent, on its person's request, completes L from its listed atoms.  The base, a, is close's only guarding role, as Section 5.4 asks of a schema with a listed role.  groups/self.glp plays it.
%%
%% counter is befriend with a counter, an unguarded class always open to its agent once its person has begun counting, so that a contract compiled here has an agent that takes an own transaction on every own trigger it reads, without end, and still reads its other triggers between them: "The agent goal takes its own transactions one at a time, one on each own trigger it reads.  It writes an own trigger when it starts, after each other trigger it reads unless an own trigger it has written is still unread, and after each own transaction it takes, so that it reads its other triggers between its own transactions" (vGLP 6c8c663, Section 5.4, "The compilation"; vGLP #15 Cowork to Code, 2026-10-19 14:20 UTC).  The contract language has no integers and no arithmetic, an argument of an atom being a role, a variable or a name term, so a counter is not written n(k) to n(k+1); a state is a multiset, holding a count of each atom of arity zero, as friends' greeted, so count adds one tick:
%%
%%   befriend(p?, q?) :  at p  not friend(q), +friend(q)
%%                       at q  not friend(p), +friend(p)
%%   begin(a?)        :  at a  not counting, +counting
%%   count(a)         :  at a  counting, +tick
%%
%% count is guarded at no role and has one role and no variable, so the atoms its role requires need name no other role and no variable, and the contract is effective; its schema-binding at a determines an unguarded part opened by a, in the domain of a's function wherever a holds counting, which no act deletes.  begin, guarded by a, lets the play choose whose agent counts.  counter/self.glp plays it.
%%
%% merges is befriend with groups, a leader merging two of their groups in one act of the leader and of every member the leader lists in either, so that a contract compiled here has a schema with two listed roles of one base, a[listed(*, n1)] and a[listed(*, n2)] (vGLP c649c0d, Section 5.4, "Act schemas as local specifications": "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles"; vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC); a group is named by its leader and a speech act, and its leader does not list themself:
%%
%%   befriend(p?, q?)   :  at p  not friend(q), +friend(q)
%%                         at q  not friend(p), +friend(p)
%%   create(a? ; n)     :  at a  not leads(n), +leads(n)
%%   join(a?, q? ; n)   :  at a  leads(n), friend(q), +listed(q, n)
%%                         at q  friend(a), not member(a, n), +member(a, n)
%%   merge(a?, a[listed(*, n1)], a[listed(*, n2)] ; n1, n2) :
%%                         at a                  leads(n1), -leads(n2), +merged(n2, n1)
%%                         at a[listed(*, n1)]   member(a, n1), +merged(n2, n1)
%%                         at a[listed(*, n2)]   -member(a, n2), +member(a, n1)
%%
%% The members of n2 become members of n1, the members of n1 record the merger, and the leader leads n2 no more.  A schema-binding of merge determines a part for each pair of lists, of the people of each listed role, the persons q with listed(q, n1), and with listed(q, n2), in the state of the person in a, and the base person requires that it list exactly the people of each (ibid.).  Its request name is merge(a, n1, n2), and the base agent, on its person's request, completes both lists from its listed atoms.  The base of both listed roles, a, is merge's only guarding role, as Section 5.4 asks.  merges/self.glp plays it.
%%
%% coins is a currency of coins of one unit, GC's mint, swap and pay (Currencies' programs/currencies/coins/GC.glp, compiled here as the currency, currency/), less GKK's identity and knows, which GC requires, and less redeem, so that a contract compiled here has a guard whose standing approval its machine can no longer carry out, and refuses at once, and a swap its other party declines (vGLP f0acbc1, Section 3.2, "The protocol": "A machine that cannot carry out a transaction its person approved refuses it, so that the approval ends and the person is told"; vGLP #18 Cowork to Code, 2026-10-20 10:44 UTC, item 6).  Without redeem, a swap that gives a person's coin back to them is of no class with a redeem's part, guarded by one party alone, so the swap asks its other party:
%%
%%   mint(p?)         :  at p  +coin(p)
%%   swap(p?, q? ; v, u) :
%%                       at p  +coin(v), -coin(u)
%%                       at q  +coin(u), -coin(v)
%%   pay(p?, q)       :  at p  -coin(q)
%%                       at q  +coin(q)
%%
%% A state is a multiset, so a person may mint and hold several coins of one person.  coins/self.glp plays it.
%%
%% wardclose is a group whose child leader's parent closes it, CSSN's child_close (programs/cssn/CSSN.glp) with no identity, so that a contract compiled here has a schema with a listed role whose base is not a guarding role: its guarded part is opened by the person in its first role, the child, on its guard's request, the parent's (vGLP f0acbc1, Section 5.4, "Act schemas as local specifications": "and so is the opener of a guarded part determined by a schema with a listed role whose base is not a guarding role, where that person is not a guard of the part"; Definition "Local Specification, Part, Guard Set, Opener, Request"; vGLP #18 Cowork to Code, 2026-10-20 10:44 UTC, item 6):
%%
%%   befriend(p?, q?)   :  at p  not friend(q), +friend(q)
%%                         at q  not friend(p), +friend(p)
%%   adopt(p?, r?)      :  at p  not parenting(r), +parenting(r)
%%                         at r  not parent(p), +parent(p)
%%   create(a? ; n)     :  at a  not member(a, n), not closed(n), +member(a, n),
%%                               +listed(a, n)
%%   join(a?, q? ; n)   :  at a  member(a, n), friend(q), +listed(q, n)
%%                         at q  friend(a), not member(a, n), +member(a, n)
%%   child_close(r, p?, r[listed(*, n)] ; n) :
%%                         at r                 parent(p), -listed(r, n), +closed(n)
%%                         at p                 parenting(r)
%%                         at r[listed(*, n)]   -member(r, n)
%%
%% child_close's one guarding role is p, its listed role's base r its first role, and no other schema determines a transaction of its class, so the contract is a local specification (ibid.).  Its request name is child_close(r, p, n), whose parts, one for each list of the people r lists, have the opener r; the parent's Request of rho_N goes to the child's machine, which completes the list from its own listed atoms and proposes the part, naming the request.  wardclose/self.glp plays it.
%%
%% days is a contract that requires the day, so that a contract compiled here has an agent that reads a calendar, a stream of dates the device writes, and holds today(d), d the last date read, beside its app state, which no schema adds or deletes and which a schema requires and constrains a numeric variable by (vGLP, Section 5.4, "Act schemas as local specifications": "as GB's advance requires date(t) and today(d) with t<d ..., so that it is proposed once a day; what the first date is, the contract says"):
%%
%%   dawn(p?)      :  at p  not dated, +dated, +date(0)
%%   advance(p)    :  at p  today(d), -date(t), +date(d), d > t
%%
%% The first date is 0.  advance is unguarded, opened by p, t local to p's role and d bound by the today(d) p's state holds, so it is proposed once a day by the own-trigger Propose: on a date d past the date p holds, and not again until the next.  days/self.glp plays it.
%%
%% linear is a contract whose constraints are in GSC's form, "a conjunction of linear equalities and inequalities over its value variables and values" (GSC bcc1891, Definition "Schema with values"; programs/gsc/self.glp at GSC-unob3 62fb0342), so that a contract compiled here has an unguarded schema whose added atom names a variable an equality gives once the atoms its first role requires bind the others (vGLP, Section 5.4, "Act schemas as local specifications": "or the constraint gives the variable finitely many values once those are bound"):
%%
%%   start(p?)             :  at p  not started, +started, +level(0)
%%   refuel(p? ; k)        :  at p  started, +k fuel
%%   climb(p ; t, t1)      :  at p  -fuel, -level(t), +level(t1)         t1 = t + 2 and t < 6
%%   mark(p ; t, m)        :  at p  level(t), not marked(m), +marked(m)  3m = t + 3
%%
%% climb and mark are unguarded, opened by p; t is local to p's role in each, bound by the level p holds; climb's t1 is the one value its equality gives, and its inequality holds below 6; mark's m is the whole number its equality gives, where there is one, at the levels 0 and 6 and at no level between.  linear/self.glp plays it.
%%
%% forms is a contract with a safe formula in a schema's body, local to the role holding its atoms, which "the machine of the person in that role evaluates in its own state" (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications"), in GSC's term form, qschema(Name, Vars, Bound, Constraint, Roles, Conjuncts, Forms) (programs/gsc/self.glp):
%%
%%   start(p?)             :  at p  not started, +started
%%   block(p? ; k)         :  at p  started, +blocked(k)
%%   arm(p?)               :  at p  started, not armed, +armed
%%   tick(p)               :  at p  armed, not ticked, +ticked
%%                            and not exists b (blocked(b) at p and b > 2)
%%
%% tick is unguarded, opened by p, its body's formula local to p's role, an existential quantifier whose anchor p holds, its condition a constraint on the variable it binds: p's machine takes tick where no blocked(b) of its state has b > 2.  forms/self.glp plays it.
%%
%% counts is a contract with a count and a sum of a quantifier's instances in a constraint, local to the role holding the anchor, the functions min and floor, and environment predicates, cap and wt, values the contract declares and does not fix, given when the platform is deployed and held from startup (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications"; vGLP #24, Code_inbox.md, 2026-11-07 13:11 UTC, 3 and 4):
%%
%%   start(p?)             :  at p  not started, +started
%%   fill(p)               :  at p  cap(d), +tok
%%                            | #{tok at p} < d
%%   heavy(p)              :  at p  cap(d), not heavy, +heavy
%%                            | sum of w over wt(w) at p >= min(2 floor(d), 100)
%%
%% start is its introductory act; fill and heavy are unguarded, opened by p, d local to p's role and bound by the cap(d) p's state holds from startup; the count of tok counts each copy, so p's machine takes fill until it holds d copies, and the sum of the weights given at deployment decides heavy.  Section VG runs its agent with no person.
%%
%% shares is a contract with a quantified conjunct whose instances the attempt names, binding no listed role and with a conditional literal at a role other than the one holding its anchor, as GCC's appoint's "every person Alice lists as appointed, Bob lists too" (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "A conjunct with a listed role, or with conditional literals at a role other than the one holding its anchor, is local to its base; the base's machine finds its instances, the attempt names them, and every participant takes them as arguments of the transaction"):
%%
%%   start(p?)             :  at p  not started, +started
%%   acquaint(p?, q?)      :  at p  started, not knows(q), +knows(q); at q likewise
%%   note(p? ; x)          :  at p  started, knows(x), not noted(x), +noted(x)
%%   share(p?, q?)         :  at p  started, knows(q); at q  started, knows(p), not shared(p), +shared(p)
%%                            and forall x (noted(x) at p -> seen(x) at q)
%%   owe(p? ; x, k)        :  at p  started, knows(x), not owes(x, k), +owes(x, k)
%%   pass(p?, q?)          :  at p  started, knows(q); at q  started, knows(p), not passed(p), +passed(p)
%%                            and forall x, k (owes(x, k) at p -> owed(x, k) at q)
%%
%%   tally(p?, q?)         :  at p  started, knows(q); at q  started, knows(p), not tallied(p), +tallied(p)
%%                            and forall x, k (owes(x, k) at p -> owed_by(x) at q)
%%   clear(p?, q?)         :  at p  started, knows(q); at q  started, knows(p), not cleared(p), +cleared(p)
%%                            and forall x (noted(x) at p -> not seen(x) at q)
%%   settle(p?)            :  at p  started, not settled, +settled
%%                            and forall x (noted(x) at p -> done(x) at p)
%%   wipe(p?)              :  at p  started, settled, not wiped, +wiped
%%                            and forall x (noted(x) at p -> not noted(x) at p)
%%   pour(p? ; real v)     :  at p  started, +poured(v)      | v > 0
%%   drain(p? ; real v)    :  at p  started, -poured(v), +drained(v)
%%
%% share's conjunct is local to its base, p, the role holding its anchor: p's machine finds the persons it has noted, the attempt names them, share(p, q, L), and q sees each.  tally's instance is restricted to x, the one variable its literal names, without repetition: "the attempt names them, each restricted to the variables the conjunct's literals name and without repetition" (vGLP fe12932, Section 5.4), tally(p, q, L), L a list of persons.  clear deletes a conditional literal at q, which q's state need not hold: "yielding d_p less the deleted atoms, those of the conditional literals at each instance of their conjunct ... included, which d_p need not hold" (ibid.).  settle's and wipe's conjuncts are local to p, the role holding their anchor, p finding the instances in its own state and adding or deleting its literals at each (vGLP #24, Code_inbox.md, 2026-11-07 18:52 UTC, (i), (ii) and (iv)).  pour and drain have a real variable, real(v) among their variables (vGLP fb40cff, Section 5.4: "a value variable, whose type, a whole number or a real, the schema writes with it"; GSC's reader, programs/gsc/self.glp, Arg), pour's v a field and drain's local to p, found in its state.  pass's conjunct binds two variables, a person and a number, an instance an assignment of both (vGLP 2f1dc92; vGLP #24, Code_inbox.md, 2026-11-07 17:19 UTC), each i(x, k) in the class term, pass(p, q, L).  Section VG runs their printed procedures on given states.
%% ---------------------------------------------------------------------------

%% The contract, as programs/gsc/self.glp writes it, with the numbers act schemas allow (GSC 9231074, Section 3.2): num(X) the numeric variable X where X is a name and the number X where X is a number, times(K, A) the atom A with the multiplicity K, and nschema(Name, Vars, Constraint, Roles) a schema with a constraint on its numeric variables.
NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
%% real(X) a real value variable among a schema's variables, as programs/gsc/self.glp writes it (GSC 8b1460f; vGLP fb40cff, Section 5.4).
%% any the wildcard of a cleared atom, as programs/gsc/self.glp writes it (GSC 327e035).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; num(Constant) ; real(Constant) ; any.
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Mult      ::= Atom ; times(Arg, Atom) ; rest(Arg, Arg, Atom).
Mults     ::= [] ; [Mult | Mults].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
%% qlisted(Base, Rho, Args, Bound) a listed role among the arguments of its anchor at any place, as programs/gsc/self.glp writes one not at the second (vGLP b413fe1, Section 5.4).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant)
            ; listed(Integer, Constant, Args) ; qlisted(Integer, Constant, Args, Args).
RoleSpec  ::= rs(Guard, Mults, Mults, Mults, Atoms)
            ; crs(RoleKind, Guard, Mults, Mults, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Constraint ::= true ; and(Constraint, Constraint)
             ; eq(Expr, Expr) ; le(Expr, Expr) ; lt(Expr, Expr)
             ; ge(Expr, Expr) ; gt(Expr, Expr) ; succ(Arg, Arg)
             ; or(Constraint, Constraint)
             ; signed(Arg, Arg) ; unsigned(Arg, Arg) ; program(Expr).
Expr       ::= Arg ; plus(Expr, Expr) ; minus(Expr, Expr) ; mul(Expr, Expr)
             ; fn(Constant, Exprs) ; cardinality(Args, Arg, Atom, Form)
             ; sum(Args, Arg, Atom, Form, Expr)
             ; author_of(Arg) ; item_of(Arg).
Exprs      ::= [] ; [Expr | Exprs].
%% A schema's second argument is its variables, pvar(X), svar(Y) and num(X), in the order of its head (GSC 0228e79, Definition "Act schema").
Schema    ::= schema(Constant, Args, RoleSpecs) ; cschema(Constant, Args, Reaches, RoleSpecs)
            ; nschema(Constant, Args, Constraint, RoleSpecs)
            ; qschema(Constant, Args, Args, Constraint, RoleSpecs, Conjuncts, Forms).
%% A safe formula and a quantified conjunct, as programs/gsc/self.glp writes them.
Form       ::= fa(Arg, Mult) ; fnot(Form) ; fand(Form, Form) ; for(Form, Form)
             ; fexists(Args, Arg, Atom, Form)
             ; fforall(Args, Arg, Atom, Form, Forms)
             ; fcons(Constraint).
Forms      ::= [] ; [Form | Forms].
HMult      ::= hm(Integer, Mult).
HMults     ::= [] ; [HMult | HMults].
Conjunct   ::= conjunct(Args, Integer, Atom, Form, HMults, HMults, Forms).
Conjuncts  ::= [] ; [Conjunct | Conjuncts].
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract) ; environment(Preds, Contract).

%% contract_named(Name, C): the contract named, as contract_named/2 of
%% programs/gsc gives GSC's.
procedure contract_named(Constant?, Declared).
contract_named(nudge, C?) :- nudge(C).
contract_named(introduce, C?) :- introduce(C).
contract_named(gnudge, C?) :- gnudge(C).
contract_named(childsafe, C?) :- childsafe(C).
contract_named(link, C?) :- link(C).
contract_named(friends, reflexive([friend], C?)) :- friends(C).
contract_named(waves, C?) :- waves(C).
contract_named(parts, C?) :- parts(C).
contract_named(opens, C?) :- opens(C).
contract_named(groups, C?) :- groups(C).
contract_named(counter, C?) :- counter(C).
contract_named(merges, C?) :- merges(C).
contract_named(coins, C?) :- coins(C).
contract_named(wardclose, C?) :- wardclose(C).
contract_named(numbers, C?) :- numbers(C).
contract_named(bonds, C?) :- bonds(C).
contract_named(intros, C?) :- intros(C).
contract_named(days, C?) :- days(C).
contract_named(linear, C?) :- linear(C).
contract_named(forms, C?) :- forms(C).
contract_named(counts, environment([cap, wt], C?)) :- counts(C).
contract_named(shares, C?) :- shares(C).
contract_named(published, C?) :- published(C).
contract_named(leaves, C?) :- leaves(C).
contract_named(readings, C?) :- readings(C).
contract_named(backed, C?) :- backed(C).

%% introduction_named(Name, I): the introduction predicate the contract named
%% names, introduction(e), or none, no_introduction (vGLP, Section 5.4, the
%% paragraph on act schemas).
Intro     ::= no_introduction ; introduction(Constant).
procedure introduction_named(Constant?, Intro).
introduction_named(nudge, no_introduction).
introduction_named(introduce, no_introduction).
introduction_named(gnudge, no_introduction).
introduction_named(childsafe, no_introduction).
introduction_named(link, no_introduction).
introduction_named(friends, introduction(friend)).
introduction_named(waves, no_introduction).
introduction_named(parts, no_introduction).
introduction_named(opens, no_introduction).
introduction_named(groups, no_introduction).
introduction_named(counter, no_introduction).
introduction_named(merges, no_introduction).
introduction_named(coins, no_introduction).
introduction_named(wardclose, no_introduction).
introduction_named(numbers, no_introduction).
introduction_named(bonds, no_introduction).
introduction_named(intros, no_introduction).
introduction_named(days, no_introduction).
introduction_named(linear, no_introduction).
introduction_named(forms, no_introduction).
introduction_named(counts, no_introduction).
introduction_named(shares, no_introduction).
introduction_named(published, no_introduction).
introduction_named(leaves, no_introduction).
introduction_named(readings, no_introduction).
introduction_named(backed, no_introduction).

%% The pragmas of each contract, the words its app shows, as pragmas.sh prints them from a NAME.txt (compiler/pragmas.sh, its header; compiler/self.glp, Pragmas): "the compiler prints a platform only from a contract with pragmas, and refuses one with none" (vGLP ffcb093, Section 5.4, "The contract's words"), so each contract here that compile.sh prints carries a minimal pragmas term, one tab and one button for each guarded schema, the act proposed at its first guarding role and every other guarding role asked (vGLP #22 Cowork to Code, Code_inbox.md, 2026-10-31 12:55 UTC, item 3).  Each act's fields name every place of the act but the proposer's and one, the row's, since "the compiler refus[es] a line whose fields leave more than one place unnamed" (vGLP dd37d2a, Section 5.4, "The contract's words"): a field left empty, '""', names none, the fields aligned with the places in the order of the schema, its roles but its listed roles, then its variables (compiler/cvac.glp, field_places).  These are test code, and their words the compiler's fixtures, not a contract's.
PWord      ::= text(String) ; person(Integer).
PWords     ::= [] ; [PWord | PWords].
PSentences ::= [] ; [PWords | PSentences].
Said       ::= none ; said(PSentences).
Strings    ::= [] ; [String | Strings].
Ints       ::= [] ; [Integer | Ints].
PList      ::= list(String, Preds).
PLists     ::= [] ; [PList | PLists].
FType      ::= ft(Integer, Constant).
FTypes     ::= [] ; [FType | FTypes].
PAct       ::= act(Constant, String, Strings, Said, String, Proposer)
             ; act(Constant, String, Strings, Said, String, Proposer, FTypes).
Proposer   ::= by(Ints).
PActs      ::= [] ; [PAct | PActs].
%% A standing declaration, standing(Schema, Start, Stop) (vGLP 7c631b1, Section 5.4, "The contract's words"; compiler/self.glp).
PStand     ::= standing(Constant, Constant, Constant).
PStands    ::= [] ; [PStand | PStands].
Pragmas    ::= pragmas(PLists, PActs) ; pragmas(PLists, PActs, PStands).

procedure pragmas_named(Constant?, Pragmas).
pragmas_named(nudge, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1]))])).
pragmas_named(introduce, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(introduce, '"Introduce"', ['""', '""', '"Person"'], said([[], [person(1), text('" asks."')], [person(1), text('" asks."')]]), '"Friends"', by([1]))])).
pragmas_named(gnudge, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(g, '"G"', [], none, '"Friends"', by([1]))])).
pragmas_named(childsafe, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(acquaint, '"Acquaint"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(enrol, '"Enrol"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(cbefriend, '"Cbefriend"', ['""', '""', '"Parent"', '"Their parent"'], said([[], [person(1), text('" asks."')], [person(1), text('" asks."')], [person(1), text('" asks."')]]), '"Friends"', by([1]))])).
pragmas_named(link, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(link, '"Link"', ['""', '""', '"Person"'], none, '"Friends"', by([1]))])).
pragmas_named(friends, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(greet, '"Greet"', [], none, '"Friends"', by([1])),
     act(cheer, '"Cheer"', [], none, '"Friends"', by([1]))])).
pragmas_named(waves, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(wave, '"Wave"', [], none, '"Friends"', by([1])),
     act(hail, '"Hail"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1]))])).
pragmas_named(parts, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(mint, '"Mint"', [], none, '"Friends"', by([1])),
     act(tap, '"Tap"', [], none, '"Friends"', by([1])),
     act(pat, '"Pat"', [], none, '"Friends"', by([1]))])).
pragmas_named(opens, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(mark, '"Mark"', [], none, '"Friends"', by([1])),
     act(rmark, '"Rmark"', [], none, '"Friends"', by([1]))])).
pragmas_named(groups, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(create, '"Create"', [], none, '"Friends"', by([1])),
     act(join, '"Join"', ['""', '""', '"Group"'], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(close, '"Close"', [], none, '"Friends"', by([1]))])).
pragmas_named(counter, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(begin, '"Begin"', [], none, '"Friends"', by([1]))])).
pragmas_named(merges, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(create, '"Create"', [], none, '"Friends"', by([1])),
     act(join, '"Join"', ['""', '""', '"Group"'], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(merge, '"Merge"', ['""', '""', '"Into"'], none, '"Friends"', by([1]))])).
pragmas_named(coins, pragmas([list('"Coins"', [coin])],
    [act(mint, '"Mint"', [], none, '"Coins"', by([1])),
     act(swap, '"Swap"', ['""', '""', '"Given"', '"Wanted"'], said([[], [person(1), text('" asks."')]]), '"Coins"', by([1])),
     act(pay, '"Pay"', [], none, '"Coins"', by([1]))])).
pragmas_named(wardclose, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(adopt, '"Adopt"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(create, '"Create"', [], none, '"Friends"', by([1])),
     act(join, '"Join"', ['""', '""', '"Group"'], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(child_close, '"Child close"', ['""', '""', '"Group"'], none, '"Friends"', by([2]))])).
pragmas_named(numbers, pragmas([list('"Friends"', [friend])],
    [act(befriend, '"Befriend"', [], said([[], [person(1), text('" asks."')]]), '"Friends"', by([1])),
     act(start, '"Start"', [], none, '"Friends"', by([1])),
     act(refuel, '"Refuel"', [], none, '"Friends"', by([1])),
     act(claim, '"Claim"', ['""', '""', '"Amount"'], none, '"Friends"', by([1])),
     act(mint, '"Mint"', ['""', '"Amount"'], none, '"Friends"', by([1])),
     act(spend, '"Spend"', ['""', '"Amount"'], none, '"Friends"', by([1])),
     act(burn, '"Burn"', ['""', '"Held"', '"Amount"'], none, '"Friends"', by([1]))])).
pragmas_named(bonds, pragmas([list('"Contacts"', [knows])],
    [act(establish, '"Establish"', [], none, '"Contacts"', by([1])),
     act(acquaint, '"Acquaint"', [], said([[], [person(1), text('" asks."')]]), '"Contacts"', by([1])),
     act(dawn, '"Dawn"', [], none, '"Contacts"', by([1])),
     act(mint, '"Mint"', [], none, '"Contacts"', by([1])),
     act(mint_bond, '"Mint bond"', ['""', '"Date"', '"Amount"'], none, '"Contacts"', by([1])),
     act(swap_cb, '"Swap cb"', ['""', '""', '"Issuer"', '"Amount"', '"Bond issuer"', '"Date"', '"Bonds"'], said([[], [person(1), text('" asks."')]]), '"Contacts"', by([1])),
     act(redeem_bc, '"Redeem bc"', ['""', '""', '"Date"', '"Redeemer"'], none, '"Contacts"', by([1]))])).
pragmas_named(intros, pragmas([list('"Contacts"', [knows])],
    [act(acquaint, '"Acquaint"', [], said([[], [person(1), text('" asks."')]]), '"Contacts"', by([1])),
     act(introduce, '"Introduce"', ['""', '""', '"Person"'], said([[], [person(1), text('" asks."')]]), '"Contacts"', by([1])),
     act(open, '"Open"', [], none, '"Contacts"', by([1])),
     act(peek, '"Peek"', [], none, '"Contacts"', by([1])),
     act(post, '"Post"', [], none, '"Contacts"', by([1])),
     act(arrive, '"Arrive"', [], none, '"Contacts"', by([1])),
     act(leave, '"Leave"', [], none, '"Contacts"', by([1]))],
    [standing(greet, arrive, leave)])).
pragmas_named(days, pragmas([list('"Dates"', [date])],
    [act(dawn, '"Dawn"', [], none, '"Dates"', by([1]))])).
pragmas_named(linear, pragmas([list('"Levels"', [level])],
    [act(start, '"Start"', [], none, '"Levels"', by([1])),
     act(refuel, '"Refuel"', [], none, '"Levels"', by([1]))])).
pragmas_named(forms, pragmas([list('"Blocks"', [blocked])],
    [act(start, '"Start"', [], none, '"Blocks"', by([1])),
     act(block, '"Block"', ['""', '"level"'], none, '"Blocks"', by([1])),
     act(arm, '"Arm"', [], none, '"Blocks"', by([1]))])).
pragmas_named(counts, pragmas([list('"Tokens"', [tok]), list('"Weights"', [wt])],
    [act(start, '"Start"', [], none, '"Tokens"', by([1]))])).
pragmas_named(shares, pragmas([list('"Notes"', [noted]), list('"Seen"', [seen])],
    [act(start, '"Start"', [], none, '"Notes"', by([1])),
     act(acquaint, '"Acquaint"', [], said([[], [person(1), text('" asks."')]]), '"Notes"', by([1])),
     act(note, '"Note"', [], none, '"Notes"', by([1])),
     act(share, '"Share"', [], said([[], [person(1), text('" shares the persons they noted."')]]), '"Notes"', by([1])),
     act(owe, '"Owe"', ['"amount"'], none, '"Notes"', by([1])),
     act(pass, '"Pass"', [], said([[], [person(1), text('" passes on what they owe."')]]), '"Notes"', by([1])),
     act(tally, '"Tally"', [], said([[], [person(1), text('" tallies whom they owe."')]]), '"Notes"', by([1])),
     act(clear, '"Clear"', [], said([[], [person(1), text('" clears what you saw of their notes."')]]), '"Notes"', by([1])),
     act(settle, '"Settle"', [], none, '"Notes"', by([1])),
     act(wipe, '"Wipe"', [], none, '"Notes"', by([1])),
     act(pour, '"Pour"', ['"amount"'], none, '"Notes"', by([1])),
     act(drain, '"Drain"', [], none, '"Notes"', by([1]))])).
pragmas_named(published, pragmas([list('"Items"', [item])],
    [act(publish, '"Publish"', ['""', '"Program"'], none, '"Items"', by([1])),
     act(note, '"Note"', ['""', '"Text"'], none, '"Items"', by([1]))])).
pragmas_named(leaves, pragmas([list('"Programs"', [installed])],
    [act(install, '"Install"', ['""', '"Program"'], none, '"Programs"', by([1])),
     act(invite, '"Invite"', ['""', '"Person"'], said([[], [person(1), text('" invites you."')]]), '"Programs"', by([1])),
     act(leave, '"Leave"', [], none, '"Programs"', by([1]))])).

pragmas_named(readings, pragmas([list('"Levels"', [level]), list('"Contacts"', [knows])],
    [act(start, '"Start"', [], none, '"Levels"', by([1])),
     act(bump, '"Bump"', [], none, '"Levels"', by([1])),
     act(outrank, '"Outrank"', [], none, '"Levels"', by([1])),
     act(watch, '"Watch"', [], none, '"Levels"', by([1])),
     act(unwatch, '"Unwatch"', [], none, '"Levels"', by([1])),
     act(nudge, '"Nudge"', [], none, '"Contacts"', by([1])),
     act(vouch, '"Vouch"', ['""', '"Text"'], none, '"Contacts"', by([1])),
     act(meet, '"Meet"', ['"Person"', '""'], said([[person(2), text('" asks to meet you."')], []]), '"Contacts"', by([2]))],
    [standing(trail, watch, unwatch)])).
pragmas_named(backed, pragmas([list('"Treasurers"', [officer]), list('"Reserve"', [reserve])],
    [act(acquaint, '"Acquaint"', ['""', '"Person"'], said([[], [person(1), text('" asks."')]]), '"Treasurers"', by([1])),
     act(appoint, '"Appoint"', ['""', '"Person"'], said([[], [person(1), text('" asks you to be a treasurer."')]]), '"Treasurers"', by([1])),
     act(deposit, '"Deposit"', ['""', '"Amount"'], none, '"Reserve"', by([1])),
     act(owe, '"Owe"', ['""', '""', '"Amount"'], none, '"Treasurers"', by([1])),
     act(repay, '"Repay"', [], none, '"Treasurers"', by([1])),
     act(join, '"Join"', [], said([[], [person(1), text('" asks you to join its treasurers."')]]), '"Treasurers"', by([1]))])).

procedure nudge(Contract).
nudge([schema(befriend, [],
         [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
          rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
       schema(nudge, [],
         [rs(unguarded, [atom(nudged, [role(2)])], [], [atom(friend, [role(2)])],
                        [atom(nudged, [role(2)])]),
          rs(unguarded, [atom(nudged_by, [role(1)])], [], [atom(friend, [role(1)])],
                        [])])]).

procedure introduce(Contract).
introduce([schema(befriend, [],
             [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
              rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
           schema(introduce, [],
             [rs(guarded, [atom(introduced, [role(2), role(3)])], [],
                          [atom(friend, [role(2)]), atom(friend, [role(3)])], []),
              rs(guarded, [atom(friend, [role(3)])], [], [], [atom(friend, [role(3)])]),
              rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])])])]).

procedure gnudge(Contract).
gnudge([schema(befriend, [],
          [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
           rs(guarded, [atom(friend, [role(1)])], [], [], [atom(friend, [role(1)])])]),
        schema(nudge, [],
          [rs(unguarded, [atom(nudged, [role(2)])], [], [atom(friend, [role(2)])],
                         [atom(nudged, [role(2)])]),
           rs(unguarded, [atom(nudged_by, [role(1)])], [], [atom(friend, [role(1)])],
                         [])]),
        schema(g, [],
          [rs(guarded, [atom(nudged_by, [role(2)])], [], [atom(friend, [role(2)])],
                       []),
           rs(unguarded, [atom(nudged, [role(1)])], [], [atom(friend, [role(1)])],
                         [atom(nudged, [role(1)])])])]).

procedure childsafe(Contract).
childsafe([schema(befriend, [],
             [rs(guarded, [atom(friend, [role(2)])], [], [], [atom(friend, [role(2)])]),
