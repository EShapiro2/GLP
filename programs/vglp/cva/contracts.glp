         [rs(guarded, [atom(started, [])], [], [], [atom(started, [])])]),
       schema(block, [num(k)],
         [rs(guarded, [atom(blocked, [num(k)])], [], [atom(started, [])], [])]),
       schema(arm, [],
         [rs(guarded, [atom(armed, [])], [], [atom(started, [])], [atom(armed, [])])]),
       qschema(tick, [], [num(b)], true,
         [rs(unguarded, [atom(ticked, [])], [], [atom(armed, [])], [atom(ticked, [])])],
         [],
         [fnot(fexists([num(b)], role(1), atom(blocked, [num(b)]), fcons(gt(num(b), num(2)))))])]).

%% published: a program condition (vGLP b413fe1, Section 5.4, "Speech-act schemas as local specifications": a value may be "a program, a GLP module as text, which the runtime recognises", and a constraint is over "program(u), that the value u is a program"): publish(p? ; x) adds item(x) and published(x) at p where the item of x is a program, program(item_of(x)), a condition naming no local variable, local to every role and checked where the schema is bound; note(p? ; x) adds item(x), any item.
procedure published(Contract).
published([nschema(publish, [svar(x)], program(item_of(svar(x))),
          [rs(guarded, [atom(item, [svar(x)]), atom(published, [svar(x)])], [], [], [atom(item, [svar(x)])])]),
        schema(note, [svar(x)],
          [rs(guarded, [atom(item, [svar(x)])], [], [], [atom(item, [svar(x)])])])]).

%% leaves: a listed role at the third argument of its anchor (vGLP b413fe1, Section 5.4, "Speech-act schemas as local specifications": "a listed role is an agent variable bound by a quantifier whose anchor an agent role, its base, holds, the variable at any of the anchor's arguments"), as GPD's leave lists Bob by participant(Alice, p, Bob) (programs/social/graph/GPD.glp), written as GSC's reader writes it, qlisted(Base, Rho, Args, Bound), the role among the anchor's arguments: install(p? ; x) adds installed(x) at p; invite(p?, q? ; x), p holding installed(x), adds participant(x, q) at p and installed(x) and participant(x, p) at q; leave(p?, q[participant(p, x, *)] ; x) deletes installed(x) and clears participant(x, _) at p, and deletes participant(x, p) at each q that p lists.
procedure leaves(Contract).
leaves([schema(install, [svar(x)],
          [rs(guarded, [atom(installed, [svar(x)])], [], [], [atom(installed, [svar(x)])])]),
        schema(invite, [svar(x)],
          [rs(guarded, [atom(participant, [svar(x), role(2)])], [], [atom(installed, [svar(x)])], [atom(participant, [svar(x), role(2)])]),
           rs(guarded, [atom(installed, [svar(x)]), atom(participant, [svar(x), role(1)])], [], [], [atom(installed, [svar(x)])])]),
        qschema(leave, [svar(x)], [role(2)], true,
          [rs(guarded, [], [atom(installed, [svar(x)]), atom(participant, [svar(x), any])], [], []),
           crs(qlisted(1, participant, [svar(x), role(2)], [role(2)]), unguarded, [], [atom(participant, [svar(x), role(1)])], [], [])],
          [conjunct([role(2)], 1, atom(participant, [svar(x), role(2)]), fcons(true), [], [], [fnot(fa(role(2), atom(participant, [svar(x), role(1)])))])],
          [])]).

%% readings: variables read at a role and a condition across roles (vGLP 566c186 and 6abbed9, Section 5.4, "Speech-act schemas as local specifications": "A variable is also local to a role, and read there, where atoms the schema requires at that role hold it, no atom it deletes, forbids or adds at that role and no atom it requires, deletes or forbids at another role holds it, and atoms it adds at other roles do"; "a conjunct that names variables local to two roles or more is of the part's condition"; "the values it finds for the variables read at its role, in each way its state allows, are the readings of its state, which its vote yes carries; the initiator chooses readings under which the conjuncts of the condition hold, and the commit tells them to every participant, whose effect is under them").  As GAI's GnW:3, the ward's attestation read at the ward and recorded at the person who comes to know it: vouch(p? ; y) adds attestation(y) at p, and meet(c?, b?) requires attestation(y) at c, which keeps it, and adds record(c, y) at b, b proposing it, as Bob proposes GAI's agent_acquaint, and no field naming y.  As a treasurer's count against their community's: start(p?) adds level(0), bump(p ; t, t1) raises it, and outrank(p?, q ; a, b) requires level(a) at p and level(b) at q, a and b each local to its role, with a > b of the part's condition, which the initiator checks on the readings; trail(p?, q ; a, b), with a < b, is the same standing on watch until unwatch; nudge(p?, q) adds nudged(q) at p and nudged_by(p) at q, a change of q's state.
procedure readings(Contract).
readings([schema(start, [],
            [rs(guarded, [atom(started, []), atom(level, [num(0)])], [], [], [atom(started, [])])]),
          nschema(bump, [num(t), num(t1)], eq(num(t1), plus(num(t), num(1))),
            [rs(guarded, [atom(level, [num(t1)])], [atom(level, [num(t)])], [atom(started, [])], [])]),
          nschema(outrank, [num(a), num(b)], gt(num(a), num(b)),
            [rs(guarded, [atom(outranks, [role(2)])], [], [atom(knows, [role(2)]), atom(level, [num(a)])], [atom(outranks, [role(2)])]),
             rs(unguarded, [atom(outranked, [role(1)])], [], [atom(knows, [role(1)]), atom(level, [num(b)])], [])]),
          schema(watch, [],
            [rs(guarded, [atom(watching, [])], [], [], [atom(watching, [])])]),
          schema(unwatch, [],
            [rs(guarded, [], [atom(watching, [])], [], [])]),
          nschema(trail, [num(a), num(b)], lt(num(a), num(b)),
            [rs(guarded, [atom(trails, [role(2)])], [], [atom(knows, [role(2)]), atom(level, [num(a)])], [atom(trails, [role(2)])]),
             rs(unguarded, [atom(trailed, [role(1)])], [], [atom(knows, [role(1)]), atom(level, [num(b)])], [])]),
          schema(nudge, [],
            [rs(guarded, [atom(nudged, [role(2)])], [], [atom(knows, [role(2)])], [atom(nudged, [role(2)])]),
             rs(unguarded, [atom(nudged_by, [role(1)])], [], [atom(knows, [role(1)])], [])]),
          schema(vouch, [svar(y)],
            [rs(guarded, [atom(attestation, [svar(y)])], [], [], [atom(attestation, [svar(y)])])]),
          schema(meet, [svar(y)],
            [rs(guarded, [atom(knows, [role(2)])], [], [atom(attestation, [svar(y)])], [atom(knows, [role(2)])]),
             rs(guarded, [atom(knows, [role(1)]), atom(record, [role(1), svar(y)])], [], [], [atom(knows, [role(1)])])])]).

%% backed: a safe formula across roles (vGLP 5f55cf3, Section 5.4, "Speech-act schemas as local specifications": "A safe formula of B that is local to no role, its atoms held by two roles or more, each a role of the schema or a listed role its quantifier binds, is of the part's condition ...: the reading of a participant's state then holds, beside the values of the variables read at its role, the atoms of that state that the atoms of the formula held by its role match, a variable local to another role and a variable the formula's quantifiers bind matching any value, and the initiator evaluates the formula on the readings, each atom, anchor, count and sum taken in the reading of the person who holds it"), as GBCC:1's cc_join (programs/go/GBCC.glp): acquaint(o?, b?) adds knows at both; appoint(o?, c?) makes c a treasurer of o, officer(c) at o and officer_of(o) at c; deposit(c? ; k) adds k reserve at c; owe(o?, c ; k) adds k owes(c) at o, c an officer of it; repay(o? ; c) deletes one owes(c) at o and adds repaid(c); and join(o?, b?, c[officer(o, c)]), o and b knowing each other, makes b a treasurer, each treasurer c recording cotreasurer(b), only if every treasurer c of o stays backed, the owes(c) o holds at most the reserve c holds, a formula held by o and by c.
procedure backed(Contract).
backed([schema(acquaint, [],
          [rs(guarded, [atom(knows, [role(2)])], [], [], [atom(knows, [role(2)])]),
           rs(guarded, [atom(knows, [role(1)])], [], [], [atom(knows, [role(1)])])]),
        schema(appoint, [],
          [rs(guarded, [atom(officer, [role(2)])], [], [], [atom(officer, [role(2)])]),
           rs(guarded, [atom(officer_of, [role(1)])], [], [], [atom(officer_of, [role(1)])])]),
        schema(deposit, [num(k)],
          [rs(guarded, [times(num(k), atom(reserve, []))], [], [], [])]),
        schema(owe, [num(k)],
          [rs(guarded, [times(num(k), atom(owes, [role(2)]))], [], [atom(officer, [role(2)])], []),
           rs(unguarded, [], [], [atom(officer_of, [role(1)])], [])]),
        schema(repay, [pvar(c)],
          [rs(guarded, [atom(repaid, [pvar(c)])], [atom(owes, [pvar(c)])], [], [])]),
        qschema(join, [], [role(3)], true,
          [rs(guarded, [atom(officer, [role(2)])], [], [atom(knows, [role(2)])], [atom(officer, [role(2)])]),
           rs(guarded, [atom(officer_of, [role(1)])], [], [atom(knows, [role(1)])], [atom(officer_of, [role(1)])]),
           crs(qlisted(1, officer, [role(3)], [role(3)]), unguarded, [atom(cotreasurer, [role(2)])], [], [], [])],
          [conjunct([role(3)], 1, atom(officer, [role(3)]), fcons(true), [], [], [fa(role(3), atom(cotreasurer, [role(2)]))])],
          [fforall([role(3)], role(1), atom(officer, [role(3)]), fcons(true),
             [fcons(le(cardinality([], role(1), atom(owes, [role(3)]), fcons(true)), cardinality([], role(3), atom(reserve, []), fcons(true))))])])]).
