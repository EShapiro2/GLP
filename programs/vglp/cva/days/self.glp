%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract days
%% (../contracts.glp, contract_named(days, C): dawn and an advance that
%% requires the day, today(d)), platform.vglp, which
%% programs/vglp/cva/compile.sh prints from it.  The contract requires the
%% day, so its agent reads the date from its phone whenever it reads a
%% trigger, and holds today(d), d that date, beside its app state (vGLP,
%% Section 5.4, "Speech-act schemas as local specifications": "we assume that
%% every phone has the correct date, the date in UTC, and the compiled agent
%% reads it from its phone whenever it computes a condition").  It takes no
%% calendar.  The view does not show today(d), no atom of the machine state
%% the platform mapping reads.
%%
%% play_days: one agent, alice, her person scripted (../self.glp), who sets
%%   the machine's clock (the step clock(T), GLP's set_clock/1).  On day 1
%%   alice requests dawn, which adds dated and date(0), and then
%%   advance(alice, 1), the day it records named by its proposer and checked
%%   against the date of her phone: it requires date(t) and today(d) with
%%   d > t, and date(1) replaces date(0).  She requests advance(alice, 1)
%%   again, and her machine refuses it as unable, the day not past the date
%%   she holds; and advance(alice, 3), refused as unable, the day not yet 3.
%%   On day 3 she requests advance(alice, 3) once more, and date(3) replaces
%%   date(1).  The run then suspends.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------


%% The scripted person's steps and log on this platform (../self.glp): the grants of its Drawn, an approval step naming a class, the atoms of its machine state, the approvals pending and the reasons of its views, and its tabs.
ScriptSteps ::= Steps(Drawn, Class, Atom, Approved, Reason).
ScriptLog   ::= Logged(Class, Drawn, Atom, Approved, Reason, Tab).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

exported procedure play_days(Stream(ScriptLog)).
play_days(LA?) :-
    platform # agent(alice, [], _, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], [
        clock(86400000),
        own([A1], propose(dawn(A1?))),
        wait(holds(date(0))),
        own([A2], propose(advance(A2?, 1))),
        wait(holds(date(1))),
        own([A3], propose(advance(A3?, 1))),
        wait(refused(advance(alice, 1), alice, unable)),
        own([A5], propose(advance(A5?, 3))),
        wait(refused(advance(alice, 3), alice, unable)),
        clock(259200000),
        own([A4], propose(advance(A4?, 3))),
        wait(holds(date(3)))]), LA).
