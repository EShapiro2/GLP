%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract parts (../contracts.glp, contract_named(parts, C)), platform.vglp, which programs/vglp/cva/compile.sh prints from it: two-phase commit coordinated by the initiating agent (vGLP, Section 3.2, Definition "Canonical CVA Platform").  It runs two agents, alice and bob, their persons scripted and paced on their screens (../self.glp), and gives each person's log, the views with gave(K, A) where the person answers an approval question, and the network's log of the cargoes it carries.
%%
%% tap(alice, bob) and pat(alice, bob) are one class of two parts, pat's requiring a coin at alice and at bob (vGLP c0bea08, Definition "Local Specification, Part, Opener"; Section 5.4, "Act schemas as local specifications").  "The request propose([t]_j) names the class by a part, and the agent proposes, among the parts of [t] it is ready for, the one it has proposed least recently, keeping the parts it has proposed in the order it last proposed them" (Section 5.4, "The compilation"); an attempt names its part, and each participant checks its precondition in that part (Definition "Proposing", Start).
%%
%% play_parts: alice and bob come to know each other and befriend, attempt 1.  alice, holding no coin, requests pat(alice, bob): she is ready for tap's part alone, and proposes it, attempt 2, which commits.  She mints a coin, attempt 3, a class of one participant applied at its Propose.  She requests tap(alice, bob): ready for both parts, she proposes pat's, which she has not proposed, attempt 4; bob, holding no coin, is outside the domain of his effect in pat's part, though inside it in tap's, and his machine votes no, unasked, and the attempt aborts.  Her agent, tallying his no, writes the notice refused(pat(alice, bob), bob), the attempt naming its part (vGLP c44769f, Section 5.4, "The compilation"); seeing it on her screen, she requests tap(alice, bob) again and proposes tap's part, proposed less recently than pat's, attempt 5, which commits; and, once her screen shows two taps, she requests pat(alice, bob) and proposes pat's part, now the less recent, attempt 6, which aborts as attempt 4 did, its notice written again.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; mint(Peer) ; tap(Peer, Peer) ; pat(Peer, Peer).
Proposal ::= befriend(Peer, Peer) ; mint(Peer) ; tap(Peer, Peer) ; pat(Peer, Peer).
Request  ::= propose(Proposal) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= friend(Peer) ; coin ; tapped(Peer) ; tapped_by(Peer).
Output   ::= view(List(Atom), List(Key)) ; refused(Class, Key) ; yielded(Class).
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_parts(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_parts(LA?, LB?, N?) :-
    pair([req(known(bob)), wait(known(bob)),
          own([A1], propose(befriend(A1?, bob))),
          wait(holds(friend(bob))),
          own([A2], propose(pat(A2?, bob))),
          wait(holds(tapped(bob))),
          own([A3], propose(mint(A3?))),
          wait(holds(coin)),
          own([A4], propose(tap(A4?, bob))),
          wait(refused(pat(alice, bob), bob)),
          own([A5], propose(tap(A5?, bob))),
          wait(has(tapped(bob), 2)),
          own([A6], propose(pat(A6?, bob)))],
         [req(known(alice)), wait(known(alice)),
          approval(befriend(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
