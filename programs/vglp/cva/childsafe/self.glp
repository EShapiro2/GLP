%% ---------------------------------------------------------------------------
%% The plays of the canonical CVA platform of vGLP's contract childsafe
%% (../contracts.glp, contract_named(childsafe, C): befriend, enrol and a
%% four-party cbefriend guarded by all four), platform.vglp, which
%% programs/vglp/cva/compile.sh prints from it: two-phase commit coordinated by
%% the initiating agent (vGLP, Section 3.2, Definition "Canonical CVA
%% Platform"), whose initiator knows every participant before it proposes.
%% It runs its agents, their persons scripted and paced on their screens
%% (../self.glp), and gives each person's log, the views with gave(K, A)
%% where the person answers an approval question, and the network's log of the cargoes it
%% carries.
%%
%% play_childsafe: four agents, alice and bob parents, carol alice's child and
%%   dave bob's.  alice enrols carol and bob dave, each child asked on its
%%   approval question; bob then befriends alice, who is asked.  alice and dave each
%%   request the other known, the Discover the initiator needs before it
%%   proposes; alice proposes cbefriend(carol, dave, alice, bob), carol, dave
%%   and bob are asked and answer yes, and it commits at all four.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; enrol(Peer, Peer)
           ; cbefriend(Peer, Peer, Peer, Peer).
Proposal ::= befriend(Peer, Peer) ; enrol(Peer, Peer)
           ; cbefriend(Peer, Peer, Peer, Peer).
Request  ::= propose(Proposal) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= friend(Peer) ; child(Peer) ; parent(Peer) ; approved(Peer, Peer).
Output   ::= view(List(Atom), List(Key)).
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_childsafe(Stream(_), Stream(_), Stream(_), Stream(_),
    Stream(Sent(Cargo))).
play_childsafe(LA?, LB?, LC?, LD?, N?) :-
    quartet([req(known(carol)), wait(known(carol)),
             own([A1], propose(enrol(A1?, carol))),
             wait(holds(child(carol))),
             req(known(bob)),
             approval(befriend(bob, alice), yes),
             wait(holds(friend(bob))),
             req(known(dave)), wait(known(dave)),
             own([A2], propose(cbefriend(carol, dave, A2?, bob)))],
            [req(known(dave)), wait(known(dave)),
             own([B1], propose(enrol(B1?, dave))),
             wait(holds(child(dave))),
             req(known(alice)), wait(known(alice)),
             own([B2], propose(befriend(B2?, alice))),
             wait(holds(friend(alice))),
             approval(cbefriend(carol, dave, alice, bob), yes)],
            [req(known(alice)),
             approval(enrol(alice, carol), yes),
             approval(cbefriend(carol, dave, alice, bob), yes)],
            [req(known(bob)), req(known(alice)),
             approval(enrol(bob, dave), yes),
             approval(cbefriend(carol, dave, alice, bob), yes)],
            LA, LB, LC, LD, N).

%% alice, bob, carol and dave, each with its dispatcher and scripted person,
%% their networks joined.
procedure quartet(Steps(Drawn)?, Steps(Drawn)?, Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_),
    Stream(_), Stream(_), Stream(Sent(Cargo))).
quartet(SA, SB, SC, SD, LA?, LB?, LC?, LD?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    platform # agent(carol, InC?, OutC, TC, AsC),
    platform # dispatch(AsC?, ch(GC?, DC), MC),
    to_person(MC?, TC?),
    person(DC?, GC, ps(nosess, [], [], SC?), LC),
    platform # agent(dave, InD?, OutD, TD, AsD),
    platform # dispatch(AsD?, ch(GD?, DD), MD),
    to_person(MD?, TD?),
    person(DD?, GD, ps(nosess, [], [], SD?), LD),
    merge(OutA?, OutB?, Net1),
    merge(OutC?, OutD?, Net2),
    merge(Net1?, Net2?, Net),
    route4(Net?, alice, InA, bob, InB, carol, InC, dave, InD, N).
