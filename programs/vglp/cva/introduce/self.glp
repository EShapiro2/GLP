%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract introduce
%% (../contracts.glp, contract_named(introduce, C): befriend and a three-party
%% introduce; vGLP 2026-10-11 22:59 UTC, Q3, Udi approved), platform.vglp,
%% which programs/vglp/cva/compile.sh prints from it: two-phase commit
%% coordinated by the initiating agent (vGLP, Section 3.2, Definition
%% "Canonical CVA Platform").  It runs three agents, alice, bob and carol,
%% their persons scripted and paced on their screens (../self.glp), and gives
%% each person's log, the views with gave(K, A) where the person answers a
%% approval question, and the network's log of the cargoes it carries.
%%
%% play_introduce: alice befriends bob and carol, each asked and answering
%%   yes.  She proposes introducing bob and carol; both are in its one guard
%%   set and asked, each on an approval question.  bob answers no, so alice tallies his no
%%   and aborts, and tells the outcome to both; carol's question is no longer
%%   pending once her Outcome closes the attempt, so her approval question is closed by the
%%   program (vGLP, Section 5.4, "The compilation"), and
%%   the yes she gives it, once she is asked on the next attempt, reaches no goal.  alice, seeing nothing of the abort on her screen, requests the introduction again on each request question until her screen shows bob and carol introduced (../self.glp, again(R, C)): those read while her attempt holds her lock are dropped, the next is proposed, attempt 4, both answer yes, and it commits at all three; one she made before she saw the commit, read after it, is proposed, attempt 5, and the machines of bob and carol, friends by then, vote no.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; introduce(Peer, Peer, Peer).
Proposal ::= befriend(Peer, Peer) ; introduce(Peer, Peer, Peer).
Request  ::= propose(Proposal) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= friend(Peer) ; introduced(Peer, Peer).
Output   ::= view(List(Atom), List(Key)).
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_introduce(Stream(_), Stream(_), Stream(_),
    Stream(Sent(Cargo))).
play_introduce(LA?, LB?, LC?, N?) :-
    trio([req(known(bob)), req(known(carol)),
          wait(known(bob)), wait(known(carol)),
          own([A1], propose(befriend(A1?, bob))),
          wait(holds(friend(bob))),
          own([A2], propose(befriend(A2?, carol))),
          wait(holds(friend(carol))),
          own([A3], propose(introduce(A3?, bob, carol))),
          again(propose(introduce(alice, bob, carol)), holds(introduced(bob, carol)))],
         [req(known(alice)), wait(known(alice)),
          approval(befriend(alice, bob), yes),
          approval(attempt(alice, 3, 3, introduce(alice, bob, carol)), no),
          approval(attempt(alice, 4, 4, introduce(alice, bob, carol)), yes)],
         [req(known(alice)), wait(known(alice)),
          approval(befriend(alice, carol), yes),
          wait(asked(attempt(alice, 4, 4, introduce(alice, bob, carol)))),
          approval(attempt(alice, 3, 3, introduce(alice, bob, carol)), yes),
          approval(attempt(alice, 4, 4, introduce(alice, bob, carol)), yes)],
         LA, LB, LC, N).

%% alice, bob and carol, each with its dispatcher and scripted person, their
%% networks joined.
procedure trio(Steps(Drawn)?, Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(_),
    Stream(Sent(Cargo))).
trio(SA, SB, SC, LA?, LB?, LC?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    platform # agent(carol, InC?, OutC, TC, AsC),
    platform # dispatch(AsC?, ch(GC?, DC), MC),
    to_person(MC?, TC?),
    person(DC?, GC, ps(nosess, [], [], SC?), LC),
    merge(OutA?, OutB?, Net1),
    merge(Net1?, OutC?, Net),
    route3(Net?, alice, InA, bob, InB, carol, InC, N).
