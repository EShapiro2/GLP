%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract introduce
%% (../contracts.glp, contract_named(introduce, C): befriend and a three-party
%% introduce; vGLP 2026-10-11 22:59 UTC, Q3, Udi approved), platform.vglp,
%% which programs/vglp/cva/compile.sh prints from it: two-phase commit
%% coordinated by the initiating agent (vGLP, Section 3.2, Definition
%% "Canonical CVA Platform").  It runs three agents, alice, bob and carol,
%% their persons scripted and paced on their threads (../self.glp), and gives
%% each person's log, the thread with gave(K, A) where the person answers a
%% card, and the network's log of the cargoes it carries.
%%
%% play_introduce: alice befriends bob and carol, each asked and answering
%%   yes.  She proposes introducing bob and carol; both are in its one guard
%%   set and asked, each on a card.  bob answers no, so alice tallies his no
%%   and aborts, and tells the outcome to both; carol's question is no longer
%%   pending once her Outcome closes the attempt, so her card is closed by the
%%   program (vGLP, Section 5.4, Definition "Compilation of the Canonical
%%   Platform"), and
%%   the yes she gives it after takes no Answer.  alice proposes it again, both
%%   answer yes, and it commits at all three.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; introduce(Peer, Peer, Peer).
Request  ::= propose(Class) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Txn      ::= propose(Attempt) ; start(Attempt) ; answer(Attempt) ; vote(Attempt)
           ; tally(Attempt) ; commit(Attempt) ; yield(Attempt) ; wound(Attempt, Attempt) ; outcome(Attempt)
           ; discover(Peer).
Session  ::= session(Stream(Request)?, Stream(Txn)).
Card     ::= card(Attempt, YesNo?).
Question ::= session_w(Session) ; card_w(Card).
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_))).

exported procedure play_introduce(Stream(_), Stream(_), Stream(_),
    Stream(Sent(Cargo))).
play_introduce(LA?, LB?, LC?, N?) :-
    trio([req(known(bob)), req(known(carol)),
          wait(discover(bob)), wait(discover(carol)),
          req(propose(befriend(alice, bob))),
          wait(commit(attempt(alice, 1, 1, befriend(alice, bob)))),
          req(propose(befriend(alice, carol))),
          wait(commit(attempt(alice, 2, 2, befriend(alice, carol)))),
          req(propose(introduce(alice, bob, carol))),
          wait(tally(attempt(alice, 3, 3, introduce(alice, bob, carol)))),
          req(propose(introduce(alice, bob, carol)))],
         [req(known(alice)), wait(discover(alice)),
          card(befriend(alice, bob), yes),
          card(attempt(alice, 3, 3, introduce(alice, bob, carol)), no),
          card(attempt(alice, 4, 4, introduce(alice, bob, carol)), yes)],
         [req(known(alice)), wait(discover(alice)),
          card(befriend(alice, carol), yes),
          wait(outcome(attempt(alice, 3, 3, introduce(alice, bob, carol)))),
          card(attempt(alice, 3, 3, introduce(alice, bob, carol)), yes),
          card(attempt(alice, 4, 4, introduce(alice, bob, carol)), yes)],
         LA, LB, LC, N).

%% alice, bob and carol, each with its dispatcher and scripted person, their
%% networks joined.
procedure trio(Steps?, Steps?, Steps?, Stream(_), Stream(_), Stream(_),
    Stream(Sent(Cargo))).
trio(SA, SB, SC, LA?, LB?, LC?, N?) :-
    platform # agent(alice, InA?, OutA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), _),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), _),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    platform # agent(carol, InC?, OutC, AsC),
    platform # dispatch(AsC?, ch(GC?, DC), _),
    person(DC?, GC, ps(nosess, [], [], SC?), LC),
    merge(OutA?, OutB?, Net1),
    merge(Net1?, OutC?, Net),
    route3(Net?, alice, InA, bob, InB, carol, InC, N).
