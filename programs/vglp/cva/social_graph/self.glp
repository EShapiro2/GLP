%% ---------------------------------------------------------------------------
%% The plays of the canonical CVA platform of GSC's social graph
%% (GSC's, programs/gsc/GSG.glp, the social graph),
%% platform.vglp, which programs/vglp/cva/compile.sh prints from it: two-phase
%% commit coordinated by the initiating agent (vGLP, Section 3.2, Definition
%% "Canonical CVA Platform").  Each runs two agents, alice and bob, their
%% persons scripted and paced on their threads (../self.glp), and gives each
%% person's log, the thread with gave(K, A) where the person answers an approval question,
%% and the network's log of the cargoes it carries.  Each person's first request
%% establishes their identity, establish(P) (GSG:1, Identity), a class of one
%% participant guarded by them and applied at its Propose, every other role of
%% the contract requiring identity.  Where a person proposes a class that names
%% their agent, the script holds a hole there and the person writes into it
%% the agent's own key, which the request question shows (../self.glp,
%% own(Ks, R)).
%%
%% play_befriend: alice proposes befriending bob; bob, in its guard set, is
%%   asked on his approval question and answers yes, and his Vote, an own transaction, votes yes;
%%   alice tallies his yes and commits, and bob's Outcome commits.
%% play_unfriend: befriended, bob proposes unfriending alice; unfriend is one
%%   class guarded by either party, its guard sets {alice} and {bob} (vGLP,
%%   Section 5.4, the paragraph on act schemas), so the attempt asks nobody and
%%   alice's machine votes yes; befriended again, alice proposes unfriending
%%   bob, and bob's machine votes yes.
%% play_refused: alice proposes befriending bob and bob answers no; the
%%   else-branch records his no, his Vote, an own transaction, votes no, and the
%%   attempt aborts at both; alice proposes it
%%   again, bob is asked again and answers yes, and it commits.
%% play_menu: alice's request questions show her agent's own key, alice, and
%%   the persons it knows (vGLP 321127a, Section 5.4): the first, asked when
%%   her agent starts, none; she makes bob known and, once he is, proposes
%%   befriending him, and the request question asked on reading that request
%%   shows bob.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Speech   ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
Class    ::= establish(Peer) ; befriend(Peer, Peer) ; unfriend(Peer, Peer).
Proposal ::= establish(Peer) ; befriend(Peer, Peer) ; unfriend(Peer, Peer).
Request  ::= propose(Proposal) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= identity ; friend(Peer).
Output   ::= List(Atom).
Approval ::= approval(Attempt, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_befriend(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_befriend(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), req(known(bob)), wait(discover(bob)),
          own([A2], propose(befriend(A2?, bob)))],
         [own([B1], propose(establish(B1?))), req(known(alice)), wait(discover(alice)),
          approval(befriend(alice, bob), yes)],
         LA, LB, N).

exported procedure play_unfriend(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_unfriend(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), req(known(bob)), wait(discover(bob)),
          own([A2], propose(befriend(A2?, bob))),
          wait(commit(attempt(alice, 2, 2, befriend(alice, bob)))),
          wait(outcome(attempt(bob, 3, 3, unfriend(bob, alice)))),
          own([A3], propose(befriend(A3?, bob))),
          wait(commit(attempt(alice, 4, 4, befriend(alice, bob)))),
          own([A4], propose(unfriend(A4?, bob)))],
         [own([B1], propose(establish(B1?))), req(known(alice)), wait(discover(alice)),
          approval(attempt(alice, 2, 2, befriend(alice, bob)), yes),
          wait(outcome(attempt(alice, 2, 2, befriend(alice, bob)))),
          own([B2], propose(unfriend(B2?, alice))),
          approval(attempt(alice, 4, 4, befriend(alice, bob)), yes)],
         LA, LB, N).

exported procedure play_refused(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_refused(LA?, LB?, N?) :-
    pair([own([A1], propose(establish(A1?))), req(known(bob)), wait(discover(bob)),
          own([A2], propose(befriend(A2?, bob))),
          wait(tally(attempt(alice, 2, 2, befriend(alice, bob)))),
          own([A3], propose(befriend(A3?, bob)))],
         [own([B1], propose(establish(B1?))), req(known(alice)), wait(discover(alice)),
          approval(attempt(alice, 2, 2, befriend(alice, bob)), no),
          approval(attempt(alice, 3, 3, befriend(alice, bob)), yes)],
         LA, LB, N).

exported procedure play_menu(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_menu(LA?, LB?, N?) :-
    pair([look, own([A1], propose(establish(A1?))), req(known(bob)), wait(discover(bob)),
          own([A2], propose(befriend(A2?, bob))),
          wait(commit(attempt(alice, 2, 2, befriend(alice, bob)))), look],
         [own([B1], propose(establish(B1?))), req(known(alice)), wait(discover(alice)),
          approval(befriend(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks
%% joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
