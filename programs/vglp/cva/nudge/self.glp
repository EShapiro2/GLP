%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract nudge
%% (../contracts.glp, contract_named(nudge, C): the social network's befriend
%% and an unguarded nudge), platform.vglp, which programs/vglp/cva/compile.sh
%% prints from it: two-phase commit coordinated by the initiating agent (vGLP,
%% Section 3.2, Definition "Canonical CVA Platform").  It runs two agents,
%% alice and bob, their persons scripted and paced on their threads
%% (../self.glp), and gives each person's log, the thread with gave(K, A) where
%% the person answers a card, and the network's log of the cargoes it carries.
%%
%% play_nudge: alice proposes befriending bob, bob is asked and answers yes,
%%   and it commits.  Each is then the opener of the unguarded class of nudge
%%   whose first role it is in (vGLP, Section 5.4, the paragraph on act
%%   schemas), and its machine proposes it on a tick (Section 5.4, Definition
%%   "Compilation of the Canonical Platform": Propose of an unguarded class, by
%%   its opener, on a tick), the attempt asking nobody and the other's machine
%%   voting on its start.  Both propose at once, their attempts of one rank,
%%   alice's with priority, she preceding bob in the order of identifiers
%%   (vGLP 49cd9f7, Definition "Attempt, Priority, ..."): bob, holding his own
%%   attempt prepared, holds alice's start waiting and wounds his attempt,
%%   which aborts; alice holds his start waiting, her lock set, and takes it,
%%   the attempt closed, after its abort.  bob then takes her start and votes
%%   yes, and her nudge commits at both; bob proposes again, his attempt
%%   keeping the rank of the wounded one, and it commits at both.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; nudge(Peer, Peer).
Request  ::= propose(Class) ; known(Peer).
YesNo    ::= yes ; no.
Decision ::= commit ; abort.
Attempt  ::= attempt(Peer, Integer, Integer, Class).
Cargo    ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision)
           ; yield(Attempt).
Content  ::= hello(Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Txn      ::= propose(Attempt) ; start(Attempt) ; answer(Attempt) ; vote(Attempt)
           ; tally(Attempt) ; commit(Attempt) ; yield(Attempt) ; wound(Attempt, Attempt) ; outcome(Attempt)
           ; discover(Peer).
Session  ::= session(Stream(Request)?, Stream(Txn)).
Card     ::= card(Attempt, YesNo?).
Question ::= session_w(Session) ; card_w(Card).
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    Channel(PersonIn, Stream(_))?, Channel(Stream(_), Stream(_))).

exported procedure play_nudge(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_nudge(LA?, LB?, N?) :-
    pair([req(known(bob)), wait(discover(bob)),
          req(propose(befriend(alice, bob)))],
         [req(known(alice)), wait(discover(alice)),
          card(befriend(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks
%% joined.
procedure pair(Steps?, Steps?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), _),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), _),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
