%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract nudge
%% (../contracts.glp, contract_named(nudge, C): the social network's befriend
%% and an unguarded nudge), platform.vglp, which programs/vglp/cva/compile.sh
%% prints from it: two-phase commit coordinated by the initiating agent (vGLP,
%% Section 3.2, Definition "Canonical CVA Platform").  It runs two agents,
%% alice and bob, their persons scripted and paced on their screens
%% (../self.glp), and gives each person's log, the views with gave(K, A) where
%% the person answers an approval question, and the network's log of the cargoes it carries.
%%
%% play_nudge: alice proposes befriending bob, bob is asked and answers yes,
%%   and it commits.  Each is then the opener of the unguarded class of nudge
%%   whose first role it is in (vGLP, Section 5.4, the paragraph on act
%%   schemas), and its machine proposes it as an own transaction (Section 5.4,
%%   "Triggers": Propose of an unguarded class, by its opener, one of the agent's
%%   own transactions), the attempt asking nobody and the other's machine
%%   voting on its start.  Both propose at once, their attempts of one rank,
%%   alice's with priority, she preceding bob in the order of identifiers
%%   (vGLP, Definition "Priority, Waiting, Blocked, Clear"): bob, holding his own
%%   attempt prepared, holds alice's start waiting and wounds his attempt,
%%   which yields, the outcome yield (vGLP f0acbc1, Definitions "Starting and
%%   Wounding" and "Deciding"); alice holds his start waiting, her lock set,
%%   and takes it, the attempt closed, after its yield.  bob then takes her start and votes
%%   yes, and her nudge commits at both; bob proposes again, his attempt
%%   keeping the rank of the wounded one, and it commits at both.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; nudge(Peer, Peer).
Proposal ::= befriend(Peer, Peer).
Request  ::= propose(Proposal).
YesNo    ::= yes ; no.
Reason   ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote     ::= yes ; no(Reason).
Decision ::= commit ; abort(Peer, Reason) ; yield.
Rho      ::= one(Class) ; rho(Proposal).
Names    ::= none ; request(Rho, Integer).
Attempt  ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo    ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
           ; yield(Attempt) ; request(Rho, Integer).
Content  ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= friend(Peer) ; nudged(Peer) ; nudged_by(Peer).
Approved ::= Proposal.
Output   ::= view(List(Atom), List(Key), List(Approved)) ; refused(Approved, Key, Reason).
Asking   ::= Attempt ; hello(Peer, Proposal).
Approval ::= approval(Asking, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_nudge(Stream(_), Stream(_), Stream(Sent(Cargo))).
play_nudge(LA?, LB?, N?) :-
    pair([own([A1], propose(befriend(A1?, bob)))],
         [approval(befriend(alice, bob), yes)],
         LA, LB, N).

%% alice and bob, each with its dispatcher and scripted person, their networks
%% joined.
procedure pair(Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(Sent(Cargo))).
pair(SA, SB, LA?, LB?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    merge(OutA?, OutB?, Net),
    route(Net?, alice, InA, bob, InB, N).
