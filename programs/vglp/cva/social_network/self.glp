%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of GSC's social network (GSC's, programs/gsc/Groups.glp, the checker's groups, the network without provenance), platform.vglp, which programs/vglp/cva/compile.sh prints from it: two-phase commit coordinated by the initiating agent (vGLP, Section 3.2, Definition "Canonical CVA Platform"), a group n held by its leader as leader(n), a member holding member(n, a), a its leader, and the leader listed(q, n) for each member q, and close taking the listed role a[listed(*, n)], every member the leader lists (vGLP a890465, Section 5.4, "Act schemas as local specifications").  It runs four agents, alice, bob, carol and dave, their persons scripted and paced on their screens (../self.glp), and gives each person's log, the views with gave(K, A) where the person answers an approval question, and the network's log of the cargoes it carries (vGLP #16 Cowork to Code, 2026-10-19 15:57 UTC, item 5).
%%
%% play_network: each person establishes their identity (GKK:1), every other role requiring it; alice comes to know bob, carol and dave, acquaint(p?, q?), each asked and answering yes (GKK:2), and then befriends them, each asked and answering yes (GSG:1), befriend requiring knows of the other at each role (programs/gsc/Groups.glp, which extends GSG and GKK).  alice creates the group n, club, create(a? ; n), and is its leader and first member and lists herself (GSN:2).  She adds bob, carol and dave to it, each asked on his or her approval question and answering yes (GSN:3, Join, join(q?, a? ; n), the one who joins first and the leader, its proposer, second), and then sends bob a message, speech(utterance(post), alice), message(q, p? ; x), its receiver first and its sender second, bob's machine voting yes unasked (GSN:1), so bob holds message(alice, x).  bob, a member, having received it, posts x, speech(utterance(hi), bob), to the group: post(a, p? ; x, n), the leader first and the member who posts second, alice's machine voting yes unasked, records posted(x, bob, n) at alice; and alice's machine delivers it to every member it lists, deliver(a, q ; p, x, n), p the member who posted it, an unguarded class it opens, the member's machine voting yes unasked, alice holding group_delivered(p, x, n, q) and the member group_message(p, x, n, alice), bob, who posted it, among them; and to herself, deliver_leader(a ; p, x, n), a class of one participant, alice holding group_delivered(p, x, n, alice) and group_message(p, x, n, alice) (GSN:4, Post and Deliver).  carol, having received it, leaves the group, leave(q?, a ; n), alice's machine voting yes (GSN:3, Leave).  bob, having received it, creates a group of his own, m, den, and adds alice to it, join(alice, bob, m), alice asked and answering yes (GSN:2, GSN:3), and then ends his friendship with alice, unfriend(bob, alice), alice's machine voting yes: its cleared atoms, listed(q, *) and member(*, q) at each role, q the other, end every membership between the two in the same act, bob's in alice's group n at both and alice's in bob's group m at both (vGLP f8127b1, Section 5.4, "Act schemas as local specifications": "the act deletes every atom of the state that it matches, and requires none, as GSN's unfriend ends every membership between the two"; GSN:3, Unfriend, of Groups.txt).  alice, once her machine has delivered x to dave and carol and bob are listed no more, closes the group, close(a?, a[listed(*, n)] ; n): her agent completes the list from the people she lists, close(alice, [alice, dave], n), dave's machine votes yes unasked, and it commits at both, ending every membership in one act (GSN:2, Close).
%%
%% A request is taken or dropped when it is read (vGLP a890465, Section 5.4, "Triggers"; "The compilation": the dispatch "drops the answer where none can be taken"), and Propose takes the agent free and clear (Section 3.2, Definition "Proposing"), so a person here makes a request only once what it waits on shows that their agent's attempts before it have closed: alice adds her members one at a time, and bob posts once alice's message, sent after the last of them joins, shows that she is done.
%%
%% The types of platform.vglp, written again for the declarations of the procedures imported from its compiled module.
%% ---------------------------------------------------------------------------


%% The scripted person's steps and log on this platform (../self.glp): the grants of its Drawn, an approval step naming a class, the atoms of its machine state, the approvals pending and the reasons of its views, and its tabs.
ScriptSteps ::= Steps(Drawn, Class, Atom, Approved, Reason).
ScriptLog   ::= Logged(Class, Drawn, Atom, Approved, Reason, Tab).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

exported procedure play_network(Stream(ScriptLog), Stream(ScriptLog), Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
play_network(LA?, LB?, LC?, LD?, N?) :-
    quartet([own([A1], propose(establish(A1?))), wait(holds(identity)),
             own([M1], propose(acquaint(M1?, bob))), wait(holds(knows(bob))),
             own([M2], propose(acquaint(M2?, carol))), wait(holds(knows(carol))),
             own([M3], propose(acquaint(M3?, dave))), wait(holds(knows(dave))),
             own([A2], propose(befriend(A2?, bob))),
             wait(holds(friend(bob))),
             own([A3], propose(befriend(A3?, carol))),
             wait(holds(friend(carol))),
             own([A4], propose(befriend(A4?, dave))),
             wait(holds(friend(dave))),
             own([A5], propose(create(A5?, club))),
             wait(holds(member(club, alice))),
             own([A7], propose(join(bob, A7?, club))),
             wait(holds(listed(bob, club))),
             own([A9], propose(join(carol, A9?, club))),
             wait(holds(listed(carol, club))),
             own([A11], propose(join(dave, A11?, club))),
             wait(holds(listed(dave, club))),
             own([A13, A14], propose(message(bob, A13?, speech(utterance(post), A14?)))),
             wait(holds(group_delivered(bob, speech(utterance(hi), bob), club, dave))),
             wait(lacks(listed(carol, club))),
             approval(join(alice, bob, den), yes),
             wait(lacks(listed(bob, club))),
             own([A15], propose(close(A15?, club)))],
            [own([B1], propose(establish(B1?))), wait(holds(identity)), approval(acquaint(alice, bob), yes),
             approval(befriend(alice, bob), yes),
             approval(join(bob, alice, club), yes),
             wait(holds(message(alice, speech(utterance(post), alice)))),
             own([B2, B3], propose(post(alice, B2?, speech(utterance(hi), B3?), club))),
             wait(holds(group_message(bob, speech(utterance(hi), bob), club, alice))),
             own([B5], propose(create(B5?, den))),
             wait(holds(member(den, bob))),
             own([B7], propose(join(alice, B7?, den))),
             wait(holds(listed(alice, den))),
             own([B4], propose(unfriend(B4?, alice)))],
            [own([C1], propose(establish(C1?))), wait(holds(identity)), approval(acquaint(alice, carol), yes),
             approval(befriend(alice, carol), yes),
             approval(join(carol, alice, club), yes),
             wait(holds(group_message(bob, speech(utterance(hi), bob), club, alice))),
             own([C2], propose(leave(C2?, alice, club)))],
            [own([D1], propose(establish(D1?))), wait(holds(identity)), approval(acquaint(alice, dave), yes),
             approval(befriend(alice, dave), yes),
             approval(join(dave, alice, club), yes)],
            LA, LB, LC, LD, N).

%% alice, bob, carol and dave, each with its dispatcher and scripted person,
%% their networks joined.
procedure quartet(ScriptSteps?, ScriptSteps?, ScriptSteps?, ScriptSteps?, Stream(ScriptLog), Stream(ScriptLog),
    Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
quartet(SA, SB, SC, SD, LA?, LB?, LC?, LD?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    platform # agent(carol, InC?, OutC, TC, AsC),
    platform # dispatch(AsC?, ch(GC?, DC), MC),
    to_person(MC?, TC?),
    person(DC?, GC, ps(nosess, [], [], SC?), LC),
    platform # agent(dave, InD?, OutD, TD, AsD),
    platform # dispatch(AsD?, ch(GD?, DD), MD),
    to_person(MD?, TD?),
    person(DD?, GD, ps(nosess, [], [], SD?), LD),
    merge(OutA?, OutB?, Net1),
    merge(OutC?, OutD?, Net2),
    merge(Net1?, Net2?, Net),
    route4(Net?, alice, InA, bob, InB, carol, InC, dave, InD, N).
