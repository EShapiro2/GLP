%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract friends
%% (../contracts.glp, contract_named(friends, C): befriend, friend reflexive
%% and the contract's introduction predicate; vGLP 2026-10-16 13:53 UTC, C.3),
%% platform.vglp, which programs/vglp/cva/compile.sh prints from it with its
%% introduction rule (vGLP, Section 3.2, Definition "Introduction Rule,
%% Introduce Peers"; Section 5.4, the paragraph on act schemas).  It runs
%% three agents, alice, bob and carol, their persons scripted and paced on
%% their screens (../self.glp), and gives each person's log, the views with
%% gave(K, A) where the person answers an approval question, and the
%% network's log of the cargoes it carries.
%%
%% play_friends: alice befriends bob and carol, each asked and answering yes.
%%   The introduction rule then gives alice the pair {bob, carol}, both known
%%   to her, and her agent takes Introduce peers {bob, carol}, an own transaction,
%%   sending bob intro(carol) and carol intro(bob).  Each, on reading it,
%%   sends the other ihello, and on the second of the two each comes to know
%%   the other, no person asked (Section 5.4).  bob, never having requested
%%   carol known, proposes befriending her, and the request question asked on
%%   reading that request shows his own key, bob, and alice and carol; carol answers yes and it
%%   commits.  Meanwhile alice greets herself twice, greet(alice, alice), its
%%   two roles at her and friend(alice) holding there, friend reflexive: a
%%   class of one participant, applied at its Propose, adding greeted and
%%   greeting.  She cheers twice, each cheer deleting one of her two greeted;
%%   her third cheer finds none, so it is dropped and takes no number; and she
%%   greets bob, whose machine votes on it.
%%
%% The types of platform.vglp, written again for the declarations of the
%% procedures imported from its compiled module.
%% ---------------------------------------------------------------------------

Class    ::= befriend(Peer, Peer) ; greet(Peer, Peer) ; cheer(Peer).
Proposal ::= befriend(Peer, Peer) ; greet(Peer, Peer) ; cheer(Peer).
Request  ::= propose(Proposal).
YesNo    ::= yes ; no.
Reason   ::= declined ; unable ; unable(List(Atom), List(Atom)).
Vote     ::= yes ; no(Reason).
Decision ::= commit ; abort(Peer, Reason) ; yield.
Rho      ::= one(Class) ; rho(Proposal).
Names    ::= none ; request(Rho, Integer).
Attempt  ::= attempt(Peer, Integer, Integer, Class, Names).
Cargo    ::= start(Attempt) ; vote(Attempt, Vote) ; outcome(Attempt, Decision)
           ; yield(Attempt) ; request(Rho, Integer).
Content  ::= hello(Peer, Proposal) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net      ::= msg(Peer, Content).
Atom     ::= friend(Peer) ; greeted ; greeting ; cheered.
Approved ::= Proposal ; Attempt.
Output   ::= view(List(Atom), List(Key), List(Approved)) ; refused(Class, Key, Reason).
Asking   ::= Attempt ; hello(Peer, Proposal).
Approval ::= approval(Asking, YesNo?).
Menu     ::= menu(Key, List(Key), Request?).
Question ::= menu_w(Menu) ; approval_w(Approval).
Drawn    ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.
Ask(Q)   ::= ask(Constant, Q).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).

exported procedure play_friends(Stream(_), Stream(_), Stream(_),
    Stream(Sent(Cargo))).
play_friends(LA?, LB?, LC?, N?) :-
    trio([own([A1], propose(befriend(A1?, bob))),
          wait(holds(friend(bob))),
          own([A2], propose(befriend(A2?, carol))),
          wait(holds(friend(carol))),
          own([A3, A4], propose(greet(A3?, A4?))),
          wait(has(greeted, 1)),
          own([A5, A6], propose(greet(A5?, A6?))),
          wait(has(greeted, 2)),
          own([A7], propose(cheer(A7?))),
          wait(has(cheered, 1)),
          own([A8], propose(cheer(A8?))),
          wait(has(cheered, 2)),
          own([A9], propose(cheer(A9?))),
          own([A10], propose(greet(A10?, bob)))],
         [approval(befriend(alice, bob), yes),
          wait(known(carol)),
          own([B1], propose(befriend(B1?, carol))), look],
         [approval(befriend(alice, carol), yes),
          approval(befriend(bob, carol), yes)],
         LA, LB, LC, N).

%% alice, bob and carol, each with its dispatcher and scripted person, their
%% networks joined.
procedure trio(Steps(Drawn)?, Steps(Drawn)?, Steps(Drawn)?, Stream(_), Stream(_), Stream(_),
    Stream(Sent(Cargo))).
trio(SA, SB, SC, LA?, LB?, LC?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    platform # agent(carol, InC?, OutC, TC, AsC),
    platform # dispatch(AsC?, ch(GC?, DC), MC),
    to_person(MC?, TC?),
    person(DC?, GC, ps(nosess, [], [], SC?), LC),
    merge(OutA?, OutB?, Net1),
    merge(Net1?, OutC?, Net),
    route3(Net?, alice, InA, bob, InB, carol, InC, N).
