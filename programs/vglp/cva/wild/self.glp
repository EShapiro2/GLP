%% ---------------------------------------------------------------------------
%% The play of the canonical CVA platform of vGLP's contract wild
%% (../contracts.glp, contract_named(wild, C), in the clause syntax), platform.vglp,
%% which programs/vglp/cva/compile.sh prints from it: "a wildcard in an unnegated
%% atom of B, or in the anchor of a quantifier, is a variable of its own, standing
%% for some value: the machine of the person who holds the atom finds one in its
%% state, and the act neither names nor records it, as an act that requires a bond
%% of some maturity" (vGLP, Section 5.4, "Speech-act schemas as local
%% specifications").
%%
%% play_wild, among alice, bob and carol.  alice requests accept(alice, carol),
%% which requires bond(carol, _) at her, holding no bond: refused, unable.  carol
%% issues her a bond of maturity 7, issue(carol, alice, 7), and one of maturity
%% 9, alice answering yes to each; alice requests accept(alice, carol) again,
%% holding two bonds of carol, either of which meets bond(carol, _), carol
%% answering yes, and it commits, her state gaining accepted(carol) and keeping
%% both bonds.  bob requests boast(bob), exists r
%% role(_, r), holding no role: refused, unable.  carol appoints bob chair and
%% then clerk, and alice chair, each answering yes; bob requests boast(bob) again,
%% and gains officer.  carol reports to alice, report(carol, alice): its
%% instances are the roles carol has given, chair and clerk, chair once though
%% two hold it, and alice gains title(carol, r) for each.  carol retires,
%% retire(carol): her agent lists alice and bob, the people she has in some
%% role, bob once; each holds role(carol, _), and loses every role in carol in
%% the one act, carol losing every has_role(_, _).
%% ---------------------------------------------------------------------------

%% The scripted person's steps and log on this platform (../self.glp): the grants of its Drawn, an approval step naming a class, the atoms of its machine state, the approvals pending and the reasons of their refusals; the log of each.
ScriptSteps ::= Steps(Drawn, Class, Atom, Approved, Reason).
ScriptLog   ::= Logged(Class, Drawn, Atom, Approved, Reason, Tab).

imported procedure platform#agent(Peer?, Stream(Net)?, Stream(Net),
    Stream(Output), Stream(Ask(Question))).
imported procedure platform#dispatch(Stream(Ask(Question))?,
    PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).

exported procedure play_wild(Stream(ScriptLog), Stream(ScriptLog), Stream(ScriptLog), Stream(Sent(Cargo))).
play_wild(LA?, LB?, LC?, N?) :-
    trio([own([A1], propose(accept(A1?, carol))),
          wait(refused(accept(alice, carol), alice, unable)),
          approval(issue(carol, alice, 7), yes),
          approval(issue(carol, alice, 9), yes),
          wait(holds(bond(carol, 9))),
          own([A2], propose(accept(A2?, carol))),
          wait(holds(accepted(carol))),
          approval(appoint(carol, alice, speech(utterance(chair), carol)), yes),
          approval(report(carol, alice, [speech(utterance(chair), carol), speech(utterance(clerk), carol)]), yes)],
         [own([B1], propose(boast(B1?))),
          wait(refused(boast(bob), bob, unable)),
          approval(appoint(carol, bob, speech(utterance(chair), carol)), yes),
          approval(appoint(carol, bob, speech(utterance(clerk), carol)), yes),
          wait(holds(role(carol, speech(utterance(clerk), carol)))),
          own([B2], propose(boast(B2?))),
          wait(holds(officer))],
         [own([C1], propose(issue(C1?, alice, 7))),
          wait(holds(issued(alice, 7))),
          own([C0], propose(issue(C0?, alice, 9))),
          approval(accept(alice, carol), yes),
          wait(holds(accepted_by(alice))),
          own([C2, C3], propose(appoint(C2?, bob, speech(utterance(chair), C3?)))),
          wait(holds(has_role(bob, speech(utterance(chair), carol)))),
          own([C4, C5], propose(appoint(C4?, bob, speech(utterance(clerk), C5?)))),
          wait(holds(has_role(bob, speech(utterance(clerk), carol)))),
          own([C6, C7], propose(appoint(C6?, alice, speech(utterance(chair), C7?)))),
          wait(holds(has_role(alice, speech(utterance(chair), carol)))),
          own([C8], propose(report(C8?, alice))),
          wait(holds(reported(alice))),
          own([C9], propose(retire(C9?))),
          wait(holds(retired))],
         LA, LB, LC, N).

%% alice, bob and carol, each with its dispatcher and scripted person, their
%% networks joined.
procedure trio(ScriptSteps?, ScriptSteps?, ScriptSteps?, Stream(ScriptLog), Stream(ScriptLog), Stream(ScriptLog),
    Stream(Sent(Cargo))).
trio(SA, SB, SC, LA?, LB?, LC?, N?) :-
    platform # agent(alice, InA?, OutA, TA, AsA),
    platform # dispatch(AsA?, ch(GA?, DA), MA),
    to_person(MA?, TA?),
    person(DA?, GA, ps(nosess, [], [], SA?), LA),
    platform # agent(bob, InB?, OutB, TB, AsB),
    platform # dispatch(AsB?, ch(GB?, DB), MB),
    to_person(MB?, TB?),
    person(DB?, GB, ps(nosess, [], [], SB?), LB),
    platform # agent(carol, InC?, OutC, TC, AsC),
    platform # dispatch(AsC?, ch(GC?, DC), MC),
    to_person(MC?, TC?),
    person(DC?, GC, ps(nosess, [], [], SC?), LC),
    merge(OutA?, OutB?, Net1),
    merge(Net1?, OutC?, Net),
    route3(Net?, alice, InA, bob, InB, carol, InC, N).
