%% ---------------------------------------------------------------------------
%% The compiler from an act-schema contract to its canonical CVA platform in
%% vGLP.
%%
%% vGLP (/Grassroots/vGLP, 099f876), Section 3.2, sections/cva-2pc.tex: Definitions "Volition-Guarded Specification", "Local Specification, Part, Guard Set, Opener", "Attempt", "Cargo, App State, Question, Free, Ready", "Priority, Waiting, Blocked, Clear", "Proposing" to "Deciding" and "Canonical CVA Platform", two-phase commit coordinated by the initiating agent; Section 5.4, sections/cva-implementation.tex, Definition "Effective Local Specification", "The compilation" and the paragraph "Act schemas as local specifications", which says that a contract of act schemas is a local specification, each schema-binding determining a part with the people in its marked roles as its guard set, and when it is effective.  GSC (/Grassroots/GSC), Sections 3 and 5: Definitions "Act schema", "Binding", "Compilation" and "Realisation of a contract", and Appendix F, "Introduction with wards".  The papers are the specification; each module names the definitions it decides.
%%
%% compile(Name, Contract, Verdict) takes a contract in the term form
%% programs/gsc reads, and the verdict its checker gives it, and prints the
%% .vglp module of the contract's canonical platform between the lines
%% "%% compile begin" and "%% compile end", one line of source to a line, as
%% programs/gsc/compile.glp prints its output; or, for a contract it does not
%% compile, the lines saying why.  programs/vglp/cva/compile.sh runs the
%% checker of programs/gsc and then this.
%% ---------------------------------------------------------------------------

%% The contract, as programs/gsc/self.glp writes it.  sgn(Y, I) is the signed
%% term sgn(y, pi_I) of GSC's Definition "Act schema", the speech act y signed
%% by the party in role I, which an atom a schema adds may carry: under a
%% binding it is the speech act bound to y, signed by the person in role I
%% (GSC, Definition "Binding"; vGLP, Section 5.4, "Act schemas as local
%% specifications"), a speech act being an utterance or a speech act, signed;
%% local.glp decides the contract over it and the printed text computes it.
NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Schema    ::= schema(Constant, RoleSpecs) ; cschema(Constant, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% Its checker's verdict, as programs/gsc/self.glp writes it (GSC, Section 3,
%% Definition "Syntactically grassroots"; Appendix F, Definition "Introduction
%% with wards").
Cause     ::= unobtainable ; blocked_by(Constant, Integer, Atom) ; reflexive.
%% What GSC's Definition "Act schema" requires of a signed term, and the atom
%% carrying one violates: it occurs in an atom not marked + (not_added), its
%% role is not a guarding role (not_guarding), its speech-act variable occurs
%% in no atom a role requires (not_required); or the contract has community
%% roles, whose schemas admit no signed term (community).
SgnCause  ::= not_added ; not_guarding ; not_required ; community.
%% What GSC's Definition "Act schema" requires of the form of a schema, and a schema formed otherwise violates, in a verdict malformed(Faults): an atom both added and deleted at a role (added_and_deleted), a role that is not guarding and adds and deletes nothing (changes_nothing), and no role adding or deleting an atom (no_role_changes), as programs/gsc/self.glp writes them.
Fault     ::= no_introductory_act
            ; obstructed(Constant, Integer, Atom, Cause)
            ; untraceable(Preds)
            ; volition(Constant, Integer, Integer)
            ; cohesion(Constant, Integer, Atom)
            ; reflexive(Constant, Integer, Atom)
            ; signed(Constant, Integer, Atom, SgnCause)
            ; added_and_deleted(Constant, Integer, Atom)
            ; changes_nothing(Constant, Integer)
            ; no_role_changes(Constant).
Faults    ::= [] ; [Fault | Faults].
%% An introduction with wards (GSC, Appendix F): guardianship(M, Iota, G, W) is the guardianship (m, iota, g, w) of Definition "Guardianship"; a party of a relay act (Definition "Relay") is a ward role, ward(Role, Mark, GuardianRole), or a free role, free(Role); a relay act is named with its two parties.  grassroots_with_wards names the introductory act unobstructed but for the marks, the set of marks, the guardianship of each, the relay acts found and the leaving marks of the contract (Definition "Leaving mark"), as programs/gsc/self.glp writes it from GLP 91a2962b on (GSC #3, Code_inbox.md, 2026-10-18 22:16 UTC).
Guardianship  ::= guardianship(Constant, Constant, Constant, Constant).
Guardianships ::= [] ; [Guardianship | Guardianships].
Party     ::= ward(Integer, Constant, Integer) ; free(Integer).
Parties   ::= [] ; [Party | Parties].
Relay     ::= relay(Constant, Party, Party).
Relays    ::= [] ; [Relay | Relays].
Verdict   ::= syntactically_grassroots ; not_grassroots(Faults)
            ; grassroots_with_wards(Constant, Preds, Guardianships, Relays, Preds)
            ; conditions_met ; conditions_failed(Faults) ; malformed(Faults).

%% A contract's introduction predicate, where it names one (vGLP, Section 5.4,
%% the paragraph on act schemas), given to compile/4.
Intro     ::= no_introduction ; introduction(Constant).

imported procedure cvac#compile(Constant?, Declared?, Verdict?).
exported procedure compile(Constant?, Declared?, Verdict?).
compile(Nm, D, V) :- cvac # compile(Nm?, D?, V?).
imported procedure cvac#compile(Constant?, Declared?, Verdict?, Intro?).
exported procedure compile(Constant?, Declared?, Verdict?, Intro?).
compile(Nm, D, V, I) :- cvac # compile(Nm?, D?, V?, I?).

%% ---------------------------------------------------------------------------
%% Shared by the modules of the compiler
%% ---------------------------------------------------------------------------

YesNo ::= yes ; no.
Ints  ::= [] ; [Integer | Ints].

procedure rs_lists(RoleSpec?, Atoms, Atoms, Atoms, Atoms).
rs_lists(rs(_, P, M, K, N), P?, M?, K?, N?).
rs_lists(crs(_, _, P, M, K, N), P?, M?, K?, N?).

procedure rs_guarded(RoleSpec?, YesNo).
rs_guarded(rs(guarded, _, _, _, _), yes).
rs_guarded(rs(guarded_at(_), _, _, _, _), yes).
rs_guarded(rs(unguarded, _, _, _, _), no).
rs_guarded(crs(_, guarded, _, _, _, _), yes).
rs_guarded(crs(_, guarded_at(_), _, _, _, _), yes).
rs_guarded(crs(_, unguarded, _, _, _, _), no).

%% The variables of a schema in the order programs/gsc gives them
%% (self.glp, schema_vars): its roles, then its party variables and then its
%% speech-act variables, each in order of first occurrence, the atoms of each
%% role read as +(i), -(i), =(i), not(i).
procedure schema_vars(RoleSpecs?, Args).
schema_vars(Rs, Vs?) :- ground(Rs?) |
    rs_count(Rs?, K),
    role_args(1, K?, Ro),
    rs_args(Rs?, As),
    schema_vars1(Ro?, As?, Vs).
procedure schema_vars1(Args?, Args?, Args).
schema_vars1(Ro, As, Vs?) :- ground(As?) |
    pvars_of(As?, Pv0),
    dedup(Pv0?, Pv),
    svars_of(As?, Sv0),
    dedup(Sv0?, Sv),
    app(Pv?, Sv?, PS),
    app(Ro?, PS?, Vs).
procedure rs_count(RoleSpecs?, Integer).
rs_count([], 0).
rs_count([_|Rs], N?) :- rs_count(Rs?, M), N := M? + 1.
procedure role_args(Integer?, Integer?, Args).
role_args(I, K, []) :- I? > K? | true.
role_args(I, K, [role(I?)|R?]) :- I? =< K? | I1 := I? + 1, role_args(I1?, K?, R).
procedure rs_args(RoleSpecs?, Args).
rs_args([], []).
rs_args([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M, K, N),
    atoms_args(P?, A1),
    atoms_args(M?, A2),
    atoms_args(K?, A3),
    atoms_args(N?, A4),
    rs_args(Rs?, A5),
    app(A4?, A5?, A45),
    app(A3?, A45?, A35),
    app(A2?, A35?, A25),
    app(A1?, A25?, As).
procedure atoms_args(Atoms?, Args).
atoms_args([], []).
atoms_args([atom(_, As)|Xs], R?) :- atoms_args(Xs?, R1), app(As?, R1?, R).
procedure pvars_of(Args?, Args).
pvars_of([], []).
pvars_of([pvar(X)|As], [pvar(X?)|R?]) :- pvars_of(As?, R).
pvars_of([role(_)|As], R?) :- pvars_of(As?, R).
pvars_of([svar(_)|As], R?) :- pvars_of(As?, R).
pvars_of([nterm(_)|As], R?) :- pvars_of(As?, R).
pvars_of([sgn(_, _)|As], R?) :- pvars_of(As?, R).
%% A signed term's speech-act variable occurs in an atom some role requires
%% (GSC, Definition "Act schema"), where it is collected.
procedure svars_of(Args?, Args).
svars_of([], []).
svars_of([svar(X)|As], [svar(X?)|R?]) :- svars_of(As?, R).
svars_of([role(_)|As], R?) :- svars_of(As?, R).
svars_of([pvar(_)|As], R?) :- svars_of(As?, R).
svars_of([nterm(_)|As], R?) :- svars_of(As?, R).
svars_of([sgn(_, _)|As], R?) :- svars_of(As?, R).

procedure and(YesNo?, YesNo?, YesNo).
and(yes, B, B?).
and(no, _, no).
procedure or(YesNo?, YesNo?, YesNo).
or(yes, _, yes).
or(no, B, B?).
procedure neg(YesNo?, YesNo).
neg(yes, no).
neg(no, yes).

procedure(X) app(Stream(X)?, Stream(X)?, Stream(X)).
app([], Ys, Ys?).
app([X|Xs], Ys, [X?|Zs?]) :- app(Xs?, Ys?, Zs).
procedure(X) mem(X?, Stream(X)?, YesNo).
mem(_, [], no).
mem(X, [Y|_], yes) :- X? =?= Y? | true.
mem(X, [_|Ys], R?) :- otherwise | mem(X?, Ys?, R).
procedure(X) dedup(Stream(X)?, Stream(X)).
dedup([], []).
dedup([X|Xs], [X?|Ys?]) :- ground(X?) | remove_all(X?, Xs?, Xs1), dedup(Xs1?, Ys).
procedure(X) remove_all(X?, Stream(X)?, Stream(X)).
remove_all(_, [], []).
remove_all(X, [Y|Ys], Zs?) :- X? =?= Y? | remove_all(X?, Ys?, Zs).
remove_all(X, [Y|Ys], [Y?|Zs?]) :- otherwise | remove_all(X?, Ys?, Zs).
