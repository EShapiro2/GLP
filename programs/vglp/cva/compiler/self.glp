%% ---------------------------------------------------------------------------
%% The compiler from an act-schema contract to its canonical CVA platform in
%% vGLP.
%%
%% vGLP (/Grassroots/vGLP, f0acbc1), Section 3.2, sections/cva-2pc.tex: "The protocol" and Definitions "Volition-Guarded Specification", "Local Specification, Part, Guard Set, Opener, Request", "Attempt", "Cargo, App State, Question, Approval, Free, Ready", "Priority, Waiting, Blocked, Clear", "Proposing" to "Deciding" and "Canonical CVA Platform", two-phase commit coordinated by the initiating agent, a person's request or answer yes its standing approval; Section 5.4, sections/cva-implementation.tex, Definition "Effective Local Specification", "The compilation" and the paragraph "Act schemas as local specifications", which says that a contract of act schemas is a local specification, each schema-binding determining a part with the people in its marked roles as its guard set, and when it is effective.  GSC (/Grassroots/GSC), Sections 3 and 5: Definitions "Act schema", "Binding", "Compilation" and "Realisation of a contract", and Appendix F, "Introduction with wards".  The papers are the specification; each module names the definitions it decides.
%%
%% compile(Name, Contract, Verdict) takes a contract in the term form
%% programs/gsc reads, and the verdict its checker gives it, and prints the
%% .vglp module of the contract's canonical platform between the lines
%% "%% compile begin" and "%% compile end", one line of source to a line, as
%% programs/gsc/compile.glp prints its output; or, for a contract it does not
%% compile, the lines saying why.  programs/vglp/cva/compile.sh runs the
%% checker of programs/gsc and then this.
%% ---------------------------------------------------------------------------

%% The contract, as programs/gsc/self.glp writes it.  sgn(Y, I) is the signed
%% term sgn(y, pi_I) of GSC's Definition "Act schema", the speech act y signed
%% by the party in role I, which an atom a schema adds may carry: under a
%% binding it is the speech act bound to y, signed by the person in role I
%% (GSC, Definition "Binding"; vGLP, Section 5.4, "Act schemas as local
%% specifications"), a speech act being an utterance or a speech act, signed;
%% local.glp decides the contract over it and the printed text computes it.
%% A cleared atom (vGLP f8127b1, Section 5.4, "Act schemas as local specifications": "A schema may mark an atom it deletes as cleared, with the wildcard * among its arguments or as the speech act of a name term: the act deletes every atom of the state that it matches, and requires none"), as programs/gsc/self.glp writes it among a role's deleted atoms (GSC 327e035, Definition "Speech-act schema"): any is the wildcard as an argument, and ext_any(N) the name term N.*, the wildcard as its speech act.
NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant) ; ext_any(NameTerm).
%% Act schemas allow numbers (GSC 9231074, Section 3.2; vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "an argument of an atom may be a number or a numeric variable, a schema may carry a constraint on its numeric variables, and an atom it adds or deletes may carry a multiplicity, a number or a numeric variable, for that many copies of it"): num(X) is the numeric variable X where X is a name and the number X where X is a number, and times(K, A) is the atom A with the multiplicity K, as programs/gsc/self.glp writes them.
%% ilist(K, T) is no argument of an atom: it is the place, after the variables, of the list of the instances of the K-th conjunct of a schema, each of the type T, that its base finds and the attempt names, which the compiler appends to a schema's head when it prints the class term (cvac.glp, inst_heads; vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "A conjunct with a listed role, or with conditional literals at a role other than the one holding its anchor, is local to its base; the base's machine finds its instances, the attempt names them").
%% A value variable has a type, a whole number or a real, which the schema writes with it among its variables: num(X) whole and real(X) real, an atom, a multiplicity and a constraint writing num(X) of either (vGLP fb40cff, Section 5.4, "Speech-act schemas as local specifications"; programs/gsc/self.glp, Arg).  The compiler takes a schema's real(X) as num(X) for every check, and prints its type, Real, from the table of the real variables (cvac.glp, real_lx, real_heads).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String)
            ; item_of(Arg).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args) ; times(Arg, Atom) ; rest(Arg, Arg, Atom).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
%% listed(I, Rho, Args) is the listed role pi_I[rho(*, u_2, ..., u_r)] of the agent role pi_I, its base, Args its arguments u_2, ..., u_r (GSC 8064cfb, Appendix D, Definition "Role"; programs/gsc/self.glp at GLP 96908b2d).
%% qlisted(I, Rho, Args, Xs) is the listed role bound by Xs in its anchor rho(pi_I, Args), written pi_I[A] with the bound variables replaced by _ in A (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications": "a listed role is an agent variable bound by a quantifier whose anchor an agent role, its base, holds, and that holds an atom"), as programs/gsc/self.glp writes it.
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant)
            ; listed(Integer, Constant, Args) ; qlisted(Integer, Constant, Args, Args).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
%% A schema's second argument is its variables, pvar(X) and svar(Y), in the order of its head, tau(pi_1, ..., pi_k ; x_1, ..., x_m) (GSC 0228e79, Definition "Act schema"; programs/gsc/README.md, "Writing a contract"; Udi, 2026-10-19, to GSC #4).
%% A schema with a constraint on its numeric variables is nschema(Name, Vars, Constraint, Roles), the constraint "a conjunction of linear equalities and inequalities over its value variables and values" (GSC bcc1891, Definition "Schema with values"), as programs/gsc/self.glp writes it at GSC-unob3 62fb0342: true, and(C1, C2), and eq, le, lt, ge and gt of two expressions, X = Y, X =< Y, X < Y, X >= Y and X > Y, with succ(X, Y), Y = X + 1; an expression a numeric argument, plus(X, Y), minus(X, Y) or mul(X, Y); or(C1, C2) is in the type, a contract carrying it being refused by the checker, malformed(constraint_not_conjunction(...)).
%% A constraint is "a decidable condition on the values its binding assigns, in the relations their types provide --- linear arithmetic on its numeric variables, and signed(u, y) and unsigned(u, y), that the person bound to u signed the speech act bound to y or did not --- which is evaluated when the schema is bound" (vGLP dd37d2a, Section 5.4, "Speech-act schemas as local specifications"; GSC 10fcc92, def:numbers: "signed(u, y) holding when beta(u) is the signer of beta(y) or of a speech act inside it and unsigned(u, y) otherwise"), signed(U, Y) and unsigned(U, Y) as programs/gsc/self.glp writes them, U role(I) or pvar(X) and Y svar(Y).
Constraint ::= true ; and(Constraint, Constraint)
             ; eq(Expr, Expr) ; le(Expr, Expr) ; lt(Expr, Expr)
             ; ge(Expr, Expr) ; gt(Expr, Expr) ; succ(Arg, Arg)
             ; or(Constraint, Constraint)
             ; signed(Arg, Arg) ; unsigned(Arg, Arg)
             ; not(Constraint) ; implies(Constraint, Constraint)
             ; ne(Expr, Expr) ; rel(Constant, Exprs)
             ; program(Expr).
%% not, implies and ne, and the relations rel(Name, Args), functions fn(Name, Args), cardinalities cardinality(Xs, H, A, Phi) and sums sum(Xs, H, A, Phi, U) a constraint may hold, as programs/gsc/self.glp writes them (GSC c8c5ead, def:numbers).  vGLP's constraint is "a decidable condition on the values its binding assigns, in the relations their types provide --- linear arithmetic on its numeric variables, and signed(u, y) and unsigned(u, y)" (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications"), so the compiler takes not, implies and ne, and refuses a contract with a relation, a function, a cardinality or a sum (cvac.glp, q_lines).
Expr       ::= Arg ; plus(Expr, Expr) ; minus(Expr, Expr) ; mul(Expr, Expr)
             ; fn(Constant, Exprs) ; cardinality(Args, Arg, Atom, Form)
             ; sum(Args, Arg, Atom, Form, Expr)
             ; author_of(Arg) ; item_of(Arg).
%% author_of(Y), item_of(Y) and program(E), the author and the item of the speech act bound to Y and a condition on an utterance its type provides, as programs/gsc/self.glp writes them (GSC 65a26da, def:numbers): the compiler takes the author and the item (vGLP 27bae5d, Section 5.4, "Speech-act schemas as local specifications": "a constraint ... is over the relations and functions the value types provide --- ...; the signer, the author and the item of a speech act, its last signer, its first signer and its utterance"; vGLP #24, Code_inbox.md, 2026-11-07 22:27 UTC, 20:36 item 1), and refuses a contract that holds a program condition, with the reason (cvac.glp, con_beyond).
Exprs      ::= [] ; [Expr | Exprs].
Constraints ::= [] ; [Constraint | Constraints].
%% A safe formula (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications": "A safe formula is built from atoms and constraints by and, or and not and by the quantifiers exists x (A and phi) and forall x (A and phi -> psi), A an atom, the quantifier's anchor"), as programs/gsc/self.glp writes it: fa(H, M) the atom or multiplicity M held by H, fnot, fand and for, fexists(Xs, H, A, Phi), fforall(Xs, H, A, Phi, Psi), Psi a list, and fcons(C) a constraint.
Form       ::= fa(Arg, Atom) ; fnot(Form) ; fand(Form, Form) ; for(Form, Form)
             ; fexists(Args, Arg, Atom, Form)
             ; fforall(Args, Arg, Atom, Form, Forms)
             ; fcons(Constraint).
Forms      ::= [] ; [Form | Forms].
%% A quantified conjunct of the head, forall Xs (A and Phi -> L_1, ..., L_m), conjunct(Xs, I, A, Phi, Add, Del, Lits), I the index of the agent role holding its anchor A, Add and Del its conditional literals, each hm(J, M) the atom M at the agent role J, and Lits all its literals, as programs/gsc/self.glp writes it.
HMult      ::= hm(Integer, Atom).
HMults     ::= [] ; [HMult | HMults].
Conjunct   ::= conjunct(Args, Integer, Atom, Form, HMults, HMults, Forms).
Conjuncts  ::= [] ; [Conjunct | Conjuncts].
%% A schema with quantifiers is qschema(Name, Vars, Bound, Constraint, Roles, Conjuncts, Forms), Bound the variables its quantifiers bind and Forms the safe formulas of its body, which the reader of the clause syntax writes (programs/gsc/self.glp).
Schema    ::= schema(Constant, Args, RoleSpecs)
            ; cschema(Constant, Args, Reaches, RoleSpecs)
            ; nschema(Constant, Args, Constraint, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
%% The contract as the compiler reads it, its schemas with quantifiers among them; the compiler takes it to its plain form, a Contract (cvac.glp, plain_contract).
QSchema   ::= schema(Constant, Args, RoleSpecs)
            ; cschema(Constant, Args, Reaches, RoleSpecs)
            ; nschema(Constant, Args, Constraint, RoleSpecs)
            ; qschema(Constant, Args, Args, Constraint, RoleSpecs, Conjuncts, Forms).
QContract ::= [] ; [QSchema | QContract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= QContract ; reflexive(Preds, QContract).
%% The contract as its owner writes it (programs/gsc/self.glp, WDeclared; GSC 25b6b3c, Section 2: "the schemas naming their roles as the clauses do"): a schema's head may list its roles' names, schema(Name, Names, Vars, Roles), cschema(Name, Names, Vars, Reaches, Roles) and nschema(Name, Names, Vars, Constraint, Roles), and a contract may name its environment predicates, environment(Preds, Body).  The compiler reads it with the names and the environment predicates dropped (unnamed): pragmas.sh maps a pragma's names to the roles before the compiler reads the pragmas, and the one environment predicate the compiler knows, today, it knows by its name (cvac.glp, the day).
RName    ::= Constant ; one(Constant, Constant).
Names     ::= [] ; [RName | Names].
RChunks    ::= [] ; [RName | RChunks].
WSchema   ::= schema(Constant, Args, RoleSpecs)
            ; cschema(Constant, Args, Reaches, RoleSpecs)
            ; nschema(Constant, Args, Constraint, RoleSpecs)
            ; schema(Constant, Names, Args, RoleSpecs)
            ; cschema(Constant, Names, Args, Reaches, RoleSpecs)
            ; nschema(Constant, Names, Args, Constraint, RoleSpecs)
            ; qschema(Constant, Args, Args, Constraint, RoleSpecs, Conjuncts, Forms)
            ; qschema(Constant, Names, Args, Args, Constraint, RoleSpecs, Conjuncts, Forms).
WContract ::= [] ; [WSchema | WContract].
WBody     ::= WContract ; reflexive(Preds, WContract).
WDeclared ::= WBody ; environment(Preds, WBody).
procedure unnamed(WDeclared?, Declared).
unnamed([], []).
unnamed([S|Ss], C?) :- ground(S?), ground(Ss?) | unnamed_c([S?|Ss?], C).
unnamed(reflexive(Rf, Ss), reflexive(Rf?, C?)) :- ground(Ss?) | unnamed_c(Ss?, C).
unnamed(environment(_, B), D?) :- ground(B?) | unnamed_b(B?, D).
procedure unnamed_b(WBody?, Declared).
unnamed_b([], []).
unnamed_b([S|Ss], C?) :- ground(S?), ground(Ss?) | unnamed_c([S?|Ss?], C).
unnamed_b(reflexive(Rf, Ss), reflexive(Rf?, C?)) :- ground(Ss?) | unnamed_c(Ss?, C).
procedure unnamed_c(WContract?, QContract).
unnamed_c([], []).
unnamed_c([S|Ss], [S1?|Ss1?]) :- ground(S?), ground(Ss?) |
    unnamed_s(S?, S1),
    unnamed_c(Ss?, Ss1).
procedure unnamed_s(WSchema?, QSchema).
unnamed_s(schema(Nm, Vs, Rs), schema(Nm?, Vs?, Rs?)).
unnamed_s(cschema(Nm, Vs, X, Rs), cschema(Nm?, Vs?, X?, Rs?)).
unnamed_s(nschema(Nm, Vs, Cn, Rs), nschema(Nm?, Vs?, Cn?, Rs?)).
unnamed_s(schema(Nm, _, Vs, Rs), schema(Nm?, Vs?, Rs?)).
unnamed_s(cschema(Nm, _, Vs, X, Rs), cschema(Nm?, Vs?, X?, Rs?)).
unnamed_s(nschema(Nm, _, Vs, Cn, Rs), nschema(Nm?, Vs?, Cn?, Rs?)).
unnamed_s(qschema(Nm, Vs, Bd, Cn, Rs, Cj, Fs), qschema(Nm?, Vs?, Bd?, Cn?, Rs?, Cj?, Fs?)).
unnamed_s(qschema(Nm, _, Vs, Bd, Cn, Rs, Cj, Fs), qschema(Nm?, Vs?, Bd?, Cn?, Rs?, Cj?, Fs?)).

%% Its checker's verdict, as programs/gsc/self.glp writes it (GSC, Section 3,
%% Definition "Syntactically grassroots"; Appendix D.4, Definition
%% "Syntactically grassroots, agent-named"; Appendix F, Definitions
%% "Introduction with wards" and "Syntactically grassroots with wards").
%% listed_role(Schema, Role, Atom) is clause 2 of the agent-named definition:
%% the listed role adds an atom of a predicate the introductory act forbids
%% (GSC f3c4f43; programs/gsc/self.glp at GLP f5081cfa).
Cause     ::= unobtainable ; blocked_by(Constant, Integer, Atom) ; reflexive
            ; listed_role(Constant, Integer, Atom).
%% What GSC's Definition "Act schema", and Appendix D's, require of a signed term, and the atom carrying one violates: it occurs in an atom not marked + (not_added), its speech-act variable occurs in no atom its role requires (not_required), or its role is not an agent role (not_agent_role).
SgnCause  ::= not_added ; not_required ; not_agent_role.
%% What GSC's Definition "Speech-act schema" admits of a reading role, a role that is not guarding and adds and deletes nothing, and Definition "Volition" requires of it, an edge to a guarding role from an atom that guarding role requires (GSC 0380a8a): a reading role with none is a fault changes_nothing(Schema, Role) of volition, in a verdict not_grassroots(Faults), as programs/gsc/self.glp writes it from GLP e2b5a802 on.  What GSC's Definition "Speech-act schema" requires of the form of a schema, and a schema formed otherwise violates, in a verdict malformed(Faults): an atom both added and deleted at a role (added_and_deleted), no role adding or deleting an atom (no_role_changes), an entry of the head that is not a variable (head_not_variable), an entry listed twice (head_repeated), and a variable of the schema not in its head (not_in_head), and, of a listed role, a base that is not an agent role (listed_base), a signed term among its arguments (listed_signed) or the mark ? (listed_guarded, GSC f3c4f43), as programs/gsc/self.glp writes them.
%% name_term_base(Schema, N), a name term on a base that is not an agent role of the schema, a fault of its form; of a schema's values, in a verdict malformed(Faults), a multiplicity on an atom neither added nor deleted (multiplicity_not_added), one that is no value argument (multiplicity_not_numeric), one written as a number that is no positive whole number (multiplicity_not_whole), an argument of the constraint that is no value argument (constraint_not_numeric), a product of two expressions each carrying a value variable (constraint_not_linear) and a disjunction (constraint_not_conjunction), and a signing condition signed(u, y) or unsigned(u, y) whose u is no agent role or agent variable (signing_not_agent) or whose y is no speech-act variable (signing_not_speech_act; GSC 10fcc92, def:numbers; programs/gsc/self.glp at GLP 0989846e); and obstructed_jointly(Act), an introductory act each of whose conditions of def:unobstructed is met at some choice of its values and no choice meets them all, as programs/gsc/self.glp writes them at GSC-unob3 62fb0342 (GSC bcc1891, Appendix "Values in Act Schemas").
Fault     ::= no_introductory_act
            ; obstructed(Constant, Integer, Atom, Cause)
            ; untraceable(Preds)
            ; volition(Constant, Integer, Integer)
            ; reflexive(Constant, Integer, Atom)
            ; signed(Constant, Integer, Atom, SgnCause)
            ; added_and_deleted(Constant, Integer, Atom)
            ; changes_nothing(Constant, Integer)
            ; no_role_changes(Constant)
            ; head_not_variable(Constant, Arg)
            ; head_repeated(Constant, Arg)
            ; not_in_head(Constant, Arg)
            ; name_term_base(Constant, NameTerm)
            ; listed_base(Constant, Integer)
            ; listed_signed(Constant, Integer)
            ; listed_guarded(Constant, Integer)
            ; multiplicity_not_added(Constant, Integer, Atom)
            ; multiplicity_not_numeric(Constant, Integer, Atom)
            ; multiplicity_not_whole(Constant, Integer, Atom)
            ; constraint_not_numeric(Constant, Arg)
            ; constraint_not_linear(Constant, Expr)
            ; constraint_not_conjunction(Constant, Constraint)
            ; signing_not_agent(Constant, Arg)
            ; signing_not_speech_act(Constant, Arg)
            ; obstructed_jointly(Constant).
Faults    ::= [] ; [Fault | Faults].
%% An introduction with wards (GSC, Appendix F): guardianship(M, Iota, G, W, V) is the guardianship (m, iota, g, w, v) of Definition "Guardianship" (GAI, appendix "Contracts with Wards"); a party of a relay act (Definition "Relay") is a ward role, ward(Role, Mark, GuardianRole), or a free role, free(Role); a relay act is named with its two parties.  grassroots_with_wards names the introductory act unobstructed but for the marks, the set of marks, the guardianship of each, the relay acts found and the leaving marks of the contract (Definition "Leaving mark"), as programs/gsc/self.glp writes it from GLP 91a2962b on (GSC #3, Code_inbox.md, 2026-10-18 22:16 UTC).  syntactically_grassroots_with_wards, of the same arguments, is the verdict on one with listed roles or name terms (def:sg-wards of CSSN's paper; programs/gsc/self.glp at GSC-unob3 f06db5dc).
Guardianship  ::= guardianship(Constant, Constant, Constant, Constant, Constant).
Guardianships ::= [] ; [Guardianship | Guardianships].
Party     ::= ward(Integer, Constant, Integer) ; free(Integer).
Parties   ::= [] ; [Party | Parties].
Relay     ::= relay(Constant, Party, Party).
Relays    ::= [] ; [Relay | Relays].
%% The verdict, as programs/gsc/self.glp writes it at GSC-unob3 62fb0342: syntactically_grassroots, by GSC's one definition for agent roles and listed roles alike (GSC ac7ad63, Section 3), syntactically_grassroots_with_listed_roles merged into it and conditions_met and conditions_failed gone with GSC's Appendix D; each condition decided at every value case (GSC bcc1891, Appendix "Values in Act Schemas": the conditions "stay decidable, the constraints being linear").
Verdict   ::= syntactically_grassroots ; not_grassroots(Faults)
            ; syntactically_grassroots_with_wards(Constant, Preds, Guardianships, Relays, Preds)
            ; grassroots_with_wards(Constant, Preds, Guardianships, Relays, Preds)
            ; malformed(Faults).

%% A contract's introduction predicate, where it names one (vGLP, Section 5.4,
%% the paragraph on act schemas), given to compile/4.
Intro     ::= no_introduction ; introduction(Constant).

%% A contract's pragmas, the words its app shows (vGLP, Section 5.4, "The contract's words"; GSC 2991379, Section 2, its first paragraph), as the scripts that run the compiler read them from the contract's .txt and from the .txt of every contract it extends (README.md beside this file, "The pragmas"): pragmas(Lists, Acts), or no_pragmas for a contract whose .txt has none, which the compiler refuses (vGLP ffcb093, Section 5.4, "The contract's words").  A list, list(Name, Words), is a pragma's first line: the name of the list and the words of what it lists, each in lower case and, where it ends in s, also without it.  An act, act(Schema, Button, Fields, Sentence, Tab), is each other line: the schema its button names, the button's text in lower case, "a button for each act of it a person proposes, in brackets, each bearing its act's name" (GSC, ibid.); the button as it reads; the name of each field in angle brackets, in order; the questions, said(Questions), or none, one for each guarding role, the proposer's [], each word text(S) or person(I), I the rank among the schema's persons of the role the name bears, by the names the schema term gives its roles (GSC 25b6b3c, Section 2: "A name in a pragma is the schema's role of that name"); the name of the tab of its contract, the first line of the pragmas of the NAME.txt it is in; and the guarding roles at which it is proposed, by(Gs), each one whose every other guarding role has a question (vGLP, Section 5.4, "The contract's words"), the one the line names as its proposer where it names one, as GSC's form writes it (GSC, Section 2, its first paragraph), the button offered there alone; any, each guarding role, where the scripts gave no contract term.  Every string is carried as its source text, quotes and all, since the printer writes a constant as it is and GLP has no string concatenation.
PWord     ::= text(String) ; person(Integer).
PWords    ::= [] ; [PWord | PWords].
PSentences ::= [] ; [PWords | PSentences].
Said      ::= none ; said(PSentences).
Strings   ::= [] ; [String | Strings].
PList     ::= list(String, Strings).
PLists    ::= [] ; [PList | PLists].
PAct      ::= act(Constant, String, Strings, Said, String, Proposer).
Proposer  ::= any ; by(Ints) ; by(Ints, Sames).
Same      ::= same(Integer, Integer).
Sames     ::= [] ; [Same | Sames].
PActs     ::= [] ; [PAct | PActs].
%% A standing declaration, standing(Schema, Start, Stop): the acts of the guarded schema Schema standing, the person's request of the act Start making their standing request of every class of Schema's acts that they propose, and their request of the act Stop withdrawing it (vGLP 7c631b1, Section 5.4, "The contract's words": "An implementation pragma may make the acts of a clause standing, as `Encounter: Alice stands on [Open place] until [Close place]' does ...: the person's request of the act of the first button is also their standing request (Definition Local) of every class of the clause's acts that they propose, and their request of the act of the second withdraws it; a standing act has no button, every guarding role of it proposes it, and its persons are asked nothing, their machines voting yes on their standing approvals").  pragmas.sh reads it from a contract's implementation pragmas, "<Clause>: <Name> stands on [<Start>] until [<Stop>]", for each schema of the clause (GSC 1a8e31c, Section 2), and vGLP's own contracts give the term (contracts.glp, pragmas_named/2).
PStand    ::= standing(Constant, Constant, Constant).
PStands   ::= [] ; [PStand | PStands].
Pragmas   ::= no_pragmas ; pragmas(PLists, PActs) ; pragmas(PLists, PActs, PStands).
%% What a schema does to the atom a standing declaration stands on (cvac.glp, standing_lines): makes the standing request, withdraws it, or neither.
StandAct  ::= makes(Constant) ; withdraws(Constant) ; plain.

imported procedure cvac#compile(Constant?, Declared?, Verdict?).
exported procedure compile(Constant?, WDeclared?, Verdict?).
compile(Nm, D, V) :- unnamed(D?, D0), cvac # compile(Nm?, D0?, V?).
imported procedure cvac#compile(Constant?, Declared?, Verdict?, Intro?).
exported procedure compile(Constant?, WDeclared?, Verdict?, Intro?).
compile(Nm, D, V, I) :- unnamed(D?, D0), cvac # compile(Nm?, D0?, V?, I?).
%% compile(Name, Contract, Verdict, Intro, Pragmas): the same, with the contract's pragmas, so that the platform printed carries the contract's words (vGLP, Sections 5.4 and 6.2).
%% The contract's environment predicates, environment(Preds, Body) (programs/gsc/self.glp, WDeclared), go to the compiler beside the contract: "An environment predicate is the day, by the calendar, or a value the contract declares and does not fix ...: given when the platform is deployed, held from startup" (vGLP #24, Code_inbox.md, 2026-11-07 13:11 UTC, 4; vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications").
imported procedure cvac#compile(Constant?, Declared?, Verdict?, Intro?, Pragmas?, Preds?).
exported procedure compile(Constant?, WDeclared?, Verdict?, Intro?, Pragmas?).
compile(Nm, D, V, I, P) :- ground(D?) | unnamed(D?, D0), env_of(D?, E), cvac # compile(Nm?, D0?, V?, I?, P?, E?).
procedure env_of(WDeclared?, Preds).
env_of(environment(Ps, _), Ps?).
env_of(_, []) :- otherwise | true.

%% ---------------------------------------------------------------------------
%% Shared by the modules of the compiler
%% ---------------------------------------------------------------------------

YesNo ::= yes ; no.
Ints  ::= [] ; [Integer | Ints].

procedure rs_lists(RoleSpec?, Atoms, Atoms, Atoms, Atoms).
rs_lists(rs(_, P, M, K, N), P?, M?, K?, N?).
rs_lists(crs(_, _, P, M, K, N), P?, M?, K?, N?).

%% A role's deleted atoms less its cleared ones: a cleared atom is deleted and not required (vGLP f8127b1, Section 5.4, "Act schemas as local specifications": "the act deletes every atom of the state that it matches, and requires none"), so the atoms a role requires are those it keeps and these, GSC's =(i) u -(i) (GSC 327e035, Definition "Speech-act schema", -(i) the atoms marked - with no wildcard).
procedure uncleared(Atoms?, Atoms).
uncleared([], []).
uncleared([A|As], R?) :- ground(A?) |
    cleared(A?, C),
    uncleared(As?, R1),
    keep_atom(C?, A?, R1?, R).
procedure keep_atom(YesNo?, Atom?, Atoms?, Atoms).
keep_atom(yes, _, R, R?).
keep_atom(no, A, R, [A?|R?]).
%% Whether an atom is cleared: the wildcard among its arguments, or as the speech act of a name term among them.
procedure cleared(Atom?, YesNo).
cleared(atom(_, As), C?) :- args_wild(As?, C).
cleared(times(_, A), C?) :- cleared(A?, C).
cleared(rest(_, _, A), C?) :- cleared(A?, C).
procedure args_wild(Args?, YesNo).
args_wild([], no).
args_wild([any|_], yes).
args_wild([nterm(N)|As], C?) :- nt_wild(N?, C1), args_wild1(C1?, As?, C).
args_wild([A|As], C?) :- otherwise, ground(A?) | args_wild(As?, C).
procedure args_wild1(YesNo?, Args?, YesNo).
args_wild1(yes, _, yes).
args_wild1(no, As, C?) :- args_wild(As?, C).
procedure nt_wild(NameTerm?, YesNo).
nt_wild(own(_), no).
nt_wild(own_var(_), no).
nt_wild(nvar(_), no).
nt_wild(ext(N, _), C?) :- nt_wild(N?, C).
nt_wild(ext_any(_), yes).

procedure rs_guarded(RoleSpec?, YesNo).
rs_guarded(rs(guarded, _, _, _, _), yes).
rs_guarded(rs(guarded_at(_), _, _, _, _), yes).
rs_guarded(rs(unguarded, _, _, _, _), no).
rs_guarded(crs(_, guarded, _, _, _, _), yes).
rs_guarded(crs(_, guarded_at(_), _, _, _, _), yes).
rs_guarded(crs(_, unguarded, _, _, _, _), no).

%% The variables of a schema in the order of its head, tau(pi_1, ..., pi_k ; x_1, ..., x_m): its roles, role(1) to role(K), then the variables its head lists, Hd, in that order (GSC 0228e79, Definition "Act schema"; vGLP #15 Cowork to Code, 2026-10-19 13:34 UTC, item 2: the compiler takes the order of a class's arguments "from the schema's head as GSC's term form gives it").  GSC's checker refuses a schema whose head is not its variables, malformed(Faults), and the compiler compiles no contract so refused.
procedure schema_vars(RoleSpecs?, Args?, Args).
schema_vars(Rs, Hd, Vs?) :- ground(Rs?), ground(Hd?) |
    rs_count(Rs?, K),
    role_args(1, K?, Ro),
    app(Ro?, Hd?, Vs).
procedure rs_count(RoleSpecs?, Integer).
rs_count([], 0).
rs_count([_|Rs], N?) :- rs_count(Rs?, M), N := M? + 1.
procedure role_args(Integer?, Integer?, Args).
role_args(I, K, []) :- I? > K? | true.
role_args(I, K, [role(I?)|R?]) :- I? =< K? | I1 := I? + 1, role_args(I1?, K?, R).
procedure atoms_args(Atoms?, Args).
atoms_args([], []).
atoms_args([atom(_, As)|Xs], R?) :- atoms_args(Xs?, R1), app(As?, R1?, R).
%% A multiplicity is an argument of its atom here: "an atom it adds or deletes may carry a multiplicity, a number or a numeric variable" (vGLP 613ee8d, Section 5.4).
atoms_args([times(K, A)|Xs], [K?|R?]) :- atoms_args([A?|Xs?], R).
atoms_args([rest(K, J, A)|Xs], [K?, J?|R?]) :- atoms_args([A?|Xs?], R).

%% --- Numbers -----------------------------------------------------------------
%% "A variable that occurs only in atoms the schema requires or deletes at one role, and in the constraint, is local to that role ...; a constraint is local to the role whose local variables it names, and to every role where it names none.  A schema-binding does not bind a local variable: the machine of the person in that role finds a value for it in its own state.  Every other variable is bound by the schema-binding, and a request names it" (vGLP 8a3ae79, Section 5.4, "Speech-act schemas as local specifications").  num_info(Name, Constraint, Locals, Role): a schema's constraint, true where it has none; its local variables, each loc(I, V), V an agent, speech-act or numeric variable, pvar(X), svar(X) or num(X), and I the index of the role it is local to; and the role whose local variables the constraint names, at(I), every where it names none, so that every role checks it, and two_roles where it names those of two roles or more, which the contract being a local specification forbids ("a constraint names the local variables of one role", ibid.).
Loc     ::= loc(Integer, Arg).
Locs    ::= [] ; [Loc | Locs].
CRole   ::= every ; at(Integer) ; two_roles.
%% A safe formula of a schema's body with the role it is local to: "A safe formula of B, and a quantified conjunct, is local to a role where every atom of it, but the literals of a listed role in its conclusion, is held by that role, and every variable of it is a role, a variable of the schema, a variable of its quantifiers or local to that role: the machine of the person in that role evaluates it in its own state" (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications"): fi(at(I), F), local to the role I; fi(every, F), a formula with no atom and no local variable, local to every role, as a constraint that names no local variable is, which each checks; and fi(nowhere, F), local to no role, which the contract being a local specification forbids (local.glp, form_infos).
FRole   ::= every ; at(Integer) ; nowhere.
FInfo   ::= fi(FRole, Form).
FInfos  ::= [] ; [FInfo | FInfos].
NumInfo ::= num_info(Constant, Constraint, Locs, CRole, FInfos).
NumInfos ::= [] ; [NumInfo | NumInfos].
procedure num_lookup(Constant?, NumInfos?, NumInfo).
num_lookup(Nm, [], num_info(Nm?, true, [], every, [])).
num_lookup(Nm, [num_info(N, C, L, R, F)|_], num_info(N?, C?, L?, R?, F?)) :- Nm? =?= N? | true.
num_lookup(Nm, [_|Ns], I?) :- otherwise | num_lookup(Nm?, Ns?, I).
%% The local variables, as arguments.
procedure loc_vars(Locs?, Args).
loc_vars([], []).
loc_vars([loc(_, V)|Ls], [V?|Vs?]) :- loc_vars(Ls?, Vs).
%% Whether an argument is a numeric variable, num(X) with X a name, not a number.
procedure is_nvar(Arg?, YesNo).
is_nvar(num(X), no) :- number(X?) | true.
is_nvar(num(X), yes) :- otherwise, ground(X?) | true.
is_nvar(real(_), yes).
is_nvar(role(_), no).
is_nvar(pvar(_), no).
is_nvar(svar(_), no).
is_nvar(item_of(_), no).
is_nvar(nterm(_), no).
is_nvar(sgn(_, _), no).
is_nvar(any, no).
is_nvar(ilist(_, _), no).
%% The numeric arguments a constraint names, those of its expressions included.
procedure con_args(Constraint?, Args).
con_args(true, []).
con_args(and(C1, C2), A?) :- con_args(C1?, A1), con_args(C2?, A2), app(A1?, A2?, A).
con_args(eq(X, Y), A?) :- exprs_args(X?, Y?, A).
con_args(le(X, Y), A?) :- exprs_args(X?, Y?, A).
con_args(lt(X, Y), A?) :- exprs_args(X?, Y?, A).
con_args(ge(X, Y), A?) :- exprs_args(X?, Y?, A).
con_args(gt(X, Y), A?) :- exprs_args(X?, Y?, A).
con_args(succ(X, Y), [X?, Y?]).
con_args(or(C1, C2), A?) :- con_args(C1?, A1), con_args(C2?, A2), app(A1?, A2?, A).
%% A signing condition names an agent and a speech-act variable, no numeric variable, so it is local to every role.
con_args(signed(U, Y), [U?, Y?]).
con_args(unsigned(U, Y), [U?, Y?]).
con_args(not(C), A?) :- con_args(C?, A).
con_args(implies(C1, C2), A?) :- con_args(C1?, A1), con_args(C2?, A2), app(A1?, A2?, A).
con_args(ne(X, Y), A?) :- exprs_args(X?, Y?, A).
con_args(rel(_, Es), A?) :- exprl_args(Es?, A).
%% A program condition of a speech act is refused before this is read (cvac.glp, con_beyond); the clause covers the type.
con_args(program(_), []).
procedure exprs_args(Expr?, Expr?, Args).
exprs_args(X, Y, A?) :- expr_args(X?, A1), expr_args(Y?, A2), app(A1?, A2?, A).
%% The numeric arguments of an expression, in order.
procedure expr_args(Expr?, Args).
expr_args(plus(X, Y), A?) :- exprs_args(X?, Y?, A).
expr_args(minus(X, Y), A?) :- exprs_args(X?, Y?, A).
expr_args(mul(X, Y), A?) :- exprs_args(X?, Y?, A).
expr_args(num(X), [num(X?)]).
expr_args(real(X), [num(X?)]).
expr_args(role(I), [role(I?)]).
expr_args(pvar(X), [pvar(X?)]).
expr_args(svar(X), [svar(X?)]).
expr_args(nterm(N), [nterm(N?)]).
expr_args(sgn(Y, J), [sgn(Y?, J?)]).
%% The wildcard is in no constraint (GSC 327e035: it occurs only in a cleared atom); the clause covers the type.
expr_args(any, [any]).
%% The place of a conjunct's instances is in no atom, constraint or request (cvac.glp, inst_heads); the clause covers the type.
expr_args(ilist(_, _), []).
%% A function's arguments; a cardinality and a sum, which bind their own variables, are refused before any procedure reads their arguments (cvac.glp, q_lines), and the clauses cover the type.
expr_args(fn(_, Es), A?) :- exprl_args(Es?, A).
expr_args(cardinality(_, _, _, _), []).
expr_args(sum(_, _, _, _, _), []).
%% The author and the item of a speech act name its speech-act variable (vGLP 27bae5d, Section 5.4, "Speech-act schemas as local specifications": "a constraint ... is over the relations and functions the value types provide --- ...; the signer, the author and the item of a speech act, its last signer, its first signer and its utterance"; vGLP #24, Code_inbox.md, 2026-11-07 22:27 UTC, 20:36 item 1).
expr_args(author_of(Y), A?) :- expr_args(Y?, A).
expr_args(item_of(Y), A?) :- expr_args(Y?, A).
procedure exprl_args(Exprs?, Args).
exprl_args([], []).
exprl_args([E|Es], A?) :- expr_args(E?, A1), exprl_args(Es?, A2), app(A1?, A2?, A).

%% A schema's listed roles (GSC 8064cfb, Appendix D, Definition "Role"; vGLP c649c0d, Section 5.4, "Act schemas as local specifications": "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles"): their indices, from 1, in the order of the roles (listed_ixs); each with its index, its base, the index of its agent role, its predicate rho and its arguments u_2, ..., u_r, listing(I, Base, Rho, Args), in the order of the roles (listed_all); their bases (listed_bases); and the arguments of a role that are no arguments of its atoms, a listed role's (kind_args).  "the listed roles of a schema have one base" (ibid.), which local.glp decides.
Listing  ::= listing(Integer, Integer, Constant, Args).
Listings ::= [] ; [Listing | Listings].
%% A listed role as the shared text reads it (cvac.glp, text_schemas): listing(I, Base, Rho, Args, Phi, CAdd, CDel), the condition Phi of its quantifier and the conditional literals CAdd and CDel of its conjunct, each hm(J, M) the atom M at the agent role J for each person of the role (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "the instances of a conjunct with a listed role give the people of the role, one for each instance, and the instances of a conjunct with conditional literals give the atoms each adds or deletes").
%% A conjunct with conditional literals at a role other than the one holding its anchor, binding no listed role, as the shared text reads it: instances(K, Base, Xs, A, Phi, CAdd, CDel), the K-th such conjunct of its schema, Base the index of the role holding its anchor A, Xs the variables its quantifier binds, of any kind, an instance an assignment of all of them, Phi its condition and CAdd and CDel its conditional literals, each hm(J, M) the atom M at the agent role J for each instance, each variable of Xs in M standing for its value at that instance (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "the instances of a conjunct with conditional literals give the atoms each adds or deletes"; "A conjunct ... with conditional literals at a role other than the one holding its anchor, is local to its base; the base's machine finds its instances, the attempt names them, and every participant takes them as arguments of the transaction").
TListing  ::= listing(Integer, Integer, Constant, Args, Form, HMults, HMults)
            ; instances(Integer, Integer, Args, Atom, Form, HMults, HMults).
TListings ::= [] ; [TListing | TListings].
%% A schema as the shared text reads it: schema(Name, Head, Roles), or lschema(Name, Head, Roles, Listings) for one with listed roles.
TSchema   ::= schema(Constant, Args, RoleSpecs) ; lschema(Constant, Args, RoleSpecs, TListings).
TSchemas  ::= [] ; [TSchema | TSchemas].
%% The condition and the conditional literals of each listed role of a schema with quantifiers, lx(Schema, I, Phi, CAdd, CDel) (cvac.glp, lx_table).
%% And each conjunct of a schema with conditional literals at a role other than the one holding its anchor that binds no listed role, ix(Schema, K, Base, Xs, A, Phi, CAdd, CDel), the K-th of its schema in conjunct order (cvac.glp, ix_conjs).
%% And each conjunct binding no listed role whose conditional literals are all at the role holding its anchor, local to that role, lc(Schema, Base, Xs, A, Phi, CAdd, CDel) (cvac.glp, lc_conjs).
%% And each real variable X of a schema S, rl(S, X) (cvac.glp, real_lx).
Lx        ::= lx(Constant, Integer, Form, HMults, HMults)
            ; ix(Constant, Integer, Integer, Args, Atom, Form, HMults, HMults)
            ; lc(Constant, Integer, Args, Atom, Form, HMults, HMults)
            ; rl(Constant, Constant).
Lxs       ::= [] ; [Lx | Lxs].
procedure listed_ixs(RoleSpecs?, Integer?, Ints).
listed_ixs([], _, []).
listed_ixs([crs(listed(_, _, _), _, _, _, _, _)|Rs], I, [I?|Is?]) :- integer(I?) | I1 := I? + 1, listed_ixs(Rs?, I1?, Is).
listed_ixs([_|Rs], I, Is?) :- otherwise, integer(I?) | I1 := I? + 1, listed_ixs(Rs?, I1?, Is).
%% The places of a schema's class term that hold lists: those of its listed roles, in the order of the roles, and those of the instances of its conjuncts, ilist(K), after its variables, in conjunct order (cvac.glp, inst_heads).
procedure list_places(RoleSpecs?, Args?, Ints).
list_places(Rs, Hd, Lis?) :- ground(Rs?), ground(Hd?) |
    listed_ixs(Rs?, 1, L1),
    schema_vars(Rs?, Hd?, Vs),
    ilist_places(Vs?, 1, L2),
    app(L1?, L2?, Lis).
procedure ilist_places(Args?, Integer?, Ints).
ilist_places([], _, []).
ilist_places([ilist(_, _)|Vs], I, [I?|Is?]) :- integer(I?) | I1 := I? + 1, ilist_places(Vs?, I1?, Is).
ilist_places([_|Vs], I, Is?) :- otherwise, integer(I?) | I1 := I? + 1, ilist_places(Vs?, I1?, Is).
procedure listed_all(RoleSpecs?, Integer?, Listings).
listed_all([], _, []).
listed_all([crs(listed(B, Rho, As), _, _, _, _, _)|Rs], I, [listing(I?, B?, Rho?, As?)|Ls?]) :- integer(I?) | I1 := I? + 1, listed_all(Rs?, I1?, Ls).
listed_all([_|Rs], I, Ls?) :- otherwise, integer(I?) | I1 := I? + 1, listed_all(Rs?, I1?, Ls).
procedure listed_bases(RoleSpecs?, Ints).
listed_bases([], []).
listed_bases([crs(listed(B, _, _), _, _, _, _, _)|Rs], [B?|Bs?]) :- listed_bases(Rs?, Bs).
listed_bases([_|Rs], Bs?) :- otherwise | listed_bases(Rs?, Bs).
procedure kind_args(RoleSpec?, Args).
kind_args(rs(_, _, _, _, _), []).
kind_args(crs(listed(_, _, As), _, _, _, _, _), As?).
kind_args(crs(seated(_, _), _, _, _, _, _), []).
kind_args(crs(constituent(_, _), _, _, _, _, _), []).
kind_args(crs(qlisted(_, _, As, _), _, _, _, _, _), As?).

procedure and(YesNo?, YesNo?, YesNo).
and(yes, B, B?).
and(no, _, no).
procedure or(YesNo?, YesNo?, YesNo).
or(yes, _, yes).
or(no, B, B?).
procedure neg(YesNo?, YesNo).
neg(yes, no).
neg(no, yes).

procedure(X) app(Stream(X)?, Stream(X)?, Stream(X)).
app([], Ys, Ys?).
app([X|Xs], Ys, [X?|Zs?]) :- app(Xs?, Ys?, Zs).
procedure(X) mem(X?, Stream(X)?, YesNo).
mem(_, [], no).
mem(X, [Y|_], yes) :- X? =?= Y? | true.
mem(X, [_|Ys], R?) :- otherwise | mem(X?, Ys?, R).
procedure(X) dedup(Stream(X)?, Stream(X)).
dedup([], []).
dedup([X|Xs], [X?|Ys?]) :- ground(X?) | remove_all(X?, Xs?, Xs1), dedup(Xs1?, Ys).
procedure(X) remove_all(X?, Stream(X)?, Stream(X)).
remove_all(_, [], []).
remove_all(X, [Y|Ys], Zs?) :- X? =?= Y? | remove_all(X?, Ys?, Zs).
remove_all(X, [Y|Ys], [Y?|Zs?]) :- otherwise | remove_all(X?, Ys?, Zs).

%% A place of a class term a question does not name, shown after it by the name of its field: vp(I, F, named) of a person, vp(I, F, valued) of a number (cvac.glp, schema_sentence1).
VPlace    ::= vp(Integer, String, Constant).
VPlaces   ::= [] ; [VPlace | VPlaces].
FieldAt   ::= field(String) ; nofield.

%% Lines of source.  The compiler builds each line it prints as a string (cvac.glp, the head of the file): call_text(F, As, T), T the text of F applied to the texts As, F as it is, a name of the compiler's own or the words of a comment; named_call(F, As, T), the same for a name F from the contract, through term_to_string/2, F alone where As is empty; said(H, C, T), the comment H applied to the constant C; list_text(As, T), the texts As as a list (GLP-Spec ca3c8e5, appendix-guards, "Text": "a list as [a, b] or [a, b | T], arguments and elements separated by a comma and a space").
procedure call_text(String?, Strings?, String).
call_text(F, As, T?) :- ground(F?), ground(As?) |
    join_texts(As?, J),
    string_concat([F?, '(', J?, ')'], T).
procedure named_call(Constant?, Strings?, String).
named_call(F, [], T?) :- term_to_string(F?, T).
named_call(F, [A|As], T?) :- ground(F?), ground(A?), ground(As?) |
    term_to_string(F?, Ft),
    call_text(Ft?, [A?|As?], T).
procedure said(String?, Constant?, String).
said(H, C, T?) :- ground(H?), ground(C?) |
    term_to_string(C?, Ct),
    call_text(H?, [Ct?], T).
procedure list_text(Strings?, String).
list_text(As, T?) :- ground(As?) |
    join_texts(As?, J),
    string_concat(['[', J?, ']'], T).
procedure join_texts(Strings?, String).
join_texts([], '').
join_texts([A], A?).
join_texts([A, B|As], T?) :- ground(A?), ground(B?), ground(As?) |
    join_texts([B?|As?], J),
    string_concat([A?, ', ', J?], T).
