%% cvac.glp --- compile(Name, Contract, Verdict): the canonical CVA platform of
%% an act-schema contract, printed as a .vglp module (vGLP, Section 3.2,
%% Definition "Canonical CVA Platform"; Section 5.4, "The compilation" and the
%% paragraph "Act schemas"; self.glp says more).
%%
%% A contract is compiled when programs/gsc finds it syntactically grassroots, grassroots with wards or syntactically grassroots with wards, or finds no fault in it but its introductory acts, so with traceable provenance and volition (verdict_lines below), every role a party role or a listed role, and no name variable (role_lines), so that it is a local specification (vGLP 099f876, Section 5.4, "Act schemas as local specifications": "Such a contract is a local specification"), and when it is effective, by the same paragraph, which local.glp decides.  Otherwise it prints the lines saying why and nothing else.  A signed term sgn(y, i) in an added atom is the speech act bound to y, signed by the person in role i (vGLP, Section 5.4, "Act schemas as local specifications"; GSC, Definition "Act schema"): local.glp decides the contract over it and the printed text, text.glp, computes it.
%%
%% The module is what is printed from the contract, here, and the text every contract shares, text.glp.  What is printed from the contract is the type Class, one alternative per schema, the schema's name applied to the people in its roles and then the values of its variables, in the order of its head, tau(pi_1, ..., pi_k ; x_1, ..., x_m), as GSC's term form gives it (GSC 0228e79, Definition "Act schema"; vGLP #15 Cowork to Code, 2026-10-19 13:34 UTC, item 2), a term of it naming a schema-binding and so its part and its class (vGLP 099f876, Section 5.4, "Act schemas as local specifications": "each schema-binding determines a part [t]_j of its class"); the request type, Request, with the alternative propose([t]_j) for each guarded part [t]_j, a term of Proposal, the alternatives of the schemas whose terms name guarded parts, and the alternative known(Peer) (Section 5.4, "The compilation"); the
%% contract itself, as the term programs/gsc reads, from which the shared text
%% computes the classes and their parts, and each schema under its name,
%% schema_entry; its reflexive predicates; and per
%% schema a clause taking a term of Class to the binding it names, binding_of,
%% and one taking a binding back to the term, class_of.  Each line is a string, built by string_concat/2, each constant from the contract written through term_to_string/2 so that the reader reads it back as the same constant, pvar('Carol') and not pvar(Carol), and each variable of the printed program, V1 or V1? from vname/3, and each type written as it is (GLP-Spec ca3c8e5, appendix-guards, "Text": "A program that prints GLP source, as a compiler does, builds each line as a string by these two, a constant of the source by term_to_string/2 and a variable or a type T? by string_concat/2, and prints it by send_to_user/1"; vGLP #23, Code_inbox.md, 2026-11-06 07:57 UTC); self.glp has the procedures, said/3, call_text/3, named_call/3 and list_text/2.

Line  ::= String ; guarded_only(Line) ; unguarded_only(Line)
        ; day_only(Line) ; dayless_only(Line).
Lines ::= [] ; [Line | Lines].
imported procedure text#fixed_text(Lines).
imported procedure local#faults(Contract?, Preds?, NumInfos?, Strings).
imported procedure local#num_info_of(Constant?, Args?, Constraint?, Forms?, RoleSpecs?, NumInfo).
imported procedure local#proposable(Contract?, Preds?, Preds).

Found ::= named(String, String) ; unnamed.

exported procedure compile(Constant?, Declared?, Verdict?).
compile(Nm, D, V) :- compile_intro(Nm?, D?, V?, no_introduction, words(no_pragmas)).
%% compile(Name, Contract, Verdict, Intro): the same, for a contract naming
%% an introduction predicate e, introduction(e), whose introduction rule the
%% platform's agents follow (vGLP, Section 3.2, Definition "Introduction Rule,
%% Introduce Peers"; Section 5.4, the paragraph on act schemas), or none,
%% no_introduction.
exported procedure compile(Constant?, Declared?, Verdict?, Intro?).
compile(Nm, D, V, I) :- compile_intro(Nm?, D?, V?, I?, words(no_pragmas)).
%% compile(Name, Contract, Verdict, Intro, Pragmas): the same, for a contract carrying pragmas, the words its app shows (vGLP, Section 5.4, "The contract's words": "The compiler carries them into the platform it prints: a request's label and field names and an approval question's two answers into the widget declarations it prints for the platform's request type and approval type, a sentence into the approval question that Start raises, and a list's name into the view the agent writes"; Section 6.2, "The words a platform shows").  Each act a pragma proposes is the schema its button names: "a button for each act of it a person proposes, in brackets, each bearing its act's name" (GSC 2991379, Section 2, its first paragraph).  A contract with no pragmas, no_pragmas, as compile/3 and compile/4 give it, is checked and not printed (compile3a).
exported procedure compile(Constant?, Declared?, Verdict?, Intro?, Pragmas?).
compile(Nm, D, V, I, P) :- compile_intro(Nm?, D?, V?, I?, words(P?)).
%% The contract's words, its pragmas, carried through the compiler whole.
Words ::= words(Pragmas).
%% The words of a contract carrying pragmas, the only contract the compiler prints a platform from (compile3a; vGLP, Section 5.4, "The contract's words"), which every procedure past compile3a takes.
Worded ::= words(Given).
Given  ::= pragmas(PLists, PActs).
%% Numbers (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications"): each schema's constraint, its local variables and the role whose local variables the constraint names, the table Nt (local.glp, num_info_of); the contract compiled is its plain form (plain_contract), each schema's head less its local variables, which "the schema-binding does not bind", so that a class term names the schema-binding: its roles and its other variables, "bound by the schema-binding, as a speech-act variable is", in the order of the head.
procedure compile_intro(Constant?, Declared?, Verdict?, Intro?, Words?).
compile_intro(Nm, D, V, I, W) :- ground(Nm?), ground(D?) |
    decl_schemas(D?, Cq),
    q_lines(Cq?, Nm?, Lq),
    compile_q(Lq?, Nm?, D?, V?, I?, W?).
%% A contract the compiler does not take, by q_lines, is refused before any other procedure reads it, with the lines saying why.
procedure compile_q(Lines?, Constant?, Declared?, Verdict?, Intro?, Words?).
compile_q([L|Ls], _, _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).
compile_q([], Nm, D, V, I, W) :- ground(D?), ground(I?) |
    decl_schemas(D?, C0),
    decl_schemas(D?, C1),
    decl_schemas(D?, C2),
    num_table(C1?, Nt),
    num_table(C2?, Nt1),
    plain_contract(C0?, Nt1?, C),
    decl_reflexive(D?, Rf),
    intro_preds(I?, E),
    compile0(Nm?, C?, Rf?, E?, Nt?, V?, W?).
procedure intro_preds(Intro?, Preds).
intro_preds(no_introduction, []).
intro_preds(introduction(P), [P?]).
procedure compile0(Constant?, Contract?, Preds?, Preds?, NumInfos?, Verdict?, Words?).
compile0(Nm, C, Rf, E, Nt, V, W) :- ground(Nm?), ground(C?) |
    verdict_lines(V?, Nm?, L1),
    role_lines(C?, Nm?, L2),
    lapp(L1?, L2?, L),
    compile1(L?, Nm?, C?, Rf?, E?, Nt?, W?).

procedure compile1(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?).
compile1([], Nm, C, Rf, E, Nt, W) :- ground(C?) |
    names_lines(C?, Nm?, L1),
    compile2(L1?, Nm?, C?, Rf?, E?, Nt?, W?).
compile1([L|Ls], _, _, _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

procedure compile2(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?).
compile2([], Nm, C, Rf, E, Nt, W) :- ground(C?), ground(Rf?), ground(Nt?) |
    local # faults(C?, Rf?, Nt?, Fs),
    compile3(Fs?, Nm?, C?, Rf?, E?, Nt?, W?).
compile2([L|Ls], _, _, _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

procedure compile3(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?).
compile3([], Nm, C, Rf, E, Nt, W) :- ground(C?), ground(Rf?), ground(W?) |
    local # proposable(C?, Rf?, Ps),
    compile3a(Ps?, Nm?, C?, Rf?, E?, Nt?, W?).
compile3([F|Fs], Nm, _, _, _, _, _) :- ground(Nm?) |
    said('%% not compiled', Nm?, H),
    send_to_user(['%% compile begin', H?, F?|Fs1?]),
    lapp(Fs?, ['%% compile end'], Fs1).

%% A contract that passes the checks and carries no pragmas is refused, with the line saying why: "Every other word the app shows is the contract's, so the compiler prints a platform only from a contract with pragmas, and refuses one with none; the checks that a contract is local, effective and grassroots are of its schemas and need none" (vGLP ffcb093, Section 5.4, "The contract's words").  compile/3 and compile/4, which give no pragmas, so check a contract and print no platform.
procedure compile3a(Preds?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?).
compile3a(_, Nm, _, _, _, _, words(no_pragmas)) :- ground(Nm?) |
    said('%% not compiled, having no pragmas', Nm?, H),
    send_to_user(['%% compile begin', H?,
        '%% it passes the checks, its verdict, local and effective, and has no pragmas, the words its app shows: the compiler prints a platform only from a contract with pragmas, and refuses one with none (vGLP, Section 5.4, "The contract\'s words").',
        '%% compile end']).
compile3a(Ps, Nm, C, Rf, E, Nt, words(pragmas(Ls, As))) :- ground(Ps?), ground(C?), ground(Ls?), ground(As?) |
    word_faults(words(pragmas(Ls?, As?)), C?, Ps?, Wf),
    compile4(Wf?, Nm?, C?, Rf?, E?, Nt?, words(pragmas(Ls?, As?)), Ps?).

%% A contract whose words do not name its schemas, or leave a guarded schema with no button, is not compiled, with the lines saying why (word_faults).
procedure compile4(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Worded?, Preds?).
compile4([], Nm, C, Rf, E, Nt, W, Ps) :-
    module_lines(Nm?, C?, Rf?, E?, Nt?, W?, Ps?, Ls),
    send_to_user(['%% compile begin'|Ls?]).
compile4([L|Ls], Nm, _, _, _, _, _, _) :- ground(Nm?) |
    said('%% not compiled', Nm?, H),
    send_to_user(['%% compile begin', H?, L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

%% --- The contract compiled ------------------------------------------------
%% What the compiler takes of a schema with quantifiers (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications"), qschema in GSC's term form, and of a constraint, and the lines refusing what it does not take, the schema named, before any other procedure reads the contract:
%% (1) A safe formula of the body local to a role, "the machine of the person in that role evaluates it in its own state", is taken (local.glp, form_infos; the printed text's forms_at).
%% (2) A quantified conjunct of the head, with a listed role bound by its quantifier or with conditional literals, is not: "its request name is the schema-binding with, where the base of the schema is a guarding role, the instances of L" (ibid.), a list of instances, where Definition "Effective Local Specification" has "a request name, a term of an interactive type in which no Stream or List occurs", and the view carries the approvals by their request names, under a List (Section 5.4, "The compilation").  Until the paper says how a request name carries the instances, the compiler refuses such a schema.
%% (3) A relation, a function, a cardinality or a sum in a constraint or a safe formula is not: the constraint is "a decidable condition on the values its binding assigns, in the relations their types provide --- linear arithmetic on its numeric variables, and signed(u, y) and unsigned(u, y)" (ibid.).
procedure q_lines(QContract?, Constant?, Lines).
q_lines(C, Nm, L?) :- ground(C?), ground(Nm?) |
    q_faults(C?, L0),
    head_line(L0?, Nm?, L).
procedure q_faults(QContract?, Lines).
q_faults([], []).
q_faults([S|Ss], L?) :- ground(S?) |
    q_schema(S?, L1),
    q_faults(Ss?, L2),
    lapp(L1?, L2?, L).
procedure q_schema(QSchema?, Lines).
q_schema(schema(_, _, _), []).
q_schema(cschema(_, _, _, _), []).
q_schema(nschema(S, _, C, _), L?) :- ground(S?) |
    con_beyond(C?, B),
    beyond_lines(B?, S?, L).
q_schema(qschema(S, _, _, C, Rs, Cj, Fs), L?) :- ground(S?), ground(Rs?) |
    some_conjunct(Cj?, Q1),
    some_qlisted(Rs?, Q2),
    or(Q1?, Q2?, Q),
    conjunct_lines(Q?, S?, L1),
    con_beyond(C?, B1),
    forms_beyond(Fs?, B2),
    or(B1?, B2?, B),
    beyond_lines(B?, S?, L2),
    lapp(L1?, L2?, L).
procedure some_conjunct(Conjuncts?, YesNo).
some_conjunct([], no).
some_conjunct([_|_], yes).
procedure some_qlisted(RoleSpecs?, YesNo).
some_qlisted([], no).
some_qlisted([crs(qlisted(_, _, _, _), _, _, _, _, _)|_], yes).
some_qlisted([_|Rs], B?) :- otherwise | some_qlisted(Rs?, B).
procedure conjunct_lines(YesNo?, Constant?, Lines).
conjunct_lines(no, _, []).
conjunct_lines(yes, S, ['%% it has a quantified conjunct in a schema\'s head, a listed role bound by its quantifier or conditional literals, which the compiler does not take: the request name of a part whose base is a guarding role carries the instances (vGLP, Section 5.4, "Speech-act schemas as local specifications"), a list, where Definition "Effective Local Specification" has no List in a request name:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
procedure beyond_lines(YesNo?, Constant?, Lines).
beyond_lines(no, _, []).
beyond_lines(yes, S, ['%% it has a relation, a function, a cardinality or a sum in a constraint or a safe formula, which vGLP Section 5.4 does not take, a constraint being of linear arithmetic and signing conditions:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
%% Whether a constraint, an expression or a safe formula holds a relation, a function, a cardinality or a sum.
procedure con_beyond(Constraint?, YesNo).
con_beyond(true, no).
con_beyond(and(C1, C2), B?) :- con_beyond(C1?, B1), con_beyond(C2?, B2), or(B1?, B2?, B).
con_beyond(or(C1, C2), B?) :- con_beyond(C1?, B1), con_beyond(C2?, B2), or(B1?, B2?, B).
con_beyond(implies(C1, C2), B?) :- con_beyond(C1?, B1), con_beyond(C2?, B2), or(B1?, B2?, B).
con_beyond(not(C), B?) :- con_beyond(C?, B).
con_beyond(eq(X, Y), B?) :- exprs_beyond(X?, Y?, B).
con_beyond(ne(X, Y), B?) :- exprs_beyond(X?, Y?, B).
con_beyond(le(X, Y), B?) :- exprs_beyond(X?, Y?, B).
con_beyond(lt(X, Y), B?) :- exprs_beyond(X?, Y?, B).
con_beyond(ge(X, Y), B?) :- exprs_beyond(X?, Y?, B).
con_beyond(gt(X, Y), B?) :- exprs_beyond(X?, Y?, B).
con_beyond(succ(_, _), no).
con_beyond(signed(_, _), no).
con_beyond(unsigned(_, _), no).
con_beyond(rel(_, _), yes).
procedure exprs_beyond(Expr?, Expr?, YesNo).
exprs_beyond(X, Y, B?) :- expr_beyond(X?, B1), expr_beyond(Y?, B2), or(B1?, B2?, B).
procedure expr_beyond(Expr?, YesNo).
expr_beyond(plus(X, Y), B?) :- exprs_beyond(X?, Y?, B).
expr_beyond(minus(X, Y), B?) :- exprs_beyond(X?, Y?, B).
expr_beyond(mul(X, Y), B?) :- exprs_beyond(X?, Y?, B).
expr_beyond(fn(_, _), yes).
expr_beyond(cardinality(_, _, _, _), yes).
expr_beyond(sum(_, _, _, _, _), yes).
expr_beyond(role(_), no).
expr_beyond(pvar(_), no).
expr_beyond(svar(_), no).
expr_beyond(nterm(_), no).
expr_beyond(sgn(_, _), no).
expr_beyond(num(_), no).
expr_beyond(any, no).
procedure forms_beyond(Forms?, YesNo).
forms_beyond([], no).
forms_beyond([F|Fs], B?) :- form_beyond(F?, B1), forms_beyond(Fs?, B2), or(B1?, B2?, B).
procedure form_beyond(Form?, YesNo).
form_beyond(fa(_, _), no).
form_beyond(fnot(F), B?) :- form_beyond(F?, B).
form_beyond(fand(F, G), B?) :- form_beyond(F?, B1), form_beyond(G?, B2), or(B1?, B2?, B).
form_beyond(for(F, G), B?) :- form_beyond(F?, B1), form_beyond(G?, B2), or(B1?, B2?, B).
form_beyond(fexists(_, _, _, F), B?) :- form_beyond(F?, B).
form_beyond(fforall(_, _, _, F, Gs), B?) :- form_beyond(F?, B1), forms_beyond(Gs?, B2), or(B1?, B2?, B).
form_beyond(fcons(C), B?) :- con_beyond(C?, B).

procedure decl_schemas(Declared?, QContract).
decl_schemas([], []).
decl_schemas([S|Ss], [S?|Ss?]).
decl_schemas(reflexive(_, C), C?).
procedure decl_reflexive(Declared?, Preds).
decl_reflexive([], []).
decl_reflexive([_|_], []).
decl_reflexive(reflexive(Rf, _), Rf?).

%% vGLP, Section 5.4, the paragraph on act schemas, asks of a contract that it be a local and effective specification, and nothing of its being grassroots; its schemas compile to transactions by the realisation, which CSSN (Appendix B.4) takes for a contract with traceable provenance that satisfies volition by the definition GSC gives for a syntactically grassroots one.  So a contract is compiled where GSC's checker certifies it syntactically grassroots, or grassroots with wards (GSC, Appendix F: its introductory act unobstructed but for the marks, with their guardianships and relay acts, and its leaving marks; vGLP #14, 2026-10-18 12:24 UTC, A), or finds no fault in it but its introductory acts (vGLP 2026-10-16 13:53 UTC, C, as Code #9 gives it: "the compiler takes a contract with traceable provenance and volition"); a contract with community roles has no canonical platform here, its roles' extents being no participants of a binding.
procedure verdict_lines(Verdict?, Constant?, Lines).
verdict_lines(syntactically_grassroots, _, []).
verdict_lines(grassroots_with_wards(_, _, _, _, _), _, []).
verdict_lines(not_grassroots(Fs), Nm, L?) :- ground(Fs?), ground(Nm?) |
    realisable(Fs?, B),
    realisable_lines(B?, Nm?, L).
verdict_lines(malformed(_), Nm, [H?, '%% it is malformed; check_named in programs/gsc gives the faults.']) :-
    ground(Nm?) | said('%% not compiled', Nm?, H).
%% The verdict on a contract with wards and listed roles or name terms (def:sg-wards of CSSN's paper): compiled, its listed roles taken by vGLP Section 5.4 (vGLP f5f1644), and any other community role refused (role_lines).
verdict_lines(syntactically_grassroots_with_wards(_, _, _, _, _), _, []).
procedure realisable(Faults?, YesNo).
realisable([], yes).
realisable([no_introductory_act|Fs], B?) :- realisable(Fs?, B).
realisable([obstructed(_, _, _, _)|Fs], B?) :- realisable(Fs?, B).
realisable([untraceable(_)|_], no).
realisable([volition(_, _, _)|_], no).
%% obstructed_jointly(Act) is a fault of an introductory act, as obstructed is: each condition of def:unobstructed holds at some choice of its values, and no one choice satisfies them all (GSC bcc1891, Appendix "Values in Act Schemas"; programs/gsc/unobstructed.glp at GSC-unob3 62fb0342).
realisable([obstructed_jointly(_)|Fs], B?) :- realisable(Fs?, B).
realisable([reflexive(_, _, _)|_], no).
realisable([signed(_, _, _, _)|_], no).
%% A reading role with no edge to a guarding role from an atom that guarding role requires is a fault of volition (GSC 0380a8a, Definition "Volition"), as volition(_, _, _) is.
realisable([changes_nothing(_, _)|_], no).
%% A fault of a schema's form comes in a verdict malformed(Faults), which verdict_lines refuses whole; these clauses cover the type.
realisable([added_and_deleted(_, _, _)|_], no).
realisable([no_role_changes(_)|_], no).
realisable([head_not_variable(_, _)|_], no).
realisable([head_repeated(_, _)|_], no).
realisable([not_in_head(_, _)|_], no).
realisable([name_term_base(_, _)|_], no).
realisable([listed_base(_, _)|_], no).
realisable([listed_signed(_, _)|_], no).
realisable([listed_guarded(_, _)|_], no).
realisable([multiplicity_not_added(_, _, _)|_], no).
realisable([multiplicity_not_numeric(_, _, _)|_], no).
realisable([multiplicity_not_whole(_, _, _)|_], no).
realisable([constraint_not_numeric(_, _)|_], no).
realisable([constraint_not_linear(_, _)|_], no).
realisable([constraint_not_conjunction(_, _)|_], no).
realisable([signing_not_agent(_, _)|_], no).
realisable([signing_not_speech_act(_, _)|_], no).
procedure realisable_lines(YesNo?, Constant?, Lines).
realisable_lines(yes, _, []).
realisable_lines(no, Nm, [H?, '%% it lacks traceable provenance or volition, or is otherwise faulty; check_named in programs/gsc gives the faults.']) :-
    ground(Nm?) | said('%% not compiled', Nm?, H).

%% What vGLP Section 5.4 takes of GSC's community roles (vGLP f5f1644, "Act schemas as local specifications": "A listed role pi[rho(*, u_2, ..., u_r)], pi a party role, its base, has as its people at a schema-binding the persons q with rho(q, u_2, ..., u_r), so bound, in the state of the person in pi"; vGLP #15 Cowork to Code, 2026-10-19 14:24 UTC, item 1: "The compiler takes GSC's listed roles (Appendix D, 8064cfb), not seated or constituent roles, which it still refuses").  A contract is refused where a schema has a seated or a constituent role, or reach conditions, which are of community names; and where a name term is built on a name variable, which a seated role would need (vGLP #15 Cowork to Code, 2026-10-19 14:49 UTC).  A name term <u>.y_1...y_n built on a role or an agent variable is taken: it is "the community name of the person bound to u followed by the speech acts bound to y_1, ..., y_n" (vGLP c649c0d, Section 5.4), an atom holding one written in the view with the community name one argument, of the type CName the shared text defines.  A cschema with no reach conditions is a schema (plain_contract).  A schema may have several listed roles: "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles" (vGLP c649c0d, Section 5.4; vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC), and local.glp asks that they have one base.
Flags ::= f(YesNo, YesNo, YesNo).
procedure role_lines(Contract?, Constant?, Lines).
role_lines(C, Nm, L?) :- ground(C?), ground(Nm?) |
    role_flags(C?, f(no, no, no), F),
    flag_lines(F?, Nm?, L).
procedure role_flags(Contract?, Flags?, Flags).
role_flags([], F, F?).
role_flags([schema(_, _, Rs)|Ss], F, F2?) :- ground(Rs?), ground(F?) |
    schema_flags(no, Rs?, F?, F1),
    role_flags(Ss?, F1?, F2).
role_flags([nschema(_, _, _, _)|Ss], F, F2?) :- role_flags(Ss?, F?, F2).
role_flags([cschema(_, _, Rc, Rs)|Ss], F, F2?) :- ground(Rc?), ground(Rs?), ground(F?) |
    some_reach(Rc?, R),
    schema_flags(R?, Rs?, F?, F1),
    role_flags(Ss?, F1?, F2).
procedure schema_flags(YesNo?, RoleSpecs?, Flags?, Flags).
schema_flags(R, Rs, f(R0, S0, N0), f(R1?, S1?, N1?)) :- ground(Rs?) |
    or(R0?, R?, R1),
    seated_any(Rs?, S),
    or(S0?, S?, S1),
    spec_args(Rs?, As),
    nvar_in(As?, N),
    or(N0?, N?, N1).
procedure some_reach(Reaches?, YesNo).
some_reach([], no).
some_reach([_|_], yes).
procedure seated_any(RoleSpecs?, YesNo).
seated_any([], no).
seated_any([rs(_, _, _, _, _)|Rs], B?) :- seated_any(Rs?, B).
seated_any([crs(seated(_, _), _, _, _, _, _)|_], yes).
seated_any([crs(constituent(_, _), _, _, _, _, _)|_], yes).
seated_any([crs(listed(_, _, _), _, _, _, _, _)|Rs], B?) :- seated_any(Rs?, B).
%% The arguments of a schema's atoms, at every role, and of its listed roles.
procedure spec_args(RoleSpecs?, Args).
spec_args([], []).
spec_args([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M, K, N),
    atoms_args(P?, A1),
    atoms_args(M?, A2),
    atoms_args(K?, A3),
    atoms_args(N?, A4),
    kind_args(R?, A5),
    spec_args(Rs?, A6),
    app(A5?, A6?, A56),
    app(A4?, A56?, A46),
    app(A3?, A46?, A36),
    app(A2?, A36?, A26),
    app(A1?, A26?, As).
%% A name term built on a name variable, which a seated role would need: "Name variables, which a seated role would need, stay out with seated roles" (vGLP #15 Cowork to Code, 2026-10-19 14:49 UTC).
procedure nvar_in(Args?, YesNo).
nvar_in([], no).
nvar_in([nterm(T)|As], B?) :- nt_nvar(T?, B1), nvar_in1(B1?, As?, B).
nvar_in([_|As], B?) :- otherwise | nvar_in(As?, B).
procedure nvar_in1(YesNo?, Args?, YesNo).
nvar_in1(yes, _, yes).
nvar_in1(no, As, B?) :- nvar_in(As?, B).
procedure nt_nvar(NameTerm?, YesNo).
nt_nvar(own(_), no).
nt_nvar(own_var(_), no).
nt_nvar(nvar(_), yes).
nt_nvar(ext(T, _), B?) :- nt_nvar(T?, B).
nt_nvar(ext_any(T), B?) :- nt_nvar(T?, B).
procedure flag_lines(Flags?, Constant?, Lines).
flag_lines(f(R, S, N), Nm, L?) :- ground(Nm?) |
    flag_line(R?, '%% it has reach conditions, which vGLP Section 5.4 does not take.', L1),
    flag_line(S?, '%% it has seated or constituent roles, which vGLP Section 5.4 does not take: it takes listed roles (vGLP f5f1644).', L2),
    flag_line(N?, '%% it has name variables, which vGLP Section 5.4 does not take, as it does not take seated roles.', L3),
    lapp(L1?, L2?, L12),
    lapp(L12?, L3?, L0),
    head_line(L0?, Nm?, L).
procedure flag_line(YesNo?, String?, Lines).
flag_line(no, _, []).
flag_line(yes, X, [X?]).
procedure head_line(Lines?, Constant?, Lines).
head_line([], _, []).
head_line([X|Xs], Nm, [H?, X?|Xs?]) :- ground(Nm?) | said('%% not compiled', Nm?, H).

%% A cschema with no reach conditions is a schema of its roles (GSC, Appendix D: a schema carrying a finite set of reach conditions is written cschema, programs/gsc/README.md); a schema with a constraint, nschema, is a schema of its roles, its constraint in the table Nt; and each schema's head is taken less its local variables.
procedure plain_contract(QContract?, NumInfos?, Contract).
plain_contract([], _, []).
plain_contract([schema(S, Hd, Rs)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
plain_contract([nschema(S, Hd, _, Rs)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
plain_contract([cschema(S, Hd, [], Rs)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
plain_contract([cschema(S, Hd, [R|Rc], Rs)|Ss], Nt, [cschema(S?, Hd?, [R?|Rc?], Rs?)|Ps?]) :- plain_contract(Ss?, Nt?, Ps).
%% A schema with quantifiers, no quantified conjunct in its head and agent roles alone (q_lines), is a schema of its roles, its constraint and the safe formulas of its body in the table Nt.
plain_contract([qschema(S, Hd, _, _, Rs, _, _)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
procedure strip_locals(Constant?, Args?, NumInfos?, Args).
strip_locals(S, Hd, Nt, Hd1?) :- num_lookup(S?, Nt?, Ni), strip_locals1(Ni?, Hd?, Hd1).
procedure strip_locals1(NumInfo?, Args?, Args).
strip_locals1(num_info(_, _, Ls, _, _), Hd, Hd1?) :- loc_vars(Ls?, Vs), drop_args(Hd?, Vs?, Hd1).
procedure drop_args(Args?, Args?, Args).
drop_args([], _, []).
drop_args([A|As], Vs, R?) :- ground(A?), ground(Vs?) |
    mem(A?, Vs?, In),
    drop_args(As?, Vs?, R1),
    keep_unless(In?, A?, R1?, R).
procedure keep_unless(YesNo?, Arg?, Args?, Args).
keep_unless(yes, _, R, R?).
keep_unless(no, A, R, [A?|R?]).
%% The table of the schemas' numbers: each schema's constraint, true where it has none, its local variables and the role whose local variables the constraint names (local.glp, num_info_of).
procedure num_table(QContract?, NumInfos).
num_table([], []).
num_table([schema(S, Hd, Rs)|Ss], [N?|Ns?]) :- local # num_info_of(S?, Hd?, true, [], Rs?, N), num_table(Ss?, Ns).
num_table([nschema(S, Hd, C, Rs)|Ss], [N?|Ns?]) :- local # num_info_of(S?, Hd?, C?, [], Rs?, N), num_table(Ss?, Ns).
num_table([cschema(S, Hd, _, Rs)|Ss], [N?|Ns?]) :- local # num_info_of(S?, Hd?, true, [], Rs?, N), num_table(Ss?, Ns).
%% A schema with quantifiers whose head has no quantified conjunct and whose roles are agent roles, the only one q_lines lets through: its constraint and the safe formulas of its body, each with the role it is local to (local.glp, form_infos).
num_table([qschema(S, Hd, _, C, Rs, _, Fs)|Ss], [N?|Ns?]) :- local # num_info_of(S?, Hd?, C?, Fs?, Rs?, N), num_table(Ss?, Ns).

%% A schema's variables are named V1, V2, ... in the printed clauses; there are
%% as many names as vname/3 has.
procedure names_lines(Contract?, Constant?, Lines).
names_lines([], _, []).
names_lines([schema(S, Hd, Rs)|Ss], Nm, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Nm?) |
    schema_vars(Rs?, Hd?, Vs),
    count_args(Vs?, N),
    vname(N?, F),
    names_lines1(F?, S?, Ss?, Nm?, L).
names_lines([cschema(_, _, _, _)|Ss], Nm, L?) :- names_lines(Ss?, Nm?, L).
names_lines([nschema(_, _, _, _)|Ss], Nm, L?) :- names_lines(Ss?, Nm?, L).
procedure names_lines1(Found?, Constant?, Contract?, Constant?, Lines).
names_lines1(named(_, _), _, Ss, Nm, L?) :- names_lines(Ss?, Nm?, L).
names_lines1(unnamed, S, _, Nm, [H?, H2?]) :- ground(Nm?), ground(S?) |
    said('%% not compiled', Nm?, H),
    said('%% the compiler names the variables of no schema with this many, at', S?, H2).
procedure count_args(Args?, Integer).
count_args([], 0).
count_args([_|As], N?) :- count_args(As?, M), N := M? + 1.

%% --- The module ------------------------------------------------------------
procedure module_lines(Constant?, Contract?, Preds?, Preds?, NumInfos?, Worded?, Preds?, Lines).
module_lines(Nm, C, Rf, E, Nt, W, Ps, Ls?) :- ground(Nm?), ground(C?), ground(Rf?), ground(E?), ground(Nt?), ground(W?), ground(Ps?) |
    said('%% the canonical CVA platform of the contract', Nm?, H),
    class_lines(C?, L1),
    text # fixed_text(Fx),
    proposal_alts(C?, Ps?, Pa),
    request_lines(Pa?, Lr0),
    any_name(Ps?, Gd),
    day_required(C?, Dy),
    shared_lines(Fx?, Gd?, Dy?, Fx1),
    proved_rules(C?, Rl),
    widget_lines(W?, C?, Ps?, ctx(Rf?, Rl?), Lw),
    lapp(Lr0?, Lw?, Lr),
    atom_parts(C?, La),
    text_schemas(C?, Ct),
    schema_lines(Ct?, T1, Le0),
    numeric_lines(Nt?, Lm),
    lapp(Le0?, Lm?, Le),
    name_class_lines(C?, Ps?, Ln0),
    name_class_decl(Ln0?, Ln1),
    request_name_lines(C?, Ps?, Lq0),
    request_name_decl(Lq0?, Lq),
    word_lines(W?, C?, Lp),
    meeting_lines(C?, Ps?, Lmt),
    lapp(Lq?, Lp?, Lqp0),
    lapp(Lqp0?, Lmt?, Lqp),
    lapp(Ln1?, Lqp?, Ln),
    T2a =.. [reflexive_preds, Rf?],
    term_to_string(T2a?, T2),
    T3a =.. [introduction_preds, E?],
    term_to_string(T3a?, T3),
    binding_lines(C?, Nt?, L2),
    class_of_lines(C?, L3),
    lapp(Ln?, [''|Fx1?], Lnx),
    lapp(L3?, Lnx?, L3x),
    lapp(L2?, ['',
        'procedure class_of(Constant?, Binding?, Peer?, Class).'|L3x?], L2x),
    lapp(L1?, Lr1?, L1x),
    lapp(Lr?, La1?, Lr1),
    lapp(Le?, ['',
        'procedure reflexive_preds(Preds).',
        T2?,
        '.',
        '',
        'procedure introduction_preds(Preds).',
        T3?,
        '.',
        '',
        'procedure binding_of(Class?, Constant, Binding).'|L2x?], Le1),
    lapp(La?, ['',
        'procedure contract_schemas(Schemas).',
        T1?,
        '.'|Le1?], La1),
    lapp(['%% Printed by programs/vglp/cva/compiler from the contract named below, in the',
         '%% term form programs/gsc reads (GSC, Sections 3 and 5, Appendix D): the canonical CVA',
         '%% platform of the contract (vGLP, Section 3.2, Definition "Canonical CVA',
         '%% Platform"), two-phase commit coordinated by the initiating agent, compiled',
         '%% into vGLP by its compilation (Section 5.4, "The compilation").  Edit the',
         '%% contract or the compiler and run',
         '%% programs/vglp/cva/compile.sh, not this file.',
         H?,
         '',
         '%% ===========================================================================',
         '%% The contract',
         '%% ===========================================================================',
         '',
         'Class ::='|L1x?], ['%% compile end'], Ls).

%% Class ::= the schemas' alternatives, separated by ;.
procedure class_lines(Contract?, Lines).
class_lines([], ['.']).
class_lines([schema(S, Hd, Rs)|Ss], [A?|L?]) :- ground(S?), ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    var_types_l(Vs?, Lis?, Ts),
    named_call(S?, Ts?, A),
    class_lines1(Ss?, L).
class_lines([cschema(_, _, _, _)|Ss], L?) :- class_lines(Ss?, L).
class_lines([nschema(_, _, _, _)|Ss], L?) :- class_lines(Ss?, L).
procedure class_lines1(Contract?, Lines).
class_lines1([], ['.']).
class_lines1([S|Ss], [';'|L?]) :- class_lines([S?|Ss?], L).
%% The types of a class's arguments: at the place of each listed role, the list of its people (vGLP c649c0d, Section 5.4, "Act schemas as local specifications": "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles"), List(Peer), the people in the order of identifiers; the part's term carries the people of each, in the order of the roles (vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC).
procedure var_types_l(Args?, Ints?, Strings).
var_types_l([], _, []).
var_types_l([role(J)|Vs], Lis, [T?|Ts?]) :- ground(Lis?) | mem(J?, Lis?, In), role_type(In?, T), var_types_l(Vs?, Lis?, Ts).
var_types_l([pvar(_)|Vs], Lis, ['Peer'|Ts?]) :- var_types_l(Vs?, Lis?, Ts).
var_types_l([svar(_)|Vs], Lis, ['Speech'|Ts?]) :- var_types_l(Vs?, Lis?, Ts).
var_types_l([nterm(_)|Vs], Lis, ['Peer'|Ts?]) :- var_types_l(Vs?, Lis?, Ts).
var_types_l([sgn(_, _)|Vs], Lis, Ts?) :- var_types_l(Vs?, Lis?, Ts).
%% The wildcard of a cleared atom is no variable of a schema (GSC 327e035, Definition "Speech-act schema"); the clause covers the type.
var_types_l([any|Vs], Lis, Ts?) :- var_types_l(Vs?, Lis?, Ts).
var_types_l([num(_)|Vs], Lis, ['Integer'|Ts?]) :- var_types_l(Vs?, Lis?, Ts).
procedure role_type(YesNo?, String).
role_type(yes, 'List(Peer)').
role_type(no, 'Peer').
%% A class's arguments less the places of its listed roles: the arguments of its request name (vGLP f5f1644, Section 5.4, "Act schemas as local specifications": "its request name is the schema-binding"; "The compilation": the request type has "the alternative propose(N) for the request name N of each guarded part"; vGLP #15 Cowork to Code, 2026-10-19 14:24 UTC, item 2: "the binding, its head with no extent, so no List").
procedure drop_listed(Args?, Ints?, Args).
drop_listed([], _, []).
drop_listed([role(J)|Vs], Lis, R?) :- integer(J?), ground(Lis?) |
    mem(J?, Lis?, In),
    drop_listed(Vs?, Lis?, R1),
    keep_arg(In?, role(J?), R1?, R).
drop_listed([V|Vs], Lis, [V?|R?]) :- otherwise | drop_listed(Vs?, Lis?, R).
procedure keep_arg(YesNo?, Arg?, Args?, Args).
keep_arg(yes, _, R, R?).
keep_arg(no, A, R, [A?|R?]).
procedure var_types(Args?, Strings).
var_types([], []).
var_types([role(_)|Vs], ['Peer'|Ts?]) :- var_types(Vs?, Ts).
var_types([pvar(_)|Vs], ['Peer'|Ts?]) :- var_types(Vs?, Ts).
var_types([svar(_)|Vs], ['Speech'|Ts?]) :- var_types(Vs?, Ts).
var_types([nterm(_)|Vs], ['Peer'|Ts?]) :- var_types(Vs?, Ts).
%% A signed term is no variable of a schema (schema_vars); the clause covers
%% the type.
var_types([sgn(_, _)|Vs], Ts?) :- var_types(Vs?, Ts).
%% The wildcard is no variable of a schema; the clause covers the type.
var_types([any|Vs], Ts?) :- var_types(Vs?, Ts).
%% A numeric variable the schema-binding binds, a number in the class term and in the request, so the request form takes it, a number field (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "a request names it, so the request form takes it").
var_types([num(_)|Vs], ['Integer'|Ts?]) :- var_types(Vs?, Ts).

%% Whether the contract requires the day: a schema requires the atom today(d) at a role (vGLP, Section 5.4, "Act schemas as local specifications": "A contract may require the day: the compiled agent reads, with its triggers, a calendar, a stream of dates the device writes, one a day, and holds today(d), d the last date read, beside its app state, which no schema adds or deletes and which a schema may require at a role").
procedure day_required(Contract?, YesNo).
day_required(C, D?) :- ground(C?) |
    contract_preds(C?, Pr),
    mem(today, Pr?, D).
%% The request type: Proposal ::= the alternatives of the schemas whose terms name guarded parts (local.glp, proposable), separated by ;, and Request ::= propose(Proposal) ; refresh, "of a type with the alternative propose(N) for the request name N of each guarded part and the alternative refresh" (vGLP e22e2ad, Section 5.4, "The compilation"); where there are none, Request ::= refresh, and the shared text's lines guarded_only(L), its clauses on the request propose([t]_j) and on a hello, are not printed.
procedure proposal_alts(Contract?, Preds?, Strings).
proposal_alts([], _, []).
proposal_alts([schema(S, Hd, Rs)|Ss], Ps, As?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?) |
    mem(S?, Ps?, In),
    schema_vars(Rs?, Hd?, Vs0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs0?, Lis?, Vs),
    var_types(Vs?, Ts),
    named_call(S?, Ts?, A),
    proposal_alts(Ss?, Ps?, As1),
    keep_alt(In?, A?, As1?, As).
proposal_alts([cschema(_, _, _, _)|Ss], Ps, As?) :- proposal_alts(Ss?, Ps?, As).
proposal_alts([nschema(_, _, _, _)|Ss], Ps, As?) :- proposal_alts(Ss?, Ps?, As).
procedure keep_alt(YesNo?, String?, Strings?, Strings).
keep_alt(yes, A, As, [A?|As?]).
keep_alt(no, _, As, As?).
procedure request_lines(Lines?, Lines).
request_lines([], ['', 'Request ::= refresh.']).
request_lines([A|As], ['', 'Proposal ::=', A?|L?]) :-
    alts_rest(As?, ['', 'Request ::= propose(Proposal) ; refresh.'], L).
procedure alts_rest(Lines?, Lines?, Lines).
alts_rest([], Tl, ['.'|Tl?]).
alts_rest([A|As], Tl, [';', A?|L?]) :- alts_rest(As?, Tl?, L).
procedure any_name(Preds?, YesNo).
any_name([], no).
any_name([_|_], yes).
%% The shared text's lines, a line guarded_only(L) printed as L where the contract has a guarded part and left out where it has none, and a line unguarded_only(L) the other way about; a line day_only(L) printed as L where the contract requires the day and left out where it does not, and a line dayless_only(L) the other way about.  The compiler prints a platform only from a contract with pragmas (vGLP, Section 5.4, "The contract's words"), so the shared text is that of such a platform, and no line of it is kept or left out by its pragmas.
procedure shared_lines(Lines?, YesNo?, YesNo?, Lines).
shared_lines([], _, _, []).
shared_lines([guarded_only(L)|Ls], yes, D, Ls1?) :- shared_lines([L?|Ls?], yes, D?, Ls1).
shared_lines([guarded_only(_)|Ls], no, D, Ls1?) :- shared_lines(Ls?, no, D?, Ls1).
shared_lines([unguarded_only(_)|Ls], yes, D, Ls1?) :- shared_lines(Ls?, yes, D?, Ls1).
shared_lines([unguarded_only(L)|Ls], no, D, Ls1?) :- shared_lines([L?|Ls?], no, D?, Ls1).
shared_lines([day_only(L)|Ls], G, yes, Ls1?) :- shared_lines([L?|Ls?], G?, yes, Ls1).
shared_lines([day_only(_)|Ls], G, no, Ls1?) :- shared_lines(Ls?, G?, no, Ls1).
shared_lines([dayless_only(_)|Ls], G, yes, Ls1?) :- shared_lines(Ls?, G?, yes, Ls1).
shared_lines([dayless_only(L)|Ls], G, no, Ls1?) :- shared_lines([L?|Ls?], G?, no, Ls1).
shared_lines([L|Ls], G, D, [L?|Ls1?]) :- otherwise | shared_lines(Ls?, G?, D?, Ls1).

%% The type of the machine states, List(Atom), in the type of the views, Output ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)) in the shared text (vGLP 12f629d, Section 5.4, "The compilation": "the compilation defines Output as the type of the views", a view carrying "its own key k, the machine state s of its app state, the persons K it knows and the approvals A its person made that are pending"): a machine state is a multiset of the contract's atoms, written as a list, and Atom is the union of the contract's predicates at their argument types: an argument is of the type Peer, a person, where the schemas write a role, a party variable or a name term, and of the type Speech, a speech act, where they write a speech-act variable or a signed term; Atom has one alternative for each predicate and argument types the schemas write it with, in order of first occurrence.  The agent holds an atom as g(Name, Vals), each value p(Peer) or s(Speech), and writes it on the output as the contract writes it: atom_of(g(friend, [p(V1)]), shown(friend(V1?))), one clause per alternative.
Kind  ::= peer ; speech ; name ; num.
Kinds ::= [] ; [Kind | Kinds].
Sig   ::= sig(Constant, Kinds).
Sigs  ::= [] ; [Sig | Sigs].
procedure atom_parts(Contract?, Lines).
atom_parts(C, ['', '%% The atoms of the contract at their argument types: a machine state is a list of them, in the view the agent writes, Output ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)), and the agent writes each atom it holds, g(Name, Vals), as atom_of gives it (vGLP, Section 5.4, "The compilation"); the day, today(d), is no atom of the machine state the view shows (Section 5.4, "Act schemas as local specifications").', 'Atom ::='|L?]) :- ground(C?) |
    contract_atoms(C?, As),
    atom_sigs(As?, Gs0),
    dedup(Gs0?, Gs1),
    drop_today(Gs1?, Gs),
    atom_parts1(Gs?, L).
procedure drop_today(Sigs?, Sigs).
drop_today([], []).
drop_today([sig(today, _)|Gs], Gs1?) :- drop_today(Gs?, Gs1).
drop_today([G|Gs], [G?|Gs1?]) :- otherwise | drop_today(Gs?, Gs1).
procedure atom_parts1(Sigs?, Lines).
atom_parts1(Gs, L?) :- ground(Gs?) |
    atom_alts(Gs?, La),
    atom_of_lines(Gs?, Lo),
    lapp(La?, ['', 'procedure atom_of(GAtom?, Shown).'|Lo?], L).
procedure contract_atoms(Contract?, Atoms).
contract_atoms([], []).
contract_atoms([schema(_, _, Rs)|Ss], As?) :- rs_atoms(Rs?, A1), contract_atoms(Ss?, A2), app(A1?, A2?, As).
contract_atoms([cschema(_, _, _, Rs)|Ss], As?) :- rs_atoms(Rs?, A1), contract_atoms(Ss?, A2), app(A1?, A2?, As).
contract_atoms([nschema(_, _, _, Rs)|Ss], As?) :- rs_atoms(Rs?, A1), contract_atoms(Ss?, A2), app(A1?, A2?, As).
%% A cleared atom, which carries the wildcard, is no atom of a state: it stands for the atoms of the state it matches (vGLP f8127b1, Section 5.4, "Act schemas as local specifications"), which other atoms of the contract write, so the type Atom takes the role's deleted atoms less its cleared ones (uncleared).
procedure rs_atoms(RoleSpecs?, Atoms).
rs_atoms([], []).
rs_atoms([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M0, K, N),
    uncleared(M0?, M),
    rs_atoms(Rs?, A5),
    app(N?, A5?, A4),
    app(K?, A4?, A3),
    app(M?, A3?, A2),
    app(P?, A2?, As).
procedure atom_sigs(Atoms?, Sigs).
atom_sigs([], []).
atom_sigs([atom(F, Xs)|As], [sig(F?, Ks?)|Gs?]) :- arg_kinds(Xs?, Ks), atom_sigs(As?, Gs).
atom_sigs([times(_, A)|As], Gs?) :- atom_sigs([A?|As?], Gs).
atom_sigs([rest(_, _, A)|As], Gs?) :- atom_sigs([A?|As?], Gs).
procedure arg_kinds(Args?, Kinds).
arg_kinds([], []).
arg_kinds([role(_)|Xs], [peer|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([pvar(_)|Xs], [peer|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([nterm(_)|Xs], [name|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([svar(_)|Xs], [speech|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([sgn(_, _)|Xs], [speech|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([num(_)|Xs], [num|Ks?]) :- arg_kinds(Xs?, Ks).
%% The wildcard is in no atom of a state, a cleared atom being none (rs_atoms); the clause covers the type and is never reached.
arg_kinds([any|Xs], Ks?) :- arg_kinds(Xs?, Ks).
%% Atom ::= the alternatives, separated by ;, each the predicate applied to its argument types, a predicate of no argument a constant.
procedure atom_alts(Sigs?, Lines).
atom_alts([], ['.']).
atom_alts([G|Gs], [A?|L?]) :- ground(G?) |
    sig_alt(G?, A),
    atom_alts1(Gs?, L).
procedure atom_alts1(Sigs?, Lines).
atom_alts1([], ['.']).
atom_alts1([G|Gs], [';'|L?]) :- atom_alts([G?|Gs?], L).
procedure sig_alt(Sig?, String).
sig_alt(sig(F, []), A?) :- term_to_string(F?, A).
sig_alt(sig(F, [K|Ks]), A?) :- ground(F?), ground(K?), ground(Ks?) |
    kind_types([K?|Ks?], Ts),
    named_call(F?, Ts?, A).
procedure kind_types(Kinds?, Strings).
kind_types([], []).
kind_types([peer|Ks], ['Peer'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([speech|Ks], ['Speech'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([name|Ks], ['CName'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([num|Ks], ['Integer'|Ts?]) :- kind_types(Ks?, Ts).
%% atom_of(g(f, [p(V1), s(V2)]), shown(f(V1?, V2?))), one clause per alternative of Atom, and a last clause on any other atom, which covers the type GAtom and is never reached: the agent holds only atoms the contract's schemas add.
procedure atom_of_lines(Sigs?, Lines).
atom_of_lines([], ['atom_of(_, unshown) :- otherwise | true.']).
atom_of_lines([sig(F, [])|Gs], [T?, '.'|L?]) :- ground(F?) |
    T0 =.. [atom_of, g(F?, []), shown(F?)],
    term_to_string(T0?, T),
    atom_of_lines(Gs?, L).
atom_of_lines([sig(F, [K|Ks])|Gs], [T?, '.'|L?]) :- ground(F?), ground(K?), ground(Ks?) |
    kind_vals([K?|Ks?], 1, Ws, Qs),
    named_call(F?, Qs?, Out),
    term_to_string(F?, Ft),
    list_text(Ws?, Wl),
    call_text(g, [Ft?, Wl?], G),
    call_text(shown, [Out?], Sh),
    call_text(atom_of, [G?, Sh?], T),
    atom_of_lines(Gs?, L).
procedure kind_vals(Kinds?, Integer?, Strings, Strings).
kind_vals([], _, [], []).
kind_vals([K|Ks], I, [W?|Ws?], [Q?|Qs?]) :- ground(K?), integer(I?) |
    vname(I?, F),
    name_of(F?, N, Q),
    kind_val(K?, N?, W),
    I1 := I? + 1,
    kind_vals(Ks?, I1?, Ws, Qs).
procedure kind_val(Kind?, String?, String).
kind_val(peer, N, W?) :- call_text(p, [N?], W).
kind_val(name, N, W?) :- call_text(c, [N?], W).
kind_val(speech, N, W?) :- call_text(s, [N?], W).
kind_val(num, N, W?) :- call_text(n, [N?], W).

%% binding_of(s(V1, ..., Vn), s, [b(Var1, p(V1?)), ...]), and, for each variable local to a role, agent, speech-act or numeric, b(pvar(X), lv(s, X)), b(svar(X), lv(s, X)) or b(num(X), lv(s, X)): the schema-binding does not bind it, and its value in the binding stands for the variable, which the state of the person in its role binds (vGLP 8a3ae79, Section 5.4, "Speech-act schemas as local specifications": "A schema-binding does not bind a local variable: the machine of the person in that role finds a value for it in its own state"; the shared text, dom_bindings).
procedure binding_lines(Contract?, NumInfos?, Lines).
binding_lines([], _, []).
binding_lines([schema(S, Hd, Rs)|Ss], Nt, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Nt?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    num_lookup(S?, Nt?, Ni),
    local_binds(Ni?, S?, Lb),
    binding_line_l(Lis?, S?, Vs?, Lb?, L1),
    binding_lines(Ss?, Nt?, L2),
    lapp(L1?, L2?, L).
binding_lines([cschema(_, _, _, _)|Ss], Nt, L?) :- binding_lines(Ss?, Nt?, L).
binding_lines([nschema(_, _, _, _)|Ss], Nt, L?) :- binding_lines(Ss?, Nt?, L).
procedure local_binds(NumInfo?, Constant?, Strings).
local_binds(num_info(_, _, Ls, _, _), S, Lb?) :- ground(S?) | loc_vars(Ls?, Vs), local_binds1(Vs?, S?, Lb).
procedure local_binds1(Args?, Constant?, Strings).
local_binds1([], _, []).
local_binds1([num(X)|Vs], S, [T?|Lb?]) :- ground(X?), ground(S?) | term_to_string(b(num(X?), lv(S?, X?)), T), local_binds1(Vs?, S?, Lb).
local_binds1([pvar(X)|Vs], S, [T?|Lb?]) :- ground(X?), ground(S?) | term_to_string(b(pvar(X?), lv(S?, X?)), T), local_binds1(Vs?, S?, Lb).
local_binds1([svar(X)|Vs], S, [T?|Lb?]) :- ground(X?), ground(S?) | term_to_string(b(svar(X?), lv(S?, X?)), T), local_binds1(Vs?, S?, Lb).
local_binds1([_|Vs], S, Lb?) :- otherwise | local_binds1(Vs?, S?, Lb).
%% binding_of(c(V1, ..., Vn), c, B): the binding a class term names; for a schema with listed roles at i_1, ..., i_m, the binding of its other roles and its variables, and the list [Vi_1, ..., Vi_m] of the people of each listed role, in the order of the roles, which the shared text sends onto the roles of the schema it carries for them (listed_binding).
procedure binding_line_l(Ints?, Constant?, Args?, Strings?, Lines).
binding_line_l([], S, Vs, Lb, [T?, '.']) :- binding_line(S?, Vs?, Lb?, T).
binding_line_l([I|Is], S, Vs, Lb, [T?, ':-', G?, '.']) :- integer(I?), ground(Is?), ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, _),
    bind_terms_skip(Vs?, 1, [I?|Is?], Bs0),
    sapp(Bs0?, Lb?, Bs),
    list_names([I?|Is?], Lqs),
    named_call(S?, Ns?, Hd),
    term_to_string(S?, S1),
    term_to_string(S?, S2),
    list_text(Bs?, Bl),
    list_text(Lqs?, Ql),
    call_text(binding_of, [Hd?, S1?, 'B?'], T),
    call_text(listed_binding, [S2?, Bl?, Ql?, 'B'], G).
%% The names, V_i?, of the places i of the listed roles, as a list.
procedure list_names(Ints?, Strings).
list_names([], []).
list_names([I|Is], [Q?|Qs?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, _, Q),
    list_names(Is?, Qs).
procedure bind_terms_skip(Args?, Integer?, Ints?, Strings).
bind_terms_skip([], _, _, []).
bind_terms_skip([V|Vs], I, Lis, Bs?) :- ground(V?), integer(I?), ground(Lis?) |
    I1 := I? + 1,
    bind_terms_skip(Vs?, I1?, Lis?, Bs1),
    mem(I?, Lis?, In),
    keep_bind(In?, I?, V?, Bs1?, Bs).
procedure keep_bind(YesNo?, Integer?, Arg?, Strings?, Strings).
keep_bind(yes, _, _, Bs, Bs?).
keep_bind(no, I, V, Bs, [X?|Bs?]) :- ground(V?), integer(I?) |
    vname(I?, F),
    wrapped(V?, F?, W),
    term_to_string(V?, Vt),
    call_text(b, [Vt?, W?], X).
procedure binding_line(Constant?, Args?, Strings?, String).
binding_line(S, Vs, Lb, T?) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, _),
    bind_terms(Vs?, 1, Bs0),
    sapp(Bs0?, Lb?, Bs),
    named_call(S?, Ns?, Hd),
    term_to_string(S?, S1),
    list_text(Bs?, Bl),
    call_text(binding_of, [Hd?, S1?, Bl?], T).
procedure bind_terms(Args?, Integer?, Strings).
bind_terms([], _, []).
bind_terms([V|Vs], I, [X?|Bs?]) :- ground(V?), integer(I?) |
    vname(I?, F),
    wrapped(V?, F?, W),
    term_to_string(V?, Vt),
    call_text(b, [Vt?, W?], X),
    I1 := I? + 1,
    bind_terms(Vs?, I1?, Bs).
procedure wrapped(Arg?, Found?, String).
wrapped(role(_), named(_, Q), W?) :- call_text(p, [Q?], W).
wrapped(pvar(_), named(_, Q), W?) :- call_text(p, [Q?], W).
wrapped(svar(_), named(_, Q), W?) :- call_text(s, [Q?], W).
wrapped(nterm(_), named(_, Q), W?) :- call_text(p, [Q?], W).
wrapped(num(_), named(_, Q), W?) :- call_text(n, [Q?], W).
wrapped(_, unnamed, 'p(unnamed)').
procedure var_names(Args?, Integer?, Strings, Strings).
var_names([], _, [], []).
var_names([_|Vs], I, [N?|Ns?], [Q?|Qs?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, N, Q),
    I1 := I? + 1,
    var_names(Vs?, I1?, Ns, Qs).
procedure name_of(Found?, String, String).
name_of(named(N, Q), N?, Q?).
name_of(unnamed, unnamed, unnamed).

%% class_of(s, B, D, s(V1?, ..., Vn?)) :- ground(B?), ground(D?) |
%%     val_peer(Var1, B?, D?, V1), ... .
procedure class_of_lines(Contract?, Lines).
class_of_lines([], []).
class_of_lines([schema(S, Hd, Rs)|Ss], [T?, ':-', 'ground(B?)', ',', 'ground(D?)', '|'|L?]) :-
    ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    class_of_line(S?, Vs?, Lis?, T, L1),
    class_of_lines(Ss?, L2),
    lapp(L1?, L2?, L).
class_of_lines([cschema(_, _, _, _)|Ss], L?) :- class_of_lines(Ss?, L).
class_of_lines([nschema(_, _, _, _)|Ss], L?) :- class_of_lines(Ss?, L).
procedure class_of_line(Constant?, Args?, Ints?, String, Lines).
class_of_line(S, Vs, Lis, T?, L1?) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, _, Qs),
    named_call(S?, Qs?, Out),
    term_to_string(S?, S1),
    call_text(class_of, [S1?, 'B', 'D', Out?], T),
    val_goals(Vs?, 1, S?, Lis?, L1).
%% The value of each argument of the class term; at the place i of a listed role, the people of the roles the shared text carries for it, in the order of identifiers (copies_of(B, i, Vi)).
procedure val_goals(Args?, Integer?, Constant?, Ints?, Lines).
val_goals([], _, _, _, []).
val_goals([V|Vs], I, S, Lis, [G?|L?]) :- ground(V?), integer(I?), ground(S?), ground(Lis?) |
    vname(I?, F),
    name_of(F?, N, _),
    mem(I?, Lis?, In),
    val_goal_l(In?, I?, V?, N?, G),
    I1 := I? + 1,
    val_goals1(Vs?, I1?, S?, Lis?, L).
procedure val_goals1(Args?, Integer?, Constant?, Ints?, Lines).
val_goals1([], _, _, _, ['.']).
val_goals1([V|Vs], I, S, Lis, [','|L?]) :- val_goals([V?|Vs?], I?, S?, Lis?, L).
procedure val_goal_l(YesNo?, Integer?, Arg?, String?, String).
val_goal_l(yes, I, _, N, G?) :- integer(I?), ground(N?) | term_to_string(I?, It), call_text(copies_of, ['B?', It?, N?], G).
val_goal_l(no, _, V, N, G?) :- val_goal(V?, N?, G).
procedure val_goal(Arg?, String?, String).
val_goal(svar(X), N, G?) :- ground(X?), ground(N?) | term_to_string(svar(X?), Vt), call_text(val_speech, [Vt?, 'B?', 'D?', N?], G).
val_goal(role(I), N, G?) :- ground(N?) | term_to_string(role(I?), Vt), call_text(val_peer, [Vt?, 'B?', 'D?', N?], G).
val_goal(pvar(X), N, G?) :- ground(X?), ground(N?) | term_to_string(pvar(X?), Vt), call_text(val_peer, [Vt?, 'B?', 'D?', N?], G).
val_goal(nterm(_), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
val_goal(num(X), N, G?) :- ground(X?), ground(N?) | term_to_string(num(X?), Vt), call_text(val_num, [Vt?, 'B?', N?], G).
%% A signed term is no variable of a schema (schema_vars); the clause covers
%% the type.
val_goal(sgn(_, _), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
%% The wildcard is no variable of a schema; the clause covers the type.
val_goal(any, N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).

procedure vname(Integer?, Found).
vname(1, named('V1', 'V1?')).
vname(2, named('V2', 'V2?')).
vname(3, named('V3', 'V3?')).
vname(4, named('V4', 'V4?')).
vname(5, named('V5', 'V5?')).
vname(6, named('V6', 'V6?')).
vname(7, named('V7', 'V7?')).
vname(8, named('V8', 'V8?')).
vname(9, named('V9', 'V9?')).
vname(10, named('V10', 'V10?')).
vname(11, named('V11', 'V11?')).
vname(12, named('V12', 'V12?')).
vname(13, named('V13', 'V13?')).
vname(14, named('V14', 'V14?')).
vname(15, named('V15', 'V15?')).
vname(16, named('V16', 'V16?')).
vname(17, named('V17', 'V17?')).
vname(18, named('V18', 'V18?')).
vname(19, named('V19', 'V19?')).
vname(20, named('V20', 'V20?')).
vname(21, named('V21', 'V21?')).
vname(22, named('V22', 'V22?')).
vname(23, named('V23', 'V23?')).
vname(24, named('V24', 'V24?')).
vname(25, named('V25', 'V25?')).
vname(26, named('V26', 'V26?')).
vname(27, named('V27', 'V27?')).
vname(28, named('V28', 'V28?')).
vname(29, named('V29', 'V29?')).
vname(30, named('V30', 'V30?')).
vname(N, unnamed) :- otherwise, integer(N?) | true.

%% The contract as the shared text reads it: a schema with listed roles, lschema(Name, Vars, Roles, Listings), each listed role written as a party role of its atoms and listing(I, Base, Rho, Args) in Listings, in the order of the roles: its index I, its base the agent role of index Base and its people the persons q with rho(q, Args) in the state of the person in the base (vGLP c649c0d, Section 5.4, "Act schemas as local specifications").
procedure text_schemas(Contract?, Stream(_)).
text_schemas([], []).
text_schemas([schema(S, Hd, Rs)|Ss], [X?|Xs?]) :- ground(S?), ground(Hd?), ground(Rs?) |
    listed_ixs(Rs?, 1, Lis),
    text_schema(Lis?, S?, Hd?, Rs?, X),
    text_schemas(Ss?, Xs).
text_schemas([cschema(_, _, _, _)|Ss], Xs?) :- text_schemas(Ss?, Xs).
text_schemas([nschema(_, _, _, _)|Ss], Xs?) :- text_schemas(Ss?, Xs).
procedure text_schema(Ints?, Constant?, Args?, RoleSpecs?, _).
text_schema([], S, Hd, Rs, schema(S?, Hd?, Rs?)).
text_schema([_|_], S, Hd, Rs, lschema(S?, Hd?, Rs1?, Ls?)) :- ground(Rs?) |
    plain_specs(Rs?, Rs1),
    listed_all(Rs?, 1, Ls).
%% The contract, contract_schemas([S_1, ..., S_n]), and each schema under its name, schema_entry(Name, S_i), the schema of a name being found by its clause and not by building the whole contract at every look-up (Code #12's change 1 of 2026-10-20 11:55 UTC, approved by vGLP #18 Cowork as implementation, Code_inbox.md 12:03 UTC); a name of no schema has the schema of no roles, schema(Name, [], []).
procedure schema_lines(Stream(_)?, String, Lines).
schema_lines(Ct, T1?, ['', 'procedure schema_entry(Constant?, Schema).'|Le?]) :- ground(Ct?) |
    T0 =.. [contract_schemas, Ct?],
    term_to_string(T0?, T1),
    entry_lines(Ct?, Le).
procedure entry_lines(Stream(_)?, Lines).
entry_lines([], ['schema_entry(Nm, schema(Nm?, [], [])) :- otherwise | true.']).
entry_lines([X|Xs], [E?, '.'|L?]) :- ground(X?) |
    schema_name(X?, Nm),
    E0 =.. [schema_entry, Nm?, X?],
    term_to_string(E0?, E),
    entry_lines(Xs?, L).
%% The schemas' numbers, schema_numeric(Name, numeric(Constraint, Locals, Role)), printed for each schema with a constraint or a local variable: its constraint, its variables local to a role and the role whose local variables the constraint names, at(I), or every, where it names none and every role checks it (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "a constraint is local to the role whose local variables it names, and to every role where it names none, which each checks"); any other schema has none, numeric(true, [], every).
procedure numeric_lines(NumInfos?, Lines).
numeric_lines(Nt, ['', 'procedure schema_numeric(Constant?, Numeric).'|L?]) :- ground(Nt?) |
    numeric_lines1(Nt?, L1),
    form_lines(Nt?, L2),
    lapp(L1?, ['', 'procedure schema_forms(Constant?, SForms).'|L2?], L).
procedure numeric_lines1(NumInfos?, Lines).
numeric_lines1([], ['schema_numeric(_, numeric(true, [], every)) :- otherwise | true.']).
numeric_lines1([num_info(S, C, Ls, R, _)|Ns], L?) :- ground(S?), ground(C?), ground(Ls?), ground(R?) |
    loc_vars(Ls?, Vs1),
    loc_vars(Ls?, Vs2),
    plain_num(C?, Vs1?, R?, P),
    numeric_line(P?, S?, C?, Vs2?, R?, L1),
    numeric_lines1(Ns?, L2),
    lapp(L1?, L2?, L).
%% The safe formulas of the schemas' bodies, schema_forms(Name, Forms), printed for each schema with one, each sform(R, F), F the formula as programs/gsc writes it and R the role it is local to, at(I), or every, which every role checks (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications": "A safe formula of B ... is local to a role where every atom of it ... is held by that role ...: the machine of the person in that role evaluates it in its own state"; local.glp, form_infos, which refuses one local to no role).
procedure form_lines(NumInfos?, Lines).
form_lines([], ['schema_forms(_, []) :- otherwise | true.']).
form_lines([num_info(S, _, _, _, Fi)|Ns], L?) :- ground(S?), ground(Fi?) |
    form_line(Fi?, S?, L1),
    form_lines(Ns?, L2),
    lapp(L1?, L2?, L).
procedure form_line(FInfos?, Constant?, Lines).
form_line([], _, []).
form_line([F|Fs], S, [T?, '.']) :- ground(S?), ground(F?), ground(Fs?) |
    sforms([F?|Fs?], Sf),
    T0 =.. [schema_forms, S?, Sf?],
    term_to_string(T0?, T).
SForm  ::= sform(FRole, Form).
SForms ::= [] ; [SForm | SForms].
procedure sforms(FInfos?, SForms).
sforms([], []).
sforms([fi(R, F)|Fs], [sform(R?, F?)|Ss?]) :- sforms(Fs?, Ss).
procedure plain_num(Constraint?, Args?, CRole?, YesNo).
plain_num(true, [], every, yes).
plain_num(_, _, _, no) :- otherwise | true.
procedure numeric_line(YesNo?, Constant?, Constraint?, Args?, CRole?, Lines).
numeric_line(yes, _, _, _, _, []).
numeric_line(no, S, C, Vs, R, [T?, '.']) :- ground(S?), ground(C?), ground(Vs?), ground(R?) |
    T0 =.. [schema_numeric, S?, numeric(C?, Vs?, R?)],
    term_to_string(T0?, T).
procedure schema_name(_?, Constant).
schema_name(schema(Nm, _, _), Nm?).
schema_name(lschema(Nm, _, _, _), Nm?).
procedure plain_specs(RoleSpecs?, RoleSpecs).
plain_specs([], []).
plain_specs([rs(G, A, D, K, F)|Rs], [rs(G?, A?, D?, K?, F?)|Ps?]) :- plain_specs(Rs?, Ps).
plain_specs([crs(_, G, A, D, K, F)|Rs], [rs(G?, A?, D?, K?, F?)|Ps?]) :- plain_specs(Rs?, Ps).

%% name_class(N, S, C): the class term of the part a request name N names at an agent of the machine state S (vGLP f5f1644, Section 5.4, "Triggers": on propose(N) the agent "proposes, among the guarded parts it guards and is ready for of the classes of the parts named N, the one it has proposed least recently"): N itself for a schema with no listed role, and for one with listed roles N with the people the state lists at the place of each, which the shared text finds (listed_class), so the base agent completes each list from its listed atoms (vGLP #15 Cowork to Code, 2026-10-19 14:24 UTC, item 2; vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC: "the base agent filling in each from its own listed atoms").  Printed for the schemas the request type proposes, and only where it has one.
procedure name_class_lines(Contract?, Preds?, Lines).
name_class_lines([], _, []).
name_class_lines([schema(S, Hd, Rs)|Ss], Ps, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?) |
    mem(S?, Ps?, In),
    name_class_lines1(In?, S?, Hd?, Rs?, L1),
    name_class_lines(Ss?, Ps?, L2),
    lapp(L1?, L2?, L).
name_class_lines([cschema(_, _, _, _)|Ss], Ps, L?) :- name_class_lines(Ss?, Ps?, L).
name_class_lines([nschema(_, _, _, _)|Ss], Ps, L?) :- name_class_lines(Ss?, Ps?, L).
procedure name_class_lines1(YesNo?, Constant?, Args?, RoleSpecs?, Lines).
name_class_lines1(no, _, _, _, []).
name_class_lines1(yes, S, Hd, Rs, L?) :- ground(S?), ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    name_class_line(Lis?, S?, Vs?, L).
procedure name_class_line(Ints?, Constant?, Args?, Lines).
name_class_line([], S, Vs, [T?, '.']) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, Qs),
    named_call(S?, Ns?, In),
    named_call(S?, Qs?, Out),
    call_text(name_class, [In?, '_', Out?], T).
name_class_line([I|Is], S, Vs, [T?, ':-', G?, '.']) :- integer(I?), ground(Is?), ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns0, _),
    drop_at(Ns0?, 1, [I?|Is?], Ns),
    bind_terms_skip(Vs?, 1, [I?|Is?], Bs),
    named_call(S?, Ns?, In),
    term_to_string(S?, S1),
    list_text(Bs?, Bl),
    call_text(name_class, [In?, 'St', 'C?'], T),
    call_text(listed_class, [S1?, Bl?, 'St?', 'C'], G).
procedure drop_at(Strings?, Integer?, Ints?, Strings).
drop_at([], _, _, []).
drop_at([X|Xs], I, Lis, R?) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    drop_at(Xs?, I1?, Lis?, R1),
    mem(I?, Lis?, In),
    keep_at(In?, X?, R1?, R).
procedure keep_at(YesNo?, String?, Strings?, Strings).
keep_at(yes, _, R, R?).
keep_at(no, X, R, [X?|R?]).
procedure name_class_decl(Lines?, Lines).
name_class_decl([], []).
name_class_decl([X|Xs], ['', 'procedure name_class(Proposal?, GAtoms?, Class).', X?|Xs?]).

%% request_name(C, pname(N)): the request name N of the part the class term C names, its schema-binding, with no list of the people of its listed roles, for the schemas the request type proposes, and nopname for any other class term (vGLP f0acbc1, Section 5.4, "Act schemas as local specifications": "its request name is the schema-binding"); the shared text asks it whether a class is of a request rho_N, a guarded part of the class with an opener being named N (in_rho; Definition "Effective Local Specification": "whether a class is in rho_N being decidable from a part of it and N").  Printed for the schemas the request type proposes, and only where it has one.
procedure request_name_lines(Contract?, Preds?, Lines).
request_name_lines([], _, []).
request_name_lines([schema(S, Hd, Rs)|Ss], Ps, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?) |
    mem(S?, Ps?, In),
    request_name_lines1(In?, S?, Hd?, Rs?, L1),
    request_name_lines(Ss?, Ps?, L2),
    lapp(L1?, L2?, L).
request_name_lines([cschema(_, _, _, _)|Ss], Ps, L?) :- request_name_lines(Ss?, Ps?, L).
request_name_lines([nschema(_, _, _, _)|Ss], Ps, L?) :- request_name_lines(Ss?, Ps?, L).
procedure request_name_lines1(YesNo?, Constant?, Args?, RoleSpecs?, Lines).
request_name_lines1(no, _, _, _, []).
request_name_lines1(yes, S, Hd, Rs, [T?, '.']) :- ground(S?), ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis1),
    listed_ixs(Rs?, 1, Lis2),
    var_names(Vs?, 1, Ns0, Qs0),
    blank_names(Ns0?, 1, Lis1?, Ns),
    drop_at(Qs0?, 1, Lis2?, Qs),
    named_call(S?, Ns?, In),
    named_call(S?, Qs?, Out),
    call_text(pname, [Out?], P),
    call_text(request_name, [In?, P?], T).
%% The names, the place of each listed role written _, which the clause does not read.
procedure blank_names(Strings?, Integer?, Ints?, Strings).
blank_names([], _, _, []).
blank_names([X|Xs], I, Lis, [Y?|R?]) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    mem(I?, Lis?, In),
    blank_one(In?, X?, Y),
    blank_names(Xs?, I1?, Lis?, R).
procedure blank_one(YesNo?, String?, String).
blank_one(yes, _, '_').
blank_one(no, X, X?).
procedure request_name_decl(Lines?, Lines).
request_name_decl([], []).
request_name_decl([X|Xs], ['', 'procedure request_name(Class?, PName).', X?|Xs1?]) :-
    lapp(Xs?, ['request_name(_, nopname) :- otherwise | true.'], Xs1).

%% --- The contract's words ---------------------------------------------------
%% vGLP, Section 5.4, "The contract's words": "Beside its clauses and its schemas a contract carries the words its app shows, its pragmas: for each schema, the label of the request that proposes its act and a name for each field the person fills in, and, for each guarding role, the sentence put to that role's agent and its two answers; and, for each list the app shows, its name and what it lists.  A sentence names the roles and the variables of its schema, which the platform fills in from the binding of the attempt it asks about.  The compiler carries them into the platform it prints: a request's label and field names and an approval question's two answers into the widget declarations it prints for the platform's request type and approval type (Section 6.2), a sentence into the approval question that Start raises, and a list's name into the view the agent writes."  GSC, Section 2, its first paragraph: "the first line names a tab of the app and what it lists, and each other line names a clause, then the button proposing its act, in brackets, any field the person fills, in angle brackets, and, where the act needs another person's will, the question that person is then asked."  The forms the papers leave open, and the forms chosen here, are in README.md beside this file.

%% A contract whose pragmas name what the contract does not hold is not compiled, with a line saying why: a list naming no predicate of the contract, or more than one; a button naming no schema of the contract, the button's text read in lower case being the schema's name ("each bearing its act's name", GSC 2991379, Section 2); a pragma naming more fields than its schema has variables the person fills; a sentence naming a person, Alice, Bob or Carol, that its schema does not have; and a guarded schema no button names (unnamed_lines).
procedure word_faults(Worded?, Contract?, Preds?, Lines).
word_faults(words(pragmas(Ls, As)), C, Ps, F?) :- ground(Ls?), ground(As?), ground(C?), ground(Ps?) |
    contract_preds(C?, Pr),
    list_faults(Ls?, Pr?, F1),
    act_faults(As?, C?, F2),
    act_names(As?, Ns),
    unnamed_lines(Ps?, Ns?, F3),
    lapp(F1?, F2?, F12),
    lapp(F12?, F3?, F).

%% The predicates of the contract's atoms, each once.
procedure contract_preds(Contract?, Preds).
contract_preds(C, Ps?) :- ground(C?) |
    contract_atoms(C?, As),
    atom_names(As?, Ns),
    dedup(Ns?, Ps).
procedure atom_names(Atoms?, Preds).
atom_names([], []).
atom_names([atom(F, _)|As], [F?|Ns?]) :- atom_names(As?, Ns).
atom_names([times(_, A)|As], Ns?) :- atom_names([A?|As?], Ns).
atom_names([rest(_, _, A)|As], Ns?) :- atom_names([A?|As?], Ns).

%% What a list lists: the one predicate of the contract among the words of its pragma, "the persons Alice knows" the predicate knows, "the friends of Alice" friend, "the groups Alice is a member of" member.
procedure list_faults(PLists?, Preds?, Lines).
list_faults([], _, []).
list_faults([list(N, Ws)|Ls], Pr, F?) :- ground(N?), ground(Ws?), ground(Pr?) |
    listed_preds(Ws?, Pr?, Ms),
    list_fault(Ms?, N?, F1),
    list_faults(Ls?, Pr?, F2),
    lapp(F1?, F2?, F).
procedure listed_preds(Strings?, Preds?, Preds).
listed_preds(Ws, Pr, Ms?) :- ground(Ws?), ground(Pr?) |
    listed_preds1(Ws?, Pr?, Ms0),
    dedup(Ms0?, Ms).
procedure listed_preds1(Strings?, Preds?, Preds).
listed_preds1([], _, []).
listed_preds1([W|Ws], Pr, Ms?) :- ground(W?), ground(Pr?) |
    mem(W?, Pr?, In),
    listed_preds1(Ws?, Pr?, Ms1),
    keep_pred(In?, W?, Ms1?, Ms).
procedure keep_pred(YesNo?, Constant?, Preds?, Preds).
keep_pred(yes, P, Ps, [P?|Ps?]).
keep_pred(no, _, Ps, Ps?).
procedure list_fault(Preds?, String?, Lines).
list_fault([_], _, []).
list_fault([], N, [H?]) :- ground(N?) | string_concat(['%% the list of its pragmas names no predicate of the contract:(', N?, ')'], H).
list_fault([_, _|_], N, [H?]) :- ground(N?) | string_concat(['%% the list of its pragmas names more than one predicate of the contract:(', N?, ')'], H).

%% A schema of the contract, its head and its roles.
SFound ::= sfound(Args, RoleSpecs) ; nosfound.
procedure find_schema(Constant?, Contract?, SFound).
find_schema(_, [], nosfound).
find_schema(S, [schema(T, Hd, Rs)|_], sfound(Hd?, Rs?)) :- S? =?= T? | true.
find_schema(S, [_|Cs], F?) :- otherwise | find_schema(S?, Cs?, F).

%% Each act a pragma proposes, act(Name, Button, Fields, Sentence), is the schema Name its button names.
procedure act_faults(PActs?, Contract?, Lines).
act_faults([], _, []).
act_faults([act(N, _, Fs, Q, _, _)|As], C, F?) :- ground(N?), ground(Fs?), ground(Q?), ground(C?) |
    schema_faults([N?], Fs?, Q?, C?, F1),
    act_faults(As?, C?, F2),
    lapp(F1?, F2?, F).
procedure schema_faults(Preds?, Strings?, Said?, Contract?, Lines).
schema_faults([], _, _, _, []).
schema_faults([S|Ss], Fs, Q, C, F?) :- ground(S?), ground(Fs?), ground(Q?), ground(C?) |
    find_schema(S?, C?, Sf),
    schema_fault(Sf?, S?, Fs?, Q?, F1),
    schema_faults(Ss?, Fs?, Q?, C?, F2),
    lapp(F1?, F2?, F).
procedure schema_fault(SFound?, Constant?, Strings?, Said?, Lines).
schema_fault(nosfound, S, _, _, [H?]) :- ground(S?) |
    said('%% a pragma\'s button names no schema of the contract:', S?, H).
schema_fault(sfound(Hd, Rs), S, Fs, Q, F?) :- ground(Hd?), ground(Rs?), ground(S?), ground(Fs?), ground(Q?) |
    field_places(Hd?, Rs?, Fp),
    person_places(Hd?, Rs?, Pp),
    count_ints(Fp?, NF),
    count_strings(Fs?, NS),
    field_fault(NS?, NF?, S?, F1),
    said_fault(Q?, Pp?, S?, F2),
    question_fault(Q?, Rs?, S?, F3),
    lapp(F1?, F2?, F12),
    lapp(F12?, F3?, F).
procedure field_fault(Integer?, Integer?, Constant?, Lines).
field_fault(NS, NF, _, []) :- NS? =< NF? | true.
field_fault(NS, NF, S, [H?]) :- NS? > NF?, ground(S?) |
    said('%% a pragma names more fields than the schema has variables the person fills:', S?, H).
%% A line whose questions are neither one nor one per guarding role of its act, an act of two guarding roles or more (vGLP 21fca00, Section 5.4, "The contract's words": "a line's questions are one per guarding role of the widest schema of its clause, in the order of the roles, none left out").
procedure question_fault(Said?, RoleSpecs?, Constant?, Lines).
question_fault(none, _, _, []).
question_fault(said(Qs), Rs, S, F?) :- ground(Qs?), ground(Rs?), ground(S?) |
    count_questions(Qs?, NQ),
    guard_count(Rs?, NG),
    question_fault1(NQ?, NG?, S?, F).
procedure count_questions(PSentences?, Integer).
count_questions([], 0).
count_questions([_|Qs], N?) :- count_questions(Qs?, M), N := M? + 1.
procedure question_fault1(Integer?, Integer?, Constant?, Lines).
question_fault1(_, 1, _, []).
question_fault1(1, NG, _, []) :- NG? > 1 | true.
question_fault1(NQ, NG, _, []) :- NG? > 1, NQ? =:= NG? | true.
question_fault1(NQ, NG, S, [H?]) :- NG? > 1, NQ? =\= 1, NQ? =\= NG?, ground(S?) |
    said('%% a pragma\'s questions are neither one nor one per guarding role of the act:', S?, H).
question_fault1(_, 0, _, []).
procedure said_fault(Said?, Ints?, Constant?, Lines).
said_fault(none, _, _, []).
said_fault(said([]), _, _, []).
said_fault(said([Ws|Qs]), Pp, S, F?) :- ground(Ws?), ground(Qs?), ground(Pp?), ground(S?) |
    said_fault(said(Qs?), Pp?, S?, F2),
    said_fault0(Ws?, Pp?, S?, F1),
    lapp(F1?, F2?, F).
procedure said_fault0(PWords?, Ints?, Constant?, Lines).
said_fault0(Ws, Pp, S, F?) :- ground(Ws?), ground(Pp?), ground(S?) |
    count_ints(Pp?, NP),
    said_fault1(Ws?, NP?, S?, F).
procedure said_fault1(PWords?, Integer?, Constant?, Lines).
said_fault1([], _, _, []).
said_fault1([text(_)|Ws], NP, S, F?) :- said_fault1(Ws?, NP?, S?, F).
said_fault1([person(I)|Ws], NP, S, F?) :- I? =< NP? | said_fault1(Ws?, NP?, S?, F).
said_fault1([person(I)|_], NP, S, [H?]) :- I? > NP?, ground(S?) |
    said('%% a sentence names a person the schema does not have:', S?, H).
procedure count_strings(Strings?, Integer).
count_strings([], 0).
count_strings([_|Xs], N?) :- count_strings(Xs?, M), N := M? + 1.
procedure count_ints(Ints?, Integer).
count_ints([], 0).
count_ints([_|Xs], N?) :- count_ints(Xs?, M), N := M? + 1.

%% The places of a schema's request name that a pragma's fields may name, in the order of its head, the places of its listed roles left out (proposal_alts: the request name is "the binding, its head with no extent"): its roles, then its variables a person or the state fills, a pragma's fields naming them, a field left empty naming none, as pragmas.sh aligns them: "a button is pressed in the row of a tab's entry, whose person takes a role of the act, and the fields are what the proposer fills besides" (vGLP 516a0a2, Section 5.4, "The contract's words"), so the proposer's place and the entry's are left empty, and a field names each other role, as GAI's Agent meet <person> names Bob, and each variable, as GC's swap its four; a place no field names is filled from what the view lists or from the proposer's state.
procedure field_places(Args?, RoleSpecs?, Ints).
field_places(Hd, Rs, Fp?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs0?, Lis?, Vs),
    field_places2(Vs?, 1, [], Fp).
%% The places of the args Vs from I that a field may name: a role not in Lis, an agent, speech-act or numeric variable.
procedure field_places2(Args?, Integer?, Ints?, Ints).
field_places2([], _, _, []).
field_places2([V|Vs], I, Lis, Fp?) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    a_field(V?, I?, Lis?, F),
    field_places2(Vs?, I1?, Lis?, Fp1),
    keep_int(F?, I?, Fp1?, Fp).
procedure a_field(Arg?, Integer?, Ints?, YesNo).
a_field(role(_), I, Lis, F?) :- ground(Lis?) | mem(I?, Lis?, In), neg(In?, F).
a_field(pvar(_), _, _, yes).
a_field(svar(_), _, _, yes).
a_field(num(_), _, _, yes).
a_field(nterm(_), _, _, no).
a_field(sgn(_, _), _, _, no).
a_field(any, _, _, no).
procedure keep_int(YesNo?, Integer?, Ints?, Ints).
keep_int(yes, I, Is, [I?|Is?]).
keep_int(no, _, Is, Is?).
%% The places of a schema's class term that hold its persons, in the order of its head: its roles that are not listed roles, then its agent variables.  A sentence's Alice, Bob and Carol are the first, the second and the third of them, as GSC writes a schema, befriend(Alice?, Bob?), introduce(Alice?, Bob?; c), Carol its agent variable c (GSC, Sections 3.2 and 3.3).
procedure person_places(Args?, RoleSpecs?, Ints).
person_places(Hd, Rs, Pp?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    person_places1(Vs?, 1, Lis?, Pp).
procedure person_places1(Args?, Integer?, Ints?, Ints).
person_places1([], _, _, []).
person_places1([V|Vs], I, Lis, Pp?) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    a_person(V?, I?, Lis?, P),
    person_places1(Vs?, I1?, Lis?, Pp1),
    keep_int(P?, I?, Pp1?, Pp).
procedure a_person(Arg?, Integer?, Ints?, YesNo).
a_person(role(_), I, Lis, P?) :- mem(I?, Lis?, In), neg(In?, P).
a_person(pvar(_), _, _, yes).
a_person(svar(_), _, _, no).
a_person(num(_), _, _, no).
a_person(nterm(_), _, _, no).
a_person(sgn(_, _), _, _, no).
a_person(any, _, _, no).

%% The two widget declarations every platform carries (vGLP, Section 6.2, "The words a platform shows": "The compiler prints three widget declarations for a platform: for its request type, a menu of the buttons and the fields of the contract's acts; for its approval type, the question with the buttons yes and no"), so that no app writes a self.vglp: the approval question drawn by the construct family's approval_sentence, the request question by its social_menu.  With pragmas, the request type's declaration carries the buttons the contract's pragmas give, button(B, Acts), B the label in brackets and Acts the acts it names (Section 5.4, "The contract's words": "A button is of the acts it names"); each act, for each guarding role at which it is proposed, act(F, M, Pre, Binds, Fields, Same, Text): F its schema, M the place of the proposer in its request, Pre the atoms its schema requires and forbids at the proposer's role and what the schemas prove, Binds the places of its request those atoms bind, Fields its fields, field(I, S, T), its place I, its label S and its type T, in the schema's order, Same its places possibly one person and Text the text of its request form (Section 6.2: the request widget "draws one button for each way the viewer's state, in the last view written, satisfies the act at the proposer's role, with the values that way binds and the act's fields").  It carries no tab and no row: where the construct family draws a button is its own choice, from the atoms that bind the way (Section 6.2: "How the buttons of one act are arranged, each beside the atoms that bind it or as one button with a picker, is the construct family's").  The approval question's two answers are given by no pragma, so its declaration carries no label, and the construct family draws the name of each (Section 6.2: "A construct family draws the label it is given, and the name of the type where it is given none").  The grammar is README.md's beside this file, 6.
procedure widget_lines(Worded?, Contract?, Preds?, DrawCtx?, Lines).
widget_lines(_, _, [], _, ['', '%% The widget declarations of the platform (vGLP, Section 6.2, Definition "Widget Declaration"): its approval question drawn by the construct family\'s approval_sentence, and its request question, a contract with no guarded part having the request refresh alone, by its social_menu, with no button.', 'Approval =::= approval_sentence.', 'Request? =::= social_menu([]).']).
widget_lines(words(pragmas(_, As)), C, Ps, Rf, ['', '%% The widget declarations of the platform (vGLP, Section 6.2, Definition "Widget Declaration"; "The words a platform shows"): its approval question drawn by the construct family\'s approval_sentence, and its request question, of the moded type Request?, by its social_menu, which reads the agent\'s own key and the persons it knows from the last view drawn on construct 0 (Section 6.2), with a button for each button of the contract\'s pragmas, button(B, Acts), B its label and Acts the acts it names, each act(F, M, Roles, Pre, Binds, Fields, Same, Text), F the schema, M the place of the proposer, Roles the places of its roles, Pre the atoms the schema requires, req(P, As), and forbids, forb(P, As), at the proposer\'s role and what the schemas prove, unless(P, As) and proved(Q, Ws, P, As), As each argument\'s place, at(K), a group\'s, grp(J, K), or any, Binds the places those atoms bind, Fields its fields, field(I, S, T), its place I, its label S and its type T, person, key, text or number, Same its places possibly one person, same(K, J), and Text the text of its request form, each word say(S) or at(I) (README.md beside this file, 6).', 'Approval =::= approval_sentence.', T?, '.']) :-
    ground(As?), ground(C?), ground(Ps?), ground(Rf?) |
    act_buttons(As?, C?, Ps?, Rf?, [], Bs),
    button_texts(Bs?, Bt),
    list_text(Bt?, Bl),
    call_text('Request? =::= social_menu', [Bl?], T).
%% The declaration as a line of source (README.md beside this file, 6): a schema's and a predicate's name through term_to_string/2, a label and a word of the text as pragmas.sh writes them, a double-quoted string.
procedure button_texts(WButtons?, Strings).
button_texts([], []).
button_texts([button(B, As)|Bs], [T?|Ts?]) :-
    act_texts(As?, Xs),
    list_text(Xs?, Xl),
    call_text(button, [B?, Xl?], T),
    button_texts(Bs?, Ts).
procedure act_texts(WActs?, Strings).
act_texts([], []).
act_texts([act(F, M, Rp, Pre, Bd, Fd, Sm, Tx)|As], [T?|Ts?]) :- ground(F?), ground(M?), ground(Rp?), ground(Pre?), ground(Bd?), ground(Sm?) |
    term_to_string(F?, Ft),
    term_to_string(M?, Mt),
    term_to_string(Rp?, Rt),
    term_to_string(Pre?, Pt),
    term_to_string(Bd?, Bt),
    term_to_string(Sm?, St),
    field_texts(Fd?, Fs),
    list_text(Fs?, Fl),
    fword_texts(Tx?, Ws),
    list_text(Ws?, Wl),
    call_text(act, [Ft?, Mt?, Rt?, Pt?, Bt?, Fl?, St?, Wl?], T),
    act_texts(As?, Ts).
procedure field_texts(WFields?, Strings).
field_texts([], []).
field_texts([field(I, S, F)|Fs], [T?|Ts?]) :-
    term_to_string(I?, It),
    term_to_string(F?, Ft),
    call_text(field, [It?, S?, Ft?], T),
    field_texts(Fs?, Ts).
procedure fword_texts(FWords?, Strings).
fword_texts([], []).
fword_texts([say(S)|Ws], [T?|Ts?]) :- call_text(say, [S?], T), fword_texts(Ws?, Ts).
fword_texts([at(I)|Ws], [T?|Ts?]) :- term_to_string(at(I?), T), fword_texts(Ws?, Ts).
%% The buttons of the request widget: one for each button of the pragmas, in their order, with the acts it names that the request type proposes, a button naming none of them left out.
WField    ::= field(Integer, String, FieldType).
WFields   ::= [] ; [WField | WFields].
FieldType ::= person ; key ; agent ; text ; number.
FWord     ::= say(String) ; at(Integer).
FWords    ::= [] ; [FWord | FWords].
WAct      ::= act(Constant, Integer, Ints, Preconds, Ints, WFields, Preconds, FWords).
WActs     ::= [] ; [WAct | WActs].
WButton   ::= button(String, WActs).
WButtons  ::= [] ; [WButton | WButtons].
procedure act_buttons(PActs?, Contract?, Preds?, DrawCtx?, WButtons?, WButtons).
act_buttons([], _, _, _, Bs, Bs?).
act_buttons([act(N, B, Fs, Q, _, By)|As], C, Ps, Rf, Bs0, Bs?) :- ground(N?), ground(B?), ground(Fs?), ground(Q?), ground(By?), ground(C?), ground(Ps?), ground(Rf?), ground(Bs0?) |
    mem(N?, Ps?, In),
    find_schema(N?, C?, Sf),
    schema_acts(In?, Sf?, N?, Fs?, Q?, By?, Rf?, Ws),
    add_button(Bs0?, B?, Ws?, Bs1),
    act_buttons(As?, C?, Ps?, Rf?, Bs1?, Bs).
%% The acts Ws joined to the button labelled B, or a new button after the others; nothing where Ws is empty.  One name is one button (Section 5.4, "The contract's words": "A button is of the acts it names"), so every act of a name joins one button.
procedure add_button(WButtons?, String?, WActs?, WButtons).
add_button(Bs, _, [], Bs?).
add_button([], B, [W|Ws], [button(B?, [W?|Ws?])]).
add_button([button(B1, Xs)|Bs], B, [W|Ws], [button(B1?, Ys?)|Bs?]) :- ground(B1?), ground(B?), B1? =?= B? | app(Xs?, [W?|Ws?], Ys).
add_button([X|Bs], B, [W|Ws], [X?|Bs1?]) :- otherwise | add_button(Bs?, B?, [W?|Ws?], Bs1).
%% The acts of a schema the request type proposes, one for each guarding role at which it is proposed (proposer_roles).
procedure schema_acts(YesNo?, SFound?, Constant?, Strings?, Said?, Proposer?, DrawCtx?, WActs).
schema_acts(no, _, _, _, _, _, _, []).
schema_acts(yes, nosfound, _, _, _, _, _, []).
schema_acts(yes, sfound(Hd, Rs), S, Fs, Q, By, Rf, Ws?) :- ground(Hd?), ground(Rs?), ground(S?), ground(Fs?), ground(Q?), ground(By?), ground(Rf?) |
    schema_vars(Rs?, Hd?, Vs0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs0?, Lis?, Vs),
    schema_vars(Rs?, Hd?, Us0),
    listed_ixs(Rs?, 1, Lis1),
    drop_listed(Us0?, Lis1?, Us),
    field_places(Hd?, Rs?, Fp),
    meeting_schema(Rs?, Mt),
    act_fields(Fp?, Fs?, Us?, Mt?, Fd),
    guard_roles(Rs?, 1, Gr0),
    proposer_roles(By?, Gr0?, Gr),
    same_places(By?, Sm),
    form_text(Hd?, Rs?, Q?, Tx),
    role_acts(Gr?, S?, Vs?, Rs?, Rf?, Fd?, Sm?, Tx?, Ws).
%% The places of the request that hold roles: "distinct roles are bound to distinct agents, unless the clause says of two names 'possibly one person'" (vGLP, Section 5.4, "Speech-act schemas as local specifications"), and an agent variable is bound by no such rule (vGLP #23, Code_inbox.md, 2026-11-06 12:00 UTC, 1).
procedure role_places(Args?, Integer?, Ints).
role_places([], _, []).
role_places([role(_)|Vs], I, [I?|Is?]) :- integer(I?) | I1 := I? + 1, role_places(Vs?, I1?, Is).
role_places([V|Vs], I, Is?) :- otherwise, integer(I?), ground(V?) | I1 := I? + 1, role_places(Vs?, I1?, Is).
%% The fields of an act, field(I, S, T), the k-th field of its pragma at the k-th place field_places counts, a field left empty, an inapplicable field of a schema that shares its button, naming none (README.md beside this file, 2).
procedure act_fields(Ints?, Strings?, Args?, YesNo?, WFields).
act_fields(_, [], _, _, []).
act_fields([], [_|_], _, _, []).
act_fields([_|Is], [F|Fs], Vs, Mt, Fd?) :- ground(F?), F? =?= '""' | act_fields(Is?, Fs?, Vs?, Mt?, Fd).
act_fields([I|Is], [F|Fs], Vs, Mt, [field(I?, F?, T?)|Fd?]) :- otherwise, integer(I?), ground(F?), ground(Vs?), ground(Mt?) |
    nth_arg(I?, Vs?, A),
    field_type(A?, Mt?, T),
    act_fields(Is?, Fs?, Vs?, Mt?, Fd).
%% The type of a field (vGLP, Section 5.4, "The contract's words": "A field is typed, a person by key or picked among the persons the viewer knows"; Section 6.2: "A field that takes a person in a role offers the persons the viewer knows ... The field of an acquaintance takes the key of a person the viewer does not know"): a person in a role, picked among the persons the viewer knows; the key of the peer of an acquaintance schema; an agent variable, a person in no role, by key or picked, which Section 6.2's two sentences do not restrict; a speech act, a text; a number.
procedure field_type(Arg?, YesNo?, FieldType).
field_type(role(_), no, person).
field_type(role(_), yes, key).
field_type(pvar(_), _, agent).
field_type(svar(_), _, text).
field_type(num(_), _, number).
%% A name term, a signed term and the wildcard are at no place a field may name (field_places); the clauses cover the type.
field_type(nterm(_), _, text).
field_type(sgn(_, _), _, text).
field_type(any, _, text).
%% An act for each guarding role G at which it is proposed: its proposer's place M, its precondition there (condition_places) and the places that precondition binds.
procedure role_acts(Ints?, Constant?, Args?, RoleSpecs?, DrawCtx?, WFields?, Preconds?, FWords?, WActs).
role_acts([], _, _, _, _, _, _, _, []).
role_acts([G|Gs], S, Vs, Rs, Rf, Fd, Sm, Tx, [act(S?, M?, Rp?, Pre?, Bd?, Fd?, Sm?, Tx?)|Ws?]) :- integer(G?), ground(S?), ground(Vs?), ground(Rs?), ground(Rf?), ground(Fd?), ground(Sm?), ground(Tx?) |
    place_of(role(G?), Vs?, 1, M),
    role_places(Vs?, 1, Rp),
    condition_places(G?, Rs?, Vs?, Rf?, Pre0),
    role_field_places(Fd?, Pk),
    field_proved(Pre0?, Pk?, Pre),
    condition_places(G?, Rs?, Vs?, Rf?, Pre1),
    bound_places(Pre1?, M?, Bd0),
    dedup(Bd0?, Bd),
    role_acts(Gs?, S?, Vs?, Rs?, Rf?, Fd?, Sm?, Tx?, Ws).
%% What the schemas prove of a person is printed for a field that takes a person in a role, and for no other place (vGLP, Section 6.2: "A field that takes a person in a role offers the persons the viewer knows ... and, where that person's role requires an atom that the schemas prove of a person from the viewer's records, as above, only a person so proved").
procedure role_field_places(WFields?, Ints).
role_field_places([], []).
role_field_places([field(I, _, person)|Fs], [I?|Is?]) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, key)|Fs], Is?) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, agent)|Fs], Is?) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, text)|Fs], Is?) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, number)|Fs], Is?) :- role_field_places(Fs?, Is).
procedure field_proved(Preconds?, Ints?, Preconds).
field_proved([], _, []).
field_proved([proved(Q, Ws, P, As)|Cs], Ks, R?) :- ground(Q?), ground(Ws?), ground(P?), ground(As?), ground(Ks?) |
    at_of(As?, K),
    int_in(K?, Ks?, B),
    keep_proved(B?, Q?, Ws?, P?, As?, R1),
    field_proved(Cs?, Ks?, R2),
    app(R1?, R2?, R).
field_proved([C|Cs], Ks, [C?|R?]) :- otherwise, ground(Ks?) | field_proved(Cs?, Ks?, R).
procedure keep_proved(YesNo?, Constant?, Preds?, Constant?, CondArgs?, Preconds).
keep_proved(no, _, _, _, _, []).
keep_proved(yes, Q, Ws, P, As, [proved(Q?, Ws?, P?, As?)]).
%% The one place a proved entry's arguments name, the rest being any (unless_args).
procedure at_of(CondArgs?, Integer).
at_of([], 0).
at_of([at(K)|_], K?).
at_of([grp(_, K)|_], K?).
at_of([any|As], K?) :- at_of(As?, K).
procedure int_in(Integer?, Ints?, YesNo).
int_in(_, [], no).
int_in(K, [I|_], yes) :- integer(K?), integer(I?), K? =:= I? | true.
int_in(K, [I|Is], B?) :- integer(K?), integer(I?), K? =\= I? | int_in(K?, Is?, B).
%% The places of the request that the atoms the act requires at the proposer's role bind, beside the proposer's own M: each at(K) and each grp(J, K) of a req(P, As), a local variable, any, binding no place (vGLP 40f8444, Section 5.4, "The contract's words": "every binding of the variables of the atoms the schema requires there under which the state holds those atoms").
procedure bound_places(Preconds?, Integer?, Ints).
bound_places([], _, []).
bound_places([req(_, As)|Ps], M, Bd?) :- ground(As?), integer(M?) |
    arg_bound(As?, M?, B1),
    bound_places(Ps?, M?, B2),
    app(B1?, B2?, Bd).
bound_places([_|Ps], M, Bd?) :- otherwise | bound_places(Ps?, M?, Bd).
procedure arg_bound(CondArgs?, Integer?, Ints).
arg_bound([], _, []).
arg_bound([at(K)|As], M, [K?|Bd?]) :- integer(K?), integer(M?), K? =\= M? | arg_bound(As?, M?, Bd).
arg_bound([at(K)|As], M, Bd?) :- integer(K?), integer(M?), K? =:= M? | arg_bound(As?, M?, Bd).
arg_bound([grp(J, K)|As], M, Bd?) :- integer(J?), integer(K?), integer(M?) | arg_bound([at(J?), at(K?)|As?], M?, Bd).
arg_bound([any|As], M, Bd?) :- arg_bound(As?, M?, Bd).
%% The text of the request form of an act with one guarding role, its question "text of the request form, shown with the button: the request is the will, elicited once" (vGLP, Section 5.4, "The contract's words"), each word say(S), or at(I), the person at place I of the request, the sentence's person(K) the K-th of the schema's persons; [] for every other act.
procedure form_text(Args?, RoleSpecs?, Said?, FWords).
form_text(_, _, none, []).
form_text(Hd, Rs, said(Qs), Tx?) :- ground(Hd?), ground(Rs?), ground(Qs?) |
    guard_count(Rs?, N),
    join_questions(Qs?, Ws),
    form_text1(N?, Hd?, Rs?, Ws?, Tx).
procedure form_text1(Integer?, Args?, RoleSpecs?, PWords?, FWords).
form_text1(1, Hd, Rs, Ws, Tx?) :- ground(Hd?), ground(Rs?), ground(Ws?) |
    person_places(Hd?, Rs?, Pp),
    schema_vars(Rs?, Hd?, Vs0),
    schema_vars(Rs?, Hd?, Vs1),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs1?, Lis?, Vs),
    form_words(Ws?, Pp?, Vs0?, Vs?, Tx).
form_text1(N, _, _, _, []) :- N? =\= 1 | true.
%% The questions of a line as one text, each after the one before and a space.
procedure join_questions(PSentences?, PWords).
join_questions([], []).
join_questions([Q], Q?).
join_questions([Q1, Q2|Qs], Ws?) :- join_questions([Q2?|Qs?], Ws1), app(Q1?, [text('" "')|Ws1?], Ws).
%% A sentence's words as the request form's: text(S) as say(S), and person(K), the K-th of the schema's persons, as at(I), I its place in the request.
procedure form_words(PWords?, Ints?, Args?, Args?, FWords).
form_words([], _, _, _, []).
form_words([text(X)|Ws], Pp, Vs0, Vs, [say(X?)|Fs?]) :- form_words(Ws?, Pp?, Vs0?, Vs?, Fs).
form_words([person(K)|Ws], Pp, Vs0, Vs, [at(I?)|Fs?]) :- ground(Pp?), ground(Vs0?), ground(Vs?) |
    nth_int(K?, Pp?, J),
    nth_arg(J?, Vs0?, A),
    place_of(A?, Vs?, 1, I),
    form_words(Ws?, Pp?, Vs0?, Vs?, Fs).
%% The schemas the buttons name.
procedure act_names(PActs?, Preds).
act_names([], []).
act_names([act(N, _, _, _, _, _)|As], [N?|Ns?]) :- act_names(As?, Ns).
%% A guarded schema no button names: "A guarded schema is proposed by a person, by its button, so the compiler requires a button for every guarded schema; an unguarded one is proposed by its opener's machine and has none" (vGLP 932c710, Section 5.4, "The contract's words").  The schemas the request type proposes are those naming guarded parts (local.glp, proposable).
procedure unnamed_lines(Preds?, Preds?, Lines).
unnamed_lines([], _, []).
unnamed_lines([P|Ps], Ns, L?) :- ground(P?), ground(Ns?) |
    mem(P?, Ns?, In),
    unnamed_line(In?, P?, L1),
    unnamed_lines(Ps?, Ns?, L2),
    lapp(L1?, L2?, L).
procedure unnamed_line(YesNo?, Constant?, Lines).
unnamed_line(yes, _, []).
unnamed_line(no, P, [H?]) :- ground(P?) |
    said('%% a guarded schema has no button in the contract\'s pragmas:', P?, H).

%% The guarding roles at which the act is proposed, by(Gs), as pragmas.sh reads them, each one whose every other guarding role has a question (vGLP 3ec07a2, Section 5.4, "The contract's words": "A guarding role with no question is never asked, so an act is proposed only at a guarding role whose every other guarding role has a question"; Section 6.2, "The words a platform shows": "The request widget offers an act only where the person's machine can propose it, and at a guarding role at which the act is proposed"), the proposer a line in GSC's form names (GSC, Section 2, its first paragraph); each guarding role, any, where the scripts gave no contract term.
procedure proposer_roles(Proposer?, Ints?, Ints).
proposer_roles(any, Gr, Gr?).
proposer_roles(by(Gs), _, Gs?).
proposer_roles(by(Gs, _), _, Gs?).
%% The pairs of places possibly one person (GSC 316d875, Section 2: "a clause that admits one person in both writes 'Alice and Bob, possibly one person'"), printed in each act entry, same(K, J), a field offering one person for both (vGLP, Section 6.2).
procedure same_places(Proposer?, Preconds).
same_places(any, []).
same_places(by(_), []).
same_places(by(_, Ss), Is?) :- ground(Ss?) | sames_items(Ss?, Is).
procedure sames_items(Sames?, Preconds).
sames_items([], []).
sames_items([same(K, J)|Ss], [same(K?, J?)|Is?]) :- sames_items(Ss?, Is).
%% The precondition of the act at the role G, the viewer's (vGLP 6e9f71d, Section 6.2, "The words a platform shows": a button is drawn "in the row of an entry that an atom the act requires or deletes at the proposer's role names, whatever the atom's predicate, a group <a>.n being named by n ...; and only where the viewer's state holds the atoms the act requires at the proposer's role and lacks those it forbids there"), so that the construct family finds from it both the rows the button is drawn in and whether it is drawn there: req(P, As) for each atom the schema requires or deletes at G, forb(P, As) for each it forbids there, As the place of each argument, at(K), a group by the places of its leader and its name, grp(J, K), and any where it is neither, as a variable local to the role; an atom of a reflexive predicate naming the role G itself is left out, holding at every person of that person (Section 5.4, "Act schemas as local specifications").
procedure condition_places(Integer?, RoleSpecs?, Args?, DrawCtx?, Preconds).
condition_places(G, Rs, Vs, ctx(Rf, Rl), Cs?) :- integer(G?), ground(Rs?), ground(Vs?), ground(Rf?), ground(Rl?) |
    nth_rs(G?, Rs?, R),
    condition_places1(R?, G?, Vs?, Rf?, C1),
    unless_places(Rs?, 1, G?, Vs?, Rl?, C2),
    dedup(C2?, C3),
    proved_places(Rs?, 1, G?, Vs?, Rl?, C4),
    dedup(C4?, C5),
    app(C3?, C5?, C35),
    app(C1?, C35?, Cs).
procedure condition_places1(RoleSpecs?, Integer?, Args?, Preds?, Preconds).
condition_places1([], _, _, _, []).
condition_places1([R|_], G, Vs, Rf, Cs?) :- ground(R?), integer(G?), ground(Vs?), ground(Rf?) |
    rs_lists(R?, _, M0, K, N),
    uncleared(M0?, M),
    app(K?, M?, Rq),
    cond_atoms(Rq?, req, G?, Vs?, Rf?, C1),
    cond_atoms(N?, forb, G?, Vs?, Rf?, C2),
    app(C1?, C2?, Cs).
procedure cond_atoms(Atoms?, Constant?, Integer?, Args?, Preds?, Preconds).
cond_atoms([], _, _, _, _, []).
cond_atoms([times(_, A)|As], Sg, G, Vs, Rf, Cs?) :- cond_atoms([A?|As?], Sg?, G?, Vs?, Rf?, Cs).
%% The copies of an atom a role keeps beyond those it deletes, whose req the deleted atom gives.
cond_atoms([rest(_, _, _)|As], Sg, G, Vs, Rf, Cs?) :- cond_atoms(As?, Sg?, G?, Vs?, Rf?, Cs).
cond_atoms([atom(P, Xs)|As], Sg, G, Vs, Rf, Cs?) :- ground(P?), ground(Xs?), ground(Sg?), integer(G?), ground(Vs?), ground(Rf?) |
    mem(P?, Rf?, In),
    self_refl(In?, Xs?, G?, Sk),
    cond_args(Xs?, Vs?, Ks),
    cond_atom(Sk?, Sg?, P?, Ks?, C1),
    cond_atoms(As?, Sg?, G?, Vs?, Rf?, C2),
    app(C1?, C2?, Cs).
procedure self_refl(YesNo?, Args?, Integer?, YesNo).
self_refl(no, _, _, no).
self_refl(yes, [role(J)], G, yes) :- J? =:= G? | true.
self_refl(yes, _, _, no) :- otherwise | true.
procedure cond_atom(YesNo?, Constant?, Constant?, CondArgs?, Preconds).
cond_atom(yes, _, _, _, []).
cond_atom(no, req, P, Ks, [req(P?, Ks?)]).
cond_atom(no, forb, P, Ks, [forb(P?, Ks?)]).
CondArg ::= at(Integer) ; grp(Integer, Integer) ; any.
CondArgs ::= [] ; [CondArg | CondArgs].
procedure cond_args(Args?, Args?, CondArgs).
cond_args([], _, []).
cond_args([nterm(ext(own(J), Y))|Xs], Vs, [A?|As?]) :- integer(J?), ground(Y?), ground(Vs?) |
    place_of(role(J?), Vs?, 1, PJ),
    place_of(svar(Y?), Vs?, 1, PY),
    grp_arg(PJ?, PY?, A),
    cond_args(Xs?, Vs?, As).
cond_args([X|Xs], Vs, [A?|As?]) :- otherwise, ground(X?), ground(Vs?) |
    place_of(X?, Vs?, 1, K),
    at_arg(K?, A),
    cond_args(Xs?, Vs?, As).
procedure grp_arg(Integer?, Integer?, CondArg).
grp_arg(J, K, grp(J?, K?)) :- J? > 0, K? > 0 | true.
grp_arg(_, _, any) :- otherwise | true.
procedure at_arg(Integer?, CondArg).
at_arg(K, at(K?)) :- K? > 0 | true.
at_arg(0, any).
%% What the schemas prove of the other roles (vGLP 893d4ea, Section 6.2, "The words a platform shows": "where every schema that adds an atom naming x at a role requires or adds at x's role an atom that no schema deletes, the viewer holding the first shows that x holds the second, and an act that forbids the second at x's role is not drawn beside x"): rule(P, N, I, pat(Q, Ws)), the atom of P of arity N naming x at its argument I, at the viewer v, shows that x holds Q, its arguments Ws each x or v; derived from the schemas when the contract is compiled.  An act at the viewer's role G that forbids, at the role s of its place K, an atom such a rule proves of the person at K, is drawn with unless(P, As), As at(K) at argument I and any elsewhere: the viewer holding a matching atom, it is not drawn.
DrawCtx ::= ctx(Preds, Rules).
Pat ::= pat(Constant, Preds).
Pats ::= [] ; [Pat | Pats].
Rule ::= rule(Constant, Integer, Integer, Pat).
Rules ::= [] ; [Rule | Rules].
Occ ::= occ(Constant, Integer, Integer, Pats).
Occs ::= [] ; [Occ | Occs].
procedure proved_rules(Contract?, Rules).
proved_rules(C, Rl?) :- ground(C?) |
    deleted_preds(C?, D),
    proved_rules1(C?, D?, Rl).
procedure proved_rules1(Contract?, Preds?, Rules).
proved_rules1(C, D, Rl?) :- ground(C?), ground(D?) |
    schema_occs(C?, D?, Os),
    schema_occs(C?, D?, Os2),
    occ_rules(Os?, Os2?, Rl).
procedure sch_rs(Schema?, RoleSpecs).
sch_rs(schema(_, _, Rs), Rs?).
sch_rs(cschema(_, _, _, Rs), Rs?).
sch_rs(nschema(_, _, _, Rs), Rs?).
%% The predicates some schema deletes.
procedure deleted_preds(Contract?, Preds).
deleted_preds([], []).
deleted_preds([S|Ss], D?) :- ground(S?) |
    sch_rs(S?, Rs),
    rs_deleted(Rs?, D1),
    deleted_preds(Ss?, D2),
    app(D1?, D2?, D).
procedure rs_deleted(RoleSpecs?, Preds).
rs_deleted([], []).
rs_deleted([R|Rs], D?) :- ground(R?) |
    rs_lists(R?, _, M, _, _),
    atom_preds(M?, D1),
    rs_deleted(Rs?, D2),
    app(D1?, D2?, D).
procedure atom_preds(Atoms?, Preds).
atom_preds([], []).
atom_preds([atom(P, _)|As], [P?|Ps?]) :- atom_preds(As?, Ps).
atom_preds([times(_, A)|As], Ps?) :- atom_preds([A?|As?], Ps).
atom_preds([rest(_, _, A)|As], Ps?) :- atom_preds([A?|As?], Ps).
%% For each schema, each role r and each atom it adds there naming another role s at argument I: occ(P, N, I, Pats), Pats the atoms required or added at s whose predicate no schema deletes, their arguments s and r read x and v.
procedure schema_occs(Contract?, Preds?, Occs).
schema_occs([], _, []).
schema_occs([S|Ss], D, Os?) :- ground(S?), ground(D?) |
    sch_rs(S?, Rs),
    sch_rs(S?, Rs2),
    role_occs(Rs?, Rs2?, 1, D?, O1),
    schema_occs(Ss?, D?, O2),
    app(O1?, O2?, Os).
procedure role_occs(RoleSpecs?, RoleSpecs?, Integer?, Preds?, Occs).
role_occs([], _, _, _, []).
role_occs([R|Rs], All, Ri, D, Os?) :- ground(R?), ground(All?), integer(Ri?), ground(D?) |
    rs_lists(R?, P, _, _, _),
    added_occs(P?, All?, Ri?, D?, O1),
    Ri1 := Ri? + 1,
    role_occs(Rs?, All?, Ri1?, D?, O2),
    app(O1?, O2?, Os).
procedure added_occs(Atoms?, RoleSpecs?, Integer?, Preds?, Occs).
added_occs([], _, _, _, []).
added_occs([times(_, A)|As], All, Ri, D, Os?) :- added_occs([A?|As?], All?, Ri?, D?, Os).
added_occs([rest(_, _, A)|As], All, Ri, D, Os?) :- added_occs([A?|As?], All?, Ri?, D?, Os).
added_occs([atom(P, Xs)|As], All, Ri, D, Os?) :- ground(P?), ground(Xs?), ground(All?), integer(Ri?), ground(D?) |
    count_args(Xs?, N),
    arg_occs(Xs?, 1, P?, N?, All?, Ri?, D?, O1),
    added_occs(As?, All?, Ri?, D?, O2),
    app(O1?, O2?, Os).
procedure arg_occs(Args?, Integer?, Constant?, Integer?, RoleSpecs?, Integer?, Preds?, Occs).
arg_occs([], _, _, _, _, _, _, []).
arg_occs([role(Sx)|Xs], I, P, N, All, Ri, D, Os?) :- integer(Sx?), integer(I?), ground(P?), integer(N?), ground(All?), integer(Ri?), ground(D?), Sx? =\= Ri? |
    nth_rs(Sx?, All?, R),
    role_pats(R?, Sx?, Ri?, D?, Pats),
    I1 := I? + 1,
    arg_occs(Xs?, I1?, P?, N?, All?, Ri?, D?, O2),
    Os = [occ(P?, N?, I?, Pats?)|O2?].
arg_occs([_|Xs], I, P, N, All, Ri, D, Os?) :- otherwise, integer(I?) |
    I1 := I? + 1,
    arg_occs(Xs?, I1?, P?, N?, All?, Ri?, D?, Os).
procedure role_pats(RoleSpecs?, Integer?, Integer?, Preds?, Pats).
role_pats([], _, _, _, []).
role_pats([R|_], Sx, Ri, D, Pats?) :- ground(R?), integer(Sx?), integer(Ri?), ground(D?) |
    rs_lists(R?, P, M0, K, _),
    uncleared(M0?, M),
    app(K?, M?, A1),
    app(A1?, P?, A),
    atom_pats(A?, Sx?, Ri?, D?, Pats).
procedure atom_pats(Atoms?, Integer?, Integer?, Preds?, Pats).
atom_pats([], _, _, _, []).
atom_pats([times(_, A)|As], Sx, Ri, D, Ps?) :- atom_pats([A?|As?], Sx?, Ri?, D?, Ps).
atom_pats([rest(_, _, A)|As], Sx, Ri, D, Ps?) :- atom_pats([A?|As?], Sx?, Ri?, D?, Ps).
atom_pats([atom(Q, Ys)|As], Sx, Ri, D, Ps?) :- ground(Q?), ground(Ys?), integer(Sx?), integer(Ri?), ground(D?) |
    mem(Q?, D?, Del),
    xv_args(Ys?, Sx?, Ri?, Ws, Ok),
    atom_pat(Del?, Ok?, Q?, Ws?, P1),
    atom_pats(As?, Sx?, Ri?, D?, P2),
    app(P1?, P2?, Ps).
procedure atom_pat(YesNo?, YesNo?, Constant?, Preds?, Pats).
atom_pat(no, yes, Q, Ws, [pat(Q?, Ws?)]).
atom_pat(yes, _, _, _, []).
atom_pat(no, no, _, _, []).
procedure xv_args(Args?, Integer?, Integer?, Preds, YesNo).
xv_args([], _, _, [], yes).
xv_args([role(J)|Ys], Sx, Ri, [x|Ws?], Ok?) :- integer(J?), integer(Sx?), integer(Ri?), J? =:= Sx? | xv_args(Ys?, Sx?, Ri?, Ws, Ok).
xv_args([role(J)|Ys], Sx, Ri, [v|Ws?], Ok?) :- integer(J?), integer(Sx?), integer(Ri?), J? =:= Ri? | xv_args(Ys?, Sx?, Ri?, Ws, Ok).
xv_args(_, _, _, [], no) :- otherwise | true.
%% The rules: for each occurrence, each of its patterns that every occurrence of the same predicate, arity and argument has.
procedure occ_rules(Occs?, Occs?, Rules).
occ_rules([], _, []).
occ_rules([occ(P, N, I, Ps)|Os], All, Rl?) :- ground(P?), integer(N?), integer(I?), ground(Ps?), ground(All?) |
    common_pats(Ps?, P?, N?, I?, All?, Rl1),
    occ_rules(Os?, All?, Rl2),
    app(Rl1?, Rl2?, Rl).
procedure common_pats(Pats?, Constant?, Integer?, Integer?, Occs?, Rules).
common_pats([], _, _, _, _, []).
common_pats([Pt|Ps], P, N, I, All, Rl?) :- ground(Pt?), ground(P?), integer(N?), integer(I?), ground(All?) |
    in_every(All?, P?, N?, I?, Pt?, B),
    keep_rule(B?, rule(P?, N?, I?, Pt?), Rl1),
    common_pats(Ps?, P?, N?, I?, All?, Rl2),
    app(Rl1?, Rl2?, Rl).
procedure keep_rule(YesNo?, Rule?, Rules).
keep_rule(yes, R, [R?]).
keep_rule(no, _, []).
procedure in_every(Occs?, Constant?, Integer?, Integer?, Pat?, YesNo).
in_every([], _, _, _, _, yes).
in_every([occ(P1, N1, I1, Ps1)|Os], P, N, I, Pt, B?) :- ground(P1?), ground(N1?), ground(I1?), ground(Ps1?), ground(P?), integer(N?), integer(I?), ground(Pt?), occ(P1?, N1?, I1?) =?= occ(P?, N?, I?) |
    mem(Pt?, Ps1?, B1),
    in_every1(B1?, Os?, P?, N?, I?, Pt?, B).
in_every([_|Os], P, N, I, Pt, B?) :- otherwise | in_every(Os?, P?, N?, I?, Pt?, B).
procedure in_every1(YesNo?, Occs?, Constant?, Integer?, Integer?, Pat?, YesNo).
in_every1(no, _, _, _, _, _, no).
in_every1(yes, Os, P, N, I, Pt, B?) :- in_every(Os?, P?, N?, I?, Pt?, B).
%% The unless entries of an act at the viewer's role G: for each other role s of it, at its place K, each atom it forbids at s that a rule proves of the person at s.
procedure unless_places(RoleSpecs?, Integer?, Integer?, Args?, Rules?, Preconds).
unless_places([], _, _, _, _, []).
unless_places([R|Rs], Sx, G, Vs, Rl, Us?) :- ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    unless_role(R?, Sx?, G?, Vs?, Rl?, U1),
    Sx1 := Sx? + 1,
    unless_places(Rs?, Sx1?, G?, Vs?, Rl?, U2),
    app(U1?, U2?, Us).
procedure unless_role(RoleSpec?, Integer?, Integer?, Args?, Rules?, Preconds).
unless_role(_, Sx, G, _, _, []) :- integer(Sx?), integer(G?), Sx? =:= G? | true.
unless_role(R, Sx, G, Vs, Rl, Us?) :- otherwise, ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    rs_lists(R?, _, _, _, N),
    place_of(role(Sx?), Vs?, 1, K),
    forb_pats(N?, Sx?, G?, Fs),
    unless_rules(Rl?, Fs?, K?, Us).
procedure forb_pats(Atoms?, Integer?, Integer?, Pats).
forb_pats([], _, _, []).
forb_pats([times(_, A)|As], Sx, G, Ps?) :- forb_pats([A?|As?], Sx?, G?, Ps).
forb_pats([rest(_, _, A)|As], Sx, G, Ps?) :- forb_pats([A?|As?], Sx?, G?, Ps).
forb_pats([atom(Q, Ys)|As], Sx, G, Ps?) :- ground(Q?), ground(Ys?), integer(Sx?), integer(G?) |
    xv_args(Ys?, Sx?, G?, Ws, Ok),
    atom_pat(no, Ok?, Q?, Ws?, P1),
    forb_pats(As?, Sx?, G?, P2),
    app(P1?, P2?, Ps).
procedure unless_rules(Rules?, Pats?, Integer?, Preconds).
unless_rules([], _, _, []).
unless_rules([rule(P, N, I, Pt)|Rl], Fs, K, Us?) :- ground(P?), integer(N?), integer(I?), ground(Pt?), ground(Fs?), integer(K?) |
    mem(Pt?, Fs?, B),
    unless_entry(B?, P?, N?, I?, K?, U1),
    unless_rules(Rl?, Fs?, K?, U2),
    app(U1?, U2?, Us).
procedure unless_entry(YesNo?, Constant?, Integer?, Integer?, Integer?, Preconds).
unless_entry(no, _, _, _, _, []).
unless_entry(yes, P, N, I, K, [unless(P?, As?)]) :- K? > 0 | unless_args(1, N?, I?, K?, As).
unless_entry(yes, _, _, _, 0, []).
procedure unless_args(Integer?, Integer?, Integer?, Integer?, CondArgs).
unless_args(J, N, _, _, []) :- J? > N? | true.
unless_args(J, N, I, K, [at(K?)|As?]) :- J? =< N?, J? =:= I? | J1 := J? + 1, unless_args(J1?, N?, I?, K?, As).
unless_args(J, N, I, K, [any|As?]) :- J? =< N?, J? =\= I? | J1 := J? + 1, unless_args(J1?, N?, I?, K?, As).
%% The proved entries of an act at the viewer's role G (vGLP 3ec07a2, Section 6.2, "The words a platform shows": "where the place's role requires an atom that the schemas prove of a person from the viewer's records, as above, only a person so proved is offered"): for each other role s of it, at its place K, each atom pat(Q, Ws) it requires or deletes at s that a rule proves of the person at s, its arguments s and G read x and v, and each rule rule(P, N, I, pat(Q, Ws)) proving it, proved(Q, Ws, P, As), As at(K) at argument I and any elsewhere: the place K offers only a person x for whom, for each such atom, the viewer holds an atom matching some entry of it.
procedure proved_places(RoleSpecs?, Integer?, Integer?, Args?, Rules?, Preconds).
proved_places([], _, _, _, _, []).
proved_places([R|Rs], Sx, G, Vs, Rl, Us?) :- ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    proved_role(R?, Sx?, G?, Vs?, Rl?, U1),
    Sx1 := Sx? + 1,
    proved_places(Rs?, Sx1?, G?, Vs?, Rl?, U2),
    app(U1?, U2?, Us).
procedure proved_role(RoleSpec?, Integer?, Integer?, Args?, Rules?, Preconds).
proved_role(_, Sx, G, _, _, []) :- integer(Sx?), integer(G?), Sx? =:= G? | true.
proved_role(R, Sx, G, Vs, Rl, Us?) :- otherwise, ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    rs_lists(R?, _, M0, K, _),
    uncleared(M0?, M),
    app(K?, M?, A),
    forb_pats(A?, Sx?, G?, Fs),
    place_of(role(Sx?), Vs?, 1, Kp),
    proved_rules_of(Rl?, Fs?, Kp?, Us).
procedure proved_rules_of(Rules?, Pats?, Integer?, Preconds).
proved_rules_of([], _, _, []).
proved_rules_of([rule(P, N, I, Pt)|Rl], Fs, K, Us?) :- ground(P?), integer(N?), integer(I?), ground(Pt?), ground(Fs?), integer(K?) |
    mem(Pt?, Fs?, B),
    proved_entry(B?, Pt?, P?, N?, I?, K?, U1),
    proved_rules_of(Rl?, Fs?, K?, U2),
    app(U1?, U2?, Us).
procedure proved_entry(YesNo?, Pat?, Constant?, Integer?, Integer?, Integer?, Preconds).
proved_entry(no, _, _, _, _, _, []).
proved_entry(yes, pat(Q, Ws), P, N, I, K, [proved(Q?, Ws?, P?, As?)]) :- K? > 0 | unless_args(1, N?, I?, K?, As).
proved_entry(yes, _, _, _, _, 0, []).
%% The conditions of an act at the proposer's role, printed in its widget declaration: req(P, As) and forb(P, As), the atoms the schema requires and forbids there; unless(P, As) and proved(Q, Ws, P, As), what the schemas prove of the other roles; and same(K, J), two places possibly one person.
Precond ::= req(Constant, CondArgs) ; forb(Constant, CondArgs) ; unless(Constant, CondArgs) ; proved(Constant, Preds, Constant, CondArgs) ; same(Integer, Integer).
Preconds ::= [] ; [Precond | Preconds].
procedure nth_rs(Integer?, RoleSpecs?, RoleSpecs).
nth_rs(_, [], []).
nth_rs(1, [R|_], [R?]).
nth_rs(G, [_|Rs], R?) :- G? > 1 | G1 := G? - 1, nth_rs(G1?, Rs?, R).
%% The index of the first guarding role, from J; 0 where there is none.
procedure first_guard(RoleSpecs?, Integer?, Integer).
first_guard([], _, 0).
first_guard([R|Rs], J, G?) :- ground(R?), integer(J?) | rs_guarded(R?, B), first_guard1(B?, J?, Rs?, G).
procedure first_guard1(YesNo?, Integer?, RoleSpecs?, Integer).
first_guard1(yes, J, _, J?).
first_guard1(no, J, Rs, G?) :- integer(J?) | J1 := J? + 1, first_guard(Rs?, J1?, G).
%% The number of guarding roles.
procedure guard_count(RoleSpecs?, Integer).
guard_count([], 0).
guard_count([R|Rs], N?) :- ground(R?) | rs_guarded(R?, B), guard_count(Rs?, M), add_yes(B?, M?, N).
procedure add_yes(YesNo?, Integer?, Integer).
add_yes(yes, M, N?) :- N := M? + 1.
add_yes(no, M, M?).
%% The place of an argument among the request's arguments, from I; 0 where it is not one.
procedure place_of(Arg?, Args?, Integer?, Integer).
place_of(_, [], _, 0).
place_of(A, [B|_], I, I?) :- A? =?= B? | true.
place_of(A, [_|Bs], I, P?) :- otherwise, integer(I?) | I1 := I? + 1, place_of(A?, Bs?, I1?, P).
procedure nth_arg(Integer?, Args?, Arg).
nth_arg(1, [A|_], A?).
nth_arg(K, [_|As], A?) :- K? > 1 | K1 := K? - 1, nth_arg(K1?, As?, A).
nth_arg(_, [], role(0)).

%% The lists and the sentences, printed for a contract with pragmas: tabs(Ts), the lists its app shows, tab(Name, P), P the predicate whose atoms the list holds; and sentence_of(C, Me, Ws), the sentence the contract puts to the agent Me on an attempt of the part C, its roles and variables filled in from the binding C names, or [] where it puts none: where the pragma of C's clause has no sentence, or where the sentence names Me, the sentence being put to the guarding roles whose persons it does not name (README.md beside this file, "The pragmas").
procedure word_lines(Worded?, Contract?, Lines).
word_lines(words(pragmas(Ls, As)), C, L?) :- ground(Ls?), ground(As?), ground(C?) |
    contract_preds(C?, Pr),
    mult_preds(C?, Mp),
    tab_terms(Ls?, Pr?, Mp?, Ts),
    list_text(Ts?, Tl),
    call_text(tabs, [Tl?], T),
    sentence_lines(As?, C?, Lsn),
    lapp(Lsn?, ['sentence_of(_, _, asked(0, [])) :- otherwise | true.'], Lsn1),
    lapp(['',
        '%% The lists the app shows, as the contract\'s pragmas give them, each its name and the predicate whose atoms it lists (vGLP, Section 5.4, "The contract\'s words").',
        'procedure tabs(List(Tab)).',
        T?,
        '.',
        '',
        '%% The question the contract puts to the agent Me on an attempt of the part C, the question of the guarding role beyond the proposer\'s that Me is in, its persons filled in from the binding C names, with the role of the proposer, asked(G, Words); none, asked(0, []), where Me is in none or the contract puts none (vGLP, Section 6.2, "The words a platform shows"; GSC, Section 2, its first paragraph).',
        'procedure sentence_of(Class?, Peer?, Asked).'|Lsn1?], [], L).
%% A tab is tab(Name, P), or tab(Name, P, counted) where the contract adds or deletes the predicate P with a multiplicity, so that each atom it lists is shown with its count (vGLP 40f8444, Section 5.4, "The contract's words": "The tab lists the atoms of that predicate in the state, each with its count where the contract adds or deletes the predicate with a multiplicity, the view carrying the whole state").
procedure tab_terms(PLists?, Preds?, Preds?, Strings).
tab_terms([], _, _, []).
tab_terms([list(N, Ws)|Ls], Pr, Mp, [T?|Ts?]) :- ground(N?), ground(Ws?), ground(Pr?), ground(Mp?) |
    listed_preds(Ws?, Pr?, Ms),
    first_pred(Ms?, P),
    tab_term(N?, P?, Mp?, T),
    tab_terms(Ls?, Pr?, Mp?, Ts).
procedure tab_term(String?, Constant?, Preds?, String).
tab_term(N, P, Mp, T?) :- ground(P?), ground(Mp?) |
    mem(P?, Mp?, C),
    tab_term1(C?, N?, P?, T).
procedure tab_term1(YesNo?, String?, Constant?, String).
tab_term1(yes, N, P, T?) :- term_to_string(P?, Pt), call_text(tab, [N?, Pt?, counted], T).
tab_term1(no, N, P, T?) :- term_to_string(P?, Pt), call_text(tab, [N?, Pt?], T).
%% The predicates the contract adds or deletes with a multiplicity, times(K, A) in an atom list it adds or deletes at a role.
procedure mult_preds(Contract?, Preds).
mult_preds(C, Ps?) :- ground(C?) |
    contract_changes(C?, As),
    times_names(As?, Ns),
    dedup(Ns?, Ps).
procedure contract_changes(Contract?, Atoms).
contract_changes([], []).
contract_changes([schema(_, _, Rs)|Ss], As?) :- rs_changes(Rs?, A1), contract_changes(Ss?, A2), app(A1?, A2?, As).
contract_changes([cschema(_, _, _, Rs)|Ss], As?) :- rs_changes(Rs?, A1), contract_changes(Ss?, A2), app(A1?, A2?, As).
contract_changes([nschema(_, _, _, Rs)|Ss], As?) :- rs_changes(Rs?, A1), contract_changes(Ss?, A2), app(A1?, A2?, As).
procedure rs_changes(RoleSpecs?, Atoms).
rs_changes([], []).
rs_changes([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M, _, _),
    rs_changes(Rs?, A3),
    app(M?, A3?, A2),
    app(P?, A2?, As).
procedure times_names(Atoms?, Preds).
times_names([], []).
times_names([times(_, atom(F, _))|As], [F?|Ns?]) :- times_names(As?, Ns).
times_names([_|As], Ns?) :- otherwise | times_names(As?, Ns).
procedure first_pred(Preds?, Constant).
first_pred([P|_], P?).
first_pred([], none).
procedure sentence_lines(PActs?, Contract?, Lines).
sentence_lines([], _, []).
sentence_lines([act(_, _, _, none, _, _)|As], C, L?) :- sentence_lines(As?, C?, L).
sentence_lines([act(N, _, Fs, said(Ws), _, By)|As], C, L?) :- ground(N?), ground(Ws?), ground(Fs?), ground(By?), ground(C?) |
    schema_sentences([N?], Ws?, Fs?, By?, C?, L1),
    sentence_lines(As?, C?, L2),
    lapp(L1?, L2?, L).
procedure schema_sentences(Preds?, PSentences?, Strings?, Proposer?, Contract?, Lines).
schema_sentences([], _, _, _, _, []).
schema_sentences([S|Ss], Ws, Fs, By, C, L?) :- ground(S?), ground(Ws?), ground(Fs?), ground(By?), ground(C?) |
    find_schema(S?, C?, Sf),
    schema_sentence(Sf?, S?, Ws?, Fs?, By?, L1),
    schema_sentences(Ss?, Ws?, Fs?, By?, C?, L2),
    lapp(L1?, L2?, L).
%% sentence_of(s(V1, _, V3), Me, Ws?) :- ground(V1?), ground(V3?), ground(Me?) | said([V1?, V3?], Me?, [person(V1?), text(...), person(V3?), ...], Ws), each person the sentence names at the place of its class term that holds it, every other place _.
procedure schema_sentence(SFound?, Constant?, PSentences?, Strings?, Proposer?, Lines).
schema_sentence(nosfound, _, _, _, _, []).
schema_sentence(sfound(Hd, Rs), S, Ws, Fs, By, L?) :- ground(Hd?), ground(Rs?) |
    guard_count(Rs?, N),
    schema_sentence0(N?, Hd?, Rs?, S?, Ws?, Fs?, By?, L).
%% An act with one guarding role puts its question to no other person: it is text of its request form (text_entry), and no sentence_of clause is printed for it (vGLP, Section 5.4, "The contract's words").
procedure schema_sentence0(Integer?, Args?, RoleSpecs?, Constant?, PSentences?, Strings?, Proposer?, Lines).
schema_sentence0(1, _, _, _, _, _, _, []).
schema_sentence0(N, Hd, Rs, S, Qs, Fs, By, L?) :- N? =\= 1, ground(Hd?), ground(Rs?), ground(Qs?), ground(By?) |
    guard_roles(Rs?, 1, Gr),
    guard_roles(Rs?, 1, Gr1),
    proposer_roles(By?, Gr1?, Pr),
    count_questions(Qs?, NQ),
    asked_roles(NQ?, Gr?, Ga0),
    drop_unasked(Ga0?, Qs?, Ga, Qs1),
    person_places(Hd?, Rs?, Pp),
    schema_vars(Rs?, Hd?, Vs),
    value_field_places(Hd?, Rs?, Fq),
    schema_sentence1(Ga?, Qs1?, Pp?, Vs?, S?, Fs?, Fq?, Pr?, L).
%% The proposer's question, [], in a pragma that names the proposer, none being put to the proposer, and its role left out (pragmas.sh).
procedure drop_unasked(Ints?, PSentences?, Ints, PSentences).
drop_unasked([], _, [], []).
drop_unasked([_|_], [], [], []).
drop_unasked([_|Gs], [[]|Qs], Gs1?, Qs1?) :- drop_unasked(Gs?, Qs?, Gs1, Qs1).
drop_unasked([G|Gs], [[W|Ws]|Qs], [G?|Gs1?], [[W?|Ws?]|Qs1?]) :- drop_unasked(Gs?, Qs?, Gs1, Qs1).
%% The guarding roles a line's questions are put to: its one question to each guarding role beyond the first; its questions, one per guarding role, each to its own, in the order of the roles (vGLP 21fca00, Section 5.4, "The contract's words": "a line's questions are one per guarding role of the widest schema of its clause, in the order of the roles, none left out, since any guard may propose"), pragmas.sh having given each schema a line covers the questions of its own guarding roles.
procedure asked_roles(Integer?, Ints?, Ints).
asked_roles(1, Gr, Ga?) :- rest_ints(Gr?, Ga).
asked_roles(NQ, Gr, Gr?) :- NQ? =\= 1 | true.
%% The indices of the guarding roles, in order, from J.
procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([R|Rs], J, Gs?) :- ground(R?), integer(J?) |
    rs_guarded(R?, B),
    J1 := J? + 1,
    guard_roles(Rs?, J1?, Gs1),
    keep_int(B?, J?, Gs1?, Gs).
procedure rest_ints(Ints?, Ints).
rest_ints([], []).
rest_ints([_|Is], Is?).
%% sentence_of(s(V1, V2, _), Me, Ws?) :- ground(V1?), ground(V2?), ground(Me?) | ask_of([q(V2?, [person(V1?), text(...)]), ...], Me?, Ws): the question of each guarding role beyond the proposer's, the first, in their order, q(R, Words), R the person in that role, each person the question names at the place of the class term that holds it, every other place _; ask_of gives the words of the first whose role holds Me, and [] where none does (GSC, Section 2, its first paragraph: "for each role whose will the act needs beyond the proposer's, in their order, the question the person in it is asked").
%% Each question names the role of the proposer, q(R, G, Words), the first of the roles at which the act is proposed other than R's, whose atoms the question shows (vGLP e22e2ad, Section 5.4, "The contract's words"; question_words in the shared text).
%% After its sentence, a question shows each value of the binding it does not name, a person or a number, by the name of its field, named(F, P) or valued(F, K) (vGLP 110caf4, Section 5.4, "The contract's words": "and shows after it each value of the binding the question does not name, by the name of its field, so that the person sees the whole proposal"); a place no field of the pragma names is not shown.
procedure schema_sentence1(Ints?, PSentences?, Ints?, Args?, Constant?, Strings?, Ints?, Ints?, Lines).
schema_sentence1(Gr, Qs, Pp, Vs, S, Fs, Fq, Pr, [T?, ':-'|L?]) :- ground(Gr?), ground(Qs?), ground(Pp?), ground(Vs?), ground(S?), ground(Fs?), ground(Fq?), ground(Pr?) |
    spread_questions(Gr?, Qs?, Q1),
    spread_questions(Gr?, Qs?, Q2),
    question_places(Gr?, Q1?, Pp?, Ns0),
    schema_sentence1b(Ns0?, Gr?, Q2?, Pp?, Vs?, S?, Fs?, Fq?, Pr?, T, L).
procedure schema_sentence1b(Ints?, Ints?, PSentences?, Ints?, Args?, Constant?, Strings?, Ints?, Ints?, String, Lines).
schema_sentence1b(Ns0, Gr, Qs, Pp, Vs, S, Fs, Fq, Pr, T?, L?) :- ground(Ns0?), ground(Vs?), ground(Fs?), ground(Fq?) |
    value_places(Fq?, Fs?, Ns0?, Vs?, Vp),
    schema_sentence1c(Vp?, Ns0?, Gr?, Qs?, Pp?, Vs?, S?, Pr?, T, L).
procedure schema_sentence1c(VPlaces?, Ints?, Ints?, PSentences?, Ints?, Args?, Constant?, Ints?, String, Lines).
schema_sentence1c(Vp, Ns0, Gr, Qs, Pp, Vs, S, Pr, T?, L?) :- ground(Vp?) |
    vplace_ints(Vp?, Vi),
    app(Ns0?, Vi?, Ns1),
    dedup(Ns1?, Ns),
    value_words(Vp?, Vw),
    question_terms(Gr?, Qs?, Pp?, Vw?, Pr?, Qt),
    schema_sentence2(Ns?, Vs?, S?, Qt?, T, L).
%% The clause's one question put to each guarding role other than the proposer's (vGLP 932c710, Section 5.4, "The contract's words": "a question into the approval question that Start raises at each guarding role other than the proposer's"; vGLP #20, Code_inbox.md, 2026-10-24 09:21 UTC: "the principal is asked the same question as the agent"): a line with one question gives it to each of those roles; a line with one for each, in their order, gives each its own (GSC, Section 2, its first paragraph).
procedure spread_questions(Ints?, PSentences?, PSentences).
spread_questions(Gr, [Q], Qs?) :- ground(Gr?), ground(Q?) | spread1(Gr?, Q?, Qs).
spread_questions(_, Qs, Qs?) :- otherwise | true.
procedure spread1(Ints?, PWords?, PSentences).
spread1([], _, []).
spread1([_|Gs], Q, [Q?|Qs?]) :- ground(Q?) | spread1(Gs?, Q?, Qs).
procedure question_places(Ints?, PSentences?, Ints?, Ints).
question_places([], _, _, []).
question_places([_|_], [], _, []).
question_places([G|Gs], [Q|Qs], Pp, Ns?) :- integer(G?), ground(Q?), ground(Pp?) |
    said_places(Q?, Pp?, N1),
    question_places(Gs?, Qs?, Pp?, N2),
    app([G?|N1?], N2?, Ns).
procedure question_terms(Ints?, PSentences?, Ints?, Strings?, Ints?, Strings).
question_terms([], _, _, _, _, []).
question_terms([_|_], [], _, _, _, []).
question_terms([G|Gs], [Q|Qs], Pp, Vw, Pr, [T?|Ts?]) :- integer(G?), ground(Q?), ground(Pp?), ground(Vw?), ground(Pr?) |
    vname(G?, F),
    name_of(F?, _, R),
    said_words(Q?, Pp?, Sw0),
    sapp(Sw0?, Vw?, Sw),
    list_text(Sw?, Sl),
    first_other(Pr?, G?, Pg),
    term_to_string(Pg?, Pt),
    call_text(q, [R?, Pt?, Sl?], T),
    question_terms(Gs?, Qs?, Pp?, Vw?, Pr?, Ts).
%% The first of the roles Pr other than G; 0, no proposer's atoms shown, where there is none.
procedure first_other(Ints?, Integer?, Integer).
first_other([], _, 0).
first_other([P|_], G, P?) :- integer(P?), integer(G?), P? =\= G? | true.
first_other([P|Ps], G, R?) :- integer(P?), integer(G?), P? =:= G? | first_other(Ps?, G?, R).
%% The places of the class term the pragma's fields name, the k-th field the k-th of them, in the order field_places counts them, the peer of an acquaintance schema first and then the variables of the head a person fills, but numbered as the class term's places, its roles then its head, as the question's places are (said_places).
procedure value_field_places(Args?, RoleSpecs?, Ints).
value_field_places(Hd, Rs, Fq?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    field_places2(Vs?, 1, Lis?, Fq).
%% The places the pragma's fields name that the question does not name, each with the name of its field and the kind of its value: vp(I, F, named) of a person, vp(I, F, valued) of a number; a field left empty, as an inapplicable field of a schema that shares its button, names no place.
procedure value_places(Ints?, Strings?, Ints?, Args?, VPlaces).
value_places([], _, _, _, []).
value_places([_|_], [], _, _, []).
value_places([I|Is], [F|Fs], Ns, Vs, Vp?) :- integer(I?), ground(F?), ground(Ns?), ground(Vs?) |
    mem(I?, Ns?, In),
    nth_arg(I?, Vs?, A),
    value_kind(A?, K),
    value_place(In?, K?, field(F?), I?, Vp1),
    value_places(Is?, Fs?, Ns?, Vs?, Vp2),
    app(Vp1?, Vp2?, Vp).
procedure value_kind(Arg?, Constant).
value_kind(role(_), named).
value_kind(pvar(_), named).
value_kind(num(_), valued).
value_kind(_, none) :- otherwise | true.
procedure value_place(YesNo?, Constant?, FieldAt?, Integer?, VPlaces).
value_place(yes, _, _, _, []).
value_place(no, _, nofield, _, []).
value_place(no, none, field(_), _, []).
value_place(no, named, field(F), I, Vp?) :- ground(F?) | nonempty_field(F?, named, I?, Vp).
value_place(no, valued, field(F), I, Vp?) :- ground(F?) | nonempty_field(F?, valued, I?, Vp).
procedure nonempty_field(String?, Constant?, Integer?, VPlaces).
nonempty_field(F, _, _, []) :- ground(F?), F? =?= '""' | true.
nonempty_field(F, K, I, [vp(I?, F?, K?)]) :- otherwise | true.
procedure vplace_ints(VPlaces?, Ints).
vplace_ints([], []).
vplace_ints([vp(I, _, _)|Vs], [I?|Is?]) :- vplace_ints(Vs?, Is).
procedure value_words(VPlaces?, Strings).
value_words([], []).
value_words([vp(I, F, K)|Vs], [W?|Ws?]) :- integer(I?), ground(F?), ground(K?) |
    vname(I?, N),
    name_of(N?, _, Q),
    named_call(K?, [F?, Q?], W),
    value_words(Vs?, Ws).
procedure schema_sentence2(Ints?, Args?, Constant?, Strings?, String, Lines).
schema_sentence2(Ns, Vs, S, Qt, T?, L?) :- ground(Ns?), ground(Vs?), ground(S?), ground(Qt?) |
    head_names(Vs?, 1, Ns?, Hn),
    named_call(S?, Hn?, Cl),
    call_text(sentence_of, [Cl?, 'Me', 'Ws?'], T),
    guard_lines(Ns?, Lg),
    list_text(Qt?, Ql),
    call_text(ask_of, [Ql?, 'Me?', 'Ws'], B),
    lapp(Lg?, ['ground(Me?)', '|', B?, '.'], L).
%% The places of the class term a sentence names, in its order.
procedure said_places(PWords?, Ints?, Ints).
said_places([], _, []).
said_places([text(_)|Ws], Pp, Ns?) :- said_places(Ws?, Pp?, Ns).
said_places([person(K)|Ws], Pp, [I?|Ns?]) :- ground(Pp?) | nth_int(K?, Pp?, I), said_places(Ws?, Pp?, Ns).
procedure nth_int(Integer?, Ints?, Integer).
nth_int(1, [I|_], I?).
nth_int(K, [_|Is], I?) :- K? > 1 | K1 := K? - 1, nth_int(K1?, Is?, I).
nth_int(_, [], 0).
%% The class term's arguments: V_i at a place i the sentence names, _ elsewhere.
procedure head_names(Args?, Integer?, Ints?, Strings).
head_names([], _, _, []).
head_names([_|Vs], I, Ns, [X?|Xs?]) :- integer(I?), ground(Ns?) |
    mem(I?, Ns?, In),
    vname(I?, F),
    head_name(In?, F?, X),
    I1 := I? + 1,
    head_names(Vs?, I1?, Ns?, Xs).
procedure head_name(YesNo?, Found?, String).
head_name(yes, named(N, _), N?).
head_name(yes, unnamed, unnamed).
head_name(no, _, '_').
procedure guard_lines(Ints?, Lines).
guard_lines([], []).
guard_lines([I|Is], [G?, ','|L?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, _, Q),
    call_text(ground, [Q?], G),
    guard_lines(Is?, L).
procedure place_reads(Ints?, Strings).
place_reads([], []).
place_reads([I|Is], [Q?|Qs?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, _, Q),
    place_reads(Is?, Qs).
procedure said_words(PWords?, Ints?, Strings).
said_words([], _, []).
said_words([text(S)|Ws], Pp, [X?|Xs?]) :- call_text(text, [S?], X), said_words(Ws?, Pp?, Xs).
said_words([person(K)|Ws], Pp, [X?|Xs?]) :- ground(Pp?) |
    nth_int(K?, Pp?, I),
    vname(I?, F),
    name_of(F?, _, Q),
    call_text(person, [Q?], X),
    said_words(Ws?, Pp?, Xs).

%% --- Acquaintance --------------------------------------------------------------
%% The acquaintance schemas, whose parts are the acquaintance parts of the compilation (vGLP, Section 5.4, "The compilation": "The compilation is given, with the specification, its acquaintance parts: guarded parts with two guards and no opener by which two agents come to know each other, for a contract the parts of an acquaintance schema, one with two roles, both guarding, that requires at neither role an atom naming the other, as GKK's meet"): a schema of two party roles, each guarding, whose atoms required or deleted at each role name neither the other role nor a name term built on it.  meeting_peer(N, Me, P), printed where the request type proposes a schema: P the peer a request name N of an acquaintance part names beside the agent Me, peer(Q), the person in its other role, where Me is in one of its two roles and another person in the other; nopeer otherwise, and for every other request name.
procedure meeting_lines(Contract?, Preds?, Lines).
meeting_lines(_, [], []).
meeting_lines(C, [P|Ps], L?) :- ground(C?), ground(P?), ground(Ps?) |
    meeting_clauses(C?, [P?|Ps?], Lc),
    lapp(Lc?, ['meeting_peer(_, _, nopeer) :- otherwise | true.'], Lc1),
    lapp(['',
        '%% The peer a request name N of an acquaintance part names beside the agent Me, peer(Q), or none, nopeer: the acquaintance schemas, each of two roles, both guarding, that requires at neither role an atom naming the other (vGLP, Section 5.4, "The compilation").',
        'procedure meeting_peer(Proposal?, Peer?, MeetPeer).'|Lc1?], [], L).
procedure meeting_clauses(Contract?, Preds?, Lines).
meeting_clauses([], _, []).
meeting_clauses([schema(S, Hd, Rs)|Ss], Ps, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?) |
    mem(S?, Ps?, In),
    meeting_schema(Rs?, M),
    and(In?, M?, B),
    meeting_clause(B?, S?, Hd?, Rs?, L1),
    meeting_clauses(Ss?, Ps?, L2),
    lapp(L1?, L2?, L).
meeting_clauses([cschema(_, _, _, _)|Ss], Ps, L?) :- meeting_clauses(Ss?, Ps?, L).
meeting_clauses([nschema(_, _, _, _)|Ss], Ps, L?) :- meeting_clauses(Ss?, Ps?, L).
%% Whether a schema is an acquaintance schema: two party roles, both guarding, and the atoms each requires or deletes naming not the other.
procedure meeting_schema(RoleSpecs?, YesNo).
meeting_schema([rs(G1, _, D1, K1, _), rs(G2, _, D2, K2, _)], B?) :-
    ground(G1?), ground(D1?), ground(K1?), ground(G2?), ground(D2?), ground(K2?) |
    guarding(G1?, B1),
    guarding(G2?, B2),
    uncleared(D1?, U1),
    uncleared(D2?, U2),
    app(K1?, U1?, R1),
    app(K2?, U2?, R2),
    names_role(R1?, 2, N1),
    names_role(R2?, 1, N2),
    or(N1?, N2?, N),
    neg(N?, B3),
    and(B1?, B2?, B12),
    and(B12?, B3?, B).
meeting_schema(_, no) :- otherwise | true.
procedure guarding(Guard?, YesNo).
guarding(guarded, yes).
guarding(guarded_at(_), yes).
guarding(unguarded, no).
%% Whether an atom of the list names the role J: an argument role(J), a name term built on it, or a speech act signed by its person.
procedure names_role(Atoms?, Integer?, YesNo).
names_role(As, J, B?) :- ground(As?) |
    atoms_args(As?, Xs),
    args_name(Xs?, J?, B).
procedure args_name(Args?, Integer?, YesNo).
args_name([], _, no).
args_name([X|Xs], J, B?) :- ground(X?), integer(J?) |
    arg_names(X?, J?, B1),
    args_name1(B1?, Xs?, J?, B).
procedure args_name1(YesNo?, Args?, Integer?, YesNo).
args_name1(yes, _, _, yes).
args_name1(no, Xs, J, B?) :- args_name(Xs?, J?, B).
procedure arg_names(Arg?, Integer?, YesNo).
arg_names(role(I), J, yes) :- I? =:= J? | true.
arg_names(nterm(T), J, B?) :- nt_names(T?, J?, B).
arg_names(sgn(_, I), J, yes) :- I? =:= J? | true.
arg_names(_, _, no) :- otherwise | true.
procedure nt_names(NameTerm?, Integer?, YesNo).
nt_names(own(I), J, yes) :- I? =:= J? | true.
nt_names(ext(T, _), J, B?) :- nt_names(T?, J?, B).
nt_names(ext_any(T), J, B?) :- nt_names(T?, J?, B).
nt_names(_, _, no) :- otherwise | true.
%% meeting_peer(S(V1, V2, _, ...), Me, P?) :- ground(V1?), ground(V2?), ground(Me?) | meet_other(V1?, V2?, Me?, P): the two roles at the first two places of the request name, its head beginning with its roles.
procedure meeting_clause(YesNo?, Constant?, Args?, RoleSpecs?, Lines).
meeting_clause(no, _, _, _, []).
meeting_clause(yes, S, Hd, Rs, [T?, ':-', 'ground(V1?)', ',', 'ground(V2?)', ',', 'ground(Me?)', '|', 'meet_other(V1?, V2?, Me?, P)', '.']) :-
    ground(S?), ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    head_names(Vs?, 1, [1, 2], Hn),
    named_call(S?, Hn?, Cl),
    call_text(meeting_peer, [Cl?, 'Me', 'P?'], T).

%% Lines are strings, each printed on a line of its own.
procedure lapp(Lines?, Lines?, Lines).
lapp([], Ys, Ys?).
lapp([X|Xs], Ys, [X?|Zs?]) :- lapp(Xs?, Ys?, Zs).
procedure sapp(Strings?, Strings?, Strings).
sapp([], Ys, Ys?).
sapp([X|Xs], Ys, [X?|Zs?]) :- sapp(Xs?, Ys?, Zs).
