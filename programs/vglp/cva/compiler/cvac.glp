%% cvac.glp --- compile(Name, Contract, Verdict): the canonical CVA platform of
%% an act-schema contract, printed as a .vglp module (vGLP, Section 3.2,
%% Definition "Canonical CVA Platform"; Section 5.4, Definition "Compilation of
%% the Canonical Platform" and the paragraph "Act schemas"; self.glp says more).
%%
%% A contract is compiled when programs/gsc finds it syntactically
%% grassroots, grassroots with wards, or finds no fault in it but its
%% introductory acts, so with traceable provenance and volition
%% (verdict_lines below), every role a party role, and when it is a local and
%% effective specification with simple guards, by the paragraph on act schemas
%% and the sentence after it and by Definition "Volition-Guarded
%% Specification, Participants, Guard Sets, Simple Guards", which local.glp
%% decides.  Otherwise it prints the lines saying why and nothing else.  A
%% signed term sgn(y, i) in an added atom is the speech act bound to y, signed
%% by the person in role i (vGLP, Section 5.4, "Act schemas as local
%% specifications"; GSC, Definition "Act schema"): local.glp decides the
%% contract over it and the printed text, text.glp, computes it.
%%
%% The module is the contract's own part, printed here, and the text every
%% contract shares, text.glp.  The contract's part is the type Class, one
%% alternative per schema, the schema's name applied to the people in its roles,
%% then its party variables, then its speech-act variables, in programs/gsc's
%% order; the request type, Request, with the alternative propose([t]) for each
%% guarded class [t], a term of Proposal, the alternatives of the schemas whose
%% terms name guarded classes, and the alternative known(Peer) (vGLP, Section
%% 5.4, the compilation); the contract itself, as the term programs/gsc reads, from which the
%% shared text computes the classes; its reflexive predicates; and per schema a
%% clause taking a term of Class to the binding it names, binding_of, and one
%% taking a binding back to the term, class_of.  GLP has no string
%% concatenation, so a line naming the contract or a schema is printed as a
%% term, the printer writing a term on a line of its own, as
%% programs/sglp/transform.glp prints a clause's head; a source variable is a
%% constant whose name is the variable's, V1, V1?, from vname/3.

Line  ::= String ; guarded_only(String).
Lines ::= [] ; [Line | Lines].
imported procedure text#fixed_text(Lines).
imported procedure local#faults(Contract?, Preds?, Stream(_)).
imported procedure local#proposable(Contract?, Preds?, Preds).

Found ::= named(Constant, Constant) ; unnamed.

exported procedure compile(Constant?, Declared?, Verdict?).
compile(Nm, D, V) :- compile_intro(Nm?, D?, V?, no_introduction).
%% compile(Name, Contract, Verdict, Intro): the same, for a contract naming
%% an introduction predicate e, introduction(e), whose introduction rule the
%% platform's agents follow (vGLP, Section 3.2, Definition "Introduction Rule,
%% Introduce Peers"; Section 5.4, the paragraph on act schemas), or none,
%% no_introduction.
exported procedure compile(Constant?, Declared?, Verdict?, Intro?).
compile(Nm, D, V, I) :- compile_intro(Nm?, D?, V?, I?).
procedure compile_intro(Constant?, Declared?, Verdict?, Intro?).
compile_intro(Nm, D, V, I) :- ground(D?), ground(I?) |
    decl_schemas(D?, C),
    decl_reflexive(D?, Rf),
    intro_preds(I?, E),
    compile0(Nm?, C?, Rf?, E?, V?).
procedure intro_preds(Intro?, Preds).
intro_preds(no_introduction, []).
intro_preds(introduction(P), [P?]).
procedure compile0(Constant?, Contract?, Preds?, Preds?, Verdict?).
compile0(Nm, C, Rf, E, V) :- ground(Nm?), ground(C?) |
    verdict_lines(V?, Nm?, L1),
    community_lines(C?, Nm?, L2),
    lapp(L1?, L2?, L),
    compile1(L?, Nm?, C?, Rf?, E?).

procedure compile1(Stream(_)?, Constant?, Contract?, Preds?, Preds?).
compile1([], Nm, C, Rf, E) :- ground(C?) |
    names_lines(C?, Nm?, L1),
    compile2(L1?, Nm?, C?, Rf?, E?).
compile1([L|Ls], _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

procedure compile2(Stream(_)?, Constant?, Contract?, Preds?, Preds?).
compile2([], Nm, C, Rf, E) :- ground(C?), ground(Rf?) |
    local # faults(C?, Rf?, Fs),
    compile3(Fs?, Nm?, C?, Rf?, E?).
compile2([L|Ls], _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

procedure compile3(Stream(_)?, Constant?, Contract?, Preds?, Preds?).
compile3([], Nm, C, Rf, E) :-
    module_lines(Nm?, C?, Rf?, E?, Ls),
    send_to_user(['%% compile begin'|Ls?]).
compile3([F|Fs], Nm, _, _, _) :- ground(Nm?) |
    H =.. ['%% not compiled', Nm?],
    send_to_user(['%% compile begin', H?, F?|Fs1?]),
    lapp(Fs?, ['%% compile end'], Fs1).

%% --- The contract compiled ------------------------------------------------
procedure decl_schemas(Declared?, Contract).
decl_schemas([], []).
decl_schemas([S|Ss], [S?|Ss?]).
decl_schemas(reflexive(_, C), C?).
procedure decl_reflexive(Declared?, Preds).
decl_reflexive([], []).
decl_reflexive([_|_], []).
decl_reflexive(reflexive(Rf, _), Rf?).

%% vGLP, Section 5.4, the paragraph on act schemas, asks of a contract that it
%% be a local and effective specification with simple guards, and nothing of
%% its being grassroots; its schemas compile to transactions by the
%% realisation, which CSSN (Appendix B.4) takes for a contract with traceable
%% provenance that satisfies volition by the definition GSC gives for a
%% syntactically grassroots one.  So a contract is compiled where GSC's
%% checker certifies it syntactically grassroots, or grassroots with wards
%% (GSC, Appendix F: its introductory act unobstructed but for the marks, with
%% their guardianships and relay acts; vGLP #14, 2026-10-18 12:24 UTC, A), or
%% finds no fault in it but its introductory acts (vGLP 2026-10-16 13:53 UTC,
%% C, as Code #9 gives it: "the compiler takes a contract with traceable
%% provenance and volition"); a contract with community roles has no
%% canonical platform here, its roles' extents being no participants of a
%% binding.
procedure verdict_lines(Verdict?, Constant?, Stream(_)).
verdict_lines(syntactically_grassroots, _, []).
verdict_lines(grassroots_with_wards(_, _, _, _), _, []).
verdict_lines(not_grassroots(Fs), Nm, L?) :- ground(Fs?), ground(Nm?) |
    realisable(Fs?, B),
    realisable_lines(B?, Nm?, L).
verdict_lines(malformed(_), Nm, [H?, '%% it is malformed; check_named in programs/gsc gives the faults.']) :-
    ground(Nm?) | H =.. ['%% not compiled', Nm?].
verdict_lines(conditions_met, Nm, [H?, '%% it has community roles, which the canonical platform of vGLP Section 3.2 does not take.']) :-
    ground(Nm?) | H =.. ['%% not compiled', Nm?].
verdict_lines(conditions_failed(_), Nm, [H?, '%% it has community roles, which the canonical platform of vGLP Section 3.2 does not take.']) :-
    ground(Nm?) | H =.. ['%% not compiled', Nm?].
procedure realisable(Faults?, YesNo).
realisable([], yes).
realisable([no_introductory_act|Fs], B?) :- realisable(Fs?, B).
realisable([obstructed(_, _, _, _)|Fs], B?) :- realisable(Fs?, B).
realisable([untraceable(_)|_], no).
realisable([volition(_, _, _)|_], no).
realisable([cohesion(_, _, _)|_], no).
realisable([reflexive(_, _, _)|_], no).
realisable([signed(_, _, _, _)|_], no).
procedure realisable_lines(YesNo?, Constant?, Stream(_)).
realisable_lines(yes, _, []).
realisable_lines(no, Nm, [H?, '%% it lacks traceable provenance or volition, or is otherwise faulty; check_named in programs/gsc gives the faults.']) :-
    ground(Nm?) | H =.. ['%% not compiled', Nm?].

procedure community_lines(Contract?, Constant?, Stream(_)).
community_lines(C, Nm, L?) :- ground(Nm?) |
    has_community(C?, B),
    community_lines1(B?, Nm?, L).
procedure community_lines1(YesNo?, Constant?, Stream(_)).
community_lines1(no, _, []).
community_lines1(yes, Nm, [H?, '%% it has community roles, which the canonical platform of vGLP Section 3.2 does not take.']) :-
    ground(Nm?) | H =.. ['%% not compiled', Nm?].
procedure has_community(Contract?, YesNo).
has_community([], no).
has_community([schema(_, Rs)|Ss], B?) :- roles_community(Rs?, B1), has_community1(B1?, Ss?, B).
has_community([cschema(_, _, _)|_], yes).
procedure has_community1(YesNo?, Contract?, YesNo).
has_community1(yes, _, yes).
has_community1(no, Ss, B?) :- has_community(Ss?, B).
procedure roles_community(RoleSpecs?, YesNo).
roles_community([], no).
roles_community([rs(_, _, _, _, _)|Rs], B?) :- roles_community(Rs?, B).
roles_community([crs(_, _, _, _, _, _)|_], yes).

%% A schema's variables are named V1, V2, ... in the printed clauses; there are
%% as many names as vname/3 has.
procedure names_lines(Contract?, Constant?, Stream(_)).
names_lines([], _, []).
names_lines([schema(S, Rs)|Ss], Nm, L?) :- ground(S?), ground(Rs?), ground(Nm?) |
    schema_vars(Rs?, Vs),
    count_args(Vs?, N),
    vname(N?, F),
    names_lines1(F?, S?, Ss?, Nm?, L).
names_lines([cschema(_, _, _)|Ss], Nm, L?) :- names_lines(Ss?, Nm?, L).
procedure names_lines1(Found?, Constant?, Contract?, Constant?, Stream(_)).
names_lines1(named(_, _), _, Ss, Nm, L?) :- names_lines(Ss?, Nm?, L).
names_lines1(unnamed, S, _, Nm, [H?, H2?]) :- ground(Nm?), ground(S?) |
    H =.. ['%% not compiled', Nm?],
    H2 =.. ['%% the compiler names the variables of no schema with this many, at', S?].
procedure count_args(Args?, Integer).
count_args([], 0).
count_args([_|As], N?) :- count_args(As?, M), N := M? + 1.

%% --- The module ------------------------------------------------------------
procedure module_lines(Constant?, Contract?, Preds?, Preds?, Stream(_)).
module_lines(Nm, C, Rf, E, Ls?) :- ground(Nm?), ground(C?), ground(Rf?), ground(E?) |
    H =.. ['%% the canonical CVA platform of the contract', Nm?],
    class_lines(C?, L1),
    local # proposable(C?, Rf?, Ps),
    text # fixed_text(Fx),
    request_parts(C?, Ps?, Fx?, Lr, Fx1),
    T1 =.. [contract_schemas, C?],
    T2 =.. [reflexive_preds, Rf?],
    T3 =.. [introduction_preds, E?],
    binding_lines(C?, L2),
    class_of_lines(C?, L3),
    lapp(L3?, [''|Fx1?], L3x),
    lapp(L2?, ['',
        'procedure class_of(Constant?, Binding?, Peer?, Class).'|L3x?], L2x),
    lapp(L1?, Lr1?, L1x),
    lapp(Lr?, ['',
        'procedure contract_schemas(Schemas).',
        T1?,
        '.',
        '',
        'procedure reflexive_preds(Preds).',
        T2?,
        '.',
        '',
        'procedure introduction_preds(Preds).',
        T3?,
        '.',
        '',
        'procedure binding_of(Class?, Constant, Binding).'|L2x?], Lr1),
    lapp(['%% Printed by programs/vglp/cva/compiler from the contract named below, in the',
         '%% term form programs/gsc reads (GSC, Sections 3 and 5): the canonical CVA',
         '%% platform of the contract (vGLP, Section 3.2, Definition "Canonical CVA',
         '%% Platform"), two-phase commit coordinated by the initiating agent, compiled',
         '%% into vGLP by Definition "Compilation of the Canonical Platform" (Section',
         '%% 5.4).  Edit the contract or the compiler and run',
         '%% programs/vglp/cva/compile.sh, not this file.',
         H?,
         '',
         '%% ===========================================================================',
         '%% The contract',
         '%% ===========================================================================',
         '',
         'Class ::='|L1x?], ['%% compile end'], Ls).

%% Class ::= the schemas' alternatives, separated by ;.
procedure class_lines(Contract?, Stream(_)).
class_lines([], ['.']).
class_lines([schema(S, Rs)|Ss], [A?|L?]) :- ground(S?), ground(Rs?) |
    schema_vars(Rs?, Vs),
    var_types(Vs?, Ts),
    A =.. [S?|Ts?],
    class_lines1(Ss?, L).
class_lines([cschema(_, _, _)|Ss], L?) :- class_lines(Ss?, L).
procedure class_lines1(Contract?, Stream(_)).
class_lines1([], ['.']).
class_lines1([S|Ss], [';'|L?]) :- class_lines([S?|Ss?], L).
procedure var_types(Args?, Stream(_)).
var_types([], []).
var_types([role(_)|Vs], ['Peer'|Ts?]) :- var_types(Vs?, Ts).
var_types([pvar(_)|Vs], ['Peer'|Ts?]) :- var_types(Vs?, Ts).
var_types([svar(_)|Vs], ['Speech'|Ts?]) :- var_types(Vs?, Ts).
var_types([nterm(_)|Vs], ['Peer'|Ts?]) :- var_types(Vs?, Ts).
%% A signed term is no variable of a schema (schema_vars); the clause covers
%% the type.
var_types([sgn(_, _)|Vs], Ts?) :- var_types(Vs?, Ts).

%% The request type: Proposal ::= the alternatives of the schemas whose terms
%% name guarded classes (local.glp, proposable), separated by ;, and Request
%% ::= propose(Proposal) ; known(Peer); where there are none, Request ::=
%% known(Peer) alone, and the shared text's lines guarded_only(L), its clauses
%% on the request propose([t]), are not printed.
procedure request_parts(Contract?, Preds?, Lines?, Stream(_), Stream(_)).
request_parts(C, Ps, Fx, Lr?, Fx1?) :- ground(C?), ground(Ps?) |
    proposal_alts(C?, Ps?, As),
    request_lines(As?, Lr),
    any_name(Ps?, G),
    shared_lines(Fx?, G?, Fx1).
procedure proposal_alts(Contract?, Preds?, Stream(_)).
proposal_alts([], _, []).
proposal_alts([schema(S, Rs)|Ss], Ps, As?) :- ground(S?), ground(Rs?), ground(Ps?) |
    mem(S?, Ps?, In),
    schema_vars(Rs?, Vs),
    var_types(Vs?, Ts),
    A =.. [S?|Ts?],
    proposal_alts(Ss?, Ps?, As1),
    keep_alt(In?, A?, As1?, As).
proposal_alts([cschema(_, _, _)|Ss], Ps, As?) :- proposal_alts(Ss?, Ps?, As).
procedure keep_alt(YesNo?, _?, Stream(_)?, Stream(_)).
keep_alt(yes, A, As, [A?|As?]).
keep_alt(no, _, As, As?).
procedure request_lines(Stream(_)?, Stream(_)).
request_lines([], ['', 'Request ::= known(Peer).']).
request_lines([A|As], ['', 'Proposal ::=', A?|L?]) :-
    alts_rest(As?, ['', 'Request ::= propose(Proposal) ; known(Peer).'], L).
procedure alts_rest(Stream(_)?, Stream(_)?, Stream(_)).
alts_rest([], Tl, ['.'|Tl?]).
alts_rest([A|As], Tl, [';', A?|L?]) :- alts_rest(As?, Tl?, L).
procedure any_name(Preds?, YesNo).
any_name([], no).
any_name([_|_], yes).
%% The shared text's lines, a line guarded_only(L) printed as L where the
%% contract has a guarded class and left out where it has none.
procedure shared_lines(Lines?, YesNo?, Stream(_)).
shared_lines([], _, []).
shared_lines([guarded_only(L)|Ls], yes, [L?|Ls1?]) :- shared_lines(Ls?, yes, Ls1).
shared_lines([guarded_only(_)|Ls], no, Ls1?) :- shared_lines(Ls?, no, Ls1).
shared_lines([L|Ls], G, [L?|Ls1?]) :- otherwise | shared_lines(Ls?, G?, Ls1).

%% binding_of(s(V1, ..., Vn), s, [b(Var1, p(V1?)), ...]).
procedure binding_lines(Contract?, Stream(_)).
binding_lines([], []).
binding_lines([schema(S, Rs)|Ss], [T?, '.'|L?]) :- ground(Rs?) |
    schema_vars(Rs?, Vs),
    binding_line(S?, Vs?, T),
    binding_lines(Ss?, L).
binding_lines([cschema(_, _, _)|Ss], L?) :- binding_lines(Ss?, L).
procedure binding_line(Constant?, Args?, _).
binding_line(S, Vs, T?) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, _),
    bind_terms(Vs?, 1, Bs),
    Hd =.. [S?|Ns?],
    T =.. [binding_of, Hd?, S?, Bs?].
procedure bind_terms(Args?, Integer?, Stream(_)).
bind_terms([], _, []).
bind_terms([V|Vs], I, [b(V?, W?)|Bs?]) :- ground(V?), integer(I?) |
    vname(I?, F),
    wrapped(V?, F?, W),
    I1 := I? + 1,
    bind_terms(Vs?, I1?, Bs).
procedure wrapped(Arg?, Found?, _).
wrapped(role(_), named(_, Q), p(Q?)).
wrapped(pvar(_), named(_, Q), p(Q?)).
wrapped(svar(_), named(_, Q), s(Q?)).
wrapped(nterm(_), named(_, Q), p(Q?)).
wrapped(_, unnamed, p(unnamed)).
procedure var_names(Args?, Integer?, Stream(_), Stream(_)).
var_names([], _, [], []).
var_names([_|Vs], I, [N?|Ns?], [Q?|Qs?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, N, Q),
    I1 := I? + 1,
    var_names(Vs?, I1?, Ns, Qs).
procedure name_of(Found?, Constant, Constant).
name_of(named(N, Q), N?, Q?).
name_of(unnamed, unnamed, unnamed).

%% class_of(s, B, D, s(V1?, ..., Vn?)) :- ground(B?), ground(D?) |
%%     val_peer(Var1, B?, D?, V1), ... .
procedure class_of_lines(Contract?, Stream(_)).
class_of_lines([], []).
class_of_lines([schema(S, Rs)|Ss], [T?, ':-', 'ground(B?)', ',', 'ground(D?)', '|'|L?]) :-
    ground(Rs?) |
    schema_vars(Rs?, Vs),
    class_of_line(S?, Vs?, T, L1),
    class_of_lines(Ss?, L2),
    lapp(L1?, L2?, L).
class_of_lines([cschema(_, _, _)|Ss], L?) :- class_of_lines(Ss?, L).
procedure class_of_line(Constant?, Args?, _, Stream(_)).
class_of_line(S, Vs, T?, L1?) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, _, Qs),
    Out =.. [S?|Qs?],
    T =.. [class_of, S?, 'B', 'D', Out?],
    val_goals(Vs?, 1, L1).
procedure val_goals(Args?, Integer?, Stream(_)).
val_goals([], _, []).
val_goals([V|Vs], I, [G?|L?]) :- ground(V?), integer(I?) |
    vname(I?, F),
    name_of(F?, N, _),
    val_goal(V?, N?, G),
    I1 := I? + 1,
    val_goals1(Vs?, I1?, L).
procedure val_goals1(Args?, Integer?, Stream(_)).
val_goals1([], _, ['.']).
val_goals1([V|Vs], I, [','|L?]) :- val_goals([V?|Vs?], I?, L).
procedure val_goal(Arg?, Constant?, _).
val_goal(svar(X), N, G?) :- ground(X?), ground(N?) | G =.. [val_speech, svar(X?), 'B?', 'D?', N?].
val_goal(role(I), N, G?) :- ground(N?) | G =.. [val_peer, role(I?), 'B?', 'D?', N?].
val_goal(pvar(X), N, G?) :- ground(X?), ground(N?) | G =.. [val_peer, pvar(X?), 'B?', 'D?', N?].
val_goal(nterm(_), N, G?) :- ground(N?) | G =.. [val_peer, unnamed, 'B?', 'D?', N?].
%% A signed term is no variable of a schema (schema_vars); the clause covers
%% the type.
val_goal(sgn(_, _), N, G?) :- ground(N?) | G =.. [val_peer, unnamed, 'B?', 'D?', N?].

procedure vname(Integer?, Found).
vname(1, named('V1', 'V1?')).
vname(2, named('V2', 'V2?')).
vname(3, named('V3', 'V3?')).
vname(4, named('V4', 'V4?')).
vname(5, named('V5', 'V5?')).
vname(6, named('V6', 'V6?')).
vname(7, named('V7', 'V7?')).
vname(8, named('V8', 'V8?')).
vname(9, named('V9', 'V9?')).
vname(10, named('V10', 'V10?')).
vname(11, named('V11', 'V11?')).
vname(12, named('V12', 'V12?')).
vname(13, named('V13', 'V13?')).
vname(14, named('V14', 'V14?')).
vname(15, named('V15', 'V15?')).
vname(16, named('V16', 'V16?')).
vname(17, named('V17', 'V17?')).
vname(18, named('V18', 'V18?')).
vname(19, named('V19', 'V19?')).
vname(20, named('V20', 'V20?')).
vname(21, named('V21', 'V21?')).
vname(22, named('V22', 'V22?')).
vname(23, named('V23', 'V23?')).
vname(24, named('V24', 'V24?')).
vname(25, named('V25', 'V25?')).
vname(26, named('V26', 'V26?')).
vname(27, named('V27', 'V27?')).
vname(28, named('V28', 'V28?')).
vname(29, named('V29', 'V29?')).
vname(30, named('V30', 'V30?')).
vname(N, unnamed) :- otherwise, integer(N?) | true.

%% Lines are constants and terms, each printed on a line of its own.
procedure lapp(Stream(_)?, Stream(_)?, Stream(_)).
lapp([], Ys, Ys?).
lapp([X|Xs], Ys, [X?|Zs?]) :- lapp(Xs?, Ys?, Zs).
