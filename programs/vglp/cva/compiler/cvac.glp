%% cvac.glp --- compile(Name, Contract, Verdict): the canonical CVA platform of
%% an act-schema contract, printed as a .vglp module (vGLP, Section 3.2,
%% Definition "Canonical CVA Platform"; Section 5.4, "The compilation" and the
%% paragraph "Act schemas"; self.glp says more).
%%
%% A contract is compiled when programs/gsc finds it syntactically grassroots, grassroots with wards or syntactically grassroots with wards, or finds no fault in it but its introductory acts, so with traceable provenance and volition (verdict_lines below), every role a party role or a listed role, and no name variable (role_lines), so that it is a local specification (vGLP 099f876, Section 5.4, "Act schemas as local specifications": "Such a contract is a local specification"), and when it is effective, by the same paragraph, which local.glp decides.  Otherwise it prints the lines saying why and nothing else.  A signed term sgn(y, i) in an added atom is the speech act bound to y, signed by the person in role i (vGLP, Section 5.4, "Act schemas as local specifications"; GSC, Definition "Act schema"): local.glp decides the contract over it and the printed text, text.glp, computes it.
%%
%% The module is what is printed from the contract, here, and the text every contract shares, text.glp.  What is printed from the contract is the type Class, one alternative per schema, the schema's name applied to the people in its roles and then the values of its variables, in the order of its head, tau(pi_1, ..., pi_k ; x_1, ..., x_m), as GSC's term form gives it (GSC 0228e79, Definition "Act schema"; vGLP #15 Cowork to Code, 2026-10-19 13:34 UTC, item 2), a term of it naming a schema-binding and so its part and its class (vGLP 099f876, Section 5.4, "Act schemas as local specifications": "each schema-binding determines a part [t]_j of its class"); the request type, Request, with the alternative propose([t]_j) for each guarded part [t]_j, a term of Proposal, the alternatives of the schemas whose terms name guarded parts, and the alternative known(Peer) (Section 5.4, "The compilation"); the
%% contract itself, as the term programs/gsc reads, from which the shared text
%% computes the classes and their parts, and each schema under its name,
%% schema_entry; its reflexive predicates; and per
%% schema a clause taking a term of Class to the binding it names, binding_of,
%% and one taking a binding back to the term, class_of.  Each line is a string, built by string_concat/2, each constant from the contract written through term_to_string/2 so that the reader reads it back as the same constant, pvar('Carol') and not pvar(Carol), and each variable of the printed program, V1 or V1? from vname/3, and each type written as it is (GLP-Spec ca3c8e5, appendix-guards, "Text": "A program that prints GLP source, as a compiler does, builds each line as a string by these two, a constant of the source by term_to_string/2 and a variable or a type T? by string_concat/2, and prints it by send_to_user/1"; vGLP #23, Code_inbox.md, 2026-11-06 07:57 UTC); self.glp has the procedures, said/3, call_text/3, named_call/3 and list_text/2.

Line  ::= String ; guarded_only(Line) ; unguarded_only(Line) ; standing_only(Line) ; standless_only(Line)
        ; day_only(Line) ; dayless_only(Line) ; env_only(Line) ; envless_only(Line)
        ; wild_only(Line) ; wildless_only(Line)
        ; const_only(Line) ; constless_only(Line)
        ; set_only(Line) ; setless_only(Line)
        ; cmp_only(Line) ; cmpless_only(Line)
        ; found_only(Line) ; foundless_only(Line)
        ; trust_only(Line) ; trustless_only(Line)
        ; fn_only(Line).
Lines ::= [] ; [Line | Lines].
imported procedure text#fixed_text(Lines).
imported procedure local#faults(Contract?, Preds?, NumInfos?, Ones?, Strings).
imported procedure local#num_info_of(Constant?, Args?, Constraint?, Forms?, RoleSpecs?, Integer?, NumInfo).
imported procedure local#form_cross(Form?, YesNo).
imported procedure local#tag_form(Form?, Form).
imported procedure local#form_held(Form?, Locs?, HPats).
imported procedure local#proposable(Contract?, Preds?, Ones?, Preds).
imported procedure local#listed_ok(Integer?, Ints?, YesNo).

Found ::= named(String, String) ; unnamed.

exported procedure compile(Constant?, Declared?, Verdict?).
compile(Nm, D, V) :- ground(D?) | compile_intro(Nm?, D?, V?, no_introduction, words(no_pragmas, [], [], D?, nodev)).
%% compile(Name, Contract, Verdict, Intro): the same, for a contract naming
%% an introduction predicate e, introduction(e), whose introduction rule the
%% platform's agents follow (vGLP, Section 3.2, Definition "Introduction Rule,
%% Introduce Peers"; Section 5.4, the paragraph on act schemas), or none,
%% no_introduction.
exported procedure compile(Constant?, Declared?, Verdict?, Intro?).
compile(Nm, D, V, I) :- ground(D?) | compile_intro(Nm?, D?, V?, I?, words(no_pragmas, [], [], D?, nodev)).
%% compile(Name, Contract, Verdict, Intro, Pragmas): the same, for a contract carrying pragmas, the words its app shows (vGLP, Section 5.4, "The contract's words": "The compiler carries them into the platform it prints: a request's label and field names and an approval question's two answers into the widget declarations it prints for the platform's request type and approval type, a sentence into the approval question that Start raises, and a list's name into the view the agent writes"; Section 6.2, "The words a platform shows").  Each act a pragma proposes is the schema its button names: "a button for each act of it a person proposes, in brackets, each bearing its act's name" (GSC 2991379, Section 2, its first paragraph).  A contract with no pragmas, no_pragmas, as compile/3 and compile/4 give it, is checked and not printed (compile3a).
exported procedure compile(Constant?, Declared?, Verdict?, Intro?, FPragmas?).
compile(Nm, D, V, I, P) :- ground(D?) | norm_pragmas(P?, Q), compile_intro(Nm?, D?, V?, I?, words(Q?, [], [], D?, nodev)).
%% compile(Name, Contract, Verdict, Intro, Pragmas, Env): the same, for a contract naming its environment predicates Env (self.glp, env_of).
exported procedure compile(Constant?, Declared?, Verdict?, Intro?, FPragmas?, Preds?).
compile(Nm, D, V, I, P, E) :- ground(D?) | norm_pragmas(P?, Q), compile_intro(Nm?, D?, V?, I?, words(Q?, E?, [], D?, nodev)).
%% compile(Name, Contract, Verdict, Intro, Pragmas, Env, Read): the same, with the contract as read, its names and its environment predicates with it, which the platform exports in contract(Text, Schemas) (export_lines).
exported procedure compile(Constant?, Declared?, Verdict?, Intro?, FPragmas?, Preds?, WDeclared?).
compile(Nm, D, V, I, P, E, W) :- norm_pragmas(P?, Q), compile_intro(Nm?, D?, V?, I?, words(Q?, E?, [], W?, nodev)).
%% The same, with the values the developer gives (dev_lines).
exported procedure compile(Constant?, Declared?, Verdict?, Intro?, FPragmas?, Preds?, WDeclared?, DevValues?).
compile(Nm, D, V, I, P, E, W, Vl) :- norm_pragmas(P?, Q), compile_intro(Nm?, D?, V?, I?, words(Q?, E?, [], W?, Vl?)).
%% The pragmas as the compiler carries them, with the standing declarations, none where the term gives none.
%% A term with no look, no version and no text, vGLP's own contracts' (../contracts.glp, pragmas_named/2), has nolook, version(1, 1) and the empty text.
procedure norm_pragmas(FPragmas?, WPragmas).
norm_pragmas(no_pragmas, no_pragmas).
norm_pragmas(pragmas(Ls, As), pragmas(Ls?, Ts?, [], nolook, version(1, 1), '""', [], nofns)) :- norm_acts(As?, Ts).
norm_pragmas(pragmas(Ls, As, Ss), pragmas(Ls?, Ts?, Ss?, nolook, version(1, 1), '""', [], nofns)) :- norm_acts(As?, Ts).
norm_pragmas(pragmas(Ls, As, Ss, Lk, Vn, Tx), pragmas(Ls?, Ts?, Ss?, Lk?, Vn?, Tx?, [], nofns)) :- norm_acts(As?, Ts).
%% The predicates the phone finds, the seventh argument pragmas.sh prints where the implementation pragmas name one (vGLP, Section 5.4: "An implementation pragma says, of each environment predicate other than the day, whether the phone finds it").
norm_pragmas(pragmas(Ls, As, Ss, Lk, Vn, Tx, Fd), pragmas(Ls?, Ts?, Ss?, Lk?, Vn?, Tx?, Fd?, nofns)) :- norm_acts(As?, Ts).
%% The functions the owner of a value type gives, the eighth argument pragmas.sh prints where NAME-functions.glp is (PFns).
norm_pragmas(pragmas(Ls, As, Ss, Lk, Vn, Tx, Fd, Fn), pragmas(Ls?, Ts?, Ss?, Lk?, Vn?, Tx?, Fd?, Fn?)) :- norm_acts(As?, Ts).
%% A term with the functions of the standard library its contract's constraints apply, which compile.sh gives with the pragmas of vGLP's own contracts (libfns.sh; README.md, item 47): the pragmas, their functions those.
norm_pragmas(with_fns(P, Fn), Q?) :- norm_pragmas(P?, Q0), set_fns(Q0?, Fn?, Q).
procedure set_fns(WPragmas?, PFns?, WPragmas).
set_fns(no_pragmas, _, no_pragmas).
set_fns(pragmas(Ls, Ts, Ss, Lk, Vn, Tx, Fd, _), Fn, pragmas(Ls?, Ts?, Ss?, Lk?, Vn?, Tx?, Fd?, Fn?)).
%% Every act with the types of its fields, [] where it gives none (self.glp, PAct).
procedure norm_acts(PActs?, TActs).
norm_acts([], []).
norm_acts([act(S, B, Fs, Q, T, By)|As], [act(S?, B?, Fs?, Q?, T?, By?, [])|Ts?]) :- norm_acts(As?, Ts).
norm_acts([act(S, B, Fs, Q, T, By, Ft)|As], [act(S?, B?, Fs?, Q?, T?, By?, Ft?)|Ts?]) :- norm_acts(As?, Ts).
%% The contract's words, its pragmas, carried through the compiler whole, with its environment predicates and the contract as read, which the platform exports (export_lines).
WPragmas ::= no_pragmas ; pragmas(PLists, TActs, PStands, PLook, PVersion, String, PhoneFacts, PFns).
Words ::= words(WPragmas, Preds, Lxs, WDeclared, DevValues).
%% The words of a contract carrying pragmas, the only contract the compiler prints a platform from (compile3a; vGLP, Section 5.4, "The contract's words"), which every procedure past compile3a takes, with its environment predicates.
Worded ::= words(Given, Preds, Lxs, WDeclared, DevValues).
Given  ::= pragmas(PLists, TActs, PStands, PLook, PVersion, String, PhoneFacts, PFns).
%% Numbers (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications"): each schema's constraint, its local variables and the role whose local variables the constraint names, the table Nt (local.glp, num_info_of); the contract compiled is its plain form (plain_contract), each schema's head less its local variables, which "the schema-binding does not bind", so that a class term names the schema-binding: its roles and its other variables, "bound by the schema-binding, as a speech-act variable is", in the order of the head.
procedure compile_intro(Constant?, Declared?, Verdict?, Intro?, Words?).
compile_intro(Nm, D, V, I, words(P, E, Lx, Dn, Vl)) :- ground(Nm?), ground(D?), ground(P?) |
    decl_schemas(D?, Cq),
    pragma_fns(P?, Fs),
    q_lines(Cq?, Nm?, Fs?, Lq),
    compile_q(Lq?, Nm?, D?, V?, I?, words(P?, E?, Lx?, Dn?, Vl?)).
%% The functions the owner of a value type gives (PFns), none where the contract has no such file.
procedure pragma_fns(WPragmas?, FnDecls).
pragma_fns(pragmas(_, _, _, _, _, _, _, fns(Fs, _)), Fs?).
pragma_fns(_, []) :- otherwise | true.
%% A contract the compiler does not take, by q_lines, is refused before any other procedure reads it, with the lines saying why.
procedure compile_q(Lines?, Constant?, Declared?, Verdict?, Intro?, Words?).
compile_q([L|Ls], _, _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).
compile_q([], Nm, D, V, I, words(P, E0, _, Dn, Vl)) :- ground(D?), ground(I?), ground(P?) |
    decl_schemas(D?, Cr0),
    reals_off(Cr0?, Cq0),
    q_normal(Cq0?, C0),
    decl_schemas(D?, Cr1),
    reals_off(Cr1?, Cq1),
    q_normal(Cq1?, C1),
    decl_schemas(D?, Cr2),
    reals_off(Cr2?, Cq2),
    q_normal(Cq2?, C2),
    decl_schemas(D?, Cr3),
    reals_off(Cr3?, Cq3),
    lx_table(Cq3?, Lx0),
    decl_schemas(D?, Cr4),
    real_lx(Cr4?, Rl),
    app(Lx0?, Rl?, Lx),
    W = words(P1?, E0?, Lx?, Dn?, Vl?),
    decl_schemas(D?, Cr7),
    reals_off(Cr7?, Cq7),
    q_normal(Cq7?, C7),
    decl_schemas(D?, Cr5),
    reals_off(Cr5?, Cq5),
    lx_table(Cq5?, Lb1),
    decl_schemas(D?, Cr6),
    reals_off(Cr6?, Cq6),
    lx_table(Cq6?, Lb2),
    pragma_acts(P?, Pa1),
    pragma_acts(P?, Pa2),
    num_table(C1?, Pa1?, Lb1?, Nt),
    num_table(C2?, Pa2?, Lb2?, Nt1),
    plain_words(C0?, C7?, Nt1?, P?, C, P1),
    decl_reflexive(D?, Rf),
    intro_preds(I?, E),
    compile0(Nm?, C?, Rf?, E?, Nt?, V?, W?).
%% A real variable the constraint determines, local to a role (local.glp, det_locals), is refused with the reason: the printed text would compute it by arithmetic, and GLP types the result of := on reals Number, not Real (TGLP; the root self.glp declares '_real'(Number?, Number)), so no well-typed procedure gives it the type Real its atoms and the class term carry (vGLP #24, Code_inbox.md, 2026-11-07, 5).  A real the class term gives, or that the role's state holds, is carried.
procedure real_det_lines(Contract?, NumInfos?, Words?, Constant?, Lines).
real_det_lines(C, Nt, W, Nm, L?) :- ground(Nt?) |
    words_lx(W?, Lx),
    dets_real(C?, Nt?, Lx?, Ss),
    real_det_lines1(Ss?, L0),
    head_line(L0?, Nm?, L).
%% The possibly-one pairs of the contract as read, which the words carry (self.glp, ones_of).
procedure words_ones(Words?, Sames?, Ones).
words_ones(words(_, _, _, D, _), Mk, Os?) :- ones_of(D?, Os0), ones_marked(Os0?, Mk?, Os).
%% Each schema's pairs, with the contract's marks after them.
procedure ones_marked(Ones?, Sames?, Ones).
ones_marked([], _, []).
ones_marked([ones(N, Ps)|Os], Mk, [ones(N?, Ps1?)|Os1?]) :- ground(Mk?) | app(Ps?, Mk?, Ps1), ones_marked(Os?, Mk?, Os1).
procedure words_lx(Words?, Lxs).
words_lx(words(_, _, Lx, _, _), Lx?).
procedure real_det_lines1(Preds?, Lines).
real_det_lines1([], []).
real_det_lines1([S|Ss], ['%% it has a real variable the constraint determines, which the compiler does not carry: GLP types the result of arithmetic on reals Number, not Real, so the printed text cannot give it the type Real (vGLP #24, Code_inbox.md, 2026-11-07, 5):', T?|L?]) :- ground(S?) |
    said('%% the schema', S?, T),
    real_det_lines1(Ss?, L).
procedure dets_real(Contract?, NumInfos?, Lxs?, Preds).
dets_real([], _, _, []).
dets_real([schema(S, _, Rs)|Cs], Nt, Lx, R?) :- ground(S?), ground(Rs?), ground(Nt?), ground(Lx?) |
    det_real_of(S?, Rs?, Nt?, Lx?, D),
    dets_real(Cs?, Nt?, Lx?, R1),
    keep_pred(D?, S?, R1?, R).
dets_real([nschema(S, _, _, Rs)|Cs], Nt, Lx, R?) :- ground(S?), ground(Rs?), ground(Nt?), ground(Lx?) |
    det_real_of(S?, Rs?, Nt?, Lx?, D),
    dets_real(Cs?, Nt?, Lx?, R1),
    keep_pred(D?, S?, R1?, R).
dets_real([cschema(_, _, _, _)|Cs], Nt, Lx, R?) :- dets_real(Cs?, Nt?, Lx?, R).
procedure det_real_of(Constant?, RoleSpecs?, NumInfos?, Lxs?, YesNo).
det_real_of(S, Rs, Nt, Lx, D?) :- ground(S?), ground(Rs?) |
    reals_of(Lx?, S?, Xs),
    num_lookup(S?, Nt?, Ni),
    ni_locs(Ni?, Ls),
    added_args(Rs?, Aa),
    det_real(Xs?, Ls?, Aa?, D).
procedure ni_locs(NumInfo?, Locs).
ni_locs(num_info(_, _, Ls, _, _, _), Ls?).
procedure added_args(RoleSpecs?, Args).
added_args([], []).
added_args([R|Rs], As?) :- ground(R?) | rs_lists(R?, P, _, _, _), atoms_args(P?, A1), added_args(Rs?, A2), app(A1?, A2?, As).
procedure det_real(Preds?, Locs?, Args?, YesNo).
det_real([], _, _, no).
det_real([X|Xs], Ls, Aa, D?) :- ground(X?), ground(Ls?), ground(Aa?) |
    loc_vars(Ls?, Lv),
    mem(num(X?), Lv?, L),
    mem(num(X?), Aa?, A),
    and(L?, A?, D1),
    det_real(Xs?, Ls?, Aa?, D2),
    or(D1?, D2?, D).
procedure intro_preds(Intro?, Preds).
intro_preds(no_introduction, []).
intro_preds(introduction(P), [P?]).
procedure compile0(Constant?, Contract?, Preds?, Preds?, NumInfos?, Verdict?, Words?).
compile0(Nm, C, Rf, E, Nt, V, W) :- ground(Nm?), ground(C?), ground(Nt?), ground(W?), ground(V?) |
    verdict_lines(V?, Nm?, L1),
    role_lines(C?, Nm?, L2),
    real_det_lines(C?, Nt?, W?, Nm?, L3),
    lapp(L2?, L3?, L23),
    lapp(L1?, L23?, L),
    verdict_marks(V?, Mk),
    compile1(L?, Nm?, C?, Rf?, E?, Nt?, W?, Mk?).
%% The marks of a contract with wards, the predicates its verdict names, of which an agent holding identity holds one or person and not both (GSC, Lemma Wards and guardians; vGLP b798a06, Section 5.4: "the compiler checks it on the states that meet the invariants the contract's paper proves"); none for another contract.
procedure verdict_marks(Verdict?, Sames).
verdict_marks(syntactically_grassroots_with_wards(_, Ms, Gs, _, _), Mk?) :- marks_items(Ms?, Mk1), gships_items(Gs?, Mk2), app(Mk1?, Mk2?, Mk).
verdict_marks(grassroots_with_wards(_, Ms, Gs, _, _), Mk?) :- marks_items(Ms?, Mk1), gships_items(Gs?, Mk2), app(Mk1?, Mk2?, Mk).
verdict_marks(_, []) :- otherwise | true.
procedure gships_items(Guardianships?, Sames).
gships_items([], []).
gships_items([guardianship(M, V, U)|Gs], [gship(M?, V?, U?)|Ks?]) :- gships_items(Gs?, Ks).
procedure marks_items(Preds?, Sames).
marks_items([], []).
marks_items([M|Ms], [mark(M?)|Ks?]) :- marks_items(Ms?, Ks).

procedure compile1(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?, Sames?).
compile1([], Nm, C, Rf, E, Nt, W, Mk) :- ground(C?) |
    names_lines(C?, Nm?, L1),
    compile2(L1?, Nm?, C?, Rf?, E?, Nt?, W?, Mk?).
compile1([L|Ls], _, _, _, _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

procedure compile2(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?, Sames?).
compile2([], Nm, C, Rf, E, Nt, W, Mk) :- ground(C?), ground(Rf?), ground(Nt?), ground(W?), ground(Mk?) |
    words_ones(W?, Mk?, Os),
    local # faults(C?, Rf?, Nt?, Os?, Fs),
    compile3(Fs?, Nm?, C?, Rf?, E?, Nt?, W?, Mk?).
compile2([L|Ls], _, _, _, _, _, _, _) :-
    send_to_user(['%% compile begin', L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

procedure compile3(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?, Sames?).
compile3([], Nm, C, Rf, E, Nt, W, Mk) :- ground(C?), ground(Rf?), ground(W?) |
    words_ones(W?, Mk?, Os),
    local # proposable(C?, Rf?, Os?, Ps),
    compile3a(Ps?, Nm?, C?, Rf?, E?, Nt?, W?).
compile3([F|Fs], Nm, _, _, _, _, _, _) :- ground(Nm?) |
    said('%% not compiled', Nm?, H),
    send_to_user(['%% compile begin', H?, F?|Fs1?]),
    lapp(Fs?, ['%% compile end'], Fs1).

%% A contract that passes the checks and carries no pragmas is refused, with the line saying why: "Every other word the app shows is the contract's, so the compiler prints a platform only from a contract with pragmas, and refuses one with none; the checks that a contract is local, effective and grassroots are of its schemas and need none" (vGLP ffcb093, Section 5.4, "The contract's words").  compile/3 and compile/4, which give no pragmas, so check a contract and print no platform.
procedure compile3a(Preds?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Words?).
compile3a(_, Nm, _, _, _, _, words(no_pragmas, _, _, _, _)) :- ground(Nm?) |
    said('%% not compiled, having no pragmas', Nm?, H),
    send_to_user(['%% compile begin', H?,
        '%% it passes the checks, its verdict, local and effective, and has no pragmas, the words its app shows: the compiler prints a platform only from a contract with pragmas, and refuses one with none (vGLP, Section 5.4, "The contract\'s words").',
        '%% compile end']).
compile3a(Ps, Nm, C, Rf, E, Nt, words(pragmas(Ls, As, Ss, Lk, Vn, Tx, Fd, Fn), Ev, Lx, Dn, Vl)) :- ground(Fd?), ground(Fn?), ground(Vl?), ground(Ps?), ground(C?), ground(Nt?), ground(Ls?), ground(As?), ground(Ss?), ground(Lk?), ground(Vn?), ground(Tx?), ground(Ev?), ground(Lx?), ground(Dn?) |
    word_faults(words(pragmas(Ls?, As?, Ss?, Lk?, Vn?, Tx?, Fd?, Fn?), Ev?, Lx?, Dn?, Vl?), C?, Nt?, Ps?, Wf),
    compile4(Wf?, Nm?, C?, Rf?, E?, Nt?, words(pragmas(Ls?, As?, Ss?, Lk?, Vn?, Tx?, Fd?, Fn?), Ev?, Lx?, Dn?, Vl?), Ps?).

%% A contract whose words do not name its schemas, or leave a guarded schema with no button, is not compiled, with the lines saying why (word_faults).
procedure compile4(Lines?, Constant?, Contract?, Preds?, Preds?, NumInfos?, Worded?, Preds?).
compile4([], Nm, C, Rf, E, Nt, W, Ps) :-
    module_lines(Nm?, C?, Rf?, E?, Nt?, W?, Ps?, Ls),
    send_to_user(['%% compile begin'|Ls?]).
compile4([L|Ls], Nm, _, _, _, _, _, _) :- ground(Nm?) |
    said('%% not compiled', Nm?, H),
    send_to_user(['%% compile begin', H?, L?|Ls1?]),
    lapp(Ls?, ['%% compile end'], Ls1).

%% --- The contract compiled ------------------------------------------------
%% What the compiler takes of a schema with quantifiers (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications"), qschema in GSC's term form, and of a constraint, and the lines refusing what it does not take, the schema named, before any other procedure reads the contract:
%% (1) A safe formula of the body local to a role, "the machine of the person in that role evaluates it in its own state", is taken (local.glp, form_infos; the printed text's forms_at).
%% (2) A listed role bound by a quantifier, qlisted in GSC's term form, whose person is the first argument of its anchor after the holder and the one variable its quantifier binds, is taken as listed/3 with the condition of its quantifier, and a quantified conjunct that binds it with its conditional literals added at other roles, one for each person of the role (q_normal, lx_table; the printed text's listing/7): "its request name is the schema-binding" (vGLP 9ee6f87, Section 5.4), the class term naming the people of the role, as for listed/3.  A conjunct binding no listed role, with a conditional literal at a role other than the one holding its anchor, is taken, its instances a list the base finds and the attempt names, each restricted to the variables its literals name, without repetition (ix_conjs, hm_named, inst_heads; the printed text's instances/7).  A conjunct binding no listed role whose conditional literals are all at the role holding its anchor is local to that role, which finds its instances in its own state and applies its literals at each (lc_conjs, local_lines; the printed text's local_effect).  A conditional literal deleted is subtracted from a state that need not hold it (the printed text's opt).  One with a conditional literal at a listed role or holding a signed term of a speech-act variable its quantifier binds, one whose literals at another role name none of its bound variables, and any other listed role are not yet taken, and refused with the reason (odd_conjunct, inst_odd, odd_qlisted).
%% (3) A count and a sum of a quantifier's instances, and the functions min and floor, in a constraint or a safe formula are taken, the count or the sum local to the role holding its anchor (local.glp, con_counts; the printed text's con_counted): "A constraint and a safe formula are over the relations and functions of GSC's value types --- comparison, arithmetic, min, floor, signed, unsigned --- and over the count and the sum of a quantifier's instances, each counted by its anchor's multiplicity; a count or a sum is local to the role holding its anchor" (vGLP #24, Code_inbox.md, 2026-11-07 13:11 UTC, 3; vGLP 9ee6f87, Section 5.4).  A relation rel(Name, Args) and a function the paper does not name are not: the paper names no relation of a value type beyond comparison, and no function beyond min and floor.
procedure q_lines(QContract?, Constant?, FnDecls?, Lines).
q_lines(C, Nm, Fs, L?) :- ground(C?), ground(Nm?) |
    q_faults(C?, Fs?, L0),
    wild_faults(C?, L1),
    bound_faults(C?, L2),
    lapp(L1?, L2?, L12),
    lapp(L0?, L12?, L01),
    head_line(L01?, Nm?, L).
procedure q_faults(QContract?, FnDecls?, Lines).
q_faults([], _, []).
q_faults([S|Ss], Fs, L?) :- ground(S?), ground(Fs?) |
    q_schema(S?, Fs?, L1),
    const_faults(S?, L00),
    set_faults(S?, L01),
    lapp(L00?, L01?, L0),
    q_faults(Ss?, Fs?, L2),
    lapp(L0?, L2?, L02),
    lapp(L1?, L02?, L).
%% (4) A variable over the constants, const(X) among a schema's variables (vGLP, Section 5.4, "Speech-act schemas as local specifications": "a value variable, whose type, a whole number, a real or a constant, the schema writes with it, a multiplicity and a count being whole numbers, and a variable over the constants taking the name its proposer types, as the name of the role to which an organisation appoints an officer, which another act requires as a constant the contract names"), is taken where it is an argument of an atom, bound by the schema-binding or local to a role.  It is no number, so one written as a multiplicity is refused; one in a constraint, or in the constraint of a safe formula or of a conjunct's condition, is refused, the printed text comparing numbers, persons, speech acts and community names and no value such a variable takes (con_holds, expr_term1); and one a quantifier binds is refused, the instances of a conjunct being printed of the types Peer, Speech and Integer (kind_type).
procedure const_faults(QSchema?, Lines).
const_faults(schema(S, Hd, Rs), L?) :- hd_consts(Hd?, Xs), const_check(Xs?, [], true, Rs?, [], [], S?, L).
const_faults(cschema(S, Hd, _, Rs), L?) :- hd_consts(Hd?, Xs), const_check(Xs?, [], true, Rs?, [], [], S?, L).
const_faults(nschema(S, Hd, C, Rs), L?) :- hd_consts(Hd?, Xs), const_check(Xs?, [], C?, Rs?, [], [], S?, L).
const_faults(qschema(S, Hd, Bd, C, Rs, Cj, Fs), L?) :- hd_consts(Hd?, Xs), hd_consts(Bd?, Bs), const_check(Xs?, Bs?, C?, Rs?, Cj?, Fs?, S?, L).
%% (5) A set variable, set(X) among a schema's variables (GSC, the appendix on values, Definition "Schema with values"), stands in an atom for its elements, one atom each, and in a constraint as size(X), its size, a whole number; the compiler carries it in a constraint only as size(X).
procedure set_faults(QSchema?, Lines).
set_faults(schema(_, _, _), []).
set_faults(cschema(_, _, _, _), []).
set_faults(nschema(S, Hd, C, _), L?) :- set_check(Hd?, C?, S?, L).
set_faults(qschema(S, Hd, _, C, _, _, _), L?) :- set_check(Hd?, C?, S?, L).
procedure set_check(Args?, Constraint?, Constant?, Lines).
set_check(Hd, C, S, L?) :- ground(Hd?), ground(C?), ground(S?) |
    hd_sets(Hd?, Xs),
    sz_con(C?, C1),
    con_args(C1?, A),
    names_in(A?, Xs?, K),
    const_fault(K?, S?, '%% it has a set variable in a constraint other than as size(N), its size, which the compiler does not carry (GSC, the appendix on values, Definition "Schema with values"):', L).
procedure hd_sets(Args?, Preds).
hd_sets([], []).
hd_sets([set(X)|As], [X?|Xs?]) :- hd_sets(As?, Xs).
hd_sets([_|As], Xs?) :- otherwise | hd_sets(As?, Xs).
%% The constraint with each size(X), fn(size, [num(X)]), written as a constant, so that the names left are those outside a size.
procedure sz_con(Constraint?, Constraint).
sz_con(true, true).
sz_con(and(A, B), and(A1?, B1?)) :- sz_con(A?, A1), sz_con(B?, B1).
sz_con(or(A, B), or(A1?, B1?)) :- sz_con(A?, A1), sz_con(B?, B1).
sz_con(implies(A, B), implies(A1?, B1?)) :- sz_con(A?, A1), sz_con(B?, B1).
sz_con(not(A), not(A1?)) :- sz_con(A?, A1).
sz_con(eq(X, Y), eq(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_con(ne(X, Y), ne(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_con(le(X, Y), le(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_con(lt(X, Y), lt(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_con(ge(X, Y), ge(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_con(gt(X, Y), gt(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_con(rel(R, Es), rel(R?, Es1?)) :- sz_exprs(Es?, Es1).
sz_con(C, C?) :- otherwise | true.
procedure sz_exprs(Exprs?, Exprs).
sz_exprs([], []).
sz_exprs([E|Es], [E1?|Es1?]) :- sz_expr(E?, E1), sz_exprs(Es?, Es1).
procedure sz_expr(Expr?, Expr).
sz_expr(fn(size, [num(_)]), val(size)).
sz_expr(plus(X, Y), plus(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_expr(minus(X, Y), minus(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_expr(mul(X, Y), mul(X1?, Y1?)) :- sz_expr(X?, X1), sz_expr(Y?, Y1).
sz_expr(fn(F, Es), fn(F?, Es1?)) :- otherwise | sz_exprs(Es?, Es1).
sz_expr(E, E?) :- otherwise | true.
%% The names of the variables over the constants among a schema's variables.
procedure hd_consts(Args?, Preds).
hd_consts([], []).
hd_consts([const(X)|As], [X?|Xs?]) :- hd_consts(As?, Xs).
hd_consts([_|As], Xs?) :- otherwise | hd_consts(As?, Xs).
procedure const_check(Preds?, Preds?, Constraint?, RoleSpecs?, Conjuncts?, Forms?, Constant?, Lines).
const_check([], [], _, _, _, _, _, []).
const_check(Xs, Bs, C, Rs, Cj, Fs, S, L?) :- otherwise, ground(Xs?), ground(Bs?), ground(S?) |
    app(Xs?, Bs?, Ys),
    app(Xs?, Bs?, Ys1),
    co_roles(Rs?, Rs1),
    rs_atoms(Rs1?, As),
    mult_args(As?, Ms),
    names_in(Ms?, Ys?, M),
    co_con(C?, C1),
    con_ord(C1?, Ca),
    co_forms(Fs?, Fs1),
    co_conjs(Cj?, Cj1),
    conj_phis(Cj1?, Ps),
    app(Fs1?, Ps?, Fp),
    forms_cons(Fp?, Fa),
    app(Ca?, Fa?, Cf),
    names_in(Cf?, Ys1?, K),
    any_name(Bs?, Q),
    const_fault(M?, S?, '%% it has a variable over the constants as a multiplicity, and a multiplicity is a whole number (vGLP, Section 5.4, "Speech-act schemas as local specifications": "a multiplicity and a count being whole numbers"):', L1),
    const_fault(K?, S?, '%% it has a variable over the constants in a constraint, or in the constraint of a safe formula, other than as a side of an equality or an inequality, eq or ne, which the compiler does not carry: comparison of constants is their equality, and the printed text orders and adds numbers, no value a variable over the constants takes:', L2),
    const_fault(Q?, S?, '%% it has a variable over the constants that a quantifier binds, which the compiler does not carry yet: the instances of a conjunct are printed of the types Peer, Speech and Integer:', L3),
    lapp(L2?, L3?, L23),
    lapp(L1?, L23?, L).
procedure const_fault(YesNo?, Constant?, String?, Lines).
const_fault(no, _, _, []).
const_fault(yes, S, H, [H?, T?]) :- ground(S?) | said('%% the schema', S?, T).
%% The multiplicities of the atoms, as arguments.
procedure mult_args(Atoms?, Args).
mult_args([], []).
mult_args([atom(_, _)|As], Ms?) :- mult_args(As?, Ms).
mult_args([times(K, A)|As], [K?|Ms?]) :- mult_args([A?|As?], Ms).
mult_args([rest(K, J, A)|As], [K?, J?|Ms?]) :- mult_args([A?|As?], Ms).
%% Whether an argument among As is a value variable num(X), X among the names Xs.
procedure names_in(Args?, Preds?, YesNo).
names_in([], _, no).
names_in([num(X)|As], Xs, B?) :- ground(Xs?) | mem(X?, Xs?, B1), names_in(As?, Xs?, B2), or(B1?, B2?, B).
names_in([_|As], Xs, B?) :- otherwise | names_in(As?, Xs?, B).
%% The conditions of the conjuncts.
procedure conj_phis(Conjuncts?, Forms).
conj_phis([], []).
conj_phis([conjunct(_, _, _, F, _, _, _)|Cs], [F?|Fs?]) :- conj_phis(Cs?, Fs).
%% The arguments the constraints of safe formulas name (self.glp, con_args).
procedure forms_cons(Forms?, Args).
forms_cons([], []).
forms_cons([F|Fs], A?) :- form_cons(F?, A1), forms_cons(Fs?, A2), app(A1?, A2?, A).
procedure form_cons(Form?, Args).
form_cons(fa(_, _), []).
form_cons(fnot(F), A?) :- form_cons(F?, A).
form_cons(fand(F, G), A?) :- form_cons(F?, A1), form_cons(G?, A2), app(A1?, A2?, A).
form_cons(for(F, G), A?) :- form_cons(F?, A1), form_cons(G?, A2), app(A1?, A2?, A).
form_cons(fexists(_, _, _, F), A?) :- form_cons(F?, A).
form_cons(fforall(_, _, _, F, Gs), A?) :- form_cons(F?, A1), forms_cons(Gs?, A2), app(A1?, A2?, A).
form_cons(fcons(C), A?) :- con_ord(C?, A).
%% The arguments of a constraint other than a side of eq or ne that is one argument: a variable over the constants is compared there for equality, the comparison its type provides (vGLP, Section 5.4, "Speech-act schemas as local specifications": "a constraint, and a safe formula, is over the relations and functions the value types provide --- comparison and arithmetic"), as Rides's award and Gigs's pass require one constant at two roles, eq(const(Dollar), const(DollarTwo)); anywhere else, under an order, in arithmetic, in succ or in a relation, it is refused (const_check).
procedure con_ord(Constraint?, Args).
con_ord(true, []).
con_ord(and(C1, C2), A?) :- con_ord(C1?, A1), con_ord(C2?, A2), app(A1?, A2?, A).
con_ord(or(C1, C2), A?) :- con_ord(C1?, A1), con_ord(C2?, A2), app(A1?, A2?, A).
con_ord(implies(C1, C2), A?) :- con_ord(C1?, A1), con_ord(C2?, A2), app(A1?, A2?, A).
con_ord(not(C), A?) :- con_ord(C?, A).
con_ord(eq(X, Y), A?) :- side_args(X?, A1), side_args(Y?, A2), app(A1?, A2?, A).
con_ord(ne(X, Y), A?) :- side_args(X?, A1), side_args(Y?, A2), app(A1?, A2?, A).
con_ord(C, A?) :- otherwise | con_args(C?, A).
procedure side_args(Expr?, Args).
side_args(num(_), []).
%% A variable that is an argument of a function, as fn(side, [const('Board')]), is the value the function is applied to, compared by none of the orders: the function's owner gives its type (vGLP, Section 5.4, "any other relation or function of a value type, which the owner of the type gives as a typed GLP procedure"), and the compiler calls it with the constant (owner_fn_lines).
side_args(fn(_, Es), A?) :- fn_side_args(Es?, A).
side_args(E, A?) :- otherwise | expr_args(E?, A).
procedure fn_side_args(Exprs?, Args).
fn_side_args([], []).
fn_side_args([num(_)|Es], A?) :- fn_side_args(Es?, A).
fn_side_args([const(_)|Es], A?) :- fn_side_args(Es?, A).
fn_side_args([E|Es], A?) :- otherwise | expr_args(E?, A1), fn_side_args(Es?, A2), app(A1?, A2?, A).
procedure q_schema(QSchema?, FnDecls?, Lines).
q_schema(schema(_, _, _), _, []).
q_schema(cschema(_, _, _, _), _, []).
q_schema(nschema(S, _, C, _), Fn, L?) :- ground(S?) |
    con_beyond(Fn?, C?, B),
    beyond_lines(B?, S?, L).
q_schema(qschema(S, _, _, C, Rs, Cj, Fs), Fn, L?) :- ground(S?), ground(Rs?), ground(Cj?), ground(Fn?) |
    q_listed_ixs(Rs?, 1, Lis0),
    listed_ixs(Rs?, 1, Lis1),
    app(Lis0?, Lis1?, Lis),
    odd_conjunct(Cj?, Lis?, Q1),
    odd_qlisted(Rs?, 1, Q2),
    or(Q1?, Q2?, Q),
    conjunct_lines(Q?, S?, L1),
    con_beyond(Fn?, C?, B1),
    forms_beyond(Fn?, Fs?, B2),
    or(B1?, B2?, B),
    beyond_lines(B?, S?, L2),
    inst_base_lines(Cj?, Rs?, S?, L3),
    lapp(L1?, L2?, L12),
    lapp(L12?, L3?, L).
%% A quantified conjunct the compiler takes: one binding a listed role, and one binding no listed role, its quantifier binding variables Xs of any kind, which has conditional literals at a role other than the one holding its anchor, its instances, assignments of Xs, a list the attempt names (vGLP 2f1dc92 and vGLP #24, Code_inbox.md, 2026-11-07 17:19 UTC: a conjunct may bind several variables of any kind, an instance being an assignment of all of them): "A conjunct with a listed role, or with conditional literals at a role other than the one holding its anchor, is local to its base; the base's machine finds its instances, the attempt names them, and every participant takes them as arguments of the transaction" (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications"), as GCC's appoint's "every person Alice lists as appointed, Bob lists too".  The compiler does not take yet, and refuses with the reason: a conjunct deleting a conditional literal; one binding no listed role whose conditional literals are all at the role holding its anchor, local to that role, whose instances that role's machine would find in its own state; one binding a listed role and other variables; and one with a conditional literal at a listed role, or with a signed term of a speech-act variable of Xs.
procedure odd_conjunct(Conjuncts?, Ints?, YesNo).
odd_conjunct([], _, no).
odd_conjunct([conjunct([role(I)], _, _, _, _, _, _)|Cs], Lis, B?) :- integer(I?), ground(Lis?) |
    mem_int(I?, Lis?, In),
    neg(In?, B1),
    odd_conjunct(Cs?, Lis?, B2),
    or(B1?, B2?, B).
odd_conjunct([conjunct([X|Xs], Bi, _, _, CA, CD, _)|Cs], Lis, B?) :- ground(X?), ground(Xs?), integer(Bi?), ground(CA?), ground(CD?), ground(Lis?) |
    has_role([X?|Xs?], R),
    app(CA?, CD?, H),
    inst_odd([X?|Xs?], Bi?, H?, Lis?, B0),
    or(R?, B0?, B1),
    odd_conjunct(Cs?, Lis?, B2),
    or(B1?, B2?, B).
odd_conjunct([_|_], _, yes) :- otherwise | true.
%% Whether the variables a quantifier binds name a role, a listed role bound with others.
procedure has_role(Args?, YesNo).
has_role([], no).
has_role([role(_)|_], yes).
has_role([_|Xs], R?) :- otherwise | has_role(Xs?, R).
%% Whether a conjunct binding the variables Xs, its anchor held by the role Bi, with the conditional literals Hs, is one the compiler does not take: one at a listed role of Lis; one with a signed term of a speech-act variable of Xs, refused with the reason until a contract needs it (vGLP #24, Code_inbox.md, 2026-11-07 18:52 UTC, (iii)); and one with a literal at a role other than Bi whose literals name none of Xs, its instances restricted to no variable (hm_named).
procedure inst_odd(Args?, Integer?, HMults?, Ints?, YesNo).
inst_odd(Xs, Bi, Hs, Lis, B?) :- ground(Xs?), integer(Bi?), ground(Hs?), ground(Lis?) |
    hm_other(Hs?, Bi?, O),
    hm_named(Hs?, Xs?, Xr),
    no_args(Xr?, E),
    and(O?, E?, OE),
    hm_listed(Hs?, Lis?, Li),
    hm_signed(Hs?, Xs?, N),
    or(Li?, N?, B1),
    or(OE?, B1?, B).
procedure no_args(Args?, YesNo).
no_args([], yes).
no_args([_|_], no).
%% The variables of Xs that the conditional literals Hs name, in the order of Xs: "the attempt names them, each restricted to the variables the conjunct's literals name and without repetition" (vGLP fe12932, Section 5.4, "Speech-act schemas as local specifications"), a variable in a name term or a signed term, or a multiplicity, named as one in an atom is.
procedure hm_named(HMults?, Args?, Args).
hm_named(Hs, Xs, Xr?) :- ground(Hs?), ground(Xs?) |
    hm_atoms(Hs?, Ms),
    atoms_args(Ms?, As0),
    flat_args(As0?, As),
    named_xs(Xs?, As?, Xr).
procedure flat_args(Args?, Args).
flat_args([], []).
flat_args([nterm(N)|As], R?) :- nterm_args(N?, R1), flat_args(As?, R2), app(R1?, R2?, R).
flat_args([sgn(Y, I)|As], [svar(Y?), role(I?)|R?]) :- flat_args(As?, R).
%% The item of a speech act, item_of(y), its utterance under its signatures, an argument of an atom (vGLP e1d1b8a, Section 5.4: an argument of an atom may be "the signer, the author or the item of a speech act", as GSC's term form writes it, programs/gsc/self.glp, Arg).
flat_args([item_of(V)|As], [V?|R?]) :- flat_args(As?, R).
%% A constant the contract names, val(C), names no variable (vGLP 0eeea71, Section 5.4).
flat_args([val(_)|As], R?) :- flat_args(As?, R).
%% A compound value holds the variables of its arguments.
flat_args([cmp(_, Bs)|As], R?) :- flat_args(Bs?, R1), flat_args(As?, R2), app(R1?, R2?, R).
flat_args([A|As], [A?|R?]) :- otherwise | flat_args(As?, R).
procedure nterm_args(NameTerm?, Args).
nterm_args(own(I), [role(I?)]).
nterm_args(own_var(X), [pvar(X?)]).
nterm_args(nvar(X), [pvar(X?)]).
nterm_args(ext(N, Y), [svar(Y?)|R?]) :- nterm_args(N?, R).
nterm_args(ext_any(N), R?) :- nterm_args(N?, R).
procedure named_xs(Args?, Args?, Args).
named_xs([], _, []).
named_xs([X|Xs], As, R?) :- ground(X?), ground(As?) |
    mem(X?, As?, In),
    named_xs(Xs?, As?, R1),
    keep_named(In?, X?, R1?, R).
procedure keep_named(YesNo?, Arg?, Args?, Args).
keep_named(yes, X, R, [X?|R?]).
keep_named(no, _, R, R?).
procedure hm_other(HMults?, Integer?, YesNo).
hm_other([], _, no).
hm_other([hm(J, _)|_], Bi, yes) :- J? =\= Bi? | true.
hm_other([_|Hs], Bi, O?) :- otherwise | hm_other(Hs?, Bi?, O).
procedure hm_listed(HMults?, Ints?, YesNo).
hm_listed([], _, no).
hm_listed([hm(J, _)|Hs], Lis, B?) :- integer(J?), ground(Lis?) |
    mem_int(J?, Lis?, B1),
    hm_listed(Hs?, Lis?, B2),
    or(B1?, B2?, B).
procedure hm_signed(HMults?, Args?, YesNo).
hm_signed([], _, no).
hm_signed([hm(_, M)|Hs], Xs, B?) :- ground(Xs?) |
    atom_signs(M?, Xs?, B1),
    hm_signed(Hs?, Xs?, B2),
    or(B1?, B2?, B).
procedure atom_signs(Atom?, Args?, YesNo).
atom_signs(atom(_, As), Xs, B?) :- args_sign(As?, Xs?, B).
atom_signs(times(_, A), Xs, B?) :- atom_signs(A?, Xs?, B).
atom_signs(rest(_, _, A), Xs, B?) :- atom_signs(A?, Xs?, B).
procedure args_sign(Args?, Args?, YesNo).
args_sign([], _, no).
args_sign([sgn(Y, _)|As], Xs, B?) :- ground(Y?), ground(Xs?) |
    mem(svar(Y?), Xs?, B1),
    args_sign(As?, Xs?, B2),
    or(B1?, B2?, B).
args_sign([_|As], Xs, B?) :- otherwise | args_sign(As?, Xs?, B).
%% The conjuncts of a schema local to their base and not to one role, those of its listed roles and those whose instances the attempt names, have one base, which is a guarding role or, where the schema has one guarding role or none, its first role: "The conjuncts of a schema that are local to their base and not to one role have one base, the base of the schema" and "the base of a schema is a guarding role or, where the schema has one guarding role or none, its first role, so that the person who proposes a part the schema determines ... finds the instances in their own state" (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications"; local.glp, listed_ok).  Checked here for a schema with a conjunct whose instances the attempt names; local.glp checks the bases of the listed roles.
procedure inst_base_lines(Conjuncts?, RoleSpecs?, Constant?, Lines).
inst_base_lines(Cj, Rs, S, L?) :- ground(Cj?), ground(Rs?), ground(S?) |
    inst_bases(Cj?, Ib),
    inst_bases(Cj?, Ib1),
    q_bases(Rs?, Qb),
    app(Qb?, Ib1?, Bs0),
    dedup(Bs0?, Bs),
    guard_indices1(Rs?, 1, Gs),
    inst_base_lines1(Ib?, Bs?, Gs?, S?, L).
procedure inst_bases(Conjuncts?, Ints).
inst_bases([], []).
inst_bases([conjunct([role(_)], _, _, _, _, _, _)|Cs], Bs?) :- inst_bases(Cs?, Bs).
inst_bases([conjunct(_, Bi, _, _, CA, CD, _)|Cs], Bs?) :- otherwise, integer(Bi?), ground(CA?), ground(CD?) |
    app(CA?, CD?, H),
    hm_other(H?, Bi?, O),
    inst_bases(Cs?, Bs1),
    keep_int(O?, Bi?, Bs1?, Bs).
procedure q_bases(RoleSpecs?, Ints).
q_bases([], []).
q_bases([crs(qlisted(Bi, _, _, _), _, _, _, _, _)|Rs], [Bi?|Bs?]) :- q_bases(Rs?, Bs).
q_bases([crs(listed(Bi, _, _), _, _, _, _, _)|Rs], [Bi?|Bs?]) :- q_bases(Rs?, Bs).
q_bases([_|Rs], Bs?) :- otherwise | q_bases(Rs?, Bs).
procedure inst_base_lines1(Ints?, Ints?, Ints?, Constant?, Lines).
inst_base_lines1([], _, _, _, []).
inst_base_lines1([_|_], [B], Gs, S, L?) :- local # listed_ok(B?, Gs?, Ok), inst_base_lines2(Ok?, S?, L).
inst_base_lines1([_|_], [_, _|_], _, S, ['%% it is not effective (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "The conjuncts of a schema that are local to their base and not to one role have one base"): a schema whose conjuncts local to their base have different bases:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
procedure inst_base_lines2(YesNo?, Constant?, Lines).
inst_base_lines2(yes, _, []).
inst_base_lines2(no, S, ['%% it is not effective (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "the base of a schema is a guarding role or, where the schema has one guarding role or none, its first role"): a schema with a conjunct whose instances the attempt names, whose base is neither:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
%% A listed role the compiler does not take yet: one whose person is not the first argument of its anchor after its holder, or whose quantifier binds another variable.
procedure odd_qlisted(RoleSpecs?, Integer?, YesNo).
odd_qlisted([], _, no).
odd_qlisted([crs(qlisted(_, _, As, [role(K)]), _, _, _, _, _)|Rs], I, B?) :- integer(I?), K? =:= I?, ground(As?) |
    mem(role(I?), As?, In),
    neg(In?, B1),
    I1 := I? + 1,
    odd_qlisted(Rs?, I1?, B2),
    or(B1?, B2?, B).
odd_qlisted([crs(qlisted(_, _, _, _), _, _, _, _, _)|_], _, yes) :- otherwise | true.
odd_qlisted([_|Rs], I, B?) :- otherwise, integer(I?) | I1 := I? + 1, odd_qlisted(Rs?, I1?, B).
procedure conjunct_lines(YesNo?, Constant?, Lines).
conjunct_lines(no, _, []).
conjunct_lines(yes, S, ['%% it has a quantified conjunct the compiler does not carry yet: one binding a listed role and other variables, or with a conditional literal at a listed role; one with a conditional literal holding a signed term of a speech-act variable its quantifier binds, refused until a contract needs it (vGLP #24, Code_inbox.md, 2026-11-07 18:52 UTC, (iii)); one with a conditional literal at a role other than the one holding its anchor whose literals name no variable its quantifier binds, an instance restricted to none; or a listed role whose person is not the first argument of its anchor or whose quantifier binds another variable:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
procedure beyond_lines(YesNo?, Constant?, Lines).
beyond_lines(no, _, []).
beyond_lines(yes, S, ['%% it has a relation or a function other than min and floor in a constraint or a safe formula, a program condition of a speech act among them, which vGLP Section 5.4 does not name, a constraint being over comparison, arithmetic, min, floor, the signing conditions, the author and the item of a speech act, counts and sums:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
%% Whether a constraint, an expression or a safe formula holds a relation, or a function other than min and floor.
procedure con_beyond(FnDecls?, Constraint?, YesNo).
con_beyond(_, true, no).
con_beyond(Fs, and(C1, C2), B?) :- ground(Fs?) | con_beyond(Fs?, C1?, B1), con_beyond(Fs?, C2?, B2), or(B1?, B2?, B).
con_beyond(Fs, or(C1, C2), B?) :- ground(Fs?) | con_beyond(Fs?, C1?, B1), con_beyond(Fs?, C2?, B2), or(B1?, B2?, B).
con_beyond(Fs, implies(C1, C2), B?) :- ground(Fs?) | con_beyond(Fs?, C1?, B1), con_beyond(Fs?, C2?, B2), or(B1?, B2?, B).
con_beyond(Fs, not(C), B?) :- con_beyond(Fs?, C?, B).
con_beyond(Fs, eq(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
con_beyond(Fs, ne(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
con_beyond(Fs, le(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
con_beyond(Fs, lt(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
con_beyond(Fs, ge(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
con_beyond(Fs, gt(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
con_beyond(_, succ(_, _), no).
con_beyond(_, signed(_, _), no).
con_beyond(_, unsigned(_, _), no).
con_beyond(_, rel(_, _), yes).
%% program(u), that the value u is a program, is a relation of the constraint, local to every role and evaluated where the schema is bound (vGLP b413fe1, Section 5.4: "and program(u), that the value u is a program"); the printed text's con_holds.
con_beyond(_, program(_), no).
procedure exprs_beyond(FnDecls?, Expr?, Expr?, YesNo).
exprs_beyond(Fs, X, Y, B?) :- ground(Fs?) | expr_beyond(Fs?, X?, B1), expr_beyond(Fs?, Y?, B2), or(B1?, B2?, B).
procedure expr_beyond(FnDecls?, Expr?, YesNo).
expr_beyond(Fs, plus(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
%% The author and the item of a speech act are taken (vGLP 27bae5d, Section 5.4, "Speech-act schemas as local specifications": "a constraint ... is over the relations and functions the value types provide --- ...; the signer, the author and the item of a speech act, its last signer, its first signer and its utterance"; vGLP #24, Code_inbox.md, 2026-11-07 22:27 UTC, 20:36 item 1); a program condition is not, 5.4 naming a program among the values and not how the runtime recognises one.
expr_beyond(_, author_of(_), no).
expr_beyond(_, item_of(_), no).
expr_beyond(_, val(_), no).
%% A compound value is in no constraint the printed text evaluates, which compares numbers, persons, speech acts and community names: refused (vGLP #32; Bonds' constraints name a bond's maturity Day, a value variable, and no compound value).
expr_beyond(_, cmp(_, _), yes).
expr_beyond(Fs, minus(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
expr_beyond(Fs, mul(X, Y), B?) :- exprs_beyond(Fs?, X?, Y?, B).
%% A function the paper names, min or floor, is taken, and a count and a sum (vGLP 9ee6f87, Section 5.4: "over the relations and functions the value types provide --- comparison and arithmetic, min and floor, and signed(u, y) and unsigned(u, y) ... --- and over the count and the sum of the instances of a quantifier"); any other function is not.
expr_beyond(Fs, fn(F, Es), B?) :- ground(F?), ground(Es?), ground(Fs?) | exprs_count(Es?, 1, K), fn_named(F?, K?, Fs?, B0), exprl_beyond(Fs?, Es?, B1), or(B0?, B1?, B).
expr_beyond(Fs, cardinality(_, _, _, F), B?) :- form_beyond(Fs?, F?, B).
expr_beyond(Fs, sum(_, _, _, F, U), B?) :- ground(Fs?) | form_beyond(Fs?, F?, B1), expr_beyond(Fs?, U?, B2), or(B1?, B2?, B).
expr_beyond(_, role(_), no).
expr_beyond(_, pvar(_), no).
expr_beyond(_, svar(_), no).
expr_beyond(_, nterm(_), no).
expr_beyond(_, sgn(_, _), no).
expr_beyond(_, num(_), no).
expr_beyond(_, real(_), no).
%% A variable over the constants is num(X) to the checks (consts_off); the clause covers the type.
expr_beyond(_, const(_), no).
expr_beyond(_, set(_), no).
expr_beyond(_, any, no).
%% The place of a conjunct's instances is in no atom, constraint or request (cvac.glp, inst_heads); the clause covers the type.
expr_beyond(_, ilist(_, _), no).
procedure fn_named(Constant?, Integer?, FnDecls?, YesNo).
fn_named(min, _, _, no).
fn_named(floor, _, _, no).
%% The size of a set, |N| (GSC, def:numbers, the set variable).
fn_named(size, _, _, no).
%% A function the owner of a value type gives as a typed GLP procedure, of its arity, its value its last argument (vGLP, Section 5.4, "Speech-act schemas as local specifications": "any other relation or function of a value type, which the owner of the type gives as a typed GLP procedure that decides the relation or computes the function, and which the platform the compiler prints calls"; pragmas.sh, NAME-functions.glp).
fn_named(F, K, Fs, B?) :- otherwise | fn_given(F?, K?, Fs?, B).
procedure fn_given(Constant?, Integer?, FnDecls?, YesNo).
fn_given(_, _, [], yes).
fn_given(F, K, [fn(G, Ks, V)|_], B?) :- F? =?= G? | kinds_ok(Ks?, V?, 1, K?, B).
fn_given(F, K, [_|Fs], B?) :- otherwise | fn_given(F?, K?, Fs?, B).
%% Whether the function's places are of the arity K, its value last, each a number or a constant (FnKind); a place of another type the compiler does not take.
procedure kinds_ok(FnKinds?, FnKind?, Integer?, Integer?, YesNo).
kinds_ok([], other, _, _, yes).
kinds_ok([], _, J, K, no) :- otherwise, integer(J?), integer(K?), J? =?= K? | true.
kinds_ok([], _, _, _, yes) :- otherwise | true.
kinds_ok([other|_], _, _, _, yes).
kinds_ok([_|Ks], V, J, K, B?) :- otherwise, integer(J?) | J1 := J? + 1, kinds_ok(Ks?, V?, J1?, K?, B).
%% The arity of a function applied to the expressions, one more than their number, its value its last argument.
procedure exprs_count(Exprs?, Integer?, Integer).
exprs_count([], K, K?).
exprs_count([_|Es], K, N?) :- integer(K?) | K1 := K? + 1, exprs_count(Es?, K1?, N).
procedure exprl_beyond(FnDecls?, Exprs?, YesNo).
exprl_beyond(_, [], no).
exprl_beyond(Fs, [E|Es], B?) :- ground(Fs?) | expr_beyond(Fs?, E?, B1), exprl_beyond(Fs?, Es?, B2), or(B1?, B2?, B).
procedure forms_beyond(FnDecls?, Forms?, YesNo).
forms_beyond(_, [], no).
forms_beyond(Fs, [F|Gs], B?) :- ground(Fs?) | form_beyond(Fs?, F?, B1), forms_beyond(Fs?, Gs?, B2), or(B1?, B2?, B).
procedure form_beyond(FnDecls?, Form?, YesNo).
form_beyond(_, fa(_, _), no).
form_beyond(Fs, fnot(F), B?) :- form_beyond(Fs?, F?, B).
form_beyond(Fs, fand(F, G), B?) :- ground(Fs?) | form_beyond(Fs?, F?, B1), form_beyond(Fs?, G?, B2), or(B1?, B2?, B).
form_beyond(Fs, for(F, G), B?) :- ground(Fs?) | form_beyond(Fs?, F?, B1), form_beyond(Fs?, G?, B2), or(B1?, B2?, B).
form_beyond(Fs, fexists(_, _, _, F), B?) :- form_beyond(Fs?, F?, B).
form_beyond(Fs, fforall(_, _, _, F, Gs), B?) :- ground(Fs?) | form_beyond(Fs?, F?, B1), forms_beyond(Fs?, Gs?, B2), or(B1?, B2?, B).
form_beyond(Fs, fcons(C), B?) :- con_beyond(Fs?, C?, B).

%% A real variable, real(X) among a schema's variables, is num(X) to every check and every place of the shared text (reals_off), the schema writing num(X) in its atoms and its constraint; its type, Real, is printed from the table rl(S, X) (real_lx), into the class term, the request type and the atoms (real_heads, real_atoms): "a value variable, whose type, a whole number or a real, the schema writes with it" (vGLP fb40cff, Section 5.4, "Speech-act schemas as local specifications"; vGLP #24, Code_inbox.md, 2026-11-07, 5).
procedure reals_off(QContract?, QContract).
reals_off([], []).
reals_off([schema(S, Hd, Rs)|Ss], [schema(S?, Hd1?, Rs?)|Ns?]) :- nums_of(Hd?, Hd1), reals_off(Ss?, Ns).
reals_off([cschema(S, Hd, Rc, Rs)|Ss], [cschema(S?, Hd1?, Rc?, Rs?)|Ns?]) :- nums_of(Hd?, Hd1), reals_off(Ss?, Ns).
reals_off([nschema(S, Hd, Cn, Rs)|Ss], [nschema(S?, Hd1?, Cn?, Rs?)|Ns?]) :- nums_of(Hd?, Hd1), reals_off(Ss?, Ns).
reals_off([qschema(S, Hd, Bd, Cn, Rs, Cj, Fs)|Ss], [qschema(S?, Hd1?, Bd1?, Cn?, Rs?, Cj?, Fs?)|Ns?]) :- nums_of(Hd?, Hd1), nums_of(Bd?, Bd1), reals_off(Ss?, Ns).
procedure nums_of(Args?, Args).
nums_of([], []).
nums_of([real(X)|As], [num(X?)|Bs?]) :- nums_of(As?, Bs).
%% A variable over the constants is num(X) likewise, its type printed from the table cn(S, X) (consts_off, below).
nums_of([const(X)|As], [num(X?)|Bs?]) :- nums_of(As?, Bs).
%% A set variable stays set(X) in the head, so that no role takes it as local (local.glp, num_info_of), its atoms and its constraint writing num(X) (GSC, the checker's form).
nums_of([A|As], [A?|Bs?]) :- otherwise | nums_of(As?, Bs).
procedure real_lx(QContract?, Lxs).
real_lx([], []).
real_lx([schema(S, Hd, _)|Ss], L?) :- ground(S?) | hd_reals(Hd?, S?, L1), real_lx(Ss?, L2), app(L1?, L2?, L).
real_lx([cschema(S, Hd, _, _)|Ss], L?) :- ground(S?) | hd_reals(Hd?, S?, L1), real_lx(Ss?, L2), app(L1?, L2?, L).
real_lx([nschema(S, Hd, _, _)|Ss], L?) :- ground(S?) | hd_reals(Hd?, S?, L1), real_lx(Ss?, L2), app(L1?, L2?, L).
real_lx([qschema(S, Hd, _, _, _, _, _)|Ss], L?) :- ground(S?) | hd_reals(Hd?, S?, L1), real_lx(Ss?, L2), app(L1?, L2?, L).
procedure hd_reals(Args?, Constant?, Lxs).
hd_reals([], _, []).
hd_reals([real(X)|As], S, [rl(S?, X?)|L?]) :- ground(S?) | hd_reals(As?, S?, L).
hd_reals([const(X)|As], S, [cn(S?, X?)|L?]) :- ground(S?) | hd_reals(As?, S?, L).
hd_reals([set(X)|As], S, [st(S?, X?)|L?]) :- ground(S?) | hd_reals(As?, S?, L).
hd_reals([_|As], S, L?) :- otherwise | hd_reals(As?, S?, L).
%% The contract with each real variable of a schema's head written real(X) again, for the printers of the class term and the request type.
procedure real_heads(Contract?, Lxs?, Contract).
real_heads([], _, []).
real_heads([schema(S, Hd, Rs)|Ss], Lx, [schema(S?, Hd1?, Rs?)|Cs?]) :- ground(S?), ground(Lx?) |
    reals_of(Lx?, S?, Xs),
    reals_on(Hd?, Xs?, Hd0),
    consts_of(Lx?, S?, Ys),
    consts_on(Hd0?, Ys?, Hd1),
    real_heads(Ss?, Lx?, Cs).
real_heads([cschema(S, Hd, Rc, Rs)|Ss], Lx, [cschema(S?, Hd?, Rc?, Rs?)|Cs?]) :- real_heads(Ss?, Lx?, Cs).
real_heads([nschema(S, Hd, Cn, Rs)|Ss], Lx, [nschema(S?, Hd?, Cn?, Rs?)|Cs?]) :- real_heads(Ss?, Lx?, Cs).
procedure reals_of(Lxs?, Constant?, Preds).
reals_of([], _, []).
reals_of([rl(S1, X)|Lx], S, [X?|Xs?]) :- S1? =?= S? | reals_of(Lx?, S?, Xs).
reals_of([_|Lx], S, Xs?) :- otherwise | reals_of(Lx?, S?, Xs).
procedure reals_on(Args?, Preds?, Args).
reals_on([], _, []).
reals_on([num(X)|As], Xs, [A?|Bs?]) :- ground(X?), ground(Xs?) | mem(X?, Xs?, In), real_if(In?, X?, A), reals_on(As?, Xs?, Bs).
reals_on([A|As], Xs, [A?|Bs?]) :- otherwise | reals_on(As?, Xs?, Bs).
procedure real_if(YesNo?, Constant?, Arg).
real_if(yes, X, real(X?)).
real_if(no, X, num(X?)).
%% The atoms of a schema with each argument num(X) of a real variable X written real(X), for the type Atom.
procedure real_atoms(Atoms?, Preds?, Atoms).
real_atoms([], _, []).
real_atoms([M|Ms], Xs, [M1?|Ns?]) :- ground(Xs?) | real_atom(M?, Xs?, M1), real_atoms(Ms?, Xs?, Ns).
procedure real_atom(Atom?, Preds?, Atom).
real_atom(atom(F, As), Xs, atom(F?, As1?)) :- reals_on(As?, Xs?, As1).
real_atom(times(K, A), Xs, times(K?, A1?)) :- real_atom(A?, Xs?, A1).
real_atom(rest(K, J, A), Xs, rest(K?, J?, A1?)) :- real_atom(A?, Xs?, A1).
%% A variable over the constants, const(X) among a schema's variables (vGLP, Section 5.4, "Speech-act schemas as local specifications": "a value variable, whose type, a whole number, a real or a constant, the schema writes with it, a multiplicity and a count being whole numbers, and a variable over the constants taking the name its proposer types, as the name of the role to which an organisation appoints an officer, which another act requires as a constant the contract names"), is num(X) to every check and every place of the shared text, as a real variable is (reals_off): where the schema writes const(X) in an atom, a constraint or a safe formula, the compiler reads num(X) (consts_off, which decl_schemas calls), the variables of the head left as written for the table; its type, Constant, is printed from the table cn(S, X) (real_lx) into the class term and the request type (real_heads, consts_on) and into the atoms (contract_ratoms, const_atoms), its place in an atom of the kind const, as the place of a constant the contract names, val(C), so that the agent holds its value as v(C); and the shared text's lines const_only(L) are printed only for a contract with such a variable (const_lines).  GSC's form of it was not written when this was built (GSC-const): the compiler takes const(X) among the variables, and const(X) or num(X) where the variable occurs.
procedure consts_off(QContract?, QContract).
consts_off([], []).
consts_off([schema(S, Hd, Rs)|Ss], [schema(S?, Hd?, Rs1?)|Ns?]) :- co_roles(Rs?, Rs1), consts_off(Ss?, Ns).
consts_off([cschema(S, Hd, Rc, Rs)|Ss], [cschema(S?, Hd?, Rc?, Rs1?)|Ns?]) :- co_roles(Rs?, Rs1), consts_off(Ss?, Ns).
consts_off([nschema(S, Hd, Cn, Rs)|Ss], [nschema(S?, Hd?, Cn1?, Rs1?)|Ns?]) :- co_con(Cn?, Cn1), co_roles(Rs?, Rs1), consts_off(Ss?, Ns).
consts_off([qschema(S, Hd, Bd, Cn, Rs, Cj, Fs)|Ss], [qschema(S?, Hd?, Bd?, Cn1?, Rs1?, Cj1?, Fs1?)|Ns?]) :- co_con(Cn?, Cn1), co_roles(Rs?, Rs1), co_conjs(Cj?, Cj1), co_forms(Fs?, Fs1), consts_off(Ss?, Ns).
procedure co_arg(Arg?, Arg).
co_arg(const(X), num(X?)).
co_arg(set(X), num(X?)).
co_arg(item_of(A), item_of(A1?)) :- co_arg(A?, A1).
co_arg(A, A?) :- otherwise | true.
procedure co_args(Args?, Args).
co_args([], []).
co_args([A|As], [B?|Bs?]) :- co_arg(A?, B), co_args(As?, Bs).
procedure co_atom(Atom?, Atom).
co_atom(atom(F, As), atom(F?, Bs?)) :- co_args(As?, Bs).
co_atom(times(K, A), times(K1?, A1?)) :- co_arg(K?, K1), co_atom(A?, A1).
co_atom(rest(K, J, A), rest(K1?, J1?, A1?)) :- co_arg(K?, K1), co_arg(J?, J1), co_atom(A?, A1).
procedure co_atoms(Atoms?, Atoms).
co_atoms([], []).
co_atoms([A|As], [B?|Bs?]) :- co_atom(A?, B), co_atoms(As?, Bs).
procedure co_roles(RoleSpecs?, RoleSpecs).
co_roles([], []).
co_roles([rs(G, P, M, K, N)|Rs], [rs(G?, P1?, M1?, K1?, N1?)|Rs1?]) :- co_atoms(P?, P1), co_atoms(M?, M1), co_atoms(K?, K1), co_atoms(N?, N1), co_roles(Rs?, Rs1).
co_roles([crs(Kd, G, P, M, K, N)|Rs], [crs(Kd1?, G?, P1?, M1?, K1?, N1?)|Rs1?]) :- co_kind(Kd?, Kd1), co_atoms(P?, P1), co_atoms(M?, M1), co_atoms(K?, K1), co_atoms(N?, N1), co_roles(Rs?, Rs1).
procedure co_kind(RoleKind?, RoleKind).
co_kind(listed(I, R, As), listed(I?, R?, Bs?)) :- co_args(As?, Bs).
co_kind(qlisted(I, R, As, Xs), qlisted(I?, R?, Bs?, Xs?)) :- co_args(As?, Bs).
co_kind(seated(N, R), seated(N?, R?)).
co_kind(constituent(N, R), constituent(N?, R?)).
procedure co_con(Constraint?, Constraint).
co_con(true, true).
co_con(and(A, B), and(A1?, B1?)) :- co_con(A?, A1), co_con(B?, B1).
co_con(or(A, B), or(A1?, B1?)) :- co_con(A?, A1), co_con(B?, B1).
co_con(implies(A, B), implies(A1?, B1?)) :- co_con(A?, A1), co_con(B?, B1).
co_con(not(A), not(A1?)) :- co_con(A?, A1).
co_con(eq(X, Y), eq(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_con(ne(X, Y), ne(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_con(le(X, Y), le(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_con(lt(X, Y), lt(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_con(ge(X, Y), ge(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_con(gt(X, Y), gt(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_con(succ(X, Y), succ(X1?, Y1?)) :- co_arg(X?, X1), co_arg(Y?, Y1).
co_con(signed(U, Y), signed(U?, Y?)).
co_con(unsigned(U, Y), unsigned(U?, Y?)).
co_con(rel(R, Es), rel(R?, Es1?)) :- co_exprs(Es?, Es1).
co_con(program(E), program(E1?)) :- co_expr(E?, E1).
procedure co_exprs(Exprs?, Exprs).
co_exprs([], []).
co_exprs([E|Es], [E1?|Es1?]) :- co_expr(E?, E1), co_exprs(Es?, Es1).
procedure co_expr(Expr?, Expr).
co_expr(const(X), num(X?)).
co_expr(set(X), num(X?)).
co_expr(plus(X, Y), plus(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_expr(minus(X, Y), minus(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_expr(mul(X, Y), mul(X1?, Y1?)) :- co_expr(X?, X1), co_expr(Y?, Y1).
co_expr(fn(F, Es), fn(F?, Es1?)) :- co_exprs(Es?, Es1).
co_expr(cardinality(Xs, H, A, F), cardinality(Xs?, H?, A1?, F1?)) :- co_atom(A?, A1), co_form(F?, F1).
co_expr(sum(Xs, H, A, F, U), sum(Xs?, H?, A1?, F1?, U1?)) :- co_atom(A?, A1), co_form(F?, F1), co_expr(U?, U1).
co_expr(E, E?) :- otherwise | true.
procedure co_forms(Forms?, Forms).
co_forms([], []).
co_forms([F|Fs], [F1?|Fs1?]) :- co_form(F?, F1), co_forms(Fs?, Fs1).
procedure co_form(Form?, Form).
co_form(fa(H, M), fa(H?, M1?)) :- co_atom(M?, M1).
co_form(fnot(F), fnot(F1?)) :- co_form(F?, F1).
co_form(fand(F, G), fand(F1?, G1?)) :- co_form(F?, F1), co_form(G?, G1).
co_form(for(F, G), for(F1?, G1?)) :- co_form(F?, F1), co_form(G?, G1).
co_form(fexists(Xs, H, A, F), fexists(Xs?, H?, A1?, F1?)) :- co_atom(A?, A1), co_form(F?, F1).
co_form(fforall(Xs, H, A, F, Gs), fforall(Xs?, H?, A1?, F1?, Gs1?)) :- co_atom(A?, A1), co_form(F?, F1), co_forms(Gs?, Gs1).
co_form(fcons(C), fcons(C1?)) :- co_con(C?, C1).
procedure co_conjs(Conjuncts?, Conjuncts).
co_conjs([], []).
co_conjs([conjunct(Xs, I, A, F, CA, CD, Ls)|Cs], [conjunct(Xs?, I?, A1?, F1?, CA1?, CD1?, Ls1?)|Cs1?]) :- co_atom(A?, A1), co_form(F?, F1), co_hms(CA?, CA1), co_hms(CD?, CD1), co_forms(Ls?, Ls1), co_conjs(Cs?, Cs1).
procedure co_hms(HMults?, HMults).
co_hms([], []).
co_hms([hm(J, M)|Hs], [hm(J?, M1?)|Hs1?]) :- co_atom(M?, M1), co_hms(Hs?, Hs1).
%% The variables over the constants of the schema S, from the table (real_lx).
procedure consts_of(Lxs?, Constant?, Preds).
consts_of([], _, []).
consts_of([cn(S1, X)|Lx], S, [X?|Xs?]) :- S1? =?= S? | consts_of(Lx?, S?, Xs).
consts_of([_|Lx], S, Xs?) :- otherwise | consts_of(Lx?, S?, Xs).
%% The arguments with each num(X) of a variable X over the constants written const(X), for the printers of the class term, the request type and the type Atom.
procedure consts_on(Args?, Preds?, Args).
consts_on([], _, []).
consts_on([num(X)|As], Xs, [A?|Bs?]) :- ground(X?), ground(Xs?) | mem(X?, Xs?, In), const_if(In?, X?, A), consts_on(As?, Xs?, Bs).
consts_on([A|As], Xs, [A?|Bs?]) :- otherwise | consts_on(As?, Xs?, Bs).
procedure const_if(YesNo?, Constant?, Arg).
const_if(yes, X, const(X?)).
const_if(no, X, num(X?)).
procedure const_atoms(Atoms?, Preds?, Atoms).
const_atoms([], _, []).
const_atoms([M|Ms], Xs, [M1?|Ns?]) :- ground(Xs?) | const_atom(M?, Xs?, M1), const_atoms(Ms?, Xs?, Ns).
procedure const_atom(Atom?, Preds?, Atom).
const_atom(atom(F, As), Xs, atom(F?, As1?)) :- consts_on(As?, Xs?, As1).
const_atom(times(K, A), Xs, times(K?, A1?)) :- const_atom(A?, Xs?, A1).
const_atom(rest(K, J, A), Xs, rest(K?, J?, A1?)) :- const_atom(A?, Xs?, A1).
%% Whether the contract has a variable over the constants, by the table.
procedure lx_consts(Lxs?, YesNo).
lx_consts([], no).
lx_consts([cn(_, _)|_], yes).
lx_consts([_|Lx], B?) :- otherwise | lx_consts(Lx?, B).
%% Whether the contract has a set variable, by the table.
procedure lx_sets(Lxs?, YesNo).
lx_sets([], no).
lx_sets([st(_, _)|_], yes).
lx_sets([_|Lx], B?) :- otherwise | lx_sets(Lx?, B).
%% The shared text's lines, a line set_only(L) printed as L where the contract has a set variable and left out where it has none, and a line setless_only(L) the other way about, so that a platform with none prints what it printed before set variables were built.
%% The shared text's lines, a line fn_only(L) printed as L where the contract has functions the owner of a value type gives and left out where it has none, so that a platform with none prints what it printed before.
procedure fn_lines_in(Lines?, YesNo?, Lines).
fn_lines_in([], _, []).
fn_lines_in([fn_only(L)|Ls], yes, [L?|Ls1?]) :- fn_lines_in(Ls?, yes, Ls1).
fn_lines_in([fn_only(_)|Ls], no, Ls1?) :- fn_lines_in(Ls?, no, Ls1).
fn_lines_in([L|Ls], C, [L?|Ls1?]) :- otherwise | fn_lines_in(Ls?, C?, Ls1).
%% The functions the owner of a value type gives, of the contract's words (PFns).
procedure worded_fns(Words?, PFns).
worded_fns(words(pragmas(_, _, _, _, _, _, _, Fn), _, _, _, _), Fn?).
worded_fns(_, nofns) :- otherwise | true.
procedure fns_any(PFns?, YesNo).
fns_any(nofns, no).
fns_any(fns(_, _), yes).
%% The platform's call of each function the owner of a value type gives, owner_val and owner_term, then the owner's procedures, the lines of its file, which the platform carries (vGLP, Section 5.4, "Speech-act schemas as local specifications": "any other relation or function of a value type, which the owner of the type gives as a typed GLP procedure that decides the relation or computes the function, and which the platform the compiler prints calls"; pragmas.sh, NAME-functions.glp).
procedure owner_fn_lines(PFns?, Lines).
owner_fn_lines(nofns, []).
owner_fn_lines(fns(Fs0, Ls), L?) :- ground(Fs0?) |
    plain_fns(Fs0?, Fs),
    owner_fn_plain(Fs?, Ls?, L).
procedure owner_fn_plain(FnDecls?, Lines?, Lines).
owner_fn_plain(Fs, Ls, L?) :- ground(Fs?) |
    owner_calls(Fs?, num, 'owner_val', Lv),
    owner_calls(Fs?, const, 'owner_term', Lt),
    owner_wrappers(Fs?, Lw),
    lapp(Lw?, ['', '%% The functions the owner of the value types gives, its file NAME-functions.glp beside the contract.'|Ls?], L3),
    lapp(Lt?, ['owner_term(_, _, _, free) :- otherwise | true.'|L3?], L2),
    lapp(Lv?, ['owner_val(_, _, _, no_num) :- otherwise | true.', 'procedure owner_term(Constant?, Exprs?, Binding?, Found).'|L2?], L1),
    lapp(['', '%% The functions of the value types that their owner gives as typed GLP procedures: owner_val(F, Es, B, R), the value R of F at the values of Es under B, a number, and owner_term(F, Es, B, V), a constant; each argument a number or a constant by the type its procedure declares it, the value no_num or free where an argument has none.', 'procedure owner_val(Constant?, Exprs?, Binding?, NumRes).'], L1?, L).
%% The functions the platform calls: those whose arguments and value are each a number or a constant; a procedure of the file with a place of another type is carried and called by the owner's procedures alone, a constraint applying it being refused (kinds_ok).
procedure plain_fns(FnDecls?, FnDecls).
plain_fns([], []).
plain_fns([fn(F, Ks, V)|Fs], P?) :- ground(Ks?), ground(V?) | fn_plain([V?|Ks?], B), plain_fn(B?, fn(F?, Ks?, V?), Fs?, P).
procedure plain_fn(YesNo?, FnDecl?, FnDecls?, FnDecls).
plain_fn(yes, D, Fs, [D?|P?]) :- plain_fns(Fs?, P).
plain_fn(no, _, Fs, P?) :- plain_fns(Fs?, P).
procedure fn_plain(FnKinds?, YesNo).
fn_plain([], yes).
fn_plain([other|_], no).
fn_plain([_|Ks], B?) :- otherwise | fn_plain(Ks?, B).
%% The clauses of owner_val (a value of the kind num) or owner_term (const), one per function of that kind.
procedure owner_calls(FnDecls?, FnKind?, String?, Lines).
owner_calls([], _, _, []).
owner_calls([fn(F, Ks, V)|Fs], W, H, [T?|Ls?]) :- ground(F?), ground(Ks?), ground(W?), ground(H?), V? =?= W? | owner_call(H?, F?, Ks?, T), owner_calls(Fs?, W?, H?, Ls).
owner_calls([_|Fs], W, H, Ls?) :- otherwise | owner_calls(Fs?, W?, H?, Ls).
procedure owner_call(String?, Constant?, FnKinds?, String).
owner_call(H, F, Ks, T?) :- ground(H?), ground(F?), ground(Ks?) |
    term_to_string(F?, Fn1),
    term_to_string(F?, Fn2),
    kind_list(Ks?, 1, e, Le),
    joined(Le?, ', ', Es),
    kind_list(Ks?, 1, get, Lg),
    kind_list(Ks?, 1, a, La),
    sapp(La?, ['R'], La1),
    joined(La1?, ', ', As),
    string_concat(['owner_', Fn2?, '(', As?, ')'], Ca),
    sapp(Lg?, [Ca?], Lgc),
    joined(Lgc?, ', ', Bd),
    string_concat([H?, '(', Fn1?, ', [', Es?, '], B, R?) :- ground(B?) | ', Bd?, '.'], T).
%% Each function's own procedure, owner_F, taking the values of its arguments, as expr_val and expr_term give them, and calling the owner's procedure F.
procedure owner_wrappers(FnDecls?, Lines).
owner_wrappers([], []).
owner_wrappers([fn(F, Ks, V)|Fs], [D?, C?|L?]) :- ground(F?), ground(Ks?), ground(V?) |
    owner_decl(F?, Ks?, V?, D),
    owner_clause(F?, Ks?, V?, C),
    owner_rest(F?, Ks?, V?, L0),
    owner_wrappers(Fs?, L1),
    lapp(L0?, L1?, L).
procedure owner_decl(Constant?, FnKinds?, FnKind?, String).
owner_decl(F, Ks, V, D?) :- ground(F?), ground(Ks?), ground(V?) |
    term_to_string(F?, Fn),
    kind_list(Ks?, 1, ty, Lt),
    val_kind(ty, V?, Vt),
    sapp(Lt?, [Vt?], Lt1),
    joined(Lt1?, ', ', Ts),
    string_concat(['procedure owner_', Fn?, '(', Ts?, ').'], D).
procedure owner_clause(Constant?, FnKinds?, FnKind?, String).
owner_clause(F, Ks, V, C?) :- ground(F?), ground(Ks?), ground(V?) |
    term_to_string(F?, Fn1),
    term_to_string(F?, Fn2),
    kind_list(Ks?, 1, pat, Lp),
    val_kind(pat, V?, Vp),
    sapp(Lp?, [Vp?], Lp1),
    joined(Lp1?, ', ', Ps),
    kind_list(Ks?, 1, guard, Lg),
    guards_of(Lg?, Gs),
    kind_list(Ks?, 1, x, Lx),
    sapp(Lx?, ['R'], Lx1),
    joined(Lx1?, ', ', Xs),
    string_concat(['owner_', Fn1?, '(', Ps?, ')', Gs?, Fn2?, '(', Xs?, ').'], C).
procedure owner_rest(Constant?, FnKinds?, FnKind?, Lines).
owner_rest(_, [], _, []).
owner_rest(F, [K|Ks], V, [C?]) :- ground(F?), ground(V?) |
    term_to_string(F?, Fn),
    kind_list([K?|Ks?], 1, us, Lu),
    val_kind(none, V?, Vn),
    sapp(Lu?, [Vn?], Lu1),
    joined(Lu1?, ', ', Us),
    string_concat(['owner_', Fn?, '(', Us?, ') :- otherwise | true.'], C).
%% The parts of the lines of a function, one per argument, I its place: its expression E<I>, the goal taking its value A<I>, that value, its type, its pattern X<I>, its guard, X<I> read, and _.
procedure kind_list(FnKinds?, Integer?, Constant?, Strings).
kind_list([], _, _, []).
kind_list([K|Ks], I, W, [S?|Ss?]) :- integer(I?), ground(K?), ground(W?) | kind_part(W?, K?, I?, S), I1 := I? + 1, kind_list(Ks?, I1?, W?, Ss).
procedure kind_part(Constant?, FnKind?, Integer?, String).
kind_part(W, K, I, S?) :- integer(I?) | term_to_string(I?, Is), part_of(W?, K?, Is?, S).
procedure part_of(Constant?, FnKind?, String?, String).
part_of(e, _, Is, S?) :- string_concat(['E', Is?], S).
part_of(get, num, Is, S?) :- ground(Is?) | string_concat(['expr_val(E', Is?, '?, B?, A', Is?, ')'], S).
part_of(get, const, Is, S?) :- ground(Is?) | string_concat(['expr_term(E', Is?, '?, B?, A', Is?, ')'], S).
part_of(a, _, Is, S?) :- string_concat(['A', Is?, '?'], S).
part_of(ty, num, _, 'NumRes?').
part_of(ty, const, _, 'Found?').
part_of(pat, num, Is, S?) :- string_concat(['num_is(X', Is?, ')'], S).
part_of(pat, const, Is, S?) :- string_concat(['found(v(X', Is?, '))'], S).
part_of(guard, num, Is, S?) :- string_concat(['integer(X', Is?, '?)'], S).
part_of(guard, const, Is, S?) :- string_concat(['ground(X', Is?, '?)'], S).
part_of(x, _, Is, S?) :- string_concat(['X', Is?, '?'], S).
part_of(us, _, _, '_').
part_of(_, _, _, '') :- otherwise | true.
%% The same parts of a function's value.
procedure val_kind(Constant?, FnKind?, String).
val_kind(ty, num, 'NumRes').
val_kind(ty, const, 'Found').
val_kind(pat, num, 'num_is(R?)').
val_kind(pat, const, 'found(v(R?))').
val_kind(none, num, 'no_num').
val_kind(none, const, 'free').
val_kind(_, _, '') :- otherwise | true.
procedure guards_of(Strings?, String).
guards_of([], ' :- ').
guards_of([G|Gs], S?) :- joined([G?|Gs?], ', ', S0), string_concat([' :- ', S0?, ' | '], S).
%% The strings joined, P between each two.
procedure joined(Strings?, String?, String).
joined([], _, '').
joined([S], _, S?).
joined([S, T|Ss], P, J?) :- ground(P?) | joined([T?|Ss?], P?, J1), string_concat([S?, P?, J1?], J).
procedure set_lines(Lines?, YesNo?, Lines).
set_lines([], _, []).
set_lines([set_only(L)|Ls], yes, [L?|Ls1?]) :- set_lines(Ls?, yes, Ls1).
set_lines([set_only(_)|Ls], no, Ls1?) :- set_lines(Ls?, no, Ls1).
set_lines([setless_only(_)|Ls], yes, Ls1?) :- set_lines(Ls?, yes, Ls1).
set_lines([setless_only(L)|Ls], no, [L?|Ls1?]) :- set_lines(Ls?, no, Ls1).
set_lines([L|Ls], C, [L?|Ls1?]) :- otherwise | set_lines(Ls?, C?, Ls1).
%% The shared text's lines, a line const_only(L) printed as L where the contract has a variable over the constants and left out where it has none, and a line constless_only(L) the other way about, so that a platform with none prints what it printed before such variables were built.
procedure const_lines(Lines?, YesNo?, Lines).
const_lines([], _, []).
const_lines([const_only(L)|Ls], yes, [L?|Ls1?]) :- const_lines(Ls?, yes, Ls1).
const_lines([const_only(_)|Ls], no, Ls1?) :- const_lines(Ls?, no, Ls1).
const_lines([constless_only(_)|Ls], yes, Ls1?) :- const_lines(Ls?, yes, Ls1).
const_lines([constless_only(L)|Ls], no, [L?|Ls1?]) :- const_lines(Ls?, no, Ls1).
const_lines([L|Ls], C, [L?|Ls1?]) :- otherwise | const_lines(Ls?, C?, Ls1).
%% The compound values the contract names (GSC compound values, GLP c28d1c7: val(F, Args) read as cmp(F, Args)), each cs(F, Ks), F its function symbol and Ks the kinds of its arguments, as Bonds' bond(Day), cs(bond, [num]), the type of a note due Day.
CShape  ::= cs(Constant, Kinds).
CShapes ::= [] ; [CShape | CShapes].
procedure contract_cmps(Contract?, Lxs?, CShapes).
contract_cmps(C, Lx, R?) :- contract_ratoms(C?, Lx?, As), atoms_cmps(As?, R0), dedup(R0?, R).
procedure atoms_cmps(Atoms?, CShapes).
atoms_cmps([], []).
atoms_cmps([atom(_, Xs)|As], R?) :- args_cmps(Xs?, R1), atoms_cmps(As?, R2), app(R1?, R2?, R).
atoms_cmps([times(_, A)|As], R?) :- atoms_cmps([A?|As?], R).
atoms_cmps([rest(_, _, A)|As], R?) :- atoms_cmps([A?|As?], R).
procedure args_cmps(Args?, CShapes).
args_cmps([], []).
args_cmps([cmp(F, Bs)|Xs], [cs(F?, Ks?)|R?]) :- ground(Bs?) | arg_kinds(Bs?, Ks), args_cmps(Bs?, R1), args_cmps(Xs?, R2), app(R1?, R2?, R).
args_cmps([_|Xs], R?) :- otherwise | args_cmps(Xs?, R).
procedure cmps_any(CShapes?, YesNo, CShapes).
cmps_any([], no, []).
cmps_any([G|Gs], yes, [G?|Gs?]).
%% The type of the values over the constants: Constant, or CValue, the constants and the compound values the contract names, where it names one.
procedure ct_name(YesNo?, String).
ct_name(no, 'Constant').
ct_name(yes, 'CValue').
%% Where the contract names a compound value, the places of the kind const are of the type CValue.
procedure sigs_cval(YesNo?, Sigs?, Sigs).
sigs_cval(no, Gs, Gs?).
sigs_cval(yes, Gs, R?) :- sigs_cval1(Gs?, R).
procedure sigs_cval1(Sigs?, Sigs).
sigs_cval1([], []).
sigs_cval1([sig(F, Ks)|Gs], [sig(F?, Ks1?)|R?]) :- kinds_cval(Ks?, Ks1), sigs_cval1(Gs?, R).
procedure kinds_cval(Kinds?, Kinds).
kinds_cval([], []).
kinds_cval([const|Ks], [cval|R?]) :- kinds_cval(Ks?, R).
kinds_cval([u(Us)|Ks], [u(Us1?)|R?]) :- kinds_cval(Us?, Us1), kinds_cval(Ks?, R).
kinds_cval([K|Ks], [K?|R?]) :- otherwise | kinds_cval(Ks?, R).
%% The shared text's lines, a line cmp_only(L) printed as L where the contract names a compound value and left out where it names none, and a line cmpless_only(L) the other way about, so that a platform with none prints what it printed before compound values were built.
procedure cmp_lines(Lines?, YesNo?, Lines).
cmp_lines([], _, []).
cmp_lines([cmp_only(L)|Ls], yes, [L?|Ls1?]) :- cmp_lines(Ls?, yes, Ls1).
cmp_lines([cmp_only(_)|Ls], no, Ls1?) :- cmp_lines(Ls?, no, Ls1).
cmp_lines([cmpless_only(_)|Ls], yes, Ls1?) :- cmp_lines(Ls?, yes, Ls1).
cmp_lines([cmpless_only(L)|Ls], no, [L?|Ls1?]) :- cmp_lines(Ls?, no, Ls1).
cmp_lines([L|Ls], C, [L?|Ls1?]) :- otherwise | cmp_lines(Ls?, C?, Ls1).
%% The type of the values over the constants, CValue ::= Constant ; f(T1, ..., Tk) for each compound value the contract names, and the agent's procedures taking such a value apart and building it: cval_split(T, F, Vs), F the function symbol of T and Vs the values of its arguments, a constant being its own symbol with none; cval_join(F, Vs, T) the converse (GSC compound values: "bound argument by argument to cmpv(F, Vals), matched by the same function symbol, printed f(t1, ..., tk)").
procedure cval_lines(CShapes?, Lines).
cval_lines([], []).
cval_lines([G|Gs], ['', '%% The values over the constants: the constants and the compound values the contract names (GSC compound values; vGLP #32).', D?, '', 'procedure cval_split(CValue?, Constant, Vals).'|L?]) :- ground(G?), ground(Gs?) |
    shapes_alts([G?|Gs?], As),
    alts_text(As?, Ab),
    string_concat(['CValue ::= Constant', Ab?, '.'], D),
    split_lines([G?|Gs?], L1),
    join_lines([G?|Gs?], L2),
    lapp(L1?, ['cval_split(C, C?, []) :- constant(C?) | true.', '', 'procedure cval_join(CValue?, Vals?, CValue).'|L2?], L3),
    lapp(L3?, ['cval_join(F, _, F?) :- otherwise | true.'], L).
procedure shapes_alts(CShapes?, Strings).
shapes_alts([], []).
shapes_alts([cs(F, Ks)|Gs], [A?|As?]) :- ground(F?), ground(Ks?) | kinds_cval(Ks?, Ks1), kind_types(Ks1?, Ts), named_call(F?, Ts?, A), shapes_alts(Gs?, As).
procedure alts_text(Strings?, String).
alts_text([], '').
alts_text([A|As], T?) :- alts_text(As?, T1), string_concat([' ; ', A?, T1?], T).
procedure split_lines(CShapes?, Lines).
split_lines([], []).
split_lines([cs(F, Ks)|Gs], [T?|L?]) :- ground(F?), ground(Ks?) |
    kinds_cval(Ks?, Ks1),
    kinds_cval(Ks?, Ks2),
    reader_vals(Ks1?, 1, Ws),
    env_names(Ks2?, 1, Ns),
    named_call(F?, Ns?, In),
    term_to_string(F?, Ft),
    list_text(Ws?, Wl),
    call_text(cval_split, [In?, Ft?, Wl?], T0),
    string_concat([T0?, '.'], T),
    split_lines(Gs?, L).
procedure join_lines(CShapes?, Lines).
join_lines([], []).
join_lines([cs(F, Ks)|Gs], [T?|L?]) :- ground(F?), ground(Ks?) |
    kinds_cval(Ks?, Ks1),
    kind_vals(Ks1?, 1, Ws, Qs),
    named_call(F?, Qs?, Out),
    term_to_string(F?, Ft),
    list_text(Ws?, Wl),
    call_text(cval_join, [Ft?, Wl?, Out?], T0),
    string_concat([T0?, '.'], T),
    join_lines(Gs?, L).
%% The schemas, each listed role's arguments taken whole: listed(B, Rho, As), As the anchor's arguments after its holder with the listed role itself, role(I), among them, at its place (norm_roles); GSC's reader writes the role at the anchor's second argument without it, listed(B, Rho, [u_2, ..., u_r]), and a role elsewhere among the arguments as qlisted(B, Rho, As, [role(I)]), which q_roles takes as it is, "the variable at any of the anchor's arguments" (vGLP b413fe1, Section 5.4, "Speech-act schemas as local specifications").
%% A wildcard in an atom a role requires, or in the anchor of a quantifier, is a variable of its own (wild_schemas, below), so the schemas every procedure of the compiler reads are those with each such wildcard written as that variable.
procedure decl_schemas(Declared?, QContract).
decl_schemas(D, R?) :- ground(D?) |
    decl_norm(D?, C00),
    bound_kinds(C00?, C01),
    bound_kinds(C01?, C0),
    wild_twice_c(C0?, Ca, Cb),
    wild_table(Ca?, Gs),
    wild_schemas(Cb?, Gs?, R).
procedure wild_twice_c(QContract?, QContract, QContract).
wild_twice_c(C, C?, C?) :- ground(C?) | true.
procedure decl_norm(Declared?, QContract).
decl_norm([], []).
decl_norm([S|Ss], R?) :- norm_schemas([S?|Ss?], R0), consts_off(R0?, R).
decl_norm(reflexive(_, C), R?) :- norm_schemas(C?, R0), consts_off(R0?, R).
procedure norm_schemas(QContract?, QContract).
norm_schemas([], []).
norm_schemas([schema(S, Hd, Rs)|Ss], [schema(S?, Hd?, Rs1?)|R?]) :- norm_roles(Rs?, 1, Rs1), norm_schemas(Ss?, R).
norm_schemas([cschema(S, Hd, X, Rs)|Ss], [cschema(S?, Hd?, X?, Rs1?)|R?]) :- norm_roles(Rs?, 1, Rs1), norm_schemas(Ss?, R).
norm_schemas([nschema(S, Hd, C, Rs)|Ss], [nschema(S?, Hd?, C?, Rs1?)|R?]) :- norm_roles(Rs?, 1, Rs1), norm_schemas(Ss?, R).
norm_schemas([qschema(S, Hd, Bd, C, Rs, Cj, Fs)|Ss], [qschema(S?, Hd?, Bd?, C?, Rs1?, Cj?, Fs?)|R?]) :- norm_roles(Rs?, 1, Rs1), norm_schemas(Ss?, R).
procedure norm_roles(RoleSpecs?, Integer?, RoleSpecs).
norm_roles([], _, []).
norm_roles([crs(listed(B, Rho, As), G, A, D, K, F)|Rs], I, [crs(listed(B?, Rho?, As1?), G?, A?, D?, K?, F?)|Rs1?]) :- integer(I?), ground(As?) |
    mem(role(I?), As?, In),
    role_in(In?, I?, As?, As1),
    I1 := I? + 1,
    norm_roles(Rs?, I1?, Rs1).
norm_roles([R|Rs], I, [R?|Rs1?]) :- otherwise, integer(I?) | I1 := I? + 1, norm_roles(Rs?, I1?, Rs1).
procedure role_in(YesNo?, Integer?, Args?, Args).
role_in(yes, _, As, As?).
role_in(no, I, As, [role(I?)|As?]).
%% --- The variables a quantifier binds, each of the kind of its place -----------
%% vGLP, Section 5.4, "Speech-act schemas as local specifications": "an instance of it in a state is an assignment of the variables it binds under which that person holds the anchor and the condition phi holds", every variable a quantifier binds occurring among its anchor's arguments ("A an atom, the quantifier's anchor, among whose arguments every variable of x occurs").  GSC's reader writes a variable a quantifier binds as a speech-act variable, svar(X), unless the schema writes it a number or it holds an atom (programs/gsc/self.glp); the printed text matches a speech-act variable with a speech act alone (kind_ok), so one standing at a person's place of its anchor matched no atom, and "Bob is a guardian of no one", not exists G1 has_guardian(Bob, G1), held in every state.  So a variable a quantifier binds is written of the kind of the place it stands at in its anchor, before any procedure reads the contract (bound_kinds): an agent variable, pvar(X), at a person's place, and a value variable, num(X), at a number's, through the quantifier's scope, its anchor, its condition and its conclusion or conditional literals; the kind of the place is the one the other atoms of the contract give it, the variables that quantifiers bind in their own anchors giving none (bk_masked).  It is done twice, so that a place typed only by a variable another quantifier binds, as that of a conditional literal, has its kind by then.  Refused, with the line (bound_faults): a variable a quantifier binds, still written a speech-act variable, at a place of its anchor that is not a speech act's, no other atom of the contract typing the place, the variable standing at places of two kinds, the place a constant's, a community name's, an item's or a real's, or its kind following only from a longer chain of quantifiers.
%% A quantifier that binds a listed role, fforall([role(I)], ...) and conjunct([role(I)], ...), binds a role, and is as it is.
Sb    ::= sb(Constant, Arg).
Sbs   ::= [] ; [Sb | Sbs].
BMode ::= mask ; kinds(Sigs).
procedure bound_kinds(QContract?, QContract).
bound_kinds(C, R?) :- ground(C?) |
    bk_schemas(C?, mask, Cm),
    wild_table(Cm?, T),
    bk_schemas(C?, kinds(T?), R).
%% The contract with, under mask, each variable a quantifier binds, written svar(X), the wildcard in its anchor, so that the anchor gives its place no type; and, under kinds(T), each written of the kind the table T gives its place.
procedure bk_schemas(QContract?, BMode?, QContract).
bk_schemas([], _, []).
bk_schemas([schema(S, Hd, Rs)|Ss], Md, [schema(S?, Hd?, Rs?)|Ns?]) :- bk_schemas(Ss?, Md?, Ns).
bk_schemas([cschema(S, Hd, X, Rs)|Ss], Md, [cschema(S?, Hd?, X?, Rs?)|Ns?]) :- bk_schemas(Ss?, Md?, Ns).
bk_schemas([nschema(S, Hd, C, Rs)|Ss], Md, [nschema(S?, Hd?, C1?, Rs?)|Ns?]) :- ground(Md?) | bk_con(C?, Md?, C1), bk_schemas(Ss?, Md?, Ns).
bk_schemas([qschema(S, Hd, Bd, C, Rs, Cj, Fs)|Ss], Md, [qschema(S?, Hd?, Bd?, C1?, Rs?, Cj1?, Fs1?)|Ns?]) :- ground(Md?) |
    bk_con(C?, Md?, C1),
    bk_conjs(Cj?, Md?, Cj1),
    bk_forms(Fs?, Md?, Fs1),
    bk_schemas(Ss?, Md?, Ns).
procedure bk_conjs(Conjuncts?, BMode?, Conjuncts).
bk_conjs([], _, []).
bk_conjs([conjunct([role(I)], Bi, A, Phi, CA, CD, Lits)|Cs], Md, [conjunct([role(I?)], Bi?, A?, Phi1?, CA?, CD?, Lits?)|Cs1?]) :- ground(Md?) |
    bk_form(Phi?, Md?, Phi1),
    bk_conjs(Cs?, Md?, Cs1).
bk_conjs([conjunct(Xs, Bi, A, Phi, CA, CD, Lits)|Cs], Md, [conjunct(Xs1?, Bi?, A1?, Phi1?, CA1?, CD1?, Lits1?)|Cs1?]) :- otherwise, ground(Md?) |
    bk_bind(Md?, Xs?, A?, Xs1, A1, Sb),
    bk_conj(Sb?, Md?, Phi?, CA?, CD?, Lits?, Phi1, CA1, CD1, Lits1),
    bk_conjs(Cs?, Md?, Cs1).
procedure bk_conj(Sbs?, BMode?, Form?, HMults?, HMults?, Forms?, Form, HMults, HMults, Forms).
bk_conj(Sb, Md, Phi, CA, CD, Lits, Phi1?, CA1?, CD1?, Lits1?) :- ground(Sb?) |
    sb_form(Phi?, Sb?, Phi0),
    bk_form(Phi0?, Md?, Phi1),
    sb_hms(CA?, Sb?, CA1),
    sb_hms(CD?, Sb?, CD1),
    sb_forms(Lits?, Sb?, Lits1).
procedure bk_forms(Forms?, BMode?, Forms).
bk_forms([], _, []).
bk_forms([F|Fs], Md, [F1?|Fs1?]) :- ground(Md?) | bk_form(F?, Md?, F1), bk_forms(Fs?, Md?, Fs1).
procedure bk_form(Form?, BMode?, Form).
bk_form(fa(H, M), _, fa(H?, M?)).
bk_form(fcons(C), Md, fcons(C1?)) :- bk_con(C?, Md?, C1).
bk_form(fnot(F), Md, fnot(F1?)) :- bk_form(F?, Md?, F1).
bk_form(fand(F, G), Md, fand(F1?, G1?)) :- ground(Md?) | bk_form(F?, Md?, F1), bk_form(G?, Md?, G1).
bk_form(for(F, G), Md, for(F1?, G1?)) :- ground(Md?) | bk_form(F?, Md?, F1), bk_form(G?, Md?, G1).
bk_form(fexists(Xs, H, A, F), Md, fexists(Xs1?, H?, A1?, F1?)) :- ground(Md?) |
    bk_bind(Md?, Xs?, A?, Xs1, A1, Sb),
    sb_form(F?, Sb?, F0),
    bk_form(F0?, Md?, F1).
bk_form(fforall([role(I)], H, A, F, Ps), Md, fforall([role(I?)], H?, A?, F1?, Ps1?)) :- ground(Md?) |
    bk_form(F?, Md?, F1),
    bk_forms(Ps?, Md?, Ps1).
bk_form(fforall(Xs, H, A, F, Ps), Md, fforall(Xs1?, H?, A1?, F1?, Ps1?)) :- otherwise, ground(Md?) |
    bk_bind(Md?, Xs?, A?, Xs1, A1, Sb),
    bk_scope(Sb?, Md?, F?, Ps?, F1, Ps1).
procedure bk_scope(Sbs?, BMode?, Form?, Forms?, Form, Forms).
bk_scope(Sb, Md, F, Ps, F1?, Ps1?) :- ground(Sb?), ground(Md?) |
    sb_form(F?, Sb?, F0),
    bk_form(F0?, Md?, F1),
    sb_forms(Ps?, Sb?, Ps0),
    bk_forms(Ps0?, Md?, Ps1).
procedure bk_con(Constraint?, BMode?, Constraint).
bk_con(and(A, B), Md, and(A1?, B1?)) :- ground(Md?) | bk_con(A?, Md?, A1), bk_con(B?, Md?, B1).
bk_con(or(A, B), Md, or(A1?, B1?)) :- ground(Md?) | bk_con(A?, Md?, A1), bk_con(B?, Md?, B1).
bk_con(implies(A, B), Md, implies(A1?, B1?)) :- ground(Md?) | bk_con(A?, Md?, A1), bk_con(B?, Md?, B1).
bk_con(not(A), Md, not(A1?)) :- bk_con(A?, Md?, A1).
bk_con(eq(X, Y), Md, eq(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_con(ne(X, Y), Md, ne(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_con(le(X, Y), Md, le(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_con(lt(X, Y), Md, lt(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_con(ge(X, Y), Md, ge(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_con(gt(X, Y), Md, gt(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_con(rel(R, Es), Md, rel(R?, Es1?)) :- bk_exprs(Es?, Md?, Es1).
bk_con(program(E), Md, program(E1?)) :- bk_expr(E?, Md?, E1).
bk_con(C, _, C?) :- otherwise | true.
procedure bk_exprs(Exprs?, BMode?, Exprs).
bk_exprs([], _, []).
bk_exprs([E|Es], Md, [E1?|Es1?]) :- ground(Md?) | bk_expr(E?, Md?, E1), bk_exprs(Es?, Md?, Es1).
procedure bk_expr(Expr?, BMode?, Expr).
bk_expr(plus(X, Y), Md, plus(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_expr(minus(X, Y), Md, minus(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_expr(mul(X, Y), Md, mul(X1?, Y1?)) :- ground(Md?) | bk_expr(X?, Md?, X1), bk_expr(Y?, Md?, Y1).
bk_expr(fn(F, Es), Md, fn(F?, Es1?)) :- bk_exprs(Es?, Md?, Es1).
bk_expr(cardinality(Xs, H, A, F), Md, cardinality(Xs1?, H?, A1?, F1?)) :- ground(Md?) |
    bk_bind(Md?, Xs?, A?, Xs1, A1, Sb),
    sb_form(F?, Sb?, F0),
    bk_form(F0?, Md?, F1).
bk_expr(sum(Xs, H, A, F, U), Md, sum(Xs1?, H?, A1?, F1?, U1?)) :- ground(Md?) |
    bk_bind(Md?, Xs?, A?, Xs1, A1, Sb),
    bk_sum(Sb?, Md?, F?, U?, F1, U1).
bk_expr(E, _, E?) :- otherwise | true.
procedure bk_sum(Sbs?, BMode?, Form?, Expr?, Form, Expr).
bk_sum(Sb, Md, F, U, F1?, U1?) :- ground(Sb?), ground(Md?) |
    sb_form(F?, Sb?, F0),
    bk_form(F0?, Md?, F1),
    sb_expr(U?, Sb?, U0),
    bk_expr(U0?, Md?, U1).
%% The variables Xs a quantifier binds and its anchor A: under mask, the anchor with each svar(X) of Xs the wildcard, and nothing more; under kinds(T), each svar(X) of Xs that stands at a person's place of A an agent variable, and at a number's a value variable, in Xs and in A, and the substitution for the rest of the quantifier's scope.
procedure bk_bind(BMode?, Args?, Atom?, Args, Atom, Sbs).
bk_bind(mask, Xs, A, Xs?, A1?, []) :- ground(Xs?) |
    mask_subs(Xs?, Sm),
    sb_atom(A?, Sm?, A1).
bk_bind(kinds(T), Xs, A, Xs1?, A1?, Sb?) :- ground(Xs?), ground(A?) |
    kind_subs(Xs?, A?, T?, Sb0),
    bk_bind1(Sb0?, Xs?, A?, Xs1, A1, Sb).
procedure bk_bind1(Sbs?, Args?, Atom?, Args, Atom, Sbs).
bk_bind1(Sb, Xs, A, Xs1?, A1?, Sb?) :- ground(Sb?) | sb_args(Xs?, Sb?, Xs1), sb_atom(A?, Sb?, A1).
procedure mask_subs(Args?, Sbs).
mask_subs([], []).
mask_subs([svar(N)|Xs], [sb(N?, any)|S?]) :- mask_subs(Xs?, S).
mask_subs([_|Xs], S?) :- otherwise | mask_subs(Xs?, S).
procedure kind_subs(Args?, Atom?, Sigs?, Sbs).
kind_subs(Xs, atom(F, As), T, S?) :- ground(F?), ground(As?) |
    place_kinds(F?, As?, T?, Ks),
    kind_subs1(Xs?, As?, Ks?, S).
kind_subs(_, times(_, _), _, []).
kind_subs(_, rest(_, _, _), _, []).
procedure kind_subs1(Args?, Args?, Kinds?, Sbs).
kind_subs1([], _, _, []).
kind_subs1([svar(N)|Xs], As, Ks, S?) :- ground(N?), ground(As?), ground(Ks?) |
    var_kind(As?, Ks?, N?, K),
    kind_sub(K?, N?, S1),
    kind_subs1(Xs?, As?, Ks?, S2),
    app(S1?, S2?, S).
kind_subs1([_|Xs], As, Ks, S?) :- otherwise | kind_subs1(Xs?, As?, Ks?, S).
%% The kind of the first place of As at which svar(N) stands; wild where it stands at none.
procedure var_kind(Args?, Kinds?, Constant?, Kind).
var_kind([], _, _, wild).
var_kind([svar(M)|_], [K|_], N, K?) :- M? =?= N? | true.
var_kind([_|As], [_|Ks], N, K?) :- otherwise | var_kind(As?, Ks?, N?, K).
var_kind([_|_], [], _, wild).
procedure kind_sub(Kind?, Constant?, Sbs).
kind_sub(peer, N, [sb(N?, pvar(N?))]) :- ground(N?) | true.
kind_sub(num, N, [sb(N?, num(N?))]) :- ground(N?) | true.
kind_sub(_, _, []) :- otherwise | true.
%% The substitution Sb, svar(X) to its argument, through an argument, an atom, a literal, a safe formula, a constraint and an expression.
procedure sb_arg(Arg?, Sbs?, Arg).
sb_arg(svar(N), Sb, A?) :- sb_look(Sb?, N?, A).
sb_arg(item_of(X), Sb, item_of(X1?)) :- sb_arg(X?, Sb?, X1).
sb_arg(A, _, A?) :- otherwise | true.
procedure sb_look(Sbs?, Constant?, Arg).
sb_look([], N, svar(N?)).
sb_look([sb(M, A)|_], N, A?) :- M? =?= N? | true.
sb_look([_|Sb], N, A?) :- otherwise | sb_look(Sb?, N?, A).
procedure sb_args(Args?, Sbs?, Args).
sb_args([], _, []).
sb_args([A|As], Sb, [B?|Bs?]) :- ground(Sb?) | sb_arg(A?, Sb?, B), sb_args(As?, Sb?, Bs).
procedure sb_atom(Atom?, Sbs?, Atom).
sb_atom(atom(F, As), Sb, atom(F?, Bs?)) :- sb_args(As?, Sb?, Bs).
sb_atom(times(K, A), Sb, times(K1?, A1?)) :- ground(Sb?) | sb_arg(K?, Sb?, K1), sb_atom(A?, Sb?, A1).
sb_atom(rest(K, J, A), Sb, rest(K1?, J1?, A1?)) :- ground(Sb?) | sb_arg(K?, Sb?, K1), sb_arg(J?, Sb?, J1), sb_atom(A?, Sb?, A1).
procedure sb_hms(HMults?, Sbs?, HMults).
sb_hms([], _, []).
sb_hms([hm(J, M)|Hs], Sb, [hm(J?, M1?)|Hs1?]) :- ground(Sb?) | sb_atom(M?, Sb?, M1), sb_hms(Hs?, Sb?, Hs1).
procedure sb_forms(Forms?, Sbs?, Forms).
sb_forms([], _, []).
sb_forms([F|Fs], Sb, [F1?|Fs1?]) :- ground(Sb?) | sb_form(F?, Sb?, F1), sb_forms(Fs?, Sb?, Fs1).
procedure sb_form(Form?, Sbs?, Form).
sb_form(F, [], F?).
sb_form(fa(H, M), [S|Sb], fa(H1?, M1?)) :- ground(S?), ground(Sb?) | sb_arg(H?, [S?|Sb?], H1), sb_atom(M?, [S?|Sb?], M1).
sb_form(fnot(F), [S|Sb], fnot(F1?)) :- sb_form(F?, [S?|Sb?], F1).
sb_form(fand(F, G), [S|Sb], fand(F1?, G1?)) :- ground(S?), ground(Sb?) | sb_form(F?, [S?|Sb?], F1), sb_form(G?, [S?|Sb?], G1).
sb_form(for(F, G), [S|Sb], for(F1?, G1?)) :- ground(S?), ground(Sb?) | sb_form(F?, [S?|Sb?], F1), sb_form(G?, [S?|Sb?], G1).
sb_form(fexists(Xs, H, A, F), [S|Sb], fexists(Xs?, H1?, A1?, F1?)) :- ground(S?), ground(Sb?) |
    sb_arg(H?, [S?|Sb?], H1), sb_atom(A?, [S?|Sb?], A1), sb_form(F?, [S?|Sb?], F1).
sb_form(fforall(Xs, H, A, F, Ps), [S|Sb], fforall(Xs?, H1?, A1?, F1?, Ps1?)) :- ground(S?), ground(Sb?) |
    sb_arg(H?, [S?|Sb?], H1), sb_atom(A?, [S?|Sb?], A1), sb_form(F?, [S?|Sb?], F1), sb_forms(Ps?, [S?|Sb?], Ps1).
sb_form(fcons(C), [S|Sb], fcons(C1?)) :- sb_con(C?, [S?|Sb?], C1).
procedure sb_con(Constraint?, Sbs?, Constraint).
sb_con(true, _, true).
sb_con(and(A, B), Sb, and(A1?, B1?)) :- ground(Sb?) | sb_con(A?, Sb?, A1), sb_con(B?, Sb?, B1).
sb_con(or(A, B), Sb, or(A1?, B1?)) :- ground(Sb?) | sb_con(A?, Sb?, A1), sb_con(B?, Sb?, B1).
sb_con(implies(A, B), Sb, implies(A1?, B1?)) :- ground(Sb?) | sb_con(A?, Sb?, A1), sb_con(B?, Sb?, B1).
sb_con(not(A), Sb, not(A1?)) :- sb_con(A?, Sb?, A1).
sb_con(eq(X, Y), Sb, eq(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_con(ne(X, Y), Sb, ne(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_con(le(X, Y), Sb, le(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_con(lt(X, Y), Sb, lt(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_con(ge(X, Y), Sb, ge(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_con(gt(X, Y), Sb, gt(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_con(succ(X, Y), Sb, succ(X1?, Y1?)) :- ground(Sb?) | sb_arg(X?, Sb?, X1), sb_arg(Y?, Sb?, Y1).
sb_con(signed(U, Y), Sb, signed(U1?, Y?)) :- sb_arg(U?, Sb?, U1).
sb_con(unsigned(U, Y), Sb, unsigned(U1?, Y?)) :- sb_arg(U?, Sb?, U1).
sb_con(rel(R, Es), Sb, rel(R?, Es1?)) :- sb_exprs(Es?, Sb?, Es1).
sb_con(program(E), Sb, program(E1?)) :- sb_expr(E?, Sb?, E1).
procedure sb_exprs(Exprs?, Sbs?, Exprs).
sb_exprs([], _, []).
sb_exprs([E|Es], Sb, [E1?|Es1?]) :- ground(Sb?) | sb_expr(E?, Sb?, E1), sb_exprs(Es?, Sb?, Es1).
procedure sb_expr(Expr?, Sbs?, Expr).
sb_expr(svar(N), Sb, A?) :- sb_look(Sb?, N?, A).
sb_expr(plus(X, Y), Sb, plus(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_expr(minus(X, Y), Sb, minus(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_expr(mul(X, Y), Sb, mul(X1?, Y1?)) :- ground(Sb?) | sb_expr(X?, Sb?, X1), sb_expr(Y?, Sb?, Y1).
sb_expr(fn(F, Es), Sb, fn(F?, Es1?)) :- sb_exprs(Es?, Sb?, Es1).
sb_expr(cardinality(Xs, H, A, F), Sb, cardinality(Xs?, H1?, A1?, F1?)) :- ground(Sb?) |
    sb_arg(H?, Sb?, H1), sb_atom(A?, Sb?, A1), sb_form(F?, Sb?, F1).
sb_expr(sum(Xs, H, A, F, U), Sb, sum(Xs?, H1?, A1?, F1?, U1?)) :- ground(Sb?) |
    sb_arg(H?, Sb?, H1), sb_atom(A?, Sb?, A1), sb_form(F?, Sb?, F1), sb_expr(U?, Sb?, U1).
sb_expr(author_of(Y), Sb, author_of(Y1?)) :- sb_arg(Y?, Sb?, Y1).
sb_expr(item_of(Y), Sb, item_of(Y1?)) :- sb_arg(Y?, Sb?, Y1).
sb_expr(E, _, E?) :- otherwise | true.
%% Whether a variable a quantifier binds is still written svar(X) at a place of its anchor that is not a speech act's by the other atoms of the contract (bk_masked's table): the schemas with one, each with the line.
procedure bound_faults(QContract?, Lines).
bound_faults(C, L?) :- ground(C?) |
    bk_schemas(C?, mask, Cm),
    wild_table(Cm?, T),
    bound_faults1(C?, T?, L).
procedure bound_faults1(QContract?, Sigs?, Lines).
bound_faults1([], _, []).
bound_faults1([nschema(S, _, C, _)|Ss], T, L?) :- ground(S?), ground(T?) |
    bq_con(C?, Qs),
    bq_bad(Qs?, T?, B),
    bound_lines(B?, S?, L1),
    bound_faults1(Ss?, T?, L2),
    lapp(L1?, L2?, L).
bound_faults1([qschema(S, _, _, C, _, Cj, Fs)|Ss], T, L?) :- ground(S?), ground(T?) |
    bq_con(C?, Q1),
    bq_conjs(Cj?, Q2),
    bq_forms(Fs?, Q3),
    app(Q2?, Q3?, Q23),
    app(Q1?, Q23?, Qs),
    bq_bad(Qs?, T?, B),
    bound_lines(B?, S?, L1),
    bound_faults1(Ss?, T?, L2),
    lapp(L1?, L2?, L).
bound_faults1([_|Ss], T, L?) :- otherwise | bound_faults1(Ss?, T?, L).
procedure bound_lines(YesNo?, Constant?, Lines).
bound_lines(no, _, []).
bound_lines(yes, S, ['%% it has a variable a quantifier binds, written as a speech-act variable, at a place of its anchor that is not a speech act\'s: "an instance of it in a state is an assignment of the variables it binds under which that person holds the anchor" (vGLP, Section 5.4, "Speech-act schemas as local specifications"), so the variable is of the kind of its place, a person at a person\'s and a number at a number\'s, and here no other atom of the contract gives the place a type, or the variable stands at places of two kinds, or the place is a constant\'s, a community name\'s, an item\'s or a real\'s, of which the compiler carries no variable a quantifier binds, or its kind follows only from a chain of quantifiers longer than the compiler follows:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
%% The quantifiers, but those binding a listed role: qa(Xs, A), the variables one binds and its anchor.
QA  ::= qa(Args, Atom).
QAs ::= [] ; [QA | QAs].
procedure bq_conjs(Conjuncts?, QAs).
bq_conjs([], []).
bq_conjs([conjunct([role(_)], _, _, Phi, _, _, _)|Cs], Q?) :- bq_form(Phi?, Q1), bq_conjs(Cs?, Q2), app(Q1?, Q2?, Q).
bq_conjs([conjunct(Xs, _, A, Phi, _, _, _)|Cs], [qa(Xs?, A?)|Q?]) :- otherwise | bq_form(Phi?, Q1), bq_conjs(Cs?, Q2), app(Q1?, Q2?, Q).
procedure bq_forms(Forms?, QAs).
bq_forms([], []).
bq_forms([F|Fs], Q?) :- bq_form(F?, Q1), bq_forms(Fs?, Q2), app(Q1?, Q2?, Q).
procedure bq_form(Form?, QAs).
bq_form(fa(_, _), []).
bq_form(fcons(C), Q?) :- bq_con(C?, Q).
bq_form(fnot(F), Q?) :- bq_form(F?, Q).
bq_form(fand(F, G), Q?) :- bq_form(F?, Q1), bq_form(G?, Q2), app(Q1?, Q2?, Q).
bq_form(for(F, G), Q?) :- bq_form(F?, Q1), bq_form(G?, Q2), app(Q1?, Q2?, Q).
bq_form(fexists(Xs, _, A, F), [qa(Xs?, A?)|Q?]) :- bq_form(F?, Q).
bq_form(fforall([role(_)], _, _, F, Ps), Q?) :- bq_form(F?, Q1), bq_forms(Ps?, Q2), app(Q1?, Q2?, Q).
bq_form(fforall(Xs, _, A, F, Ps), [qa(Xs?, A?)|Q?]) :- otherwise | bq_form(F?, Q1), bq_forms(Ps?, Q2), app(Q1?, Q2?, Q).
procedure bq_con(Constraint?, QAs).
bq_con(and(A, B), Q?) :- bq_con(A?, Q1), bq_con(B?, Q2), app(Q1?, Q2?, Q).
bq_con(or(A, B), Q?) :- bq_con(A?, Q1), bq_con(B?, Q2), app(Q1?, Q2?, Q).
bq_con(implies(A, B), Q?) :- bq_con(A?, Q1), bq_con(B?, Q2), app(Q1?, Q2?, Q).
bq_con(not(A), Q?) :- bq_con(A?, Q).
bq_con(eq(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_con(ne(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_con(le(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_con(lt(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_con(ge(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_con(gt(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_con(rel(_, Es), Q?) :- bq_exprs(Es?, Q).
bq_con(program(E), Q?) :- bq_expr(E?, Q).
bq_con(C, []) :- otherwise, ground(C?) | true.
procedure bq_exprs(Exprs?, QAs).
bq_exprs([], []).
bq_exprs([E|Es], Q?) :- bq_expr(E?, Q1), bq_exprs(Es?, Q2), app(Q1?, Q2?, Q).
procedure bq_expr(Expr?, QAs).
bq_expr(plus(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_expr(minus(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_expr(mul(X, Y), Q?) :- bq_expr(X?, Q1), bq_expr(Y?, Q2), app(Q1?, Q2?, Q).
bq_expr(fn(_, Es), Q?) :- bq_exprs(Es?, Q).
bq_expr(cardinality(Xs, _, A, F), [qa(Xs?, A?)|Q?]) :- bq_form(F?, Q).
bq_expr(sum(Xs, _, A, F, U), [qa(Xs?, A?)|Q?]) :- bq_form(F?, Q1), bq_expr(U?, Q2), app(Q1?, Q2?, Q).
bq_expr(E, []) :- otherwise, ground(E?) | true.
procedure bq_bad(QAs?, Sigs?, YesNo).
bq_bad([], _, no).
bq_bad([qa(Xs, atom(F, As))|Qs], T, B?) :- ground(Xs?), ground(F?), ground(As?), ground(T?) |
    sb_masked(As?, Xs?, Am),
    place_kinds(F?, Am?, T?, Ks),
    bq_args(As?, Ks?, Xs?, B1),
    bq_bad(Qs?, T?, B2),
    or(B1?, B2?, B).
bq_bad([_|Qs], T, B?) :- otherwise | bq_bad(Qs?, T?, B).
procedure sb_masked(Args?, Args?, Args).
sb_masked(As, Xs, Am?) :- mask_subs(Xs?, Sm), sb_args(As?, Sm?, Am).
%% Whether an argument svar(X), X of Xs, stands at a place whose kind is not speech.
procedure bq_args(Args?, Kinds?, Args?, YesNo).
bq_args([], _, _, no).
bq_args([svar(N)|As], [K|Ks], Xs, B?) :- ground(N?), ground(K?), ground(Xs?) |
    mem(svar(N?), Xs?, In),
    not_speech(K?, Ns),
    and(In?, Ns?, B1),
    bq_args(As?, Ks?, Xs?, B2),
    or(B1?, B2?, B).
bq_args([_|As], [_|Ks], Xs, B?) :- otherwise | bq_args(As?, Ks?, Xs?, B).
bq_args([_|_], [], _, no).
procedure not_speech(Kind?, YesNo).
not_speech(speech, no).
not_speech(_, yes) :- otherwise | true.
%% --- The wildcard in an unnegated atom --------------------------------------
%% vGLP, Section 5.4, "Speech-act schemas as local specifications": "a wildcard in a negated atom is universally quantified, the atom forbidding, in B, and clearing, in H, every atom of the state that it matches ...; a wildcard in an unnegated atom of B, or in the anchor of a quantifier, is a variable of its own, standing for some value: the machine of the person who holds the atom finds one in its state, and the act neither names nor records it, as an act that requires a bond of some maturity" (GSC, programs/gsc/self.glp: "In an unnegated atom it is a variable of its own, one per occurrence").
%% (1) A wildcard among the arguments of an atom a role requires, an agent role or a listed role, is written as a variable of the schema that no atom of it names, '_1', '_2', ..., in the order of the schema, of the kind its place has (wild_made), and listed in the schema's head: it occurs in that one atom, required at one role, so it is local to that role (local.glp, locals_of: "A variable that occurs only in atoms the schema requires or deletes at one role ... is local to that role"), "a schema-binding does not bind a local variable: the machine of the person in that role finds a value for it in its own state", the class term and the request do not name it, no field is for it, and, no atom added or deleted naming it, the effect does not depend on it.
%% (2) A wildcard among the arguments of the anchor of a quantifier of a safe formula, or of a quantified conjunct that binds no listed role, is written as such a variable among the variables its quantifier binds: the printed text matches the anchor into the state of its holder under the binding, which leaves the variable free, so it matches any value (the printed text's match_into); an instance of a conjunct is "restricted to the variables the conjunct's literals name and without repetition" (hm_named; the printed text's inst_at), and no literal names the variable.
%% (3) A wildcard among the arguments of the anchor of a listed role stays the wildcard, the anchor being no atom the printed text matches: the people of the role are those at the role's place of the atoms of the anchor's predicate in the base's state whose other arguments are the image of the anchor's, the wildcard met by any value, each person once (the printed text's list_at, vals_meet; listed_wild).
%% (4) A wildcard in a negated atom, forbidden or cleared, is as it was, and so is one in the name term N._: the printed text has the atom forbid, and clear, every atom of the state that its image matches (forb_held, held_one and forb_meets; clear_out), the wildcard no variable (vars_bound).  A wildcard in an atom of a safe formula that is not the anchor of a quantifier makes the atom the quantifier exists Ws (M) (wild_fa), so that the atom holds where the state has an atom it matches, and its negation where it has none.  Refused with the reason (wild_faults): a wildcard at an argument of a predicate to which no other atom of the contract gives a type; one in a required atom, an anchor or an atom of a safe formula at an argument that is a community name or an item, or, in an anchor that is not a listed role's or in an atom of a safe formula, a constant or a real, a variable a quantifier binds not being carried as one (a wildcard at a constant's place in an atom a role requires is a variable over the constants, const(X), and in a listed role's anchor it stays the wildcard, (3)); one in the anchor of a count or a sum, or in an atom of its condition.  A wildcard in the anchor of a quantifier that binds a listed role in a safe formula across roles, of the part's condition, is carried: the reading of the base holds the atoms of its state the anchor matches, the wildcard matching any value, as a variable a quantifier binds does, and the people the quantifier ranges over are those the attempt lists, each once (vGLP, Section 5.4: "a wildcard in an unnegated atom of B, or in the anchor of a quantifier, is a variable of its own"; GSNW's and CSSN's Retire, member(Carol, _, E), Calculus #6 and Helper #4, vGLP_inbox, 2026-11-15 21:44 and 21:47 UTC; refused until then).
%% The types of the arguments of the contract's predicates, a signature for each predicate and number of arguments, the wildcard's place taking the type another atom of the contract gives it, and wild where none does (wild_sigs), a person where one atom writes a person and another a variable a quantifier binds (peer_sigs).
procedure wild_table(QContract?, Sigs).
wild_table(C, Gs?) :- ground(C?) |
    q_all_atoms(C?, As),
    q_all_atoms(C?, As2),
    atom_sigs(As?, Gs0a),
    atoms_cmps(As2?, Cs),
    cmp_sigs(Cs?, Gs0b),
    app(Gs0a?, Gs0b?, Gs0),
    dedup(Gs0?, Gs1),
    wild_sigs(Gs1?, Gs2),
    peer_sigs_all(Gs2?, Gs).
%% Every atom the schemas write: those of their roles, the anchors of their listed roles, and those of their constraints, conjuncts and safe formulas, each argument of a real variable written real(X) and each of a variable over the constants const(X).
procedure q_all_atoms(QContract?, Atoms).
q_all_atoms([], []).
q_all_atoms([S|Ss], As?) :- qs_atoms(S?, A1), q_all_atoms(Ss?, A2), app(A1?, A2?, As).
procedure qs_atoms(QSchema?, Atoms).
qs_atoms(schema(_, Hd, Rs), As?) :- ground(Hd?) | qr_atoms(Rs?, yes, A0), hd_real_names(Hd?, Xs), real_atoms(A0?, Xs?, Ar), hd_const_names(Hd?, Cs), const_atoms(Ar?, Cs?, As).
qs_atoms(cschema(_, Hd, _, Rs), As?) :- ground(Hd?) | qr_atoms(Rs?, yes, A0), hd_real_names(Hd?, Xs), real_atoms(A0?, Xs?, Ar), hd_const_names(Hd?, Cs), const_atoms(Ar?, Cs?, As).
qs_atoms(nschema(_, Hd, C, Rs), As?) :- ground(Hd?) |
    qr_atoms(Rs?, yes, A1),
    c_atoms(C?, A2),
    app(A1?, A2?, A0),
    hd_real_names(Hd?, Xs),
    real_atoms(A0?, Xs?, Ar), hd_const_names(Hd?, Cs), const_atoms(Ar?, Cs?, As).
qs_atoms(qschema(_, Hd, _, C, Rs, Cj, Fs), As?) :- ground(Hd?) |
    qr_atoms(Rs?, yes, A1),
    c_atoms(C?, A2),
    cj_atoms(Cj?, yes, A3),
    fs_atoms(Fs?, A4),
    app(A3?, A4?, A34),
    app(A2?, A34?, A24),
    app(A1?, A24?, A0),
    hd_real_names(Hd?, Xs),
    real_atoms(A0?, Xs?, Ar), hd_const_names(Hd?, Cs), const_atoms(Ar?, Cs?, As).
%% The atoms of the roles, with the atoms they delete (yes) or without (no), and the anchors of the listed roles.
procedure qr_atoms(RoleSpecs?, YesNo?, Atoms).
qr_atoms([], _, []).
qr_atoms([R|Rs], Dl, As?) :- ground(R?), ground(Dl?) |
    rs_lists(R?, P, M, K, N),
    deleted_if(Dl?, M?, M1),
    listed_anchor(R?, A0),
    qr_atoms(Rs?, Dl?, A5),
    app(N?, A5?, A4),
    app(K?, A4?, A3),
    app(M1?, A3?, A2),
    app(P?, A2?, A1),
    app(A0?, A1?, As).
procedure deleted_if(YesNo?, Atoms?, Atoms).
deleted_if(yes, M, M?).
deleted_if(no, _, []).
procedure listed_anchor(RoleSpec?, Atoms).
listed_anchor(crs(listed(_, Rho, As), _, _, _, _, _), [atom(Rho?, As?)]).
listed_anchor(crs(qlisted(_, Rho, As, _), _, _, _, _, _), [atom(Rho?, As?)]).
listed_anchor(_, []) :- otherwise | true.
%% The atoms of the conjuncts: their anchors, those of their conditions and their conditional literals added, and, with yes, those deleted and those of their literals.
procedure cj_atoms(Conjuncts?, YesNo?, Atoms).
cj_atoms([], _, []).
cj_atoms([conjunct(_, _, A, Phi, CA, CD, Lits)|Cs], Dl, [A?|As?]) :- ground(Dl?) |
    f_atoms(Phi?, A1),
    hm_atoms(CA?, A2),
    cj_deleted(Dl?, CD?, Lits?, A3),
    cj_atoms(Cs?, Dl?, A4),
    app(A3?, A4?, A34),
    app(A2?, A34?, A24),
    app(A1?, A24?, As).
procedure cj_deleted(YesNo?, HMults?, Forms?, Atoms).
cj_deleted(yes, CD, Lits, As?) :- hm_atoms(CD?, A1), fs_atoms(Lits?, A2), app(A1?, A2?, As).
cj_deleted(no, _, _, []).
%% The variables over the constants of a schema's head, const(X), which its atoms write num(X) (consts_off): their places are of the kind const (const_atoms).
procedure hd_const_names(Args?, Preds).
hd_const_names([], []).
hd_const_names([const(X)|As], [X?|Xs?]) :- hd_const_names(As?, Xs).
hd_const_names([set(X)|As], [X?|Xs?]) :- hd_const_names(As?, Xs).
hd_const_names([_|As], Xs?) :- otherwise | hd_const_names(As?, Xs).
procedure hd_real_names(Args?, Preds).
hd_real_names([], []).
hd_real_names([real(X)|As], [X?|Xs?]) :- hd_real_names(As?, Xs).
hd_real_names([_|As], Xs?) :- otherwise | hd_real_names(As?, Xs).
%% Each signature with the type another signature of its predicate and number of arguments gives a place where it has wild.
procedure wild_sigs(Sigs?, Sigs).
wild_sigs(Gs, R?) :- ground(Gs?) | wild_fill(Gs?, Gs?, R).
procedure wild_fill(Sigs?, Sigs?, Sigs).
wild_fill([], _, []).
wild_fill([sig(F, Ks)|Gs], All, [sig(F?, Ks1?)|Gs1?]) :- ground(F?), ground(Ks?), ground(All?) |
    wild_kinds(All?, F?, Ks?, Ks1),
    wild_fill(Gs?, All?, Gs1).
procedure wild_kinds(Sigs?, Constant?, Kinds?, Kinds).
wild_kinds([], _, Ks, Ks?).
wild_kinds([sig(G, Js)|Gs], F, Ks, R?) :- G? =?= F?, ground(Js?), ground(Ks?) |
    same_len(Ks?, Js?, B),
    wild_zip(B?, Ks?, Js?, Ks1),
    wild_kinds(Gs?, F?, Ks1?, R).
wild_kinds([_|Gs], F, Ks, R?) :- otherwise | wild_kinds(Gs?, F?, Ks?, R).
%% Ks with the kind of Js, of its length, at each place where it has wild.
procedure wild_zip(YesNo?, Kinds?, Kinds?, Kinds).
wild_zip(no, Ks, _, Ks?).
wild_zip(yes, [], _, []).
wild_zip(yes, [wild|Ks], [J|Js], [J?|R?]) :- wild_zip(yes, Ks?, Js?, R).
wild_zip(yes, [K|Ks], [_|Js], [K?|R?]) :- otherwise | wild_zip(yes, Ks?, Js?, R).
%% The signatures with no place wild: one with a place still wild is of an atom no state holds, a cleared conditional literal, or of a contract refused (wild_faults).
procedure unwild(Sigs?, Sigs).
unwild([], []).
unwild([sig(F, Ks)|Gs], R?) :- ground(F?), ground(Ks?) |
    mem(wild, Ks?, W),
    unwild(Gs?, R1),
    drop_sig(W?, sig(F?, Ks?), R1?, R).
procedure drop_sig(YesNo?, Sig?, Sigs?, Sigs).
drop_sig(yes, _, R, R?).
drop_sig(no, G, R, [G?|R?]).
%% The kinds of the arguments As of the predicate F by the table: those of its signature of that many arguments, and those the arguments write where the table has none.
procedure place_kinds(Constant?, Args?, Sigs?, Kinds).
place_kinds(_, As, [], Ks?) :- arg_kinds(As?, Ks).
place_kinds(F, As, [sig(G, Js)|Gs], Ks?) :- G? =?= F?, ground(As?), ground(Js?) |
    arg_kinds(As?, Ks0),
    same_len(Ks0?, Js?, B),
    place_kinds1(B?, F?, As?, Js?, Gs?, Ks).
place_kinds(F, As, [_|Gs], Ks?) :- otherwise | place_kinds(F?, As?, Gs?, Ks).
procedure place_kinds1(YesNo?, Constant?, Args?, Kinds?, Sigs?, Kinds).
place_kinds1(yes, _, _, Js, _, Js?).
place_kinds1(no, F, As, _, Gs, Ks?) :- place_kinds(F?, As?, Gs?, Ks).
%% The schemas with each wildcard of a required atom a variable of the head, and each wildcard of an anchor a variable its quantifier binds, numbered through the schema.
procedure wild_schemas(QContract?, Sigs?, QContract).
wild_schemas([], _, []).
wild_schemas([schema(S, Hd, Rs)|Ss], Gs, [schema(S?, Hd1?, Rs1?)|Ns?]) :- ground(Gs?) |
    wild_roles(Rs?, Gs?, 1, Rs1, _, Vs),
    app(Hd?, Vs?, Hd1),
    wild_schemas(Ss?, Gs?, Ns).
wild_schemas([cschema(S, Hd, X, Rs)|Ss], Gs, [cschema(S?, Hd1?, X?, Rs1?)|Ns?]) :- ground(Gs?) |
    wild_roles(Rs?, Gs?, 1, Rs1, _, Vs),
    app(Hd?, Vs?, Hd1),
    wild_schemas(Ss?, Gs?, Ns).
wild_schemas([nschema(S, Hd, C, Rs)|Ss], Gs, [nschema(S?, Hd1?, C?, Rs1?)|Ns?]) :- ground(Gs?) |
    wild_roles(Rs?, Gs?, 1, Rs1, _, Vs),
    app(Hd?, Vs?, Hd1),
    wild_schemas(Ss?, Gs?, Ns).
wild_schemas([qschema(S, Hd, Bd, C, Rs, Cj, Fs)|Ss], Gs, [qschema(S?, Hd1?, Bd1?, C?, Rs1?, Cj1?, Fs1?)|Ns?]) :- ground(Gs?) |
    wild_roles(Rs?, Gs?, 1, Rs1, K1, Vs),
    app(Hd?, Vs?, Hd1),
    wild_conjs(Cj?, Gs?, K1?, Cj1, K2, B1),
    wild_forms(Fs?, Gs?, K2?, Fs1, _, B2),
    app(B1?, B2?, B12),
    app(Bd?, B12?, Bd1),
    wild_schemas(Ss?, Gs?, Ns).
procedure wild_roles(RoleSpecs?, Sigs?, Integer?, RoleSpecs, Integer, Args).
wild_roles([], _, K, [], K?, []).
wild_roles([rs(G, P, M, Kp, N)|Rs], Gs, K, [rs(G?, P?, M?, Kp1?, N?)|Rs1?], K2?, Vs?) :- ground(Gs?) |
    wild_atoms(Kp?, Gs?, head, K?, Kp1, K1, V1),
    wild_roles(Rs?, Gs?, K1?, Rs1, K2, V2),
    app(V1?, V2?, Vs).
wild_roles([crs(Kd, G, P, M, Kp, N)|Rs], Gs, K, [crs(Kd?, G?, P?, M?, Kp1?, N?)|Rs1?], K2?, Vs?) :- ground(Gs?) |
    wild_atoms(Kp?, Gs?, head, K?, Kp1, K1, V1),
    wild_roles(Rs?, Gs?, K1?, Rs1, K2, V2),
    app(V1?, V2?, Vs).
%% head: a variable of the schema's head, of an atom a role requires; bound: a variable a quantifier binds, of its anchor.
WMode ::= head ; bound.
procedure wild_atoms(Atoms?, Sigs?, WMode?, Integer?, Atoms, Integer, Args).
wild_atoms([], _, _, K, [], K?, []).
wild_atoms([A|As], Gs, Md, K, [A1?|As1?], K2?, Vs?) :- ground(Gs?), ground(Md?) |
    wild_atom(A?, Gs?, Md?, K?, A1, K1, V1),
    wild_atoms(As?, Gs?, Md?, K1?, As1, K2, V2),
    app(V1?, V2?, Vs).
%% An atom with a multiplicity carries no wildcard (programs/gsc/self.glp, multiplicity_wildcard), and is as it is.
procedure wild_atom(Atom?, Sigs?, WMode?, Integer?, Atom, Integer, Args).
wild_atom(atom(F, As), Gs, Md, K, atom(F?, As1?), K1?, Vs?) :- ground(F?), ground(As?), ground(Gs?) |
    place_kinds(F?, As?, Gs?, Ks),
    wild_args(As?, Ks?, Gs?, Md?, K?, As1, K1, Vs).
wild_atom(times(M, A), _, _, K, times(M?, A?), K?, []).
wild_atom(rest(M, J, A), _, _, K, rest(M?, J?, A?), K?, []).
procedure wild_args(Args?, Kinds?, Sigs?, WMode?, Integer?, Args, Integer, Args).
wild_args([], _, _, _, K, [], K?, []).
wild_args([any|As], [Kd|Ks], Gs, Md, K, [A?|As1?], K2?, Vs?) :- ground(Md?) |
    wild_var(Kd?, Md?, K?, A, K1, V1),
    wild_args(As?, Ks?, Gs?, Md?, K1?, As1, K2, V2),
    app(V1?, V2?, Vs).
%% A wildcard among the arguments of a compound value is a variable of the kind of its place in that compound value, as the contract writes the compound value elsewhere (cmp_sigs), as a bond of any maturity, bond(_), where another act names bond(Day).
wild_args([cmp(F, Bs)|As], [_|Ks], Gs, Md, K, [cmp(F?, Bs1?)|As1?], K2?, Vs?) :- ground(F?), ground(Bs?), ground(Gs?), ground(Md?) |
    cmp_key(F?, Ky),
    place_kinds(Ky?, Bs?, Gs?, Js),
    wild_args(Bs?, Js?, Gs?, Md?, K?, Bs1, K1, V1),
    wild_args(As?, Ks?, Gs?, Md?, K1?, As1, K2, V2),
    app(V1?, V2?, Vs).
wild_args([A|As], [_|Ks], Gs, Md, K, [A?|As1?], K1?, Vs?) :- otherwise | wild_args(As?, Ks?, Gs?, Md?, K?, As1, K1, Vs).
wild_args([A|As], [], _, _, K, [A?|As?], K?, []).
%% The kinds of the arguments of each compound value, as a signature keyed by its function symbol (cmp_key), among the signatures of the predicates (wild_table).
procedure cmp_sigs(CShapes?, Sigs).
cmp_sigs([], []).
cmp_sigs([cs(F, Ks)|Cs], [sig(Ky?, Ks?)|Gs?]) :- cmp_key(F?, Ky), cmp_sigs(Cs?, Gs).
procedure cmp_key(Constant?, Constant).
cmp_key(F, Ky?) :- ground(F?) | term_to_string(F?, Ft), string_concat(['cmp ', Ft?], Ky).
%% The K-th wildcard of a schema as a variable of the kind of its place, '_K': an agent variable at a person's place, a speech-act variable at a speech act's, a value variable at a number's, a real one, in the head, at a real's; a variable over the constants, in the head, at a constant's; and the wildcard still, where its place has no type (wild), or is a community name's or an item's, or, in an anchor, a constant's or a real's (wild_faults).
procedure wild_var(Kind?, WMode?, Integer?, Arg, Integer, Args).
wild_var(Kd, Md, K, A?, K1?, Vs?) :- integer(K?) |
    term_to_string(K?, Kt),
    string_concat(['_', Kt?], N),
    wild_made(Kd?, Md?, N?, A, Vs),
    K1 := K? + 1.
procedure wild_made(Kind?, WMode?, Constant?, Arg, Args).
wild_made(peer, _, N, pvar(N?), [pvar(N?)]) :- ground(N?) | true.
wild_made(speech, _, N, svar(N?), [svar(N?)]) :- ground(N?) | true.
wild_made(num, _, N, num(N?), [num(N?)]) :- ground(N?) | true.
wild_made(real, head, N, num(N?), [real(N?)]) :- ground(N?) | true.
wild_made(real, bound, _, any, []).
wild_made(name, _, _, any, []).
wild_made(item, _, _, any, []).
%% A variable over the constants, const(X) in the head and num(X) in the atom, as the schemas write one (consts_off).
wild_made(const, head, N, num(N?), [const(N?)]) :- ground(N?) | true.
wild_made(const, bound, _, any, []).
wild_made(cval, head, N, num(N?), [const(N?)]) :- ground(N?) | true.
wild_made(cval, bound, _, any, []).
wild_made(wild, _, _, any, []).
%% A union of kinds is only in the signatures the type Atom is printed from (merge_sigs); the clause covers the type.
wild_made(u(_), _, _, any, []).
%% The conjuncts: one binding a listed role, conjunct([role(I)], ...), with its anchor as it is (3), and the anchors of its condition (2); any other with its anchor's wildcards among the variables it binds.
procedure wild_conjs(Conjuncts?, Sigs?, Integer?, Conjuncts, Integer, Args).
wild_conjs([], _, K, [], K?, []).
wild_conjs([conjunct([role(I)], Bi, A, Phi, CA, CD, Lits)|Cs], Gs, K, [conjunct([role(I?)], Bi?, A?, Phi1?, CA?, CD?, Lits?)|Cs1?], K2?, Vs?) :- ground(Gs?) |
    wild_form(Phi?, Gs?, K?, Phi1, K1, V1),
    wild_conjs(Cs?, Gs?, K1?, Cs1, K2, V2),
    app(V1?, V2?, Vs).
wild_conjs([conjunct(Xs, Bi, A, Phi, CA, CD, Lits)|Cs], Gs, K, [conjunct(Xs1?, Bi?, A1?, Phi1?, CA?, CD?, Lits?)|Cs1?], K3?, Vs?) :- otherwise, ground(Gs?) |
    wild_atom(A?, Gs?, bound, K?, A1, K1, V0),
    wild_twice(V0?, V0a, V0b),
    app(Xs?, V0a?, Xs1),
    wild_form(Phi?, Gs?, K1?, Phi1, K2, V1),
    wild_conjs(Cs?, Gs?, K2?, Cs1, K3, V2),
    app(V1?, V2?, V12),
    app(V0b?, V12?, Vs).
procedure wild_twice(Args?, Args, Args).
wild_twice(Vs, Vs?, Vs?) :- ground(Vs?) | true.
procedure wild_forms(Forms?, Sigs?, Integer?, Forms, Integer, Args).
wild_forms([], _, K, [], K?, []).
wild_forms([F|Fs], Gs, K, [F1?|Fs1?], K2?, Vs?) :- ground(Gs?) |
    wild_form(F?, Gs?, K?, F1, K1, V1),
    wild_forms(Fs?, Gs?, K1?, Fs1, K2, V2),
    app(V1?, V2?, Vs).
%% A safe formula with the wildcards of the anchors of its quantifiers among the variables they bind, but of a quantifier that binds a listed role, fforall([role(I)], ...), whose anchor and conclusion are as they are; its constraints as they are; and an atom of it with a wildcard, fa(H, M), the quantifier exists Ws M, Ws the wildcards as variables (wild_fa).
procedure wild_form(Form?, Sigs?, Integer?, Form, Integer, Args).
wild_form(fa(H, M), Gs, K, F1?, K1?, Vs?) :-
    wild_atom(M?, Gs?, bound, K?, M1, K1, V0),
    wild_twice(V0?, V0a, Vs),
    wild_fa(V0a?, H?, M1?, F1).
wild_form(fcons(C), _, K, fcons(C?), K?, []).
wild_form(fnot(F), Gs, K, fnot(F1?), K1?, Vs?) :- wild_form(F?, Gs?, K?, F1, K1, Vs).
wild_form(fand(F, G), Gs, K, fand(F1?, G1?), K2?, Vs?) :- ground(Gs?) |
    wild_form(F?, Gs?, K?, F1, K1, V1),
    wild_form(G?, Gs?, K1?, G1, K2, V2),
    app(V1?, V2?, Vs).
wild_form(for(F, G), Gs, K, for(F1?, G1?), K2?, Vs?) :- ground(Gs?) |
    wild_form(F?, Gs?, K?, F1, K1, V1),
    wild_form(G?, Gs?, K1?, G1, K2, V2),
    app(V1?, V2?, Vs).
wild_form(fexists(Xs, H, A, F), Gs, K, fexists(Xs1?, H?, A1?, F1?), K2?, Vs?) :- ground(Gs?) |
    wild_atom(A?, Gs?, bound, K?, A1, K1, V0),
    wild_twice(V0?, V0a, V0b),
    app(Xs?, V0a?, Xs1),
    wild_form(F?, Gs?, K1?, F1, K2, V1),
    app(V0b?, V1?, Vs).
wild_form(fforall([role(I)], H, A, F, Ps), Gs, K, fforall([role(I?)], H?, A?, F1?, Ps?), K1?, Vs?) :-
    wild_form(F?, Gs?, K?, F1, K1, Vs).
wild_form(fforall(Xs, H, A, F, Ps), Gs, K, fforall(Xs1?, H?, A1?, F1?, Ps1?), K3?, Vs?) :- otherwise, ground(Gs?) |
    wild_atom(A?, Gs?, bound, K?, A1, K1, V0),
    wild_twice(V0?, V0a, V0b),
    app(Xs?, V0a?, Xs1),
    wild_form(F?, Gs?, K1?, F1, K2, V1),
    wild_forms(Ps?, Gs?, K2?, Ps1, K3, V2),
    app(V1?, V2?, V12),
    app(V0b?, V12?, Vs).
%% An atom of a safe formula with wildcards, as the quantifier exists Ws (M), its anchor the atom with each wildcard a variable Ws binds: it holds in a state that has an atom M matches, "a variable of its own, standing for some value", and its negation, not M, where the state has none, "a wildcard in a negated atom is universally quantified, the atom forbidding, in B, ... every atom of the state that it matches" (vGLP, Section 5.4, "Speech-act schemas as local specifications"); before, the printed text took the wildcard for a value no atom has, the atom held in no state and its negation in every one.
procedure wild_fa(Args?, Arg?, Atom?, Form).
wild_fa([], H, M, fa(H?, M?)).
wild_fa([V|Vs], H, M, fexists([V?|Vs?], H?, M?, fcons(true))).
%% What the compiler does not take of a wildcard, the lines saying why ((4), above).
UPlace  ::= up(Constant, Integer).
UPlaces ::= [] ; [UPlace | UPlaces].
procedure wild_faults(QContract?, Lines).
wild_faults(C, L?) :- ground(C?) |
    wild_table(C?, Gs),
    wild_faults1(C?, Gs?, L).
procedure wild_faults1(QContract?, Sigs?, Lines).
wild_faults1(C, Gs, L?) :- ground(C?), ground(Gs?) |
    q_typed_atoms(C?, As),
    untyped_places(As?, Gs?, Ps0),
    dedup(Ps0?, Ps),
    untyped_lines(Ps?, L1),
    wild_schema_faults(C?, Gs?, L2),
    lapp(L1?, L2?, L).
%% The atoms whose predicates the type Atom has: those the roles add, require and forbid, the anchors of the listed roles, and those of the constraints, the conjuncts, but the conditional literals they delete, and the safe formulas; a cleared atom is none.
procedure q_typed_atoms(QContract?, Atoms).
q_typed_atoms([], []).
q_typed_atoms([S|Ss], As?) :- qs_typed(S?, A1), q_typed_atoms(Ss?, A2), app(A1?, A2?, As).
procedure qs_typed(QSchema?, Atoms).
qs_typed(schema(_, _, Rs), As?) :- qr_atoms(Rs?, no, As).
qs_typed(cschema(_, _, _, Rs), As?) :- qr_atoms(Rs?, no, As).
qs_typed(nschema(_, _, C, Rs), As?) :- qr_atoms(Rs?, no, A1), c_atoms(C?, A2), app(A1?, A2?, As).
qs_typed(qschema(_, _, _, C, Rs, Cj, Fs), As?) :-
    qr_atoms(Rs?, no, A1),
    c_atoms(C?, A2),
    cj_atoms(Cj?, no, A3),
    fs_atoms(Fs?, A4),
    app(A3?, A4?, A34),
    app(A2?, A34?, A24),
    app(A1?, A24?, As).
procedure untyped_places(Atoms?, Sigs?, UPlaces).
untyped_places([], _, []).
untyped_places([atom(F, As)|Ms], Gs, Ps?) :- ground(F?), ground(As?), ground(Gs?) |
    place_kinds(F?, As?, Gs?, Ks),
    untyped_args(As?, Ks?, F?, 1, P1),
    untyped_places(Ms?, Gs?, P2),
    app(P1?, P2?, Ps).
untyped_places([times(_, A)|Ms], Gs, Ps?) :- untyped_places([A?|Ms?], Gs?, Ps).
untyped_places([rest(_, _, A)|Ms], Gs, Ps?) :- untyped_places([A?|Ms?], Gs?, Ps).
procedure untyped_args(Args?, Kinds?, Constant?, Integer?, UPlaces).
untyped_args([], _, _, _, []).
untyped_args([any|As], [wild|Ks], F, I, [up(F?, I?)|Ps?]) :- ground(F?), integer(I?) |
    I1 := I? + 1,
    untyped_args(As?, Ks?, F?, I1?, Ps).
untyped_args([_|As], [_|Ks], F, I, Ps?) :- otherwise, integer(I?) |
    I1 := I? + 1,
    untyped_args(As?, Ks?, F?, I1?, Ps).
untyped_args([_|_], [], _, _, []).
procedure untyped_lines(UPlaces?, Lines).
untyped_lines([], []).
untyped_lines([P|Ps], ['%% it has a wildcard at an argument of a predicate to which no other atom of the contract gives a type, so the type of the atoms of a state cannot be formed: a wildcard in an unnegated atom "is a variable of its own, standing for some value" (vGLP, Section 5.4, "Speech-act schemas as local specifications"), and the contract says of what type nowhere; the predicate and the argument, counted after the holder:'|L?]) :-
    untyped_lines1([P?|Ps?], L).
procedure untyped_lines1(UPlaces?, Lines).
untyped_lines1([], []).
untyped_lines1([up(F, I)|Ps], [T?|L?]) :-
    term_to_string(F?, Ft),
    term_to_string(I?, It),
    call_text('%% the predicate and the argument', [Ft?, It?], T),
    untyped_lines1(Ps?, L).
procedure wild_schema_faults(QContract?, Sigs?, Lines).
wild_schema_faults([], _, []).
wild_schema_faults([schema(S, _, Rs)|Ss], Gs, L?) :- ground(S?), ground(Gs?) |
    kept_atoms(Rs?, Ka),
    wild_resid(Ka?, Gs?, R),
    resid_lines(R?, S?, L1),
    wild_schema_faults(Ss?, Gs?, L2),
    lapp(L1?, L2?, L).
wild_schema_faults([cschema(S, _, _, Rs)|Ss], Gs, L?) :- ground(S?), ground(Gs?) |
    kept_atoms(Rs?, Ka),
    wild_resid(Ka?, Gs?, R),
    resid_lines(R?, S?, L1),
    wild_schema_faults(Ss?, Gs?, L2),
    lapp(L1?, L2?, L).
wild_schema_faults([nschema(S, _, C, Rs)|Ss], Gs, L?) :- ground(S?), ground(Gs?) |
    kept_atoms(Rs?, Ka),
    wild_resid(Ka?, Gs?, R),
    resid_lines(R?, S?, L1),
    c_atoms(C?, Ca),
    atoms_any(Ca?, Cw),
    count_lines(Cw?, S?, L2),
    wild_schema_faults(Ss?, Gs?, L3),
    lapp(L2?, L3?, L23),
    lapp(L1?, L23?, L).
wild_schema_faults([qschema(S, _, _, C, Rs, Cj, Fs)|Ss], Gs, L?) :- ground(S?), ground(Gs?), ground(Cj?), ground(Fs?) |
    kept_atoms(Rs?, Ka),
    cj_anchors(Cj?, Aa1),
    forms_anchors(Fs?, Aa2),
    conj_phis(Cj?, Ph),
    forms_fas(Ph?, Fa1),
    forms_fas(Fs?, Fa2),
    app(Fa1?, Fa2?, Fa),
    app(Aa2?, Fa?, Aa2f),
    app(Aa1?, Aa2f?, Aa),
    app(Ka?, Aa?, Ra),
    wild_resid(Ra?, Gs?, R),
    resid_lines(R?, S?, L1),
    c_atoms(C?, Ca1),
    wcj_cons(Cj?, Ca2),
    wforms_cons(Fs?, Ca3),
    app(Ca2?, Ca3?, Ca23),
    app(Ca1?, Ca23?, Ca),
    atoms_any(Ca?, Cw),
    count_lines(Cw?, S?, L2),
    wild_schema_faults(Ss?, Gs?, L4),
    lapp(L2?, L4?, L24),
    lapp(L1?, L24?, L).
procedure kept_atoms(RoleSpecs?, Atoms).
kept_atoms([], []).
kept_atoms([R|Rs], As?) :- ground(R?) | rs_lists(R?, _, _, K, _), kept_atoms(Rs?, A2), app(K?, A2?, As).
%% The anchors of the quantifiers of the conjuncts and their conditions, and of the safe formulas, but of those that bind a listed role.
procedure cj_anchors(Conjuncts?, Atoms).
cj_anchors([], []).
cj_anchors([conjunct([role(_)], _, _, Phi, _, _, _)|Cs], As?) :- form_anchors(Phi?, A1), cj_anchors(Cs?, A2), app(A1?, A2?, As).
cj_anchors([conjunct(_, _, A, Phi, _, _, _)|Cs], [A?|As?]) :- otherwise | form_anchors(Phi?, A1), cj_anchors(Cs?, A2), app(A1?, A2?, As).
procedure forms_anchors(Forms?, Atoms).
forms_anchors([], []).
forms_anchors([F|Fs], As?) :- form_anchors(F?, A1), forms_anchors(Fs?, A2), app(A1?, A2?, As).
procedure form_anchors(Form?, Atoms).
form_anchors(fa(_, _), []).
form_anchors(fcons(_), []).
form_anchors(fnot(F), As?) :- form_anchors(F?, As).
form_anchors(fand(F, G), As?) :- form_anchors(F?, A1), form_anchors(G?, A2), app(A1?, A2?, As).
form_anchors(for(F, G), As?) :- form_anchors(F?, A1), form_anchors(G?, A2), app(A1?, A2?, As).
form_anchors(fexists(_, _, A, F), [A?|As?]) :- form_anchors(F?, As).
form_anchors(fforall([role(_)], _, _, F, Ps), As?) :- form_anchors(F?, A1), forms_anchors(Ps?, A2), app(A1?, A2?, As).
form_anchors(fforall(_, _, A, F, Ps), [A?|As?]) :- otherwise | form_anchors(F?, A1), forms_anchors(Ps?, A2), app(A1?, A2?, As).
%% The atoms of the safe formulas that are no anchors, but those of the conclusion of a quantifier that binds a listed role, which are the listed role's (its role's atoms).
procedure forms_fas(Forms?, Atoms).
forms_fas([], []).
forms_fas([F|Fs], As?) :- form_fas(F?, A1), forms_fas(Fs?, A2), app(A1?, A2?, As).
procedure form_fas(Form?, Atoms).
form_fas(fa(_, M), [M?]).
form_fas(fcons(_), []).
form_fas(fnot(F), As?) :- form_fas(F?, As).
form_fas(fand(F, G), As?) :- form_fas(F?, A1), form_fas(G?, A2), app(A1?, A2?, As).
form_fas(for(F, G), As?) :- form_fas(F?, A1), form_fas(G?, A2), app(A1?, A2?, As).
form_fas(fexists(_, _, _, F), As?) :- form_fas(F?, As).
form_fas(fforall([role(_)], _, _, F, _), As?) :- form_fas(F?, As).
form_fas(fforall(_, _, _, F, Ps), As?) :- otherwise | form_fas(F?, A1), forms_fas(Ps?, A2), app(A1?, A2?, As).
%% The atoms of the constraints inside the conjuncts' conditions and the safe formulas, the anchors of their counts and sums and the atoms of those's conditions.
procedure wcj_cons(Conjuncts?, Atoms).
wcj_cons([], []).
wcj_cons([conjunct(_, _, _, Phi, _, _, _)|Cs], As?) :- wform_cons(Phi?, A1), wcj_cons(Cs?, A2), app(A1?, A2?, As).
procedure wforms_cons(Forms?, Atoms).
wforms_cons([], []).
wforms_cons([F|Fs], As?) :- wform_cons(F?, A1), wforms_cons(Fs?, A2), app(A1?, A2?, As).
procedure wform_cons(Form?, Atoms).
wform_cons(fa(_, _), []).
wform_cons(fcons(C), As?) :- c_atoms(C?, As).
wform_cons(fnot(F), As?) :- wform_cons(F?, As).
wform_cons(fand(F, G), As?) :- wform_cons(F?, A1), wform_cons(G?, A2), app(A1?, A2?, As).
wform_cons(for(F, G), As?) :- wform_cons(F?, A1), wform_cons(G?, A2), app(A1?, A2?, As).
wform_cons(fexists(_, _, _, F), As?) :- wform_cons(F?, As).
wform_cons(fforall(_, _, _, F, Ps), As?) :- wform_cons(F?, A1), wforms_cons(Ps?, A2), app(A1?, A2?, As).
%% Whether an atom of As has the wildcard among its arguments.
procedure atoms_any(Atoms?, YesNo).
atoms_any([], no).
atoms_any([A|As], B?) :- atom_any(A?, B1), atoms_any(As?, B2), or(B1?, B2?, B).
procedure atom_any(Atom?, YesNo).
atom_any(atom(_, As), B?) :- mem(any, As?, B).
atom_any(times(_, A), B?) :- atom_any(A?, B).
atom_any(rest(_, _, A), B?) :- atom_any(A?, B).
%% Whether a required atom or an anchor still has a wildcard, at a place that has a type: one the term form has no variable of (wild_made).
procedure wild_resid(Atoms?, Sigs?, YesNo).
wild_resid([], _, no).
wild_resid([atom(F, As)|Ms], Gs, B?) :- ground(F?), ground(As?), ground(Gs?) |
    place_kinds(F?, As?, Gs?, Ks),
    resid_args(As?, Ks?, B1),
    wild_resid(Ms?, Gs?, B2),
    or(B1?, B2?, B).
wild_resid([times(_, _)|Ms], Gs, B?) :- wild_resid(Ms?, Gs?, B).
wild_resid([rest(_, _, _)|Ms], Gs, B?) :- wild_resid(Ms?, Gs?, B).
procedure resid_args(Args?, Kinds?, YesNo).
resid_args([], _, no).
resid_args([any|As], [wild|Ks], B?) :- resid_args(As?, Ks?, B).
resid_args([any|_], [K|_], yes) :- otherwise, ground(K?) | true.
resid_args([_|As], [_|Ks], B?) :- otherwise | resid_args(As?, Ks?, B).
resid_args([_|_], [], no).
procedure resid_lines(YesNo?, Constant?, Lines).
resid_lines(no, _, []).
resid_lines(yes, S, ['%% it has a wildcard, in an atom a role requires, in the anchor of a quantifier or in an atom of a safe formula, at an argument that is a community name or an item, or, in an anchor or an atom of a safe formula, a constant or a real: such a wildcard "is a variable of its own, standing for some value" (vGLP, Section 5.4, "Speech-act schemas as local specifications"), and the compiler writes it as an agent, a speech-act or a value variable, over numbers, reals or constants in an atom a role requires and over numbers in an anchor: the schemas\' term form has no variable over community names or items, and a variable a quantifier binds is not carried as a constant or a real:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
procedure count_lines(YesNo?, Constant?, Lines).
count_lines(no, _, []).
count_lines(yes, S, ['%% it has a wildcard in the anchor of a count or a sum, or in an atom of its condition: a constraint is over "the count and the sum of the instances of a quantifier, each instance counted as many times as its anchor\'s multiplicity" (vGLP, Section 5.4, "Speech-act schemas as local specifications"), and the paper does not say whether two atoms that differ at the wildcard are one instance or two:', T?]) :-
    ground(S?) | said('%% the schema', S?, T).
%% Whether a listed role's anchor has a wildcard among its arguments ((3), above): the shared text then prints vals_meet, and compares the anchor's other arguments by it (wild_shared).
procedure listed_wild(Contract?, YesNo).
listed_wild([], no).
listed_wild([schema(_, _, Rs)|Ss], B?) :- roles_lwild(Rs?, B1), listed_wild(Ss?, B2), or(B1?, B2?, B).
listed_wild([cschema(_, _, _, Rs)|Ss], B?) :- roles_lwild(Rs?, B1), listed_wild(Ss?, B2), or(B1?, B2?, B).
listed_wild([nschema(_, _, _, Rs)|Ss], B?) :- roles_lwild(Rs?, B1), listed_wild(Ss?, B2), or(B1?, B2?, B).
procedure roles_lwild(RoleSpecs?, YesNo).
roles_lwild([], no).
roles_lwild([R|Rs], B?) :- kind_args(R?, As), mem(any, As?, B1), roles_lwild(Rs?, B2), or(B1?, B2?, B).
%% A line wild_only(L) is printed as L where a listed role's anchor has a wildcard, and left out where none has, and a line wildless_only(L) the other way about, so that a platform with no such anchor prints what it printed before.
procedure wild_shared(Lines?, YesNo?, Lines).
wild_shared([], _, []).
wild_shared([wild_only(L)|Ls], yes, [L?|R?]) :- wild_shared(Ls?, yes, R).
wild_shared([wild_only(_)|Ls], no, R?) :- wild_shared(Ls?, no, R).
wild_shared([wildless_only(_)|Ls], yes, R?) :- wild_shared(Ls?, yes, R).
wild_shared([wildless_only(L)|Ls], no, [L?|R?]) :- wild_shared(Ls?, no, R).
wild_shared([L|Ls], W, [L?|R?]) :- otherwise | wild_shared(Ls?, W?, R).
procedure decl_reflexive(Declared?, Preds).
decl_reflexive([], []).
decl_reflexive([_|_], []).
decl_reflexive(reflexive(Rf, _), Rf?).

%% vGLP, Section 5.4, the paragraph on act schemas, asks of a contract that it be a local and effective specification, and nothing of its being grassroots; its schemas compile to transactions by the realisation, which CSSN (Appendix B.4) takes for a contract with traceable provenance that satisfies volition by the definition GSC gives for a syntactically grassroots one.  So a contract is compiled where GSC's checker certifies it syntactically grassroots, or grassroots with wards (GSC, Appendix F: its introductory act unobstructed but for the marks, with their guardianships and relay acts, and its leaving marks; vGLP #14, 2026-10-18 12:24 UTC, A), or finds no fault in it but its introductory acts (vGLP 2026-10-16 13:53 UTC, C, as Code #9 gives it: "the compiler takes a contract with traceable provenance and volition"); a contract with community roles has no canonical platform here, its roles' extents being no participants of a binding.
procedure verdict_lines(Verdict?, Constant?, Lines).
verdict_lines(syntactically_grassroots, _, []).
verdict_lines(grassroots_with_wards(_, _, _, _, _), _, []).
verdict_lines(not_grassroots(Fs), Nm, L?) :- ground(Fs?), ground(Nm?) |
    realisable(Fs?, B),
    realisable_lines(B?, Nm?, L).
verdict_lines(malformed(_), Nm, [H?, '%% it is malformed; check_named in programs/gsc gives the faults.']) :-
    ground(Nm?) | said('%% not compiled', Nm?, H).
%% The verdict on a contract with wards and listed roles or name terms (def:sg-wards of CSSN's paper): compiled, its listed roles taken by vGLP Section 5.4 (vGLP f5f1644), and any other community role refused (role_lines).
verdict_lines(syntactically_grassroots_with_wards(_, _, _, _, _), _, []).
procedure realisable(Faults?, YesNo).
realisable([], yes).
realisable([no_introductory_act|Fs], B?) :- realisable(Fs?, B).
realisable([obstructed(_, _, _, _)|Fs], B?) :- realisable(Fs?, B).
realisable([untraceable(_)|_], no).
realisable([volition(_, _, _)|_], no).
%% obstructed_jointly(Act) is a fault of an introductory act, as obstructed is: each condition of def:unobstructed holds at some choice of its values, and no one choice satisfies them all (GSC bcc1891, Appendix "Values in Act Schemas"; programs/gsc/unobstructed.glp at GSC-unob3 62fb0342).
realisable([obstructed_jointly(_)|Fs], B?) :- realisable(Fs?, B).
realisable([reflexive(_, _, _)|_], no).
realisable([signed(_, _, _, _)|_], no).
%% A reading role with no edge to a guarding role from an atom that guarding role requires is a fault of volition (GSC 0380a8a, Definition "Volition"), as volition(_, _, _) is.
realisable([changes_nothing(_, _)|_], no).
%% A fault of a schema's form comes in a verdict malformed(Faults), which verdict_lines refuses whole; these clauses cover the type.
realisable([added_and_deleted(_, _, _)|_], no).
realisable([no_role_changes(_)|_], no).
realisable([head_not_variable(_, _)|_], no).
realisable([head_repeated(_, _)|_], no).
realisable([not_in_head(_, _)|_], no).
realisable([name_term_base(_, _)|_], no).
realisable([listed_base(_, _)|_], no).
realisable([listed_signed(_, _)|_], no).
realisable([listed_guarded(_, _)|_], no).
realisable([multiplicity_not_added(_, _, _)|_], no).
realisable([multiplicity_not_numeric(_, _, _)|_], no).
realisable([multiplicity_not_whole(_, _, _)|_], no).
realisable([constraint_not_numeric(_, _)|_], no).
realisable([constraint_not_linear(_, _)|_], no).
realisable([constraint_not_conjunction(_, _)|_], no).
realisable([signing_not_agent(_, _)|_], no).
realisable([signing_not_speech_act(_, _)|_], no).
%% The faults GSC's checker writes since (programs/gsc/self.glp, Fault, at migration f470e2f8; GSC #18, vGLP_inbox, 2026-11-15 19:45 UTC): the type is GSC's, and the compiler's copy takes every constructor of it.
realisable([not_in_vars(_, _)|_], no).
realisable([not_holder(_, _)|_], no).
realisable([unsupplied(_, _)|_], no).
realisable([deleted_not_required(_, _, _)|_], no).
realisable([listed_reading(_, _)|_], no).
realisable([no_signature_atom(_)|_], no).
realisable([multiplicity_wildcard(_, _, _)|_], no).
realisable([condition_holder(_, _)|_], no).
realisable([head_formula(_)|_], no).
realisable([quantified_condition(_, _)|_], no).
realisable([listed_agent_role(_, _)|_], no).
realisable([guard_not_role(_, _)|_], no).
realisable([value_type(_, _)|_], no).
realisable([item_argument(_, _)|_], no).
%% An atom carries no multiplicity, a local state being a set (GSC 4a9175a).
realisable([multiplicity(_, _, _)|_], no).
procedure realisable_lines(YesNo?, Constant?, Lines).
realisable_lines(yes, _, []).
realisable_lines(no, Nm, [H?, '%% it lacks traceable provenance or volition, or is otherwise faulty; check_named in programs/gsc gives the faults.']) :-
    ground(Nm?) | said('%% not compiled', Nm?, H).

%% What vGLP Section 5.4 takes of GSC's community roles (vGLP f5f1644, "Act schemas as local specifications": "A listed role pi[rho(*, u_2, ..., u_r)], pi a party role, its base, has as its people at a schema-binding the persons q with rho(q, u_2, ..., u_r), so bound, in the state of the person in pi"; vGLP #15 Cowork to Code, 2026-10-19 14:24 UTC, item 1: "The compiler takes GSC's listed roles (Appendix D, 8064cfb), not seated or constituent roles, which it still refuses").  A contract is refused where a schema has a seated or a constituent role, or reach conditions, which are of community names; and where a name term is built on a name variable, which a seated role would need (vGLP #15 Cowork to Code, 2026-10-19 14:49 UTC).  A name term <u>.y_1...y_n built on a role or an agent variable is taken: it is "the community name of the person bound to u followed by the speech acts bound to y_1, ..., y_n" (vGLP c649c0d, Section 5.4), an atom holding one written in the view with the community name one argument, of the type CName the shared text defines.  A cschema with no reach conditions is a schema (plain_contract).  A schema may have several listed roles: "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles" (vGLP c649c0d, Section 5.4; vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC), and local.glp asks that they have one base.
Flags ::= f(YesNo, YesNo, YesNo).
procedure role_lines(Contract?, Constant?, Lines).
role_lines(C, Nm, L?) :- ground(C?), ground(Nm?) |
    role_flags(C?, f(no, no, no), F),
    flag_lines(F?, Nm?, L).
procedure role_flags(Contract?, Flags?, Flags).
role_flags([], F, F?).
role_flags([schema(_, _, Rs)|Ss], F, F2?) :- ground(Rs?), ground(F?) |
    schema_flags(no, Rs?, F?, F1),
    role_flags(Ss?, F1?, F2).
role_flags([nschema(_, _, _, _)|Ss], F, F2?) :- role_flags(Ss?, F?, F2).
role_flags([cschema(_, _, Rc, Rs)|Ss], F, F2?) :- ground(Rc?), ground(Rs?), ground(F?) |
    some_reach(Rc?, R),
    schema_flags(R?, Rs?, F?, F1),
    role_flags(Ss?, F1?, F2).
procedure schema_flags(YesNo?, RoleSpecs?, Flags?, Flags).
schema_flags(R, Rs, f(R0, S0, N0), f(R1?, S1?, N1?)) :- ground(Rs?) |
    or(R0?, R?, R1),
    seated_any(Rs?, S),
    or(S0?, S?, S1),
    spec_args(Rs?, As),
    nvar_in(As?, N),
    or(N0?, N?, N1).
procedure some_reach(Reaches?, YesNo).
some_reach([], no).
some_reach([_|_], yes).
procedure seated_any(RoleSpecs?, YesNo).
seated_any([], no).
seated_any([rs(_, _, _, _, _)|Rs], B?) :- seated_any(Rs?, B).
seated_any([crs(seated(_, _), _, _, _, _, _)|_], yes).
seated_any([crs(constituent(_, _), _, _, _, _, _)|_], yes).
seated_any([crs(listed(_, _, _), _, _, _, _, _)|Rs], B?) :- seated_any(Rs?, B).
%% The arguments of a schema's atoms, at every role, and of its listed roles.
procedure spec_args(RoleSpecs?, Args).
spec_args([], []).
spec_args([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M, K, N),
    atoms_args(P?, A1),
    atoms_args(M?, A2),
    atoms_args(K?, A3),
    atoms_args(N?, A4),
    kind_args(R?, A5),
    spec_args(Rs?, A6),
    app(A5?, A6?, A56),
    app(A4?, A56?, A46),
    app(A3?, A46?, A36),
    app(A2?, A36?, A26),
    app(A1?, A26?, As).
%% A name term built on a name variable, which a seated role would need: "Name variables, which a seated role would need, stay out with seated roles" (vGLP #15 Cowork to Code, 2026-10-19 14:49 UTC).
procedure nvar_in(Args?, YesNo).
nvar_in([], no).
nvar_in([nterm(T)|As], B?) :- nt_nvar(T?, B1), nvar_in1(B1?, As?, B).
nvar_in([_|As], B?) :- otherwise | nvar_in(As?, B).
procedure nvar_in1(YesNo?, Args?, YesNo).
nvar_in1(yes, _, yes).
nvar_in1(no, As, B?) :- nvar_in(As?, B).
procedure nt_nvar(NameTerm?, YesNo).
nt_nvar(own(_), no).
nt_nvar(own_var(_), no).
nt_nvar(nvar(_), yes).
nt_nvar(ext(T, _), B?) :- nt_nvar(T?, B).
nt_nvar(ext_any(T), B?) :- nt_nvar(T?, B).
procedure flag_lines(Flags?, Constant?, Lines).
flag_lines(f(R, S, N), Nm, L?) :- ground(Nm?) |
    flag_line(R?, '%% it has reach conditions, which vGLP Section 5.4 does not take.', L1),
    flag_line(S?, '%% it has seated or constituent roles, which vGLP Section 5.4 does not take: it takes listed roles (vGLP f5f1644).', L2),
    flag_line(N?, '%% it has name variables, which vGLP Section 5.4 does not take, as it does not take seated roles.', L3),
    lapp(L1?, L2?, L12),
    lapp(L12?, L3?, L0),
    head_line(L0?, Nm?, L).
procedure flag_line(YesNo?, String?, Lines).
flag_line(no, _, []).
flag_line(yes, X, [X?]).
procedure head_line(Lines?, Constant?, Lines).
head_line([], _, []).
head_line([X|Xs], Nm, [H?, X?|Xs?]) :- ground(Nm?) | said('%% not compiled', Nm?, H).

%% A cschema with no reach conditions is a schema of its roles (GSC, Appendix D: a schema carrying a finite set of reach conditions is written cschema, programs/gsc/README.md); a schema with a constraint, nschema, is a schema of its roles, its constraint in the table Nt; and each schema's head is taken less its local variables.
%% The plain contract and the pragmas with the fields of its local set variables left out (strip_wpragmas).
procedure plain_words(QContract?, QContract?, NumInfos?, WPragmas?, Contract, WPragmas).
plain_words(C0, C7, Nt, P, C?, P1?) :- ground(Nt?) |
    plain_contract(C0?, Nt?, C),
    strip_wpragmas(P?, C7?, Nt?, P1).
%% A set variable local to a role is no place of the request (strip_locals; local.glp, set_locals): "A set variable of atoms the schema deletes at a role other than the base is local to that role, as the notes Bob gives in a swap, which his machine picks from his own" (OSPM, act-schemas-local, VEUI vglp32-sets-2026-11-24).  pragmas.sh gives an act a field string for each place of the schema's head, so the string of such a place is left out, and a field type, ft(K, T), after it renumbered.
procedure strip_wpragmas(WPragmas?, QContract?, NumInfos?, WPragmas).
strip_wpragmas(no_pragmas, _, _, no_pragmas).
strip_wpragmas(pragmas(Ls, As, Ss, Lk, Vn, Tx, Fd, Fn), C, Nt, pragmas(Ls?, As1?, Ss?, Lk?, Vn?, Tx?, Fd?, Fn?)) :- strip_tacts(As?, C?, Nt?, As1).
procedure strip_tacts(TActs?, QContract?, NumInfos?, TActs).
strip_tacts([], _, _, []).
strip_tacts([act(N, B, Fs, Q, X, By, Ft)|As], C, Nt, [act(N?, B?, Fs1?, Q?, X?, By?, Ft1?)|As1?]) :- ground(N?), ground(C?), ground(Nt?), ground(Fs?), ground(Ft?) |
    q_head(N?, C?, Hr),
    num_lookup(N?, Nt?, Ni),
    gone_fields(Hr?, Ni?, Gs),
    strip_fs(Gs?, Fs?, Ft?, Fs1, Ft1),
    strip_tacts(As?, C?, Nt?, As1).
procedure strip_fs(Ints?, Strings?, FTypes?, Strings, FTypes).
strip_fs(Gs, Fs, Ft, Fs1?, Ft1?) :- ground(Gs?) | drop_nths(Fs?, Gs?, 1, Fs1), renum_fts(Ft?, Gs?, Ft1).
QHead ::= hr(Args, RoleSpecs) ; nohead.
procedure q_head(Constant?, QContract?, QHead).
q_head(_, [], nohead).
q_head(N, [schema(S, Hd, Rs)|_], hr(Hd?, Rs?)) :- N? =?= S? | true.
q_head(N, [cschema(S, Hd, _, Rs)|_], hr(Hd?, Rs?)) :- N? =?= S? | true.
q_head(N, [nschema(S, Hd, _, Rs)|_], hr(Hd?, Rs?)) :- N? =?= S? | true.
q_head(N, [qschema(S, Hd, _, _, Rs, _, _)|_], hr(Hd?, Rs?)) :- N? =?= S? | true.
q_head(N, [_|Cs], H?) :- otherwise | q_head(N?, Cs?, H).
%% The ordinals, among the places a field may name (field_places), of the set variables local to a role.
procedure gone_fields(QHead?, NumInfo?, Ints).
gone_fields(nohead, _, []).
gone_fields(hr(Hd, Rs), num_info(_, _, Ls, _, _, _), Gs?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs0?, Lis?, Vs),
    loc_vars(Ls?, Lv),
    gone_walk(Vs?, 1, 1, Lv?, Gs).
procedure gone_walk(Args?, Integer?, Integer?, Args?, Ints).
gone_walk([], _, _, _, []).
gone_walk([V|Vs], I, K, Lv, Gs?) :- integer(I?), integer(K?), ground(Lv?), ground(V?) |
    a_field(V?, I?, [], F),
    I1 := I? + 1,
    gone_step(F?, V?, K?, Lv?, K1, G),
    gone_walk(Vs?, I1?, K1?, Lv?, Gs1),
    keep_int(G?, K?, Gs1?, Gs).
procedure gone_step(YesNo?, Arg?, Integer?, Args?, Integer, YesNo).
gone_step(no, _, K, _, K?, no).
gone_step(yes, set(X), K, Lv, K1?, G?) :- ground(X?), ground(Lv?), integer(K?) | K1 := K? + 1, mem(num(X?), Lv?, G).
gone_step(yes, V, K, Lv, K1?, no) :- otherwise, integer(K?), ground(V?), ground(Lv?) |
    mem(V?, Lv?, In),
    gone_next(In?, K?, K1).
%% A variable local to a role that is no set variable is no place pragmas.sh gives a field string, so the count of the field strings stays (pragmas.sh: "A variable local to a role ... is not named by the request, and no field names it"; a set variable, which is no field, keeping its place): Works' Arbitrate for the contractor, its Job, Sum and Carol read at Dave's role, its fields ["orga", "bob", "", "", "dollar"], SumSet the fourth (Calculus #15, vGLP_inbox.md, 2026-11-26 09:58 UTC).
procedure gone_next(YesNo?, Integer?, Integer).
gone_next(yes, K, K?).
gone_next(no, K, K1?) :- integer(K?) | K1 := K? + 1.
procedure drop_nths(Strings?, Ints?, Integer?, Strings).
drop_nths([], _, _, []).
drop_nths([F|Fs], Gs, K, R?) :- integer(K?), ground(Gs?) |
    mem(K?, Gs?, In),
    K1 := K? + 1,
    drop_nths(Fs?, Gs?, K1?, R1),
    keep_string(In?, F?, R1?, R).
procedure keep_string(YesNo?, String?, Strings?, Strings).
keep_string(yes, _, R, R?).
keep_string(no, F, R, [F?|R?]).
procedure renum_fts(FTypes?, Ints?, FTypes).
renum_fts([], _, []).
renum_fts([ft(J, U)|Ft], Gs, [ft(J1?, U?)|Ft1?]) :- integer(J?), ground(Gs?) |
    below_count(Gs?, J?, D),
    J1 := J? - D?,
    renum_fts(Ft?, Gs?, Ft1).
renum_fts([consents(I)|Ft], Gs, [consents(I?)|Ft1?]) :- renum_fts(Ft?, Gs?, Ft1).
procedure below_count(Ints?, Integer?, Integer).
below_count([], _, 0).
below_count([G|Gs], J, N?) :- G? < J? | below_count(Gs?, J?, M), N := M? + 1.
below_count([G|Gs], J, N?) :- G? >= J? | below_count(Gs?, J?, N).

procedure plain_contract(QContract?, NumInfos?, Contract).
plain_contract([], _, []).
plain_contract([schema(S, Hd, Rs)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
plain_contract([nschema(S, Hd, _, Rs)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
plain_contract([cschema(S, Hd, [], Rs)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
plain_contract([cschema(S, Hd, [R|Rc], Rs)|Ss], Nt, [cschema(S?, Hd?, [R?|Rc?], Rs?)|Ps?]) :- plain_contract(Ss?, Nt?, Ps).
%% A schema with quantifiers, no quantified conjunct in its head and agent roles alone (q_lines), is a schema of its roles, its constraint and the safe formulas of its body in the table Nt.
plain_contract([qschema(S, Hd, _, _, Rs, _, _)|Ss], Nt, [schema(S?, Hd1?, Rs?)|Ps?]) :- ground(S?), ground(Nt?) |
    strip_locals(S?, Hd?, Nt?, Hd1),
    plain_contract(Ss?, Nt?, Ps).
procedure strip_locals(Constant?, Args?, NumInfos?, Args).
strip_locals(S, Hd, Nt, Hd1?) :- num_lookup(S?, Nt?, Ni), strip_locals1(Ni?, Hd?, Hd1).
procedure strip_locals1(NumInfo?, Args?, Args).
strip_locals1(num_info(_, _, Ls, _, _, _), Hd, Hd1?) :- loc_vars(Ls?, Vs), drop_args(Hd?, Vs?, Hd1).
procedure drop_args(Args?, Args?, Args).
drop_args([], _, []).
drop_args([A|As], Vs, R?) :- ground(A?), ground(Vs?) |
    arg_key(A?, K),
    mem(K?, Vs?, In),
    drop_args(As?, Vs?, R1),
    keep_unless(In?, A?, R1?, R).
%% A set variable of the head, set(X), is local as num(X), the atoms naming it so (local.glp, set_locals).
procedure arg_key(Arg?, Arg).
arg_key(set(X), num(X?)).
arg_key(A, A?) :- otherwise | true.
procedure keep_unless(YesNo?, Arg?, Args?, Args).
keep_unless(yes, _, R, R?).
keep_unless(no, A, R, [A?|R?]).
%% The table of the schemas' numbers: each schema's constraint, true where it has none, its local variables and the role whose local variables the constraint names (local.glp, num_info_of).
procedure num_table(QContract?, TActs?, Lxs?, NumInfos).
num_table([], _, _, []).
num_table([schema(S, Hd, Rs)|Ss], As, Lx, [N?|Ns?]) :- ground(S?), ground(Rs?), ground(As?), ground(Lx?) |
    base_one(S?, Rs?, As?, Lx?, B),
    local # num_info_of(S?, Hd?, true, [], Rs?, B?, N),
    num_table(Ss?, As?, Lx?, Ns).
num_table([nschema(S, Hd, C, Rs)|Ss], As, Lx, [N?|Ns?]) :- ground(S?), ground(Rs?), ground(As?), ground(Lx?) |
    base_one(S?, Rs?, As?, Lx?, B),
    local # num_info_of(S?, Hd?, C?, [], Rs?, B?, N),
    num_table(Ss?, As?, Lx?, Ns).
num_table([cschema(S, Hd, _, Rs)|Ss], As, Lx, [N?|Ns?]) :- ground(S?), ground(Rs?), ground(As?), ground(Lx?) |
    base_one(S?, Rs?, As?, Lx?, B),
    local # num_info_of(S?, Hd?, true, [], Rs?, B?, N),
    num_table(Ss?, As?, Lx?, Ns).
%% A schema with quantifiers whose head has no quantified conjunct and whose roles are agent roles, the only one q_lines lets through: its constraint and the safe formulas of its body, each with the role it is local to (local.glp, form_infos).
num_table([qschema(S, Hd, _, C, Rs, _, Fs)|Ss], As, Lx, [N?|Ns?]) :- ground(S?), ground(Rs?), ground(As?), ground(Lx?) |
    base_one(S?, Rs?, As?, Lx?, B),
    local # num_info_of(S?, Hd?, C?, Fs?, Rs?, B?, N),
    num_table(Ss?, As?, Lx?, Ns).
%% The base of a schema, as schema_base prints it (base_lines1): the base of its listed roles and of its conjuncts whose instances the attempt names, or the guarding role its pragma names before its button, or its first guarding role, or its first role; a variable is read only at a role other than the base (vGLP 7892aeb, Section 5.4: "A variable is also local to a role other than the base of the schema ... and read there").
procedure base_one(Constant?, RoleSpecs?, TActs?, Lxs?, Integer).
base_one(S, Rs, As, Lx, B?) :- ground(S?), ground(Rs?), ground(As?), ground(Lx?) |
    listed_bases(Rs?, Bs0),
    ix_bases(Lx?, S?, Bs1),
    app(Bs0?, Bs1?, Bs),
    guard_indices1(Rs?, 1, Gs),
    named_role(As?, S?, Gs?, Ns),
    base_of(Bs?, Ns?, B).
%% The acts of a contract's pragmas, none for a contract with none.
procedure pragma_acts(Pragmas?, TActs).
pragma_acts(no_pragmas, []).
pragma_acts(pragmas(_, As), Ts?) :- norm_acts(As?, Ts).
pragma_acts(pragmas(_, As, _), Ts?) :- norm_acts(As?, Ts).
pragma_acts(pragmas(_, As, _, _, _, _), Ts?) :- norm_acts(As?, Ts).
pragma_acts(pragmas(_, As, _, _, _, _, _), Ts?) :- norm_acts(As?, Ts).
pragma_acts(pragmas(_, As, _, _, _, _, _, _), Ts?) :- norm_acts(As?, Ts).

%% A schema's variables are named V1, V2, ... in the printed clauses; there are
%% as many names as vname/3 has.
procedure names_lines(Contract?, Constant?, Lines).
names_lines([], _, []).
names_lines([schema(S, Hd, Rs)|Ss], Nm, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Nm?) |
    schema_vars(Rs?, Hd?, Vs),
    count_args(Vs?, N),
    vname(N?, F),
    names_lines1(F?, S?, Ss?, Nm?, L).
names_lines([cschema(_, _, _, _)|Ss], Nm, L?) :- names_lines(Ss?, Nm?, L).
names_lines([nschema(_, _, _, _)|Ss], Nm, L?) :- names_lines(Ss?, Nm?, L).
procedure names_lines1(Found?, Constant?, Contract?, Constant?, Lines).
names_lines1(named(_, _), _, Ss, Nm, L?) :- names_lines(Ss?, Nm?, L).
names_lines1(unnamed, S, _, Nm, [H?, H2?]) :- ground(Nm?), ground(S?) |
    said('%% not compiled', Nm?, H),
    said('%% the compiler names the variables of no schema with this many, at', S?, H2).
procedure count_args(Args?, Integer).
count_args([], 0).
count_args([_|As], N?) :- count_args(As?, M), N := M? + 1.

%% --- The module ------------------------------------------------------------
procedure module_lines(Constant?, Contract?, Preds?, Preds?, NumInfos?, Worded?, Preds?, Lines).
module_lines(Nm, C, Rf, E, Nt, W, Ps, Ls?) :- ground(C?), ground(W?) |
    worded_lx(W?, Lx),
    worded_lx(W?, Lx1),
    real_heads(C?, Lx1?, Cr),
    inst_heads(Cr?, Lx?, Ci),
    module_lines0(Nm?, C?, Ci?, Rf?, E?, Nt?, W?, Ps?, Ls).
%% Ci is the contract C with the places of the lists of instances in each schema's head (inst_heads), which the printers of the class term read: its type, binding_of, class_of, name_class, request_name and sentence_of.
procedure module_lines0(Constant?, Contract?, Contract?, Preds?, Preds?, NumInfos?, Worded?, Preds?, Lines).
module_lines0(Nm, C, Ci, Rf, E, Nt, W, Ps, Ls?) :- ground(Nm?), ground(C?), ground(Ci?), ground(Rf?), ground(E?), ground(Nt?), ground(W?), ground(Ps?) |
    said('%% the canonical CVA platform of the contract', Nm?, H),
    worded_lx(W?, Lxc),
    contract_cmps(C?, Lxc?, Cs),
    cmps_any(Cs?, Kc, Cs1),
    ct_name(Kc?, Ct1),
    ct_name(Kc?, Ct2),
    ct_name(Kc?, Ct3),
    class_lines(Ci?, Ct1?, L1),
    text # fixed_text(Fx),
    worded_lx(W?, Lx8),
    real_heads(C?, Lx8?, Cr),
    proposal_alts(Cr?, Ps?, Ct2?, Pa),
    request_lines(Pa?, Lr0),
    any_name(Ps?, Gd),
    day_required(C?, Dy),
    worded_env(W?, Ev),
    env_any(Ev?, En),
    worded_stands(W?, Wsd),
    stands_any(Wsd?, Sd),
    listed_wild(C?, Wl),
    wild_shared(Fx?, Wl?, Fx00),
    worded_lx(W?, Lx9),
    lx_consts(Lx9?, Kn),
    const_lines(Fx00?, Kn?, Fx0s),
    worded_lx(W?, Lx10),
    lx_sets(Lx10?, Ks),
    set_lines(Fx0s?, Ks?, Fx01f),
    worded_fns(W?, Wfn0),
    fns_any(Wfn0?, Kf),
    fn_lines_in(Fx01f?, Kf?, Fx01s),
    cmp_lines(Fx01s?, Kc?, Fx01),
    worded_phone(W?, Ph0),
    phone_found(Ph0?, Fd),
    env_any(Fd?, Fy),
    worded_phone(W?, Ph1),
    phone_trust(Ph1?, Tr0),
    env_any(Tr0?, Ty),
    worded_phone(W?, Ph2),
    phone_trust(Ph2?, Tr1),
    trust_lines(Tr1?, Ltr),
    found_lines(Fx01?, Fy?, Fx02),
    trust_lines_in(Fx02?, Ty?, Fx03),
    app(Fx03?, Ltr?, Fx0),
    shared_lines(Fx0?, Gd?, Dy?, En?, Sd?, Fx1a),
    complete_lines(Ci?, Nt?, Ps?, head, Lcm0),
    complete_req(Lcm0?, Fx1a?, Fx1),
    proved_rules(C?, Rl),
    worded_lx(W?, Lx7),
    real_heads(C?, Lx7?, Ch),
    widget_lines(W?, C?, Ch?, Ps?, Nt?, ctx(Rf?, Rl?, Kc?), Lw0),
    worded_lx(W?, Lx11),
    lx_sets(Lx11?, Ks1),
    menu_lines(Lw0?, Ks1?, Lw1),
    calc_acts(W?, Wa),
    calc_any(Wa?, Ps?, Nt?, C?, Kq),
    calc_lines(Lw1?, Kq?, Lwv),
    value_lines(Lwv?, Kc?, Lw),
    lapp(Lr0?, Lw?, Lr),
    worded_lx(W?, Lx3),
    atom_parts(C?, Nt?, Lx3?, Kc?, La00),
    cval_lines(Cs1?, Lcv),
    lapp(La00?, Lcv?, La0),
    worded_env(W?, Ev1),
    worded_lx(W?, Lxe),
    env_lines(Ev1?, C?, Nt?, Lxe?, Lv),
    lapp(La0?, Lv?, La),
    worded_lx(W?, Lx),
    text_schemas(C?, Lx?, Ct),
    schema_lines(Ct?, T1, Le0),
    numeric_lines(Nt?, Lm00),
    worded_lx(W?, Lx12),
    worded_lx(W?, Lx13),
    lx_sets(Lx13?, Ks2),
    lsets_lines(Ks2?, Nt?, Lx12?, Lls),
    lapp(Lm00?, Lls?, Lm0),
    worded_acts(W?, Was),
    worded_lx(W?, Lx2),
    base_lines(C?, Was?, Lx2?, Lb00),
    worded_ones(W?, Wos),
    ones_lines(Wos?, Lon0),
    worded_vones(W?, Wvs),
    vones_lines(Wvs?, Lvo),
    lapp(Lon0?, Lvo?, Lon),
    lapp(Lb00?, Lon?, Lb01),
    worded_stands(W?, Wss),
    standing_lines(C?, Wss?, Lsd),
    worded_acts(W?, Wac),
    consent_lines(Wac?, Lcs),
    lapp(Lsd?, Lcs?, Lsc),
    lapp(Lb01?, Lsc?, Lb0),
    worded_lx(W?, Lx6),
    local_lines(Lx6?, Ll),
    lapp(Lb0?, Ll?, Lb),
    worded_lx(W?, Lx5),
    inst_conv_lines(Lx5?, Lc),
    lapp(Lb?, Lc?, Lbc),
    lapp(Lm0?, Lbc?, Lm),
    lapp(Le0?, Lm?, Le),
    name_class_lines(Ci?, Ps?, Ln0),
    name_class_decl(Ln0?, Ln1),
    request_name_lines(Ci?, Ps?, Lq0),
    request_name_decl(Lq0?, Lq),
    word_lines(W?, Ci?, Nt?, Lp),
    worded_phone(W?, Phm),
    phone_found(Phm?, Fdm),
    worded_stands(W?, Ssm),
    meeting_lines(C?, Ps?, Fdm?, Ssm?, Lmt),
    lapp(Lq?, Lp?, Lqp0),
    lapp(Lqp0?, Lmt?, Lqp1),
    worded_fns(W?, Wfn1),
    owner_fn_lines(Wfn1?, Lfn),
    complete_lines(Ci?, Nt?, Ps?, head, Lcm1),
    complete_lines(Ci?, Nt?, Ps?, body, Lcm2),
    complete_text(Lcm1?, Lcm2?, Ct3?, Lcm),
    lapp(Lfn?, Lcm?, Lfc),
    lapp(Lqp1?, Lfc?, Lqp),
    lapp(Ln1?, Lqp?, Ln),
    T2a =.. [reflexive_preds, Rf?],
    term_to_string(T2a?, T2),
    T3a =.. [introduction_preds, E?],
    term_to_string(T3a?, T3),
    binding_lines(Ci?, Nt?, L2),
    class_of_lines(Ci?, L3),
    lapp(Ln?, [''|Fx1?], Lnx),
    lapp(L3?, Lnx?, L3x),
    lapp(L2?, ['',
        'procedure class_of(Constant?, Binding?, Peer?, Class).'|L3x?], L2x),
    worded_lx(W?, Lx4),
    inst_type_lines(Lx4?, Lt),
    lapp(L1?, Lt?, L1t),
    lapp(L1t?, Lr1?, L1x),
    lapp(Lr?, La1?, Lr1),
    lapp(Le?, ['',
        'procedure reflexive_preds(Preds).',
        T2?,
        '.',
        '',
        'procedure introduction_preds(Preds).',
        T3?,
        '.',
        '',
        'procedure binding_of(Class?, Constant, Binding).'|L2x?], Le1),
    lapp(La?, ['',
        'procedure contract_schemas(Schemas).',
        T1?,
        '.'|Le1?], La1),
    lapp(['%% Printed by programs/vglp/cva/compiler from the contract named below, in the',
         '%% term form programs/gsc reads (GSC, Sections 3 and 5, Appendix D): the canonical CVA',
         '%% platform of the contract (vGLP, Section 3.2, Definition "Canonical CVA',
         '%% Platform"), two-phase commit coordinated by the initiating agent, compiled',
         '%% into vGLP by its compilation (Section 5.4, "The compilation").  Edit the',
         '%% contract or the compiler and run',
         '%% programs/vglp/cva/compile.sh, not this file.',
         H?,
         '',
         '%% ===========================================================================',
         '%% The contract',
         '%% ===========================================================================',
         '',
         'Class ::='|L1x?], ['%% compile end'], Ls).

%% Class ::= the schemas' alternatives, separated by ;.
procedure class_lines(Contract?, String?, Lines).
class_lines([], _, ['.']).
class_lines([schema(S, Hd, Rs)|Ss], Ct, [A?|L?]) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ct?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    var_types_l(Vs?, Lis?, Ct?, Ts),
    named_call(S?, Ts?, A),
    class_lines1(Ss?, Ct?, L).
class_lines([cschema(_, _, _, _)|Ss], Ct, L?) :- class_lines(Ss?, Ct?, L).
class_lines([nschema(_, _, _, _)|Ss], Ct, L?) :- class_lines(Ss?, Ct?, L).
procedure class_lines1(Contract?, String?, Lines).
class_lines1([], _, ['.']).
class_lines1([S|Ss], Ct, [';'|L?]) :- class_lines([S?|Ss?], Ct?, L).
%% The types of a class's arguments: at the place of each listed role, the list of its people (vGLP c649c0d, Section 5.4, "Act schemas as local specifications": "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles"), List(Peer), the people in the order of identifiers; the part's term carries the people of each, in the order of the roles (vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC).
procedure var_types_l(Args?, Ints?, String?, Strings).
var_types_l([], _, _, []).
var_types_l([role(J)|Vs], Lis, Ct, [T?|Ts?]) :- ground(Lis?), ground(Ct?) | mem(J?, Lis?, In), role_type(In?, T), var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([pvar(_)|Vs], Lis, Ct, ['Peer'|Ts?]) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([svar(_)|Vs], Lis, Ct, ['Speech'|Ts?]) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([nterm(_)|Vs], Lis, Ct, ['Peer'|Ts?]) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([sgn(_, _)|Vs], Lis, Ct, Ts?) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([item_of(_)|Vs], Lis, Ct, Ts?) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([val(_)|Vs], Lis, Ct, Ts?) :- var_types_l(Vs?, Lis?, Ct?, Ts).
%% A compound value is no variable of a schema; the clause covers the type.
var_types_l([cmp(_, _)|Vs], Lis, Ct, Ts?) :- var_types_l(Vs?, Lis?, Ct?, Ts).
%% The wildcard of a cleared atom is no variable of a schema (GSC 327e035, Definition "Speech-act schema"); the clause covers the type.
var_types_l([any|Vs], Lis, Ct, Ts?) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([num(_)|Vs], Lis, Ct, ['Integer'|Ts?]) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([real(_)|Vs], Lis, Ct, ['Real'|Ts?]) :- var_types_l(Vs?, Lis?, Ct?, Ts).
var_types_l([const(_)|Vs], Lis, Ct, [Ct?|Ts?]) :- ground(Ct?) | var_types_l(Vs?, Lis?, Ct?, Ts).
%% A set variable's value is a set of constants, a list of them in the request (GSC, def:numbers, the set variable).
var_types_l([set(_)|Vs], Lis, Ct, ['List(Constant)'|Ts?]) :- var_types_l(Vs?, Lis?, Ct?, Ts).
%% The place of the instances of a conjunct, the list of them, each a person, the one agent variable its quantifier binds, in the order of identifiers (inst_heads).
var_types_l([ilist(_, T)|Vs], Lis, Ct, [L?|Ts?]) :- ground(T?) | string_concat(['List(', T?, ')'], L), var_types_l(Vs?, Lis?, Ct?, Ts).
procedure role_type(YesNo?, String).
role_type(yes, 'List(Peer)').
role_type(no, 'Peer').
%% A class's arguments less the places of its listed roles: the arguments of its request name (vGLP f5f1644, Section 5.4, "Act schemas as local specifications": "its request name is the schema-binding"; "The compilation": the request type has "the alternative propose(N) for the request name N of each guarded part"; vGLP #15 Cowork to Code, 2026-10-19 14:24 UTC, item 2: "the binding, its head with no extent, so no List").
procedure drop_listed(Args?, Ints?, Args).
drop_listed([], _, []).
drop_listed([role(J)|Vs], Lis, R?) :- integer(J?), ground(Lis?) |
    mem(J?, Lis?, In),
    drop_listed(Vs?, Lis?, R1),
    keep_arg(In?, role(J?), R1?, R).
drop_listed([V|Vs], Lis, [V?|R?]) :- otherwise | drop_listed(Vs?, Lis?, R).
procedure keep_arg(YesNo?, Arg?, Args?, Args).
keep_arg(yes, _, R, R?).
keep_arg(no, A, R, [A?|R?]).
procedure var_types(Args?, String?, Strings).
var_types([], _, []).
var_types([role(_)|Vs], Ct, ['Peer'|Ts?]) :- var_types(Vs?, Ct?, Ts).
var_types([pvar(_)|Vs], Ct, ['Peer'|Ts?]) :- var_types(Vs?, Ct?, Ts).
var_types([svar(_)|Vs], Ct, ['Speech'|Ts?]) :- var_types(Vs?, Ct?, Ts).
var_types([nterm(_)|Vs], Ct, ['Peer'|Ts?]) :- var_types(Vs?, Ct?, Ts).
%% A signed term is no variable of a schema (schema_vars); the clause covers
%% the type.
var_types([sgn(_, _)|Vs], Ct, Ts?) :- var_types(Vs?, Ct?, Ts).
var_types([item_of(_)|Vs], Ct, Ts?) :- var_types(Vs?, Ct?, Ts).
var_types([val(_)|Vs], Ct, Ts?) :- var_types(Vs?, Ct?, Ts).
%% A compound value is no variable of a schema; the clause covers the type.
var_types([cmp(_, _)|Vs], Ct, Ts?) :- var_types(Vs?, Ct?, Ts).
%% The wildcard is no variable of a schema; the clause covers the type.
var_types([any|Vs], Ct, Ts?) :- var_types(Vs?, Ct?, Ts).
%% A numeric variable the schema-binding binds, a number in the class term and in the request, so the request form takes it, a number field (vGLP 613ee8d, Section 5.4, "Act schemas as local specifications": "a request names it, so the request form takes it").
var_types([num(_)|Vs], Ct, ['Integer'|Ts?]) :- var_types(Vs?, Ct?, Ts).
var_types([real(_)|Vs], Ct, ['Real'|Ts?]) :- var_types(Vs?, Ct?, Ts).
%% A variable over the constants the schema-binding binds, a constant in the class term and in the request, the name its proposer types (vGLP, Section 5.4, "Speech-act schemas as local specifications": "a variable over the constants taking the name its proposer types").
%% A variable over the constants, of the type of the values over the constants: Constant, or CValue where the contract names a compound value (cval_lines).
var_types([const(_)|Vs], Ct, [Ct?|Ts?]) :- ground(Ct?) | var_types(Vs?, Ct?, Ts).
var_types([set(_)|Vs], Ct, ['List(Constant)'|Ts?]) :- var_types(Vs?, Ct?, Ts).
%% The place of a conjunct's instances is in no atom, constraint or request (cvac.glp, inst_heads); the clause covers the type.
var_types([ilist(_, _)|Vs], Ct, Ts?) :- var_types(Vs?, Ct?, Ts).

%% Whether the contract requires the day: a schema requires the atom today(d) at a role (vGLP, Section 5.4, "Speech-act schemas as local specifications": "we assume that every phone has the correct date, the date in UTC, and the compiled agent reads it from its phone whenever it computes a condition").
procedure day_required(Contract?, YesNo).
day_required(C, D?) :- ground(C?) |
    contract_preds(C?, [], Pr),
    mem(today, Pr?, D).
%% The request type: Proposal ::= the alternatives of the schemas whose terms name guarded parts (local.glp, proposable), separated by ;, and Request ::= propose(Proposal), "a type with the alternative propose(N) for the request name N of each guarded part" (vGLP d433f71, Section 5.4, "The compilation"; Section 6.3: the request type loses refresh, a refresh being a grant addressed to no construct, Input(T) ::= input(Integer, Path, T) ; refresh); where there are none, no request type, a contract with no guarded part having no request, and the shared text's lines guarded_only(L), its request question and its clauses on the request propose([t]_j) and on a hello, are not printed.
procedure proposal_alts(Contract?, Preds?, String?, Strings).
proposal_alts([], _, _, []).
proposal_alts([schema(S, Hd, Rs)|Ss], Ps, Ct, As?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?), ground(Ct?) |
    mem(S?, Ps?, In),
    schema_vars(Rs?, Hd?, Vs0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs0?, Lis?, Vs),
    var_types(Vs?, Ct?, Ts),
    named_call(S?, Ts?, A),
    proposal_alts(Ss?, Ps?, Ct?, As1),
    keep_alt(In?, A?, As1?, As).
proposal_alts([cschema(_, _, _, _)|Ss], Ps, Ct, As?) :- proposal_alts(Ss?, Ps?, Ct?, As).
proposal_alts([nschema(_, _, _, _)|Ss], Ps, Ct, As?) :- proposal_alts(Ss?, Ps?, Ct?, As).
procedure keep_alt(YesNo?, String?, Strings?, Strings).
keep_alt(yes, A, As, [A?|As?]).
keep_alt(no, _, As, As?).
procedure request_lines(Lines?, Lines).
request_lines([], []).
request_lines([A|As], ['', 'Proposal ::=', A?|L?]) :-
    alts_rest(As?, ['', 'Request ::= propose(Proposal).'], L).
procedure alts_rest(Lines?, Lines?, Lines).
alts_rest([], Tl, ['.'|Tl?]).
alts_rest([A|As], Tl, [';', A?|L?]) :- alts_rest(As?, Tl?, L).
procedure any_name(Preds?, YesNo).
any_name([], no).
any_name([_|_], yes).
%% The shared text's lines, a line guarded_only(L) printed as L where the contract has a guarded part and left out where it has none, and a line unguarded_only(L) the other way about; a line day_only(L) printed as L where the contract requires the day and left out where it does not, and a line dayless_only(L) the other way about.  The compiler prints a platform only from a contract with pragmas (vGLP, Section 5.4, "The contract's words"), so the shared text is that of such a platform, and no line of it is kept or left out by its pragmas.
%% A line env_only(L) is printed as L where the contract declares an environment predicate other than the day, and left out where it declares none, and a line envless_only(L) the other way about: its agent takes, when the platform is deployed, the atoms of those predicates, and holds them from startup ("An environment predicate is the day, by the calendar, or a value the contract declares and does not fix, as BCC's f and GFF-FR's d: given when the platform is deployed, held from startup", vGLP #24, Code_inbox.md, 2026-11-07 13:11 UTC, 4; vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "its value is given when the platform is deployed, and the compiled agent holds the atom from startup").
procedure shared_lines(Lines?, YesNo?, YesNo?, YesNo?, YesNo?, Lines).
shared_lines([], _, _, _, _, []).
shared_lines([guarded_only(L)|Ls], yes, D, E, S, Ls1?) :- shared_lines([L?|Ls?], yes, D?, E?, S?, Ls1).
shared_lines([guarded_only(_)|Ls], no, D, E, S, Ls1?) :- shared_lines(Ls?, no, D?, E?, S?, Ls1).
shared_lines([unguarded_only(_)|Ls], yes, D, E, S, Ls1?) :- shared_lines(Ls?, yes, D?, E?, S?, Ls1).
shared_lines([unguarded_only(L)|Ls], no, D, E, S, Ls1?) :- shared_lines([L?|Ls?], no, D?, E?, S?, Ls1).
shared_lines([day_only(L)|Ls], G, yes, E, S, Ls1?) :- shared_lines([L?|Ls?], G?, yes, E?, S?, Ls1).
shared_lines([day_only(_)|Ls], G, no, E, S, Ls1?) :- shared_lines(Ls?, G?, no, E?, S?, Ls1).
shared_lines([dayless_only(_)|Ls], G, yes, E, S, Ls1?) :- shared_lines(Ls?, G?, yes, E?, S?, Ls1).
shared_lines([dayless_only(L)|Ls], G, no, E, S, Ls1?) :- shared_lines([L?|Ls?], G?, no, E?, S?, Ls1).
shared_lines([env_only(L)|Ls], G, D, yes, S, Ls1?) :- shared_lines([L?|Ls?], G?, D?, yes, S?, Ls1).
shared_lines([env_only(_)|Ls], G, D, no, S, Ls1?) :- shared_lines(Ls?, G?, D?, no, S?, Ls1).
shared_lines([envless_only(_)|Ls], G, D, yes, S, Ls1?) :- shared_lines(Ls?, G?, D?, yes, S?, Ls1).
shared_lines([envless_only(L)|Ls], G, D, no, S, Ls1?) :- shared_lines([L?|Ls?], G?, D?, no, S?, Ls1).
%% A line standing_only(L) is printed as L where the contract declares a standing act (vGLP d433f71, Section 5.4, "The contract's words"), and a line standless_only(L) where it declares none, so that a platform with no standing act prints what it printed before standing requests were built.
shared_lines([standing_only(L)|Ls], G, D, E, yes, Ls1?) :- shared_lines([L?|Ls?], G?, D?, E?, yes, Ls1).
shared_lines([standing_only(_)|Ls], G, D, E, no, Ls1?) :- shared_lines(Ls?, G?, D?, E?, no, Ls1).
shared_lines([standless_only(_)|Ls], G, D, E, yes, Ls1?) :- shared_lines(Ls?, G?, D?, E?, yes, Ls1).
shared_lines([standless_only(L)|Ls], G, D, E, no, Ls1?) :- shared_lines([L?|Ls?], G?, D?, E?, no, Ls1).
shared_lines([L|Ls], G, D, E, S, [L?|Ls1?]) :- otherwise | shared_lines(Ls?, G?, D?, E?, S?, Ls1).
%% A line found_only(L) is printed as L where the phone finds an environment predicate of the contract, and a line foundless_only(L) where it finds none, so that every other platform prints what it printed before (vGLP, Section 5.4, "Speech-act schemas as local specifications": "the compiled agent reads it from its phone afresh whenever it computes a condition that requires it"); the wrappers of the other kinds are looked through.
procedure found_lines(Lines?, YesNo?, Lines).
found_lines([], _, []).
found_lines([L|Ls], F, R?) :- ground(F?) |
    found_line(L?, F?, K),
    found_lines(Ls?, F?, R1),
    kept(K?, R1?, R).
Kept ::= keep(Line) ; drop.
procedure kept(Kept?, Lines?, Lines).
kept(keep(L), R, [L?|R?]).
kept(drop, R, R?).
procedure found_line(Line?, YesNo?, Kept).
found_line(found_only(L), yes, K?) :- found_line(L?, yes, K).
found_line(found_only(_), no, drop).
found_line(foundless_only(_), yes, drop).
found_line(foundless_only(L), no, K?) :- found_line(L?, no, K).
found_line(guarded_only(L), F, K?) :- found_line(L?, F?, K0), wrap_kept(K0?, guarded, K).
found_line(unguarded_only(L), F, K?) :- found_line(L?, F?, K0), wrap_kept(K0?, unguarded, K).
found_line(standing_only(L), F, K?) :- found_line(L?, F?, K0), wrap_kept(K0?, standing, K).
found_line(standless_only(L), F, K?) :- found_line(L?, F?, K0), wrap_kept(K0?, standless, K).
found_line(L, _, keep(L?)) :- otherwise | true.
procedure wrap_kept(Kept?, Constant?, Kept).
wrap_kept(drop, _, drop).
wrap_kept(keep(L), guarded, keep(guarded_only(L?))).
wrap_kept(keep(L), unguarded, keep(unguarded_only(L?))).
wrap_kept(keep(L), standing, keep(standing_only(L?))).
wrap_kept(keep(L), standless, keep(standless_only(L?))).
%% A line trust_only(L) is printed as L where a standing request of the contract opens the phone to persons it does not know, and trustless_only(L) where none does (trust_lines; vGLP, Section 5.4); the wrappers of the other kinds are looked through, as found_lines does.
procedure trust_lines_in(Lines?, YesNo?, Lines).
trust_lines_in([], _, []).
trust_lines_in([trust_only(L)|Ls], yes, [L?|R?]) :- trust_lines_in(Ls?, yes, R).
trust_lines_in([trust_only(_)|Ls], no, R?) :- trust_lines_in(Ls?, no, R).
trust_lines_in([trustless_only(_)|Ls], yes, R?) :- trust_lines_in(Ls?, yes, R).
trust_lines_in([trustless_only(L)|Ls], no, [L?|R?]) :- trust_lines_in(Ls?, no, R).
trust_lines_in([standing_only(guarded_only(trust_only(L)))|Ls], yes, [standing_only(guarded_only(L?))|R?]) :- trust_lines_in(Ls?, yes, R).
trust_lines_in([standing_only(guarded_only(trust_only(_)))|Ls], no, R?) :- trust_lines_in(Ls?, no, R).
trust_lines_in([standing_only(guarded_only(trustless_only(_)))|Ls], yes, R?) :- trust_lines_in(Ls?, yes, R).
trust_lines_in([standing_only(guarded_only(trustless_only(L)))|Ls], no, [standing_only(guarded_only(L?))|R?]) :- trust_lines_in(Ls?, no, R).
trust_lines_in([L|Ls], T, [L?|R?]) :- otherwise | trust_lines_in(Ls?, T?, R).
%% Whether the contract declares a standing act.
procedure stands_any(PStands?, YesNo).
stands_any([], no).
stands_any([_|_], yes).

%% The environment predicates the contract declares, the day, today, apart: its agent reads the day from its phone (day_required).
procedure worded_env(Worded?, Preds).
worded_env(words(_, Ev, _, _, _), E?) :- drop_pred(today, Ev?, E).
procedure worded_lx(Worded?, Lxs).
worded_lx(words(_, _, Lx, _, _), Lx?).
procedure drop_pred(Constant?, Preds?, Preds).
drop_pred(_, [], []).
drop_pred(P, [Q|Qs], R?) :- P? =?= Q? | drop_pred(P?, Qs?, R).
drop_pred(P, [Q|Qs], [Q?|R?]) :- otherwise | drop_pred(P?, Qs?, R).
procedure env_any(Preds?, YesNo).
env_any([], no).
env_any([_|_], yes).
%% env_atom(f(V1, ..., Vn), [g(f, [p(V1?), ..., n(Vn?)])]), one clause for each alternative of Atom of an environment predicate, and a last clause giving no atom for any other: the atoms the agent takes when the platform is deployed, written as the contract writes them, held as the agent holds an atom (env_atoms in the shared text).  Each place is of the kind the type Atom gives it, a variable over the constants const and a real variable real by the table Lx (contract_ratoms, nt_ratoms), as atom_parts types it, so that env_atom(period_ended(V1), ...) holds V1 as v(V1?) where Atom has period_ended(Constant).
procedure env_lines(Preds?, Contract?, NumInfos?, Lxs?, Lines).
env_lines([], _, _, _, []).
env_lines([P|Ps], C, Nt, Lx, ['', '%% The atoms of the environment predicates the contract declares, given when the platform is deployed and held from startup (vGLP, Section 5.4, "Speech-act schemas as local specifications").', 'procedure env_atom(Atom?, GAtoms).'|L?]) :- ground(C?), ground(Nt?), ground(Lx?), ground(P?), ground(Ps?) |
    contract_ratoms(C?, Lx?, As0),
    nt_ratoms(Nt?, Lx?, As1),
    app(As0?, As1?, As),
    atom_sigs(As?, Gs0),
    wild_sigs(Gs0?, Gs00),
    unwild(Gs00?, Gs01),
    dedup(Gs01?, Gs1),
    sigs_of([P?|Ps?], Gs1?, Gs),
    env_atom_lines(Gs?, L).
procedure sigs_of(Preds?, Sigs?, Sigs).
sigs_of(_, [], []).
sigs_of(Ps, [sig(F, Ks)|Gs], R?) :- ground(Ps?), ground(F?), ground(Ks?) |
    pred_in(F?, Ps?, In),
    sigs_of(Ps?, Gs?, R1),
    keep_sig(In?, sig(F?, Ks?), R1?, R).
procedure pred_in(Constant?, Preds?, YesNo).
pred_in(_, [], no).
pred_in(F, [P|_], yes) :- F? =?= P? | true.
pred_in(F, [_|Ps], R?) :- otherwise | pred_in(F?, Ps?, R).
procedure keep_sig(YesNo?, Sig?, Sigs?, Sigs).
keep_sig(yes, G, R, [G?|R?]).
keep_sig(no, _, R, R?).
procedure env_atom_lines(Sigs?, Lines).
env_atom_lines([], ['env_atom(_, []) :- otherwise | true.']).
env_atom_lines([sig(F, [])|Gs], [T?, '.'|L?]) :- ground(F?) |
    T0 =.. [env_atom, F?, [g(F?, [])]],
    term_to_string(T0?, T),
    env_atom_lines(Gs?, L).
env_atom_lines([sig(F, [K|Ks])|Gs], [T?, '.'|L?]) :- ground(F?), ground(K?), ground(Ks?) |
    env_names([K?|Ks?], 1, Ns),
    named_call(F?, Ns?, In),
    term_to_string(F?, Ft),
    reader_vals([K?|Ks?], 1, Ws),
    list_text(Ws?, Wl),
    call_text(g, [Ft?, Wl?], G),
    list_text([G?], Gl),
    call_text(env_atom, [In?, Gl?], T),
    env_atom_lines(Gs?, L).
%% The names V1, ..., Vn of the arguments, as the clause's head writes them.
procedure env_names(Kinds?, Integer?, Strings).
env_names([], _, []).
env_names([_|Ks], I, [N?|Ns?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, N, _),
    I1 := I? + 1,
    env_names(Ks?, I1?, Ns).
%% The values p(V1?), ..., n(Vn?), each read from the head.
procedure reader_vals(Kinds?, Integer?, Strings).
reader_vals([], _, []).
reader_vals([K|Ks], I, [W?|Ws?]) :- ground(K?), integer(I?) |
    vname(I?, F),
    name_of(F?, _, Q),
    kind_val(K?, Q?, W),
    I1 := I? + 1,
    reader_vals(Ks?, I1?, Ws).

%% The type of the machine states, List(Atom), in the type of the views, Output ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)) in the shared text (vGLP 12f629d, Section 5.4, "The compilation": "the compilation defines Output as the type of the views", a view carrying "its own key k, the machine state s of its app state, the persons K it knows and the approvals A its person made that are pending"): a machine state is a multiset of the contract's atoms, written as a list, and Atom is the union of the contract's predicates at their argument types: an argument is of the type Peer, a person, where the schemas write a role, a party variable or a name term, and of the type Speech, a speech act, where they write a speech-act variable or a signed term; Atom has one alternative for each predicate and argument types the schemas write it with, in order of first occurrence.  The agent holds an atom as g(Name, Vals), each value p(Peer) or s(Speech), and writes it on the output as the contract writes it: atom_of(g(friend, [p(V1)]), shown(friend(V1?))), one clause per alternative.
%% wild is the kind of a wildcard's place before it takes the type another atom of the contract gives that place (wild_sigs).
%% cval is the kind const of a contract naming a compound value, its type CValue (cval_lines).
Kind  ::= peer ; speech ; name ; num ; real ; item ; const ; cval ; wild ; u(Kinds).
Kinds ::= [] ; [Kind | Kinds].
Sig   ::= sig(Constant, Kinds).
Sigs  ::= [] ; [Sig | Sigs].
procedure atom_parts(Contract?, NumInfos?, Lxs?, YesNo?, Lines).
atom_parts(C, Nt, Lx, Kc, ['', '%% The atoms of the contract at their argument types: a machine state is a list of them, in the view the agent writes, Output ::= view(Key, List(Atom), List(Key), List(Approved), List(Tab)), and the agent writes each atom it holds, g(Name, Vals), as atom_of gives it (vGLP, Section 5.4, "The compilation"); the day, today(d), is no atom of the machine state the view shows (Section 5.4, "Act schemas as local specifications").', 'Atom ::='|L?]) :- ground(C?), ground(Nt?), ground(Lx?), ground(Kc?) |
    contract_ratoms(C?, Lx?, As0),
    nt_ratoms(Nt?, Lx?, As1),
    lx_atoms(Lx?, As2),
    app(As1?, As2?, As12),
    app(As0?, As12?, As),
    atom_sigs(As?, Gs0),
    wild_sigs(Gs0?, Gs00),
    peer_sigs_all(Gs00?, Gs01),
    unwild(Gs01?, Gs02),
    dedup(Gs02?, Gs1),
    drop_today(Gs1?, Gs2),
    sigs_cval(Kc?, Gs2?, Gs),
    atom_parts1(Gs?, L).
%% A predicate has one type at each argument: a variable a quantifier binds, written as a speech-act variable, at an argument where another atom of the contract writes a person, is a person, as G1 of "Bob is a guardian of no one", not exists G1 has_guardian(Bob, G1), beside has_guardian(Carol, Alice); so a signature's speech at a place where another signature of its predicate and arity has peer is peer, and the type Atom has one alternative of that predicate (TGLP: the alternatives of a union have distinct functors).
procedure peer_sigs_all(Sigs?, Sigs).
peer_sigs_all(Gs, R?) :- ground(Gs?) | peer_sigs(Gs?, Gs?, R).
procedure peer_sigs(Sigs?, Sigs?, Sigs).
peer_sigs([], _, []).
peer_sigs([sig(F, Ks)|Gs], All, [sig(F?, Ks1?)|Gs1?]) :- ground(F?), ground(Ks?), ground(All?) |
    peer_kinds(All?, F?, Ks?, Ks1),
    peer_sigs(Gs?, All?, Gs1).
procedure peer_kinds(Sigs?, Constant?, Kinds?, Kinds).
peer_kinds([], _, Ks, Ks?).
peer_kinds([sig(G, Js)|Gs], F, Ks, R?) :- G? =?= F?, ground(Js?), ground(Ks?) |
    same_len(Ks?, Js?, B),
    peer_zip(B?, Ks?, Js?, Ks1),
    peer_kinds(Gs?, F?, Ks1?, R).
peer_kinds([_|Gs], F, Ks, R?) :- otherwise | peer_kinds(Gs?, F?, Ks?, R).
procedure same_len(Kinds?, Kinds?, YesNo).
same_len([], [], yes).
same_len([_|Ks], [_|Js], B?) :- same_len(Ks?, Js?, B).
same_len([], [_|_], no).
same_len([_|_], [], no).
%% Ks with peer at each place where it has speech and Js, of its length, has peer.
procedure peer_zip(YesNo?, Kinds?, Kinds?, Kinds).
peer_zip(no, Ks, _, Ks?).
peer_zip(yes, [], _, []).
peer_zip(yes, [speech|Ks], [peer|Js], [peer|R?]) :- peer_zip(yes, Ks?, Js?, R).
peer_zip(yes, [K|Ks], [_|Js], [K?|R?]) :- otherwise | peer_zip(yes, Ks?, Js?, R).
procedure drop_today(Sigs?, Sigs).
drop_today([], []).
drop_today([sig(today, _)|Gs], Gs1?) :- drop_today(Gs?, Gs1).
drop_today([G|Gs], [G?|Gs1?]) :- otherwise | drop_today(Gs?, Gs1).
procedure atom_parts1(Sigs?, Lines).
atom_parts1(Gs, L?) :- ground(Gs?) |
    merge_sigs(Gs?, [], Gm),
    atom_of_lines(Gs?, Lo),
    atom_parts2(Gm?, Lo?, L).
procedure atom_parts2(Sigs?, Lines?, Lines).
atom_parts2(Gm, Lo, L?) :- ground(Gm?) |
    atom_alts(Gm?, La),
    union_lines(Gm?, Lu),
    lapp(Lu?, ['', 'procedure atom_of(GAtom?, Shown).'|Lo?], L1),
    lapp(La?, L1?, L).
%% The type Atom has one alternative of each predicate and arity (TGLP: the alternatives of a union have distinct functors): two signatures of one predicate and arity whose kinds differ at a place are one, the place of the join of the two kinds, as Agora's posted, whose first place is an item a member holds, a speech act, in Offer, and something they want, a constant, in Want (Calculus #11, vGLP_inbox.md, 2026-11-24 16:56 UTC); the agent keeps one atom_of clause for each signature, its values wrapped by their kinds.
procedure merge_sigs(Sigs?, Sigs?, Sigs).
merge_sigs([], Acc, Acc?).
merge_sigs([G|Gs], Acc, R?) :- merge_in(G?, Acc?, Acc1), merge_sigs(Gs?, Acc1?, R).
procedure merge_in(Sig?, Sigs?, Sigs).
merge_in(G, [], [G?]).
merge_in(sig(F, Ks), [sig(F1, Js)|Gs], R?) :- F? =?= F1?, ground(F?), ground(Ks?), ground(Js?) |
    same_len(Ks?, Js?, B),
    merge_at(B?, F?, Ks?, Js?, Gs?, R).
merge_in(G, [H|Gs], [H?|R?]) :- otherwise | merge_in(G?, Gs?, R).
procedure merge_at(YesNo?, Constant?, Kinds?, Kinds?, Sigs?, Sigs).
merge_at(yes, F, Ks, Js, Gs, [sig(F?, Ls?)|Gs?]) :- join_kinds(Js?, Ks?, Ls).
merge_at(no, F, Ks, Js, Gs, [sig(F?, Js?)|R?]) :- merge_in(sig(F?, Ks?), Gs?, R).
procedure join_kinds(Kinds?, Kinds?, Kinds).
join_kinds([], _, []).
join_kinds([J|Js], [K|Ks], [L?|Ls?]) :- kind_join(J?, K?, L), join_kinds(Js?, Ks?, Ls).
join_kinds([_|_], [], []).
%% The join of two kinds: the kind itself where they are one; else the kinds of both, less each one another of them holds, a person, a whole number and a real being constants and a speech act an utterance, Peer ::= Key, Key ::= String and Utterance ::= ... ; Speech; one kind left being the join, and several their union u(Ks), in the order peer, speech, item, name, num, real, const.
procedure kind_join(Kind?, Kind?, Kind).
kind_join(J, K, J?) :- J? =?= K? | true.
kind_join(J, K, L?) :- otherwise, ground(J?), ground(K?) |
    kind_base(J?, B1),
    kind_base(K?, B2),
    app(B1?, B2?, B),
    kinds_kept([peer, speech, item, name, num, real, const, cval], B?, Us),
    kind_of_union(Us?, L).
procedure kind_base(Kind?, Kinds).
kind_base(u(Ks), Ks?).
kind_base(K, [K?]) :- otherwise | true.
procedure kinds_kept(Kinds?, Kinds?, Kinds).
kinds_kept([], _, []).
kinds_kept([K|Ks], B, R?) :- ground(K?), ground(B?) |
    kind_in(K?, B?, In),
    kind_held(K?, B?, Held),
    kind_keep(In?, Held?, K?, Ks?, B?, R).
procedure kind_keep(YesNo?, YesNo?, Kind?, Kinds?, Kinds?, Kinds).
kind_keep(yes, no, K, Ks, B, [K?|R?]) :- kinds_kept(Ks?, B?, R).
kind_keep(yes, yes, _, Ks, B, R?) :- kinds_kept(Ks?, B?, R).
kind_keep(no, _, _, Ks, B, R?) :- kinds_kept(Ks?, B?, R).
procedure kind_in(Kind?, Kinds?, YesNo).
kind_in(_, [], no).
kind_in(K, [J|_], yes) :- K? =?= J? | true.
kind_in(K, [_|Js], B?) :- otherwise | kind_in(K?, Js?, B).
%% Whether another kind of B holds the kind K.
procedure kind_held(Kind?, Kinds?, YesNo).
kind_held(peer, B, H?) :- kind_const_in(B?, H).
kind_held(num, B, H?) :- kind_const_in(B?, H).
kind_held(real, B, H?) :- kind_const_in(B?, H).
kind_held(speech, B, H?) :- kind_in(item, B?, H).
kind_held(_, _, no) :- otherwise | true.
%% Whether B has a kind over the constants, const, or cval where the contract names a compound value (sigs_cval).
procedure kind_const_in(Kinds?, YesNo).
kind_const_in(B, H?) :- ground(B?) | kind_in(const, B?, H1), kind_in(cval, B?, H2), yes_or(H1?, H2?, H).
procedure yes_or(YesNo?, YesNo?, YesNo).
yes_or(yes, _, yes).
yes_or(no, B, B?).
procedure kind_of_union(Kinds?, Kind).
kind_of_union([K], K?).
kind_of_union(Ks, u(Ks?)) :- otherwise | true.
%% The union types the signatures name, one line each, Name ::= T1 ; T2 ..., the name their types' names joined by Or, as SpeechOrConstant ::= Speech ; Constant.
procedure union_lines(Sigs?, Lines).
union_lines(Gs, L?) :- ground(Gs?) |
    sigs_unions(Gs?, Us0),
    dedup(Us0?, Us),
    union_defs(Us?, L).
procedure sigs_unions(Sigs?, Kinds).
sigs_unions([], []).
sigs_unions([sig(_, Ks)|Gs], R?) :- kinds_unions(Ks?, U1), sigs_unions(Gs?, U2), app(U1?, U2?, R).
procedure kinds_unions(Kinds?, Kinds).
kinds_unions([], []).
kinds_unions([u(Ks)|Js], [u(Ks?)|R?]) :- kinds_unions(Js?, R).
kinds_unions([_|Js], R?) :- otherwise | kinds_unions(Js?, R).
procedure union_defs(Kinds?, Lines).
union_defs([], []).
union_defs([u(Ks)|Us], ['', D?|L?]) :- ground(Ks?) |
    kind_types(Ks?, Ts),
    union_def(Ts?, D),
    union_defs(Us?, L).
union_defs([_|Us], L?) :- otherwise | union_defs(Us?, L).
procedure union_def(Strings?, String).
union_def(Ts, D?) :- ground(Ts?) |
    union_name(Ts?, N),
    union_body(Ts?, Bd),
    string_concat([N?, ' ::= ', Bd?, '.'], D).
procedure union_name(Strings?, String).
union_name([], '').
union_name([T], T?).
union_name([T|Ts], N?) :- otherwise | union_name(Ts?, N1), string_concat([T?, 'Or', N1?], N).
procedure union_body(Strings?, String).
union_body([], '').
union_body([T], T?).
union_body([T|Ts], B?) :- otherwise | union_body(Ts?, B1), string_concat([T?, ' ; ', B1?], B).
%% The atoms of the schemas' constraints and safe formulas, the anchors of their quantifiers, counts and sums among them: an atom a schema reads only there, as an environment predicate's, is an atom of a state (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications").
procedure nt_atoms(NumInfos?, Atoms).
nt_atoms([], []).
nt_atoms([num_info(_, C, _, _, Fi, _)|Ns], As?) :- c_atoms(C?, A1), fi_atoms(Fi?, A2), nt_atoms(Ns?, A3), app(A2?, A3?, A23), app(A1?, A23?, As).
%% The same, each argument of a value variable written with its type, real(X) or const(X), as contract_ratoms writes the schemas' atoms: a value variable's type is the one the schema writes with it (vGLP, Section 5.4, "Speech-act schemas as local specifications": "a value variable, whose type, a whole number, a real or a constant, the schema writes with it"), in the anchor of a count or a sum as in an atom a role holds, so that a predicate has one type at each argument and Atom one alternative of it.
procedure nt_ratoms(NumInfos?, Lxs?, Atoms).
nt_ratoms([], _, []).
nt_ratoms([num_info(S, C, _, _, Fi, _)|Ns], Lx, As?) :- ground(S?), ground(Lx?) |
    c_atoms(C?, A1),
    fi_atoms(Fi?, A2),
    app(A1?, A2?, A0),
    reals_of(Lx?, S?, Xs),
    real_atoms(A0?, Xs?, A10),
    consts_of(Lx?, S?, Ys),
    const_atoms(A10?, Ys?, A3),
    nt_ratoms(Ns?, Lx?, A4),
    app(A3?, A4?, As).
procedure fi_atoms(FInfos?, Atoms).
fi_atoms([], []).
fi_atoms([fi(_, F)|Fs], As?) :- f_atoms(F?, A1), fi_atoms(Fs?, A2), app(A1?, A2?, As).
procedure f_atoms(Form?, Atoms).
f_atoms(fa(_, M), [M?]).
f_atoms(fnot(F), As?) :- f_atoms(F?, As).
f_atoms(fand(F, G), As?) :- f_atoms(F?, A1), f_atoms(G?, A2), app(A1?, A2?, As).
f_atoms(for(F, G), As?) :- f_atoms(F?, A1), f_atoms(G?, A2), app(A1?, A2?, As).
f_atoms(fexists(_, _, A, F), [A?|As?]) :- f_atoms(F?, As).
f_atoms(fforall(_, _, A, F, Gs), [A?|As?]) :- f_atoms(F?, A1), fs_atoms(Gs?, A2), app(A1?, A2?, As).
f_atoms(fcons(C), As?) :- c_atoms(C?, As).
procedure fs_atoms(Forms?, Atoms).
fs_atoms([], []).
fs_atoms([F|Fs], As?) :- f_atoms(F?, A1), fs_atoms(Fs?, A2), app(A1?, A2?, As).
procedure c_atoms(Constraint?, Atoms).
c_atoms(and(C1, C2), As?) :- c_atoms(C1?, A1), c_atoms(C2?, A2), app(A1?, A2?, As).
c_atoms(or(C1, C2), As?) :- c_atoms(C1?, A1), c_atoms(C2?, A2), app(A1?, A2?, As).
c_atoms(implies(C1, C2), As?) :- c_atoms(C1?, A1), c_atoms(C2?, A2), app(A1?, A2?, As).
c_atoms(not(C), As?) :- c_atoms(C?, As).
c_atoms(eq(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
c_atoms(ne(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
c_atoms(le(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
c_atoms(lt(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
c_atoms(ge(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
c_atoms(gt(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
c_atoms(C, []) :- otherwise, ground(C?) | true.
procedure e_atoms(Expr?, Atoms).
e_atoms(plus(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
e_atoms(minus(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
e_atoms(mul(X, Y), As?) :- e_atoms(X?, A1), e_atoms(Y?, A2), app(A1?, A2?, As).
e_atoms(fn(_, Es), As?) :- es_atoms(Es?, As).
e_atoms(cardinality(_, _, A, F), [A?|As?]) :- f_atoms(F?, As).
e_atoms(sum(_, _, A, F, U), [A?|As?]) :- f_atoms(F?, A1), e_atoms(U?, A2), app(A1?, A2?, As).
e_atoms(E, []) :- otherwise, ground(E?) | true.
procedure es_atoms(Exprs?, Atoms).
es_atoms([], []).
es_atoms([E|Es], As?) :- e_atoms(E?, A1), es_atoms(Es?, A2), app(A1?, A2?, As).
%% The atoms of the schemas, each argument of a real variable written real(X), its type Real (real_atoms).
procedure contract_ratoms(Contract?, Lxs?, Atoms).
contract_ratoms([], _, []).
contract_ratoms([schema(S, _, Rs)|Ss], Lx, As?) :- ground(S?), ground(Lx?) |
    rs_atoms(Rs?, A0),
    reals_of(Lx?, S?, Xs),
    real_atoms(A0?, Xs?, A10),
    elems_of(Lx?, S?, Ys),
    const_atoms(A10?, Ys?, A1),
    contract_ratoms(Ss?, Lx?, A2),
    app(A1?, A2?, As).
contract_ratoms([cschema(_, _, _, Rs)|Ss], Lx, As?) :- rs_atoms(Rs?, A1), contract_ratoms(Ss?, Lx?, A2), app(A1?, A2?, As).
contract_ratoms([nschema(S, _, _, Rs)|Ss], Lx, As?) :- ground(S?), ground(Lx?) |
    rs_atoms(Rs?, A0),
    elems_of(Lx?, S?, Ys),
    const_atoms(A0?, Ys?, A1),
    contract_ratoms(Ss?, Lx?, A2),
    app(A1?, A2?, As).
%% The variables of a schema whose values in an atom are constants: those over the constants, and the set variables, an atom with a set variable being one atom for each element, a constant (GSC 0daa1b8: the elements constants).
procedure elems_of(Lxs?, Constant?, Preds).
elems_of([], _, []).
elems_of([cn(S1, X)|Lx], S, [X?|Xs?]) :- S1? =?= S? | elems_of(Lx?, S?, Xs).
elems_of([st(S1, X)|Lx], S, [X?|Xs?]) :- S1? =?= S? | elems_of(Lx?, S?, Xs).
elems_of([_|Lx], S, Xs?) :- otherwise | elems_of(Lx?, S?, Xs).
procedure contract_atoms(Contract?, Atoms).
contract_atoms([], []).
contract_atoms([schema(_, _, Rs)|Ss], As?) :- rs_atoms(Rs?, A1), contract_atoms(Ss?, A2), app(A1?, A2?, As).
contract_atoms([cschema(_, _, _, Rs)|Ss], As?) :- rs_atoms(Rs?, A1), contract_atoms(Ss?, A2), app(A1?, A2?, As).
contract_atoms([nschema(_, _, _, Rs)|Ss], As?) :- rs_atoms(Rs?, A1), contract_atoms(Ss?, A2), app(A1?, A2?, As).
%% A cleared atom, which carries the wildcard, is no atom of a state: it stands for the atoms of the state it matches (vGLP f8127b1, Section 5.4, "Act schemas as local specifications"), which other atoms of the contract write, so the type Atom takes the role's deleted atoms less its cleared ones (uncleared).
procedure rs_atoms(RoleSpecs?, Atoms).
rs_atoms([], []).
rs_atoms([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M0, K, N),
    uncleared(M0?, M),
    rs_atoms(Rs?, A5),
    app(N?, A5?, A4),
    app(K?, A4?, A3),
    app(M?, A3?, A2),
    app(P?, A2?, As).
procedure atom_sigs(Atoms?, Sigs).
atom_sigs([], []).
atom_sigs([atom(F, Xs)|As], [sig(F?, Ks?)|Gs?]) :- arg_kinds(Xs?, Ks), atom_sigs(As?, Gs).
atom_sigs([times(_, A)|As], Gs?) :- atom_sigs([A?|As?], Gs).
atom_sigs([rest(_, _, A)|As], Gs?) :- atom_sigs([A?|As?], Gs).
procedure arg_kinds(Args?, Kinds).
arg_kinds([], []).
arg_kinds([role(_)|Xs], [peer|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([pvar(_)|Xs], [peer|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([nterm(_)|Xs], [name|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([svar(_)|Xs], [speech|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([sgn(_, _)|Xs], [speech|Ks?]) :- arg_kinds(Xs?, Ks).
%% The item of a speech act, item_of(y), its utterance under its signatures, an argument of an atom (vGLP e1d1b8a, Section 5.4: an argument of an atom may be "the signer, the author or the item of a speech act", as GSC's term form writes it, programs/gsc/self.glp, Arg).
arg_kinds([item_of(_)|Xs], [item|Ks?]) :- arg_kinds(Xs?, Ks).
%% A constant the contract names, val(C), a value or an utterance (vGLP 0eeea71, Section 5.4), of the kind const: its place in the atom is of the type Constant, and the agent holds it as v(C), printed as C in the view.
arg_kinds([val(_)|Xs], [const|Ks?]) :- arg_kinds(Xs?, Ks).
%% A compound value f(t1, ..., tk) is of the kind const, as a constant is: its place is of the type of the values over the constants, which holds the compound values the contract names (cval_lines), and the agent holds it as v(T), T the term f(v1, ..., vk).
arg_kinds([cmp(_, _)|Xs], [const|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([num(_)|Xs], [num|Ks?]) :- arg_kinds(Xs?, Ks).
%% An atom with a set variable stands for one atom per element (GSC, def:binding-numbers), so the place holds a constant.
arg_kinds([set(_)|Xs], [const|Ks?]) :- arg_kinds(Xs?, Ks).
arg_kinds([real(_)|Xs], [real|Ks?]) :- arg_kinds(Xs?, Ks).
%% A variable over the constants (const_atoms), of the kind const, as a constant the contract names is: its place is of the type Constant, and the agent holds its value as v(C).
arg_kinds([const(_)|Xs], [const|Ks?]) :- arg_kinds(Xs?, Ks).
%% The wildcard's place is of the type the contract gives that place of the predicate in another atom: it is wild here, and takes that type from the signatures of the predicate's other atoms (wild_sigs), a predicate having one type at each argument; a wildcard a role requires, and one in an anchor, is by then a variable of its place's kind (wild_schemas), so the wildcards met here are those of the atoms a role forbids, of the anchors of the listed roles and of the atoms of the safe formulas.
arg_kinds([any|Xs], [wild|Ks?]) :- arg_kinds(Xs?, Ks).
%% The place of a conjunct's instances is in no atom, constraint or request (cvac.glp, inst_heads); the clause covers the type.
arg_kinds([ilist(_, _)|Xs], Ks?) :- arg_kinds(Xs?, Ks).
%% Atom ::= the alternatives, separated by ;, each the predicate applied to its argument types, a predicate of no argument a constant.
procedure atom_alts(Sigs?, Lines).
atom_alts([], ['.']).
atom_alts([G|Gs], [A?|L?]) :- ground(G?) |
    sig_alt(G?, A),
    atom_alts1(Gs?, L).
procedure atom_alts1(Sigs?, Lines).
atom_alts1([], ['.']).
atom_alts1([G|Gs], [';'|L?]) :- atom_alts([G?|Gs?], L).
procedure sig_alt(Sig?, String).
sig_alt(sig(F, []), A?) :- term_to_string(F?, A).
sig_alt(sig(F, [K|Ks]), A?) :- ground(F?), ground(K?), ground(Ks?) |
    kind_types([K?|Ks?], Ts),
    named_call(F?, Ts?, A).
procedure kind_types(Kinds?, Strings).
kind_types([], []).
kind_types([peer|Ks], ['Peer'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([speech|Ks], ['Speech'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([name|Ks], ['CName'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([num|Ks], ['Integer'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([real|Ks], ['Real'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([item|Ks], ['Utterance'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([const|Ks], ['Constant'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([cval|Ks], ['CValue'|Ts?]) :- kind_types(Ks?, Ts).
kind_types([u(Us)|Ks], [N?|Ts?]) :- kind_types(Us?, Us1), union_name(Us1?, N), kind_types(Ks?, Ts).
%% No signature printed has a place wild (unwild); the clause covers the type.
kind_types([wild|Ks], Ts?) :- kind_types(Ks?, Ts).
%% atom_of(g(f, [p(V1), s(V2)]), shown(f(V1?, V2?))), one clause per alternative of Atom, and a last clause on any other atom, which covers the type GAtom and is never reached: the agent holds only atoms the contract's schemas add.
procedure atom_of_lines(Sigs?, Lines).
atom_of_lines([], ['atom_of(_, unshown) :- otherwise | true.']).
atom_of_lines([sig(F, [])|Gs], [T?, '.'|L?]) :- ground(F?) |
    T0 =.. [atom_of, g(F?, []), shown(F?)],
    term_to_string(T0?, T),
    atom_of_lines(Gs?, L).
atom_of_lines([sig(F, [K|Ks])|Gs], [T?, '.'|L?]) :- ground(F?), ground(K?), ground(Ks?) |
    kind_vals([K?|Ks?], 1, Ws, Qs),
    named_call(F?, Qs?, Out),
    term_to_string(F?, Ft),
    list_text(Ws?, Wl),
    call_text(g, [Ft?, Wl?], G),
    call_text(shown, [Out?], Sh),
    call_text(atom_of, [G?, Sh?], T),
    atom_of_lines(Gs?, L).
procedure kind_vals(Kinds?, Integer?, Strings, Strings).
kind_vals([], _, [], []).
kind_vals([K|Ks], I, [W?|Ws?], [Q?|Qs?]) :- ground(K?), integer(I?) |
    vname(I?, F),
    name_of(F?, N, Q),
    kind_val(K?, N?, W),
    I1 := I? + 1,
    kind_vals(Ks?, I1?, Ws, Qs).
procedure kind_val(Kind?, String?, String).
kind_val(peer, N, W?) :- call_text(p, [N?], W).
kind_val(name, N, W?) :- call_text(c, [N?], W).
kind_val(speech, N, W?) :- call_text(s, [N?], W).
kind_val(num, N, W?) :- call_text(n, [N?], W).
kind_val(real, N, W?) :- call_text(r, [N?], W).
kind_val(item, N, W?) :- call_text(i, [N?], W).
kind_val(const, N, W?) :- call_text(v, [N?], W).
kind_val(cval, N, W?) :- call_text(v, [N?], W).
%% No signature printed has a place wild (unwild); the clause covers the type.
kind_val(wild, N, N?).
%% A union of kinds is only in the signatures the type Atom is printed from (merge_sigs); the clause covers the type.
kind_val(u(_), N, N?).

%% binding_of(s(V1, ..., Vn), s, [b(Var1, p(V1?)), ...]), and, for each variable local to a role, agent, speech-act or numeric, b(pvar(X), lv(s, X)), b(svar(X), lv(s, X)) or b(num(X), lv(s, X)): the schema-binding does not bind it, and its value in the binding stands for the variable, which the state of the person in its role binds (vGLP 8a3ae79, Section 5.4, "Speech-act schemas as local specifications": "A schema-binding does not bind a local variable: the machine of the person in that role finds a value for it in its own state"; the shared text, dom_bindings).
procedure binding_lines(Contract?, NumInfos?, Lines).
binding_lines([], _, []).
binding_lines([schema(S, Hd, Rs)|Ss], Nt, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Nt?) |
    schema_vars(Rs?, Hd?, Vs),
    list_places(Rs?, Hd?, Lis),
    num_lookup(S?, Nt?, Ni),
    local_binds(Ni?, S?, Lb),
    binding_line_l(Lis?, S?, Vs?, Lb?, L1),
    binding_lines(Ss?, Nt?, L2),
    lapp(L1?, L2?, L).
binding_lines([cschema(_, _, _, _)|Ss], Nt, L?) :- binding_lines(Ss?, Nt?, L).
binding_lines([nschema(_, _, _, _)|Ss], Nt, L?) :- binding_lines(Ss?, Nt?, L).
procedure local_binds(NumInfo?, Constant?, Strings).
local_binds(num_info(_, _, Ls, _, _, _), S, Lb?) :- ground(S?) | loc_vars(Ls?, Vs), local_binds1(Vs?, S?, Lb).
procedure local_binds1(Args?, Constant?, Strings).
local_binds1([], _, []).
local_binds1([num(X)|Vs], S, [T?|Lb?]) :- ground(X?), ground(S?) | term_to_string(b(num(X?), lv(S?, X?)), T), local_binds1(Vs?, S?, Lb).
local_binds1([real(X)|Vs], S, [T?|Lb?]) :- ground(X?), ground(S?) | term_to_string(b(num(X?), lv(S?, X?)), T), local_binds1(Vs?, S?, Lb).
local_binds1([pvar(X)|Vs], S, [T?|Lb?]) :- ground(X?), ground(S?) | term_to_string(b(pvar(X?), lv(S?, X?)), T), local_binds1(Vs?, S?, Lb).
local_binds1([svar(X)|Vs], S, [T?|Lb?]) :- ground(X?), ground(S?) | term_to_string(b(svar(X?), lv(S?, X?)), T), local_binds1(Vs?, S?, Lb).
local_binds1([_|Vs], S, Lb?) :- otherwise | local_binds1(Vs?, S?, Lb).
%% binding_of(c(V1, ..., Vn), c, B): the binding a class term names; for a schema with listed roles at i_1, ..., i_m, the binding of its other roles and its variables, and the list [Vi_1, ..., Vi_m] of the people of each listed role, in the order of the roles, which the shared text sends onto the roles of the schema it carries for them (listed_binding).
procedure binding_line_l(Ints?, Constant?, Args?, Strings?, Lines).
binding_line_l([], S, Vs, Lb, [T?, '.']) :- binding_line(S?, Vs?, Lb?, T).
binding_line_l([I|Is], S, Vs, Lb, [T?, ':-', G?, '.']) :- integer(I?), ground(Is?), ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, _),
    bind_terms_skip(Vs?, 1, [I?|Is?], Bs0),
    sapp(Bs0?, Lb?, Bs),
    list_args([I?|Is?], Vs?, S?, Lqs, Pre),
    named_call(S?, Ns?, Hd),
    term_to_string(S?, S1),
    term_to_string(S?, S2),
    list_text(Bs?, Bl),
    list_text(Lqs?, Ql),
    call_text(binding_of, [Hd?, S1?, 'B?'], T),
    call_text(listed_binding, [S2?, Bl?, Ql?, 'B'], G0),
    string_concat([Pre?, G0?], G).
%% The lists of the places Lis of a class term, ppl(Vi?) at a listed role's, and ins(Iki?) at the instances of the k-th conjunct, Iki the instances in the shared text's form, which the goals Pre give, each followed by a comma (inst_in_S_K).
procedure list_args(Ints?, Args?, Constant?, Strings, String).
list_args([], _, _, [], '').
list_args([I|Is], Vs, S, [A?|As?], P?) :- integer(I?), ground(Vs?), ground(S?) |
    nth_arg(I?, Vs?, V),
    vname(I?, F),
    name_of(F?, _, Q),
    list_arg(V?, Q?, S?, A, P1),
    list_args(Is?, Vs?, S?, As, P2),
    string_concat([P1?, P2?], P).
procedure list_arg(Arg?, String?, Constant?, String, String).
list_arg(ilist(K, _), Q, S, A?, P?) :- integer(K?), ground(Q?), ground(S?) |
    term_to_string(K?, Kt),
    string_concat(['Ik', Kt?], J),
    string_concat(['Ik', Kt?, '?'], Jq),
    ix_name('inst_in_', S?, K?, I),
    call_text(I?, [Q?, J?], P0),
    string_concat([P0?, ', '], P),
    call_text(ins, [Jq?], A).
list_arg(V, Q, _, A?, '') :- otherwise, ground(V?), ground(Q?) | call_text(ppl, [Q?], A).
procedure bind_terms_skip(Args?, Integer?, Ints?, Strings).
bind_terms_skip([], _, _, []).
bind_terms_skip([V|Vs], I, Lis, Bs?) :- ground(V?), integer(I?), ground(Lis?) |
    I1 := I? + 1,
    bind_terms_skip(Vs?, I1?, Lis?, Bs1),
    mem(I?, Lis?, In),
    keep_bind(In?, I?, V?, Bs1?, Bs).
procedure keep_bind(YesNo?, Integer?, Arg?, Strings?, Strings).
keep_bind(yes, _, _, Bs, Bs?).
keep_bind(no, I, V, Bs, [X?|Bs?]) :- ground(V?), integer(I?) |
    vname(I?, F),
    wrapped(V?, F?, W),
    bind_key(V?, K),
    term_to_string(K?, Vt),
    call_text(b, [Vt?, W?], X).
procedure binding_line(Constant?, Args?, Strings?, String).
binding_line(S, Vs, Lb, T?) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, _),
    bind_terms(Vs?, 1, Bs0),
    sapp(Bs0?, Lb?, Bs),
    named_call(S?, Ns?, Hd),
    term_to_string(S?, S1),
    list_text(Bs?, Bl),
    call_text(binding_of, [Hd?, S1?, Bl?], T).
procedure bind_terms(Args?, Integer?, Strings).
bind_terms([], _, []).
bind_terms([V|Vs], I, [X?|Bs?]) :- ground(V?), integer(I?) |
    vname(I?, F),
    wrapped(V?, F?, W),
    bind_key(V?, K),
    term_to_string(K?, Vt),
    call_text(b, [Vt?, W?], X),
    I1 := I? + 1,
    bind_terms(Vs?, I1?, Bs).
%% A real variable is num(X) in the binding, the atoms and the constraint writing num(X) of it (reals_off).
procedure bind_key(Arg?, Arg).
bind_key(real(X), num(X?)).
%% And so is a variable over the constants (consts_off), its value in the binding a constant, v(C).
bind_key(const(X), num(X?)).
bind_key(set(X), num(X?)).
bind_key(A, A?) :- otherwise | true.
procedure wrapped(Arg?, Found?, String).
wrapped(role(_), named(_, Q), W?) :- call_text(p, [Q?], W).
wrapped(pvar(_), named(_, Q), W?) :- call_text(p, [Q?], W).
wrapped(svar(_), named(_, Q), W?) :- call_text(s, [Q?], W).
wrapped(nterm(_), named(_, Q), W?) :- call_text(p, [Q?], W).
wrapped(num(_), named(_, Q), W?) :- call_text(n, [Q?], W).
wrapped(real(_), named(_, Q), W?) :- call_text(r, [Q?], W).
wrapped(const(_), named(_, Q), W?) :- call_text(v, [Q?], W).
%% A set, named by the request as a list of constants, is st(L) in the binding, each element one atom (GSC, def:binding-numbers).
wrapped(set(_), named(_, Q), W?) :- call_text(st, [Q?], W).
wrapped(_, unnamed, 'p(unnamed)').
procedure var_names(Args?, Integer?, Strings, Strings).
var_names([], _, [], []).
var_names([_|Vs], I, [N?|Ns?], [Q?|Qs?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, N, Q),
    I1 := I? + 1,
    var_names(Vs?, I1?, Ns, Qs).
procedure name_of(Found?, String, String).
name_of(named(N, Q), N?, Q?).
name_of(unnamed, unnamed, unnamed).

%% class_of(s, B, D, s(V1?, ..., Vn?)) :- ground(B?), ground(D?) |
%%     val_peer(Var1, B?, D?, V1), ... .
procedure class_of_lines(Contract?, Lines).
class_of_lines([], []).
class_of_lines([schema(S, Hd, Rs)|Ss], [T?, ':-', 'ground(B?)', ',', 'ground(D?)', '|'|L?]) :-
    ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    list_places(Rs?, Hd?, Lis),
    class_of_line(S?, Vs?, Lis?, T, L1),
    class_of_lines(Ss?, L2),
    lapp(L1?, L2?, L).
class_of_lines([cschema(_, _, _, _)|Ss], L?) :- class_of_lines(Ss?, L).
class_of_lines([nschema(_, _, _, _)|Ss], L?) :- class_of_lines(Ss?, L).
procedure class_of_line(Constant?, Args?, Ints?, String, Lines).
class_of_line(S, Vs, Lis, T?, L1?) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, _, Qs),
    named_call(S?, Qs?, Out),
    term_to_string(S?, S1),
    call_text(class_of, [S1?, 'B', 'D', Out?], T),
    val_goals(Vs?, 1, S?, Lis?, L1).
%% The value of each argument of the class term; at the place i of a listed role, the people of the roles the shared text carries for it, in the order of identifiers (copies_of(B, i, Vi)).
procedure val_goals(Args?, Integer?, Constant?, Ints?, Lines).
val_goals([], _, _, _, []).
val_goals([V|Vs], I, S, Lis, [G?|L?]) :- ground(V?), integer(I?), ground(S?), ground(Lis?) |
    vname(I?, F),
    name_of(F?, N, _),
    mem(I?, Lis?, In),
    val_goal_l(In?, I?, V?, N?, S?, G),
    I1 := I? + 1,
    val_goals1(Vs?, I1?, S?, Lis?, L).
procedure val_goals1(Args?, Integer?, Constant?, Ints?, Lines).
val_goals1([], _, _, _, ['.']).
val_goals1([V|Vs], I, S, Lis, [','|L?]) :- val_goals([V?|Vs?], I?, S?, Lis?, L).
procedure val_goal_l(YesNo?, Integer?, Arg?, String?, Constant?, String).
val_goal_l(yes, I, V, N, S, G?) :- list_goal(V?, I?, N?, S?, G).
val_goal_l(no, _, V, N, _, G?) :- val_goal(V?, N?, G).
%% At the place of the instances of the K-th conjunct, the instances the binding carries for it, in the order of terms, in the class term's form (inst_list(S, B, K, Jk), inst_out_S_K(Jk, Vi)).
procedure list_goal(Arg?, Integer?, String?, Constant?, String).
list_goal(ilist(K, _), _, N, S, G?) :- integer(K?), ground(N?), ground(S?) |
    term_to_string(K?, Kt),
    term_to_string(S?, St),
    string_concat(['Jk', Kt?], J),
    string_concat(['Jk', Kt?, '?'], Jq),
    ix_name('inst_out_', S?, K?, O),
    call_text(inst_list, [St?, 'B?', Kt?, J?], G1),
    call_text(O?, [Jq?, N?], G2),
    string_concat([G1?, ', ', G2?], G).
list_goal(V, I, N, _, G?) :- otherwise, ground(V?), integer(I?), ground(N?) | term_to_string(I?, It), call_text(copies_of, ['B?', It?, N?], G).
procedure val_goal(Arg?, String?, String).
val_goal(svar(X), N, G?) :- ground(X?), ground(N?) | term_to_string(svar(X?), Vt), call_text(val_speech, [Vt?, 'B?', 'D?', N?], G).
val_goal(role(I), N, G?) :- ground(N?) | term_to_string(role(I?), Vt), call_text(val_peer, [Vt?, 'B?', 'D?', N?], G).
val_goal(pvar(X), N, G?) :- ground(X?), ground(N?) | term_to_string(pvar(X?), Vt), call_text(val_peer, [Vt?, 'B?', 'D?', N?], G).
val_goal(nterm(_), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
val_goal(num(X), N, G?) :- ground(X?), ground(N?) | term_to_string(num(X?), Vt), call_text(val_num, [Vt?, 'B?', N?], G).
val_goal(real(X), N, G?) :- ground(X?), ground(N?) | term_to_string(num(X?), Vt), call_text(val_real, [Vt?, 'B?', N?], G).
%% The constant of a variable over the constants (the shared text's val_const, a line const_only).
val_goal(const(X), N, G?) :- ground(X?), ground(N?) | term_to_string(num(X?), Vt), call_text(val_const, [Vt?, 'B?', N?], G).
%% The elements of a set variable, a list of constants (the shared text's val_set, a line set_only).
val_goal(set(X), N, G?) :- ground(X?), ground(N?) | term_to_string(num(X?), Vt), call_text(val_set, [Vt?, 'B?', N?], G).
%% A signed term is no variable of a schema (schema_vars); the clause covers
%% the type.
val_goal(sgn(_, _), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
%% An item is no variable of a schema either; the clause covers the type.
val_goal(item_of(_), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
%% A constant the contract names is no variable of a schema either; the clause covers the type.
val_goal(val(_), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
%% A compound value is no variable of a schema either; the clause covers the type.
val_goal(cmp(_, _), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
%% The wildcard is no variable of a schema; the clause covers the type.
val_goal(any, N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).
%% The place of a conjunct's instances is a list (list_goal); the clause covers the type.
val_goal(ilist(_, _), N, G?) :- ground(N?) | call_text(val_peer, [unnamed, 'B?', 'D?', N?], G).

procedure vname(Integer?, Found).
vname(1, named('V1', 'V1?')).
vname(2, named('V2', 'V2?')).
vname(3, named('V3', 'V3?')).
vname(4, named('V4', 'V4?')).
vname(5, named('V5', 'V5?')).
vname(6, named('V6', 'V6?')).
vname(7, named('V7', 'V7?')).
vname(8, named('V8', 'V8?')).
vname(9, named('V9', 'V9?')).
vname(10, named('V10', 'V10?')).
vname(11, named('V11', 'V11?')).
vname(12, named('V12', 'V12?')).
vname(13, named('V13', 'V13?')).
vname(14, named('V14', 'V14?')).
vname(15, named('V15', 'V15?')).
vname(16, named('V16', 'V16?')).
vname(17, named('V17', 'V17?')).
vname(18, named('V18', 'V18?')).
vname(19, named('V19', 'V19?')).
vname(20, named('V20', 'V20?')).
vname(21, named('V21', 'V21?')).
vname(22, named('V22', 'V22?')).
vname(23, named('V23', 'V23?')).
vname(24, named('V24', 'V24?')).
vname(25, named('V25', 'V25?')).
vname(26, named('V26', 'V26?')).
vname(27, named('V27', 'V27?')).
vname(28, named('V28', 'V28?')).
vname(29, named('V29', 'V29?')).
vname(30, named('V30', 'V30?')).
vname(N, unnamed) :- otherwise, integer(N?) | true.

%% The contract as the shared text reads it: a schema with listed roles, lschema(Name, Vars, Roles, Listings), each listed role written as a party role of its atoms and listing(I, Base, Rho, Args) in Listings, in the order of the roles: its index I, its base the agent role of index Base and its people the persons q with rho(q, Args) in the state of the person in the base (vGLP c649c0d, Section 5.4, "Act schemas as local specifications").
procedure text_schemas(Contract?, Lxs?, TSchemas).
text_schemas([], _, []).
text_schemas([schema(S, Hd, Rs)|Ss], Lx, [X?|Xs?]) :- ground(S?), ground(Hd?), ground(Rs?), ground(Lx?) |
    listed_ixs(Rs?, 1, Lis),
    ix_listings(Lx?, S?, Is),
    text_schema(Lis?, Is?, S?, Hd?, Rs?, Lx?, X),
    text_schemas(Ss?, Lx?, Xs).
text_schemas([cschema(_, _, _, _)|Ss], Lx, Xs?) :- text_schemas(Ss?, Lx?, Xs).
text_schemas([nschema(_, _, _, _)|Ss], Lx, Xs?) :- text_schemas(Ss?, Lx?, Xs).
%% A schema with listed roles or with conjuncts whose instances the attempt names is an lschema, its listings those of its listed roles, in the order of the roles, and then its lists of instances, in conjunct order.
procedure text_schema(Ints?, TListings?, Constant?, Args?, RoleSpecs?, Lxs?, TSchema).
text_schema([], [], S, Hd, Rs, _, schema(S?, Hd?, Rs?)).
text_schema(_, Is, S, Hd, Rs, Lx, lschema(S?, Hd?, Rs1?, Ls?)) :- otherwise, ground(Rs?), ground(S?) |
    plain_specs(Rs?, Rs1),
    listed_all(Rs?, 1, Ls0),
    t_listings(Ls0?, S?, Lx?, Ls1),
    app(Ls1?, Is?, Ls).
%% Each listed role with the condition of its quantifier and the conditional literals of its conjunct, true and none where the schema has none (lx_table).
procedure t_listings(Listings?, Constant?, Lxs?, TListings).
t_listings([], _, _, []).
t_listings([listing(I, B, Rho, As)|Ls], S, Lx, [listing(I?, B?, Rho?, As?, Phi?, CA?, CD?)|Ts?]) :- ground(S?), ground(Lx?), integer(I?) |
    lx_of(Lx?, S?, I?, Phi, CA, CD),
    t_listings(Ls?, S?, Lx?, Ts).
procedure lx_of(Lxs?, Constant?, Integer?, Form, HMults, HMults).
lx_of([], _, _, fcons(true), [], []).
lx_of([lx(S1, I1, Phi, CA, CD)|_], S, I, Phi?, CA?, CD?) :- S1? =?= S?, I1? =:= I? | true.
lx_of([_|Lx], S, I, Phi?, CA?, CD?) :- otherwise | lx_of(Lx?, S?, I?, Phi, CA, CD).
%% The listed roles of the schemas with quantifiers: "A conjunct with a listed role ... is local to its base; the base's machine finds its instances, the attempt names them, and every participant takes them as arguments of the transaction" (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications").  A listed role written qlisted(Bi, Rho, [role(I)|As], [role(I)]), the person of the role the first argument of its anchor rho(pi_Bi, role(I), As) after its holder and the one variable its quantifier binds, is the listed role pi_Bi[rho(_, As)] of listed/3 (programs/gsc/self.glp, RoleKind) with the condition Phi of its quantifier, and its conjunct's conditional literals at other roles, each person of the role giving them; the quantifiers of the body that bind a listed role are its literals, which its role specification holds (programs/gsc/README.md: "it requires and forbids by the literals it holds in the conclusions of the conjuncts of Body binding it").
procedure q_normal(QContract?, QContract).
q_normal([], []).
q_normal([qschema(S, Hd, Bd, C, Rs, _, Fs)|Ss], [qschema(S?, Hd?, Bd?, C?, Rs1?, [], Fs1?)|Ns?]) :- ground(Rs?) |
    q_roles(Rs?, 1, Rs1),
    q_listed_ixs(Rs?, 1, Lis),
    q_forms(Fs?, Lis?, Fs1),
    q_normal(Ss?, Ns).
q_normal([S|Ss], [S?|Ns?]) :- otherwise | q_normal(Ss?, Ns).
procedure q_roles(RoleSpecs?, Integer?, RoleSpecs).
q_roles([], _, []).
q_roles([crs(qlisted(Bi, Rho, As, _), G, A, D, K, F)|Rs], I, [crs(listed(Bi?, Rho?, As?), G?, A?, D?, K?, F?)|Ns?]) :- integer(I?) |
    I1 := I? + 1,
    q_roles(Rs?, I1?, Ns).
q_roles([R|Rs], I, [R?|Ns?]) :- otherwise, integer(I?) | I1 := I? + 1, q_roles(Rs?, I1?, Ns).
procedure q_listed_ixs(RoleSpecs?, Integer?, Ints).
q_listed_ixs([], _, []).
q_listed_ixs([crs(qlisted(_, _, _, _), _, _, _, _, _)|Rs], I, [I?|Is?]) :- integer(I?) | I1 := I? + 1, q_listed_ixs(Rs?, I1?, Is).
q_listed_ixs([_|Rs], I, Is?) :- otherwise, integer(I?) | I1 := I? + 1, q_listed_ixs(Rs?, I1?, Is).
%% The safe formulas of the body less the quantifiers that bind a listed role, but those whose atoms two roles or more hold, which are of the part's condition (vGLP 5f55cf3, Section 5.4: "A safe formula of B that is local to no role, its atoms held by two roles or more, each a role of the schema or a listed role its quantifier binds, is of the part's condition").
procedure q_forms(Forms?, Ints?, Forms).
q_forms([], _, []).
q_forms([F|Fs], Lis, R?) :- ground(F?), ground(Lis?) |
    binds_listed(F?, Lis?, B),
    local # form_cross(F?, X),
    neg(X?, Nx),
    and(B?, Nx?, Dr),
    q_forms(Fs?, Lis?, R1),
    keep_form_unless(Dr?, F?, R1?, R).
procedure binds_listed(Form?, Ints?, YesNo).
binds_listed(fforall([role(I)], _, _, _, _), Lis, B?) :- integer(I?) | mem_int(I?, Lis?, B).
binds_listed(_, _, no) :- otherwise | true.
procedure keep_form_unless(YesNo?, Form?, Forms?, Forms).
keep_form_unless(yes, _, R, R?).
keep_form_unless(no, F, R, [F?|R?]).
procedure mem_int(Integer?, Ints?, YesNo).
mem_int(_, [], no).
mem_int(I, [J|_], yes) :- I? =:= J? | true.
mem_int(I, [_|Js], B?) :- otherwise | mem_int(I?, Js?, B).
%% The condition and the conditional literals of each listed role, from its conjunct, conjunct([role(I)], Bi, A, Phi, Add, Del, Lits), or else from the quantifier of the body that binds it.
procedure lx_table(QContract?, Lxs).
lx_table([], []).
lx_table([qschema(S, _, _, _, _, Cj, Fs)|Ss], Lx?) :- ground(S?), ground(Cj?) |
    ix_conjs(Cj?, S?, 1, L0a),
    lc_conjs(Cj?, S?, L0b),
    app(L0a?, L0b?, L0),
    lx_conjs(Cj?, S?, L1),
    lx_forms(Fs?, S?, Cj?, L2),
    lx_table(Ss?, L3),
    app(L2?, L3?, L23),
    app(L1?, L23?, L123),
    app(L0?, L123?, Lx).
lx_table([_|Ss], Lx?) :- otherwise | lx_table(Ss?, Lx).
%% Each conjunct binding no listed role, its quantifier binding the variables Xs, the K-th of its schema in conjunct order: ix(S, K, Base, Xs, A, Phi, CAdd, CDel), its instances a list the attempt names (q_lines lets through no other such conjunct).
procedure ix_conjs(Conjuncts?, Constant?, Integer?, Lxs).
ix_conjs([], _, _, []).
ix_conjs([conjunct([role(_)], _, _, _, _, _, _)|Cs], S, K, Ls?) :- ix_conjs(Cs?, S?, K?, Ls).
ix_conjs([conjunct(Xs, Bi, A, Phi, CA, CD, _)|Cs], S, K, Ls?) :- otherwise, ground(S?), integer(K?), ground(Xs?), integer(Bi?), ground(CA?), ground(CD?) |
    app(CA?, CD?, H),
    hm_other(H?, Bi?, O),
    ix_conj(O?, S?, K?, Bi?, Xs?, A?, Phi?, CA?, CD?, Cs?, Ls).
%% A conjunct with a conditional literal at a role other than the one holding its anchor is one whose instances the attempt names, each restricted to the variables its literals name (hm_named); one whose literals are all at the role holding its anchor is local to that role (lc_conjs).
procedure ix_conj(YesNo?, Constant?, Integer?, Integer?, Args?, Atom?, Form?, HMults?, HMults?, Conjuncts?, Lxs).
ix_conj(no, S, K, _, _, _, _, _, _, Cs, Ls?) :- ix_conjs(Cs?, S?, K?, Ls).
ix_conj(yes, S, K, Bi, Xs, A, Phi, CA, CD, Cs, [ix(S?, K?, Bi?, Xr?, A?, Phi?, CA?, CD?)|Ls?]) :- ground(S?), integer(K?), ground(CA?), ground(CD?) |
    app(CA?, CD?, H),
    hm_named(H?, Xs?, Xr),
    K1 := K? + 1,
    ix_conjs(Cs?, S?, K1?, Ls).
%% Each conjunct binding no listed role whose conditional literals are all at the role holding its anchor: "A safe formula of B, a constraint, and a quantified conjunct, is local to a role where every atom of it ... is held by that role ...: the machine of the person in that role evaluates it in its own state" (vGLP fe12932, Section 5.4, "Speech-act schemas as local specifications"), lc(S, Bi, Xs, A, Phi, CAdd, CDel), Xs the variables its literals name (hm_named): the role finds the instances in its own state and applies its literals at each (vGLP #24, Code_inbox.md, 2026-11-07 18:52 UTC, (ii)).
procedure lc_conjs(Conjuncts?, Constant?, Lxs).
lc_conjs([], _, []).
lc_conjs([conjunct([role(_)], _, _, _, _, _, _)|Cs], S, Ls?) :- lc_conjs(Cs?, S?, Ls).
lc_conjs([conjunct(Xs, Bi, A, Phi, CA, CD, _)|Cs], S, Ls?) :- otherwise, ground(S?), ground(Xs?), integer(Bi?), ground(CA?), ground(CD?) |
    app(CA?, CD?, H),
    hm_other(H?, Bi?, O),
    lc_conj(O?, S?, Bi?, Xs?, A?, Phi?, CA?, CD?, Cs?, Ls).
procedure lc_conj(YesNo?, Constant?, Integer?, Args?, Atom?, Form?, HMults?, HMults?, Conjuncts?, Lxs).
lc_conj(yes, S, _, _, _, _, _, _, Cs, Ls?) :- lc_conjs(Cs?, S?, Ls).
lc_conj(no, S, Bi, Xs, A, Phi, CA, CD, Cs, [lc(S?, Bi?, Xr?, A?, Phi?, CA?, CD?)|Ls?]) :- ground(S?), ground(Xs?), ground(CA?), ground(CD?) |
    app(CA?, CD?, H),
    hm_named(H?, Xs?, Xr),
    lc_conjs(Cs?, S?, Ls).
%% The lists of instances of a schema's conjuncts, instances(K, Base, X, A, Phi, CAdd, CDel), in conjunct order.
procedure ix_listings(Lxs?, Constant?, TListings).
ix_listings([], _, []).
ix_listings([ix(S1, K, Bi, X, A, Phi, CA, CD)|Lx], S, [instances(K?, Bi?, X?, A?, Phi?, CA?, CD?)|Is?]) :- S1? =?= S? | ix_listings(Lx?, S?, Is).
ix_listings([_|Lx], S, Is?) :- otherwise | ix_listings(Lx?, S?, Is).
%% Their places, ilist(K, T), after the variables of the class term, in conjunct order, T the type of an instance (ix_type).
procedure ix_ilists(Lxs?, Constant?, Args).
ix_ilists([], _, []).
ix_ilists([ix(S1, K, _, Xs, _, _, _, _)|Lx], S, [ilist(K?, T?)|Ks?]) :- S1? =?= S?, ground(S?), integer(K?) | ix_type(S?, K?, Xs?, T), ix_ilists(Lx?, S?, Ks).
ix_ilists([_|Lx], S, Ks?) :- otherwise | ix_ilists(Lx?, S?, Ks).
%% The type of an instance of the K-th conjunct of the schema S, binding the variables Xs: the type of its one variable's value, Peer, Speech or Integer; or, binding several, Inst_S_K ::= i(T_1, ..., T_n), the types of their values in their order (inst_type_lines), since a type expression in a class term is a name and a list in a class term holds no list (vGLP, Section 5.1, Definition "Volitional Procedure, Interactive Type": "never under another Stream or List").
procedure ix_type(Constant?, Integer?, Args?, String).
ix_type(_, _, [X], T?) :- kind_type(X?, T).
ix_type(S, K, [_, _|_], T?) :- ix_name('Inst_', S?, K?, T).
%% A quantifier binds at least one variable (GSC, the reader's conjunct); the clause covers the type.
ix_type(_, _, [], 'Peer').
procedure kind_type(Arg?, String).
kind_type(svar(_), 'Speech').
kind_type(num(_), 'Integer').
kind_type(real(_), 'Real').
kind_type(_, 'Peer') :- otherwise | true.
procedure kind_wrap(Arg?, String).
kind_wrap(svar(_), 's').
kind_wrap(num(_), 'n').
kind_wrap(real(_), 'r').
kind_wrap(_, 'p') :- otherwise | true.
%% A name of the K-th conjunct of the schema S: P, S, _ and K.
procedure ix_name(String?, Constant?, Integer?, String).
ix_name(P, S, K, T?) :- ground(P?), ground(S?), integer(K?) |
    term_to_string(S?, St),
    term_to_string(K?, Kt),
    string_concat([P?, St?, '_', Kt?], T).
%% Inst_S_K ::= i(T_1, ..., T_n). for each conjunct binding several variables.
procedure inst_type_lines(Lxs?, Lines).
inst_type_lines([], []).
inst_type_lines([ix(S, K, _, [X, Y|Zs], _, _, _, _)|Lx], ['', T?|L?]) :- ground(S?), integer(K?), ground(X?), ground(Y?), ground(Zs?) |
    ix_name('Inst_', S?, K?, N),
    var_kind_types([X?, Y?|Zs?], Ts),
    call_text(i, Ts?, I),
    string_concat([N?, ' ::= ', I?, '.'], T),
    inst_type_lines(Lx?, L).
inst_type_lines([_|Lx], L?) :- otherwise | inst_type_lines(Lx?, L).
procedure var_kind_types(Args?, Strings).
var_kind_types([], []).
var_kind_types([X|Xs], [T?|Ts?]) :- kind_type(X?, T), var_kind_types(Xs?, Ts).
%% For each conjunct whose instances the attempt names, inst_out_S_K(Is, L), the instances of the shared text's form, each the list of its values, to the class term's list L of them, and inst_in_S_K(L, Is), back (insts_of, listed_binding).
procedure inst_conv_lines(Lxs?, Lines).
inst_conv_lines([], []).
inst_conv_lines([ix(S, K, _, Xs, _, _, _, _)|Lx], L?) :- ground(S?), integer(K?), ground(Xs?) |
    ix_name('inst_out_', S?, K?, O),
    ix_name('inst_in_', S?, K?, I),
    ix_type(S?, K?, Xs?, T),
    inst_vals_text(Xs?, 1, Vi, Vo),
    inst_term_text(Xs?, Wi, Wo),
    string_concat(['procedure ', O?, '(Insts?, List(', T?, ')).'], P1),
    string_concat([O?, '([], []).'], C1),
    string_concat([O?, '([', Vi?, '|Is], [', Wo?, '|Os?]) :- ', O?, '(Is?, Os).'], C2),
    string_concat([O?, '([_|Is], Os?) :- otherwise | ', O?, '(Is?, Os).'], C3),
    string_concat(['procedure ', I?, '(List(', T?, ')?, Insts).'], P2),
    string_concat([I?, '([], []).'], C4),
    string_concat([I?, '([', Wi?, '|Os], [', Vo?, '|Is?]) :- ', I?, '(Os?, Is).'], C5),
    inst_conv_lines(Lx?, L1),
    lapp(['', P1?, C1?, C2?, C3?, '', P2?, C4?, C5?], L1?, L).
inst_conv_lines([_|Lx], L?) :- otherwise | inst_conv_lines(Lx?, L).
%% The list of the values of an instance, [p(V1), s(V2), ...] as read and [p(V1?), s(V2?), ...] as written.
procedure inst_vals_text(Args?, Integer?, String, String).
inst_vals_text(Xs, J, Ti?, To?) :- ground(Xs?), integer(J?) |
    val_texts(Xs?, J?, Ai, Ao),
    list_text(Ai?, Ti),
    list_text(Ao?, To).
procedure val_texts(Args?, Integer?, Strings, Strings).
val_texts([], _, [], []).
val_texts([X|Xs], J, [A?|As?], [B?|Bs?]) :- ground(X?), integer(J?) |
    kind_wrap(X?, W),
    vname(J?, F),
    name_of(F?, N, Q),
    call_text(W?, [N?], A),
    call_text(W?, [Q?], B),
    J1 := J? + 1,
    val_texts(Xs?, J1?, As, Bs).
%% The class term's form of an instance: its one value, V1, or i(V1, ..., Vn); as read and as written.
procedure inst_term_text(Args?, String, String).
inst_term_text([], 'V1', 'V1?').
inst_term_text([_], 'V1', 'V1?').
inst_term_text([X, Y|Zs], Ti?, To?) :- ground(X?), ground(Y?), ground(Zs?) |
    var_names([X?, Y?|Zs?], 1, Ns, Qs),
    call_text(i, Ns?, Ti),
    call_text(i, Qs?, To).
%% Their bases.
procedure ix_bases(Lxs?, Constant?, Ints).
ix_bases([], _, []).
ix_bases([ix(S1, _, Bi, _, _, _, _, _)|Lx], S, [Bi?|Bs?]) :- S1? =?= S? | ix_bases(Lx?, S?, Bs).
ix_bases([_|Lx], S, Bs?) :- otherwise | ix_bases(Lx?, S?, Bs).
%% The contract whose class terms the compiler prints: each schema's head followed by the places of the lists of instances of its conjuncts, ilist(K), in conjunct order (the reading of vGLP 9ee6f87, Section 5.4, "each schema-binding determines a part [t]_j of a class for each list L of instances, one list for each conjunct local to the base of the schema and not to one role", which does not say where in the class term the lists sit; vGLP #24, Code_inbox.md, 2026-11-07 15:28 UTC, put to vGLP).  The request name is the schema-binding, so the lists are no place of it (request_name_lines).
procedure inst_heads(Contract?, Lxs?, Contract).
inst_heads([], _, []).
inst_heads([schema(S, Hd, Rs)|Ss], Lx, [schema(S?, Hd1?, Rs?)|Cs?]) :- ground(S?), ground(Lx?) |
    ix_ilists(Lx?, S?, Ks),
    app(Hd?, Ks?, Hd1),
    inst_heads(Ss?, Lx?, Cs).
inst_heads([cschema(S, Hd, Rc, Rs)|Ss], Lx, [cschema(S?, Hd?, Rc?, Rs?)|Cs?]) :- inst_heads(Ss?, Lx?, Cs).
inst_heads([nschema(S, Hd, Cn, Rs)|Ss], Lx, [nschema(S?, Hd?, Cn?, Rs?)|Cs?]) :- inst_heads(Ss?, Lx?, Cs).
procedure lx_conjs(Conjuncts?, Constant?, Lxs).
lx_conjs([], _, []).
lx_conjs([conjunct([role(I)], _, _, Phi, A, D, _)|Cs], S, [lx(S?, I?, Phi?, A?, D?)|Ls?]) :- ground(S?) | lx_conjs(Cs?, S?, Ls).
lx_conjs([_|Cs], S, Ls?) :- otherwise | lx_conjs(Cs?, S?, Ls).
procedure lx_forms(Forms?, Constant?, Conjuncts?, Lxs).
lx_forms([], _, _, []).
lx_forms([fforall([role(I)], _, _, Phi, _)|Fs], S, Cj, Ls?) :- ground(S?), ground(Cj?), integer(I?) |
    conj_binds(Cj?, I?, B),
    lx_forms(Fs?, S?, Cj?, Ls1),
    lx_form1(B?, S?, I?, Phi?, Ls1?, Ls).
lx_forms([_|Fs], S, Cj, Ls?) :- otherwise | lx_forms(Fs?, S?, Cj?, Ls).
procedure lx_form1(YesNo?, Constant?, Integer?, Form?, Lxs?, Lxs).
lx_form1(yes, _, _, _, Ls, Ls?).
lx_form1(no, S, I, Phi, Ls, [lx(S?, I?, Phi?, [], [])|Ls?]).
procedure conj_binds(Conjuncts?, Integer?, YesNo).
conj_binds([], _, no).
conj_binds([conjunct([role(J)], _, _, _, _, _, _)|_], I, yes) :- J? =:= I? | true.
conj_binds([_|Cs], I, B?) :- otherwise | conj_binds(Cs?, I?, B).

%% The contract, contract_schemas([S_1, ..., S_n]), and each schema under its name, schema_entry(Name, S_i), the schema of a name being found by its clause and not by building the whole contract at every look-up (Code #12's change 1 of 2026-10-20 11:55 UTC, approved by vGLP #18 Cowork as implementation, Code_inbox.md 12:03 UTC); a name of no schema has the schema of no roles, schema(Name, [], []).
procedure schema_lines(TSchemas?, String, Lines).
schema_lines(Ct, T1?, ['', 'procedure schema_entry(Constant?, Schema).'|Le?]) :- ground(Ct?) |
    T0 =.. [contract_schemas, Ct?],
    term_to_string(T0?, T1),
    entry_lines(Ct?, Le).
procedure entry_lines(TSchemas?, Lines).
entry_lines([], ['schema_entry(Nm, schema(Nm?, [], [])) :- otherwise | true.']).
entry_lines([X|Xs], [E?, '.'|L?]) :- ground(X?) |
    schema_name(X?, Nm),
    E0 =.. [schema_entry, Nm?, X?],
    term_to_string(E0?, E),
    entry_lines(Xs?, L).
%% The base of each schema, schema_base(Name, I), the index of its role: the base of its listed roles, and, for a schema with none, the guarding role its pragma names before its button or, having no guarding role, its first role: "The conjuncts of a schema that are local to their base and not to one role have one base, the base of the schema; a schema with none has as its base the guarding role its pragma names before its button (below) or, having no guarding role, its first role" (vGLP 0b51a60, Section 5.4, "Speech-act schemas as local specifications").  The role the pragma names is the first of by(Gs) of the act of the schema (self.glp, Proposer: "the one the line names as its proposer where it names one"); where the pragmas give no role for it, any, its first guarding role.  The proposer of a guarded part with no opener is the person in the base (ibid.: "where the base of the schema is a guarding role, its proposer is the person in the base"; the printed text's part_bases).
%% The conjuncts of each schema local to the role holding their anchor, schema_locals(Name, Locals), each local(Base, Xs, A, Phi, CAdd, CDel), in conjunct order (lc_conjs): "the instances of a conjunct with conditional literals give the atoms each adds or deletes", the role "yielding d_p less the deleted atoms, those of the conditional literals at each instance of their conjunct, in L or, for a conjunct local to p's role, in d_p, included, which d_p need not hold, ... plus the added ones, likewise" (vGLP fe12932, Section 5.4, "Speech-act schemas as local specifications"); the printed text's local_effect applies them.
procedure local_lines(Lxs?, Lines).
local_lines(Lx, ['', 'procedure schema_locals(Constant?, Locals).'|L?]) :- ground(Lx?) |
    lc_names(Lx?, Ns0),
    dedup(Ns0?, Ns),
    local_lines1(Ns?, Lx?, L).
procedure lc_names(Lxs?, Preds).
lc_names([], []).
lc_names([lc(S, _, _, _, _, _, _)|Lx], [S?|Ns?]) :- lc_names(Lx?, Ns).
lc_names([_|Lx], Ns?) :- otherwise | lc_names(Lx?, Ns).
procedure local_lines1(Preds?, Lxs?, Lines).
local_lines1([], _, ['schema_locals(_, []) :- otherwise | true.']).
local_lines1([S|Ss], Lx, [T?, '.'|L?]) :- ground(S?), ground(Lx?) |
    lc_of(Lx?, S?, Ls),
    T0 =.. [schema_locals, S?, Ls?],
    term_to_string(T0?, T),
    local_lines1(Ss?, Lx?, L).
TLocal  ::= local(Integer, Args, Atom, Form, HMults, HMults).
TLocals ::= [] ; [TLocal | TLocals].
procedure lc_of(Lxs?, Constant?, TLocals).
lc_of([], _, []).
lc_of([lc(S1, Bi, Xs, A, Phi, CA, CD)|Lx], S, [local(Bi?, Xs?, A?, Phi?, CA?, CD?)|Ls?]) :- S1? =?= S? | lc_of(Lx?, S?, Ls).
lc_of([_|Lx], S, Ls?) :- otherwise | lc_of(Lx?, S?, Ls).
procedure worded_acts(Worded?, TActs).
worded_acts(words(pragmas(_, As, _, _, _, _, _, _), _, _, _, _), As?).
%% The standing declarations of a contract carrying pragmas.
procedure worded_stands(Worded?, PStands).
worded_stands(words(pragmas(_, _, Ss, _, _, _, _, _), _, _, _, _), Ss?).
%% What the phone does for the contract (norm_pragmas): the predicates it finds, and the standing schemas whose standing request opens it to persons it does not know.
procedure worded_phone(Worded?, PhoneFacts).
worded_phone(words(pragmas(_, _, _, _, _, _, Ph, _), _, _, _, _), Ph?).
procedure phone_found(PhoneFacts?, Preds).
phone_found([], []).
phone_found([found(P)|Ps], [P?|Fs?]) :- phone_found(Ps?, Fs).
phone_found([trust(_)|Ps], Fs?) :- phone_found(Ps?, Fs).
procedure phone_trust(PhoneFacts?, Preds).
phone_trust([], []).
phone_trust([trust(S)|Ps], [S?|Ts?]) :- phone_trust(Ps?, Ts).
phone_trust([found(_)|Ps], Ts?) :- phone_trust(Ps?, Ts).
%% trust_schemas(Ss), the standing schemas whose standing request opens the phone to persons it does not know (vGLP, Section 5.4: "An implementation pragma may open a person's phone to persons it does not know, over Bluetooth and the local network, from their standing request until they withdraw it"), printed where there is one (trust_only lines of the text).
procedure trust_lines(Preds?, Lines).
trust_lines([], []).
trust_lines([S|Ss], ['', 'procedure trust_schemas(Preds).', L?]) :- ground(S?), ground(Ss?) |
    term_to_string([S?|Ss?], T),
    string_concat(['trust_schemas(', T?, ').'], L).
%% The standing tables of the platform (vGLP 7c631b1, Section 5.4, "The contract's words"): schema_standing(S, on(A)) for each standing schema S, A the act whose request makes the standing request, and none for every other; stand_act(M, makes(S)) for the act M whose request makes it, stand_act(M, withdraws(S)) for the act whose request withdraws it, and plain for every other.
%% The roles of each schema whose persons must consent to its act and are not asked (vGLP, Section 5.4, "The contract's words": "A clause may say that a person, or a ward, must consent to its act: they are a guard of the act, so it is never taken against them, and they are not asked"): schema_consents(S, Is) for each act of the pragmas that carries consents(I) with the types of its fields (self.glp, FType), and [] for every other.
procedure consent_lines(TActs?, Lines).
consent_lines(As, ['', 'procedure schema_consents(Constant?, Ints).'|L?]) :- ground(As?) |
    consent_lines1(As?, L).
procedure consent_lines1(TActs?, Lines).
consent_lines1([], ['schema_consents(_, []) :- otherwise | true.']).
consent_lines1([act(S, _, _, _, _, _, Ft)|As], L?) :- ground(S?), ground(Ft?) |
    consent_roles(Ft?, Is),
    consent_line(Is?, S?, L1),
    consent_lines1(As?, L2),
    lapp(L1?, L2?, L).
procedure consent_roles(FTypes?, Ints).
consent_roles([], []).
consent_roles([consents(I)|Fs], [I?|Is?]) :- consent_roles(Fs?, Is).
consent_roles([ft(_, _)|Fs], Is?) :- consent_roles(Fs?, Is).
procedure consent_line(Ints?, Constant?, Lines).
consent_line([], _, []).
consent_line([I|Is], S, [T?, '.']) :- ground(I?), ground(Is?), ground(S?) |
    T0 =.. [schema_consents, S?, [I?|Is?]],
    term_to_string(T0?, T).
procedure standing_lines(Contract?, PStands?, Lines).
standing_lines(_, [], []).
standing_lines(C, [S0|Ss0], ['', 'procedure schema_standing(Constant?, StandOn).'|L?]) :- ground(C?), ground(S0?), ground(Ss0?) |
    standing_lines1(C?, [S0?|Ss0?], L).
procedure standing_lines1(Contract?, PStands?, Lines).
standing_lines1(C, Ss, L?) :- ground(C?), ground(Ss?) |
    standing_on_lines(Ss?, L1),
    stand_act_lines(C?, Ss?, L2),
    lapp(L1?, ['schema_standing(_, none) :- otherwise | true.', '', 'procedure stand_act(Constant?, StandAct).'|L2?], L).
procedure standing_on_lines(PStands?, Lines).
standing_on_lines([], []).
standing_on_lines([standing(S, A, _)|Ss], [T?, '.'|L?]) :- ground(S?), ground(A?) |
    T0 =.. [schema_standing, S?, on(A?)],
    term_to_string(T0?, T),
    standing_on_lines(Ss?, L).
procedure stand_act_lines(Contract?, PStands?, Lines).
stand_act_lines([], _, ['stand_act(_, plain) :- otherwise | true.']).
stand_act_lines([schema(M, _, Rs)|Cs], Ss, L?) :- ground(M?), ground(Rs?), ground(Ss?) |
    stand_act_of(Ss?, M?, A),
    stand_act_line(A?, M?, L1),
    stand_act_lines(Cs?, Ss?, L2),
    lapp(L1?, L2?, L).
stand_act_lines([_|Cs], Ss, L?) :- otherwise | stand_act_lines(Cs?, Ss?, L).
procedure stand_act_line(StandAct?, Constant?, Lines).
stand_act_line(plain, _, []).
stand_act_line(makes(S), M, [T?, '.']) :- ground(S?), ground(M?) |
    T0 =.. [stand_act, M?, makes(S?)], term_to_string(T0?, T).
stand_act_line(withdraws(S), M, [T?, '.']) :- ground(S?), ground(M?) |
    T0 =.. [stand_act, M?, withdraws(S?)], term_to_string(T0?, T).
%% What a schema's request does to a standing declaration (vGLP 7c631b1, Section 5.4, "The contract's words": "the person's request of the act of the first button is also their standing request ... of every class of the clause's acts that they propose, and their request of the act of the second withdraws it"): the first declaration whose first act it is, makes, or whose second, withdraws.
procedure stand_act_of(PStands?, Constant?, StandAct).
stand_act_of([], _, plain).
stand_act_of([standing(S, A, W)|Ss], M, R?) :- ground(S?), ground(A?), ground(W?), ground(M?) |
    same_act(M?, A?, Ad),
    same_act(M?, W?, De),
    stand_act_of1(Ad?, De?, S?, Ss?, M?, R).
procedure stand_act_of1(YesNo?, YesNo?, Constant?, PStands?, Constant?, StandAct).
stand_act_of1(yes, _, S, _, _, makes(S?)).
stand_act_of1(no, yes, S, _, _, withdraws(S?)).
stand_act_of1(no, no, _, Ss, M, R?) :- stand_act_of(Ss?, M?, R).
procedure same_act(Constant?, Constant?, YesNo).
same_act(X, Y, yes) :- X? =?= Y? | true.
same_act(_, _, no) :- otherwise | true.
%% The pairs of each schema's roles that its clause names possibly one person, schema_ones(Name, Pairs), each may_one(J, I), which the platform's rule of a schema-binding reads (text.glp, rule_ok; vGLP, Section 5.4, "Speech-act schemas as local specifications": "distinct agent roles to distinct persons but for two the clause names as possibly one person").
MayOne  ::= may_one(Integer, Integer).
MayOnes ::= [] ; [MayOne | MayOnes].
procedure worded_ones(Worded?, Ones).
worded_ones(words(_, _, _, D, _), Os?) :- ones_of(D?, Os).
procedure ones_lines(Ones?, Lines).
ones_lines(Os, ['', 'MayOne    ::= may_one(Integer, Integer).', 'MayOnes   ::= [] ; [MayOne | MayOnes].', 'procedure schema_ones(Constant?, MayOnes).'|L?]) :- ones_lines1(Os?, L).
procedure ones_lines1(Ones?, Lines).
ones_lines1([], ['schema_ones(_, []) :- otherwise | true.']).
ones_lines1([ones(N, Ps)|Os], [T?, '.'|L?]) :- ground(N?) |
    may_ones(Ps?, Ms),
    T0 =.. [schema_ones, N?, Ms?],
    term_to_string(T0?, T),
    ones_lines1(Os?, L).
procedure may_ones(Sames?, MayOnes).
may_ones([], []).
may_ones([same(J, I)|Ps], [may_one(J?, I?)|Ms?]) :- may_ones(Ps?, Ms).
may_ones([mark(_)|Ps], Ms?) :- may_ones(Ps?, Ms).
may_ones([gship(_, _, _)|Ps], Ms?) :- may_ones(Ps?, Ms).
%% The pairs of persons of different names, one an agent variable that is no role, that a schema's clause names possibly one person, schema_vones(Name, VOnes), each vone(K, L) or vone_any(K), which the platform's rule of a schema-binding reads (text.glp, vars_ok; self.glp, vones_of; vGLP, Section 5.4, "Speech-act schemas as local specifications": "and persons of different names to different persons but for two the clause names as possibly one person").
procedure worded_vones(Worded?, SVOnesL).
worded_vones(words(_, _, _, D, _), Os?) :- vones_of(D?, Os).
procedure vones_lines(SVOnesL?, Lines).
vones_lines(Os, ['', 'VOne      ::= vone(Var, Var) ; vone_any(Var) ; vone_all.', 'VOnes     ::= [] ; [VOne | VOnes].', 'procedure schema_vones(Constant?, VOnes).'|L?]) :- vones_lines1(Os?, L).
procedure vones_lines1(SVOnesL?, Lines).
vones_lines1([], ['schema_vones(_, []) :- otherwise | true.']).
vones_lines1([vones(_, [])|Os], L?) :- vones_lines1(Os?, L).
vones_lines1([vones(N, [V|Vs])|Os], [T?, '.'|L?]) :- ground(N?), ground(V?), ground(Vs?) |
    T0 =.. [schema_vones, N?, [V?|Vs?]],
    term_to_string(T0?, T),
    vones_lines1(Os?, L).
procedure base_lines(Contract?, TActs?, Lxs?, Lines).
base_lines(C, As, Lx, ['', 'procedure schema_base(Constant?, Integer).'|L?]) :- ground(C?), ground(As?), ground(Lx?) | base_lines1(C?, As?, Lx?, L).
%% The base of the conjuncts of a schema local to their base, its listed roles' and those of its conjuncts whose instances the attempt names, which have one (q_lines, local.glp).
procedure base_lines1(Contract?, TActs?, Lxs?, Lines).
base_lines1([], _, _, ['schema_base(_, 1) :- otherwise | true.']).
base_lines1([schema(S, _, Rs)|Ss], As, Lx, [T?, '.'|L?]) :- ground(S?), ground(Rs?), ground(As?), ground(Lx?) |
    listed_bases(Rs?, Bs0),
    ix_bases(Lx?, S?, Bs1),
    app(Bs0?, Bs1?, Bs),
    guard_indices1(Rs?, 1, Gs),
    named_role(As?, S?, Gs?, Ns),
    base_of(Bs?, Ns?, B),
    T0 =.. [schema_base, S?, B?],
    term_to_string(T0?, T),
    base_lines1(Ss?, As?, Lx?, L).
base_lines1([cschema(_, _, _, _)|Ss], As, Lx, L?) :- base_lines1(Ss?, As?, Lx?, L).
base_lines1([nschema(_, _, _, _)|Ss], As, Lx, L?) :- base_lines1(Ss?, As?, Lx?, L).
%% The guarding role the pragma of the schema S names before its button, first, then the schema's guarding roles Gs: the first of by(Ns) of the act of S, a guarding role at which the act is proposed (self.glp, Proposer), where it names one.
procedure named_role(TActs?, Constant?, Ints?, Ints).
named_role([], _, Gs, Gs?).
named_role([act(S1, _, _, _, _, P, _)|_], S, Gs, Ns?) :- S1? =?= S?, ground(Gs?) | proposer_role(P?, Gs?, Ns).
named_role([_|As], S, Gs, Ns?) :- otherwise | named_role(As?, S?, Gs?, Ns).
procedure proposer_role(Proposer?, Ints?, Ints).
proposer_role(by([N|_]), Gs, [N?|Gs?]).
proposer_role(by([N|_], _), Gs, [N?|Gs?]).
proposer_role(_, Gs, Gs?) :- otherwise | true.
procedure base_of(Ints?, Ints?, Integer).
base_of([B|_], _, B?).
base_of([], [G|_], G?).
base_of([], [], 1).
procedure guard_indices1(RoleSpecs?, Integer?, Ints).
guard_indices1([], _, []).
guard_indices1([R|Rs], I, Gs?) :- ground(R?), integer(I?) |
    rs_guarded(R?, G),
    I1 := I? + 1,
    guard_indices1(Rs?, I1?, Gs1),
    keep_gi(G?, I?, Gs1?, Gs).
procedure keep_gi(YesNo?, Integer?, Ints?, Ints).
keep_gi(yes, I, Gs, [I?|Gs?]).
keep_gi(no, _, Gs, Gs?).
%% The schemas' numbers, schema_numeric(Name, numeric(Conjuncts, Locals, Reads)), printed for each schema with a constraint, a local variable or a reading: the conjuncts of its constraint each with its role, cj(every, C), which every role checks, cj(at(I), C), which the role I checks, and cj(cond, C), of the part's condition, which the initiator checks on the readings, its counts named num('#k') (local.glp, conjuncts_of); its variables local to a role; and what each role reads with its vote yes, read(I, Vars, Counts) (local.glp, reads_of) (vGLP 566c186, Section 5.4, "Speech-act schemas as local specifications"); any other schema has none, numeric([], [], []).
%% The set variables local to a role of each schema, schema_lsets(Name, Xs), printed for a contract with a set variable (lx_sets), which the role's machine binds from its state (text.glp, dom_bindings; local.glp, set_locals): its local variables, num(X), that are set variables of the schema, st(Name, X) in Lx.
procedure lsets_lines(YesNo?, NumInfos?, Lxs?, Lines).
lsets_lines(no, _, _, []).
lsets_lines(yes, Nt, Lx, ['', 'procedure schema_lsets(Constant?, List(Constant)).'|L?]) :- ground(Nt?), ground(Lx?) |
    lsets_lines1(Nt?, Lx?, L1),
    lapp(L1?, ['schema_lsets(_, []) :- otherwise | true.'], L).
procedure lsets_lines1(NumInfos?, Lxs?, Lines).
lsets_lines1([], _, []).
lsets_lines1([num_info(S, _, Ls, _, _, _)|Ns], Lx, L?) :- ground(S?), ground(Ls?), ground(Lx?) |
    loc_vars(Ls?, Vs),
    lset_names(Vs?, S?, Lx?, Xs),
    lsets_line(Xs?, S?, L1),
    lsets_lines1(Ns?, Lx?, L2),
    lapp(L1?, L2?, L).
procedure lset_names(Args?, Constant?, Lxs?, List(Constant)).
lset_names([], _, _, []).
lset_names([num(X)|Vs], S, Lx, Xs?) :- ground(X?), ground(S?), ground(Lx?) |
    mem(st(S?, X?), Lx?, In),
    lset_names(Vs?, S?, Lx?, Xs1),
    keep_const(In?, X?, Xs1?, Xs).
lset_names([_|Vs], S, Lx, Xs?) :- otherwise | lset_names(Vs?, S?, Lx?, Xs).
procedure keep_const(YesNo?, Constant?, List(Constant)?, List(Constant)).
keep_const(yes, X, Xs, [X?|Xs?]).
keep_const(no, _, Xs, Xs?).
procedure lsets_line(List(Constant)?, Constant?, Lines).
lsets_line([], _, []).
lsets_line([X|Xs], S, [T?, '.']) :- ground(S?), ground(X?), ground(Xs?) |
    T0 =.. [schema_lsets, S?, [X?|Xs?]],
    term_to_string(T0?, T).
procedure numeric_lines(NumInfos?, Lines).
numeric_lines(Nt, ['', 'procedure schema_numeric(Constant?, Numeric).'|L?]) :- ground(Nt?) |
    numeric_lines1(Nt?, L1),
    form_lines(Nt?, L2),
    held_lines(Nt?, L3),
    lapp(L2?, ['', 'procedure schema_held(Constant?, HPats).'|L3?], L23),
    lapp(L1?, ['', 'procedure schema_forms(Constant?, SForms).'|L23?], L).
procedure numeric_lines1(NumInfos?, Lines).
numeric_lines1([], ['schema_numeric(_, numeric([], [], [])) :- otherwise | true.']).
numeric_lines1([num_info(S, _, Ls, Cj, _, Rd)|Ns], L?) :- ground(S?), ground(Cj?), ground(Ls?), ground(Rd?) |
    loc_vars(Ls?, Vs1),
    loc_vars(Ls?, Vs2),
    plain_num(Cj?, Vs1?, Rd?, P),
    numeric_line(P?, S?, Cj?, Vs2?, Rd?, L1),
    numeric_lines1(Ns?, L2),
    lapp(L1?, L2?, L).
%% The safe formulas of the schemas' bodies, schema_forms(Name, Forms), printed for each schema with one, each sform(R, F), F the formula as programs/gsc writes it and R the role it is local to, at(I), or every, which every role checks (vGLP bcb2726, Section 5.4, "Speech-act schemas as local specifications": "A safe formula of B ... is local to a role where every atom of it ... is held by that role ...: the machine of the person in that role evaluates it in its own state"; local.glp, form_infos, which refuses one local to no role).
procedure form_lines(NumInfos?, Lines).
form_lines([], ['schema_forms(_, []) :- otherwise | true.']).
form_lines([num_info(S, _, _, _, Fi, _)|Ns], L?) :- ground(S?), ground(Fi?) |
    form_line(Fi?, S?, L1),
    form_lines(Ns?, L2),
    lapp(L1?, L2?, L).
procedure form_line(FInfos?, Constant?, Lines).
form_line([], _, []).
form_line([F|Fs], S, [T?, '.']) :- ground(S?), ground(F?), ground(Fs?) |
    sforms([F?|Fs?], Sf),
    T0 =.. [schema_forms, S?, Sf?],
    term_to_string(T0?, T).
SForm  ::= sform(FRole, Form).
SForms ::= [] ; [SForm | SForms].
procedure sforms(FInfos?, SForms).
sforms([], []).
%% A formula of the condition printed with each atom's holder first among its arguments, as the initiator evaluates it on the readings (local.glp, tag_form).
sforms([fi(cond, F)|Fs], [sform(cond, F1?)|Ss?]) :- local # tag_form(F?, F1), sforms(Fs?, Ss).
sforms([fi(R, F)|Fs], [sform(R?, F?)|Ss?]) :- otherwise | sforms(Fs?, Ss).
%% The atoms each role reads for the formulas of the condition of each schema, schema_held(Name, HPats), hp(I, Atoms) for each role I holding atoms of them (vGLP 5f55cf3, Section 5.4: "the reading of a participant's state then holds, beside the values of the variables read at its role, the atoms of that state that the atoms of the formula held by its role match").
procedure held_lines(NumInfos?, Lines).
held_lines([], ['schema_held(_, []) :- otherwise | true.']).
held_lines([num_info(S, _, Ls, _, Fi, _)|Ns], L?) :- ground(S?), ground(Fi?), ground(Ls?) |
    cond_held(Fi?, Ls?, Hp),
    held_line(Hp?, S?, L1),
    held_lines(Ns?, L2),
    lapp(L1?, L2?, L).
procedure cond_held(FInfos?, Locs?, HPats).
cond_held([], _, []).
cond_held([fi(cond, F)|Fs], Ls, Hp?) :- ground(Ls?) | local # form_held(F?, Ls?, H1), cond_held(Fs?, Ls?, H2), app(H1?, H2?, Hp).
cond_held([_|Fs], Ls, Hp?) :- otherwise | cond_held(Fs?, Ls?, Hp).
procedure held_line(HPats?, Constant?, Lines).
held_line([], _, []).
held_line([H|Hs], S, [T?, '.']) :- ground(H?), ground(Hs?), ground(S?) |
    T0 =.. [schema_held, S?, [H?|Hs?]],
    term_to_string(T0?, T).
procedure plain_num(Conjs?, Args?, Reads?, YesNo).
plain_num([], [], [], yes).
plain_num(_, _, _, no) :- otherwise | true.
procedure numeric_line(YesNo?, Constant?, Conjs?, Args?, Reads?, Lines).
numeric_line(yes, _, _, _, _, []).
numeric_line(no, S, Cj, Vs, Rd, [T?, '.']) :- ground(S?), ground(Cj?), ground(Vs?), ground(Rd?) |
    T0 =.. [schema_numeric, S?, numeric(Cj?, Vs?, Rd?)],
    term_to_string(T0?, T).
procedure schema_name(TSchema?, Constant).
schema_name(schema(Nm, _, _), Nm?).
schema_name(lschema(Nm, _, _, _), Nm?).
procedure plain_specs(RoleSpecs?, RoleSpecs).
plain_specs([], []).
plain_specs([rs(G, A, D, K, F)|Rs], [rs(G?, A?, D?, K?, F?)|Ps?]) :- plain_specs(Rs?, Ps).
plain_specs([crs(_, G, A, D, K, F)|Rs], [rs(G?, A?, D?, K?, F?)|Ps?]) :- plain_specs(Rs?, Ps).

%% name_class(N, S, C): the class term of the part a request name N names at an agent of the machine state S (vGLP f5f1644, Section 5.4, "Triggers": on propose(N) the agent "proposes, among the guarded parts it guards and is ready for of the classes of the parts named N, the one it has proposed least recently"): N itself for a schema with no listed role, and for one with listed roles N with the people the state lists at the place of each, which the shared text finds (listed_class), so the base agent completes each list from its listed atoms (vGLP #15 Cowork to Code, 2026-10-19 14:24 UTC, item 2; vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC: "the base agent filling in each from its own listed atoms").  Printed for the schemas the request type proposes, and only where it has one.
procedure name_class_lines(Contract?, Preds?, Lines).
name_class_lines([], _, []).
name_class_lines([schema(S, Hd, Rs)|Ss], Ps, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?) |
    mem(S?, Ps?, In),
    name_class_lines1(In?, S?, Hd?, Rs?, L1),
    name_class_lines(Ss?, Ps?, L2),
    lapp(L1?, L2?, L).
name_class_lines([cschema(_, _, _, _)|Ss], Ps, L?) :- name_class_lines(Ss?, Ps?, L).
name_class_lines([nschema(_, _, _, _)|Ss], Ps, L?) :- name_class_lines(Ss?, Ps?, L).
procedure name_class_lines1(YesNo?, Constant?, Args?, RoleSpecs?, Lines).
name_class_lines1(no, _, _, _, []).
name_class_lines1(yes, S, Hd, Rs, L?) :- ground(S?), ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    list_places(Rs?, Hd?, Lis),
    name_class_line(Lis?, S?, Vs?, L).
procedure name_class_line(Ints?, Constant?, Args?, Lines).
name_class_line([], S, Vs, [T?, '.']) :- ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, Qs),
    named_call(S?, Ns?, In),
    named_call(S?, Qs?, Out),
    call_text(name_class, [In?, '_', Out?], T).
name_class_line([I|Is], S, Vs, [T?, ':-', G?, '.']) :- integer(I?), ground(Is?), ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns0, _),
    drop_at(Ns0?, 1, [I?|Is?], Ns),
    bind_terms_skip(Vs?, 1, [I?|Is?], Bs),
    named_call(S?, Ns?, In),
    term_to_string(S?, S1),
    list_text(Bs?, Bl),
    call_text(name_class, [In?, 'St', 'C?'], T),
    call_text(listed_class, [S1?, Bl?, 'St?', 'C'], G).
procedure drop_at(Strings?, Integer?, Ints?, Strings).
drop_at([], _, _, []).
drop_at([X|Xs], I, Lis, R?) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    drop_at(Xs?, I1?, Lis?, R1),
    mem(I?, Lis?, In),
    keep_at(In?, X?, R1?, R).
procedure keep_at(YesNo?, String?, Strings?, Strings).
keep_at(yes, _, R, R?).
keep_at(no, X, R, [X?|R?]).
procedure name_class_decl(Lines?, Lines).
name_class_decl([], []).
name_class_decl([X|Xs], ['', 'procedure name_class(Proposal?, GAtoms?, Class).', X?|Xs?]).

%% request_name(C, pname(N)): the request name N of the part the class term C names, its schema-binding, with no list of the people of its listed roles, for the schemas the request type proposes, and nopname for any other class term (vGLP f0acbc1, Section 5.4, "Act schemas as local specifications": "its request name is the schema-binding"); the shared text asks it whether a class is of a request rho_N, a guarded part of the class with an opener being named N (in_rho; Definition "Effective Local Specification": "whether a class is in rho_N being decidable from a part of it and N").  Printed for the schemas the request type proposes, and only where it has one.
procedure request_name_lines(Contract?, Preds?, Lines).
request_name_lines([], _, []).
request_name_lines([schema(S, Hd, Rs)|Ss], Ps, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?) |
    mem(S?, Ps?, In),
    request_name_lines1(In?, S?, Hd?, Rs?, L1),
    request_name_lines(Ss?, Ps?, L2),
    lapp(L1?, L2?, L).
request_name_lines([cschema(_, _, _, _)|Ss], Ps, L?) :- request_name_lines(Ss?, Ps?, L).
request_name_lines([nschema(_, _, _, _)|Ss], Ps, L?) :- request_name_lines(Ss?, Ps?, L).
procedure request_name_lines1(YesNo?, Constant?, Args?, RoleSpecs?, Lines).
request_name_lines1(no, _, _, _, []).
request_name_lines1(yes, S, Hd, Rs, [T?, '.']) :- ground(S?), ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    list_places(Rs?, Hd?, Lis1),
    list_places(Rs?, Hd?, Lis2),
    var_names(Vs?, 1, Ns0, Qs0),
    blank_names(Ns0?, 1, Lis1?, Ns),
    drop_at(Qs0?, 1, Lis2?, Qs),
    named_call(S?, Ns?, In),
    named_call(S?, Qs?, Out),
    call_text(pname, [Out?], P),
    call_text(request_name, [In?, P?], T).
%% The names, the place of each listed role written _, which the clause does not read.
procedure blank_names(Strings?, Integer?, Ints?, Strings).
blank_names([], _, _, []).
blank_names([X|Xs], I, Lis, [Y?|R?]) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    mem(I?, Lis?, In),
    blank_one(In?, X?, Y),
    blank_names(Xs?, I1?, Lis?, R).
procedure blank_one(YesNo?, String?, String).
blank_one(yes, _, '_').
blank_one(no, X, X?).
procedure request_name_decl(Lines?, Lines).
request_name_decl([], []).
request_name_decl([X|Xs], ['', 'procedure request_name(Class?, PName).', X?|Xs1?]) :-
    lapp(Xs?, ['request_name(_, nopname) :- otherwise | true.'], Xs1).

%% --- The contract's words ---------------------------------------------------
%% vGLP, Section 5.4, "The contract's words": "Beside its clauses and its schemas a contract carries the words its app shows, its pragmas: for each schema, the label of the request that proposes its act and a name for each field the person fills in, and, for each guarding role, the sentence put to that role's agent and its two answers; and, for each list the app shows, its name and what it lists.  A sentence names the roles and the variables of its schema, which the platform fills in from the binding of the attempt it asks about.  The compiler carries them into the platform it prints: a request's label and field names and an approval question's two answers into the widget declarations it prints for the platform's request type and approval type (Section 6.2), a sentence into the approval question that Start raises, and a list's name into the view the agent writes."  GSC, Section 2, its first paragraph: "the first line names a tab of the app and what it lists, and each other line names a clause, then the button proposing its act, in brackets, any field the person fills, in angle brackets, and, where the act needs another person's will, the question that person is then asked."  The forms the papers leave open, and the forms chosen here, are in README.md beside this file.

%% A contract whose pragmas name what the contract does not hold is not compiled, with a line saying why: a list naming no predicate of the contract, or more than one; a button naming no schema of the contract, the button's text read in lower case being the schema's name ("each bearing its act's name", GSC 2991379, Section 2); a pragma naming more fields than its schema has variables the person fills; a sentence naming a person, Alice, Bob or Carol, that its schema does not have; and a guarded schema no button names (unnamed_lines).
procedure word_faults(Worded?, Contract?, NumInfos?, Preds?, Lines).
word_faults(words(pragmas(Ls, As, Ss, _, _, _, _, _), _, Lx, _, _), C, Nt, Ps, F?) :- ground(Ls?), ground(As?), ground(Ss?), ground(C?), ground(Ps?), ground(Lx?) |
    contract_preds_lx(C?, Nt?, Lx?, Pr),
    list_faults(Ls?, Pr?, F1),
    act_faults(As?, C?, F2),
    act_names(As?, Ns0),
    stand_names(Ss?, Sn),
    app(Ns0?, Sn?, Ns),
    unnamed_lines(Ps?, Ns?, F3),
    proposer_faults(As?, C?, Lx?, F4),
    standing_faults(Ss?, C?, F5),
    dead_lines(As?, C?, Ps?, F6),
    lapp(F1?, F2?, F12),
    lapp(F3?, F4?, F34),
    lapp(F12?, F34?, F1234),
    lapp(F5?, F6?, F56),
    lapp(F1234?, F56?, F).
%% The schemas the standing declarations name: "the standing act has no button" (vGLP d433f71, Section 5.4, "The contract's words"), so a guarded schema declared standing is named although no button names it.
procedure stand_names(PStands?, Preds).
stand_names([], []).
stand_names([standing(S, _, _)|Ss], [S?|Ns?]) :- stand_names(Ss?, Ns).
%% A standing declaration, standing(S, A, W), is of a guarded schema S of the contract, its acts made standing by the request of the act A and withdrawn by that of the act W, both acts of the contract (vGLP 7c631b1, Section 5.4, "The contract's words": "An implementation pragma may make the acts of a clause standing ... the person's request of the act of the first button is also their standing request (Definition Local) of every class of the clause's acts that they propose, and their request of the act of the second withdraws it; a standing act has no button, every guarding role of it proposes it"); and, "every guarding role of it" proposing it, the atoms each guarding role requires name every other role and every variable of S, so that "the guarded parts with no opener of classes of rho that p proposes with s in dom(f) are finitely many and computable from p, s and rho" (Definition "Effective Local Specification").  A standing schema of another form, with a constraint, a quantifier or a listed role, is refused, the compiler not carrying it.
procedure standing_faults(PStands?, Contract?, Lines).
standing_faults([], _, []).
standing_faults([standing(S, A, W)|Ss], C, F?) :- ground(S?), ground(A?), ground(W?), ground(C?) |
    find_schema(S?, C?, Sf),
    standing_fault(Sf?, S?, F1),
    find_schema(A?, C?, Af),
    stand_act_fault(Af?, A?, F3),
    find_schema(W?, C?, Wf),
    stand_act_fault(Wf?, W?, F4),
    standing_faults(Ss?, C?, F2),
    lapp(F3?, F4?, F34),
    lapp(F1?, F34?, F12),
    lapp(F12?, F2?, F).
%% The two acts of a standing declaration, its first making the standing request and its second withdrawing it, are acts of the contract (vGLP 7c631b1, Section 5.4, "The contract's words").
procedure stand_act_fault(SFound?, Constant?, Lines).
stand_act_fault(nosfound, A, [L?]) :- ground(A?) |
    said('%% a standing declaration names, as the act that makes or withdraws the standing request, no schema of the contract that the compiler carries standing, one with no constraint, quantifier or listed role:', A?, L).
stand_act_fault(sfound(_, _), _, []).
procedure standing_fault(SFound?, Constant?, Lines).
standing_fault(nosfound, S, [L?]) :- ground(S?) |
    said('%% a standing declaration names no schema of the contract that the compiler carries standing, one with no constraint, quantifier or listed role:', S?, L).
standing_fault(sfound(Hd, Rs), S, L?) :- ground(Hd?), ground(Rs?), ground(S?) |
    guard_roles(Rs?, 1, Gs),
    rs_count(Rs?, K),
    role_args(1, K?, All),
    named_args(Hd?, Vs),
    app(All?, Vs?, Need),
    standing_fault0(Gs?, Rs?, Need?, S?, L).
procedure standing_fault0(Ints?, RoleSpecs?, Args?, Constant?, Lines).
standing_fault0(Gs, Rs, Need, S, L?) :- ground(Gs?) |
    standing_roles(Gs?, Rs?, Need?, Ok),
    standing_fault1(Gs?, Ok?, S?, L).
procedure standing_fault1(Ints?, YesNo?, Constant?, Lines).
standing_fault1([], _, S, [L?]) :- ground(S?) |
    said('%% a standing declaration names a schema with no guarding role, "a standing act has no button, every guarding role of it proposes it" (vGLP, Section 5.4, "The contract\'s words"):', S?, L).
standing_fault1([_|_], yes, _, []).
standing_fault1([_|_], no, S, [L?]) :- ground(S?) |
    said('%% a standing declaration names a schema a guarding role of which requires atoms that do not name every other role and every variable of it, so that its standing parts are not computable from that role\'s state (vGLP, Section 5.4, "The contract\'s words"; Definition "Effective Local Specification"):', S?, L).
%% Whether each guarding role I requires an atom of P, and its required atoms, with I, name every role and variable in Need.
procedure standing_roles(Ints?, RoleSpecs?, Args?, YesNo).
standing_roles([], _, _, yes).
standing_roles([I|Is], Rs, Need, B?) :- integer(I?), ground(Rs?), ground(Need?) |
    nth_spec(I?, Rs?, R),
    rs_lists(R?, _, M0, K0, _),
    uncleared(M0?, M),
    app(K0?, M?, K),
    standing_role(K?, I?, Need?, B1),
    standing_roles1(B1?, Is?, Rs?, Need?, B).
procedure standing_role(Atoms?, Integer?, Args?, YesNo).
standing_role(K, I, Need, B?) :- ground(K?) |
    atoms_args(K?, A0),
    named_args([role(I?)|A0?], A),
    all_in(Need?, A?, B).
procedure standing_roles1(YesNo?, Ints?, RoleSpecs?, Args?, YesNo).
standing_roles1(no, _, _, _, no).
standing_roles1(yes, Is, Rs, Need, B?) :- standing_roles(Is?, Rs?, Need?, B).
procedure nth_spec(Integer?, RoleSpecs?, RoleSpec).
nth_spec(I, [R|_], R?) :- I? =:= 1 | true.
nth_spec(I, [_|Rs], R?) :- I? > 1 | I1 := I? - 1, nth_spec(I1?, Rs?, R).
%% A role past the last, which guard_roles never gives, is none: the clause covers the type.
nth_spec(_, [], rs(unguarded, [], [], [], [])).
procedure has_pred(Constant?, Atoms?, YesNo).
has_pred(_, [], no).
has_pred(P, [atom(Q, _)|_], yes) :- P? =?= Q? | true.
has_pred(P, [times(_, A)|As], B?) :- has_pred(P?, [A?|As?], B).
has_pred(P, [rest(_, _, A)|As], B?) :- has_pred(P?, [A?|As?], B).
has_pred(P, [_|As], B?) :- otherwise | has_pred(P?, As?, B).
%% The roles and the variables among arguments, a signed term naming its variable and its role; a number names none.
procedure named_args(Args?, Args).
named_args([], []).
named_args([role(I)|As], [role(I?)|R?]) :- named_args(As?, R).
named_args([pvar(X)|As], [pvar(X?)|R?]) :- named_args(As?, R).
named_args([svar(X)|As], [svar(X?)|R?]) :- named_args(As?, R).
named_args([sgn(Y, I)|As], [svar(Y?), role(I?)|R?]) :- named_args(As?, R).
named_args([item_of(V)|As], R?) :- named_args([V?|As?], R).
named_args([_|As], R?) :- otherwise | named_args(As?, R).
procedure all_in(Args?, Args?, YesNo).
all_in([], _, yes).
all_in([A|As], Fa, B?) :- ground(A?), ground(Fa?) | mem(A?, Fa?, B1), all_in1(B1?, As?, Fa?, B).
procedure all_in1(YesNo?, Args?, Args?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, As, Fa, B?) :- all_in(As?, Fa?, B).
%% The person named before a button, of a schema whose conjuncts local to their base have a base that guards, is the person in the base: "The person named before a button is in a guarding role of its acts: in the base, where the base guards, and then their proposer, or, where the base is an opener, the one guard, who requests it" (vGLP 9ee6f87, Section 5.4, "The contract's words"), the base finding the instances in its own state.  A line naming another, by(Gs) of its act with a role other than the base, is a fault, the schema named.
procedure proposer_faults(TActs?, Contract?, Lxs?, Lines).
proposer_faults([], _, _, []).
proposer_faults([act(S, _, _, _, _, P, _)|As], C, Lx, F?) :- ground(S?), ground(P?), ground(C?), ground(Lx?) |
    find_schema(S?, C?, Sf),
    ix_bases(Lx?, S?, Ib),
    proposer_fault(Sf?, Ib?, P?, S?, F1),
    proposer_faults(As?, C?, Lx?, F2),
    lapp(F1?, F2?, F).
procedure proposer_fault(SFound?, Ints?, Proposer?, Constant?, Lines).
proposer_fault(nosfound, _, _, _, []).
proposer_fault(sfound(_, Rs), Ib, P, S, F?) :- ground(Rs?), ground(Ib?), ground(P?), ground(S?) |
    listed_bases(Rs?, Lb),
    app(Lb?, Ib?, Bs),
    guard_indices1(Rs?, 1, Gs),
    proposer_fault1(Bs?, Gs?, P?, S?, F).
procedure proposer_fault1(Ints?, Ints?, Proposer?, Constant?, Lines).
proposer_fault1([], _, _, _, []).
proposer_fault1([B|_], Gs, P, S, F?) :- integer(B?), ground(Gs?), ground(P?), ground(S?) |
    mem_int(B?, Gs?, G),
    by_roles(P?, Ns),
    others_than(Ns?, B?, O),
    proposer_fault2(G?, O?, S?, F).
procedure by_roles(Proposer?, Ints).
by_roles(by(Ns), Ns?).
by_roles(by(Ns, _), Ns?).
by_roles(any, []).
procedure others_than(Ints?, Integer?, YesNo).
others_than([], _, no).
others_than([N|_], B, yes) :- N? =\= B? | true.
others_than([_|Ns], B, O?) :- otherwise | others_than(Ns?, B?, O).
procedure proposer_fault2(YesNo?, YesNo?, Constant?, Lines).
proposer_fault2(yes, yes, S, [T?]) :- ground(S?) |
    said('%% a line of its pragmas names before a button a person other than the base of its schema, which guards (vGLP 9ee6f87, Section 5.4, "The contract\'s words": "The person named before a button is in a guarding role of its acts: in the base, where the base guards, and then their proposer"):', S?, T).
proposer_fault2(_, _, _, []) :- otherwise | true.

%% The predicates of the contract's atoms, each once.
procedure contract_preds(Contract?, NumInfos?, Preds).
contract_preds(C, Nt, Ps?) :- ground(C?) |
    contract_atoms(C?, As0),
    nt_atoms(Nt?, As1),
    app(As0?, As1?, As),
    atom_names(As?, Ns),
    dedup(Ns?, Ps).
%% The same, with the atoms of the quantified conjuncts, their anchors and their conditional literals (lx_atoms).
procedure contract_preds_lx(Contract?, NumInfos?, Lxs?, Preds).
contract_preds_lx(C, Nt, Lx, Ps?) :- ground(C?) |
    contract_atoms(C?, As0),
    nt_atoms(Nt?, As1),
    lx_atoms(Lx?, As2),
    app(As1?, As2?, As12),
    app(As0?, As12?, As),
    atom_names(As?, Ns),
    dedup(Ns?, Ps).
%% The atoms of the quantified conjuncts of the schemas: the conditional literals of each, and the anchor and the condition of each whose instances the attempt names, atoms of a state (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": "the instances of a conjunct with conditional literals give the atoms each adds or deletes").
procedure lx_atoms(Lxs?, Atoms).
lx_atoms([], []).
lx_atoms([lx(_, _, _, CA, CD)|Ls], As?) :-
    hm_atoms(CA?, A1),
    hm_atoms(CD?, A2),
    lx_atoms(Ls?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, As).
lx_atoms([rl(_, _)|Ls], As?) :- lx_atoms(Ls?, As).
lx_atoms([cn(_, _)|Ls], As?) :- lx_atoms(Ls?, As).
lx_atoms([st(_, _)|Ls], As?) :- lx_atoms(Ls?, As).
lx_atoms([lc(_, _, _, A, Phi, CA, CD)|Ls], [A?|As?]) :-
    f_atoms(Phi?, A0),
    hm_atoms(CA?, A1),
    hm_atoms(CD?, A2),
    lx_atoms(Ls?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, A123),
    app(A0?, A123?, As).
lx_atoms([ix(_, _, _, _, A, Phi, CA, CD)|Ls], [A?|As?]) :-
    f_atoms(Phi?, A0),
    hm_atoms(CA?, A1),
    hm_atoms(CD?, A2),
    lx_atoms(Ls?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, A123),
    app(A0?, A123?, As).
procedure hm_atoms(HMults?, Atoms).
hm_atoms([], []).
hm_atoms([hm(_, M)|Hs], [M?|As?]) :- hm_atoms(Hs?, As).
procedure atom_names(Atoms?, Preds).
atom_names([], []).
atom_names([atom(F, _)|As], [F?|Ns?]) :- atom_names(As?, Ns).
atom_names([times(_, A)|As], Ns?) :- atom_names([A?|As?], Ns).
atom_names([rest(_, _, A)|As], Ns?) :- atom_names([A?|As?], Ns).

%% What a list lists: the one predicate of the contract among the words of its pragma, "the persons Alice knows" the predicate knows, "the friends of Alice" friend, "the groups Alice is a member of" member.
procedure list_faults(PLists?, Preds?, Lines).
list_faults([], _, []).
list_faults([list(N, Ws)|Ls], Pr, F?) :- ground(N?), ground(Ws?), ground(Pr?) |
    listed_preds(Ws?, Pr?, Ms),
    list_fault(Ms?, N?, F1),
    list_faults(Ls?, Pr?, F2),
    lapp(F1?, F2?, F).
procedure listed_preds(Strings?, Preds?, Preds).
listed_preds(Ws, Pr, Ms?) :- ground(Ws?), ground(Pr?) |
    listed_preds1(Ws?, Pr?, Ms0),
    dedup(Ms0?, Ms).
procedure listed_preds1(Strings?, Preds?, Preds).
listed_preds1([], _, []).
listed_preds1([W|Ws], Pr, Ms?) :- ground(W?), ground(Pr?) |
    mem(W?, Pr?, In),
    listed_preds1(Ws?, Pr?, Ms1),
    keep_pred(In?, W?, Ms1?, Ms).
procedure keep_pred(YesNo?, Constant?, Preds?, Preds).
keep_pred(yes, P, Ps, [P?|Ps?]).
keep_pred(no, _, Ps, Ps?).
procedure list_fault(Preds?, String?, Lines).
list_fault([_], _, []).
list_fault([], N, [H?]) :- ground(N?) | string_concat(['%% the list of its pragmas names no predicate of the contract:(', N?, ')'], H).
list_fault([_, _|_], N, [H?]) :- ground(N?) | string_concat(['%% the list of its pragmas names more than one predicate of the contract:(', N?, ')'], H).

%% A schema of the contract, its head and its roles.
SFound ::= sfound(Args, RoleSpecs) ; nosfound.
procedure find_schema(Constant?, Contract?, SFound).
find_schema(_, [], nosfound).
find_schema(S, [schema(T, Hd, Rs)|_], sfound(Hd?, Rs?)) :- S? =?= T? | true.
find_schema(S, [_|Cs], F?) :- otherwise | find_schema(S?, Cs?, F).

%% Each act a pragma proposes, act(Name, Button, Fields, Sentence), is the schema Name its button names.
procedure act_faults(TActs?, Contract?, Lines).
act_faults([], _, []).
act_faults([act(N, _, Fs, Q, _, _, _)|As], C, F?) :- ground(N?), ground(Fs?), ground(Q?), ground(C?) |
    schema_faults([N?], Fs?, Q?, C?, F1),
    act_faults(As?, C?, F2),
    lapp(F1?, F2?, F).
procedure schema_faults(Preds?, Strings?, Said?, Contract?, Lines).
schema_faults([], _, _, _, []).
schema_faults([S|Ss], Fs, Q, C, F?) :- ground(S?), ground(Fs?), ground(Q?), ground(C?) |
    find_schema(S?, C?, Sf),
    schema_fault(Sf?, S?, Fs?, Q?, F1),
    schema_faults(Ss?, Fs?, Q?, C?, F2),
    lapp(F1?, F2?, F).
procedure schema_fault(SFound?, Constant?, Strings?, Said?, Lines).
schema_fault(nosfound, S, _, _, [H?]) :- ground(S?) |
    said('%% a pragma\'s button names no schema of the contract:', S?, H).
schema_fault(sfound(Hd, Rs), S, Fs, Q, F?) :- ground(Hd?), ground(Rs?), ground(S?), ground(Fs?), ground(Q?) |
    field_places(Hd?, Rs?, Fp),
    person_places(Hd?, Rs?, Pp),
    count_ints(Fp?, NF),
    count_strings(Fs?, NS),
    field_fault(NS?, NF?, S?, F1),
    said_fault(Q?, Pp?, S?, F2),
    question_fault(Q?, Rs?, S?, F3),
    lapp(F1?, F2?, F12),
    lapp(F12?, F3?, F).
procedure field_fault(Integer?, Integer?, Constant?, Lines).
field_fault(NS, NF, _, []) :- NS? =< NF? | true.
field_fault(NS, NF, S, [H?]) :- NS? > NF?, ground(S?) |
    said('%% a pragma names more fields than the schema has variables the person fills:', S?, H).
%% A line whose questions are neither one nor one per guarding role of its act, an act of two guarding roles or more (vGLP 21fca00, Section 5.4, "The contract's words": "a line's questions are one per guarding role of the widest schema of its clause, in the order of the roles, none left out").
procedure question_fault(Said?, RoleSpecs?, Constant?, Lines).
question_fault(none, _, _, []).
question_fault(said(Qs), Rs, S, F?) :- ground(Qs?), ground(Rs?), ground(S?) |
    count_questions(Qs?, NQ),
    guard_count(Rs?, NG),
    question_fault1(NQ?, NG?, S?, F).
procedure count_questions(PSentences?, Integer).
count_questions([], 0).
count_questions([_|Qs], N?) :- count_questions(Qs?, M), N := M? + 1.
procedure question_fault1(Integer?, Integer?, Constant?, Lines).
question_fault1(_, 1, _, []).
question_fault1(1, NG, _, []) :- NG? > 1 | true.
question_fault1(NQ, NG, _, []) :- NG? > 1, NQ? =:= NG? | true.
question_fault1(NQ, NG, S, [H?]) :- NG? > 1, NQ? =\= 1, NQ? =\= NG?, ground(S?) |
    said('%% a pragma\'s questions are neither one nor one per guarding role of the act:', S?, H).
question_fault1(_, 0, _, []).
procedure said_fault(Said?, Ints?, Constant?, Lines).
said_fault(none, _, _, []).
said_fault(said([]), _, _, []).
said_fault(said([Ws|Qs]), Pp, S, F?) :- ground(Ws?), ground(Qs?), ground(Pp?), ground(S?) |
    said_fault(said(Qs?), Pp?, S?, F2),
    said_fault0(Ws?, Pp?, S?, F1),
    lapp(F1?, F2?, F).
procedure said_fault0(PWords?, Ints?, Constant?, Lines).
said_fault0(Ws, Pp, S, F?) :- ground(Ws?), ground(Pp?), ground(S?) |
    count_ints(Pp?, NP),
    said_fault1(Ws?, NP?, S?, F).
procedure said_fault1(PWords?, Integer?, Constant?, Lines).
said_fault1([], _, _, []).
said_fault1([text(_)|Ws], NP, S, F?) :- said_fault1(Ws?, NP?, S?, F).
said_fault1([person(I)|Ws], NP, S, F?) :- I? =< NP? | said_fault1(Ws?, NP?, S?, F).
said_fault1([person(I)|_], NP, S, [H?]) :- I? > NP?, ground(S?) |
    said('%% a sentence names a person the schema does not have:', S?, H).
procedure count_strings(Strings?, Integer).
count_strings([], 0).
count_strings([_|Xs], N?) :- count_strings(Xs?, M), N := M? + 1.
procedure count_ints(Ints?, Integer).
count_ints([], 0).
count_ints([_|Xs], N?) :- count_ints(Xs?, M), N := M? + 1.

%% The places of a schema's request name that a pragma's fields may name, in the order of its head, the places of its listed roles left out (proposal_alts: the request name is "the binding, its head with no extent"): its roles, then its variables a person or the state fills, a pragma's fields naming them, a field left empty naming none, as pragmas.sh aligns them: "a button is pressed in the row of a tab's entry, whose person takes a role of the act, and the fields are what the proposer fills besides" (vGLP 516a0a2, Section 5.4, "The contract's words"), so the proposer's place and the entry's are left empty, and a field names each other role, as GAI's Agent meet <person> names Bob, and each variable, as GC's swap its four; a place no field names is filled from what the view lists or from the proposer's state.
procedure field_places(Args?, RoleSpecs?, Ints).
field_places(Hd, Rs, Fp?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs0?, Lis?, Vs),
    field_places2(Vs?, 1, [], Fp).
%% The places of the args Vs from I that a field may name: a role not in Lis, an agent, speech-act or numeric variable.
procedure field_places2(Args?, Integer?, Ints?, Ints).
field_places2([], _, _, []).
field_places2([V|Vs], I, Lis, Fp?) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    a_field(V?, I?, Lis?, F),
    field_places2(Vs?, I1?, Lis?, Fp1),
    keep_int(F?, I?, Fp1?, Fp).
procedure a_field(Arg?, Integer?, Ints?, YesNo).
a_field(role(_), I, Lis, F?) :- ground(Lis?) | mem(I?, Lis?, In), neg(In?, F).
a_field(pvar(_), _, _, yes).
a_field(svar(_), _, _, yes).
a_field(num(_), _, _, yes).
a_field(real(_), _, _, yes).
a_field(const(_), _, _, yes).
a_field(set(_), _, _, yes).
a_field(nterm(_), _, _, no).
a_field(sgn(_, _), _, _, no).
a_field(item_of(_), _, _, no).
a_field(val(_), _, _, no).
a_field(cmp(_, _), _, _, no).
a_field(any, _, _, no).
a_field(ilist(_, _), _, _, no).
procedure keep_int(YesNo?, Integer?, Ints?, Ints).
keep_int(yes, I, Is, [I?|Is?]).
keep_int(no, _, Is, Is?).
%% The places of a schema's class term that hold its persons, in the order of its head: its roles that are not listed roles, then its agent variables.  A sentence's Alice, Bob and Carol are the first, the second and the third of them, as GSC writes a schema, befriend(Alice?, Bob?), introduce(Alice?, Bob?; c), Carol its agent variable c (GSC, Sections 3.2 and 3.3).
procedure person_places(Args?, RoleSpecs?, Ints).
person_places(Hd, Rs, Pp?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    person_places1(Vs?, 1, Lis?, Pp).
procedure person_places1(Args?, Integer?, Ints?, Ints).
person_places1([], _, _, []).
person_places1([V|Vs], I, Lis, Pp?) :- integer(I?), ground(Lis?) |
    I1 := I? + 1,
    a_person(V?, I?, Lis?, P),
    person_places1(Vs?, I1?, Lis?, Pp1),
    keep_int(P?, I?, Pp1?, Pp).
procedure a_person(Arg?, Integer?, Ints?, YesNo).
a_person(role(_), I, Lis, P?) :- mem(I?, Lis?, In), neg(In?, P).
a_person(pvar(_), _, _, yes).
a_person(svar(_), _, _, no).
a_person(num(_), _, _, no).
a_person(real(_), _, _, no).
a_person(const(_), _, _, no).
a_person(set(_), _, _, no).
a_person(nterm(_), _, _, no).
a_person(sgn(_, _), _, _, no).
a_person(item_of(_), _, _, no).
a_person(val(_), _, _, no).
a_person(cmp(_, _), _, _, no).
a_person(any, _, _, no).
a_person(ilist(_, _), _, _, no).

%% The two widget declarations every platform carries (vGLP, Section 6.2, "The words a platform shows": "The compiler prints three widget declarations for a platform: for its request type, a menu of the buttons and the fields of the contract's acts; for its approval type, the question with the buttons yes and no"), so that no app writes a self.vglp: the approval question drawn by the construct family's approval_sentence, the request question by its social_menu.  With pragmas, the request type's declaration carries the buttons the contract's pragmas give, button(B, Acts), B the label in brackets and Acts the acts it names (Section 5.4, "The contract's words": "A button is of the acts it names"); each act, for each guarding role at which it is proposed, act(F, M, Pre, Binds, Fields, Same, Text): F its schema, M the place of the proposer in its request, Pre the atoms its schema requires and forbids at the proposer's role and what the schemas prove, Binds the places of its request those atoms bind, Fields its fields, field(I, S, T), its place I, its label S and its type T, in the schema's order, Same its places possibly one person and Text the text of its request form (Section 6.2: the request widget "draws one button for each way the viewer's state, in the last view written, satisfies the act at the proposer's role, with the values that way binds and the act's fields").  It carries no tab and no row: where the construct family draws a button is its own choice, from the atoms that bind the way (Section 6.2: "How the buttons of one act are arranged, each beside the atoms that bind it or as one button with a picker, is the construct family's").  The approval question's two answers are given by no pragma, so its declaration carries no label, and the construct family draws the name of each (Section 6.2: "A construct family draws the label it is given, and the name of the type where it is given none").  The grammar is README.md's beside this file, 6.
procedure widget_lines(Worded?, Contract?, Contract?, Preds?, NumInfos?, DrawCtx?, Lines).
widget_lines(_, _, _, [], _, _, ['', '%% The widget declaration of the platform (vGLP, Section 6.2, Definition "Widget Declaration"): its approval question drawn by the construct family\'s approval_sentence; a contract with no guarded part has no request question.', 'Approval =::= approval_sentence.']).
widget_lines(words(pragmas(_, As, _, _, _, _, _, _), _, _, _, _), C, Ch, Ps, Nt, Rf, ['', '%% The widget declarations of the platform (vGLP, Section 6.2, Definition "Widget Declaration"; "The words a platform shows"): its approval question drawn by the construct family\'s approval_sentence, and its request question, of the moded type Request?, by its social_menu, which reads the agent\'s own key and the persons it knows from the last view drawn on construct 0 (Section 6.2), with a button for each button of the contract\'s pragmas, button(B, Acts), B its label and Acts the acts it names, each act(F, M, Roles, Pre, Binds, Fields, Same, Text), F the schema, M the place of the proposer, Roles the places of its roles, Pre the atoms the schema requires, req(P, As), and forbids, forb(P, As), at the proposer\'s role and what the schemas prove, unless(P, As) and proved(Q, Ws, P, As), As each argument\'s place, at(K), a group\'s, grp(J, K), or any, Binds the places those atoms bind, Fields its fields, field(I, S, T), its place I, its label S and its type T, person, key, text or number, Same its places possibly one person, same(K, J), and Text the text of its request form, each word say(S) or at(I) (README.md beside this file, 6).', 'Approval =::= approval_sentence.', T?, '.', '', '%% The types of the request widget\'s term, social_menu(Buttons), printed with the platform as its request type and Atom are (vGLP 0eeea71, Section 5.4: the compiler types the term "by type declarations it prints with the platform"; Section 6.3, the paragraph after the construct process: the compilation forms the union of the values drawn, the raw inputs and the widget terms, the parameter T of the person channel, so the widget a construct draws is typed as its value is; README.md beside this file, 6).  RequestMenu\'s one alternative is T\'s.', 'RequestMenu ::= social_menu(List(MenuEntry)).', 'MenuEntry ::= button(String, List(MenuAct)) ; label(Constant, String) ; label(Constant, Integer, String).', 'MenuAct ::= act(Constant, Integer, List(Integer), List(MenuCond), List(Integer), List(MenuField), List(MenuCond), List(MenuWord)).', 'MenuCond ::= req(Constant, List(MenuCondArg)) ; forb(Constant, List(MenuCondArg)) ; unless(Constant, List(MenuCondArg)) ; proved(Constant, List(Constant), Constant, List(MenuCondArg)) ; same(Integer, Integer).', 'MenuCondArg ::= at(Integer) ; grp(Integer, Integer) ; any.', 'MenuField ::= field(Integer, String, MenuFieldType).', 'MenuFieldType ::= person ; key ; agent ; text ; number.', 'MenuWord ::= say(String) ; at(Integer).']) :-
    ground(As?), ground(C?), ground(Ch?), ground(Ps?), ground(Rf?) |
    act_buttons(As?, C?, Ch?, Ps?, Nt?, Rf?, [], Bs),
    button_texts(Bs?, Bt),
    list_text(Bt?, Bl),
    call_text('Request? =::= social_menu', [Bl?], T).
%% The declaration as a line of source (README.md beside this file, 6): a schema's and a predicate's name through term_to_string/2, a label and a word of the text as pragmas.sh writes them, a double-quoted string.
procedure button_texts(WButtons?, Strings).
button_texts([], []).
button_texts([button(B, As)|Bs], [T?|Ts?]) :-
    act_texts(As?, Xs),
    list_text(Xs?, Xl),
    call_text(button, [B?, Xl?], T),
    button_texts(Bs?, Ts).
procedure act_texts(WActs?, Strings).
act_texts([], []).
act_texts([act(F, M, Rp, Pre, Bd, Fd, Sm, Tx)|As], [T?|Ts?]) :- ground(F?), ground(M?), ground(Rp?), ground(Pre?), ground(Bd?), ground(Sm?) |
    term_to_string(F?, Ft),
    term_to_string(M?, Mt),
    term_to_string(Rp?, Rt),
    term_to_string(Pre?, Pt),
    term_to_string(Bd?, Bt),
    term_to_string(Sm?, St),
    field_texts(Fd?, Fs),
    list_text(Fs?, Fl),
    fword_texts(Tx?, Ws),
    list_text(Ws?, Wl),
    call_text(act, [Ft?, Mt?, Rt?, Pt?, Bt?, Fl?, St?, Wl?], T),
    act_texts(As?, Ts).
procedure field_texts(WFields?, Strings).
field_texts([], []).
field_texts([field(I, S, F)|Fs], [T?|Ts?]) :-
    term_to_string(I?, It),
    term_to_string(F?, Ft),
    call_text(field, [It?, S?, Ft?], T),
    field_texts(Fs?, Ts).
procedure fword_texts(FWords?, Strings).
fword_texts([], []).
fword_texts([say(S)|Ws], [T?|Ts?]) :- call_text(say, [S?], T), fword_texts(Ws?, Ts).
fword_texts([at(I)|Ws], [T?|Ts?]) :- term_to_string(at(I?), T), fword_texts(Ws?, Ts).
%% The buttons of the request widget: one for each button of the pragmas, in their order, with the acts it names that the request type proposes, a button naming none of them left out.
WField    ::= field(Integer, String, FieldType).
WFields   ::= [] ; [WField | WFields].
%% A text field of a typed variable is of its type, as email or name (vGLP 37fe038, Section 5.4), the device told what it takes (Section 6.2, Remark Construct Families).
FieldType ::= person ; key ; agent ; text ; number ; value ; Constant.
FWord     ::= say(String) ; at(Integer).
FWords    ::= [] ; [FWord | FWords].
WAct      ::= act(Constant, Integer, Ints, Preconds, Ints, WFields, Preconds, FWords).
WActs     ::= [] ; [WAct | WActs].
WButton   ::= button(String, WActs).
WButtons  ::= [] ; [WButton | WButtons].
%% Ch is the contract C with each real variable of a head written real(X) and each variable over the constants const(X) (real_heads), which gives a field its type (field_type).
procedure act_buttons(TActs?, Contract?, Contract?, Preds?, NumInfos?, DrawCtx?, WButtons?, WButtons).
act_buttons([], _, _, _, _, _, Bs, Bs?).
act_buttons([act(N, B, Fs, Q, _, By, Ft)|As], C, Ch, Ps, Nt, Rf, Bs0, Bs?) :- ground(N?), ground(B?), ground(Fs?), ground(Q?), ground(By?), ground(Ft?), ground(C?), ground(Ch?), ground(Ps?), ground(Nt?), ground(Rf?), ground(Bs0?) |
    mem(N?, Ps?, In),
    find_schema(N?, C?, Sf),
    find_schema(N?, Ch?, Sh),
    num_lookup(N?, Nt?, Ni),
    schema_acts(In?, Sf?, Sh?, N?, Fs?, Ft?, Q?, By?, Ni?, Rf?, Ws),
    add_button(Bs0?, B?, Ws?, Bs1),
    act_buttons(As?, C?, Ch?, Ps?, Nt?, Rf?, Bs1?, Bs).
%% The acts Ws joined to the button labelled B, or a new button after the others; nothing where Ws is empty.  One name is one button (Section 5.4, "The contract's words": "A button is of the acts it names"), so every act of a name joins one button.
procedure add_button(WButtons?, String?, WActs?, WButtons).
add_button(Bs, _, [], Bs?).
add_button([], B, [W|Ws], [button(B?, [W?|Ws?])]).
add_button([button(B1, Xs)|Bs], B, [W|Ws], [button(B1?, Ys?)|Bs?]) :- ground(B1?), ground(B?), B1? =?= B? | app(Xs?, [W?|Ws?], Ys).
add_button([X|Bs], B, [W|Ws], [X?|Bs1?]) :- otherwise | add_button(Bs?, B?, [W?|Ws?], Bs1).
%% The acts of a schema the request type proposes, one for each guarding role at which it is proposed (proposer_roles).
procedure schema_acts(YesNo?, SFound?, SFound?, Constant?, Strings?, FTypes?, Said?, Proposer?, NumInfo?, DrawCtx?, WActs).
schema_acts(no, _, _, _, _, _, _, _, _, _, []).
schema_acts(yes, nosfound, _, _, _, _, _, _, _, _, []).
schema_acts(yes, sfound(_, _), nosfound, _, _, _, _, _, _, _, []).
schema_acts(yes, sfound(Hd, Rs), sfound(Hh, _), S, Fs, Ft, Q, By, Ni, Rf, Ws?) :- ground(Hd?), ground(Hh?), ground(Rs?), ground(S?), ground(Fs?), ground(Ft?), ground(Q?), ground(By?), ground(Ni?), ground(Rf?) |
    schema_vars(Rs?, Hd?, Vs0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs0?, Lis?, Vs),
    schema_vars(Rs?, Hh?, Us0),
    listed_ixs(Rs?, 1, Lis1),
    drop_listed(Us0?, Lis1?, Us),
    field_places(Hd?, Rs?, Fp),
    meeting_schema(Rs?, Mt),
    ctx_cval(Rf?, Cv),
    act_fields(Fp?, Fs?, 1, Ft?, Us?, Mt?, Cv?, Fd),
    guard_roles(Rs?, 1, Gr0),
    proposer_roles(By?, Gr0?, Gr),
    same_places(By?, Sm0),
    schema_vars(Rs?, Hd?, Vz0),
    listed_ixs(Rs?, 1, Lis2),
    drop_listed(Vz0?, Lis2?, Vz),
    size_places(Ni?, Vz?, Sz),
    schema_vars(Rs?, Hd?, Vc0),
    listed_ixs(Rs?, 1, Lis3),
    drop_listed(Vc0?, Lis3?, Vc),
    schema_vars(Rs?, Hh?, Vh0),
    listed_ixs(Rs?, 1, Lis4),
    drop_listed(Vh0?, Lis4?, Vh),
    calc_places(Ni?, Vc?, Vh?, Cl),
    app(Sm0?, Sz?, Sm1),
    app(Sm1?, Cl?, Sm),
    form_text(Hd?, Rs?, Q?, Tx),
    role_acts(Gr?, S?, Vs?, Rs?, Rf?, Fd?, Sm?, Tx?, Ws).
%% The places of a set variable the request names and of the field that gives its size, size(S, F), for each conjunct eq(size(X), Y) of the schema's constraint, X at the place S and Y at the place F: "The person gives the size of a set variable in a field, a number" (OSPM, act-schemas-local, VEUI vglp32-sets-2026-11-24); a set variable local to a role is at no place of the request and has none.
procedure size_places(NumInfo?, Args?, Preconds).
size_places(num_info(_, C, _, _, _, _), Vs, Sz?) :- ground(C?), ground(Vs?) |
    con_list(C?, Cs),
    size_items(Cs?, Vs?, Sz).
procedure con_list(Constraint?, Constraints).
con_list(and(C1, C2), R?) :- con_list(C1?, R1), con_list(C2?, R2), app(R1?, R2?, R).
con_list(C, [C?]) :- otherwise | true.
procedure size_items(Constraints?, Args?, Preconds).
size_items([], _, []).
size_items([eq(fn(size, [num(X)]), num(Y))|Cs], Vs, Sz?) :- ground(X?), ground(Y?), ground(Vs?) |
    arg_place(set(X?), Vs?, 1, Ps),
    arg_place(num(Y?), Vs?, 1, Pf),
    size_item(Ps?, Pf?, Sz1),
    size_items(Cs?, Vs?, Sz2),
    app(Sz1?, Sz2?, Sz).
size_items([_|Cs], Vs, Sz?) :- otherwise | size_items(Cs?, Vs?, Sz).
procedure arg_place(Arg?, Args?, Integer?, Ints).
arg_place(_, [], _, []).
arg_place(A, [V|_], I, [I?]) :- ground(A?), ground(V?), A? =?= V? | true.
arg_place(A, [_|Vs], I, R?) :- otherwise, integer(I?) | I1 := I? + 1, arg_place(A?, Vs?, I1?, R).
procedure size_item(Ints?, Ints?, Preconds).
size_item([S], [F], [size(S?, F?)]).
size_item(_, _, []) :- otherwise | true.
%% The places of a number the constraint determines from the variables the schema-binding binds, and its value, calc(P, E), for each conjunct eq(num(Y), E) of the schema's constraint, Y at the place P of the request and E an expression whose variables are each at a place of the request, E' being E with each variable at(K), K its place, and each number lit(N): "A variable the constraint determines from the variables the schema-binding binds is bound by the schema-binding to the value the constraint gives it, which the proposer's machine computes and the request names" (OSPM, act-schemas-local, VEUI vglp33-determined 224558d; Audit #151), as Double = Votes * 2, calc(5, mul(at(4), lit(2))); the form computes it from the fields.
MExpr   ::= at(Integer) ; lit(Constant) ; plus(MExpr, MExpr) ; minus(MExpr, MExpr) ; mul(MExpr, MExpr) ; fn(Constant, MExprs).
MExprs  ::= [] ; [MExpr | MExprs].
CalcR   ::= none ; ok(MExpr).
CalcRs  ::= [] ; [CalcR | CalcRs].
procedure calc_places(NumInfo?, Args?, Args?, Preconds).
calc_places(num_info(_, C, _, _, _, _), Vs, Vh, Cl?) :- ground(C?), ground(Vs?), ground(Vh?) |
    con_list(C?, Cs),
    calc_items(Cs?, Vs?, Vh?, Cl).
procedure calc_items(Constraints?, Args?, Args?, Preconds).
calc_items([], _, _, []).
calc_items([eq(num(Y), E)|Cs], Vs, Vh, Cl?) :- ground(Y?), ground(E?), ground(Vs?), ground(Vh?) |
    arg_place(num(Y?), Vs?, 1, Py),
    calc_expr(E?, Vs?, Me),
    calc_item(Py?, Me?, Vh?, C1),
    calc_items(Cs?, Vs?, Vh?, C2),
    app(C1?, C2?, Cl).
calc_items([_|Cs], Vs, Vh, Cl?) :- otherwise | calc_items(Cs?, Vs?, Vh?, Cl).
%% An expression of arithmetic: a bare variable or number determines nothing to compute.
procedure calc_expr(Expr?, Args?, CalcR).
calc_expr(plus(A, B), Vs, R?) :- ground(Vs?) | calc_arg(A?, Vs?, Ra), calc_arg(B?, Vs?, Rb), calc_plus(Ra?, Rb?, R).
calc_expr(minus(A, B), Vs, R?) :- ground(Vs?) | calc_arg(A?, Vs?, Ra), calc_arg(B?, Vs?, Rb), calc_minus(Ra?, Rb?, R).
calc_expr(mul(A, B), Vs, R?) :- ground(Vs?) | calc_arg(A?, Vs?, Ra), calc_arg(B?, Vs?, Rb), calc_mul(Ra?, Rb?, R).
%% A function the owner of a value type gives, computed by the proposer's machine from the request's places, as the form computes calc's arithmetic (Code #39, vGLP_inbox.md, 2026-11-25 22:29 UTC: "the proposer's machine computes next by owner_fn before the request is signed, as for calc").
calc_expr(fn(F, Es), Vs, R?) :- ground(F?), ground(Vs?) | calc_args(Es?, Vs?, Rs), calc_fn(F?, Rs?, R).
calc_expr(_, _, none) :- otherwise | true.
procedure calc_args(Exprs?, Args?, CalcRs).
calc_args([], _, []).
calc_args([E|Es], Vs, [R?|Rs?]) :- ground(Vs?) | calc_arg(E?, Vs?, R), calc_args(Es?, Vs?, Rs).
procedure calc_fn(Constant?, CalcRs?, CalcR).
calc_fn(F, Rs, R?) :- ground(F?) | calc_oks(Rs?, Ms, Y), calc_fn1(Y?, F?, Ms?, R).
procedure calc_fn1(YesNo?, Constant?, MExprs?, CalcR).
calc_fn1(yes, F, Ms, ok(fn(F?, Ms?))).
calc_fn1(no, _, _, none).
procedure calc_oks(CalcRs?, MExprs, YesNo).
calc_oks([], [], yes).
calc_oks([ok(M)|Rs], [M?|Ms?], Y?) :- calc_oks(Rs?, Ms, Y).
calc_oks([none|_], [], no).
procedure calc_arg(Expr?, Args?, CalcR).
calc_arg(num(X), Vs, R?) :- ground(X?), ground(Vs?) | calc_num(X?, Vs?, R).
calc_arg(E, Vs, R?) :- otherwise | calc_expr(E?, Vs?, R).
procedure calc_num(Constant?, Args?, CalcR).
calc_num(X, _, ok(lit(X?))) :- integer(X?) | true.
calc_num(X, Vs, R?) :- otherwise | arg_place(num(X?), Vs?, 1, P), calc_at(P?, R).
procedure calc_at(Ints?, CalcR).
calc_at([P], ok(at(P?))).
calc_at(_, none) :- otherwise | true.
procedure calc_plus(CalcR?, CalcR?, CalcR).
calc_plus(ok(A), ok(B), ok(plus(A?, B?))).
calc_plus(_, _, none) :- otherwise | true.
procedure calc_minus(CalcR?, CalcR?, CalcR).
calc_minus(ok(A), ok(B), ok(minus(A?, B?))).
calc_minus(_, _, none) :- otherwise | true.
procedure calc_mul(CalcR?, CalcR?, CalcR).
calc_mul(ok(A), ok(B), ok(mul(A?, B?))).
calc_mul(_, _, none) :- otherwise | true.
%% With the kind of the place, num or const, by the variable at it in the head with its types, so that the form puts its placeholder, 0 or '', there (Code #39, vGLP_inbox.md, 2026-11-25 23:16 UTC).
procedure calc_item(Ints?, CalcR?, Args?, Preconds).
calc_item([P], ok(E), Vh, [calc(P?, E?, K?)]) :- integer(P?) | nth_arg(P?, Vh?, A), calc_kind(A?, K).
calc_item(_, _, _, []) :- otherwise | true.
procedure calc_kind(Arg?, FnKind).
calc_kind(const(_), const).
calc_kind(_, num) :- otherwise | true.
%% The completion of a request (Code #39, vGLP_inbox.md, 2026-11-25 22:58 UTC, agreed by vGLP #35: the form holds no GLP runtime and cannot call the owner's functions): each place the constraint determines, calc(P, E), is computed by the proposer's machine, the agent the platform runs (vGLP, Section 5.4, "Speech-act schemas as local specifications": "The proposer's machine finds in its own state every way to satisfy an act"), when it reads the request propose(C) and before it names it, the form putting a placeholder there.  For each class with such places and no listed role, complete(C, C1): the binding of C, and each such place replaced by the value of its expression under it, expr_val for a number, expr_term for a constant, the placeholder kept where an argument has no value, which the constraint then refuses; any other request is as it is.
procedure complete_lines(Contract?, NumInfos?, Preds?, Constant?, Lines).
complete_lines([], _, _, _, []).
complete_lines([schema(S, Hd, Rs)|Ss], Nt, Ps, M, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Nt?), ground(Ps?), ground(M?) |
    schema_vars(Rs?, Hd?, Vs),
    list_places(Rs?, Hd?, Lis0),
    mem(S?, Ps?, In),
    proposed_lis(In?, Lis0?, Lis),
    num_lookup(S?, Nt?, Ni),
    complete_s(Vs?, Lis?, Ni?, S?, M?, L1),
    complete_lines(Ss?, Nt?, Ps?, M?, L2),
    lapp(L1?, L2?, L).
complete_lines([cschema(_, _, _, _)|Ss], Nt, Ps, M, L?) :- complete_lines(Ss?, Nt?, Ps?, M?, L).
complete_lines([nschema(_, _, _, _)|Ss], Nt, Ps, M, L?) :- complete_lines(Ss?, Nt?, Ps?, M?, L).
%% A class the request type does not propose is completed by no clause, as one with a listed role is not: its listed places stand for it, [0].
procedure proposed_lis(YesNo?, Ints?, Ints).
proposed_lis(yes, Lis, Lis?).
proposed_lis(no, _, [0]).
procedure complete_s(Args?, Ints?, NumInfo?, Constant?, Constant?, Lines).
complete_s(Vs, Lis, Ni, S, M, L?) :- ground(Vs?) |
    keys_of(Vs?, Vk),
    cmp_calcs(Ni?, Vs?, Vk?, Cs),
    complete_line(Lis?, Cs?, S?, Vs?, M?, L).
%% The variables of a class term as the binding and the constraint write them (bind_key).
procedure keys_of(Args?, Args).
keys_of([], []).
keys_of([V|Vs], [K?|Ks?]) :- bind_key(V?, K), keys_of(Vs?, Ks).
CCalc   ::= cc(Integer, FnKind, Expr).
CCalcs  ::= [] ; [CCalc | CCalcs].
%% The places a conjunct eq(num(Y), E) of the constraint determines, Y a number or a constant of the request at the place P and E an expression of its places (calc_expr), cc(P, K, E), K num or const.
procedure cmp_calcs(NumInfo?, Args?, Args?, CCalcs).
cmp_calcs(num_info(_, C, _, _, _, _), Vs, Vk, Cs?) :- ground(C?) |
    con_list(C?, Cl),
    cmp_items(Cl?, Vs?, Vk?, Cs).
procedure cmp_items(Constraints?, Args?, Args?, CCalcs).
cmp_items([], _, _, []).
cmp_items([eq(num(Y), E)|Cl], Vs, Vk, Cs?) :- ground(Y?), ground(E?), ground(Vs?), ground(Vk?) |
    arg_place(num(Y?), Vs?, 1, Pn),
    arg_place(const(Y?), Vs?, 1, Pc),
    calc_expr(E?, Vk?, Me),
    cmp_item(Pn?, Pc?, Me?, E?, C1),
    cmp_items(Cl?, Vs?, Vk?, C2),
    app(C1?, C2?, Cs).
cmp_items([_|Cl], Vs, Vk, Cs?) :- otherwise | cmp_items(Cl?, Vs?, Vk?, Cs).
procedure cmp_item(Ints?, Ints?, CalcR?, Expr?, CCalcs).
cmp_item([P], [], ok(_), E, [cc(P?, num, E?)]).
cmp_item([], [P], ok(_), E, [cc(P?, const, E?)]).
cmp_item(_, _, _, _, []) :- otherwise | true.
%% The two clauses of a class with places to compute and no listed role: complete(S(V1, ..., Vn), C) taking the binding, and complete_S(B, S(V1, ..., Vn), C) computing the places.
procedure complete_line(Ints?, CCalcs?, Constant?, Args?, Constant?, Lines).
complete_line([], [Cc|Ccs], S, Vs, M, L?) :- ground(Cc?), ground(Ccs?), ground(S?), ground(Vs?) |
    var_names(Vs?, 1, Ns, Qs),
    complete_line2(Ns?, Qs?, Cc?, Ccs?, S?, T1, T2, T3, T4),
    complete_mode(M?, T1?, T2?, T3?, T4?, L).
complete_line(_, _, _, _, _, []) :- otherwise | true.
%% complete/2's clause (head), or the procedure complete_S (body), so that the clauses of complete/2 are together.
procedure complete_mode(Constant?, String?, String?, String?, String?, Lines).
complete_mode(head, T1, _, _, _, [T1?]).
complete_mode(body, _, T2, T3, T4, [T2?, T3?, T4?]).
procedure complete_line2(Strings?, Strings?, CCalc?, CCalcs?, Constant?, String, String, String, String).
complete_line2(Ns, Qs, Cc, Ccs, S, T1?, T2?, T3?, T4?) :- ground(Ns?), ground(Qs?), ground(Cc?), ground(Ccs?), ground(S?) |
    named_call(S?, Ns?, Hd),
    named_call(S?, Qs?, Hq),
    term_to_string(S?, Sn),
    string_concat(['complete_', Sn?], Cn),
    ground_guards(Qs?, Gs),
    string_concat(['complete(', Hd?, ', C?) :- ', Gs?, ' | binding_of(', Hq?, ', _, B), ', Cn?, '(B?, ', Hq?, ', C).'], T1),
    string_concat(['procedure ', Cn?, '(Binding?, Proposal?, Proposal).'], T2),
    string_concat([Cn?, '(_, C, C?) :- otherwise | true.'], T4),
    cmp_calls(Cc?, Ccs?, Ns?, Qs?, Cl, Ws),
    named_call(S?, Ws?, Hw),
    string_concat([Cn?, '(B, ', Hd?, ', C?) :- ground(B?), ', Gs?, ' | ', Cl?, 'C = ', Hw?, '.'], T3).
procedure ground_guards(Strings?, String).
ground_guards(Qs, G?) :- ground(Qs?) | ground_list(Qs?, Gl), joined(Gl?, ', ', G).
procedure ground_list(Strings?, Strings).
ground_list([], []).
ground_list([Q|Qs], [G?|Gs?]) :- ground(Q?) | string_concat(['ground(', Q?, ')'], G), ground_list(Qs?, Gs).
%% The calls computing each place, calc_num(E, B?, V?, W) or calc_term(E, B?, V?, W), each followed by a comma, and the arguments of the completed term: W? at each place computed, V? elsewhere.
procedure cmp_calls(CCalc?, CCalcs?, Strings?, Strings?, String, Strings).
cmp_calls(Cc, Ccs, Ns, Qs, Cl?, Ws?) :- ground(Cc?), ground(Ccs?), ground(Ns?), ground(Qs?) |
    cmp_texts([Cc?|Ccs?], Qs?, Ts),
    sjoin(Ts?, Cl),
    cmp_args(Ns?, Qs?, 1, [Cc?|Ccs?], Ws).
procedure cmp_texts(CCalcs?, Strings?, Strings).
cmp_texts([], _, []).
cmp_texts([cc(P, K, E)|Cs], Qs, [T?|Ts?]) :- integer(P?), ground(K?), ground(E?), ground(Qs?) |
    nth_str(P?, Qs?, Q),
    term_to_string(P?, Ps),
    term_to_string(E?, Es),
    cmp_head(K?, H),
    string_concat([H?, '(', Es?, ', B?, ', Q?, ', W', Ps?, '), '], T),
    cmp_texts(Cs?, Qs?, Ts).
procedure cmp_head(FnKind?, String).
cmp_head(num, 'calc_num').
cmp_head(const, 'calc_term').
cmp_head(other, 'calc_none').
procedure cmp_args(Strings?, Strings?, Integer?, CCalcs?, Strings).
cmp_args([], _, _, _, []).
cmp_args([_|Ns], [Q|Qs], I, Cs, [A?|As?]) :- integer(I?), ground(Q?), ground(Cs?) |
    cmp_at(I?, Cs?, Y),
    cmp_arg(Y?, I?, Q?, A),
    I1 := I? + 1,
    cmp_args(Ns?, Qs?, I1?, Cs?, As).
procedure cmp_at(Integer?, CCalcs?, YesNo).
cmp_at(_, [], no).
cmp_at(I, [cc(P, _, _)|_], yes) :- integer(I?), integer(P?), I? =:= P? | true.
cmp_at(I, [_|Cs], Y?) :- otherwise | cmp_at(I?, Cs?, Y).
procedure cmp_arg(YesNo?, Integer?, String?, String).
cmp_arg(yes, I, _, A?) :- integer(I?) | term_to_string(I?, Is), string_concat(['W', Is?, '?'], A).
cmp_arg(no, _, Q, Q?).
procedure nth_str(Integer?, Strings?, String).
nth_str(1, [S|_], S?).
nth_str(_, [], '').
nth_str(I, [_|Ss], S?) :- integer(I?), I? > 1 | I1 := I? - 1, nth_str(I1?, Ss?, S).
procedure sjoin(Strings?, String).
sjoin([], '').
sjoin([S|Ss], J?) :- sjoin(Ss?, J1), string_concat([S?, J1?], J).
%% The completion's shared lines, printed where some class has a place to compute, and the request read through it.
%% calc_term's values of the type of the values over the constants, Ct, Constant or CValue (ct_name), as Val's v(CValue) where the contract names a compound value (Calculus #15, vGLP_inbox.md, 2026-11-26 11:18 UTC: Village Governance's platform.glp, 'Variable pair (C, C?) not dual across clause: Constant vs CValue?').
procedure complete_text(Lines?, Lines?, String?, Lines).
complete_text([], _, _, []).
complete_text([L|Ls], Lb, Ct, ['',
        '%% The completion of a request: each place the constraint determines computed by the proposer\'s machine under the binding the request names, before it names it (complete; the form puts a placeholder there).',
        'procedure complete(Proposal?, Proposal).',
        L?|R?]) :- ground(Ct?) |
    lapp(Ls?, ['complete(C, C?) :- otherwise | true.'|L2?], R),
    lapp(Lb?, [
        'procedure calc_num(Expr?, Binding?, Integer?, Integer).',
        'calc_num(E, B, V, W?) :- ground(B?) | expr_val(E?, B?, R), calc_num1(R?, V?, W).',
        'procedure calc_num1(NumRes?, Integer?, Integer).',
        'calc_num1(num_is(N), _, N?) :- integer(N?) | true.',
        'calc_num1(_, V, V?) :- otherwise | true.',
        Pt?,
        'calc_term(E, B, V, W?) :- ground(B?) | expr_term(E?, B?, F), calc_term1(F?, V?, W).',
        Pt1?,
        'calc_term1(found(v(C)), _, C?) :- ground(C?) | true.',
        'calc_term1(_, V, V?) :- otherwise | true.'], L2),
    string_concat(['procedure calc_term(Expr?, Binding?, ', Ct?, '?, ', Ct?, ').'], Pt),
    string_concat(['procedure calc_term1(Found?, ', Ct?, '?, ', Ct?, ').'], Pt1).
procedure complete_req(Lines?, Lines?, Lines).
complete_req([], Ls, Ls?).
complete_req([_|_], Ls, R?) :- line_sub(Ls?, 'await_request(propose(C), [req(propose(C?))]).', 'await_request(propose(C), [req(propose(C1?))]) :- complete(C?, C1).', R).
%% Whether an act of the request type has a number to compute (calc_places), an act a button of the pragmas names whose schema the request type proposes, as act_buttons finds them, so that a platform with none prints its types as before.
procedure calc_acts(Worded?, TActs).
calc_acts(words(pragmas(_, As, _, _, _, _, _, _), _, _, _, _), As?).
calc_acts(_, []) :- otherwise | true.
procedure calc_any(TActs?, Preds?, NumInfos?, Contract?, YesNo).
calc_any([], _, _, _, no).
calc_any([act(N, _, _, _, _, _, _)|As], Ps, Nt, Cs, B?) :- ground(N?), ground(Ps?), ground(Nt?), ground(Cs?) |
    mem(N?, Ps?, In),
    num_lookup(N?, Nt?, Ni),
    find_schema(N?, Cs?, Sf),
    calc_in(In?, Sf?, Ni?, Cl),
    calc_any1(Cl?, As?, Ps?, Nt?, Cs?, B).
procedure calc_any1(Preconds?, TActs?, Preds?, NumInfos?, Contract?, YesNo).
calc_any1([_|_], _, _, _, _, yes).
calc_any1([], As, Ps, Nt, Cs, B?) :- calc_any(As?, Ps?, Nt?, Cs?, B).
procedure calc_in(YesNo?, SFound?, NumInfo?, Preconds).
calc_in(no, _, _, []).
calc_in(yes, Sf, Ni, Cl?) :- calc_of(Sf?, Ni?, Cl).
procedure calc_of(SFound?, NumInfo?, Preconds).
calc_of(nosfound, _, []).
calc_of(sfound(Hd, Rs), Ni, Cl?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vz0),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vz0?, Lis?, Vz),
    calc_whether(Ni?, Vz?, Cl).
%% Whether there is a place to compute, the kinds aside.
procedure calc_whether(NumInfo?, Args?, Preconds).
calc_whether(Ni, Vz, Cl?) :- ground(Vz?) | calc_places(Ni?, Vz?, Vz?, Cl).
%% The types of the request widget's term gain calc(Integer, MenuExpr, Constant), the kind of the place, where an act has a number to compute (calc_any).
procedure calc_lines(Lines?, YesNo?, Lines).
calc_lines(Ls, no, Ls?).
calc_lines(Ls, yes, R?) :-
    line_sub(Ls?, 'MenuCond ::= req(Constant, List(MenuCondArg)) ; forb(Constant, List(MenuCondArg)) ; unless(Constant, List(MenuCondArg)) ; proved(Constant, List(Constant), Constant, List(MenuCondArg)) ; same(Integer, Integer).', 'MenuCond ::= req(Constant, List(MenuCondArg)) ; forb(Constant, List(MenuCondArg)) ; unless(Constant, List(MenuCondArg)) ; proved(Constant, List(Constant), Constant, List(MenuCondArg)) ; same(Integer, Integer) ; calc(Integer, MenuExpr, Constant).', R1),
    line_sub(R1?, 'MenuCond ::= req(Constant, List(MenuCondArg)) ; forb(Constant, List(MenuCondArg)) ; unless(Constant, List(MenuCondArg)) ; proved(Constant, List(Constant), Constant, List(MenuCondArg)) ; same(Integer, Integer) ; size(Integer, Integer).', 'MenuCond ::= req(Constant, List(MenuCondArg)) ; forb(Constant, List(MenuCondArg)) ; unless(Constant, List(MenuCondArg)) ; proved(Constant, List(Constant), Constant, List(MenuCondArg)) ; same(Integer, Integer) ; size(Integer, Integer) ; calc(Integer, MenuExpr, Constant).', R2),
    line_after(R2?, 'MenuCondArg ::= at(Integer) ; grp(Integer, Integer) ; any.', 'MenuExpr ::= at(Integer) ; lit(Integer) ; plus(MenuExpr, MenuExpr) ; minus(MenuExpr, MenuExpr) ; mul(MenuExpr, MenuExpr) ; fn(Constant, List(MenuExpr)).', R).
%% The places of the request that hold persons, its roles and its agent variables: persons of different names are bound to different persons, "but for two the clause names as possibly one person" (vGLP, Section 5.4, "Speech-act schemas as local specifications", Udi, 2026-11-17, to vGLP #30), the pairs pragmas.sh gives as same(K, J) (same_places).
procedure role_places(Args?, Integer?, Ints).
role_places([], _, []).
role_places([role(_)|Vs], I, [I?|Is?]) :- integer(I?) | I1 := I? + 1, role_places(Vs?, I1?, Is).
role_places([pvar(_)|Vs], I, [I?|Is?]) :- integer(I?) | I1 := I? + 1, role_places(Vs?, I1?, Is).
role_places([V|Vs], I, Is?) :- otherwise, integer(I?), ground(V?) | I1 := I? + 1, role_places(Vs?, I1?, Is).
%% The fields of an act, field(I, S, T), the k-th field of its pragma at the k-th place field_places counts, a field left empty, an inapplicable field of a schema that shares its button, naming none (README.md beside this file, 2).
procedure act_fields(Ints?, Strings?, Integer?, FTypes?, Args?, YesNo?, YesNo?, WFields).
act_fields(_, [], _, _, _, _, _, []).
act_fields([], [_|_], _, _, _, _, _, []).
act_fields([_|Is], [F|Fs], K, Ft, Vs, Mt, Cv, Fd?) :- ground(F?), F? =?= '""', integer(K?) | K1 := K? + 1, act_fields(Is?, Fs?, K1?, Ft?, Vs?, Mt?, Cv?, Fd).
act_fields([I|Is], [F|Fs], K, Ft, Vs, Mt, Cv, [field(I?, F?, T?)|Fd?]) :- otherwise, integer(I?), integer(K?), ground(F?), ground(Ft?), ground(Vs?), ground(Mt?), ground(Cv?) |
    nth_arg(I?, Vs?, A),
    field_value(A?, Mt?, Cv?, T0),
    ftype_of(Ft?, K?, T0?, T),
    K1 := K? + 1,
    act_fields(Is?, Fs?, K1?, Ft?, Vs?, Mt?, Cv?, Fd).
%% The kind of the K-th field: the type its schema gives its speech-act variable, ft(K, T), where it gives one, as email or name, which constrains nothing and which the field's widget is told (vGLP 37fe038, Section 5.4); else its kind by its variable (field_type).
procedure ftype_of(FTypes?, Integer?, FieldType?, FieldType).
ftype_of([], _, T, T?).
ftype_of([ft(J, U)|_], K, text, U?) :- J? =:= K? | true.
ftype_of([_|Ft], K, T, R?) :- otherwise | ftype_of(Ft?, K?, T?, R).
%% The type of a field (vGLP, Section 5.4, "The contract's words": "A field is typed, a person by key or picked among the persons the viewer knows"; Section 6.2: "A field that takes a person in a role offers the persons the viewer knows ... The field of an acquaintance takes the key of a person the viewer does not know"): a person in a role, picked among the persons the viewer knows; the key of the peer of an acquaintance schema; an agent variable, a person in no role, by key or picked, which Section 6.2's two sentences do not restrict; a speech act, a text; a number.
%% A field of a variable over the constants in a contract that names a compound value takes a value, value: the form reads its text by the GLP reader, a ground compound term being that value, as bond(10), any other text the constant of that name (vGLP, Section 5.4, "The contract's words": "A field is typed"; Currencies #24 and Code #39, vGLP_inbox.md, 2026-11-26 01:00 UTC: GB's Issue field type, of CValue ::= Constant ; bond(Integer)).
procedure ctx_cval(DrawCtx?, YesNo).
ctx_cval(ctx(_, _, Cv), Cv?).
procedure field_value(Arg?, YesNo?, YesNo?, FieldType).
field_value(const(_), _, yes, value).
field_value(A, Mt, _, T?) :- otherwise | field_type(A?, Mt?, T).
procedure field_type(Arg?, YesNo?, FieldType).
field_type(role(_), no, person).
field_type(role(_), yes, key).
field_type(pvar(_), _, agent).
field_type(svar(_), _, text).
field_type(num(_), _, number).
field_type(real(_), _, number).
%% A variable over the constants, a text, the name its proposer types (vGLP, Section 5.4, "Speech-act schemas as local specifications": "a variable over the constants taking the name its proposer types"), which the request carries as the constant of that name.
field_type(const(_), _, text).
field_type(set(_), _, set).
%% A name term, a signed term and the wildcard are at no place a field may name (field_places); the clauses cover the type.
field_type(nterm(_), _, text).
field_type(sgn(_, _), _, text).
field_type(item_of(_), _, text).
field_type(val(_), _, text).
field_type(cmp(_, _), _, text).
field_type(any, _, text).
field_type(ilist(_, _), _, text).
%% An act for each guarding role G at which it is proposed: its proposer's place M, its precondition there (condition_places) and the places that precondition binds.
procedure role_acts(Ints?, Constant?, Args?, RoleSpecs?, DrawCtx?, WFields?, Preconds?, FWords?, WActs).
role_acts([], _, _, _, _, _, _, _, []).
role_acts([G|Gs], S, Vs, Rs, Rf, Fd, Sm, Tx, [act(S?, M?, Rp?, Pre?, Bd?, Fd?, Sm?, Tx?)|Ws?]) :- integer(G?), ground(S?), ground(Vs?), ground(Rs?), ground(Rf?), ground(Fd?), ground(Sm?), ground(Tx?) |
    place_of(role(G?), Vs?, 1, M),
    role_places(Vs?, 1, Rp),
    condition_places(G?, Rs?, Vs?, Rf?, Pre0),
    role_field_places(Fd?, Pk),
    field_proved(Pre0?, Pk?, Pre),
    condition_places(G?, Rs?, Vs?, Rf?, Pre1),
    bound_places(Pre1?, M?, Bd0),
    dedup(Bd0?, Bd),
    role_acts(Gs?, S?, Vs?, Rs?, Rf?, Fd?, Sm?, Tx?, Ws).
%% What the schemas prove of a person is printed for a field that takes a person in a role, and for no other place (vGLP, Section 6.2: "A field that takes a person in a role offers the persons the viewer knows ... and, where that person's role requires an atom that the schemas prove of a person from the viewer's records, as above, only a person so proved").
procedure role_field_places(WFields?, Ints).
role_field_places([], []).
role_field_places([field(I, _, person)|Fs], [I?|Is?]) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, key)|Fs], Is?) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, agent)|Fs], Is?) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, text)|Fs], Is?) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, number)|Fs], Is?) :- role_field_places(Fs?, Is).
role_field_places([field(_, _, _)|Fs], Is?) :- otherwise | role_field_places(Fs?, Is).
procedure field_proved(Preconds?, Ints?, Preconds).
field_proved([], _, []).
field_proved([proved(Q, Ws, P, As)|Cs], Ks, R?) :- ground(Q?), ground(Ws?), ground(P?), ground(As?), ground(Ks?) |
    at_of(As?, K),
    int_in(K?, Ks?, B),
    keep_proved(B?, Q?, Ws?, P?, As?, R1),
    field_proved(Cs?, Ks?, R2),
    app(R1?, R2?, R).
field_proved([C|Cs], Ks, [C?|R?]) :- otherwise, ground(Ks?) | field_proved(Cs?, Ks?, R).
procedure keep_proved(YesNo?, Constant?, Preds?, Constant?, CondArgs?, Preconds).
keep_proved(no, _, _, _, _, []).
keep_proved(yes, Q, Ws, P, As, [proved(Q?, Ws?, P?, As?)]).
%% The one place a proved entry's arguments name, the rest being any (unless_args).
procedure at_of(CondArgs?, Integer).
at_of([], 0).
at_of([at(K)|_], K?).
at_of([grp(_, K)|_], K?).
at_of([any|As], K?) :- at_of(As?, K).
at_of([cmp(_, Cs)|As], K?) :- ground(Cs?), ground(As?) | app_conds(Cs?, As?, Ds), at_of(Ds?, K).
procedure int_in(Integer?, Ints?, YesNo).
int_in(_, [], no).
int_in(K, [I|_], yes) :- integer(K?), integer(I?), K? =:= I? | true.
int_in(K, [I|Is], B?) :- integer(K?), integer(I?), K? =\= I? | int_in(K?, Is?, B).
%% The places of the request that the atoms the act requires at the proposer's role bind, beside the proposer's own M: each at(K) and each grp(J, K) of a req(P, As), a local variable, any, binding no place (vGLP 40f8444, Section 5.4, "The contract's words": "every binding of the variables of the atoms the schema requires there under which the state holds those atoms").
procedure bound_places(Preconds?, Integer?, Ints).
bound_places([], _, []).
bound_places([req(_, As)|Ps], M, Bd?) :- ground(As?), integer(M?) |
    arg_bound(As?, M?, B1),
    bound_places(Ps?, M?, B2),
    app(B1?, B2?, Bd).
bound_places([_|Ps], M, Bd?) :- otherwise | bound_places(Ps?, M?, Bd).
procedure arg_bound(CondArgs?, Integer?, Ints).
arg_bound([], _, []).
arg_bound([at(K)|As], M, [K?|Bd?]) :- integer(K?), integer(M?), K? =\= M? | arg_bound(As?, M?, Bd).
arg_bound([at(K)|As], M, Bd?) :- integer(K?), integer(M?), K? =:= M? | arg_bound(As?, M?, Bd).
arg_bound([grp(J, K)|As], M, Bd?) :- integer(J?), integer(K?), integer(M?) | arg_bound([at(J?), at(K?)|As?], M?, Bd).
arg_bound([any|As], M, Bd?) :- arg_bound(As?, M?, Bd).
arg_bound([cmp(_, Cs)|As], M, Bd?) :- ground(Cs?), ground(As?) | app_conds(Cs?, As?, Ds), arg_bound(Ds?, M?, Bd).
procedure app_conds(CondArgs?, CondArgs?, CondArgs).
app_conds([], Bs, Bs?).
app_conds([A|As], Bs, [A?|Cs?]) :- app_conds(As?, Bs?, Cs).
%% The text of the request form of an act with one guarding role, its question "text of the request form, shown with the button: the request is the will, elicited once" (vGLP, Section 5.4, "The contract's words"), each word say(S), or at(I), the person at place I of the request, the sentence's person(K) the K-th of the schema's persons; [] for every other act.
procedure form_text(Args?, RoleSpecs?, Said?, FWords).
form_text(_, _, none, []).
form_text(Hd, Rs, said(Qs), Tx?) :- ground(Hd?), ground(Rs?), ground(Qs?) |
    guard_count(Rs?, N),
    join_questions(Qs?, Ws),
    form_text1(N?, Hd?, Rs?, Ws?, Tx).
procedure form_text1(Integer?, Args?, RoleSpecs?, PWords?, FWords).
form_text1(1, Hd, Rs, Ws, Tx?) :- ground(Hd?), ground(Rs?), ground(Ws?) |
    person_places(Hd?, Rs?, Pp),
    schema_vars(Rs?, Hd?, Vs0),
    schema_vars(Rs?, Hd?, Vs1),
    listed_ixs(Rs?, 1, Lis),
    drop_listed(Vs1?, Lis?, Vs),
    form_words(Ws?, Pp?, Vs0?, Vs?, Tx).
form_text1(N, _, _, _, []) :- N? =\= 1 | true.
%% The questions of a line as one text, each after the one before and a space.
procedure join_questions(PSentences?, PWords).
join_questions([], []).
join_questions([Q], Q?).
join_questions([Q1, Q2|Qs], Ws?) :- join_questions([Q2?|Qs?], Ws1), app(Q1?, [text('" "')|Ws1?], Ws).
%% A sentence's words as the request form's: text(S) as say(S), and person(K), the K-th of the schema's persons, as at(I), I its place in the request.
procedure form_words(PWords?, Ints?, Args?, Args?, FWords).
form_words([], _, _, _, []).
form_words([text(X)|Ws], Pp, Vs0, Vs, [say(X?)|Fs?]) :- form_words(Ws?, Pp?, Vs0?, Vs?, Fs).
form_words([person(K)|Ws], Pp, Vs0, Vs, [at(I?)|Fs?]) :- ground(Pp?), ground(Vs0?), ground(Vs?) |
    nth_int(K?, Pp?, J),
    nth_arg(J?, Vs0?, A),
    place_of(A?, Vs?, 1, I),
    form_words(Ws?, Pp?, Vs0?, Vs?, Fs).
%% A button naming a guarded schema that names no guarded part, no binding of it determining a transaction, as one that adds at a role an atom it deletes there: "no atom a schema adds at a person is one it deletes there" (vGLP, Section 5.4, "Speech-act schemas as local specifications"), so no person can propose its act, and the request type has no alternative for it (local.glp, proposable).  The contract is not compiled, with the line saying why, as for a button naming no schema (Grassroots-Audit, programs/vglp/cva/compiler/cvac.glp.md, Finding 3).
procedure dead_lines(TActs?, Contract?, Preds?, Lines).
dead_lines([], _, _, []).
dead_lines([act(N, _, _, _, _, _, _)|As], C, Ps, L?) :- ground(N?), ground(C?), ground(Ps?) |
    find_schema(N?, C?, Sf),
    mem(N?, Ps?, In),
    dead_line(Sf?, In?, N?, L1),
    dead_lines(As?, C?, Ps?, L2),
    lapp(L1?, L2?, L).
procedure dead_line(SFound?, YesNo?, Constant?, Lines).
dead_line(sfound(_, Rs), no, N, L?) :- ground(Rs?), ground(N?) |
    guard_roles(Rs?, 1, Gs),
    dead_guarded(Gs?, N?, L).
dead_line(_, _, _, []) :- otherwise | true.
procedure dead_guarded(Ints?, Constant?, Lines).
dead_guarded([], _, []).
dead_guarded([_|_], N, [H?]) :- ground(N?) |
    said('%% a pragma\'s button names a guarded schema no binding of which determines a transaction, as one adding at a role an atom it deletes there:', N?, H).
%% The schemas the buttons name.
procedure act_names(TActs?, Preds).
act_names([], []).
act_names([act(N, _, _, _, _, _, _)|As], [N?|Ns?]) :- act_names(As?, Ns).
%% A guarded schema no button names: "A guarded schema is proposed by a person, by its button, so the compiler requires a button for every guarded schema; an unguarded one is proposed by its opener's machine and has none" (vGLP 932c710, Section 5.4, "The contract's words").  The schemas the request type proposes are those naming guarded parts (local.glp, proposable).
procedure unnamed_lines(Preds?, Preds?, Lines).
unnamed_lines([], _, []).
unnamed_lines([P|Ps], Ns, L?) :- ground(P?), ground(Ns?) |
    mem(P?, Ns?, In),
    unnamed_line(In?, P?, L1),
    unnamed_lines(Ps?, Ns?, L2),
    lapp(L1?, L2?, L).
procedure unnamed_line(YesNo?, Constant?, Lines).
unnamed_line(yes, _, []).
unnamed_line(no, P, [H?]) :- ground(P?) |
    said('%% a guarded schema has no button in the contract\'s pragmas:', P?, H).

%% The guarding roles at which the act is proposed, by(Gs), as pragmas.sh reads them, each one whose every other guarding role has a question (vGLP 3ec07a2, Section 5.4, "The contract's words": "A guarding role with no question is never asked, so an act is proposed only at a guarding role whose every other guarding role has a question"; Section 6.2, "The words a platform shows": "The request widget offers an act only where the person's machine can propose it, and at a guarding role at which the act is proposed"), the proposer a line in GSC's form names (GSC, Section 2, its first paragraph); each guarding role, any, where the scripts gave no contract term.
procedure proposer_roles(Proposer?, Ints?, Ints).
proposer_roles(any, Gr, Gr?).
proposer_roles(by(Gs), _, Gs?).
proposer_roles(by(Gs, _), _, Gs?).
%% The pairs of places possibly one person (GSC 316d875, Section 2: "a clause that admits one person in both writes 'Alice and Bob, possibly one person'"), printed in each act entry, same(K, J), a field offering one person for both (vGLP, Section 6.2).
procedure same_places(Proposer?, Preconds).
same_places(any, []).
same_places(by(_), []).
same_places(by(_, Ss), Is?) :- ground(Ss?) | sames_items(Ss?, Is).
procedure sames_items(Sames?, Preconds).
sames_items([], []).
sames_items([same(K, J)|Ss], [same(K?, J?)|Is?]) :- sames_items(Ss?, Is).
%% A mark is of the local check (words_ones), and pragmas.sh gives an act none; the clause covers the type.
sames_items([mark(_)|Ss], Is?) :- sames_items(Ss?, Is).
sames_items([gship(_, _, _)|Ss], Is?) :- sames_items(Ss?, Is).
%% The precondition of the act at the role G, the viewer's (vGLP 6e9f71d, Section 6.2, "The words a platform shows": a button is drawn "in the row of an entry that an atom the act requires or deletes at the proposer's role names, whatever the atom's predicate, a group <a>.n being named by n ...; and only where the viewer's state holds the atoms the act requires at the proposer's role and lacks those it forbids there"), so that the construct family finds from it both the rows the button is drawn in and whether it is drawn there: req(P, As) for each atom the schema requires or deletes at G, forb(P, As) for each it forbids there, As the place of each argument, at(K), a group by the places of its leader and its name, grp(J, K), and any where it is neither, as a variable local to the role; an atom of a reflexive predicate naming the role G itself is left out, holding at every person of that person (Section 5.4, "Act schemas as local specifications").
procedure condition_places(Integer?, RoleSpecs?, Args?, DrawCtx?, Preconds).
condition_places(G, Rs, Vs, ctx(Rf, Rl, _), Cs?) :- integer(G?), ground(Rs?), ground(Vs?), ground(Rf?), ground(Rl?) |
    nth_rs(G?, Rs?, R),
    condition_places1(R?, G?, Vs?, Rf?, C1),
    unless_places(Rs?, 1, G?, Vs?, Rl?, C2),
    dedup(C2?, C3),
    proved_places(Rs?, 1, G?, Vs?, Rl?, C4),
    dedup(C4?, C5),
    app(C3?, C5?, C35),
    app(C1?, C35?, Cs).
procedure condition_places1(RoleSpecs?, Integer?, Args?, Preds?, Preconds).
condition_places1([], _, _, _, []).
condition_places1([R|_], G, Vs, Rf, Cs?) :- ground(R?), integer(G?), ground(Vs?), ground(Rf?) |
    rs_lists(R?, _, M0, K, N),
    uncleared(M0?, M),
    app(K?, M?, Rq0),
    seen_atoms(Rq0?, Rq),
    seen_atoms(N?, N1),
    cond_atoms(Rq?, req, G?, Vs?, Rf?, C1),
    cond_atoms(N1?, forb, G?, Vs?, Rf?, C2),
    app(C1?, C2?, Cs).
%% The atoms of As that a view may show: all but the day, today(d), which the agent holds beside its state and the view never shows (README, 10), so the widget, which offers an act only where the view's atoms hold what it requires, is told no condition on it, and a variable only today(d) holds at the proposer's role is bound by no atom of the view and has a field: "a day that an act records is among its arguments, named by its proposer, and each participant that requires it checks it against the date of its own phone" (vGLP, Section 5.4; Mac #1 through Code #31, vGLP_inbox, 2026-11-15 21:27 UTC: GB's Issue bond was drawn on no phone).
procedure seen_atoms(Atoms?, Atoms).
seen_atoms([], []).
seen_atoms([atom(today, _)|As], Bs?) :- seen_atoms(As?, Bs).
seen_atoms([A|As], [A?|Bs?]) :- otherwise | seen_atoms(As?, Bs).
procedure cond_atoms(Atoms?, Constant?, Integer?, Args?, Preds?, Preconds).
cond_atoms([], _, _, _, _, []).
cond_atoms([times(_, A)|As], Sg, G, Vs, Rf, Cs?) :- cond_atoms([A?|As?], Sg?, G?, Vs?, Rf?, Cs).
%% The copies of an atom a role keeps beyond those it deletes, whose req the deleted atom gives.
cond_atoms([rest(_, _, _)|As], Sg, G, Vs, Rf, Cs?) :- cond_atoms(As?, Sg?, G?, Vs?, Rf?, Cs).
cond_atoms([atom(P, Xs)|As], Sg, G, Vs, Rf, Cs?) :- ground(P?), ground(Xs?), ground(Sg?), integer(G?), ground(Vs?), ground(Rf?) |
    mem(P?, Rf?, In),
    self_refl(In?, Xs?, G?, Sk),
    cond_args(Xs?, Vs?, Ks),
    cond_atom(Sk?, Sg?, P?, Ks?, C1),
    cond_atoms(As?, Sg?, G?, Vs?, Rf?, C2),
    app(C1?, C2?, Cs).
procedure self_refl(YesNo?, Args?, Integer?, YesNo).
self_refl(no, _, _, no).
self_refl(yes, [role(J)], G, yes) :- J? =:= G? | true.
self_refl(yes, _, _, no) :- otherwise | true.
procedure cond_atom(YesNo?, Constant?, Constant?, CondArgs?, Preconds).
cond_atom(yes, _, _, _, []).
cond_atom(no, req, P, Ks, [req(P?, Ks?)]).
cond_atom(no, forb, P, Ks, [forb(P?, Ks?)]).
%% A compound value f(t1, ..., tk) in an atom the act requires, cmp(F, As), As the places of its arguments, so that the way binds a variable of it, as the Day of a bond, bond(Day) (vGLP, Section 5.4: "every binding of the variables of the atoms the schema requires there"; Currencies #24, Code #39, 2026-11-26 01:16 UTC, GB's redeem_bond).
CondArg ::= at(Integer) ; grp(Integer, Integer) ; any ; cmp(Constant, CondArgs).
CondArgs ::= [] ; [CondArg | CondArgs].
procedure cond_args(Args?, Args?, CondArgs).
cond_args([], _, []).
cond_args([nterm(ext(own(J), Y))|Xs], Vs, [A?|As?]) :- integer(J?), ground(Y?), ground(Vs?) |
    place_of(role(J?), Vs?, 1, PJ),
    place_of(svar(Y?), Vs?, 1, PY),
    grp_arg(PJ?, PY?, A),
    cond_args(Xs?, Vs?, As).
cond_args([cmp(F, Ys)|Xs], Vs, [cmp(F?, Cs?)|As?]) :- ground(F?), ground(Ys?), ground(Vs?) |
    cond_args(Ys?, Vs?, Cs),
    cond_args(Xs?, Vs?, As).
cond_args([X|Xs], Vs, [A?|As?]) :- otherwise, ground(X?), ground(Vs?) |
    place_of(X?, Vs?, 1, K),
    at_arg(K?, A),
    cond_args(Xs?, Vs?, As).
procedure grp_arg(Integer?, Integer?, CondArg).
grp_arg(J, K, grp(J?, K?)) :- J? > 0, K? > 0 | true.
grp_arg(_, _, any) :- otherwise | true.
procedure at_arg(Integer?, CondArg).
at_arg(K, at(K?)) :- K? > 0 | true.
at_arg(0, any).
%% What the schemas prove of the other roles (vGLP 893d4ea, Section 6.2, "The words a platform shows": "where every schema that adds an atom naming x at a role requires or adds at x's role an atom that no schema deletes, the viewer holding the first shows that x holds the second, and an act that forbids the second at x's role is not drawn beside x"): rule(P, N, I, pat(Q, Ws)), the atom of P of arity N naming x at its argument I, at the viewer v, shows that x holds Q, its arguments Ws each x or v; derived from the schemas when the contract is compiled.  An act at the viewer's role G that forbids, at the role s of its place K, an atom such a rule proves of the person at K, is drawn with unless(P, As), As at(K) at argument I and any elsewhere: the viewer holding a matching atom, it is not drawn.
%% And whether the contract names a compound value, so that a field of a variable over the constants takes a value (field_value).
DrawCtx ::= ctx(Preds, Rules, YesNo).
Pat ::= pat(Constant, Preds).
Pats ::= [] ; [Pat | Pats].
Rule ::= rule(Constant, Integer, Integer, Pat).
Rules ::= [] ; [Rule | Rules].
Occ ::= occ(Constant, Integer, Integer, Pats).
Occs ::= [] ; [Occ | Occs].
procedure proved_rules(Contract?, Rules).
proved_rules(C, Rl?) :- ground(C?) |
    deleted_preds(C?, D),
    proved_rules1(C?, D?, Rl).
procedure proved_rules1(Contract?, Preds?, Rules).
proved_rules1(C, D, Rl?) :- ground(C?), ground(D?) |
    schema_occs(C?, D?, Os),
    schema_occs(C?, D?, Os2),
    occ_rules(Os?, Os2?, Rl).
procedure sch_rs(Schema?, RoleSpecs).
sch_rs(schema(_, _, Rs), Rs?).
sch_rs(cschema(_, _, _, Rs), Rs?).
sch_rs(nschema(_, _, _, Rs), Rs?).
%% The predicates some schema deletes.
procedure deleted_preds(Contract?, Preds).
deleted_preds([], []).
deleted_preds([S|Ss], D?) :- ground(S?) |
    sch_rs(S?, Rs),
    rs_deleted(Rs?, D1),
    deleted_preds(Ss?, D2),
    app(D1?, D2?, D).
procedure rs_deleted(RoleSpecs?, Preds).
rs_deleted([], []).
rs_deleted([R|Rs], D?) :- ground(R?) |
    rs_lists(R?, _, M, _, _),
    atom_preds(M?, D1),
    rs_deleted(Rs?, D2),
    app(D1?, D2?, D).
procedure atom_preds(Atoms?, Preds).
atom_preds([], []).
atom_preds([atom(P, _)|As], [P?|Ps?]) :- atom_preds(As?, Ps).
atom_preds([times(_, A)|As], Ps?) :- atom_preds([A?|As?], Ps).
atom_preds([rest(_, _, A)|As], Ps?) :- atom_preds([A?|As?], Ps).
%% For each schema, each role r and each atom it adds there naming another role s at argument I: occ(P, N, I, Pats), Pats the atoms required or added at s whose predicate no schema deletes, their arguments s and r read x and v.
procedure schema_occs(Contract?, Preds?, Occs).
schema_occs([], _, []).
schema_occs([S|Ss], D, Os?) :- ground(S?), ground(D?) |
    sch_rs(S?, Rs),
    sch_rs(S?, Rs2),
    role_occs(Rs?, Rs2?, 1, D?, O1),
    schema_occs(Ss?, D?, O2),
    app(O1?, O2?, Os).
procedure role_occs(RoleSpecs?, RoleSpecs?, Integer?, Preds?, Occs).
role_occs([], _, _, _, []).
role_occs([R|Rs], All, Ri, D, Os?) :- ground(R?), ground(All?), integer(Ri?), ground(D?) |
    rs_lists(R?, P, _, _, _),
    added_occs(P?, All?, Ri?, D?, O1),
    Ri1 := Ri? + 1,
    role_occs(Rs?, All?, Ri1?, D?, O2),
    app(O1?, O2?, Os).
procedure added_occs(Atoms?, RoleSpecs?, Integer?, Preds?, Occs).
added_occs([], _, _, _, []).
added_occs([times(_, A)|As], All, Ri, D, Os?) :- added_occs([A?|As?], All?, Ri?, D?, Os).
added_occs([rest(_, _, A)|As], All, Ri, D, Os?) :- added_occs([A?|As?], All?, Ri?, D?, Os).
added_occs([atom(P, Xs)|As], All, Ri, D, Os?) :- ground(P?), ground(Xs?), ground(All?), integer(Ri?), ground(D?) |
    count_args(Xs?, N),
    arg_occs(Xs?, 1, P?, N?, All?, Ri?, D?, O1),
    added_occs(As?, All?, Ri?, D?, O2),
    app(O1?, O2?, Os).
procedure arg_occs(Args?, Integer?, Constant?, Integer?, RoleSpecs?, Integer?, Preds?, Occs).
arg_occs([], _, _, _, _, _, _, []).
arg_occs([role(Sx)|Xs], I, P, N, All, Ri, D, Os?) :- integer(Sx?), integer(I?), ground(P?), integer(N?), ground(All?), integer(Ri?), ground(D?), Sx? =\= Ri? |
    nth_rs(Sx?, All?, R),
    role_pats(R?, Sx?, Ri?, D?, Pats),
    I1 := I? + 1,
    arg_occs(Xs?, I1?, P?, N?, All?, Ri?, D?, O2),
    Os = [occ(P?, N?, I?, Pats?)|O2?].
arg_occs([_|Xs], I, P, N, All, Ri, D, Os?) :- otherwise, integer(I?) |
    I1 := I? + 1,
    arg_occs(Xs?, I1?, P?, N?, All?, Ri?, D?, Os).
procedure role_pats(RoleSpecs?, Integer?, Integer?, Preds?, Pats).
role_pats([], _, _, _, []).
role_pats([R|_], Sx, Ri, D, Pats?) :- ground(R?), integer(Sx?), integer(Ri?), ground(D?) |
    rs_lists(R?, P, M0, K, _),
    uncleared(M0?, M),
    app(K?, M?, A1),
    app(A1?, P?, A),
    atom_pats(A?, Sx?, Ri?, D?, Pats).
procedure atom_pats(Atoms?, Integer?, Integer?, Preds?, Pats).
atom_pats([], _, _, _, []).
atom_pats([times(_, A)|As], Sx, Ri, D, Ps?) :- atom_pats([A?|As?], Sx?, Ri?, D?, Ps).
atom_pats([rest(_, _, A)|As], Sx, Ri, D, Ps?) :- atom_pats([A?|As?], Sx?, Ri?, D?, Ps).
atom_pats([atom(Q, Ys)|As], Sx, Ri, D, Ps?) :- ground(Q?), ground(Ys?), integer(Sx?), integer(Ri?), ground(D?) |
    mem(Q?, D?, Del),
    xv_args(Ys?, Sx?, Ri?, Ws, Ok),
    atom_pat(Del?, Ok?, Q?, Ws?, P1),
    atom_pats(As?, Sx?, Ri?, D?, P2),
    app(P1?, P2?, Ps).
procedure atom_pat(YesNo?, YesNo?, Constant?, Preds?, Pats).
atom_pat(no, yes, Q, Ws, [pat(Q?, Ws?)]).
atom_pat(yes, _, _, _, []).
atom_pat(no, no, _, _, []).
procedure xv_args(Args?, Integer?, Integer?, Preds, YesNo).
xv_args([], _, _, [], yes).
xv_args([role(J)|Ys], Sx, Ri, [x|Ws?], Ok?) :- integer(J?), integer(Sx?), integer(Ri?), J? =:= Sx? | xv_args(Ys?, Sx?, Ri?, Ws, Ok).
xv_args([role(J)|Ys], Sx, Ri, [v|Ws?], Ok?) :- integer(J?), integer(Sx?), integer(Ri?), J? =:= Ri? | xv_args(Ys?, Sx?, Ri?, Ws, Ok).
xv_args(_, _, _, [], no) :- otherwise | true.
%% The rules: for each occurrence, each of its patterns that every occurrence of the same predicate, arity and argument has.
procedure occ_rules(Occs?, Occs?, Rules).
occ_rules([], _, []).
occ_rules([occ(P, N, I, Ps)|Os], All, Rl?) :- ground(P?), integer(N?), integer(I?), ground(Ps?), ground(All?) |
    common_pats(Ps?, P?, N?, I?, All?, Rl1),
    occ_rules(Os?, All?, Rl2),
    app(Rl1?, Rl2?, Rl).
procedure common_pats(Pats?, Constant?, Integer?, Integer?, Occs?, Rules).
common_pats([], _, _, _, _, []).
common_pats([Pt|Ps], P, N, I, All, Rl?) :- ground(Pt?), ground(P?), integer(N?), integer(I?), ground(All?) |
    in_every(All?, P?, N?, I?, Pt?, B),
    keep_rule(B?, rule(P?, N?, I?, Pt?), Rl1),
    common_pats(Ps?, P?, N?, I?, All?, Rl2),
    app(Rl1?, Rl2?, Rl).
procedure keep_rule(YesNo?, Rule?, Rules).
keep_rule(yes, R, [R?]).
keep_rule(no, _, []).
procedure in_every(Occs?, Constant?, Integer?, Integer?, Pat?, YesNo).
in_every([], _, _, _, _, yes).
in_every([occ(P1, N1, I1, Ps1)|Os], P, N, I, Pt, B?) :- ground(P1?), ground(N1?), ground(I1?), ground(Ps1?), ground(P?), integer(N?), integer(I?), ground(Pt?), occ(P1?, N1?, I1?) =?= occ(P?, N?, I?) |
    mem(Pt?, Ps1?, B1),
    in_every1(B1?, Os?, P?, N?, I?, Pt?, B).
in_every([_|Os], P, N, I, Pt, B?) :- otherwise | in_every(Os?, P?, N?, I?, Pt?, B).
procedure in_every1(YesNo?, Occs?, Constant?, Integer?, Integer?, Pat?, YesNo).
in_every1(no, _, _, _, _, _, no).
in_every1(yes, Os, P, N, I, Pt, B?) :- in_every(Os?, P?, N?, I?, Pt?, B).
%% The unless entries of an act at the viewer's role G: for each other role s of it, at its place K, each atom it forbids at s that a rule proves of the person at s.
procedure unless_places(RoleSpecs?, Integer?, Integer?, Args?, Rules?, Preconds).
unless_places([], _, _, _, _, []).
unless_places([R|Rs], Sx, G, Vs, Rl, Us?) :- ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    unless_role(R?, Sx?, G?, Vs?, Rl?, U1),
    Sx1 := Sx? + 1,
    unless_places(Rs?, Sx1?, G?, Vs?, Rl?, U2),
    app(U1?, U2?, Us).
procedure unless_role(RoleSpec?, Integer?, Integer?, Args?, Rules?, Preconds).
unless_role(_, Sx, G, _, _, []) :- integer(Sx?), integer(G?), Sx? =:= G? | true.
unless_role(R, Sx, G, Vs, Rl, Us?) :- otherwise, ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    rs_lists(R?, _, _, _, N),
    place_of(role(Sx?), Vs?, 1, K),
    forb_pats(N?, Sx?, G?, Fs),
    unless_rules(Rl?, Fs?, K?, Us).
procedure forb_pats(Atoms?, Integer?, Integer?, Pats).
forb_pats([], _, _, []).
forb_pats([times(_, A)|As], Sx, G, Ps?) :- forb_pats([A?|As?], Sx?, G?, Ps).
forb_pats([rest(_, _, A)|As], Sx, G, Ps?) :- forb_pats([A?|As?], Sx?, G?, Ps).
forb_pats([atom(Q, Ys)|As], Sx, G, Ps?) :- ground(Q?), ground(Ys?), integer(Sx?), integer(G?) |
    xv_args(Ys?, Sx?, G?, Ws, Ok),
    atom_pat(no, Ok?, Q?, Ws?, P1),
    forb_pats(As?, Sx?, G?, P2),
    app(P1?, P2?, Ps).
procedure unless_rules(Rules?, Pats?, Integer?, Preconds).
unless_rules([], _, _, []).
unless_rules([rule(P, N, I, Pt)|Rl], Fs, K, Us?) :- ground(P?), integer(N?), integer(I?), ground(Pt?), ground(Fs?), integer(K?) |
    mem(Pt?, Fs?, B),
    unless_entry(B?, P?, N?, I?, K?, U1),
    unless_rules(Rl?, Fs?, K?, U2),
    app(U1?, U2?, Us).
procedure unless_entry(YesNo?, Constant?, Integer?, Integer?, Integer?, Preconds).
unless_entry(no, _, _, _, _, []).
unless_entry(yes, P, N, I, K, [unless(P?, As?)]) :- K? > 0 | unless_args(1, N?, I?, K?, As).
unless_entry(yes, _, _, _, 0, []).
procedure unless_args(Integer?, Integer?, Integer?, Integer?, CondArgs).
unless_args(J, N, _, _, []) :- J? > N? | true.
unless_args(J, N, I, K, [at(K?)|As?]) :- J? =< N?, J? =:= I? | J1 := J? + 1, unless_args(J1?, N?, I?, K?, As).
unless_args(J, N, I, K, [any|As?]) :- J? =< N?, J? =\= I? | J1 := J? + 1, unless_args(J1?, N?, I?, K?, As).
%% The proved entries of an act at the viewer's role G (vGLP 3ec07a2, Section 6.2, "The words a platform shows": "where the place's role requires an atom that the schemas prove of a person from the viewer's records, as above, only a person so proved is offered"): for each other role s of it, at its place K, each atom pat(Q, Ws) it requires or deletes at s that a rule proves of the person at s, its arguments s and G read x and v, and each rule rule(P, N, I, pat(Q, Ws)) proving it, proved(Q, Ws, P, As), As at(K) at argument I and any elsewhere: the place K offers only a person x for whom, for each such atom, the viewer holds an atom matching some entry of it.
procedure proved_places(RoleSpecs?, Integer?, Integer?, Args?, Rules?, Preconds).
proved_places([], _, _, _, _, []).
proved_places([R|Rs], Sx, G, Vs, Rl, Us?) :- ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    proved_role(R?, Sx?, G?, Vs?, Rl?, U1),
    Sx1 := Sx? + 1,
    proved_places(Rs?, Sx1?, G?, Vs?, Rl?, U2),
    app(U1?, U2?, Us).
procedure proved_role(RoleSpec?, Integer?, Integer?, Args?, Rules?, Preconds).
proved_role(_, Sx, G, _, _, []) :- integer(Sx?), integer(G?), Sx? =:= G? | true.
proved_role(R, Sx, G, Vs, Rl, Us?) :- otherwise, ground(R?), integer(Sx?), integer(G?), ground(Vs?), ground(Rl?) |
    rs_lists(R?, _, M0, K, _),
    uncleared(M0?, M),
    app(K?, M?, A),
    forb_pats(A?, Sx?, G?, Fs),
    place_of(role(Sx?), Vs?, 1, Kp),
    proved_rules_of(Rl?, Fs?, Kp?, Us).
procedure proved_rules_of(Rules?, Pats?, Integer?, Preconds).
proved_rules_of([], _, _, []).
proved_rules_of([rule(P, N, I, Pt)|Rl], Fs, K, Us?) :- ground(P?), integer(N?), integer(I?), ground(Pt?), ground(Fs?), integer(K?) |
    mem(Pt?, Fs?, B),
    proved_entry(B?, Pt?, P?, N?, I?, K?, U1),
    proved_rules_of(Rl?, Fs?, K?, U2),
    app(U1?, U2?, Us).
procedure proved_entry(YesNo?, Pat?, Constant?, Integer?, Integer?, Integer?, Preconds).
proved_entry(no, _, _, _, _, _, []).
proved_entry(yes, pat(Q, Ws), P, N, I, K, [proved(Q?, Ws?, P?, As?)]) :- K? > 0 | unless_args(1, N?, I?, K?, As).
proved_entry(yes, _, _, _, _, 0, []).
%% The conditions of an act at the proposer's role, printed in its widget declaration: req(P, As) and forb(P, As), the atoms the schema requires and forbids there; unless(P, As) and proved(Q, Ws, P, As), what the schemas prove of the other roles; and same(K, J), two places possibly one person.
Precond ::= req(Constant, CondArgs) ; forb(Constant, CondArgs) ; unless(Constant, CondArgs) ; proved(Constant, Preds, Constant, CondArgs) ; same(Integer, Integer) ; size(Integer, Integer) ; calc(Integer, MExpr, FnKind).
Preconds ::= [] ; [Precond | Preconds].
procedure nth_rs(Integer?, RoleSpecs?, RoleSpecs).
nth_rs(_, [], []).
nth_rs(1, [R|_], [R?]).
nth_rs(G, [_|Rs], R?) :- G? > 1 | G1 := G? - 1, nth_rs(G1?, Rs?, R).
%% The index of the first guarding role, from J; 0 where there is none.
procedure first_guard(RoleSpecs?, Integer?, Integer).
first_guard([], _, 0).
first_guard([R|Rs], J, G?) :- ground(R?), integer(J?) | rs_guarded(R?, B), first_guard1(B?, J?, Rs?, G).
procedure first_guard1(YesNo?, Integer?, RoleSpecs?, Integer).
first_guard1(yes, J, _, J?).
first_guard1(no, J, Rs, G?) :- integer(J?) | J1 := J? + 1, first_guard(Rs?, J1?, G).
%% The number of guarding roles.
procedure guard_count(RoleSpecs?, Integer).
guard_count([], 0).
guard_count([R|Rs], N?) :- ground(R?) | rs_guarded(R?, B), guard_count(Rs?, M), add_yes(B?, M?, N).
procedure add_yes(YesNo?, Integer?, Integer).
add_yes(yes, M, N?) :- N := M? + 1.
add_yes(no, M, M?).
%% The place of an argument among the request's arguments, from I; 0 where it is not one.
procedure place_of(Arg?, Args?, Integer?, Integer).
place_of(_, [], _, 0).
place_of(A, [B|_], I, I?) :- A? =?= B? | true.
%% A set variable is set(X) in the head and num(X) in its atoms and its constraint (nums_of).
place_of(num(X), [set(Y)|_], I, I?) :- X? =?= Y? | true.
place_of(A, [_|Bs], I, P?) :- otherwise, integer(I?) | I1 := I? + 1, place_of(A?, Bs?, I1?, P).
procedure nth_arg(Integer?, Args?, Arg).
nth_arg(1, [A|_], A?).
nth_arg(K, [_|As], A?) :- K? > 1 | K1 := K? - 1, nth_arg(K1?, As?, A).
nth_arg(_, [], role(0)).

%% The lists and the sentences, printed for a contract with pragmas: tabs(Ts), the lists its app shows, tab(Name, P), P the predicate whose atoms the list holds; and sentence_of(C, Me, Ws), the sentence the contract puts to the agent Me on an attempt of the part C, its roles and variables filled in from the binding C names, or [] where it puts none: where the pragma of C's clause has no sentence, or where the sentence names Me, the sentence being put to the guarding roles whose persons it does not name (README.md beside this file, "The pragmas").
procedure word_lines(Worded?, Contract?, NumInfos?, Lines).
word_lines(words(pragmas(Ls, As, Ss, Lk, Vn, Tx, _, _), Ev, Lx, Dn, Vl), C, Nt, L?) :- ground(Ls?), ground(As?), ground(C?), ground(Ss?), ground(Lk?), ground(Vn?), ground(Tx?), ground(Dn?), ground(Lx?) |
    export_lines(Dn?, pragmas(Ls?, As?, Ss?, Lk?, Vn?), Tx?, Vn?, Lex0),
    lx_consts(Lx?, Kn),
    lx_sets(Lx?, Ks),
    rarg_lines(Lex0?, Kn?, Ks?, Lex1),
    contract_cmps(C?, Lx?, Cc),
    cmps_any(Cc?, Kc, _),
    rarg_cmp(Lex1?, Kc?, Lex),
    contract_preds_lx(C?, Nt?, Lx?, Pr),
    mult_preds(C?, Mp),
    tab_terms(Ls?, Pr?, Mp?, Ts),
    list_text(Ts?, Tl),
    call_text(tabs, [Tl?], T),
    sentence_lines(As?, C?, Lsn),
    lapp(Lsn?, ['sentence_of(_, _, asked(0, [])) :- otherwise | true.'], Lsn1),
    lapp(['',
        '%% The lists the app shows, as the contract\'s pragmas give them, each its name and the predicate whose atoms it lists (vGLP, Section 5.4, "The contract\'s words").',
        'procedure tabs(List(Tab)).',
        T?,
        '.',
        '',
        '%% The question the contract puts to the agent Me on an attempt of the part C, the question of the guarding role beyond the proposer\'s that Me is in, its persons filled in from the binding C names, with the role of the proposer, asked(G, Words); none, asked(0, []), where Me is in none or the contract puts none (vGLP, Section 6.2, "The words a platform shows"; GSC, Section 2, its first paragraph).',
        'procedure sentence_of(Class?, Peer?, Asked).'|Lsn1?], Lex?, L0),
    drop_pred(today, Ev?, Ev1),
    dev_lines(Vl?, Ev1?, Ld),
    lapp(L0?, Ld?, L).
%% The values the developer gives, dev(Text), Text the list of their atoms as the contract's Vocabulary writes them, read from the contract's NAME.values: the platform prints them and an agent of four arguments that starts the agent of five with them, so that the program carries them and a mini-app calls agent/4 (vGLP 922ac53, Section 5.4, "Speech-act schemas as local specifications": "A platform is deployed when its developer compiles it, giving the compiler the values; the program carries them, so every participant of one of its instances holds the same values, and the same contract with other values is another program").  None where the contract has no environment predicate besides the day, its agent having four arguments already.
procedure dev_lines(DevValues?, Preds?, Lines).
dev_lines(nodev, _, []).
dev_lines(dev(_), [], []).
dev_lines(dev(S), [_|_], ['',
        '%% The values the developer gave when compiling the platform, the atoms of the environment predicates the developer gives (vGLP, Section 5.4), which the agent holds from startup.',
        'procedure developer_values(List(Atom)).',
        T?,
        '.',
        'exported procedure agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output)).',
        'agent(Id, NetIn, Out?, Thr?) :- developer_values(Vs), agent(Id?, NetIn?, Out, Thr, Vs?).']) :- call_text(developer_values, [S?], T).
% The platform's exports of the contract it is compiled from (vGLP b413fe1, Section 5.4, "The contract's words": "The platform the compiler prints exports, beside its agent and its dispatcher, two procedures: contract(Text, Schemas), the contract it is compiled from, its clauses as text and its schemas with the pragmas as the term the checker and the compiler read; and version(Current, Back), its version and the earliest version of itself it is compatible with, both from a line of the pragmas, so the app that loads the platform reads its contract and its versions from it"): contract(Text, with(Read, Pragmas)), Text the clauses as pragmas.sh reads them from the contract's NAME.txt, Read the contract as GSC's reader reads it, its names with it, and Pragmas its pragmas, pragmas(Lists, Acts, Stands, Look, Version), the look among them, where the app and the site read it (ibid., "The contract's words": the look, "which the compiler carries into the platform it prints, among the pragmas of the contract the platform exports, where the app and the site that show it read it"); and version(Current, Back), from the contract's Version line, or version(1, 1).  The types of the term, GSC's reader's and the pragmas' (programs/gsc/self.glp; self.glp beside this file), are declared in the platform with an R before their names, the platform's own types bearing theirs.
procedure export_lines(WDeclared?, RPragmas?, String?, PVersion?, Lines).
%% The types of an act carry the types of its fields only where an act of the pragmas has some (vGLP 37fe038, Section 5.4), so that a platform with no typed field prints as before.
export_lines(Dn, Pr, Tx, Vn, L?) :- ground(Pr?) |
    export_head(Hd),
    acts_typed(Pr?, Y),
    act_type_lines(Y?, Ma),
    export_tail(Dn?, Pr?, Tx?, Vn?, Tl),
    lapp(Hd?, Ma?, L1),
    lapp(L1?, Tl?, L).
%% The type of an argument of the contract as read has the alternative const(Constant) only where the contract has a variable over the constants (lx_consts), and set(Constant) only where it has a set variable (lx_sets), so that a platform with neither prints as before.
%% A field's type has the alternative set only where the contract has a set variable (lx_sets), a field of a set variable taking its elements, so that a platform with none prints as before.
%% A field's type has the alternative value only where the contract names a compound value (field_value), so that a platform naming none prints as before.
procedure value_lines(Lines?, YesNo?, Lines).
value_lines(Ls, no, Ls?).
value_lines(Ls, yes, R?) :-
    line_sub(Ls?, 'MenuFieldType ::= person ; key ; agent ; text ; number.', 'MenuFieldType ::= person ; key ; agent ; text ; number ; value.', R1),
    line_sub(R1?, 'MenuFieldType ::= person ; key ; agent ; text ; number ; set.', 'MenuFieldType ::= person ; key ; agent ; text ; number ; set ; value.', R2),
    line_sub(R2?, 'MenuCondArg ::= at(Integer) ; grp(Integer, Integer) ; any.', 'MenuCondArg ::= at(Integer) ; grp(Integer, Integer) ; any ; cmp(Constant, List(MenuCondArg)).', R).
procedure menu_lines(Lines?, YesNo?, Lines).
menu_lines(Ls, no, Ls?).
menu_lines(Ls, yes, R?) :-
    line_sub(Ls?, 'MenuFieldType ::= person ; key ; agent ; text ; number.', 'MenuFieldType ::= person ; key ; agent ; text ; number ; set.', R1),
    line_sub(R1?, 'MenuCond ::= req(Constant, List(MenuCondArg)) ; forb(Constant, List(MenuCondArg)) ; unless(Constant, List(MenuCondArg)) ; proved(Constant, List(Constant), Constant, List(MenuCondArg)) ; same(Integer, Integer).', 'MenuCond ::= req(Constant, List(MenuCondArg)) ; forb(Constant, List(MenuCondArg)) ; unless(Constant, List(MenuCondArg)) ; proved(Constant, List(Constant), Constant, List(MenuCondArg)) ; same(Integer, Integer) ; size(Integer, Integer).', R).
procedure rarg_lines(Lines?, YesNo?, YesNo?, Lines).
rarg_lines(Ls, no, no, Ls?).
rarg_lines(Ls, yes, no, R?) :- line_sub(Ls?, 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant).', 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; const(Constant).', R).
rarg_lines(Ls, no, yes, R?) :- line_sub(Ls?, 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant).', 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; set(Constant).', R).
rarg_lines(Ls, yes, yes, R?) :- line_sub(Ls?, 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant).', 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; const(Constant) ; set(Constant).', R).
procedure rarg_cmp(Lines?, YesNo?, Lines).
%% The type of an argument of the contract as read has the alternative cmp(Constant, RArgs) only where the contract names a compound value (contract_cmps), so that a platform with none prints as before.
rarg_cmp(Ls, no, Ls?).
rarg_cmp(Ls, yes, R?) :-
    line_sub(Ls?, 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant).', 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; cmp(Constant, RArgs).', L1),
    line_sub(L1?, 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; const(Constant).', 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; const(Constant) ; cmp(Constant, RArgs).', L2),
    line_sub(L2?, 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; set(Constant).', 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; set(Constant) ; cmp(Constant, RArgs).', L3),
    line_sub(L3?, 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; const(Constant) ; set(Constant).', 'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant) ; const(Constant) ; set(Constant) ; cmp(Constant, RArgs).', R).
%% The lines with the line Old replaced by New.
procedure line_sub(Lines?, String?, String?, Lines).
line_sub([], _, _, []).
line_sub([L|Ls], O, A, [A?|Ls?]) :- L? =?= O? | true.
line_sub([L|Ls], O, A, [L?|Ls1?]) :- otherwise | line_sub(Ls?, O?, A?, Ls1).
%% The lines with A added as a line of its own after the line O, each type definition on a line of its own, as sGLP's interface.sh reads them (Code #38, 2026-11-25).
procedure line_after(Lines?, String?, String?, Lines).
line_after([], _, _, []).
line_after([L|Ls], O, A, [L?, A?|Ls?]) :- L? =?= O? | true.
line_after([L|Ls], O, A, [L?|Ls1?]) :- otherwise | line_after(Ls?, O?, A?, Ls1).
procedure export_head(Lines).
export_head(['',
        '% The contract the platform is compiled from (vGLP, Section 5.4, "The contract\'s words"): contract(Text, with(Read, Pragmas)), its clauses as text, the contract as GSC\'s reader reads it, with its names, and its pragmas, pragmas(Lists, Acts, Stands, Look, Version), its look among them, where the app and the site read it; and version(Current, Back), its version and the earliest version of itself it is compatible with, from its Version line, or version(1, 1).  The types of the term are GSC\'s reader\'s and the pragmas\', named with an R before them.',
        'RNameTerm ::= own(Integer) ; own_var(Constant) ; nvar(Constant) ; ext(RNameTerm, Constant) ; ext_any(RNameTerm).',
        'RArg      ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(RNameTerm) ; sgn(Constant, Integer) ; num(Constant) ; real(Constant) ; any ; ilist(Integer, String) ; item_of(RArg) ; val(Constant).',
        'RArgs     ::= [] ; [RArg | RArgs].',
        'RAtom     ::= atom(Constant, RArgs) ; times(RArg, RAtom) ; rest(RArg, RArg, RAtom).',
        'RAtoms    ::= [] ; [RAtom | RAtoms].',
        'RGuard    ::= guarded ; unguarded ; guarded_at(Constant).',
        'RRoleKind ::= seated(RNameTerm, Constant) ; constituent(RNameTerm, Constant) ; listed(Integer, Constant, RArgs) ; qlisted(Integer, Constant, RArgs, RArgs).',
        'RRoleSpec ::= rs(RGuard, RAtoms, RAtoms, RAtoms, RAtoms) ; crs(RRoleKind, RGuard, RAtoms, RAtoms, RAtoms, RAtoms).',
        'RRoleSpecs ::= [] ; [RRoleSpec | RRoleSpecs].',
        'RReach    ::= reach(RNameTerm, Constant, RNameTerm).',
        'RReaches  ::= [] ; [RReach | RReaches].',
        'RConstraint ::= true ; and(RConstraint, RConstraint) ; eq(RExpr, RExpr) ; le(RExpr, RExpr) ; lt(RExpr, RExpr) ; ge(RExpr, RExpr) ; gt(RExpr, RExpr) ; succ(RArg, RArg) ; or(RConstraint, RConstraint) ; signed(RArg, RArg) ; unsigned(RArg, RArg) ; not(RConstraint) ; implies(RConstraint, RConstraint) ; ne(RExpr, RExpr) ; rel(Constant, RExprs) ; program(RExpr).',
        'RExpr     ::= RArg ; plus(RExpr, RExpr) ; minus(RExpr, RExpr) ; mul(RExpr, RExpr) ; fn(Constant, RExprs) ; cardinality(RArgs, RArg, RAtom, RForm) ; sum(RArgs, RArg, RAtom, RForm, RExpr) ; author_of(RArg).',
        'RExprs    ::= [] ; [RExpr | RExprs].',
        'RForm     ::= fa(RArg, RAtom) ; fnot(RForm) ; fand(RForm, RForm) ; for(RForm, RForm) ; fexists(RArgs, RArg, RAtom, RForm) ; fforall(RArgs, RArg, RAtom, RForm, RForms) ; fcons(RConstraint).',
        'RForms    ::= [] ; [RForm | RForms].',
        'RHMult    ::= hm(Integer, RAtom).',
        'RHMults   ::= [] ; [RHMult | RHMults].',
        'RConjunct ::= conjunct(RArgs, Integer, RAtom, RForm, RHMults, RHMults, RForms).',
        'RConjuncts ::= [] ; [RConjunct | RConjuncts].',
        'RName     ::= Constant ; one(Constant, OneOf).',
        'RNames    ::= [] ; [RName | RNames].',
        'RSchema   ::= schema(Constant, RArgs, RRoleSpecs) ; cschema(Constant, RArgs, RReaches, RRoleSpecs) ; nschema(Constant, RArgs, RConstraint, RRoleSpecs) ; schema(Constant, RNames, RArgs, RRoleSpecs) ; cschema(Constant, RNames, RArgs, RReaches, RRoleSpecs) ; nschema(Constant, RNames, RArgs, RConstraint, RRoleSpecs) ; qschema(Constant, RArgs, RArgs, RConstraint, RRoleSpecs, RConjuncts, RForms) ; qschema(Constant, RNames, RArgs, RArgs, RConstraint, RRoleSpecs, RConjuncts, RForms).',
        'RContract ::= [] ; [RSchema | RContract].',
        'RBody     ::= RContract ; reflexive(Preds, RContract).',
        'RDeclared ::= RBody ; environment(Preds, RBody).',
        '%% The pragmas (programs/vglp/cva/compiler/README.md, 1): the lists, the acts, the standing declarations, the look and the version.',
        'PWord     ::= text(String) ; person(Integer).',
        'PWords    ::= [] ; [PWord | PWords].',
        'PSentences ::= [] ; [PWords | PSentences].',
        'PSaid     ::= none ; said(PSentences).',
        'PStrings  ::= [] ; [String | PStrings].',
        'PList     ::= list(String, PStrings).',
        'PLists    ::= [] ; [PList | PLists].']).
procedure act_type_lines(YesNo?, Lines).
act_type_lines(no, ['PAct      ::= act(Constant, String, PStrings, PSaid, String, PProposer).']).
act_type_lines(yes, ['PFType    ::= ft(Integer, Constant) ; consents(Integer).',
        'PFTypes   ::= [] ; [PFType | PFTypes].',
        'PAct      ::= act(Constant, String, PStrings, PSaid, String, PProposer) ; act(Constant, String, PStrings, PSaid, String, PProposer, PFTypes).']).
%% Whether an act of the pragmas carries the types of its fields.
procedure acts_typed(RPragmas?, YesNo).
acts_typed(pragmas(_, As, _, _, _), Y?) :- acts_typed1(As?, Y).
procedure acts_typed1(TActs?, YesNo).
acts_typed1([], no).
acts_typed1([act(_, _, _, _, _, _, [])|As], Y?) :- acts_typed1(As?, Y).
acts_typed1([act(_, _, _, _, _, _, [_|_])|_], yes).
procedure export_tail(WDeclared?, RPragmas?, String?, PVersion?, Lines).
export_tail(Dn, Pr, Tx, Vn, ['PProposer ::= any ; by(Ints) ; by(Ints, PSames).',
        'PSame     ::= same(Integer, Integer).',
        'PSames    ::= [] ; [PSame | PSames].',
        'PActs     ::= [] ; [PAct | PActs].',
        'PStand    ::= standing(Constant, Constant, Constant).',
        'PStands   ::= [] ; [PStand | PStands].',
        'PLook     ::= nolook ; look(String, String).',
        'PVersion  ::= version(Integer, Integer).',
        'RPragmas  ::= pragmas(PLists, PActs, PStands, PLook, PVersion).',
        'Exported  ::= with(RDeclared, RPragmas).',
        '',
        'exported procedure contract(String, Exported).',
        Ct?,
        '.',
        '',
        'exported procedure version(Integer, Integer).',
        Vl?,
        '.']) :- ground(Dn?), ground(Pr?), ground(Tx?), ground(Vn?) |
    term_to_string(Dn?, Dt),
    rp_text(Pr?, Pt),
    string_concat(['contract(', Tx?, ', with(', Dt?, ', ', Pt?, '))'], Ct),
    term_to_string(Vn?, Vl).
%% The pragmas term written as source, each word, a list's name, a button, a field, a word of a question, a tab, the look's icon and family, written as it is, its source text inside the quoted name pragmas.sh gives it (14), so that the platform reads it back as the string and not as a name holding quotes; every other constant written by term_to_string.
procedure rp_text(RPragmas?, String).
rp_text(pragmas(Ls, As, Ss, Lk, Vn), T?) :- ground(Ls?), ground(As?), ground(Ss?), ground(Lk?), ground(Vn?) |
    plists_src(Ls?, L1),
    list_text(L1?, Lt),
    pacts_src(As?, A1),
    list_text(A1?, At),
    term_to_string(Ss?, St),
    look_src(Lk?, Kt),
    term_to_string(Vn?, Vt),
    string_concat(['pragmas(', Lt?, ', ', At?, ', ', St?, ', ', Kt?, ', ', Vt?, ')'], T).
procedure plists_src(PLists?, Strings).
plists_src([], []).
plists_src([list(N, Ws)|Ls], [T?|Ts?]) :- ground(N?), ground(Ws?) |
    term_to_string(Ws?, Wt),
    string_concat(['list(', N?, ', ', Wt?, ')'], T),
    plists_src(Ls?, Ts).
procedure pacts_src(TActs?, Strings).
pacts_src([], []).
pacts_src([act(S, B, Fs, Sd, Tab, Pr, Fy)|As], [T?|Ts?]) :- ground(S?), ground(B?), ground(Fs?), ground(Sd?), ground(Tab?), ground(Pr?), ground(Fy?) |
    term_to_string(S?, St),
    list_text(Fs?, Ft),
    said_src(Sd?, Dt),
    term_to_string(Pr?, Pt),
    ftypes_src(Fy?, Yt),
    string_concat(['act(', St?, ', ', B?, ', ', Ft?, ', ', Dt?, ', ', Tab?, ', ', Pt?, Yt?, ')'], T),
    pacts_src(As?, Ts).
%% The types of an act's fields, as its seventh argument, nothing where it has none.
procedure ftypes_src(FTypes?, String).
ftypes_src([], '').
ftypes_src([F|Fs], T?) :- ground(F?), ground(Fs?) | term_to_string([F?|Fs?], Ft), string_concat([', ', Ft?], T).
procedure said_src(Said?, String).
said_src(none, 'none').
said_src(said(Ss), T?) :- ground(Ss?) | sentences_src(Ss?, S1), list_text(S1?, St), string_concat(['said(', St?, ')'], T).
procedure sentences_src(PSentences?, Strings).
sentences_src([], []).
sentences_src([Ws|Ss], [T?|Ts?]) :- ground(Ws?) | pwords_src(Ws?, W1), list_text(W1?, T), sentences_src(Ss?, Ts).
procedure pwords_src(PWords?, Strings).
pwords_src([], []).
pwords_src([text(X)|Ws], [T?|Ts?]) :- ground(X?) | string_concat(['text(', X?, ')'], T), pwords_src(Ws?, Ts).
pwords_src([person(I)|Ws], [T?|Ts?]) :- integer(I?) | term_to_string(person(I?), T), pwords_src(Ws?, Ts).
procedure look_src(PLook?, String).
look_src(nolook, 'nolook').
look_src(look(I, F), T?) :- ground(I?), ground(F?) | string_concat(['look(', I?, ', ', F?, ')'], T).
%% A tab is tab(Name, P), or tab(Name, P, counted) where the contract adds or deletes the predicate P with a multiplicity, so that each atom it lists is shown with its count (vGLP 40f8444, Section 5.4, "The contract's words": "The tab lists the atoms of that predicate in the state, each with its count where the contract adds or deletes the predicate with a multiplicity, the view carrying the whole state").
procedure tab_terms(PLists?, Preds?, Preds?, Strings).
tab_terms([], _, _, []).
tab_terms([list(N, Ws)|Ls], Pr, Mp, [T?|Ts?]) :- ground(N?), ground(Ws?), ground(Pr?), ground(Mp?) |
    listed_preds(Ws?, Pr?, Ms),
    first_pred(Ms?, P),
    tab_term(N?, P?, Mp?, T),
    tab_terms(Ls?, Pr?, Mp?, Ts).
procedure tab_term(String?, Constant?, Preds?, String).
tab_term(N, P, Mp, T?) :- ground(P?), ground(Mp?) |
    mem(P?, Mp?, C),
    tab_term1(C?, N?, P?, T).
procedure tab_term1(YesNo?, String?, Constant?, String).
tab_term1(yes, N, P, T?) :- term_to_string(P?, Pt), call_text(tab, [N?, Pt?, counted], T).
tab_term1(no, N, P, T?) :- term_to_string(P?, Pt), call_text(tab, [N?, Pt?], T).
%% The predicates the contract adds or deletes with a multiplicity, times(K, A) in an atom list it adds or deletes at a role.
procedure mult_preds(Contract?, Preds).
mult_preds(C, Ps?) :- ground(C?) |
    contract_changes(C?, As),
    times_names(As?, Ns),
    dedup(Ns?, Ps).
procedure contract_changes(Contract?, Atoms).
contract_changes([], []).
contract_changes([schema(_, _, Rs)|Ss], As?) :- rs_changes(Rs?, A1), contract_changes(Ss?, A2), app(A1?, A2?, As).
contract_changes([cschema(_, _, _, Rs)|Ss], As?) :- rs_changes(Rs?, A1), contract_changes(Ss?, A2), app(A1?, A2?, As).
contract_changes([nschema(_, _, _, Rs)|Ss], As?) :- rs_changes(Rs?, A1), contract_changes(Ss?, A2), app(A1?, A2?, As).
procedure rs_changes(RoleSpecs?, Atoms).
rs_changes([], []).
rs_changes([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M, _, _),
    rs_changes(Rs?, A3),
    app(M?, A3?, A2),
    app(P?, A2?, As).
procedure times_names(Atoms?, Preds).
times_names([], []).
times_names([times(_, atom(F, _))|As], [F?|Ns?]) :- times_names(As?, Ns).
times_names([_|As], Ns?) :- otherwise | times_names(As?, Ns).
procedure first_pred(Preds?, Constant).
first_pred([P|_], P?).
first_pred([], none).
procedure sentence_lines(TActs?, Contract?, Lines).
sentence_lines([], _, []).
sentence_lines([act(_, _, _, none, _, _, _)|As], C, L?) :- sentence_lines(As?, C?, L).
sentence_lines([act(N, _, Fs, said(Ws), _, By, _)|As], C, L?) :- ground(N?), ground(Ws?), ground(Fs?), ground(By?), ground(C?) |
    schema_sentences([N?], Ws?, Fs?, By?, C?, L1),
    sentence_lines(As?, C?, L2),
    lapp(L1?, L2?, L).
procedure schema_sentences(Preds?, PSentences?, Strings?, Proposer?, Contract?, Lines).
schema_sentences([], _, _, _, _, []).
schema_sentences([S|Ss], Ws, Fs, By, C, L?) :- ground(S?), ground(Ws?), ground(Fs?), ground(By?), ground(C?) |
    find_schema(S?, C?, Sf),
    schema_sentence(Sf?, S?, Ws?, Fs?, By?, L1),
    schema_sentences(Ss?, Ws?, Fs?, By?, C?, L2),
    lapp(L1?, L2?, L).
%% sentence_of(s(V1, _, V3), Me, Ws?) :- ground(V1?), ground(V3?), ground(Me?) | said([V1?, V3?], Me?, [person(V1?), text(...), person(V3?), ...], Ws), each person the sentence names at the place of its class term that holds it, every other place _.
procedure schema_sentence(SFound?, Constant?, PSentences?, Strings?, Proposer?, Lines).
schema_sentence(nosfound, _, _, _, _, []).
schema_sentence(sfound(Hd, Rs), S, Ws, Fs, By, L?) :- ground(Hd?), ground(Rs?) |
    guard_count(Rs?, N),
    schema_sentence0(N?, Hd?, Rs?, S?, Ws?, Fs?, By?, L).
%% An act with one guarding role puts its question to no other person: it is text of its request form (text_entry), and no sentence_of clause is printed for it (vGLP, Section 5.4, "The contract's words").
procedure schema_sentence0(Integer?, Args?, RoleSpecs?, Constant?, PSentences?, Strings?, Proposer?, Lines).
schema_sentence0(1, _, _, _, _, _, _, []).
schema_sentence0(N, Hd, Rs, S, Qs, Fs, By, L?) :- N? =\= 1, ground(Hd?), ground(Rs?), ground(Qs?), ground(By?) |
    guard_roles(Rs?, 1, Gr),
    guard_roles(Rs?, 1, Gr1),
    proposer_roles(By?, Gr1?, Pr),
    count_questions(Qs?, NQ),
    asked_roles(NQ?, Gr?, Ga0),
    drop_unasked(Ga0?, Qs?, Ga, Qs1),
    person_places(Hd?, Rs?, Pp),
    schema_vars(Rs?, Hd?, Vs),
    value_field_places(Hd?, Rs?, Fq),
    schema_sentence1(Ga?, Qs1?, Pp?, Vs?, S?, Fs?, Fq?, Pr?, L).
%% The proposer's question, [], in a pragma that names the proposer, none being put to the proposer, and its role left out (pragmas.sh).
procedure drop_unasked(Ints?, PSentences?, Ints, PSentences).
drop_unasked([], _, [], []).
drop_unasked([_|_], [], [], []).
drop_unasked([_|Gs], [[]|Qs], Gs1?, Qs1?) :- drop_unasked(Gs?, Qs?, Gs1, Qs1).
drop_unasked([G|Gs], [[W|Ws]|Qs], [G?|Gs1?], [[W?|Ws?]|Qs1?]) :- drop_unasked(Gs?, Qs?, Gs1, Qs1).
%% The guarding roles a line's questions are put to: its one question to each guarding role beyond the first; its questions, one per guarding role, each to its own, in the order of the roles (vGLP 21fca00, Section 5.4, "The contract's words": "a line's questions are one per guarding role of the widest schema of its clause, in the order of the roles, none left out, since any guard may propose"), pragmas.sh having given each schema a line covers the questions of its own guarding roles.
procedure asked_roles(Integer?, Ints?, Ints).
asked_roles(1, Gr, Ga?) :- rest_ints(Gr?, Ga).
asked_roles(NQ, Gr, Gr?) :- NQ? =\= 1 | true.
%% The indices of the guarding roles, in order, from J.
procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([R|Rs], J, Gs?) :- ground(R?), integer(J?) |
    rs_guarded(R?, B),
    J1 := J? + 1,
    guard_roles(Rs?, J1?, Gs1),
    keep_int(B?, J?, Gs1?, Gs).
procedure rest_ints(Ints?, Ints).
rest_ints([], []).
rest_ints([_|Is], Is?).
%% sentence_of(s(V1, V2, _), Me, Ws?) :- ground(V1?), ground(V2?), ground(Me?) | ask_of([q(V2?, [person(V1?), text(...)]), ...], Me?, Ws): the question of each guarding role beyond the proposer's, the first, in their order, q(R, Words), R the person in that role, each person the question names at the place of the class term that holds it, every other place _; ask_of gives the words of the first whose role holds Me, and [] where none does (GSC, Section 2, its first paragraph: "for each role whose will the act needs beyond the proposer's, in their order, the question the person in it is asked").
%% Each question names the role of the proposer, q(R, G, Words), the first of the roles at which the act is proposed other than R's, whose atoms the question shows (vGLP e22e2ad, Section 5.4, "The contract's words"; question_words in the shared text).
%% After its sentence, a question shows each value of the binding it does not name, a person or a number, by the name of its field, named(F, P) or valued(F, K) (vGLP 110caf4, Section 5.4, "The contract's words": "and shows after it each value of the binding the question does not name, by the name of its field, so that the person sees the whole proposal"); a place no field of the pragma names is not shown.
procedure schema_sentence1(Ints?, PSentences?, Ints?, Args?, Constant?, Strings?, Ints?, Ints?, Lines).
schema_sentence1(Gr, Qs, Pp, Vs, S, Fs, Fq, Pr, [T?, ':-'|L?]) :- ground(Gr?), ground(Qs?), ground(Pp?), ground(Vs?), ground(S?), ground(Fs?), ground(Fq?), ground(Pr?) |
    spread_questions(Gr?, Qs?, Q1),
    spread_questions(Gr?, Qs?, Q2),
    question_places(Gr?, Q1?, Pp?, Ns0),
    schema_sentence1b(Ns0?, Gr?, Q2?, Pp?, Vs?, S?, Fs?, Fq?, Pr?, T, L).
procedure schema_sentence1b(Ints?, Ints?, PSentences?, Ints?, Args?, Constant?, Strings?, Ints?, Ints?, String, Lines).
schema_sentence1b(Ns0, Gr, Qs, Pp, Vs, S, Fs, Fq, Pr, T?, L?) :- ground(Ns0?), ground(Vs?), ground(Fs?), ground(Fq?) |
    value_places(Fq?, Fs?, Ns0?, Vs?, Vp),
    schema_sentence1c(Vp?, Ns0?, Gr?, Qs?, Pp?, Vs?, S?, Pr?, T, L).
procedure schema_sentence1c(VPlaces?, Ints?, Ints?, PSentences?, Ints?, Args?, Constant?, Ints?, String, Lines).
schema_sentence1c(Vp, Ns0, Gr, Qs, Pp, Vs, S, Pr, T?, L?) :- ground(Vp?) |
    vplace_ints(Vp?, Vi),
    app(Ns0?, Vi?, Ns1),
    dedup(Ns1?, Ns),
    value_words(Vp?, Vw),
    question_terms(Gr?, Qs?, Pp?, Vw?, Pr?, Qt),
    schema_sentence2(Ns?, Vs?, S?, Qt?, T, L).
%% The clause's one question put to each guarding role other than the proposer's (vGLP 932c710, Section 5.4, "The contract's words": "a question into the approval question that Start raises at each guarding role other than the proposer's"; vGLP #20, Code_inbox.md, 2026-10-24 09:21 UTC: "the principal is asked the same question as the agent"): a line with one question gives it to each of those roles; a line with one for each, in their order, gives each its own (GSC, Section 2, its first paragraph).
procedure spread_questions(Ints?, PSentences?, PSentences).
spread_questions(Gr, [Q], Qs?) :- ground(Gr?), ground(Q?) | spread1(Gr?, Q?, Qs).
spread_questions(_, Qs, Qs?) :- otherwise | true.
procedure spread1(Ints?, PWords?, PSentences).
spread1([], _, []).
spread1([_|Gs], Q, [Q?|Qs?]) :- ground(Q?) | spread1(Gs?, Q?, Qs).
procedure question_places(Ints?, PSentences?, Ints?, Ints).
question_places([], _, _, []).
question_places([_|_], [], _, []).
question_places([G|Gs], [Q|Qs], Pp, Ns?) :- integer(G?), ground(Q?), ground(Pp?) |
    said_places(Q?, Pp?, N1),
    question_places(Gs?, Qs?, Pp?, N2),
    app([G?|N1?], N2?, Ns).
procedure question_terms(Ints?, PSentences?, Ints?, Strings?, Ints?, Strings).
question_terms([], _, _, _, _, []).
question_terms([_|_], [], _, _, _, []).
question_terms([G|Gs], [Q|Qs], Pp, Vw, Pr, [T?|Ts?]) :- integer(G?), ground(Q?), ground(Pp?), ground(Vw?), ground(Pr?) |
    vname(G?, F),
    name_of(F?, _, R),
    said_words(Q?, Pp?, Sw0),
    sapp(Sw0?, Vw?, Sw),
    list_text(Sw?, Sl),
    first_other(Pr?, G?, Pg),
    term_to_string(Pg?, Pt),
    mem_int(G?, Pp?, InP),
    ask_functor(InP?, Qf),
    call_text(Qf?, [R?, Pt?, Sl?], T),
    question_terms(Gs?, Qs?, Pp?, Vw?, Pr?, Ts).
%% A question put to a listed role is put to each person of its list, the class term holding the list at its place, ql(L, G, Words) (vGLP 9ee6f87, Section 5.4, "Speech-act schemas as local specifications": the guard set of a part is the people in its guarding roles, "those in a listed guarding role being those of L"; vGLP #24, Code_inbox.md, 2026-11-07 11:45 UTC, 3: "each is asked").
procedure ask_functor(YesNo?, String).
ask_functor(yes, 'q').
ask_functor(no, 'ql').
%% The first of the roles Pr other than G; 0, no proposer's atoms shown, where there is none.
procedure first_other(Ints?, Integer?, Integer).
first_other([], _, 0).
first_other([P|_], G, P?) :- integer(P?), integer(G?), P? =\= G? | true.
first_other([P|Ps], G, R?) :- integer(P?), integer(G?), P? =:= G? | first_other(Ps?, G?, R).
%% The places of the class term the pragma's fields name, the k-th field the k-th of them, in the order field_places counts them, the peer of an acquaintance schema first and then the variables of the head a person fills, but numbered as the class term's places, its roles then its head, as the question's places are (said_places).
procedure value_field_places(Args?, RoleSpecs?, Ints).
value_field_places(Hd, Rs, Fq?) :- ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    listed_ixs(Rs?, 1, Lis),
    field_places2(Vs?, 1, Lis?, Fq).
%% The places the pragma's fields name that the question does not name, each with the name of its field and the kind of its value: vp(I, F, named) of a person, vp(I, F, valued) of a number; a field left empty, as an inapplicable field of a schema that shares its button, names no place.
procedure value_places(Ints?, Strings?, Ints?, Args?, VPlaces).
value_places([], _, _, _, []).
value_places([_|_], [], _, _, []).
value_places([I|Is], [F|Fs], Ns, Vs, Vp?) :- integer(I?), ground(F?), ground(Ns?), ground(Vs?) |
    mem(I?, Ns?, In),
    nth_arg(I?, Vs?, A),
    value_kind(A?, K),
    value_place(In?, K?, field(F?), I?, Vp1),
    value_places(Is?, Fs?, Ns?, Vs?, Vp2),
    app(Vp1?, Vp2?, Vp).
procedure value_kind(Arg?, Constant).
value_kind(role(_), named).
value_kind(pvar(_), named).
value_kind(num(_), valued).
%% A variable over the constants, its value a constant or a compound value, shown(F, v(V)) (Word, const_only).
value_kind(const(_), shown).
%% A real field's value is not yet shown after the question: the word valued(S, K) is of the type Integer in every play that declares the platform's types again, and a real there needs it of the type Number in each.
value_kind(real(_), none).
value_kind(_, none) :- otherwise | true.
procedure value_place(YesNo?, Constant?, FieldAt?, Integer?, VPlaces).
value_place(yes, _, _, _, []).
value_place(no, _, nofield, _, []).
value_place(no, none, field(_), _, []).
value_place(no, named, field(F), I, Vp?) :- ground(F?) | nonempty_field(F?, named, I?, Vp).
value_place(no, valued, field(F), I, Vp?) :- ground(F?) | nonempty_field(F?, valued, I?, Vp).
value_place(no, shown, field(F), I, Vp?) :- ground(F?) | nonempty_field(F?, shown, I?, Vp).
procedure nonempty_field(String?, Constant?, Integer?, VPlaces).
nonempty_field(F, _, _, []) :- ground(F?), F? =?= '""' | true.
nonempty_field(F, K, I, [vp(I?, F?, K?)]) :- otherwise | true.
procedure vplace_ints(VPlaces?, Ints).
vplace_ints([], []).
vplace_ints([vp(I, _, _)|Vs], [I?|Is?]) :- vplace_ints(Vs?, Is).
procedure value_words(VPlaces?, Strings).
value_words([], []).
value_words([vp(I, F, shown)|Vs], [W?|Ws?]) :- integer(I?), ground(F?) |
    vname(I?, N),
    name_of(N?, _, Q),
    call_text(v, [Q?], Vq),
    named_call(shown, [F?, Vq?], W),
    value_words(Vs?, Ws).
value_words([vp(I, F, K)|Vs], [W?|Ws?]) :- otherwise, integer(I?), ground(F?), ground(K?) |
    vname(I?, N),
    name_of(N?, _, Q),
    named_call(K?, [F?, Q?], W),
    value_words(Vs?, Ws).
procedure schema_sentence2(Ints?, Args?, Constant?, Strings?, String, Lines).
schema_sentence2(Ns, Vs, S, Qt, T?, L?) :- ground(Ns?), ground(Vs?), ground(S?), ground(Qt?) |
    head_names(Vs?, 1, Ns?, Hn),
    named_call(S?, Hn?, Cl),
    call_text(sentence_of, [Cl?, 'Me', 'Ws?'], T),
    guard_lines(Ns?, Lg),
    list_text(Qt?, Ql),
    call_text(ask_of, [Ql?, 'Me?', 'Ws'], B),
    lapp(Lg?, ['ground(Me?)', '|', B?, '.'], L).
%% The places of the class term a sentence names, in its order.
procedure said_places(PWords?, Ints?, Ints).
said_places([], _, []).
said_places([text(_)|Ws], Pp, Ns?) :- said_places(Ws?, Pp?, Ns).
said_places([person(K)|Ws], Pp, [I?|Ns?]) :- ground(Pp?) | nth_int(K?, Pp?, I), said_places(Ws?, Pp?, Ns).
procedure nth_int(Integer?, Ints?, Integer).
nth_int(1, [I|_], I?).
nth_int(K, [_|Is], I?) :- K? > 1 | K1 := K? - 1, nth_int(K1?, Is?, I).
nth_int(_, [], 0).
%% The class term's arguments: V_i at a place i the sentence names, _ elsewhere.
procedure head_names(Args?, Integer?, Ints?, Strings).
head_names([], _, _, []).
head_names([_|Vs], I, Ns, [X?|Xs?]) :- integer(I?), ground(Ns?) |
    mem(I?, Ns?, In),
    vname(I?, F),
    head_name(In?, F?, X),
    I1 := I? + 1,
    head_names(Vs?, I1?, Ns?, Xs).
procedure head_name(YesNo?, Found?, String).
head_name(yes, named(N, _), N?).
head_name(yes, unnamed, unnamed).
head_name(no, _, '_').
procedure guard_lines(Ints?, Lines).
guard_lines([], []).
guard_lines([I|Is], [G?, ','|L?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, _, Q),
    call_text(ground, [Q?], G),
    guard_lines(Is?, L).
procedure place_reads(Ints?, Strings).
place_reads([], []).
place_reads([I|Is], [Q?|Qs?]) :- integer(I?) |
    vname(I?, F),
    name_of(F?, _, Q),
    place_reads(Is?, Qs).
procedure said_words(PWords?, Ints?, Strings).
said_words([], _, []).
said_words([text(S)|Ws], Pp, [X?|Xs?]) :- call_text(text, [S?], X), said_words(Ws?, Pp?, Xs).
said_words([person(K)|Ws], Pp, [X?|Xs?]) :- ground(Pp?) |
    nth_int(K?, Pp?, I),
    vname(I?, F),
    name_of(F?, _, Q),
    call_text(person, [Q?], X),
    said_words(Ws?, Pp?, Xs).

%% --- Acquaintance --------------------------------------------------------------
%% The acquaintance schemas, whose parts are the acquaintance parts of the compilation (vGLP, Section 5.4, "The compilation": "The compilation is given, with the specification, its acquaintance parts: guarded parts with two guards and no opener by which two agents come to know each other, for a contract the parts of an acquaintance schema, one with two roles, both guarding, that requires at neither role an atom naming the other, as GKK's meet"): a schema of two party roles, each guarding, whose atoms required or deleted at each role name neither the other role nor a name term built on it.  meeting_peer(N, Me, P), printed where the request type proposes a schema: P the peer a request name N of an acquaintance part names beside the agent Me, peer(Q), the person in its other role, where Me is in one of its two roles and another person in the other; nopeer otherwise, and for every other request name.
procedure meeting_lines(Contract?, Preds?, Preds?, PStands?, Lines).
meeting_lines(_, [], _, _, []).
meeting_lines(C, [P|Ps], Fd, Ss, L?) :- ground(C?), ground(P?), ground(Ps?), ground(Fd?), ground(Ss?) |
    stand_meet_lines(C?, [P?|Ps?], Fd?, Ss?, Lsm),
    meeting_clauses(C?, [P?|Ps?], Fd?, Lc0),
    lapp(Lc0?, [], Lc),
    lapp(Lc?, ['meeting_peer(_, _, nopeer) :- otherwise | true.'], Lc1),
    lapp(Lsm?, ['',
        '%% The peer a request name N of an acquaintance part names beside the agent Me, peer(Q), or none, nopeer: the acquaintance schemas, each of two roles, both guarding, that requires at neither role an atom naming the other (vGLP, Section 5.4, "The compilation").',
        'procedure meeting_peer(Proposal?, Peer?, MeetPeer).'|Lc1?], L).
procedure meeting_clauses(Contract?, Preds?, Preds?, Lines).
meeting_clauses([], _, _, []).
meeting_clauses([schema(S, Hd, Rs)|Ss], Ps, Fd, L?) :- ground(S?), ground(Hd?), ground(Rs?), ground(Ps?), ground(Fd?) |
    mem(S?, Ps?, In),
    meeting_schema_f(Rs?, Fd?, M),
    and(In?, M?, B),
    meeting_clause(B?, S?, Hd?, Rs?, L1),
    meeting_clauses(Ss?, Ps?, Fd?, L2),
    lapp(L1?, L2?, L).
meeting_clauses([cschema(_, _, _, _)|Ss], Ps, Fd, L?) :- meeting_clauses(Ss?, Ps?, Fd?, L).
meeting_clauses([nschema(_, _, _, _)|Ss], Ps, Fd, L?) :- meeting_clauses(Ss?, Ps?, Fd?, L).
%% A standing acquaintance act (vGLP, Section 5.4: "Under a standing request of an acquaintance act, the machine sends the hello to each person it is about to propose the act with, and answers a hello that arrives by its standing request, without asking its person"): for each standing schema that is an acquaintance schema, stand_meet_name(S, A, B, N), N its request name with A and B in its two roles, and meet_standing(N, S); printed where the phone finds a fact, the person met being one the phone finds.
procedure stand_meet_lines(Contract?, Preds?, Preds?, PStands?, Lines).
stand_meet_lines(_, _, [], _, []).
stand_meet_lines(C, Ps, [F|Fs], Ss, L?) :- ground(C?), ground(Ps?), ground(F?), ground(Fs?), ground(Ss?) |
    stand_meets(Ss?, C?, Ps?, [F?|Fs?], Sm),
    stand_meet_text(Sm?, L).
procedure stand_meets(PStands?, Contract?, Preds?, Preds?, Preds).
stand_meets([], _, _, _, []).
stand_meets([standing(S, _, _)|Ss], C, Ps, Fd, R?) :- ground(S?), ground(C?), ground(Ps?), ground(Fd?) |
    find_schema(S?, C?, Fs),
    stand_meet1(Fs?, Fd?, M0),
    mem(S?, Ps?, In),
    and(In?, M0?, M),
    stand_meets(Ss?, C?, Ps?, Fd?, R1),
    keep_name(M?, S?, R1?, R).
procedure stand_meet1(SFound?, Preds?, YesNo).
stand_meet1(sfound(_, Rs), Fd, M?) :- meeting_schema_f(Rs?, Fd?, M).
stand_meet1(nosfound, _, no).
procedure keep_name(YesNo?, Constant?, Preds?, Preds).
keep_name(yes, S, R, [S?|R?]).
keep_name(no, _, R, R?).
procedure stand_meet_text(Preds?, Lines).
stand_meet_text(Sm, ['', 'procedure stand_meets(Preds).', L0?, 'procedure stand_meet_name(Constant?, Peer?, Peer?, MeetName).'|L1?]) :- ground(Sm?) |
    term_to_string(Sm?, T0),
    string_concat(['stand_meets(', T0?, ').'], L0),
    stand_meet_names(Sm?, Ln),
    lapp(Ln?, ['stand_meet_name(_, _, _, nomeetname) :- otherwise | true.', 'procedure meet_standing(Proposal?, StandOf).'|Lm?], L1),
    meet_standings(Sm?, Lm0),
    lapp(Lm0?, ['meet_standing(_, notstanding) :- otherwise | true.'], Lm).
procedure stand_meet_names(Preds?, Lines).
stand_meet_names([], []).
stand_meet_names([S|Ss], [L?|Ls?]) :- ground(S?) |
    term_to_string(S?, T),
    string_concat(['stand_meet_name(', T?, ', A, B, meetname(', T?, '(A?, B?))).'], L),
    stand_meet_names(Ss?, Ls).
procedure meet_standings(Preds?, Lines).
meet_standings([], []).
meet_standings([S|Ss], [L?|Ls?]) :- ground(S?) |
    term_to_string(S?, T),
    string_concat(['meet_standing(', T?, '(_, _), standing_of(', T?, ')).'], L),
    meet_standings(Ss?, Ls).
%% Whether a schema is an acquaintance schema, an atom the phone finds left out of what each role requires (vGLP, Section 5.4: "requires at neither role an atom naming the other, but for an atom the phone finds").
procedure meeting_schema_f(RoleSpecs?, Preds?, YesNo).
meeting_schema_f([rs(G1, A1, D1, K1, F1), rs(G2, A2, D2, K2, F2)], Fd, B?) :- ground(K1?), ground(K2?), ground(Fd?) |
    drop_found(K1?, Fd?, K1f),
    drop_found(K2?, Fd?, K2f),
    meeting_schema([rs(G1?, A1?, D1?, K1f?, F1?), rs(G2?, A2?, D2?, K2f?, F2?)], B).
meeting_schema_f(_, _, no) :- otherwise | true.
procedure drop_found(Atoms?, Preds?, Atoms).
drop_found([], _, []).
drop_found([atom(P, As)|Xs], Fd, R?) :- ground(P?), ground(As?), ground(Fd?) |
    mem(P?, Fd?, In),
    drop_found(Xs?, Fd?, R1),
    keep_atom(In?, atom(P?, As?), R1?, R).
drop_found([X|Xs], Fd, [X?|R?]) :- otherwise | drop_found(Xs?, Fd?, R).
procedure keep_atom(YesNo?, Atom?, Atoms?, Atoms).
keep_atom(yes, _, R, R?).
keep_atom(no, A, R, [A?|R?]).
%% Whether a schema is an acquaintance schema: two party roles, both guarding, and the atoms each requires or deletes naming not the other.
procedure meeting_schema(RoleSpecs?, YesNo).
meeting_schema([rs(G1, _, D1, K1, _), rs(G2, _, D2, K2, _)], B?) :-
    ground(G1?), ground(D1?), ground(K1?), ground(G2?), ground(D2?), ground(K2?) |
    guarding(G1?, B1),
    guarding(G2?, B2),
    uncleared(D1?, U1),
    uncleared(D2?, U2),
    app(K1?, U1?, R1),
    app(K2?, U2?, R2),
    names_role(R1?, 2, N1),
    names_role(R2?, 1, N2),
    or(N1?, N2?, N),
    neg(N?, B3),
    and(B1?, B2?, B12),
    and(B12?, B3?, B).
meeting_schema(_, no) :- otherwise | true.
procedure guarding(Guard?, YesNo).
guarding(guarded, yes).
guarding(guarded_at(_), yes).
guarding(unguarded, no).
%% Whether an atom of the list names the role J: an argument role(J), a name term built on it, or a speech act signed by its person.
procedure names_role(Atoms?, Integer?, YesNo).
names_role(As, J, B?) :- ground(As?) |
    atoms_args(As?, Xs),
    args_name(Xs?, J?, B).
procedure args_name(Args?, Integer?, YesNo).
args_name([], _, no).
args_name([X|Xs], J, B?) :- ground(X?), integer(J?) |
    arg_names(X?, J?, B1),
    args_name1(B1?, Xs?, J?, B).
procedure args_name1(YesNo?, Args?, Integer?, YesNo).
args_name1(yes, _, _, yes).
args_name1(no, Xs, J, B?) :- args_name(Xs?, J?, B).
procedure arg_names(Arg?, Integer?, YesNo).
arg_names(role(I), J, yes) :- I? =:= J? | true.
arg_names(nterm(T), J, B?) :- nt_names(T?, J?, B).
arg_names(sgn(_, I), J, yes) :- I? =:= J? | true.
arg_names(_, _, no) :- otherwise | true.
procedure nt_names(NameTerm?, Integer?, YesNo).
nt_names(own(I), J, yes) :- I? =:= J? | true.
nt_names(ext(T, _), J, B?) :- nt_names(T?, J?, B).
nt_names(ext_any(T), J, B?) :- nt_names(T?, J?, B).
nt_names(_, _, no) :- otherwise | true.
%% meeting_peer(S(V1, V2, _, ...), Me, P?) :- ground(V1?), ground(V2?), ground(Me?) | meet_other(V1?, V2?, Me?, P): the two roles at the first two places of the request name, its head beginning with its roles.
procedure meeting_clause(YesNo?, Constant?, Args?, RoleSpecs?, Lines).
meeting_clause(no, _, _, _, []).
meeting_clause(yes, S, Hd, Rs, [T?, ':-', 'ground(V1?)', ',', 'ground(V2?)', ',', 'ground(Me?)', '|', 'meet_other(V1?, V2?, Me?, P)', '.']) :-
    ground(S?), ground(Hd?), ground(Rs?) |
    schema_vars(Rs?, Hd?, Vs),
    head_names(Vs?, 1, [1, 2], Hn),
    named_call(S?, Hn?, Cl),
    call_text(meeting_peer, [Cl?, 'Me', 'P?'], T).

%% Lines are strings, each printed on a line of its own.
procedure lapp(Lines?, Lines?, Lines).
lapp([], Ys, Ys?).
lapp([X|Xs], Ys, [X?|Zs?]) :- lapp(Xs?, Ys?, Zs).
procedure sapp(Strings?, Strings?, Strings).
sapp([], Ys, Ys?).
sapp([X|Xs], Ys, [X?|Zs?]) :- sapp(Xs?, Ys?, Zs).
