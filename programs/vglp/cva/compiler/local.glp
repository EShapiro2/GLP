%% local.glp --- whether a contract of act schemas is a local and effective specification (vGLP 099f876, Section 5.4, the paragraph "Act schemas as local specifications"; Section 3.2, Definition "Local Specification, Part, Guard Set, Opener"), and, where it is not, the lines saying why; and the schemas whose terms name guarded parts, which the request type proposes.
%%
%% Local: each schema-binding "determines a part [t]_j of its class: the set of transactions it determines, ... and with the people in its marked roles as its guard set.  Such a contract is a local specification" (ibid.).  So a contract whose roles are party roles and listed roles is a local specification with no condition on its guards (vGLP #15, Code_inbox.md, 2026-10-19 10:50 UTC, item 2; vGLP f5f1644, the same paragraph: "each schema-binding determines a part [t]_j of a class for each list L of the people of its listed roles"), and nothing here decides locality; cvac.glp refuses a contract with seated or constituent roles, reach conditions or name variables.  A schema with listed roles is effective where they have one base, which is its only guarding role or, not a guarding role, its first role (listed_lines).  A schema with a listed role whose base is not a guarding role determines guarded parts that the person in its base opens, and "the contract is a local specification where every other guarded part of the class that a guard of such a part guards is determined likewise, with the same opener" (vGLP a890465, ibid.): nothing here decides that condition, a gap reported to Code #11 on 2026-10-19.
%%
%% Effective: "The contract is effective (Definition "Effective Local Specification") where, moreover, every variable of a schema that occurs in an atom it requires or forbids also occurs in an atom it deletes or adds, a variable inside a signed term or a name term included, so that a class has finitely many parts, and the atoms each unguarded schema requires at its first role name every other role and every variable of its deleted and added atoms" (ibid.).  A variable here is a party variable or a speech-act variable, the sentence naming roles and variables apart, "every other role and every variable", and a role being bound to one of the finitely many participants (vGLP #15, ibid., answer (2)); a signed term sgn(y, i) in a deleted or added atom holds the variable y and names role i (GSC, Section 3: "An atom names what is among its arguments or is the signer of one"), so y is a variable of the atom.  Otherwise the contract is refused, the schema named.
%%
%% The request type has "the alternative propose([t]_j) for each guarded part [t]_j" (vGLP 099f876, Section 5.4, "The compilation"), so cvac.glp prints in it the alternatives of the schemas whose terms name guarded parts (proposable): a schema marking a role, some binding of which determines a transaction, a part whose guard set is the people in its marked roles, never empty.  A schema marking no role names unguarded parts only; one marking a role names guarded parts, as gnudge's g, whose part is guarded though its class holds the unguarded part of nudge (vGLP #15, ibid., item 4).
%%
%% The schemas name no person (GSC, Proposition "Anonymity"), so the bindings of a schema are taken up to renaming: its roles and party variables sent to people person(0), person(1), ... in the order of its head, every partition of them a binding; its speech-act variables to speech acts sp(U, S), S the signer, one of those people or one person more, whom no other variable names, and U an utterance, utt(N), in the order of its head --- "a speech act being an utterance or a speech act, signed; a signed term sgn(y, i) in an added atom is the speech act bound to y, signed by the person in role i" (vGLP 099f876, Section 5.4, "Act schemas as local specifications"; GSC 63b301f, Section 3, Definitions "Act schema" and "Binding", beta(sgn(y, pi)) := (beta(y), beta(pi))), so the image of sgn(y, i) under a binding is sp(beta(y), beta(i)), a speech act whose utterance is a speech act.  Such a binding determines a transaction where it is one (GSC, Definition "Binding"), its added and deleted atoms are disjoint at each participant (GSC, Definition "Compilation"), and at each participant no atom is both required and forbidden and no atom of a reflexive predicate naming the participant is forbidden: a state is a multiset; two roles bound to one person act together there; and a predicate of arity one the contract declares reflexive holds at every person of that person, so an atom of it naming the participant is no requirement there, and one forbidden there leaves the schema-binding determining no transaction (vGLP, Section 5.4, the paragraph on act schemas).

%% A speech act sp(U, S): its utterance U, utt(N) or a speech act, and its
%% signer S (GSC, Section 3: "A speech act is an utterance or a speech act,
%% signed by a person").
Utt      ::= utt(Integer) ; Sp.
Sp       ::= sp(Utt, Integer).
%% The community name a name term denotes, cn(V) of the person V, and cdot(N, S), the community name N followed by the speech act S (vGLP c649c0d, Section 5.4, "Act schemas as local specifications").
Val      ::= person(Integer) ; Sp ; free_var(Arg) ; cn(Val) ; cdot(Val, Val).
Vals     ::= [] ; [Val | Vals].
Bnd      ::= bnd(Arg, Val).
Binding  ::= [] ; [Bnd | Binding].
Bindings ::= [] ; [Binding | Bindings].
GA       ::= ga(Constant, Vals).
GAs      ::= [] ; [GA | GAs].
%% A participant and the atoms its roles delete and add, joined.
Delta    ::= delta(Integer, GAs, GAs).
Deltas   ::= [] ; [Delta | Deltas].
Found    ::= found(Val) ; unbound.

exported procedure faults(Contract?, Preds?, Stream(_)).
faults(C, _, Ls?) :- ground(C?) | effective_lines(C?, Ls).

%% The value of a variable in a binding; a variable the binding leaves free
%% is its own value, free_var(V), one fresh person or speech act per variable.
procedure val_or_free(Found?, Arg?, Val).
val_or_free(found(X), _, X?).
val_or_free(unbound, V, free_var(V?)).

%% --- Effective -------------------------------------------------------------
%% Each schema: every variable of an atom it requires or forbids a variable of
%% an atom it deletes or adds (free_lines); and, where it marks no role, the
%% atoms its first role requires naming every other role and every variable of
%% its deleted and added atoms (effective_one).
procedure effective_lines(Contract?, Stream(_)).
effective_lines([], []).
effective_lines([schema(Nm, _, Rs)|Ss], L?) :- ground(Nm?), ground(Rs?) |
    free_lines(Nm?, Rs?, L0),
    guarded_any(Rs?, G),
    effective_one(G?, Nm?, Rs?, L1),
    listed_lines(Nm?, Rs?, L3),
    effective_lines(Ss?, L2),
    lapp(L1?, L2?, L12),
    lapp(L3?, L12?, L312),
    lapp(L0?, L312?, L).
effective_lines([cschema(_, _, _, _)|Ss], L?) :- effective_lines(Ss?, L).
procedure guarded_any(RoleSpecs?, YesNo).
guarded_any([], no).
guarded_any([R|Rs], B?) :- rs_guarded(R?, B1), guarded_any1(B1?, Rs?, B).
procedure guarded_any1(YesNo?, RoleSpecs?, YesNo).
guarded_any1(yes, _, yes).
guarded_any1(no, Rs, B?) :- guarded_any(Rs?, B).

%% A variable of an atom the schema requires or forbids, at any role, that no
%% atom it deletes or adds holds, a signed term's variable included.
procedure free_lines(Constant?, RoleSpecs?, Stream(_)).
free_lines(Nm, Rs, L?) :- ground(Nm?), ground(Rs?) |
    kept_forbidden_args(Rs?, Kf0),
    flat_args(Kf0?, Kf1),
    variables_of(Kf1?, Kf),
    changed_args(Rs?, Ch0),
    flat_args(Ch0?, Ch),
    first_absent(Kf?, Ch?, F),
    free_lines1(F?, Nm?, L).
procedure free_lines1(Args?, Constant?, Stream(_)).
free_lines1([], _, []).
free_lines1([V|_], Nm, ['%% it is not effective (vGLP, Section 5.4, the paragraph on act schemas): a variable of',
        '%% the schema occurs in an atom it requires or forbids and in no atom it deletes or adds:',
        T?]) :-
    ground(Nm?), ground(V?) | T =.. ['%% the schema and the variable', Nm?, V?].
%% The arguments of the atoms a schema requires or forbids, the listing atoms rho(q, u_2, ..., u_r) the base person of a listed role requires among them (vGLP f5f1644, Section 5.4, the paragraph on act schemas: "for p the person in the base of a listed role, p lists in d_p exactly the people of that role in L").
procedure kept_forbidden_args(RoleSpecs?, Args).
kept_forbidden_args([], []).
kept_forbidden_args([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, _, _, K, N),
    atoms_args(K?, A1),
    atoms_args(N?, A2),
    kind_args(R?, A0),
    kept_forbidden_args(Rs?, A3),
    app(A2?, A3?, A23),
    app(A0?, A23?, A03),
    app(A1?, A03?, As).
%% The party and speech-act variables among the arguments.
procedure variables_of(Args?, Args).
variables_of([], []).
variables_of([pvar(X)|As], [pvar(X?)|R?]) :- variables_of(As?, R).
variables_of([svar(X)|As], [svar(X?)|R?]) :- variables_of(As?, R).
variables_of([role(_)|As], R?) :- variables_of(As?, R).
variables_of([nterm(_)|As], R?) :- variables_of(As?, R).
variables_of([sgn(_, _)|As], R?) :- variables_of(As?, R).
%% The arguments with each signed term sgn(y, i) taken as its variable y and
%% its role i, which it names.
procedure flat_args(Args?, Args).
flat_args([], []).
flat_args([sgn(Y, I)|As], [svar(Y?), role(I?)|R?]) :- flat_args(As?, R).
flat_args([nterm(N)|As], R?) :- nt_flat(N?, Ws), flat_args(As?, R1), app(Ws?, R1?, R).
flat_args([A|As], [A?|R?]) :- otherwise | flat_args(As?, R).
%% The variables of a name term, its base, a role or an agent variable, and its speech-act variables: "a variable inside a signed term or a name term included" (vGLP c649c0d, Section 5.4, the paragraph on act schemas), and its base named by it.
procedure nt_flat(NameTerm?, Args).
nt_flat(own(I), [role(I?)]).
nt_flat(own_var(X), [pvar(X?)]).
nt_flat(nvar(_), []).
nt_flat(ext(N, Y), R?) :- nt_flat(N?, R1), app(R1?, [svar(Y?)], R).
%% The first argument of the first list absent from the second; none, [].
procedure first_absent(Args?, Args?, Args).
first_absent([], _, []).
first_absent([A|As], Ch, F?) :- ground(A?), ground(Ch?) |
    mem(A?, Ch?, In),
    first_absent1(In?, A?, As?, Ch?, F).
procedure first_absent1(YesNo?, Arg?, Args?, Args?, Args).
first_absent1(no, A, _, _, [A?]).
first_absent1(yes, _, As, Ch, F?) :- first_absent(As?, Ch?, F).

procedure effective_one(YesNo?, Constant?, RoleSpecs?, Stream(_)).
effective_one(yes, _, _, []).
effective_one(no, Nm, Rs, L?) :- ground(Rs?), ground(Nm?) |
    first_required_args(Rs?, Fa1),
    first_listing_args(Rs?, Fl),
    app(Fa1?, Fl?, Fa0),
    flat_args(Fa0?, Fa),
    rs_count(Rs?, K),
    role_args(2, K?, Others0),
    listed_ixs(Rs?, 1, Lis),
    drop_role_at(Others0?, Lis?, Others),
    changed_args(Rs?, Ch0),
    flat_args(Ch0?, Ch),
    drop_role_one(Ch?, Ch1),
    app(Others?, Ch1?, Need),
    all_member(Need?, Fa?, Ok),
    effective_one1(Ok?, Nm?, L).
procedure effective_one1(YesNo?, Constant?, Stream(_)).
effective_one1(yes, _, []).
effective_one1(no, Nm, ['%% it is not effective (vGLP, Section 5.4, the paragraph on act schemas): an unguarded',
        '%% schema whose first role requires no atom naming some other role, or some variable of',
        '%% an atom it deletes or adds:', T?]) :-
    ground(Nm?) | T =.. ['%% the schema', Nm?].
%% The arguments of the listing atoms the first role requires where it is the base of listed roles; the people of a listed role are those its base person lists, so its own place is no other role its first role must name (vGLP c649c0d, Section 5.4, the paragraph on act schemas: "the listed roles of a schema have one base, which is its only guarding role or, if it is not a guarding role, its first role, so that the agent that proposes a part the schema determines, its guard or its opener, reads the people of those roles from its own state").
procedure first_listing_args(RoleSpecs?, Args).
first_listing_args(Rs, As?) :- ground(Rs?) |
    listed_all(Rs?, 1, Ls),
    first_listing1(Ls?, As).
procedure first_listing1(Listings?, Args).
first_listing1([], []).
first_listing1([listing(_, B, _, As0)|Ls], As?) :- integer(B?) |
    first_listing1(Ls?, As1),
    first_listing2(B?, As0?, As1?, As).
procedure first_listing2(Integer?, Args?, Args?, Args).
first_listing2(B, As0, As1, As?) :- B? =:= 1 | app(As0?, As1?, As).
first_listing2(_, _, As1, As1?) :- otherwise | true.
procedure drop_role_at(Args?, Ints?, Args).
drop_role_at([], _, []).
drop_role_at([role(J)|As], Lis, R?) :- integer(J?), ground(Lis?) |
    mem(J?, Lis?, In),
    drop_role_at(As?, Lis?, R1),
    keep_role(In?, J?, R1?, R).
drop_role_at([A|As], Lis, [A?|R?]) :- otherwise | drop_role_at(As?, Lis?, R).
procedure keep_role(YesNo?, Integer?, Args?, Args).
keep_role(yes, _, R, R?).
keep_role(no, J, R, [role(J?)|R?]).

%% "the listed roles of a schema have one base, which is its only guarding role or, if it is not a guarding role, its first role, so that the agent that proposes a part the schema determines, its guard or its opener, reads the people of those roles from its own state" (vGLP a890465, Section 5.4, the paragraph on act schemas; vGLP #16 Cowork to Code, 2026-10-19 15:51 UTC: "refuse as not effective a schema whose listed roles have different bases", and 15:57 UTC, item 1): the listed roles of a schema have one base, and the compiler takes it where it is the schema's only guarding role, or where it is not a guarding role and is the schema's first role, whatever its guarding roles, as CSSN's child_close(r, p?, r[listed(*, n)] ; n), whose base r opens the part p guards; otherwise the contract is not effective, the schema named.
procedure listed_lines(Constant?, RoleSpecs?, Stream(_)).
listed_lines(Nm, Rs, L?) :- ground(Nm?), ground(Rs?) |
    listed_bases(Rs?, Bs0),
    dedup(Bs0?, Bs),
    guard_indices(Rs?, 1, Gs),
    listed_lines1(Bs?, Gs?, Nm?, L).
procedure listed_lines1(Ints?, Ints?, Constant?, Stream(_)).
listed_lines1([], _, _, []).
listed_lines1([B], Gs, Nm, L?) :- listed_ok(B?, Gs?, Ok), listed_lines2(Ok?, Nm?, L).
listed_lines1([_, _|_], _, Nm, ['%% it is not effective (vGLP, Section 5.4, the paragraph on act schemas): a schema whose',
        '%% listed roles have different bases:', T?]) :-
    ground(Nm?) | T =.. ['%% the schema', Nm?].
procedure guard_indices(RoleSpecs?, Integer?, Ints).
guard_indices([], _, []).
guard_indices([R|Rs], I, Gs?) :- ground(R?), integer(I?) |
    rs_guarded(R?, G),
    I1 := I? + 1,
    guard_indices(Rs?, I1?, Gs1),
    keep_index(G?, I?, Gs1?, Gs).
procedure keep_index(YesNo?, Integer?, Ints?, Ints).
keep_index(yes, I, Gs, [I?|Gs?]).
keep_index(no, _, Gs, Gs?).
%% listed_ok(B, Gs, Ok): the base B, of the guarding roles Gs, is the schema's only guarding role, or is not a guarding role and is its first role.
procedure listed_ok(Integer?, Ints?, YesNo).
listed_ok(B, Gs, R?) :- integer(B?), ground(Gs?) |
    mem(B?, Gs?, In),
    listed_ok1(In?, B?, Gs?, R).
procedure listed_ok1(YesNo?, Integer?, Ints?, YesNo).
listed_ok1(yes, _, [_], yes).
listed_ok1(yes, _, [_, _|_], no).
listed_ok1(yes, _, [], no).
listed_ok1(no, B, _, R?) :- int_is(B?, 1, R).
procedure int_is(Integer?, Integer?, YesNo).
int_is(A, B, yes) :- A? =:= B? | true.
int_is(_, _, no) :- otherwise | true.
procedure listed_lines2(YesNo?, Constant?, Stream(_)).
listed_lines2(yes, _, []).
listed_lines2(no, Nm, ['%% it is not effective (vGLP, Section 5.4, the paragraph on act schemas): a schema with a',
        '%% listed role whose base is neither its only guarding role nor, not a guarding role, its first role:', T?]) :-
    ground(Nm?) | T =.. ['%% the schema', Nm?].

procedure first_required_args(RoleSpecs?, Args).
first_required_args([], []).
first_required_args([R|_], As?) :- ground(R?) |
    rs_lists(R?, _, M, K, _),
    atoms_args(K?, A1),
    atoms_args(M?, A2),
    app(A1?, A2?, As).
procedure changed_args(RoleSpecs?, Args).
changed_args([], []).
changed_args([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M, _, _),
    atoms_args(P?, A1),
    atoms_args(M?, A2),
    changed_args(Rs?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, As).
procedure drop_role_one(Args?, Args).
drop_role_one([], []).
drop_role_one([role(I)|As], R?) :- I? =:= 1 | drop_role_one(As?, R).
drop_role_one([A|As], [A?|R?]) :- otherwise | drop_role_one(As?, R).
procedure all_member(Args?, Args?, YesNo).
all_member([], _, yes).
all_member([A|As], Fa, B?) :- ground(Fa?) | mem(A?, Fa?, B1), all_member1(B1?, As?, Fa?, B).
procedure all_member1(YesNo?, Args?, Args?, YesNo).
all_member1(no, _, _, no).
all_member1(yes, As, Fa, B?) :- all_member(As?, Fa?, B).

%% --- The request type -------------------------------------------------------
%% The schemas whose terms name guarded parts (the header): a schema marking a role, some binding of which, up to renaming, determines a transaction.
exported procedure proposable(Contract?, Preds?, Preds).
proposable(C, Rf, Ns?) :- ground(Rf?) | proposable1(C?, Rf?, Ns).
procedure proposable1(Contract?, Preds?, Preds).
proposable1([], _, []).
proposable1([schema(Nm, Hd, Rs)|Ss], Rf, Ns?) :- ground(Nm?), ground(Hd?), ground(Rs?), ground(Rf?) |
    guarded_any(Rs?, G),
    proposable_schema(G?, Rs?, Hd?, Rf?, P),
    proposable1(Ss?, Rf?, Ns1),
    keep_name(P?, Nm?, Ns1?, Ns).
proposable1([cschema(_, _, _, _)|Ss], Rf, Ns?) :- proposable1(Ss?, Rf?, Ns).
procedure proposable_schema(YesNo?, RoleSpecs?, Args?, Preds?, YesNo).
proposable_schema(no, _, _, _, no).
proposable_schema(yes, Rs, Hd, Rf, P?) :- ground(Rs?), ground(Hd?) |
    canon_bindings(Rs?, Hd?, Bs),
    some_live(Bs?, Rs?, Rf?, P).
procedure some_live(Bindings?, RoleSpecs?, Preds?, YesNo).
some_live([], _, _, no).
some_live([B|Bs], Rs, Rf, P?) :- ground(B?), ground(Rs?), ground(Rf?) |
    sig_of(Rs?, B?, Pt),
    determines(Pt?, B?, Rs?, Rf?, D),
    some_live1(D?, Bs?, Rs?, Rf?, P).
procedure some_live1(YesNo?, Bindings?, RoleSpecs?, Preds?, YesNo).
some_live1(yes, _, _, _, yes).
some_live1(no, Bs, Rs, Rf, P?) :- some_live(Bs?, Rs?, Rf?, P).
%% A schema-binding of the participants and atoms Pt determines a transaction: its deleted and added atoms disjoint at each participant, and at each no atom both required and forbidden and no atom of a reflexive predicate naming the participant forbidden (live_at).
procedure determines(Deltas?, Binding?, RoleSpecs?, Preds?, YesNo).
determines(Pt, B, Rs, Rf, D?) :- ground(Pt?) |
    deltas_valid(Pt?, V1),
    deltas_people(Pt?, Q),
    live_at(Q?, Rs?, B?, Rf?, V2),
    and(V1?, V2?, D).
procedure keep_name(YesNo?, Constant?, Preds?, Preds).
keep_name(yes, Nm, Ns, [Nm?|Ns?]).
keep_name(no, _, Ns, Ns?).

%% live_at(Q, Rs, B, Rf, Ok): at each participant of Q, no atom both required and forbidden, and no atom of a reflexive predicate naming the participant forbidden.
procedure live_at(Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at([], _, _, _, yes).
live_at([P|Ps], Rs, B, Rf, Ok?) :- ground(Rs?), ground(B?), ground(Rf?), integer(P?) |
    reqs_at(Rs?, B?, P?, Rf?, R),
    forbs_at(Rs?, B?, P?, F),
    live_one(R?, F?, P?, Rf?, Ok1),
    live_at1(Ok1?, Ps?, Rs?, B?, Rf?, Ok).
procedure live_one(GAs?, GAs?, Integer?, Preds?, YesNo).
live_one(R, F, P, Rf, Ok?) :- ground(F?) |
    meets(R?, F?, M1),
    own_reflexive_in(F?, P?, Rf?, M2),
    or(M1?, M2?, M),
    neg(M?, Ok).
procedure live_at1(YesNo?, Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at1(no, _, _, _, _, no).
live_at1(yes, Ps, Rs, B, Rf, Ok?) :- live_at(Ps?, Rs?, B?, Rf?, Ok).
procedure keep_ga(YesNo?, GA?, GAs?, GAs).
keep_ga(no, A, R, [A?|R?]).
keep_ga(yes, _, R, R?).
procedure own_reflexive_in(GAs?, Integer?, Preds?, YesNo).
own_reflexive_in([], _, _, no).
own_reflexive_in([ga(N, [person(Q)])|As], P, Rf, B?) :- ground(Rf?), integer(P?), Q? =:= P? |
    mem(N?, Rf?, B1),
    own_reflexive_in1(B1?, As?, P?, Rf?, B).
own_reflexive_in([_|As], P, Rf, B?) :- otherwise | own_reflexive_in(As?, P?, Rf?, B).
procedure own_reflexive_in1(YesNo?, GAs?, Integer?, Preds?, YesNo).
own_reflexive_in1(yes, _, _, _, yes).
own_reflexive_in1(no, As, P, Rf, B?) :- own_reflexive_in(As?, P?, Rf?, B).

%% The atoms required (=(i) and -(i)) at the roles sent to P, joined, less
%% those of a reflexive predicate naming P, which hold at every person of that
%% person (vGLP, Section 5.4, the paragraph on act schemas); and those
%% forbidden there.
procedure reqs_at(RoleSpecs?, Binding?, Integer?, Preds?, GAs).
reqs_at(Rs, B, P, Rf, R?) :- ground(B?), integer(P?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    reqs_join(RsP?, B?, [], R0),
    drop_own_reflexive(R0?, P?, Rf?, R).
procedure drop_own_reflexive(GAs?, Integer?, Preds?, GAs).
drop_own_reflexive([], _, _, []).
drop_own_reflexive([ga(N, [person(Q)])|As], P, Rf, R?) :-
    ground(Rf?), integer(P?), integer(Q?), Q? =:= P? |
    mem(N?, Rf?, Own),
    drop_own_reflexive(As?, P?, Rf?, R1),
    keep_ga(Own?, ga(N?, [person(Q?)]), R1?, R).
drop_own_reflexive([A|As], P, Rf, [A?|R?]) :- otherwise | drop_own_reflexive(As?, P?, Rf?, R).
procedure reqs_join(RoleSpecs?, Binding?, GAs?, GAs).
reqs_join([], _, Acc, Acc?).
reqs_join([R|Rs], B, Acc, Out?) :- ground(R?), ground(B?) |
    rs_lists(R?, _, M, K, _),
    img_atoms(K?, B?, G1),
    img_atoms(M?, B?, G2),
    app(G1?, G2?, G),
    ms_join(Acc?, G?, Acc1),
    reqs_join(Rs?, B?, Acc1?, Out).
procedure forbs_at(RoleSpecs?, Binding?, Integer?, GAs).
forbs_at(Rs, B, P, F?) :- ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    forbs_cat(RsP?, B?, F).
procedure forbs_cat(RoleSpecs?, Binding?, GAs).
forbs_cat([], _, []).
forbs_cat([R|Rs], B, F?) :- ground(R?), ground(B?) |
    rs_lists(R?, _, _, _, N),
    img_atoms(N?, B?, G),
    forbs_cat(Rs?, B?, F1),
    app(G?, F1?, F).

%% --- The bindings of a schema, up to renaming ------------------------------
%% The bindings of a schema of roles Rs and head Hd, its variables in the order of its head (self.glp, schema_vars).
procedure canon_bindings(RoleSpecs?, Args?, Bindings).
canon_bindings(Rs, Hd, Bs?) :- ground(Rs?), ground(Hd?) |
    schema_vars(Rs?, Hd?, Vs),
    canon_bindings1(Rs?, Vs?, Bs).
procedure canon_bindings1(RoleSpecs?, Args?, Bindings).
canon_bindings1(Rs, Vs, Bs?) :- ground(Rs?), ground(Vs?) |
    person_vars(Vs?, Pv),
    speech_vars(Vs?, Sv),
    rgs(Pv?, 0, [], B1),
    rule_filter(B1?, Rs?, B2),
    with_speech(B2?, Sv?, B3),
    adm_filter(B3?, Rs?, Bs).
procedure person_vars(Args?, Args).
person_vars([], []).
person_vars([role(I)|Vs], [role(I?)|R?]) :- person_vars(Vs?, R).
person_vars([pvar(X)|Vs], [pvar(X?)|R?]) :- person_vars(Vs?, R).
person_vars([svar(_)|Vs], R?) :- person_vars(Vs?, R).
person_vars([nterm(_)|Vs], R?) :- person_vars(Vs?, R).
person_vars([sgn(_, _)|Vs], R?) :- person_vars(Vs?, R).
procedure speech_vars(Args?, Args).
speech_vars([], []).
speech_vars([svar(X)|Vs], [svar(X?)|R?]) :- speech_vars(Vs?, R).
speech_vars([role(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([pvar(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([nterm(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([sgn(_, _)|Vs], R?) :- speech_vars(Vs?, R).

%% rgs(Vs, N, B, Bs): every extension of B sending Vs to people, person(N)
%% being the first not yet used.
procedure rgs(Args?, Integer?, Binding?, Bindings).
rgs([], _, B, [B?]).
rgs([X|Xs], N, B, R?) :- ground(X?), ground(Xs?), ground(B?) |
    rgs_from(0, N?, X?, Xs?, B?, R).
procedure rgs_from(Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
rgs_from(I, N, _, _, _, []) :- I? > N? | true.
rgs_from(I, N, X, Xs, B, R?) :- I? =< N?, ground(X?), ground(Xs?), ground(B?) |
    next_fresh(I?, N?, N1),
    rgs(Xs?, N1?, [bnd(X?, person(I?))|B?], R1),
    I1 := I? + 1,
    rgs_from(I1?, N?, X?, Xs?, B?, R2),
    app(R1?, R2?, R).
procedure next_fresh(Integer?, Integer?, Integer).
next_fresh(I, N, N1?) :- I? =:= N? | N1 := N? + 1.
next_fresh(I, N, N?) :- I? < N? | true.

%% with_speech(Bs, Sv, R): each binding of Bs extended to the speech-act
%% variables, an utterance utt(N) in order of first use and, for a new one, its
%% signer one of the people the binding uses or one more.
procedure with_speech(Bindings?, Args?, Bindings).
with_speech([], _, []).
with_speech([B|Bs], Sv, R?) :- ground(B?), ground(Sv?) |
    people_count(B?, NP),
    svs(Sv?, 0, NP?, B?, R1),
    with_speech(Bs?, Sv?, R2),
    app(R1?, R2?, R).
procedure people_count(Binding?, Integer).
people_count([], 0).
people_count([bnd(_, person(I))|Bs], N?) :- people_count(Bs?, M), max1(I?, M?, N).
people_count([bnd(_, sp(_, _))|Bs], N?) :- people_count(Bs?, N).
people_count([bnd(_, free_var(_))|Bs], N?) :- people_count(Bs?, N).
%% A binding binds no variable to a community name, a name term being imaged from its parts (nt_val); the clauses cover the type.
people_count([bnd(_, cn(_))|Bs], N?) :- people_count(Bs?, N).
people_count([bnd(_, cdot(_, _))|Bs], N?) :- people_count(Bs?, N).
procedure max1(Integer?, Integer?, Integer).
max1(I, M, N?) :- I? >= M? | N := I? + 1.
max1(I, M, M?) :- I? < M? | true.
procedure svs(Args?, Integer?, Integer?, Binding?, Bindings).
svs([], _, _, B, [B?]).
svs([Y|Ys], NU, NP, B, R?) :- ground(Y?), ground(Ys?), ground(B?) |
    svs_old(0, NU?, NP?, Y?, Ys?, B?, R1),
    svs_new(0, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% An utterance already used, U < NU, with the signer it has.
procedure svs_old(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_old(U, NU, _, _, _, _, []) :- U? >= NU? | true.
svs_old(U, NU, NP, Y, Ys, B, R?) :- U? < NU?, ground(Y?), ground(Ys?), ground(B?) |
    signer_of(U?, B?, S),
    svs(Ys?, NU?, NP?, [bnd(Y?, sp(utt(U?), S?))|B?], R1),
    U1 := U? + 1,
    svs_old(U1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% A new utterance NU, signed by person S, 0 =< S =< NP.
procedure svs_new(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_new(S, _, NP, _, _, _, []) :- S? > NP? | true.
svs_new(S, NU, NP, Y, Ys, B, R?) :- S? =< NP?, ground(Y?), ground(Ys?), ground(B?) |
    NU1 := NU? + 1,
    svs(Ys?, NU1?, NP?, [bnd(Y?, sp(utt(NU?), S?))|B?], R1),
    S1 := S? + 1,
    svs_new(S1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
procedure signer_of(Integer?, Binding?, Integer).
signer_of(_, [], 0).
signer_of(U, [bnd(_, sp(utt(U1), S))|_], S?) :- U? =:= U1? | true.
signer_of(U, [_|Bs], S?) :- otherwise | signer_of(U?, Bs?, S).

procedure rule_filter(Bindings?, RoleSpecs?, Bindings).
rule_filter([], _, []).
rule_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    rule_ok(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    rule_filter(Bs?, Rs?, R1).
procedure adm_filter(Bindings?, RoleSpecs?, Bindings).
adm_filter([], _, []).
adm_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    admissible(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    adm_filter(Bs?, Rs?, R1).
procedure keep_binding(YesNo?, Binding?, Bindings?, Bindings).
keep_binding(yes, B, R, [B?|R?]).
keep_binding(no, _, R, R?).

%% --- Schema-bindings: their participants and atoms --------------------------
%% The participants and, for each, the join of the atoms its roles delete and
%% add (GSC, Definition "Compilation").
procedure sig_of(RoleSpecs?, Binding?, Deltas).
sig_of(Rs, B, Pt?) :- ground(Rs?), ground(B?) |
    role_people(Rs?, 1, B?, Ws),
    dedup(Ws?, Q),
    deltas_for(Q?, Rs?, B?, Pt).
procedure role_people(RoleSpecs?, Integer?, Binding?, Ints).
role_people([], _, _, []).
role_people([_|Rs], I, B, [P?|Ps?]) :- integer(I?), ground(B?) |
    role_person(I?, B?, P),
    I1 := I? + 1,
    role_people(Rs?, I1?, B?, Ps).
procedure role_person(Integer?, Binding?, Integer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), person_index(F?, P).
procedure person_index(Found?, Integer).
person_index(found(person(P)), P?).
person_index(found(sp(_, _)), -1).
person_index(found(free_var(_)), -1).
person_index(unbound, -1).
person_index(found(cn(_)), -1).
person_index(found(cdot(_, _)), -1).
procedure deltas_for(Ints?, RoleSpecs?, Binding?, Deltas).
deltas_for([], _, _, []).
deltas_for([P|Ps], Rs, B, [delta(P?, D?, A?)|Xs?]) :- ground(Rs?), ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    joins(RsP?, B?, D, A),
    deltas_for(Ps?, Rs?, B?, Xs).
procedure joins(RoleSpecs?, Binding?, GAs, GAs).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) |
    changes_join(RsP?, B?, del, [], D),
    changes_join(RsP?, B?, add, [], A).
procedure changes_join(RoleSpecs?, Binding?, Constant?, GAs?, GAs).
changes_join([], _, _, Acc, Acc?).
changes_join([R|Rs], B, W, Acc, Out?) :- ground(R?), ground(B?), ground(W?) |
    rs_lists(R?, P, M, _, _),
    which(W?, P?, M?, Xs),
    img_atoms(Xs?, B?, G),
    ms_join(Acc?, G?, Acc1),
    changes_join(Rs?, B?, W?, Acc1?, Out).
procedure which(Constant?, Atoms?, Atoms?, Atoms).
which(W, P, _, P?) :- W? =?= add | true.
which(W, _, M, M?) :- W? =?= del | true.
which(_, _, _, []) :- otherwise | true.
procedure specs_at(RoleSpecs?, Integer?, Binding?, Integer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R|Rs], I, B, P, Out?) :- integer(I?), ground(B?) |
    role_person(I?, B?, Q),
    I1 := I? + 1,
    specs_at(Rs?, I1?, B?, P?, Rest),
    keep_spec(Q?, P?, R?, Rest?, Out).
procedure keep_spec(Integer?, Integer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R?|Rest?]) :- Q? =:= P? | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.
procedure deltas_valid(Deltas?, YesNo).
deltas_valid([], yes).
deltas_valid([delta(_, D, A)|Ps], B?) :- ground(A?) |
    meets(D?, A?, M),
    neg(M?, B1),
    deltas_valid1(B1?, Ps?, B).
procedure deltas_valid1(YesNo?, Deltas?, YesNo).
deltas_valid1(no, _, no).
deltas_valid1(yes, Ps, B?) :- deltas_valid(Ps?, B).
procedure deltas_people(Deltas?, Ints).
deltas_people([], []).
deltas_people([delta(P, _, _)|Ps], [P?|Qs?]) :- deltas_people(Ps?, Qs).

%% GSC, Definition "Binding": two roles sent to one person only if neither
%% adds or deletes an atom naming the other.
procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) |
    rs_count(Rs?, K),
    pairs_ok(1, K?, Rs?, B?, R).
procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- I? > K? | true.
pairs_ok(I, K, Rs, B, R?) :- I? =< K?, ground(Rs?), ground(B?) |
    J := I? + 1,
    pair_row(I?, J?, K?, Rs?, B?, R1),
    I1 := I? + 1,
    pairs_ok1(R1?, I1?, K?, Rs?, B?, R).
procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).
procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- J? > K? | true.
pair_row(I, J, K, Rs, B, R?) :- J? =< K?, ground(Rs?), ground(B?) |
    role_person(I?, B?, P),
    role_person(J?, B?, Q),
    nth_spec(Rs?, I?, RI),
    nth_spec(Rs?, J?, RJ),
    pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1),
    J1 := J? + 1,
    pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).
procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).
procedure pair_ok(Integer?, Integer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- P? =:= Q? |
    role_names(RI?, J?, A1),
    role_names(RJ?, I?, A2),
    or(A1?, A2?, A),
    neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.
procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(R, J, B?) :- ground(R?), integer(J?) |
    rs_lists(R?, P, M, _, _),
    names_role(P?, J?, B1),
    names_role(M?, J?, B2),
    or(B1?, B2?, B).
%% An atom names a role among its arguments or the role of a signed term among
%% them (GSC, Section 3: "An atom names what is among its arguments or is the
%% signer of one: ... in a schema a role or a variable, the role of a signed
%% term included").
procedure names_role(Atoms?, Integer?, YesNo).
names_role([], _, no).
names_role([atom(_, As)|Xs], J, B?) :- integer(J?), ground(As?) |
    flat_args(As?, Fs),
    mem(role(J?), Fs?, B1),
    sgn_names(As?, J?, B2),
    or(B1?, B2?, B12),
    names_role1(B12?, Xs?, J?, B).
procedure sgn_names(Args?, Integer?, YesNo).
sgn_names([], _, no).
sgn_names([sgn(_, I)|_], J, yes) :- I? =:= J? | true.
sgn_names([_|As], J, B?) :- otherwise | sgn_names(As?, J?, B).
procedure names_role1(YesNo?, Atoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, Xs, J, B?) :- names_role(Xs?, J?, B).
procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R|_], I, R?) :- I? =:= 1 | true.
nth_spec([_|Rs], I, R?) :- I? > 1 | I1 := I? - 1, nth_spec(Rs?, I1?, R).

%% GSC, Definition "Binding", admissible.
procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) |
    added_atoms(Rs?, Ad),
    required_atoms(Rs?, Rq),
    guard_people(Rs?, 1, B?, Gp),
    atoms_args(Ad?, Av),
    atoms_args(Rq?, Qv),
    adm_each(Av?, Qv?, B?, Gp?, R).
procedure adm_each(Args?, Args?, Binding?, Ints?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V|Vs], Qv, B, Gp, R?) :- ground(V?), ground(Qv?), ground(B?), ground(Gp?) |
    adm_var(V?, Qv?, B?, Gp?, R1),
    adm_each1(R1?, Vs?, Qv?, B?, Gp?, R).
procedure adm_each1(YesNo?, Args?, Args?, Binding?, Ints?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Qv, B, Gp, R?) :- adm_each(Vs?, Qv?, B?, Gp?, R).
procedure adm_var(Arg?, Args?, Binding?, Ints?, YesNo).
adm_var(svar(X), Qv, B, Gp, R?) :- ground(X?), ground(B?) |
    mem(svar(X?), Qv?, InReq),
    lookup(svar(X?), B?, F),
    adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(nterm(_), _, _, _, yes).
%% A signed term's speech-act variable occurs in an atom some role requires
%% (GSC, Definition "Act schema"), so it asks nothing of the binding; its
%% value is the speech act bound to y, signed by the person in role i
%% (img_sgn).
adm_var(sgn(_, _), _, _, _, yes).
procedure adm_var1(YesNo?, Found?, Ints?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(sp(_, S)), Gp, R?) :- mem(S?, Gp?, R).
adm_var1(no, found(person(_)), _, no).
adm_var1(no, found(free_var(_)), _, no).
adm_var1(no, found(cn(_)), _, no).
adm_var1(no, found(cdot(_, _)), _, no).
adm_var1(no, unbound, _, no).
procedure added_atoms(RoleSpecs?, Atoms).
added_atoms([], []).
added_atoms([R|Rs], A?) :- ground(R?) | rs_lists(R?, P, _, _, _), added_atoms(Rs?, A1), app(P?, A1?, A).
procedure required_atoms(RoleSpecs?, Atoms).
required_atoms([], []).
required_atoms([R|Rs], A?) :- ground(R?) |
    rs_lists(R?, _, M, K, _),
    required_atoms(Rs?, A1),
    app(M?, A1?, A2),
    app(K?, A2?, A).
procedure guard_people(RoleSpecs?, Integer?, Binding?, Ints).
guard_people([], _, _, []).
guard_people([R|Rs], I, B, G?) :- ground(R?), integer(I?), ground(B?) |
    rs_guarded(R?, Gd),
    role_person(I?, B?, P),
    I1 := I? + 1,
    guard_people(Rs?, I1?, B?, G1),
    keep_int(Gd?, P?, G1?, G).
procedure keep_int(YesNo?, Integer?, Ints?, Ints).
keep_int(yes, P, G, [P?|G?]).
keep_int(no, _, G, G?).

%% --- Atoms, bindings and matching ------------------------------------------
procedure lookup(Arg?, Binding?, Found).
lookup(_, [], unbound).
lookup(V, [bnd(W, X)|_], found(X?)) :- V? =?= W? | true.
lookup(V, [_|Bs], F?) :- otherwise | lookup(V?, Bs?, F).
procedure img_atoms(Atoms?, Binding?, GAs).
img_atoms([], _, []).
img_atoms([atom(P, As)|Xs], B, [ga(P?, Vs?)|Gs?]) :- ground(B?) |
    img_args(As?, B?, Vs),
    img_atoms(Xs?, B?, Gs).
procedure img_args(Args?, Binding?, Vals).
img_args([], _, []).
img_args([sgn(Y, I)|As], B, [X?|Xs?]) :- ground(B?), ground(Y?), ground(I?) |
    lookup(svar(Y?), B?, F),
    role_person(I?, B?, P),
    img_sgn(F?, P?, sgn(Y?, I?), X),
    img_args(As?, B?, Xs).
img_args([nterm(N)|As], B, [X?|Xs?]) :- ground(B?), ground(N?) |
    nt_val(N?, B?, X),
    img_args(As?, B?, Xs).
img_args([A|As], B, [X?|Xs?]) :- otherwise, ground(B?), ground(A?) |
    lookup(A?, B?, F),
    val_or_free(F?, A?, X),
    img_args(As?, B?, Xs).
%% The community name a name term denotes at a binding; a name variable, which the compiler refuses with seated roles (cvac.glp, role_lines), stands for itself.
procedure nt_val(NameTerm?, Binding?, Val).
nt_val(own(I), B, cn(V?)) :- lookup(role(I?), B?, F), val_or_free(F?, role(I?), V).
nt_val(own_var(X), B, cn(V?)) :- lookup(pvar(X?), B?, F), val_or_free(F?, pvar(X?), V).
nt_val(nvar(Z), _, free_var(nterm(nvar(Z?)))).
nt_val(ext(N, Y), B, cdot(C?, V?)) :- ground(B?) |
    nt_val(N?, B?, C),
    lookup(svar(Y?), B?, F),
    val_or_free(F?, svar(Y?), V).
%% The image of a signed term sgn(y, i): the speech act bound to y, signed by the person in role i (GSC, Definition "Binding": beta(sgn(y, pi)) := (beta(y), beta(pi))).  Every binding taken here sends y to a speech act (canon_bindings), so the second clause covers the type and is never reached.
procedure img_sgn(Found?, Integer?, Arg?, Val).
img_sgn(found(sp(U, S)), P, _, sp(sp(U?, S?), P?)).
img_sgn(_, _, A, free_var(A?)) :- otherwise | true.

%% --- Multisets --------------------------------------------------------------
procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y|Ys], yes, Ys?) :- X? =?= Y? | true.
ms_remove(X, [Y|Ys], F?, [Y?|Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).
procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X|Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).
procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).
procedure(X) meets(Stream(X)?, Stream(X)?, YesNo).
meets([], _, no).
meets([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), meets1(R1?, Xs?, B?, R).
procedure(X) meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
meets1(yes, _, _, yes).
meets1(no, Xs, B, R?) :- meets(Xs?, B?, R).

procedure lapp(Stream(_)?, Stream(_)?, Stream(_)).
lapp([], Ys, Ys?).
lapp([X|Xs], Ys, [X?|Zs?]) :- lapp(Xs?, Ys?, Zs).
