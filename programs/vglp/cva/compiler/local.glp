%% local.glp --- whether a contract of act schemas is a local and effective
%% specification (vGLP, Section 3.2, the paragraph on act schemas and the
%% sentence after Definition "Effective Local Specification"), and, where it is
%% not, the lines saying why.
%%
%% Local: "a contract written as act schemas ... is a local specification when
%% every two schema-bindings of one class delete and add the same atoms at each
%% participant, and require and forbid the same atoms at every participant but
%% one", the classes being "those of the contract's equivalence, generated by
%% relating two transactions when one schema at one binding determines both".
%% Two schema-bindings determining a common transaction delete and add the same
%% atoms at each of the same participants (Jurix, Definition "Compilation"), and
%% vGLP takes a class to be all the schema-bindings of those participants and
%% those deleted and added atoms (vGLP #8, 2026-10-11 17:24 UTC, Q-A: "the class
%% is then the product of the union at the one participant and the common
%% requirements at the others").  So the contract is local when, for every
%% schema-binding, every schema-binding deleting and adding the same atoms at
%% the same participants requires and forbids the same atoms at all of them but
%% one; otherwise it is refused, the two schema-bindings named.
%%
%% The schemas name no person (Jurix, Proposition "Anonymity"), so the bindings
%% of a schema are taken up to renaming: its roles and party variables sent to
%% people person(0), person(1), ... in order of first use, every partition of
%% them a binding; its speech-act variables to speech acts sp(U, S), U an
%% utterance in order of first use and S the signer, one of those people or
%% one person more, whom no other variable names.  For each such binding that
%% is one (Jurix, Definition "Binding") and determines a transaction (Jurix,
%% Definition "Compilation": the added and the deleted atoms of each person
%% disjoint), its schema-bindings of the same deleted and added atoms are found
%% by sending every schema's roles onto its participants and matching the atoms
%% they delete and add, a variable of none of them left free.  A free variable
%% in an atom required or forbidden at a participant makes the requirements
%% there differ for some binding of it.
%%
%% Effective: "a contract of act schemas is effective where the atoms each
%% unguarded schema requires at its first role name every other role and every
%% variable of its deleted and added atoms"; otherwise refused, the schema
%% named.

Val      ::= person(Integer) ; sp(Integer, Integer) ; free.
Vals     ::= [] ; [Val | Vals].
Bnd      ::= bnd(Arg, Val).
Binding  ::= [] ; [Bnd | Binding].
Bindings ::= [] ; [Binding | Bindings].
GA       ::= ga(Constant, Vals).
GAs      ::= [] ; [GA | GAs].
Part     ::= part(Integer, GAs, GAs).
Parts    ::= [] ; [Part | Parts].
Mate     ::= mate(Constant, RoleSpecs, Binding).
Mates    ::= [] ; [Mate | Mates].
Found    ::= found(Val) ; unbound.
Match    ::= match(Binding) ; nomatch.
Pair     ::= nonlocal(Constant, RoleSpecs, Binding, Constant, RoleSpecs, Binding).
Pairs    ::= [] ; [Pair | Pairs].

exported procedure faults(Contract?, Stream(_)).
faults(C, Ls?) :- ground(C?) |
    local_pairs(C?, C?, Ps),
    local_lines(Ps?, L1),
    effective_lines(C?, L2),
    lapp(L1?, L2?, Ls).

%% The first pair found is named.
procedure local_lines(Pairs?, Stream(_)).
local_lines([], []).
local_lines([nonlocal(N1, Rs1, B1, N2, Rs2, B2)|_],
        ['%% it is not a local specification (vGLP, Section 3.2, the paragraph on act schemas):',
         '%% two schema-bindings delete and add the same atoms at each participant and require',
         '%% or forbid different atoms at two participants, a variable free being sent anywhere:',
         T1?, T2?]) :-
    ground(N1?), ground(Rs1?), ground(B1?), ground(N2?), ground(Rs2?), ground(B2?) |
    sb_term(N1?, Rs1?, B1?, S1),
    sb_term(N2?, Rs2?, B2?, S2),
    T1 =.. ['%% the schema-binding', S1?],
    T2 =.. ['%% and the schema-binding', S2?].

%% A schema-binding as the schema's name applied to the values of its
%% variables, in programs/jurix's order; free for a variable it leaves free.
procedure sb_term(Constant?, RoleSpecs?, Binding?, _).
sb_term(Nm, Rs, B, T?) :- ground(Nm?), ground(B?) |
    schema_vars(Rs?, Vs),
    vals_of(Vs?, B?, Xs),
    T =.. [Nm?|Xs?].
procedure vals_of(Args?, Binding?, Vals).
vals_of([], _, []).
vals_of([V|Vs], B, [X?|Xs?]) :- ground(B?) |
    lookup(V?, B?, F),
    val_or_free(F?, X),
    vals_of(Vs?, B?, Xs).
procedure val_or_free(Found?, Val).
val_or_free(found(X), X?).
val_or_free(unbound, free).

%% --- Effective -------------------------------------------------------------
procedure effective_lines(Contract?, Stream(_)).
effective_lines([], []).
effective_lines([schema(Nm, Rs)|Ss], L?) :- ground(Nm?), ground(Rs?) |
    guarded_any(Rs?, G),
    effective_one(G?, Nm?, Rs?, L1),
    effective_lines(Ss?, L2),
    lapp(L1?, L2?, L).
effective_lines([cschema(_, _, _)|Ss], L?) :- effective_lines(Ss?, L).
procedure guarded_any(RoleSpecs?, YesNo).
guarded_any([], no).
guarded_any([R|Rs], B?) :- rs_guarded(R?, B1), guarded_any1(B1?, Rs?, B).
procedure guarded_any1(YesNo?, RoleSpecs?, YesNo).
guarded_any1(yes, _, yes).
guarded_any1(no, Rs, B?) :- guarded_any(Rs?, B).
procedure effective_one(YesNo?, Constant?, RoleSpecs?, Stream(_)).
effective_one(yes, _, _, []).
effective_one(no, Nm, Rs, L?) :- ground(Rs?), ground(Nm?) |
    first_required_args(Rs?, Fa),
    rs_count(Rs?, K),
    role_args(2, K?, Others),
    changed_args(Rs?, Ch),
    drop_role_one(Ch?, Ch1),
    app(Others?, Ch1?, Need),
    all_member(Need?, Fa?, Ok),
    effective_one1(Ok?, Nm?, L).
procedure effective_one1(YesNo?, Constant?, Stream(_)).
effective_one1(yes, _, []).
effective_one1(no, Nm, ['%% it is not effective (vGLP, Section 3.2, the sentence after Definition "Effective Local Specification"):',
        '%% an unguarded schema whose first role requires no atom naming some other role, or',
        '%% some variable of an atom it deletes or adds:', T?]) :-
    ground(Nm?) | T =.. ['%% the schema', Nm?].
procedure first_required_args(RoleSpecs?, Args).
first_required_args([], []).
first_required_args([R|_], As?) :- ground(R?) |
    rs_parts(R?, _, M, K, _),
    atoms_args(K?, A1),
    atoms_args(M?, A2),
    app(A1?, A2?, As).
procedure changed_args(RoleSpecs?, Args).
changed_args([], []).
changed_args([R|Rs], As?) :- ground(R?) |
    rs_parts(R?, P, M, _, _),
    atoms_args(P?, A1),
    atoms_args(M?, A2),
    changed_args(Rs?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, As).
procedure drop_role_one(Args?, Args).
drop_role_one([], []).
drop_role_one([role(I)|As], R?) :- I? =:= 1 | drop_role_one(As?, R).
drop_role_one([A|As], [A?|R?]) :- otherwise | drop_role_one(As?, R).
procedure all_member(Args?, Args?, YesNo).
all_member([], _, yes).
all_member([A|As], Fa, B?) :- ground(Fa?) | mem(A?, Fa?, B1), all_member1(B1?, As?, Fa?, B).
procedure all_member1(YesNo?, Args?, Args?, YesNo).
all_member1(no, _, _, no).
all_member1(yes, As, Fa, B?) :- all_member(As?, Fa?, B).

%% --- Local -----------------------------------------------------------------
procedure local_pairs(Contract?, Contract?, Pairs).
local_pairs([], _, []).
local_pairs([schema(Nm, Rs)|Ss], C, Ps?) :- ground(Nm?), ground(Rs?), ground(C?) |
    canon_bindings(Rs?, Bs),
    bindings_pairs(Bs?, Nm?, Rs?, C?, P1),
    local_pairs(Ss?, C?, P2),
    app(P1?, P2?, Ps).
local_pairs([cschema(_, _, _)|Ss], C, Ps?) :- local_pairs(Ss?, C?, Ps).

procedure bindings_pairs(Bindings?, Constant?, RoleSpecs?, Contract?, Pairs).
bindings_pairs([], _, _, _, []).
bindings_pairs([B|Bs], Nm, Rs, C, Ps?) :- ground(B?), ground(Nm?), ground(Rs?), ground(C?) |
    sig_of(Rs?, B?, Pt),
    binding_pairs(Pt?, B?, Nm?, Rs?, C?, P1),
    bindings_pairs(Bs?, Nm?, Rs?, C?, P2),
    app(P1?, P2?, Ps).
procedure binding_pairs(Parts?, Binding?, Constant?, RoleSpecs?, Contract?, Pairs).
binding_pairs(Pt, B, Nm, Rs, C, Ps?) :- ground(Pt?) |
    parts_valid(Pt?, V),
    binding_pairs1(V?, Pt?, B?, Nm?, Rs?, C?, Ps).
procedure binding_pairs1(YesNo?, Parts?, Binding?, Constant?, RoleSpecs?, Contract?, Pairs).
binding_pairs1(no, _, _, _, _, _, []).
binding_pairs1(yes, Pt, B, Nm, Rs, C, Ps?) :- ground(Pt?) |
    mates_of(C?, Pt?, Ms),
    compare_mates(Ms?, Pt?, Nm?, Rs?, B?, Ps).
procedure compare_mates(Mates?, Parts?, Constant?, RoleSpecs?, Binding?, Pairs).
compare_mates([], _, _, _, _, []).
compare_mates([mate(N2, Rs2, B2)|Ms], Pt, Nm, Rs, B, Ps?) :-
    ground(N2?), ground(Rs2?), ground(B2?), ground(Pt?), ground(Nm?), ground(Rs?), ground(B?) |
    parts_people(Pt?, Q),
    differing(Q?, Rs?, B?, Rs2?, B2?, K),
    compare_one(K?, nonlocal(Nm?, Rs?, B?, N2?, Rs2?, B2?), P1),
    compare_mates(Ms?, Pt?, Nm?, Rs?, B?, P2),
    app(P1?, P2?, Ps).
procedure compare_one(Integer?, Pair?, Pairs).
compare_one(K, P, [P?]) :- K? >= 2 | true.
compare_one(K, _, []) :- K? < 2 | true.

%% The number of participants at which the two require or forbid different
%% atoms, an atom with a variable left free differing.
procedure differing(Ints?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Integer).
differing([], _, _, _, _, 0).
differing([P|Ps], Rs, B, Rs2, B2, K?) :- ground(Rs?), ground(B?), ground(Rs2?), ground(B2?) |
    reqs_at(Rs?, B?, P?, R1),
    reqs_at(Rs2?, B2?, P?, R2),
    forbs_at(Rs?, B?, P?, F1),
    forbs_at(Rs2?, B2?, P?, F2),
    same_atoms(R1?, R2?, F1?, F2?, E),
    differing(Ps?, Rs?, B?, Rs2?, B2?, K1),
    count_differs(E?, K1?, K).
procedure count_differs(YesNo?, Integer?, Integer).
count_differs(yes, K, K?).
count_differs(no, K1, K?) :- K := K1? + 1.
procedure same_atoms(GAs?, GAs?, GAs?, GAs?, YesNo).
same_atoms(R1, R2, F1, F2, E?) :- ground(R2?), ground(F2?) |
    open_atoms(R2?, O1),
    open_atoms(F2?, O2),
    ms_eq(R1?, R2?, E1),
    dedup(F1?, F1s),
    dedup(F2?, F2s),
    set_eq(F1s?, F2s?, E2),
    or(O1?, O2?, O),
    neg(O?, NO),
    and(E1?, E2?, E12),
    and(NO?, E12?, E).
procedure open_atoms(GAs?, YesNo).
open_atoms([], no).
open_atoms([ga(_, Xs)|As], B?) :- mem(free, Xs?, B1), open_atoms1(B1?, As?, B).
procedure open_atoms1(YesNo?, GAs?, YesNo).
open_atoms1(yes, _, yes).
open_atoms1(no, As, B?) :- open_atoms(As?, B).

%% The atoms required (=(i) and -(i)) at the roles sent to P, joined, and those
%% forbidden there.
procedure reqs_at(RoleSpecs?, Binding?, Integer?, GAs).
reqs_at(Rs, B, P, R?) :- ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    reqs_join(RsP?, B?, [], R).
procedure reqs_join(RoleSpecs?, Binding?, GAs?, GAs).
reqs_join([], _, Acc, Acc?).
reqs_join([R|Rs], B, Acc, Out?) :- ground(R?), ground(B?) |
    rs_parts(R?, _, M, K, _),
    img_atoms(K?, B?, G1),
    img_atoms(M?, B?, G2),
    app(G1?, G2?, G),
    ms_join(Acc?, G?, Acc1),
    reqs_join(Rs?, B?, Acc1?, Out).
procedure forbs_at(RoleSpecs?, Binding?, Integer?, GAs).
forbs_at(Rs, B, P, F?) :- ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    forbs_cat(RsP?, B?, F).
procedure forbs_cat(RoleSpecs?, Binding?, GAs).
forbs_cat([], _, []).
forbs_cat([R|Rs], B, F?) :- ground(R?), ground(B?) |
    rs_parts(R?, _, _, _, N),
    img_atoms(N?, B?, G),
    forbs_cat(Rs?, B?, F1),
    app(G?, F1?, F).

%% --- The bindings of a schema, up to renaming ------------------------------
procedure canon_bindings(RoleSpecs?, Bindings).
canon_bindings(Rs, Bs?) :- ground(Rs?) |
    schema_vars(Rs?, Vs),
    canon_bindings1(Rs?, Vs?, Bs).
procedure canon_bindings1(RoleSpecs?, Args?, Bindings).
canon_bindings1(Rs, Vs, Bs?) :- ground(Rs?), ground(Vs?) |
    person_vars(Vs?, Pv),
    speech_vars(Vs?, Sv),
    rgs(Pv?, 0, [], B1),
    rule_filter(B1?, Rs?, B2),
    with_speech(B2?, Sv?, B3),
    adm_filter(B3?, Rs?, Bs).
procedure person_vars(Args?, Args).
person_vars([], []).
person_vars([role(I)|Vs], [role(I?)|R?]) :- person_vars(Vs?, R).
person_vars([pvar(X)|Vs], [pvar(X?)|R?]) :- person_vars(Vs?, R).
person_vars([svar(_)|Vs], R?) :- person_vars(Vs?, R).
person_vars([nterm(_)|Vs], R?) :- person_vars(Vs?, R).
procedure speech_vars(Args?, Args).
speech_vars([], []).
speech_vars([svar(X)|Vs], [svar(X?)|R?]) :- speech_vars(Vs?, R).
speech_vars([role(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([pvar(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([nterm(_)|Vs], R?) :- speech_vars(Vs?, R).

%% rgs(Vs, N, B, Bs): every extension of B sending Vs to people, person(N)
%% being the first not yet used.
procedure rgs(Args?, Integer?, Binding?, Bindings).
rgs([], _, B, [B?]).
rgs([X|Xs], N, B, R?) :- ground(X?), ground(Xs?), ground(B?) |
    rgs_from(0, N?, X?, Xs?, B?, R).
procedure rgs_from(Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
rgs_from(I, N, _, _, _, []) :- I? > N? | true.
rgs_from(I, N, X, Xs, B, R?) :- I? =< N?, ground(X?), ground(Xs?), ground(B?) |
    next_fresh(I?, N?, N1),
    rgs(Xs?, N1?, [bnd(X?, person(I?))|B?], R1),
    I1 := I? + 1,
    rgs_from(I1?, N?, X?, Xs?, B?, R2),
    app(R1?, R2?, R).
procedure next_fresh(Integer?, Integer?, Integer).
next_fresh(I, N, N1?) :- I? =:= N? | N1 := N? + 1.
next_fresh(I, N, N?) :- I? < N? | true.

%% with_speech(Bs, Sv, R): each binding of Bs extended to the speech-act
%% variables, an utterance in order of first use and, for a new one, its signer
%% one of the people the binding uses or one more.
procedure with_speech(Bindings?, Args?, Bindings).
with_speech([], _, []).
with_speech([B|Bs], Sv, R?) :- ground(B?), ground(Sv?) |
    people_count(B?, NP),
    svs(Sv?, 0, NP?, B?, R1),
    with_speech(Bs?, Sv?, R2),
    app(R1?, R2?, R).
procedure people_count(Binding?, Integer).
people_count([], 0).
people_count([bnd(_, person(I))|Bs], N?) :- people_count(Bs?, M), max1(I?, M?, N).
people_count([bnd(_, sp(_, _))|Bs], N?) :- people_count(Bs?, N).
people_count([bnd(_, free)|Bs], N?) :- people_count(Bs?, N).
procedure max1(Integer?, Integer?, Integer).
max1(I, M, N?) :- I? >= M? | N := I? + 1.
max1(I, M, M?) :- I? < M? | true.
procedure svs(Args?, Integer?, Integer?, Binding?, Bindings).
svs([], _, _, B, [B?]).
svs([Y|Ys], NU, NP, B, R?) :- ground(Y?), ground(Ys?), ground(B?) |
    svs_old(0, NU?, NP?, Y?, Ys?, B?, R1),
    svs_new(0, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% An utterance already used, U < NU, with the signer it has.
procedure svs_old(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_old(U, NU, _, _, _, _, []) :- U? >= NU? | true.
svs_old(U, NU, NP, Y, Ys, B, R?) :- U? < NU?, ground(Y?), ground(Ys?), ground(B?) |
    signer_of(U?, B?, S),
    svs(Ys?, NU?, NP?, [bnd(Y?, sp(U?, S?))|B?], R1),
    U1 := U? + 1,
    svs_old(U1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% A new utterance NU, signed by person S, 0 =< S =< NP.
procedure svs_new(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_new(S, _, NP, _, _, _, []) :- S? > NP? | true.
svs_new(S, NU, NP, Y, Ys, B, R?) :- S? =< NP?, ground(Y?), ground(Ys?), ground(B?) |
    NU1 := NU? + 1,
    svs(Ys?, NU1?, NP?, [bnd(Y?, sp(NU?, S?))|B?], R1),
    S1 := S? + 1,
    svs_new(S1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
procedure signer_of(Integer?, Binding?, Integer).
signer_of(_, [], 0).
signer_of(U, [bnd(_, sp(U1, S))|_], S?) :- U? =:= U1? | true.
signer_of(U, [_|Bs], S?) :- otherwise | signer_of(U?, Bs?, S).

procedure rule_filter(Bindings?, RoleSpecs?, Bindings).
rule_filter([], _, []).
rule_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    rule_ok(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    rule_filter(Bs?, Rs?, R1).
procedure adm_filter(Bindings?, RoleSpecs?, Bindings).
adm_filter([], _, []).
adm_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    admissible(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    adm_filter(Bs?, Rs?, R1).
procedure keep_binding(YesNo?, Binding?, Bindings?, Bindings).
keep_binding(yes, B, R, [B?|R?]).
keep_binding(no, _, R, R?).

%% --- Schema-bindings: signatures and mates, as the platform computes them --
%% The participants and, for each, the join of the atoms its roles delete and
%% add (Jurix, Definition "Compilation").
procedure sig_of(RoleSpecs?, Binding?, Parts).
sig_of(Rs, B, Pt?) :- ground(Rs?), ground(B?) |
    role_people(Rs?, 1, B?, Ws),
    dedup(Ws?, Q),
    parts_for(Q?, Rs?, B?, Pt).
procedure role_people(RoleSpecs?, Integer?, Binding?, Ints).
role_people([], _, _, []).
role_people([_|Rs], I, B, [P?|Ps?]) :- integer(I?), ground(B?) |
    role_person(I?, B?, P),
    I1 := I? + 1,
    role_people(Rs?, I1?, B?, Ps).
procedure role_person(Integer?, Binding?, Integer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), person_index(F?, P).
procedure person_index(Found?, Integer).
person_index(found(person(P)), P?).
person_index(found(sp(_, _)), -1).
person_index(found(free), -1).
person_index(unbound, -1).
procedure parts_for(Ints?, RoleSpecs?, Binding?, Parts).
parts_for([], _, _, []).
parts_for([P|Ps], Rs, B, [part(P?, D?, A?)|Xs?]) :- ground(Rs?), ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    joins(RsP?, B?, D, A),
    parts_for(Ps?, Rs?, B?, Xs).
procedure joins(RoleSpecs?, Binding?, GAs, GAs).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) |
    changes_join(RsP?, B?, del, [], D),
    changes_join(RsP?, B?, add, [], A).
procedure changes_join(RoleSpecs?, Binding?, Constant?, GAs?, GAs).
changes_join([], _, _, Acc, Acc?).
changes_join([R|Rs], B, W, Acc, Out?) :- ground(R?), ground(B?), ground(W?) |
    rs_parts(R?, P, M, _, _),
    which(W?, P?, M?, Xs),
    img_atoms(Xs?, B?, G),
    ms_join(Acc?, G?, Acc1),
    changes_join(Rs?, B?, W?, Acc1?, Out).
procedure which(Constant?, Atoms?, Atoms?, Atoms).
which(W, P, _, P?) :- W? =?= add | true.
which(W, _, M, M?) :- W? =?= del | true.
which(_, _, _, []) :- otherwise | true.
procedure specs_at(RoleSpecs?, Integer?, Binding?, Integer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R|Rs], I, B, P, Out?) :- integer(I?), ground(B?) |
    role_person(I?, B?, Q),
    I1 := I? + 1,
    specs_at(Rs?, I1?, B?, P?, Rest),
    keep_spec(Q?, P?, R?, Rest?, Out).
procedure keep_spec(Integer?, Integer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R?|Rest?]) :- Q? =:= P? | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.
procedure parts_valid(Parts?, YesNo).
parts_valid([], yes).
parts_valid([part(_, D, A)|Ps], B?) :- ground(A?) |
    meets(D?, A?, M),
    neg(M?, B1),
    parts_valid1(B1?, Ps?, B).
procedure parts_valid1(YesNo?, Parts?, YesNo).
parts_valid1(no, _, no).
parts_valid1(yes, Ps, B?) :- parts_valid(Ps?, B).
procedure parts_people(Parts?, Ints).
parts_people([], []).
parts_people([part(P, _, _)|Ps], [P?|Qs?]) :- parts_people(Ps?, Qs).
procedure parts_eq(Parts?, Parts?, YesNo).
parts_eq(A, B, E?) :- ground(A?), ground(B?) |
    parts_people(A?, Pa),
    parts_people(B?, Pb),
    set_eq(Pa?, Pb?, E1),
    parts_in(A?, B?, E2),
    and(E1?, E2?, E).
procedure parts_in(Parts?, Parts?, YesNo).
parts_in([], _, yes).
parts_in([X|Xs], B, E?) :- ground(B?) |
    part_in(X?, B?, E1),
    parts_in1(E1?, Xs?, B?, E).
procedure parts_in1(YesNo?, Parts?, Parts?, YesNo).
parts_in1(no, _, _, no).
parts_in1(yes, Xs, B, E?) :- parts_in(Xs?, B?, E).
procedure part_in(Part?, Parts?, YesNo).
part_in(_, [], no).
part_in(part(P, D, A), [part(Q, D1, A1)|Ps], E?) :- P? =:= Q?, ground(D?), ground(A?) |
    ms_eq(D?, D1?, E1),
    ms_eq(A?, A1?, E2),
    and(E1?, E2?, E3),
    part_in1(E3?, part(P?, D?, A?), Ps?, E).
part_in(X, [_|Ps], E?) :- otherwise | part_in(X?, Ps?, E).
procedure part_in1(YesNo?, Part?, Parts?, YesNo).
part_in1(yes, _, _, yes).
part_in1(no, X, Ps, E?) :- part_in(X?, Ps?, E).

%% Jurix, Definition "Binding": two roles sent to one person only if neither
%% adds or deletes an atom naming the other.
procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) |
    rs_count(Rs?, K),
    pairs_ok(1, K?, Rs?, B?, R).
procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- I? > K? | true.
pairs_ok(I, K, Rs, B, R?) :- I? =< K?, ground(Rs?), ground(B?) |
    J := I? + 1,
    pair_row(I?, J?, K?, Rs?, B?, R1),
    I1 := I? + 1,
    pairs_ok1(R1?, I1?, K?, Rs?, B?, R).
procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).
procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- J? > K? | true.
pair_row(I, J, K, Rs, B, R?) :- J? =< K?, ground(Rs?), ground(B?) |
    role_person(I?, B?, P),
    role_person(J?, B?, Q),
    nth_spec(Rs?, I?, RI),
    nth_spec(Rs?, J?, RJ),
    pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1),
    J1 := J? + 1,
    pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).
procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).
procedure pair_ok(Integer?, Integer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- P? =:= Q? |
    role_names(RI?, J?, A1),
    role_names(RJ?, I?, A2),
    or(A1?, A2?, A),
    neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.
procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(R, J, B?) :- ground(R?), integer(J?) |
    rs_parts(R?, P, M, _, _),
    names_role(P?, J?, B1),
    names_role(M?, J?, B2),
    or(B1?, B2?, B).
procedure names_role(Atoms?, Integer?, YesNo).
names_role([], _, no).
names_role([atom(_, As)|Xs], J, B?) :- integer(J?) |
    mem(role(J?), As?, B1),
    names_role1(B1?, Xs?, J?, B).
procedure names_role1(YesNo?, Atoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, Xs, J, B?) :- names_role(Xs?, J?, B).
procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R|_], I, R?) :- I? =:= 1 | true.
nth_spec([_|Rs], I, R?) :- I? > 1 | I1 := I? - 1, nth_spec(Rs?, I1?, R).

%% Jurix, Definition "Binding", admissible.
procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) |
    added_atoms(Rs?, Ad),
    required_atoms(Rs?, Rq),
    guard_people(Rs?, 1, B?, Gp),
    atoms_args(Ad?, Av),
    atoms_args(Rq?, Qv),
    adm_each(Av?, Qv?, B?, Gp?, R).
procedure adm_each(Args?, Args?, Binding?, Ints?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V|Vs], Qv, B, Gp, R?) :- ground(V?), ground(Qv?), ground(B?), ground(Gp?) |
    adm_var(V?, Qv?, B?, Gp?, R1),
    adm_each1(R1?, Vs?, Qv?, B?, Gp?, R).
procedure adm_each1(YesNo?, Args?, Args?, Binding?, Ints?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Qv, B, Gp, R?) :- adm_each(Vs?, Qv?, B?, Gp?, R).
procedure adm_var(Arg?, Args?, Binding?, Ints?, YesNo).
adm_var(svar(X), Qv, B, Gp, R?) :- ground(X?), ground(B?) |
    mem(svar(X?), Qv?, InReq),
    lookup(svar(X?), B?, F),
    adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(nterm(_), _, _, _, yes).
procedure adm_var1(YesNo?, Found?, Ints?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(sp(_, S)), Gp, R?) :- mem(S?, Gp?, R).
adm_var1(no, found(person(_)), _, no).
adm_var1(no, found(free), _, no).
adm_var1(no, unbound, _, no).
procedure added_atoms(RoleSpecs?, Atoms).
added_atoms([], []).
added_atoms([R|Rs], A?) :- ground(R?) | rs_parts(R?, P, _, _, _), added_atoms(Rs?, A1), app(P?, A1?, A).
procedure required_atoms(RoleSpecs?, Atoms).
required_atoms([], []).
required_atoms([R|Rs], A?) :- ground(R?) |
    rs_parts(R?, _, M, K, _),
    required_atoms(Rs?, A1),
    app(M?, A1?, A2),
    app(K?, A2?, A).
procedure guard_people(RoleSpecs?, Integer?, Binding?, Ints).
guard_people([], _, _, []).
guard_people([R|Rs], I, B, G?) :- ground(R?), integer(I?), ground(B?) |
    rs_guarded(R?, Gd),
    role_person(I?, B?, P),
    I1 := I? + 1,
    guard_people(Rs?, I1?, B?, G1),
    keep_int(Gd?, P?, G1?, G).
procedure keep_int(YesNo?, Integer?, Ints?, Ints).
keep_int(yes, P, G, [P?|G?]).
keep_int(no, _, G, G?).

%% The schema-bindings of every schema whose roles, sent onto the
%% participants, delete and add exactly the atoms of Pt.
procedure mates_of(Contract?, Parts?, Mates).
mates_of([], _, []).
mates_of([schema(Nm, Rs)|Ss], Pt, M?) :- ground(Nm?), ground(Rs?), ground(Pt?) |
    parts_people(Pt?, Q),
    rs_count(Rs?, K),
    assigns(K?, Q?, As),
    mates_assigns(As?, Nm?, Rs?, Pt?, M1),
    mates_of(Ss?, Pt?, M2),
    app(M1?, M2?, M).
mates_of([cschema(_, _, _)|Ss], Pt, M?) :- mates_of(Ss?, Pt?, M).
procedure assigns(Integer?, Ints?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).
procedure assigns1(Integer?, Integer?, Ints?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- I? > K? | true.
assigns1(I, K, Q, Acc, R?) :- I? =< K?, ground(Q?) |
    extend_role(Acc?, I?, Q?, Acc1),
    I1 := I? + 1,
    assigns1(I1?, K?, Q?, Acc1?, R).
procedure extend_role(Bindings?, Integer?, Ints?, Bindings).
extend_role([], _, _, []).
extend_role([B|Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) |
    extend_one(Q?, I?, B?, R1),
    extend_role(Bs?, I?, Q?, R2),
    app(R1?, R2?, R).
procedure extend_one(Ints?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P|Ps], I, B, [[bnd(role(I?), person(P?))|B?]|R?]) :- ground(B?), integer(I?) |
    extend_one(Ps?, I?, B?, R).
procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Parts?, Mates).
mates_assigns([], _, _, _, []).
mates_assigns([B|Bs], Nm, Rs, Pt, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Pt?) |
    parts_people(Pt?, Q),
    role_people(Rs?, 1, B?, Ws),
    all_in(Q?, Ws?, Onto),
    rule_ok(Rs?, B?, Ok),
    and(Onto?, Ok?, Go),
    mates_assign(Go?, B?, Nm?, Rs?, Pt?, M1),
    mates_assigns(Bs?, Nm?, Rs?, Pt?, M2),
    app(M1?, M2?, M).
procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Parts?, Mates).
mates_assign(no, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Pt, M?) :- ground(Rs?), ground(Pt?) |
    match_parts(Pt?, Rs?, [B?], Bs),
    mates_check(Bs?, Nm?, Rs?, Pt?, M).
procedure match_parts(Parts?, RoleSpecs?, Bindings?, Bindings).
match_parts([], _, Bs, Bs?).
match_parts([part(P, D, A)|Pt], Rs, Bs, R?) :- ground(D?), ground(A?), ground(Rs?) |
    match_part(Bs?, P?, D?, A?, Rs?, Bs1),
    match_parts(Pt?, Rs?, Bs1?, R).
procedure match_part(Bindings?, Integer?, GAs?, GAs?, RoleSpecs?, Bindings).
match_part([], _, _, _, _, []).
match_part([B|Bs], P, D, A, Rs, R?) :- ground(B?), ground(D?), ground(A?), ground(Rs?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    match_part1(RsP?, B?, D?, A?, B2),
    match_part(Bs?, P?, D?, A?, Rs?, R2),
    app(B2?, R2?, R).
procedure match_part1(RoleSpecs?, Binding?, GAs?, GAs?, Bindings).
match_part1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) |
    changes_cat(RsP?, del, Dp),
    changes_cat(RsP?, add, Ap),
    match_all(Dp?, D?, B?, B1),
    match_all_each(B1?, Ap?, A?, R).
procedure changes_cat(RoleSpecs?, Constant?, Atoms).
changes_cat([], _, []).
changes_cat([R|Rs], W, Xs?) :- ground(R?), ground(W?) |
    rs_parts(R?, P, M, _, _),
    which(W?, P?, M?, X1),
    changes_cat(Rs?, W?, X2),
    app(X1?, X2?, Xs).
procedure mates_check(Bindings?, Constant?, RoleSpecs?, Parts?, Mates).
mates_check([], _, _, _, []).
mates_check([B|Bs], Nm, Rs, Pt, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Pt?) |
    sig_of(Rs?, B?, Pt1),
    parts_eq(Pt?, Pt1?, E1),
    admissible(Rs?, B?, E2),
    and(E1?, E2?, E),
    mate_of(E?, B?, Nm?, Rs?, M1),
    mates_check(Bs?, Nm?, Rs?, Pt?, M2),
    app(M1?, M2?, M).
procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, Rs?, B?)]).

procedure all_in(Ints?, Ints?, YesNo).
all_in([], _, yes).
all_in([P|Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).
procedure all_in1(YesNo?, Ints?, Ints?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).

%% --- Atoms, bindings and matching ------------------------------------------
procedure lookup(Arg?, Binding?, Found).
lookup(_, [], unbound).
lookup(V, [bnd(W, X)|_], found(X?)) :- V? =?= W? | true.
lookup(V, [_|Bs], F?) :- otherwise | lookup(V?, Bs?, F).
procedure img_atoms(Atoms?, Binding?, GAs).
img_atoms([], _, []).
img_atoms([atom(P, As)|Xs], B, [ga(P?, Vs?)|Gs?]) :- ground(B?) |
    img_args(As?, B?, Vs),
    img_atoms(Xs?, B?, Gs).
procedure img_args(Args?, Binding?, Vals).
img_args([], _, []).
img_args([A|As], B, [X?|Xs?]) :- ground(B?) |
    lookup(A?, B?, F),
    val_or_free(F?, X),
    img_args(As?, B?, Xs).

procedure match_all(Atoms?, GAs?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A|As], Gs, B, R?) :- ground(Gs?) |
    match_into(A?, Gs?, B?, Bs),
    match_all_each(Bs?, As?, Gs?, R).
procedure match_all_each(Bindings?, Atoms?, GAs?, Bindings).
match_all_each([], _, _, []).
match_all_each([B|Bs], As, Gs, R?) :- ground(As?), ground(Gs?) |
    match_all(As?, Gs?, B?, R1),
    match_all_each(Bs?, As?, Gs?, R2),
    app(R1?, R2?, R).
procedure match_into(Atom?, GAs?, Binding?, Bindings).
match_into(_, [], _, []).
match_into(A, [G|Gs], B, R?) :- ground(A?), ground(B?) |
    match_atom(A?, G?, B?, M),
    match_into1(M?, A?, Gs?, B?, R).
procedure match_into1(Match?, Atom?, GAs?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1?|R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).
procedure match_atom(Atom?, GA?, Binding?, Match).
match_atom(atom(P, As), ga(Q, Xs), B, R?) :- P? =?= Q? | match_args(As?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.
procedure match_args(Args?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_|_], _, nomatch).
match_args([_|_], [], _, nomatch).
match_args([V|Vs], [X|Xs], B, R?) :- ground(V?), ground(X?), ground(B?) |
    lookup(V?, B?, F),
    kind_ok(V?, X?, K),
    match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).
procedure match_one(Found?, YesNo?, Arg?, Val?, Args?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- W? =?= X? | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(unbound, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [bnd(V?, X?)|B?], R).
match_one(unbound, no, _, _, _, _, _, nomatch).
procedure kind_ok(Arg?, Val?, YesNo).
kind_ok(role(_), person(_), yes).
kind_ok(pvar(_), person(_), yes).
kind_ok(svar(_), sp(_, _), yes).
kind_ok(_, _, no) :- otherwise | true.

%% --- Multisets --------------------------------------------------------------
procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y|Ys], yes, Ys?) :- X? =?= Y? | true.
ms_remove(X, [Y|Ys], F?, [Y?|Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).
procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X|Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).
procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X|Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).
procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).
procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) |
    ms_sub(A?, B?, R1),
    ms_sub(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) set_eq(Stream(X)?, Stream(X)?, YesNo).
set_eq(A, B, R?) :- ground(A?), ground(B?) |
    all_of(A?, B?, R1),
    all_of(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) all_of(Stream(X)?, Stream(X)?, YesNo).
all_of([], _, yes).
all_of([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), all_of1(R1?, Xs?, B?, R).
procedure(X) all_of1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
all_of1(no, _, _, no).
all_of1(yes, Xs, B, R?) :- all_of(Xs?, B?, R).
procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).
procedure(X) meets(Stream(X)?, Stream(X)?, YesNo).
meets([], _, no).
meets([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), meets1(R1?, Xs?, B?, R).
procedure(X) meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
meets1(yes, _, _, yes).
meets1(no, Xs, B, R?) :- meets(Xs?, B?, R).

procedure lapp(Stream(_)?, Stream(_)?, Stream(_)).
lapp([], Ys, Ys?).
lapp([X|Xs], Ys, [X?|Zs?]) :- lapp(Xs?, Ys?, Zs).
