%% local.glp --- whether a contract of act schemas is a local and effective
%% specification with simple guards (vGLP, Section 5.4, the paragraph "Act
%% schemas as local specifications"; Section 3.2, Definition "Volition-Guarded
%% Specification", the paragraph after it on guard sets and simple guards, and
%% Definition "Local Specification, Part, Opener"), and, where it is not, the
%% lines saying why.
%%
%% Local: "Such a contract is a local specification under one condition: the
%% schema-bindings determining any two transactions of one class mark the same
%% sets of people, so that equivalent transactions have the same minimal
%% guards" (vGLP c0bea08, Section 5.4, "Act schemas as local specifications"),
%% the classes being "those of the contract's equivalence, generated by
%% relating two transactions when one schema-binding determines both", and
%% "the parts of a class are the sets of transactions its schema-bindings
%% determine".  A state is a multiset; two roles bound to one person act
%% together there; and a predicate of arity one the contract declares
%% reflexive holds at every person of that person, so an atom of it naming the
%% participant is no requirement there, and one forbidden there leaves the
%% schema-binding determining no transaction.  A schema-binding determining no
%% transaction, an atom both required and forbidden at a participant, is of no
%% class.
%%
%% The condition is read as comparing, for two transactions of a class, the
%% collections of the sets of people marked by all the schema-bindings
%% determining each: the sentence speaks of "sets", and its example needs it,
%% "unfriending, whose schema determines the same transaction at the binding of
%% either party first, is one class guarded by either party", unfriend(p, q)
%% marking p and unfriend(q, p) marking q, each transaction of the class
%% determined by both (as CSSN #5 reads it, Code_inbox.md, 2026-10-18 21:52
%% UTC).  So, M being the sets the schema-bindings of a class mark, the
%% transactions of the class all carry the same sets exactly when each carries
%% every set of M:
%% for each schema-binding S of the class and each set m of M, every
%% transaction S determines is determined by a schema-binding of the class
%% marking m.  A transaction S determines is S's deleted and added atoms at a
%% state in its domain at every participant, the atoms S requires there
%% present, as a multiset, and those it forbids absent; so the condition fails
%% at S and m exactly when some state of the domain of S lies outside the
%% domain of each schema-binding marking m, each of them missing an atom it
%% requires, in its count, or holding an atom it forbids, at some participant
%% (marks_cover, uncovered).  Every schema-binding of every schema is, up to
%% renaming, one of the bindings below, so the condition is decided at those.
%% A class one of whose schema-bindings leaves a variable free, a variable of
%% no deleted or added atom, has a part for each person and speech act it is
%% sent to; the contract is then not effective (below), and the condition is
%% not decided for the class.
%%
%% The class of a schema-binding, from the sentence quoted above (vGLP #14,
%% 2026-10-18 12:24 UTC, C): two schema-bindings are of one class when a chain
%% of schema-bindings links them, each two consecutive ones determining a
%% common transaction --- the same participants, the same deleted and added
%% atoms at each (GSC, Definition "Compilation"), and no atom one requires at
%% a participant that the other forbids there, a transaction both determine
%% holding at each participant the atoms both require and none either
%% forbids.  A class is not every schema-binding of the same participants and
%% the same deleted and added atoms (vGLP #8, 2026-10-11 17:24 UTC, Q-A, a
%% reading withdrawn): CSSN's child_befriend(0, 1, 2, 2) and
%% child_adult_befriend(0, 1, 2), one requiring child at participant 1 and the
%% other forbidding it there, are two classes.
%%
%% The schemas name no person (GSC, Proposition "Anonymity"), so the bindings
%% of a schema are taken up to renaming: its roles and party variables sent to
%% people person(0), person(1), ... in order of first use, every partition of
%% them a binding; its speech-act variables to speech acts sp(U, S), S the
%% signer, one of those people or one person more, whom no other variable
%% names, and U an utterance, utt(N), in order of first use --- "a speech act
%% being an utterance or a speech act, signed; a signed term sgn(y, i) in an
%% added atom is the speech act bound to y, signed by the person in role i"
%% (vGLP 9c819f5, Section 5.4, "Act schemas as local specifications"; GSC
%% 63b301f, Section 3, Definitions "Act schema" and "Binding", beta(sgn(y, pi))
%% := (beta(y), beta(pi))), so the image of sgn(y, i) under a binding is
%% sp(beta(y), beta(i)), a speech act whose utterance is a speech act, and
%% sgn(y, i) matches such a speech act, y bound to the inner one and role i to
%% its signer (match_sgn), and no other.  For each such binding that
%% is one (GSC, Definition "Binding") and determines a transaction (GSC,
%% Definition "Compilation": the added and the deleted atoms of each person
%% disjoint), its mates, the schema-bindings of the same participants and the
%% same deleted and added atoms, are found by sending every schema's roles
%% onto its participants and matching the atoms they delete and add; a
%% variable of no deleted or added atom is left free, free_var(V), and a mate
%% with one stands for its completions, the schema-bindings sending the
%% variable anywhere.  The class is the mates a chain links to the binding
%% (class_mates), two mates being linked when no atom with no free variable
%% one requires at a participant the other forbids there (linked): the
%% completions of a mate that send each free variable to a person or speech
%% act no atom of the class names are linked exactly when its atoms with no
%% free variable are, an atom naming such a person being no atom of another
%% schema-binding of the class, and every other completion is linked to
%% those, so a mate is in the class with all its completions or with none.  A
%% mate requiring and forbidding one atom at a participant, the same free
%% variable in both, determines no transaction at any completion and is of no
%% class (live_at).
%%
%% Simple guards: the guard sets of a class are "the minimal sets among the
%% people in the marked roles of its schema-bindings", and the specification
%% has simple guards "if every class has one guard set, all of whose members
%% must will it, or guard sets of one person each"; a class with two minimal
%% guard sets not both of one person is refused, two schema-bindings with such
%% sets named (vGLP 2026-10-11 22:59 UTC, Q1, Udi approved).
%%
%% Effective: "The contract is effective (Definition "Effective Local
%% Specification") where, moreover, every variable of a schema that occurs in an atom it
%% requires or forbids also occurs in an atom it deletes or adds, a variable
%% inside a signed term included, so that a class has finitely many parts, and
%% the atoms each unguarded schema requires at its first role name every other
%% role and every variable of its deleted and added atoms" (vGLP c0bea08,
%% Section 5.4).  A variable here is a party variable or a speech-act variable,
%% the sentence naming roles and variables apart, "every other role and every
%% variable", and a role being bound to one of the finitely many participants;
%% a signed term sgn(y, i) in a deleted or added atom holds the variable y and
%% names role i (GSC, Section 3: "An atom names what is among its arguments or
%% is the signer of one"), so y is a variable of the atom.  Otherwise the
%% contract is refused, the schema named.  A class is unguarded where one of
%% its schema-bindings has no marked role, the empty set then its one minimal
%% guard set.

%% A speech act sp(U, S): its utterance U, utt(N) or a speech act, and its
%% signer S (GSC, Section 3: "A speech act is an utterance or a speech act,
%% signed by a person").
Utt      ::= utt(Integer) ; Sp.
Sp       ::= sp(Utt, Integer).
Val      ::= person(Integer) ; Sp ; free_var(Arg).
SgnParts ::= signed(Val, Integer) ; unsigned.
Vals     ::= [] ; [Val | Vals].
Bnd      ::= bnd(Arg, Val).
Binding  ::= [] ; [Bnd | Binding].
Bindings ::= [] ; [Binding | Bindings].
GA       ::= ga(Constant, Vals).
GAs      ::= [] ; [GA | GAs].
%% A participant and the atoms its roles delete and add, joined.
Delta    ::= delta(Integer, GAs, GAs).
Deltas   ::= [] ; [Delta | Deltas].
Mate     ::= mate(Constant, RoleSpecs, Binding).
Mates    ::= [] ; [Mate | Mates].
Found    ::= found(Val) ; unbound.
Match    ::= match(Binding) ; nomatch.
Pair     ::= marks_differ(Constant, RoleSpecs, Binding, Constant, RoleSpecs, Binding)
           ; nonsimple(Constant, RoleSpecs, Binding, Constant, RoleSpecs, Binding).
Pairs    ::= [] ; [Pair | Pairs].
Gd       ::= gd(Constant, RoleSpecs, Binding, Ints).
Gds      ::= [] ; [Gd | Gds].
GdRes    ::= gdf(Gd) ; nogd.
IntSets  ::= [] ; [Ints | IntSets].
%% The domain of a schema-binding at a participant P: the atoms required
%% there, as a multiset, and those forbidden.  A literal of a schema-binding at
%% P, which a state outside its domain breaks: an atom A required there C
%% times, lreq(P, A, C), broken by fewer than C of A at P; and an atom A
%% forbidden there, lforb(P, A), broken by A at P.
Dom      ::= dom(Integer, GAs, GAs).
Doms     ::= [] ; [Dom | Doms].
Lit      ::= lreq(Integer, GA, Integer) ; lforb(Integer, GA).
Lits     ::= [] ; [Lit | Lits].
Litss    ::= [] ; [Lits | Litss].
Cnt      ::= cnt(GA, Integer).
Cnts     ::= [] ; [Cnt | Cnts].
Bound    ::= unbounded ; upto(Integer).

exported procedure faults(Contract?, Preds?, Stream(_)).
faults(C, Rf, Ls?) :- ground(C?), ground(Rf?) |
    local_pairs(C?, C?, Rf?, Ps),
    pair_lines(Ps?, L1),
    effective_lines(C?, L2),
    lapp(L1?, L2?, Ls).

%% The first pair found of each kind is named: not local, not simple.
procedure pair_lines(Pairs?, Stream(_)).
pair_lines(Ps, L?) :- ground(Ps?) |
    first_of(marks_differ, Ps?, F1),
    first_of(nonsimple, Ps?, F2),
    fault_lines(F1?, L1),
    fault_lines(F2?, L2),
    lapp(L1?, L2?, L).
procedure kind_of(Pair?, Constant).
kind_of(marks_differ(_, _, _, _, _, _), marks_differ).
kind_of(nonsimple(_, _, _, _, _, _), nonsimple).
procedure first_of(Constant?, Pairs?, Pairs).
first_of(_, [], []).
first_of(K, [P|Ps], F?) :- ground(K?), ground(P?) |
    kind_of(P?, K1),
    first_of1(K1?, K?, P?, Ps?, F).
procedure first_of1(Constant?, Constant?, Pair?, Pairs?, Pairs).
first_of1(K1, K, P, _, [P?]) :- K1? =?= K? | true.
first_of1(_, K, _, Ps, F?) :- otherwise | first_of(K?, Ps?, F).
procedure fault_lines(Pairs?, Stream(_)).
fault_lines([], []).
fault_lines([marks_differ(N1, Rs1, B1, N2, Rs2, B2)|_],
        ['%% it is not a local specification (vGLP, Section 5.4, the paragraph on act schemas,',
         '%% its condition): the schema-bindings determining two transactions of one class mark',
         '%% different sets of people, the first schema-binding below determining a transaction',
         '%% that no schema-binding of its class marking the people the second marks determines:',
         T1?, T2?]) :-
    two_terms(N1?, Rs1?, B1?, N2?, Rs2?, B2?, T1, T2).
fault_lines([nonsimple(N1, Rs1, B1, N2, Rs2, B2)|_],
        ['%% it does not have simple guards (vGLP, Section 3.2, the paragraph after Definition',
         '%% "Volition-Guarded Specification"): a class has two minimal guard sets, not both of',
         '%% one person, those of the marked roles of these schema-bindings:',
         T1?, T2?]) :-
    two_terms(N1?, Rs1?, B1?, N2?, Rs2?, B2?, T1, T2).
procedure two_terms(Constant?, RoleSpecs?, Binding?, Constant?, RoleSpecs?, Binding?, _, _).
two_terms(N1, Rs1, B1, N2, Rs2, B2, T1?, T2?) :-
    ground(N1?), ground(Rs1?), ground(B1?), ground(N2?), ground(Rs2?), ground(B2?) |
    sb_term(N1?, Rs1?, B1?, S1),
    sb_term(N2?, Rs2?, B2?, S2),
    T1 =.. ['%% the schema-binding', S1?],
    T2 =.. ['%% and the schema-binding', S2?].

%% A schema-binding as the schema's name applied to the values of its
%% variables, in programs/gsc's order; free for a variable it leaves free.
procedure sb_term(Constant?, RoleSpecs?, Binding?, _).
sb_term(Nm, Rs, B, T?) :- ground(Nm?), ground(B?) |
    schema_vars(Rs?, Vs),
    vals_of(Vs?, B?, Xs),
    T =.. [Nm?|Xs?].
procedure vals_of(Args?, Binding?, Stream(_)).
vals_of([], _, []).
vals_of([V|Vs], B, [X?|Xs?]) :- ground(B?) |
    lookup(V?, B?, F),
    shown_val(F?, X),
    vals_of(Vs?, B?, Xs).
procedure shown_val(Found?, _).
shown_val(found(person(I)), person(I?)).
shown_val(found(sp(U, S)), sp(U?, S?)).
shown_val(found(free_var(_)), free).
shown_val(unbound, free).
%% The value of a variable in a binding; a variable the binding leaves free
%% is its own value, free_var(V), one fresh person or speech act per variable.
procedure val_or_free(Found?, Arg?, Val).
val_or_free(found(X), _, X?).
val_or_free(unbound, V, free_var(V?)).

%% --- Effective -------------------------------------------------------------
%% Each schema: every variable of an atom it requires or forbids a variable of
%% an atom it deletes or adds (free_lines); and, where it marks no role, the
%% atoms its first role requires naming every other role and every variable of
%% its deleted and added atoms (effective_one).
procedure effective_lines(Contract?, Stream(_)).
effective_lines([], []).
effective_lines([schema(Nm, Rs)|Ss], L?) :- ground(Nm?), ground(Rs?) |
    free_lines(Nm?, Rs?, L0),
    guarded_any(Rs?, G),
    effective_one(G?, Nm?, Rs?, L1),
    effective_lines(Ss?, L2),
    lapp(L1?, L2?, L12),
    lapp(L0?, L12?, L).
effective_lines([cschema(_, _, _)|Ss], L?) :- effective_lines(Ss?, L).
procedure guarded_any(RoleSpecs?, YesNo).
guarded_any([], no).
guarded_any([R|Rs], B?) :- rs_guarded(R?, B1), guarded_any1(B1?, Rs?, B).
procedure guarded_any1(YesNo?, RoleSpecs?, YesNo).
guarded_any1(yes, _, yes).
guarded_any1(no, Rs, B?) :- guarded_any(Rs?, B).

%% A variable of an atom the schema requires or forbids, at any role, that no
%% atom it deletes or adds holds, a signed term's variable included.
procedure free_lines(Constant?, RoleSpecs?, Stream(_)).
free_lines(Nm, Rs, L?) :- ground(Nm?), ground(Rs?) |
    kept_forbidden_args(Rs?, Kf0),
    flat_args(Kf0?, Kf1),
    variables_of(Kf1?, Kf),
    changed_args(Rs?, Ch0),
    flat_args(Ch0?, Ch),
    first_absent(Kf?, Ch?, F),
    free_lines1(F?, Nm?, L).
procedure free_lines1(Args?, Constant?, Stream(_)).
free_lines1([], _, []).
free_lines1([V|_], Nm, ['%% it is not effective (vGLP, Section 5.4, the paragraph on act schemas): a variable of',
        '%% the schema occurs in an atom it requires or forbids and in no atom it deletes or adds:',
        T?]) :-
    ground(Nm?), ground(V?) | T =.. ['%% the schema and the variable', Nm?, V?].
procedure kept_forbidden_args(RoleSpecs?, Args).
kept_forbidden_args([], []).
kept_forbidden_args([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, _, _, K, N),
    atoms_args(K?, A1),
    atoms_args(N?, A2),
    kept_forbidden_args(Rs?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, As).
%% The party and speech-act variables among the arguments.
procedure variables_of(Args?, Args).
variables_of([], []).
variables_of([pvar(X)|As], [pvar(X?)|R?]) :- variables_of(As?, R).
variables_of([svar(X)|As], [svar(X?)|R?]) :- variables_of(As?, R).
variables_of([role(_)|As], R?) :- variables_of(As?, R).
variables_of([nterm(_)|As], R?) :- variables_of(As?, R).
variables_of([sgn(_, _)|As], R?) :- variables_of(As?, R).
%% The arguments with each signed term sgn(y, i) taken as its variable y and
%% its role i, which it names.
procedure flat_args(Args?, Args).
flat_args([], []).
flat_args([sgn(Y, I)|As], [svar(Y?), role(I?)|R?]) :- flat_args(As?, R).
flat_args([A|As], [A?|R?]) :- otherwise | flat_args(As?, R).
%% The first argument of the first list absent from the second; none, [].
procedure first_absent(Args?, Args?, Args).
first_absent([], _, []).
first_absent([A|As], Ch, F?) :- ground(A?), ground(Ch?) |
    mem(A?, Ch?, In),
    first_absent1(In?, A?, As?, Ch?, F).
procedure first_absent1(YesNo?, Arg?, Args?, Args?, Args).
first_absent1(no, A, _, _, [A?]).
first_absent1(yes, _, As, Ch, F?) :- first_absent(As?, Ch?, F).

procedure effective_one(YesNo?, Constant?, RoleSpecs?, Stream(_)).
effective_one(yes, _, _, []).
effective_one(no, Nm, Rs, L?) :- ground(Rs?), ground(Nm?) |
    first_required_args(Rs?, Fa0),
    flat_args(Fa0?, Fa),
    rs_count(Rs?, K),
    role_args(2, K?, Others),
    changed_args(Rs?, Ch0),
    flat_args(Ch0?, Ch),
    drop_role_one(Ch?, Ch1),
    app(Others?, Ch1?, Need),
    all_member(Need?, Fa?, Ok),
    effective_one1(Ok?, Nm?, L).
procedure effective_one1(YesNo?, Constant?, Stream(_)).
effective_one1(yes, _, []).
effective_one1(no, Nm, ['%% it is not effective (vGLP, Section 5.4, the paragraph on act schemas): an unguarded',
        '%% schema whose first role requires no atom naming some other role, or some variable of',
        '%% an atom it deletes or adds:', T?]) :-
    ground(Nm?) | T =.. ['%% the schema', Nm?].
procedure first_required_args(RoleSpecs?, Args).
first_required_args([], []).
first_required_args([R|_], As?) :- ground(R?) |
    rs_lists(R?, _, M, K, _),
    atoms_args(K?, A1),
    atoms_args(M?, A2),
    app(A1?, A2?, As).
procedure changed_args(RoleSpecs?, Args).
changed_args([], []).
changed_args([R|Rs], As?) :- ground(R?) |
    rs_lists(R?, P, M, _, _),
    atoms_args(P?, A1),
    atoms_args(M?, A2),
    changed_args(Rs?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, As).
procedure drop_role_one(Args?, Args).
drop_role_one([], []).
drop_role_one([role(I)|As], R?) :- I? =:= 1 | drop_role_one(As?, R).
drop_role_one([A|As], [A?|R?]) :- otherwise | drop_role_one(As?, R).
procedure all_member(Args?, Args?, YesNo).
all_member([], _, yes).
all_member([A|As], Fa, B?) :- ground(Fa?) | mem(A?, Fa?, B1), all_member1(B1?, As?, Fa?, B).
procedure all_member1(YesNo?, Args?, Args?, YesNo).
all_member1(no, _, _, no).
all_member1(yes, As, Fa, B?) :- all_member(As?, Fa?, B).

%% --- The request type -------------------------------------------------------
%% The schemas whose terms name parts of guarded classes: the request type has
%% "the alternative propose([t]_j) for each part [t]_j of a guarded class"
%% (vGLP c0bea08, Section 5.4, the compilation), so cvac.glp prints the
%% alternatives of these schemas in it.  A schema is one of them where it
%% marks a role and some binding of it, taken up to renaming as for locality,
%% determines a transaction and is of a guarded class.  A class is unguarded
%% where one of its schema-bindings has no marked role, so a schema marking no
%% role names parts of unguarded classes only, and a schema marking a role may,
%% as gnudge's g, one class with its nudge.
exported procedure proposable(Contract?, Preds?, Preds).
proposable(C, Rf, Ns?) :- ground(C?), ground(Rf?) | proposable1(C?, C?, Rf?, Ns).
procedure proposable1(Contract?, Contract?, Preds?, Preds).
proposable1([], _, _, []).
proposable1([schema(Nm, Rs)|Ss], C, Rf, Ns?) :-
    ground(Nm?), ground(Rs?), ground(C?), ground(Rf?) |
    guarded_any(Rs?, G),
    proposable_schema(G?, Nm?, Rs?, C?, Rf?, P),
    proposable1(Ss?, C?, Rf?, Ns1),
    keep_name(P?, Nm?, Ns1?, Ns).
proposable1([cschema(_, _, _)|Ss], C, Rf, Ns?) :- proposable1(Ss?, C?, Rf?, Ns).
procedure proposable_schema(YesNo?, Constant?, RoleSpecs?, Contract?, Preds?, YesNo).
proposable_schema(no, _, _, _, _, no).
proposable_schema(yes, Nm, Rs, C, Rf, P?) :- ground(Rs?) |
    canon_bindings(Rs?, Bs),
    some_guarded(Bs?, Nm?, Rs?, C?, Rf?, P).
procedure some_guarded(Bindings?, Constant?, RoleSpecs?, Contract?, Preds?, YesNo).
some_guarded([], _, _, _, _, no).
some_guarded([B|Bs], Nm, Rs, C, Rf, P?) :-
    ground(B?), ground(Nm?), ground(Rs?), ground(C?), ground(Rf?) |
    sig_of(Rs?, B?, Pt),
    binding_guarded(Pt?, B?, Nm?, Rs?, C?, Rf?, G),
    some_guarded1(G?, Bs?, Nm?, Rs?, C?, Rf?, P).
procedure some_guarded1(YesNo?, Bindings?, Constant?, RoleSpecs?, Contract?, Preds?, YesNo).
some_guarded1(yes, _, _, _, _, _, yes).
some_guarded1(no, Bs, Nm, Rs, C, Rf, P?) :- some_guarded(Bs?, Nm?, Rs?, C?, Rf?, P).
%% A schema-binding of a guarded class: it determines a transaction, as for
%% locality (binding_pairs), and every schema-binding of its class marks a role.
procedure binding_guarded(Deltas?, Binding?, Constant?, RoleSpecs?, Contract?, Preds?, YesNo).
binding_guarded(Pt, B, Nm, Rs, C, Rf, G?) :- ground(Pt?), ground(Rs?), ground(B?), ground(Rf?) |
    deltas_valid(Pt?, V1),
    deltas_people(Pt?, Q),
    live_at(Q?, Rs?, B?, Rf?, V2),
    and(V1?, V2?, V),
    binding_guarded1(V?, Pt?, B?, Nm?, Rs?, C?, Rf?, G).
procedure binding_guarded1(YesNo?, Deltas?, Binding?, Constant?, RoleSpecs?, Contract?, Preds?,
    YesNo).
binding_guarded1(no, _, _, _, _, _, _, no).
binding_guarded1(yes, Pt, B, Nm, Rs, C, Rf, G?) :- ground(Pt?), ground(Rf?) |
    mates_of(C?, Pt?, Rf?, Ms),
    deltas_people(Pt?, Q),
    class_mates(Ms?, Nm?, Rs?, B?, Q?, Rf?, Cls),
    mates_guards(Cls?, Gs),
    some_unguarded(Gs?, Ug),
    neg(Ug?, G).
procedure keep_name(YesNo?, Constant?, Preds?, Preds).
keep_name(yes, Nm, Ns, [Nm?|Ns?]).
keep_name(no, _, Ns, Ns?).

%% --- Local -----------------------------------------------------------------
procedure local_pairs(Contract?, Contract?, Preds?, Pairs).
local_pairs([], _, _, []).
local_pairs([schema(Nm, Rs)|Ss], C, Rf, Ps?) :- ground(Nm?), ground(Rs?), ground(C?), ground(Rf?) |
    canon_bindings(Rs?, Bs),
    bindings_pairs(Bs?, Nm?, Rs?, C?, Rf?, P1),
    local_pairs(Ss?, C?, Rf?, P2),
    app(P1?, P2?, Ps).
local_pairs([cschema(_, _, _)|Ss], C, Rf, Ps?) :- local_pairs(Ss?, C?, Rf?, Ps).

procedure bindings_pairs(Bindings?, Constant?, RoleSpecs?, Contract?, Preds?, Pairs).
bindings_pairs([], _, _, _, _, []).
bindings_pairs([B|Bs], Nm, Rs, C, Rf, Ps?) :-
    ground(B?), ground(Nm?), ground(Rs?), ground(C?), ground(Rf?) |
    sig_of(Rs?, B?, Pt),
    binding_pairs(Pt?, B?, Nm?, Rs?, C?, Rf?, P1),
    bindings_pairs(Bs?, Nm?, Rs?, C?, Rf?, P2),
    app(P1?, P2?, Ps).
%% A schema-binding takes part in a class only where it determines a
%% transaction: its added and deleted atoms disjoint at each participant, and
%% its requirements there satisfiable, no atom both required and forbidden,
%% and no atom of a reflexive predicate naming the participant forbidden there
%% (vGLP, Section 5.4, the paragraph on act schemas: for the part [t]_j of a
%% schema-binding, f is defined at d_p iff the schema-binding has the atoms it
%% requires at p in d_p, with the atoms of the reflexive predicates naming p,
%% and those it forbids there not).
procedure binding_pairs(Deltas?, Binding?, Constant?, RoleSpecs?, Contract?, Preds?, Pairs).
binding_pairs(Pt, B, Nm, Rs, C, Rf, Ps?) :- ground(Pt?), ground(Rs?), ground(B?), ground(Rf?) |
    deltas_valid(Pt?, V1),
    deltas_people(Pt?, Q),
    live_at(Q?, Rs?, B?, Rf?, V2),
    and(V1?, V2?, V),
    binding_pairs1(V?, Pt?, B?, Nm?, Rs?, C?, Rf?, Ps).
procedure binding_pairs1(YesNo?, Deltas?, Binding?, Constant?, RoleSpecs?, Contract?, Preds?,
    Pairs).
binding_pairs1(no, _, _, _, _, _, _, []).
%% The class of the schema-binding, the mates a chain links to it, and at it
%% the condition, the sets its class marks carried by every transaction it
%% determines; and the minimal guard sets of its class.
binding_pairs1(yes, Pt, B, Nm, Rs, C, Rf, Ps?) :-
    ground(Pt?), ground(Rf?), ground(B?), ground(Rs?), ground(Nm?) |
    mates_of(C?, Pt?, Rf?, Ms),
    deltas_people(Pt?, Q),
    deltas_people(Pt?, Q1),
    class_mates(Ms?, Nm?, Rs?, B?, Q?, Rf?, Cls),
    class_faults(Cls?, Q1?, Nm?, Rs?, B?, Rf?, Ps).
procedure class_faults(Mates?, Ints?, Constant?, RoleSpecs?, Binding?, Preds?, Pairs).
class_faults(Ms, Q, Nm, Rs, B, Rf, Ps?) :- ground(Ms?), ground(Q?) |
    marks_fault(Ms?, Q?, Nm?, Rs?, B?, Rf?, P1),
    mates_guards(Ms?, Gs),
    simple_fault(Gs?, P2),
    app(P1?, P2?, Ps).

%% --- The condition: the sets of people marked, per transaction ------------
%% marks_fault(Ms, Q, Nm, Rs, B, Rf, Ps): for the schema-binding (Nm, Rs, B)
%% of the class Ms, of the participants Q, and each set m of people a
%% schema-binding of the class marks, every transaction (Nm, Rs, B) determines
%% is determined by a schema-binding of the class marking m; where one is not,
%% the schema-binding and one marking m named.  A class with a schema-binding
%% leaving a variable free is not decided (the header).
procedure marks_fault(Mates?, Ints?, Constant?, RoleSpecs?, Binding?, Preds?, Pairs).
marks_fault(Ms, Q, Nm, Rs, B, Rf, Ps?) :- ground(Ms?), ground(Q?), ground(Rf?) |
    any_open(Ms?, Q?, Rf?, Op),
    marks_fault1(Op?, Ms?, Q?, Nm?, Rs?, B?, Rf?, Ps).
procedure marks_fault1(YesNo?, Mates?, Ints?, Constant?, RoleSpecs?, Binding?, Preds?, Pairs).
marks_fault1(yes, _, _, _, _, _, _, []).
marks_fault1(no, Ms, Q, Nm, Rs, B, Rf, Ps?) :- ground(Ms?), ground(Rs?), ground(B?) |
    mates_guards(Ms?, Gs),
    marks_fault2(Gs?, Q?, Nm?, Rs?, B?, Rf?, Ps).
procedure marks_fault2(Gds?, Ints?, Constant?, RoleSpecs?, Binding?, Preds?, Pairs).
marks_fault2(Gs, Q, Nm, Rs, B, Rf, Ps?) :-
    ground(Gs?), ground(Q?), ground(Rs?), ground(B?), ground(Rf?) |
    gd_sets(Gs?, Ss0),
    dedup(Ss0?, Ss),
    guard_set(Rs?, B?, G),
    domain_of(Q?, Rs?, B?, Rf?, Dm),
    marks_cover(Ss?, G?, Gs?, Q?, Dm?, Rf?, Nm?, Rs?, B?, Ps).
%% For each set M of the class's, unless it is the schema-binding's own: the
%% schema-bindings of the class marking M, and whether some state of the
%% schema-binding's domain lies outside each of their domains.
procedure marks_cover(IntSets?, Ints?, Gds?, Ints?, Doms?, Preds?, Constant?, RoleSpecs?,
    Binding?, Pairs).
marks_cover([], _, _, _, _, _, _, _, _, []).
marks_cover([M|Ms], G, Gs, Q, Dm, Rf, Nm, Rs, B, Ps?) :-
    ground(M?), ground(G?), ground(Gs?), ground(Q?), ground(Dm?), ground(Rf?) |
    same_set(M?, G?, Own),
    marks_cover1(Own?, M?, Ms?, G?, Gs?, Q?, Dm?, Rf?, Nm?, Rs?, B?, Ps).
procedure marks_cover1(YesNo?, Ints?, IntSets?, Ints?, Gds?, Ints?, Doms?, Preds?, Constant?,
    RoleSpecs?, Binding?, Pairs).
marks_cover1(yes, _, Ms, G, Gs, Q, Dm, Rf, Nm, Rs, B, Ps?) :-
    marks_cover(Ms?, G?, Gs?, Q?, Dm?, Rf?, Nm?, Rs?, B?, Ps).
marks_cover1(no, M, Ms, G, Gs, Q, Dm, Rf, Nm, Rs, B, Ps?) :-
    ground(M?), ground(Gs?), ground(Q?), ground(Rf?), ground(Dm?) |
    marking(Gs?, M?, Ks),
    marking(Gs?, M?, Ks1),
    lits_all(Ks?, Q?, Rf?, Lss),
    uncovered(Lss?, Dm?, [], U),
    marks_cover2(U?, Ks1?, Ms?, G?, Gs?, Q?, Dm?, Rf?, Nm?, Rs?, B?, Ps).
procedure marks_cover2(YesNo?, Gds?, IntSets?, Ints?, Gds?, Ints?, Doms?, Preds?, Constant?,
    RoleSpecs?, Binding?, Pairs).
marks_cover2(yes, [gd(N2, Rs2, B2, _)|_], _, _, _, _, _, _, Nm, Rs, B,
        [marks_differ(Nm?, Rs?, B?, N2?, Rs2?, B2?)]).
marks_cover2(yes, [], Ms, G, Gs, Q, Dm, Rf, Nm, Rs, B, Ps?) :-
    marks_cover(Ms?, G?, Gs?, Q?, Dm?, Rf?, Nm?, Rs?, B?, Ps).
marks_cover2(no, _, Ms, G, Gs, Q, Dm, Rf, Nm, Rs, B, Ps?) :-
    marks_cover(Ms?, G?, Gs?, Q?, Dm?, Rf?, Nm?, Rs?, B?, Ps).
procedure gd_sets(Gds?, IntSets).
gd_sets([], []).
gd_sets([gd(_, _, _, G)|Gs], [G?|Ss?]) :- gd_sets(Gs?, Ss).
procedure marking(Gds?, Ints?, Gds).
marking([], _, []).
marking([gd(N, Rs, B, G)|Gs], M, Ks?) :- ground(G?), ground(M?) |
    same_set(G?, M?, In),
    marking(Gs?, M?, Ks1),
    keep_gd1(In?, gd(N?, Rs?, B?, G?), Ks1?, Ks).
procedure keep_gd1(YesNo?, Gd?, Gds?, Gds).
keep_gd1(yes, X, Ks, [X?|Ks?]).
keep_gd1(no, _, Ks, Ks?).
%% The people in the marked roles of a schema-binding, a set, ascending.
procedure guard_set(RoleSpecs?, Binding?, Ints).
guard_set(Rs, B, G?) :- ground(Rs?), ground(B?) |
    guard_people(Rs?, 1, B?, G0),
    sort_ints(G0?, G1),
    dedup(G1?, G).
%% Whether a schema-binding of the class requires or forbids, at a
%% participant, an atom with a variable it leaves free.
procedure any_open(Mates?, Ints?, Preds?, YesNo).
any_open([], _, _, no).
any_open([mate(_, Rs, B)|Ms], Q, Rf, Op?) :- ground(Rs?), ground(B?), ground(Q?), ground(Rf?) |
    open_at(Q?, Rs?, B?, Rf?, O1),
    any_open1(O1?, Ms?, Q?, Rf?, Op).
procedure any_open1(YesNo?, Mates?, Ints?, Preds?, YesNo).
any_open1(yes, _, _, _, yes).
any_open1(no, Ms, Q, Rf, Op?) :- any_open(Ms?, Q?, Rf?, Op).
procedure open_at(Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
open_at([], _, _, _, no).
open_at([P|Ps], Rs, B, Rf, Op?) :- ground(Rs?), ground(B?), ground(Rf?), integer(P?) |
    reqs_at(Rs?, B?, P?, Rf?, R),
    forbs_at(Rs?, B?, P?, F),
    open_atoms(R?, O1),
    open_atoms(F?, O2),
    or(O1?, O2?, O12),
    open_at1(O12?, Ps?, Rs?, B?, Rf?, Op).
procedure open_at1(YesNo?, Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
open_at1(yes, _, _, _, _, yes).
open_at1(no, Ps, Rs, B, Rf, Op?) :- open_at(Ps?, Rs?, B?, Rf?, Op).

%% The domain of a schema-binding at each participant: its required atoms,
%% a multiset, and its forbidden ones.
procedure domain_of(Ints?, RoleSpecs?, Binding?, Preds?, Doms).
domain_of([], _, _, _, []).
domain_of([P|Ps], Rs, B, Rf, [dom(P?, R?, F?)|Ds?]) :- ground(Rs?), ground(B?), ground(Rf?), integer(P?) |
    reqs_at(Rs?, B?, P?, Rf?, R),
    forbs_at(Rs?, B?, P?, F0),
    dedup(F0?, F),
    domain_of(Ps?, Rs?, B?, Rf?, Ds).
%% The literals of each schema-binding marking the set: per participant, each
%% atom it requires with its count, and each atom it forbids.
procedure lits_all(Gds?, Ints?, Preds?, Litss).
lits_all([], _, _, []).
lits_all([gd(_, Rs, B, _)|Ks], Q, Rf, [L?|Ls?]) :- ground(Q?), ground(Rf?) |
    domain_of(Q?, Rs?, B?, Rf?, Dm),
    dom_lits(Dm?, L),
    lits_all(Ks?, Q?, Rf?, Ls).
procedure dom_lits(Doms?, Lits).
dom_lits([], []).
dom_lits([dom(P, R, F)|Ds], L?) :- ground(R?), ground(F?), integer(P?) |
    counts(R?, Cs),
    req_lits(Cs?, P?, L1),
    forb_lits(F?, P?, L2),
    dom_lits(Ds?, L3),
    app(L2?, L3?, L23),
    app(L1?, L23?, L).
procedure req_lits(Cnts?, Integer?, Lits).
req_lits([], _, []).
req_lits([cnt(A, C)|Cs], P, [lreq(P?, A?, C?)|L?]) :- integer(P?) | req_lits(Cs?, P?, L).
procedure forb_lits(GAs?, Integer?, Lits).
forb_lits([], _, []).
forb_lits([A|As], P, [lforb(P?, A?)|L?]) :- integer(P?) | forb_lits(As?, P?, L).
%% Each atom of a multiset with its count.
procedure counts(GAs?, Cnts).
counts([], []).
counts([A|As], [cnt(A?, C?)|Cs?]) :- ground(A?), ground(As?) |
    count_of(A?, As?, 1, C),
    remove_all(A?, As?, As1),
    counts(As1?, Cs).
procedure count_of(GA?, GAs?, Integer?, Integer).
count_of(_, [], N, N?).
count_of(A, [X|Xs], N, C?) :- A? =?= X? | N1 := N? + 1, count_of(A?, Xs?, N1?, C).
count_of(A, [_|Xs], N, C?) :- otherwise | count_of(A?, Xs?, N?, C).

%% uncovered(Lss, Dm, Ch, U): whether a state of the domain Dm breaks a literal
%% of each list of Lss, each schema-binding's, consistently with the literals
%% Ch chosen for those before: at each participant and atom, at least as many
%% as Dm requires and one where a forbidden atom is chosen broken, and fewer
%% than each count chosen broken and none where Dm forbids it.
procedure uncovered(Litss?, Doms?, Lits?, YesNo).
uncovered([], _, _, yes).
uncovered([L|Lss], Dm, Ch, U?) :- ground(L?), ground(Dm?), ground(Ch?) |
    break_one(L?, Lss?, Dm?, Ch?, U).
procedure break_one(Lits?, Litss?, Doms?, Lits?, YesNo).
break_one([], _, _, _, no).
break_one([X|Xs], Lss, Dm, Ch, U?) :- ground(X?), ground(Dm?), ground(Ch?) |
    consistent(X?, Dm?, Ch?, C),
    break_one1(C?, X?, Xs?, Lss?, Dm?, Ch?, U).
procedure break_one1(YesNo?, Lit?, Lits?, Litss?, Doms?, Lits?, YesNo).
break_one1(no, _, Xs, Lss, Dm, Ch, U?) :- break_one(Xs?, Lss?, Dm?, Ch?, U).
break_one1(yes, X, Xs, Lss, Dm, Ch, U?) :- ground(Lss?), ground(Dm?), ground(Ch?) |
    uncovered(Lss?, Dm?, [X?|Ch?], U1),
    break_one2(U1?, Xs?, Lss?, Dm?, Ch?, U).
procedure break_one2(YesNo?, Lits?, Litss?, Doms?, Lits?, YesNo).
break_one2(yes, _, _, _, _, yes).
break_one2(no, Xs, Lss, Dm, Ch, U?) :- break_one(Xs?, Lss?, Dm?, Ch?, U).
%% A literal broken consistently with the domain and the literals chosen.
procedure consistent(Lit?, Doms?, Lits?, YesNo).
consistent(lreq(P, A, C), Dm, Ch, R?) :- ground(A?), ground(Dm?), ground(Ch?), integer(P?), integer(C?) |
    dom_at(Dm?, P?, Rq, Fb),
    count_in(A?, Rq?, Lo0),
    forb_chosen(Ch?, P?, A?, Fc),
    lo_of(Fc?, Lo0?, Lo),
    mem(A?, Fb?, Fd),
    C1 := C? - 1,
    hi_of(Fd?, C1?, Hi0),
    hi_chosen(Ch?, P?, A?, Hi0?, Hi),
    within(Lo?, Hi?, R).
consistent(lforb(P, A), Dm, Ch, R?) :- ground(A?), ground(Dm?), ground(Ch?), integer(P?) |
    dom_at(Dm?, P?, Rq, Fb),
    mem(A?, Fb?, Fd),
    consistent_forb(Fd?, P?, A?, Rq?, Ch?, R).
procedure consistent_forb(YesNo?, Integer?, GA?, GAs?, Lits?, YesNo).
consistent_forb(yes, _, _, _, _, no).
consistent_forb(no, P, A, Rq, Ch, R?) :- ground(A?), ground(Rq?), ground(Ch?) |
    count_in(A?, Rq?, Lo0),
    max_int(Lo0?, 1, Lo),
    hi_chosen(Ch?, P?, A?, unbounded, Hi),
    within(Lo?, Hi?, R).
procedure dom_at(Doms?, Integer?, GAs, GAs).
dom_at([], _, [], []).
dom_at([dom(Q, R, F)|_], P, R?, F?) :- Q? =:= P? | true.
dom_at([_|Ds], P, R?, F?) :- otherwise | dom_at(Ds?, P?, R, F).
procedure count_in(GA?, GAs?, Integer).
count_in(A, Rq, N?) :- count_of(A?, Rq?, 0, N).
procedure forb_chosen(Lits?, Integer?, GA?, YesNo).
forb_chosen([], _, _, no).
forb_chosen([lforb(Q, X)|_], P, A, yes) :- Q? =:= P?, X? =?= A? | true.
forb_chosen([_|Ls], P, A, B?) :- otherwise | forb_chosen(Ls?, P?, A?, B).
procedure lo_of(YesNo?, Integer?, Integer).
lo_of(yes, L, M?) :- max_int(L?, 1, M).
lo_of(no, L, L?).
procedure hi_of(YesNo?, Integer?, Bound).
hi_of(yes, _, upto(0)).
hi_of(no, H, upto(H?)).
%% The bound above, the least of H and each count less one chosen broken at P
%% for A.
procedure hi_chosen(Lits?, Integer?, GA?, Bound?, Bound).
hi_chosen([], _, _, H, H?).
hi_chosen([lreq(Q, X, C)|Ls], P, A, H, R?) :- Q? =:= P?, X? =?= A?, integer(C?) |
    C1 := C? - 1,
    min_bound(H?, C1?, H1),
    hi_chosen(Ls?, P?, A?, H1?, R).
hi_chosen([_|Ls], P, A, H, R?) :- otherwise | hi_chosen(Ls?, P?, A?, H?, R).
procedure min_bound(Bound?, Integer?, Bound).
min_bound(unbounded, C, upto(C?)).
min_bound(upto(H), C, upto(M?)) :- min_int(H?, C?, M).
procedure min_int(Integer?, Integer?, Integer).
min_int(A, B, A?) :- A? =< B? | true.
min_int(A, B, B?) :- A? > B? | true.
procedure max_int(Integer?, Integer?, Integer).
max_int(A, B, A?) :- A? >= B? | true.
max_int(A, B, B?) :- A? < B? | true.
procedure same_set(Ints?, Ints?, YesNo).
same_set(A, B, yes) :- A? =?= B? | true.
same_set(_, _, no) :- otherwise | true.
procedure within(Integer?, Bound?, YesNo).
within(_, unbounded, yes).
within(L, upto(H), yes) :- L? =< H? | true.
within(L, upto(H), no) :- L? > H? | true.

%% live_at(Q, Rs, B, Rf, Ok): at each participant of Q, no atom both required
%% and forbidden --- a free variable the same in two atoms of one
%% schema-binding, free_var(V), naming one person or speech act in both ---
%% and no atom of a reflexive predicate naming the participant forbidden.
procedure live_at(Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at([], _, _, _, yes).
live_at([P|Ps], Rs, B, Rf, Ok?) :- ground(Rs?), ground(B?), ground(Rf?), integer(P?) |
    reqs_at(Rs?, B?, P?, Rf?, R),
    forbs_at(Rs?, B?, P?, F),
    live_one(R?, F?, P?, Rf?, Ok1),
    live_at1(Ok1?, Ps?, Rs?, B?, Rf?, Ok).
procedure live_one(GAs?, GAs?, Integer?, Preds?, YesNo).
live_one(R, F, P, Rf, Ok?) :- ground(F?) |
    meets(R?, F?, M1),
    own_reflexive_in(F?, P?, Rf?, M2),
    or(M1?, M2?, M),
    neg(M?, Ok).

%% linked(Q, Rs1, B1, Rs2, B2, Rf, L): whether two schema-bindings of the
%% participants Q, of the same deleted and added atoms at each, determine a
%% common transaction --- no atom with no free variable one requires at a
%% participant that the other forbids there (the header above).
procedure linked(Ints?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked([], _, _, _, _, _, yes).
linked([P|Ps], Rs1, B1, Rs2, B2, Rf, L?) :-
    ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?), integer(P?) |
    reqs_at(Rs1?, B1?, P?, Rf?, R1),
    reqs_at(Rs2?, B2?, P?, Rf?, R2),
    forbs_at(Rs1?, B1?, P?, F1),
    forbs_at(Rs2?, B2?, P?, F2),
    bound_gas(R1?, Rb1),
    bound_gas(R2?, Rb2),
    meets(Rb1?, F2?, C1),
    meets(Rb2?, F1?, C2),
    or(C1?, C2?, C),
    linked1(C?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).
procedure linked1(YesNo?, Ints?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked1(yes, _, _, _, _, _, _, no).
linked1(no, Ps, Rs1, B1, Rs2, B2, Rf, L?) :- linked(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

%% class_mates(Ms, Nm, Rs, B, Q, Rf, Cls): the class of the schema-binding
%% (Nm, Rs, B) among its mates Ms, those a chain of linked mates joins to it,
%% in the order of Ms.
procedure class_mates(Mates?, Constant?, RoleSpecs?, Binding?, Ints?, Preds?, Mates).
class_mates(Ms, Nm, Rs, B, Q, Rf, Cls?) :- ground(Ms?), ground(Q?), ground(Rf?) |
    grow([mate(Nm?, Rs?, B?)], Ms?, Q?, Rf?, [], In),
    keep_mates(Ms?, In?, Cls).
%% grow(Front, Rest, Q, Rf, Done, Out): Out is Done, Front and every mate of
%% Rest that a chain through the mates of Front reaches; a mate of Front is
%% moved to Done once the mates of Rest linked to it have joined Front.
procedure grow(Mates?, Mates?, Ints?, Preds?, Mates?, Mates).
grow([], _, _, _, Done, Done?).
grow([mate(N, Rs, B)|Fs], Rest, Q, Rf, Done, Out?) :-
    ground(N?), ground(Rs?), ground(B?), ground(Rest?), ground(Q?), ground(Rf?) |
    split_linked(Rest?, Rs?, B?, Q?, Rf?, New, Keep),
    app(Fs?, New?, Fs1),
    grow(Fs1?, Keep?, Q?, Rf?, [mate(N?, Rs?, B?)|Done?], Out).
procedure split_linked(Mates?, RoleSpecs?, Binding?, Ints?, Preds?, Mates, Mates).
split_linked([], _, _, _, _, [], []).
split_linked([mate(N2, Rs2, B2)|Ms], Rs, B, Q, Rf, New?, Keep?) :-
    ground(N2?), ground(Rs2?), ground(B2?), ground(Rs?), ground(B?), ground(Q?), ground(Rf?) |
    linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L),
    split_linked(Ms?, Rs?, B?, Q?, Rf?, New1, Keep1),
    split_one(L?, mate(N2?, Rs2?, B2?), New1?, Keep1?, New, Keep).
procedure split_one(YesNo?, Mate?, Mates?, Mates?, Mates, Mates).
split_one(yes, M, New, Keep, [M?|New?], Keep?).
split_one(no, M, New, Keep, New?, [M?|Keep?]).
procedure keep_mates(Mates?, Mates?, Mates).
keep_mates([], _, []).
keep_mates([M|Ms], In, R?) :- ground(M?), ground(In?) |
    mem(M?, In?, B),
    keep_mates(Ms?, In?, R1),
    keep_mate(B?, M?, R1?, R).
procedure keep_mate(YesNo?, Mate?, Mates?, Mates).
keep_mate(yes, M, R, [M?|R?]).
keep_mate(no, _, R, R?).
procedure live_at1(YesNo?, Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at1(no, _, _, _, _, no).
live_at1(yes, Ps, Rs, B, Rf, Ok?) :- live_at(Ps?, Rs?, B?, Rf?, Ok).
procedure bound_gas(GAs?, GAs).
bound_gas([], []).
bound_gas([ga(N, Xs)|As], R?) :- ground(Xs?) |
    has_free(Xs?, Fr),
    bound_gas(As?, R1),
    keep_ga(Fr?, ga(N?, Xs?), R1?, R).
procedure has_free(Vals?, YesNo).
has_free([], no).
has_free([free_var(_)|_], yes).
has_free([person(_)|Xs], B?) :- has_free(Xs?, B).
has_free([sp(_, _)|Xs], B?) :- has_free(Xs?, B).
procedure keep_ga(YesNo?, GA?, GAs?, GAs).
keep_ga(no, A, R, [A?|R?]).
keep_ga(yes, _, R, R?).
procedure own_reflexive_in(GAs?, Integer?, Preds?, YesNo).
own_reflexive_in([], _, _, no).
own_reflexive_in([ga(N, [person(Q)])|As], P, Rf, B?) :- ground(Rf?), integer(P?), Q? =:= P? |
    mem(N?, Rf?, B1),
    own_reflexive_in1(B1?, As?, P?, Rf?, B).
own_reflexive_in([_|As], P, Rf, B?) :- otherwise | own_reflexive_in(As?, P?, Rf?, B).
procedure own_reflexive_in1(YesNo?, GAs?, Integer?, Preds?, YesNo).
own_reflexive_in1(yes, _, _, _, yes).
own_reflexive_in1(no, As, P, Rf, B?) :- own_reflexive_in(As?, P?, Rf?, B).
%% The people in the marked roles of each mate, a set, ascending.
procedure mates_guards(Mates?, Gds).
mates_guards([], []).
mates_guards([mate(N, Rs, B)|Ms], [gd(N?, Rs?, B?, G?)|Gs?]) :- ground(Rs?), ground(B?) |
    guard_people(Rs?, 1, B?, G0),
    sort_ints(G0?, G1),
    dedup(G1?, G),
    mates_guards(Ms?, Gs).
procedure some_unguarded(Gds?, YesNo).
some_unguarded([], no).
some_unguarded([gd(_, _, _, [])|_], yes).
some_unguarded([gd(_, _, _, [_|_])|Gs], B?) :- some_unguarded(Gs?, B).

%% Simple guards: the minimal guard sets one, or all of one person each;
%% otherwise two schema-bindings of distinct minimal sets, one of them not of
%% one person, named.
procedure simple_fault(Gds?, Pairs).
simple_fault(Gs, P?) :- ground(Gs?) |
    minimal_gds(Gs?, Gs?, M0),
    dedup_gds(M0?, M),
    simple_fault1(M?, P).
procedure simple_fault1(Gds?, Pairs).
simple_fault1(M, P?) :- ground(M?) |
    count_gds(M?, N),
    first_nonsingle(M?, F),
    simple_fault2(N?, F?, M?, P).
procedure simple_fault2(Integer?, GdRes?, Gds?, Pairs).
simple_fault2(N, _, _, []) :- N? < 2 | true.
simple_fault2(N, nogd, _, []) :- N? >= 2 | true.
simple_fault2(N, gdf(G1), M, P?) :- N? >= 2, ground(G1?) |
    other_gd(G1?, M?, G2),
    nonsimple_pair(G1?, G2?, P).
procedure nonsimple_pair(Gd?, GdRes?, Pairs).
nonsimple_pair(gd(N1, Rs1, B1, _), gdf(gd(N2, Rs2, B2, _)),
        [nonsimple(N1?, Rs1?, B1?, N2?, Rs2?, B2?)]).
nonsimple_pair(_, nogd, []).
procedure minimal_gds(Gds?, Gds?, Gds).
minimal_gds([], _, []).
minimal_gds([gd(N, Rs, B, G)|Gs], All, M?) :- ground(G?), ground(All?) |
    has_smaller(All?, G?, S),
    minimal_gds(Gs?, All?, M1),
    keep_gd(S?, gd(N?, Rs?, B?, G?), M1?, M).
procedure has_smaller(Gds?, Ints?, YesNo).
has_smaller([], _, no).
has_smaller([gd(_, _, _, H)|Gs], G, B?) :- ground(H?), ground(G?) |
    all_in(H?, G?, Sub),
    all_in(G?, H?, Sup),
    neg(Sup?, Strict),
    and(Sub?, Strict?, B1),
    has_smaller1(B1?, Gs?, G?, B).
procedure has_smaller1(YesNo?, Gds?, Ints?, YesNo).
has_smaller1(yes, _, _, yes).
has_smaller1(no, Gs, G, B?) :- has_smaller(Gs?, G?, B).
procedure keep_gd(YesNo?, Gd?, Gds?, Gds).
keep_gd(yes, _, M, M?).
keep_gd(no, X, M, [X?|M?]).
procedure dedup_gds(Gds?, Gds).
dedup_gds([], []).
dedup_gds([gd(N, Rs, B, G)|Gs], [gd(N?, Rs?, B?, G?)|R?]) :- ground(G?) |
    drop_gds(G?, Gs?, Gs1),
    dedup_gds(Gs1?, R).
procedure drop_gds(Ints?, Gds?, Gds).
drop_gds(_, [], []).
drop_gds(G, [gd(_, _, _, H)|Gs], R?) :- G? =?= H? | drop_gds(G?, Gs?, R).
drop_gds(G, [X|Gs], [X?|R?]) :- otherwise | drop_gds(G?, Gs?, R).
procedure count_gds(Gds?, Integer).
count_gds([], 0).
count_gds([_|Gs], N?) :- count_gds(Gs?, M), N := M? + 1.
procedure first_nonsingle(Gds?, GdRes).
first_nonsingle([], nogd).
first_nonsingle([gd(_, _, _, [_])|Gs], F?) :- first_nonsingle(Gs?, F).
first_nonsingle([gd(N, Rs, B, G)|_], gdf(gd(N?, Rs?, B?, G?))) :- otherwise | true.
procedure other_gd(Gd?, Gds?, GdRes).
other_gd(_, [], nogd).
other_gd(gd(N, Rs, B, G), [gd(_, _, _, H)|Gs], F?) :- ground(G?), ground(H?), G? =?= H? |
    other_gd(gd(N?, Rs?, B?, G?), Gs?, F).
other_gd(_, [Y|_], gdf(Y?)) :- otherwise | true.
procedure sort_ints(Ints?, Ints).
sort_ints([], []).
sort_ints([X|Xs], S?) :- sort_ints(Xs?, S1), insert_int(X?, S1?, S).
procedure insert_int(Integer?, Ints?, Ints).
insert_int(X, [], [X?]).
insert_int(X, [Y|Ys], [X?, Y?|Ys?]) :- X? =< Y? | true.
insert_int(X, [Y|Ys], [Y?|R?]) :- X? > Y? | insert_int(X?, Ys?, R).

procedure open_atoms(GAs?, YesNo).
open_atoms([], no).
open_atoms([ga(_, Xs)|As], B?) :- has_free(Xs?, B1), open_atoms1(B1?, As?, B).
procedure open_atoms1(YesNo?, GAs?, YesNo).
open_atoms1(yes, _, yes).
open_atoms1(no, As, B?) :- open_atoms(As?, B).

%% The atoms required (=(i) and -(i)) at the roles sent to P, joined, less
%% those of a reflexive predicate naming P, which hold at every person of that
%% person (vGLP, Section 5.4, the paragraph on act schemas); and those
%% forbidden there.
procedure reqs_at(RoleSpecs?, Binding?, Integer?, Preds?, GAs).
reqs_at(Rs, B, P, Rf, R?) :- ground(B?), integer(P?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    reqs_join(RsP?, B?, [], R0),
    drop_own_reflexive(R0?, P?, Rf?, R).
procedure drop_own_reflexive(GAs?, Integer?, Preds?, GAs).
drop_own_reflexive([], _, _, []).
drop_own_reflexive([ga(N, [person(Q)])|As], P, Rf, R?) :-
    ground(Rf?), integer(P?), integer(Q?), Q? =:= P? |
    mem(N?, Rf?, Own),
    drop_own_reflexive(As?, P?, Rf?, R1),
    keep_ga(Own?, ga(N?, [person(Q?)]), R1?, R).
drop_own_reflexive([A|As], P, Rf, [A?|R?]) :- otherwise | drop_own_reflexive(As?, P?, Rf?, R).
procedure reqs_join(RoleSpecs?, Binding?, GAs?, GAs).
reqs_join([], _, Acc, Acc?).
reqs_join([R|Rs], B, Acc, Out?) :- ground(R?), ground(B?) |
    rs_lists(R?, _, M, K, _),
    img_atoms(K?, B?, G1),
    img_atoms(M?, B?, G2),
    app(G1?, G2?, G),
    ms_join(Acc?, G?, Acc1),
    reqs_join(Rs?, B?, Acc1?, Out).
procedure forbs_at(RoleSpecs?, Binding?, Integer?, GAs).
forbs_at(Rs, B, P, F?) :- ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    forbs_cat(RsP?, B?, F).
procedure forbs_cat(RoleSpecs?, Binding?, GAs).
forbs_cat([], _, []).
forbs_cat([R|Rs], B, F?) :- ground(R?), ground(B?) |
    rs_lists(R?, _, _, _, N),
    img_atoms(N?, B?, G),
    forbs_cat(Rs?, B?, F1),
    app(G?, F1?, F).

%% --- The bindings of a schema, up to renaming ------------------------------
procedure canon_bindings(RoleSpecs?, Bindings).
canon_bindings(Rs, Bs?) :- ground(Rs?) |
    schema_vars(Rs?, Vs),
    canon_bindings1(Rs?, Vs?, Bs).
procedure canon_bindings1(RoleSpecs?, Args?, Bindings).
canon_bindings1(Rs, Vs, Bs?) :- ground(Rs?), ground(Vs?) |
    person_vars(Vs?, Pv),
    speech_vars(Vs?, Sv),
    rgs(Pv?, 0, [], B1),
    rule_filter(B1?, Rs?, B2),
    with_speech(B2?, Sv?, B3),
    adm_filter(B3?, Rs?, Bs).
procedure person_vars(Args?, Args).
person_vars([], []).
person_vars([role(I)|Vs], [role(I?)|R?]) :- person_vars(Vs?, R).
person_vars([pvar(X)|Vs], [pvar(X?)|R?]) :- person_vars(Vs?, R).
person_vars([svar(_)|Vs], R?) :- person_vars(Vs?, R).
person_vars([nterm(_)|Vs], R?) :- person_vars(Vs?, R).
person_vars([sgn(_, _)|Vs], R?) :- person_vars(Vs?, R).
procedure speech_vars(Args?, Args).
speech_vars([], []).
speech_vars([svar(X)|Vs], [svar(X?)|R?]) :- speech_vars(Vs?, R).
speech_vars([role(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([pvar(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([nterm(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([sgn(_, _)|Vs], R?) :- speech_vars(Vs?, R).

%% rgs(Vs, N, B, Bs): every extension of B sending Vs to people, person(N)
%% being the first not yet used.
procedure rgs(Args?, Integer?, Binding?, Bindings).
rgs([], _, B, [B?]).
rgs([X|Xs], N, B, R?) :- ground(X?), ground(Xs?), ground(B?) |
    rgs_from(0, N?, X?, Xs?, B?, R).
procedure rgs_from(Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
rgs_from(I, N, _, _, _, []) :- I? > N? | true.
rgs_from(I, N, X, Xs, B, R?) :- I? =< N?, ground(X?), ground(Xs?), ground(B?) |
    next_fresh(I?, N?, N1),
    rgs(Xs?, N1?, [bnd(X?, person(I?))|B?], R1),
    I1 := I? + 1,
    rgs_from(I1?, N?, X?, Xs?, B?, R2),
    app(R1?, R2?, R).
procedure next_fresh(Integer?, Integer?, Integer).
next_fresh(I, N, N1?) :- I? =:= N? | N1 := N? + 1.
next_fresh(I, N, N?) :- I? < N? | true.

%% with_speech(Bs, Sv, R): each binding of Bs extended to the speech-act
%% variables, an utterance utt(N) in order of first use and, for a new one, its
%% signer one of the people the binding uses or one more.
procedure with_speech(Bindings?, Args?, Bindings).
with_speech([], _, []).
with_speech([B|Bs], Sv, R?) :- ground(B?), ground(Sv?) |
    people_count(B?, NP),
    svs(Sv?, 0, NP?, B?, R1),
    with_speech(Bs?, Sv?, R2),
    app(R1?, R2?, R).
procedure people_count(Binding?, Integer).
people_count([], 0).
people_count([bnd(_, person(I))|Bs], N?) :- people_count(Bs?, M), max1(I?, M?, N).
people_count([bnd(_, sp(_, _))|Bs], N?) :- people_count(Bs?, N).
people_count([bnd(_, free_var(_))|Bs], N?) :- people_count(Bs?, N).
procedure max1(Integer?, Integer?, Integer).
max1(I, M, N?) :- I? >= M? | N := I? + 1.
max1(I, M, M?) :- I? < M? | true.
procedure svs(Args?, Integer?, Integer?, Binding?, Bindings).
svs([], _, _, B, [B?]).
svs([Y|Ys], NU, NP, B, R?) :- ground(Y?), ground(Ys?), ground(B?) |
    svs_old(0, NU?, NP?, Y?, Ys?, B?, R1),
    svs_new(0, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% An utterance already used, U < NU, with the signer it has.
procedure svs_old(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_old(U, NU, _, _, _, _, []) :- U? >= NU? | true.
svs_old(U, NU, NP, Y, Ys, B, R?) :- U? < NU?, ground(Y?), ground(Ys?), ground(B?) |
    signer_of(U?, B?, S),
    svs(Ys?, NU?, NP?, [bnd(Y?, sp(utt(U?), S?))|B?], R1),
    U1 := U? + 1,
    svs_old(U1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% A new utterance NU, signed by person S, 0 =< S =< NP.
procedure svs_new(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_new(S, _, NP, _, _, _, []) :- S? > NP? | true.
svs_new(S, NU, NP, Y, Ys, B, R?) :- S? =< NP?, ground(Y?), ground(Ys?), ground(B?) |
    NU1 := NU? + 1,
    svs(Ys?, NU1?, NP?, [bnd(Y?, sp(utt(NU?), S?))|B?], R1),
    S1 := S? + 1,
    svs_new(S1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
procedure signer_of(Integer?, Binding?, Integer).
signer_of(_, [], 0).
signer_of(U, [bnd(_, sp(utt(U1), S))|_], S?) :- U? =:= U1? | true.
signer_of(U, [_|Bs], S?) :- otherwise | signer_of(U?, Bs?, S).

procedure rule_filter(Bindings?, RoleSpecs?, Bindings).
rule_filter([], _, []).
rule_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    rule_ok(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    rule_filter(Bs?, Rs?, R1).
procedure adm_filter(Bindings?, RoleSpecs?, Bindings).
adm_filter([], _, []).
adm_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    admissible(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    adm_filter(Bs?, Rs?, R1).
procedure keep_binding(YesNo?, Binding?, Bindings?, Bindings).
keep_binding(yes, B, R, [B?|R?]).
keep_binding(no, _, R, R?).

%% --- Schema-bindings: signatures and mates, as the platform computes them --
%% The participants and, for each, the join of the atoms its roles delete and
%% add (GSC, Definition "Compilation").
procedure sig_of(RoleSpecs?, Binding?, Deltas).
sig_of(Rs, B, Pt?) :- ground(Rs?), ground(B?) |
    role_people(Rs?, 1, B?, Ws),
    dedup(Ws?, Q),
    deltas_for(Q?, Rs?, B?, Pt).
procedure role_people(RoleSpecs?, Integer?, Binding?, Ints).
role_people([], _, _, []).
role_people([_|Rs], I, B, [P?|Ps?]) :- integer(I?), ground(B?) |
    role_person(I?, B?, P),
    I1 := I? + 1,
    role_people(Rs?, I1?, B?, Ps).
procedure role_person(Integer?, Binding?, Integer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), person_index(F?, P).
procedure person_index(Found?, Integer).
person_index(found(person(P)), P?).
person_index(found(sp(_, _)), -1).
person_index(found(free_var(_)), -1).
person_index(unbound, -1).
procedure deltas_for(Ints?, RoleSpecs?, Binding?, Deltas).
deltas_for([], _, _, []).
deltas_for([P|Ps], Rs, B, [delta(P?, D?, A?)|Xs?]) :- ground(Rs?), ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    joins(RsP?, B?, D, A),
    deltas_for(Ps?, Rs?, B?, Xs).
procedure joins(RoleSpecs?, Binding?, GAs, GAs).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) |
    changes_join(RsP?, B?, del, [], D),
    changes_join(RsP?, B?, add, [], A).
procedure changes_join(RoleSpecs?, Binding?, Constant?, GAs?, GAs).
changes_join([], _, _, Acc, Acc?).
changes_join([R|Rs], B, W, Acc, Out?) :- ground(R?), ground(B?), ground(W?) |
    rs_lists(R?, P, M, _, _),
    which(W?, P?, M?, Xs),
    img_atoms(Xs?, B?, G),
    ms_join(Acc?, G?, Acc1),
    changes_join(Rs?, B?, W?, Acc1?, Out).
procedure which(Constant?, Atoms?, Atoms?, Atoms).
which(W, P, _, P?) :- W? =?= add | true.
which(W, _, M, M?) :- W? =?= del | true.
which(_, _, _, []) :- otherwise | true.
procedure specs_at(RoleSpecs?, Integer?, Binding?, Integer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R|Rs], I, B, P, Out?) :- integer(I?), ground(B?) |
    role_person(I?, B?, Q),
    I1 := I? + 1,
    specs_at(Rs?, I1?, B?, P?, Rest),
    keep_spec(Q?, P?, R?, Rest?, Out).
procedure keep_spec(Integer?, Integer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R?|Rest?]) :- Q? =:= P? | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.
procedure deltas_valid(Deltas?, YesNo).
deltas_valid([], yes).
deltas_valid([delta(_, D, A)|Ps], B?) :- ground(A?) |
    meets(D?, A?, M),
    neg(M?, B1),
    deltas_valid1(B1?, Ps?, B).
procedure deltas_valid1(YesNo?, Deltas?, YesNo).
deltas_valid1(no, _, no).
deltas_valid1(yes, Ps, B?) :- deltas_valid(Ps?, B).
procedure deltas_people(Deltas?, Ints).
deltas_people([], []).
deltas_people([delta(P, _, _)|Ps], [P?|Qs?]) :- deltas_people(Ps?, Qs).
procedure deltas_eq(Deltas?, Deltas?, YesNo).
deltas_eq(A, B, E?) :- ground(A?), ground(B?) |
    deltas_people(A?, Pa),
    deltas_people(B?, Pb),
    set_eq(Pa?, Pb?, E1),
    deltas_in(A?, B?, E2),
    and(E1?, E2?, E).
procedure deltas_in(Deltas?, Deltas?, YesNo).
deltas_in([], _, yes).
deltas_in([X|Xs], B, E?) :- ground(B?) |
    delta_in(X?, B?, E1),
    deltas_in1(E1?, Xs?, B?, E).
procedure deltas_in1(YesNo?, Deltas?, Deltas?, YesNo).
deltas_in1(no, _, _, no).
deltas_in1(yes, Xs, B, E?) :- deltas_in(Xs?, B?, E).
procedure delta_in(Delta?, Deltas?, YesNo).
delta_in(_, [], no).
delta_in(delta(P, D, A), [delta(Q, D1, A1)|Ps], E?) :- P? =:= Q?, ground(D?), ground(A?) |
    ms_eq(D?, D1?, E1),
    ms_eq(A?, A1?, E2),
    and(E1?, E2?, E3),
    delta_in1(E3?, delta(P?, D?, A?), Ps?, E).
delta_in(X, [_|Ps], E?) :- otherwise | delta_in(X?, Ps?, E).
procedure delta_in1(YesNo?, Delta?, Deltas?, YesNo).
delta_in1(yes, _, _, yes).
delta_in1(no, X, Ps, E?) :- delta_in(X?, Ps?, E).

%% GSC, Definition "Binding": two roles sent to one person only if neither
%% adds or deletes an atom naming the other.
procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) |
    rs_count(Rs?, K),
    pairs_ok(1, K?, Rs?, B?, R).
procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- I? > K? | true.
pairs_ok(I, K, Rs, B, R?) :- I? =< K?, ground(Rs?), ground(B?) |
    J := I? + 1,
    pair_row(I?, J?, K?, Rs?, B?, R1),
    I1 := I? + 1,
    pairs_ok1(R1?, I1?, K?, Rs?, B?, R).
procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).
procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- J? > K? | true.
pair_row(I, J, K, Rs, B, R?) :- J? =< K?, ground(Rs?), ground(B?) |
    role_person(I?, B?, P),
    role_person(J?, B?, Q),
    nth_spec(Rs?, I?, RI),
    nth_spec(Rs?, J?, RJ),
    pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1),
    J1 := J? + 1,
    pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).
procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).
procedure pair_ok(Integer?, Integer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- P? =:= Q? |
    role_names(RI?, J?, A1),
    role_names(RJ?, I?, A2),
    or(A1?, A2?, A),
    neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.
procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(R, J, B?) :- ground(R?), integer(J?) |
    rs_lists(R?, P, M, _, _),
    names_role(P?, J?, B1),
    names_role(M?, J?, B2),
    or(B1?, B2?, B).
%% An atom names a role among its arguments or the role of a signed term among
%% them (GSC, Section 3: "An atom names what is among its arguments or is the
%% signer of one: ... in a schema a role or a variable, the role of a signed
%% term included").
procedure names_role(Atoms?, Integer?, YesNo).
names_role([], _, no).
names_role([atom(_, As)|Xs], J, B?) :- integer(J?), ground(As?) |
    mem(role(J?), As?, B1),
    sgn_names(As?, J?, B2),
    or(B1?, B2?, B12),
    names_role1(B12?, Xs?, J?, B).
procedure sgn_names(Args?, Integer?, YesNo).
sgn_names([], _, no).
sgn_names([sgn(_, I)|_], J, yes) :- I? =:= J? | true.
sgn_names([_|As], J, B?) :- otherwise | sgn_names(As?, J?, B).
procedure names_role1(YesNo?, Atoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, Xs, J, B?) :- names_role(Xs?, J?, B).
procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R|_], I, R?) :- I? =:= 1 | true.
nth_spec([_|Rs], I, R?) :- I? > 1 | I1 := I? - 1, nth_spec(Rs?, I1?, R).

%% GSC, Definition "Binding", admissible.
procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) |
    added_atoms(Rs?, Ad),
    required_atoms(Rs?, Rq),
    guard_people(Rs?, 1, B?, Gp),
    atoms_args(Ad?, Av),
    atoms_args(Rq?, Qv),
    adm_each(Av?, Qv?, B?, Gp?, R).
procedure adm_each(Args?, Args?, Binding?, Ints?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V|Vs], Qv, B, Gp, R?) :- ground(V?), ground(Qv?), ground(B?), ground(Gp?) |
    adm_var(V?, Qv?, B?, Gp?, R1),
    adm_each1(R1?, Vs?, Qv?, B?, Gp?, R).
procedure adm_each1(YesNo?, Args?, Args?, Binding?, Ints?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Qv, B, Gp, R?) :- adm_each(Vs?, Qv?, B?, Gp?, R).
procedure adm_var(Arg?, Args?, Binding?, Ints?, YesNo).
adm_var(svar(X), Qv, B, Gp, R?) :- ground(X?), ground(B?) |
    mem(svar(X?), Qv?, InReq),
    lookup(svar(X?), B?, F),
    adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(nterm(_), _, _, _, yes).
%% A signed term's speech-act variable occurs in an atom some role requires
%% (GSC, Definition "Act schema"), so it asks nothing of the binding; its
%% value is the speech act bound to y, signed by the person in role i
%% (img_sgn).
adm_var(sgn(_, _), _, _, _, yes).
procedure adm_var1(YesNo?, Found?, Ints?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(sp(_, S)), Gp, R?) :- mem(S?, Gp?, R).
adm_var1(no, found(person(_)), _, no).
adm_var1(no, found(free_var(_)), _, no).
adm_var1(no, unbound, _, no).
procedure added_atoms(RoleSpecs?, Atoms).
added_atoms([], []).
added_atoms([R|Rs], A?) :- ground(R?) | rs_lists(R?, P, _, _, _), added_atoms(Rs?, A1), app(P?, A1?, A).
procedure required_atoms(RoleSpecs?, Atoms).
required_atoms([], []).
required_atoms([R|Rs], A?) :- ground(R?) |
    rs_lists(R?, _, M, K, _),
    required_atoms(Rs?, A1),
    app(M?, A1?, A2),
    app(K?, A2?, A).
procedure guard_people(RoleSpecs?, Integer?, Binding?, Ints).
guard_people([], _, _, []).
guard_people([R|Rs], I, B, G?) :- ground(R?), integer(I?), ground(B?) |
    rs_guarded(R?, Gd),
    role_person(I?, B?, P),
    I1 := I? + 1,
    guard_people(Rs?, I1?, B?, G1),
    keep_int(Gd?, P?, G1?, G).
procedure keep_int(YesNo?, Integer?, Ints?, Ints).
keep_int(yes, P, G, [P?|G?]).
keep_int(no, _, G, G?).

%% The schema-bindings of every schema whose roles, sent onto the
%% participants, delete and add exactly the atoms of Pt.
procedure mates_of(Contract?, Deltas?, Preds?, Mates).
mates_of([], _, _, []).
mates_of([schema(Nm, Rs)|Ss], Pt, Rf, M?) :- ground(Nm?), ground(Rs?), ground(Pt?), ground(Rf?) |
    deltas_people(Pt?, Q),
    rs_count(Rs?, K),
    assigns(K?, Q?, As),
    mates_assigns(As?, Nm?, Rs?, Pt?, Rf?, M1),
    mates_of(Ss?, Pt?, Rf?, M2),
    app(M1?, M2?, M).
mates_of([cschema(_, _, _)|Ss], Pt, Rf, M?) :- mates_of(Ss?, Pt?, Rf?, M).
procedure assigns(Integer?, Ints?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).
procedure assigns1(Integer?, Integer?, Ints?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- I? > K? | true.
assigns1(I, K, Q, Acc, R?) :- I? =< K?, ground(Q?) |
    extend_role(Acc?, I?, Q?, Acc1),
    I1 := I? + 1,
    assigns1(I1?, K?, Q?, Acc1?, R).
procedure extend_role(Bindings?, Integer?, Ints?, Bindings).
extend_role([], _, _, []).
extend_role([B|Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) |
    extend_one(Q?, I?, B?, R1),
    extend_role(Bs?, I?, Q?, R2),
    app(R1?, R2?, R).
procedure extend_one(Ints?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P|Ps], I, B, [[bnd(role(I?), person(P?))|B?]|R?]) :- ground(B?), integer(I?) |
    extend_one(Ps?, I?, B?, R).
procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Deltas?, Preds?, Mates).
mates_assigns([], _, _, _, _, []).
mates_assigns([B|Bs], Nm, Rs, Pt, Rf, M?) :-
    ground(B?), ground(Nm?), ground(Rs?), ground(Pt?), ground(Rf?) |
    deltas_people(Pt?, Q),
    role_people(Rs?, 1, B?, Ws),
    all_in(Q?, Ws?, Onto),
    rule_ok(Rs?, B?, Ok),
    and(Onto?, Ok?, Go),
    mates_assign(Go?, B?, Nm?, Rs?, Pt?, Rf?, M1),
    mates_assigns(Bs?, Nm?, Rs?, Pt?, Rf?, M2),
    app(M1?, M2?, M).
procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Deltas?, Preds?, Mates).
mates_assign(no, _, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Pt, Rf, M?) :- ground(Rs?), ground(Pt?) |
    match_deltas(Pt?, Rs?, [B?], Bs),
    mates_check(Bs?, Nm?, Rs?, Pt?, Rf?, M).
procedure match_deltas(Deltas?, RoleSpecs?, Bindings?, Bindings).
match_deltas([], _, Bs, Bs?).
match_deltas([delta(P, D, A)|Pt], Rs, Bs, R?) :- ground(D?), ground(A?), ground(Rs?) |
    match_delta(Bs?, P?, D?, A?, Rs?, Bs1),
    match_deltas(Pt?, Rs?, Bs1?, R).
procedure match_delta(Bindings?, Integer?, GAs?, GAs?, RoleSpecs?, Bindings).
match_delta([], _, _, _, _, []).
match_delta([B|Bs], P, D, A, Rs, R?) :- ground(B?), ground(D?), ground(A?), ground(Rs?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    match_delta1(RsP?, B?, D?, A?, B2),
    match_delta(Bs?, P?, D?, A?, Rs?, R2),
    app(B2?, R2?, R).
procedure match_delta1(RoleSpecs?, Binding?, GAs?, GAs?, Bindings).
match_delta1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) |
    changes_cat(RsP?, del, Dp),
    changes_cat(RsP?, add, Ap),
    match_all(Dp?, D?, B?, B1),
    match_all_each(B1?, Ap?, A?, R).
procedure changes_cat(RoleSpecs?, Constant?, Atoms).
changes_cat([], _, []).
changes_cat([R|Rs], W, Xs?) :- ground(R?), ground(W?) |
    rs_lists(R?, P, M, _, _),
    which(W?, P?, M?, X1),
    changes_cat(Rs?, W?, X2),
    app(X1?, X2?, Xs).
procedure mates_check(Bindings?, Constant?, RoleSpecs?, Deltas?, Preds?, Mates).
mates_check([], _, _, _, _, []).
mates_check([B|Bs], Nm, Rs, Pt, Rf, M?) :-
    ground(B?), ground(Nm?), ground(Rs?), ground(Pt?), ground(Rf?) |
    sig_of(Rs?, B?, Pt1),
    deltas_eq(Pt?, Pt1?, E1),
    admissible(Rs?, B?, E2),
    deltas_people(Pt?, Q),
    live_at(Q?, Rs?, B?, Rf?, E3),
    and(E1?, E2?, E12),
    and(E12?, E3?, E),
    mate_of(E?, B?, Nm?, Rs?, M1),
    mates_check(Bs?, Nm?, Rs?, Pt?, Rf?, M2),
    app(M1?, M2?, M).
procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, Rs?, B?)]).

procedure all_in(Ints?, Ints?, YesNo).
all_in([], _, yes).
all_in([P|Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).
procedure all_in1(YesNo?, Ints?, Ints?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).

%% --- Atoms, bindings and matching ------------------------------------------
procedure lookup(Arg?, Binding?, Found).
lookup(_, [], unbound).
lookup(V, [bnd(W, X)|_], found(X?)) :- V? =?= W? | true.
lookup(V, [_|Bs], F?) :- otherwise | lookup(V?, Bs?, F).
procedure img_atoms(Atoms?, Binding?, GAs).
img_atoms([], _, []).
img_atoms([atom(P, As)|Xs], B, [ga(P?, Vs?)|Gs?]) :- ground(B?) |
    img_args(As?, B?, Vs),
    img_atoms(Xs?, B?, Gs).
procedure img_args(Args?, Binding?, Vals).
img_args([], _, []).
img_args([sgn(Y, I)|As], B, [X?|Xs?]) :- ground(B?), ground(Y?), ground(I?) |
    lookup(svar(Y?), B?, F),
    role_person(I?, B?, P),
    img_sgn(F?, P?, sgn(Y?, I?), X),
    img_args(As?, B?, Xs).
img_args([A|As], B, [X?|Xs?]) :- otherwise, ground(B?), ground(A?) |
    lookup(A?, B?, F),
    val_or_free(F?, A?, X),
    img_args(As?, B?, Xs).
%% The image of a signed term sgn(y, i): the speech act bound to y, signed by
%% the person in role i (GSC, Definition "Binding": beta(sgn(y, pi)) :=
%% (beta(y), beta(pi))).  A signed term occurs only in an added atom (GSC,
%% Definition "Act schema"), whose matching binds y to a speech act, so the
%% second clause, the term left free as a free variable is, covers the type and
%% is never reached.
procedure img_sgn(Found?, Integer?, Arg?, Val).
img_sgn(found(sp(U, S)), P, _, sp(sp(U?, S?), P?)).
img_sgn(_, _, A, free_var(A?)) :- otherwise | true.

procedure match_all(Atoms?, GAs?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A|As], Gs, B, R?) :- ground(Gs?) |
    match_into(A?, Gs?, B?, Bs),
    match_all_each(Bs?, As?, Gs?, R).
procedure match_all_each(Bindings?, Atoms?, GAs?, Bindings).
match_all_each([], _, _, []).
match_all_each([B|Bs], As, Gs, R?) :- ground(As?), ground(Gs?) |
    match_all(As?, Gs?, B?, R1),
    match_all_each(Bs?, As?, Gs?, R2),
    app(R1?, R2?, R).
procedure match_into(Atom?, GAs?, Binding?, Bindings).
match_into(_, [], _, []).
match_into(A, [G|Gs], B, R?) :- ground(A?), ground(B?) |
    match_atom(A?, G?, B?, M),
    match_into1(M?, A?, Gs?, B?, R).
procedure match_into1(Match?, Atom?, GAs?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1?|R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).
procedure match_atom(Atom?, GA?, Binding?, Match).
match_atom(atom(P, As), ga(Q, Xs), B, R?) :- P? =?= Q? | match_args(As?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.
procedure match_args(Args?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_|_], _, nomatch).
match_args([_|_], [], _, nomatch).
%% A signed term sgn(y, i) matches a speech act whose utterance is a speech
%% act, y matching that speech act and role i its signer (GSC, Definition
%% "Binding": beta(sgn(y, pi)) := (beta(y), beta(pi))); an utterance signed
%% once, a person or a free variable it does not match.
match_args([sgn(Y, I)|Vs], [X|Xs], B, R?) :- ground(Y?), ground(I?), ground(X?), ground(B?) |
    sgn_parts(X?, Ps),
    match_sgn(Ps?, Y?, I?, Vs?, Xs?, B?, R).
match_args([V|Vs], [X|Xs], B, R?) :- otherwise, ground(V?), ground(X?), ground(B?) |
    lookup(V?, B?, F),
    kind_ok(V?, X?, K),
    match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).
procedure sgn_parts(Val?, SgnParts).
sgn_parts(sp(sp(U, S), P), signed(sp(U?, S?), P?)).
sgn_parts(sp(utt(_), _), unsigned).
sgn_parts(person(_), unsigned).
sgn_parts(free_var(_), unsigned).
procedure match_sgn(SgnParts?, Constant?, Integer?, Args?, Vals?, Binding?, Match).
match_sgn(signed(U, P), Y, I, Vs, Xs, B, R?) :-
    match_args([svar(Y?), role(I?)|Vs?], [U?, person(P?)|Xs?], B?, R).
match_sgn(unsigned, _, _, _, _, _, nomatch).
procedure match_one(Found?, YesNo?, Arg?, Val?, Args?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- W? =?= X? | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(unbound, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [bnd(V?, X?)|B?], R).
match_one(unbound, no, _, _, _, _, _, nomatch).
procedure kind_ok(Arg?, Val?, YesNo).
kind_ok(role(_), person(_), yes).
kind_ok(pvar(_), person(_), yes).
kind_ok(svar(_), sp(_, _), yes).
kind_ok(_, _, no) :- otherwise | true.

%% --- Multisets --------------------------------------------------------------
procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y|Ys], yes, Ys?) :- X? =?= Y? | true.
ms_remove(X, [Y|Ys], F?, [Y?|Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).
procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X|Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).
procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X|Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).
procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).
procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) |
    ms_sub(A?, B?, R1),
    ms_sub(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) set_eq(Stream(X)?, Stream(X)?, YesNo).
set_eq(A, B, R?) :- ground(A?), ground(B?) |
    all_of(A?, B?, R1),
    all_of(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) all_of(Stream(X)?, Stream(X)?, YesNo).
all_of([], _, yes).
all_of([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), all_of1(R1?, Xs?, B?, R).
procedure(X) all_of1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
all_of1(no, _, _, no).
all_of1(yes, Xs, B, R?) :- all_of(Xs?, B?, R).
procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).
procedure(X) meets(Stream(X)?, Stream(X)?, YesNo).
meets([], _, no).
meets([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), meets1(R1?, Xs?, B?, R).
procedure(X) meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
meets1(yes, _, _, yes).
meets1(no, Xs, B, R?) :- meets(Xs?, B?, R).

procedure lapp(Stream(_)?, Stream(_)?, Stream(_)).
lapp([], Ys, Ys?).
lapp([X|Xs], Ys, [X?|Zs?]) :- lapp(Xs?, Ys?, Zs).
