%% local.glp --- whether a contract of act schemas is a local and effective
%% specification with simple guards (vGLP, Section 5.4, the paragraph on act
%% schemas and the sentence after it; Section 3.2, Definition "Volition-Guarded
%% Specification, Participants, Guard Sets, Simple Guards"), and, where it is
%% not, the lines saying why.
%%
%% Local: "Such a contract is a local specification under three conditions.
%% First, every two schema-bindings of one class delete and add the same atoms
%% at each participant ...  Second, they require and forbid the same atoms at
%% every participant but one ...  Third, the schema-bindings determining any
%% two transactions of one class mark the same sets of people" (vGLP ca78e11,
%% Section 5.4, "Act schemas as local specifications"), the classes being
%% "those of the contract's equivalence, generated by relating two
%% transactions when one schema-binding determines both".  A state is a
%% multiset; two roles bound to one person act together there; and a
%% predicate of arity one the contract declares reflexive holds at every
%% person of that person, so an atom of it naming the participant is no
%% requirement there, and one forbidden there leaves the schema-binding
%% determining no transaction.  A schema-binding determining no transaction,
%% an atom both required and forbidden at a participant, is of no class.  The
%% third condition is taken as: two schema-bindings of one class marking
%% different people require and forbid the same atoms at every participant,
%% so that every transaction one determines the other does; otherwise the
%% contract is refused, the two schema-bindings named.
%% Two schema-bindings determining a common transaction delete and add the same
%% atoms at each of the same participants (GSC, Definition "Compilation"), and
%% vGLP takes a class to be all the schema-bindings of those participants and
%% those deleted and added atoms (vGLP #8, 2026-10-11 17:24 UTC, Q-A: "the class
%% is then the product of the union at the one participant and the common
%% requirements at the others").  So the contract is local when, for every
%% schema-binding, every schema-binding deleting and adding the same atoms at
%% the same participants requires and forbids the same atoms at all of them but
%% one; otherwise it is refused, the two schema-bindings named.
%%
%% The schemas name no person (GSC, Proposition "Anonymity"), so the bindings
%% of a schema are taken up to renaming: its roles and party variables sent to
%% people person(0), person(1), ... in order of first use, every partition of
%% them a binding; its speech-act variables to speech acts sp(U, S), U an
%% utterance in order of first use and S the signer, one of those people or
%% one person more, whom no other variable names.  For each such binding that
%% is one (GSC, Definition "Binding") and determines a transaction (GSC,
%% Definition "Compilation": the added and the deleted atoms of each person
%% disjoint), its schema-bindings of the same deleted and added atoms are found
%% by sending every schema's roles onto its participants and matching the atoms
%% they delete and add, a variable of none of them left free.  A free variable
%% in an atom required or forbidden at a participant makes the requirements
%% there differ for some binding of it.
%%
%% Simple guards: the guard sets of a class are "the minimal sets among the
%% people in the marked roles of its schema-bindings", and the specification
%% has simple guards "if every class has one guard set, or guard sets of one
%% person each"; a class with two minimal guard sets not both of one person is
%% refused, two schema-bindings with such sets named (vGLP 2026-10-11 22:59
%% UTC, Q1, Udi approved).
%%
%% Effective: "a contract of act schemas is effective where the schema-bindings
%% of each unguarded class require and forbid the same atoms at every
%% participant, and the atoms each unguarded schema requires at its first role
%% name every other role and every variable of its deleted and added atoms";
%% otherwise refused, the two schema-bindings or the schema named.  A class is
%% unguarded where one of its schema-bindings has no marked role, the empty set
%% then its one minimal guard set.

Val      ::= person(Integer) ; sp(Integer, Integer) ; free.
Vals     ::= [] ; [Val | Vals].
Bnd      ::= bnd(Arg, Val).
Binding  ::= [] ; [Bnd | Binding].
Bindings ::= [] ; [Binding | Bindings].
GA       ::= ga(Constant, Vals).
GAs      ::= [] ; [GA | GAs].
Part     ::= part(Integer, GAs, GAs).
Parts    ::= [] ; [Part | Parts].
Mate     ::= mate(Constant, RoleSpecs, Binding).
Mates    ::= [] ; [Mate | Mates].
Found    ::= found(Val) ; unbound.
Match    ::= match(Binding) ; nomatch.
Pair     ::= nonlocal(Constant, RoleSpecs, Binding, Constant, RoleSpecs, Binding)
           ; uneffective(Constant, RoleSpecs, Binding, Constant, RoleSpecs, Binding)
           ; nonsimple(Constant, RoleSpecs, Binding, Constant, RoleSpecs, Binding)
           ; guards_differ(Constant, RoleSpecs, Binding, Constant, RoleSpecs, Binding).
Pairs    ::= [] ; [Pair | Pairs].
Gd       ::= gd(Constant, RoleSpecs, Binding, Ints).
Gds      ::= [] ; [Gd | Gds].
GdRes    ::= gdf(Gd) ; nogd.

exported procedure faults(Contract?, Preds?, Stream(_)).
faults(C, Rf, Ls?) :- ground(C?), ground(Rf?) |
    local_pairs(C?, C?, Rf?, Ps),
    pair_lines(Ps?, L1),
    effective_lines(C?, L2),
    lapp(L1?, L2?, Ls).

%% The first pair found of each kind is named: not local, not simple, not
%% effective.
procedure pair_lines(Pairs?, Stream(_)).
pair_lines(Ps, L?) :- ground(Ps?) |
    first_of(nonlocal, Ps?, F1),
    first_of(nonsimple, Ps?, F2),
    first_of(uneffective, Ps?, F3),
    first_of(guards_differ, Ps?, F4),
    fault_lines(F1?, L1),
    fault_lines(F2?, L2),
    fault_lines(F3?, L3),
    fault_lines(F4?, L4),
    lapp(L3?, L4?, L34),
    lapp(L2?, L34?, L234),
    lapp(L1?, L234?, L).
procedure kind_of(Pair?, Constant).
kind_of(nonlocal(_, _, _, _, _, _), nonlocal).
kind_of(uneffective(_, _, _, _, _, _), uneffective).
kind_of(nonsimple(_, _, _, _, _, _), nonsimple).
kind_of(guards_differ(_, _, _, _, _, _), guards_differ).
procedure first_of(Constant?, Pairs?, Pairs).
first_of(_, [], []).
first_of(K, [P|Ps], F?) :- ground(K?), ground(P?) |
    kind_of(P?, K1),
    first_of1(K1?, K?, P?, Ps?, F).
procedure first_of1(Constant?, Constant?, Pair?, Pairs?, Pairs).
first_of1(K1, K, P, _, [P?]) :- K1? =?= K? | true.
first_of1(_, K, _, Ps, F?) :- otherwise | first_of(K?, Ps?, F).
procedure fault_lines(Pairs?, Stream(_)).
fault_lines([], []).
fault_lines([nonlocal(N1, Rs1, B1, N2, Rs2, B2)|_],
        ['%% it is not a local specification (vGLP, Section 5.4, the paragraph on act schemas):',
         '%% two schema-bindings delete and add the same atoms at each participant and require',
         '%% or forbid different atoms at two participants, a variable free being sent anywhere:',
         T1?, T2?]) :-
    two_terms(N1?, Rs1?, B1?, N2?, Rs2?, B2?, T1, T2).
fault_lines([nonsimple(N1, Rs1, B1, N2, Rs2, B2)|_],
        ['%% it does not have simple guards (vGLP, Section 3.2, Definition "Volition-Guarded',
         '%% Specification, Participants, Guard Sets, Simple Guards"): a class has two minimal guard',
         '%% sets, not both of one person, those of the marked roles of these schema-bindings:',
         T1?, T2?]) :-
    two_terms(N1?, Rs1?, B1?, N2?, Rs2?, B2?, T1, T2).
fault_lines([uneffective(N1, Rs1, B1, N2, Rs2, B2)|_],
        ['%% it is not effective (vGLP, Section 5.4, the sentence after the paragraph on act schemas):',
         '%% two schema-bindings of an unguarded class require or forbid different atoms at a',
         '%% participant, a variable free being sent anywhere:',
         T1?, T2?]) :-
    two_terms(N1?, Rs1?, B1?, N2?, Rs2?, B2?, T1, T2).
fault_lines([guards_differ(N1, Rs1, B1, N2, Rs2, B2)|_],
        ['%% it is not a local specification (vGLP, Section 5.4, the paragraph on act schemas,',
         '%% the third condition): two schema-bindings of one class mark different sets of people',
         '%% and require or forbid different atoms at a participant, so that two transactions of',
         '%% the class may be determined by schema-bindings marking different sets:',
         T1?, T2?]) :-
    two_terms(N1?, Rs1?, B1?, N2?, Rs2?, B2?, T1, T2).
procedure two_terms(Constant?, RoleSpecs?, Binding?, Constant?, RoleSpecs?, Binding?, _, _).
two_terms(N1, Rs1, B1, N2, Rs2, B2, T1?, T2?) :-
    ground(N1?), ground(Rs1?), ground(B1?), ground(N2?), ground(Rs2?), ground(B2?) |
    sb_term(N1?, Rs1?, B1?, S1),
    sb_term(N2?, Rs2?, B2?, S2),
    T1 =.. ['%% the schema-binding', S1?],
    T2 =.. ['%% and the schema-binding', S2?].

%% A schema-binding as the schema's name applied to the values of its
%% variables, in programs/gsc's order; free for a variable it leaves free.
procedure sb_term(Constant?, RoleSpecs?, Binding?, _).
sb_term(Nm, Rs, B, T?) :- ground(Nm?), ground(B?) |
    schema_vars(Rs?, Vs),
    vals_of(Vs?, B?, Xs),
    T =.. [Nm?|Xs?].
procedure vals_of(Args?, Binding?, Vals).
vals_of([], _, []).
vals_of([V|Vs], B, [X?|Xs?]) :- ground(B?) |
    lookup(V?, B?, F),
    val_or_free(F?, X),
    vals_of(Vs?, B?, Xs).
procedure val_or_free(Found?, Val).
val_or_free(found(X), X?).
val_or_free(unbound, free).

%% --- Effective -------------------------------------------------------------
procedure effective_lines(Contract?, Stream(_)).
effective_lines([], []).
effective_lines([schema(Nm, Rs)|Ss], L?) :- ground(Nm?), ground(Rs?) |
    guarded_any(Rs?, G),
    effective_one(G?, Nm?, Rs?, L1),
    effective_lines(Ss?, L2),
    lapp(L1?, L2?, L).
effective_lines([cschema(_, _, _)|Ss], L?) :- effective_lines(Ss?, L).
procedure guarded_any(RoleSpecs?, YesNo).
guarded_any([], no).
guarded_any([R|Rs], B?) :- rs_guarded(R?, B1), guarded_any1(B1?, Rs?, B).
procedure guarded_any1(YesNo?, RoleSpecs?, YesNo).
guarded_any1(yes, _, yes).
guarded_any1(no, Rs, B?) :- guarded_any(Rs?, B).
procedure effective_one(YesNo?, Constant?, RoleSpecs?, Stream(_)).
effective_one(yes, _, _, []).
effective_one(no, Nm, Rs, L?) :- ground(Rs?), ground(Nm?) |
    first_required_args(Rs?, Fa),
    rs_count(Rs?, K),
    role_args(2, K?, Others),
    changed_args(Rs?, Ch),
    drop_role_one(Ch?, Ch1),
    app(Others?, Ch1?, Need),
    all_member(Need?, Fa?, Ok),
    effective_one1(Ok?, Nm?, L).
procedure effective_one1(YesNo?, Constant?, Stream(_)).
effective_one1(yes, _, []).
effective_one1(no, Nm, ['%% it is not effective (vGLP, Section 5.4, the sentence after the paragraph on act schemas):',
        '%% an unguarded schema whose first role requires no atom naming some other role, or',
        '%% some variable of an atom it deletes or adds:', T?]) :-
    ground(Nm?) | T =.. ['%% the schema', Nm?].
procedure first_required_args(RoleSpecs?, Args).
first_required_args([], []).
first_required_args([R|_], As?) :- ground(R?) |
    rs_parts(R?, _, M, K, _),
    atoms_args(K?, A1),
    atoms_args(M?, A2),
    app(A1?, A2?, As).
procedure changed_args(RoleSpecs?, Args).
changed_args([], []).
changed_args([R|Rs], As?) :- ground(R?) |
    rs_parts(R?, P, M, _, _),
    atoms_args(P?, A1),
    atoms_args(M?, A2),
    changed_args(Rs?, A3),
    app(A2?, A3?, A23),
    app(A1?, A23?, As).
procedure drop_role_one(Args?, Args).
drop_role_one([], []).
drop_role_one([role(I)|As], R?) :- I? =:= 1 | drop_role_one(As?, R).
drop_role_one([A|As], [A?|R?]) :- otherwise | drop_role_one(As?, R).
procedure all_member(Args?, Args?, YesNo).
all_member([], _, yes).
all_member([A|As], Fa, B?) :- ground(Fa?) | mem(A?, Fa?, B1), all_member1(B1?, As?, Fa?, B).
procedure all_member1(YesNo?, Args?, Args?, YesNo).
all_member1(no, _, _, no).
all_member1(yes, As, Fa, B?) :- all_member(As?, Fa?, B).

%% --- Local -----------------------------------------------------------------
procedure local_pairs(Contract?, Contract?, Preds?, Pairs).
local_pairs([], _, _, []).
local_pairs([schema(Nm, Rs)|Ss], C, Rf, Ps?) :- ground(Nm?), ground(Rs?), ground(C?), ground(Rf?) |
    canon_bindings(Rs?, Bs),
    bindings_pairs(Bs?, Nm?, Rs?, C?, Rf?, P1),
    local_pairs(Ss?, C?, Rf?, P2),
    app(P1?, P2?, Ps).
local_pairs([cschema(_, _, _)|Ss], C, Rf, Ps?) :- local_pairs(Ss?, C?, Rf?, Ps).

procedure bindings_pairs(Bindings?, Constant?, RoleSpecs?, Contract?, Preds?, Pairs).
bindings_pairs([], _, _, _, _, []).
bindings_pairs([B|Bs], Nm, Rs, C, Rf, Ps?) :-
    ground(B?), ground(Nm?), ground(Rs?), ground(C?), ground(Rf?) |
    sig_of(Rs?, B?, Pt),
    binding_pairs(Pt?, B?, Nm?, Rs?, C?, Rf?, P1),
    bindings_pairs(Bs?, Nm?, Rs?, C?, Rf?, P2),
    app(P1?, P2?, Ps).
%% A schema-binding takes part in a class only where it determines a
%% transaction: its added and deleted atoms disjoint at each participant, and
%% its requirements there satisfiable, no atom both required and forbidden,
%% and no atom of a reflexive predicate naming the participant forbidden there
%% (vGLP, Section 5.4, the paragraph on act schemas: f is defined at d iff
%% some schema-binding of the class has the atoms it requires at p in d, with
%% the atoms of the reflexive predicates naming p, and those it forbids there
%% not).
procedure binding_pairs(Parts?, Binding?, Constant?, RoleSpecs?, Contract?, Preds?, Pairs).
binding_pairs(Pt, B, Nm, Rs, C, Rf, Ps?) :- ground(Pt?), ground(Rs?), ground(B?), ground(Rf?) |
    parts_valid(Pt?, V1),
    parts_people(Pt?, Q),
    live_at(Q?, Rs?, B?, Rf?, V2),
    and(V1?, V2?, V),
    binding_pairs1(V?, Pt?, B?, Nm?, Rs?, C?, Rf?, Ps).
procedure binding_pairs1(YesNo?, Parts?, Binding?, Constant?, RoleSpecs?, Contract?, Preds?,
    Pairs).
binding_pairs1(no, _, _, _, _, _, _, []).
%% The class of the schema-binding: its mates compared with it, at two
%% participants for locality and, where the class is unguarded, at one for
%% effectiveness, and, where they mark different people, at every one for the
%% third condition; and its minimal guard sets.
binding_pairs1(yes, Pt, B, Nm, Rs, C, Rf, Ps?) :- ground(Pt?), ground(Rf?) |
    mates_of(C?, Pt?, Rf?, Ms),
    class_faults(Ms?, Pt?, Nm?, Rs?, B?, Rf?, Ps).
procedure class_faults(Mates?, Parts?, Constant?, RoleSpecs?, Binding?, Preds?, Pairs).
class_faults(Ms, Pt, Nm, Rs, B, Rf, Ps?) :- ground(Ms?) |
    mates_guards(Ms?, Gs),
    class_faults1(Gs?, Ms?, Pt?, Nm?, Rs?, B?, Rf?, Ps).
procedure class_faults1(Gds?, Mates?, Parts?, Constant?, RoleSpecs?, Binding?, Preds?, Pairs).
class_faults1(Gs, Ms, Pt, Nm, Rs, B, Rf, Ps?) :- ground(Gs?), ground(Rs?), ground(B?) |
    some_unguarded(Gs?, Ug),
    guard_people(Rs?, 1, B?, G0),
    sort_ints(G0?, G1),
    dedup(G1?, G),
    compare_mates(Ms?, Ug?, G?, Pt?, Nm?, Rs?, B?, Rf?, P1),
    simple_fault(Gs?, P2),
    app(P1?, P2?, Ps).
procedure compare_mates(Mates?, YesNo?, Ints?, Parts?, Constant?, RoleSpecs?, Binding?, Preds?,
    Pairs).
compare_mates([], _, _, _, _, _, _, _, []).
compare_mates([mate(N2, Rs2, B2)|Ms], Ug, G, Pt, Nm, Rs, B, Rf, Ps?) :-
    ground(N2?), ground(Rs2?), ground(B2?), ground(Ug?), ground(G?), ground(Pt?), ground(Nm?),
    ground(Rs?), ground(B?), ground(Rf?) |
    parts_people(Pt?, Q),
    differing(Q?, Rs?, B?, Rs2?, B2?, Rf?, K),
    guard_people(Rs2?, 1, B2?, H0),
    sort_ints(H0?, H1),
    dedup(H1?, H),
    set_eq(G?, H?, SameG),
    compare_one(K?, Ug?, Nm?, Rs?, B?, N2?, Rs2?, B2?, P1),
    compare_marks(SameG?, K?, Nm?, Rs?, B?, N2?, Rs2?, B2?, P3),
    compare_mates(Ms?, Ug?, G?, Pt?, Nm?, Rs?, B?, Rf?, P2),
    app(P3?, P2?, P23),
    app(P1?, P23?, Ps).
%% The third condition: two schema-bindings of one class marking different
%% people require and forbid the same atoms at every participant, so that every
%% transaction one determines the other does.
procedure compare_marks(YesNo?, Integer?, Constant?, RoleSpecs?, Binding?, Constant?, RoleSpecs?,
    Binding?, Pairs).
compare_marks(yes, _, _, _, _, _, _, _, []).
compare_marks(no, K, N1, Rs1, B1, N2, Rs2, B2, [guards_differ(N1?, Rs1?, B1?, N2?, Rs2?, B2?)]) :-
    K? >= 1 | true.
compare_marks(no, K, _, _, _, _, _, _, []) :- K? < 1 | true.

%% live_at(Q, Rs, B, Rf, Ok): at each participant of Q, no atom both required
%% and forbidden, every variable of it bound, and no atom of a reflexive
%% predicate naming the participant forbidden.
procedure live_at(Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at([], _, _, _, yes).
live_at([P|Ps], Rs, B, Rf, Ok?) :- ground(Rs?), ground(B?), ground(Rf?), integer(P?) |
    reqs_at(Rs?, B?, P?, Rf?, R),
    forbs_at(Rs?, B?, P?, F),
    live_one(R?, F?, P?, Rf?, Ok1),
    live_at1(Ok1?, Ps?, Rs?, B?, Rf?, Ok).
procedure live_one(GAs?, GAs?, Integer?, Preds?, YesNo).
live_one(R, F, P, Rf, Ok?) :- ground(F?) |
    bound_gas(R?, Rb),
    meets(Rb?, F?, M1),
    own_reflexive_in(F?, P?, Rf?, M2),
    or(M1?, M2?, M),
    neg(M?, Ok).
procedure live_at1(YesNo?, Ints?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at1(no, _, _, _, _, no).
live_at1(yes, Ps, Rs, B, Rf, Ok?) :- live_at(Ps?, Rs?, B?, Rf?, Ok).
procedure bound_gas(GAs?, GAs).
bound_gas([], []).
bound_gas([ga(N, Xs)|As], R?) :- ground(Xs?) |
    mem(free, Xs?, Fr),
    bound_gas(As?, R1),
    keep_ga(Fr?, ga(N?, Xs?), R1?, R).
procedure keep_ga(YesNo?, GA?, GAs?, GAs).
keep_ga(no, A, R, [A?|R?]).
keep_ga(yes, _, R, R?).
procedure own_reflexive_in(GAs?, Integer?, Preds?, YesNo).
own_reflexive_in([], _, _, no).
own_reflexive_in([ga(N, [person(Q)])|As], P, Rf, B?) :- ground(Rf?), integer(P?), Q? =:= P? |
    mem(N?, Rf?, B1),
    own_reflexive_in1(B1?, As?, P?, Rf?, B).
own_reflexive_in([_|As], P, Rf, B?) :- otherwise | own_reflexive_in(As?, P?, Rf?, B).
procedure own_reflexive_in1(YesNo?, GAs?, Integer?, Preds?, YesNo).
own_reflexive_in1(yes, _, _, _, yes).
own_reflexive_in1(no, As, P, Rf, B?) :- own_reflexive_in(As?, P?, Rf?, B).
procedure compare_one(Integer?, YesNo?, Constant?, RoleSpecs?, Binding?, Constant?, RoleSpecs?,
    Binding?, Pairs).
compare_one(K, _, N1, Rs1, B1, N2, Rs2, B2, [nonlocal(N1?, Rs1?, B1?, N2?, Rs2?, B2?)]) :-
    K? >= 2 | true.
compare_one(K, yes, N1, Rs1, B1, N2, Rs2, B2, [uneffective(N1?, Rs1?, B1?, N2?, Rs2?, B2?)]) :-
    K? =:= 1 | true.
compare_one(K, no, _, _, _, _, _, _, []) :- K? =:= 1 | true.
compare_one(K, _, _, _, _, _, _, _, []) :- K? < 1 | true.

%% The people in the marked roles of each mate, a set, ascending.
procedure mates_guards(Mates?, Gds).
mates_guards([], []).
mates_guards([mate(N, Rs, B)|Ms], [gd(N?, Rs?, B?, G?)|Gs?]) :- ground(Rs?), ground(B?) |
    guard_people(Rs?, 1, B?, G0),
    sort_ints(G0?, G1),
    dedup(G1?, G),
    mates_guards(Ms?, Gs).
procedure some_unguarded(Gds?, YesNo).
some_unguarded([], no).
some_unguarded([gd(_, _, _, [])|_], yes).
some_unguarded([gd(_, _, _, [_|_])|Gs], B?) :- some_unguarded(Gs?, B).

%% Simple guards: the minimal guard sets one, or all of one person each;
%% otherwise two schema-bindings of distinct minimal sets, one of them not of
%% one person, named.
procedure simple_fault(Gds?, Pairs).
simple_fault(Gs, P?) :- ground(Gs?) |
    minimal_gds(Gs?, Gs?, M0),
    dedup_gds(M0?, M),
    simple_fault1(M?, P).
procedure simple_fault1(Gds?, Pairs).
simple_fault1(M, P?) :- ground(M?) |
    count_gds(M?, N),
    first_nonsingle(M?, F),
    simple_fault2(N?, F?, M?, P).
procedure simple_fault2(Integer?, GdRes?, Gds?, Pairs).
simple_fault2(N, _, _, []) :- N? < 2 | true.
simple_fault2(N, nogd, _, []) :- N? >= 2 | true.
simple_fault2(N, gdf(G1), M, P?) :- N? >= 2, ground(G1?) |
    other_gd(G1?, M?, G2),
    nonsimple_pair(G1?, G2?, P).
procedure nonsimple_pair(Gd?, GdRes?, Pairs).
nonsimple_pair(gd(N1, Rs1, B1, _), gdf(gd(N2, Rs2, B2, _)),
        [nonsimple(N1?, Rs1?, B1?, N2?, Rs2?, B2?)]).
nonsimple_pair(_, nogd, []).
procedure minimal_gds(Gds?, Gds?, Gds).
minimal_gds([], _, []).
minimal_gds([gd(N, Rs, B, G)|Gs], All, M?) :- ground(G?), ground(All?) |
    has_smaller(All?, G?, S),
    minimal_gds(Gs?, All?, M1),
    keep_gd(S?, gd(N?, Rs?, B?, G?), M1?, M).
procedure has_smaller(Gds?, Ints?, YesNo).
has_smaller([], _, no).
has_smaller([gd(_, _, _, H)|Gs], G, B?) :- ground(H?), ground(G?) |
    all_in(H?, G?, Sub),
    all_in(G?, H?, Sup),
    neg(Sup?, Strict),
    and(Sub?, Strict?, B1),
    has_smaller1(B1?, Gs?, G?, B).
procedure has_smaller1(YesNo?, Gds?, Ints?, YesNo).
has_smaller1(yes, _, _, yes).
has_smaller1(no, Gs, G, B?) :- has_smaller(Gs?, G?, B).
procedure keep_gd(YesNo?, Gd?, Gds?, Gds).
keep_gd(yes, _, M, M?).
keep_gd(no, X, M, [X?|M?]).
procedure dedup_gds(Gds?, Gds).
dedup_gds([], []).
dedup_gds([gd(N, Rs, B, G)|Gs], [gd(N?, Rs?, B?, G?)|R?]) :- ground(G?) |
    drop_gds(G?, Gs?, Gs1),
    dedup_gds(Gs1?, R).
procedure drop_gds(Ints?, Gds?, Gds).
drop_gds(_, [], []).
drop_gds(G, [gd(_, _, _, H)|Gs], R?) :- G? =?= H? | drop_gds(G?, Gs?, R).
drop_gds(G, [X|Gs], [X?|R?]) :- otherwise | drop_gds(G?, Gs?, R).
procedure count_gds(Gds?, Integer).
count_gds([], 0).
count_gds([_|Gs], N?) :- count_gds(Gs?, M), N := M? + 1.
procedure first_nonsingle(Gds?, GdRes).
first_nonsingle([], nogd).
first_nonsingle([gd(_, _, _, [_])|Gs], F?) :- first_nonsingle(Gs?, F).
first_nonsingle([gd(N, Rs, B, G)|_], gdf(gd(N?, Rs?, B?, G?))) :- otherwise | true.
procedure other_gd(Gd?, Gds?, GdRes).
other_gd(_, [], nogd).
other_gd(gd(N, Rs, B, G), [gd(_, _, _, H)|Gs], F?) :- ground(G?), ground(H?), G? =?= H? |
    other_gd(gd(N?, Rs?, B?, G?), Gs?, F).
other_gd(_, [Y|_], gdf(Y?)) :- otherwise | true.
procedure sort_ints(Ints?, Ints).
sort_ints([], []).
sort_ints([X|Xs], S?) :- sort_ints(Xs?, S1), insert_int(X?, S1?, S).
procedure insert_int(Integer?, Ints?, Ints).
insert_int(X, [], [X?]).
insert_int(X, [Y|Ys], [X?, Y?|Ys?]) :- X? =< Y? | true.
insert_int(X, [Y|Ys], [Y?|R?]) :- X? > Y? | insert_int(X?, Ys?, R).

%% The number of participants at which the two require or forbid different
%% atoms, an atom with a variable left free differing.
procedure differing(Ints?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, Integer).
differing([], _, _, _, _, _, 0).
differing([P|Ps], Rs, B, Rs2, B2, Rf, K?) :-
    ground(Rs?), ground(B?), ground(Rs2?), ground(B2?), ground(Rf?) |
    reqs_at(Rs?, B?, P?, Rf?, R1),
    reqs_at(Rs2?, B2?, P?, Rf?, R2),
    forbs_at(Rs?, B?, P?, F1),
    forbs_at(Rs2?, B2?, P?, F2),
    same_atoms(R1?, R2?, F1?, F2?, E),
    differing(Ps?, Rs?, B?, Rs2?, B2?, Rf?, K1),
    count_differs(E?, K1?, K).
procedure count_differs(YesNo?, Integer?, Integer).
count_differs(yes, K, K?).
count_differs(no, K1, K?) :- K := K1? + 1.
procedure same_atoms(GAs?, GAs?, GAs?, GAs?, YesNo).
same_atoms(R1, R2, F1, F2, E?) :- ground(R2?), ground(F2?) |
    open_atoms(R2?, O1),
    open_atoms(F2?, O2),
    ms_eq(R1?, R2?, E1),
    dedup(F1?, F1s),
    dedup(F2?, F2s),
    set_eq(F1s?, F2s?, E2),
    or(O1?, O2?, O),
    neg(O?, NO),
    and(E1?, E2?, E12),
    and(NO?, E12?, E).
procedure open_atoms(GAs?, YesNo).
open_atoms([], no).
open_atoms([ga(_, Xs)|As], B?) :- mem(free, Xs?, B1), open_atoms1(B1?, As?, B).
procedure open_atoms1(YesNo?, GAs?, YesNo).
open_atoms1(yes, _, yes).
open_atoms1(no, As, B?) :- open_atoms(As?, B).

%% The atoms required (=(i) and -(i)) at the roles sent to P, joined, less
%% those of a reflexive predicate naming P, which hold at every person of that
%% person (vGLP, Section 5.4, the paragraph on act schemas); and those
%% forbidden there.
procedure reqs_at(RoleSpecs?, Binding?, Integer?, Preds?, GAs).
reqs_at(Rs, B, P, Rf, R?) :- ground(B?), integer(P?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    reqs_join(RsP?, B?, [], R0),
    drop_own_reflexive(R0?, P?, Rf?, R).
procedure drop_own_reflexive(GAs?, Integer?, Preds?, GAs).
drop_own_reflexive([], _, _, []).
drop_own_reflexive([ga(N, [person(Q)])|As], P, Rf, R?) :-
    ground(Rf?), integer(P?), integer(Q?), Q? =:= P? |
    mem(N?, Rf?, Own),
    drop_own_reflexive(As?, P?, Rf?, R1),
    keep_ga(Own?, ga(N?, [person(Q?)]), R1?, R).
drop_own_reflexive([A|As], P, Rf, [A?|R?]) :- otherwise | drop_own_reflexive(As?, P?, Rf?, R).
procedure reqs_join(RoleSpecs?, Binding?, GAs?, GAs).
reqs_join([], _, Acc, Acc?).
reqs_join([R|Rs], B, Acc, Out?) :- ground(R?), ground(B?) |
    rs_parts(R?, _, M, K, _),
    img_atoms(K?, B?, G1),
    img_atoms(M?, B?, G2),
    app(G1?, G2?, G),
    ms_join(Acc?, G?, Acc1),
    reqs_join(Rs?, B?, Acc1?, Out).
procedure forbs_at(RoleSpecs?, Binding?, Integer?, GAs).
forbs_at(Rs, B, P, F?) :- ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    forbs_cat(RsP?, B?, F).
procedure forbs_cat(RoleSpecs?, Binding?, GAs).
forbs_cat([], _, []).
forbs_cat([R|Rs], B, F?) :- ground(R?), ground(B?) |
    rs_parts(R?, _, _, _, N),
    img_atoms(N?, B?, G),
    forbs_cat(Rs?, B?, F1),
    app(G?, F1?, F).

%% --- The bindings of a schema, up to renaming ------------------------------
procedure canon_bindings(RoleSpecs?, Bindings).
canon_bindings(Rs, Bs?) :- ground(Rs?) |
    schema_vars(Rs?, Vs),
    canon_bindings1(Rs?, Vs?, Bs).
procedure canon_bindings1(RoleSpecs?, Args?, Bindings).
canon_bindings1(Rs, Vs, Bs?) :- ground(Rs?), ground(Vs?) |
    person_vars(Vs?, Pv),
    speech_vars(Vs?, Sv),
    rgs(Pv?, 0, [], B1),
    rule_filter(B1?, Rs?, B2),
    with_speech(B2?, Sv?, B3),
    adm_filter(B3?, Rs?, Bs).
procedure person_vars(Args?, Args).
person_vars([], []).
person_vars([role(I)|Vs], [role(I?)|R?]) :- person_vars(Vs?, R).
person_vars([pvar(X)|Vs], [pvar(X?)|R?]) :- person_vars(Vs?, R).
person_vars([svar(_)|Vs], R?) :- person_vars(Vs?, R).
person_vars([nterm(_)|Vs], R?) :- person_vars(Vs?, R).
procedure speech_vars(Args?, Args).
speech_vars([], []).
speech_vars([svar(X)|Vs], [svar(X?)|R?]) :- speech_vars(Vs?, R).
speech_vars([role(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([pvar(_)|Vs], R?) :- speech_vars(Vs?, R).
speech_vars([nterm(_)|Vs], R?) :- speech_vars(Vs?, R).

%% rgs(Vs, N, B, Bs): every extension of B sending Vs to people, person(N)
%% being the first not yet used.
procedure rgs(Args?, Integer?, Binding?, Bindings).
rgs([], _, B, [B?]).
rgs([X|Xs], N, B, R?) :- ground(X?), ground(Xs?), ground(B?) |
    rgs_from(0, N?, X?, Xs?, B?, R).
procedure rgs_from(Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
rgs_from(I, N, _, _, _, []) :- I? > N? | true.
rgs_from(I, N, X, Xs, B, R?) :- I? =< N?, ground(X?), ground(Xs?), ground(B?) |
    next_fresh(I?, N?, N1),
    rgs(Xs?, N1?, [bnd(X?, person(I?))|B?], R1),
    I1 := I? + 1,
    rgs_from(I1?, N?, X?, Xs?, B?, R2),
    app(R1?, R2?, R).
procedure next_fresh(Integer?, Integer?, Integer).
next_fresh(I, N, N1?) :- I? =:= N? | N1 := N? + 1.
next_fresh(I, N, N?) :- I? < N? | true.

%% with_speech(Bs, Sv, R): each binding of Bs extended to the speech-act
%% variables, an utterance in order of first use and, for a new one, its signer
%% one of the people the binding uses or one more.
procedure with_speech(Bindings?, Args?, Bindings).
with_speech([], _, []).
with_speech([B|Bs], Sv, R?) :- ground(B?), ground(Sv?) |
    people_count(B?, NP),
    svs(Sv?, 0, NP?, B?, R1),
    with_speech(Bs?, Sv?, R2),
    app(R1?, R2?, R).
procedure people_count(Binding?, Integer).
people_count([], 0).
people_count([bnd(_, person(I))|Bs], N?) :- people_count(Bs?, M), max1(I?, M?, N).
people_count([bnd(_, sp(_, _))|Bs], N?) :- people_count(Bs?, N).
people_count([bnd(_, free)|Bs], N?) :- people_count(Bs?, N).
procedure max1(Integer?, Integer?, Integer).
max1(I, M, N?) :- I? >= M? | N := I? + 1.
max1(I, M, M?) :- I? < M? | true.
procedure svs(Args?, Integer?, Integer?, Binding?, Bindings).
svs([], _, _, B, [B?]).
svs([Y|Ys], NU, NP, B, R?) :- ground(Y?), ground(Ys?), ground(B?) |
    svs_old(0, NU?, NP?, Y?, Ys?, B?, R1),
    svs_new(0, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% An utterance already used, U < NU, with the signer it has.
procedure svs_old(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_old(U, NU, _, _, _, _, []) :- U? >= NU? | true.
svs_old(U, NU, NP, Y, Ys, B, R?) :- U? < NU?, ground(Y?), ground(Ys?), ground(B?) |
    signer_of(U?, B?, S),
    svs(Ys?, NU?, NP?, [bnd(Y?, sp(U?, S?))|B?], R1),
    U1 := U? + 1,
    svs_old(U1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
%% A new utterance NU, signed by person S, 0 =< S =< NP.
procedure svs_new(Integer?, Integer?, Integer?, Arg?, Args?, Binding?, Bindings).
svs_new(S, _, NP, _, _, _, []) :- S? > NP? | true.
svs_new(S, NU, NP, Y, Ys, B, R?) :- S? =< NP?, ground(Y?), ground(Ys?), ground(B?) |
    NU1 := NU? + 1,
    svs(Ys?, NU1?, NP?, [bnd(Y?, sp(NU?, S?))|B?], R1),
    S1 := S? + 1,
    svs_new(S1?, NU?, NP?, Y?, Ys?, B?, R2),
    app(R1?, R2?, R).
procedure signer_of(Integer?, Binding?, Integer).
signer_of(_, [], 0).
signer_of(U, [bnd(_, sp(U1, S))|_], S?) :- U? =:= U1? | true.
signer_of(U, [_|Bs], S?) :- otherwise | signer_of(U?, Bs?, S).

procedure rule_filter(Bindings?, RoleSpecs?, Bindings).
rule_filter([], _, []).
rule_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    rule_ok(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    rule_filter(Bs?, Rs?, R1).
procedure adm_filter(Bindings?, RoleSpecs?, Bindings).
adm_filter([], _, []).
adm_filter([B|Bs], Rs, R?) :- ground(B?), ground(Rs?) |
    admissible(Rs?, B?, Ok),
    keep_binding(Ok?, B?, R1?, R),
    adm_filter(Bs?, Rs?, R1).
procedure keep_binding(YesNo?, Binding?, Bindings?, Bindings).
keep_binding(yes, B, R, [B?|R?]).
keep_binding(no, _, R, R?).

%% --- Schema-bindings: signatures and mates, as the platform computes them --
%% The participants and, for each, the join of the atoms its roles delete and
%% add (GSC, Definition "Compilation").
procedure sig_of(RoleSpecs?, Binding?, Parts).
sig_of(Rs, B, Pt?) :- ground(Rs?), ground(B?) |
    role_people(Rs?, 1, B?, Ws),
    dedup(Ws?, Q),
    parts_for(Q?, Rs?, B?, Pt).
procedure role_people(RoleSpecs?, Integer?, Binding?, Ints).
role_people([], _, _, []).
role_people([_|Rs], I, B, [P?|Ps?]) :- integer(I?), ground(B?) |
    role_person(I?, B?, P),
    I1 := I? + 1,
    role_people(Rs?, I1?, B?, Ps).
procedure role_person(Integer?, Binding?, Integer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), person_index(F?, P).
procedure person_index(Found?, Integer).
person_index(found(person(P)), P?).
person_index(found(sp(_, _)), -1).
person_index(found(free), -1).
person_index(unbound, -1).
procedure parts_for(Ints?, RoleSpecs?, Binding?, Parts).
parts_for([], _, _, []).
parts_for([P|Ps], Rs, B, [part(P?, D?, A?)|Xs?]) :- ground(Rs?), ground(B?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    joins(RsP?, B?, D, A),
    parts_for(Ps?, Rs?, B?, Xs).
procedure joins(RoleSpecs?, Binding?, GAs, GAs).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) |
    changes_join(RsP?, B?, del, [], D),
    changes_join(RsP?, B?, add, [], A).
procedure changes_join(RoleSpecs?, Binding?, Constant?, GAs?, GAs).
changes_join([], _, _, Acc, Acc?).
changes_join([R|Rs], B, W, Acc, Out?) :- ground(R?), ground(B?), ground(W?) |
    rs_parts(R?, P, M, _, _),
    which(W?, P?, M?, Xs),
    img_atoms(Xs?, B?, G),
    ms_join(Acc?, G?, Acc1),
    changes_join(Rs?, B?, W?, Acc1?, Out).
procedure which(Constant?, Atoms?, Atoms?, Atoms).
which(W, P, _, P?) :- W? =?= add | true.
which(W, _, M, M?) :- W? =?= del | true.
which(_, _, _, []) :- otherwise | true.
procedure specs_at(RoleSpecs?, Integer?, Binding?, Integer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R|Rs], I, B, P, Out?) :- integer(I?), ground(B?) |
    role_person(I?, B?, Q),
    I1 := I? + 1,
    specs_at(Rs?, I1?, B?, P?, Rest),
    keep_spec(Q?, P?, R?, Rest?, Out).
procedure keep_spec(Integer?, Integer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R?|Rest?]) :- Q? =:= P? | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.
procedure parts_valid(Parts?, YesNo).
parts_valid([], yes).
parts_valid([part(_, D, A)|Ps], B?) :- ground(A?) |
    meets(D?, A?, M),
    neg(M?, B1),
    parts_valid1(B1?, Ps?, B).
procedure parts_valid1(YesNo?, Parts?, YesNo).
parts_valid1(no, _, no).
parts_valid1(yes, Ps, B?) :- parts_valid(Ps?, B).
procedure parts_people(Parts?, Ints).
parts_people([], []).
parts_people([part(P, _, _)|Ps], [P?|Qs?]) :- parts_people(Ps?, Qs).
procedure parts_eq(Parts?, Parts?, YesNo).
parts_eq(A, B, E?) :- ground(A?), ground(B?) |
    parts_people(A?, Pa),
    parts_people(B?, Pb),
    set_eq(Pa?, Pb?, E1),
    parts_in(A?, B?, E2),
    and(E1?, E2?, E).
procedure parts_in(Parts?, Parts?, YesNo).
parts_in([], _, yes).
parts_in([X|Xs], B, E?) :- ground(B?) |
    part_in(X?, B?, E1),
    parts_in1(E1?, Xs?, B?, E).
procedure parts_in1(YesNo?, Parts?, Parts?, YesNo).
parts_in1(no, _, _, no).
parts_in1(yes, Xs, B, E?) :- parts_in(Xs?, B?, E).
procedure part_in(Part?, Parts?, YesNo).
part_in(_, [], no).
part_in(part(P, D, A), [part(Q, D1, A1)|Ps], E?) :- P? =:= Q?, ground(D?), ground(A?) |
    ms_eq(D?, D1?, E1),
    ms_eq(A?, A1?, E2),
    and(E1?, E2?, E3),
    part_in1(E3?, part(P?, D?, A?), Ps?, E).
part_in(X, [_|Ps], E?) :- otherwise | part_in(X?, Ps?, E).
procedure part_in1(YesNo?, Part?, Parts?, YesNo).
part_in1(yes, _, _, yes).
part_in1(no, X, Ps, E?) :- part_in(X?, Ps?, E).

%% GSC, Definition "Binding": two roles sent to one person only if neither
%% adds or deletes an atom naming the other.
procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) |
    rs_count(Rs?, K),
    pairs_ok(1, K?, Rs?, B?, R).
procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- I? > K? | true.
pairs_ok(I, K, Rs, B, R?) :- I? =< K?, ground(Rs?), ground(B?) |
    J := I? + 1,
    pair_row(I?, J?, K?, Rs?, B?, R1),
    I1 := I? + 1,
    pairs_ok1(R1?, I1?, K?, Rs?, B?, R).
procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).
procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- J? > K? | true.
pair_row(I, J, K, Rs, B, R?) :- J? =< K?, ground(Rs?), ground(B?) |
    role_person(I?, B?, P),
    role_person(J?, B?, Q),
    nth_spec(Rs?, I?, RI),
    nth_spec(Rs?, J?, RJ),
    pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1),
    J1 := J? + 1,
    pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).
procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).
procedure pair_ok(Integer?, Integer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- P? =:= Q? |
    role_names(RI?, J?, A1),
    role_names(RJ?, I?, A2),
    or(A1?, A2?, A),
    neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.
procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(R, J, B?) :- ground(R?), integer(J?) |
    rs_parts(R?, P, M, _, _),
    names_role(P?, J?, B1),
    names_role(M?, J?, B2),
    or(B1?, B2?, B).
procedure names_role(Atoms?, Integer?, YesNo).
names_role([], _, no).
names_role([atom(_, As)|Xs], J, B?) :- integer(J?) |
    mem(role(J?), As?, B1),
    names_role1(B1?, Xs?, J?, B).
procedure names_role1(YesNo?, Atoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, Xs, J, B?) :- names_role(Xs?, J?, B).
procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R|_], I, R?) :- I? =:= 1 | true.
nth_spec([_|Rs], I, R?) :- I? > 1 | I1 := I? - 1, nth_spec(Rs?, I1?, R).

%% GSC, Definition "Binding", admissible.
procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) |
    added_atoms(Rs?, Ad),
    required_atoms(Rs?, Rq),
    guard_people(Rs?, 1, B?, Gp),
    atoms_args(Ad?, Av),
    atoms_args(Rq?, Qv),
    adm_each(Av?, Qv?, B?, Gp?, R).
procedure adm_each(Args?, Args?, Binding?, Ints?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V|Vs], Qv, B, Gp, R?) :- ground(V?), ground(Qv?), ground(B?), ground(Gp?) |
    adm_var(V?, Qv?, B?, Gp?, R1),
    adm_each1(R1?, Vs?, Qv?, B?, Gp?, R).
procedure adm_each1(YesNo?, Args?, Args?, Binding?, Ints?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Qv, B, Gp, R?) :- adm_each(Vs?, Qv?, B?, Gp?, R).
procedure adm_var(Arg?, Args?, Binding?, Ints?, YesNo).
adm_var(svar(X), Qv, B, Gp, R?) :- ground(X?), ground(B?) |
    mem(svar(X?), Qv?, InReq),
    lookup(svar(X?), B?, F),
    adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(nterm(_), _, _, _, yes).
procedure adm_var1(YesNo?, Found?, Ints?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(sp(_, S)), Gp, R?) :- mem(S?, Gp?, R).
adm_var1(no, found(person(_)), _, no).
adm_var1(no, found(free), _, no).
adm_var1(no, unbound, _, no).
procedure added_atoms(RoleSpecs?, Atoms).
added_atoms([], []).
added_atoms([R|Rs], A?) :- ground(R?) | rs_parts(R?, P, _, _, _), added_atoms(Rs?, A1), app(P?, A1?, A).
procedure required_atoms(RoleSpecs?, Atoms).
required_atoms([], []).
required_atoms([R|Rs], A?) :- ground(R?) |
    rs_parts(R?, _, M, K, _),
    required_atoms(Rs?, A1),
    app(M?, A1?, A2),
    app(K?, A2?, A).
procedure guard_people(RoleSpecs?, Integer?, Binding?, Ints).
guard_people([], _, _, []).
guard_people([R|Rs], I, B, G?) :- ground(R?), integer(I?), ground(B?) |
    rs_guarded(R?, Gd),
    role_person(I?, B?, P),
    I1 := I? + 1,
    guard_people(Rs?, I1?, B?, G1),
    keep_int(Gd?, P?, G1?, G).
procedure keep_int(YesNo?, Integer?, Ints?, Ints).
keep_int(yes, P, G, [P?|G?]).
keep_int(no, _, G, G?).

%% The schema-bindings of every schema whose roles, sent onto the
%% participants, delete and add exactly the atoms of Pt.
procedure mates_of(Contract?, Parts?, Preds?, Mates).
mates_of([], _, _, []).
mates_of([schema(Nm, Rs)|Ss], Pt, Rf, M?) :- ground(Nm?), ground(Rs?), ground(Pt?), ground(Rf?) |
    parts_people(Pt?, Q),
    rs_count(Rs?, K),
    assigns(K?, Q?, As),
    mates_assigns(As?, Nm?, Rs?, Pt?, Rf?, M1),
    mates_of(Ss?, Pt?, Rf?, M2),
    app(M1?, M2?, M).
mates_of([cschema(_, _, _)|Ss], Pt, Rf, M?) :- mates_of(Ss?, Pt?, Rf?, M).
procedure assigns(Integer?, Ints?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).
procedure assigns1(Integer?, Integer?, Ints?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- I? > K? | true.
assigns1(I, K, Q, Acc, R?) :- I? =< K?, ground(Q?) |
    extend_role(Acc?, I?, Q?, Acc1),
    I1 := I? + 1,
    assigns1(I1?, K?, Q?, Acc1?, R).
procedure extend_role(Bindings?, Integer?, Ints?, Bindings).
extend_role([], _, _, []).
extend_role([B|Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) |
    extend_one(Q?, I?, B?, R1),
    extend_role(Bs?, I?, Q?, R2),
    app(R1?, R2?, R).
procedure extend_one(Ints?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P|Ps], I, B, [[bnd(role(I?), person(P?))|B?]|R?]) :- ground(B?), integer(I?) |
    extend_one(Ps?, I?, B?, R).
procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Parts?, Preds?, Mates).
mates_assigns([], _, _, _, _, []).
mates_assigns([B|Bs], Nm, Rs, Pt, Rf, M?) :-
    ground(B?), ground(Nm?), ground(Rs?), ground(Pt?), ground(Rf?) |
    parts_people(Pt?, Q),
    role_people(Rs?, 1, B?, Ws),
    all_in(Q?, Ws?, Onto),
    rule_ok(Rs?, B?, Ok),
    and(Onto?, Ok?, Go),
    mates_assign(Go?, B?, Nm?, Rs?, Pt?, Rf?, M1),
    mates_assigns(Bs?, Nm?, Rs?, Pt?, Rf?, M2),
    app(M1?, M2?, M).
procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Parts?, Preds?, Mates).
mates_assign(no, _, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Pt, Rf, M?) :- ground(Rs?), ground(Pt?) |
    match_parts(Pt?, Rs?, [B?], Bs),
    mates_check(Bs?, Nm?, Rs?, Pt?, Rf?, M).
procedure match_parts(Parts?, RoleSpecs?, Bindings?, Bindings).
match_parts([], _, Bs, Bs?).
match_parts([part(P, D, A)|Pt], Rs, Bs, R?) :- ground(D?), ground(A?), ground(Rs?) |
    match_part(Bs?, P?, D?, A?, Rs?, Bs1),
    match_parts(Pt?, Rs?, Bs1?, R).
procedure match_part(Bindings?, Integer?, GAs?, GAs?, RoleSpecs?, Bindings).
match_part([], _, _, _, _, []).
match_part([B|Bs], P, D, A, Rs, R?) :- ground(B?), ground(D?), ground(A?), ground(Rs?) |
    specs_at(Rs?, 1, B?, P?, RsP),
    match_part1(RsP?, B?, D?, A?, B2),
    match_part(Bs?, P?, D?, A?, Rs?, R2),
    app(B2?, R2?, R).
procedure match_part1(RoleSpecs?, Binding?, GAs?, GAs?, Bindings).
match_part1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) |
    changes_cat(RsP?, del, Dp),
    changes_cat(RsP?, add, Ap),
    match_all(Dp?, D?, B?, B1),
    match_all_each(B1?, Ap?, A?, R).
procedure changes_cat(RoleSpecs?, Constant?, Atoms).
changes_cat([], _, []).
changes_cat([R|Rs], W, Xs?) :- ground(R?), ground(W?) |
    rs_parts(R?, P, M, _, _),
    which(W?, P?, M?, X1),
    changes_cat(Rs?, W?, X2),
    app(X1?, X2?, Xs).
procedure mates_check(Bindings?, Constant?, RoleSpecs?, Parts?, Preds?, Mates).
mates_check([], _, _, _, _, []).
mates_check([B|Bs], Nm, Rs, Pt, Rf, M?) :-
    ground(B?), ground(Nm?), ground(Rs?), ground(Pt?), ground(Rf?) |
    sig_of(Rs?, B?, Pt1),
    parts_eq(Pt?, Pt1?, E1),
    admissible(Rs?, B?, E2),
    parts_people(Pt?, Q),
    live_at(Q?, Rs?, B?, Rf?, E3),
    and(E1?, E2?, E12),
    and(E12?, E3?, E),
    mate_of(E?, B?, Nm?, Rs?, M1),
    mates_check(Bs?, Nm?, Rs?, Pt?, Rf?, M2),
    app(M1?, M2?, M).
procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, Rs?, B?)]).

procedure all_in(Ints?, Ints?, YesNo).
all_in([], _, yes).
all_in([P|Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).
procedure all_in1(YesNo?, Ints?, Ints?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).

%% --- Atoms, bindings and matching ------------------------------------------
procedure lookup(Arg?, Binding?, Found).
lookup(_, [], unbound).
lookup(V, [bnd(W, X)|_], found(X?)) :- V? =?= W? | true.
lookup(V, [_|Bs], F?) :- otherwise | lookup(V?, Bs?, F).
procedure img_atoms(Atoms?, Binding?, GAs).
img_atoms([], _, []).
img_atoms([atom(P, As)|Xs], B, [ga(P?, Vs?)|Gs?]) :- ground(B?) |
    img_args(As?, B?, Vs),
    img_atoms(Xs?, B?, Gs).
procedure img_args(Args?, Binding?, Vals).
img_args([], _, []).
img_args([A|As], B, [X?|Xs?]) :- ground(B?) |
    lookup(A?, B?, F),
    val_or_free(F?, X),
    img_args(As?, B?, Xs).

procedure match_all(Atoms?, GAs?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A|As], Gs, B, R?) :- ground(Gs?) |
    match_into(A?, Gs?, B?, Bs),
    match_all_each(Bs?, As?, Gs?, R).
procedure match_all_each(Bindings?, Atoms?, GAs?, Bindings).
match_all_each([], _, _, []).
match_all_each([B|Bs], As, Gs, R?) :- ground(As?), ground(Gs?) |
    match_all(As?, Gs?, B?, R1),
    match_all_each(Bs?, As?, Gs?, R2),
    app(R1?, R2?, R).
procedure match_into(Atom?, GAs?, Binding?, Bindings).
match_into(_, [], _, []).
match_into(A, [G|Gs], B, R?) :- ground(A?), ground(B?) |
    match_atom(A?, G?, B?, M),
    match_into1(M?, A?, Gs?, B?, R).
procedure match_into1(Match?, Atom?, GAs?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1?|R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).
procedure match_atom(Atom?, GA?, Binding?, Match).
match_atom(atom(P, As), ga(Q, Xs), B, R?) :- P? =?= Q? | match_args(As?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.
procedure match_args(Args?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_|_], _, nomatch).
match_args([_|_], [], _, nomatch).
match_args([V|Vs], [X|Xs], B, R?) :- ground(V?), ground(X?), ground(B?) |
    lookup(V?, B?, F),
    kind_ok(V?, X?, K),
    match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).
procedure match_one(Found?, YesNo?, Arg?, Val?, Args?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- W? =?= X? | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(unbound, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [bnd(V?, X?)|B?], R).
match_one(unbound, no, _, _, _, _, _, nomatch).
procedure kind_ok(Arg?, Val?, YesNo).
kind_ok(role(_), person(_), yes).
kind_ok(pvar(_), person(_), yes).
kind_ok(svar(_), sp(_, _), yes).
kind_ok(_, _, no) :- otherwise | true.

%% --- Multisets --------------------------------------------------------------
procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y|Ys], yes, Ys?) :- X? =?= Y? | true.
ms_remove(X, [Y|Ys], F?, [Y?|Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).
procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X|Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).
procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X|Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).
procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).
procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) |
    ms_sub(A?, B?, R1),
    ms_sub(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) set_eq(Stream(X)?, Stream(X)?, YesNo).
set_eq(A, B, R?) :- ground(A?), ground(B?) |
    all_of(A?, B?, R1),
    all_of(B?, A?, R2),
    and(R1?, R2?, R).
procedure(X) all_of(Stream(X)?, Stream(X)?, YesNo).
all_of([], _, yes).
all_of([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), all_of1(R1?, Xs?, B?, R).
procedure(X) all_of1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
all_of1(no, _, _, no).
all_of1(yes, Xs, B, R?) :- all_of(Xs?, B?, R).
procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).
procedure(X) meets(Stream(X)?, Stream(X)?, YesNo).
meets([], _, no).
meets([X|Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), meets1(R1?, Xs?, B?, R).
procedure(X) meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
meets1(yes, _, _, yes).
meets1(no, Xs, B, R?) :- meets(Xs?, B?, R).

procedure lapp(Stream(_)?, Stream(_)?, Stream(_)).
lapp([], Ys, Ys?).
lapp([X|Xs], Ys, [X?|Zs?]) :- lapp(Xs?, Ys?, Zs).
