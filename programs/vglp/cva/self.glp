%% ---------------------------------------------------------------------------
%% programs/vglp/cva --- the compiler from an act-schema contract to its
%% canonical CVA platform in vGLP (compiler/, compile.sh), vGLP's contracts
%% beside GSC's three, their owners' (contracts.glp), the platforms it prints
%% (social_graph/platform.vglp, social_network/platform.vglp, currency/platform.vglp, nudge/platform.vglp,
%% introduce/platform.vglp, gnudge/platform.vglp, childsafe/platform.vglp,
%% link/platform.vglp, friends/platform.vglp, waves/platform.vglp, parts/platform.vglp, opens/platform.vglp, groups/platform.vglp, counter/platform.vglp, merges/platform.vglp, coins/platform.vglp, wardclose/platform.vglp, numbers/platform.vglp, bonds/platform.vglp, intros/platform.vglp, days/platform.vglp, each beside its plays) and what the plays of all of them share, here: a
%% scripted person and a network between two agents, three or four.
%%
%% A play runs the agents of a compiled platform, each the agent of the module
%% with its ask stream and its dispatcher on that stream, on its person
%% channel and on the program's output, the agent's views (to_person/2), as
%% whatever spawns an agent's initial goal does (vGLP, Definition "Canonical
%% Compilation"), its person scripted, and their networks joined by route/6,
%% route3/8 or route4/10.  The person reads what its dispatcher draws (vGLP,
%% the construct process, draw(Id, W, V) and withdraw(Id); a grant input(Id,
%% P, R)): the agent's request questions, each bare, of the request type
%% Request?, taking one request (vGLP 12f629d, Section 5.4, "The compilation"); the program's output, construct 0, on which the agent goal writes its view, view(Me, S, K, A, Ts), its own key Me, the machine state S of its app state, the contract's atoms, the persons K it knows and the approvals A its person made that are pending, when it starts and whenever any changes, drawn element by element, which it logs (vGLP, Section 5.4, "The compilation"), and the notices it writes there when an approval its person made, by a request or by an answer yes, ends by a refusal, refused(P, Q, D), P the part of the refused attempt, Q its refuser and D the reason, declined or unable(Lacks, Has), or when a request of its person is dropped, the agent ready for no part it names, refused(P, Q, unable) (vGLP, Section 5.4, "The compilation"); the approval questions Start raises; and the approval question an arriving hello asks of a meeting.  The person's screen shows the last view written and the notices written after it (vGLP f5f1644, Section 5.4, "The compilation"), and the plays pace the persons on what their screens show: the last view, the notices after it, the request question open and the approval questions drawn.
%%
%% The person's script is a list of steps: req(R) grants the request R on the
%% request question open, once one is drawn; refresh grants refresh, an Input
%% addressed to no construct, on which the dispatcher has every construct, and
%% construct 0, draw again what it last drew (vGLP d433f71, Section 6.3);
%% own(Ks, R) grants R likewise,
%% once the person has written into each of the holes Ks the agent's own key,
%% which the last view drawn shows, R reading the holes wherever it names the agent:
%% a person proposing a class that names its agent names it by the key it
%% reads off the view, as the request form does (vGLP 12f629d, Section 5.4,
%% "The compilation": the view carries "its own key k"; Section 6.2: "A declared
%% widget is drawn also with the last value drawn on construct 0"), and a script, one clause, holds a hole for each place its
%% request names the agent, GLP's variables being single-reader; look logs
%% menu(K, Ks), K the agent's own key and Ks the persons it knows, as the last
%% view drawn shows them, once a request question is drawn; wait(C) waits until the person's screen shows C; approval(K, A) answers A, yes or no, the approval question of the attempt K, or of an attempt of the class K, or the one an arriving hello asks of the meeting K (vGLP, Section 5.4, "The compilation": an arriving hello from Q "asks its person the approval question of the clause of N, with its pragma, by a goal that shows Q and takes yes or no"), once it is drawn.  A request is the person's approval, which stands until the transaction is taken or refused: the agent proposes, and proposes again an attempt that yields, with no further question to the person; a person whose approval ends by a refusal sees the notice, refused(P, Q, D), and may make the request again (vGLP f0acbc1, Section 5.4, "Triggers" and "The compilation").  The screen shows known(Q) where the last view written shows Q among the persons the agent knows; holds(A) where its machine state holds the atom A, lacks(A) where it does not, and has(A, N) where it holds A at least N times; refused(P, Q, D) where that notice is written after the last view; asked(K) where the approval question of the attempt K, or of an attempt of the class K, or of the meeting K, is drawn and not answered; and asking where a request question is drawn and not answered.  Its log is the output, each view and each notice once, with menu(K, Ks) where it looks and gave(K, A) where it answers an approval question.  What the person reads, its script and its log are typed by parameters, each play instantiating them at its platform's types (docs/typed-glp-manual.md, 18.1, no open type): T the grant, the platform's Drawn; Q what an approval step names, a class of the contract or an attempt; S an atom of the machine state, P an approval pending and D a reason, as the platform's Output carries them, and B a tab; C, N and M the class, the names and the meeting of an attempt or a hello asked, as its Asking carries them; and R and W the proposal of a request and the words of an approval question, as its Drawn carries them.  The network logs each cargo it carries, sent(From, To, Cargo),
%% so a play shows what the views do not, the starts, the votes and the outcomes.
%% The person channel never closes, so a run does not end: once each agent has taken its own transactions until none holds and no trigger is left to read, the run suspends, the logs' tails unbound (vGLP 6c8c663, Section 5.4, "Triggers": the agent takes its own transactions "one at a time, each on an own trigger that the agent writes on a stream merged fairly with its other triggers, when it starts, after another trigger and after each own transaction it takes, until none holds").  The counter's run does not suspend, its agent counting without end, and is stopped at the REPL's :limit (counter/self.glp), and so is the bonds' run, a dated person's agent advancing their date without end (bonds/self.glp).
%% ---------------------------------------------------------------------------

Peer       ::= Key.
Carried(X, R) ::= hello(Peer, R) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, X).
Msg(X, R)  ::= msg(Peer, Carried(X, R)).
Sent(X)    ::= sent(Peer, Peer, X) ; intro(Peer, Peer, Peer).
Step(T, Q, S, P, D) ::= req(T) ; own(Holes, T) ; look ; wait(Cond(Q, S, P, D)) ; approval(Q, T) ; refresh.
Cond(Q, S, P, D) ::= known(Peer) ; holds(S) ; lacks(S) ; has(S, Integer) ; refused(P, Peer, D) ; asked(Q) ; asking.
Holes      ::= [] ; [Peer? | Holes].
Steps(T, Q, S, P, D) ::= [] ; [Step(T, Q, S, P, D) | Steps(T, Q, S, P, D)].
Sess       ::= nosess ; sess(Integer, Path).
%% What the person reads: the program's output, the views and the notices; an attempt or a hello asked; the views of the request, propose(R), and of the answer yes or no, each as the compilation forms Questioned(S), S ; input(Path) (vGLP, Section 6.3, "The construct process"); an approval question, of a platform compiled with or without its contract's words; and what the dispatcher draws.
HView(S, P, D, B) ::= view(Peer, List(S), List(Peer), List(P), List(B)) ; refused(P, Peer, D).
HAsking(C, N, M) ::= attempt(Peer, Integer, Integer, C, N) ; hello(Peer, M).
HRequest(R) ::= propose(R) ; input(Path).
HAnswer    ::= yes ; no ; input(Path).
HApproval(K, W) ::= approval(K, HAnswer) ; approval(K, W, HAnswer).
%% And the widget terms the platform's declarations name, each an alternative of the union the person channel carries: last_state, approval_sentence and the request widget's term social_menu(E), E the list of its entries, of the types the platform prints with it (vGLP 668df7d, Section 6.3, the paragraph after the construct process; vGLP 0eeea71, Section 5.4).
HDrawn(R, K, W, S, P, D, B, E) ::= request_r(HRequest(R)) ; approval_w(HApproval(K, W)) ; output(List(HView(S, P, D, B))) ; propose(R) ; yes ; no ; last_state ; approval_sentence ; social_menu(E).
Seen(K)    ::= seen(Integer, Path, K).
Seens(K)   ::= [] ; [Seen(K) | Seens(K)].
PSt(T, Q, S, P, D, B, K) ::= ps(Sess, List(HView(S, P, D, B)), Seens(K), Steps(T, Q, S, P, D)).
ApprovalAt(K) ::= approval_at(Integer, Path, Seens(K)) ; noapproval.
%% The last view, as the script looks at it: none, or view(Me, S, K), the agent's own key, the machine state and the persons it knows; and, for the step look, nomenu, or menu(Me, K), the key and the persons known.
LastView(S) ::= none ; view(Peer, List(S), List(Peer)).
Menu       ::= nomenu ; menu(Peer, List(Peer)).
%% The person's log: the views and the notices, once each; what look saw; and gave(K, A), each answer to an approval question.
Logged(Q, T, S, P, D, B) ::= view(Peer, List(S), List(Peer), List(P), List(B)) ; refused(P, Peer, D) ; nomenu ; menu(Peer, List(Peer)) ; gave(Q, T).
YN         ::= y ; n.

%% The network between two agents A and B: each message to its recipient, each
%% cargo logged.
procedure(X, R) route(Stream(Msg(X, R))?, Peer?, Stream(Msg(X, R)), Peer?, Stream(Msg(X, R)),
    Stream(Sent(X))).
route([msg(To, C)|Ms], A, [msg(To?, C?)|OA?], B, OB?, Log?) :-
    ground(To?), ground(C?), ground(A?), ground(B?), To? =?= A? |
    note(C?, To?, Log, Log1?),
    route(Ms?, A?, OA, B?, OB, Log1).
route([msg(To, C)|Ms], A, OA?, B, [msg(To?, C?)|OB?], Log?) :-
    ground(To?), ground(C?), ground(A?), ground(B?), To? =?= B? |
    note(C?, To?, Log, Log1?),
    route(Ms?, A?, OA, B?, OB, Log1).
route([msg(_, _)|Ms], A, OA?, B, OB?, Log?) :- otherwise |
    route(Ms?, A?, OA, B?, OB, Log).
route([], _, [], _, [], []).

%% The network between three agents A, B and C.
procedure(X, R) route3(Stream(Msg(X, R))?, Peer?, Stream(Msg(X, R)), Peer?, Stream(Msg(X, R)),
    Peer?, Stream(Msg(X, R)), Stream(Sent(X))).
route3([msg(To, M)|Ms], A, [msg(To?, M?)|OA?], B, OB?, C, OC?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), To? =?= A? |
    note(M?, To?, Log, Log1?),
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log1).
route3([msg(To, M)|Ms], A, OA?, B, [msg(To?, M?)|OB?], C, OC?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), To? =?= B? |
    note(M?, To?, Log, Log1?),
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log1).
route3([msg(To, M)|Ms], A, OA?, B, OB?, C, [msg(To?, M?)|OC?], Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), To? =?= C? |
    note(M?, To?, Log, Log1?),
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log1).
route3([msg(_, _)|Ms], A, OA?, B, OB?, C, OC?, Log?) :- otherwise |
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log).
route3([], _, [], _, [], _, [], []).

%% The network between four agents A, B, C and D.
procedure(X, R) route4(Stream(Msg(X, R))?, Peer?, Stream(Msg(X, R)), Peer?, Stream(Msg(X, R)),
    Peer?, Stream(Msg(X, R)), Peer?, Stream(Msg(X, R)), Stream(Sent(X))).
route4([msg(To, M)|Ms], A, [msg(To?, M?)|OA?], B, OB?, C, OC?, D, OD?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= A? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(To, M)|Ms], A, OA?, B, [msg(To?, M?)|OB?], C, OC?, D, OD?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= B? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(To, M)|Ms], A, OA?, B, OB?, C, [msg(To?, M?)|OC?], D, OD?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= C? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(To, M)|Ms], A, OA?, B, OB?, C, OC?, D, [msg(To?, M?)|OD?], Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= D? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(_, _)|Ms], A, OA?, B, OB?, C, OC?, D, OD?, Log?) :- otherwise |
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log).
route4([], _, [], _, [], _, [], _, [], []).

%% A cargo, logged with its sender and its recipient, and an introduction,
%% intro(From, To, Q), From introducing Q to To; a hello or an ihello, not.
procedure(X, R) note(Carried(X, R)?, Peer?, Stream(Sent(X)), Stream(Sent(X))?).
note(hello(_, _), _, Log1?, Log1).
note(ihello(_), _, Log1?, Log1).
note(intro(F, Q), To, [intro(F?, To?, Q?)|Log1?], Log1).
note(cargo(F, X), To, [sent(F?, To?, X?)|Log1?], Log1).

%% The program's output to its person, the views and the notices, on its end of the person channel (vGLP, "The canonical compilation": the program's output to its person, of the reserved type Output, drawn as construct 0).
procedure(I, X) to_person(Channel(Stream(I), Stream(X))?, Stream(X)?).
to_person(ch(_, O?), O).

%% The person.
procedure(T, Q, S, P, D, B, C, N, M, R, W, E) person(PersonOut(HDrawn(R, HAsking(C, N, M), W, S, P, D, B, E))?, PersonIn(T),
    PSt(T, Q, S, P, D, B, HAsking(C, N, M))?, Stream(Logged(Q, T, S, P, D, B))).
person([draw(0, _, output(T))|Ds], Gs?, ps(Se, Old, Cs, Ss), Log?) :-
    ground(T?) |
    list_of(T?, L),
    thread_seen(Se?, Old?, L?, Cs?, Ss?, Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
%% The request question, bare, of the request type Request? (vGLP 12f629d, Section 5.4, "The compilation"): the person reads the agent's own key and the persons it knows off the last view drawn on construct 0, as the request form does (Section 6.2: "A declared widget is drawn also with the last value drawn on construct 0").
person([draw(Id, _, request_r(input(P)))|Ds], Gs?, ps(_, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?) |
    advance(ps(sess(Id?, P?), T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([draw(Id, _, approval_w(approval(At, input(P))))|Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?), ground(At?) |
    advance(ps(Se?, T?, [seen(Id?, P?, At?)|Cs?], Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
%% The approval question of a platform compiled from a contract with pragmas, approval(At, Ws, YN), Ws the sentence the contract puts to the person (vGLP, Section 6.2, "The words a platform shows"): answered as any other, its answer at the place the draw marks.
person([draw(Id, _, approval_w(approval(At, _, input(P))))|Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?), ground(At?) |
    advance(ps(Se?, T?, [seen(Id?, P?, At?)|Cs?], Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([withdraw(Id)|Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :- ground(Id?) |
    drop_seen(Id?, Cs?, Cs1),
    person(Ds?, Gs, ps(Se?, T?, Cs1?, Ss?), Log).
person([_|Ds], Gs?, St, Log?) :- otherwise | person(Ds?, Gs, St?, Log).

procedure(T, Q, S, P, D, B, K) thread_seen(Sess?, List(HView(S, P, D, B))?, List(HView(S, P, D, B))?, Seens(K)?,
    Steps(T, Q, S, P, D)?, PersonIn(T), PersonIn(T)?, PSt(T, Q, S, P, D, B, K), Stream(Logged(Q, T, S, P, D, B)), Stream(Logged(Q, T, S, P, D, B))?).
thread_seen(Se, Old, L, Cs, Ss, Gs?, Gs1, St1?, Log?, Log1) :- ground(L?) |
    log_new(Old?, L?, Log, Log2?),
    advance(ps(Se?, L?, Cs?, Ss?), Gs, Gs1?, St1, Log2, Log1?).

%% advance(St?, Gs, Gs1?, St1, Log, Log1?): take the script's steps as far as
%% they can be taken, the grants written on Gs, continuing at Gs1.
procedure(T, Q, S, P, D, B, K) advance(PSt(T, Q, S, P, D, B, K)?, PersonIn(T), PersonIn(T)?, PSt(T, Q, S, P, D, B, K), Stream(Logged(Q, T, S, P, D, B)),
    Stream(Logged(Q, T, S, P, D, B))?).
advance(ps(sess(Id, P), T, Cs, [req(R)|Ss]), [input(Id?, P?, R?)|Gs?], Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?) |
    advance(ps(nosess, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [req(R)|Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [req(R?)|Ss?]), Log1?, Log1).
advance(ps(Se, T, Cs, [refresh|Ss]), [refresh|Gs?], Gs1, St1?, Log?, Log1) :-
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
%% The agent's own key, which the request form reads off the view, is the first argument of every view, the first of them written when the agent starts, so the person reads it off the first view drawn on construct 0; with none drawn yet, the step waits (vGLP 12f629d, Section 5.4, "The compilation"; Section 6.2).
advance(ps(sess(Id, P), [view(Me, S, K, A, Ts)|Vs], Cs, [own(Ks, R)|Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?), ground(Me?) |
    fill(Me?, Ks?),
    grant(Id?, P?, R?, Gs, Gs2?),
    advance(ps(nosess, [view(Me?, S?, K?, A?, Ts?)|Vs?], Cs?, Ss?), Gs2, Gs1?, St1, Log, Log1?).
advance(ps(sess(Id, P), [], Cs, [own(Ks, R)|Ss]), Gs1?, Gs1, ps(sess(Id?, P?), [], Cs?, [own(Ks?, R?)|Ss?]), Log1?, Log1).
advance(ps(nosess, T, Cs, [own(Ks, R)|Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [own(Ks?, R?)|Ss?]), Log1?, Log1).
%% look logs menu(K, Ks), the agent's own key and the persons it knows, as the last view drawn shows them; with none drawn yet, the step waits.
advance(ps(sess(Id, P), [V|Vs], Cs, [look|Ss]), Gs?, Gs1, St1?, [M?|Log?], Log1) :-
    ground(Id?), ground(P?), ground(V?), ground(Vs?) |
    last_menu([V?|Vs?], nomenu, M),
    advance(ps(sess(Id?, P?), [V?|Vs?], Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(sess(Id, P), [], Cs, [look|Ss]), Gs1?, Gs1, ps(sess(Id?, P?), [], Cs?, [look|Ss?]), Log1?, Log1).
advance(ps(nosess, T, Cs, [look|Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [look|Ss?]), Log1?, Log1).
advance(ps(Se, T, Cs, [wait(X)|Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    ground(Se?), ground(T?), ground(Cs?), ground(X?) |
    shows(X?, Se?, T?, Cs?, B),
    waited(B?, ps(Se?, T?, Cs?, [wait(X?)|Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, [approval(K, A)|Ss]), Gs?, Gs1, St1?, Log?, Log1) :- ground(Cs?), ground(K?) |
    find_approval(K?, Cs?, F),
    approved(F?, ps(Se?, T?, Cs?, [approval(K?, A?)|Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, []), Gs1?, Gs1, ps(Se?, T?, Cs?, []), Log1?, Log1).

%% fill(Me, Ks): the agent's own key Me written into each hole of Ks.
procedure fill(Peer?, Holes?).
fill(Me, [Me?|Ks]) :- ground(Me?) | fill(Me?, Ks?).
fill(_, []).

%% grant(Id, P, R, Gs, Gs1): the grant of R on the question Id at P, once R,
%% its holes filled, is ground.
procedure(T) grant(Integer?, Path?, T?, PersonIn(T), PersonIn(T)?).
grant(Id, P, R, [input(Id?, P?, R?)|Gs1?], Gs1) :- ground(R?) | true.

procedure(T, Q, S, P, D, B, K) waited(YN?, PSt(T, Q, S, P, D, B, K)?, PersonIn(T), PersonIn(T)?, PSt(T, Q, S, P, D, B, K), Stream(Logged(Q, T, S, P, D, B)),
    Stream(Logged(Q, T, S, P, D, B))?).
waited(y, ps(Se, T, Cs, [_|Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
waited(n, St, Gs1?, Gs1, St?, Log1?, Log1).

%% What the person's screen shows (the step wait(C)): the last view written and the notices written after it, the approval questions drawn and not answered, and whether a request question is drawn and not answered.
procedure(Q, S, P, D, B, C, N, M) shows(Cond(Q, S, P, D)?, Sess?, List(HView(S, P, D, B))?, Seens(HAsking(C, N, M))?, YN).
shows(known(Q), _, T, _, B?) :- ground(Q?), ground(T?) |
    last_of(T?, L),
    known_in(Q?, L?, B).
shows(holds(A), _, T, _, B?) :- ground(A?), ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, 1, B).
shows(lacks(A), _, T, _, B?) :- ground(A?), ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, 1, B1),
    flip(B1?, B).
shows(has(A, K), _, T, _, B?) :- ground(A?), integer(K?), ground(T?) |
    last_of(T?, L),
    count_in(A?, L?, N),
    at_least(N?, K?, B).
shows(refused(P, Q, D), _, T, _, B?) :- ground(P?), ground(Q?), ground(D?), ground(T?) |
    notices_of(T?, Ns),
    among(refused(P?, Q?, D?), Ns?, B).
shows(asked(K), _, _, Cs, B?) :- ground(K?), ground(Cs?) |
    find_approval(K?, Cs?, F),
    found_yn(F?, B).
shows(asking, sess(_, _), _, _, y).
shows(asking, nosess, _, _, n).
shows(_, _, _, _, n) :- otherwise | true.

%% The last view written, or none: the output holds the views and the notices.
procedure(S, P, D, B) last_of(List(HView(S, P, D, B))?, LastView(S)).
last_of(T, L?) :- last_view(T?, none, L).
procedure(S, P, D, B) last_view(List(HView(S, P, D, B))?, LastView(S)?, LastView(S)).
last_view([], L, L?).
%% The view, view(Me, S, K, A, Ts): the agent's own key, the machine state, the persons it knows, the approvals the person made that are pending and the lists its app shows (vGLP 12f629d, Section 5.4, "The compilation" and "The contract's words"), the script looking at the first three, view(Me, S, K).
last_view([view(Me, S, K, _, _)|Xs], none, L?) :- last_view(Xs?, view(Me?, S?, K?), L).
last_view([view(Me, S, K, _, _)|Xs], view(_, _, _), L?) :- last_view(Xs?, view(Me?, S?, K?), L).
last_view([_|Xs], L0, L?) :- otherwise | last_view(Xs?, L0?, L).
%% What the step look logs: menu(Me, K), the key and the persons known of the last view, or nomenu where none is written.
procedure(S, P, D, B) last_menu(List(HView(S, P, D, B))?, Menu?, Menu).
last_menu([], L, L?).
last_menu([view(Me, _, K, _, _)|Xs], nomenu, L?) :- last_menu(Xs?, menu(Me?, K?), L).
last_menu([view(Me, _, K, _, _)|Xs], menu(_, _), L?) :- last_menu(Xs?, menu(Me?, K?), L).
last_menu([_|Xs], L0, L?) :- otherwise | last_menu(Xs?, L0?, L).
%% The notices written after the last view, which the screen shows until the next view is written (vGLP f5f1644, Section 5.4, "The compilation": the widget "draws the last view written and the notices written after it").
procedure(S, P, D, B) notices_of(List(HView(S, P, D, B))?, List(HView(S, P, D, B))).
notices_of(T, Ns?) :- notices_after(T?, [], Ns).
procedure(S, P, D, B) notices_after(List(HView(S, P, D, B))?, List(HView(S, P, D, B))?, List(HView(S, P, D, B))).
notices_after([], Ns, Ns?).
notices_after([view(_, _, _, _, _)|Xs], _, Ns?) :- notices_after(Xs?, [], Ns).
notices_after([X|Xs], Ns0, Ns?) :- otherwise | notices_after(Xs?, [X?|Ns0?], Ns).
procedure(S) known_in(Peer?, LastView(S)?, YN).
known_in(Q, view(_, _, Ks), B?) :- among(Q?, Ks?, B).
known_in(_, none, n).
procedure(S) count_in(S?, LastView(S)?, Integer).
count_in(A, view(_, S, _), N?) :- count(A?, S?, N).
count_in(_, none, 0).
procedure(S) count(S?, List(S)?, Integer).
count(_, [], 0).
count(X, [Y|Ys], N?) :- X? =?= Y? | count(X?, Ys?, M), N := M? + 1.
count(X, [_|Ys], N?) :- otherwise | count(X?, Ys?, N).
procedure at_least(Integer?, Integer?, YN).
at_least(N, K, y) :- N? >= K? | true.
at_least(N, K, n) :- N? < K? | true.
procedure flip(YN?, YN).
flip(y, n).
flip(n, y).
procedure(K) found_yn(ApprovalAt(K)?, YN).
found_yn(approval_at(_, _, _), y).
found_yn(noapproval, n).

procedure(T, Q, S, P, D, B, K) approved(ApprovalAt(K)?, PSt(T, Q, S, P, D, B, K)?, PersonIn(T), PersonIn(T)?, PSt(T, Q, S, P, D, B, K),
    Stream(Logged(Q, T, S, P, D, B)), Stream(Logged(Q, T, S, P, D, B))?).
approved(approval_at(Id, P, Cs1), ps(Se, T, _, [approval(K, A)|Ss]),
       [input(Id?, P?, A?)|Gs?], Gs1, St1?, [gave(K?, A?)|Log?], Log1) :-
    ground(K?), ground(A?) |
    advance(ps(Se?, T?, Cs1?, Ss?), Gs, Gs1?, St1, Log, Log1?).
approved(noapproval, St, Gs1?, Gs1, St?, Log1?, Log1).

%% The approval question of the attempt K, or of an attempt of the class K, or of the meeting K a hello carries, the earliest
%% drawn first.
procedure(Q, C, N, M) find_approval(Q?, Seens(HAsking(C, N, M))?, ApprovalAt(HAsking(C, N, M))).
find_approval(K, Cs, F?) :- ground(Cs?) | rev_seen(Cs?, [], Rs), find_approval1(K?, Rs?, [], F).
procedure(Q, C, N, M) find_approval1(Q?, Seens(HAsking(C, N, M))?, Seens(HAsking(C, N, M))?, ApprovalAt(HAsking(C, N, M))).
find_approval1(_, [], _, noapproval).
find_approval1(K, [seen(Id, P, At)|Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(At?), ground(K?), K? =?= At? |
    rev_seen(Done?, Cs?, Rest).
find_approval1(K, [seen(Id, P, attempt(_, _, _, C, _))|Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(C?), ground(K?), K? =?= C? |
    rev_seen(Done?, Cs?, Rest).
find_approval1(K, [seen(Id, P, hello(_, N))|Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(N?), ground(K?), K? =?= N? |
    rev_seen(Done?, Cs?, Rest).
find_approval1(K, [S|Cs], Done, F?) :- otherwise | find_approval1(K?, Cs?, [S?|Done?], F).
procedure(K) rev_seen(Seens(K)?, Seens(K)?, Seens(K)).
rev_seen([], Acc, Acc?).
rev_seen([S|Ss], Acc, R?) :- rev_seen(Ss?, [S?|Acc?], R).

procedure(K) drop_seen(Integer?, Seens(K)?, Seens(K)).
drop_seen(_, [], []).
drop_seen(Id, [seen(J, _, _)|Cs], Cs?) :- Id? =:= J? | true.
drop_seen(Id, [S|Cs], [S?|Cs1?]) :- otherwise | drop_seen(Id?, Cs?, Cs1).

procedure(X) among(X?, List(X)?, YN).
among(_, [], n).
among(X, [Y|_], y) :- X? =?= Y? | true.
among(X, [_|Ys], B?) :- otherwise | among(X?, Ys?, B).

%% The output's written elements as a list: construct 0 "is drawn element by element as it arrives, its unwritten tail not drawn" (vGLP 1a02877, "The construct process"), so each view is logged once it is written, in the output's order.
procedure(S, P, D, B) list_of(List(HView(S, P, D, B))?, List(HView(S, P, D, B))).
list_of([X|Xs], [X?|Ys?]) :- list_of(Xs?, Ys).
list_of([], []).

%% Log the views and the notices of the output not logged before.
procedure(Q, T, S, P, D, B) log_new(List(HView(S, P, D, B))?, List(HView(S, P, D, B))?, Stream(Logged(Q, T, S, P, D, B)), Stream(Logged(Q, T, S, P, D, B))?).
log_new([_|Os], [_|Ns], Log?, Log1) :- log_new(Os?, Ns?, Log, Log1?).
log_new([], Ns, Log?, Log1) :- put(Ns?, Log, Log1?).
log_new([_|_], [], Log1?, Log1).
procedure(Q, T, S, P, D, B) put(List(HView(S, P, D, B))?, Stream(Logged(Q, T, S, P, D, B)), Stream(Logged(Q, T, S, P, D, B))?).
put([X|Xs], [X?|Log?], Log1) :- put(Xs?, Log, Log1?).
put([], Log1?, Log1).
