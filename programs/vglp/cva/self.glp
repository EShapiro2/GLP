%% ---------------------------------------------------------------------------
%% programs/vglp/cva --- the compiler from an act-schema contract to its
%% canonical CVA platform in vGLP (compiler/, compile.sh), vGLP's contracts
%% beside GSC's two, their owners' (contracts.glp), the platforms it prints
%% (social_graph/platform.vglp, currency/platform.vglp, nudge/platform.vglp,
%% introduce/platform.vglp, gnudge/platform.vglp, childsafe/platform.vglp,
%% link/platform.vglp, friends/platform.vglp, each beside its plays) and what the plays of all of them share, here: a
%% scripted person and a network between two agents, three or four.
%%
%% A play runs the agents of a compiled platform, each the agent of the module
%% with its ask stream and its dispatcher on that stream, on its person
%% channel and on the program's output, the agent's thread (to_person/2), as
%% whatever spawns an agent's initial goal does (vGLP, Definition "Canonical
%% Compilation"), its person scripted, and their networks joined by route/6,
%% route3/8 or route4/10.  The person reads what its dispatcher draws (vGLP,
%% the construct process, draw(Id, W, V) and withdraw(Id); a grant input(Id,
%% P, R)): the agent's request questions, each showing the persons the agent
%% knows and taking one request (vGLP ca78e11, Section 5.4); the thread, the
%% program's output, construct 0, drawn element by element, which it logs;
%% and the approval questions Start raises.  The plays pace the persons on
%% the thread, on which the agent goal writes each app transaction it takes,
%% its schema applied to its attempt, and discover(Q) once it knows Q (vGLP
%% 56d898f, Section 5.4).
%%
%% The person's script is a list of steps: req(R) grants the request R on the
%% request question open, once one is drawn; look logs menu(Ks), Ks the
%% persons the request question open shows, once one is drawn; wait(T) waits
%% until the transaction T is on the
%% thread; approval(K, A) answers A, yes or no, the approval question of the attempt K, or of an
%% attempt of the class K, once it is drawn.  Its log is the thread, each
%% transaction once, with gave(K, A) where it answers an approval question.  It reads what
%% the dispatcher sends it as any term and its script as terms of any form, the
%% steps holding the platform's requests, transactions, attempts and classes
%% (docs/typed-glp-manual.md, 18.3, the play of programs/tests/vglp/fragments
%% likewise).  The network logs each cargo it carries, sent(From, To, Cargo),
%% so a play shows what the thread does not name, the votes and the outcomes.
%% The person channel never closes, so a run ends at the REPL's :limit, the
%% clock of each agent ticking without end (vGLP #8, 2026-10-11 16:44 UTC,
%% after the fact).
%% ---------------------------------------------------------------------------

Peer       ::= Key.
Carried(X) ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, X).
Msg(X)     ::= msg(Peer, Carried(X)).
Sent(X)    ::= sent(Peer, Peer, X) ; intro(Peer, Peer, Peer).
Step(T)    ::= req(T) ; look ; wait(_) ; approval(_, T).
Steps(T)   ::= [] ; [Step(T) | Steps(T)].
Sess       ::= nosess ; sess(Integer, Path, List(Peer)).
Seen       ::= seen(Integer, Path, _).
Seens      ::= [] ; [Seen | Seens].
PSt(T)     ::= ps(Sess, Stream(_), Seens, Steps(T)).
ApprovalAt ::= approval_at(Integer, Path, Seens) ; noapproval.
YN         ::= y ; n.

%% The network between two agents A and B: each message to its recipient, each
%% cargo logged.
procedure(X) route(Stream(Msg(X))?, Peer?, Stream(Msg(X)), Peer?, Stream(Msg(X)),
    Stream(Sent(X))).
route([msg(To, C)|Ms], A, [msg(To?, C?)|OA?], B, OB?, Log?) :-
    ground(To?), ground(C?), ground(A?), ground(B?), To? =?= A? |
    note(C?, To?, Log, Log1?),
    route(Ms?, A?, OA, B?, OB, Log1).
route([msg(To, C)|Ms], A, OA?, B, [msg(To?, C?)|OB?], Log?) :-
    ground(To?), ground(C?), ground(A?), ground(B?), To? =?= B? |
    note(C?, To?, Log, Log1?),
    route(Ms?, A?, OA, B?, OB, Log1).
route([msg(_, _)|Ms], A, OA?, B, OB?, Log?) :- otherwise |
    route(Ms?, A?, OA, B?, OB, Log).
route([], _, [], _, [], []).

%% The network between three agents A, B and C.
procedure(X) route3(Stream(Msg(X))?, Peer?, Stream(Msg(X)), Peer?, Stream(Msg(X)),
    Peer?, Stream(Msg(X)), Stream(Sent(X))).
route3([msg(To, M)|Ms], A, [msg(To?, M?)|OA?], B, OB?, C, OC?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), To? =?= A? |
    note(M?, To?, Log, Log1?),
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log1).
route3([msg(To, M)|Ms], A, OA?, B, [msg(To?, M?)|OB?], C, OC?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), To? =?= B? |
    note(M?, To?, Log, Log1?),
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log1).
route3([msg(To, M)|Ms], A, OA?, B, OB?, C, [msg(To?, M?)|OC?], Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), To? =?= C? |
    note(M?, To?, Log, Log1?),
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log1).
route3([msg(_, _)|Ms], A, OA?, B, OB?, C, OC?, Log?) :- otherwise |
    route3(Ms?, A?, OA, B?, OB, C?, OC, Log).
route3([], _, [], _, [], _, [], []).

%% The network between four agents A, B, C and D.
procedure(X) route4(Stream(Msg(X))?, Peer?, Stream(Msg(X)), Peer?, Stream(Msg(X)),
    Peer?, Stream(Msg(X)), Peer?, Stream(Msg(X)), Stream(Sent(X))).
route4([msg(To, M)|Ms], A, [msg(To?, M?)|OA?], B, OB?, C, OC?, D, OD?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= A? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(To, M)|Ms], A, OA?, B, [msg(To?, M?)|OB?], C, OC?, D, OD?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= B? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(To, M)|Ms], A, OA?, B, OB?, C, [msg(To?, M?)|OC?], D, OD?, Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= C? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(To, M)|Ms], A, OA?, B, OB?, C, OC?, D, [msg(To?, M?)|OD?], Log?) :-
    ground(To?), ground(M?), ground(A?), ground(B?), ground(C?), ground(D?), To? =?= D? |
    note(M?, To?, Log, Log1?),
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log1).
route4([msg(_, _)|Ms], A, OA?, B, OB?, C, OC?, D, OD?, Log?) :- otherwise |
    route4(Ms?, A?, OA, B?, OB, C?, OC, D?, OD, Log).
route4([], _, [], _, [], _, [], _, [], []).

%% A cargo, logged with its sender and its recipient, and an introduction,
%% intro(From, To, Q), From introducing Q to To; a hello or an ihello, not.
procedure(X) note(Carried(X)?, Peer?, Stream(Sent(X)), Stream(Sent(X))?).
note(hello(_), _, Log1?, Log1).
note(ihello(_), _, Log1?, Log1).
note(intro(F, Q), To, [intro(F?, To?, Q?)|Log1?], Log1).
note(cargo(F, X), To, [sent(F?, To?, X?)|Log1?], Log1).

%% The program's output to its person, the thread, on its end of the person
%% channel (vGLP, Definition "Canonical Compilation": the program's output to
%% its person, of the reserved type Output, drawn as construct 0).
procedure(X) to_person(Channel(Stream(_), Stream(X))?, Stream(X)?).
to_person(ch(_, O?), O).

%% The person.
procedure(T) person(_?, PersonIn(T), PSt(T)?, Stream(_)).
person([draw(0, _, output(T))|Ds], Gs?, ps(Se, Old, Cs, Ss), Log?) :-
    ground(T?) |
    list_of(T?, L),
    thread_seen(Se?, Old?, L?, Cs?, Ss?, Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([draw(Id, _, menu_w(menu(Ks, input(P))))|Ds], Gs?, ps(_, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?), ground(Ks?) |
    advance(ps(sess(Id?, P?, Ks?), T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([draw(Id, _, approval_w(approval(At, input(P))))|Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :-
    ground(Id?), ground(P?), ground(At?) |
    advance(ps(Se?, T?, [seen(Id?, P?, At?)|Cs?], Ss?), Gs, Gs1?, St1, Log, Log1?),
    person(Ds?, Gs1, St1?, Log1).
person([withdraw(Id)|Ds], Gs?, ps(Se, T, Cs, Ss), Log?) :- ground(Id?) |
    drop_seen(Id?, Cs?, Cs1),
    person(Ds?, Gs, ps(Se?, T?, Cs1?, Ss?), Log).
person([_|Ds], Gs?, St, Log?) :- otherwise | person(Ds?, Gs, St?, Log).

procedure(T) thread_seen(Sess?, Stream(_)?, Stream(_)?, Seens?,
    Steps(T)?, PersonIn(T), PersonIn(T)?, PSt(T), Stream(_), Stream(_)?).
thread_seen(Se, Old, L, Cs, Ss, Gs?, Gs1, St1?, Log?, Log1) :- ground(L?) |
    log_new(Old?, L?, Log, Log2?),
    advance(ps(Se?, L?, Cs?, Ss?), Gs, Gs1?, St1, Log2, Log1?).

%% advance(St?, Gs, Gs1?, St1, Log, Log1?): take the script's steps as far as
%% they can be taken, the grants written on Gs, continuing at Gs1.
procedure(T) advance(PSt(T)?, PersonIn(T), PersonIn(T)?, PSt(T), Stream(_),
    Stream(_)?).
advance(ps(sess(Id, P, _), T, Cs, [req(R)|Ss]), [input(Id?, P?, R?)|Gs?], Gs1, St1?, Log?, Log1) :-
    ground(Id?), ground(P?) |
    advance(ps(nosess, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [req(R)|Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [req(R?)|Ss?]), Log1?, Log1).
advance(ps(sess(Id, P, Ks), T, Cs, [look|Ss]), Gs?, Gs1, St1?, [menu(Ks?)|Log?], Log1) :-
    ground(Id?), ground(P?), ground(Ks?) |
    advance(ps(sess(Id?, P?, Ks?), T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
advance(ps(nosess, T, Cs, [look|Ss]), Gs1?, Gs1, ps(nosess, T?, Cs?, [look|Ss?]), Log1?, Log1).
advance(ps(Se, T, Cs, [wait(X)|Ss]), Gs?, Gs1, St1?, Log?, Log1) :- ground(T?), ground(X?) |
    among(X?, T?, B),
    waited(B?, ps(Se?, T?, Cs?, [wait(X?)|Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, [approval(K, A)|Ss]), Gs?, Gs1, St1?, Log?, Log1) :- ground(Cs?), ground(K?) |
    find_approval(K?, Cs?, F),
    approved(F?, ps(Se?, T?, Cs?, [approval(K?, A?)|Ss?]), Gs, Gs1?, St1, Log, Log1?).
advance(ps(Se, T, Cs, []), Gs1?, Gs1, ps(Se?, T?, Cs?, []), Log1?, Log1).

procedure(T) waited(YN?, PSt(T)?, PersonIn(T), PersonIn(T)?, PSt(T), Stream(_),
    Stream(_)?).
waited(y, ps(Se, T, Cs, [_|Ss]), Gs?, Gs1, St1?, Log?, Log1) :-
    advance(ps(Se?, T?, Cs?, Ss?), Gs, Gs1?, St1, Log, Log1?).
waited(n, St, Gs1?, Gs1, St?, Log1?, Log1).

procedure(T) approved(ApprovalAt?, PSt(T)?, PersonIn(T), PersonIn(T)?, PSt(T),
    Stream(_), Stream(_)?).
approved(approval_at(Id, P, Cs1), ps(Se, T, _, [approval(K, A)|Ss]),
       [input(Id?, P?, A?)|Gs?], Gs1, St1?, [gave(K?, A?)|Log?], Log1) :-
    ground(K?), ground(A?) |
    advance(ps(Se?, T?, Cs1?, Ss?), Gs, Gs1?, St1, Log, Log1?).
approved(noapproval, St, Gs1?, Gs1, St?, Log1?, Log1).

%% The approval question of the attempt K, or of an attempt of the class K, the earliest
%% drawn first.
procedure find_approval(_?, Seens?, ApprovalAt).
find_approval(K, Cs, F?) :- ground(Cs?) | rev_seen(Cs?, [], Rs), find_approval1(K?, Rs?, [], F).
procedure find_approval1(_?, Seens?, Seens?, ApprovalAt).
find_approval1(_, [], _, noapproval).
find_approval1(K, [seen(Id, P, At)|Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(At?), ground(K?), K? =?= At? |
    rev_seen(Done?, Cs?, Rest).
find_approval1(K, [seen(Id, P, attempt(_, _, _, C))|Cs], Done, approval_at(Id?, P?, Rest?)) :-
    ground(C?), ground(K?), K? =?= C? |
    rev_seen(Done?, Cs?, Rest).
find_approval1(K, [S|Cs], Done, F?) :- otherwise | find_approval1(K?, Cs?, [S?|Done?], F).
procedure rev_seen(Seens?, Seens?, Seens).
rev_seen([], Acc, Acc?).
rev_seen([S|Ss], Acc, R?) :- rev_seen(Ss?, [S?|Acc?], R).

procedure drop_seen(Integer?, Seens?, Seens).
drop_seen(_, [], []).
drop_seen(Id, [seen(J, _, _)|Cs], Cs?) :- Id? =:= J? | true.
drop_seen(Id, [S|Cs], [S?|Cs1?]) :- otherwise | drop_seen(Id?, Cs?, Cs1).

procedure among(_?, Stream(_)?, YN).
among(_, [], n).
among(X, [Y|_], y) :- X? =?= Y? | true.
among(X, [_|Ys], B?) :- otherwise | among(X?, Ys?, B).

%% The thread's written elements as a list: construct 0 is drawn element by
%% element as it arrives, its unwritten tail not drawn (vGLP 56d898f, "The
%% construct process"), so each transaction is logged once it is written, in
%% the thread's order.
procedure list_of(_?, Stream(_)).
list_of([pending(_)|_], []).
list_of([X|Xs], [X?|Ys?]) :- otherwise | list_of(Xs?, Ys).
list_of(_, []) :- otherwise | true.

%% Log the transactions of the thread not logged before.
procedure log_new(Stream(_)?, Stream(_)?, Stream(_), Stream(_)?).
log_new([_|Os], [_|Ns], Log?, Log1) :- log_new(Os?, Ns?, Log, Log1?).
log_new([], Ns, Log?, Log1) :- put(Ns?, Log, Log1?).
log_new([_|_], [], Log1?, Log1).
procedure put(Stream(_)?, Stream(_), Stream(_)?).
put([X|Xs], [X?|Log?], Log1) :- put(Xs?, Log, Log1?).
put([], Log1?, Log1).
