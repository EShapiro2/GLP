%% ---------------------------------------------------------------------------
%% GRV.glp --- GRV, Grassroots Rendezvous, GNA's (a paper of the GSA project), its clauses in GRV.txt beside this file, extending GSV (GSV.txt), in the clause syntax of GSC's paper, Section 3.2.  The term is an instance of GnW (programs/gsc/GnW.glp), instance_named(Name, gnw, Bindings, Additions), its parameter ward written service and the other five as GnW writes them (GSC's paper, Definition Parametric contract; programs/gsc/README.md, "Parametric contracts and their instances"); it restates no schema of GnW, and docs/tools/gen_gsv.py of GNA's repository writes this file.  Then GRV's five: open_server is GRV:1, Server; invite_by_link GRV:2, Registration, named as its button; redeem GRV:3, Redemption; present and match GRV:4, Reconnection, one clause in two schemas, each friend presenting and the server matching the two.  rendezvous(Dave) says that the service Dave is a rendezvous server; registered(Dave, Alice, s, e) that Alice registered with it a link with serial s and expiry e, and registered_with(Alice, Dave, s) the same at Alice; used(Dave, Alice, s) that the link was spent; redeemed(Bob, Alice, s) at Bob that he presented it; waiting(Dave, Alice, Bob) that Alice asked the server to reconnect her with her friend Bob.  link(Alice, s, e) is an environment predicate, the serial and the expiry of the next invitation link of Alice, which her app keeps current and invite_by_link requires at her role, so its button has no field.  A link's serial and expiry are values (GSC, the appendix Values); the link itself, the term Alice signs, travels outside the contract, and the server checks its signature and its expiry by the implementation pragmas.  A friend's signature over the friendship (GRV:4) is, in the schema, the atom friend(Alice, Bob) required at her role.  A person comes to know the server by GnW:3, ward_acquaint, the server answering anyone.  Rewritten on GSV by GSA #3 Cowork, 2026-11-10 (Udi, 2026-11-10 13:52 UTC), from GSA #2's of 2026-11-07.
%% ---------------------------------------------------------------------------

% instance_named(grv, gnw, Bindings, Additions): the contract, GRV.
procedure instance_named(Constant?, Constant, SBindings, SDeclared).
instance_named(grv, gnw,
   [ward = service],
   environment([link], [
%% GRV:1, Server: Carol, a guardian of the service Dave, makes it a server, by an act of both.
    sas(open_server, ['Carol', 'Dave'], [],
       [atom(rendezvous, ['Dave'])],
       [atom(identity, ['Carol']), atom(person, ['Carol']), atom(guardian_of, ['Carol', 'Dave']),
        atom(identity, ['Dave']), atom(service, ['Dave']), atom(guarded_by, ['Dave', 'Carol']),
        not(atom(rendezvous, ['Dave']))],
       true, ['Carol', 'Dave']),
%% GRV:2, Registration: Alice registers with the server Dave a link with serial s and expiry e.
    sas(invite_by_link, ['Alice', 'Dave'], [s, e],
       [atom(registered_with, ['Alice', 'Dave', num(s)]),
        atom(registered, ['Dave', 'Alice', num(s), num(e)])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(knows, ['Alice', 'Dave']),
        atom(link, ['Alice', num(s), num(e)]),
        not(atom(registered_with, ['Alice', 'Dave', num(s)])),
        atom(identity, ['Dave']), atom(rendezvous, ['Dave']),
        not(atom(registered, ['Dave', 'Alice', num(s), '_'])), not(atom(used, ['Dave', 'Alice', num(s)]))],
       true, ['Alice']),
%% GRV:3, Redemption: Bob presents to Dave a link registered by a; the link is spent.
    sas(redeem, ['Bob', 'Dave'], [a, s, e],
       [atom(redeemed, ['Bob', a, num(s)]),
        atom(used, ['Dave', a, num(s)]), not(atom(registered, ['Dave', a, num(s), num(e)]))],
       [atom(identity, ['Bob']), atom(person, ['Bob']), atom(knows, ['Bob', 'Dave']),
        atom(identity, ['Dave']), atom(rendezvous, ['Dave']), atom(registered, ['Dave', a, num(s), num(e)])],
       true, ['Bob']),
%% GRV:4, Reconnection: Alice, a friend of Bob, asks Dave to reconnect them.
    sas(present, ['Alice', 'Dave'], ['Bob'],
       [atom(waiting, ['Dave', 'Alice', 'Bob'])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(knows, ['Alice', 'Dave']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Dave']), atom(rendezvous, ['Dave']), not(atom(waiting, ['Dave', 'Alice', 'Bob']))],
       true, ['Alice']),
%% GRV:4, Reconnection: Dave matches the two friends who each asked.
    sas(match, ['Dave'], [a, b],
       [not(atom(waiting, ['Dave', a, b])), not(atom(waiting, ['Dave', b, a])), atom(matched, ['Dave', a, b])],
       [atom(identity, ['Dave']), atom(rendezvous, ['Dave']),
        atom(waiting, ['Dave', a, b]), atom(waiting, ['Dave', b, a])],
       true, [])])).
