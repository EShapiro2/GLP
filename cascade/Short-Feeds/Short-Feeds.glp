% contract_named(short_feeds, C): the contract, Short Feeds.
procedure contract_named(Constant?, SDeclared).
contract_named(short_feeds, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], [], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(identity, ['Carol']), atom(person, ['Alice']), atom(person, ['Bob']), atom(person, ['Carol']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Alice', 'Bob', 'Bob']), atom(pointer, ['Bob', 'Alice', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice'])), not(atom(pointer, ['Alice', 'Bob', 'Bob'])), not(atom(pointer, ['Bob', 'Alice', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Alice', 'Bob', 'Bob']), atom(pointer, ['Bob', 'Alice', 'Alice'])], true, ['Alice']),
 sas(point_friend, ['Alice', 'Bob'], [], [atom(points_to, ['Alice', 'Bob'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(points_to, ['Alice', 'Bob']))], true, ['Alice']),
 sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'], [atom(points_to, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Carol']), atom(points_to, ['Alice', 'Bob']), atom(points_to, ['Bob', 'Carol']), not(atom(points_to, ['Alice', 'Carol']))], true, ['Alice']),
 sas(unpoint, ['Alice', 'Bob'], ['Bob'], [not(atom(points_to, ['Alice', 'Bob']))], [atom(identity, ['Alice']), atom(points_to, ['Alice', 'Bob'])], true, ['Alice']),
 sas(labeled_point_friend, ['Alice', 'Bob', 'Dave', one('Erin', '_')], ['Dave', 'Erin'], [atom(pointer, ['Alice', 'Bob', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Bob', 'Erin', 'Dave']), not(atom(pointer, ['Alice', 'Bob', 'Dave']))], true, ['Alice']),
 sas(labeled_point_transitive, ['Alice', 'Bob', 'Carol', one('Dave', 'Carol')], ['Dave'], [atom(pointer, ['Alice', 'Carol', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(pointer, ['Alice', 'Bob', 'Dave']), atom(pointer, ['Bob', 'Carol', 'Dave']), not(atom(pointer, ['Alice', 'Carol', 'Dave'])), atom(knows, ['Carol', 'Alice'])], true, ['Alice']),
 sas(labeled_point_transitive_friend, ['Alice', 'Bob', 'Carol', one('Dave', 'Carol')], ['Dave'], [atom(pointer, ['Alice', 'Carol', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Bob', 'Carol', 'Dave']), not(atom(pointer, ['Alice', 'Carol', 'Dave'])), atom(knows, ['Carol', 'Alice'])], true, ['Alice']),
 sas(labeled_unpoint, ['Alice', 'Carol', 'Dave'], ['Carol', 'Dave'], [not(atom(pointer, ['Alice', 'Carol', 'Dave']))], [atom(identity, ['Alice']), atom(pointer, ['Alice', 'Carol', 'Dave'])], true, ['Alice']),
 sas(labeled_unpoint_self, ['Alice', 'Dave'], ['Dave'], [not(atom(pointer, ['Alice', 'Dave', 'Dave']))], [atom(identity, ['Alice']), not(atom(friend, ['Alice', 'Dave'])), atom(pointer, ['Alice', 'Dave', 'Dave'])], true, ['Alice']),
 sas(post, ['Alice'], ['Item'], [atom(item, ['Alice', 'Item', 'Alice'])], [atom(identity, ['Alice']), not(atom(item, ['Alice', 'Item', 'Alice']))], true, ['Alice']),
 sas(deliver, ['Bob', 'Alice', one('Carol', 'Bob')], ['Item', 'Carol'], [atom(item, ['Alice', 'Item', 'Carol']), atom(received, ['Alice', 'Item', 'Carol', 'Bob'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(pointer, ['Alice', 'Bob', 'Carol']), atom(knows, ['Bob', 'Alice']), atom(item, ['Bob', 'Item', 'Carol']), not(atom(item, ['Alice', 'Item', 'Carol']))], true, []),
 sas(shorten, ['Alice', 'Carol', 'Bob', one('Dave', 'Carol')], ['Dave'], [not(atom(pointer, ['Alice', 'Bob', 'Dave'])), atom(pointer, ['Alice', 'Carol', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(pointer, ['Bob', 'Carol', 'Dave']), not(atom(pointer, ['Alice', 'Carol', 'Dave'])), atom(pointer, ['Alice', 'Bob', 'Dave'])], true, [])])).
