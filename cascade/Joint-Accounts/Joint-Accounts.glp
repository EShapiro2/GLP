% contract_named(joint_accounts, C): the contract, Joint Accounts.
procedure contract_named(Constant?, SDeclared).
contract_named(joint_accounts, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], [], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(identity, ['Carol']), atom(person, ['Alice']), atom(person, ['Bob']), atom(person, ['Carol']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(issue, ['Alice'], ['Type', 'Sum'], [times(num('Sum'), atom(note, ['Alice', 'Alice', const('Type')]))], [atom(identity, ['Alice'])], true, ['Alice']),
 sas(swap, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob']), one('Dave', ['Alice', 'Bob', 'Carol'])], ['Carol', 'Type', 'Sum', 'Dave', 'Other', 'Total'], [not(times(num('Sum'), atom(note, ['Alice', 'Carol', const('Type')]))), times(num('Sum'), atom(note, ['Bob', 'Carol', const('Type')])), not(times(num('Total'), atom(note, ['Bob', 'Dave', const('Other')]))), times(num('Total'), atom(note, ['Alice', 'Dave', const('Other')])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(note, ['Alice', 'Carol', const('Type')])), times(num('Total'), atom(note, ['Bob', 'Dave', const('Other')]))], true, ['Alice', 'Bob']),
 sas(pay, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Type', 'Sum'], [not(times(num('Sum'), atom(note, ['Alice', 'Carol', const('Type')]))), times(num('Sum'), atom(note, ['Bob', 'Carol', const('Type')])), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(note, ['Alice', 'Carol', const('Type')]))], true, ['Alice', 'Bob']),
 sas(pay_issuer, ['Alice', 'Bob'], ['Type', 'Sum'], [not(times(num('Sum'), atom(note, ['Alice', 'Bob', const('Type')]))), times(num('Sum'), atom(note, ['Bob', 'Bob', const('Type')]))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(note, ['Alice', 'Bob', const('Type')]))], true, ['Alice']),
 sas(deposit, ['Alice', 'Carol', one('Dave', ['Alice', 'Carol']), one('Bob', 'Dave')], ['Dave', 'Type', 'Sum', 'Bob', 'Cond'], [not(times(num('Sum'), atom(note, ['Alice', 'Dave', const('Type')]))), times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond']))], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(note, ['Alice', 'Dave', const('Type')]))], true, ['Alice', 'Carol']),
 sas(release, ['Carol', 'Bob', one('Dave', ['Carol', 'Bob']), one('Alice', 'Dave')], ['Dave', 'Type', 'Alice', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(note, ['Bob', 'Dave', const('Type')])), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Bob']),
 sas(return, ['Carol', 'Alice', one('Dave', ['Carol', 'Alice']), one('Bob', 'Dave')], ['Dave', 'Type', 'Bob', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(note, ['Alice', 'Dave', const('Type')])), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', const('Type'), 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Alice']),
 sas(redeem, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol'], [not(atom(note, ['Alice', 'Bob', val(coin)])), atom(note, ['Bob', 'Bob', val(coin)]), not(atom(note, ['Bob', 'Carol', val(coin)])), atom(note, ['Alice', 'Carol', val(coin)]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(note, ['Alice', 'Bob', val(coin)]), atom(note, ['Bob', 'Carol', val(coin)])], true, ['Alice']),
 sas(open_account, ['Alice', 'Bob'], ['Acct'], [atom(account, ['Alice', const('Acct')]), atom(joint, ['Alice', const('Acct'), 'Bob']), atom(joint, ['Bob', const('Acct'), 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(account, ['Alice', const('Acct')]))], true, ['Alice', 'Bob']),
 sas(deposit_2, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Sum', 'Acct'], [not(times(num('Sum'), atom(note, ['Alice', 'Carol', val(coin)]))), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob'])), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(joint, ['Alice', const('Acct'), 'Bob']), atom(joint, ['Bob', const('Acct'), 'Alice']), times(num('Sum'), atom(note, ['Alice', 'Carol', val(coin)]))], true, ['Alice']),
 sas(partner_deposit, ['Bob', 'Alice', one('Carol', ['Bob', 'Alice'])], ['Carol', 'Sum', 'Acct'], [not(times(num('Sum'), atom(note, ['Bob', 'Carol', val(coin)]))), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob'])), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(joint, ['Alice', const('Acct'), 'Bob']), atom(joint, ['Bob', const('Acct'), 'Alice']), times(num('Sum'), atom(note, ['Bob', 'Carol', val(coin)]))], true, ['Bob']),
 sas(withdraw, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Acct', 'Sum'], [not(times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))), times(num('Sum'), atom(note, ['Alice', 'Carol', val(coin)]))], [atom(identity, ['Alice']), atom(identity, ['Bob']), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))], true, ['Alice', 'Bob']),
 sas(partner_withdraw, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Acct', 'Sum'], [not(times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))), times(num('Sum'), atom(note, ['Bob', 'Carol', val(coin)]))], [atom(identity, ['Alice']), atom(identity, ['Bob']), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))], true, ['Alice', 'Bob'])])).
