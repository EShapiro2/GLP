% contract_named(joint_accounts, C): the contract, Joint Accounts.
procedure contract_named(Constant?, SDeclared).
contract_named(joint_accounts, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(issue, ['Alice'], ['Sum'], [times(num('Sum'), atom(coin, ['Alice', 'Alice']))], [atom(identity, ['Alice'])], true, ['Alice']),
 sas(swap, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob']), one('Dave', ['Alice', 'Bob', 'Carol'])], ['Carol', 'Sum', 'Dave', 'Total'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol']))), times(num('Sum'), atom(coin, ['Bob', 'Carol'])), not(times(num('Total'), atom(coin, ['Bob', 'Dave']))), times(num('Total'), atom(coin, ['Alice', 'Dave'])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(coin, ['Alice', 'Carol'])), times(num('Total'), atom(coin, ['Bob', 'Dave']))], true, ['Alice', 'Bob']),
 sas(pay, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Sum'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol']))), times(num('Sum'), atom(coin, ['Bob', 'Carol'])), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Carol']))], true, ['Alice', 'Bob']),
 sas(pay_issuer, ['Alice', 'Bob'], ['Sum'], [not(times(num('Sum'), atom(coin, ['Alice', 'Bob']))), times(num('Sum'), atom(coin, ['Bob', 'Bob']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Bob']))], true, ['Alice']),
 sas(deposit_coin, ['Alice', 'Carol', one('Dave', ['Alice', 'Carol']), one('Bob', 'Dave')], ['Dave', 'Sum', 'Bob', 'Cond'], [not(times(num('Sum'), atom(coin, ['Alice', 'Dave']))), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Dave']))], true, ['Alice', 'Carol']),
 sas(release, ['Carol', 'Bob', one('Dave', ['Carol', 'Bob']), one('Alice', 'Dave')], ['Dave', 'Alice', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(coin, ['Bob', 'Dave'])), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Bob']),
 sas(return, ['Carol', 'Alice', one('Dave', ['Carol', 'Alice']), one('Bob', 'Dave')], ['Dave', 'Bob', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(coin, ['Alice', 'Dave'])), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Alice']),
 sas(redeem, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol'], [not(atom(coin, ['Alice', 'Bob'])), atom(coin, ['Bob', 'Bob']), not(atom(coin, ['Bob', 'Carol'])), atom(coin, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(coin, ['Alice', 'Bob']), atom(coin, ['Bob', 'Carol'])], true, ['Alice']),
 sas(open_account, ['Alice', 'Bob'], ['Acct'], [atom(account, ['Alice', const('Acct')]), atom(joint, ['Alice', const('Acct'), 'Bob']), atom(joint, ['Bob', const('Acct'), 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(account, ['Alice', const('Acct')]))], true, ['Alice', 'Bob']),
 sas(deposit, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Sum', 'Acct'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol']))), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob'])), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(joint, ['Alice', const('Acct'), 'Bob']), atom(joint, ['Bob', const('Acct'), 'Alice']), times(num('Sum'), atom(coin, ['Alice', 'Carol']))], true, ['Alice']),
 sas(partner_deposit, ['Bob', 'Alice', one('Carol', ['Bob', 'Alice'])], ['Carol', 'Sum', 'Acct'], [not(times(num('Sum'), atom(coin, ['Bob', 'Carol']))), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob'])), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(joint, ['Alice', const('Acct'), 'Bob']), atom(joint, ['Bob', const('Acct'), 'Alice']), times(num('Sum'), atom(coin, ['Bob', 'Carol']))], true, ['Bob']),
 sas(withdraw, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Acct', 'Sum'], [not(times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))), times(num('Sum'), atom(coin, ['Alice', 'Carol']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))], true, ['Alice', 'Bob']),
 sas(partner_withdraw, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Acct', 'Sum'], [not(times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))), times(num('Sum'), atom(coin, ['Bob', 'Carol']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), times(num('Sum'), atom(joint_coin, ['Alice', 'Carol', const('Acct'), 'Bob']))], true, ['Alice', 'Bob'])])).
