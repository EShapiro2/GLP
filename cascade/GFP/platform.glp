dom_bindings(Nm, Rs, B, Id, Sh, Bs?) :- ground(Nm?), ground(Rs?), ground(B?), ground(Id?), ground(Sh?) | specs_at(Rs?, 1, B?, Id?, RsP), unlocal(B?, B0), con_at(Nm?, B?, Id?, Con), forms_at(Nm?, B?, Id?, Fs), dom_bindings1(RsP?, B0?, Sh?, Con?, Fs?, Bs).

