wound_by1(no, _, _, _, St, Acc, Acc?, St?).
wound_by1(yes, A, B, V, St, Acc, Cs?, St1?) :- ground(B?) | attempt_class(B?, C), st_class(C?, St?, Cr, St1), wound_by_c(Cr?, A?, B?, V?, Acc?, Cs).

procedure wound_by_c(ClassRes?, Attempt?, Attempt?, V?, Cands?, Cands).
wound_by_c(nocls, _, _, _, Acc, Acc?).
wound_by_c(cls(I), A, B, V, Acc, Cs?) :- ground(I?), ground(A?), ground(B?), ground(V?) | v_id(V?, Id), v_recs(V?, R), wound_rec(I?, A?, B?, Id?, R?, Ok), vote_cand(Ok?, cls(I?), wd(A?, B?), Acc?, Cs).

procedure wound_rec(Info?, Attempt?, Attempt?, Peer?, Recs?, YesNo).
wound_rec(I, A, B, Id, R, Ok?) :- ground(I?), ground(B?), ground(Id?), ground(R?) | prio(A?, B?, Pr), mem(yielded(B?), R?, Yd), neg(Yd?, NYd), attempt_id(B?, P), same(P?, Id?, Own), all_yes(I?, B?, Id?, R?, All), wound_by2(Own?, All?, Ok1), and(Pr?, NYd?, B1), and(B1?, Ok1?, Ok).

procedure wound_by2(YesNo?, YesNo?, YesNo).
