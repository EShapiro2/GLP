has_chose([_ | R], At, B?) :- otherwise | has_chose(R?, At?, B).

procedure ready_cands(St?, Cands, St).
ready_cands(St, Cs?, St1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), st_view(St?, V), ready_cands0(R?, V?, St?, Cs, St1).

