show_known(Q, St0, St, Thr?, Thr1, St?) :- ground(Q?), ground(St0?), ground(St?) | known_st(Q?, St0?, B0), known_st(Q?, St?, B1), neg(B0?, N0), and(N0?, B1?, B), show_view(B?, St?, Thr, Thr1?).

