intro_pend(ix(Tr, Wl, In, ic(S0, Ns0, Pe)), Id, S, ix(Tr?, Wl?, In1?, Ic?)) :- ground(S?), ground(S0?) | same(S?, S0?, Sm), intro_pend1(Sm?, S?, Ns0?, Pe?, Id?, In?, Ic, In1).

