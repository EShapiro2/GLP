wound_by(noblk, _, _, St, Acc, Acc?, St?).
wound_by(blk(B), A, V, St, Acc, Cs?, St1?) :- ground(B?), ground(A?), ground(V?) | prio(A?, B?, Pr), v_recs(V?, R), mem(yielded(B?), R?, Yd), neg(Yd?, NYd), and(Pr?, NYd?, Go), wound_by1(Go?, A?, B?, V?, St?, Acc?, Cs, St1).

