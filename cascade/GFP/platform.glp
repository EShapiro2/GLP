procedure commit_cand(YesNo?, ClassRes?, Attempt?, Peer?, Recs?, Cands?, Cands).
commit_cand(yes, cls(I), At, _, R, Acc, Cs?) :- ground(I?), ground(At?), ground(R?) | mem(closed(At?), R?, Cl), neg(Cl?, Open), has_chose(R?, At?, Chs), and(Open?, Chs?, B), vote_cand(B?, cls(I?), cm(At?), Acc?, Cs).
