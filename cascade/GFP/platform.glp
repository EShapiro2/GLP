dom_bindings1(RsP, B0, Sh, Con, Fs, Bs?) :- ground(RsP?), ground(Sh?), ground(Con?) | reqs_of(RsP?, Q), match_all(Q?, Sh?, B0?, Cs0), extend_each(Cs0?, Con?, Sh?, Cs1), dedup(Cs1?, Cs), dom_keep(Cs?, RsP?, Sh?, Con?, Fs?, Bs).

