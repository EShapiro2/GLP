opening1(Ss, Rf, Id, S, St, Is?, St1?) :- ground(Id?), ground(S?) | hat(Rf?, Id?, S?, Sh), opened(Ss?, Id?, Sh?, Cs), meet_all(Cs?, St?, [], Is0, St1), dedup(Is0?, Is).

