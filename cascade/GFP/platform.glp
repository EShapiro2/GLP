procedure some_holds(Bindings?, Form?, GAtoms?, YesNo).
some_holds([], _, _, no).
some_holds([B | Bs], F, Sh, R?) :- ground(F?), ground(Sh?) | form_holds(F?, B?, Sh?, R1), some_holds1(R1?, Bs?, F?, Sh?, R).

procedure some_holds1(YesNo?, Bindings?, Form?, GAtoms?, YesNo).
some_holds1(yes, _, _, _, yes).
some_holds1(no, Bs, F, Sh, R?) :- some_holds(Bs?, F?, Sh?, R).

procedure all_hold(Bindings?, Form?, Forms?, GAtoms?, YesNo).
all_hold([], _, _, _, yes).
all_hold([B | Bs], F, Gs, Sh, R?) :- ground(B?), ground(F?), ground(Gs?), ground(Sh?) | form_holds(F?, B?, Sh?, C), concl_holds(C?, Gs?, B?, Sh?, R1), all_hold1(R1?, Bs?, F?, Gs?, Sh?, R).

procedure concl_holds(YesNo?, Forms?, Binding?, GAtoms?, YesNo).
concl_holds(no, _, _, _, yes).
concl_holds(yes, Gs, B, Sh, R?) :- forms_hold(Gs?, B?, Sh?, R).

procedure all_hold1(YesNo?, Bindings?, Form?, Forms?, GAtoms?, YesNo).
all_hold1(no, _, _, _, _, no).
all_hold1(yes, Bs, F, Gs, Sh, R?) :- all_hold(Bs?, F?, Gs?, Sh?, R).

procedure reqs_of(RoleSpecs?, SAtoms).
reqs_of([], []).
reqs_of([R | Rs], Q?) :- ground(R?) | rs_req(R?, Q1), reqs_of(Rs?, Q2), app(Q1?, Q2?, Q).

procedure cand_ok(RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok([], _, _, yes).
cand_ok([R | Rs], B, Sh, Out?) :- ground(R?), ground(B?), ground(Sh?) | rs_req(R?, Q), img_atoms(Q?, B?, G), ms_sub(G?, Sh?, B1), rs_forb(R?, F), forb_ok(F?, B?, Sh?, B2), and(B1?, B2?, B3), cand_ok1(B3?, Rs?, B?, Sh?, Out).

procedure cand_ok1(YesNo?, RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok1(no, _, _, _, no).
cand_ok1(yes, Rs, B, Sh, Out?) :- cand_ok(Rs?, B?, Sh?, Out).

procedure forb_ok(SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok([], _, _, yes).
forb_ok([A | As], B, Sh, R?) :- ground(A?), ground(B?), ground(Sh?) | atom_bound(A?, B?, Bd), forb_one(Bd?, A?, B?, Sh?, R1), forb_ok1(R1?, As?, B?, Sh?, R).

procedure forb_one(YesNo?, SAtom?, Binding?, GAtoms?, YesNo).
forb_one(no, _, _, _, yes).
forb_one(yes, A, B, Sh, R?) :- ground(Sh?) | img_atom(A?, B?, G), mem(G?, Sh?, In), neg(In?, R).

procedure forb_ok1(YesNo?, SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok1(no, _, _, _, no).
forb_ok1(yes, As, B, Sh, R?) :- forb_ok(As?, B?, Sh?, R).

procedure apply_part(Class?, Peer?, GAtoms?, Binding?, GAtoms).
apply_part(P, Id, S, W, S1?) :- ground(P?), ground(Id?), ground(S?), ground(W?) | term_spec(P?, Nm, Rs, Bn), reflexive_preds(Rf), hat(Rf?, Id?, S?, Sh), dom_bindings(Nm?, Rs?, Bn?, Id?, Sh?, Bs), under_readings(Bs?, W?, Bs1), term_spec(P?, Nm2, Rs2, Bn2), reflexive_preds(Rf2), hat(Rf2?, Id?, S?, Sh2), apply_with(Bs1?, Nm2?, Rs2?, Bn2?, Id?, S?, Sh2?, S1).

procedure under_readings(Bindings?, Binding?, Bindings).
under_readings([], _, []).
under_readings([B | Bs], W, R?) :- ground(B?), ground(W?) | agrees(W?, B?, A), merge_in(W?, B?, B1), under_readings(Bs?, W?, R1), keep_binding(A?, B1?, R1?, R).

procedure agrees(Binding?, Binding?, YesNo).
agrees([], _, yes).
agrees([b(V, X) | W], B, A?) :- ground(V?), ground(X?), ground(B?) | lookup(V?, B?, F), agrees1(F?, X?, W?, B?, A).

procedure agrees1(Found?, Val?, Binding?, Binding?, YesNo).
agrees1(free, _, W, B, A?) :- agrees(W?, B?, A).
agrees1(found(Y), X, W, B, A?) :- ground(X?), ground(Y?) | same(X?, Y?, E), agrees2(E?, W?, B?, A).

procedure agrees2(YesNo?, Binding?, Binding?, YesNo).
agrees2(no, _, _, no).
agrees2(yes, W, B, A?) :- agrees(W?, B?, A).

procedure merge_in(Binding?, Binding?, Binding).
merge_in([], B, B?).
merge_in([b(V, X) | W], B, B2?) :- ground(V?), ground(B?) | lookup(V?, B?, F), merge_one(F?, V?, X?, B?, B1), merge_in(W?, B1?, B2).

procedure merge_one(Found?, Var?, Val?, Binding?, Binding).
merge_one(free, V, X, B, [b(V?, X?) | B?]).
merge_one(found(_), _, _, B, B?).

procedure apply_with(Bindings?, Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, GAtoms?, GAtoms).
apply_with([B | _], Nm, Rs, _, Id, S, Sh, S1?) :- ground(Rs?), ground(B?), ground(Id?) | specs_at(Rs?, 1, B?, Id?, RsP), joins(RsP?, B?, D, A), local_effect(Nm?, B?, Id?, Sh?, Dl, Al), clear_split(D?, Dp0, Ks), app(Dp0?, Dl?, Dp), ms_diff(S?, Dp?, S0a), clear_out(S0a?, Ks?, S0), app(Al?, S0?, S0b), app(A?, S0b?, S1).
apply_with([], Nm, Rs, Bn, Id, S, Sh, S1?) :- ground(Rs?), ground(Bn?), ground(Id?) | specs_at(Rs?, 1, Bn?, Id?, RsP), joins(RsP?, Bn?, D, A), local_effect(Nm?, Bn?, Id?, Sh?, Dl, Al), clear_split(D?, Dp0, Ks), app(Dp0?, Dl?, Dp), ms_diff(S?, Dp?, S0a), clear_out(S0a?, Ks?, S0), app(Al?, S0?, S0b), app(A?, S0b?, S1).

procedure local_effect(Constant?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
local_effect(Nm, B, Id, Sh, D?, A?) :- ground(Nm?) | schema_locals(Nm?, Lc), local_apply(Lc?, B?, Id?, Sh?, D, A).

procedure local_apply(Locals?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
local_apply([], _, _, _, [], []).
local_apply([local(Bi, Xs, An, Phi, CA, CD) | Ls], B, Id, Sh, D?, A?) :- ground(B?), ground(Id?), ground(Sh?) | role_person(Bi?, B?, P), same(P?, Id?, Mine), local_one(Mine?, Xs?, An?, Phi?, CA?, CD?, B?, Sh?, D1, A1), local_apply(Ls?, B?, Id?, Sh?, D2, A2), app(D1?, D2?, D), app(A1?, A2?, A).

procedure local_one(YesNo?, Vars?, SAtom?, Form?, HMults?, HMults?, Binding?, GAtoms?, GAtoms, GAtoms).
local_one(no, _, _, _, _, _, _, _, [], []).
local_one(yes, Xs, An, Phi, CA, CD, B, Sh, D?, A?) :- ground(Xs?), ground(An?), ground(B?), ground(Sh?) | inst_at(Xs?, An?, Phi?, B?, Sh?, L), hm_atoms_of(CA?, Ma), hm_atoms_of(CD?, Md), local_two(L?, Xs?, Ma?, Md?, B?, D, A).

procedure local_two(Insts?, Vars?, SAtoms?, SAtoms?, Binding?, GAtoms, GAtoms).
local_two(L, Xs, Ma, Md, B, D?, A?) :- ground(L?), ground(Xs?), ground(B?) | local_atoms(L?, Xs?, Ma?, B?, A0), local_atoms(L?, Xs?, Md?, B?, D0), dedup(A0?, A), dedup(D0?, D).

procedure local_atoms(Insts?, Vars?, SAtoms?, Binding?, GAtoms).
local_atoms([], _, _, _, []).
local_atoms([I | Is], Xs, Ms, B, Gs?) :- ground(I?), ground(Xs?), ground(Ms?), ground(B?) | inst_bind(Xs?, I?, B?, B1), img_atoms(Ms?, B1?, G1), local_atoms(Is?, Xs?, Ms?, B?, G2), app(G1?, G2?, Gs).

procedure clear_split(GAtoms?, GAtoms, GAtoms).
clear_split([], [], []).
clear_split([G | Gs], D?, K?) :- ground(G?) | g_wild(G?, W), clear_split(Gs?, D1, K1), clear_put(W?, G?, D1?, K1?, D, K).

procedure clear_put(YesNo?, GAtom?, GAtoms?, GAtoms?, GAtoms, GAtoms).
clear_put(yes, G, D, K, D?, [G? | K?]).
clear_put(no, G, D, K, [G? | D?], K?).

procedure g_wild(GAtom?, YesNo).
g_wild(g(_, Xs), W?) :- vals_wild(Xs?, W).

procedure vals_wild(Vals?, YesNo).
vals_wild([], no).
vals_wild([any | _], yes).
vals_wild([c(C) | Xs], W?) :- cn_wild(C?, W1), vals_wild1(W1?, Xs?, W).
vals_wild([X | Xs], W?) :- otherwise, ground(X?) | vals_wild(Xs?, W).

procedure vals_wild1(YesNo?, Vals?, YesNo).
vals_wild1(yes, _, yes).
vals_wild1(no, Xs, W?) :- vals_wild(Xs?, W).

procedure cn_wild(CName?, YesNo).
cn_wild(community(_), no).
cn_wild(dot(C, _), W?) :- cn_wild(C?, W).
cn_wild(dot_any(_), yes).

procedure clear_out(GAtoms?, GAtoms?, GAtoms).
clear_out(S, [], S?).
clear_out([], [_ | _], []).
clear_out([G | Gs], [K | Ks], R?) :- ground(G?), ground(K?), ground(Ks?) | g_cleared(G?, [K? | Ks?], M), neg(M?, Keep), clear_out(Gs?, [K? | Ks?], R1), keep_g(Keep?, G?, R1?, R).

procedure g_cleared(GAtom?, GAtoms?, YesNo).
g_cleared(_, [], no).
g_cleared(G, [K | Ks], M?) :- ground(G?), ground(K?) | g_matches(K?, G?, M1), g_cleared1(M1?, G?, Ks?, M).

procedure g_cleared1(YesNo?, GAtom?, GAtoms?, YesNo).
g_cleared1(yes, _, _, yes).
g_cleared1(no, G, Ks, M?) :- g_cleared(G?, Ks?, M).

procedure g_matches(GAtom?, GAtom?, YesNo).
g_matches(g(P, Ks), g(Q, Xs), M?) :- (P? =?= Q?) | gm_vals(Ks?, Xs?, M).
g_matches(_, _, no) :- otherwise | true.

procedure gm_vals(Vals?, Vals?, YesNo).
gm_vals([], [], yes).
gm_vals([], [_ | _], no).
gm_vals([_ | _], [], no).
gm_vals([K | Ks], [X | Xs], M?) :- ground(K?), ground(X?) | gm_val(K?, X?, M1), gm_vals1(M1?, Ks?, Xs?, M).

procedure gm_vals1(YesNo?, Vals?, Vals?, YesNo).
gm_vals1(no, _, _, no).
gm_vals1(yes, Ks, Xs, M?) :- gm_vals(Ks?, Xs?, M).

procedure gm_val(Val?, Val?, YesNo).
gm_val(any, _, yes).
gm_val(c(K), c(C), M?) :- gm_cname(K?, C?, M).
gm_val(K, X, M?) :- otherwise | same(K?, X?, M).

procedure gm_cname(CName?, CName?, YesNo).
gm_cname(dot_any(K), dot(C, _), M?) :- gm_cname(K?, C?, M).
gm_cname(dot(K, S), dot(C, T), M?) :- (S? =?= T?) | gm_cname(K?, C?, M).
gm_cname(community(P), community(Q), yes) :- (P? =?= Q?) | true.
gm_cname(_, _, no) :- otherwise | true.

procedure delta_at(Deltas?, Peer?, GAtoms, GAtoms).
delta_at([], _, [], []).
delta_at([delta(P, D, A) | _], Id, D?, A?) :- (P? =?= Id?) | true.
delta_at([_ | Ps], Id, D?, A?) :- otherwise | delta_at(Ps?, Id?, D, A).

procedure st_class(Class?, St?, ClassRes, St).
st_class(C, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), R?, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca1?, Pd?, Pr?, Hd?, Ix?, Rq?)) :- ground(Id?) | class_info(C?, Id?, Ca?, R, Ca1).

procedure class_info(Class?, Peer?, Infos?, ClassRes, Infos).
class_info(C, Id, Ca, R?, Ca1?) :- ground(C?) | binding_of(C?, Nm, B), class_info1(Nm?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info1(Constant?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info1(Nm, B, C, Id, Ca, R?, Ca1?) :- ground(Nm?), ground(B?) | bound_spec(Nm?, B?, Rs), rule_spec_ok(Nm?, B?, V0), con_live(Nm?, B?, Vc), and(V0?, Vc?, V1), class_info2(V1?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info2(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info2(V1, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | admissible(Rs?, B?, V2), and(V1?, V2?, V), class_info3(V?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info3(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info3(no, _, _, _, _, Ca, nocls, Ca?).
class_info3(yes, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | sig_of(Rs?, B?, Ps), class_info4(Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info4(Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info4(Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Id?), ground(Rs?), ground(B?) | deltas_valid(Ps?, V1), deltas_peers(Ps?, Q), mem(Id?, Q?, V2), deltas_peers(Ps?, Q1), reflexive_preds(Rf), live_at(Q1?, Rs?, B?, Rf?, V3), and(V1?, V2?, V12), and(V12?, V3?, V), class_info5(V?, Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info5(YesNo?, Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info5(no, _, _, _, _, _, Ca, nocls, Ca?).
class_info5(yes, Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Ca?) | cache_find(Rs?, B?, Ps?, Ca?, F), class_info6(F?, Ps?, C?, Id?, Ca?, R, Ca1).

procedure class_info6(ClassRes?, Deltas?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info6(cls(I), _, _, _, Ca, cls(I?), Ca?).
class_info6(nocls, Ps, C, Id, Ca, R?, Ca1?) :- new_info(C?, Ps?, Id?, I), add_info(I?, Ca?, R, Ca1).

procedure add_info(Info?, Infos?, ClassRes, Infos).
add_info(I, Ca, cls(I?), Ca1?) :- ground(I?) | app(Ca?, [I?], Ca1).

procedure cache_find(RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find(_, _, _, [], nocls).
cache_find(Rs, B, Ps, [ci(C, Ps1, Q, Pts, Ms) | Is], R?) :- ground(Rs?), ground(B?), ground(Ps?), ground(Ps1?), ground(Q?), ground(Ms?) | in_class(Rs?, B?, Ps?, Ps1?, Q?, Ms?, E), cache_find1(E?, ci(C?, Ps1?, Q?, Pts?, Ms?), Rs?, B?, Ps?, Is?, R).

procedure cache_find1(YesNo?, Info?, RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find1(yes, I, _, _, _, _, cls(I?)).
cache_find1(no, _, Rs, B, Ps, Is, R?) :- cache_find(Rs?, B?, Ps?, Is?, R).

procedure new_info(Class?, Deltas?, Peer?, Info).
new_info(C, Ps, Id, I?) :- ground(Ps?) | contract_schemas(Ss), reflexive_preds(Rf), mates_of(Ss?, Ps?, Ms0), dedup_mates(Ms0?, Ms1), deltas_peers(Ps?, Q), new_info0(C?, Ps?, Ms1?, Q?, Rf?, Id?, I).

procedure new_info0(Class?, Deltas?, Mates?, Peers?, Preds?, Peer?, Info).
new_info0(C, Ps, Ms1, Q, Rf, Id, I?) :- ground(C?), ground(Q?), ground(Rf?) | live_mates(Ms1?, Q?, Rf?, Ms2), binding_of(C?, Nm, B), class_mates(Nm?, B?, Ms2?, Q?, Rf?, Ms), new_info1(C?, Ps?, Ms?, Id?, I).

procedure new_info1(Class?, Deltas?, Mates?, Peer?, Info).
new_info1(C, Ps, Ms, Id, ci(C?, Ps?, Q?, Pts?, Ms?)) :- ground(Ps?), ground(Ms?) | deltas_peers(Ps?, Q), deltas_peers(Ps?, Q1), info_parts_of(Ms?, Q1?, Id?, Pts).

procedure info_q(Info?, Peers).
info_q(ci(_, _, Q, _, _), Q?).

procedure info_parts(Info?, Parts).
info_parts(ci(_, _, _, Pts, _), Pts?).

procedure sig_of(RoleSpecs?, Binding?, Deltas).
sig_of(Rs, B, Ps?) :- ground(Rs?), ground(B?) | role_persons(Rs?, 1, B?, Ws), dedup(Ws?, Q), deltas_for(Q?, Rs?, B?, Ps).

procedure role_persons(RoleSpecs?, Integer?, Binding?, Peers).
role_persons([], _, _, []).
role_persons([_ | Rs], I, B, [P? | Ps?]) :- integer(I?), ground(B?) | role_person(I?, B?, P), I1 := (I? + 1), role_persons(Rs?, I1?, B?, Ps).

procedure deltas_for(Peers?, RoleSpecs?, Binding?, Deltas).
deltas_for([], _, _, []).
deltas_for([P | Ps], Rs, B, [delta(P?, D?, A?) | Xs?]) :- ground(P?), ground(Rs?), ground(B?) | specs_at(Rs?, 1, B?, P?, RsP), joins(RsP?, B?, D, A), deltas_for(Ps?, Rs?, B?, Xs).

procedure joins(RoleSpecs?, Binding?, GAtoms, GAtoms).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) | dels_join(RsP?, B?, [], D), adds_join(RsP?, B?, [], A).

procedure dels_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
dels_join([], _, Acc, Acc?).
dels_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_del(R?, D), img_atoms(D?, B?, G), ms_join(Acc?, G?, Acc1), dels_join(Rs?, B?, Acc1?, Out).

procedure adds_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
adds_join([], _, Acc, Acc?).
adds_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_add(R?, A), img_atoms(A?, B?, G), ms_join(Acc?, G?, Acc1), adds_join(Rs?, B?, Acc1?, Out).

procedure specs_at(RoleSpecs?, Integer?, Binding?, Peer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R | Rs], I, B, P, Out?) :- integer(I?), ground(B?), ground(P?) | role_person(I?, B?, Q), I1 := (I? + 1), specs_at(Rs?, I1?, B?, P?, Rest), keep_spec(Q?, P?, R?, Rest?, Out).

procedure keep_spec(Peer?, Peer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R? | Rest?]) :- (Q? =?= P?) | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.

procedure deltas_valid(Deltas?, YesNo).
deltas_valid([], yes).
deltas_valid([delta(_, D, A) | Ps], B?) :- ground(A?) | ms_meets(D?, A?, M), neg(M?, B1), deltas_valid1(B1?, Ps?, B).

procedure deltas_valid1(YesNo?, Deltas?, YesNo).
deltas_valid1(no, _, no).
deltas_valid1(yes, Ps, B?) :- deltas_valid(Ps?, B).

procedure deltas_peers(Deltas?, Peers).
deltas_peers([], []).
deltas_peers([delta(P, _, _) | Ps], [P? | Qs?]) :- deltas_peers(Ps?, Qs).

procedure deltas_eq(Deltas?, Deltas?, YesNo).
deltas_eq(A, B, E?) :- ground(A?), ground(B?) | len_deltas(A?, La), len_deltas(B?, Lb), same_int(La?, Lb?, E1), deltas_in(A?, B?, E2), and(E1?, E2?, E).

procedure len_deltas(Deltas?, Integer).
len_deltas([], 0).
len_deltas([_ | Ps], N?) :- len_deltas(Ps?, M), N := (M? + 1).

procedure deltas_in(Deltas?, Deltas?, YesNo).
deltas_in([], _, yes).
deltas_in([X | Xs], B, E?) :- ground(B?) | delta_in(X?, B?, E1), deltas_in1(E1?, Xs?, B?, E).

procedure deltas_in1(YesNo?, Deltas?, Deltas?, YesNo).
deltas_in1(no, _, _, no).
deltas_in1(yes, Xs, B, E?) :- deltas_in(Xs?, B?, E).

procedure delta_in(Delta?, Deltas?, YesNo).
delta_in(_, [], no).
delta_in(delta(P, D, A), [delta(Q, D1, A1) | Ps], E?) :- (P? =?= Q?), ground(D?), ground(A?) | ms_eq(D?, D1?, E1), ms_eq(A?, A1?, E2), and(E1?, E2?, E3), delta_in1(E3?, delta(P?, D?, A?), Ps?, E).
delta_in(X, [_ | Ps], E?) :- otherwise | delta_in(X?, Ps?, E).

procedure delta_in1(YesNo?, Delta?, Deltas?, YesNo).
delta_in1(yes, _, _, yes).
delta_in1(no, X, Ps, E?) :- delta_in(X?, Ps?, E).

procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) | rs_len(Rs?, K), pairs_ok(1, K?, Rs?, B?, R).

procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- (I? > K?) | true.
pairs_ok(I, K, Rs, B, R?) :- (I? =< K?), ground(Rs?), ground(B?) | J := (I? + 1), pair_row(I?, J?, K?, Rs?, B?, R1), I1 := (I? + 1), pairs_ok1(R1?, I1?, K?, Rs?, B?, R).

procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).

procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- (J? > K?) | true.
pair_row(I, J, K, Rs, B, R?) :- (J? =< K?), ground(Rs?), ground(B?) | role_person(I?, B?, P), role_person(J?, B?, Q), nth_spec(Rs?, I?, RI), nth_spec(Rs?, J?, RJ), pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1), J1 := (J? + 1), pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).

procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).

procedure pair_ok(Peer?, Peer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- (P? =?= Q?) | role_names(RI?, J?, A1), role_names(RJ?, I?, A2), or(A1?, A2?, A), neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.

procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(rs(_, A, D, _, _), J, R?) :- integer(J?) | names_role(A?, J?, R1), names_role(D?, J?, R2), or(R1?, R2?, R).

procedure names_role(SAtoms?, Integer?, YesNo).
names_role([], _, no).
names_role([times(_, A) | As], J, R?) :- names_role([A? | As?], J?, R).
names_role([rest(_, _, A) | As], J, R?) :- names_role([A? | As?], J?, R).
names_role([opt(A) | As], J, R?) :- names_role([A? | As?], J?, R).
names_role([atom(_, Vs) | As], J, R?) :- integer(J?), ground(Vs?) | flat_names(Vs?, Fs), mem(role(J?), Fs?, R1), sgn_names(Vs?, J?, R2), or(R1?, R2?, R12), names_role1(R12?, As?, J?, R).

procedure names_role1(YesNo?, SAtoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, As, J, R?) :- names_role(As?, J?, R).

procedure sgn_names(Vars?, Integer?, YesNo).
sgn_names([], _, no).
sgn_names([sgn(_, I) | _], J, yes) :- (I? =:= J?) | true.
sgn_names([_ | Vs], J, R?) :- otherwise | sgn_names(Vs?, J?, R).

procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) | adds_of(Rs?, Ad), reqs_of(Rs?, Rq), guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), atoms_vars(Ad?, Av), adm_each(Av?, Rq?, B?, Gp?, R).

procedure adm_each(Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V | Vs], Rq, B, Gp, R?) :- ground(V?), ground(Rq?), ground(B?), ground(Gp?) | adm_var(V?, Rq?, B?, Gp?, R1), adm_each1(R1?, Vs?, Rq?, B?, Gp?, R).

procedure adm_each1(YesNo?, Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Rq, B, Gp, R?) :- adm_each(Vs?, Rq?, B?, Gp?, R).

procedure adm_var(Var?, SAtoms?, Binding?, Peers?, YesNo).
adm_var(svar(X), Rq, B, Gp, R?) :- ground(X?), ground(B?) | atoms_vars(Rq?, Qv), mem(svar(X?), Qv?, InReq), lookup(svar(X?), B?, F), adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(nterm(_), _, _, _, yes).
adm_var(sgn(_, _), _, _, _, yes).
adm_var(item_of(_), _, _, _, yes).
adm_var(num(_), _, _, _, yes).
adm_var(any, _, _, _, yes).
adm_var(inst(_, _, _), _, _, _, yes).

procedure adm_var1(YesNo?, Found?, Peers?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(s(speech(_, P))), Gp, R?) :- mem(P?, Gp?, R).
adm_var1(no, found(p(_)), _, no).
adm_var1(no, found(c(_)), _, no).
adm_var1(no, found(n(_)), _, no).
adm_var1(no, found(r(_)), _, no).
adm_var1(no, found(lv(_, _)), _, no).
adm_var1(no, free, _, no).
adm_var1(no, found(any), _, no).

procedure adds_of(RoleSpecs?, SAtoms).
adds_of([], []).
adds_of([R | Rs], A?) :- rs_add(R?, A1), adds_of(Rs?, A2), app(A1?, A2?, A).

procedure atoms_vars(SAtoms?, Vars).
atoms_vars([], []).
atoms_vars([atom(_, Vs) | As], R?) :- flat_names(Vs?, Ws), atoms_vars(As?, R1), app(Ws?, R1?, R).
atoms_vars([times(V, A) | As], [V? | R?]) :- atoms_vars([A? | As?], R).
atoms_vars([rest(V, J, A) | As], [V?, J? | R?]) :- atoms_vars([A? | As?], R).
atoms_vars([opt(A) | As], R?) :- atoms_vars([A? | As?], R).

procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([rs(guarded, _, _, _, _) | Rs], I, [I? | Is?]) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).
guard_roles([rs(unguarded, _, _, _, _) | Rs], I, Is?) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).

procedure persons_of(Ints?, Binding?, Peers).
persons_of([], _, []).
persons_of([I | Is], B, [P? | Ps?]) :- ground(B?) | role_person(I?, B?, P), persons_of(Is?, B?, Ps).

procedure mates_of(Schemas?, Deltas?, Mates).
mates_of([], _, []).
mates_of([schema(Nm, _, Rs) | Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Ps?) | deltas_peers(Ps?, Q), rs_len(Rs?, K), fit_assigns(K?, Q?, Rs?, Ps?, As), mates_assigns(As?, Nm?, Rs?, Ps?, M1), mates_of(Ss?, Ps?, M2), app(M1?, M2?, M).
mates_of([lschema(Nm, _, Rs, Lsts) | Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Lsts?), ground(Ps?) | deltas_peers(Ps?, Q), rs_len(Rs?, K), blank_listed(Lsts?, Rs?, Rs0), fit_assigns(K?, Q?, Rs0?, Ps?, As0), on_base(As0?, Lsts?, As), deltas_peers(Ps?, Q1), sort_peers(Q1?, Q2), subsets(Q2?, Ls), list_choices(Lsts?, Ls?, Ps?, Cs), tuples_of(Cs?, Ts), listed_mates(Ts?, As?, Nm?, Rs?, Lsts?, Ps?, M1), mates_of(Ss?, Ps?, M2), app(M1?, M2?, M).

procedure on_base(Bindings?, Listings?, Bindings).
on_base([], _, []).
on_base([B | Bs], Lsts, R?) :- ground(B?), ground(Lsts?) | on_bases(Lsts?, B?, E), on_base(Bs?, Lsts?, R1), keep_binding(E?, B?, R1?, R).

procedure on_bases(Listings?, Binding?, YesNo).
on_bases([], _, yes).
on_bases([listing(I, Bi, _, _, _, _, _) | Lsts], B, E?) :- ground(B?) | role_person(I?, B?, P), role_person(Bi?, B?, Q), same(P?, Q?, E1), on_bases(Lsts?, B?, E2), and(E1?, E2?, E).
on_bases([instances(_, _, _, _, _, _, _) | Lsts], B, E?) :- on_bases(Lsts?, B?, E).

procedure keep_binding(YesNo?, Binding?, Bindings?, Bindings).
keep_binding(yes, B, R, [B? | R?]).
keep_binding(no, _, R, R?).

procedure subsets(Peers?, PeerLists).
subsets([], [[]]).
subsets([P | Ps], R?) :- ground(P?), ground(Ps?) | subsets(Ps?, S1), with_first(S1?, P?, S2), subsets(Ps?, S3), app(S2?, S3?, R).

procedure with_first(PeerLists?, Peer?, PeerLists).
with_first([], _, []).
with_first([L | Ls], P, [[P? | L?] | R?]) :- ground(P?) | with_first(Ls?, P?, R).

procedure list_choices(Listings?, PeerLists?, Deltas?, ListTuples).
list_choices([], _, _, []).
list_choices([listing(_, _, _, _, _, _, _) | Lsts], Ls, Ps, [Ws? | Cs?]) :- ground(Ls?) | wrap_ppl(Ls?, Ws), list_choices(Lsts?, Ls?, Ps?, Cs).
list_choices([instances(_, _, Xs, _, _, CA, CD) | Lsts], Ls, Ps, [Ws? | Cs?]) :- ground(Ps?), ground(Xs?), ground(CA?), ground(CD?) | inst_cands(CA?, CD?, Xs?, Ps?, Q0), sort_insts(Q0?, Q1), dedup(Q1?, Q2), isubsets(Q2?, Is), wrap_ins(Is?, Ws), list_choices(Lsts?, Ls?, Ps?, Cs).

procedure wrap_ppl(PeerLists?, LLists).
wrap_ppl([], []).
wrap_ppl([L | Ls], [ppl(L?) | Ws?]) :- wrap_ppl(Ls?, Ws).

procedure wrap_ins(InstsList?, LLists).
wrap_ins([], []).
wrap_ins([L | Ls], [ins(L?) | Ws?]) :- wrap_ins(Ls?, Ws).

procedure isubsets(Insts?, InstsList).
isubsets([], [[]]).
isubsets([I | Is], R?) :- ground(I?), ground(Is?) | isubsets(Is?, S1), iwith_first(S1?, I?, S2), isubsets(Is?, S3), app(S2?, S3?, R).

procedure iwith_first(InstsList?, Vals?, InstsList).
iwith_first([], _, []).
iwith_first([L | Ls], I, [[I? | L?] | R?]) :- ground(I?) | iwith_first(Ls?, I?, R).

procedure inst_cands(HMults?, HMults?, Vars?, Deltas?, Insts).
inst_cands([H | Hs], _, Xs, Ps, Q?) :- ground(H?), ground(Hs?), ground(Xs?), ground(Ps?) | hm_atoms_of([H? | Hs?], Ms), side_atoms(Ps?, add, Gs), match_all(Ms?, Gs?, [], Bs), inst_vals(Bs?, Xs?, Q).
inst_cands([], [H | Hs], Xs, Ps, Q?) :- ground(H?), ground(Hs?), ground(Xs?), ground(Ps?) | hm_atoms_of([H? | Hs?], Ms), side_atoms(Ps?, del, Gs), match_all(Ms?, Gs?, [], Bs), inst_vals(Bs?, Xs?, Q).
inst_cands([], [], _, _, []).

procedure hm_atoms_of(HMults?, SAtoms).
hm_atoms_of([], []).
hm_atoms_of([hm(_, M) | Hs], [M? | Ms?]) :- hm_atoms_of(Hs?, Ms).

procedure side_atoms(Deltas?, Constant?, GAtoms).
side_atoms([], _, []).
side_atoms([delta(_, Dl, Ad) | Ds], W, Gs?) :- ground(W?) | delta_side(W?, Dl?, Ad?, G1), side_atoms(Ds?, W?, G2), app(G1?, G2?, Gs).

procedure delta_side(Constant?, GAtoms?, GAtoms?, GAtoms).
delta_side(add, _, Ad, Ad?).
delta_side(del, Dl, _, Dl?).

procedure tuples_of(ListTuples?, ListTuples).
tuples_of([], [[]]).
tuples_of([Ls | Cs], R?) :- ground(Ls?) | tuples_of(Cs?, R1), prepend_each(Ls?, R1?, R).

procedure prepend_each(LLists?, ListTuples?, ListTuples).
prepend_each([], _, []).
prepend_each([L | Ls], Ts, R?) :- ground(L?), ground(Ts?) | with_head(Ts?, L?, R1), prepend_each(Ls?, Ts?, R2), app(R1?, R2?, R).

procedure with_head(ListTuples?, LList?, ListTuples).
with_head([], _, []).
with_head([T | Ts], L, [[L? | T?] | R?]) :- ground(L?) | with_head(Ts?, L?, R).

procedure listed_mates(ListTuples?, Bindings?, Constant?, RoleSpecs?, Listings?, Deltas?, Mates).
listed_mates([], _, _, _, _, _, []).
listed_mates([T | Ts], As, Nm, Rs, Lsts, Ps, M?) :- ground(T?), ground(As?), ground(Nm?), ground(Rs?), ground(Lsts?), ground(Ps?) | rs_len(Rs?, K), K1 := (K? + 1), tuple_binds(Lsts?, T?, K1?, Cs), extend_all(As?, Cs?, Bs), spec_for(Rs?, Lsts?, T?, Rs1), mates_assigns(Bs?, Nm?, Rs1?, Ps?, M1), listed_mates(Ts?, As?, Nm?, Rs?, Lsts?, Ps?, M2), app(M1?, M2?, M).

procedure extend_all(Bindings?, Binding?, Bindings).
extend_all([], _, []).
extend_all([B | Bs], Cs, [B1? | R?]) :- ground(Cs?) | app(B?, Cs?, B1), extend_all(Bs?, Cs?, R).

procedure fit_assigns(Integer?, Peers?, RoleSpecs?, Deltas?, Bindings).
fit_assigns(K, Q, Rs, Ps, As?) :- fit_roles(1, K?, Q?, Rs?, Ps?, [], As).

procedure fit_roles(Integer?, Integer?, Peers?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_roles(I, K, _, _, _, B, [B?]) :- (I? > K?) | true.
fit_roles(I, K, Q, Rs, Ps, B, As?) :- (I? =< K?), ground(Q?), ground(Rs?) | nth_spec(Rs?, I?, R), fit_one(Q?, I?, K?, Q?, R?, Rs?, Ps?, B?, As).

procedure fit_one(Peers?, Integer?, Integer?, Peers?, RoleSpec?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_one([], _, _, _, _, _, _, _, []).
fit_one([P | Qs], I, K, Q, R, Rs, Ps, B, As?) :- ground(P?), integer(I?), ground(Q?), ground(R?), ground(Rs?), ground(Ps?), ground(B?) | fits(R?, [b(role(I?), p(P?)) | B?], P?, Ps?, Ok), I1 := (I? + 1), fit_next(Ok?, I1?, K?, Q?, Rs?, Ps?, [b(role(I?), p(P?)) | B?], As1), fit_one(Qs?, I?, K?, Q?, R?, Rs?, Ps?, B?, As2), app(As1?, As2?, As).

procedure fit_next(YesNo?, Integer?, Integer?, Peers?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_next(no, _, _, _, _, _, _, []).
fit_next(yes, I, K, Q, Rs, Ps, B, As?) :- fit_roles(I?, K?, Q?, Rs?, Ps?, B?, As).

procedure fits(RoleSpec?, Binding?, Peer?, Deltas?, YesNo).
fits(R, B, P, Ps, Ok?) :- ground(R?) | delta_at(Ps?, P?, D, A), rs_del(R?, Dr), rs_add(R?, Ar), match_all(Dr?, D?, B?, Bs), match_all_each(Bs?, Ar?, A?, Ms), some_binding(Ms?, Ok).

procedure some_binding(Bindings?, YesNo).
some_binding([], no).
some_binding([_ | _], yes).

procedure assigns(Integer?, Peers?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).

procedure assigns1(Integer?, Integer?, Peers?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- (I? > K?) | true.
assigns1(I, K, Q, Acc, R?) :- (I? =< K?), ground(Q?) | extend_role(Acc?, I?, Q?, Acc1), I1 := (I? + 1), assigns1(I1?, K?, Q?, Acc1?, R).

procedure extend_role(Bindings?, Integer?, Peers?, Bindings).
extend_role([], _, _, []).
extend_role([B | Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) | extend_one(Q?, I?, B?, R1), extend_role(Bs?, I?, Q?, R2), app(R1?, R2?, R).

procedure extend_one(Peers?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P | Ps], I, B, [[b(role(I?), p(P?)) | B?] | R?]) :- ground(B?), integer(I?) | extend_one(Ps?, I?, B?, R).

procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_assigns([], _, _, _, []).
mates_assigns([B | Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | deltas_peers(Ps?, Q), role_persons(Rs?, 1, B?, Ws), all_in(Q?, Ws?, Onto), rule_spec_ok(Nm?, B?, Ok), and(Onto?, Ok?, Go), mates_assign(Go?, B?, Nm?, Rs?, Ps?, M1), mates_assigns(Bs?, Nm?, Rs?, Ps?, M2), app(M1?, M2?, M).

procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_assign(no, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Ps, M?) :- ground(Rs?), ground(Ps?) | match_deltas(Ps?, Rs?, [B?], Bs), mates_check(Bs?, Nm?, Rs?, Ps?, M).

procedure match_deltas(Deltas?, RoleSpecs?, Bindings?, Bindings).
match_deltas([], _, Bs, Bs?).
match_deltas([delta(P, D, A) | Ps], Rs, Bs, R?) :- ground(P?), ground(D?), ground(A?), ground(Rs?) | match_delta(Bs?, P?, D?, A?, Rs?, Bs1), match_deltas(Ps?, Rs?, Bs1?, R).

procedure match_delta(Bindings?, Peer?, GAtoms?, GAtoms?, RoleSpecs?, Bindings).
match_delta([], _, _, _, _, []).
match_delta([B | Bs], P, D, A, Rs, R?) :- ground(B?), ground(P?), ground(D?), ground(A?), ground(Rs?) | specs_at(Rs?, 1, B?, P?, RsP), match_delta1(RsP?, B?, D?, A?, B2), match_delta(Bs?, P?, D?, A?, Rs?, R2), app(B2?, R2?, R).

procedure match_delta1(RoleSpecs?, Binding?, GAtoms?, GAtoms?, Bindings).
match_delta1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) | dels_of(RsP?, Dp), adds_of(RsP?, Ap), match_all(Dp?, D?, B?, B1), match_all_each(B1?, Ap?, A?, R).

procedure dels_of(RoleSpecs?, SAtoms).
dels_of([], []).
dels_of([R | Rs], A?) :- rs_del(R?, A1), dels_of(Rs?, A2), app(A1?, A2?, A).

procedure mates_check(Bindings?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_check([], _, _, _, []).
mates_check([B | Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | local_norm(Nm?, B?, Nb), mates_check1(Nb?, Nm?, Rs?, Ps?, M1), mates_check(Bs?, Nm?, Rs?, Ps?, M2), app(M1?, M2?, M).

procedure mates_check1(LNorm?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_check1(badnorm, _, _, _, []).
mates_check1(norm(B), Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | sig_of(Rs?, B?, Ps1), deltas_eq(Ps?, Ps1?, E1), admissible(Rs?, B?, E2), and(E1?, E2?, E), mate_of(E?, B?, Nm?, Rs?, M).

procedure local_norm(Constant?, Binding?, LNorm).
local_norm(Nm, B, R?) :- ground(Nm?), ground(B?) | schema_numeric(Nm?, N), local_norm1(N?, Nm?, B?, R).

procedure local_norm1(Numeric?, Constant?, Binding?, LNorm).
local_norm1(numeric(_, Ls, _), Nm, B, R?) :- ground(Ls?), ground(Nm?), ground(B?) | lv_wrong(B?, Ls?, Nm?, W), locals_put(Ls?, Nm?, B?, B1), norm_or_bad(W?, B1?, R).

procedure norm_or_bad(YesNo?, Binding?, LNorm).
norm_or_bad(no, B, norm(B?)).
norm_or_bad(yes, _, badnorm).

procedure lv_wrong(Binding?, Vars?, Constant?, YesNo).
lv_wrong([], _, _, no).
lv_wrong([b(V, X) | Bs], Ls, Nm, W?) :- ground(V?), ground(X?), ground(Ls?), ground(Nm?) | mem(V?, Ls?, IsL), entry_wrong(IsL?, V?, X?, Nm?, W1), lv_wrong(Bs?, Ls?, Nm?, W2), or(W1?, W2?, W).

procedure entry_wrong(YesNo?, Var?, Val?, Constant?, YesNo).
entry_wrong(yes, V, X, Nm, W?) :- local_wrong(V?, X?, Nm?, W).
entry_wrong(no, _, X, _, W?) :- is_lv(X?, W).

procedure local_wrong(Var?, Val?, Constant?, YesNo).
local_wrong(num(Xn), X, Nm, W?) :- ground(Xn?), ground(Nm?) | same(X?, lv(Nm?, Xn?), S), neg(S?, W).
local_wrong(pvar(Xn), X, Nm, W?) :- ground(Xn?), ground(Nm?) | same(X?, lv(Nm?, Xn?), S), neg(S?, W).
local_wrong(svar(Xn), X, Nm, W?) :- ground(Xn?), ground(Nm?) | same(X?, lv(Nm?, Xn?), S), neg(S?, W).
local_wrong(_, _, _, yes) :- otherwise | true.

procedure is_lv(Val?, YesNo).
is_lv(lv(_, _), yes).
is_lv(p(_), no).
is_lv(s(_), no).
is_lv(c(_), no).
is_lv(n(_), no).
is_lv(r(_), no).
is_lv(i(_), no).
is_lv(any, no).

procedure locals_put(Vars?, Constant?, Binding?, Binding).
locals_put([], _, B, B?).
locals_put([V | Vs], Nm, B, B2?) :- ground(V?), ground(Nm?), ground(B?) | lookup(V?, B?, F), local_put(F?, V?, Nm?, B?, B1), locals_put(Vs?, Nm?, B1?, B2).

procedure local_put(Found?, Var?, Constant?, Binding?, Binding).
local_put(free, num(X), Nm, B, [b(num(X?), lv(Nm?, X?)) | B?]) :- ground(X?), ground(Nm?) | true.
local_put(free, pvar(X), Nm, B, [b(pvar(X?), lv(Nm?, X?)) | B?]) :- ground(X?), ground(Nm?) | true.
local_put(free, svar(X), Nm, B, [b(svar(X?), lv(Nm?, X?)) | B?]) :- ground(X?), ground(Nm?) | true.
local_put(found(_), _, _, B, B?).
local_put(free, V, _, B, B?) :- otherwise, ground(V?) | true.

procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, B?, G?, F?)]) :- ground(B?), ground(Rs?) | guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), sort_peers(Gp?, Gs), dedup(Gs?, G), role_person(1, B?, F).

procedure dedup_mates(Mates?, Mates).
dedup_mates([], []).
dedup_mates([M | Ms], [M? | R?]) :- ground(M?) | drop_mate(M?, Ms?, Ms1), dedup_mates(Ms1?, R).

procedure drop_mate(Mate?, Mates?, Mates).
drop_mate(_, [], []).
drop_mate(mate(N, B, G, F), [mate(N1, B1, G1, F1) | Ms], R?) :- ground(N?), ground(B?), ground(G?), ground(F?), ground(N1?), ground(B1?) | same(N?, N1?, E1), ms_eq(B?, B1?, E2), and(E1?, E2?, E), drop_mate1(E?, mate(N?, B?, G?, F?), mate(N1?, B1?, G1?, F1?), Ms?, R).

procedure drop_mate1(YesNo?, Mate?, Mate?, Mates?, Mates).
drop_mate1(yes, M, _, Ms, R?) :- drop_mate(M?, Ms?, R).
drop_mate1(no, M, M1, Ms, [M1? | R?]) :- drop_mate(M?, Ms?, R).

procedure info_parts_of(Mates?, Peers?, Peer?, Parts).
info_parts_of(Ms, Q, Id, Pts?) :- ground(Ms?) | parts_of(Ms?, Ms?, Q?, Id?, [], Pts).

procedure parts_of(Mates?, Mates?, Peers?, Peer?, Mates?, Parts).
parts_of([], _, _, _, _, []).
parts_of([M | Ms], All, Q, Id, Seen, Pts?) :- ground(M?), ground(Q?), ground(Seen?) | part_seen(Seen?, M?, Q?, Old), parts_of1(Old?, M?, Ms?, All?, Q?, Id?, Seen?, Pts).

procedure parts_of1(YesNo?, Mate?, Mates?, Mates?, Peers?, Peer?, Mates?, Parts).
parts_of1(yes, _, Ms, All, Q, Id, Seen, Pts?) :- parts_of(Ms?, All?, Q?, Id?, Seen?, Pts).
parts_of1(no, mate(N, B, G, F), Ms, All, Q, Id, Seen, [pt(T?, G?, Op?) | Pts?]) :- ground(N?), ground(B?), ground(G?), ground(F?), ground(All?), ground(Q?), ground(Id?) | class_of(N?, B?, Id?, T), part_firsts(All?, mate(N?, B?, G?, F?), Q?, Fs), part_gfirsts(All?, mate(N?, B?, G?, F?), Q?, G?, Fo), part_bases(All?, G?, Ob), part_opener(G?, Fs?, Fo?, Ob?, Op), parts_of(Ms?, All?, Q?, Id?, [mate(N?, B?, G?, F?) | Seen?], Pts).

procedure part_seen(Mates?, Mate?, Peers?, YesNo).
part_seen([], _, _, no).
part_seen([S | Ss], M, Q, B?) :- ground(M?), ground(Q?) | same_mpart(Q?, S?, M?, B1), part_seen1(B1?, Ss?, M?, Q?, B).

procedure part_seen1(YesNo?, Mates?, Mate?, Peers?, YesNo).
part_seen1(yes, _, _, _, yes).
part_seen1(no, Ss, M, Q, B?) :- part_seen(Ss?, M?, Q?, B).

procedure part_firsts(Mates?, Mate?, Peers?, Peers).
part_firsts([], _, _, []).
part_firsts([mate(N, B, G, F) | Ms], M, Q, Fs?) :- ground(F?), ground(M?), ground(Q?) | same_mpart(Q?, mate(N?, B?, G?, F?), M?, S), part_firsts(Ms?, M?, Q?, Fs1), keep_peer(S?, F?, Fs1?, Fs).

procedure part_gfirsts(Mates?, Mate?, Peers?, Peers?, Peers).
part_gfirsts([], _, _, _, []).
part_gfirsts([mate(N, B, G1, F) | Ms], M, Q, G, Fs?) :- ground(N?), ground(F?), ground(M?), ground(Q?), ground(G?) | same_mpart(Q?, mate(N?, B?, G1?, F?), M?, S), opens_guarded(N?, O), mem(F?, G?, InG), neg(InG?, NotG), and(S?, O?, S1), and(S1?, NotG?, K), part_gfirsts(Ms?, M?, Q?, G?, Fs1), keep_peer(K?, F?, Fs1?, Fs).

procedure opens_guarded(Constant?, YesNo).
opens_guarded(Nm, B?) :- schema_entry(Nm?, E), opens_guarded1(E?, B).

procedure opens_guarded1(Schema?, YesNo).
opens_guarded1(schema(_, _, _), no).
opens_guarded1(lschema(_, _, _, []), no).
opens_guarded1(lschema(_, _, Rs, [listing(_, Bi, _, _, _, _, _) | _]), B?) :- ground(Rs?), integer(Bi?) | nth_spec(Rs?, Bi?, R), spec_unguarded(R?, B).
opens_guarded1(lschema(_, _, Rs, [instances(_, Bi, _, _, _, _, _) | _]), B?) :- ground(Rs?), integer(Bi?) | nth_spec(Rs?, Bi?, R), spec_unguarded(R?, B).

procedure spec_unguarded(RoleSpec?, YesNo).
spec_unguarded(rs(unguarded, _, _, _, _), yes).
spec_unguarded(rs(guarded, _, _, _, _), no).

procedure part_opener(Peers?, Peers?, Peers?, Peers?, Opener).
part_opener([], Fs, _, Ob, Op?) :- sort_peers(Fs?, Ss), least_opener(Ss?, Ob?, Op).
part_opener([_ | _], _, Fo, Ob, Op?) :- sort_peers(Fo?, Ss), least_opener(Ss?, Ob?, Op).

procedure least_opener(Peers?, Peers?, Opener).
least_opener([P | _], _, opener(P?)).
least_opener([], Ob, proposed(Ob1?)) :- sort_peers(Ob?, Ob0), dedup(Ob0?, Ob1).

procedure part_bases(Mates?, Peers?, Peers).
part_bases([], _, []).
part_bases([mate(N, B, _, _) | Ms], G, Ob?) :- ground(N?), ground(B?), ground(G?) | schema_base(N?, Bi), role_person(Bi?, B?, P), mem(P?, G?, In), part_bases(Ms?, G?, Ob1), keep_peer(In?, P?, Ob1?, Ob).

procedure same_mpart(Peers?, Mate?, Mate?, YesNo).
same_mpart(Q, mate(N1, B1, G1, _), mate(N2, B2, G2, _), B?) :- same_bpart(Q?, N1?, B1?, G1?, N2?, B2?, G2?, B).

procedure in_class(RoleSpecs?, Binding?, Deltas?, Deltas?, Peers?, Mates?, YesNo).
in_class(Rs, B, Ps, Ps1, Q, Ms, R?) :- deltas_eq(Ps?, Ps1?, E), in_class1(E?, Rs?, B?, Q?, Ms?, R).

procedure in_class1(YesNo?, RoleSpecs?, Binding?, Peers?, Mates?, YesNo).
in_class1(no, _, _, _, _, no).
in_class1(yes, Rs, B, Q, Ms, R?) :- reflexive_preds(Rf), linked_any(Ms?, Rs?, B?, Q?, Rf?, R).

procedure linked_any(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any([], _, _, _, _, no).
linked_any([mate(N, B2, _, _) | Ms], Rs, B, Q, Rf, L?) :- ground(Rs?), ground(B?), ground(B2?), ground(Q?), ground(Rf?) | bound_spec(N?, B2?, Rs2), linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L1), linked_any1(L1?, Ms?, Rs?, B?, Q?, Rf?, L).

procedure linked_any1(YesNo?, Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any1(yes, _, _, _, _, _, yes).
linked_any1(no, Ms, Rs, B, Q, Rf, L?) :- linked_any(Ms?, Rs?, B?, Q?, Rf?, L).

procedure class_mates(Constant?, Binding?, Mates?, Peers?, Preds?, Mates).
class_mates(Nm, B, Ms, Q, Rf, Cls?) :- ground(Nm?), ground(B?), ground(Ms?) | bound_spec(Nm?, B?, Rs), mate_of(yes, B?, Nm?, Rs?, M0), grow(M0?, Ms?, Q?, Rf?, [], In), keep_mates(Ms?, In?, Cls).

procedure grow(Mates?, Mates?, Peers?, Preds?, Mates?, Mates).
grow([], _, _, _, Done, Done?).
grow([mate(N, B, G, F) | Fs], Rest, Q, Rf, Done, Out?) :- ground(N?), ground(B?), ground(Rest?), ground(Q?), ground(Rf?) | bound_spec(N?, B?, Rs), split_linked(Rest?, Rs?, B?, Q?, Rf?, New, Keep), app(Fs?, New?, Fs1), grow(Fs1?, Keep?, Q?, Rf?, [mate(N?, B?, G?, F?) | Done?], Out).

procedure split_linked(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, Mates, Mates).
split_linked([], _, _, _, _, [], []).
split_linked([mate(N2, B2, G2, F2) | Ms], Rs, B, Q, Rf, New?, Keep?) :- ground(N2?), ground(B2?), ground(Rs?), ground(B?), ground(Q?), ground(Rf?) | bound_spec(N2?, B2?, Rs2), linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L), split_linked(Ms?, Rs?, B?, Q?, Rf?, New1, Keep1), split_one(L?, mate(N2?, B2?, G2?, F2?), New1?, Keep1?, New, Keep).

procedure split_one(YesNo?, Mate?, Mates?, Mates?, Mates, Mates).
split_one(yes, M, New, Keep, [M? | New?], Keep?).
split_one(no, M, New, Keep, New?, [M? | Keep?]).

procedure keep_mates(Mates?, Mates?, Mates).
keep_mates([], _, []).
keep_mates([M | Ms], In, R?) :- ground(M?), ground(In?) | mem(M?, In?, B), keep_mates(Ms?, In?, R1), keep_mate(B?, M?, R1?, R).

procedure keep_mate(YesNo?, Mate?, Mates?, Mates).
keep_mate(yes, M, R, [M? | R?]).
keep_mate(no, _, R, R?).

procedure live_mates(Mates?, Peers?, Preds?, Mates).
live_mates([], _, _, []).
live_mates([mate(N, B, G, F) | Ms], Q, Rf, R?) :- ground(N?), ground(B?), ground(Q?), ground(Rf?) | bound_spec(N?, B?, Rs), live_at(Q?, Rs?, B?, Rf?, L0), con_live(N?, B?, Lc), and(L0?, Lc?, L), live_mates(Ms?, Q?, Rf?, R1), keep_mate(L?, mate(N?, B?, G?, F?), R1?, R).

procedure live_at(Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at([], _, _, _, yes).
live_at([P | Ps], Rs, B, Rf, Ok?) :- ground(P?), ground(Rs?), ground(B?), ground(Rf?) | reqs_at(Rs?, B?, P?, Rf?, R), forbs_at(Rs?, B?, P?, F), live_one(R?, F?, P?, Rf?, Ok1), live_at1(Ok1?, Ps?, Rs?, B?, Rf?, Ok).

procedure live_at1(YesNo?, Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at1(no, _, _, _, _, no).
live_at1(yes, Ps, Rs, B, Rf, Ok?) :- live_at(Ps?, Rs?, B?, Rf?, Ok).

procedure live_one(CAtoms?, CAtoms?, Peer?, Preds?, YesNo).
live_one(R, F, P, Rf, Ok?) :- ground(F?) | ms_meets(R?, F?, M1), own_reflexive_in(F?, P?, Rf?, M2), or(M1?, M2?, M), neg(M?, Ok).

procedure linked(Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked([], _, _, _, _, _, yes).
linked([P | Ps], Rs1, B1, Rs2, B2, Rf, L?) :- ground(P?), ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?) | reqs_at(Rs1?, B1?, P?, Rf?, R1), reqs_at(Rs2?, B2?, P?, Rf?, R2), forbs_at(Rs1?, B1?, P?, F1), forbs_at(Rs2?, B2?, P?, F2), bound_cs(R1?, Rb1), bound_cs(R2?, Rb2), ms_meets(Rb1?, F2?, C1), ms_meets(Rb2?, F1?, C2), or(C1?, C2?, C), linked1(C?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

procedure linked1(YesNo?, Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked1(yes, _, _, _, _, _, _, no).
linked1(no, Ps, Rs1, B1, Rs2, B2, Rf, L?) :- linked(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

procedure reqs_at(RoleSpecs?, Binding?, Peer?, Preds?, CAtoms).
reqs_at(Rs, B, P, Rf, R?) :- ground(B?), ground(P?) | specs_at(Rs?, 1, B?, P?, RsP), reqs_of(RsP?, Q), cimg_atoms(Q?, B?, R0), drop_own_reflexive(R0?, P?, Rf?, R).

procedure forbs_at(RoleSpecs?, Binding?, Peer?, CAtoms).
forbs_at(Rs, B, P, F?) :- ground(B?) | specs_at(Rs?, 1, B?, P?, RsP), forbs_of(RsP?, Fs), cimg_atoms(Fs?, B?, F).

procedure forbs_of(RoleSpecs?, SAtoms).
forbs_of([], []).
forbs_of([R | Rs], F?) :- rs_forb(R?, F1), forbs_of(Rs?, F2), app(F1?, F2?, F).

procedure drop_own_reflexive(CAtoms?, Peer?, Preds?, CAtoms).
drop_own_reflexive([], _, _, []).
drop_own_reflexive([A | As], P, Rf, R?) :- ground(A?), ground(P?), ground(Rf?) | own_atom(A?, P?, Rf?, Own), drop_own_reflexive(As?, P?, Rf?, R1), keep_c(Own?, A?, R1?, R).

procedure own_reflexive_in(CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in([], _, _, no).
own_reflexive_in([A | As], P, Rf, B?) :- ground(P?), ground(Rf?) | own_atom(A?, P?, Rf?, B1), own_reflexive_in1(B1?, As?, P?, Rf?, B).

procedure own_reflexive_in1(YesNo?, CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in1(yes, _, _, _, yes).
own_reflexive_in1(no, As, P, Rf, B?) :- own_reflexive_in(As?, P?, Rf?, B).

procedure own_atom(CAtom?, Peer?, Preds?, YesNo).
own_atom(cmp_atom(N, [cmp_val(p(Q))]), P, Rf, B?) :- (Q? =?= P?) | mem(N?, Rf?, B).
own_atom(_, _, _, no) :- otherwise | true.

procedure bound_cs(CAtoms?, CAtoms).
bound_cs([], []).
bound_cs([A | As], R?) :- ground(A?) | has_free(A?, Fr), bound_cs(As?, R1), keep_c(Fr?, A?, R1?, R).

procedure has_free(CAtom?, YesNo).
has_free(cmp_atom(_, Xs), B?) :- has_free1(Xs?, B).

procedure has_free1(CVals?, YesNo).
has_free1([], no).
has_free1([cmp_free(_) | _], yes).
has_free1([cmp_val(_) | Xs], B?) :- has_free1(Xs?, B).

procedure keep_c(YesNo?, CAtom?, CAtoms?, CAtoms).
keep_c(no, A, R, [A? | R?]).
keep_c(yes, _, R, R?).

procedure cimg_atoms(SAtoms?, Binding?, CAtoms).
cimg_atoms([], _, []).
cimg_atoms([A | As], B, Cs?) :- ground(B?) | cimg_one(A?, B?, C1), cimg_atoms(As?, B?, C2), app(C1?, C2?, Cs).

procedure cimg_one(SAtom?, Binding?, CAtoms).
cimg_one(atom(P, Vs), B, [cmp_atom(P?, Xs?)]) :- cimg_args(Vs?, B?, Xs).
cimg_one(times(V, A), B, Cs?) :- ground(B?) | num_of(V?, B?, K), cimg_one(A?, B?, C1), copies(K?, C1?, Cs).
cimg_one(opt(A), B, Cs?) :- cimg_one(A?, B?, Cs).
cimg_one(rest(V, J, A), B, Cs?) :- ground(B?) | num_of(V?, B?, K), num_of(J?, B?, I), less_by(K?, I?, K1), cimg_one(A?, B?, C1), copies(K1?, C1?, Cs).

procedure cimg_args(Vars?, Binding?, CVals).
cimg_args([], _, []).
cimg_args([sgn(Y, I) | Vs], B, [X? | Xs?]) :- ground(B?), ground(Y?), ground(I?) | lookup(svar(Y?), B?, F), role_person(I?, B?, P), cimg_sgn(F?, P?, sgn(Y?, I?), X), cimg_args(Vs?, B?, Xs).
cimg_args([num(X) | Vs], B, [cmp_val(n(N?)) | Xs?]) :- integer(X?) | N := X?, cimg_args(Vs?, B?, Xs).
cimg_args([item_of(V) | Vs], B, [X? | Xs?]) :- ground(B?), ground(V?) | lookup(V?, B?, F), item_found(F?, F1), cimg_item(F1?, item_of(V?), X), cimg_args(Vs?, B?, Xs).
cimg_args([nterm(N) | Vs], B, [X? | Xs?]) :- ground(B?), ground(N?) | nt_vars(N?, Ws), vars_bound(Ws?, B?, Bd), cimg_name(Bd?, N?, B?, X), cimg_args(Vs?, B?, Xs).
cimg_args([V | Vs], B, [X? | Xs?]) :- otherwise, ground(B?), ground(V?) | lookup(V?, B?, F), cimg_val(F?, V?, X), cimg_args(Vs?, B?, Xs).

procedure cimg_val(Found?, Var?, CVal).
cimg_val(found(X), _, cmp_val(X?)).
cimg_val(free, V, cmp_free(V?)).

procedure cimg_name(YesNo?, NTerm?, Binding?, CVal).
cimg_name(yes, N, B, cmp_val(c(C?))) :- nt_img(N?, B?, C).
cimg_name(no, N, _, cmp_free(nterm(N?))).

procedure cimg_sgn(Found?, Peer?, Var?, CVal).
cimg_sgn(found(s(S)), P, _, cmp_val(s(speech(S?, P?)))).
cimg_sgn(_, _, V, cmp_free(V?)) :- otherwise | true.

procedure cimg_item(Found?, Var?, CVal).
cimg_item(found(i(U)), _, cmp_val(i(U?))).
cimg_item(_, V, cmp_free(V?)) :- otherwise | true.

procedure bound_spec(Constant?, Binding?, RoleSpecs).
bound_spec(Nm, B, Rs?) :- schema_entry(Nm?, E), bound_spec1(E?, B?, Rs).

procedure bound_spec1(Schema?, Binding?, RoleSpecs).
bound_spec1(schema(_, _, Rs), _, Rs?).
bound_spec1(lschema(_, _, Rs, Lsts), B, Rs1?) :- ground(Rs?), ground(B?), ground(Lsts?) | lists_of(Lsts?, B?, Ls), spec_for(Rs?, Lsts?, Ls?, Rs1).

procedure lists_of(Listings?, Binding?, LLists).
lists_of([], _, []).
lists_of([listing(I, _, _, _, _, _, _) | Lsts], B, [ppl(L?) | Ls?]) :- ground(B?) | copies_of(B?, I?, L), lists_of(Lsts?, B?, Ls).
lists_of([instances(K, _, Xs, _, _, _, _) | Lsts], B, [ins(L?) | Ls?]) :- ground(B?) | insts_of(B?, K?, Xs?, L), lists_of(Lsts?, B?, Ls).

procedure spec_for(RoleSpecs?, Listings?, LLists?, RoleSpecs).
spec_for(Rs, Lsts, Ls, Rs1?) :- ground(Rs?), ground(Lsts?), ground(Ls?) | rs_len(Rs?, K), K1 := (K? + 1), blank_listed(Lsts?, Rs?, Rs0), listed_copies(Lsts?, Ls?, Rs?, K1?, Cs), cond_specs(Lsts?, Ls?, K1?, Rs0?, Rs0c), app(Rs0c?, Cs?, Rs1).

procedure cond_specs(Listings?, LLists?, Integer?, RoleSpecs?, RoleSpecs).
cond_specs([], _, _, Rs, Rs?).
cond_specs([_ | _], [], _, Rs, Rs?).
cond_specs([listing(I, _, _, _, _, CA, CD) | Lsts], [ppl(L) | Ls], J, Rs, Rs2?) :- ground(L?), integer(I?), integer(J?), ground(CA?), ground(CD?) | cond_people(L?, I?, J?, CA?, CD?, Rs?, Rs1, J1), cond_specs(Lsts?, Ls?, J1?, Rs1?, Rs2).
cond_specs([instances(K, _, Xs, _, _, CA, CD) | Lsts], [ins(L) | Ls], J, Rs, Rs2?) :- ground(L?), integer(K?), ground(Xs?), ground(CA?), ground(CD?) | cond_insts(L?, K?, Xs?, 1, CA?, CD?, Rs?, Rs1), cond_specs(Lsts?, Ls?, J?, Rs1?, Rs2).

procedure cond_insts(Insts?, Integer?, Vars?, Integer?, HMults?, HMults?, RoleSpecs?, RoleSpecs).
cond_insts([], _, _, _, _, _, Rs, Rs?).
cond_insts([_ | Ps], K, Xs, J, CA, CD, Rs, Rs3?) :- integer(K?), ground(Xs?), integer(J?), ground(CA?), ground(CD?) | inst_add(CA?, K?, J?, Xs?, add, Rs?, Rs1), inst_add(CD?, K?, J?, Xs?, del, Rs1?, Rs2), J1 := (J? + 1), cond_insts(Ps?, K?, Xs?, J1?, CA?, CD?, Rs2?, Rs3).

procedure inst_add(HMults?, Integer?, Integer?, Vars?, Constant?, RoleSpecs?, RoleSpecs).
inst_add([], _, _, _, _, Rs, Rs?).
inst_add([hm(R, M) | Hs], K, J, Xs, W, Rs, Rs2?) :- integer(K?), integer(J?), ground(Xs?), ground(W?) | ren_atom(M?, K?, J?, Xs?, M1), add_to_role(Rs?, R?, 1, W?, M1?, Rs1), inst_add(Hs?, K?, J?, Xs?, W?, Rs1?, Rs2).

procedure ren_atom(SAtom?, Integer?, Integer?, Vars?, SAtom).
ren_atom(atom(P, Vs), K, J, Xs, atom(P?, Vs1?)) :- ren_vars(Vs?, K?, J?, Xs?, Vs1).
ren_atom(times(N, M), K, J, Xs, times(N1?, M1?)) :- integer(K?), integer(J?), ground(Xs?) | ren_var(N?, K?, J?, Xs?, N1), ren_atom(M?, K?, J?, Xs?, M1).
ren_atom(rest(N, I, M), K, J, Xs, rest(N1?, I1?, M1?)) :- integer(K?), integer(J?), ground(Xs?) | ren_var(N?, K?, J?, Xs?, N1), ren_var(I?, K?, J?, Xs?, I1), ren_atom(M?, K?, J?, Xs?, M1).
ren_atom(opt(M), K, J, Xs, opt(M1?)) :- ren_atom(M?, K?, J?, Xs?, M1).

procedure ren_vars(Vars?, Integer?, Integer?, Vars?, Vars).
ren_vars([], _, _, _, []).
ren_vars([U | Us], K, J, Xs, [U1? | Us1?]) :- integer(K?), integer(J?), ground(Xs?) | ren_var(U?, K?, J?, Xs?, U1), ren_vars(Us?, K?, J?, Xs?, Us1).

procedure ren_var(Var?, Integer?, Integer?, Vars?, Var).
ren_var(nterm(N), K, J, Xs, nterm(N1?)) :- ren_nt(N?, K?, J?, Xs?, N1).
ren_var(U, K, J, Xs, V?) :- otherwise, ground(U?), integer(K?), integer(J?), ground(Xs?) | mem(U?, Xs?, In), ren_if(In?, U?, K?, J?, V).

procedure ren_if(YesNo?, Var?, Integer?, Integer?, Var).
ren_if(yes, U, K, J, inst(K?, J?, U?)).
ren_if(no, U, _, _, U?).

procedure ren_nt(NTerm?, Integer?, Integer?, Vars?, NTerm).
ren_nt(own_var(X), K, J, Xs, N?) :- ground(X?), integer(K?), integer(J?), ground(Xs?) | mem(pvar(X?), Xs?, In), ren_own(In?, X?, K?, J?, N).
ren_nt(ext(N, Y), K, J, Xs, N2?) :- ground(Y?), integer(K?), integer(J?), ground(Xs?) | ren_nt(N?, K?, J?, Xs?, N1), mem(svar(Y?), Xs?, In), ren_ext(In?, N1?, Y?, K?, J?, N2).
ren_nt(ext_any(N), K, J, Xs, ext_any(N1?)) :- ren_nt(N?, K?, J?, Xs?, N1).
ren_nt(ext_iv(N, V), K, J, Xs, ext_iv(N1?, V?)) :- ren_nt(N?, K?, J?, Xs?, N1).
ren_nt(N, _, _, _, N?) :- otherwise | true.

procedure ren_own(YesNo?, Constant?, Integer?, Integer?, NTerm).
ren_own(yes, X, K, J, own_iv(inst(K?, J?, pvar(X?)))).
ren_own(no, X, _, _, own_var(X?)).

procedure ren_ext(YesNo?, NTerm?, Constant?, Integer?, Integer?, NTerm).
ren_ext(yes, N, Y, K, J, ext_iv(N?, inst(K?, J?, svar(Y?)))).
ren_ext(no, N, Y, _, _, ext(N?, Y?)).

procedure cond_people(Peers?, Integer?, Integer?, HMults?, HMults?, RoleSpecs?, RoleSpecs, Integer).
cond_people([], _, J, _, _, Rs, Rs?, J?).
cond_people([_ | Ps], I, J, CA, CD, Rs, Rs3?, J2?) :- integer(I?), integer(J?), ground(CA?), ground(CD?) | cond_add(CA?, I?, J?, add, Rs?, Rs1), cond_add(CD?, I?, J?, del, Rs1?, Rs2), J1 := (J? + 1), cond_people(Ps?, I?, J1?, CA?, CD?, Rs2?, Rs3, J2).

procedure cond_add(HMults?, Integer?, Integer?, Constant?, RoleSpecs?, RoleSpecs).
cond_add([], _, _, _, Rs, Rs?).
cond_add([hm(R, M) | Hs], I, J, W, Rs, Rs2?) :- integer(I?), integer(J?), ground(W?) | renum_atom(M?, I?, J?, M1), add_to_role(Rs?, R?, 1, W?, M1?, Rs1), cond_add(Hs?, I?, J?, W?, Rs1?, Rs2).

procedure add_to_role(RoleSpecs?, Integer?, Integer?, Constant?, SAtom?, RoleSpecs).
add_to_role([], _, _, _, _, []).
add_to_role([rs(G, A, D, K, F) | Rs], R, I, add, M, [rs(G?, [M? | A?], D?, K?, F?) | Rs?]) :- (R? =:= I?) | true.
add_to_role([rs(G, A, D, K, F) | Rs], R, I, del, M, [rs(G?, A?, [opt(M?) | D?], K?, F?) | Rs?]) :- (R? =:= I?) | true.
add_to_role([X | Rs], R, I, W, M, [X? | Rs1?]) :- otherwise, integer(I?) | I1 := (I? + 1), add_to_role(Rs?, R?, I1?, W?, M?, Rs1).

procedure blank_listed(Listings?, RoleSpecs?, RoleSpecs).
blank_listed([], Rs, Rs?).
blank_listed([listing(I, _, _, _, _, _, _) | Lsts], Rs, Rs2?) :- blank_at(Rs?, I?, 1, Rs1), blank_listed(Lsts?, Rs1?, Rs2).
blank_listed([instances(_, _, _, _, _, _, _) | Lsts], Rs, Rs1?) :- blank_listed(Lsts?, Rs?, Rs1).

procedure listed_copies(Listings?, LLists?, RoleSpecs?, Integer?, RoleSpecs).
listed_copies([], _, _, _, []).
listed_copies([listing(I, _, _, _, _, _, _) | Lsts], [ppl(L) | Ls], Rs, J, Cs?) :- ground(Rs?), integer(I?) | nth_spec(Rs?, I?, R), spec_copies(L?, R?, I?, J?, C1, J1), listed_copies(Lsts?, Ls?, Rs?, J1?, C2), app(C1?, C2?, Cs).
listed_copies([instances(_, _, _, _, _, _, _) | Lsts], [_ | Ls], Rs, J, Cs?) :- listed_copies(Lsts?, Ls?, Rs?, J?, Cs).
listed_copies([_ | _], [], _, _, []).

procedure blank_at(RoleSpecs?, Integer?, Integer?, RoleSpecs).
blank_at([], _, _, []).
blank_at([R | Rs], I, J, [X? | Xs?]) :- integer(I?), integer(J?) | blank_one(I?, J?, R?, X), J1 := (J? + 1), blank_at(Rs?, I?, J1?, Xs).

procedure blank_one(Integer?, Integer?, RoleSpec?, RoleSpec).
blank_one(I, J, _, rs(unguarded, [], [], [], [])) :- (I? =:= J?) | true.
blank_one(_, _, R, R?) :- otherwise | true.

procedure spec_copies(Peers?, RoleSpec?, Integer?, Integer?, RoleSpecs, Integer).
spec_copies([], _, _, J, [], J?).
spec_copies([_ | Ps], R, I, J, [R1? | Rs?], J2?) :- ground(R?), integer(I?), integer(J?) | renum_spec(R?, I?, J?, R1), J1 := (J? + 1), spec_copies(Ps?, R?, I?, J1?, Rs, J2).

procedure renum_spec(RoleSpec?, Integer?, Integer?, RoleSpec).
renum_spec(rs(G, A, D, K, F), I, J, rs(G?, A1?, D1?, K1?, F1?)) :- integer(I?), integer(J?) | renum_atoms(A?, I?, J?, A1), renum_atoms(D?, I?, J?, D1), renum_atoms(K?, I?, J?, K1), renum_atoms(F?, I?, J?, F1).

procedure renum_atoms(SAtoms?, Integer?, Integer?, SAtoms).
renum_atoms([], _, _, []).
renum_atoms([M | Ms], I, J, [M1? | Ms1?]) :- integer(I?), integer(J?) | renum_atom(M?, I?, J?, M1), renum_atoms(Ms?, I?, J?, Ms1).

procedure renum_atom(SAtom?, Integer?, Integer?, SAtom).
renum_atom(atom(P, Vs), I, J, atom(P?, Vs1?)) :- renum_vars(Vs?, I?, J?, Vs1).
renum_atom(times(V, M), I, J, times(V1?, M1?)) :- integer(I?), integer(J?) | renum_var(V?, I?, J?, V1), renum_atom(M?, I?, J?, M1).
renum_atom(rest(V, W, M), I, J, rest(V1?, W1?, M1?)) :- integer(I?), integer(J?) | renum_var(V?, I?, J?, V1), renum_var(W?, I?, J?, W1), renum_atom(M?, I?, J?, M1).
renum_atom(opt(M), I, J, opt(M1?)) :- renum_atom(M?, I?, J?, M1).

procedure renum_vars(Vars?, Integer?, Integer?, Vars).
renum_vars([], _, _, []).
renum_vars([V | Vs], I, J, [V1? | Vs1?]) :- integer(I?), integer(J?) | renum_var(V?, I?, J?, V1), renum_vars(Vs?, I?, J?, Vs1).

procedure renum_var(Var?, Integer?, Integer?, Var).
renum_var(role(K), I, J, role(J?)) :- (K? =:= I?) | true.
renum_var(sgn(Y, K), I, J, sgn(Y?, J?)) :- (K? =:= I?) | true.
renum_var(nterm(N), I, J, nterm(N1?)) :- renum_nt(N?, I?, J?, N1).
renum_var(item_of(V), I, J, item_of(V1?)) :- renum_var(V?, I?, J?, V1).
renum_var(V, _, _, V?) :- otherwise | true.

procedure renum_nt(NTerm?, Integer?, Integer?, NTerm).
renum_nt(own(K), I, J, own(J?)) :- (K? =:= I?) | true.
renum_nt(ext(N, Y), I, J, ext(N1?, Y?)) :- renum_nt(N?, I?, J?, N1).
renum_nt(ext_any(N), I, J, ext_any(N1?)) :- renum_nt(N?, I?, J?, N1).
renum_nt(N, _, _, N?) :- otherwise | true.

procedure copies_of(Binding?, Integer?, List(Peer)).
copies_of(B, I, L?) :- ground(B?), integer(I?) | NI := (0 - I?), neg_people(B?, NI?, Ps0), sort_peers(Ps0?, Ps1), dedup(Ps1?, L).

procedure neg_people(Binding?, Integer?, Peers).
neg_people([], _, []).
neg_people([b(role(J), p(Q)) | Bs], NI, [Q? | Ps?]) :- (J? =:= NI?) | neg_people(Bs?, NI?, Ps).
neg_people([_ | Bs], NI, Ps?) :- otherwise | neg_people(Bs?, NI?, Ps).

procedure listed_binding(Constant?, Binding?, LLists?, Binding).
listed_binding(Nm, B0, Ls, B?) :- schema_entry(Nm?, E), listed_binding1(E?, B0?, Ls?, B).

procedure listed_binding1(Schema?, Binding?, LLists?, Binding).
listed_binding1(schema(_, _, _), B0, _, B0?).
listed_binding1(lschema(_, _, Rs, Lsts), B0, Ls, B?) :- ground(Rs?), ground(B0?), ground(Lsts?) | rs_len(Rs?, K), base_binds(Lsts?, B0?, Bb), sorted_lists(Ls?, Ls1), K1 := (K? + 1), tuple_binds(Lsts?, Ls1?, K1?, Cs), app(Bb?, Cs?, Bc), app(B0?, Bc?, B).

procedure base_binds(Listings?, Binding?, Binding).
base_binds([], _, []).
base_binds([listing(I, Bi, _, _, _, _, _) | Lsts], B0, [b(role(I?), p(P?)) | Bs?]) :- ground(B0?) | role_person(Bi?, B0?, P), base_binds(Lsts?, B0?, Bs).
base_binds([instances(_, _, _, _, _, _, _) | Lsts], B0, Bs?) :- base_binds(Lsts?, B0?, Bs).

procedure sorted_lists(LLists?, LLists).
sorted_lists([], []).
sorted_lists([ppl(L) | Ls], [ppl(L1?) | Ls1?]) :- sort_peers(L?, L0), dedup(L0?, L1), sorted_lists(Ls?, Ls1).
sorted_lists([ins(L) | Ls], [ins(L1?) | Ls1?]) :- sort_insts(L?, L0), dedup(L0?, L1), sorted_lists(Ls?, Ls1).

procedure sort_insts(Insts?, Insts).
sort_insts([], []).
sort_insts([I | Is], S?) :- sort_insts(Is?, S1), insert_inst(I?, S1?, S).

procedure insert_inst(Vals?, Insts?, Insts).
insert_inst(I, [], [I?]).
insert_inst(I, [J | Js], R?) :- ground(I?), ground(J?) | term_to_string(I?, Si), term_to_string(J?, Sj), insert_inst1(Si?, Sj?, I?, J?, Js?, R).

procedure insert_inst1(String?, String?, Vals?, Vals?, Insts?, Insts).
insert_inst1(Si, Sj, I, J, Js, [I?, J? | Js?]) :- '@<'(Si?, Sj?) | true.
insert_inst1(_, _, I, J, Js, [J? | R?]) :- otherwise | insert_inst(I?, Js?, R).

procedure tuple_binds(Listings?, LLists?, Integer?, Binding).
tuple_binds([], _, _, []).
tuple_binds([listing(I, _, _, _, _, _, _) | Lsts], [ppl(L) | Ls], J, Bs?) :- ground(L?), integer(I?) | copy_binds(L?, J?, Cs, J1), NI := (0 - I?), neg_binds(L?, NI?, Ns), tuple_binds(Lsts?, Ls?, J1?, Bs1), app(Ns?, Bs1?, Bs2), app(Cs?, Bs2?, Bs).
tuple_binds([instances(K, _, Xs, _, _, _, _) | Lsts], [ins(L) | Ls], J, Bs?) :- ground(L?), integer(K?), ground(Xs?) | inst_binds(L?, K?, Xs?, 1, Is), tuple_binds(Lsts?, Ls?, J?, Bs1), app(Is?, Bs1?, Bs).
tuple_binds([_ | _], [], _, []).

procedure copy_binds(Peers?, Integer?, Binding, Integer).
copy_binds([], J, [], J?).
copy_binds([Q | Qs], J, [b(role(J?), p(Q?)) | Bs?], J2?) :- integer(J?) | J1 := (J? + 1), copy_binds(Qs?, J1?, Bs, J2).

procedure neg_binds(Peers?, Integer?, Binding).
neg_binds([], _, []).
neg_binds([Q | Qs], NI, [b(role(NI?), p(Q?)) | Bs?]) :- integer(NI?) | neg_binds(Qs?, NI?, Bs).

procedure inst_list(Constant?, Binding?, Integer?, Insts).
inst_list(Nm, B, K, L?) :- schema_entry(Nm?, E), inst_list1(E?, B?, K?, L).

procedure inst_list1(Schema?, Binding?, Integer?, Insts).
inst_list1(schema(_, _, _), _, _, []).
inst_list1(lschema(_, _, _, Lsts), B, K, L?) :- ground(Lsts?), integer(K?) | inst_xs(Lsts?, K?, Xs), insts_of(B?, K?, Xs?, L).

procedure inst_xs(Listings?, Integer?, Vars).
inst_xs([], _, []).
inst_xs([instances(K1, _, Xs, _, _, _, _) | _], K, Xs?) :- (K1? =:= K?) | true.
inst_xs([_ | Ls], K, Xs?) :- otherwise | inst_xs(Ls?, K?, Xs).

procedure inst_binds(Insts?, Integer?, Vars?, Integer?, Binding).
inst_binds([], _, _, _, []).
inst_binds([I | Is], K, Xs, J, Bs?) :- integer(K?), ground(Xs?), integer(J?) | inst_entries(Xs?, I?, K?, J?, B1), J1 := (J? + 1), inst_binds(Is?, K?, Xs?, J1?, B2), app(B1?, B2?, Bs).

procedure inst_entries(Vars?, Vals?, Integer?, Integer?, Binding).
inst_entries([], _, _, _, []).
inst_entries([_ | _], [], _, _, []).
inst_entries([X | Xs], [V | Vs], K, J, [b(inst(K?, J?, X?), V?) | Bs?]) :- integer(K?), integer(J?) | inst_entries(Xs?, Vs?, K?, J?, Bs).

procedure insts_of(Binding?, Integer?, Vars?, Insts).
insts_of(B, K, Xs, L?) :- ground(B?), integer(K?), ground(Xs?) | inst_js(B?, K?, Js0), dedup(Js0?, Js), inst_vals_at(Js?, B?, K?, Xs?, L0), sort_insts(L0?, L1), dedup(L1?, L).

procedure inst_js(Binding?, Integer?, Ints).
inst_js([], _, []).
inst_js([b(inst(K1, J, _), _) | Bs], K, [J? | Js?]) :- (K1? =:= K?) | inst_js(Bs?, K?, Js).
inst_js([_ | Bs], K, Js?) :- otherwise | inst_js(Bs?, K?, Js).

procedure inst_vals_at(Ints?, Binding?, Integer?, Vars?, Insts).
inst_vals_at([], _, _, _, []).
inst_vals_at([J | Js], B, K, Xs, [I? | Is?]) :- ground(B?), integer(K?), ground(Xs?), integer(J?) | inst_lookup(Xs?, B?, K?, J?, I), inst_vals_at(Js?, B?, K?, Xs?, Is).

procedure inst_lookup(Vars?, Binding?, Integer?, Integer?, Vals).
inst_lookup([], _, _, _, []).
inst_lookup([X | Xs], B, K, J, [V? | Vs?]) :- ground(B?), integer(K?), integer(J?) | lookup(inst(K?, J?, X?), B?, F), img_val(F?, V), inst_lookup(Xs?, B?, K?, J?, Vs).

procedure listed_people(Constant?, Binding?, GAtoms?, LLists).
listed_people(Nm, B0, S, Ls?) :- schema_entry(Nm?, E), listed_people1(E?, B0?, S?, Ls).

procedure listed_people1(Schema?, Binding?, GAtoms?, LLists).
listed_people1(schema(_, _, _), _, _, []).
listed_people1(lschema(_, _, _, Lsts), B0, S, Ls?) :- lists_at(Lsts?, B0?, S?, Ls).

procedure lists_at(Listings?, Binding?, GAtoms?, LLists).
lists_at([], _, _, []).
lists_at([listing(I, _, Rho, As, Phi, _, _) | Lsts], B0, S, [ppl(L?) | Ls?]) :- ground(B0?), ground(S?) | list_at(I?, Rho?, As?, Phi?, B0?, S?, L), lists_at(Lsts?, B0?, S?, Ls).
lists_at([instances(_, _, Xs, A, Phi, _, _) | Lsts], B0, S, [ins(L?) | Ls?]) :- ground(B0?), ground(S?) | inst_at(Xs?, A?, Phi?, B0?, S?, L), lists_at(Lsts?, B0?, S?, Ls).

procedure inst_at(Vars?, SAtom?, Form?, Binding?, GAtoms?, Insts).
inst_at(Xs, A, Phi, B0, S, L?) :- ground(Xs?), ground(A?), ground(B0?), ground(S?) | match_into(A?, S?, B0?, Bs0), phi_binds(Bs0?, Phi?, S?, Bs), inst_vals(Bs?, Xs?, Is1), sort_insts(Is1?, Is2), dedup(Is2?, L).

procedure phi_binds(Bindings?, Form?, GAtoms?, Bindings).
phi_binds([], _, _, []).
phi_binds([B | Bs], Phi, S, R?) :- ground(B?), ground(Phi?), ground(S?) | form_holds(Phi?, B?, S?, H), phi_binds(Bs?, Phi?, S?, R1), keep_binding(H?, B?, R1?, R).

procedure inst_vals(Bindings?, Vars?, Insts).
inst_vals([], _, []).
inst_vals([B | Bs], Xs, Is?) :- ground(B?), ground(Xs?) | vals_of(Xs?, B?, Vs, All), inst_vals(Bs?, Xs?, Is1), keep_inst(All?, Vs?, Is1?, Is).

procedure vals_of(Vars?, Binding?, Vals, YesNo).
vals_of([], _, [], yes).
vals_of([X | Xs], B, Vs?, All?) :- ground(B?) | lookup(X?, B?, F), vals_of(Xs?, B?, Vs1, All1), found_val(F?, Vs1?, All1?, Vs, All).

procedure found_val(Found?, Vals?, YesNo?, Vals, YesNo).
found_val(found(V), Vs, A, [V? | Vs?], A?).
found_val(free, Vs, _, Vs?, no).

procedure keep_inst(YesNo?, Vals?, Insts?, Insts).
keep_inst(yes, V, Is, [V? | Is?]).
keep_inst(no, _, Is, Is?).

procedure inst_bind(Vars?, Vals?, Binding?, Binding).
inst_bind([], _, B0, B0?).
inst_bind([_ | _], [], B0, B0?).
inst_bind([X | Xs], [V | Vs], B0, [b(X?, V?) | B?]) :- inst_bind(Xs?, Vs?, B0?, B).

procedure list_at(Integer?, Constant?, Vars?, Form?, Binding?, GAtoms?, List(Peer)).
list_at(I, Rho, As, Phi, B0, S, L?) :- ground(As?), ground(B0?), ground(S?), integer(I?) | img_args(As?, B0?, Vs), arg_pos(As?, I?, 1, K), nth_out(Vs?, K?, _, Vr), listing_in(S?, Rho?, Vr?, K?, Ps0), phi_people(Ps0?, I?, Phi?, B0?, S?, Ps00), sort_peers(Ps00?, Ps1), dedup(Ps1?, L).

procedure phi_people(Peers?, Integer?, Form?, Binding?, GAtoms?, Peers).
phi_people([], _, _, _, _, []).
phi_people([Q | Qs], I, Phi, B0, S, R?) :- ground(Q?), integer(I?), ground(Phi?), ground(B0?), ground(S?) | form_holds(Phi?, [b(role(I?), p(Q?)) | B0?], S?, H), phi_people(Qs?, I?, Phi?, B0?, S?, R1), keep_peer(H?, Q?, R1?, R).

procedure arg_pos(Vars?, Integer?, Integer?, Integer).
arg_pos([], _, _, 0).
arg_pos([role(J) | _], I, K, K?) :- (J? =:= I?) | true.
arg_pos([_ | As], I, K, P?) :- otherwise, integer(K?) | K1 := (K? + 1), arg_pos(As?, I?, K1?, P).

procedure nth_out(Vals?, Integer?, Val, Vals).
nth_out([], _, any, []).
nth_out([X | Xs], K, X?, Xs?) :- (K? =:= 1) | true.
nth_out([X | Xs], K, Y?, [X? | Ys?]) :- (K? > 1) | K1 := (K? - 1), nth_out(Xs?, K1?, Y, Ys).
nth_out([X | Xs], K, any, [X? | Xs?]) :- (K? < 1) | true.

procedure listing_in(GAtoms?, Constant?, Vals?, Integer?, Peers).
listing_in([], _, _, _, []).
listing_in([g(F, Xs) | Gs], Rho, Vr, K, Ps?) :- ground(F?), ground(Xs?), ground(Rho?), ground(Vr?), integer(K?) | same(F?, Rho?, E1), nth_out(Xs?, K?, X, Xr), same(Xr?, Vr?, E2), and(E1?, E2?, E), listing_in(Gs?, Rho?, Vr?, K?, Ps1), keep_listed(E?, X?, Ps1?, Ps).

procedure keep_listed(YesNo?, Val?, Peers?, Peers).
keep_listed(yes, p(Q), Ps, [Q? | Ps?]).
keep_listed(_, _, Ps, Ps?) :- otherwise | true.

procedure listed_class(Constant?, Binding?, GAtoms?, Class).
listed_class(Nm, B0, S, C?) :- ground(Nm?), ground(B0?) | listed_people(Nm?, B0?, S?, Ls), listed_binding(Nm?, B0?, Ls?, B), role_person(1, B0?, D), class_of(Nm?, B?, D?, C).

procedure listing_ok(Constant?, Binding?, Peer?, GAtoms?, YesNo).
listing_ok(Nm, B, Id, S, Ok?) :- schema_entry(Nm?, E), listing_ok1(E?, B?, Id?, S?, Ok).

procedure listing_ok1(Schema?, Binding?, Peer?, GAtoms?, YesNo).
listing_ok1(schema(_, _, _), _, _, _, yes).
listing_ok1(lschema(_, _, _, Lsts), B, Id, S, Ok?) :- listings_ok(Lsts?, B?, Id?, S?, Ok).

procedure listings_ok(Listings?, Binding?, Peer?, GAtoms?, YesNo).
listings_ok([], _, _, _, yes).
listings_ok([listing(I, Bi, Rho, As, Phi, _, _) | Lsts], B, Id, S, Ok?) :- ground(B?), ground(Id?), ground(S?) | role_person(Bi?, B?, P), same(P?, Id?, Base), listing_one(Base?, I?, Rho?, As?, Phi?, B?, S?, Ok1), listings_ok1(Ok1?, Lsts?, B?, Id?, S?, Ok).
listings_ok([instances(K, Bi, Xs, A, Phi, _, _) | Lsts], B, Id, S, Ok?) :- ground(B?), ground(Id?), ground(S?) | role_person(Bi?, B?, P), same(P?, Id?, Base), inst_one(Base?, K?, Xs?, A?, Phi?, B?, S?, Ok1), listings_ok1(Ok1?, Lsts?, B?, Id?, S?, Ok).

procedure inst_one(YesNo?, Integer?, Vars?, SAtom?, Form?, Binding?, GAtoms?, YesNo).
inst_one(no, _, _, _, _, _, _, yes).
inst_one(yes, K, Xs, A, Phi, B, S, Ok?) :- ground(B?), integer(K?), ground(Xs?) | insts_of(B?, K?, Xs?, L), inst_at(Xs?, A?, Phi?, B?, S?, L1), same(L?, L1?, Ok).

procedure listing_one(YesNo?, Integer?, Constant?, Vars?, Form?, Binding?, GAtoms?, YesNo).
listing_one(no, _, _, _, _, _, _, yes).
listing_one(yes, I, Rho, As, Phi, B, S, Ok?) :- ground(B?), integer(I?) | copies_of(B?, I?, L), list_at(I?, Rho?, As?, Phi?, B?, S?, L1), same(L?, L1?, Ok).

procedure listings_ok1(YesNo?, Listings?, Binding?, Peer?, GAtoms?, YesNo).
listings_ok1(no, _, _, _, _, no).
listings_ok1(yes, Lsts, B, Id, S, Ok?) :- listings_ok(Lsts?, B?, Id?, S?, Ok).

procedure rule_spec_ok(Constant?, Binding?, YesNo).
rule_spec_ok(Nm, B, Ok?) :- schema_entry(Nm?, E), rule_spec(E?, Rs0), rule_ok(Rs0?, B?, Ok).

procedure rule_spec(Schema?, RoleSpecs).
rule_spec(schema(_, _, Rs), Rs?).
rule_spec(lschema(_, _, Rs, Lsts), Rs0?) :- blank_listed(Lsts?, Rs?, Rs0).

procedure term_spec(Class?, Constant, RoleSpecs, Binding).
term_spec(C, Nm?, Rs?, B?) :- ground(C?) | binding_of(C?, Nm0, B0), term_spec1(Nm0?, B0?, Nm, Rs, B).

procedure term_spec1(Constant?, Binding?, Constant, RoleSpecs, Binding).
term_spec1(Nm0, B0, Nm0?, Rs?, B0?) :- ground(Nm0?), ground(B0?) | bound_spec(Nm0?, B0?, Rs).

procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R | _], I, R?) :- (I? =:= 1) | true.
nth_spec([_ | Rs], I, R?) :- (I? > 1) | I1 := (I? - 1), nth_spec(Rs?, I1?, R).

procedure rs_len(RoleSpecs?, Integer).
rs_len([], 0).
rs_len([_ | Rs], N?) :- rs_len(Rs?, M), N := (M? + 1).

procedure rs_add(RoleSpec?, SAtoms).
rs_add(rs(_, A, _, _, _), A?).

procedure rs_del(RoleSpec?, SAtoms).
rs_del(rs(_, _, D, _, _), D?).

procedure rs_req(RoleSpec?, SAtoms).
rs_req(rs(_, _, D, K, _), R?) :- uncleared(D?, D1), app(K?, D1?, R).

procedure uncleared(SAtoms?, SAtoms).
uncleared([], []).
uncleared([A | As], R?) :- ground(A?) | s_cleared(A?, C), uncleared(As?, R1), keep_s(C?, A?, R1?, R).

procedure keep_s(YesNo?, SAtom?, SAtoms?, SAtoms).
keep_s(yes, _, R, R?).
keep_s(no, A, R, [A? | R?]).

procedure s_cleared(SAtom?, YesNo).
s_cleared(atom(_, Vs), C?) :- vars_wild(Vs?, C).
s_cleared(times(_, A), C?) :- s_cleared(A?, C).
s_cleared(rest(_, _, A), C?) :- s_cleared(A?, C).
s_cleared(opt(_), yes).

procedure vars_wild(Vars?, YesNo).
vars_wild([], no).
vars_wild([any | _], yes).
vars_wild([nterm(N) | Vs], C?) :- snt_wild(N?, C1), vars_wild1(C1?, Vs?, C).
vars_wild([V | Vs], C?) :- otherwise, ground(V?) | vars_wild(Vs?, C).

procedure vars_wild1(YesNo?, Vars?, YesNo).
vars_wild1(yes, _, yes).
vars_wild1(no, Vs, C?) :- vars_wild(Vs?, C).

procedure snt_wild(NTerm?, YesNo).
snt_wild(own(_), no).
snt_wild(own_var(_), no).
snt_wild(own_iv(_), no).
snt_wild(ext_iv(N, _), C?) :- snt_wild(N?, C).
snt_wild(ext(N, _), C?) :- snt_wild(N?, C).
snt_wild(ext_any(_), yes).

procedure rs_forb(RoleSpec?, SAtoms).
rs_forb(rs(_, _, _, _, F), F?).

procedure role_person(Integer?, Binding?, Peer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), found_peer(F?, P).

procedure found_peer(Found?, Peer).
found_peer(found(p(P)), P?).
found_peer(found(s(_)), unbound).
found_peer(found(c(_)), unbound).
found_peer(found(n(_)), unbound).
found_peer(found(r(_)), unbound).
found_peer(found(i(_)), unbound).
found_peer(found(lv(_, _)), unbound).
found_peer(free, unbound).
found_peer(found(any), unbound).

procedure lookup(Var?, Binding?, Found).
lookup(_, [], free).
lookup(V, [b(W, X) | _], found(X?)) :- (V? =?= W?) | true.
lookup(V, [_ | Bs], F?) :- otherwise | lookup(V?, Bs?, F).

procedure img_atoms(SAtoms?, Binding?, GAtoms).
img_atoms([], _, []).
img_atoms([A | As], B, Gs?) :- ground(B?) | img_one(A?, B?, G1), img_atoms(As?, B?, G2), app(G1?, G2?, Gs).

procedure img_one(SAtom?, Binding?, GAtoms).
img_one(atom(P, Vs), B, [g(P?, Xs?)]) :- img_args(Vs?, B?, Xs).
img_one(times(V, A), B, Gs?) :- ground(B?) | num_of(V?, B?, K), img_one(A?, B?, G1), copies(K?, G1?, Gs).
img_one(opt(A), B, Gs?) :- img_one(A?, B?, Gs).
img_one(rest(V, J, A), B, Gs?) :- ground(B?) | num_of(V?, B?, K), num_of(J?, B?, I), less_by(K?, I?, K1), img_one(A?, B?, G1), copies(K1?, G1?, Gs).

procedure less_by(NumRes?, NumRes?, NumRes).
less_by(num_is(K), num_is(J), num_is(N?)) :- N := (K? - J?).
less_by(no_num, _, no_num).
less_by(num_is(_), no_num, no_num).

procedure(X) copies(NumRes?, Stream(X)?, Stream(X)).
copies(num_is(K), G, Gs?) :- (K? > 0), ground(G?) | K1 := (K? - 1), copies(num_is(K1?), G?, Gs1), app(G?, Gs1?, Gs).
copies(num_is(K), _, []) :- (K? =< 0) | true.
copies(no_num, G, G?).

procedure img_atom(SAtom?, Binding?, GAtom).
img_atom(atom(P, Vs), B, g(P?, Xs?)) :- img_args(Vs?, B?, Xs).
img_atom(times(_, A), B, G?) :- img_atom(A?, B?, G).
img_atom(rest(_, _, A), B, G?) :- img_atom(A?, B?, G).
img_atom(opt(A), B, G?) :- img_atom(A?, B?, G).

procedure img_args(Vars?, Binding?, Vals).
img_args([], _, []).
img_args([sgn(Y, I) | Vs], B, [X? | Xs?]) :- ground(B?), ground(Y?), ground(I?) | lookup(svar(Y?), B?, F), role_person(I?, B?, P), img_sgn(F?, P?, X), img_args(Vs?, B?, Xs).
img_args([nterm(N) | Vs], B, [c(C?) | Xs?]) :- ground(B?), ground(N?) | nt_img(N?, B?, C), img_args(Vs?, B?, Xs).
img_args([num(X) | Vs], B, [n(N?) | Xs?]) :- integer(X?) | N := X?, img_args(Vs?, B?, Xs).
img_args([item_of(V) | Vs], B, [X? | Xs?]) :- ground(B?), ground(V?) | lookup(V?, B?, F), item_found(F?, F1), img_val(F1?, X), img_args(Vs?, B?, Xs).
img_args([any | Vs], B, [any | Xs?]) :- img_args(Vs?, B?, Xs).
img_args([V | Vs], B, [X? | Xs?]) :- otherwise, ground(B?) | lookup(V?, B?, F), img_val(F?, X), img_args(Vs?, B?, Xs).

procedure nt_img(NTerm?, Binding?, CName).
nt_img(own(I), B, community(P?)) :- role_person(I?, B?, P).
nt_img(own_var(X), B, community(P?)) :- val_peer(pvar(X?), B?, unbound, P).
nt_img(own_iv(V), B, community(P?)) :- val_peer(V?, B?, unbound, P).
nt_img(ext_iv(N, V), B, dot(C?, S?)) :- ground(B?) | nt_img(N?, B?, C), val_speech(V?, B?, unbound, S).
nt_img(ext_any(N), B, dot_any(C?)) :- nt_img(N?, B?, C).
nt_img(ext(N, Y), B, dot(C?, S?)) :- ground(B?) | nt_img(N?, B?, C), val_speech(svar(Y?), B?, unbound, S).

procedure nt_vars(NTerm?, Vars).
nt_vars(own(I), [role(I?)]).
nt_vars(own_var(X), [pvar(X?)]).
nt_vars(own_iv(V), [V?]).
nt_vars(ext_iv(N, V), Vs?) :- nt_vars(N?, Vs0), app(Vs0?, [V?], Vs).
nt_vars(ext(N, Y), Vs?) :- nt_vars(N?, Vs0), app(Vs0?, [svar(Y?)], Vs).
nt_vars(ext_any(N), Vs?) :- nt_vars(N?, Vs).

procedure flat_names(Vars?, Vars).
flat_names([], []).
flat_names([nterm(N) | Vs], R?) :- nt_vars(N?, Ws), flat_names(Vs?, R1), app(Ws?, R1?, R).
flat_names([V | Vs], [V? | R?]) :- otherwise | flat_names(Vs?, R).

procedure img_val(Found?, Val).
img_val(found(X), X?).
img_val(free, p(unbound)).

procedure img_sgn(Found?, Peer?, Val).
img_sgn(found(s(S)), P, s(speech(S?, P?))).
img_sgn(_, _, p(unbound)) :- otherwise | true.

procedure atom_bound(SAtom?, Binding?, YesNo).
atom_bound(atom(_, Vs), B, R?) :- vars_bound(Vs?, B?, R).
atom_bound(times(_, A), B, R?) :- atom_bound(A?, B?, R).
atom_bound(rest(_, _, A), B, R?) :- atom_bound(A?, B?, R).
atom_bound(opt(A), B, R?) :- atom_bound(A?, B?, R).

procedure vars_bound(Vars?, Binding?, YesNo).
vars_bound([], _, yes).
vars_bound([num(X) | Vs], B, R?) :- number(X?) | vars_bound(Vs?, B?, R).
vars_bound([item_of(V) | Vs], B, R?) :- vars_bound([V? | Vs?], B?, R).
vars_bound([nterm(N) | Vs], B, R?) :- ground(N?) | nt_vars(N?, Ws), app(Ws?, Vs?, Vs1), vars_bound(Vs1?, B?, R).
vars_bound([V | Vs], B, R?) :- otherwise, ground(B?) | lookup(V?, B?, F), vars_bound1(F?, Vs?, B?, R).

procedure vars_bound1(Found?, Vars?, Binding?, YesNo).
vars_bound1(free, _, _, no).
vars_bound1(found(_), Vs, B, R?) :- vars_bound(Vs?, B?, R).

procedure match_all(SAtoms?, GAtoms?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A | As], Gs, B, R?) :- ground(Gs?) | match_into(A?, Gs?, B?, Bs0), dedup(Bs0?, Bs), match_all_each(Bs?, As?, Gs?, R).

procedure match_all_each(Bindings?, SAtoms?, GAtoms?, Bindings).
match_all_each([], _, _, []).
match_all_each([B | Bs], As, Gs, R?) :- ground(As?), ground(Gs?) | match_all(As?, Gs?, B?, R1), match_all_each(Bs?, As?, Gs?, R2), app(R1?, R2?, R).

procedure match_into(SAtom?, GAtoms?, Binding?, Bindings).
match_into(times(V, A), Gs, B, R?) :- ground(V?), ground(A?), ground(Gs?), ground(B?) | match_into(A?, Gs?, B?, Bs), count_bind(Bs?, V?, A?, Gs?, R).
match_into(opt(A), Gs, B, R?) :- match_into(A?, Gs?, B?, R).
match_into(rest(V, _, A), Gs, B, R?) :- ground(V?), ground(A?), ground(Gs?), ground(B?) | match_into(A?, Gs?, B?, Bs), count_bind(Bs?, V?, A?, Gs?, R).
match_into(_, [], _, []).
match_into(A, [G | Gs], B, R?) :- ground(A?), ground(B?) | match_atom(A?, G?, B?, M), match_into1(M?, A?, Gs?, B?, R).

procedure match_into1(Match?, SAtom?, GAtoms?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1? | R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).

procedure match_atom(SAtom?, GAtom?, Binding?, Match).
match_atom(atom(P, Vs), g(Q, Xs), B, R?) :- (P? =?= Q?) | match_args(Vs?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.

procedure match_args(Vars?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_ | _], _, nomatch).
match_args([_ | _], [], _, nomatch).
match_args([sgn(Y, I) | Vs], [X | Xs], B, R?) :- ground(Y?), ground(I?), ground(X?), ground(B?) | sgn_parts(X?, Ps), match_sgn(Ps?, Y?, I?, Vs?, Xs?, B?, R).
match_args([nterm(N) | Vs], [X | Xs], B, R?) :- ground(N?), ground(X?), ground(B?) | name_parts(N?, X?, Ps), match_name(Ps?, Vs?, Xs?, B?, R).
match_args([num(X) | Vs], [Y | Ys], B, R?) :- number(X?), ground(Y?), ground(B?) | lit_val(X?, Y?, E), lit_then(E?, Vs?, Ys?, B?, R).
match_args([item_of(V) | Vs], [X | Xs], B, R?) :- ground(V?), ground(X?), ground(B?) | lookup(V?, B?, F), item_found(F?, F1), item_then(F1?, X?, Vs?, Xs?, B?, R).
match_args([any | Vs], [X | Xs], B, R?) :- ground(X?), ground(B?) | any_val(X?, E), lit_then(E?, Vs?, Xs?, B?, R).
match_args([V | Vs], [X | Xs], B, R?) :- otherwise, ground(V?), ground(X?), ground(B?) | lookup(V?, B?, F), kind_ok(V?, X?, K), match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).

procedure lit_val(Number?, Val?, YesNo).
lit_val(X, n(K), yes) :- (X? =:= K?) | true.
lit_val(X, r(K), yes) :- (X? =:= K?) | true.
lit_val(_, _, no) :- otherwise | true.

procedure any_val(Val?, YesNo).
any_val(any, yes).
any_val(_, no) :- otherwise | true.

procedure item_then(Found?, Val?, Vars?, Vals?, Binding?, Match).
item_then(found(W), X, Vs, Xs, B, R?) :- (W? =?= X?) | match_args(Vs?, Xs?, B?, R).
item_then(_, _, _, _, _, nomatch) :- otherwise | true.

procedure lit_then(YesNo?, Vars?, Vals?, Binding?, Match).
lit_then(yes, Vs, Ys, B, R?) :- match_args(Vs?, Ys?, B?, R).
lit_then(no, _, _, _, nomatch).

procedure count_bind(Bindings?, Var?, SAtom?, GAtoms?, Bindings).
count_bind([], _, _, _, []).
count_bind([B | Bs], V, A, Gs, [B1? | R?]) :- ground(B?), ground(V?), ground(A?), ground(Gs?) | num_of(V?, B?, K), count_bind1(K?, V?, A?, Gs?, B?, B1), count_bind(Bs?, V?, A?, Gs?, R).

procedure count_bind1(NumRes?, Var?, SAtom?, GAtoms?, Binding?, Binding).
count_bind1(num_is(_), _, _, _, B, B?).
count_bind1(no_num, V, A, Gs, B, [b(V?, n(N?)) | B?]) :- ground(B?), ground(V?) | img_atom(A?, B?, G), count_g(G?, Gs?, N).

procedure count_g(GAtom?, GAtoms?, Integer).
count_g(_, [], 0).
count_g(G, [H | Hs], N?) :- (G? =?= H?) | count_g(G?, Hs?, M), N := (M? + 1).
count_g(G, [_ | Hs], N?) :- otherwise | count_g(G?, Hs?, N).

procedure name_parts(NTerm?, Val?, NameParts).
name_parts(N, c(C), Ps?) :- nt_parts(N?, C?, Ps).
name_parts(_, p(_), noparts).
name_parts(_, s(_), noparts).
name_parts(_, n(_), noparts).
name_parts(_, r(_), noparts).
name_parts(_, i(_), noparts).
name_parts(_, lv(_, _), noparts).
name_parts(_, any, noparts).

procedure nt_parts(NTerm?, CName?, NameParts).
nt_parts(own(I), community(P), parts([role(I?)], [p(P?)])).
nt_parts(own_var(X), community(P), parts([pvar(X?)], [p(P?)])).
nt_parts(own_iv(V), community(P), parts([V?], [p(P?)])).
nt_parts(ext_iv(N, V), dot(C, S), Ps?) :- nt_parts(N?, C?, Ps0), nt_more_v(Ps0?, V?, S?, Ps).
nt_parts(ext(N, Y), dot(C, S), Ps?) :- nt_parts(N?, C?, Ps0), nt_more(Ps0?, Y?, S?, Ps).
nt_parts(ext_any(N), dot_any(C), Ps?) :- nt_parts(N?, C?, Ps).
nt_parts(_, _, noparts) :- otherwise | true.

procedure nt_more_v(NameParts?, Var?, Speech?, NameParts).
nt_more_v(parts(Vs, Xs), V, S, parts(Vs1?, Xs1?)) :- app(Vs?, [V?], Vs1), app(Xs?, [s(S?)], Xs1).
nt_more_v(noparts, _, _, noparts).

procedure nt_more(NameParts?, Constant?, Speech?, NameParts).
nt_more(parts(Vs, Xs), Y, S, parts(Vs1?, Xs1?)) :- app(Vs?, [svar(Y?)], Vs1), app(Xs?, [s(S?)], Xs1).
nt_more(noparts, _, _, noparts).

procedure match_name(NameParts?, Vars?, Vals?, Binding?, Match).
match_name(parts(Ws, Ys), Vs, Xs, B, R?) :- app(Ws?, Vs?, Vs1), app(Ys?, Xs?, Xs1), match_args(Vs1?, Xs1?, B?, R).
match_name(noparts, _, _, _, nomatch).

procedure sgn_parts(Val?, SgnParts).
sgn_parts(s(speech(speech(U, Q), P)), signed(s(speech(U?, Q?)), P?)).
sgn_parts(s(speech(utterance(_), _)), unsigned).
sgn_parts(s(speech(program(_), _)), unsigned).
sgn_parts(p(_), unsigned).
sgn_parts(c(_), unsigned).
sgn_parts(n(_), unsigned).
sgn_parts(r(_), unsigned).
sgn_parts(i(_), unsigned).
sgn_parts(lv(_, _), unsigned).
sgn_parts(any, unsigned).

procedure match_sgn(SgnParts?, Constant?, Integer?, Vars?, Vals?, Binding?, Match).
match_sgn(signed(S, P), Y, I, Vs, Xs, B, R?) :- match_args([svar(Y?), role(I?) | Vs?], [S?, p(P?) | Xs?], B?, R).
match_sgn(unsigned, _, _, _, _, _, nomatch).

procedure match_one(Found?, YesNo?, Var?, Val?, Vars?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- (W? =?= X?) | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(free, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [b(V?, X?) | B?], R).
match_one(free, no, _, _, _, _, _, nomatch).

procedure kind_ok(Var?, Val?, YesNo).
kind_ok(role(_), p(_), yes).
kind_ok(role(_), s(_), no).
kind_ok(pvar(_), p(_), yes).
kind_ok(pvar(_), s(_), no).
kind_ok(svar(_), p(_), no).
kind_ok(svar(_), s(_), yes).
kind_ok(sgn(_, _), p(_), no).
kind_ok(sgn(_, _), s(_), no).
kind_ok(sgn(_, _), c(_), no).
kind_ok(nterm(_), _, no).
kind_ok(role(_), c(_), no).
kind_ok(pvar(_), c(_), no).
kind_ok(svar(_), c(_), no).
kind_ok(num(_), n(_), yes).
kind_ok(num(_), r(_), yes).
kind_ok(num(_), lv(_, _), yes).
kind_ok(num(_), p(_), no).
kind_ok(num(_), s(_), no).
kind_ok(num(_), c(_), no).
kind_ok(role(_), n(_), no).
kind_ok(role(_), r(_), no).
kind_ok(role(_), lv(_, _), no).
kind_ok(pvar(_), n(_), no).
kind_ok(pvar(_), r(_), no).
kind_ok(pvar(_), lv(_, _), yes).
kind_ok(svar(_), n(_), no).
kind_ok(svar(_), r(_), no).
kind_ok(svar(_), lv(_, _), yes).
kind_ok(sgn(_, _), n(_), no).
kind_ok(sgn(_, _), r(_), no).
kind_ok(sgn(_, _), lv(_, _), no).
kind_ok(inst(_, _, X), V, K?) :- kind_ok(X?, V?, K).
kind_ok(item_of(_), _, no).
kind_ok(any, _, no).
kind_ok(V, any, no) :- ground(V?) | true.

procedure val_peer(Var?, Binding?, Peer?, Peer).
val_peer(V, B, D, P?) :- lookup(V?, B?, F), val_peer1(F?, D?, P).

procedure val_peer1(Found?, Peer?, Peer).
val_peer1(found(p(P)), _, P?).
val_peer1(found(s(_)), D, D?).
val_peer1(found(c(_)), D, D?).
val_peer1(found(n(_)), D, D?).
val_peer1(found(r(_)), D, D?).
val_peer1(found(i(_)), D, D?).
val_peer1(found(lv(_, _)), D, D?).
val_peer1(free, D, D?).
val_peer1(found(any), D, D?).

procedure val_speech(Var?, Binding?, Peer?, Speech).
val_speech(V, B, D, S?) :- lookup(V?, B?, F), val_speech1(F?, D?, S).

procedure val_speech1(Found?, Peer?, Speech).
val_speech1(found(s(S)), _, S?).
val_speech1(found(p(_)), D, speech(utterance(none), D?)).
val_speech1(found(c(_)), D, speech(utterance(none), D?)).
val_speech1(found(n(_)), D, speech(utterance(none), D?)).
val_speech1(found(r(_)), D, speech(utterance(none), D?)).
val_speech1(found(i(_)), D, speech(utterance(none), D?)).
val_speech1(found(lv(_, _)), D, speech(utterance(none), D?)).
val_speech1(free, D, speech(utterance(none), D?)).
val_speech1(found(any), D, speech(utterance(none), D?)).

procedure num_of(Var?, Binding?, NumRes).
num_of(num(X), _, num_is(N?)) :- number(X?) | N := X?.
num_of(V, B, R?) :- otherwise, ground(B?) | lookup(V?, B?, F), num_found(F?, R).

procedure num_found(Found?, NumRes).
num_found(found(n(K)), num_is(K?)).
num_found(found(r(K)), num_is(K?)).
num_found(found(i(_)), no_num).
num_found(found(p(_)), no_num).
num_found(found(s(_)), no_num).
num_found(found(c(_)), no_num).
num_found(found(lv(_, _)), no_num).
num_found(free, no_num).
num_found(found(any), no_num).

procedure val_num(Var?, Binding?, Integer).
val_num(V, B, K?) :- num_of(V?, B?, R), num_val(R?, K).

procedure num_val(NumRes?, Integer).
num_val(num_is(K), I?) :- integer(K?) | I := integer(K?).
num_val(_, 0) :- otherwise | true.

procedure val_real(Var?, Binding?, Real).
val_real(V, B, K?) :- ground(B?) | lookup(V?, B?, F), real_found(F?, K).

procedure real_found(Found?, Real).
real_found(found(r(K)), K?).
real_found(_, 0.0) :- otherwise | true.

procedure con_holds(Constraint?, Binding?, YesNo).
con_holds(true, _, yes).
con_holds(and(C1, C2), B, R?) :- ground(B?) | con_holds(C1?, B?, R1), con_holds(C2?, B?, R2), and(R1?, R2?, R).
con_holds(eq(X, Y), B, R?) :- ground(B?), ground(X?), ground(Y?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), eq_vals(A?, C?, X?, Y?, B?, R).
con_holds(ne(X, Y), B, R?) :- ground(B?), ground(X?), ground(Y?) | con_holds(eq(X?, Y?), B?, R1), ne_vals(R1?, X?, Y?, B?, R).
con_holds(not(C), B, R?) :- con_holds(C?, B?, R1), neg(R1?, R).
con_holds(implies(C1, C2), B, R?) :- ground(B?) | con_holds(C1?, B?, R1), con_holds(C2?, B?, R2), neg(R1?, N1), or(N1?, R2?, R).
con_holds(le(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_le(A?, C?, R).
con_holds(lt(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_gt(C?, A?, R).
con_holds(ge(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_le(C?, A?, R).
con_holds(gt(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_gt(A?, C?, R).
con_holds(succ(X, Y), B, R?) :- ground(B?) | num_of(X?, B?, A), num_of(Y?, B?, C), num_succ(A?, C?, R).
con_holds(or(C1, C2), B, R?) :- ground(B?) | con_holds(C1?, B?, R1), con_holds(C2?, B?, R2), or(R1?, R2?, R).
con_holds(signed(U, Y), B, R?) :- ground(B?) | lookup(U?, B?, P), lookup(Y?, B?, S), signing(P?, S?, yes, R).
con_holds(unsigned(U, Y), B, R?) :- ground(B?) | lookup(U?, B?, P), lookup(Y?, B?, S), signing(P?, S?, no, R).
con_holds(program(E), B, R?) :- ground(B?) | expr_term(E?, B?, F), is_program(F?, R).

procedure is_program(Found?, YesNo).
is_program(found(i(program(_))), yes).
is_program(_, no) :- otherwise | true.

procedure eq_vals(NumRes?, NumRes?, Expr?, Expr?, Binding?, YesNo).
eq_vals(num_is(A), num_is(C), _, _, _, R?) :- num_eq(num_is(A?), num_is(C?), R).
eq_vals(no_num, no_num, X, Y, B, R?) :- ground(B?) | expr_term(X?, B?, U), expr_term(Y?, B?, V), same_term(U?, V?, R).
eq_vals(_, _, _, _, _, no) :- otherwise | true.

procedure ne_vals(YesNo?, Expr?, Expr?, Binding?, YesNo).
ne_vals(yes, _, _, _, no).
ne_vals(no, X, Y, B, R?) :- ground(B?) | expr_bound(X?, B?, R1), expr_bound(Y?, B?, R2), and(R1?, R2?, R).

procedure expr_term(Expr?, Binding?, Found).
expr_term(nterm(N), B, found(c(C?))) :- ground(B?), ground(N?) | nt_vars(N?, Vs), vars_bound(Vs?, B?, Bd), nt_term(Bd?, N?, B?, C).
expr_term(E, B, F?) :- otherwise | expr_term1(E?, B?, F).

procedure expr_term1(Expr?, Binding?, Found).
expr_term1(role(I), B, F?) :- lookup(role(I?), B?, F).
expr_term1(pvar(X), B, F?) :- lookup(pvar(X?), B?, F).
expr_term1(svar(X), B, F?) :- lookup(svar(X?), B?, F).
expr_term1(author_of(Y), B, F?) :- lookup(Y?, B?, F0), author_found(F0?, F).
expr_term1(item_of(Y), B, F?) :- lookup(Y?, B?, F0), item_found(F0?, F).
expr_term1(_, _, free) :- otherwise | true.

procedure author_found(Found?, Found).
author_found(found(s(S)), found(p(P?))) :- ground(S?) | first_signer(S?, P).
author_found(_, free) :- otherwise | true.

procedure first_signer(Speech?, Peer).
first_signer(speech(utterance(_), P), P?).
first_signer(speech(program(_), P), P?).
first_signer(speech(speech(U, Q), _), P?) :- first_signer(speech(U?, Q?), P).

procedure item_found(Found?, Found).
item_found(found(s(S)), found(i(U?))) :- ground(S?) | utterance_of(S?, U).
item_found(_, free) :- otherwise | true.

procedure utterance_of(Speech?, Utterance).
utterance_of(speech(utterance(T), _), utterance(T?)).
utterance_of(speech(program(M), _), program(M?)).
utterance_of(speech(speech(U, Q), _), V?) :- utterance_of(speech(U?, Q?), V).

procedure nt_term(YesNo?, NTerm?, Binding?, CName).
nt_term(yes, N, B, C?) :- nt_img(N?, B?, C).
nt_term(no, _, _, dot_any(community(unbound))).

procedure same_term(Found?, Found?, YesNo).
same_term(found(U), found(V), R?) :- ground(U?), ground(V?) | bound_val(U?, BU), bound_val(V?, BV), and(BU?, BV?, Bb), same_if(Bb?, U?, V?, R).
same_term(_, _, no) :- otherwise | true.

procedure same_if(YesNo?, Val?, Val?, YesNo).
same_if(yes, U, V, R?) :- same(U?, V?, R).
same_if(no, _, _, no).

procedure bound_val(Val?, YesNo).
bound_val(lv(_, _), no).
bound_val(any, no).
bound_val(c(dot_any(_)), no).
bound_val(_, yes) :- otherwise | true.

procedure expr_bound(Expr?, Binding?, YesNo).
expr_bound(E, B, R?) :- ground(E?), ground(B?) | expr_val(E?, B?, N), expr_term(E?, B?, T), has_value(N?, T?, R).

procedure has_value(NumRes?, Found?, YesNo).
has_value(num_is(_), _, yes).
has_value(no_num, found(V), R?) :- bound_val(V?, R).
has_value(no_num, free, no).

procedure signing(Found?, Found?, YesNo?, YesNo).
signing(found(p(P)), found(s(S)), W, R?) :- ground(S?) | signed_by(P?, S?, G), same(G?, W?, R).
signing(_, _, _, no) :- otherwise | true.

procedure signed_by(Peer?, Utterance?, YesNo).
signed_by(P, speech(_, Q), yes) :- (P? =?= Q?) | true.
signed_by(P, speech(U, _), R?) :- otherwise | signed_by(P?, U?, R).
signed_by(_, utterance(_), no).
signed_by(_, program(_), no).

procedure expr_val(Expr?, Binding?, NumRes).
expr_val(plus(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(plus, A?, C?, R).
expr_val(minus(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(minus, A?, C?, R).
expr_val(mul(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(mul, A?, C?, R).
expr_val(num(X), B, R?) :- ground(B?) | num_of(num(X?), B?, R).
expr_val(fn(min, [X, Y]), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(min, A?, C?, R).
expr_val(fn(floor, [X]), B, R?) :- expr_val(X?, B?, A), num_floor(A?, R).
expr_val(fn(_, _), _, no_num) :- otherwise | true.
expr_val(cardinality(_, _, _, _), _, no_num).
expr_val(sum(_, _, _, _, _), _, no_num).
expr_val(role(_), _, no_num).
expr_val(pvar(_), _, no_num).
expr_val(svar(_), _, no_num).
expr_val(author_of(_), _, no_num).
expr_val(item_of(_), _, no_num).
expr_val(sgn(_, _), _, no_num).
expr_val(nterm(_), _, no_num).
expr_val(any, _, no_num).
expr_val(inst(_, _, _), _, no_num).

procedure num_op(Constant?, NumRes?, NumRes?, NumRes).
num_op(plus, num_is(A), num_is(C), num_is(K?)) :- number(A?), number(C?) | K := (A? + C?).
num_op(minus, num_is(A), num_is(C), num_is(K?)) :- number(A?), number(C?) | K := (A? - C?).
num_op(mul, num_is(A), num_is(C), num_is(K?)) :- number(A?), number(C?) | K := (A? * C?).
num_op(min, num_is(A), num_is(C), num_is(A?)) :- number(A?), number(C?), (A? =< C?) | true.
num_op(min, num_is(A), num_is(C), num_is(C?)) :- number(A?), number(C?), (A? > C?) | true.
num_op(_, _, _, no_num) :- otherwise | true.

procedure num_floor(NumRes?, NumRes).
num_floor(num_is(A), num_is(A?)) :- integer(A?) | true.
num_floor(num_is(A), num_is(K?)) :- real(A?) | K := floor(A?).
num_floor(_, no_num) :- otherwise | true.

procedure num_eq(NumRes?, NumRes?, YesNo).
num_eq(num_is(A), num_is(C), yes) :- (A? =:= C?) | true.
num_eq(_, _, no) :- otherwise | true.

procedure num_gt(NumRes?, NumRes?, YesNo).
num_gt(num_is(A), num_is(C), yes) :- (A? > C?) | true.
num_gt(_, _, no) :- otherwise | true.

procedure num_le(NumRes?, NumRes?, YesNo).
num_le(num_is(A), num_is(C), yes) :- (A? =< C?) | true.
num_le(_, _, no) :- otherwise | true.

procedure num_succ(NumRes?, NumRes?, YesNo).
num_succ(num_is(A), num_is(C), R?) :- integer(A?), integer(C?) | A1 := (integer(A?) + 1), C1 := integer(C?), same_int(A1?, C1?, R).
num_succ(_, _, no) :- otherwise | true.

procedure con_at(Constant?, Binding?, Peer?, Constraint).
con_at(Nm, B, Id, C?) :- ground(Nm?), ground(B?) | schema_numeric(Nm?, N), con_at0(N?, B?, Id?, C).

procedure con_at0(Numeric?, Binding?, Peer?, Constraint).
con_at0(numeric(Cj, _, _), B, Id, C?) :- ground(B?), ground(Id?) | conjs_at(Cj?, B?, Id?, C).

procedure conjs_at(Conjs?, Binding?, Peer?, Constraint).
conjs_at([], _, _, true).
conjs_at([cj(every, C) | Cj], B, Id, and(C?, D?)) :- conjs_at(Cj?, B?, Id?, D).
conjs_at([cj(at(I), C) | Cj], B, Id, and(C1?, D?)) :- ground(B?), ground(Id?) | role_person(I?, B?, P), same(P?, Id?, Me), con_if(Me?, C?, C1), conjs_at(Cj?, B?, Id?, D).
conjs_at([cj(cond, _) | Cj], B, Id, D?) :- conjs_at(Cj?, B?, Id?, D).

procedure conjs_every(Conjs?, Constraint).
conjs_every([], true).
conjs_every([cj(every, C) | Cj], and(C?, D?)) :- conjs_every(Cj?, D).
conjs_every([cj(at(_), _) | Cj], D?) :- conjs_every(Cj?, D).
conjs_every([cj(cond, _) | Cj], D?) :- conjs_every(Cj?, D).

procedure conjs_local(Conjs?, Constraint).
conjs_local([], true).
conjs_local([cj(every, C) | Cj], and(C?, D?)) :- conjs_local(Cj?, D).
conjs_local([cj(at(_), C) | Cj], and(C?, D?)) :- conjs_local(Cj?, D).
conjs_local([cj(cond, _) | Cj], D?) :- conjs_local(Cj?, D).

procedure con_if(YesNo?, Constraint?, Constraint).
con_if(yes, C, C?).
con_if(no, _, true).

procedure con_counted(Constraint?, Binding?, GAtoms?, Constraint).
con_counted(true, _, _, true).
con_counted(and(C1, C2), B, Sh, and(D1?, D2?)) :- ground(B?), ground(Sh?) | con_counted(C1?, B?, Sh?, D1), con_counted(C2?, B?, Sh?, D2).
con_counted(or(C1, C2), B, Sh, or(D1?, D2?)) :- ground(B?), ground(Sh?) | con_counted(C1?, B?, Sh?, D1), con_counted(C2?, B?, Sh?, D2).
con_counted(implies(C1, C2), B, Sh, implies(D1?, D2?)) :- ground(B?), ground(Sh?) | con_counted(C1?, B?, Sh?, D1), con_counted(C2?, B?, Sh?, D2).
con_counted(not(C), B, Sh, not(D?)) :- con_counted(C?, B?, Sh?, D).
con_counted(eq(X, Y), B, Sh, eq(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
con_counted(ne(X, Y), B, Sh, ne(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
con_counted(le(X, Y), B, Sh, le(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
con_counted(lt(X, Y), B, Sh, lt(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
con_counted(ge(X, Y), B, Sh, ge(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
con_counted(gt(X, Y), B, Sh, gt(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
con_counted(succ(X, Y), _, _, succ(X?, Y?)).
con_counted(signed(X, Y), _, _, signed(X?, Y?)).
con_counted(unsigned(X, Y), _, _, unsigned(X?, Y?)).
con_counted(program(E), _, _, program(E?)).

procedure expr_counted(Expr?, Binding?, GAtoms?, Expr).
expr_counted(plus(X, Y), B, Sh, plus(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
expr_counted(minus(X, Y), B, Sh, minus(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
expr_counted(mul(X, Y), B, Sh, mul(U?, V?)) :- ground(B?), ground(Sh?) | expr_counted(X?, B?, Sh?, U), expr_counted(Y?, B?, Sh?, V).
expr_counted(fn(F, Es), B, Sh, fn(F?, Ds?)) :- exprs_counted(Es?, B?, Sh?, Ds).
expr_counted(cardinality(_, _, A, F), B, Sh, num(K?)) :- ground(A?), ground(F?), ground(B?), ground(Sh?) | match_into(A?, Sh?, B?, Bs), count_holding(Bs?, F?, Sh?, 0, K).
expr_counted(sum(_, _, A, F, U), B, Sh, num(K?)) :- ground(A?), ground(F?), ground(U?), ground(B?), ground(Sh?) | match_into(A?, Sh?, B?, Bs), sum_holding(Bs?, F?, U?, Sh?, 0, K).
expr_counted(E, _, _, E?) :- otherwise | true.

procedure exprs_counted(Exprs?, Binding?, GAtoms?, Exprs).
exprs_counted([], _, _, []).
exprs_counted([E | Es], B, Sh, [D? | Ds?]) :- ground(B?), ground(Sh?) | expr_counted(E?, B?, Sh?, D), exprs_counted(Es?, B?, Sh?, Ds).

procedure count_holding(Bindings?, Form?, GAtoms?, Integer?, Integer).
count_holding([], _, _, K, K?).
count_holding([B | Bs], F, Sh, K0, K?) :- ground(F?), ground(Sh?), integer(K0?) | form_holds(F?, B?, Sh?, H), count_add(H?, K0?, K1), count_holding(Bs?, F?, Sh?, K1?, K).

procedure count_add(YesNo?, Integer?, Integer).
count_add(yes, K0, K?) :- K := (K0? + 1).
count_add(no, K0, K0?).

procedure sum_holding(Bindings?, Form?, Expr?, GAtoms?, Number?, Number).
sum_holding([], _, _, _, K, K?).
sum_holding([B | Bs], F, U, Sh, K0, K?) :- ground(B?), ground(F?), ground(U?), ground(Sh?), number(K0?) | form_holds(F?, B?, Sh?, H), expr_counted(U?, B?, Sh?, U1), expr_val(U1?, B?, V), sum_add(H?, V?, K0?, K1), sum_holding(Bs?, F?, U?, Sh?, K1?, K).

procedure sum_add(YesNo?, NumRes?, Number?, Number).
sum_add(yes, num_is(V), K0, K?) :- number(V?), number(K0?) | K := (K0? + V?).
sum_add(_, _, K0, K0?) :- otherwise | true.

procedure con_live(Constant?, Binding?, YesNo).
con_live(Nm, B, V?) :- ground(Nm?) | schema_numeric(Nm?, N), con_live1(N?, B?, V).

procedure con_live1(Numeric?, Binding?, YesNo).
con_live1(numeric(Cj, _, _), B, V?) :- ground(B?) | conjs_every(Cj?, C), con_holds(C?, B?, V).

procedure unlocal(Binding?, Binding).
unlocal([], []).
unlocal([b(_, lv(_, _)) | Bs], R?) :- unlocal(Bs?, R).
unlocal([E | Bs], [E? | R?]) :- otherwise | unlocal(Bs?, R).

procedure con_extend(Constraint?, Binding?, Bindings).
con_extend(C, B, Bs?) :- ground(C?), ground(B?) | con_ext1(C?, B?, Bs1), con_again(Bs1?, C?, B?, Bs).

procedure con_again(Bindings?, Constraint?, Binding?, Bindings).
con_again([], _, _, []).
con_again([B1 | Bs], C, B, R?) :- ground(B1?), ground(B?), ground(C?) | blen(B1?, N1), blen(B?, N), con_again1(N1?, N?, B1?, C?, R1), con_again(Bs?, C?, B?, R2), app(R1?, R2?, R).

procedure con_again1(Integer?, Integer?, Binding?, Constraint?, Bindings).
con_again1(N1, N, B1, C, R?) :- (N1? > N?) | con_extend(C?, B1?, R).
con_again1(_, _, B1, _, [B1?]) :- otherwise | true.

procedure blen(Binding?, Integer).
blen([], 0).
blen([_ | Bs], N?) :- blen(Bs?, M), N := (M? + 1).

procedure con_ext1(Constraint?, Binding?, Bindings).
con_ext1(true, B, [B?]).
con_ext1(program(_), B, [B?]).
con_ext1(and(C1, C2), B, Bs?) :- ground(B?) | con_ext1(C2?, B?, Bs2), ext_by(Bs2?, C1?, Bs).
con_ext1(eq(X, Y), B, Bs?) :- ground(X?), ground(Y?), ground(B?) | eq_ext(X?, Y?, B?, Bs).
con_ext1(le(_, _), B, [B?]).
con_ext1(lt(_, _), B, [B?]).
con_ext1(ge(_, _), B, [B?]).
con_ext1(gt(_, _), B, [B?]).
con_ext1(succ(X, Y), B, Bs?) :- ground(B?), ground(X?), ground(Y?) | num_of(X?, B?, A), num_of(Y?, B?, C), succ_ext(A?, C?, X?, Y?, B?, Bs).
con_ext1(signed(_, _), B, [B?]).
con_ext1(unsigned(_, _), B, [B?]).
con_ext1(not(_), B, [B?]).
con_ext1(implies(_, _), B, [B?]).
con_ext1(ne(_, _), B, [B?]).
con_ext1(or(C1, C2), B, Bs?) :- ground(B?) | con_ext1(C1?, B?, Bs1), con_ext1(C2?, B?, Bs2), app(Bs1?, Bs2?, Bs).

procedure ext_by(Bindings?, Constraint?, Bindings).
ext_by([], _, []).
ext_by([B | Bs], C, R?) :- ground(C?) | con_ext1(C?, B?, R1), ext_by(Bs?, C?, R2), app(R1?, R2?, R).

procedure eq_ext(Expr?, Expr?, Binding?, Bindings).
eq_ext(X, Y, B, Bs?) :- ground(X?), ground(Y?), ground(B?) | expr_free(X?, B?, [], F1), expr_free(Y?, B?, F1?, F), eq_ext1(F?, X?, Y?, B?, Bs).

procedure eq_ext1(Vars?, Expr?, Expr?, Binding?, Bindings).
eq_ext1([V], X, Y, B, Bs?) :- ground(V?), ground(X?), ground(Y?), ground(B?) | expr_val(minus(X?, Y?), [b(V?, n(0)) | B?], D0), expr_val(minus(X?, Y?), [b(V?, n(1)) | B?], D1), eq_solve(D0?, D1?, V?, B?, Bs).
eq_ext1(_, _, _, B, [B?]) :- otherwise | true.

procedure eq_solve(NumRes?, NumRes?, Var?, Binding?, Bindings).
eq_solve(num_is(D0), num_is(D1), V, B, Bs?) :- integer(D0?), integer(D1?) | C := (integer(D1?) - integer(D0?)), D := integer(D0?), eq_solve1(C?, D?, V?, B?, Bs).
eq_solve(_, _, _, B, [B?]) :- otherwise | true.

procedure eq_solve1(Integer?, Integer?, Var?, Binding?, Bindings).
eq_solve1(C, D0, V, B, [[b(V?, n(K?)) | B?]]) :- (C? =\= 0), ((D0? mod C?) =:= 0) | K := ((0 - D0?) // C?).
eq_solve1(_, _, _, B, [B?]) :- otherwise | true.

procedure expr_free(Expr?, Binding?, Vars?, Vars).
expr_free(plus(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(minus(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(mul(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(num(X), _, F0, F0?) :- number(X?) | true.
expr_free(num(X), B, F0, F?) :- otherwise, ground(X?), ground(B?), ground(F0?) | num_of(num(X?), B?, R), leaf_free1(R?, num(X?), F0?, F).
expr_free(role(_), _, F0, F0?).
expr_free(pvar(_), _, F0, F0?).
expr_free(svar(_), _, F0, F0?).
expr_free(author_of(_), _, F0, F0?).
expr_free(item_of(_), _, F0, F0?).
expr_free(sgn(_, _), _, F0, F0?).
expr_free(nterm(_), _, F0, F0?).
expr_free(any, _, F0, F0?).
expr_free(inst(_, _, _), _, F0, F0?).
expr_free(fn(_, Es), B, F0, F?) :- ground(B?) | exprs_free(Es?, B?, F0?, F).
expr_free(cardinality(_, _, _, _), _, F0, F0?).
expr_free(sum(_, _, _, _, _), _, F0, F0?).

procedure exprs_free(Exprs?, Binding?, Vars?, Vars).
exprs_free([], _, F0, F0?).
exprs_free([E | Es], B, F0, F?) :- ground(B?) | expr_free(E?, B?, F0?, F1), exprs_free(Es?, B?, F1?, F).

procedure leaf_free1(NumRes?, Var?, Vars?, Vars).
leaf_free1(num_is(_), _, F0, F0?).
leaf_free1(no_num, V, F0, F?) :- ground(V?), ground(F0?) | var_in(V?, F0?, In), add_var(In?, V?, F0?, F).

procedure var_in(Var?, Vars?, YesNo).
var_in(_, [], no).
var_in(V, [W | _], yes) :- (V? =?= W?) | true.
var_in(V, [_ | Ws], R?) :- otherwise | var_in(V?, Ws?, R).

procedure add_var(YesNo?, Var?, Vars?, Vars).
add_var(yes, _, F0, F0?).
add_var(no, V, F0, [V? | F0?]).

procedure succ_ext(NumRes?, NumRes?, Var?, Var?, Binding?, Bindings).
succ_ext(num_is(A), no_num, _, Y, B, [[b(Y?, n(A1?)) | B?]]) :- integer(A?) | A1 := (integer(A?) + 1).
succ_ext(no_num, num_is(C), X, _, B, [[b(X?, n(C1?)) | B?]]) :- integer(C?) | C1 := (integer(C?) - 1).
succ_ext(_, _, _, _, B, [B?]) :- otherwise | true.

procedure nums_bound(Constant?, Binding?, YesNo).
nums_bound(Nm, B, Ok?) :- ground(Nm?) | schema_entry(Nm?, E), schema_head(E?, Hd), hd_nums_bound(Hd?, B?, Ok).

procedure schema_head(Schema?, Vars).
schema_head(schema(_, Hd, _), Hd?).
schema_head(lschema(_, Hd, _, _), Hd?).

procedure hd_nums_bound(Vars?, Binding?, YesNo).
hd_nums_bound([], _, yes).
hd_nums_bound([num(X) | Vs], B, Ok?) :- ground(X?), ground(B?) | num_of(num(X?), B?, K), is_num(K?, O1), hd_nums_bound(Vs?, B?, O2), and(O1?, O2?, Ok).
hd_nums_bound([_ | Vs], B, Ok?) :- otherwise | hd_nums_bound(Vs?, B?, Ok).

procedure is_num(NumRes?, YesNo).
is_num(num_is(_), yes).
is_num(no_num, no).

procedure st_id(St?, Peer).
st_id(st(Id, _, _, _, _, _, _, _, _, _, _, _, _, _), Id?).

procedure st_app(St?, App).
st_app(st(_, Ap, _, _, _, _, _, _, _, _, _, _, _, _), Ap?).

procedure st_count(St?, Integer).
st_count(st(_, _, D, _, _, _, _, _, _, _, _, _, _, _), D?).

procedure st_sent(St?, Peers).
st_sent(st(_, _, _, Se, _, _, _, _, _, _, _, _, _, _), Se?).

procedure st_recd(St?, Peers).
st_recd(st(_, _, _, _, Rc, _, _, _, _, _, _, _, _, _), Rc?).

procedure st_known(St?, List(Key)).
st_known(st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), Ks?) :- ground(Se?), ground(ISe?) | app(Se?, ISe?, Ps), known_sorted(Ps?, kn(Se?, Rc?, ISe?, IRc?), Ks).

procedure known_sorted(Peers?, Kn?, List(Key)).
known_sorted(Ps, Kn, Ks?) :- ground(Ps?) | dedup(Ps?, Ps1), known_of(Ps1?, Kn?, K0), sort_peers(K0?, Ks).

procedure known_of(Peers?, Kn?, Peers).
known_of([], _, []).
known_of([P | Ps], Kn, Ks?) :- ground(P?), ground(Kn?) | known_kn(P?, Kn?, B), known_of(Ps?, Kn?, K1), keep_peer(B?, P?, K1?, Ks).

procedure keep_peer(YesNo?, Peer?, Peers?, Peers).
keep_peer(yes, P, Ks, [P? | Ks?]).
keep_peer(no, _, Ks, Ks?).

procedure st_isent(St?, Peers).
st_isent(st(_, _, _, _, _, ISe, _, _, _, _, _, _, _, _), ISe?).

procedure st_irecd(St?, Peers).
st_irecd(st(_, _, _, _, _, _, IRc, _, _, _, _, _, _, _), IRc?).

procedure st_waits(St?, Waits).
st_waits(st(_, _, _, _, _, _, _, W, _, _, _, _, _, _), W?).

procedure st_pends(St?, Pends).
st_pends(st(_, _, _, _, _, _, _, _, _, Pd, _, _, _, _), Pd?).

procedure st_ix(St?, Ix).
st_ix(st(_, _, _, _, _, _, _, _, _, _, _, _, Ix, _), Ix?).

procedure set_ix(St?, Ix?, St).
set_ix(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, _, Rq), Ix, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_trie(St?, Trie).
st_trie(st(_, _, _, _, _, _, _, _, _, _, _, _, ix(Tr, _, _, _), _), Tr?).

procedure st_kn(St?, Kn).
st_kn(st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), kn(Se?, Rc?, ISe?, IRc?)).

procedure st_view(St?, V).
st_view(st(Id, app(S, _, L, R), _, Se, Rc, ISe, IRc, _, _, Pd, _, _, _, _), v(Id?, S?, L?, R?, Pd?, kn(Se?, Rc?, ISe?, IRc?))).

procedure v_id(V?, Peer).
v_id(v(Id, _, _, _, _, _), Id?).

procedure v_ms(V?, GAtoms).
v_ms(v(_, S, _, _, _, _), S?).

procedure v_recs(V?, Recs).
v_recs(v(_, _, _, R, _, _), R?).

procedure v_pends(V?, Pends).
v_pends(v(_, _, _, _, Pd, _), Pd?).

procedure v_kn(V?, Kn).
v_kn(v(_, _, _, _, _, Kn), Kn?).

procedure set_app(St?, App?, St).
set_app(st(Id, _, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), Ap, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure set_waits(St?, Waits?, St).
set_waits(st(Id, Ap, D, Se, Rc, ISe, IRc, _, Ca, Pd, Pr, Hd, Ix, Rq), W, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_made(St?, Rhos).
st_made(st(_, _, _, _, _, _, _, _, _, _, Pr, _, _, _), Pr?).

procedure set_made(St?, Rhos?, St).
set_made(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, _, Hd, Ix, Rq), Pr, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_held(St?, Helds).
st_held(st(_, _, _, _, _, _, _, _, _, _, _, Hd, _, _), Hd?).

procedure set_held(St?, Helds?, St).
set_held(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, _, Ix, Rq), Hd, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_reqs(St?, Proposals).
st_reqs(st(_, _, _, _, _, _, _, _, _, _, _, _, _, Rq), Rq?).

procedure set_reqs(St?, Proposals?, St).
set_reqs(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, _), Rq, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure set_pends(St?, Pends?, St).
set_pends(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, _, Pr, Hd, Ix, Rq), Pd, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_pend_once(Pend?, St?, St).
add_pend_once(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?, Pr?, Hd?, Ix?, Rq?)) :- ground(X?), ground(Pd?) | mem(X?, Pd?, In), add_pend1(In?, X?, Pd?, Pd1).

procedure add_pend1(YesNo?, Pend?, Pends?, Pends).
add_pend1(yes, _, Pd, Pd?).
add_pend1(no, X, Pd, Pd1?) :- app(Pd?, [X?], Pd1).

procedure drop_pend(Pend?, St?, St).
drop_pend(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?, Pr?, Hd?, Ix?, Rq?)) :- remove_all(X?, Pd?, Pd1).

procedure add_sent(Peer?, St?, St).
add_sent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, [Q? | Se?], Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_isent(Peer?, St?, St).
add_isent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, [Q? | ISe?], IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_irecd(Peer?, St?, St).
add_irecd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, ISe?, [P? | IRc?], W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_recd(Peer?, St?, St).
add_recd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, [P? | Rc?], ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure advance(St?, St).
advance(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D1?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)) :- D1 := (D? + 1).

procedure app_recs(App?, Recs).
app_recs(app(_, _, _, R), R?).

procedure app_count(App?, Integer).
app_count(app(_, K, _, _), K?).

procedure app_state(App?, GAtoms).
app_state(app(S, _, _, _), S?).

procedure attempt_id(Attempt?, Peer).
attempt_id(attempt(I, _, _, _, _), I?).

procedure attempt_k(Attempt?, Integer).
attempt_k(attempt(_, K, _, _, _), K?).

procedure attempt_rank(Attempt?, Integer).
attempt_rank(attempt(_, _, P, _, _), P?).

procedure attempt_class(Attempt?, Class).
attempt_class(attempt(_, _, _, C, _), C?).

procedure attempt_names(Attempt?, Names).
attempt_names(attempt(_, _, _, _, Nm), Nm?).

procedure and(YesNo?, YesNo?, YesNo).
and(yes, B, B?).
and(no, _, no).

procedure or(YesNo?, YesNo?, YesNo).
or(yes, _, yes).
or(no, B, B?).

procedure neg(YesNo?, YesNo).
neg(yes, no).
neg(no, yes).

procedure(X) same(X?, X?, YesNo).
same(P, Q, yes) :- (P? =?= Q?) | true.
same(_, _, no) :- otherwise | true.

procedure same_int(Integer?, Integer?, YesNo).
same_int(M, N, yes) :- (M? =:= N?) | true.
same_int(_, _, no) :- otherwise | true.

procedure sort_peers(Peers?, Peers).
sort_peers([], []).
sort_peers([P | Ps], S?) :- sort_peers(Ps?, S1), insert_peer(P?, S1?, S).

procedure insert_peer(Peer?, Peers?, Peers).
insert_peer(P, [], [P?]).
insert_peer(P, [Q | Qs], [P?, Q? | Qs?]) :- '@<'(P?, Q?) | true.
insert_peer(P, [Q | Qs], [Q? | R?]) :- otherwise | insert_peer(P?, Qs?, R).

procedure(X) app(Stream(X)?, Stream(X)?, Stream(X)).
app([], Ys, Ys?).
app([X | Xs], Ys, [X? | Zs?]) :- app(Xs?, Ys?, Zs).

procedure(X) mem(X?, Stream(X)?, YesNo).
mem(_, [], no).
mem(X, [Y | _], yes) :- (X? =?= Y?) | true.
mem(X, [_ | Ys], R?) :- otherwise | mem(X?, Ys?, R).

procedure(X) dedup(Stream(X)?, Stream(X)).
dedup([], []).
dedup([X | Xs], [X? | Ys?]) :- ground(X?) | remove_all(X?, Xs?, Xs1), dedup(Xs1?, Ys).

procedure(X) remove_all(X?, Stream(X)?, Stream(X)).
remove_all(_, [], []).
remove_all(X, [Y | Ys], Zs?) :- (X? =?= Y?) | remove_all(X?, Ys?, Zs).
remove_all(X, [Y | Ys], [Y? | Zs?]) :- otherwise | remove_all(X?, Ys?, Zs).

procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y | Ys], yes, Ys?) :- (X? =?= Y?) | true.
ms_remove(X, [Y | Ys], F?, [Y? | Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).

procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X | Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).

procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X | Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).

procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).

procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) | ms_sub(A?, B?, R1), ms_sub(B?, A?, R2), and(R1?, R2?, R).

procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).

procedure(X) ms_meets(Stream(X)?, Stream(X)?, YesNo).
ms_meets([], _, no).
ms_meets([X | Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), ms_meets1(R1?, Xs?, B?, R).

procedure(X) ms_meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_meets1(yes, _, _, yes).
ms_meets1(no, Xs, B, R?) :- ms_meets(Xs?, B?, R).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).
Event(Q, T) ::= Ask(Q) ; Input(T) ; Draw(T).
Events(Q, T) ::= [Event(Q, T) | Events(Q, T)].
Turn ::= ask ; grant ; draw.
Questioned(S) ::= S ; input(Path).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(Input(T)), Stream(Draw(T))), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(Input(T)), Stream(Draw(T))?, Inputs(T), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, G0s?, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, DOut, [route(0, G0s)], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(Input(T))).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).
split_grants([refresh | Gs], [refresh | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) fair(Turn?, Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Events(Q, T)).
fair(ask, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(grant, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(draw, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(ask, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(grant, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(draw, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(ask, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(grant, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(draw, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).

procedure(Q, T) serve(Events(Q, T)?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve([ask(_, Q) | Es], CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve(Es?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve([input(Id, P, R) | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(input(Id?, P?, R?), Rs?, Rs1), serve(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve([refresh | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- refresh_routes(Rs?, Rs1), serve(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve([draw(Id, W, V) | Es], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve(Es?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve([withdraw(Id) | Es], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve(Es?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) refresh_routes(Routes(T)?, Routes(T)).
refresh_routes([route(Id, [refresh | Gs1?]) | Rs], [route(Id?, Gs1) | Rs1?]) :- refresh_routes(Rs?, Rs1).
refresh_routes([], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure(T) form_string(T?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure(T) form_module(T?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= request_r(View_request_r) ; approval_w(View_approval) ; output(List(Output)) ; Request ; YesNo.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(Input(Drawn)), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, G0s, Ss), output(named(last_state, thread(menu([form(view, [field('Key', shown), field('List(Atom)', thread(menu([shown, form(knows, [field('Peer', shown)]), form(friend, [field('Peer', shown)]), form(item, [field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])]))), field('List(Key)', thread), field('List(Approved)', thread(menu([form(establish, [field('Peer', shown)]), form(acquaint, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(befriend, [field('Peer', shown), field('Peer', shown)]), form(unfriend, [field('Peer', shown), field('Peer', shown)]), form(sign, [field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))]), form(forward, [field('Peer', shown), field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])]))), field('List(Tab)', thread(menu([form(tab, [field('String', shown), field('Constant', shown)]), form(tab, [field('String', shown), field('Constant', shown), field('Constant', shown)])])))]), form(refused, [field('Approved', menu([form(establish, [field('Peer', shown)]), form(acquaint, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(befriend, [field('Peer', shown), field('Peer', shown)]), form(unfriend, [field('Peer', shown), field('Peer', shown)]), form(sign, [field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))]), form(forward, [field('Peer', shown), field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])])), field('Key', shown), field('Reason', menu([shown, shown, form(unable, [field('List(Atom)', thread(menu([shown, form(knows, [field('Peer', shown)]), form(friend, [field('Peer', shown)]), form(item, [field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])]))), field('List(Atom)', thread(menu([shown, form(knows, [field('Peer', shown)]), form(friend, [field('Peer', shown)]), form(item, [field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])])))])]))])]))), MOut?, G0s?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, request_r(X?), Gs, Ds?) :- answer_request([], X, Gs1?, _, Done), run_request_r(Id?, named('social_menu([button(\'Establish\', [act(establish, 1, [1], [forb(identity, [])], [], [], [], [])]), button(\'Acquaint\', [act(acquaint, 1, [1, 2], [req(identity, [])], [], [field(2, person, key)], [], [])]), button(\'Introduce\', [act(introduce, 1, [1, 2], [req(identity, []), req(knows, [at(2)]), req(knows, [at(3)])], [2, 3], [], [], [])]), button(\'Befriend\', [act(befriend, 1, [1, 2], [req(identity, []), req(knows, [at(2)]), forb(friend, [at(2)])], [2], [], [], [])]), button(\'Unfriend\', [act(unfriend, 1, [1, 2], [req(identity, []), req(friend, [at(2)])], [2], [], [], [])]), button(\'Sign\', [act(sign, 1, [1], [req(identity, []), forb(item, [at(2)])], [], [field(2, text, text)], [], [])]), button(\'Forward\', [act(forward, 1, [1, 2], [req(identity, []), req(item, [at(3)]), req(friend, [at(2)])], [3, 2], [], [], [])])])', form(propose, [field('Proposal', menu([label('Establish', form(establish, [field('Peer', peer)])), label('Acquaint', form(acquaint, [field('Peer', peer), field(person, peer)])), label('Introduce', form(introduce, [field('Peer', peer), field('Peer', peer), field('Peer', peer)])), label('Befriend', form(befriend, [field('Peer', peer), field('Peer', peer)])), label('Unfriend', form(unfriend, [field('Peer', peer), field('Peer', peer)])), label('Sign', form(sign, [field('Peer', peer), field(text, rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', text)]), form(program, [field('Module', text)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', peer)])]))), field('Peer', peer)])))])), label('Forward', form(forward, [field('Peer', peer), field('Peer', peer), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', text)]), form(program, [field('Module', text)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', peer)])]))), field('Peer', peer)])))]))]))])), [input([])], Done?, Gs?, Gs1, Ds).
construct(Id, approval_w(X), Gs, Ds?) :- present_approval([], X?, Gs1?, _, Vs, Done), run_approval_w(Id?, named(approval_sentence, form(approval, [field('Asking', menu([form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(establish, [field('Peer', shown)]), form(acquaint, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(befriend, [field('Peer', shown), field('Peer', shown)]), form(unfriend, [field('Peer', shown), field('Peer', shown)]), form(sign, [field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))]), form(forward, [field('Peer', shown), field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])])), field('Names', menu([shown, form(request, [field('Rho', menu([form(one, [field('Class', menu([form(establish, [field('Peer', shown)]), form(acquaint, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(befriend, [field('Peer', shown), field('Peer', shown)]), form(unfriend, [field('Peer', shown), field('Peer', shown)]), form(sign, [field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))]), form(forward, [field('Peer', shown), field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])]))]), form(rho, [field('Proposal', menu([form(establish, [field('Peer', shown)]), form(acquaint, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(befriend, [field('Peer', shown), field('Peer', shown)]), form(unfriend, [field('Peer', shown), field('Peer', shown)]), form(sign, [field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))]), form(forward, [field('Peer', shown), field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])]))])])), field('Integer', shown)])]))]), form(hello, [field('Peer', shown), field('Proposal', menu([form(establish, [field('Peer', shown)]), form(acquaint, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(befriend, [field('Peer', shown), field('Peer', shown)]), form(unfriend, [field('Peer', shown), field('Peer', shown)]), form(sign, [field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))]), form(forward, [field('Peer', shown), field('Peer', shown), field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])]))])])), field('List(Word)', thread(menu([form(text, [field('String', shown)]), form(person, [field('Peer', shown)]), form(named, [field('String', shown), field('Peer', shown)]), form(valued, [field('String', shown), field('Number', shown)]), form(held, [field('Atom', menu([shown, form(knows, [field('Peer', shown)]), form(friend, [field('Peer', shown)]), form(item, [field('Speech', rec('Speech', form(speech, [field('Utterance', rec('Utterance', menu([form(utterance, [field('String', shown)]), form(program, [field('Module', shown)]), form(speech, [field('Utterance', ref('Utterance')), field('Peer', shown)])]))), field('Peer', shown)])))])])), field('Integer', shown)])]))), field('YesNo', buttons([yes, no]))])), Vs?, Done?, Gs?, Gs1, Ds).

procedure output(Widget?, Stream(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output(W, Ms, Gs, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Gs?, Ds).

procedure output_more(Widget?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Gs, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Gs?, Ds).
output_more(W, Ms, Es, [refresh | Gs], Ds?) :- output_draw(W?, Ms?, Es?, Gs?, Ds).
output_more(W, Ms, Es, [input(_, _, _) | Gs], Ds?) :- output_more(W?, Ms?, Es?, Gs?, Ds).
output_more(W, [], Es, Gs, Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_draw(Widget?, Stream(Output)?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, Gs, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Gs?, Ds).

procedure output_end(Widget?, List(Output)?, Inputs(Drawn)?, Stream(Draw(Drawn))).
output_end(W, Es, [refresh | Gs], [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_end(W?, Es?, Gs?, Ds).
output_end(W, Es, [input(_, _, _) | Gs], Ds?) :- output_end(W?, Es?, Gs?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure join_proposal_establish_1(Formed(Peer)?, Formed(Proposal)).
join_proposal_establish_1(formed(X1), formed(establish(X1?))).
join_proposal_establish_1(refused, refused).

procedure join_proposal_acquaint_2(Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_acquaint_2(formed(X1), formed(X2), formed(acquaint(X1?, X2?))).
join_proposal_acquaint_2(refused, _, refused).
join_proposal_acquaint_2(_, refused, refused).

procedure join_proposal_introduce_3(Formed(Peer)?, Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_introduce_3(formed(X1), formed(X2), formed(X3), formed(introduce(X1?, X2?, X3?))).
join_proposal_introduce_3(refused, _, _, refused).
join_proposal_introduce_3(_, refused, _, refused).
join_proposal_introduce_3(_, _, refused, refused).

procedure join_proposal_befriend_2(Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_befriend_2(formed(X1), formed(X2), formed(befriend(X1?, X2?))).
join_proposal_befriend_2(refused, _, refused).
join_proposal_befriend_2(_, refused, refused).

procedure join_proposal_unfriend_2(Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_unfriend_2(formed(X1), formed(X2), formed(unfriend(X1?, X2?))).
join_proposal_unfriend_2(refused, _, refused).
join_proposal_unfriend_2(_, refused, refused).

procedure join_utterance_utterance_1(Formed(String)?, Formed(Utterance)).
join_utterance_utterance_1(formed(X1), formed(utterance(X1?))).
join_utterance_utterance_1(refused, refused).

procedure join_utterance_program_1(Formed(Module)?, Formed(Utterance)).
join_utterance_program_1(formed(X1), formed(program(X1?))).
join_utterance_program_1(refused, refused).

procedure join_utterance_speech_2(Formed(Utterance)?, Formed(Peer)?, Formed(Utterance)).
join_utterance_speech_2(formed(X1), formed(X2), formed(speech(X1?, X2?))).
join_utterance_speech_2(refused, _, refused).
join_utterance_speech_2(_, refused, refused).

procedure form_utterance(Utterance?, Formed(Utterance)).
form_utterance(utterance(R1), F?) :- form_string(R1?, F1), join_utterance_utterance_1(F1?, F).
form_utterance(program(R1), F?) :- form_module(R1?, F1), join_utterance_program_1(F1?, F).
form_utterance(speech(R1, R2), F?) :- form_utterance(R1?, F1), form_string(R2?, F2), join_utterance_speech_2(F1?, F2?, F).
form_utterance(_, refused) :- otherwise | true.

procedure join_speech_speech_2(Formed(Utterance)?, Formed(Peer)?, Formed(Speech)).
join_speech_speech_2(formed(X1), formed(X2), formed(speech(X1?, X2?))).
join_speech_speech_2(refused, _, refused).
join_speech_speech_2(_, refused, refused).

procedure form_speech(Speech?, Formed(Speech)).
form_speech(speech(R1, R2), F?) :- form_utterance(R1?, F1), form_string(R2?, F2), join_speech_speech_2(F1?, F2?, F).
form_speech(_, refused) :- otherwise | true.

procedure join_proposal_sign_2(Formed(Peer)?, Formed(Speech)?, Formed(Proposal)).
join_proposal_sign_2(formed(X1), formed(X2), formed(sign(X1?, X2?))).
join_proposal_sign_2(refused, _, refused).
join_proposal_sign_2(_, refused, refused).

procedure join_proposal_forward_3(Formed(Peer)?, Formed(Peer)?, Formed(Speech)?, Formed(Proposal)).
join_proposal_forward_3(formed(X1), formed(X2), formed(X3), formed(forward(X1?, X2?, X3?))).
join_proposal_forward_3(refused, _, _, refused).
join_proposal_forward_3(_, refused, _, refused).
join_proposal_forward_3(_, _, refused, refused).

procedure form_proposal(Proposal?, Formed(Proposal)).
form_proposal(establish(R1), F?) :- form_string(R1?, F1), join_proposal_establish_1(F1?, F).
form_proposal(acquaint(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_proposal_acquaint_2(F1?, F2?, F).
form_proposal(introduce(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), join_proposal_introduce_3(F1?, F2?, F3?, F).
form_proposal(befriend(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_proposal_befriend_2(F1?, F2?, F).
form_proposal(unfriend(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_proposal_unfriend_2(F1?, F2?, F).
form_proposal(sign(R1, R2), F?) :- form_string(R1?, F1), form_speech(R2?, F2), join_proposal_sign_2(F1?, F2?, F).
form_proposal(forward(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_speech(R3?, F3), join_proposal_forward_3(F1?, F2?, F3?, F).
form_proposal(_, refused) :- otherwise | true.

procedure join_request_propose_1(Formed(Proposal)?, Formed(Request)).
join_request_propose_1(formed(X1), formed(propose(X1?))).
join_request_propose_1(refused, refused).

procedure form_request(Drawn?, Formed(Request)).
form_request(propose(R1), F?) :- form_proposal(R1?, F1), join_request_propose_1(F1?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_request(Path?, Request, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_request(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_request(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_request(Formed(Request)?, Path?, Request, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_request(formed(V), _, V?, _, Gs, Gs?, done).
take_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_request(P?, X, Gs?, Gs1, Done).

View_request_r ::= Request ; input(Path).
procedure run_request_r(Integer?, Widget?, Stream(View_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_request_r(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_request_r(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_request_r_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_request_r_more(Integer?, Widget?, View_request_r?, Stream(View_request_r)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_request_r_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_request_r_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_request_r_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_request_r_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_request_r_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_request_r_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_request_r_last(Integer?, Widget?, View_request_r?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_request_r_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_request_r_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, request_r(V?)) | Ds?]) :- ground(W?), ground(V?) | run_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_request_r_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_request_r_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_request_r_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_request_r_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_request_r_grants(Gs?, Gs1).
run_request_r_grants([refresh | Gs], Gs1?) :- run_request_r_grants(Gs?, Gs1).

procedure form_yesNo(Drawn?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [G | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, G?, Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

View_approval ::= approval(Asking, List(Word), Questioned(YesNo)).
procedure present_approval(Path?, Approval?, Inputs(Drawn)?, Inputs(Drawn), Stream(View_approval), Done).
present_approval(P, approval(H1, H2, H3?), Gs, Gs1?, [approval(H1?, H2?, input(M3?))], D3?) :- ground(P?), ground(H1?), ground(H2?) | path(P?, 3, M3), path(P?, 3, Q3), answer_yesNo(Q3?, H3, Gs?, Gs1, D3).

procedure run_approval_w(Integer?, Widget?, Stream(View_approval)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_approval_w(Id, W, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w(Id, _, [], Done, Gs, Gs1?, Ds?) :- run_approval_w_grants(Gs?, Gs1), run_end(Id?, Done?, Ds).

procedure run_approval_w_more(Integer?, Widget?, View_approval?, Stream(View_approval)?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_approval_w_more(Id, _, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_approval_w_more(Id, W, _, [V | Vs], Done, Gs, Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w_more(Id, W, V, Vs, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w_more(Id, W, V, Vs, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_approval_w_more(Id?, W?, V?, Vs?, Done?, Gs?, Gs1, Ds).
run_approval_w_more(Id, W, V, [], Done, Gs, Gs1?, Ds?) :- run_approval_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_approval_w_last(Integer?, Widget?, View_approval?, Done?, Inputs(Drawn)?, Inputs(Drawn), Stream(Draw(Drawn))).
run_approval_w_last(Id, _, _, done, Gs, Gs?, [withdraw(Id?)]).
run_approval_w_last(Id, W, V, Done, [refresh | Gs], Gs1?, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).
run_approval_w_last(Id, W, V, Done, [input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?], Ds?) :- run_approval_w_last(Id?, W?, V?, Done?, Gs?, Gs1, Ds).

procedure run_approval_w_grants(Inputs(Drawn)?, Inputs(Drawn)).
run_approval_w_grants([input(I, P, R) | Gs], [input(I?, P?, R?) | Gs1?]) :- run_approval_w_grants(Gs?, Gs1).
run_approval_w_grants([refresh | Gs], Gs1?) :- run_approval_w_grants(Gs?, Gs1).

