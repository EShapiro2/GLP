procedure respond1(Attempt?, List(Word)?, Close?, Stream(Trigger), Approval, Stream(Ask(Question))).
respond1(At, Ws, Cl, Out?, approval(At?, Ws?, YN), []) :- ground(At?) | await(At?, YN?, Cl?, Out).

procedure respond_whole(Attempt?, List(Word)?, Close?, Stream(Trigger), Stream(Ask(Question))).
respond_whole(At, Ws, Cl, Out?, D?) :- ground(Ws?) | respond(At?, Ws?, Cl?, Out, D).

procedure await(Attempt?, YesNo?, Close?, Stream(Trigger)).
await(At, yes, _, [answered(At?, yes)]).
await(At, no, _, [answered(At?, no)]).
await(_, _, close, []).

procedure greet(Peer?, Proposal?, List(Word)?, Stream(Trigger), Stream(Ask(Question))).
