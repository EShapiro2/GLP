intro_pend1(yes, S, Ns0, Pe, _, In, ic(S?, Ns0?, Pe?), In?).
intro_pend1(no, S, Ns0, Pe, Id, In, Ic?, In1?) :- ground(S?) | introduction_preds(E), named_by(E?, S?, Id?, Ns1), dedup(Ns1?, Ns2), sort_peers(Ns2?, Ns), intro_pend2(Ns?, Ns0?, Pe?, S?, In?, Ic, In1).

