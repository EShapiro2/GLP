procedure atom_of(GAtom?, Shown).
atom_of(g(identity, []), shown(identity)).
atom_of(g(knows, [p(V1)]), shown(knows(V1?))).
atom_of(g(friend, [p(V1)]), shown(friend(V1?))).
atom_of(g(item, [s(V1)]), shown(item(V1?))).
atom_of(_, unshown) :- otherwise | true.

procedure contract_schemas(Schemas).
contract_schemas([schema(establish, [], [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]), schema(acquaint, [], [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []), rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]), schema(introduce, [pvar('Carol')], [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar('Carol')])], []), rs(guarded, [atom(knows, [pvar('Carol')])], [], [atom(identity, []), atom(knows, [role(1)])], [])]), schema(befriend, [], [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(knows, [role(2)])], [atom(friend, [role(2)])]), rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(knows, [role(1)])], [atom(friend, [role(1)])])]), schema(unfriend, [], [rs(guarded, [], [atom(friend, [role(2)])], [atom(identity, [])], []), rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]), schema(sign, [svar(x)], [rs(guarded, [atom(item, [svar(x)])], [], [atom(identity, [])], [atom(item, [svar(x)])])]), schema(forward, [svar(x)], [rs(guarded, [], [], [atom(identity, []), atom(item, [svar(x)]), atom(friend, [role(2)])], []), rs(unguarded, [atom(item, [sgn(x, 1)])], [], [atom(identity, [])], [])])]).

procedure schema_entry(Constant?, Schema).
schema_entry(establish, schema(establish, [], [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])])).
schema_entry(acquaint, schema(acquaint, [], [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []), rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])).
schema_entry(introduce, schema(introduce, [pvar('Carol')], [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar('Carol')])], []), rs(guarded, [atom(knows, [pvar('Carol')])], [], [atom(identity, []), atom(knows, [role(1)])], [])])).
schema_entry(befriend, schema(befriend, [], [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(knows, [role(2)])], [atom(friend, [role(2)])]), rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(knows, [role(1)])], [atom(friend, [role(1)])])])).
schema_entry(unfriend, schema(unfriend, [], [rs(guarded, [], [atom(friend, [role(2)])], [atom(identity, [])], []), rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])])).
schema_entry(sign, schema(sign, [svar(x)], [rs(guarded, [atom(item, [svar(x)])], [], [atom(identity, [])], [atom(item, [svar(x)])])])).
schema_entry(forward, schema(forward, [svar(x)], [rs(guarded, [], [], [atom(identity, []), atom(item, [svar(x)]), atom(friend, [role(2)])], []), rs(unguarded, [atom(item, [sgn(x, 1)])], [], [atom(identity, [])], [])])).
schema_entry(Nm, schema(Nm?, [], [])) :- otherwise | true.

procedure schema_numeric(Constant?, Numeric).
schema_numeric(establish, numeric([cj(every, true)], [], [])).
schema_numeric(acquaint, numeric([cj(every, true)], [], [])).
schema_numeric(introduce, numeric([cj(every, true)], [], [])).
schema_numeric(befriend, numeric([cj(every, true)], [], [])).
schema_numeric(unfriend, numeric([cj(every, true)], [], [])).
schema_numeric(sign, numeric([cj(every, true)], [], [])).
schema_numeric(forward, numeric([cj(every, true)], [], [])).
