form_holds(fforall(_, _, A, F, Gs), B, Sh, R?) :- ground(Sh?), ground(F?), ground(Gs?) | match_into(A?, Sh?, B?, Bs), all_hold(Bs?, F?, Gs?, Sh?, R).
form_holds(fcons(C), B, Sh, R?) :- ground(B?) | con_counted(C?, B?, Sh?, C1), con_holds(C1?, B?, R).

