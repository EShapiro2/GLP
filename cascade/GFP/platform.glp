procedure reflexive_preds(Preds).
reflexive_preds([]).

procedure introduction_preds(Preds).
introduction_preds([]).

procedure binding_of(Class?, Constant, Binding).
binding_of(establish(V1), establish, [b(role(1), p(V1?))]).
binding_of(acquaint(V1, V2), acquaint, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(introduce(V1, V2, V3), introduce, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(pvar('Carol'), p(V3?))]).
binding_of(befriend(V1, V2), befriend, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(unfriend(V1, V2), unfriend, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(sign(V1, V2), sign, [b(role(1), p(V1?)), b(svar(x), s(V2?))]).
binding_of(forward(V1, V2, V3), forward, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(x), s(V3?))]).

procedure class_of(Constant?, Binding?, Peer?, Class).
class_of(establish, B, D, establish(V1?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1).
class_of(acquaint, B, D, acquaint(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(introduce, B, D, introduce(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(pvar('Carol'), B?, D?, V3).
class_of(befriend, B, D, befriend(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(unfriend, B, D, unfriend(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(sign, B, D, sign(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_speech(svar(x), B?, D?, V2).
class_of(forward, B, D, forward(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(x), B?, D?, V3).

procedure name_class(Proposal?, GAtoms?, Class).
name_class(establish(V1), _, establish(V1?)).
name_class(acquaint(V1, V2), _, acquaint(V1?, V2?)).
name_class(introduce(V1, V2, V3), _, introduce(V1?, V2?, V3?)).
name_class(befriend(V1, V2), _, befriend(V1?, V2?)).
name_class(unfriend(V1, V2), _, unfriend(V1?, V2?)).
name_class(sign(V1, V2), _, sign(V1?, V2?)).
name_class(forward(V1, V2, V3), _, forward(V1?, V2?, V3?)).

procedure request_name(Class?, PName).
request_name(establish(V1), pname(establish(V1?))).
request_name(acquaint(V1, V2), pname(acquaint(V1?, V2?))).
request_name(introduce(V1, V2, V3), pname(introduce(V1?, V2?, V3?))).
request_name(befriend(V1, V2), pname(befriend(V1?, V2?))).
request_name(unfriend(V1, V2), pname(unfriend(V1?, V2?))).
request_name(sign(V1, V2), pname(sign(V1?, V2?))).
request_name(forward(V1, V2, V3), pname(forward(V1?, V2?, V3?))).
request_name(_, nopname) :- otherwise | true.

procedure tabs(List(Tab)).
tabs([tab('Contacts', knows), tab('Friends', friend), tab('Items', item)]).

procedure sentence_of(Class?, Peer?, Asked).
sentence_of(acquaint(V1, V2), Me, Ws?) :- ground(V2?), ground(V1?), ground(Me?) | ask_of([q(V2?, 1, [person(V1?), text(' wishes that you know each other.')])], Me?, Ws).
sentence_of(introduce(V1, V2, V3), Me, Ws?) :- ground(V2?), ground(V1?), ground(V3?), ground(Me?) | ask_of([q(V2?, 1, [person(V1?), text(' asks to introduce '), person(V3?), text(' to you.')])], Me?, Ws).
sentence_of(befriend(V1, V2), Me, Ws?) :- ground(V2?), ground(V1?), ground(Me?) | ask_of([q(V2?, 1, [person(V1?), text(' asks to be your friend.')])], Me?, Ws).
sentence_of(_, _, asked(0, [])) :- otherwise | true.

exported procedure contract(String, Exported).
contract('GFP: Grassroots Forwarding with Provenance\nGFP extends GSG.\nAlice and Bob are persons.  The author of an item is its first signer.\n1. ■ Signing.  Alice may create an item by signing it.\n2. ■ Forwarding.  Alice may forward an item she holds to her friend Bob, adding her signature to the signatures the item carries; Bob sees them.', with([schema(establish, ['Alice'], [], [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]), schema(acquaint, ['Alice', 'Bob'], [], [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []), rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]), schema(introduce, ['Alice', 'Bob'], [pvar('Carol')], [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar('Carol')])], []), rs(guarded, [atom(knows, [pvar('Carol')])], [], [atom(identity, []), atom(knows, [role(1)])], [])]), schema(befriend, ['Alice', 'Bob'], [], [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(knows, [role(2)])], [atom(friend, [role(2)])]), rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(knows, [role(1)])], [atom(friend, [role(1)])])]), schema(unfriend, ['Alice', 'Bob'], [], [rs(guarded, [], [atom(friend, [role(2)])], [atom(identity, [])], []), rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]), schema(sign, ['Alice'], [svar(x)], [rs(guarded, [atom(item, [svar(x)])], [], [atom(identity, [])], [atom(item, [svar(x)])])]), schema(forward, ['Alice', 'Bob'], [svar(x)], [rs(guarded, [], [], [atom(identity, []), atom(item, [svar(x)]), atom(friend, [role(2)])], []), rs(unguarded, [atom(item, [sgn(x, 1)])], [], [atom(identity, [])], [])])], pragmas([list('Contacts', [knows]), list('Friends', [friend]), list('Items', [item])], [act(establish, 'Establish', [], none, 'Contacts', by([1])), act(acquaint, 'Acquaint', ['', person], said([[], [person(1), text(' wishes that you know each other.')]]), 'Contacts', by([1])), act(introduce, 'Introduce', [], said([[], [person(1), text(' asks to introduce '), person(3), text(' to you.')]]), 'Contacts', by([1])), act(befriend, 'Befriend', [], said([[], [person(1), text(' asks to be your friend.')]]), 'Friends', by([1])), act(unfriend, 'Unfriend', [], none, 'Friends', by([1])), act(sign, 'Sign', ['', text], none, 'Items', by([1])), act(forward, 'Forward', [], none, 'Items', by([1]))], [], nolook, version(1, 1)))).

exported procedure version(Integer, Integer).
version(1, 1).

procedure meeting_peer(Proposal?, Peer?, MeetPeer).
meeting_peer(acquaint(V1, V2), Me, P?) :- ground(V1?), ground(V2?), ground(Me?) | meet_other(V1?, V2?, Me?, P).
meeting_peer(_, _, nopeer) :- otherwise | true.

exported procedure agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output), Stream(Ask(Question))).
agent(Id, NetIn, Out?, [view(Id?, [], [], [], Ts?) | Thr?], D?) :- ground(Id?) | tabs(Ts), request(Rq, D1), tag_net(NetIn?, Nt), merge(Rq?, Nt?, M1), merge(M1?, Ans?, M2), merge(M2?, [own | Ow?], In), agent_goal([], In?, yes, Ans, Thr, Out, Ow, [], [], st(Id?, app([], 0, unlocked, []), 0, [], [], [], [], [], [], [], [], [], ix(nil, [], [], ic([], [], [])), []), D2), merge(D1?, D2?, D).

procedure request(Stream(Trigger), Stream(Ask(Question))).
request(S1?, [ask('Request?', request_r(X)) | D?]) :- request1(S1, X?, D).

procedure request1(Stream(Trigger), Request?, Stream(Ask(Question))).
request1(Out?, R, []) :- await_request(R?, Out).

procedure await_request(Request?, Stream(Trigger)).
await_request(propose(C), [req(propose(C?))]).

procedure ask_next(Stream(Trigger), Stream(Trigger)?, Stream(Ask(Question))).
ask_next(Ans?, Ans1, D?) :- request(R, D), merge(R?, Ans1?, Ans).

procedure tag_net(Stream(Net)?, Stream(Trigger)).
tag_net([M | Ms], [net(M?) | Ts?]) :- tag_net(Ms?, Ts).
