agent_goal([T | Ls], In, U, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- then_local(U?, Th), step(T?, Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
