%% ---------------------------------------------------------------------------
%% GB.glp --- the grassroots bonds contract, Currencies' (a contract is its
%% platform's paper's; Coordination Appendix C), in the clause syntax of
%% GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint,
%% Guards), as programs/gsc/README.md reads it, with the values speech-act
%% schemas allow (GSC, Section 3.2; GB, Appendix A); its types, SSchema,
%% SContract and SDeclared, are the root's (programs/self.glp), declared
%% once for every contract (GSC, 2026-11-09, no duplicate content).  The clauses are in
%% GB.txt beside this file.  GB extends GC, Grassroots Coins,
%% Currencies' (programs/currencies/coins/GC.glp), and through it GKK,
%% GSC's (programs/gsc/GKK.glp) (Udi, 2026-11-09, to Currencies #17): the
%% term holds GKK's three schemas, establish, acquaint and introduce, and
%% GC's four, mint, swap, pay and redeem, as GC.glp has them, and adds
%% GB's own over bonds.  A bond is not a coin; a matured bond is redeemed
%% against a coin or a bond its issuer holds (GB:4).  Establish forbids
%% the identity it adds (GKK:1, act once), and every other role requires
%% identity.  The parties to a swap and to each escrow transfer know each
%% other, and pay and redeem require knows(q) at p.  The redeem of a bond
%% presents a bond mature by its issuer's date, and the issuer's role
%% reads its own date and changes state.  A coin or a bond carries its
%% issuer's public key, so whoever holds one knows its issuer (GB,
%% Section 3.1): swap, redeem, release and return add knows of the issuer
%% of what a role receives at that role, and pay adds none, the payee
%% receiving coins of their own issue.
%%
%% The predicates are GKK's identity and knows, GC's coin, and four of GB's own.
%% coin(u) at p is a coin issued by u and held by p, GC's, and bond(u, d)
%% a bond issued by u maturing at the day d: only a bond has a maturity
%% date, and a matured bond is redeemed against a coin (Udi, 2026-11-09).  A schema that takes a
%% coin or a bond is written once for each kind it gives and takes, since the
%% term form has no value for "no date": swap and redeem four times, GC's
%% for coins and GB's cb, bc and bb, the instrument given and the one taken,
%% deposit, release and return twice (c, b), and mint twice, GC's for a
%% coin and GB's mint_bond; the schemas of one act
%% share its button (GB.txt, Pragmas; asked of GSC, 2026-10-24).
%% date(t) at p is p's date, dated that p has one, and today(d) at p is the
%% day, an environment predicate of GSC's language, declared by
%% environment([today], Contract) (GSC, 2026-10-25), which the platform
%% writes from the device's calendar and no schema adds or deletes (vGLP,
%% Section 5.4; Udi, 2026-10-24): first_date gives p
%% the day as their date once, dated forbidding a second, and advance takes
%% the date to the next day while the day is not past; so GB:2 is realised
%% by two unguarded schemas and the calendar.  Each atom carries its holder
%% first, a role by its name in Names, and a value argument x is num(x),
%% listed in Vars, beside the party variables, in the order of the paper's
%% head.  A multiplicity k on an atom A added or deleted is
%% times(num(k), A), and a multiplicity is a positive whole number (GSC,
%% 2026-10-23), so the schemas carry no constraint on amounts.  The
%% constraint is a conjunction, and(C1, C2), of gt(X, Y), le(X, Y) and
%% succ(X, Y) (Y = X + 1), or true (GSC, Definition Schema with values: a
%% conjunction of linear equalities and inequalities).  A number names no person, so the three conditions concern
%% the persons a schema names; first_date and advance name none.
%%
%% The twenty-two terms of GB are GKK's three, GC's four, and GB's fifteen:
%% mint_bond, first_date, advance, the three swaps and three redeems with a
%% bond, and the six escrow transfers.  The head holds, role by role, the
%% atoms the role adds and then those it deletes, negated; the body, role by
%% role, the atoms it deletes, those it keeps, and those it forbids, negated;
%% Guards the roles that must will the act.  The roles are named by the
%% clause's names (GSC #8, 2026-10-25; Udi approving), so that a pragma's
%% name maps to its role; u, v, r are party variables, in Names after the
%% roles; d, d1, k, k1, t, t1 are value variables.  Each
%% comment below names the clause a schema realises.  The beneficiary and
%% the condition of an escrow (GB:5) are the escrow agreement's, held
%% by the escrow agent, and name no role of a transfer (GB, Section 5).
%% GB extends GC, GC's schemas under GC's names, and the escrow clause
%% GB:5, by Currencies #17 Cowork, 2026-11-09.
%% Written by Currencies #11 Cowork, 2026-10-20; rewritten by Currencies
%% #12 Cowork, 2026-10-23, first_date and today added 2026-10-24, and coin and bond two predicates again the same day; knows of the issuer at the receiving roles, Currencies #13 Cowork, 2026-10-25; in the clause syntax, the root's types in place of a copy of them, the schemas unchanged, Currencies #18, 2026-11-11.
%% ---------------------------------------------------------------------------

%% contract_named(gb, C): the contract, GB (Coordination Appendix C).
procedure contract_named(Constant?, SDeclared).
contract_named(gb, environment([today],
   [
    %% GKK:1, Identity: act once, so establish forbids the identity it adds.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))],
       true,
       ['Alice']),
    %% GKK:2, Acquaintance.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(identity, ['Bob'])],
       true,
       ['Alice', 'Bob']),
    %% GKK:3, Introduction: p, who knows q and c, introduces c to q, who knows p.
    sas(introduce, ['Alice', 'Bob', c], [c],
       [atom(knows, ['Bob', c])],
       [atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Alice', c]),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
    %% GC:1, Minting: p mints k p-coins; GC's mint.
    sas(mint, ['Alice'], [k],
       [times(num(k), atom(coin, ['Alice', 'Alice']))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
    %% GB:1, Minting: p mints k p-bonds maturing at d, later than p's date t.
    sas(mint_bond, ['Alice'], [d, k, t],
       [times(num(k), atom(bond, ['Alice', 'Alice', num(d)]))],
       [atom(identity, ['Alice']),
        atom(date, ['Alice', num(t)])],
       gt(num(d), num(t)),
       ['Alice']),
    %% GB:2, Date: p's first date is the day, once; no role guards it.
    sas(first_date, ['Alice'], [d],
       [atom(date, ['Alice', num(d)]),
        atom(dated, ['Alice'])],
       [atom(identity, ['Alice']),
        atom(today, ['Alice', num(d)]),
        not(atom(dated, ['Alice']))],
       true,
       []),
    %% GB:2, Date: p's date advances to the next day, not past the day; no role guards it.
    sas(advance, ['Alice'], [t, t1, d],
       [atom(date, ['Alice', num(t1)]),
        not(atom(date, ['Alice', num(t)]))],
       [atom(date, ['Alice', num(t)]),
        atom(identity, ['Alice']),
        atom(today, ['Alice', num(d)])],
       and(succ(num(t), num(t1)), le(num(t1), num(d))),
       []),
    %% GC:2, Swap: p and q, who know each other, swap k coins of u for k1 coins of v; each comes to know the issuer of what they receive; GC's swap.
    sas(swap, ['Alice', 'Bob', u, v], [u, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
    %% GB:3, Swap: k coins of u for k1 bonds of v maturing at d1.
    sas(swap_cb, ['Alice', 'Bob', u, v], [u, k, v, d1, k1],
       [times(num(k1), atom(bond, ['Alice', v, num(d1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(bond, ['Bob', v, num(d1)])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(bond, ['Bob', v, num(d1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
    %% GB:3, Swap: k bonds of u maturing at d for k1 coins of v.
    sas(swap_bc, ['Alice', 'Bob', u, v], [u, d, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(bond, ['Alice', u, num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(d)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(bond, ['Alice', u, num(d)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
    %% GB:3, Swap: k bonds of u maturing at d for k1 bonds of v maturing at d1.
    sas(swap_bb, ['Alice', 'Bob', u, v], [u, d, k, v, d1, k1],
       [times(num(k1), atom(bond, ['Alice', v, num(d1)])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(bond, ['Alice', u, num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(d)])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(bond, ['Bob', v, num(d1)])))],
       [times(num(k), atom(bond, ['Alice', u, num(d)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(bond, ['Bob', v, num(d1)])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
    %% GC:3, Payment: p pays k q-coins to q, whom p knows; GC's pay.
    sas(pay, ['Alice', 'Bob'], [k],
       [not(times(num(k), atom(coin, ['Alice', 'Bob']))),
        times(num(k), atom(coin, ['Bob', 'Bob']))],
       [times(num(k), atom(coin, ['Alice', 'Bob'])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
    %% GC:4, Redemption: p redeems a q-coin against a coin of r held by q, whom p knows; p comes to know r; GC's redeem.
    sas(redeem, ['Alice', 'Bob', r], [r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(coin, ['Bob', r]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
    %% GB:4, Redemption: p redeems a q-coin against a bond of r maturing at d1 held by q.
    sas(redeem_cb, ['Alice', 'Bob', r], [r, d1],
       [atom(bond, ['Alice', r, num(d1)]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(bond, ['Bob', r, num(d1)]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(bond, ['Bob', r, num(d1)]),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
    %% GB:4, Redemption: p redeems a q-bond maturing at d, mature by q's date t, against a coin of r held by q.
    sas(redeem_bc, ['Alice', 'Bob', r], [d, r, t],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(bond, ['Alice', 'Bob', num(d)])),
        atom(bond, ['Bob', 'Bob', num(d)]),
        not(atom(coin, ['Bob', r]))],
       [atom(bond, ['Alice', 'Bob', num(d)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob']),
        atom(date, ['Bob', num(t)])],
       le(num(d), num(t)),
       ['Alice']),
    %% GB:4, Redemption: p redeems a matured q-bond maturing at d against a bond of r maturing at d1 held by q.
    sas(redeem_bb, ['Alice', 'Bob', r], [d, r, d1, t],
       [atom(bond, ['Alice', r, num(d1)]),
        atom(knows, ['Alice', r]),
        not(atom(bond, ['Alice', 'Bob', num(d)])),
        atom(bond, ['Bob', 'Bob', num(d)]),
        not(atom(bond, ['Bob', r, num(d1)]))],
       [atom(bond, ['Alice', 'Bob', num(d)]),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(bond, ['Bob', r, num(d1)]),
        atom(identity, ['Bob']),
        atom(date, ['Bob', num(t)])],
       le(num(d), num(t)),
       ['Alice']),
    %% GB:5, Escrow: p deposits k coins of u with the escrow agent e; they know each other, and e comes to know u.
    sas(deposit_c, ['Alice', 'Carol', u], [u, k],
       [not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Carol', u])),
        atom(knows, ['Carol', u])],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Carol']),
        atom(knows, ['Carol', 'Alice'])],
       true,
       ['Alice', 'Carol']),
    %% GB:5, Escrow: p deposits k bonds of u maturing at d with the escrow agent e; they know each other.
    sas(deposit_b, ['Alice', 'Carol', u], [u, d, k],
       [not(times(num(k), atom(bond, ['Alice', u, num(d)]))),
        times(num(k), atom(bond, ['Carol', u, num(d)])),
        atom(knows, ['Carol', u])],
       [times(num(k), atom(bond, ['Alice', u, num(d)])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Carol']),
        atom(knows, ['Carol', 'Alice'])],
       true,
       ['Alice', 'Carol']),
    %% GB:5, Escrow: e releases k coins of u to q; they know each other, and q comes to know u.
    sas(release_c, ['Carol', 'Bob', u], [u, k],
       [not(times(num(k), atom(coin, ['Carol', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u])],
       [times(num(k), atom(coin, ['Carol', u])),
        atom(identity, ['Carol']),
        atom(knows, ['Carol', 'Bob']),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Carol'])],
       true,
       ['Carol', 'Bob']),
    %% GB:5, Escrow: e releases k bonds of u maturing at d to q; they know each other.
    sas(release_b, ['Carol', 'Bob', u], [u, d, k],
       [not(times(num(k), atom(bond, ['Carol', u, num(d)]))),
        times(num(k), atom(bond, ['Bob', u, num(d)])),
        atom(knows, ['Bob', u])],
       [times(num(k), atom(bond, ['Carol', u, num(d)])),
        atom(identity, ['Carol']),
        atom(knows, ['Carol', 'Bob']),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Carol'])],
       true,
       ['Carol', 'Bob']),
    %% GB:5, Escrow: e returns k coins of u to the depositor p; they know each other, and p comes to know u.
    sas(return_c, ['Carol', 'Alice', u], [u, k],
       [not(times(num(k), atom(coin, ['Carol', u]))),
        times(num(k), atom(coin, ['Alice', u])),
        atom(knows, ['Alice', u])],
       [times(num(k), atom(coin, ['Carol', u])),
        atom(identity, ['Carol']),
        atom(knows, ['Carol', 'Alice']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Carol'])],
       true,
       ['Carol', 'Alice']),
    %% GB:5, Escrow: e returns k bonds of u maturing at d to the depositor p; they know each other.
    sas(return_b, ['Carol', 'Alice', u], [u, d, k],
       [not(times(num(k), atom(bond, ['Carol', u, num(d)]))),
        times(num(k), atom(bond, ['Alice', u, num(d)])),
        atom(knows, ['Alice', u])],
       [times(num(k), atom(bond, ['Carol', u, num(d)])),
        atom(identity, ['Carol']),
        atom(knows, ['Carol', 'Alice']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Carol'])],
       true,
       ['Carol', 'Alice'])])).
