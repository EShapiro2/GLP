%% The interface of the canonical CVA platform of GSG in sGLP's term form
%% (programs/sglp/README.md, "The term form"), printed by programs/sglp/cva/interface.sh
%% from platform.vglp and platform.glp beside it: the types the platform defines
%% and those of the root it names, its volitional procedure declarations, and
%% compiled(P, N) of each procedure of its canonical compilation.  An owner's
%% sGLP source is transformed against it (programs/sglp/transform.sh --interface).

exported procedure interface(SglpTerms).
interface([
  type('Class', [establish('Peer'), meet('Peer', 'Peer'), introduce('Peer', 'Peer', 'Peer'), befriend('Peer', 'Peer'), unfriend('Peer', 'Peer')]),
  type('Proposal', [establish('Peer'), meet('Peer', 'Peer'), introduce('Peer', 'Peer', 'Peer'), befriend('Peer', 'Peer'), unfriend('Peer', 'Peer')]),
  type('Request', [propose('Proposal')]),
  type('Atom', [identity, knows('Peer'), friend('Peer')]),
  type('Peer', ['Key']),
  type('Speech', [speech('Utterance', 'Peer')]),
  type('Utterance', [utterance('String'), 'Speech']),
  type('YesNo', [yes, no]),
  type('Reason', [declined, unable, unable('List'('Atom'), 'List'('Atom'))]),
  type('Vote', [yes, no('Reason')]),
  type('Decision', [commit, abort('Peer', 'Reason'), yield]),
  type('Rho', [one('Class'), rho('Proposal')]),
  type('Names', [none, request('Rho', 'Integer')]),
  type('Attempt', [attempt('Peer', 'Integer', 'Integer', 'Class', 'Names')]),
  type('Cargo', [start('Attempt'), vote('Attempt', 'Vote'), outcome('Attempt', 'Decision'), yield('Attempt'), request('Rho', 'Integer')]),
  type('Content', [hello('Peer', 'Proposal'), ihello('Peer'), intro('Peer', 'Peer'), cargo('Peer', 'Cargo')]),
  type('Net', [msg('Peer', 'Content')]),
  type('Asking', ['Attempt', hello('Peer', 'Proposal')]),
  type('Approval', [approval('Asking', 'List'('Word'), dual('YesNo'))]),
  type('Word', [text('String'), person('Peer')]),
  type('RoleAsk', [q('Peer', 'List'('Word'))]),
  type('Menu', [menu('Key', 'List'('Key'), dual('Request'))]),
  type('Close', [close]),
  type('Trigger', [req('Request'), again('Proposal'), greeted('Proposal'), net('Net'), answered('Attempt', 'YesNo'), recheck, own, day('Integer')]),
  type('MeetPeer', [peer('Peer'), nopeer]),
  type('Var', [role('Integer'), pvar('Constant'), svar('Constant'), sgn('Constant', 'Integer'), nterm('NTerm'), num('Constant')]),
  type('NTerm', [own('Integer'), own_var('Constant'), ext('NTerm', 'Constant')]),
  type('Vars', [[], ['Var' | 'Vars']]),
  type('SAtom', [atom('Constant', 'Vars'), times('Var', 'SAtom')]),
  type('SAtoms', [[], ['SAtom' | 'SAtoms']]),
  type('Guard', [guarded, unguarded]),
  type('RoleSpec', [rs('Guard', 'SAtoms', 'SAtoms', 'SAtoms', 'SAtoms')]),
  type('RoleSpecs', [[], ['RoleSpec' | 'RoleSpecs']]),
  type('Schema', [schema('Constant', 'Vars', 'RoleSpecs'), lschema('Constant', 'Vars', 'RoleSpecs', 'Listings')]),
  type('Listing', [listing('Integer', 'Integer', 'Constant', 'Vars')]),
  type('Listings', [[], ['Listing' | 'Listings']]),
  type('PeerLists', [[], ['Peers' | 'PeerLists']]),
  type('ListTuples', [[], ['PeerLists' | 'ListTuples']]),
  type('Schemas', [[], ['Schema' | 'Schemas']]),
  type('Preds', [[], ['Constant' | 'Preds']]),
  type('Constraint', [true, and('Constraint', 'Constraint'), eq('Expr', 'Expr'), le('Expr', 'Expr'), lt('Expr', 'Expr'), ge('Expr', 'Expr'), gt('Expr', 'Expr'), succ('Var', 'Var'), or('Constraint', 'Constraint')]),
  type('Expr', ['Var', plus('Expr', 'Expr'), minus('Expr', 'Expr'), mul('Expr', 'Expr')]),
  type('CRole', [every, at('Integer')]),
  type('Numeric', [numeric('Constraint', 'Vars', 'CRole')]),
  type('NumRes', [num_is('Integer'), no_num]),
  type('LNorm', [norm('Binding'), badnorm]),
  type('CName', [community('Peer'), dot('CName', 'Speech')]),
  type('Val', [p('Peer'), s('Speech'), c('CName'), n('Integer'), lv('Constant', 'Constant')]),
  type('NameParts', [parts('Vars', 'Vals'), noparts]),
  type('Vals', [[], ['Val' | 'Vals']]),
  type('GAtom', [g('Constant', 'Vals')]),
  type('GAtoms', [[], ['GAtom' | 'GAtoms']]),
  type('Approved', ['Proposal']),
  type('Output', [view('List'('Atom'), 'List'('Key'), 'List'('Approved'), 'List'('Tab')), refused('Approved', 'Key', 'Reason')]),
  type('Tab', [tab('String', 'Constant')]),
  type('Shown', [shown('Atom'), unshown]),
  type('Bind', [b('Var', 'Val')]),
  type('Binding', [[], ['Bind' | 'Binding']]),
  type('Bindings', [[], ['Binding' | 'Bindings']]),
  type('Found', [found('Val'), free]),
  type('Match', [match('Binding'), nomatch]),
  type('SgnParts', [signed('Val', 'Peer'), unsigned]),
  type('Peers', [[], ['Peer' | 'Peers']]),
  type('Nets', [[], ['Net' | 'Nets']]),
  type('Ints', [[], ['Integer' | 'Ints']]),
  type('Delta', [delta('Peer', 'GAtoms', 'GAtoms')]),
  type('Deltas', [[], ['Delta' | 'Deltas']]),
  type('Mate', [mate('Constant', 'Binding', 'Peers', 'Peer')]),
  type('Mates', [[], ['Mate' | 'Mates']]),
  type('Opener', [opener('Peer'), guarded_part]),
  type('Part', [pt('Class', 'Peers', 'Opener')]),
  type('Parts', [[], ['Part' | 'Parts']]),
  type('Info', [ci('Class', 'Deltas', 'Peers', 'Parts', 'Mates')]),
  type('Infos', [[], ['Info' | 'Infos']]),
  type('ClassRes', [cls('Info'), nocls]),
  type('CVal', [cmp_val('Val'), cmp_free('Var')]),
  type('CVals', [[], ['CVal' | 'CVals']]),
  type('CAtom', [cmp_atom('Constant', 'CVals')]),
  type('CAtoms', [[], ['CAtom' | 'CAtoms']]),
  type('Lock', [unlocked, held('Attempt')]),
  type('Rec', [asked('Attempt'), answered('Attempt', 'YesNo'), voted('Attempt', 'YesNo'), got('Attempt', 'Peer', 'YesNo'), closed('Attempt'), wounded('Attempt'), yielded('Attempt'), requested('Rho', 'Integer'), ended('Rho', 'Integer'), ended('Attempt'), introduced('Peer', 'Peer')]),
  type('Recs', [[], ['Rec' | 'Recs']]),
  type('App', [app('GAtoms', 'Integer', 'Lock', 'Recs')]),
  type('Pend', [deferred('Net')]),
  type('Pends', [[], ['Pend' | 'Pends']]),
  type('WKey', [op('Class'), vt('Attempt'), cm('Attempt'), wd('Attempt', 'Attempt'), ip('Peer', 'Peer')]),
  type('Wait', [w('WKey', 'Integer')]),
  type('Waits', [[], ['Wait' | 'Waits']]),
  type('WFound', [at('Integer'), unseen]),
  type('Held', [held('Peer', 'Rho', 'Integer')]),
  type('Helds', [[], ['Held' | 'Helds']]),
  type('Rhos', [[], ['Rho' | 'Rhos']]),
  type('Tag', [a('Peer'), r('Rho')]),
  type('Tags', [[], ['Tag' | 'Tags']]),
  type('Trie', [nil, t('Tags', 'Trie', 'Trie')]),
  type('Attempts', [[], ['Attempt' | 'Attempts']]),
  type('IC', [ic('GAtoms', 'Peers', 'Pairs')]),
  type('Ix', [ix('Trie', 'Attempts', 'Recs', 'IC')]),
  type('Fate', [keep, move, intro]),
  type('Kn', [kn('Peers', 'Peers', 'Peers', 'Peers')]),
  type('V', [v('Peer', 'GAtoms', 'Lock', 'Recs', 'Pends', 'Kn')]),
  type('Proposals', [[], ['Proposal' | 'Proposals']]),
  type('St', [st('Peer', 'App', 'Integer', 'Peers', 'Peers', 'Peers', 'Peers', 'Waits', 'Infos', 'Pends', 'Rhos', 'Helds', 'Ix', 'Proposals')]),
  type('OpenApproval', [oc('Attempt', dual('Close'))]),
  type('OpenApprovals', [[], ['OpenApproval' | 'OpenApprovals']]),
  type('Send', [to('Peer', 'Cargo')]),
  type('Sends', [[], ['Send' | 'Sends']]),
  type('Subj', [sub('Info'), pair, prop('Info', 'Class', 'Names')]),
  type('Cand', [cand('WKey', 'Subj')]),
  type('Cands', [[], ['Cand' | 'Cands']]),
  type('Choice', [take('WKey', 'Subj'), none]),
  type('Pair', [pr('Peer', 'Peer')]),
  type('Pairs', [[], ['Pair' | 'Pairs']]),
  type('PKey', [key('WKey'), nokey]),
  type('Cond', [go('Info'), drop]),
  type('PCond', [pgo('Info', 'Class', 'Names'), pdrop]),
  type('RCond', [rgo('Rho', 'Peer'), rdrop, rhold('Proposal'), rrefuse('Proposal')]),
  type('RQ', [rq('RCands', 'YesNo', 'YesNo')]),
  type('RCand', [rc('Rho', 'Peer')]),
  type('RCands', [[], ['RCand' | 'RCands']]),
  type('PName', [pname('Proposal'), nopname]),
  type('PartRes', [part('Part'), nopart]),
  type('Mine', [mine('Rho', 'Integer'), notmine]),
  type('Outputs', [[], ['Output' | 'Outputs']]),
  type('Classes', [[], ['Class' | 'Classes']]),
  type('MCond', [mgo('Info'), mdefer, mhold, noparticipant]),
  type('Blocker', [blk('Attempt'), noblk]),
  type('FoundNet', [found('Net'), nonefound]),
  type('Last', [last('Attempt'), nolast]),
  type('Known', [allknown, unknown('Peer')]),
  type('Then', [write_own, own_unread, no_own]),
  type('ApprovalRes', [approval_for('Attempt'), noapproval]),
  type('Appr', [ap('Info', 'PartsOf')]),
  type('Apprs', [[], ['Appr' | 'Apprs']]),
  type('PartsOf', [by_name('Class'), any_part]),
  type('Stream'('X'), [[], ['X' | 'Stream'('X')]]),
  type('List'('X'), [[], ['X' | 'List'('X')]]),
