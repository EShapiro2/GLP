 sas(arrive, ['Alice', 'Bob'], [], [not(atom(fare_locked, ['Alice'])), not(atom(deposit_locked, ['Bob'])), not(atom(ride, ['Alice'])), not(atom(ride, ['Bob'])), not(atom(rides_with, ['Alice', 'Bob'])), not(atom(rides_with, ['Bob', 'Alice'])), not(atom(pickup, ['Alice', '_'])), not(atom(pickup, ['Bob', '_'])), atom(released, ['Alice', 'Bob']), atom(released, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(at_destination, ['Alice', 'Bob']), atom(at_destination, ['Bob', 'Alice']), atom(fare_locked, ['Alice']), atom(deposit_locked, ['Bob']), atom(ride, ['Alice']), atom(ride, ['Bob']), atom(rides_with, ['Alice', 'Bob']), atom(rides_with, ['Bob', 'Alice'])], true, []),
