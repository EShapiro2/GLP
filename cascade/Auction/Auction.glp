 sas(point_friend, ['Alice', 'Bob'], [], [atom(points_to, ['Alice', 'Bob'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(points_to, ['Alice', 'Bob'])), atom(may_point_friend, ['Alice', 'Bob'])], true, ['Alice']),
 sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'], [atom(points_to, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Carol']), atom(points_to, ['Alice', 'Bob']), atom(points_to, ['Bob', 'Carol']), not(atom(points_to, ['Alice', 'Carol'])), atom(closer, ['Alice', 'Carol'])], true, ['Alice']),
 sas(unpoint, ['Alice', 'Bob'], ['Bob'], [not(atom(points_to, ['Alice', 'Bob']))], [atom(identity, ['Alice']), atom(points_to, ['Alice', 'Bob']), atom(bound, ['Alice', val('D')]), atom(furthest, ['Alice', 'Bob'])], gt(cardinality(['X1'], atom(points_to, ['Alice', 'X1']), true), val('D')), ['Alice']),
 sas(call, ['Alice'], ['Trip'], [atom(open_call, ['Alice', const('Trip')])], [atom(identity, ['Alice']), atom(rider, ['Alice']), not(atom(ride, ['Alice'])), not(atom(open_call, ['Alice', '_']))], true, ['Alice']),
 sas(send_call, ['Alice', 'Bob'], ['Trip'], [atom(sent_call, ['Alice', 'Bob', const('Trip')]), atom(call, ['Bob', 'Alice', const('Trip')]), atom(direct_call, ['Bob', 'Alice', const('Trip')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(open_call, ['Alice', const('Trip')]), atom(points_to, ['Alice', 'Bob']), not(atom(call, ['Bob', 'Alice', const('Trip')]))], true, []),
 sas(forward_call, ['Bob', 'Carol', 'Alice'], ['Alice', 'Trip'], [atom(forwarded, ['Bob', 'Alice', 'Carol', const('Trip')]), atom(call, ['Carol', 'Alice', const('Trip')])], [atom(identity, ['Bob']), atom(identity, ['Carol']), atom(direct_call, ['Bob', 'Alice', const('Trip')]), atom(points_to, ['Bob', 'Carol']), not(atom(forwarded, ['Bob', 'Alice', 'Carol', const('Trip')]))], true, []),
 sas(bid, ['Bob', 'Alice'], ['Trip'], [atom(bid, ['Bob', 'Alice', const('Trip')])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(driver, ['Bob']), atom(call, ['Bob', 'Alice', const('Trip')]), not(atom(period_ended, ['Alice', const('Trip')]))], true, ['Bob']),
 sas(award, ['Alice', 'Bob'], ['Trip'], [not(atom(open_call, ['Alice', const('Trip')])), atom(ride, ['Alice']), atom(ride, ['Bob']), atom(rides_with, ['Alice', 'Bob']), atom(rides_with, ['Bob', 'Alice']), atom(fare_locked, ['Alice']), atom(deposit_locked, ['Bob'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(period_ended, ['Alice', const('Trip')]), atom(bid, ['Bob', 'Alice', const('Trip')]), atom(selects, ['Alice', 'Bob', const('Trip')]), not(atom(ride, ['Bob'])), atom(open_call, ['Alice', const('Trip')])], true, ['Alice']),
