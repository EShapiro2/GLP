%% ---------------------------------------------------------------------------
%% GSNP.glp --- GSNP, Grassroots Social Network with Provenance, GAI's, its pragmas in GSNP.txt beside this file: GAI (GAI.glp beside this file) composed with GSN, GSC's (programs/gsc/GSN.glp), the composition amended (GSC's paper, Section Relations among Contracts).  A file cannot reach another's term, so the term is GAI's, an instance of GnW with GAI's bindings and GAI's six schemas, with the schemas of GSNP after them.
%% Twelve schemas beyond GAI's six: unfriend, GnW's for a person, also clearing every listing and membership between the two (GSN:3); message, GSN:1, an item its sender authored, the sender a person or an AI agent with a guardian; and GSN's groups, create, join, leave, remove and close, with post_own, post, post_forward, deliver and deliver_own carrying items, a group act a person's.  sign and forward are GFP's with the stronger body, as in GAI.glp.
%% Written by GAI #13 Cowork, 2026-11-10, on GnW as GSC has it, from GAI #12's term of 2026-11-08: person required where agent was forbidden, and no schema asking whether an agent is retired.
%% ---------------------------------------------------------------------------

% instance_named(gsnp, gnw, Bindings, Additions): the contract, GSNP.
procedure instance_named(Constant?, Constant, SBindings, SDeclared).
instance_named(gsnp, gnw,
   [ward = agent, creator = principal, created = principal_of,
    guardian_of = operator_of, guarded_by = operated_by, retired = retired_agent,
    ward_acquaint = agent_acquaint, ward_befriend = agent_befriend, ward_unfriend = agent_unfriend,
    ward_end = agent_end, wards_acquaint = agents_acquaint, wards_befriend = agents_befriend],
   [
%% GnW:1 with GAI:2, Creation: Alice creates the AI agent Carol with y, her attestation, an item she holds and authored; Carol holds it, and Alice its record.
    sas(enter, ['Alice', 'Carol'], [y],
       [atom(principal_of, ['Alice', 'Carol']), atom(operator_of, ['Alice', 'Carol']),
        atom(friend, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol']),
        atom(agent_of, ['Alice', 'Carol', y]),
        atom(identity, ['Carol']), atom(agent, ['Carol']), atom(principal, ['Carol', 'Alice']),
        atom(operated_by, ['Carol', 'Alice']),
        atom(friend, ['Carol', 'Alice']), atom(knows, ['Carol', 'Alice']),
        atom(attestation, ['Carol', y])],
       [atom(identity, ['Alice']),
        atom(person, ['Alice']), atom(item, ['Alice', y]),
        not(atom(identity, ['Carol']))],
       eq(author_of(y), 'Alice'), ['Alice', 'Carol']),
%% GnW:2 with GAI:2, Joint guardianship: Bob becomes a guardian and a friend of Carol, the two coming to know each other as GnW's make_guardian has it (GSC 00f45cb), and records her attestation y, which Alice, a guardian, holds recorded.
    sas(make_guardian, ['Bob', 'Alice', 'Carol', 'Erin'], [y],
       [atom(operator_of, ['Bob', 'Carol']), atom(friend, ['Bob', 'Carol']), atom(knows, ['Bob', 'Carol']),
        atom(agent_of, ['Bob', 'Carol', y]),
        atom(operated_by, ['Carol', 'Bob']), atom(friend, ['Carol', 'Bob']), atom(knows, ['Carol', 'Bob'])],
       [atom(identity, ['Bob']), atom(person, ['Bob']),
        not(atom(operator_of, ['Bob', 'Carol'])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(operator_of, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']),
        atom(agent_of, ['Alice', 'Carol', y]),
        atom(identity, ['Carol']), atom(agent, ['Carol']), atom(operated_by, ['Carol', 'Alice']),
        not(atom(operated_by, ['Carol', 'Bob'])), not(atom(friend, ['Carol', 'Bob'])),
        forall(['Erin'], atom(operated_by, ['Carol', 'Erin']), true,
               and(atom(identity, ['Erin']), and(atom(person, ['Erin']), atom(operator_of, ['Erin', 'Carol']))))],
       true, ['Bob', 'Alice', 'Erin']),
%% GnW:3 with GAI:2, Ward and person, knowing: Carol presents her attestation y, and Bob records it.
    sas(agent_acquaint, ['Carol', 'Bob', 'Alice'], ['Alice', y],
       [atom(knows, ['Carol', 'Bob']),
        atom(knows, ['Bob', 'Carol']), atom(agent_of, ['Bob', 'Carol', y])],
       [atom(identity, ['Carol']), atom(agent, ['Carol']), atom(operated_by, ['Carol', 'Alice']),
        atom(attestation, ['Carol', y]),
        atom(identity, ['Bob']), atom(person, ['Bob'])],
       true, ['Carol', 'Bob']),
%% GnW:4 with GAI:2, Ward and ward, knowing: Carol and Dave each present their attestation, y and z, and each records the other's.
    sas(agents_acquaint, ['Carol', 'Dave', 'Alice', 'Bob'], ['Alice', 'Bob', y, z],
       [atom(knows, ['Carol', 'Dave']), atom(agent_of, ['Carol', 'Dave', z]),
        atom(knows, ['Dave', 'Carol']), atom(agent_of, ['Dave', 'Carol', y])],
       [atom(identity, ['Carol']), atom(agent, ['Carol']), atom(operated_by, ['Carol', 'Alice']),
        atom(attestation, ['Carol', y]),
        atom(identity, ['Dave']), atom(agent, ['Dave']), atom(operated_by, ['Dave', 'Bob']),
        atom(attestation, ['Dave', z])],
       true, ['Carol', 'Dave']),
%% GFP:1, Signing, GFP's sign with a stronger body: Alice is a person, or an AI agent with a guardian (GSC, Definition Guardianship, 'can act').
    sas(sign, ['Alice'], [x],
       [atom(item, ['Alice', x])],
       [atom(identity, ['Alice']), not(atom(item, ['Alice', x])),
        or(atom(person, ['Alice']), and(atom(agent, ['Alice']), exists(['G'], atom(operated_by, ['Alice', 'G']), true)))],
       true, ['Alice']),
%% GFP:2, Forwarding, GFP's forward with a stronger body: Alice is a person, or an AI agent with a guardian.
    sas(forward, ['Alice', 'Bob'], [x],
       [atom(item, ['Bob', sgn(x, 'Alice')])],
       [atom(identity, ['Alice']), atom(item, ['Alice', x]), atom(friend, ['Alice', 'Bob']),
        or(atom(person, ['Alice']), and(atom(agent, ['Alice']), exists(['G'], atom(operated_by, ['Alice', 'G']), true))),
        atom(identity, ['Bob'])],
       true, ['Alice']),
%% GSG:2 with GSN:3, Ending a friendship, by a person, Alice, with any agent Bob but an AI agent she is a guardian of, which also clears every listing and membership between the two.
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(listed, ['Alice', 'Bob', '_'])),
        not(atom(member, ['Alice', ext(own('Bob'), '_')])),
        not(atom(friend, ['Bob', 'Alice'])), not(atom(listed, ['Bob', 'Alice', '_'])),
        not(atom(member, ['Bob', ext(own('Alice'), '_')]))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']),
        atom(person, ['Alice']),
        not(atom(operator_of, ['Alice', 'Bob'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice'])],
       true, ['Alice']),
%% GSN:1, Messaging: Alice sends her friend Bob an item she holds and authored, its first signer, as she signed it.
    sas(message, ['Alice', 'Bob'], [x],
       [atom(item, ['Bob', x])],
       [atom(identity, ['Alice']), or(atom(person, ['Alice']), and(atom(agent, ['Alice']), exists(['G'], atom(operated_by, ['Alice', 'G']), true))), atom(item, ['Alice', x]), atom(friend, ['Alice', 'Bob']), atom(identity, ['Bob'])],
       eq(author_of(x), 'Alice'), ['Alice']),
%% GSN:2, Group: Alice creates a group, of which she is the leader and first member; a group act is a person's, and an AI agent takes none.
    sas(create, ['Alice'], [n],
       [atom(member, ['Alice', ext(own('Alice'), n)]), atom(listed, ['Alice', 'Alice', n])],
       [atom(identity, ['Alice']), atom(person, ['Alice']),
        not(atom(member, ['Alice', ext(own('Alice'), n)])), not(atom(closed, ['Alice', n]))],
       true, ['Alice']),
%% GSN:3, Joining and Leaving: Alice, the leader, adds her friend Bob, with his consent.
    sas(join, ['Alice', 'Bob'], [n],
       [atom(listed, ['Alice', 'Bob', n]), atom(member, ['Bob', ext(own('Alice'), n)])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]), atom(friend, ['Alice', 'Bob']),
        atom(person, ['Alice']),
        atom(identity, ['Bob']), atom(person, ['Bob']),
        not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       true, ['Alice', 'Bob']),
%% GSN:3: Bob ends his membership.
    sas(leave, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(listed, ['Alice', 'Bob', n]),
        atom(identity, ['Bob']), atom(person, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       true, ['Bob']),
%% GSN:3: Alice, the leader, ends Bob's membership.
    sas(remove, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(listed, ['Alice', 'Bob', n]),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       true, ['Alice']),
%% GSN:2: Alice closes the group by leaving it, with every member Bob she lists.
    sas(close, ['Alice', 'Bob'], [n],
       [atom(closed, ['Alice', n]), not(atom(listed, ['Alice', 'Alice', n])),
        not(atom(member, ['Alice', ext(own('Alice'), n)])),
        forall('Bob', atom(listed, ['Alice', 'Bob', n]),
               [not(atom(member, ['Bob', ext(own('Alice'), n)]))])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Alice', n]),
        forall('Bob', atom(listed, ['Alice', 'Bob', n]),
               [atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])])],
       true, ['Alice']),
%% GSN:4, Group messaging: the leader posts her own item.
    sas(post_own, ['Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Alice']), atom(person, ['Alice']), atom(item, ['Alice', x]), atom(member, ['Alice', ext(own('Alice'), n)]), not(atom(posted, ['Alice', x, n]))],
       eq(author_of(x), 'Alice'), ['Alice']),
%% GSN:4: a member, Bob, sends the leader Alice an item he authored, as he signed it.
    sas(post, ['Bob', 'Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Bob']), atom(person, ['Bob']), atom(item, ['Bob', x]), atom(member, ['Bob', ext(own('Alice'), n)]),
        atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(posted, ['Alice', x, n]))],
       eq(author_of(x), 'Bob'), ['Bob']),
%% GSN:4 with GFP:2: a member, Bob, sends the leader Alice an item he holds, adding his signature.
    sas(post_forward, ['Bob', 'Alice'], [x, n],
       [atom(posted, ['Alice', sgn(x, 'Bob'), n])],
       [atom(identity, ['Bob']), atom(person, ['Bob']), atom(item, ['Bob', x]), atom(member, ['Bob', ext(own('Alice'), n)]),
        atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob'])],
       true, ['Bob']),
%% GSN:4 with GFP:2: the leader Alice delivers an item a member posted to every current member, adding her signature.
    sas(deliver, ['Alice', 'Bob'], [y, n],
       [atom(delivered, ['Alice', y, 'Bob', n]), atom(item, ['Bob', sgn(y, 'Alice')])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(posted, ['Alice', y, n]), atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(delivered, ['Alice', y, 'Bob', n])),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       ne(author_of(y), 'Alice'), []),
%% GSN:4: the leader Alice delivers her own item to every current member, as she signed it.
    sas(deliver_own, ['Alice', 'Bob'], [y, n],
       [atom(delivered, ['Alice', y, 'Bob', n]), atom(item, ['Bob', y])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(posted, ['Alice', y, n]), atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(delivered, ['Alice', y, 'Bob', n])),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       eq(author_of(y), 'Alice'), [])]).
