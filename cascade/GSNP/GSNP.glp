%% ---------------------------------------------------------------------------
%% GSNP.glp --- GSNP, Grassroots Social Network with Provenance, GAI's (Coordination Appendix C), its clause in GSNP.txt beside this file, extending GSN, GSC's (programs/gsc/GSN.txt, GSN.glp), and GAI, GAI's (GAI.txt, GAI.glp beside this file), and through them GnW, GSG and GKK, in the term form programs/gsc reads (its README, "Writing a contract").  This term is the one source of the schemas: a run of the cascade prints their notation from it as schemas.txt (cascade.sh, programs/gsc/notation.glp).  A schema's second argument names its roles as its clause does, its third lists its variables in the order of its head; a role is rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i), named by its index, role(1) the schema's first role; a deleted atom with the wildcard any, or ext_any(N) for <N>.*, is a cleared atom, deleting every atom it matches and requiring none; crs(listed(i, p, Args), ...) is the listed role of every agent role i lists by p; sgn(x, 1) is x signed over by the agent in role 1 (GSC, Definitions Name term, role and Speech-act schema; GAI's paper, Appendix "Contracts with Wards", signed terms).
%% Rewritten by GAI #10 Cowork, 2026-10-30, to the contracts as Udi revised them in Coordination Appendix E (Coordination #11, to_all 10:18 UTC), with GAI and GnW as Udi approved them to GAI #10, and to GSN.glp at GLP 6069b119.  Twenty-nine schemas over twenty predicates: GAI.glp's seventeen, with unfriend also clearing every membership between the two (GSN:3, as GSN.glp's unfriend); message, a friend sent an item the sender authored; forward, GSNP:1, Provenance, an item received sent on with the sender's signature added; and GSN's groups, create, join, leave, remove and close, with post_own, post, post_forward, deliver and deliver_own carrying items.  A group is named by its leader and n, its community name <a>.n (GSC, Appendix D).  Every guarding role forbids retired, the leaving mark; create and join forbid agent, so an AI agent takes no group act in this term, a ward's membership of a group (GnW:3, GnW:4) being left out, as GAI's paper says (Section 3.2); so an AI agent holds no membership, and agent_unfriend, guardian_unfriend and retire clear none.  An AI agent signs, messages and forwards as any agent does, its acts carrying its attestation (GAI:2).
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant) ; ext_any(NameTerm).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer) ; any.
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant)
            ; listed(Integer, Constant, Args).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Name      ::= Constant ; one(Constant, Constant).
Names     ::= [] ; [Name | Names].
Schema    ::= schema(Constant, Names, Args, RoleSpecs) ; cschema(Constant, Names, Args, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gsnp, C): the contract.
procedure contract_named(Constant?, Declared).
contract_named(gsnp, reflexive([friend, knows], C?)) :- gsnp_schemas(C).

procedure gsnp_schemas(Contract).
gsnp_schemas([
%% GKK:1, Identity.
    schema(establish, ['Alice'], [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(identity, []), atom(retired, [])])]),
%% GKK:2, Acquaintance, for two persons.
    schema(acquaint, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(retired, [])])]),
%% GKK:3, Introduction, for persons, with Bob's consent.
    schema(introduce, ['Alice', 'Bob'], [pvar(c)],
       [rs(guarded, [], [],
                    [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(knows, [pvar(c)])], [],
                    [atom(identity, []), atom(knows, [role(1)])],
                    [atom(agent, []), atom(retired, [])])]),
%% GSG:1, Friendship, for two persons who know each other.
    schema(befriend, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(friend, [role(2)])], [],
                    [atom(identity, []), atom(knows, [role(2)])],
                    [atom(agent, []), atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [],
                    [atom(identity, []), atom(knows, [role(1)])],
                    [atom(agent, []), atom(retired, []), atom(friend, [role(1)])])]),
%% GSG:2, Ending a friendship, by either friend, but a ward with a guardian (GnW:1, GnW:2), a guardian with the ward (GnW:2, GnW:5); with GSN:3, it clears every membership between the two, each one's listing of the other in a group they lead and their own membership in a group the other leads.
    schema(unfriend, ['Alice', 'Bob'], [],
       [rs(guarded, [], [atom(friend, [role(2)]), atom(listed, [role(2), any]),
                         atom(member, [nterm(ext_any(own(2)))])], [atom(identity, [])],
                    [atom(retired, []), atom(principal, [role(2)]), atom(guarded_by, [role(2)]),
                     atom(principal_of, [role(2)]), atom(guardian_of, [role(2)])]),
        rs(unguarded, [], [atom(friend, [role(1)]), atom(listed, [role(1), any]),
                           atom(member, [nterm(ext_any(own(1)))])], [atom(identity, [])], [])]),
%% GnW:1, Creation, with GAI:1 and GAI:2: Alice creates the AI agent Carol, choosing its key pair, and is its creator, principal, guardian and friend; Carol carries Alice's attestation y.
    schema(enter, ['Alice', 'Carol'], [svar(y)],
       [rs(guarded, [atom(principal_of, [role(2)]), atom(guardian_of, [role(2)]),
                     atom(friend, [role(2)]), atom(knows, [role(2)]),
                     atom(agent_of, [role(2), svar(y)])], [],
                    [atom(identity, []), atom(authored, [svar(y)])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(identity, []), atom(agent, []), atom(principal, [role(1)]),
                     atom(friend, [role(1)]), atom(knows, [role(1)]),
                     atom(attestation, [svar(y)])], [],
                    [], [atom(identity, []), atom(retired, [])])]),
%% GnW:2, Joint guardianship: Alice, the creator of Carol, makes their friend Bob a guardian and a friend of Carol, by an act of Alice and Bob.
    schema(make_guardian, ['Alice', 'Bob', 'Carol'], [svar(y)],
       [rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(3)]), atom(friend, [role(2)]),
                     atom(agent_of, [role(3), svar(y)])],
                    [atom(retired, [])]),
        rs(guarded, [atom(guardian_of, [role(3)]), atom(friend, [role(3)]),
                     atom(agent_of, [role(3), svar(y)])], [],
                    [atom(identity, [])],
                    [atom(agent, []), atom(retired, []), atom(guardian_of, [role(3)])]),
        rs(unguarded, [atom(guarded_by, [role(2)]), atom(friend, [role(2)])], [],
                      [atom(identity, []), atom(agent, [])],
                      [atom(friend, [role(2)])])]),
%% GnW:2: Alice, the creator of Carol, ends Bob's guardianship of Carol.
    schema(end_guardian, ['Alice', 'Bob', 'Carol'], [],
       [rs(guarded, [], [],
                    [atom(identity, []), atom(principal_of, [role(3)])], [atom(retired, [])]),
        rs(unguarded, [], [atom(guardian_of, [role(3)])],
                      [atom(identity, [])], [atom(principal_of, [role(3)])]),
        rs(unguarded, [], [atom(guarded_by, [role(2)])], [atom(identity, [])], [])]),
%% GnW:2: Bob, a guardian of Carol other than its creator, ends their guardianship of Carol, the friendship remaining.
    schema(resign, ['Bob', 'Carol'], [],
       [rs(guarded, [], [atom(guardian_of, [role(2)])],
                    [atom(identity, [])], [atom(retired, []), atom(principal_of, [role(2)])]),
        rs(unguarded, [], [atom(guarded_by, [role(1)])], [atom(identity, [])], [])]),
%% GnW:2: Bob, a guardian of Carol, ends their friendship with Carol, which ends their guardianship.
    schema(guardian_unfriend, ['Bob', 'Carol'], [],
       [rs(guarded, [], [atom(friend, [role(2)]), atom(guardian_of, [role(2)])],
                    [atom(identity, [])], [atom(retired, []), atom(principal_of, [role(2)])]),
        rs(unguarded, [], [atom(friend, [role(1)]), atom(guarded_by, [role(1)])],
                      [atom(identity, [])], [])]),
%% GnW:3, Ward and person, knowing, with GAI:2: Carol, a ward of Alice, and Bob come to know each other, provided Alice knows Bob, by an act of the three; Bob records Carol with its attestation y.
    schema(agent_acquaint, ['Carol', 'Bob', 'Alice'], [svar(y)],
       [rs(guarded, [atom(knows, [role(2)])], [],
                    [atom(identity, []), atom(agent, []), atom(attestation, [svar(y)])],
                    [atom(retired, [])]),
        rs(guarded, [atom(knows, [role(1)]), atom(agent_of, [role(1), svar(y)])], [],
                    [atom(identity, [])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(guardian_of, [role(1)]),
                     atom(agent_of, [role(1), svar(y)]), atom(knows, [role(2)])],
                    [atom(agent, []), atom(retired, [])])]),
%% GnW:3, Ward and person, a relation: Carol and Bob, who know each other, become friends, provided Alice and Bob are friends, by an act of the three.
    schema(agent_befriend, ['Carol', 'Bob', 'Alice'], [],
       [rs(guarded, [atom(friend, [role(2)])], [],
                    [atom(identity, []), atom(agent, []), atom(knows, [role(2)])],
                    [atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [],
                    [atom(identity, []), atom(knows, [role(1)])],
                    [atom(agent, []), atom(retired, []), atom(friend, [role(1)])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(guardian_of, [role(1)]), atom(friend, [role(2)])],
                    [atom(agent, []), atom(retired, [])])]),
%% GnW:3: Alice, a guardian of Carol, ends a friendship of Carol with Bob, other than a guardian.
    schema(agent_unfriend, ['Carol', 'Bob', 'Alice'], [],
       [rs(unguarded, [], [atom(friend, [role(2)])],
                      [atom(identity, [])],
                      [atom(principal, [role(2)]), atom(guarded_by, [role(2)])]),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], []),
        rs(guarded, [], [],
                    [atom(identity, []), atom(guardian_of, [role(1)])],
                    [atom(agent, []), atom(retired, [])])]),
%% GnW:4, Ward and ward, knowing, with GAI:2: Carol, a ward of Alice, and Dave, a ward of Bob, come to know each other, provided Alice knows Dave and Bob, by an act of the four, each recording the other with its attestation; Alice and Bob possibly one person.
    schema(agents_acquaint, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [svar(y), svar(z)],
       [rs(guarded, [atom(knows, [role(2)]), atom(agent_of, [role(2), svar(z)])], [],
                    [atom(identity, []), atom(agent, []), atom(attestation, [svar(y)])],
                    [atom(retired, [])]),
        rs(guarded, [atom(knows, [role(1)]), atom(agent_of, [role(1), svar(y)])], [],
                    [atom(identity, []), atom(agent, []), atom(attestation, [svar(z)])],
                    [atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(guardian_of, [role(1)]),
                     atom(agent_of, [role(1), svar(y)]),
                     atom(knows, [role(2)]), atom(knows, [role(4)])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(guardian_of, [role(2)]),
                     atom(agent_of, [role(2), svar(z)])],
                    [atom(agent, []), atom(retired, [])])]),
%% GnW:4, Ward and ward, a relation: Carol and Dave, who know each other, become friends, provided Alice knows Dave and is a friend of Bob, by an act of the four; Alice and Bob possibly one person.
    schema(agents_befriend, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
       [rs(guarded, [atom(friend, [role(2)])], [],
                    [atom(identity, []), atom(agent, []), atom(knows, [role(2)])],
                    [atom(retired, []), atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [],
                    [atom(identity, []), atom(agent, []), atom(knows, [role(1)])],
                    [atom(retired, []), atom(friend, [role(1)])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(guardian_of, [role(1)]),
                     atom(knows, [role(2)]), atom(friend, [role(4)])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [], [],
                    [atom(identity, []), atom(guardian_of, [role(2)])],
                    [atom(agent, []), atom(retired, [])])]),
%% GnW:5, Retiring: Alice, the creator of Carol, ends their friendship with Carol, which ends every guardianship and every friendship of Carol, the guardians and the friends of Carol in the act by the listed roles Carol[guarded_by(*)] and Carol[friend(*)]; retired is the leaving mark, and the creator's records stay.
    cschema(retire, ['Carol', 'Alice', 'Carol', 'Carol'], [], [],
       [rs(unguarded, [atom(retired, [])],
                      [atom(friend, [any]), atom(guarded_by, [any])],
                      [atom(identity, []), atom(agent, []), atom(principal, [role(2)])],
                      [atom(retired, [])]),
        rs(guarded, [atom(retired_of, [role(1)])], [atom(friend, [role(1)])],
                    [atom(identity, []), atom(principal_of, [role(1)])], [atom(retired, [])]),
        crs(listed(1, friend, []), unguarded,
            [], [atom(friend, [role(1)])], [atom(identity, [])], []),
        crs(listed(1, guarded_by, []), unguarded,
            [], [atom(guardian_of, [role(1)])], [atom(identity, [])],
            [atom(principal_of, [role(1)])])]),
%% GAI:1: the developer signs the code of an AI agent, and the principal the attestation, and an agent the content they create, each holding it as an item they authored (GKK:1).
    schema(sign, ['Alice'], [svar(x)],
       [rs(guarded, [atom(item, [svar(x)]), atom(authored, [svar(x)])], [],
                    [atom(identity, [])], [atom(retired, [])])]),
%% GSN:1, Messaging: Alice sends their friend Bob an item they authored, as they signed it.
    schema(message, ['Alice', 'Bob'], [svar(x)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(authored, [svar(x)]), atom(friend, [role(2)])],
                      [atom(retired, [])]),
        rs(unguarded, [atom(item, [svar(x)])], [],
                      [atom(identity, [])], [])]),
%% GSNP:1, Provenance: Alice sends their friend Bob an item they received, adding their signature.
    schema(forward, ['Alice', 'Bob'], [svar(x)],
       [rs(guarded, [], [],
                    [atom(identity, []), atom(item, [svar(x)]), atom(friend, [role(2)])],
                    [atom(authored, [svar(x)]), atom(retired, [])]),
        rs(unguarded, [atom(item, [sgn(x, 1)])], [],
                      [atom(identity, [])], [])]),
%% GSN:2, Group: Alice creates a group, of which they are the leader and first member; an AI agent takes no group act here.
    schema(create, ['Alice'], [svar(n)],
       [rs(guarded, [atom(member, [nterm(ext(own(1), n))]),
                     atom(listed, [role(1), svar(n)])], [], [atom(identity, [])],
                    [atom(agent, []), atom(retired, []), atom(member, [nterm(ext(own(1), n))]), atom(closed, [svar(n)])])]),
%% GSN:3, Joining and Leaving: Alice, the leader, adds their friend Bob, with Bob's consent.
    schema(join, ['Alice', 'Bob'], [svar(n)],
       [rs(guarded, [atom(listed, [role(2), svar(n)])], [],
                    [atom(identity, []), atom(member, [nterm(ext(own(1), n))]), atom(friend, [role(2)])],
                    [atom(agent, []), atom(retired, [])]),
        rs(guarded, [atom(member, [nterm(ext(own(1), n))])], [],
                    [atom(identity, [])],
                    [atom(agent, []), atom(retired, []), atom(member, [nterm(ext(own(1), n))])])]),
%% GSN:3: Bob ends their membership.
    schema(leave, ['Alice', 'Bob'], [svar(n)],
       [rs(unguarded, [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], []),
        rs(guarded,   [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [atom(retired, [])])]),
%% GSN:3: Alice, the leader, ends Bob's membership.
    schema(remove, ['Alice', 'Bob'], [svar(n)],
       [rs(guarded,   [], [atom(listed, [role(2), svar(n)])], [atom(identity, [])], [atom(retired, [])]),
        rs(unguarded, [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% GSN:2: Alice closes the group by leaving it, with every member Alice lists.
    cschema(close, ['Alice', 'Alice'], [svar(n)], [],
       [rs(guarded, [atom(closed, [svar(n)])],
                    [atom(listed, [role(1), svar(n)])],
                    [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [atom(retired, [])]),
        crs(listed(1, listed, [svar(n)]), unguarded,
            [], [atom(member, [nterm(ext(own(1), n))])], [atom(identity, [])], [])]),
%% GSN:4, Group messaging, with GSNP:1: the leader's own item; a member's own item, sent to the leader as they signed it, and an item they received, sent with their signature; the leader delivering a posted item to every current member with their signature, and their own as they signed it.
    schema(post_own, ['Alice'], [svar(x), svar(n)],
       [rs(guarded, [atom(posted, [svar(x), svar(n)])], [],
                    [atom(identity, []), atom(authored, [svar(x)]), atom(member, [nterm(ext(own(1), n))])],
                    [atom(retired, []), atom(posted, [svar(x), svar(n)])])]),
    schema(post, ['Bob', 'Alice'], [svar(x), svar(n)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(authored, [svar(x)]), atom(member, [nterm(ext(own(2), n))])],
                      [atom(retired, [])]),
        rs(unguarded, [atom(posted, [svar(x), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(2), n))]),
                       atom(listed, [role(1), svar(n)]), atom(friend, [role(1)])],
                      [atom(posted, [svar(x), svar(n)])])]),
    schema(post_forward, ['Bob', 'Alice'], [svar(x), svar(n)],
       [rs(guarded,   [], [],
                      [atom(identity, []), atom(item, [svar(x)]), atom(member, [nterm(ext(own(2), n))])],
                      [atom(authored, [svar(x)]), atom(retired, [])]),
        rs(unguarded, [atom(posted, [sgn(x, 1), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(2), n))]),
                       atom(listed, [role(1), svar(n)]), atom(friend, [role(1)])], [])]),
    schema(deliver, ['Alice', 'Bob'], [svar(y), svar(n)],
       [rs(unguarded, [atom(delivered, [svar(y), role(2), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))]),
                       atom(posted, [svar(y), svar(n)]),
                       atom(listed, [role(2), svar(n)]), atom(friend, [role(2)])],
                      [atom(authored, [svar(y)]), atom(delivered, [svar(y), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [sgn(y, 1)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [])]),
    schema(deliver_own, ['Alice', 'Bob'], [svar(y), svar(n)],
       [rs(unguarded, [atom(delivered, [svar(y), role(2), svar(n)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))]),
                       atom(posted, [svar(y), svar(n)]), atom(authored, [svar(y)]),
                       atom(listed, [role(2), svar(n)]), atom(friend, [role(2)])],
                      [atom(delivered, [svar(y), role(2), svar(n)])]),
        rs(unguarded, [atom(item, [svar(y)])], [],
                      [atom(identity, []), atom(member, [nterm(ext(own(1), n))])], [])])]).
