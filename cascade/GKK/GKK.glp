%% ---------------------------------------------------------------------------
%% GKK.glp --- the grassroots keys and knowledge contract, GSC's, the base contract every
%% other contract extends (Udi, 2026-10-20, to GSC #5), in the clause syntax of GSC's paper,
%% Section 3.2 (Udi, 2026-11-04, to GSC #11): sas(Name, Names, Vars, Head, Body, Constraint, Guards),
%% Names every person of the schema, Vars its variables that are no role, Head and Body lists of
%% literals, atom(Pred, [Holder | Args]) or not(...), a quantified conjunct forall(X, Cond, Lits),
%% a multiplicity times(K, Atom), the wildcard '_', Guards the persons who must will the act
%% (programs/gsc/README.md).  The clauses are in GKK.txt beside this file: establish is clause 1,
%% Identity, acquaint clause 2, Acquaintance, and introduce clause 3, Introduction; every role but
%% establish's requires identity.  knows(Alice, Bob) says that Alice holds Bob's public key; nothing
%% deletes or forbids it, a second copy meaning the same.  The clause of each schema is printed
%% from the term by a run of the cascade (schemas.txt).
%% ---------------------------------------------------------------------------

% contract_named(gkk, C): the contract, GKK (Coordination Appendix C).
procedure contract_named(Constant?, SContract).
contract_named(gkk,
   [sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob'])]).
