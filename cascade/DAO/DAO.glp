 sas(propose_own, ['Alice'], ['Prop', 'Delos'], [atom(proposed, ['Alice', 'Prop', const('Delos'), 'Alice']), atom(proposal, ['Alice', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(member, ['Alice', const('Delos'), 'Alice']), atom(steward, ['Alice', const('Delos')]), not(atom(proposal, ['Alice', 'Prop', const('Delos')]))], true, ['Alice']),
 sas(deliver_proposal, ['Alice', 'Bob'], ['Prop', 'Delos'], [atom(delivered, ['Alice', 'Prop', const('Delos'), 'Bob']), atom(proposal, ['Bob', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(steward, ['Alice', const('Delos')]), atom(proposal, ['Alice', 'Prop', const('Delos')]), atom(listed, ['Alice', 'Bob', const('Delos')]), not(atom(delivered, ['Alice', 'Prop', const('Delos'), 'Bob']))], true, []),
 sas(vote_for, ['Carol', 'Alice'], ['Prop', 'Delos'], [atom(voted, ['Carol', 'Prop', const('Delos')]), atom(vote_for, ['Alice', 'Carol', 'Prop', const('Delos')])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(member, ['Carol', const('Delos'), 'Alice']), atom(proposal, ['Carol', 'Prop', const('Delos')]), atom(steward, ['Alice', const('Delos')]), not(atom(decided, ['Alice', 'Prop', const('Delos')])), not(atom(voted, ['Carol', 'Prop', const('Delos')]))], true, ['Carol']),
 sas(vote_own_for, ['Alice'], ['Prop', 'Delos'], [atom(voted, ['Alice', 'Prop', const('Delos')]), atom(vote_for, ['Alice', 'Alice', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(member, ['Alice', const('Delos'), 'Alice']), atom(proposal, ['Alice', 'Prop', const('Delos')]), atom(steward, ['Alice', const('Delos')]), not(atom(decided, ['Alice', 'Prop', const('Delos')])), not(atom(voted, ['Alice', 'Prop', const('Delos')]))], true, ['Alice']),
 sas(vote_against, ['Carol', 'Alice'], ['Prop', 'Delos'], [atom(voted, ['Carol', 'Prop', const('Delos')]), atom(vote_against, ['Alice', 'Carol', 'Prop', const('Delos')])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(member, ['Carol', const('Delos'), 'Alice']), atom(proposal, ['Carol', 'Prop', const('Delos')]), atom(steward, ['Alice', const('Delos')]), not(atom(decided, ['Alice', 'Prop', const('Delos')])), not(atom(voted, ['Carol', 'Prop', const('Delos')]))], true, ['Carol']),
 sas(vote_own_against, ['Alice'], ['Prop', 'Delos'], [atom(voted, ['Alice', 'Prop', const('Delos')]), atom(vote_against, ['Alice', 'Alice', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(member, ['Alice', const('Delos'), 'Alice']), atom(proposal, ['Alice', 'Prop', const('Delos')]), atom(steward, ['Alice', const('Delos')]), not(atom(decided, ['Alice', 'Prop', const('Delos')])), not(atom(voted, ['Alice', 'Prop', const('Delos')]))], true, ['Alice']),
 sas(deliver_vote_for, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Prop', 'Delos'], [atom(delivered_vote, ['Alice', 'Carol', 'Prop', const('Delos'), 'Bob']), atom(vote_for, ['Bob', 'Carol', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(steward, ['Alice', const('Delos')]), atom(vote_for, ['Alice', 'Carol', 'Prop', const('Delos')]), atom(listed, ['Alice', 'Bob', const('Delos')]), not(atom(delivered_vote, ['Alice', 'Carol', 'Prop', const('Delos'), 'Bob']))], true, []),
 sas(deliver_vote_against, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Prop', 'Delos'], [atom(delivered_vote, ['Alice', 'Carol', 'Prop', const('Delos'), 'Bob']), atom(vote_against, ['Bob', 'Carol', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(steward, ['Alice', const('Delos')]), atom(vote_against, ['Alice', 'Carol', 'Prop', const('Delos')]), atom(listed, ['Alice', 'Bob', const('Delos')]), not(atom(delivered_vote, ['Alice', 'Carol', 'Prop', const('Delos'), 'Bob']))], true, []),
 sas(pass, ['Alice'], ['Prop', 'Delos', 'Votes', 'Double'], [atom(decided, ['Alice', 'Prop', const('Delos')]), atom(passed, ['Alice', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(steward, ['Alice', const('Delos')]), atom(proposal, ['Alice', 'Prop', const('Delos')]), not(atom(decided, ['Alice', 'Prop', const('Delos')]))], and(ge(cardinality(['X1'], atom(vote_for, ['Alice', 'X1', 'Prop', const('Delos')]), true), num('Votes')), and(eq(num('Double'), mul(num('Votes'), val(2))), lt(cardinality(['X2'], atom(listed, ['Alice', 'X2', const('Delos')]), true), num('Double')))), ['Alice']),
 sas(reject, ['Alice'], ['Prop', 'Delos', 'Votes', 'Double'], [atom(decided, ['Alice', 'Prop', const('Delos')]), atom(rejected, ['Alice', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(steward, ['Alice', const('Delos')]), atom(proposal, ['Alice', 'Prop', const('Delos')]), not(atom(decided, ['Alice', 'Prop', const('Delos')]))], and(ge(cardinality(['X1'], atom(vote_against, ['Alice', 'X1', 'Prop', const('Delos')]), true), num('Votes')), and(eq(num('Double'), mul(num('Votes'), val(2))), lt(cardinality(['X2'], atom(listed, ['Alice', 'X2', const('Delos')]), true), num('Double')))), ['Alice']),
 sas(deliver_pass, ['Alice', 'Bob'], ['Prop', 'Delos'], [atom(delivered_decision, ['Alice', 'Prop', const('Delos'), 'Bob']), atom(passed, ['Bob', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(steward, ['Alice', const('Delos')]), atom(passed, ['Alice', 'Prop', const('Delos')]), atom(listed, ['Alice', 'Bob', const('Delos')]), not(atom(delivered_decision, ['Alice', 'Prop', const('Delos'), 'Bob']))], true, []),
 sas(deliver_reject, ['Alice', 'Bob'], ['Prop', 'Delos'], [atom(delivered_decision, ['Alice', 'Prop', const('Delos'), 'Bob']), atom(rejected, ['Bob', 'Prop', const('Delos')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(steward, ['Alice', const('Delos')]), atom(rejected, ['Alice', 'Prop', const('Delos')]), atom(listed, ['Alice', 'Bob', const('Delos')]), not(atom(delivered_decision, ['Alice', 'Prop', const('Delos'), 'Bob']))], true, [])])).
