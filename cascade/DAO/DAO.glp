% contract_named(dao, C): the contract, DAO.
procedure contract_named(Constant?, SDeclared).
contract_named(dao, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(found, ['Alice'], ['Delos'], [atom(steward, ['Alice', const('Delos')]), atom(member, ['Alice', const('Delos'), 'Alice']), atom(listed, ['Alice', 'Alice', const('Delos')])], [atom(identity, ['Alice']), not(atom(steward, ['Alice', const('Delos')]))], true, ['Alice']),
 sas(join, ['Bob', 'Alice'], ['Delos'], [atom(member, ['Bob', const('Delos'), 'Alice']), atom(listed, ['Alice', 'Bob', const('Delos')])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(steward, ['Alice', const('Delos')]), atom(knows, ['Alice', 'Bob']), not(atom(member, ['Bob', const('Delos'), 'Alice']))], true, ['Alice', 'Bob']),
