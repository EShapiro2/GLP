%% ---------------------------------------------------------------------------
%% GDO-L.glp --- Grassroots Directed Overlay with Labels, GFF's, in the clause syntax of GSC's paper, Section 3.2,
%% the term form GDO-LB.glp writes.  It has GKK's and GDO's schemas, GSG's two recording and removing the pointers friends have, and four over pointer(Bob, Dave), a Dave-pointer to Bob.
%% Friends have each other's pointers, labeled by the friend (GDO-L's preamble),
%% so befriend records them and unfriend removes them, and every body reads a
%% recorded pointer (Udi, 2026-11-07, to GFF #4).  Every role requires identity.  The clauses are in GDO-L.txt beside this file.
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant)
              ; sgn(Constant, Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SHead       ::= SMult ; not(SMult) ; forall(PNames, SAtom, SCond, SHeads).
SHeads      ::= [] ; [SHead | SHeads].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr)
              ; fn(Constant, SExprs) ; cardinality(PNames, SAtom, SCond).
SExprs      ::= [] ; [SExpr | SExprs].
SCond       ::= true ; SMult ; not(SCond) ; and(SCond, SCond) ; or(SCond, SCond)
              ; eq(SExpr, SExpr) ; ne(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg)
              ; forall(PNames, SAtom, SCond, SCond) ; exists(PNames, SAtom, SCond).
SConds      ::= [] ; [SCond | SConds].
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SHeads, SConds, SCond, PNames).
Contract    ::= [] ; [Schema | Contract].
Preds       ::= [] ; [Constant | Preds].
Declared    ::= Contract ; environment(Preds, Contract).

%% contract_named(gdo_l, C): the contract, GDO-L.
procedure contract_named(Constant?, Declared).
contract_named(gdo_l,
   [sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
%% GSG:1, Friendship, recording the pointers friends have (GDO-L's preamble).
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(pointer, ['Alice', 'Bob', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Bob', 'Alice', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])), atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice']))],
       true,
       ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, removing the pointers friends have.
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(pointer, ['Alice', 'Bob', 'Bob'])), not(atom(friend, ['Bob', 'Alice'])), not(atom(pointer, ['Bob', 'Alice', 'Alice']))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(pointer, ['Alice', 'Bob', 'Bob']), atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Bob', 'Alice', 'Alice'])],
       true,
       ['Alice']),
%% GDO:1, Pointing to friend.
    sas(point_friend, ['Alice', 'Bob'], [],
       [atom(points_to, ['Alice', 'Bob'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), not(atom(points_to, ['Alice', 'Bob'])), atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDO:2, Transitive pointing.
    sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(points_to, ['Alice', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), atom(points_to, ['Alice', 'Bob']), atom(identity, ['Bob']), atom(points_to, ['Bob', 'Carol'])],
       true,
       ['Alice']),
%% GDO:3, Ceasing to point.
    sas(unpoint, ['Alice', 'Bob'], [],
       [not(atom(points_to, ['Alice', 'Bob']))],
       [atom(identity, ['Alice']), atom(points_to, ['Alice', 'Bob']), atom(identity, ['Bob'])],
       true,
       ['Alice']),
%% GDO-L:1, Labeled pointing to friend: a Dave-pointer to friend Bob, who has one.
    sas(follow_friend, ['Alice', 'Bob', 'Dave', 'Carol'], ['Dave', 'Carol'],
       [atom(pointer, ['Alice', 'Bob', 'Dave'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), not(atom(pointer, ['Alice', 'Bob', 'Dave'])), atom(identity, ['Bob']), atom(pointer, ['Bob', 'Carol', 'Dave'])],
       true,
       ['Alice']),
%% GDO-L:2, Labeled transitive pointing, through a Dave-pointer to Bob.
    sas(follow_transitive, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Dave'],
       [atom(pointer, ['Alice', 'Carol', 'Dave'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), atom(pointer, ['Alice', 'Bob', 'Dave']), not(atom(pointer, ['Alice', 'Carol', 'Dave'])), not(and(atom(friend, ['Alice', 'Carol']), eq('Carol', 'Dave'))), atom(identity, ['Bob']), atom(pointer, ['Bob', 'Carol', 'Dave'])],
       true,
       ['Alice']),
%% GDO-L:2, Labeled transitive pointing, through Alice's friend Bob.
    sas(follow_transitive_friend, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Dave'],
       [atom(pointer, ['Alice', 'Carol', 'Dave'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']), not(atom(pointer, ['Alice', 'Carol', 'Dave'])), not(and(atom(friend, ['Alice', 'Carol']), eq('Carol', 'Dave'))), atom(identity, ['Bob']), atom(pointer, ['Bob', 'Carol', 'Dave'])],
       true,
       ['Alice']),
%% GDO-L:3, Ceasing to point: a Dave-pointer Alice added, not the one friends have.
    sas(unfollow, ['Alice', 'Bob', 'Dave'], ['Dave'],
       [not(atom(pointer, ['Alice', 'Bob', 'Dave']))],
       [atom(identity, ['Alice']), atom(pointer, ['Alice', 'Bob', 'Dave']), not(and(atom(friend, ['Alice', 'Bob']), eq('Bob', 'Dave'))), atom(identity, ['Bob'])],
       true,
       ['Alice'])
]).
