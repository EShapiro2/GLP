%% GDO-L.glp --- printed by adopt.py from GDO-L.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit GDO-L.txt and run adopt.py GDO-L.
% contract_named(gdo_l, C): the contract, GDO-L.
procedure contract_named(Constant?, SDeclared).
contract_named(gdo_l, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Alice', 'Bob', 'Bob']), atom(pointer, ['Bob', 'Alice', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice'])), not(atom(pointer, ['Alice', 'Bob', 'Bob'])), not(atom(pointer, ['Bob', 'Alice', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Alice', 'Bob', 'Bob']), atom(pointer, ['Bob', 'Alice', 'Alice'])], true, ['Alice']),
 sas(point_friend, ['Alice', 'Bob'], [], [atom(points_to, ['Alice', 'Bob'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(points_to, ['Alice', 'Bob']))], true, ['Alice']),
 sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'], [atom(points_to, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Carol']), atom(points_to, ['Alice', 'Bob']), atom(points_to, ['Bob', 'Carol']), not(atom(points_to, ['Alice', 'Carol']))], true, ['Alice']),
 sas(unpoint, ['Alice', 'Bob'], ['Bob'], [not(atom(points_to, ['Alice', 'Bob']))], [atom(identity, ['Alice']), atom(points_to, ['Alice', 'Bob'])], true, ['Alice']),
 sas(labeled_point_friend, ['Alice', 'Bob', 'Dave', 'Erin'], ['Dave', 'Erin'], [atom(pointer, ['Alice', 'Bob', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Bob', 'Erin', 'Dave']), not(atom(pointer, ['Alice', 'Bob', 'Dave']))], true, ['Alice']),
 sas(labeled_point_transitive, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Dave'], [atom(pointer, ['Alice', 'Carol', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Carol']), atom(pointer, ['Alice', 'Bob', 'Dave']), atom(pointer, ['Bob', 'Carol', 'Dave']), not(atom(pointer, ['Alice', 'Carol', 'Dave']))], true, ['Alice']),
 sas(labeled_point_transitive_friend, ['Alice', 'Bob', 'Carol', 'Dave'], ['Carol', 'Dave'], [atom(pointer, ['Alice', 'Carol', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(pointer, ['Bob', 'Carol', 'Dave']), not(atom(pointer, ['Alice', 'Carol', 'Dave']))], true, ['Alice']),
 sas(labeled_unpoint, ['Alice', 'Carol', 'Dave'], ['Carol', 'Dave'], [not(atom(pointer, ['Alice', 'Carol', 'Dave']))], [atom(identity, ['Alice']), atom(pointer, ['Alice', 'Carol', 'Dave'])], true, ['Alice']),
 sas(labeled_unpoint_self, ['Alice', 'Dave'], ['Dave'], [not(atom(pointer, ['Alice', 'Dave', 'Dave']))], [atom(identity, ['Alice']), not(atom(friend, ['Alice', 'Dave'])), atom(pointer, ['Alice', 'Dave', 'Dave'])], true, ['Alice'])])).
