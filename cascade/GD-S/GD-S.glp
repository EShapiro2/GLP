%% ---------------------------------------------------------------------------
%% GD-S.glp --- Separating GD, GGGA's (Udi, 2026-11-06, to GGGA #3), in the
%% term form programs/gsc reads (its README, "Writing a contract").  GD-S
%% restricts GD (GD.glp beside this file; GSC, Section Relations among Contracts,
%% Definition Amendment, extension, restriction, instantiation): it has GD's
%% schemas, befriend with a stronger body, the same head, guard and name:
%% befriend (GD-S:1, restricting GSG:1) forbids at each role the distrust of the
%% other.  GD-S:2, Taking sides, is undertaken and has an undertaking formula
%% (GSC, Definition Undertaking formula), friend(Alice, Bob) and distrusts(Bob,
%% Carol) and not distrusts(Alice, Carol) leads-to distrusts(Alice, Carol) or not
%% friend(Alice, Bob), which denotes no transaction and has no term here until
%% Code proposes its term form.  The clauses are in GD-S.txt.
%%
%% A role is rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i),
%% and is named by its index, role(1) the schema's first role; c is an agent
%% variable, pvar.
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Names     ::= [] ; [Constant | Names].
Schema    ::= schema(Constant, Names, Args, RoleSpecs) ; cschema(Constant, Names, Args, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gd_s, C): the contract, GD-S (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gd_s,
   [schema(establish, ['Alice'], [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]),
    schema(acquaint, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
    schema(introduce, ['Alice', 'Bob'], [pvar(c)],
       [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
        rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
    schema(befriend, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(knows, [role(2)])],
                    [atom(friend, [role(2)]), atom(distrusts, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(knows, [role(1)])],
                    [atom(friend, [role(1)]), atom(distrusts, [role(1)])])]),
    schema(unfriend, ['Alice', 'Bob'], [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
    schema(distrust, ['Alice'], [pvar(c)],
       [rs(guarded, [atom(distrusts, [pvar(c)])], [],
                    [atom(identity, []), atom(knows, [pvar(c)])],
                    [atom(distrusts, [pvar(c)]), atom(friend, [pvar(c)])])]),
    schema(distrust_friend, ['Alice', 'Carol'], [],
       [rs(guarded,   [atom(distrusts, [role(2)])], [atom(friend, [role(2)])],
                      [atom(identity, []), atom(knows, [role(2)])], [atom(distrusts, [role(2)])]),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
    schema(propagate, ['Alice', 'Bob'], [pvar(c)],
       [rs(guarded,   [atom(distrusts, [pvar(c)])], [],
                      [atom(identity, []), atom(friend, [role(2)])],
                      [atom(distrusts, [pvar(c)]), atom(friend, [pvar(c)])]),
        rs(unguarded, [], [], [atom(identity, []), atom(distrusts, [pvar(c)])], [])]),
    schema(cease, ['Alice'], [pvar(c)],
       [rs(guarded, [], [atom(distrusts, [pvar(c)])], [atom(identity, [])], [])])]).
