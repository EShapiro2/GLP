%% Matching.glp --- printed by adopt.py from Matching.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Matching.txt and run adopt.py Matching.
% contract_named(matching, C): the contract, Matching.
procedure contract_named(Constant?, SDeclared).
contract_named(matching, environment([match], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(post, ['Alice'], ['Post'], [atom(made, ['Alice', 'Post']), atom(post, ['Alice', 'Post'])], [atom(identity, ['Alice']), not(atom(made, ['Alice', 'Post']))], true, ['Alice']),
 sas(tell, ['Bob', 'Alice'], ['Post'], [atom(post_from, ['Bob', 'Post', 'Alice']), atom(post, ['Bob', 'Post'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(post, ['Alice', 'Post']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(post_from, ['Bob', 'Post', 'Alice']))], true, ['Alice']),
 sas(return, ['Bob', 'Alice'], ['Other', 'Post'], [atom(post_from, ['Alice', 'Other', 'Bob']), atom(post, ['Alice', 'Other'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(post_from, ['Bob', 'Post', 'Alice']), atom(post, ['Bob', 'Other']), atom(match, ['Bob', 'Post', 'Other']), not(atom(post_from, ['Alice', 'Other', 'Bob']))], true, []),
 sas(withdraw, ['Alice'], ['Post'], [not(atom(made, ['Alice', 'Post'])), not(atom(post, ['Alice', 'Post']))], [atom(identity, ['Alice']), atom(made, ['Alice', 'Post']), atom(post, ['Alice', 'Post'])], true, ['Alice']),
 sas(meet, ['Alice', 'Carol'], ['Post', 'Other'], [atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(made, ['Alice', 'Post']), atom(made, ['Carol', 'Other']), atom(post, ['Alice', 'Other']), atom(post, ['Carol', 'Post']), atom(match, ['Alice', 'Post', 'Other'])], true, ['Alice', 'Carol'])]))).
