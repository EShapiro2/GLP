%% Matching.glp --- printed by adopt.py from Matching.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Matching.txt and run adopt.py Matching.
% contract_named(matching, C): the contract, Matching.
procedure contract_named(Constant?, SDeclared).
contract_named(matching, environment([covers, match, new_budget, protocol], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(post, ['Alice'], ['Post', 'Budget'], [atom(made, ['Alice', const('Post')]), atom(post, ['Alice', const('Post')]), atom(budget, ['Alice', const('Post'), num('Budget')])], [atom(identity, ['Alice']), atom(new_budget, ['Alice', num('Budget')]), not(atom(made, ['Alice', const('Post')]))], true, ['Alice']),
 sas(tell, ['Bob', 'Alice'], ['Post', 'Part', 'Budget', 'Rest'], [atom(post_from, ['Bob', const('Post'), 'Alice']), atom(post, ['Bob', const('Post')]), atom(budget, ['Bob', const('Post'), num('Part')])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(post, ['Alice', const('Post')]), atom(budget, ['Alice', const('Post'), num('Budget')]), atom(covers, ['Alice', num('Budget'), num('Rest')]), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(protocol, ['Alice', const('Post'), 'Bob', num('Part'), num('Rest')])], true, ['Alice']),
 sas(return, ['Bob', 'Alice'], ['Other', 'Post'], [atom(post_from, ['Alice', const('Other'), 'Bob']), atom(post, ['Alice', const('Other')])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(post_from, ['Bob', const('Post'), 'Alice']), atom(post, ['Bob', const('Other')]), atom(match, ['Bob', const('Post'), const('Other')]), not(atom(post_from, ['Alice', const('Other'), 'Bob']))], true, []),
 sas(meet, ['Alice', 'Carol'], ['Post', 'Other', 'OtherTwo', 'PostTwo'], [atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(made, ['Alice', const('Post')]), atom(made, ['Carol', const('Other')]), atom(post, ['Alice', const('OtherTwo')]), atom(post, ['Carol', const('PostTwo')]), atom(match, ['Alice', const('Post'), const('OtherTwo')])], and(eq(const('Other'), const('OtherTwo')), eq(const('Post'), const('PostTwo'))), ['Alice', 'Carol'])]))).
