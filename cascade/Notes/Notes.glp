%% Notes.glp --- printed by adopt.py from Notes.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Notes.txt and run adopt.py Notes.
% contract_named(notes, C): the contract, Notes.
procedure contract_named(Constant?, SDeclared).
contract_named(notes, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(issue, ['Alice'], ['Sum'], [times(num('Sum'), atom(note, ['Alice', 'Alice']))], [atom(identity, ['Alice'])], true, ['Alice']),
 sas(swap, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob']), one('Dave', ['Alice', 'Bob', 'Carol'])], ['Carol', 'Sum', 'Dave', 'Total'], [not(times(num('Sum'), atom(note, ['Alice', 'Carol']))), times(num('Sum'), atom(note, ['Bob', 'Carol'])), not(times(num('Total'), atom(note, ['Bob', 'Dave']))), times(num('Total'), atom(note, ['Alice', 'Dave'])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(note, ['Alice', 'Carol'])), times(num('Total'), atom(note, ['Bob', 'Dave']))], true, ['Alice', 'Bob']),
 sas(pay, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Sum'], [not(times(num('Sum'), atom(note, ['Alice', 'Carol']))), times(num('Sum'), atom(note, ['Bob', 'Carol'])), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(note, ['Alice', 'Carol']))], true, ['Alice', 'Bob']),
 sas(deposit, ['Alice', 'Carol', one('Dave', ['Alice', 'Carol']), one('Bob', 'Dave')], ['Dave', 'Sum', 'Bob', 'Cond'], [not(times(num('Sum'), atom(note, ['Alice', 'Dave']))), times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(note, ['Alice', 'Dave']))], true, ['Alice', 'Carol']),
 sas(release, ['Carol', 'Bob', one('Dave', ['Carol', 'Bob']), one('Alice', 'Dave')], ['Dave', 'Alice', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(note, ['Bob', 'Dave'])), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Bob']),
 sas(return, ['Carol', 'Alice', one('Dave', ['Carol', 'Alice']), one('Bob', 'Dave')], ['Dave', 'Bob', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(note, ['Alice', 'Dave'])), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), times(num('Sum'), atom(escrow_note, ['Carol', 'Dave', 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Alice'])])).
