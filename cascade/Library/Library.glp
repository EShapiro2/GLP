%% Library.glp --- printed by adopt.py from Library.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Library.txt and run adopt.py Library.
% contract_named(library, C): the contract, Library.
procedure contract_named(Constant?, SDeclared).
contract_named(library, environment([today], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], [], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(identity, ['Carol']), atom(person, ['Alice']), atom(person, ['Bob']), atom(person, ['Carol']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(shelve, ['Alice'], ['Tome'], [atom(shelved, ['Alice', const('Tome')]), atom(shelf, ['Alice', const('Tome')])], [atom(identity, ['Alice']), not(atom(shelved, ['Alice', const('Tome')]))], true, ['Alice']),
 sas(lend, ['Alice', 'Bob'], ['Tome', 'Day', 'Today'], [not(atom(shelf, ['Alice', const('Tome')])), atom(borrowed, ['Bob', const('Tome'), 'Alice', num('Day')])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(today, ['Alice', num('Today')]), atom(shelf, ['Alice', const('Tome')])], gt(num('Day'), num('Today')), ['Alice', 'Bob']),
 sas(return, ['Bob', 'Alice'], ['Tome', 'Day'], [not(atom(borrowed, ['Bob', const('Tome'), 'Alice', num('Day')])), atom(shelf, ['Alice', const('Tome')])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(borrowed, ['Bob', const('Tome'), 'Alice', num('Day')])], true, ['Bob'])]))).
