%% ---------------------------------------------------------------------------
%% DGC.glp --- Denominated Grassroots Currencies, the contract DGC, Currencies' (Coordination Appendix C; Udi's ruling of 2026-11-04, to Currencies #15), in the term form programs/gsc reads (its README, "Writing a contract").  The clauses are in DGC.txt beside this file, SGC's Section 2.1.  DGC extends GC and GB with the denomination and the acceptances (SGC, Appendix A), so the term holds GB's schemas (programs/currencies/bonds/GB.glp) with the denomination f as the argument after the issuer of every coin and bond, coin(u, f) and bond(u, f, d), and three of its own: accept, payout and spend.  accepts(u, f) in the state of p is one acceptance of u's coins in f in payment, L of them granted at once and one spent by each such coin paid to p (DGC:4).  f is a value, the denomination, written num(f) for want of a value variable in the term form; every role but establish's requires identity; today is an environment predicate, as GB has it.  Written by Currencies #15 Cowork, 2026-11-04, from GB.glp at GLP main b4fb7f13.
%% ---------------------------------------------------------------------------

NameTerm   ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
             ; ext(NameTerm, Constant).
Arg        ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
             ; sgn(Constant, Integer) ; num(Constant).
Args       ::= [] ; [Arg | Args].
Atom       ::= atom(Constant, Args).
Atoms      ::= [] ; [Atom | Atoms].
Mult       ::= Atom ; times(Arg, Atom).
Mults      ::= [] ; [Mult | Mults].
Guard      ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind   ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec   ::= rs(Guard, Mults, Mults, Atoms, Atoms)
             ; crs(RoleKind, Guard, Mults, Mults, Atoms, Atoms).
RoleSpecs  ::= [] ; [RoleSpec | RoleSpecs].
Constraint ::= true ; and(Constraint, Constraint)
             ; gt(Arg, Arg) ; le(Arg, Arg) ; succ(Arg, Arg).
Reach      ::= reach(NameTerm, Constant, NameTerm).
Reaches    ::= [] ; [Reach | Reaches].
Names      ::= [] ; [Constant | Names].
Schema     ::= schema(Constant, Names, Args, RoleSpecs)
             ; nschema(Constant, Names, Args, Constraint, RoleSpecs)
             ; cschema(Constant, Names, Args, Reaches, RoleSpecs).
Contract   ::= [] ; [Schema | Contract].
Preds      ::= [] ; [Constant | Preds].
Declared   ::= Contract ; reflexive(Preds, Contract) ; environment(Preds, Contract).

%% contract_named(dgc, C): the contract, DGC (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(dgc, environment([today],
%% GKK:1, Identity: act once, so establish forbids the identity it adds.
   [schema(establish, ['Alice'], [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]),
%% GKK:2, Acquaintance.
    schema(acquaint, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
%% GKK:3, Introduction: p, who knows q and c, introduces c to q, who knows p.
    schema(introduce, ['Alice', 'Bob'], [pvar(c)],
       [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
        rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:1, Minting: p mints k p-coins of f.
    schema(mint_coin, ['Alice'], [num(f), num(k)],
       [rs(guarded, [times(num(k), atom(coin, [role(1), num(f)]))], [], [atom(identity, [])], [])]),
%% DGC:1, Minting: p mints k p-bonds of f maturing at d, later than p's date t.
    nschema(mint_bond, ['Alice'], [num(f), num(d), num(k), num(t)], gt(num(d), num(t)),
       [rs(guarded, [times(num(k), atom(bond, [role(1), num(f), num(d)]))], [], [atom(identity, []), atom(date, [num(t)])], [])]),
%% DGC:2, Date: p's first date is the day, once; no role guards it.
    schema(first_date, ['Alice'], [num(d)],
       [rs(unguarded, [atom(date, [num(d)]), atom(dated, [])], [], [atom(identity, []), atom(today, [num(d)])], [atom(dated, [])])]),
%% DGC:2, Date: p's date advances to the next day, not past the day; no role guards it.
    nschema(advance, ['Alice'], [num(t), num(t1), num(d)], and(succ(num(t), num(t1)), le(num(t1), num(d))),
       [rs(unguarded, [atom(date, [num(t1)])], [atom(date, [num(t)])], [atom(identity, []), atom(today, [num(d)])], [])]),
%% DGC:3, Swap: p and q, who know each other, swap k coins of u for k1 coins of v; each comes to know the issuer of what they receive, in f.
    schema(swap_cc, ['Alice', 'Bob'], [num(f), pvar(u), num(k), pvar(v), num(k1)],
       [rs(guarded, [times(num(k1), atom(coin, [pvar(v), num(f)])), atom(knows, [pvar(v)])], [times(num(k), atom(coin, [pvar(u), num(f)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u), num(f)])), atom(knows, [pvar(u)])], [times(num(k1), atom(coin, [pvar(v), num(f)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:3, Swap: k coins of u for k1 bonds of v maturing at d1, in f.
    schema(swap_cb, ['Alice', 'Bob'], [num(f), pvar(u), num(k), pvar(v), num(d1), num(k1)],
       [rs(guarded, [times(num(k1), atom(bond, [pvar(v), num(f), num(d1)])), atom(knows, [pvar(v)])], [times(num(k), atom(coin, [pvar(u), num(f)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u), num(f)])), atom(knows, [pvar(u)])], [times(num(k1), atom(bond, [pvar(v), num(f), num(d1)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:3, Swap: k bonds of u maturing at d for k1 coins of v, in f.
    schema(swap_bc, ['Alice', 'Bob'], [num(f), pvar(u), num(d), num(k), pvar(v), num(k1)],
       [rs(guarded, [times(num(k1), atom(coin, [pvar(v), num(f)])), atom(knows, [pvar(v)])], [times(num(k), atom(bond, [pvar(u), num(f), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(f), num(d)])), atom(knows, [pvar(u)])], [times(num(k1), atom(coin, [pvar(v), num(f)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:3, Swap: k bonds of u maturing at d for k1 bonds of v maturing at d1, in f.
    schema(swap_bb, ['Alice', 'Bob'], [num(f), pvar(u), num(d), num(k), pvar(v), num(d1), num(k1)],
       [rs(guarded, [times(num(k1), atom(bond, [pvar(v), num(f), num(d1)])), atom(knows, [pvar(v)])], [times(num(k), atom(bond, [pvar(u), num(f), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(f), num(d)])), atom(knows, [pvar(u)])], [times(num(k1), atom(bond, [pvar(v), num(f), num(d1)]))], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:4, Acceptance: p, who holds a coin of u in f, accepts k u-coins in f in payment, a quota of L acceptances.
    schema(accept_c, ['Alice'], [num(f), pvar(u), num(l)],
       [rs(guarded, [times(num(l), atom(accepts, [pvar(u), num(f)]))], [], [atom(identity, []), atom(coin, [pvar(u), num(f)])], [])]),
%% DGC:4, Acceptance: p, who holds a bond of u in f maturing at d, accepts u-coins in f up to L.
    schema(accept_b, ['Alice'], [num(f), pvar(u), num(d), num(l)],
       [rs(guarded, [times(num(l), atom(accepts, [pvar(u), num(f)]))], [], [atom(identity, []), atom(bond, [pvar(u), num(f), num(d)])], [])]),
%% DGC:4, Payment: p pays k q-coins to q, whom p knows, in f.
    schema(pay, ['Alice', 'Bob'], [num(f), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [role(2), num(f)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [times(num(k), atom(coin, [role(2), num(f)]))], [], [atom(identity, [])], [])]),
%% DGC:5, Payment by the issuer: p pays k of their own coins in f to q, whom p knows, who accepts them, k acceptances spent.
    schema(payout, ['Alice', 'Bob'], [num(f), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [role(1), num(f)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [times(num(k), atom(coin, [role(1), num(f)]))], [times(num(k), atom(accepts, [role(1), num(f)]))], [atom(identity, [])], [])]),
%% DGC:5, Payment in a third party's coins: p pays k coins of s in f to q, who accepts them, s the issuer a party to the payment and not a guard.
    schema(spend, ['Alice', 'Bob', 'Carol'], [num(f), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [role(3), num(f)]))], [atom(identity, [])], []),
        rs(unguarded, [times(num(k), atom(coin, [role(3), num(f)]))], [times(num(k), atom(accepts, [role(3), num(f)]))], [atom(identity, [])], []),
        rs(unguarded, [], [], [atom(identity, [])], [])]),
%% DGC:5, Redemption: p redeems a q-coin against a coin of r held by q, whom p knows; p comes to know r, in f.
    schema(redeem_cc, ['Alice', 'Bob'], [num(f), pvar(r)],
       [rs(guarded, [atom(coin, [pvar(r), num(f)]), atom(knows, [pvar(r)])], [atom(coin, [role(2), num(f)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(coin, [role(2), num(f)])], [atom(coin, [pvar(r), num(f)])], [atom(identity, [])], [])]),
%% DGC:5, Redemption: p redeems a q-coin against a bond of r maturing at d1 held by q, in f.
    schema(redeem_cb, ['Alice', 'Bob'], [num(f), pvar(r), num(d1)],
       [rs(guarded, [atom(bond, [pvar(r), num(f), num(d1)]), atom(knows, [pvar(r)])], [atom(coin, [role(2), num(f)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(coin, [role(2), num(f)])], [atom(bond, [pvar(r), num(f), num(d1)])], [atom(identity, [])], [])]),
%% DGC:5, Redemption: p redeems a q-bond maturing at d, mature by q's date t, against a coin of r held by q, in f.
    nschema(redeem_bc, ['Alice', 'Bob'], [num(f), num(d), pvar(r), num(t)], le(num(d), num(t)),
       [rs(guarded, [atom(coin, [pvar(r), num(f)]), atom(knows, [pvar(r)])], [atom(bond, [role(2), num(f), num(d)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(bond, [role(2), num(f), num(d)])], [atom(coin, [pvar(r), num(f)])], [atom(identity, []), atom(date, [num(t)])], [])]),
%% DGC:5, Redemption: p redeems a matured q-bond maturing at d against a bond of r maturing at d1 held by q, in f.
    nschema(redeem_bb, ['Alice', 'Bob'], [num(f), num(d), pvar(r), num(d1), num(t)], le(num(d), num(t)),
       [rs(guarded, [atom(bond, [pvar(r), num(f), num(d1)]), atom(knows, [pvar(r)])], [atom(bond, [role(2), num(f), num(d)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(bond, [role(2), num(f), num(d)])], [atom(bond, [pvar(r), num(f), num(d1)])], [atom(identity, []), atom(date, [num(t)])], [])]),
%% DGC:7, Escrow: p deposits k coins of u with the escrow agent e; they know each other, and e comes to know u, in f.
    schema(deposit_c, ['Alice', 'Carol'], [num(f), pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u), num(f)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u), num(f)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:7, Escrow: p deposits k bonds of u maturing at d with the escrow agent e; they know each other, in f.
    schema(deposit_b, ['Alice', 'Carol'], [num(f), pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(f), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(f), num(d)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:7, Escrow: e releases k coins of u to q; they know each other, and q comes to know u, in f.
    schema(release_c, ['Carol', 'Bob'], [num(f), pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u), num(f)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u), num(f)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:7, Escrow: e releases k bonds of u maturing at d to q; they know each other, in f.
    schema(release_b, ['Carol', 'Bob'], [num(f), pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(f), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(f), num(d)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:7, Escrow: e returns k coins of u to the depositor p; they know each other, and p comes to know u, in f.
    schema(return_c, ['Carol', 'Alice'], [num(f), pvar(u), num(k)],
       [rs(guarded, [], [times(num(k), atom(coin, [pvar(u), num(f)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(coin, [pvar(u), num(f)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% DGC:7, Escrow: e returns k bonds of u maturing at d to the depositor p; they know each other, in f.
    schema(return_b, ['Carol', 'Alice'], [num(f), pvar(u), num(d), num(k)],
       [rs(guarded, [], [times(num(k), atom(bond, [pvar(u), num(f), num(d)]))], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [times(num(k), atom(bond, [pvar(u), num(f), num(d)])), atom(knows, [pvar(u)])], [], [atom(identity, []), atom(knows, [role(1)])], [])])])).
