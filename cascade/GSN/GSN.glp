%% GSN.glp --- printed by adopt.py from GSN.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit GSN.txt and run adopt.py GSN.
% contract_named(gsn, C): the contract, GSN.
procedure contract_named(Constant?, SDeclared).
contract_named(gsn, [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(knows, ['Alice', 'Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice'])), not(atom(member, ['Alice', '_', 'Bob'])), not(atom(member, ['Bob', '_', 'Alice'])), not(atom(listed, ['Alice', 'Bob', '_'])), not(atom(listed, ['Bob', 'Alice', '_']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(message, ['Bob', 'Alice'], ['Text'], [atom(message, ['Bob', 'Alice', 'Text'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(create, ['Alice'], ['Grupo'], [atom(leader, ['Alice', 'Grupo']), atom(member, ['Alice', 'Grupo', 'Alice']), atom(listed, ['Alice', 'Alice', 'Grupo'])], [atom(identity, ['Alice']), not(atom(leader, ['Alice', 'Grupo']))], true, ['Alice']),
 sas(close, ['Alice'], ['Grupo'], [not(atom(leader, ['Alice', 'Grupo'])), not(atom(listed, ['Alice', '_', 'Grupo'])), forall(['E1'], atom(listed, ['Alice', 'E1', 'Grupo']), true, [not(atom(member, ['E1', 'Grupo', '_']))])], [atom(identity, ['Alice']), atom(leader, ['Alice', 'Grupo']), forall(['E1'], atom(listed, ['Alice', 'E1', 'Grupo']), true, [atom(identity, ['E1']), atom(member, ['E1', 'Grupo', '_'])])], true, ['Alice']),
 sas(join, ['Bob', 'Alice'], ['Grupo'], [atom(member, ['Bob', 'Grupo', 'Alice']), atom(listed, ['Alice', 'Bob', 'Grupo'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(leader, ['Alice', 'Grupo']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(member, ['Bob', 'Grupo', '_']))], true, ['Alice', 'Bob']),
 sas(remove, ['Bob', 'Alice'], ['Grupo'], [not(atom(member, ['Bob', 'Grupo', 'Alice'])), not(atom(listed, ['Alice', 'Bob', 'Grupo']))], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(leader, ['Alice', 'Grupo']), atom(member, ['Bob', 'Grupo', 'Alice']), atom(listed, ['Alice', 'Bob', 'Grupo'])], true, ['Alice']),
 sas(leave, ['Bob', 'Alice'], ['Grupo'], [not(atom(member, ['Bob', 'Grupo', 'Alice'])), not(atom(listed, ['Alice', 'Bob', 'Grupo']))], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(member, ['Bob', 'Grupo', 'Alice']), atom(listed, ['Alice', 'Bob', 'Grupo'])], true, ['Bob']),
 sas(post, ['Alice', 'Bob'], ['Text', 'Grupo'], [atom(posted, ['Alice', 'Text', 'Bob', 'Grupo'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(member, ['Bob', 'Grupo', 'Alice']), not(atom(posted, ['Alice', 'Text', 'Bob', 'Grupo']))], true, ['Bob']),
 sas(deliver, ['Alice', 'Carol', 'Bob'], ['Bob', 'Text', 'Grupo'], [atom(group_delivered, ['Alice', 'Bob', 'Text', 'Grupo', 'Carol']), atom(group_message, ['Carol', 'Bob', 'Text', 'Grupo', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(leader, ['Alice', 'Grupo']), atom(posted, ['Alice', 'Text', 'Bob', 'Grupo']), atom(listed, ['Alice', 'Bob', 'Grupo']), atom(listed, ['Alice', 'Carol', 'Grupo']), not(atom(group_delivered, ['Alice', 'Bob', 'Text', 'Grupo', 'Carol']))], true, [])]).
