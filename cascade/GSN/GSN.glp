%% ---------------------------------------------------------------------------
%% GSN.glp --- the grassroots social network contract, GSC's, extending GSG, in the clause syntax
%% of GSC's paper, Section 3.2 (Udi, 2026-11-04, to GSC #11; the form is described in GKK.glp).
%% The clauses are in GSN.txt beside this file: message is GSN:1, create and close GSN:2, join,
%% leave, remove and GSN's unfriend, which replaces GSG's, GSN:3, and post_own, post, deliver and
%% deliver_leader GSN:4.  A group is the name <Alice>.n, Alice its leader; close has a quantified conjunct in its
%% body and in its head over every Bob that Alice lists (GSC, Section 3.2); unfriend clears every
%% listing and membership between the two.  Every role but establish's requires identity.
%% ---------------------------------------------------------------------------

% contract_named(gsn, C): the contract, GSN (Coordination Appendix C).
procedure contract_named(Constant?, SContract).
contract_named(gsn,
   [sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))], true, ['Alice']),
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
    sas(introduce, ['Alice', 'Bob', 'Carol'], ['Carol'],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice'])], true, ['Alice', 'Bob']),
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice']))],
       true, ['Alice', 'Bob']),
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(listed, ['Alice', 'Bob', '_'])),
        not(atom(member, ['Alice', ext(own('Bob'), '_')])),
        not(atom(friend, ['Bob', 'Alice'])), not(atom(listed, ['Bob', 'Alice', '_'])),
        not(atom(member, ['Bob', ext(own('Alice'), '_')]))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
    sas(message, ['Alice', 'Bob'], [x],
       [atom(received, ['Bob', x, 'Alice'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), atom(identity, ['Bob'])],
       true, ['Alice']),
    sas(create, ['Alice'], [n],
       [atom(member, ['Alice', ext(own('Alice'), n)]), atom(listed, ['Alice', 'Alice', n])],
       [atom(identity, ['Alice']), not(atom(member, ['Alice', ext(own('Alice'), n)])),
        not(atom(closed, ['Alice', n]))], true, ['Alice']),
    sas(join, ['Alice', 'Bob'], [n],
       [atom(listed, ['Alice', 'Bob', n]), atom(member, ['Bob', ext(own('Alice'), n)])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]), atom(friend, ['Alice', 'Bob']),
        atom(identity, ['Bob']), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       true, ['Alice', 'Bob']),
    sas(leave, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(listed, ['Alice', 'Bob', n]),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])], true, ['Bob']),
    sas(remove, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(listed, ['Alice', 'Bob', n]),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])], true, ['Alice']),
    sas(close, ['Alice', 'Bob'], [n],
       [atom(closed, ['Alice', n]), not(atom(listed, ['Alice', 'Alice', n])),
        not(atom(member, ['Alice', ext(own('Alice'), n)])),
        forall('Bob', atom(listed, ['Alice', 'Bob', n]),
               [not(atom(member, ['Bob', ext(own('Alice'), n)]))])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Alice', n]),
        forall('Bob', atom(listed, ['Alice', 'Bob', n]),
               [atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])])],
       true, ['Alice']),
    sas(post_own, ['Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        not(atom(posted, ['Alice', x, n]))], true, ['Alice']),
    sas(post, ['Bob', 'Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)]),
        atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(posted, ['Alice', x, n]))], true, ['Bob']),
    sas(deliver, ['Alice', 'Bob'], [x, n],
       [atom(delivered, ['Alice', x, 'Bob', n]), atom(received_in, ['Bob', x, 'Alice', n])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(posted, ['Alice', x, n]), atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(delivered, ['Alice', x, 'Bob', n])),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])], true, []),
%% GSN:4, the leader's own receipt: the leader is a member (GSN:2), and deliver binds two persons
%% (GSC, Definition Binding), so the leader receives each post of her group by this schema, with
%% no guard, once (the audit's finding, Grassroots-Audit ab6fc26, programs/gsc/GSN.glp.md, 1).
    sas(deliver_leader, ['Alice'], [x, n],
       [atom(received_in, ['Alice', x, 'Alice', n])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(posted, ['Alice', x, n]), not(atom(received_in, ['Alice', x, 'Alice', n]))], true, [])]).
