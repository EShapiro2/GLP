step(own, _, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- take_own(Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure next(Then?, YesNo?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
next(Th, Kick, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next_n(Th?, Kick?, Ap0?, [], Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure next_n(Then?, YesNo?, App?, Outputs?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
next_n(Th, Kick, Ap0, Ns, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(Ap0?), ground(St?) | app_changed(Ap0?, St?, Ca1), app_changed(Ap0?, St?, Ca2), app_changed(Ap0?, St?, Ca3), or(Ca2?, Kick?, Re), close_falsified(Ca1?, Approvals?, St?, Approvals1), spend(Ca3?, St?, H?, St0, H1), repend(Re?, St0?, Ag, St1), own_after(Th?, Ow, Ow1?, U), app(Ag?, Ls?, L1), show_state(Ap0?, St?, Thr, Thr1?), put_notices(Ns?, Thr1, Thr2?), agent_goal(L1?, In?, U?, Ans, Thr2, Out, Ow1, Approvals1?, H1?, St1?, D).

procedure show_state(App?, St?, Stream(Output), Stream(Output)?).
show_state(Ap0, St, Thr?, Thr1) :- ground(Ap0?), ground(St?) | app_ms(Ap0?, S00), st_ms(St?, S10), not_today(S00?, S0), not_today(S10?, S1), ms_eq(S0?, S1?, Sm), neg(Sm?, Ch1), app_recs(Ap0?, R0), approvals_of(R0?, A0), st_app(St?, Ap1), app_recs(Ap1?, R1), approvals_of(R1?, A1), same(A0?, A1?, Sa), neg(Sa?, Ch2), or(Ch1?, Ch2?, Ch), show_view(Ch?, St?, Thr, Thr1?).

procedure show_known(Peer?, St?, St?, Stream(Output), Stream(Output)?, St).
show_known(Q, St0, St, Thr?, Thr1, St?) :- ground(Q?), ground(St0?), ground(St?) | known_st(Q?, St0?, B0), known_st(Q?, St?, B1), neg(B0?, N0), and(N0?, B1?, B), show_view(B?, St?, Thr, Thr1?).

