Pair ::= pr(Peer, Peer).
Pairs ::= [] ; [Pair | Pairs].
PKey ::= key(WKey) ; nokey.
Cond ::= go(Info) ; drop.
PCond ::= pgo(Info, Class, Names) ; pdrop.
RCond ::= rgo(Rho, Peer) ; rdrop ; rhold(Proposal) ; rrefuse(Proposal).
RQ ::= rq(RCands, YesNo, YesNo).
RCand ::= rc(Rho, Peer).
RCands ::= [] ; [RCand | RCands].
PName ::= pname(Proposal) ; nopname.
PartRes ::= part(Part) ; nopart.
Mine ::= mine(Rho, Integer) ; notmine.
Outputs ::= [] ; [Output | Outputs].
Classes ::= [] ; [Class | Classes].
MCond ::= mgo(Info) ; mdefer ; mhold ; noparticipant.
Blocker ::= blk(Attempt) ; noblk.
FoundNet ::= found(Net) ; nonefound.
Last ::= last(Attempt) ; nolast.
Known ::= allknown ; unknown(Peer).
Then ::= write_own ; own_unread ; no_own.
ApprovalRes ::= approval_for(Attempt) ; noapproval.
Appr ::= ap(Info, PartsOf).
Apprs ::= [] ; [Appr | Apprs].
PartsOf ::= by_name(Class) ; any_part.

Question ::= menu_w(Menu) ; approval_w(Approval).

procedure atom_of(GAtom?, Shown).
atom_of(g(identity, []), shown(identity)).
atom_of(g(knows, [p(V1)]), shown(knows(V1?))).
atom_of(g(coin, [p(V1)]), shown(coin(V1?))).
atom_of(_, unshown) :- otherwise | true.

procedure contract_schemas(Schemas).
contract_schemas([schema(establish, [], [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]), schema(meet, [], [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []), rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]), schema(introduce, [pvar(c)], [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []), rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]), schema(mint, [num(k)], [rs(guarded, [times(num(k), atom(coin, [role(1)]))], [], [atom(identity, [])], [])]), schema(swap, [pvar(u), num(k), pvar(v), num(k1)], [rs(guarded, [times(num(k1), atom(coin, [pvar(v)]))], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []), rs(guarded, [times(num(k), atom(coin, [pvar(u)]))], [times(num(k1), atom(coin, [pvar(v)]))], [atom(identity, []), atom(knows, [role(1)])], [])]), schema(pay, [num(k)], [rs(guarded, [], [times(num(k), atom(coin, [role(2)]))], [atom(identity, []), atom(knows, [role(2)])], []), rs(unguarded, [times(num(k), atom(coin, [role(2)]))], [], [atom(identity, [])], [])]), schema(redeem, [pvar(r)], [rs(guarded, [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [atom(identity, []), atom(knows, [role(2)])], []), rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [atom(identity, [])], [])])]).

procedure schema_entry(Constant?, Schema).
schema_entry(establish, schema(establish, [], [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])])).
schema_entry(meet, schema(meet, [], [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []), rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])])).
schema_entry(introduce, schema(introduce, [pvar(c)], [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []), rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])])).
schema_entry(mint, schema(mint, [num(k)], [rs(guarded, [times(num(k), atom(coin, [role(1)]))], [], [atom(identity, [])], [])])).
schema_entry(swap, schema(swap, [pvar(u), num(k), pvar(v), num(k1)], [rs(guarded, [times(num(k1), atom(coin, [pvar(v)]))], [times(num(k), atom(coin, [pvar(u)]))], [atom(identity, []), atom(knows, [role(2)])], []), rs(guarded, [times(num(k), atom(coin, [pvar(u)]))], [times(num(k1), atom(coin, [pvar(v)]))], [atom(identity, []), atom(knows, [role(1)])], [])])).
schema_entry(pay, schema(pay, [num(k)], [rs(guarded, [], [times(num(k), atom(coin, [role(2)]))], [atom(identity, []), atom(knows, [role(2)])], []), rs(unguarded, [times(num(k), atom(coin, [role(2)]))], [], [atom(identity, [])], [])])).
schema_entry(redeem, schema(redeem, [pvar(r)], [rs(guarded, [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [atom(identity, []), atom(knows, [role(2)])], []), rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [atom(identity, [])], [])])).
schema_entry(Nm, schema(Nm?, [], [])) :- otherwise | true.

procedure schema_numeric(Constant?, Numeric).
schema_numeric(_, numeric(true, [], every)) :- otherwise | true.

procedure reflexive_preds(Preds).
reflexive_preds([]).

procedure introduction_preds(Preds).
introduction_preds([]).

procedure binding_of(Class?, Constant, Binding).
binding_of(establish(V1), establish, [b(role(1), p(V1?))]).
binding_of(meet(V1, V2), meet, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(introduce(V1, V2, V3), introduce, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(pvar(c), p(V3?))]).
binding_of(mint(V1, V2), mint, [b(role(1), p(V1?)), b(num(k), n(V2?))]).
binding_of(swap(V1, V2, V3, V4, V5, V6), swap, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(pvar(u), p(V3?)), b(num(k), n(V4?)), b(pvar(v), p(V5?)), b(num(k1), n(V6?))]).
binding_of(pay(V1, V2, V3), pay, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(num(k), n(V3?))]).
binding_of(redeem(V1, V2, V3), redeem, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(pvar(r), p(V3?))]).

procedure class_of(Constant?, Binding?, Peer?, Class).
class_of(establish, B, D, establish(V1?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1).
class_of(meet, B, D, meet(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(introduce, B, D, introduce(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(pvar(c), B?, D?, V3).
class_of(mint, B, D, mint(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_num(num(k), B?, V2).
class_of(swap, B, D, swap(V1?, V2?, V3?, V4?, V5?, V6?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(pvar(u), B?, D?, V3), val_num(num(k), B?, V4), val_peer(pvar(v), B?, D?, V5), val_num(num(k1), B?, V6).
class_of(pay, B, D, pay(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_num(num(k), B?, V3).
class_of(redeem, B, D, redeem(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(pvar(r), B?, D?, V3).

procedure name_class(Proposal?, GAtoms?, Class).
name_class(establish(V1), _, establish(V1?)).
name_class(meet(V1, V2), _, meet(V1?, V2?)).
name_class(introduce(V1, V2, V3), _, introduce(V1?, V2?, V3?)).
name_class(mint(V1, V2), _, mint(V1?, V2?)).
name_class(swap(V1, V2, V3, V4, V5, V6), _, swap(V1?, V2?, V3?, V4?, V5?, V6?)).
name_class(pay(V1, V2, V3), _, pay(V1?, V2?, V3?)).
name_class(redeem(V1, V2, V3), _, redeem(V1?, V2?, V3?)).

procedure request_name(Class?, PName).
request_name(establish(V1), pname(establish(V1?))).
request_name(meet(V1, V2), pname(meet(V1?, V2?))).
request_name(introduce(V1, V2, V3), pname(introduce(V1?, V2?, V3?))).
request_name(mint(V1, V2), pname(mint(V1?, V2?))).
request_name(swap(V1, V2, V3, V4, V5, V6), pname(swap(V1?, V2?, V3?, V4?, V5?, V6?))).
request_name(pay(V1, V2, V3), pname(pay(V1?, V2?, V3?))).
request_name(redeem(V1, V2, V3), pname(redeem(V1?, V2?, V3?))).
request_name(_, nopname) :- otherwise | true.

procedure tabs(List(Tab)).
tabs([tab('Contacts', knows), tab('Coins', coin, counted)]).

procedure sentence_of(Class?, Peer?, List(Word)).
sentence_of(meet(V1, V2), Me, Ws?) :- ground(V2?), ground(V1?), ground(Me?) | ask_of([q(V2?, [person(V1?), text(' wishes that you know each other.')])], Me?, Ws).
sentence_of(introduce(V1, V2, V3), Me, Ws?) :- ground(V2?), ground(V1?), ground(V3?), ground(Me?) | ask_of([q(V2?, [person(V1?), text(' asks to introduce '), person(V3?), text(' to you.')])], Me?, Ws).
sentence_of(swap(V1, V2, V3, V4, V5, V6), Me, Ws?) :- ground(V2?), ground(V1?), ground(V3?), ground(V4?), ground(V5?), ground(V6?), ground(Me?) | ask_of([q(V2?, [person(V1?), text(' asks to swap coins with you.'), named('issuer given', V3?), valued('amount given', V4?), named('issuer wanted', V5?), valued('amount wanted', V6?)])], Me?, Ws).
sentence_of(_, _, []) :- otherwise | true.

procedure meeting_peer(Proposal?, Peer?, MeetPeer).
meeting_peer(meet(V1, V2), Me, P?) :- ground(V1?), ground(V2?), ground(Me?) | meet_other(V1?, V2?, Me?, P).
meeting_peer(_, _, nopeer) :- otherwise | true.

exported procedure agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output), Stream(Ask(Question))).
agent(Id, NetIn, Out?, [view([], [], [], Ts?) | Thr?], D?) :- ground(Id?) | tabs(Ts), request(Id?, [], Rq, D1), tag_net(NetIn?, Nt), merge(Rq?, Nt?, M1), merge(M1?, Ans?, M2), merge(M2?, [own | Ow?], In), agent_goal([], In?, yes, Ans, Thr, Out, Ow, [], [], st(Id?, app([], 0, unlocked, []), 0, [], [], [], [], [], [], [], [], [], ix(nil, [], [], ic([], [], [])), []), D2), merge(D1?, D2?, D).

procedure request(Key?, List(Key)?, Stream(Trigger), Stream(Ask(Question))).
request(S1, S2, S3?, [ask('Menu', menu_w(X?)) | D?]) :- request1(S1?, S2?, S3, X, D).

procedure request1(Key?, List(Key)?, Stream(Trigger), Menu, Stream(Ask(Question))).
request1(Id, Ks, Out?, menu(Id?, Ks?, R), []) :- ground(Id?), ground(Ks?) | await_request(R?, Out).

procedure await_request(Request?, Stream(Trigger)).
await_request(propose(C), [req(propose(C?))]).

procedure ask_next(St?, Stream(Trigger), Stream(Trigger)?, Stream(Ask(Question))).
ask_next(St, Ans?, Ans1, D?) :- ground(St?) | st_id(St?, Id), st_known(St?, Ks), request(Id?, Ks?, R, D), merge(R?, Ans1?, Ans).

procedure tag_net(Stream(Net)?, Stream(Trigger)).
tag_net([M | Ms], [net(M?) | Ts?]) :- tag_net(Ms?, Ts).
tag_net([], []).

procedure respond(Attempt?, List(Word)?, Close?, Stream(Trigger), Stream(Ask(Question))).
respond(S1, S2, S3, S4?, [ask('Approval', approval_w(X?)) | D?]) :- respond1(S1?, S2?, S3?, S4, X, D).

procedure respond1(Attempt?, List(Word)?, Close?, Stream(Trigger), Approval, Stream(Ask(Question))).
respond1(At, Ws, Cl, Out?, approval(At?, Ws?, YN), []) :- ground(At?) | await(At?, YN?, Cl?, Out).

procedure await(Attempt?, YesNo?, Close?, Stream(Trigger)).
await(At, yes, _, [answered(At?, yes)]).
await(At, no, _, [answered(At?, no)]).
await(_, _, close, []).

procedure greet(Peer?, Proposal?, List(Word)?, Stream(Trigger), Stream(Ask(Question))).
greet(S1, S2, S3, S4?, [ask('Approval', approval_w(X?)) | D?]) :- greet1(S1?, S2?, S3?, S4, X, D).

procedure greet1(Peer?, Proposal?, List(Word)?, Stream(Trigger), Approval, Stream(Ask(Question))).
greet1(Q, N, Ws, Out?, approval(hello(Q?, N?), Ws?, YN), []) :- ground(Q?), ground(N?) | await_greet(N?, YN?, Out).

procedure await_greet(Proposal?, YesNo?, Stream(Trigger)).
await_greet(N, yes, [greeted(N?)]).
await_greet(_, no, []).

procedure agent_goal(Stream(Trigger)?, Stream(Trigger)?, YesNo?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
agent_goal([T | Ls], In, U, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- then_local(U?, Th), step(T?, Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
agent_goal([], [T | In], U, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- then_read(U?, Th), step(T?, Th?, [], In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
agent_goal([], [], _, [], [], [], [], _, _, _, []).

procedure then_local(YesNo?, Then).
then_local(yes, own_unread).
then_local(no, no_own).

procedure then_read(YesNo?, Then).
then_read(yes, own_unread).
then_read(no, write_own).

procedure step(Trigger?, Then?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
step(req(propose(N)), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(N?), ground(St?) | st_app(St?, Ap0), ask_next(St?, Ans, Ans1?, D1), st_id(St?, Id), meeting_peer(N?, Id?, Mp), meet_hello(Mp?, N?, St?, Out, Out1?, Thr, Thr1?, St0), request_cond(N?, St0?, Cd, St1), dispatch_request(Cd?, Th?, Ap0?, Ls?, In?, Ans1, Thr1, Out1, Ow, Approvals?, H?, St1?, D2), merge(D1?, D2?, D).
step(greeted(N), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(N?), ground(St?) | st_app(St?, Ap0), st_id(St?, Id), meeting_peer(N?, Id?, Mp), meet_hello(Mp?, N?, St?, Out, Out1?, Thr, Thr1?, St0), request_cond(N?, St0?, Cd, St1), dispatch_request(Cd?, Th?, Ap0?, Ls?, In?, Ans, Thr1, Out1, Ow, Approvals?, H?, St1?, D).
step(again(N), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(N?), ground(St?) | st_app(St?, Ap0), request_cond(N?, St?, Cd, St1), dispatch_request(Cd?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).
step(net(msg(_, hello(P, N))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(P?), ground(N?), ground(St?) | st_app(St?, Ap0), hello_cond(P?, St?, Cd), dispatch_hello(Cd?, P?, N?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
step(net(msg(_, ihello(P))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(P?), ground(St?) | st_app(St?, Ap0), ihello_cond(P?, St?, Cd), dispatch_ihello(Cd?, P?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
step(net(msg(_, intro(_, Q))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(Q?), ground(St?) | st_app(St?, Ap0), intro_cond(Q?, St?, Cd), dispatch_intro(Cd?, Q?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
step(net(msg(To, cargo(F, X))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(To?), ground(F?), ground(X?), ground(St?) | st_app(St?, Ap0), message_cond(X?, St?, Cd, St1), dispatch_message(Cd?, msg(To?, cargo(F?, X?)), F?, X?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).
step(answered(At, YN), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?), ground(YN?), ground(St?) | st_app(St?, Ap0), close_approval(At?, Approvals?, Approvals1), answer_cond(At?, St?, Cd, St1), dispatch_answer(Cd?, YN?, At?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals1?, H?, St1?, D).
