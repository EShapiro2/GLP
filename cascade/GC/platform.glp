Send ::= to(Peer, Cargo).
Sends ::= [] ; [Send | Sends].
Subj ::= sub(Info) ; pair ; prop(Info, Class, Names).
Cand ::= cand(WKey, Subj).
Cands ::= [] ; [Cand | Cands].
