%% Compiled from vGLP by the canonical compilation
%% (vGLP, Definition "Canonical Compilation").  Do not edit: edit
%% the .vglp source and compile again.

Class ::= mint(Peer) ; swap(Peer, Peer, Peer, Peer) ; pay(Peer, Peer) ; redeem(Peer, Peer, Peer).
Proposal ::= mint(Peer) ; swap(Peer, Peer, Peer, Peer) ; pay(Peer, Peer) ; redeem(Peer, Peer, Peer).
Request ::= propose(Proposal) ; known(Peer).
Peer ::= Key.
Speech ::= speech(Utterance, Peer).
Utterance ::= utterance(String) ; Speech.
YesNo ::= yes ; no.
Decision ::= commit ; abort.
Attempt ::= attempt(Peer, Integer, Integer, Class).
Cargo ::= start(Attempt) ; vote(Attempt, YesNo) ; outcome(Attempt, Decision) ; yield(Attempt).
Content ::= hello(Peer) ; ihello(Peer) ; intro(Peer, Peer) ; cargo(Peer, Cargo).
Net ::= msg(Peer, Content).
Txn ::= propose(Attempt) ; start(Attempt) ; answer(Attempt) ; vote(Attempt) ; tally(Attempt) ; commit(Attempt) ; yield(Attempt) ; wound(Attempt, Attempt) ; outcome(Attempt) ; introduce_peers(Peer, Peer) ; discover(Peer).
Output ::= Txn.
Approval ::= approval(Attempt, YesNo?).
Menu ::= menu(Key, List(Key), Request?).
Close ::= close.
Trigger ::= req(Request) ; net(Net) ; answered(Attempt, YesNo) ; recheck ; own.
Var ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; sgn(Constant, Integer).
Vars ::= [] ; [Var | Vars].
SAtom ::= atom(Constant, Vars).
SAtoms ::= [] ; [SAtom | SAtoms].
Guard ::= guarded ; unguarded.
RoleSpec ::= rs(Guard, SAtoms, SAtoms, SAtoms, SAtoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Schema ::= schema(Constant, RoleSpecs).
Schemas ::= [] ; [Schema | Schemas].
Preds ::= [] ; [Constant | Preds].
Val ::= p(Peer) ; s(Speech).
Vals ::= [] ; [Val | Vals].
GAtom ::= g(Constant, Vals).
GAtoms ::= [] ; [GAtom | GAtoms].
Bind ::= b(Var, Val).
Binding ::= [] ; [Bind | Binding].
Bindings ::= [] ; [Binding | Bindings].
Found ::= found(Val) ; free.
Match ::= match(Binding) ; nomatch.
SgnParts ::= signed(Val, Peer) ; unsigned.
Peers ::= [] ; [Peer | Peers].
PeerSets ::= [] ; [Peers | PeerSets].
Nets ::= [] ; [Net | Nets].
Ints ::= [] ; [Integer | Ints].
Part ::= part(Peer, GAtoms, GAtoms).
Parts ::= [] ; [Part | Parts].
Mate ::= mate(Constant, Binding, Peers, Peer).
Mates ::= [] ; [Mate | Mates].
Opener ::= opener(Peer) ; guarded_class.
Info ::= ci(Class, Parts, Peers, PeerSets, Opener, Mates).
Infos ::= [] ; [Info | Infos].
ClassRes ::= cls(Info) ; nocls.
CVal ::= cmp_val(Val) ; cmp_free(Var).
CVals ::= [] ; [CVal | CVals].
CAtom ::= cmp_atom(Constant, CVals).
CAtoms ::= [] ; [CAtom | CAtoms].
Lock ::= unlocked ; held(Attempt).
Rec ::= asked(Attempt) ; answered(Attempt, YesNo) ; voted(Attempt, YesNo) ; got(Attempt, Peer, YesNo) ; closed(Attempt) ; wounded(Attempt) ; yielded(Attempt) ; introduced(Peer, Peer).
Recs ::= [] ; [Rec | Recs].
App ::= app(GAtoms, Integer, Lock, Recs).
Pend ::= deferred(Net).
Pends ::= [] ; [Pend | Pends].
WKey ::= op(Class) ; vt(Attempt) ; cm(Attempt) ; wd(Attempt, Attempt) ; ip(Peer, Peer).
Wait ::= w(WKey, Integer).
Waits ::= [] ; [Wait | Waits].
WFound ::= at(Integer) ; unseen.
St ::= st(Peer, App, Integer, Peers, Peers, Peers, Peers, Waits, Infos, Pends).
OpenApproval ::= oc(Attempt, Close?).
OpenApprovals ::= [] ; [OpenApproval | OpenApprovals].
Send ::= to(Peer, Cargo).
Sends ::= [] ; [Send | Sends].
Subj ::= sub(Info) ; pair.
Cand ::= cand(WKey, Subj).
Cands ::= [] ; [Cand | Cands].
Choice ::= take(WKey, Subj) ; none.
Pair ::= pr(Peer, Peer).
Pairs ::= [] ; [Pair | Pairs].
PKey ::= key(WKey) ; nokey.
Cond ::= go(Info) ; drop.
MCond ::= mgo(Info) ; mdefer ; nopart.
Blocker ::= blk(Attempt) ; noblk.
FoundNet ::= found(Net) ; nonefound.
Last ::= last(Attempt) ; nolast.
Known ::= allknown ; unknown(Peer).
Then ::= after ; done.
ApprovalRes ::= approval_for(Attempt) ; noapproval.

Question ::= menu_w(Menu) ; approval_w(Approval).

procedure contract_schemas(Schemas).
contract_schemas([schema(mint, [rs(guarded, [atom(coin, [role(1)])], [], [], [])]), schema(swap, [rs(guarded, [atom(coin, [pvar(v)])], [atom(coin, [pvar(u)])], [], []), rs(guarded, [atom(coin, [pvar(u)])], [atom(coin, [pvar(v)])], [], [])]), schema(pay, [rs(guarded, [], [atom(coin, [role(2)])], [], []), rs(unguarded, [atom(coin, [role(2)])], [], [], [])]), schema(redeem, [rs(guarded, [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [], []), rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [], [])])]).

procedure reflexive_preds(Preds).
reflexive_preds([]).

procedure introduction_preds(Preds).
introduction_preds([]).

procedure binding_of(Class?, Constant, Binding).
binding_of(mint(V1), mint, [b(role(1), p(V1?))]).
binding_of(swap(V1, V2, V3, V4), swap, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(pvar(v), p(V3?)), b(pvar(u), p(V4?))]).
binding_of(pay(V1, V2), pay, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(redeem(V1, V2, V3), redeem, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(pvar(r), p(V3?))]).

procedure class_of(Constant?, Binding?, Peer?, Class).
class_of(mint, B, D, mint(V1?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1).
class_of(swap, B, D, swap(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(pvar(v), B?, D?, V3), val_peer(pvar(u), B?, D?, V4).
class_of(pay, B, D, pay(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(redeem, B, D, redeem(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(pvar(r), B?, D?, V3).

exported procedure agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output), Stream(Ask(Question))).
agent(Id, NetIn, Out?, Thr?, D?) :- ground(Id?) | request(Id?, [], Rq, D1), tag_net(NetIn?, Nt), merge(Rq?, Nt?, M1), merge(M1?, Ans?, In), agent_goal([own], In?, Ans, Thr, Out, [], st(Id?, app([], 0, unlocked, []), 0, [], [], [], [], [], [], []), D2), merge(D1?, D2?, D).

procedure request(Key?, List(Key)?, Stream(Trigger), Stream(Ask(Question))).
request(S1, S2, S3?, [ask('Menu', menu_w(X?)) | D?]) :- request1(S1?, S2?, S3, X, D).

procedure request1(Key?, List(Key)?, Stream(Trigger), Menu, Stream(Ask(Question))).
request1(Id, Ks, Out?, menu(Id?, Ks?, R), []) :- ground(Id?), ground(Ks?) | await_request(R?, Out).

procedure await_request(Request?, Stream(Trigger)).
await_request(propose(C), [req(propose(C?))]).
await_request(known(Q), [req(known(Q?))]).

procedure ask_next(St?, Stream(Trigger), Stream(Trigger)?, Stream(Ask(Question))).
ask_next(St, Ans?, Ans1, D?) :- ground(St?) | st_id(St?, Id), st_known(St?, Ks), request(Id?, Ks?, R, D), merge(R?, Ans1?, Ans).

procedure tag_net(Stream(Net)?, Stream(Trigger)).
tag_net([M | Ms], [net(M?) | Ts?]) :- tag_net(Ms?, Ts).
tag_net([], []).

procedure respond(Attempt?, Close?, Stream(Trigger), Stream(Ask(Question))).
respond(S1, S2, S3?, [ask('Approval', approval_w(X?)) | D?]) :- respond1(S1?, S2?, S3, X, D).

procedure respond1(Attempt?, Close?, Stream(Trigger), Approval, Stream(Ask(Question))).
respond1(At, Cl, Out?, approval(At?, YN), []) :- ground(At?) | await(At?, YN?, Cl?, Out).

procedure await(Attempt?, YesNo?, Close?, Stream(Trigger)).
await(At, yes, _, [answered(At?, yes)]).
await(At, no, _, [answered(At?, no)]).
await(_, _, close, []).

procedure agent_goal(Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
agent_goal([T | Ls], In, Ans?, Thr?, Out?, Approvals, St, D?) :- step(T?, done, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
agent_goal([], [T | In], Ans?, Thr?, Out?, Approvals, St, D?) :- step(T?, after, [], In?, Ans, Thr, Out, Approvals?, St?, D).
agent_goal([], [], [], [], [], _, _, []).

procedure step(Trigger?, Then?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
step(req(propose(C)), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(C?), ground(St?) | st_app(St?, Ap0), ask_next(St?, Ans, Ans1?, D1), propose_cond(C?, St?, Cd, St1), dispatch_propose(Cd?, C?, Th?, Ap0?, Ls?, In?, Ans1, Thr, Out, Approvals?, St1?, D2), merge(D1?, D2?, D).
step(req(known(Q)), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(Q?), ground(St?) | st_app(St?, Ap0), ask_next(St?, Ans, Ans1?, D1), known_cond(Q?, St?, Cd), dispatch_known(Cd?, Q?, Th?, Ap0?, Ls?, In?, Ans1, Thr, Out, Approvals?, St?, D2), merge(D1?, D2?, D).
step(net(msg(_, hello(P))), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(P?), ground(St?) | st_app(St?, Ap0), hello_cond(P?, St?, Cd), dispatch_hello(Cd?, P?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
step(net(msg(_, ihello(P))), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(P?), ground(St?) | st_app(St?, Ap0), ihello_cond(P?, St?, Cd), dispatch_ihello(Cd?, P?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
step(net(msg(_, intro(_, Q))), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(Q?), ground(St?) | st_app(St?, Ap0), intro_cond(Q?, St?, Cd), dispatch_intro(Cd?, Q?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
step(net(msg(To, cargo(F, X))), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(To?), ground(F?), ground(X?), ground(St?) | st_app(St?, Ap0), message_cond(X?, St?, Cd, St1), dispatch_message(Cd?, msg(To?, cargo(F?, X?)), F?, X?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St1?, D).
step(answered(At, YN), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(At?), ground(YN?), ground(St?) | st_app(St?, Ap0), close_approval(At?, Approvals?, Approvals1), answer_cond(At?, St?, Cd, St1), dispatch_answer(Cd?, YN?, At?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals1?, St1?, D).
step(recheck, Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(St?) | st_pends(St?, Pd), recheck_find(Pd?, St?, F), recheck1(F?, Th?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
step(own, _, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- take_own(Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure next(Then?, YesNo?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
next(Th, Kick, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(Ap0?), ground(St?) | app_changed(Ap0?, St?, Ca1), app_changed(Ap0?, St?, Ca2), or(Ca2?, Kick?, Re), close_falsified(Ca1?, Approvals?, St?, Approvals1), repend(Re?, St?, Ag, St1), own_after(Th?, Ow), app(Ag?, Ls?, L1), app(L1?, Ow?, L2), agent_goal(L2?, In?, Ans, Thr, Out, Approvals1?, St1?, D).

procedure app_changed(App?, St?, YesNo).
app_changed(Ap0, St, C?) :- ground(Ap0?), ground(St?) | st_app(St?, Ap1), same(Ap0?, Ap1?, Sm), neg(Sm?, C).

procedure own_after(Then?, Stream(Trigger)).
own_after(after, [own]).
own_after(done, []).

procedure repend(YesNo?, St?, Stream(Trigger), St).
repend(no, St, [], St?).
repend(yes, St, Ag?, St?) :- ground(St?) | st_pends(St?, Pd), pend_triggers(Pd?, Ag).

procedure pend_triggers(Pends?, Stream(Trigger)).
pend_triggers([], []).
pend_triggers([_ | _], [recheck]).

procedure propose_cond(Class?, St?, Cond, St).
propose_cond(C, St, Cd?, St2?) :- ground(C?), ground(St?) | st_class(C?, St?, R, St1), propose_cond1(R?, St1?, Cd, St2).

procedure propose_cond1(ClassRes?, St?, Cond, St).
propose_cond1(nocls, St, drop, St?).
propose_cond1(cls(I), St, Cd?, St?) :- ground(I?), ground(St?) | unguarded_i(I?, Ug), neg(Ug?, Gd), guard_of_i(I?, St?, IsG), and(Gd?, IsG?, B), initiate_cond(B?, I?, St?, Cd).

procedure initiate_cond(YesNo?, Info?, St?, Cond).
initiate_cond(no, _, _, drop).
initiate_cond(yes, I, St, Cd?) :- ground(I?), ground(St?) | ready_i(I?, St?, Rd), no_prior_start(St?, Np), others_known(I?, St?, K), known_ok(K?, Kn), and(Rd?, Np?, B1), and(B1?, Kn?, B), go_or_drop(B?, I?, Cd).

procedure dispatch_propose(Cond?, Class?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_propose(go(I), C, Th, Ap0, Ls, In, Ans?, [propose(At?) | Thr?], Out?, Approvals, St, D?) :- ground(I?), ground(C?), ground(St?) | propose_effect(I?, C?, St?, At, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Approvals?, St2?, D).
dispatch_propose(drop, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure known_cond(Peer?, St?, YesNo).
known_cond(Q, St, R?) :- ground(Q?), ground(St?) | st_id(St?, Id), st_sent(St?, Se), same(Q?, Id?, S1), mem(Q?, Se?, S2), or(S1?, S2?, S), neg(S?, R).

procedure dispatch_known(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_known(yes, Q, Th, Ap0, Ls, In, Ans?, Thr?, [msg(Q?, hello(Id?)) | Out?], Approvals, St, D?) :- ground(Q?), ground(St?) | st_id(St?, Id), add_sent(Q?, St?, St1), discovered(Q?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Approvals?, St2?, D).
dispatch_known(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure hello_cond(Peer?, St?, YesNo).
hello_cond(P, St, R?) :- ground(St?) | st_recd(St?, Rc), mem(P?, Rc?, B), neg(B?, R).

procedure dispatch_hello(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_hello(yes, P, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(P?), ground(St?) | add_recd(P?, St?, St1), discovered(P?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Approvals?, St2?, D).
dispatch_hello(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure discovered(Peer?, St?, St?, Stream(Txn), Stream(Txn)?, St).
discovered(Q, St0, St, Thr?, Thr1, St?) :- ground(Q?), ground(St0?), ground(St?) | known_at(Q?, St0?, B0), known_at(Q?, St?, B1), neg(B0?, N0), and(N0?, B1?, B), discover_q(B?, Q?, Thr, Thr1?).

procedure known_at(Peer?, St?, YesNo).
known_at(Q, St, B?) :- known_st(Q?, St?, B).

procedure discover_q(YesNo?, Peer?, Stream(Txn), Stream(Txn)?).
discover_q(yes, Q, [discover(Q?) | Thr1?], Thr1).
discover_q(no, _, Thr1?, Thr1).

procedure intro_cond(Peer?, St?, YesNo).
intro_cond(Q, St, R?) :- ground(Q?), ground(St?) | st_id(St?, Id), st_isent(St?, ISe), same(Q?, Id?, S1), mem(Q?, ISe?, S2), known_st(Q?, St?, S3), or(S1?, S2?, S12), or(S12?, S3?, S), neg(S?, R).

procedure dispatch_intro(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_intro(yes, Q, Th, Ap0, Ls, In, Ans?, Thr?, [msg(Q?, ihello(Id?)) | Out?], Approvals, St, D?) :- ground(Q?), ground(St?) | st_id(St?, Id), add_isent(Q?, St?, St1), discovered(Q?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Approvals?, St2?, D).
dispatch_intro(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure ihello_cond(Peer?, St?, YesNo).
ihello_cond(P, St, R?) :- ground(St?) | st_irecd(St?, Rc), mem(P?, Rc?, B), neg(B?, R).

procedure dispatch_ihello(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_ihello(yes, P, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(P?), ground(St?) | add_irecd(P?, St?, St1), discovered(P?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Approvals?, St2?, D).
dispatch_ihello(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure message_cond(Cargo?, St?, MCond, St).
message_cond(X, St, Cd?, St1?) :- ground(X?), ground(St?) | cargo_class(X?, C), st_class(C?, St?, R, St0), message_cond1(R?, X?, St0?, Cd, St1).

procedure message_cond1(ClassRes?, Cargo?, St?, MCond, St).
message_cond1(nocls, _, St, nopart, St?).
message_cond1(cls(I), start(At), St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), mem(closed(At?), R?, Cl), start_cond(Cl?, I?, At?, St?, Cd).
message_cond1(cls(I), vote(_, _), St, mgo(I?), St?).
message_cond1(cls(I), yield(_), St, mgo(I?), St?).
message_cond1(cls(I), outcome(_, _), St, mgo(I?), St?).

procedure start_cond(YesNo?, Info?, Attempt?, St?, MCond).
start_cond(yes, I, _, _, mgo(I?)).
start_cond(no, I, At, St, Cd?) :- ground(I?) | start_waits(I?, At?, St?, W), defer_cond1(W?, I?, Cd).

procedure defer_cond1(YesNo?, Info?, MCond).
defer_cond1(yes, _, mdefer).
defer_cond1(no, I, mgo(I?)).

procedure start_waits(Info?, Attempt?, St?, YesNo).
start_waits(I, A, St, W?) :- ground(I?), ground(A?), ground(St?) | st_pends(St?, Pd), held_prior(Pd?, A?, W1), st_app(St?, Ap), app_recs(Ap?, R), question_prior(R?, A?, W2), free_i(I?, St?, Fr), neg(Fr?, W3), or(W1?, W2?, W12), or(W12?, W3?, W).

procedure held_prior(Pends?, Attempt?, YesNo).
held_prior([], _, no).
held_prior([deferred(msg(_, cargo(_, start(B)))) | Ps], A, W?) :- ground(A?), ground(B?) | same(A?, B?, Sm), prio(B?, A?, Pr), neg(Sm?, NSm), and(NSm?, Pr?, W1), held_prior1(W1?, Ps?, A?, W).
held_prior([_ | Ps], A, W?) :- otherwise | held_prior(Ps?, A?, W).

procedure held_prior1(YesNo?, Pends?, Attempt?, YesNo).
held_prior1(yes, _, _, yes).
held_prior1(no, Ps, A, W?) :- held_prior(Ps?, A?, W).

procedure question_prior(Recs?, Attempt?, YesNo).
question_prior(R, A, W?) :- ground(R?) | question_prior1(R?, R?, A?, W).

procedure question_prior1(Recs?, Recs?, Attempt?, YesNo).
question_prior1([], _, _, no).
question_prior1([answered(G, yes) | Rs], R, A, W?) :- ground(G?), ground(R?), ground(A?) | pending_rec(G?, R?, P), same(G?, A?, Sm), neg(Sm?, NSm), prio(G?, A?, Pr), and(P?, NSm?, W0), and(W0?, Pr?, W1), question_prior2(W1?, Rs?, R?, A?, W).
question_prior1([_ | Rs], R, A, W?) :- otherwise | question_prior1(Rs?, R?, A?, W).

procedure question_prior2(YesNo?, Recs?, Recs?, Attempt?, YesNo).
question_prior2(yes, _, _, _, yes).
question_prior2(no, Rs, R, A, W?) :- question_prior1(Rs?, R?, A?, W).

procedure question_waits(Attempt?, St?, YesNo).
question_waits(A, St, W?) :- ground(St?) | st_app(St?, Ap), app_lock_recs(Ap?, L, R), question_prior(R?, A?, W1), unlocked(L?, U), neg(U?, W2), or(W1?, W2?, W).

procedure app_lock_recs(App?, Lock, Recs).
app_lock_recs(app(_, _, L, R), L?, R?).

procedure free_i(Info?, St?, YesNo).
free_i(I, St, B?) :- ground(St?) | st_app(St?, Ap), free_app(I?, Ap?, B).

procedure free_app(Info?, App?, YesNo).
free_app(I, app(_, _, L, R), B?) :- ground(R?) | unlocked(L?, B1), no_question(I?, R?, R?, B2), and(B1?, B2?, B).

procedure start_blocker(YesNo?, Info?, St?, Blocker).
start_blocker(no, _, _, noblk).
start_blocker(yes, I, St, Bk?) :- ground(St?) | st_app(St?, Ap), app_lock_recs(Ap?, L, R), start_blocker1(L?, I?, R?, Bk).

procedure start_blocker1(Lock?, Info?, Recs?, Blocker).
start_blocker1(held(B), _, _, blk(B?)).
start_blocker1(unlocked, I, R, Bk?) :- ground(R?) | class_question(R?, I?, R?, Bk).

procedure class_question(Recs?, Info?, Recs?, Blocker).
class_question([], _, _, noblk).
class_question([asked(G) | Rs], I, R, Bk?) :- ground(G?), ground(I?), ground(R?) | pending_rec(G?, R?, P), of_class(G?, I?, Cl), and(P?, Cl?, B), class_question1(B?, G?, Rs?, I?, R?, Bk).
class_question([_ | Rs], I, R, Bk?) :- otherwise | class_question(Rs?, I?, R?, Bk).

procedure class_question1(YesNo?, Attempt?, Recs?, Info?, Recs?, Blocker).
class_question1(yes, G, _, _, _, blk(G?)).
class_question1(no, _, Rs, I, R, Bk?) :- class_question(Rs?, I?, R?, Bk).

procedure question_blocker(YesNo?, St?, Blocker).
question_blocker(no, _, noblk).
question_blocker(yes, St, Bk?) :- ground(St?) | st_app(St?, Ap), app_lock_recs(Ap?, L, _), lock_blocker(L?, Bk).

procedure lock_blocker(Lock?, Blocker).
lock_blocker(held(B), blk(B?)).
lock_blocker(unlocked, noblk).

procedure prio(Attempt?, Attempt?, YesNo).
prio(A, B, P?) :- ground(A?), ground(B?) | attempt_rank(A?, RA), attempt_rank(B?, RB), attempt_id(A?, IA), attempt_id(B?, IB), prio1(RA?, RB?, IA?, IB?, P).

procedure prio1(Integer?, Integer?, Peer?, Peer?, YesNo).
prio1(RA, RB, _, _, yes) :- (RA? < RB?) | true.
prio1(RA, RB, _, _, no) :- (RA? > RB?) | true.
prio1(RA, RB, IA, IB, P?) :- (RA? =:= RB?) | precedes(IA?, IB?, P).

procedure cargo_class(Cargo?, Class).
cargo_class(start(attempt(_, _, _, C)), C?).
cargo_class(vote(attempt(_, _, _, C), _), C?).
cargo_class(yield(attempt(_, _, _, C)), C?).
cargo_class(outcome(attempt(_, _, _, C), _), C?).

procedure recheck_find(Pends?, St?, FoundNet).
recheck_find([], _, nonefound).
recheck_find([deferred(M) | Ps], St, F?) :- ground(M?), ground(St?) | held_takeable(M?, St?, T), recheck_find1(T?, M?, Ps?, St?, F).
recheck_find([_ | Ps], St, F?) :- otherwise | recheck_find(Ps?, St?, F).

procedure recheck_find1(YesNo?, Net?, Pends?, St?, FoundNet).
recheck_find1(yes, M, _, _, found(M?)).
recheck_find1(no, _, Ps, St, F?) :- recheck_find(Ps?, St?, F).

procedure held_takeable(Net?, St?, YesNo).
held_takeable(msg(_, cargo(_, start(A))), St, T?) :- ground(A?), ground(St?) | attempt_class(A?, C), st_class(C?, St?, Cr, _), held_takeable1(Cr?, A?, St?, T).
held_takeable(_, _, no) :- otherwise | true.

procedure held_takeable1(ClassRes?, Attempt?, St?, YesNo).
held_takeable1(nocls, _, _, no).
held_takeable1(cls(I), A, St, T?) :- ground(A?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), mem(closed(A?), R?, Cl), start_waits(I?, A?, St?, W), neg(W?, NW), or(Cl?, NW?, T).

procedure recheck1(FoundNet?, Then?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
recheck1(found(M), Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- step(net(M?), Th?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
recheck1(nonefound, Th, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(St?) | st_app(St?, Ap0), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure dispatch_message(MCond?, Net?, Peer?, Cargo?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_message(nopart, _, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
dispatch_message(mdefer, M, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- add_pend_once(deferred(M?), St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St1?, D).
dispatch_message(mgo(I), M, _, start(At), Th, Ap0, Ls, In, Ans?, [start(At?) | Thr?], Out?, Approvals, St, D?) :- ground(At?) | drop_pend(deferred(M?), St?, St0), start_effect(I?, At?, St0?, Ss, Cr, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), spawn(Cr?, Approvals?, Approvals1, Ans, Ans1?, D1), next(Th?, yes, Ap0?, Ls?, In?, Ans1, Thr, Out1, Approvals1?, St2?, D2), merge(D1?, D2?, D).
dispatch_message(mgo(I), _, F, vote(At, Y), Th, Ap0, Ls, In, Ans?, [tally(At?) | Thr?], Out?, Approvals, St, D?) :- ground(At?) | tally_effect(I?, At?, F?, Y?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Approvals?, St2?, D).
dispatch_message(mgo(I), _, _, yield(At), Th, Ap0, Ls, In, Ans?, [yield(At?) | Thr?], Out?, Approvals, St, D?) :- ground(At?) | yield_effect(I?, At?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Approvals?, St2?, D).
dispatch_message(mgo(I), _, _, outcome(At, Z), Th, Ap0, Ls, In, Ans?, [outcome(At?) | Thr?], Out?, Approvals, St, D?) :- ground(At?) | outcome_effect(I?, At?, Z?, St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St1?, D).

procedure spawn(ApprovalRes?, OpenApprovals?, OpenApprovals, Stream(Trigger), Stream(Trigger)?, Stream(Ask(Question))).
spawn(noapproval, Cs, Cs?, Ans?, Ans, []).
spawn(approval_for(At), Cs, [oc(At?, Cl) | Cs?], Ans?, Ans1, D?) :- ground(At?) | respond(At?, Cl?, R, D), merge(R?, Ans1?, Ans).

procedure answer_cond(Attempt?, St?, Cond, St).
answer_cond(At, St, Cd?, St2?) :- ground(At?), ground(St?) | attempt_class(At?, C), st_class(C?, St?, R, St1), answer_cond1(R?, At?, St1?, Cd, St2).

procedure answer_cond1(ClassRes?, Attempt?, St?, Cond, St).
answer_cond1(nocls, _, St, drop, St?).
answer_cond1(cls(I), At, St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), unanswered(At?, R?, Ok), go_or_drop(Ok?, I?, Cd).

procedure unanswered(Attempt?, Recs?, YesNo).
unanswered(At, R, B?) :- ground(At?), ground(R?) | pending_rec(At?, R?, P), has_answer(At?, R?, H), neg(H?, Un), and(P?, Un?, B).

procedure dispatch_answer(Cond?, YesNo?, Attempt?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_answer(go(_), YN, At, Th, Ap0, Ls, In, Ans?, [answer(At?) | Thr?], Out?, Approvals, St, D?) :- ground(At?) | answer_effect(YN?, At?, St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St1?, D).
dispatch_answer(drop, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure close_approval(Attempt?, OpenApprovals?, OpenApprovals).
close_approval(_, [], []).
close_approval(At, [oc(B, close) | Cs], Cs?) :- (At? =?= B?) | true.
close_approval(At, [oc(B, Cl?) | Cs], [oc(B?, Cl) | Cs1?]) :- otherwise | close_approval(At?, Cs?, Cs1).

procedure close_falsified(YesNo?, OpenApprovals?, St?, OpenApprovals).
close_falsified(no, Cs, _, Cs?).
close_falsified(yes, Cs, St, Cs1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), close_approvals(Cs?, R?, Cs1).

procedure close_approvals(OpenApprovals?, Recs?, OpenApprovals).
close_approvals([], _, []).
close_approvals([oc(At, Cl?) | Cs], R, Cs1?) :- ground(At?), ground(R?) | pending_rec(At?, R?, P), close_one(P?, At?, Cl, Cs?, R?, Cs1).

procedure close_one(YesNo?, Attempt?, Close, OpenApprovals?, Recs?, OpenApprovals).
close_one(no, _, close, Cs, R, Cs1?) :- close_approvals(Cs?, R?, Cs1).
close_one(yes, At, Cl?, Cs, R, [oc(At?, Cl) | Cs1?]) :- close_approvals(Cs?, R?, Cs1).

procedure take_own(Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
take_own(Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(St?) | st_app(St?, Ap0), own_cond(St?, Ch, St1), dispatch_own(Ch?, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St1?, D).

procedure own_cond(St?, Choice, St).
own_cond(St, Ch?, St2?) :- ground(St?) | opening(St?, Is, St1), own_cond1(Is?, St1?, Ch, St2).

procedure own_cond1(Infos?, St?, Choice, St).
own_cond1(Is, St, Ch?, St5?) :- ground(Is?), ground(St?) | op_cands(Is?, St?, Cs1), st_app(St?, Ap), app_recs(Ap?, R), vote_cands0(R?, St?, Cs2, St2), commit_cands_st(St2?, Cs3, St3), wound_cands0(St3?, Cs4, St4), intro_cands(St?, Cs5), app(Cs1?, Cs2?, C12), app(C12?, Cs3?, C123), app(C123?, Cs4?, C1234), app(C1234?, Cs5?, Cs), own_cond2(Cs?, St4?, Ch, St5).

procedure own_cond2(Cands?, St?, Choice, St).
own_cond2(Cs, St, Ch?, St2?) :- ground(St?) | st_waits(St?, W), st_app(St?, Ap), app_recs(Ap?, R), prune_waits(W?, R?, W0), st_count(St?, D), choose(Cs?, W0?, D?, Ch0, W1), set_waits(St?, W1?, St1), count_own(Ch0?, St1?, Ch, St2).

procedure count_own(Choice?, St?, Choice, St).
count_own(none, St, none, St?).
count_own(take(K, S), St, take(K?, S?), St1?) :- advance(St?, St1).

procedure op_cands(Infos?, St?, Cands).
op_cands([], _, []).
op_cands([I | Is], St, Cs?) :- ground(I?), ground(St?) | unguarded_i(I?, Ug), opener_i(I?, St?, Op), and(Ug?, Op?, B), initiate_cond(B?, I?, St?, Cd), op_cands(Is?, St?, Cs1), keep_cand(Cd?, Cs1?, Cs).

procedure keep_cand(Cond?, Cands?, Cands).
keep_cand(go(I), Cs, [cand(op(C?), sub(I?)) | Cs?]) :- ground(I?) | info_name(I?, C).
keep_cand(drop, Cs, Cs?).

procedure vote_cands0(Recs?, St?, Cands, St).
vote_cands0(R, St, Cs?, St1?) :- ground(R?) | vote_cands(R?, R?, St?, [], Cs, St1).

procedure vote_cands(Recs?, Recs?, St?, Cands?, Cands, St).
vote_cands([], _, St, Cs, Cs?, St?).
vote_cands([answered(At, Y) | Rs], R, St, Acc, Cs?, St2?) :- ground(At?), ground(Y?), ground(R?), ground(St?) | pending_rec(At?, R?, P), attempt_id(At?, Q), known_st(Q?, St?, Kn), and(P?, Kn?, B1), question_waits(At?, St?, Wt), vote_free(Y?, Wt?, Fr), and(B1?, Fr?, B), attempt_class(At?, C), st_class(C?, St?, Cr, St1), vote_cand(B?, Cr?, vt(At?), Acc?, Acc1), vote_cands(Rs?, R?, St1?, Acc1?, Cs, St2).
vote_cands([_ | Rs], R, St, Acc, Cs?, St1?) :- otherwise | vote_cands(Rs?, R?, St?, Acc?, Cs, St1).

procedure vote_free(YesNo?, YesNo?, YesNo).
vote_free(no, _, yes).
vote_free(yes, W, F?) :- neg(W?, F).

procedure vote_cand(YesNo?, ClassRes?, WKey?, Cands?, Cands).
vote_cand(yes, cls(I), K, Acc, [cand(K?, sub(I?)) | Acc?]).
vote_cand(yes, nocls, _, Acc, Acc?).
vote_cand(no, _, _, Acc, Acc?).

procedure commit_cands_st(St?, Cands, St).
commit_cands_st(St, Cs?, St1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), commit_cands0(R?, St?, Cs, St1).

procedure commit_cands0(Recs?, St?, Cands, St).
commit_cands0(R, St, Cs?, St1?) :- ground(R?) | commit_cands(R?, R?, St?, [], Cs, St1).

procedure commit_cands(Recs?, Recs?, St?, Cands?, Cands, St).
commit_cands([], _, St, Cs, Cs?, St?).
commit_cands([voted(At, yes) | Rs], R, St, Acc, Cs?, St2?) :- ground(At?), ground(R?), ground(St?) | st_id(St?, Id), attempt_id(At?, P), same(P?, Id?, Own), attempt_class(At?, C), st_class(C?, St?, Cr, St1), commit_cand(Own?, Cr?, At?, Id?, R?, Acc?, Acc1), commit_cands(Rs?, R?, St1?, Acc1?, Cs, St2).
commit_cands([_ | Rs], R, St, Acc, Cs?, St1?) :- otherwise | commit_cands(Rs?, R?, St?, Acc?, Cs, St1).

procedure commit_cand(YesNo?, ClassRes?, Attempt?, Peer?, Recs?, Cands?, Cands).
commit_cand(yes, cls(I), At, Id, R, Acc, Cs?) :- ground(I?), ground(At?), ground(R?) | mem(closed(At?), R?, Cl), neg(Cl?, Open), all_yes(I?, At?, Id?, R?, All), and(Open?, All?, B), vote_cand(B?, cls(I?), cm(At?), Acc?, Cs).
commit_cand(_, _, _, _, _, Acc, Acc?) :- otherwise | true.

procedure wound_cands0(St?, Cands, St).
wound_cands0(St, Cs?, St3?) :- ground(St?) | st_pends(St?, Pd), wound_starts(Pd?, St?, [], Cs1, St1), wound_cands1(Cs1?, St1?, Cs, St3).

procedure wound_cands1(Cands?, St?, Cands, St).
wound_cands1(Acc, St, Cs?, St1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), wound_questions0(R?, St?, Acc?, Cs, St1).

procedure wound_starts(Pends?, St?, Cands?, Cands, St).
wound_starts([], St, Acc, Acc?, St?).
wound_starts([deferred(msg(_, cargo(_, start(A)))) | Ps], St, Acc, Cs?, St3?) :- ground(A?), ground(St?) | attempt_class(A?, C), st_class(C?, St?, Cr, St1), wound_start(Cr?, A?, St1?, Acc?, Acc1, St2), wound_starts(Ps?, St2?, Acc1?, Cs, St3).
wound_starts([_ | Ps], St, Acc, Cs?, St1?) :- otherwise | wound_starts(Ps?, St?, Acc?, Cs, St1).

procedure wound_start(ClassRes?, Attempt?, St?, Cands?, Cands, St).
wound_start(nocls, _, St, Acc, Acc?, St?).
wound_start(cls(I), A, St, Acc, Cs?, St?) :- ground(I?), ground(A?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), mem(closed(A?), R?, Cl), start_waits(I?, A?, St?, W), neg(Cl?, Open), and(Open?, W?, B), start_blocker(B?, I?, St?, Bk), wound_by(Bk?, A?, St?, Acc?, Cs).

procedure wound_questions0(Recs?, St?, Cands?, Cands, St).
wound_questions0(R, St, Acc, Cs?, St1?) :- ground(R?) | wound_questions(R?, R?, St?, Acc?, Cs, St1).

procedure wound_questions(Recs?, Recs?, St?, Cands?, Cands, St).
wound_questions([], _, St, Acc, Acc?, St?).
wound_questions([answered(A, yes) | Rs], R, St, Acc, Cs?, St1?) :- ground(A?), ground(R?), ground(St?) | pending_rec(A?, R?, P), question_blocker(P?, St?, Bk), wound_by(Bk?, A?, St?, Acc?, Acc1), wound_questions(Rs?, R?, St?, Acc1?, Cs, St1).
wound_questions([_ | Rs], R, St, Acc, Cs?, St1?) :- otherwise | wound_questions(Rs?, R?, St?, Acc?, Cs, St1).

procedure wound_by(Blocker?, Attempt?, St?, Cands?, Cands).
wound_by(noblk, _, _, Acc, Acc?).
wound_by(blk(B), A, St, Acc, Cs?) :- ground(B?), ground(A?), ground(St?) | attempt_class(B?, C), st_class(C?, St?, Cr, _), wound_by_c(Cr?, A?, B?, St?, Acc?, Cs).

procedure wound_by_c(ClassRes?, Attempt?, Attempt?, St?, Cands?, Cands).
wound_by_c(nocls, _, _, _, Acc, Acc?).
wound_by_c(cls(I), A, B, St, Acc, Cs?) :- ground(I?), ground(A?), ground(B?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_recs(Ap?, R), wound_rec(I?, A?, B?, Id?, R?, Ok), vote_cand(Ok?, cls(I?), wd(A?, B?), Acc?, Cs).

procedure wound_rec(Info?, Attempt?, Attempt?, Peer?, Recs?, YesNo).
wound_rec(I, A, B, Id, R, Ok?) :- ground(I?), ground(B?), ground(Id?), ground(R?) | prio(A?, B?, Pr), mem(yielded(B?), R?, Yd), neg(Yd?, NYd), attempt_id(B?, P), same(P?, Id?, Own), all_yes(I?, B?, Id?, R?, All), wound_by2(Own?, All?, Ok1), and(Pr?, NYd?, B1), and(B1?, Ok1?, Ok).

procedure wound_by2(YesNo?, YesNo?, YesNo).
wound_by2(no, _, yes).
wound_by2(yes, All, Ok?) :- neg(All?, Ok).

procedure intro_cands(St?, Cands).
intro_cands(St, Cs?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_state(Ap?, S), introduction_preds(E), named_by(E?, S?, Id?, Ns0), dedup(Ns0?, Ns1), sort_peers(Ns1?, Ns), pairs_of(Ns?, Ps), intro_keep(Ps?, St?, Cs).

procedure named_by(Preds?, GAtoms?, Peer?, Peers).
named_by(_, [], _, []).
named_by(E, [g(P, [p(Q)]) | Gs], Id, Ns?) :- ground(E?), ground(Q?), ground(Id?) | mem(P?, E?, In), same(Q?, Id?, Me), neg(Me?, NMe), and(In?, NMe?, B), named_by(E?, Gs?, Id?, N1), keep_peer(B?, Q?, N1?, Ns).
named_by(E, [_ | Gs], Id, Ns?) :- otherwise | named_by(E?, Gs?, Id?, Ns).

procedure pairs_of(Peers?, Pairs).
pairs_of([], []).
pairs_of([Q | Qs], Ps?) :- ground(Q?), ground(Qs?) | pairs_with(Q?, Qs?, P1), pairs_of(Qs?, P2), app(P1?, P2?, Ps).

procedure pairs_with(Peer?, Peers?, Pairs).
pairs_with(_, [], []).
pairs_with(Q, [R | Rs], [pr(Q?, R?) | Ps?]) :- ground(Q?) | pairs_with(Q?, Rs?, Ps).

procedure intro_keep(Pairs?, St?, Cands).
intro_keep([], _, []).
intro_keep([pr(Q, R) | Ps], St, Cs?) :- ground(Q?), ground(R?), ground(St?) | known_st(Q?, St?, K1), known_st(R?, St?, K2), st_app(St?, Ap), app_recs(Ap?, Rc), mem(introduced(Q?, R?), Rc?, Done), neg(Done?, ND), and(K1?, K2?, K12), and(K12?, ND?, B), intro_keep(Ps?, St?, C1), keep_icand(B?, Q?, R?, C1?, Cs).

procedure keep_icand(YesNo?, Peer?, Peer?, Cands?, Cands).
keep_icand(yes, Q, R, Cs, [cand(ip(Q?, R?), pair) | Cs?]).
keep_icand(no, _, _, Cs, Cs?).

procedure prune_waits(Waits?, Recs?, Waits).
prune_waits([], _, []).
prune_waits([w(K, T) | Ws], R, Ws1?) :- ground(K?), ground(R?) | dead_key(K?, R?, Dd), prune_waits(Ws?, R?, Rest), prune_wait(Dd?, w(K?, T?), Rest?, Ws1).

procedure prune_wait(YesNo?, Wait?, Waits?, Waits).
prune_wait(no, X, Ws, [X? | Ws?]).
prune_wait(yes, _, Ws, Ws?).

procedure dead_key(WKey?, Recs?, YesNo).
dead_key(op(_), _, no).
dead_key(vt(A), R, D?) :- ground(A?), ground(R?) | has_vote(A?, R?, V), mem(closed(A?), R?, Cl), or(V?, Cl?, D).
dead_key(cm(A), R, D?) :- mem(closed(A?), R?, D).
dead_key(wd(_, B), R, D?) :- ground(B?), ground(R?) | mem(closed(B?), R?, Cl), mem(yielded(B?), R?, Yd), or(Cl?, Yd?, D).
dead_key(ip(Q, R1), R, D?) :- mem(introduced(Q?, R1?), R?, D).

procedure dispatch_own(Choice?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Txn), Stream(Net), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_own(none, Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- next(done, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
dispatch_own(take(op(_), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- ground(I?), ground(St?) | initiate_cond(yes, I?, St?, Cd), info_name(I?, C), dispatch_propose(Cd?, C?, after, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).
dispatch_own(take(vt(At), sub(I)), Ap0, Ls, In, Ans?, [vote(At?) | Thr?], Out?, Approvals, St, D?) :- ground(At?), ground(I?) | vote_effect(I?, At?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(after, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Approvals?, St2?, D).
dispatch_own(take(cm(At), sub(I)), Ap0, Ls, In, Ans?, [commit(At?) | Thr?], Out?, Approvals, St, D?) :- ground(At?), ground(I?) | commit_effect(I?, At?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(after, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Approvals?, St2?, D).
dispatch_own(take(wd(A, B), sub(I)), Ap0, Ls, In, Ans?, [wound(A?, B?) | Thr?], Out?, Approvals, St, D?) :- ground(A?), ground(B?), ground(I?) | wound_effect(I?, B?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(after, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Approvals?, St2?, D).
dispatch_own(take(ip(Q, R), pair), Ap0, Ls, In, Ans?, [introduce_peers(Q?, R?) | Thr?], [msg(Q?, intro(Id?, R?)), msg(R?, intro(Id?, Q?)) | Out?], Approvals, St, D?) :- ground(Q?), ground(R?), ground(St?) | st_id(St?, Id), introduce_effect(Q?, R?, St?, St1), next(after, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St1?, D).
dispatch_own(take(_, _), Ap0, Ls, In, Ans?, Thr?, Out?, Approvals, St, D?) :- otherwise | next(done, no, Ap0?, Ls?, In?, Ans, Thr, Out, Approvals?, St?, D).

procedure opening(St?, Infos, St).
opening(St, Is?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_state(Ap?, S), contract_schemas(Ss), reflexive_preds(Rf), opening1(Ss?, Rf?, Id?, S?, St?, Is, St1).

procedure opening1(Schemas?, Preds?, Peer?, GAtoms?, St?, Infos, St).
opening1(Ss, Rf, Id, S, St, Is?, St1?) :- ground(Id?), ground(S?) | hat(Rf?, Id?, S?, Sh), opened(Ss?, Id?, Sh?, Cs), meet_all(Cs?, St?, [], Is0, St1), dedup(Is0?, Is).

procedure opened(Schemas?, Peer?, GAtoms?, Stream(Class)).
opened([], _, _, []).
opened([schema(Nm, Rs) | Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | guard_roles(Rs?, 1, Gs), opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1), opened(Ss?, Id?, Sh?, C2), app(C1?, C2?, Cs).

procedure opened1(Ints?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened1([_ | _], _, _, _, _, []).
opened1([], _, [], _, _, []).
opened1([], Nm, [R | Rs], Id, Sh, Cs?) :- ground(R?), ground(Id?), ground(Sh?) | rs_req(R?, Q), match_all(Q?, Sh?, [b(role(1), p(Id?))], Bs), opened2(Bs?, Nm?, [R? | Rs?], Id?, Sh?, Cs).

procedure opened2(Bindings?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened2([], _, _, _, _, []).
opened2([B | Bs], Nm, Rs, Id, Sh, Cs?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | first_spec(Rs?, R1), cand_ok([R1?], B?, Sh?, Ok), opened3(Ok?, Nm?, B?, Id?, C1), opened2(Bs?, Nm?, Rs?, Id?, Sh?, C2), app(C1?, C2?, Cs).

procedure opened3(YesNo?, Constant?, Binding?, Peer?, Stream(Class)).
opened3(no, _, _, _, []).
opened3(yes, Nm, B, Id, [C?]) :- class_of(Nm?, B?, Id?, C).

procedure first_spec(RoleSpecs?, RoleSpec).
first_spec([R | _], R?).
first_spec([], rs(unguarded, [], [], [], [])).

procedure meet_all(Stream(Class)?, St?, Infos?, Infos, St).
meet_all([], St, Is, Is?, St?).
meet_all([C | Cs], St, Is, Is2?, St2?) :- ground(C?), ground(St?) | st_class(C?, St?, R, St1), add_cls(R?, Is?, Is1), meet_all(Cs?, St1?, Is1?, Is2, St2).

procedure add_cls(ClassRes?, Infos?, Infos).
add_cls(nocls, Is, Is?).
add_cls(cls(I), Is, Is1?) :- app(Is?, [I?], Is1).

procedure choose(Cands?, Waits?, Integer?, Choice, Waits).
choose(Cs, W, D, Ch?, W2?) :- ground(Cs?), ground(W?), integer(D?) | ensure_waits(Cs?, W?, D?, W1), choose1(Cs?, W1?, D?, Ch, W2).

procedure choose1(Cands?, Waits?, Integer?, Choice, Waits).
choose1(Cs, W1, D, Ch?, W2?) :- ground(W1?), integer(D?) | pick(Cs?, W1?, Ch, Ky), D1 := (D? + 1), retake(Ky?, W1?, D1?, W2).

procedure ensure_waits(Cands?, Waits?, Integer?, Waits).
ensure_waits([], W, _, W?).
ensure_waits([cand(K, _) | Cs], W, D, W2?) :- ground(K?), ground(W?), integer(D?) | wait_of(K?, W?, F), ensure1(F?, K?, W?, D?, W1), ensure_waits(Cs?, W1?, D?, W2).

procedure ensure1(WFound?, WKey?, Waits?, Integer?, Waits).
ensure1(at(_), _, W, _, W?).
ensure1(unseen, K, W, D, [w(K?, D?) | W?]).

procedure wait_of(WKey?, Waits?, WFound).
wait_of(_, [], unseen).
wait_of(K, [w(K1, T) | _], at(T?)) :- (K? =?= K1?) | true.
wait_of(K, [_ | Ws], F?) :- otherwise | wait_of(K?, Ws?, F).

procedure pick(Cands?, Waits?, Choice, PKey).
pick([], _, none, nokey).
pick([cand(K, I) | Cs], W, Ch?, Ky?) :- ground(K?), ground(W?) | began_at(K?, W?, T), best(Cs?, W?, T?, K?, I?, Ch, Ky).

procedure best(Cands?, Waits?, Integer?, WKey?, Subj?, Choice, PKey).
best([], _, _, K, I, take(K?, I?), key(K?)) :- ground(K?) | true.
best([cand(K2, I2) | Cs], W, T, K, I, Ch?, Ky?) :- ground(K2?), ground(W?) | began_at(K2?, W?, T2), best1(T2?, T?, K2?, I2?, K?, I?, Cs?, W?, Ch, Ky).

procedure best1(Integer?, Integer?, WKey?, Subj?, WKey?, Subj?, Cands?, Waits?, Choice, PKey).
best1(T2, T, K2, I2, _, _, Cs, W, Ch?, Ky?) :- (T2? < T?) | best(Cs?, W?, T2?, K2?, I2?, Ch, Ky).
best1(T2, T, _, _, K, I, Cs, W, Ch?, Ky?) :- (T2? >= T?) | best(Cs?, W?, T?, K?, I?, Ch, Ky).

procedure began_at(WKey?, Waits?, Integer).
began_at(K, W, T?) :- wait_of(K?, W?, F), began_of(F?, T).

procedure began_of(WFound?, Integer).
began_of(at(T), T?).
began_of(unseen, 0).

procedure retake(PKey?, Waits?, Integer?, Waits).
retake(nokey, W, _, W?).
retake(key(K), W, D, W1?) :- set_wait(K?, D?, W?, W1).

procedure set_wait(WKey?, Integer?, Waits?, Waits).
set_wait(K, D, [], [w(K?, D?)]).
set_wait(K, D, [w(K1, _) | Ws], [w(K1?, D?) | Ws?]) :- (K? =?= K1?) | true.
set_wait(K, D, [X | Ws], [X? | Ws1?]) :- otherwise | set_wait(K?, D?, Ws?, Ws1).

procedure propose_effect(Info?, Class?, St?, Attempt, Sends, St).
propose_effect(I, C, St, At?, Ss?, St1?) :- ground(I?), ground(C?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), st_app(St?, Ap0), app_count(Ap0?, K), K1 := (K? + 1), st_app(St?, Ap2), app_recs(Ap2?, R), rank_of(I?, Id?, R?, K1?, Pi), propose_app(I?, attempt(Id?, K1?, Pi?, C?), Ap?, At, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure rank_of(Info?, Peer?, Recs?, Integer?, Integer).
rank_of(I, Id, R, K1, Pi?) :- ground(R?), integer(K1?) | last_own(R?, I?, Id?, nolast, L), rank_of1(L?, R?, K1?, Pi).

procedure rank_of1(Last?, Recs?, Integer?, Integer).
rank_of1(nolast, _, K1, K1?).
rank_of1(last(A), R, K1, Pi?) :- ground(A?), ground(R?) | mem(wounded(A?), R?, W), attempt_rank(A?, P), rank_of2(W?, P?, K1?, Pi).

procedure rank_of2(YesNo?, Integer?, Integer?, Integer).
rank_of2(yes, P, _, P?).
rank_of2(no, _, K1, K1?).

procedure last_own(Recs?, Info?, Peer?, Last?, Last).
last_own([], _, _, L, L?).
last_own([voted(A, yes) | Rs], I, Id, L, L1?) :- ground(A?), ground(I?), ground(Id?) | attempt_id(A?, P), same(P?, Id?, Own), of_class(A?, I?, Cl), and(Own?, Cl?, B), later(B?, A?, L?, L0), last_own(Rs?, I?, Id?, L0?, L1).
last_own([_ | Rs], I, Id, L, L1?) :- otherwise | last_own(Rs?, I?, Id?, L?, L1).

procedure later(YesNo?, Attempt?, Last?, Last).
later(no, _, L, L?).
later(yes, A, nolast, last(A?)).
later(yes, A, last(B), L?) :- ground(A?), ground(B?) | attempt_k(A?, KA), attempt_k(B?, KB), later1(KA?, KB?, A?, B?, L).

procedure later1(Integer?, Integer?, Attempt?, Attempt?, Last).
later1(KA, KB, A, _, last(A?)) :- (KA? > KB?) | true.
later1(KA, KB, _, B, last(B?)) :- (KA? =< KB?) | true.

procedure propose_app(Info?, Attempt?, App?, Attempt, Sends, App).
propose_app(I, At, Ap, At?, Ss?, Ap1?) :- ground(I?), ground(At?) | attempt_id(At?, Id), info_q(I?, Q), only_me(Q?, Id?, One), propose_app1(One?, I?, At?, Ap?, Ss, Ap1).

procedure propose_app1(YesNo?, Info?, Attempt?, App?, Sends, App).
propose_app1(yes, I, At, app(S, _, L, R), [], app(S1?, K?, L?, [closed(At?), voted(At?, yes) | R?])) :- ground(At?) | attempt_id(At?, Id), attempt_k(At?, K), apply_info(I?, Id?, S?, S1).
propose_app1(no, I, At, app(S, _, _, R), Ss?, app(S?, K?, held(At?), [voted(At?, yes) | R?])) :- ground(At?), ground(I?) | attempt_id(At?, Id), attempt_k(At?, K), info_q(I?, Q), tell(Q?, Id?, start(At?), Ss).

procedure only_me(Peers?, Peer?, YesNo).
only_me([P], Id, yes) :- (P? =?= Id?) | true.
only_me(_, _, no) :- otherwise | true.

procedure tell(Peers?, Peer?, Cargo?, Sends).
tell([], _, _, []).
tell([Q | Qs], Id, X, Ss?) :- ground(Q?), ground(Id?), ground(X?) | same(Q?, Id?, Me), tell1(Me?, Q?, X?, Ss1?, Ss), tell(Qs?, Id?, X?, Ss1).

procedure tell1(YesNo?, Peer?, Cargo?, Sends?, Sends).
tell1(yes, _, _, Ss, Ss?).
tell1(no, Q, X, Ss, [to(Q?, X?) | Ss?]).

procedure vote_app(Attempt?, YesNo?, App?, Sends, App).
vote_app(At, yes, app(S, K, _, R), [to(I?, vote(At?, yes))], app(S?, K?, held(At?), [voted(At?, yes) | R?])) :- ground(At?) | attempt_id(At?, I).
vote_app(At, no, app(S, K, L, R), [to(I?, vote(At?, no))], app(S?, K?, L?, [voted(At?, no) | R?])) :- ground(At?) | attempt_id(At?, I).

procedure start_effect(Info?, Attempt?, St?, Sends, ApprovalRes, St).
start_effect(I, At, St, Ss?, Cr?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), start_app(I?, At?, Id?, Ap?, Ss, Cr, Ap1), set_app(St?, Ap1?, St1).

procedure start_app(Info?, Attempt?, Peer?, App?, Sends, ApprovalRes, App).
start_app(I, At, Id, app(S, K, L, R), Ss?, Cr?, Ap1?) :- ground(At?), ground(R?), integer(K?) | attempt_k(At?, KA), max_int(K?, KA?, K1), mem(closed(At?), R?, Cl), start_app1(Cl?, I?, At?, Id?, app(S?, K1?, L?, R?), Ss, Cr, Ap1).

procedure max_int(Integer?, Integer?, Integer).
max_int(A, B, A?) :- (A? >= B?) | true.
max_int(A, B, B?) :- (A? < B?) | true.

procedure start_app1(YesNo?, Info?, Attempt?, Peer?, App?, Sends, ApprovalRes, App).
start_app1(yes, _, _, _, Ap, [], noapproval, Ap?).
start_app1(no, I, At, Id, Ap, Ss?, Cr?, Ap1?) :- ground(I?), ground(At?), ground(Id?), ground(Ap?) | app_state(Ap?, S), dom_ok(I?, Id?, S?, Rd), asked_by(I?, At?, Id?, Ak), start_app2(Rd?, Ak?, At?, Ap?, Ss, Cr, Ap1).

procedure start_app2(YesNo?, YesNo?, Attempt?, App?, Sends, ApprovalRes, App).
start_app2(no, _, At, Ap, Ss?, noapproval, Ap1?) :- vote_app(At?, no, Ap?, Ss, Ap1).
start_app2(yes, yes, At, app(S, K, L, R), [], approval_for(At?), app(S?, K?, L?, [asked(At?) | R?])) :- ground(At?) | true.
start_app2(yes, no, At, Ap, Ss?, noapproval, Ap1?) :- vote_app(At?, yes, Ap?, Ss, Ap1).

procedure asked_by(Info?, Attempt?, Peer?, YesNo).
asked_by(I, At, Id, B?) :- ground(At?) | attempt_id(At?, P), asked_by1(I?, P?, Id?, B).

procedure asked_by1(Info?, Peer?, Peer?, YesNo).
asked_by1(I, P, Id, B?) :- ground(P?), ground(Id?) | info_gsets(I?, G), gset_of(G?, P?, Gs), mem(Id?, Gs?, In), same(Id?, P?, Me), neg(Me?, NotMe), and(In?, NotMe?, B).

procedure gset_of(PeerSets?, Peer?, Peers).
gset_of([], _, []).
gset_of([G | Gs], P, R?) :- ground(G?), ground(P?) | mem(P?, G?, B), gset_of1(B?, G?, Gs?, P?, R).

procedure gset_of1(YesNo?, Peers?, PeerSets?, Peer?, Peers).
gset_of1(yes, G, _, _, G?).
gset_of1(no, _, Gs, P, R?) :- gset_of(Gs?, P?, R).

procedure answer_effect(YesNo?, Attempt?, St?, St).
answer_effect(YN, At, St, St1?) :- ground(St?) | st_app(St?, Ap), answer_app(YN?, At?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure answer_app(YesNo?, Attempt?, App?, App).
answer_app(YN, At, app(S, K, L, R), app(S?, K?, L?, [answered(At?, YN?) | R?])).

procedure vote_effect(Info?, Attempt?, St?, Sends, St).
vote_effect(I, At, St, Ss?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), vote_app0(I?, At?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure vote_app0(Info?, Attempt?, Peer?, App?, Sends, App).
vote_app0(I, At, Id, Ap, Ss?, Ap1?) :- ground(At?), ground(Ap?) | app_recs(Ap?, R), answer_of(At?, R?, YN), vote_yes(YN?, I?, Id?, Ap?, Y), vote_app(At?, Y?, Ap?, Ss, Ap1).

procedure vote_yes(YesNo?, Info?, Peer?, App?, YesNo).
vote_yes(no, _, _, _, no).
vote_yes(yes, I, Id, app(S, _, _, _), Y?) :- dom_ok(I?, Id?, S?, Y).

procedure tally_effect(Info?, Attempt?, Peer?, YesNo?, St?, Sends, St).
tally_effect(I, At, F, Y, St, Ss?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), tally_app(I?, At?, F?, Y?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure tally_app(Info?, Attempt?, Peer?, YesNo?, Peer?, App?, Sends, App).
tally_app(I, At, F, Y, Id, Ap, Ss?, Ap1?) :- ground(At?), ground(Ap?) | app_recs(Ap?, R), mem(closed(At?), R?, Cl), tally_app1(Cl?, I?, At?, F?, Y?, Id?, Ap?, Ss, Ap1).

procedure tally_app1(YesNo?, Info?, Attempt?, Peer?, YesNo?, Peer?, App?, Sends, App).
tally_app1(yes, _, _, _, _, _, Ap, [], Ap?).
tally_app1(no, I, At, F, no, Id, app(S, K, _, R), Ss?, app(S?, K?, unlocked, [closed(At?), got(At?, F?, no) | R?])) :- ground(At?), ground(I?) | info_q(I?, Q), tell(Q?, Id?, outcome(At?, abort), Ss).
tally_app1(no, _, At, F, yes, _, app(S, K, L, R), [], app(S?, K?, L?, [got(At?, F?, yes) | R?])).

procedure commit_effect(Info?, Attempt?, St?, Sends, St).
commit_effect(I, At, St, Ss?, St1?) :- ground(I?), ground(At?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), commit_app(I?, At?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure commit_app(Info?, Attempt?, Peer?, App?, Sends, App).
commit_app(I, At, Id, app(S, K, _, R), Ss?, app(S1?, K?, unlocked, [closed(At?) | R?])) :- ground(I?), ground(At?), ground(Id?) | apply_info(I?, Id?, S?, S1), info_q(I?, Q), tell(Q?, Id?, outcome(At?, commit), Ss).

procedure yield_effect(Info?, Attempt?, St?, Sends, St).
yield_effect(I, At, St, Ss?, St1?) :- ground(I?), ground(At?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), yield_app(I?, At?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure yield_app(Info?, Attempt?, Peer?, App?, Sends, App).
yield_app(I, At, Id, Ap, Ss?, Ap1?) :- ground(I?), ground(At?), ground(Id?), ground(Ap?) | app_recs(Ap?, R), closed_or_all(I?, At?, Id?, R?, Done), yield_app1(Done?, I?, At?, Id?, Ap?, Ss, Ap1).

procedure closed_or_all(Info?, Attempt?, Peer?, Recs?, YesNo).
closed_or_all(I, At, Id, R, Done?) :- ground(At?), ground(R?) | mem(closed(At?), R?, Cl), all_yes(I?, At?, Id?, R?, All), or(Cl?, All?, Done).

procedure yield_app1(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
yield_app1(yes, _, _, _, Ap, [], Ap?).
yield_app1(no, I, At, Id, Ap, Ss?, Ap1?) :- abort_own(I?, At?, Id?, Ap?, Ss, Ap1).

procedure abort_own(Info?, Attempt?, Peer?, App?, Sends, App).
abort_own(I, At, Id, app(S, K, _, R), Ss?, app(S?, K?, unlocked, [wounded(At?), closed(At?) | R?])) :- ground(I?), ground(At?), ground(Id?) | info_q(I?, Q), tell(Q?, Id?, outcome(At?, abort), Ss).

procedure wound_effect(Info?, Attempt?, St?, Sends, St).
wound_effect(I, B, St, Ss?, St1?) :- ground(I?), ground(B?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), attempt_id(B?, P), same(P?, Id?, Own), wound_app(Own?, I?, B?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure wound_app(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
wound_app(yes, I, B, Id, Ap, Ss?, Ap1?) :- abort_own(I?, B?, Id?, Ap?, Ss, Ap1).
wound_app(no, _, B, _, app(S, K, L, R), [to(J?, yield(B?))], app(S?, K?, L?, [yielded(B?) | R?])) :- ground(B?) | attempt_id(B?, J).

procedure introduce_effect(Peer?, Peer?, St?, St).
introduce_effect(Q, R, St, St1?) :- ground(St?) | st_app(St?, Ap), introduce_app(Q?, R?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure introduce_app(Peer?, Peer?, App?, App).
introduce_app(Q, R, app(S, K, L, Rc), app(S?, K?, L?, [introduced(Q?, R?) | Rc?])).

procedure all_yes(Info?, Attempt?, Peer?, Recs?, YesNo).
all_yes(I, At, Id, R, B?) :- ground(At?), ground(Id?), ground(R?) | info_q(I?, Q), all_yes1(Q?, At?, Id?, R?, B).

procedure all_yes1(Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes1([], _, _, _, yes).
all_yes1([P | Ps], At, Id, R, B?) :- ground(P?), ground(At?), ground(Id?), ground(R?) | same(P?, Id?, Me), mem(got(At?, P?, yes), R?, G), or(Me?, G?, Ok), all_yes2(Ok?, Ps?, At?, Id?, R?, B).

procedure all_yes2(YesNo?, Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes2(no, _, _, _, _, no).
all_yes2(yes, Ps, At, Id, R, B?) :- all_yes1(Ps?, At?, Id?, R?, B).

procedure outcome_effect(Info?, Attempt?, Decision?, St?, St).
outcome_effect(I, At, Z, St, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), outcome_app(I?, At?, Z?, Id?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure outcome_app(Info?, Attempt?, Decision?, Peer?, App?, App).
outcome_app(I, At, commit, Id, app(S, K, L, R), app(S1?, K?, L1?, [closed(At?) | R?])) :- ground(At?) | apply_info(I?, Id?, S?, S1), release(L?, At?, L1).
outcome_app(_, At, abort, _, app(S, K, L, R), app(S?, K?, L1?, [closed(At?) | R?])) :- ground(At?) | release(L?, At?, L1).

procedure release(Lock?, Attempt?, Lock).
release(unlocked, _, unlocked).
release(held(A), At, unlocked) :- (A? =?= At?) | true.
release(held(A), _, held(A?)) :- otherwise | true.

procedure send_all(Sends?, St?, Nets, St).
send_all(Ss, St, Ms?, St?) :- ground(St?) | st_id(St?, Id), cargo_msgs(Ss?, Id?, Ms).

procedure cargo_msgs(Sends?, Peer?, Nets).
cargo_msgs([], _, []).
cargo_msgs([to(T, X) | Ss], Id, [msg(T?, cargo(Id?, X?)) | Ms?]) :- ground(Id?) | cargo_msgs(Ss?, Id?, Ms).

procedure put_all(Nets?, Stream(Net), Stream(Net)?).
put_all([], Out?, Out).
put_all([M | Ms], [M? | Out?], Cont) :- put_all(Ms?, Out, Cont?).

procedure ready_i(Info?, St?, YesNo).
ready_i(I, St, B?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), ready_app(I?, Id?, Ap?, B).

procedure ready_app(Info?, Peer?, App?, YesNo).
ready_app(I, Id, app(S, _, L, R), B?) :- ground(I?), ground(R?) | unlocked(L?, B1), no_question(I?, R?, R?, B2), dom_ok(I?, Id?, S?, B3), and(B1?, B2?, B12), and(B12?, B3?, B).

procedure unlocked(Lock?, YesNo).
unlocked(unlocked, yes).
unlocked(held(_), no).

procedure no_question(Info?, Recs?, Recs?, YesNo).
no_question(_, [], _, yes).
no_question(I, [asked(At) | Rs], R, B?) :- ground(I?), ground(At?), ground(R?) | pending_rec(At?, R?, P), of_class(At?, I?, Cl), and(P?, Cl?, Q), no_question1(Q?, I?, Rs?, R?, B).
no_question(I, [_ | Rs], R, B?) :- otherwise | no_question(I?, Rs?, R?, B).

procedure no_question1(YesNo?, Info?, Recs?, Recs?, YesNo).
no_question1(yes, _, _, _, no).
no_question1(no, I, Rs, R, B?) :- no_question(I?, Rs?, R?, B).

procedure pending_rec(Attempt?, Recs?, YesNo).
pending_rec(At, R, B?) :- ground(At?), ground(R?) | mem(asked(At?), R?, B1), has_vote(At?, R?, B2), mem(closed(At?), R?, B3), or(B2?, B3?, B23), neg(B23?, B4), and(B1?, B4?, B).

procedure has_vote(Attempt?, Recs?, YesNo).
has_vote(_, [], no).
has_vote(At, [voted(A, _) | _], yes) :- (At? =?= A?) | true.
has_vote(At, [_ | Rs], B?) :- otherwise | has_vote(At?, Rs?, B).

procedure has_answer(Attempt?, Recs?, YesNo).
has_answer(_, [], no).
has_answer(At, [answered(A, _) | _], yes) :- (At? =?= A?) | true.
has_answer(At, [_ | Rs], B?) :- otherwise | has_answer(At?, Rs?, B).

procedure answer_of(Attempt?, Recs?, YesNo).
answer_of(_, [], no).
answer_of(At, [answered(A, Y) | _], Y?) :- (At? =?= A?) | true.
answer_of(At, [_ | Rs], Y?) :- otherwise | answer_of(At?, Rs?, Y).

procedure of_class(Attempt?, Info?, YesNo).
of_class(attempt(_, _, _, C), ci(_, Ps, Q, _, _, Ms), B?) :- ground(C?) | binding_of(C?, Nm, Bn), schema_spec(Nm?, Rs), of_class1(Rs?, Bn?, Ps?, Q?, Ms?, B).

procedure of_class1(RoleSpecs?, Binding?, Parts?, Peers?, Mates?, YesNo).
of_class1(Rs, Bn, Ps, Q, Ms, B?) :- ground(Rs?), ground(Bn?) | sig_of(Rs?, Bn?, Ps1), in_class(Rs?, Bn?, Ps1?, Ps?, Q?, Ms?, B).

procedure others_known(Info?, St?, Known).
others_known(I, St, K?) :- ground(St?) | info_q(I?, Q), st_id(St?, Id), first_unknown(Q?, Id?, St?, K).

procedure first_unknown(Peers?, Peer?, St?, Known).
first_unknown([], _, _, allknown).
first_unknown([P | Ps], Id, St, K?) :- ground(P?), ground(Id?), ground(St?) | same(P?, Id?, Me), known_st(P?, St?, Kn), or(Me?, Kn?, Ok), first_unknown1(Ok?, P?, Ps?, Id?, St?, K).

procedure first_unknown1(YesNo?, Peer?, Peers?, Peer?, St?, Known).
first_unknown1(yes, _, Ps, Id, St, K?) :- first_unknown(Ps?, Id?, St?, K).
first_unknown1(no, P, _, _, _, unknown(P?)).

procedure known_st(Peer?, St?, YesNo).
known_st(P, St, B?) :- ground(P?), ground(St?) | st_sent(St?, Se), st_recd(St?, Rc), st_isent(St?, ISe), st_irecd(St?, IRc), known_peer(P?, Se?, Rc?, B1), known_peer(P?, ISe?, IRc?, B2), or(B1?, B2?, B).

procedure known_peer(Peer?, Peers?, Peers?, YesNo).
known_peer(P, Se, Rc, B?) :- ground(P?) | mem(P?, Se?, B1), mem(P?, Rc?, B2), and(B1?, B2?, B).

procedure known_ok(Known?, YesNo).
known_ok(allknown, yes).
known_ok(unknown(_), no).

procedure go_or_drop(YesNo?, Info?, Cond).
go_or_drop(yes, I, go(I?)).
go_or_drop(no, _, drop).

procedure no_prior_start(St?, YesNo).
no_prior_start(St, B?) :- ground(St?) | st_pends(St?, Pd), st_app(St?, Ap), app_recs(Ap?, R), any_answered_yes(R?, Q), empty_pends(Pd?, E), neg(Q?, NQ), and(E?, NQ?, B).

procedure empty_pends(Pends?, YesNo).
empty_pends([], yes).
empty_pends([_ | _], no).

procedure any_answered_yes(Recs?, YesNo).
any_answered_yes(R, B?) :- ground(R?) | any_answered_yes1(R?, R?, B).

procedure any_answered_yes1(Recs?, Recs?, YesNo).
any_answered_yes1([], _, no).
any_answered_yes1([answered(G, yes) | Rs], R, B?) :- ground(G?), ground(R?) | pending_rec(G?, R?, P), any_answered_yes2(P?, Rs?, R?, B).
any_answered_yes1([_ | Rs], R, B?) :- otherwise | any_answered_yes1(Rs?, R?, B).

procedure any_answered_yes2(YesNo?, Recs?, Recs?, YesNo).
any_answered_yes2(yes, _, _, yes).
any_answered_yes2(no, Rs, R, B?) :- any_answered_yes1(Rs?, R?, B).

procedure precedes(Peer?, Peer?, YesNo).
precedes(P, Q, yes) :- '@<'(P?, Q?) | true.
precedes(_, _, no) :- otherwise | true.

procedure guard_of_i(Info?, St?, YesNo).
guard_of_i(I, St, B?) :- info_gsets(I?, G), st_id(St?, Id), in_some(Id?, G?, B).

procedure unguarded_i(Info?, YesNo).
unguarded_i(I, B?) :- info_gsets(I?, G), only_empty(G?, B).

procedure opener_i(Info?, St?, YesNo).
opener_i(ci(_, _, _, _, Op, _), St, B?) :- st_id(St?, Id), is_opener(Op?, Id?, B).

procedure is_opener(Opener?, Peer?, YesNo).
is_opener(opener(P), Id, B?) :- same(P?, Id?, B).
is_opener(guarded_class, _, no).

procedure only_empty(PeerSets?, YesNo).
only_empty([[]], yes).
only_empty(_, no) :- otherwise | true.

procedure in_some(Peer?, PeerSets?, YesNo).
in_some(_, [], no).
in_some(P, [G | Gs], B?) :- ground(P?) | mem(P?, G?, B1), in_some1(B1?, P?, Gs?, B).

procedure in_some1(YesNo?, Peer?, PeerSets?, YesNo).
in_some1(yes, _, _, yes).
in_some1(no, P, Gs, B?) :- in_some(P?, Gs?, B).

procedure all_in(Peers?, Peers?, YesNo).
all_in([], _, yes).
all_in([P | Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).

procedure all_in1(YesNo?, Peers?, Peers?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).

procedure dom_ok(Info?, Peer?, GAtoms?, YesNo).
dom_ok(ci(_, _, _, _, _, Ms), Id, S, B?) :- ground(Id?), ground(S?) | reflexive_preds(Rf), hat(Rf?, Id?, S?, Sh), mates_dom(Ms?, Id?, Sh?, B).

procedure hat(Preds?, Peer?, GAtoms?, GAtoms).
hat([], _, S, S?).
hat([P | Ps], Id, S, [g(P?, [p(Id?)]) | R?]) :- ground(Id?) | hat(Ps?, Id?, S?, R).

procedure mates_dom(Mates?, Peer?, GAtoms?, YesNo).
mates_dom([], _, _, no).
mates_dom([mate(Nm, B, _, _) | Ms], Id, Sh, R?) :- ground(Id?), ground(Sh?) | schema_spec(Nm?, Rs), mate_dom(Rs?, B?, Id?, Sh?, R1), mates_dom1(R1?, Ms?, Id?, Sh?, R).

procedure mates_dom1(YesNo?, Mates?, Peer?, GAtoms?, YesNo).
mates_dom1(yes, _, _, _, yes).
mates_dom1(no, Ms, Id, Sh, R?) :- mates_dom(Ms?, Id?, Sh?, R).

procedure mate_dom(RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
mate_dom(Rs, B, Id, Sh, R?) :- ground(Rs?), ground(B?), ground(Id?), ground(Sh?) | specs_at(Rs?, 1, B?, Id?, RsP), mate_dom1(RsP?, B?, Sh?, R).

procedure mate_dom1(RoleSpecs?, Binding?, GAtoms?, YesNo).
mate_dom1(RsP, B, Sh, R?) :- ground(RsP?), ground(Sh?) | reqs_of(RsP?, Q), match_all(Q?, Sh?, B?, Bs), cands_ok(Bs?, RsP?, Sh?, R).

procedure reqs_of(RoleSpecs?, SAtoms).
reqs_of([], []).
reqs_of([R | Rs], Q?) :- ground(R?) | rs_req(R?, Q1), reqs_of(Rs?, Q2), app(Q1?, Q2?, Q).

procedure cands_ok(Bindings?, RoleSpecs?, GAtoms?, YesNo).
cands_ok([], _, _, no).
cands_ok([B | Bs], RsP, Sh, R?) :- ground(RsP?), ground(Sh?) | cand_ok(RsP?, B?, Sh?, R1), cands_ok1(R1?, Bs?, RsP?, Sh?, R).

procedure cands_ok1(YesNo?, Bindings?, RoleSpecs?, GAtoms?, YesNo).
cands_ok1(yes, _, _, _, yes).
cands_ok1(no, Bs, RsP, Sh, R?) :- cands_ok(Bs?, RsP?, Sh?, R).

procedure cand_ok(RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok([], _, _, yes).
cand_ok([R | Rs], B, Sh, Out?) :- ground(R?), ground(B?), ground(Sh?) | rs_req(R?, Q), img_atoms(Q?, B?, G), ms_sub(G?, Sh?, B1), rs_forb(R?, F), forb_ok(F?, B?, Sh?, B2), and(B1?, B2?, B3), cand_ok1(B3?, Rs?, B?, Sh?, Out).

procedure cand_ok1(YesNo?, RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok1(no, _, _, _, no).
cand_ok1(yes, Rs, B, Sh, Out?) :- cand_ok(Rs?, B?, Sh?, Out).

procedure forb_ok(SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok([], _, _, yes).
forb_ok([A | As], B, Sh, R?) :- ground(A?), ground(B?), ground(Sh?) | atom_bound(A?, B?, Bd), forb_one(Bd?, A?, B?, Sh?, R1), forb_ok1(R1?, As?, B?, Sh?, R).

procedure forb_one(YesNo?, SAtom?, Binding?, GAtoms?, YesNo).
forb_one(no, _, _, _, yes).
forb_one(yes, A, B, Sh, R?) :- ground(Sh?) | img_atom(A?, B?, G), mem(G?, Sh?, In), neg(In?, R).

procedure forb_ok1(YesNo?, SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok1(no, _, _, _, no).
forb_ok1(yes, As, B, Sh, R?) :- forb_ok(As?, B?, Sh?, R).

procedure apply_info(Info?, Peer?, GAtoms?, GAtoms).
apply_info(ci(_, Ps, _, _, _, _), Id, S, S1?) :- ground(Id?) | part_at(Ps?, Id?, D, A), ms_diff(S?, D?, S0), app(A?, S0?, S1).

procedure part_at(Parts?, Peer?, GAtoms, GAtoms).
part_at([], _, [], []).
part_at([part(P, D, A) | _], Id, D?, A?) :- (P? =?= Id?) | true.
part_at([_ | Ps], Id, D?, A?) :- otherwise | part_at(Ps?, Id?, D, A).

procedure st_class(Class?, St?, ClassRes, St).
st_class(C, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), R?, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca1?, Pd?)) :- ground(Id?) | class_info(C?, Id?, Ca?, R, Ca1).

procedure class_info(Class?, Peer?, Infos?, ClassRes, Infos).
class_info(C, Id, Ca, R?, Ca1?) :- ground(C?) | binding_of(C?, Nm, B), class_info1(Nm?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info1(Constant?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info1(Nm, B, C, Id, Ca, R?, Ca1?) :- ground(B?) | schema_spec(Nm?, Rs), class_info2(Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info2(RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info2(Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | rule_ok(Rs?, B?, V1), admissible(Rs?, B?, V2), and(V1?, V2?, V), class_info3(V?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info3(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info3(no, _, _, _, _, Ca, nocls, Ca?).
class_info3(yes, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | sig_of(Rs?, B?, Ps), class_info4(Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info4(Parts?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info4(Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Id?), ground(Rs?), ground(B?) | parts_valid(Ps?, V1), parts_peers(Ps?, Q), mem(Id?, Q?, V2), parts_peers(Ps?, Q1), reflexive_preds(Rf), live_at(Q1?, Rs?, B?, Rf?, V3), and(V1?, V2?, V12), and(V12?, V3?, V), class_info5(V?, Ps?, Rs?, B?, C?, Ca?, R, Ca1).

procedure class_info5(YesNo?, Parts?, RoleSpecs?, Binding?, Class?, Infos?, ClassRes, Infos).
class_info5(no, _, _, _, _, Ca, nocls, Ca?).
class_info5(yes, Ps, Rs, B, C, Ca, R?, Ca1?) :- ground(Ps?), ground(Ca?) | cache_find(Rs?, B?, Ps?, Ca?, F), class_info6(F?, Ps?, C?, Ca?, R, Ca1).

procedure class_info6(ClassRes?, Parts?, Class?, Infos?, ClassRes, Infos).
class_info6(cls(I), _, _, Ca, cls(I?), Ca?).
class_info6(nocls, Ps, C, Ca, R?, Ca1?) :- new_info(C?, Ps?, I), add_info(I?, Ca?, R, Ca1).

procedure add_info(Info?, Infos?, ClassRes, Infos).
add_info(I, Ca, cls(I?), Ca1?) :- ground(I?) | app(Ca?, [I?], Ca1).

procedure cache_find(RoleSpecs?, Binding?, Parts?, Infos?, ClassRes).
cache_find(_, _, _, [], nocls).
cache_find(Rs, B, Ps, [ci(C, Ps1, Q, G, Op, Ms) | Is], R?) :- ground(Rs?), ground(B?), ground(Ps?), ground(Ps1?), ground(Q?), ground(Ms?) | in_class(Rs?, B?, Ps?, Ps1?, Q?, Ms?, E), cache_find1(E?, ci(C?, Ps1?, Q?, G?, Op?, Ms?), Rs?, B?, Ps?, Is?, R).

procedure cache_find1(YesNo?, Info?, RoleSpecs?, Binding?, Parts?, Infos?, ClassRes).
cache_find1(yes, I, _, _, _, _, cls(I?)).
cache_find1(no, _, Rs, B, Ps, Is, R?) :- cache_find(Rs?, B?, Ps?, Is?, R).

procedure new_info(Class?, Parts?, Info).
new_info(C, Ps, I?) :- ground(Ps?) | contract_schemas(Ss), reflexive_preds(Rf), mates_of(Ss?, Ps?, Ms0), dedup_mates(Ms0?, Ms1), parts_peers(Ps?, Q), new_info0(C?, Ps?, Ms1?, Q?, Rf?, I).

procedure new_info0(Class?, Parts?, Mates?, Peers?, Preds?, Info).
new_info0(C, Ps, Ms1, Q, Rf, I?) :- ground(C?), ground(Q?), ground(Rf?) | live_mates(Ms1?, Q?, Rf?, Ms2), binding_of(C?, Nm, B), class_mates(Nm?, B?, Ms2?, Q?, Rf?, Ms), new_info1(C?, Ps?, Ms?, I).

procedure new_info1(Class?, Parts?, Mates?, Info).
new_info1(C, Ps, Ms, ci(C?, Ps?, Q?, G?, Op?, Ms?)) :- ground(Ps?), ground(Ms?) | parts_peers(Ps?, Q), mates_gsets(Ms?, G), mates_opener(Ms?, Op).

procedure info_name(Info?, Class).
info_name(ci(C, _, _, _, _, _), C?).

procedure info_q(Info?, Peers).
info_q(ci(_, _, Q, _, _, _), Q?).

procedure info_gsets(Info?, PeerSets).
info_gsets(ci(_, _, _, G, _, _), G?).

procedure sig_of(RoleSpecs?, Binding?, Parts).
sig_of(Rs, B, Ps?) :- ground(Rs?), ground(B?) | role_persons(Rs?, 1, B?, Ws), dedup(Ws?, Q), parts_for(Q?, Rs?, B?, Ps).

procedure role_persons(RoleSpecs?, Integer?, Binding?, Peers).
role_persons([], _, _, []).
role_persons([_ | Rs], I, B, [P? | Ps?]) :- integer(I?), ground(B?) | role_person(I?, B?, P), I1 := (I? + 1), role_persons(Rs?, I1?, B?, Ps).

procedure parts_for(Peers?, RoleSpecs?, Binding?, Parts).
parts_for([], _, _, []).
parts_for([P | Ps], Rs, B, [part(P?, D?, A?) | Xs?]) :- ground(P?), ground(Rs?), ground(B?) | specs_at(Rs?, 1, B?, P?, RsP), joins(RsP?, B?, D, A), parts_for(Ps?, Rs?, B?, Xs).

procedure joins(RoleSpecs?, Binding?, GAtoms, GAtoms).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) | dels_join(RsP?, B?, [], D), adds_join(RsP?, B?, [], A).

procedure dels_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
dels_join([], _, Acc, Acc?).
dels_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_del(R?, D), img_atoms(D?, B?, G), ms_join(Acc?, G?, Acc1), dels_join(Rs?, B?, Acc1?, Out).

procedure adds_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
adds_join([], _, Acc, Acc?).
adds_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_add(R?, A), img_atoms(A?, B?, G), ms_join(Acc?, G?, Acc1), adds_join(Rs?, B?, Acc1?, Out).

procedure specs_at(RoleSpecs?, Integer?, Binding?, Peer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R | Rs], I, B, P, Out?) :- integer(I?), ground(B?), ground(P?) | role_person(I?, B?, Q), I1 := (I? + 1), specs_at(Rs?, I1?, B?, P?, Rest), keep_spec(Q?, P?, R?, Rest?, Out).

procedure keep_spec(Peer?, Peer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R? | Rest?]) :- (Q? =?= P?) | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.

procedure parts_valid(Parts?, YesNo).
parts_valid([], yes).
parts_valid([part(_, D, A) | Ps], B?) :- ground(A?) | ms_meets(D?, A?, M), neg(M?, B1), parts_valid1(B1?, Ps?, B).

procedure parts_valid1(YesNo?, Parts?, YesNo).
parts_valid1(no, _, no).
parts_valid1(yes, Ps, B?) :- parts_valid(Ps?, B).

procedure parts_peers(Parts?, Peers).
parts_peers([], []).
parts_peers([part(P, _, _) | Ps], [P? | Qs?]) :- parts_peers(Ps?, Qs).

procedure parts_eq(Parts?, Parts?, YesNo).
parts_eq(A, B, E?) :- ground(A?), ground(B?) | len_parts(A?, La), len_parts(B?, Lb), same_int(La?, Lb?, E1), parts_in(A?, B?, E2), and(E1?, E2?, E).

procedure len_parts(Parts?, Integer).
len_parts([], 0).
len_parts([_ | Ps], N?) :- len_parts(Ps?, M), N := (M? + 1).

procedure parts_in(Parts?, Parts?, YesNo).
parts_in([], _, yes).
parts_in([X | Xs], B, E?) :- ground(B?) | part_in(X?, B?, E1), parts_in1(E1?, Xs?, B?, E).

procedure parts_in1(YesNo?, Parts?, Parts?, YesNo).
parts_in1(no, _, _, no).
parts_in1(yes, Xs, B, E?) :- parts_in(Xs?, B?, E).

procedure part_in(Part?, Parts?, YesNo).
part_in(_, [], no).
part_in(part(P, D, A), [part(Q, D1, A1) | Ps], E?) :- (P? =?= Q?), ground(D?), ground(A?) | ms_eq(D?, D1?, E1), ms_eq(A?, A1?, E2), and(E1?, E2?, E3), part_in1(E3?, part(P?, D?, A?), Ps?, E).
part_in(X, [_ | Ps], E?) :- otherwise | part_in(X?, Ps?, E).

procedure part_in1(YesNo?, Part?, Parts?, YesNo).
part_in1(yes, _, _, yes).
part_in1(no, X, Ps, E?) :- part_in(X?, Ps?, E).

procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) | rs_len(Rs?, K), pairs_ok(1, K?, Rs?, B?, R).

procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- (I? > K?) | true.
pairs_ok(I, K, Rs, B, R?) :- (I? =< K?), ground(Rs?), ground(B?) | J := (I? + 1), pair_row(I?, J?, K?, Rs?, B?, R1), I1 := (I? + 1), pairs_ok1(R1?, I1?, K?, Rs?, B?, R).

procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).

procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- (J? > K?) | true.
pair_row(I, J, K, Rs, B, R?) :- (J? =< K?), ground(Rs?), ground(B?) | role_person(I?, B?, P), role_person(J?, B?, Q), nth_spec(Rs?, I?, RI), nth_spec(Rs?, J?, RJ), pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1), J1 := (J? + 1), pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).

procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).

procedure pair_ok(Peer?, Peer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- (P? =?= Q?) | role_names(RI?, J?, A1), role_names(RJ?, I?, A2), or(A1?, A2?, A), neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.

procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(rs(_, A, D, _, _), J, R?) :- integer(J?) | names_role(A?, J?, R1), names_role(D?, J?, R2), or(R1?, R2?, R).

procedure names_role(SAtoms?, Integer?, YesNo).
names_role([], _, no).
names_role([atom(_, Vs) | As], J, R?) :- integer(J?), ground(Vs?) | mem(role(J?), Vs?, R1), sgn_names(Vs?, J?, R2), or(R1?, R2?, R12), names_role1(R12?, As?, J?, R).

procedure names_role1(YesNo?, SAtoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, As, J, R?) :- names_role(As?, J?, R).

procedure sgn_names(Vars?, Integer?, YesNo).
sgn_names([], _, no).
sgn_names([sgn(_, I) | _], J, yes) :- (I? =:= J?) | true.
sgn_names([_ | Vs], J, R?) :- otherwise | sgn_names(Vs?, J?, R).

procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) | adds_of(Rs?, Ad), reqs_of(Rs?, Rq), guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), atoms_vars(Ad?, Av), adm_each(Av?, Rq?, B?, Gp?, R).

procedure adm_each(Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V | Vs], Rq, B, Gp, R?) :- ground(V?), ground(Rq?), ground(B?), ground(Gp?) | adm_var(V?, Rq?, B?, Gp?, R1), adm_each1(R1?, Vs?, Rq?, B?, Gp?, R).

procedure adm_each1(YesNo?, Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Rq, B, Gp, R?) :- adm_each(Vs?, Rq?, B?, Gp?, R).

procedure adm_var(Var?, SAtoms?, Binding?, Peers?, YesNo).
adm_var(svar(X), Rq, B, Gp, R?) :- ground(X?), ground(B?) | atoms_vars(Rq?, Qv), mem(svar(X?), Qv?, InReq), lookup(svar(X?), B?, F), adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(sgn(_, _), _, _, _, yes).

procedure adm_var1(YesNo?, Found?, Peers?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(s(speech(_, P))), Gp, R?) :- mem(P?, Gp?, R).
adm_var1(no, found(p(_)), _, no).
adm_var1(no, free, _, no).

procedure adds_of(RoleSpecs?, SAtoms).
adds_of([], []).
adds_of([R | Rs], A?) :- rs_add(R?, A1), adds_of(Rs?, A2), app(A1?, A2?, A).

procedure atoms_vars(SAtoms?, Vars).
atoms_vars([], []).
atoms_vars([atom(_, Vs) | As], R?) :- atoms_vars(As?, R1), app(Vs?, R1?, R).

procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([rs(guarded, _, _, _, _) | Rs], I, [I? | Is?]) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).
guard_roles([rs(unguarded, _, _, _, _) | Rs], I, Is?) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).

procedure persons_of(Ints?, Binding?, Peers).
persons_of([], _, []).
persons_of([I | Is], B, [P? | Ps?]) :- ground(B?) | role_person(I?, B?, P), persons_of(Is?, B?, Ps).

procedure mates_of(Schemas?, Parts?, Mates).
mates_of([], _, []).
mates_of([schema(Nm, Rs) | Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Ps?) | parts_peers(Ps?, Q), rs_len(Rs?, K), assigns(K?, Q?, As), mates_assigns(As?, Nm?, Rs?, Ps?, M1), mates_of(Ss?, Ps?, M2), app(M1?, M2?, M).

procedure assigns(Integer?, Peers?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).

procedure assigns1(Integer?, Integer?, Peers?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- (I? > K?) | true.
assigns1(I, K, Q, Acc, R?) :- (I? =< K?), ground(Q?) | extend_role(Acc?, I?, Q?, Acc1), I1 := (I? + 1), assigns1(I1?, K?, Q?, Acc1?, R).

procedure extend_role(Bindings?, Integer?, Peers?, Bindings).
extend_role([], _, _, []).
extend_role([B | Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) | extend_one(Q?, I?, B?, R1), extend_role(Bs?, I?, Q?, R2), app(R1?, R2?, R).

procedure extend_one(Peers?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P | Ps], I, B, [[b(role(I?), p(P?)) | B?] | R?]) :- ground(B?), integer(I?) | extend_one(Ps?, I?, B?, R).

procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Parts?, Mates).
mates_assigns([], _, _, _, []).
mates_assigns([B | Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | parts_peers(Ps?, Q), role_persons(Rs?, 1, B?, Ws), all_in(Q?, Ws?, Onto), rule_ok(Rs?, B?, Ok), and(Onto?, Ok?, Go), mates_assign(Go?, B?, Nm?, Rs?, Ps?, M1), mates_assigns(Bs?, Nm?, Rs?, Ps?, M2), app(M1?, M2?, M).

procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Parts?, Mates).
mates_assign(no, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Ps, M?) :- ground(Rs?), ground(Ps?) | match_parts(Ps?, Rs?, [B?], Bs), mates_check(Bs?, Nm?, Rs?, Ps?, M).

procedure match_parts(Parts?, RoleSpecs?, Bindings?, Bindings).
match_parts([], _, Bs, Bs?).
match_parts([part(P, D, A) | Ps], Rs, Bs, R?) :- ground(P?), ground(D?), ground(A?), ground(Rs?) | match_part(Bs?, P?, D?, A?, Rs?, Bs1), match_parts(Ps?, Rs?, Bs1?, R).

procedure match_part(Bindings?, Peer?, GAtoms?, GAtoms?, RoleSpecs?, Bindings).
match_part([], _, _, _, _, []).
match_part([B | Bs], P, D, A, Rs, R?) :- ground(B?), ground(P?), ground(D?), ground(A?), ground(Rs?) | specs_at(Rs?, 1, B?, P?, RsP), match_part1(RsP?, B?, D?, A?, B2), match_part(Bs?, P?, D?, A?, Rs?, R2), app(B2?, R2?, R).

procedure match_part1(RoleSpecs?, Binding?, GAtoms?, GAtoms?, Bindings).
match_part1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) | dels_of(RsP?, Dp), adds_of(RsP?, Ap), match_all(Dp?, D?, B?, B1), match_all_each(B1?, Ap?, A?, R).

procedure dels_of(RoleSpecs?, SAtoms).
dels_of([], []).
dels_of([R | Rs], A?) :- rs_del(R?, A1), dels_of(Rs?, A2), app(A1?, A2?, A).

procedure mates_check(Bindings?, Constant?, RoleSpecs?, Parts?, Mates).
mates_check([], _, _, _, []).
mates_check([B | Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | sig_of(Rs?, B?, Ps1), parts_eq(Ps?, Ps1?, E1), admissible(Rs?, B?, E2), and(E1?, E2?, E), mate_of(E?, B?, Nm?, Rs?, M1), mates_check(Bs?, Nm?, Rs?, Ps?, M2), app(M1?, M2?, M).

procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, B?, G?, F?)]) :- ground(B?), ground(Rs?) | guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), sort_peers(Gp?, Gs), dedup(Gs?, G), role_person(1, B?, F).

procedure dedup_mates(Mates?, Mates).
dedup_mates([], []).
dedup_mates([M | Ms], [M? | R?]) :- ground(M?) | drop_mate(M?, Ms?, Ms1), dedup_mates(Ms1?, R).

procedure drop_mate(Mate?, Mates?, Mates).
drop_mate(_, [], []).
drop_mate(mate(N, B, G, F), [mate(N1, B1, G1, F1) | Ms], R?) :- ground(N?), ground(B?), ground(G?), ground(F?), ground(N1?), ground(B1?) | same(N?, N1?, E1), ms_eq(B?, B1?, E2), and(E1?, E2?, E), drop_mate1(E?, mate(N?, B?, G?, F?), mate(N1?, B1?, G1?, F1?), Ms?, R).

procedure drop_mate1(YesNo?, Mate?, Mate?, Mates?, Mates).
drop_mate1(yes, M, _, Ms, R?) :- drop_mate(M?, Ms?, R).
drop_mate1(no, M, M1, Ms, [M1? | R?]) :- drop_mate(M?, Ms?, R).

procedure mates_gsets(Mates?, PeerSets).
mates_gsets(Ms, G?) :- mates_gsets1(Ms?, G0), dedup(G0?, G1), minimal_sets(G1?, G).

procedure mates_gsets1(Mates?, PeerSets).
mates_gsets1([], []).
mates_gsets1([mate(_, _, G, _) | Ms], [G? | Gs?]) :- mates_gsets1(Ms?, Gs).

procedure minimal_sets(PeerSets?, PeerSets).
minimal_sets(G, M?) :- ground(G?) | minimal1(G?, G?, M).

procedure minimal1(PeerSets?, PeerSets?, PeerSets).
minimal1([], _, []).
minimal1([X | Xs], G, M?) :- ground(X?), ground(G?) | has_smaller(G?, X?, B), minimal1(Xs?, G?, M1), keep_set(B?, X?, M1?, M).

procedure has_smaller(PeerSets?, Peers?, YesNo).
has_smaller([], _, no).
has_smaller([Y | Ys], X, B?) :- ground(Y?), ground(X?) | same(Y?, X?, Eq), neg(Eq?, Ne), all_in(Y?, X?, Sub), and(Ne?, Sub?, B1), has_smaller1(B1?, Ys?, X?, B).

procedure has_smaller1(YesNo?, PeerSets?, Peers?, YesNo).
has_smaller1(yes, _, _, yes).
has_smaller1(no, Ys, X, B?) :- has_smaller(Ys?, X?, B).

procedure keep_set(YesNo?, Peers?, PeerSets?, PeerSets).
keep_set(yes, _, M, M?).
keep_set(no, X, M, [X? | M?]).

procedure mates_opener(Mates?, Opener).
mates_opener(Ms, Op?) :- ground(Ms?) | mates_gsets(Ms?, G), only_empty(G?, Ug), unguarded_firsts(Ms?, Fs), sort_peers(Fs?, Ss), mates_opener1(Ug?, Ss?, Op).

procedure mates_opener1(YesNo?, Peers?, Opener).
mates_opener1(yes, [P | _], opener(P?)).
mates_opener1(yes, [], guarded_class).
mates_opener1(no, _, guarded_class).

procedure unguarded_firsts(Mates?, Peers).
unguarded_firsts([], []).
unguarded_firsts([mate(_, _, [], F) | Ms], [F? | Fs?]) :- unguarded_firsts(Ms?, Fs).
unguarded_firsts([mate(_, _, [_ | _], _) | Ms], Fs?) :- unguarded_firsts(Ms?, Fs).

procedure in_class(RoleSpecs?, Binding?, Parts?, Parts?, Peers?, Mates?, YesNo).
in_class(Rs, B, Ps, Ps1, Q, Ms, R?) :- parts_eq(Ps?, Ps1?, E), in_class1(E?, Rs?, B?, Q?, Ms?, R).

procedure in_class1(YesNo?, RoleSpecs?, Binding?, Peers?, Mates?, YesNo).
in_class1(no, _, _, _, _, no).
in_class1(yes, Rs, B, Q, Ms, R?) :- reflexive_preds(Rf), linked_any(Ms?, Rs?, B?, Q?, Rf?, R).

procedure linked_any(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any([], _, _, _, _, no).
linked_any([mate(N, B2, _, _) | Ms], Rs, B, Q, Rf, L?) :- ground(Rs?), ground(B?), ground(Q?), ground(Rf?) | schema_spec(N?, Rs2), linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L1), linked_any1(L1?, Ms?, Rs?, B?, Q?, Rf?, L).

procedure linked_any1(YesNo?, Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any1(yes, _, _, _, _, _, yes).
linked_any1(no, Ms, Rs, B, Q, Rf, L?) :- linked_any(Ms?, Rs?, B?, Q?, Rf?, L).

procedure class_mates(Constant?, Binding?, Mates?, Peers?, Preds?, Mates).
class_mates(Nm, B, Ms, Q, Rf, Cls?) :- ground(Nm?), ground(B?), ground(Ms?) | schema_spec(Nm?, Rs), mate_of(yes, B?, Nm?, Rs?, M0), grow(M0?, Ms?, Q?, Rf?, [], In), keep_mates(Ms?, In?, Cls).

procedure grow(Mates?, Mates?, Peers?, Preds?, Mates?, Mates).
grow([], _, _, _, Done, Done?).
grow([mate(N, B, G, F) | Fs], Rest, Q, Rf, Done, Out?) :- ground(N?), ground(B?), ground(Rest?), ground(Q?), ground(Rf?) | schema_spec(N?, Rs), split_linked(Rest?, Rs?, B?, Q?, Rf?, New, Keep), app(Fs?, New?, Fs1), grow(Fs1?, Keep?, Q?, Rf?, [mate(N?, B?, G?, F?) | Done?], Out).

procedure split_linked(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, Mates, Mates).
split_linked([], _, _, _, _, [], []).
split_linked([mate(N2, B2, G2, F2) | Ms], Rs, B, Q, Rf, New?, Keep?) :- ground(N2?), ground(B2?), ground(Rs?), ground(B?), ground(Q?), ground(Rf?) | schema_spec(N2?, Rs2), linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L), split_linked(Ms?, Rs?, B?, Q?, Rf?, New1, Keep1), split_one(L?, mate(N2?, B2?, G2?, F2?), New1?, Keep1?, New, Keep).

procedure split_one(YesNo?, Mate?, Mates?, Mates?, Mates, Mates).
split_one(yes, M, New, Keep, [M? | New?], Keep?).
split_one(no, M, New, Keep, New?, [M? | Keep?]).

procedure keep_mates(Mates?, Mates?, Mates).
keep_mates([], _, []).
keep_mates([M | Ms], In, R?) :- ground(M?), ground(In?) | mem(M?, In?, B), keep_mates(Ms?, In?, R1), keep_mate(B?, M?, R1?, R).

procedure keep_mate(YesNo?, Mate?, Mates?, Mates).
keep_mate(yes, M, R, [M? | R?]).
keep_mate(no, _, R, R?).

procedure live_mates(Mates?, Peers?, Preds?, Mates).
live_mates([], _, _, []).
live_mates([mate(N, B, G, F) | Ms], Q, Rf, R?) :- ground(N?), ground(B?), ground(Q?), ground(Rf?) | schema_spec(N?, Rs), live_at(Q?, Rs?, B?, Rf?, L), live_mates(Ms?, Q?, Rf?, R1), keep_mate(L?, mate(N?, B?, G?, F?), R1?, R).

procedure live_at(Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at([], _, _, _, yes).
live_at([P | Ps], Rs, B, Rf, Ok?) :- ground(P?), ground(Rs?), ground(B?), ground(Rf?) | reqs_at(Rs?, B?, P?, Rf?, R), forbs_at(Rs?, B?, P?, F), live_one(R?, F?, P?, Rf?, Ok1), live_at1(Ok1?, Ps?, Rs?, B?, Rf?, Ok).

procedure live_at1(YesNo?, Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at1(no, _, _, _, _, no).
live_at1(yes, Ps, Rs, B, Rf, Ok?) :- live_at(Ps?, Rs?, B?, Rf?, Ok).

procedure live_one(CAtoms?, CAtoms?, Peer?, Preds?, YesNo).
live_one(R, F, P, Rf, Ok?) :- ground(F?) | ms_meets(R?, F?, M1), own_reflexive_in(F?, P?, Rf?, M2), or(M1?, M2?, M), neg(M?, Ok).

procedure linked(Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked([], _, _, _, _, _, yes).
linked([P | Ps], Rs1, B1, Rs2, B2, Rf, L?) :- ground(P?), ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?) | reqs_at(Rs1?, B1?, P?, Rf?, R1), reqs_at(Rs2?, B2?, P?, Rf?, R2), forbs_at(Rs1?, B1?, P?, F1), forbs_at(Rs2?, B2?, P?, F2), bound_cs(R1?, Rb1), bound_cs(R2?, Rb2), ms_meets(Rb1?, F2?, C1), ms_meets(Rb2?, F1?, C2), or(C1?, C2?, C), linked1(C?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

procedure linked1(YesNo?, Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked1(yes, _, _, _, _, _, _, no).
linked1(no, Ps, Rs1, B1, Rs2, B2, Rf, L?) :- linked(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

procedure reqs_at(RoleSpecs?, Binding?, Peer?, Preds?, CAtoms).
reqs_at(Rs, B, P, Rf, R?) :- ground(B?), ground(P?) | specs_at(Rs?, 1, B?, P?, RsP), reqs_of(RsP?, Q), cimg_atoms(Q?, B?, R0), drop_own_reflexive(R0?, P?, Rf?, R).

procedure forbs_at(RoleSpecs?, Binding?, Peer?, CAtoms).
forbs_at(Rs, B, P, F?) :- ground(B?) | specs_at(Rs?, 1, B?, P?, RsP), forbs_of(RsP?, Fs), cimg_atoms(Fs?, B?, F).

procedure forbs_of(RoleSpecs?, SAtoms).
forbs_of([], []).
forbs_of([R | Rs], F?) :- rs_forb(R?, F1), forbs_of(Rs?, F2), app(F1?, F2?, F).

procedure drop_own_reflexive(CAtoms?, Peer?, Preds?, CAtoms).
drop_own_reflexive([], _, _, []).
drop_own_reflexive([A | As], P, Rf, R?) :- ground(A?), ground(P?), ground(Rf?) | own_atom(A?, P?, Rf?, Own), drop_own_reflexive(As?, P?, Rf?, R1), keep_c(Own?, A?, R1?, R).

procedure own_reflexive_in(CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in([], _, _, no).
own_reflexive_in([A | As], P, Rf, B?) :- ground(P?), ground(Rf?) | own_atom(A?, P?, Rf?, B1), own_reflexive_in1(B1?, As?, P?, Rf?, B).

procedure own_reflexive_in1(YesNo?, CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in1(yes, _, _, _, yes).
own_reflexive_in1(no, As, P, Rf, B?) :- own_reflexive_in(As?, P?, Rf?, B).

procedure own_atom(CAtom?, Peer?, Preds?, YesNo).
own_atom(cmp_atom(N, [cmp_val(p(Q))]), P, Rf, B?) :- (Q? =?= P?) | mem(N?, Rf?, B).
own_atom(_, _, _, no) :- otherwise | true.

procedure bound_cs(CAtoms?, CAtoms).
bound_cs([], []).
bound_cs([A | As], R?) :- ground(A?) | has_free(A?, Fr), bound_cs(As?, R1), keep_c(Fr?, A?, R1?, R).

procedure has_free(CAtom?, YesNo).
has_free(cmp_atom(_, Xs), B?) :- has_free1(Xs?, B).

procedure has_free1(CVals?, YesNo).
has_free1([], no).
has_free1([cmp_free(_) | _], yes).
has_free1([cmp_val(_) | Xs], B?) :- has_free1(Xs?, B).

procedure keep_c(YesNo?, CAtom?, CAtoms?, CAtoms).
keep_c(no, A, R, [A? | R?]).
keep_c(yes, _, R, R?).

procedure cimg_atoms(SAtoms?, Binding?, CAtoms).
cimg_atoms([], _, []).
cimg_atoms([atom(P, Vs) | As], B, [cmp_atom(P?, Xs?) | Cs?]) :- ground(B?) | cimg_args(Vs?, B?, Xs), cimg_atoms(As?, B?, Cs).

procedure cimg_args(Vars?, Binding?, CVals).
cimg_args([], _, []).
cimg_args([sgn(Y, I) | Vs], B, [X? | Xs?]) :- ground(B?), ground(Y?), ground(I?) | lookup(svar(Y?), B?, F), role_person(I?, B?, P), cimg_sgn(F?, P?, sgn(Y?, I?), X), cimg_args(Vs?, B?, Xs).
cimg_args([V | Vs], B, [X? | Xs?]) :- otherwise, ground(B?), ground(V?) | lookup(V?, B?, F), cimg_val(F?, V?, X), cimg_args(Vs?, B?, Xs).

procedure cimg_val(Found?, Var?, CVal).
cimg_val(found(X), _, cmp_val(X?)).
cimg_val(free, V, cmp_free(V?)).

procedure cimg_sgn(Found?, Peer?, Var?, CVal).
cimg_sgn(found(s(S)), P, _, cmp_val(s(speech(S?, P?)))).
cimg_sgn(_, _, V, cmp_free(V?)) :- otherwise | true.

procedure schema_spec(Constant?, RoleSpecs).
schema_spec(Nm, Rs?) :- contract_schemas(Ss), find_schema(Ss?, Nm?, Rs).

procedure find_schema(Schemas?, Constant?, RoleSpecs).
find_schema([], _, []).
find_schema([schema(M, Rs) | _], Nm, Rs?) :- (M? =?= Nm?) | true.
find_schema([_ | Ss], Nm, Rs?) :- otherwise | find_schema(Ss?, Nm?, Rs).

procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R | _], I, R?) :- (I? =:= 1) | true.
nth_spec([_ | Rs], I, R?) :- (I? > 1) | I1 := (I? - 1), nth_spec(Rs?, I1?, R).

procedure rs_len(RoleSpecs?, Integer).
rs_len([], 0).
rs_len([_ | Rs], N?) :- rs_len(Rs?, M), N := (M? + 1).

procedure rs_add(RoleSpec?, SAtoms).
rs_add(rs(_, A, _, _, _), A?).

procedure rs_del(RoleSpec?, SAtoms).
rs_del(rs(_, _, D, _, _), D?).

procedure rs_req(RoleSpec?, SAtoms).
rs_req(rs(_, _, D, K, _), R?) :- app(K?, D?, R).

procedure rs_forb(RoleSpec?, SAtoms).
rs_forb(rs(_, _, _, _, F), F?).

procedure role_person(Integer?, Binding?, Peer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), found_peer(F?, P).

procedure found_peer(Found?, Peer).
found_peer(found(p(P)), P?).
found_peer(found(s(_)), unbound).
found_peer(free, unbound).

procedure lookup(Var?, Binding?, Found).
lookup(_, [], free).
lookup(V, [b(W, X) | _], found(X?)) :- (V? =?= W?) | true.
lookup(V, [_ | Bs], F?) :- otherwise | lookup(V?, Bs?, F).

procedure img_atoms(SAtoms?, Binding?, GAtoms).
img_atoms([], _, []).
img_atoms([A | As], B, [G? | Gs?]) :- ground(B?) | img_atom(A?, B?, G), img_atoms(As?, B?, Gs).

procedure img_atom(SAtom?, Binding?, GAtom).
img_atom(atom(P, Vs), B, g(P?, Xs?)) :- img_args(Vs?, B?, Xs).

procedure img_args(Vars?, Binding?, Vals).
img_args([], _, []).
img_args([sgn(Y, I) | Vs], B, [X? | Xs?]) :- ground(B?), ground(Y?), ground(I?) | lookup(svar(Y?), B?, F), role_person(I?, B?, P), img_sgn(F?, P?, X), img_args(Vs?, B?, Xs).
img_args([V | Vs], B, [X? | Xs?]) :- otherwise, ground(B?) | lookup(V?, B?, F), img_val(F?, X), img_args(Vs?, B?, Xs).

procedure img_val(Found?, Val).
img_val(found(X), X?).
img_val(free, p(unbound)).

procedure img_sgn(Found?, Peer?, Val).
img_sgn(found(s(S)), P, s(speech(S?, P?))).
img_sgn(_, _, p(unbound)) :- otherwise | true.

procedure atom_bound(SAtom?, Binding?, YesNo).
atom_bound(atom(_, Vs), B, R?) :- vars_bound(Vs?, B?, R).

procedure vars_bound(Vars?, Binding?, YesNo).
vars_bound([], _, yes).
vars_bound([V | Vs], B, R?) :- ground(B?) | lookup(V?, B?, F), vars_bound1(F?, Vs?, B?, R).

procedure vars_bound1(Found?, Vars?, Binding?, YesNo).
vars_bound1(free, _, _, no).
vars_bound1(found(_), Vs, B, R?) :- vars_bound(Vs?, B?, R).

procedure match_all(SAtoms?, GAtoms?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A | As], Gs, B, R?) :- ground(Gs?) | match_into(A?, Gs?, B?, Bs), match_all_each(Bs?, As?, Gs?, R).

procedure match_all_each(Bindings?, SAtoms?, GAtoms?, Bindings).
match_all_each([], _, _, []).
match_all_each([B | Bs], As, Gs, R?) :- ground(As?), ground(Gs?) | match_all(As?, Gs?, B?, R1), match_all_each(Bs?, As?, Gs?, R2), app(R1?, R2?, R).

procedure match_into(SAtom?, GAtoms?, Binding?, Bindings).
match_into(_, [], _, []).
match_into(A, [G | Gs], B, R?) :- ground(A?), ground(B?) | match_atom(A?, G?, B?, M), match_into1(M?, A?, Gs?, B?, R).

procedure match_into1(Match?, SAtom?, GAtoms?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1? | R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).

procedure match_atom(SAtom?, GAtom?, Binding?, Match).
match_atom(atom(P, Vs), g(Q, Xs), B, R?) :- (P? =?= Q?) | match_args(Vs?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.

procedure match_args(Vars?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_ | _], _, nomatch).
match_args([_ | _], [], _, nomatch).
match_args([sgn(Y, I) | Vs], [X | Xs], B, R?) :- ground(Y?), ground(I?), ground(X?), ground(B?) | sgn_parts(X?, Ps), match_sgn(Ps?, Y?, I?, Vs?, Xs?, B?, R).
match_args([V | Vs], [X | Xs], B, R?) :- otherwise, ground(V?), ground(X?), ground(B?) | lookup(V?, B?, F), kind_ok(V?, X?, K), match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).

procedure sgn_parts(Val?, SgnParts).
sgn_parts(s(speech(speech(U, Q), P)), signed(s(speech(U?, Q?)), P?)).
sgn_parts(s(speech(utterance(_), _)), unsigned).
sgn_parts(p(_), unsigned).

procedure match_sgn(SgnParts?, Constant?, Integer?, Vars?, Vals?, Binding?, Match).
match_sgn(signed(S, P), Y, I, Vs, Xs, B, R?) :- match_args([svar(Y?), role(I?) | Vs?], [S?, p(P?) | Xs?], B?, R).
match_sgn(unsigned, _, _, _, _, _, nomatch).

procedure match_one(Found?, YesNo?, Var?, Val?, Vars?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- (W? =?= X?) | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(free, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [b(V?, X?) | B?], R).
match_one(free, no, _, _, _, _, _, nomatch).

procedure kind_ok(Var?, Val?, YesNo).
kind_ok(role(_), p(_), yes).
kind_ok(role(_), s(_), no).
kind_ok(pvar(_), p(_), yes).
kind_ok(pvar(_), s(_), no).
kind_ok(svar(_), p(_), no).
kind_ok(svar(_), s(_), yes).
kind_ok(sgn(_, _), p(_), no).
kind_ok(sgn(_, _), s(_), no).

procedure val_peer(Var?, Binding?, Peer?, Peer).
val_peer(V, B, D, P?) :- lookup(V?, B?, F), val_peer1(F?, D?, P).

procedure val_peer1(Found?, Peer?, Peer).
val_peer1(found(p(P)), _, P?).
val_peer1(found(s(_)), D, D?).
val_peer1(free, D, D?).

procedure val_speech(Var?, Binding?, Peer?, Speech).
val_speech(V, B, D, S?) :- lookup(V?, B?, F), val_speech1(F?, D?, S).

procedure val_speech1(Found?, Peer?, Speech).
val_speech1(found(s(S)), _, S?).
val_speech1(found(p(_)), D, speech(utterance(none), D?)).
val_speech1(free, D, speech(utterance(none), D?)).

procedure st_id(St?, Peer).
st_id(st(Id, _, _, _, _, _, _, _, _, _), Id?).

procedure st_app(St?, App).
st_app(st(_, Ap, _, _, _, _, _, _, _, _), Ap?).

procedure st_count(St?, Integer).
st_count(st(_, _, D, _, _, _, _, _, _, _), D?).

procedure st_sent(St?, Peers).
st_sent(st(_, _, _, Se, _, _, _, _, _, _), Se?).

procedure st_recd(St?, Peers).
st_recd(st(_, _, _, _, Rc, _, _, _, _, _), Rc?).

procedure st_known(St?, List(Key)).
st_known(St, Ks?) :- ground(St?) | st_sent(St?, Se), st_isent(St?, ISe), app(Se?, ISe?, Ps), known_sorted(Ps?, St?, Ks).

procedure known_sorted(Peers?, St?, List(Key)).
known_sorted(Ps, St, Ks?) :- ground(Ps?) | dedup(Ps?, Ps1), known_of(Ps1?, St?, K0), sort_peers(K0?, Ks).

procedure known_of(Peers?, St?, Peers).
known_of([], _, []).
known_of([P | Ps], St, Ks?) :- ground(P?), ground(St?) | known_st(P?, St?, B), known_of(Ps?, St?, K1), keep_peer(B?, P?, K1?, Ks).

procedure keep_peer(YesNo?, Peer?, Peers?, Peers).
keep_peer(yes, P, Ks, [P? | Ks?]).
keep_peer(no, _, Ks, Ks?).

procedure st_isent(St?, Peers).
st_isent(st(_, _, _, _, _, ISe, _, _, _, _), ISe?).

procedure st_irecd(St?, Peers).
st_irecd(st(_, _, _, _, _, _, IRc, _, _, _), IRc?).

procedure st_waits(St?, Waits).
st_waits(st(_, _, _, _, _, _, _, W, _, _), W?).

procedure st_pends(St?, Pends).
st_pends(st(_, _, _, _, _, _, _, _, _, Pd), Pd?).

procedure set_app(St?, App?, St).
set_app(st(Id, _, D, Se, Rc, ISe, IRc, W, Ca, Pd), Ap, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?)).

procedure set_waits(St?, Waits?, St).
set_waits(st(Id, Ap, D, Se, Rc, ISe, IRc, _, Ca, Pd), W, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?)).

procedure set_pends(St?, Pends?, St).
set_pends(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, _), Pd, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?)).

procedure add_pend_once(Pend?, St?, St).
add_pend_once(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?)) :- ground(X?), ground(Pd?) | mem(X?, Pd?, In), add_pend1(In?, X?, Pd?, Pd1).

procedure add_pend1(YesNo?, Pend?, Pends?, Pends).
add_pend1(yes, _, Pd, Pd?).
add_pend1(no, X, Pd, Pd1?) :- app(Pd?, [X?], Pd1).

procedure drop_pend(Pend?, St?, St).
drop_pend(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?)) :- remove_all(X?, Pd?, Pd1).

procedure add_sent(Peer?, St?, St).
add_sent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), st(Id?, Ap?, D?, [Q? | Se?], Rc?, ISe?, IRc?, W?, Ca?, Pd?)).

procedure add_isent(Peer?, St?, St).
add_isent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), st(Id?, Ap?, D?, Se?, Rc?, [Q? | ISe?], IRc?, W?, Ca?, Pd?)).

procedure add_irecd(Peer?, St?, St).
add_irecd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), st(Id?, Ap?, D?, Se?, Rc?, ISe?, [P? | IRc?], W?, Ca?, Pd?)).

procedure add_recd(Peer?, St?, St).
add_recd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), st(Id?, Ap?, D?, Se?, [P? | Rc?], ISe?, IRc?, W?, Ca?, Pd?)).

procedure advance(St?, St).
advance(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd), st(Id?, Ap?, D1?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?)) :- D1 := (D? + 1).

procedure app_recs(App?, Recs).
app_recs(app(_, _, _, R), R?).

procedure app_count(App?, Integer).
app_count(app(_, K, _, _), K?).

procedure app_state(App?, GAtoms).
app_state(app(S, _, _, _), S?).

procedure attempt_id(Attempt?, Peer).
attempt_id(attempt(I, _, _, _), I?).

procedure attempt_k(Attempt?, Integer).
attempt_k(attempt(_, K, _, _), K?).

procedure attempt_rank(Attempt?, Integer).
attempt_rank(attempt(_, _, P, _), P?).

procedure attempt_class(Attempt?, Class).
attempt_class(attempt(_, _, _, C), C?).

procedure and(YesNo?, YesNo?, YesNo).
and(yes, B, B?).
and(no, _, no).

procedure or(YesNo?, YesNo?, YesNo).
or(yes, _, yes).
or(no, B, B?).

procedure neg(YesNo?, YesNo).
neg(yes, no).
neg(no, yes).

procedure(X) same(X?, X?, YesNo).
same(P, Q, yes) :- (P? =?= Q?) | true.
same(_, _, no) :- otherwise | true.

procedure same_int(Integer?, Integer?, YesNo).
same_int(M, N, yes) :- (M? =:= N?) | true.
same_int(_, _, no) :- otherwise | true.

procedure sort_peers(Peers?, Peers).
sort_peers([], []).
sort_peers([P | Ps], S?) :- sort_peers(Ps?, S1), insert_peer(P?, S1?, S).

procedure insert_peer(Peer?, Peers?, Peers).
insert_peer(P, [], [P?]).
insert_peer(P, [Q | Qs], [P?, Q? | Qs?]) :- '@<'(P?, Q?) | true.
insert_peer(P, [Q | Qs], [Q? | R?]) :- otherwise | insert_peer(P?, Qs?, R).

procedure(X) app(Stream(X)?, Stream(X)?, Stream(X)).
app([], Ys, Ys?).
app([X | Xs], Ys, [X? | Zs?]) :- app(Xs?, Ys?, Zs).

procedure(X) mem(X?, Stream(X)?, YesNo).
mem(_, [], no).
mem(X, [Y | _], yes) :- (X? =?= Y?) | true.
mem(X, [_ | Ys], R?) :- otherwise | mem(X?, Ys?, R).

procedure(X) dedup(Stream(X)?, Stream(X)).
dedup([], []).
dedup([X | Xs], [X? | Ys?]) :- ground(X?) | remove_all(X?, Xs?, Xs1), dedup(Xs1?, Ys).

procedure(X) remove_all(X?, Stream(X)?, Stream(X)).
remove_all(_, [], []).
remove_all(X, [Y | Ys], Zs?) :- (X? =?= Y?) | remove_all(X?, Ys?, Zs).
remove_all(X, [Y | Ys], [Y? | Zs?]) :- otherwise | remove_all(X?, Ys?, Zs).

procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y | Ys], yes, Ys?) :- (X? =?= Y?) | true.
ms_remove(X, [Y | Ys], F?, [Y? | Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).

procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X | Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).

procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X | Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).

procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).

procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) | ms_sub(A?, B?, R1), ms_sub(B?, A?, R2), and(R1?, R2?, R).

procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).

procedure(X) ms_meets(Stream(X)?, Stream(X)?, YesNo).
ms_meets([], _, no).
ms_meets([X | Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), ms_meets1(R1?, Xs?, B?, R).

procedure(X) ms_meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_meets1(yes, _, _, yes).
ms_meets1(no, Xs, B, R?) :- ms_meets(Xs?, B?, R).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).
Event(Q, T) ::= Ask(Q) ; Input(T) ; Draw(T).
Events(Q, T) ::= [Event(Q, T) | Events(Q, T)].
Turn ::= ask ; grant ; draw.

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(_), Stream(Draw(T))?, Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, DOut, [], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) fair(Turn?, Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Events(Q, T)).
fair(ask, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(grant, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(draw, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(ask, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(grant, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(draw, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(ask, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(grant, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(draw, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).

procedure(Q, T) serve(Events(Q, T)?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve([ask(_, Q) | Es], CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve(Es?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve([input(Id, P, R) | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(input(Id?, P?, R?), Rs?, Rs1), serve(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve([draw(Id, W, V) | Es], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve(Es?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve([withdraw(Id) | Es], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve(Es?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(Path?, _?, Stream(_)).
shown(_, X, [X?]) :- ground(X?) | true.
shown(P, X, [pending(P?) | Vs?]) :- shown_whole(X?, Vs).

procedure shown_whole(_?, Stream(_)).
shown_whole(X, [X?]) :- ground(X?) | true.

procedure thread(Path?, Stream(_)?, Stream(Stream(_))).
thread(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread(_, [], [[]]).
thread(P, Xs, [[] | Vs?]) :- thread_tail(P?, Xs?, Vs).

procedure thread_tail(Path?, Stream(_)?, Stream(Stream(_))).
thread_tail(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread_tail(_, [], []).

procedure thread_cell(Path?, _?, Stream(_)?, Stream(Stream(_))).
thread_cell(P, X, Xs, Vs?) :- ground(P?) | path(P?, 1, P1), path(P?, 2, P2), shown(P1?, X?, V1), thread(P2?, Xs?, V2), cons_views(V1?, V2?, Vs).

procedure cons_views(Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_views([E | Es], [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_views([], _, []).
cons_views(_, [], []).

procedure cons_more(_?, Stream(_)?, Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_more(_, T, [E | Es], Ts, [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(E, _, Es, [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(_, _, [], [], []).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, Ss), output(thread(menu([form(propose, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(start, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(answer, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(vote, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(tally, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(commit, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(yield, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(wound, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))])), field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(outcome, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]))]), form(introduce_peers, [field('Peer', shown), field('Peer', shown)]), form(discover, [field('Peer', shown)])])), MOut?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, menu_w(X), Gs, Ds?) :- present_menu([], X?, Gs?, _, Vs, Done), run_menu_w(Id?, form(menu, [field('Key', shown), field('List(Key)', thread), field('Request', menu([form(propose, [field('Proposal', menu([form(mint, [field('Peer', peer)]), form(swap, [field('Peer', peer), field('Peer', peer), field('Peer', peer), field('Peer', peer)]), form(pay, [field('Peer', peer), field('Peer', peer)]), form(redeem, [field('Peer', peer), field('Peer', peer), field('Peer', peer)])]))]), form(known, [field('Peer', peer)])]))]), Vs?, Done?, Ds).
construct(Id, approval_w(X), Gs, Ds?) :- present_approval([], X?, Gs?, _, Vs, Done), run_approval_w(Id?, form(approval, [field('Attempt', form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(mint, [field('Peer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))])), field('YesNo', buttons([yes, no]))]), Vs?, Done?, Ds).

procedure output(_?, Stream(Output)?, Stream(Draw(Drawn))).
output(W, Ms, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Ds).

procedure output_more(_?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Ds).
output_more(_, [], _, []).

procedure output_draw(_?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure join_proposal_mint_1(Formed(Peer)?, Formed(Proposal)).
join_proposal_mint_1(formed(X1), formed(mint(X1?))).
join_proposal_mint_1(refused, refused).

procedure join_proposal_swap_4(Formed(Peer)?, Formed(Peer)?, Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_swap_4(formed(X1), formed(X2), formed(X3), formed(X4), formed(swap(X1?, X2?, X3?, X4?))).
join_proposal_swap_4(refused, _, _, _, refused).
join_proposal_swap_4(_, refused, _, _, refused).
join_proposal_swap_4(_, _, refused, _, refused).
join_proposal_swap_4(_, _, _, refused, refused).

procedure join_proposal_pay_2(Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_pay_2(formed(X1), formed(X2), formed(pay(X1?, X2?))).
join_proposal_pay_2(refused, _, refused).
join_proposal_pay_2(_, refused, refused).

procedure join_proposal_redeem_3(Formed(Peer)?, Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_redeem_3(formed(X1), formed(X2), formed(X3), formed(redeem(X1?, X2?, X3?))).
join_proposal_redeem_3(refused, _, _, refused).
join_proposal_redeem_3(_, refused, _, refused).
join_proposal_redeem_3(_, _, refused, refused).

procedure form_proposal(_?, Formed(Proposal)).
form_proposal(mint(R1), F?) :- form_string(R1?, F1), join_proposal_mint_1(F1?, F).
form_proposal(swap(R1, R2, R3, R4), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), form_string(R4?, F4), join_proposal_swap_4(F1?, F2?, F3?, F4?, F).
form_proposal(pay(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_proposal_pay_2(F1?, F2?, F).
form_proposal(redeem(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), join_proposal_redeem_3(F1?, F2?, F3?, F).
form_proposal(_, refused) :- otherwise | true.

procedure join_request_propose_1(Formed(Proposal)?, Formed(Request)).
join_request_propose_1(formed(X1), formed(propose(X1?))).
join_request_propose_1(refused, refused).

procedure join_request_known_1(Formed(Peer)?, Formed(Request)).
join_request_known_1(formed(X1), formed(known(X1?))).
join_request_known_1(refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(propose(R1), F?) :- form_proposal(R1?, F1), join_request_propose_1(F1?, F).
form_request(known(R1), F?) :- form_string(R1?, F1), join_request_known_1(F1?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_request(Path?, Request, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_request(Formed(Request)?, Path?, Request, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_request(formed(V), _, V?, _, Gs, Gs?, done).
take_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_request(P?, X, Gs?, Gs1, Done).

procedure start_menu_menu_3(Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
start_menu_menu_3([V1 | S1], [V2 | S2], [V3 | S3], [menu(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_menu_menu_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
start_menu_menu_3([], _, _, []).
start_menu_menu_3(_, [], _, []).
start_menu_menu_3(_, _, [], []).

procedure comb_menu_menu_3(_?, _?, _?, Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
comb_menu_menu_3(_, V2, V3, [V1 | S1], S2, S3, [menu(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_menu_menu_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_menu_menu_3(V1, _, V3, S1, [V2 | S2], S3, [menu(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_menu_menu_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_menu_menu_3(_, _, _, [], [], [], []).

procedure present_menu(Path?, Menu?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_menu(P, menu(H1, H2, H3?), Gs, Gs1?, Vs?, D3?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, Q2), thread(Q2?, H2?, V2), path(P?, 3, M3), path(P?, 3, Q3), answer_request(Q3?, H3, Gs?, Gs1, D3), start_menu_menu_3(V1?, V2?, [input(M3?)], Vs).
present_menu(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_menu_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_menu_wait(Path?, Menu?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_menu_wait(P, menu(H1, H2, H3?), Gs, Gs1?, Vs?, Done?) :- present_menu(P?, menu(H1?, H2?, H3), Gs?, Gs1, Vs, Done).
present_menu_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_menu_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_menu_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_menu_w(Id, _, _, done, [withdraw(Id?)]).
run_menu_w(Id, W, [V | Vs], Done, [draw(Id?, W?, menu_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_menu_w(Id?, W?, Vs?, Done?, Ds).
run_menu_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure form_yesNo(_?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

procedure start_approval_approval_2(Stream(_)?, Stream(_)?, Stream(_)).
start_approval_approval_2([V1 | S1], [V2 | S2], [approval(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_approval_approval_2(V1?, V2?, S1?, S2?, Vs).
start_approval_approval_2([], _, []).
start_approval_approval_2(_, [], []).

procedure comb_approval_approval_2(_?, _?, Stream(_)?, Stream(_)?, Stream(_)).
comb_approval_approval_2(_, V2, [V1 | S1], S2, [approval(V1?, V2?) | Vs?]) :- ground(V1?), ground(V2?) | comb_approval_approval_2(V1?, V2?, S1?, S2?, Vs).
comb_approval_approval_2(_, _, [], [], []).

procedure present_approval(Path?, Approval?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_approval(P, approval(H1, H2?), Gs, Gs1?, Vs?, D2?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, M2), path(P?, 2, Q2), answer_yesNo(Q2?, H2, Gs?, Gs1, D2), start_approval_approval_2(V1?, [input(M2?)], Vs).
present_approval(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_approval_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_approval_wait(Path?, Approval?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_approval_wait(P, approval(H1, H2?), Gs, Gs1?, Vs?, Done?) :- present_approval(P?, approval(H1?, H2), Gs?, Gs1, Vs, Done).
present_approval_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_approval_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_approval_w(Integer?, _?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_approval_w(Id, _, _, done, [withdraw(Id?)]).
run_approval_w(Id, W, [V | Vs], Done, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w(Id?, W?, Vs?, Done?, Ds).
run_approval_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

