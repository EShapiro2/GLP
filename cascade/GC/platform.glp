procedure view_of(St?, Output).
view_of(St, view(A?, Ks?, Ps?, Ts?)) :- ground(St?) | tabs(Ts), st_ms(St?, S), atoms_of(S?, A), st_known(St?, Ks), st_app(St?, Ap), app_recs(Ap?, R), approvals_of(R?, Ps).

procedure approvals_of(Recs?, List(Approved)).
approvals_of(R, As?) :- ground(R?) | approvals1(R?, R?, [], As).

procedure approvals1(Recs?, Recs?, List(Approved)?, List(Approved)).
approvals1([], _, Acc, Acc?).
approvals1([requested(Rr, K) | Rs], R, Acc, As?) :- ground(Rr?), integer(K?), ground(R?) | mem(ended(Rr?, K?), R?, En), rho_name(Rr?, Pn), keep_pname(En?, Pn?, Acc?, Acc1), approvals1(Rs?, R?, Acc1?, As).
