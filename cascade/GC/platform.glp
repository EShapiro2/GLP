procedure again_triggers(Proposals?, Stream(Trigger)).
again_triggers([], []).
again_triggers([N | Ns], [again(N?) | Ts?]) :- again_triggers(Ns?, Ts).

procedure pend_triggers(Pends?, Stream(Trigger)).
pend_triggers([], []).
pend_triggers([_ | _], [recheck]).

procedure request_cond(Proposal?, St?, RCond, St).
request_cond(N, St, Cd?, St2?) :- ground(N?), ground(St?) | st_ms(St?, S), name_class(N?, S?, C), request_cond0(C?, N?, St?, Cd, St2).

procedure request_cond0(Class?, Proposal?, St?, RCond, St).
request_cond0(C, N, St, Cd?, St2?) :- ground(C?), ground(N?), ground(St?) | st_class(C?, St?, R, St1), request_cond1(R?, N?, C?, St1?, Cd, St2).

procedure request_cond1(ClassRes?, Proposal?, Class?, St?, RCond, St).
request_cond1(nocls, N, _, St, rrefuse(N?), St?).
request_cond1(cls(I), N, C, St, Cd?, St?) :- ground(I?), ground(N?), ground(C?), ground(St?) | term_part_of(I?, C?, Pr), request_cands(Pr?, I?, N?, C?, St?, Rq), st_made(St?, Md), pick_request(Rq?, N?, C?, Md?, Cd).

procedure request_cands(PartRes?, Info?, Proposal?, Class?, St?, RQ).
request_cands(nopart, _, _, _, _, rq([], no, no)).
request_cands(part(pt(_, G, guarded_part)), I, _, C, St, rq(Cs?, Bz?, RdN?)) :- ground(G?), ground(I?), ground(C?), ground(St?) | st_id(St?, Id), mem(Id?, G?, Gd), free_i(I?, St?, Fr), st_ms(St?, S), part_dom(C?, Id?, S?, Dm), self_request(I?, St?, NPd), and(Gd?, Fr?, B1), and(B1?, Dm?, B2), and(B2?, NPd?, B), self_cand(B?, C?, Id?, Cs), neg(Fr?, NFr), and(Gd?, NFr?, Bz), and(Gd?, Dm?, RdN).
request_cands(part(pt(_, G, opener(O))), _, N, C, St, rq(Cs?, Bz?, RdN?)) :- ground(G?), ground(N?), ground(C?), ground(St?) | st_id(St?, Id), mem(Id?, G?, Gd), same(O?, Id?, Me), neg(Me?, NMe), free_rho(N?, St?, Fr), st_ms(St?, S), part_dom(C?, Id?, S?, Rd), st_app(St?, Ap), app_recs(Ap?, Rc), pending_request(rho(N?), Rc?, Pd), neg(Pd?, NPd), known_st(O?, St?, Kn), and(Gd?, NMe?, B1), and(B1?, Fr?, B2), and(B2?, Rd?, B3), and(B3?, NPd?, B4), and(B4?, Kn?, B), rho_cand(B?, N?, O?, Cs), neg(Fr?, NFr), and(B1?, NFr?, Bz), or(Gd?, Me?, GO), st_ms(St?, S2), part_dom(C?, Id?, S2?, Dm), and(GO?, Dm?, RdN).

procedure rho_cand(YesNo?, Proposal?, Peer?, RCands).
rho_cand(yes, N, O, [rc(rho(N?), O?)]).
rho_cand(no, _, _, []).

procedure self_request(Info?, St?, YesNo).
self_request(I, St, NPd?) :- ground(I?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, Rc), class_request0(Rc?, I?, Pd), neg(Pd?, NPd).

procedure class_request0(Recs?, Info?, YesNo).
class_request0(R, I, B?) :- ground(R?) | class_request(R?, I?, R?, B).

procedure class_request(Recs?, Info?, Recs?, YesNo).
class_request([], _, _, no).
