class_request([_ | Rs], I, R, B?) :- otherwise | class_request(Rs?, I?, R?, B).

procedure class_request1(YesNo?, Recs?, Info?, Recs?, YesNo).
class_request1(yes, _, _, _, yes).
class_request1(no, Rs, I, R, B?) :- class_request(Rs?, I?, R?, B).

procedure self_cand(YesNo?, Class?, Peer?, RCands).
self_cand(yes, C, Id, [rc(one(C?), Id?)]).
self_cand(no, _, _, []).

procedure pending_request(Rho?, Recs?, YesNo).
pending_request(R, Rc, B?) :- ground(Rc?) | pending_request1(Rc?, R?, Rc?, B).

procedure pending_request1(Recs?, Rho?, Recs?, YesNo).
pending_request1([], _, _, no).
pending_request1([requested(R1, K) | Rs], R, Rc, B?) :- ground(R1?), ground(R?), ground(Rc?), integer(K?) | same(R1?, R?, Sm), mem(ended(R1?, K?), Rc?, En), neg(En?, NEn), and(Sm?, NEn?, P), pending_request2(P?, Rs?, R?, Rc?, B).
pending_request1([_ | Rs], R, Rc, B?) :- otherwise | pending_request1(Rs?, R?, Rc?, B).

procedure pending_request2(YesNo?, Recs?, Rho?, Recs?, YesNo).
pending_request2(yes, _, _, _, yes).
pending_request2(no, Rs, R, Rc, B?) :- pending_request1(Rs?, R?, Rc?, B).

procedure free_rho(Proposal?, St?, YesNo).
free_rho(N, St, B?) :- ground(N?), ground(St?) | st_app(St?, Ap), app_lock_recs(Ap?, L, R), st_id(St?, Id), free_rho1(L?, R?, N?, Id?, St?, B).

procedure free_rho1(Lock?, Recs?, Proposal?, Peer?, St?, YesNo).
free_rho1(L, R, N, Id, St, B?) :- ground(R?) | unlocked(L?, U), no_rho_question(R?, N?, Id?, St?, R?, Q), and(U?, Q?, B).

procedure no_rho_question(Recs?, Proposal?, Peer?, St?, Recs?, YesNo).
no_rho_question([], _, _, _, _, yes).
no_rho_question([asked(At) | Rs], N, Id, St, R, B?) :- ground(At?), ground(N?), ground(Id?), ground(R?) | pending_rec(At?, R?, P), rho_question(P?, At?, N?, Id?, St?, Q, St1), no_rho_question1(Q?, Rs?, N?, Id?, St1?, R?, B).
no_rho_question([_ | Rs], N, Id, St, R, B?) :- otherwise | no_rho_question(Rs?, N?, Id?, St?, R?, B).

procedure rho_question(YesNo?, Attempt?, Proposal?, Peer?, St?, YesNo, St).
rho_question(no, _, _, _, St, no, St?).
rho_question(yes, At, N, Id, St, Q?, St1?) :- attempt_class(At?, C), st_class(C?, St?, Cr, St1), cls_in_rho(Cr?, N?, Id?, Q).

procedure no_rho_question1(YesNo?, Recs?, Proposal?, Peer?, St?, Recs?, YesNo).
no_rho_question1(yes, _, _, _, _, _, no).
no_rho_question1(no, Rs, N, Id, St, R, B?) :- no_rho_question(Rs?, N?, Id?, St?, R?, B).

procedure cls_in_rho(ClassRes?, Proposal?, Peer?, YesNo).
cls_in_rho(nocls, _, _, no).
cls_in_rho(cls(I), N, Id, B?) :- in_rho(I?, N?, Id?, B).

procedure in_rho(Info?, Proposal?, Peer?, YesNo).
in_rho(ci(_, _, Q, Pts, Ms), N, Id, B?) :- ground(Q?), ground(Ms?), ground(N?) | opener_parts(Pts?, Q?, Ms?, N?, Id?, B).

procedure opener_parts(Parts?, Peers?, Mates?, Proposal?, Peer?, YesNo).
opener_parts([], _, _, _, _, no).
opener_parts([pt(T, G, opener(_)) | Ps], Q, Ms, N, Id, B?) :- ground(T?), ground(G?), ground(Q?), ground(Ms?), ground(N?) | part_named(Ms?, T?, G?, Q?, N?, Id?, B1), opener_parts1(B1?, Ps?, Q?, Ms?, N?, Id?, B).
opener_parts([pt(_, _, guarded_part) | Ps], Q, Ms, N, Id, B?) :- opener_parts(Ps?, Q?, Ms?, N?, Id?, B).

procedure opener_parts1(YesNo?, Parts?, Peers?, Mates?, Proposal?, Peer?, YesNo).
opener_parts1(yes, _, _, _, _, _, yes).
opener_parts1(no, Ps, Q, Ms, N, Id, B?) :- opener_parts(Ps?, Q?, Ms?, N?, Id?, B).

procedure part_named(Mates?, Class?, Peers?, Peers?, Proposal?, Peer?, YesNo).
part_named([], _, _, _, _, _, no).
part_named([mate(Nm, Bn, G1, _) | Ms], T, G, Q, N, Id, B?) :- ground(Nm?), ground(Bn?), ground(G1?), ground(T?), ground(G?), ground(Q?), ground(N?) | binding_of(T?, Nm2, Bn2), same_bpart(Q?, Nm?, Bn?, G1?, Nm2?, Bn2?, G?, Sp), class_of(Nm?, Bn?, Id?, C), request_name(C?, Pn), pname_is(Pn?, N?, Nn), and(Sp?, Nn?, B1), part_named1(B1?, Ms?, T?, G?, Q?, N?, Id?, B).

procedure part_named1(YesNo?, Mates?, Class?, Peers?, Peers?, Proposal?, Peer?, YesNo).
part_named1(yes, _, _, _, _, _, _, yes).
part_named1(no, Ms, T, G, Q, N, Id, B?) :- part_named(Ms?, T?, G?, Q?, N?, Id?, B).

procedure pname_is(PName?, Proposal?, YesNo).
pname_is(pname(M), N, B?) :- same(M?, N?, B).
pname_is(nopname, _, no).

procedure term_part_of(Info?, Class?, PartRes).
term_part_of(I, C, Pr?) :- ground(I?), ground(C?) | info_parts(I?, Pts), term_part_of1(Pts?, I?, C?, Pr).

procedure term_part_of1(Parts?, Info?, Class?, PartRes).
term_part_of1([], _, _, nopart).
term_part_of1([pt(T, G, Op) | Ps], I, C, Pr?) :- ground(T?), ground(G?), ground(Op?), ground(I?), ground(C?) | same_part(I?, C?, T?, B), term_part_of2(B?, pt(T?, G?, Op?), Ps?, I?, C?, Pr).

procedure term_part_of2(YesNo?, Part?, Parts?, Info?, Class?, PartRes).
term_part_of2(yes, P, _, _, _, part(P?)).
term_part_of2(no, _, Ps, I, C, Pr?) :- term_part_of1(Ps?, I?, C?, Pr).

procedure pick_request(RQ?, Proposal?, Class?, Rhos?, RCond).
pick_request(rq([X | Xs], _, _), _, _, Md, Cd?) :- ground(Md?) | least_rcand(Xs?, Md?, X?, Y), rcand_go(Y?, Cd).
pick_request(rq([], yes, _), N, _, _, rhold(N?)).
pick_request(rq([], no, yes), _, _, _, rdrop).
pick_request(rq([], no, no), N, _, _, rrefuse(N?)).

procedure least_rcand(RCands?, Rhos?, RCand?, RCand).
least_rcand([], _, Y, Y?).
least_rcand([X | Xs], Md, Y, Z?) :- ground(X?), ground(Y?), ground(Md?) | rcand_place(X?, Md?, AX), rcand_place(Y?, Md?, AY), less_int(AX?, AY?, L), least_rcand1(L?, X?, Y?, Xs?, Md?, Z).

procedure least_rcand1(YesNo?, RCand?, RCand?, RCands?, Rhos?, RCand).
least_rcand1(yes, X, _, Xs, Md, Z?) :- least_rcand(Xs?, Md?, X?, Z).
least_rcand1(no, _, Y, Xs, Md, Z?) :- least_rcand(Xs?, Md?, Y?, Z).

procedure rcand_place(RCand?, Rhos?, Integer).
rcand_place(rc(R, _), Md, A?) :- rho_place(Md?, R?, 1, A).

procedure rho_place(Rhos?, Rho?, Integer?, Integer).
rho_place([], _, _, 0).
rho_place([X | Xs], R, K, A?) :- ground(X?), ground(R?), integer(K?) | same(X?, R?, Sm), rho_place1(Sm?, Xs?, R?, K?, A).

procedure rho_place1(YesNo?, Rhos?, Rho?, Integer?, Integer).
rho_place1(yes, _, _, K, K?).
rho_place1(no, Xs, R, K, A?) :- K1 := (K? + 1), rho_place(Xs?, R?, K1?, A).

procedure less_int(Integer?, Integer?, YesNo).
less_int(A, B, yes) :- (A? < B?) | true.
less_int(A, B, no) :- (A? >= B?) | true.

procedure rcand_go(RCand?, RCond).
rcand_go(rc(R, O), rgo(R?, O?)).

procedure dispatch_request(RCond?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_request(rgo(R, O), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(R?), ground(St?) | request_effect(R?, O?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?, D).
dispatch_request(rdrop, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
dispatch_request(rhold(N), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(N?), ground(St?) | st_reqs(St?, Rq), remove_all(N?, Rq?, Rq1), app(Rq1?, [N?], Rq2), set_reqs(St?, Rq2?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).
dispatch_request(rrefuse(N), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(N?), ground(St?) | st_id(St?, Id), next_n(Th?, no, Ap0?, [refused(N?, Id?, unable)], Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure request_effect(Rho?, Peer?, St?, Sends, St).
request_effect(R, O, St, Ss?, St2?) :- ground(R?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), request_app(R?, Ap?, K, Ap1), request_sends(O?, Id?, R?, K?, Ss), set_app(St?, Ap1?, St1), note_made(R?, St1?, St2).

procedure request_app(Rho?, App?, Integer, App).
request_app(R, app(S, K, L, Rc), K1?, app(S?, K2?, L?, [requested(R?, K3?) | Rc?])) :- integer(K?) | K1 := (K? + 1), K2 := (K? + 1), K3 := (K? + 1).

procedure request_sends(Peer?, Peer?, Rho?, Integer?, Sends).
request_sends(O, Id, _, _, []) :- (O? =?= Id?) | true.
request_sends(O, _, R, K, [to(O?, request(R?, K?))]) :- otherwise | true.

procedure note_made(Rho?, St?, St).
note_made(R, St, St1?) :- ground(R?), ground(St?) | st_made(St?, Md), remove_all(R?, Md?, Md1), app(Md1?, [R?], Md2), set_made(St?, Md2?, St1).

procedure dispatch_propose(PCond?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_propose(pgo(I, P, Nm), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(I?), ground(P?), ground(Nm?), ground(St?) | propose_effect(I?, P?, Nm?, St?, Ss, Ns, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next_n(Th?, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?, D).
dispatch_propose(pdrop, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure ask_of(List(RoleAsk)?, Peer?, List(Word)).
ask_of([], _, []).
ask_of([q(P, Ws) | _], Me, Ws?) :- (P? =?= Me?) | true.
ask_of([_ | Qs], Me, Ws?) :- otherwise | ask_of(Qs?, Me?, Ws).

procedure meet_hello(MeetPeer?, Proposal?, St?, Stream(Net), Stream(Net)?, Stream(Output), Stream(Output)?, St).
meet_hello(nopeer, _, St, Out1?, Out1, Thr1?, Thr1, St?).
meet_hello(peer(Q), N, St, Out?, Out1, Thr?, Thr1, St1?) :- ground(Q?), ground(N?), ground(St?) | known_st(Q?, St?, K), st_sent(St?, Se), mem(Q?, Se?, S), or(K?, S?, B), meet_hello1(B?, Q?, N?, St?, Out, Out1?, Thr, Thr1?, St1).

procedure meet_hello1(YesNo?, Peer?, Proposal?, St?, Stream(Net), Stream(Net)?, Stream(Output), Stream(Output)?, St).
meet_hello1(yes, _, _, St, Out1?, Out1, Thr1?, Thr1, St?).
meet_hello1(no, Q, N, St, [msg(Q?, hello(Id?, N?)) | Out1?], Out1, Thr?, Thr1, St2?) :- ground(Q?), ground(N?), ground(St?) | st_id(St?, Id), add_sent(Q?, St?, St1), show_known(Q?, St?, St1?, Thr, Thr1?, St2).

procedure meet_other(Peer?, Peer?, Peer?, MeetPeer).
meet_other(A, B, Me, P?) :- ground(A?), ground(B?), ground(Me?) | same(A?, Me?, SA), same(B?, Me?, SB), meet_other1(SA?, SB?, A?, B?, P).

procedure meet_other1(YesNo?, YesNo?, Peer?, Peer?, MeetPeer).
meet_other1(yes, no, _, B, peer(B?)).
meet_other1(no, yes, A, _, peer(A?)).
meet_other1(yes, yes, _, _, nopeer).
meet_other1(no, no, _, _, nopeer).

procedure hello_cond(Peer?, St?, YesNo).
hello_cond(P, St, R?) :- ground(St?) | st_recd(St?, Rc), mem(P?, Rc?, B), neg(B?, R).

procedure dispatch_hello(YesNo?, Peer?, Proposal?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_hello(yes, P, N, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(P?), ground(N?), ground(St?) | st_sent(St?, Se), mem(P?, Se?, Sent), add_recd(P?, St?, St1), show_known(P?, St?, St1?, Thr, Thr1?, St2), greet_unless(Sent?, P?, N?, St2?, Ans, Ans1?, St3, D1), next(Th?, no, Ap0?, Ls?, In?, Ans1, Thr1, Out, Ow, Approvals?, H?, St3?, D2), merge(D1?, D2?, D).
dispatch_hello(no, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure greet_unless(YesNo?, Peer?, Proposal?, St?, Stream(Trigger), Stream(Trigger)?, St, Stream(Ask(Question))).
greet_unless(yes, _, _, St, Ans1?, Ans1, St?, []).
greet_unless(no, P, N, St, Ans?, Ans1, St?, D?) :- ground(P?), ground(N?), ground(St?) | st_id(St?, Me), st_ms(St?, S), name_class(N?, S?, C), sentence_of(C?, Me?, Ws), greet(P?, N?, Ws?, R, D), merge(R?, Ans1?, Ans).

procedure intro_cond(Peer?, St?, YesNo).
intro_cond(Q, St, R?) :- ground(Q?), ground(St?) | st_id(St?, Id), st_isent(St?, ISe), same(Q?, Id?, S1), mem(Q?, ISe?, S2), known_st(Q?, St?, S3), or(S1?, S2?, S12), or(S12?, S3?, S), neg(S?, R).

procedure dispatch_intro(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_intro(yes, Q, Th, Ap0, Ls, In, Ans?, Thr?, [msg(Q?, ihello(Id?)) | Out?], Ow?, Approvals, H, St, D?) :- ground(Q?), ground(St?) | st_id(St?, Id), add_isent(Q?, St?, St1), show_known(Q?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, H?, St2?, D).
dispatch_intro(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure ihello_cond(Peer?, St?, YesNo).
ihello_cond(P, St, R?) :- ground(St?) | st_irecd(St?, Rc), mem(P?, Rc?, B), neg(B?, R).

procedure dispatch_ihello(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_ihello(yes, P, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(P?), ground(St?) | add_irecd(P?, St?, St1), show_known(P?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, H?, St2?, D).
dispatch_ihello(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure message_cond(Cargo?, St?, MCond, St).
message_cond(request(_, _), St, mhold, St?).
message_cond(start(At), St, Cd?, St1?) :- ground(At?), ground(St?) | attempt_class(At?, C), st_class(C?, St?, R, St0), message_cond1(R?, start(At?), St0?, Cd, St1).
message_cond(vote(At, V), St, Cd?, St1?) :- ground(At?), ground(St?) | attempt_class(At?, C), st_class(C?, St?, R, St0), message_cond1(R?, vote(At?, V?), St0?, Cd, St1).
message_cond(yield(At), St, Cd?, St1?) :- ground(At?), ground(St?) | attempt_class(At?, C), st_class(C?, St?, R, St0), message_cond1(R?, yield(At?), St0?, Cd, St1).
message_cond(outcome(At, Z), St, Cd?, St1?) :- ground(At?), ground(St?) | attempt_class(At?, C), st_class(C?, St?, R, St0), message_cond1(R?, outcome(At?, Z?), St0?, Cd, St1).

procedure message_cond1(ClassRes?, Cargo?, St?, MCond, St).
message_cond1(nocls, _, St, noparticipant, St?).
message_cond1(_, request(_, _), St, mhold, St?).
message_cond1(cls(I), start(At), St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) | st_closed(At?, St?, Cl), start_cond(Cl?, I?, At?, St?, Cd).
message_cond1(cls(I), vote(_, _), St, mgo(I?), St?).
message_cond1(cls(I), yield(_), St, mgo(I?), St?).
message_cond1(cls(I), outcome(_, _), St, mgo(I?), St?).

procedure start_cond(YesNo?, Info?, Attempt?, St?, MCond).
start_cond(yes, I, _, _, mgo(I?)).
start_cond(no, I, At, St, Cd?) :- ground(I?) | start_waits(I?, At?, St?, W), defer_cond1(W?, I?, Cd).

procedure defer_cond1(YesNo?, Info?, MCond).
defer_cond1(yes, _, mdefer).
defer_cond1(no, I, mgo(I?)).

procedure start_waits(Info?, Attempt?, St?, YesNo).
start_waits(I, A, St, W?) :- st_view(St?, V), start_waits_v(I?, A?, V?, W).

procedure start_waits_v(Info?, Attempt?, V?, YesNo).
start_waits_v(I, A, V, W?) :- ground(A?), ground(V?) | v_pends(V?, Pd), held_prior(Pd?, A?, W1), v_recs(V?, R), question_prior(R?, A?, W2), free_v(I?, V?, Fr), neg(Fr?, W3), or(W1?, W2?, W12), or(W12?, W3?, W).

procedure held_prior(Pends?, Attempt?, YesNo).
held_prior([], _, no).
held_prior([deferred(msg(_, cargo(_, start(B)))) | Ps], A, W?) :- ground(A?), ground(B?) | same(A?, B?, Sm), prio(B?, A?, Pr), neg(Sm?, NSm), and(NSm?, Pr?, W1), held_prior1(W1?, Ps?, A?, W).
held_prior([_ | Ps], A, W?) :- otherwise | held_prior(Ps?, A?, W).

procedure held_prior1(YesNo?, Pends?, Attempt?, YesNo).
held_prior1(yes, _, _, yes).
held_prior1(no, Ps, A, W?) :- held_prior(Ps?, A?, W).

procedure question_prior(Recs?, Attempt?, YesNo).
question_prior(R, A, W?) :- ground(R?) | question_prior1(R?, R?, A?, W).

procedure question_prior1(Recs?, Recs?, Attempt?, YesNo).
question_prior1([], _, _, no).
question_prior1([answered(G, yes) | Rs], R, A, W?) :- ground(G?), ground(R?), ground(A?) | pending_rec(G?, R?, P), same(G?, A?, Sm), neg(Sm?, NSm), prio(G?, A?, Pr), and(P?, NSm?, W0), and(W0?, Pr?, W1), question_prior2(W1?, Rs?, R?, A?, W).
question_prior1([_ | Rs], R, A, W?) :- otherwise | question_prior1(Rs?, R?, A?, W).

procedure question_prior2(YesNo?, Recs?, Recs?, Attempt?, YesNo).
question_prior2(yes, _, _, _, yes).
question_prior2(no, Rs, R, A, W?) :- question_prior1(Rs?, R?, A?, W).

procedure question_waits(Attempt?, V?, YesNo).
question_waits(A, v(_, _, L, R, _, _), W?) :- question_prior(R?, A?, W1), unlocked(L?, U), neg(U?, W2), or(W1?, W2?, W).

procedure app_lock_recs(App?, Lock, Recs).
app_lock_recs(app(_, _, L, R), L?, R?).

procedure free_i(Info?, St?, YesNo).
free_i(I, st(_, app(_, _, L, R), _, _, _, _, _, _, _, _, _, _, _, _), B?) :- free_lr(I?, L?, R?, B).

procedure free_v(Info?, V?, YesNo).
free_v(I, v(_, _, L, R, _, _), B?) :- free_lr(I?, L?, R?, B).

procedure free_lr(Info?, Lock?, Recs?, YesNo).
free_lr(I, L, R, B?) :- ground(R?) | unlocked(L?, B1), no_question(I?, R?, R?, B2), and(B1?, B2?, B).

procedure start_blocker(YesNo?, Info?, V?, Blocker).
start_blocker(no, _, _, noblk).
start_blocker(yes, I, v(_, _, L, R, _, _), Bk?) :- start_blocker1(L?, I?, R?, Bk).

procedure start_blocker1(Lock?, Info?, Recs?, Blocker).
start_blocker1(held(B), _, _, blk(B?)).
start_blocker1(unlocked, I, R, Bk?) :- ground(R?) | class_question(R?, I?, R?, Bk).

procedure class_question(Recs?, Info?, Recs?, Blocker).
class_question([], _, _, noblk).
class_question([asked(G) | Rs], I, R, Bk?) :- ground(G?), ground(I?), ground(R?) | pending_rec(G?, R?, P), of_class(G?, I?, Cl), and(P?, Cl?, B), class_question1(B?, G?, Rs?, I?, R?, Bk).
class_question([_ | Rs], I, R, Bk?) :- otherwise | class_question(Rs?, I?, R?, Bk).

procedure class_question1(YesNo?, Attempt?, Recs?, Info?, Recs?, Blocker).
class_question1(yes, G, _, _, _, blk(G?)).
class_question1(no, _, Rs, I, R, Bk?) :- class_question(Rs?, I?, R?, Bk).

procedure question_blocker(YesNo?, V?, Blocker).
question_blocker(no, _, noblk).
question_blocker(yes, v(_, _, L, _, _, _), Bk?) :- lock_blocker(L?, Bk).

procedure lock_blocker(Lock?, Blocker).
lock_blocker(held(B), blk(B?)).
lock_blocker(unlocked, noblk).

procedure prio(Attempt?, Attempt?, YesNo).
prio(A, B, P?) :- ground(A?), ground(B?) | attempt_rank(A?, RA), attempt_rank(B?, RB), attempt_id(A?, IA), attempt_id(B?, IB), prio1(RA?, RB?, IA?, IB?, P).

procedure prio1(Integer?, Integer?, Peer?, Peer?, YesNo).
prio1(RA, RB, _, _, yes) :- (RA? < RB?) | true.
prio1(RA, RB, _, _, no) :- (RA? > RB?) | true.
prio1(RA, RB, IA, IB, P?) :- (RA? =:= RB?) | precedes(IA?, IB?, P).

procedure recheck_find(Pends?, V?, Trie?, St?, FoundNet).
recheck_find([], _, _, _, nonefound).
recheck_find([deferred(M) | Ps], V, Tr, St, F?) :- ground(M?), ground(V?) | held_takeable(M?, V?, Tr?, St?, T, Tr1, St1), recheck_find1(T?, M?, Ps?, V?, Tr1?, St1?, F).
recheck_find([_ | Ps], V, Tr, St, F?) :- otherwise | recheck_find(Ps?, V?, Tr?, St?, F).

procedure recheck_find1(YesNo?, Net?, Pends?, V?, Trie?, St?, FoundNet).
recheck_find1(yes, M, _, _, _, _, found(M?)).
recheck_find1(no, _, Ps, V, Tr, St, F?) :- recheck_find(Ps?, V?, Tr?, St?, F).

procedure held_takeable(Net?, V?, Trie?, St?, YesNo, Trie, St).
held_takeable(msg(_, cargo(_, start(A))), V, Tr, St, T?, Tr1?, St1?) :- ground(A?) | attempt_class(A?, C), st_class(C?, St?, Cr, St1), held_takeable1(Cr?, A?, V?, Tr?, T, Tr1).
held_takeable(_, _, Tr, St, no, Tr?, St?) :- otherwise | true.

procedure held_takeable1(ClassRes?, Attempt?, V?, Trie?, YesNo, Trie).
held_takeable1(nocls, _, _, Tr, no, Tr?).
held_takeable1(cls(I), A, V, Tr, T?, Tr1?) :- ground(A?), ground(V?) | v_recs(V?, R), trie_closed(A?, R?, Tr?, Cl, Tr1), start_waits_v(I?, A?, V?, W), neg(W?, NW), or(Cl?, NW?, T).

procedure recheck1(FoundNet?, Then?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
recheck1(found(M), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- step(net(M?), Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
recheck1(nonefound, Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(St?) | st_app(St?, Ap0), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure dispatch_message(MCond?, Net?, Peer?, Cargo?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_message(noparticipant, _, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
dispatch_message(mdefer, M, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- add_pend_once(deferred(M?), St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).
dispatch_message(mgo(I), M, _, start(At), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?), ground(St?) | st_id(St?, Me), drop_pend(deferred(M?), St?, St0), start_effect(I?, At?, St0?, Ss, Cr, Ns, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), spawn(Cr?, Me?, Approvals?, Approvals1, Ans, Ans1?, D1), next_n(Th?, yes, Ap0?, Ns?, Ls?, In?, Ans1, Thr, Out1, Ow, Approvals1?, H?, St2?, D2), merge(D1?, D2?, D).
dispatch_message(mgo(I), _, F, vote(At, V), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?) | tally_effect(I?, At?, F?, V?, St?, Ss, Ns, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next_n(Th?, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?, D).
dispatch_message(mgo(I), _, _, yield(At), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?) | yield_effect(I?, At?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?, D).
dispatch_message(mgo(I), _, _, outcome(At, Z), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?) | outcome_effect(I?, At?, Z?, St?, Ns, Ms, St1), put_all(Ms?, Out, Out1?), next_n(Th?, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St1?, D).
dispatch_message(mhold, _, F, request(R, K), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- hold_request(F?, R?, K?, St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).

procedure hold_request(Peer?, Rho?, Integer?, St?, St).
hold_request(F, R, K, St, St1?) :- ground(R?), ground(St?) | st_held(St?, Hd), hold_once(held(F?, R?, K?), Hd?, Hd1), set_held(St?, Hd1?, St1).

procedure hold_once(Held?, Helds?, Helds).
hold_once(X, Hd, Hd1?) :- ground(X?), ground(Hd?) | mem(X?, Hd?, In), hold_once1(In?, X?, Hd?, Hd1).

procedure hold_once1(YesNo?, Held?, Helds?, Helds).
hold_once1(yes, _, Hd, Hd?).
hold_once1(no, X, Hd, Hd1?) :- app(Hd?, [X?], Hd1).

procedure spawn(ApprovalRes?, Peer?, OpenApprovals?, OpenApprovals, Stream(Trigger), Stream(Trigger)?, Stream(Ask(Question))).
spawn(noapproval, _, Cs, Cs?, Ans?, Ans, []).
spawn(approval_for(At), Me, Cs, [oc(At?, Cl) | Cs?], Ans?, Ans1, D?) :- ground(At?) | attempt_class(At?, C), sentence_of(C?, Me?, Ws), respond(At?, Ws?, Cl?, R, D), merge(R?, Ans1?, Ans).

procedure answer_cond(Attempt?, St?, Cond, St).
answer_cond(At, St, Cd?, St2?) :- ground(At?), ground(St?) | attempt_class(At?, C), st_class(C?, St?, R, St1), answer_cond1(R?, At?, St1?, Cd, St2).

procedure answer_cond1(ClassRes?, Attempt?, St?, Cond, St).
answer_cond1(nocls, _, St, drop, St?).
answer_cond1(cls(I), At, St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), unanswered(At?, R?, Ok), go_or_drop(Ok?, I?, Cd).

procedure unanswered(Attempt?, Recs?, YesNo).
unanswered(At, R, B?) :- ground(At?), ground(R?) | pending_rec(At?, R?, P), has_answer(At?, R?, H), neg(H?, Un), and(P?, Un?, B).

procedure dispatch_answer(Cond?, YesNo?, Attempt?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_answer(go(_), YN, At, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?) | answer_effect(YN?, At?, St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).
dispatch_answer(drop, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure close_approval(Attempt?, OpenApprovals?, OpenApprovals).
close_approval(_, [], []).
close_approval(At, [oc(B, close) | Cs], Cs?) :- (At? =?= B?) | true.
close_approval(At, [oc(B, Cl?) | Cs], [oc(B?, Cl) | Cs1?]) :- otherwise | close_approval(At?, Cs?, Cs1).

procedure close_falsified(YesNo?, OpenApprovals?, St?, OpenApprovals).
close_falsified(no, Cs, _, Cs?).
close_falsified(yes, Cs, St, Cs1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), close_approvals(Cs?, R?, Cs1).

procedure close_approvals(OpenApprovals?, Recs?, OpenApprovals).
close_approvals([], _, []).
close_approvals([oc(At, Cl?) | Cs], R, Cs1?) :- ground(At?), ground(R?) | pending_rec(At?, R?, P), close_one(P?, At?, Cl, Cs?, R?, Cs1).

procedure close_one(YesNo?, Attempt?, Close, OpenApprovals?, Recs?, OpenApprovals).
close_one(no, _, close, Cs, R, Cs1?) :- close_approvals(Cs?, R?, Cs1).
close_one(yes, At, Cl?, Cs, R, [oc(At?, Cl) | Cs1?]) :- close_approvals(Cs?, R?, Cs1).

procedure take_own(Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
take_own(Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(St?) | st_app(St?, Ap0), own_cond(St?, Ch, St1), dispatch_own(Ch?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).

procedure own_cond(St?, Choice, St).
own_cond(St, Ch?, St2?) :- ground(St?) | opening(St?, Is, St1), own_cond1(Is?, St1?, Ch, St2).

procedure own_cond1(Infos?, St?, Choice, St).
own_cond1(Is, St, Ch?, St3?) :- ground(Is?), ground(St?) | st_view(St?, V), op_cands(Is?, V?, Cs1), guard_cands(St?, Csg, St1), held_cands(St1?, Csh, St2), own_cond1a(St2?, Cs1?, Csg?, Csh?, Ch, St3).

procedure own_cond1a(St?, Cands?, Cands?, Cands?, Choice, St).
own_cond1a(St, Cs1, Csg, Csh, Ch?, St5?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), st_view(St?, V), vote_cands0(R?, V?, St?, Cs2, St2), commit_cands_st(St2?, Cs3, St3), wound_cands0(St3?, Cs4, St4), intro_cands(St4?, Cs5, St6), app(Cs1?, Csg?, Ca), app(Ca?, Csh?, Cb), app(Cb?, Cs2?, C12), app(C12?, Cs3?, C123), app(C123?, Cs4?, C1234), app(C1234?, Cs5?, Cs), own_cond2(Cs?, St6?, Ch, St5).

procedure own_cond2(Cands?, St?, Choice, St).
own_cond2(Cs, St, Ch?, St2?) :- ground(St?) | st_waits(St?, W), st_app(St?, Ap), app_recs(Ap?, R), st_ix(St?, Ix), prune_waits(W?, R?, Ix?, W0), st_count(St?, D), choose(Cs?, W0?, D?, Ch0, W1), set_waits(St?, W1?, St1), count_own(Ch0?, St1?, Ch, St2).

procedure count_own(Choice?, St?, Choice, St).
count_own(none, St, none, St?).
count_own(take(K, S), St, take(K?, S?), St1?) :- advance(St?, St1).

procedure op_cands(Infos?, V?, Cands).
op_cands([], _, []).
op_cands([I | Is], V, Cs?) :- ground(I?), ground(V?) | v_id(V?, Id), info_parts(I?, Pts), opening_parts(Pts?, Id?, Ps), part_cands(Ps?, I?, V?, Cs1), op_cands(Is?, V?, Cs2), app(Cs1?, Cs2?, Cs).

procedure part_cands(Classes?, Info?, V?, Cands).
part_cands([], _, _, []).
part_cands([P | Ps], I, V, Cs?) :- ground(P?), ground(I?), ground(V?) | may_propose(I?, V?, B1), v_id(V?, Id), v_ms(V?, S), part_dom(P?, Id?, S?, B2), and(B1?, B2?, B), part_cands(Ps?, I?, V?, Cs1), keep_pcand(B?, I?, P?, none, Cs1?, Cs).

procedure keep_pcand(YesNo?, Info?, Class?, Names?, Cands?, Cands).
keep_pcand(yes, I, P, Nm, Cs, [cand(op(P?), prop(I?, P?, Nm?)) | Cs?]) :- ground(P?) | true.
keep_pcand(no, _, _, _, Cs, Cs?).

procedure may_propose(Info?, V?, YesNo).
may_propose(I, V, B?) :- ground(I?), ground(V?) | free_v(I?, V?, Fr), no_prior_start(V?, Np), others_known(I?, V?, K), known_ok(K?, Kn), and(Fr?, Np?, B1), and(B1?, Kn?, B).

procedure guard_cands(St?, Cands, St).
guard_cands(St, Cs?, St1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), st_view(St?, V), approval_classes(R?, St?, Is, St1), guard_cands1(Is?, V?, Cs).

procedure approval_classes(Recs?, St?, Apprs, St).
approval_classes(R, St, Is?, St1?) :- ground(R?) | approval_classes1(R?, R?, St?, [], Is, St1).

procedure approval_classes1(Recs?, Recs?, St?, Apprs?, Apprs, St).
approval_classes1([], _, St, Acc, Is?, St?) :- dedup(Acc?, Is).
approval_classes1([requested(one(C), K) | Rs], R, St, Acc, Is?, St2?) :- ground(C?), ground(R?) | mem(ended(one(C?), K?), R?, Done), approval_class(Done?, C?, by_name(C?), St?, Acc?, Acc1, St1), approval_classes1(Rs?, R?, St1?, Acc1?, Is, St2).
approval_classes1([answered(At, yes) | Rs], R, St, Acc, Is?, St2?) :- ground(At?), ground(R?) | mem(ended(At?), R?, Done), attempt_class(At?, C), approval_class(Done?, C?, any_part, St?, Acc?, Acc1, St1), approval_classes1(Rs?, R?, St1?, Acc1?, Is, St2).
approval_classes1([_ | Rs], R, St, Acc, Is?, St1?) :- otherwise | approval_classes1(Rs?, R?, St?, Acc?, Is, St1).

procedure approval_class(YesNo?, Class?, PartsOf?, St?, Apprs?, Apprs, St).
approval_class(yes, _, _, St, Acc, Acc?, St?).
approval_class(no, C, F, St, Acc, Acc1?, St1?) :- st_class(C?, St?, Cr, St1), open_class(no, Cr?, F?, Acc?, Acc1).

procedure open_class(YesNo?, ClassRes?, PartsOf?, Apprs?, Apprs).
open_class(no, cls(I), F, Acc, [ap(I?, F?) | Acc?]).
open_class(no, nocls, _, Acc, Acc?).
open_class(yes, _, _, Acc, Acc?).

procedure guard_cands1(Apprs?, V?, Cands).
guard_cands1([], _, []).
guard_cands1([ap(I, F) | Is], V, Cs?) :- ground(I?), ground(F?), ground(V?) | v_id(V?, Id), v_ms(V?, S), info_parts(I?, Pts), guarding_parts(Pts?, Id?, Ps0), approval_parts(F?, I?, Ps0?, Ps), may_propose(I?, V?, B), guard_parts_cands(B?, Ps?, I?, Id?, S?, Cs1), guard_cands1(Is?, V?, Cs2), app(Cs1?, Cs2?, Cs).

procedure approval_parts(PartsOf?, Info?, Classes?, Classes).
approval_parts(any_part, _, Ps, Ps?).
approval_parts(by_name(C), I, Ps, Ps1?) :- ground(C?), ground(I?) | parts_named(Ps?, I?, C?, Ps1).

procedure parts_named(Classes?, Info?, Class?, Classes).
parts_named([], _, _, []).
parts_named([P | Ps], I, C, R?) :- ground(P?), ground(I?), ground(C?) | same_part(I?, C?, P?, B), named_part(B?, Ps?, I?, C?, R).

procedure named_part(YesNo?, Classes?, Info?, Class?, Classes).
named_part(yes, _, _, C, [C?]).
named_part(no, Ps, I, C, R?) :- parts_named(Ps?, I?, C?, R).

procedure guard_parts_cands(YesNo?, Classes?, Info?, Peer?, GAtoms?, Cands).
guard_parts_cands(no, _, _, _, _, []).
guard_parts_cands(yes, Ps, I, Id, S, Cs?) :- ground(Ps?), ground(I?), ground(S?) | ready_parts(Ps?, Id?, S?, Rs), guard_ready(Rs?, Ps?, I?, Cs).

procedure guard_ready(Classes?, Classes?, Info?, Cands).
guard_ready([], [], _, []).
guard_ready([], [P | _], I, [cand(op(P?), prop(I?, P?, none))]) :- ground(P?) | true.
guard_ready([R | Rs], _, I, Cs?) :- part_pcands([R? | Rs?], I?, Cs).

procedure part_pcands(Classes?, Info?, Cands).
part_pcands([], _, []).
part_pcands([P | Ps], I, [cand(op(P?), prop(I?, P?, none)) | Cs?]) :- ground(P?), ground(I?) | part_pcands(Ps?, I?, Cs).

procedure held_cands(St?, Cands, St).
held_cands(St, Cs?, St1?) :- ground(St?) | st_held(St?, Hd), st_view(St?, V), held_cands1(Hd?, V?, St?, Cs, St1).

procedure held_cands1(Helds?, V?, St?, Cands, St).
held_cands1([], _, St, [], St?).
held_cands1([held(F, rho(N), K) | Hs], V, St, Cs?, St2?) :- ground(N?), ground(V?) | v_ms(V?, S), name_class(N?, S?, C), held_cand0(C?, F?, N?, K?, V?, St?, Cs1, St1), held_cands1(Hs?, V?, St1?, Cs2, St2), app(Cs1?, Cs2?, Cs).
held_cands1([held(_, one(_), _) | Hs], V, St, Cs?, St1?) :- held_cands1(Hs?, V?, St?, Cs, St1).

procedure held_cand0(Class?, Peer?, Proposal?, Integer?, V?, St?, Cands, St).
held_cand0(C, F, N, K, V, St, Cs?, St1?) :- ground(C?), ground(N?) | st_class(C?, St?, Cr, St1), held_cand(Cr?, F?, C?, request(rho(N?), K?), V?, Cs).

procedure held_cand(ClassRes?, Peer?, Class?, Names?, V?, Cands).
held_cand(nocls, _, _, _, _, []).
held_cand(cls(I), F, C, Nm, V, Cs?) :- ground(I?), ground(C?), ground(V?) | term_part_of(I?, C?, Pr), v_id(V?, Id), opens_for(Pr?, Id?, F?, Op), may_propose(I?, V?, B1), and(Op?, B1?, B), keep_pcand(B?, I?, C?, Nm?, [], Cs).

procedure opens_for(PartRes?, Peer?, Peer?, YesNo).
opens_for(part(pt(_, G, opener(O))), Id, F, B?) :- ground(G?) | same(O?, Id?, B1), mem(F?, G?, B2), and(B1?, B2?, B).
opens_for(part(pt(_, _, guarded_part)), _, _, no).
opens_for(nopart, _, _, no).

procedure vote_cands0(Recs?, V?, St?, Cands, St).
vote_cands0(R, V, St, Cs?, St1?) :- ground(R?) | vote_cands(R?, R?, V?, St?, [], Cs, St1).

procedure vote_cands(Recs?, Recs?, V?, St?, Cands?, Cands, St).
vote_cands([], _, _, St, Cs, Cs?, St?).
vote_cands([answered(At, Y) | Rs], R, V, St, Acc, Cs?, St2?) :- ground(At?), ground(R?), ground(V?) | pending_rec(At?, R?, P), vote_go(P?, At?, Y?, V?, St?, Acc?, Acc1, St1), vote_cands(Rs?, R?, V?, St1?, Acc1?, Cs, St2).
vote_cands([_ | Rs], R, V, St, Acc, Cs?, St1?) :- otherwise | vote_cands(Rs?, R?, V?, St?, Acc?, Cs, St1).

procedure vote_go(YesNo?, Attempt?, YesNo?, V?, St?, Cands?, Cands, St).
vote_go(no, _, _, _, St, Acc, Acc?, St?).
vote_go(yes, At, Y, V, St, Acc, Acc1?, St1?) :- ground(At?), ground(V?) | attempt_id(At?, Q), v_kn(V?, Kv), known_kn(Q?, Kv?, Kn), question_waits(At?, V?, Wt), vote_free(Y?, Wt?, Fr), and(Kn?, Fr?, B), vote_go1(B?, At?, St?, Acc?, Acc1, St1).

procedure vote_go1(YesNo?, Attempt?, St?, Cands?, Cands, St).
vote_go1(no, _, St, Acc, Acc?, St?).
vote_go1(yes, At, St, Acc, Acc1?, St1?) :- ground(At?) | attempt_class(At?, C), st_class(C?, St?, Cr, St1), vote_cand(yes, Cr?, vt(At?), Acc?, Acc1).

procedure vote_free(YesNo?, YesNo?, YesNo).
vote_free(no, _, yes).
vote_free(yes, W, F?) :- neg(W?, F).

procedure vote_cand(YesNo?, ClassRes?, WKey?, Cands?, Cands).
vote_cand(yes, cls(I), K, Acc, [cand(K?, sub(I?)) | Acc?]).
vote_cand(yes, nocls, _, Acc, Acc?).
vote_cand(no, _, _, Acc, Acc?).

procedure commit_cands_st(St?, Cands, St).
commit_cands_st(St, Cs?, St1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), st_id(St?, Id), commit_cands0(R?, Id?, St?, Cs, St1).

procedure commit_cands0(Recs?, Peer?, St?, Cands, St).
commit_cands0(R, Id, St, Cs?, St1?) :- ground(R?) | commit_cands(R?, R?, Id?, St?, [], Cs, St1).

procedure commit_cands(Recs?, Recs?, Peer?, St?, Cands?, Cands, St).
commit_cands([], _, _, St, Cs, Cs?, St?).
commit_cands([voted(At, yes) | Rs], R, Id, St, Acc, Cs?, St2?) :- ground(At?), ground(R?), ground(Id?) | attempt_id(At?, P), same(P?, Id?, Own), mem(closed(At?), R?, Cl), neg(Cl?, Open), and(Own?, Open?, Go), commit_go(Go?, At?, R?, Id?, St?, Acc?, Acc1, St1), commit_cands(Rs?, R?, Id?, St1?, Acc1?, Cs, St2).
commit_cands([_ | Rs], R, Id, St, Acc, Cs?, St1?) :- otherwise | commit_cands(Rs?, R?, Id?, St?, Acc?, Cs, St1).

procedure commit_go(YesNo?, Attempt?, Recs?, Peer?, St?, Cands?, Cands, St).
commit_go(no, _, _, _, St, Acc, Acc?, St?).
commit_go(yes, At, R, Id, St, Acc, Acc1?, St1?) :- ground(At?) | attempt_class(At?, C), st_class(C?, St?, Cr, St1), commit_cand(yes, Cr?, At?, Id?, R?, Acc?, Acc1).

procedure commit_cand(YesNo?, ClassRes?, Attempt?, Peer?, Recs?, Cands?, Cands).
commit_cand(yes, cls(I), At, Id, R, Acc, Cs?) :- ground(I?), ground(At?), ground(R?) | mem(closed(At?), R?, Cl), neg(Cl?, Open), all_yes(I?, At?, Id?, R?, All), and(Open?, All?, B), vote_cand(B?, cls(I?), cm(At?), Acc?, Cs).
commit_cand(_, _, _, _, _, Acc, Acc?) :- otherwise | true.

procedure wound_cands0(St?, Cands, St).
wound_cands0(St, Cs?, St3?) :- ground(St?) | st_pends(St?, Pd), st_view(St?, V), st_trie(St?, Tr), wound_starts(Pd?, V?, Tr?, St?, [], Cs1, St1), st_view(St?, V1), wound_cands1(Cs1?, V1?, St1?, Cs, St3).

procedure wound_cands1(Cands?, V?, St?, Cands, St).
wound_cands1(Acc, V, St, Cs?, St1?) :- ground(V?) | v_recs(V?, R), wound_questions0(R?, V?, St?, Acc?, Cs, St1).

procedure wound_starts(Pends?, V?, Trie?, St?, Cands?, Cands, St).
wound_starts([], _, _, St, Acc, Acc?, St?).
wound_starts([deferred(msg(_, cargo(_, start(A)))) | Ps], V, Tr, St, Acc, Cs?, St3?) :- ground(A?), ground(V?) | v_recs(V?, R), trie_closed(A?, R?, Tr?, Cl, Tr1), wound_open(Cl?, A?, V?, St?, Acc?, Acc1, St2), wound_starts(Ps?, V?, Tr1?, St2?, Acc1?, Cs, St3).
wound_starts([_ | Ps], V, Tr, St, Acc, Cs?, St1?) :- otherwise | wound_starts(Ps?, V?, Tr?, St?, Acc?, Cs, St1).

procedure wound_open(YesNo?, Attempt?, V?, St?, Cands?, Cands, St).
wound_open(yes, _, _, St, Acc, Acc?, St?).
wound_open(no, A, V, St, Acc, Cs?, St2?) :- ground(A?) | attempt_class(A?, C), st_class(C?, St?, Cr, St1), wound_start(Cr?, A?, V?, St1?, Acc?, Cs, St2).

procedure wound_start(ClassRes?, Attempt?, V?, St?, Cands?, Cands, St).
wound_start(nocls, _, _, St, Acc, Acc?, St?).
wound_start(cls(I), A, V, St, Acc, Cs?, St1?) :- ground(I?), ground(A?), ground(V?) | start_waits_v(I?, A?, V?, W), start_blocker(W?, I?, V?, Bk), wound_by(Bk?, A?, V?, St?, Acc?, Cs, St1).

procedure wound_questions0(Recs?, V?, St?, Cands?, Cands, St).
wound_questions0(R, V, St, Acc, Cs?, St1?) :- ground(R?) | wound_questions(R?, R?, V?, St?, Acc?, Cs, St1).

procedure wound_questions(Recs?, Recs?, V?, St?, Cands?, Cands, St).
wound_questions([], _, _, St, Acc, Acc?, St?).
wound_questions([answered(A, yes) | Rs], R, V, St, Acc, Cs?, St2?) :- ground(A?), ground(R?), ground(V?) | pending_rec(A?, R?, P), question_blocker(P?, V?, Bk), wound_by(Bk?, A?, V?, St?, Acc?, Acc1, St1), wound_questions(Rs?, R?, V?, St1?, Acc1?, Cs, St2).
wound_questions([_ | Rs], R, V, St, Acc, Cs?, St1?) :- otherwise | wound_questions(Rs?, R?, V?, St?, Acc?, Cs, St1).

procedure wound_by(Blocker?, Attempt?, V?, St?, Cands?, Cands, St).
wound_by(noblk, _, _, St, Acc, Acc?, St?).
wound_by(blk(B), A, V, St, Acc, Cs?, St1?) :- ground(B?), ground(A?), ground(V?) | prio(A?, B?, Pr), v_recs(V?, R), mem(yielded(B?), R?, Yd), neg(Yd?, NYd), and(Pr?, NYd?, Go), wound_by1(Go?, A?, B?, V?, St?, Acc?, Cs, St1).

procedure wound_by1(YesNo?, Attempt?, Attempt?, V?, St?, Cands?, Cands, St).
wound_by1(no, _, _, _, St, Acc, Acc?, St?).
wound_by1(yes, A, B, V, St, Acc, Cs?, St1?) :- ground(B?) | attempt_class(B?, C), st_class(C?, St?, Cr, St1), wound_by_c(Cr?, A?, B?, V?, Acc?, Cs).

procedure wound_by_c(ClassRes?, Attempt?, Attempt?, V?, Cands?, Cands).
wound_by_c(nocls, _, _, _, Acc, Acc?).
wound_by_c(cls(I), A, B, V, Acc, Cs?) :- ground(I?), ground(A?), ground(B?), ground(V?) | v_id(V?, Id), v_recs(V?, R), wound_rec(I?, A?, B?, Id?, R?, Ok), vote_cand(Ok?, cls(I?), wd(A?, B?), Acc?, Cs).

procedure wound_rec(Info?, Attempt?, Attempt?, Peer?, Recs?, YesNo).
wound_rec(I, A, B, Id, R, Ok?) :- ground(I?), ground(B?), ground(Id?), ground(R?) | prio(A?, B?, Pr), mem(yielded(B?), R?, Yd), neg(Yd?, NYd), attempt_id(B?, P), same(P?, Id?, Own), all_yes(I?, B?, Id?, R?, All), wound_by2(Own?, All?, Ok1), and(Pr?, NYd?, B1), and(B1?, Ok1?, Ok).

procedure wound_by2(YesNo?, YesNo?, YesNo).
wound_by2(no, _, yes).
wound_by2(yes, All, Ok?) :- neg(All?, Ok).

procedure intro_cands(St?, Cands, St).
intro_cands(St, Cs?, St1?) :- ground(St?) | st_id(St?, Id), st_ms(St?, S), st_kn(St?, Kn), st_ix(St?, Ix), intro_pend(Ix?, Id?, S?, Ix1), intro_known(Ix1?, Kn?, Cs, Ix2), set_ix(St?, Ix2?, St1).

procedure intro_pend(Ix?, Peer?, GAtoms?, Ix).
intro_pend(ix(Tr, Wl, In, ic(S0, Ns0, Pe)), Id, S, ix(Tr?, Wl?, In1?, Ic?)) :- ground(S?), ground(S0?) | same(S?, S0?, Sm), intro_pend1(Sm?, S?, Ns0?, Pe?, Id?, In?, Ic, In1).

procedure intro_pend1(YesNo?, GAtoms?, Peers?, Pairs?, Peer?, Recs?, IC, Recs).
intro_pend1(yes, S, Ns0, Pe, _, In, ic(S?, Ns0?, Pe?), In?).
intro_pend1(no, S, Ns0, Pe, Id, In, Ic?, In1?) :- ground(S?) | introduction_preds(E), named_by(E?, S?, Id?, Ns1), dedup(Ns1?, Ns2), sort_peers(Ns2?, Ns), intro_pend2(Ns?, Ns0?, Pe?, S?, In?, Ic, In1).

procedure intro_pend2(Peers?, Peers?, Pairs?, GAtoms?, Recs?, IC, Recs).
intro_pend2(Ns, Ns0, Pe, S, In, Ic?, In1?) :- ground(Ns?), ground(Ns0?) | same(Ns?, Ns0?, Sm), intro_pend3(Sm?, Ns?, Pe?, S?, In?, Ic, In1).

procedure intro_pend3(YesNo?, Peers?, Pairs?, GAtoms?, Recs?, IC, Recs).
intro_pend3(yes, Ns, Pe, S, In, ic(S?, Ns?, Pe?), In?).
intro_pend3(no, Ns, _, S, In, ic(S?, Ns?, Pe?), In?) :- ground(Ns?), ground(In?) | pairs_of(Ns?, Ps), not_introduced(Ps?, In?, Pe).

procedure not_introduced(Pairs?, Recs?, Pairs).
not_introduced([], _, []).
not_introduced([pr(Q, R) | Ps], In, Pe?) :- ground(Q?), ground(R?), ground(In?) | mem(introduced(Q?, R?), In?, D), not_introduced(Ps?, In?, Pe1), keep_pair(D?, pr(Q?, R?), Pe1?, Pe).

procedure keep_pair(YesNo?, Pair?, Pairs?, Pairs).
keep_pair(yes, _, Pe, Pe?).
keep_pair(no, P, Pe, [P? | Pe?]).

procedure intro_known(Ix?, Kn?, Cands, Ix).
intro_known(ix(Tr, Wl, In, ic(S, Ns, Pe)), Kn, Cs?, ix(Tr?, Wl?, In?, ic(S?, Ns?, Pe1?))) :- intro_keep(Pe?, Kn?, Cs, Pe1).

procedure named_by(Preds?, GAtoms?, Peer?, Peers).
named_by(_, [], _, []).
named_by(E, [g(P, [p(Q)]) | Gs], Id, Ns?) :- ground(E?), ground(Q?), ground(Id?) | mem(P?, E?, In), same(Q?, Id?, Me), neg(Me?, NMe), and(In?, NMe?, B), named_by(E?, Gs?, Id?, N1), keep_peer(B?, Q?, N1?, Ns).
named_by(E, [_ | Gs], Id, Ns?) :- otherwise | named_by(E?, Gs?, Id?, Ns).

procedure pairs_of(Peers?, Pairs).
pairs_of([], []).
pairs_of([Q | Qs], Ps?) :- ground(Q?), ground(Qs?) | pairs_with(Q?, Qs?, P1), pairs_of(Qs?, P2), app(P1?, P2?, Ps).

procedure pairs_with(Peer?, Peers?, Pairs).
pairs_with(_, [], []).
pairs_with(Q, [R | Rs], [pr(Q?, R?) | Ps?]) :- ground(Q?) | pairs_with(Q?, Rs?, Ps).

procedure intro_keep(Pairs?, Kn?, Cands, Pairs).
intro_keep([], _, [], []).
intro_keep([pr(Q, R) | Ps], Kn, Cs?, [pr(Q?, R?) | Ps1?]) :- ground(Q?), ground(R?), ground(Kn?) | known_kn(Q?, Kn?, K1), known_kn(R?, Kn?, K2), and(K1?, K2?, B), intro_keep(Ps?, Kn?, C1, Ps1), keep_icand(B?, Q?, R?, C1?, Cs).

procedure keep_icand(YesNo?, Peer?, Peer?, Cands?, Cands).
keep_icand(yes, Q, R, Cs, [cand(ip(Q?, R?), pair) | Cs?]).
keep_icand(no, _, _, Cs, Cs?).

procedure prune_waits(Waits?, Recs?, Ix?, Waits).
prune_waits([], _, _, []).
prune_waits([w(K, T) | Ws], R, Ix, Ws1?) :- ground(K?), ground(R?), ground(Ix?) | dead_key(K?, R?, Ix?, Dd), prune_waits(Ws?, R?, Ix?, Rest), prune_wait(Dd?, w(K?, T?), Rest?, Ws1).

procedure prune_wait(YesNo?, Wait?, Waits?, Waits).
prune_wait(no, X, Ws, [X? | Ws?]).
prune_wait(yes, _, Ws, Ws?).

procedure dead_key(WKey?, Recs?, Ix?, YesNo).
dead_key(op(_), _, _, no).
dead_key(vt(A), R, ix(Tr, _, _, _), D?) :- ground(A?), ground(R?) | has_vote(A?, R?, V), rec_closed(A?, R?, Tr?, Cl), or(V?, Cl?, D).
dead_key(cm(A), R, ix(Tr, _, _, _), D?) :- rec_closed(A?, R?, Tr?, D).
dead_key(wd(_, B), R, ix(Tr, _, _, _), D?) :- ground(B?), ground(R?) | rec_closed(B?, R?, Tr?, Cl), mem(yielded(B?), R?, Yd), or(Cl?, Yd?, D).
dead_key(ip(Q, R1), R, ix(_, _, In, _), D?) :- ground(Q?), ground(R1?) | mem(introduced(Q?, R1?), R?, D1), mem(introduced(Q?, R1?), In?, D2), or(D1?, D2?, D).

procedure dispatch_own(Choice?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, Recs?, St?, Stream(Ask(Question))).
dispatch_own(none, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- next(no_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
dispatch_own(take(op(_), prop(I, P, Nm)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- dispatch_propose(pgo(I?, P?, Nm?), write_own, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).
dispatch_own(take(vt(At), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?), ground(I?) | vote_effect(I?, At?, St?, Ss, Ns, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next_n(write_own, no, Ap0?, Ns?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?, D).
dispatch_own(take(cm(At), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(At?), ground(I?) | commit_effect(I?, At?, St?, Ss, Is, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), put_all(Is?, Out1, Out2?), next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out2, Ow, Approvals?, H?, St2?, D).
dispatch_own(take(wd(_, B), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- ground(B?), ground(I?) | wound_effect(I?, B?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, H?, St2?, D).
dispatch_own(take(ip(Q, R), pair), Ap0, Ls, In, Ans?, Thr?, [msg(Q?, intro(Id?, R?)), msg(R?, intro(Id?, Q?)) | Out?], Ow?, Approvals, H, St, D?) :- ground(Q?), ground(R?), ground(St?) | st_id(St?, Id), introduce_effect(Q?, R?, St?, St1), next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St1?, D).
dispatch_own(take(_, _), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, H, St, D?) :- otherwise | next(no_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, H?, St?, D).

procedure opening(St?, Infos, St).
opening(St, Is?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_state(Ap?, S), contract_schemas(Ss), reflexive_preds(Rf), opening1(Ss?, Rf?, Id?, S?, St?, Is, St1).

procedure opening1(Schemas?, Preds?, Peer?, GAtoms?, St?, Infos, St).
opening1(Ss, Rf, Id, S, St, Is?, St1?) :- ground(Id?), ground(S?) | hat(Rf?, Id?, S?, Sh), opened(Ss?, Id?, Sh?, Cs), meet_all(Cs?, St?, [], Is0, St1), dedup(Is0?, Is).

procedure opened(Schemas?, Peer?, GAtoms?, Stream(Class)).
opened([], _, _, []).
opened([schema(Nm, _, Rs) | Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | guard_roles(Rs?, 1, Gs), opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1), opened(Ss?, Id?, Sh?, C2), app(C1?, C2?, Cs).
opened([lschema(Nm, _, Rs, _) | Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | guard_roles(Rs?, 1, Gs), opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1), opened(Ss?, Id?, Sh?, C2), app(C1?, C2?, Cs).

procedure opened1(Ints?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened1([_ | _], _, _, _, _, []).
opened1([], _, [], _, _, []).
opened1([], Nm, [R | Rs], Id, Sh, Cs?) :- ground(Nm?), ground(R?), ground(Id?), ground(Sh?) | rs_req(R?, Q), match_all(Q?, Sh?, [b(role(1), p(Id?))], Bs0), schema_numeric(Nm?, N), num_extend(N?, Bs0?, Bs), opened2(Bs?, Nm?, [R? | Rs?], Id?, Sh?, Cs).

procedure num_extend(Numeric?, Bindings?, Bindings).
num_extend(numeric(C, _, _), Bs, R?) :- ground(C?) | extend_each(Bs?, C?, R).

procedure extend_each(Bindings?, Constraint?, Bindings).
extend_each([], _, []).
extend_each([B | Bs], C, R?) :- ground(C?) | con_extend(C?, B?, R1), extend_each(Bs?, C?, R2), app(R1?, R2?, R).

procedure opened2(Bindings?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened2([], _, _, _, _, []).
opened2([B | Bs], Nm, Rs, Id, Sh, Cs?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | first_spec(Rs?, R1), cand_ok([R1?], B?, Sh?, Ok1), con_at(Nm?, B?, Id?, Con), con_holds(Con?, B?, Ok2), nums_bound(Nm?, B?, Ok3), and(Ok1?, Ok2?, Ok12), and(Ok12?, Ok3?, Ok), opened3(Ok?, Nm?, B?, Id?, Sh?, C1), opened2(Bs?, Nm?, Rs?, Id?, Sh?, C2), app(C1?, C2?, Cs).

procedure opened3(YesNo?, Constant?, Binding?, Peer?, GAtoms?, Stream(Class)).
opened3(no, _, _, _, _, []).
opened3(yes, Nm, B, Id, Sh, [C?]) :- ground(Nm?), ground(B?) | listed_people(Nm?, B?, Sh?, Ls), listed_binding(Nm?, B?, Ls?, B1), class_of(Nm?, B1?, Id?, C).

procedure first_spec(RoleSpecs?, RoleSpec).
first_spec([R | _], R?).
first_spec([], rs(unguarded, [], [], [], [])).

procedure meet_all(Stream(Class)?, St?, Infos?, Infos, St).
meet_all([], St, Is, Is?, St?).
meet_all([C | Cs], St, Is, Is2?, St2?) :- ground(C?) | st_class(C?, St?, R, St1), add_cls(R?, Is?, Is1), meet_all(Cs?, St1?, Is1?, Is2, St2).

procedure add_cls(ClassRes?, Infos?, Infos).
add_cls(nocls, Is, Is?).
add_cls(cls(I), Is, Is1?) :- app(Is?, [I?], Is1).

procedure choose(Cands?, Waits?, Integer?, Choice, Waits).
choose(Cs, W, D, Ch?, W2?) :- ground(Cs?), ground(W?), integer(D?) | ensure_waits(Cs?, W?, D?, W1), choose1(Cs?, W1?, D?, Ch, W2).

procedure choose1(Cands?, Waits?, Integer?, Choice, Waits).
choose1(Cs, W1, D, Ch?, W2?) :- ground(W1?), integer(D?) | pick(Cs?, W1?, Ch, Ky), D1 := (D? + 1), retake(Ky?, W1?, D1?, W2).

procedure ensure_waits(Cands?, Waits?, Integer?, Waits).
ensure_waits([], W, _, W?).
ensure_waits([cand(K, _) | Cs], W, D, W2?) :- ground(K?), ground(W?), integer(D?) | wait_of(K?, W?, F), ensure1(F?, K?, W?, D?, W1), ensure_waits(Cs?, W1?, D?, W2).

procedure ensure1(WFound?, WKey?, Waits?, Integer?, Waits).
ensure1(at(_), _, W, _, W?).
ensure1(unseen, K, W, D, [w(K?, D?) | W?]).

procedure wait_of(WKey?, Waits?, WFound).
wait_of(_, [], unseen).
wait_of(K, [w(K1, T) | _], at(T?)) :- (K? =?= K1?) | true.
wait_of(K, [_ | Ws], F?) :- otherwise | wait_of(K?, Ws?, F).

procedure pick(Cands?, Waits?, Choice, PKey).
pick([], _, none, nokey).
pick([cand(K, I) | Cs], W, Ch?, Ky?) :- ground(K?), ground(W?) | began_at(K?, W?, T), best(Cs?, W?, T?, K?, I?, Ch, Ky).

procedure best(Cands?, Waits?, Integer?, WKey?, Subj?, Choice, PKey).
best([], _, _, K, I, take(K?, I?), key(K?)) :- ground(K?) | true.
best([cand(K2, I2) | Cs], W, T, K, I, Ch?, Ky?) :- ground(K2?), ground(W?) | began_at(K2?, W?, T2), best1(T2?, T?, K2?, I2?, K?, I?, Cs?, W?, Ch, Ky).

procedure best1(Integer?, Integer?, WKey?, Subj?, WKey?, Subj?, Cands?, Waits?, Choice, PKey).
best1(T2, T, K2, I2, _, _, Cs, W, Ch?, Ky?) :- (T2? < T?) | best(Cs?, W?, T2?, K2?, I2?, Ch, Ky).
best1(T2, T, _, _, K, I, Cs, W, Ch?, Ky?) :- (T2? >= T?) | best(Cs?, W?, T?, K?, I?, Ch, Ky).

procedure began_at(WKey?, Waits?, Integer).
began_at(K, W, T?) :- wait_of(K?, W?, F), began_of(F?, T).

procedure began_of(WFound?, Integer).
began_of(at(T), T?).
began_of(unseen, 0).

procedure retake(PKey?, Waits?, Integer?, Waits).
retake(nokey, W, _, W?).
retake(key(K), W, D, W1?) :- set_wait(K?, D?, W?, W1).

procedure set_wait(WKey?, Integer?, Waits?, Waits).
set_wait(K, D, [], [w(K?, D?)]).
set_wait(K, D, [w(K1, _) | Ws], [w(K1?, D?) | Ws?]) :- (K? =?= K1?) | true.
set_wait(K, D, [X | Ws], [X? | Ws1?]) :- otherwise | set_wait(K?, D?, Ws?, Ws1).

procedure propose_effect(Info?, Class?, Names?, St?, Sends, Outputs, St).
propose_effect(I, P, Nm, St, Ss?, Ns?, St1?) :- ground(I?), ground(P?), ground(Nm?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_count(Ap?, K), K1 := (K? + 1), st_ix(St?, Ix), rank_of(I?, P?, Ix?, K1?, Pi, Ix1), set_ix(St?, Ix1?, St0), st_ms(St?, S), part_dom(P?, Id?, S?, Dm), propose_app(Dm?, I?, attempt(Id?, K1?, Pi?, P?, Nm?), St0?, Ss, Ns, St1).

procedure rank_of(Info?, Class?, Ix?, Integer?, Integer, Ix).
rank_of(I, P, ix(Tr, Wl, In, Ic), K1, Pi?, ix(Tr?, Wl1?, In?, Ic?)) :- integer(K1?) | wl_take(Wl?, I?, P?, Wl1, L), rank_of1(L?, K1?, Pi).

procedure rank_of1(Last?, Integer?, Integer).
rank_of1(nolast, K1, K1?).
rank_of1(last(A), _, P?) :- attempt_rank(A?, P).

procedure wl_take(Attempts?, Info?, Class?, Attempts, Last).
wl_take([], _, _, [], nolast).
wl_take([A | As], I, P, As1?, L?) :- ground(A?), ground(I?), ground(P?) | attempt_class(A?, C), term_part(C?, I?, P?, Pt), wl_take1(Pt?, A?, As?, I?, P?, As1, L).

procedure wl_take1(YesNo?, Attempt?, Attempts?, Info?, Class?, Attempts, Last).
wl_take1(yes, A, As, _, _, As?, last(A?)).
wl_take1(no, A, As, I, P, [A? | As1?], L?) :- wl_take(As?, I?, P?, As1, L).

procedure propose_app(YesNo?, Info?, Attempt?, St?, Sends, Outputs, St).
propose_app(yes, I, At, St, Ss?, [], St1?) :- ground(I?), ground(At?), ground(St?) | st_id(St?, Id), info_q(I?, Q), only_me(Q?, Id?, One), st_app(St?, Ap), propose_go(One?, I?, At?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).
propose_app(no, I, At, St, Ss?, Ns?, St1?) :- ground(At?), ground(St?) | st_id(St?, Id), st_ms(St?, S), attempt_class(At?, P), unable_reason(P?, Id?, S?, D), refuse_at_once(I?, At?, D?, St?, Ss, Ns, St1).

procedure propose_go(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
propose_go(yes, I, At, Id, app(S, _, L, R), [], app(S1?, K?, L?, R2?)) :- ground(I?), ground(At?), ground(R?) | attempt_k(At?, K), attempt_class(At?, P), apply_part(P?, Id?, S?, S1), end_approvals(I?, Id?, [closed(At?), voted(At?, yes) | R?], R2, _).
propose_go(no, I, At, Id, app(S, _, _, R), Ss?, app(S?, K?, held(At?), [voted(At?, yes) | R?])) :- ground(At?), ground(I?) | attempt_k(At?, K), info_q(I?, Q), tell(Q?, Id?, start(At?), Ss).

procedure refuse_at_once(Info?, Attempt?, Reason?, St?, Sends, Outputs, St).
refuse_at_once(I, At, D, St, Ss?, Ns?, St2?) :- ground(I?), ground(At?), ground(D?), ground(St?) | st_id(St?, Id), info_q(I?, Q), tell(Q?, Id?, outcome(At?, abort(Id?, D?)), Ss), st_app(St?, Ap), attempt_names(At?, Nm1), refuse_app(Nm1?, I?, At?, Id?, Ap?, En, Ap1), attempt_class(At?, P), ended_notice(En?, P?, Id?, D?, Ns), set_app(St?, Ap1?, St1), st_held(St?, Hd), attempt_names(At?, Nm2), drop_named(Nm2?, Hd?, Hd1), set_held(St1?, Hd1?, St2).

procedure refuse_app(Names?, Info?, Attempt?, Peer?, App?, YesNo, App).
refuse_app(request(_, _), _, At, _, app(S, _, _, R), no, app(S?, K1?, unlocked, [closed(At?), voted(At?, no) | R?])) :- ground(At?) | attempt_k(At?, K1).
refuse_app(none, I, At, Id, app(S, _, _, R), En?, app(S?, K1?, unlocked, R1?)) :- ground(At?) | attempt_k(At?, K1), end_approvals(I?, Id?, [closed(At?), voted(At?, no) | R?], R1, En).

procedure only_me(Peers?, Peer?, YesNo).
only_me([P], Id, yes) :- (P? =?= Id?) | true.
only_me(_, _, no) :- otherwise | true.

procedure tell(Peers?, Peer?, Cargo?, Sends).
tell([], _, _, []).
tell([Q | Qs], Id, X, Ss?) :- ground(Q?), ground(Id?), ground(X?) | same(Q?, Id?, Me), tell1(Me?, Q?, X?, Ss1?, Ss), tell(Qs?, Id?, X?, Ss1).

procedure tell1(YesNo?, Peer?, Cargo?, Sends?, Sends).
tell1(yes, _, _, Ss, Ss?).
tell1(no, Q, X, Ss, [to(Q?, X?) | Ss?]).

procedure vote_yes_app(Attempt?, App?, Sends, App).
vote_yes_app(At, app(S, K, _, R), [to(I?, vote(At?, yes))], app(S?, K?, held(At?), [voted(At?, yes) | R?])) :- ground(At?) | attempt_id(At?, I).

procedure vote_no(Info?, Attempt?, Peer?, Reason?, App?, Sends, Outputs, App).
vote_no(I, At, Id, D, app(S, K, L, R), [to(P?, vote(At?, no(D?)))], Ns?, app(S?, K?, L?, R2?)) :- ground(At?), ground(D?), ground(R?) | attempt_id(At?, P), attempt_class(At?, C), guards_part(C?, Id?, Gd), guard_ends(Gd?, I?, Id?, [voted(At?, no) | R?], R2, En), attempt_class(At?, C2), ended_notice(En?, C2?, Id?, D?, Ns).

procedure guard_ends(YesNo?, Info?, Peer?, Recs?, Recs, YesNo).
guard_ends(no, _, _, R, R?, no).
guard_ends(yes, I, Id, R, R1?, En?) :- end_approvals(I?, Id?, R?, R1, En).

procedure guards_part(Class?, Peer?, YesNo).
guards_part(C, Id, B?) :- ground(C?) | binding_of(C?, Nm, Bn), marked_people(Nm?, Bn?, G), mem(Id?, G?, B).

procedure start_effect(Info?, Attempt?, St?, Sends, ApprovalRes, Outputs, St).
start_effect(I, At, St, Ss?, Cr?, Ns?, St1?) :- ground(At?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), st_closed(At?, St?, Cl), st_req(At?, St?, Mi, En), start_app(I?, At?, Id?, Cl?, Mi?, En?, Ap?, Ss, Cr, Ns, Ap1), set_app(St?, Ap1?, St1).

procedure start_app(Info?, Attempt?, Peer?, YesNo?, YesNo?, YesNo?, App?, Sends, ApprovalRes, Outputs, App).
start_app(I, At, Id, Cl, Mi, En, app(S, K, L, R), Ss?, Cr?, Ns?, Ap1?) :- ground(At?), integer(K?) | attempt_k(At?, KA), max_int(K?, KA?, K1), start_app1(Cl?, I?, At?, Id?, Mi?, En?, app(S?, K1?, L?, R?), Ss, Cr, Ns, Ap1).

procedure max_int(Integer?, Integer?, Integer).
max_int(A, B, A?) :- (A? >= B?) | true.
max_int(A, B, B?) :- (A? < B?) | true.

procedure start_app1(YesNo?, Info?, Attempt?, Peer?, YesNo?, YesNo?, App?, Sends, ApprovalRes, Outputs, App).
start_app1(yes, _, _, _, _, _, Ap, [], noapproval, [], Ap?).
start_app1(no, I, At, Id, Mi, En, Ap, Ss?, Cr?, Ns?, Ap1?) :- ground(At?), ground(Ap?) | app_state(Ap?, S), attempt_class(At?, C), part_dom(C?, Id?, S?, Rd), start_app2(Rd?, I?, At?, Id?, Mi?, En?, Ap?, Ss, Cr, Ns, Ap1).

procedure start_app2(YesNo?, Info?, Attempt?, Peer?, YesNo?, YesNo?, App?, Sends, ApprovalRes, Outputs, App).
start_app2(no, I, At, Id, _, _, Ap, Ss?, noapproval, Ns?, Ap1?) :- ground(At?), ground(Ap?) | app_state(Ap?, S), attempt_class(At?, C), unable_reason(C?, Id?, S?, D), vote_no(I?, At?, Id?, D?, Ap?, Ss, Ns, Ap1).
start_app2(yes, I, At, Id, Mi, En, Ap, Ss?, Cr?, Ns?, Ap1?) :- ground(At?) | names_mine(At?, Mi?, Mn), start_app3(Mn?, En?, I?, At?, Id?, Ap?, Ss, Cr, Ns, Ap1).

procedure start_app3(Mine?, YesNo?, Info?, Attempt?, Peer?, App?, Sends, ApprovalRes, Outputs, App).
start_app3(mine(_, _), En, I, At, Id, Ap, Ss?, noapproval, Ns?, Ap1?) :- start_named(En?, I?, At?, Id?, Ap?, Ss, Ns, Ap1).
start_app3(notmine, _, I, At, Id, Ap, Ss?, Cr?, Ns?, Ap1?) :- ground(I?), ground(At?), ground(Ap?) | asked_by(At?, Id?, Ak), app_recs(Ap?, R), approval_of(I?, Id?, R?, Apv), start_asked(Ak?, Apv?, At?, Ap?, Ss, Cr, Ns, Ap1).

procedure start_named(YesNo?, Info?, Attempt?, Peer?, App?, Sends, Outputs, App).
start_named(no, _, At, _, Ap, Ss?, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).
start_named(yes, I, At, Id, Ap, Ss?, Ns?, Ap1?) :- vote_no(I?, At?, Id?, unable([], []), Ap?, Ss, Ns, Ap1).

procedure start_asked(YesNo?, YesNo?, Attempt?, App?, Sends, ApprovalRes, Outputs, App).
start_asked(yes, no, At, app(S, K, L, R), [], approval_for(At?), [], app(S?, K?, L?, [asked(At?) | R?])) :- ground(At?) | true.
start_asked(yes, yes, At, Ap, Ss?, noapproval, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).
start_asked(no, _, At, Ap, Ss?, noapproval, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).

procedure names_mine(Attempt?, YesNo?, Mine).
names_mine(attempt(_, _, _, _, none), _, notmine).
names_mine(attempt(_, _, _, _, request(Rr, K)), B, Mn?) :- mine_of(B?, Rr?, K?, Mn).

procedure mine_of(YesNo?, Rho?, Integer?, Mine).
mine_of(yes, Rr, K, mine(Rr?, K?)).
mine_of(no, _, _, notmine).

procedure asked_by(Attempt?, Peer?, YesNo).
asked_by(At, Id, B?) :- ground(At?), ground(Id?) | attempt_id(At?, P), attempt_class(At?, C), binding_of(C?, Nm, Bn), marked_people(Nm?, Bn?, G), mem(Id?, G?, In), same(Id?, P?, Me), neg(Me?, NotMe), and(In?, NotMe?, B).

procedure answer_effect(YesNo?, Attempt?, St?, St).
answer_effect(YN, At, St, St1?) :- ground(St?) | st_app(St?, Ap), answer_app(YN?, At?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure answer_app(YesNo?, Attempt?, App?, App).
answer_app(YN, At, app(S, K, L, R), app(S?, K?, L?, [answered(At?, YN?) | R?])).

procedure vote_effect(Info?, Attempt?, St?, Sends, Outputs, St).
vote_effect(I, At, St, Ss?, Ns?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), vote_app0(I?, At?, Id?, Ap?, Ss, Ns, Ap1), set_app(St?, Ap1?, St1).

procedure vote_app0(Info?, Attempt?, Peer?, App?, Sends, Outputs, App).
vote_app0(I, At, Id, Ap, Ss?, Ns?, Ap1?) :- ground(At?), ground(Ap?) | app_recs(Ap?, R), answer_of(At?, R?, YN), app_state(Ap?, S), attempt_class(At?, C), part_dom(C?, Id?, S?, Dm), vote_on(YN?, Dm?, I?, At?, Id?, Ap?, Ss, Ns, Ap1).

procedure vote_on(YesNo?, YesNo?, Info?, Attempt?, Peer?, App?, Sends, Outputs, App).
vote_on(yes, yes, _, At, _, Ap, Ss?, [], Ap1?) :- vote_yes_app(At?, Ap?, Ss, Ap1).
vote_on(yes, no, I, At, Id, Ap, Ss?, Ns?, Ap1?) :- ground(At?), ground(Ap?) | app_state(Ap?, S), attempt_class(At?, C), unable_reason(C?, Id?, S?, D), vote_no(I?, At?, Id?, D?, Ap?, Ss, Ns, Ap1).
vote_on(no, _, I, At, Id, Ap, Ss?, Ns?, Ap1?) :- vote_no(I?, At?, Id?, declined, Ap?, Ss, Ns, Ap1).

procedure tally_effect(Info?, Attempt?, Peer?, Vote?, St?, Sends, Outputs, St).
tally_effect(I, At, F, V, St, Ss?, Ns?, St1?) :- ground(At?), ground(St?) | st_closed(At?, St?, Cl), tally1(Cl?, I?, At?, F?, V?, St?, Ss, Ns, St1).

procedure tally1(YesNo?, Info?, Attempt?, Peer?, Vote?, St?, Sends, Outputs, St).
tally1(yes, _, _, _, _, St, [], [], St?).
tally1(no, _, At, F, yes, St, [], [], St1?) :- ground(St?) | st_app(St?, Ap), add_rec(got(At?, F?, yes), Ap?, Ap1), set_app(St?, Ap1?, St1).
tally1(no, I, At, F, no(D), St, Ss?, Ns?, St3?) :- ground(I?), ground(At?), ground(D?), ground(St?) | st_id(St?, Id), info_q(I?, Q), tell(Q?, Id?, outcome(At?, abort(F?, D?)), Ss), st_app(St?, Ap), app_recs(Ap?, R), attempt_class(At?, C), guards_part(C?, Id?, Gd), guard_ends(Gd?, I?, Id?, [closed(At?), got(At?, F?, no) | R?], R1, En), attempt_class(At?, C2), ended_notice(En?, C2?, F?, D?, Ns), st_app(St?, Ap2), unlock_recs(Ap2?, R1?, Ap3), set_app(St?, Ap3?, St2), st_held(St?, Hd), attempt_names(At?, Nm), drop_named(Nm?, Hd?, Hd1), set_held(St2?, Hd1?, St3).

procedure add_rec(Rec?, App?, App).
add_rec(X, app(S, K, L, R), app(S?, K?, L?, [X? | R?])).

procedure unlock_recs(App?, Recs?, App).
unlock_recs(app(S, K, _, _), R, app(S?, K?, unlocked, R?)).

procedure commit_effect(Info?, Attempt?, St?, Sends, Nets, St).
commit_effect(I, At, St, Ss?, Ms?, St2?) :- ground(I?), ground(At?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), commit_app(I?, At?, Id?, Ap?, Ss, Ap1), commit_pairs(I?, Id?, Ps1), attempt_class(At?, P), iota_known(P?, Id?, St?, Ps2), app(Ps1?, Ps2?, Ps0), dedup(Ps0?, Ps), st_ix(St?, Ix), ix_intros(Ix?, In), commit_intros(Ps?, Id?, In?, Ap1?, Ms, Ap2), set_app(St?, Ap2?, St1), st_held(St?, Hd), drop_held_class(Hd?, I?, Id?, Hd1), set_held(St1?, Hd1?, St2).

procedure commit_pairs(Info?, Peer?, Pairs).
commit_pairs(I, Id, Ps?) :- ground(I?) | info_q(I?, Q), remove_all(Id?, Q?, Q1), dedup(Q1?, Q2), sort_peers(Q2?, Q3), pairs_of(Q3?, Ps).

procedure commit_intros(Pairs?, Peer?, Recs?, App?, Nets, App).
commit_intros([], _, _, Ap, [], Ap?).
commit_intros([pr(Q, R) | Ps], Id, In, Ap, Ms?, Ap2?) :- ground(Q?), ground(R?), ground(In?), ground(Ap?) | app_recs(Ap?, Rc), mem(introduced(Q?, R?), Rc?, D1), mem(introduced(Q?, R?), In?, D2), or(D1?, D2?, Done), commit_intro(Done?, Q?, R?, Id?, Ap?, Ms, Ms1?, Ap1), commit_intros(Ps?, Id?, In?, Ap1?, Ms1, Ap2).

procedure commit_intro(YesNo?, Peer?, Peer?, Peer?, App?, Nets, Nets?, App).
commit_intro(yes, _, _, _, Ap, Ms?, Ms, Ap?).
commit_intro(no, Q, R, Id, Ap, [msg(Q?, intro(Id?, R?)), msg(R?, intro(Id?, Q?)) | Ms?], Ms, Ap1?) :- ground(Q?), ground(R?), ground(Id?) | introduce_app(Q?, R?, Ap?, Ap1).

procedure iota_known(Class?, Peer?, St?, Pairs).
iota_known(P, Id, St, Ps?) :- ground(St?) | iota_pairs(P?, Id?, Ps0), known_pairs(Ps0?, St?, Ps).

procedure known_pairs(Pairs?, St?, Pairs).
known_pairs([], _, []).
known_pairs([pr(Q, R) | Ps], St, Ks?) :- ground(Q?), ground(R?), ground(St?) | known_st(Q?, St?, K1), known_st(R?, St?, K2), and(K1?, K2?, K), known_pairs(Ps?, St?, Ks1), keep_known_pair(K?, pr(Q?, R?), Ks1?, Ks).

procedure keep_known_pair(YesNo?, Pair?, Pairs?, Pairs).
keep_known_pair(yes, P, Ps, [P? | Ps?]).
keep_known_pair(no, _, Ps, Ps?).

procedure iota_pairs(Class?, Peer?, Pairs).
iota_pairs(P, Id, Ps?) :- ground(P?), ground(Id?) | term_spec(P?, _, Rs, Bn), iota_rs(Rs?, Bn?, Id?, Ps0), dedup(Ps0?, Ps).

procedure iota_rs(RoleSpecs?, Binding?, Peer?, Pairs).
iota_rs(Rs, Bn, Id, Ps?) :- ground(Rs?), ground(Bn?) | rs_len(Rs?, K), iota_from(1, K?, Rs?, Bn?, Id?, Ps).

procedure iota_from(Integer?, Integer?, RoleSpecs?, Binding?, Peer?, Pairs).
iota_from(I, K, _, _, _, []) :- (I? > K?) | true.
iota_from(I, K, Rs, Bn, Id, Ps?) :- (I? =< K?), ground(Rs?), ground(Bn?), ground(Id?) | role_person(I?, Bn?, P), same(P?, Id?, Mine), iota_role(Mine?, I?, K?, Rs?, Bn?, Id?, Ps1), I1 := (I? + 1), iota_from(I1?, K?, Rs?, Bn?, Id?, Ps2), app(Ps1?, Ps2?, Ps).

procedure iota_role(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, Peer?, Pairs).
iota_role(no, _, _, _, _, _, []).
iota_role(yes, I, K, Rs, Bn, Id, Ps?) :- integer(I?), ground(Rs?), ground(Bn?) | nth_spec(Rs?, I?, R), rs_req(R?, Q), atoms_vars(Q?, Vs), var_agents(Vs?, Bn?, Cs), iota_gainers(1, K?, I?, Rs?, Bn?, Id?, Cs?, Ps).

procedure var_agents(Vars?, Binding?, Peers).
var_agents([], _, []).
var_agents([pvar(X) | Vs], B, [C? | Cs?]) :- ground(B?) | val_peer(pvar(X?), B?, unbound, C), var_agents(Vs?, B?, Cs).
var_agents([_ | Vs], B, Cs?) :- otherwise | var_agents(Vs?, B?, Cs).

procedure iota_gainers(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, Peer?, Peers?, Pairs).
iota_gainers(J, K, _, _, _, _, _, []) :- (J? > K?) | true.
iota_gainers(J, K, I, Rs, Bn, Id, Cs, Ps?) :- (J? =< K?), integer(I?), ground(Rs?), ground(Bn?), ground(Id?), ground(Cs?) | same_int(J?, I?, Self), iota_gainer(Self?, J?, Rs?, Bn?, Id?, Cs?, Ps1), J1 := (J? + 1), iota_gainers(J1?, K?, I?, Rs?, Bn?, Id?, Cs?, Ps2), app(Ps1?, Ps2?, Ps).

procedure iota_gainer(YesNo?, Integer?, RoleSpecs?, Binding?, Peer?, Peers?, Pairs).
iota_gainer(yes, _, _, _, _, _, []).
iota_gainer(no, J, Rs, Bn, Id, Cs, Ps?) :- integer(J?), ground(Rs?), ground(Bn?) | role_person(J?, Bn?, Q), nth_spec(Rs?, J?, R), rs_add(R?, A), img_atoms(A?, Bn?, G), iota_named(Cs?, G?, Q?, Id?, Ps).

procedure iota_named(Peers?, GAtoms?, Peer?, Peer?, Pairs).
iota_named([], _, _, _, []).
iota_named([C | Cs], G, Q, Id, Ps?) :- ground(G?), ground(C?), ground(Q?), ground(Id?) | names_peer(G?, C?, N), same(Q?, C?, E1), same(Q?, Id?, E2), same(C?, Id?, E3), or(E1?, E2?, E12), or(E12?, E3?, E), neg(E?, NE), and(N?, NE?, B), iota_named(Cs?, G?, Q?, Id?, Ps1), keep_ipair(B?, Q?, C?, Ps1?, Ps).

procedure keep_ipair(YesNo?, Peer?, Peer?, Pairs?, Pairs).
keep_ipair(no, _, _, Ps, Ps?).
keep_ipair(yes, Q, C, Ps, [Pr? | Ps?]) :- ordered_pair(Q?, C?, Pr).

procedure ordered_pair(Peer?, Peer?, Pair).
ordered_pair(Q, C, pr(Q?, C?)) :- '@<'(Q?, C?) | true.
ordered_pair(Q, C, pr(C?, Q?)) :- otherwise | true.

procedure names_peer(GAtoms?, Peer?, YesNo).
names_peer([], _, no).
names_peer([g(_, Vs) | Gs], C, B?) :- ground(Vs?), ground(C?) | vals_name(Vs?, C?, B1), names_peer1(B1?, Gs?, C?, B).

procedure names_peer1(YesNo?, GAtoms?, Peer?, YesNo).
names_peer1(yes, _, _, yes).
names_peer1(no, Gs, C, B?) :- names_peer(Gs?, C?, B).

procedure vals_name(Vals?, Peer?, YesNo).
vals_name([], _, no).
vals_name([X | Xs], C, B?) :- ground(X?), ground(C?) | val_names(X?, C?, B1), vals_name1(B1?, Xs?, C?, B).

procedure vals_name1(YesNo?, Vals?, Peer?, YesNo).
vals_name1(yes, _, _, yes).
vals_name1(no, Xs, C, B?) :- vals_name(Xs?, C?, B).

procedure val_names(Val?, Peer?, YesNo).
val_names(p(Q), C, B?) :- same(Q?, C?, B).
val_names(s(speech(_, Q)), C, B?) :- same(Q?, C?, B).
val_names(c(N), C, B?) :- cname_base(N?, Q), same(Q?, C?, B).
val_names(n(_), _, no).
val_names(lv(_, _), _, no).

procedure cname_base(CName?, Peer).
cname_base(community(Q), Q?).
cname_base(dot(N, _), Q?) :- cname_base(N?, Q).

procedure commit_app(Info?, Attempt?, Peer?, App?, Sends, App).
commit_app(I, At, Id, app(S, K, _, R), Ss?, app(S1?, K?, unlocked, R1?)) :- ground(I?), ground(At?), ground(Id?) | attempt_class(At?, P), apply_part(P?, Id?, S?, S1), info_q(I?, Q), tell(Q?, Id?, outcome(At?, commit), Ss), end_approvals(I?, Id?, [closed(At?) | R?], R1, _).

procedure yield_effect(Info?, Attempt?, St?, Sends, St).
yield_effect(I, At, St, Ss?, St1?) :- ground(I?), ground(At?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), st_closed(At?, St?, Cl), yield_app(I?, At?, Id?, Cl?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure yield_app(Info?, Attempt?, Peer?, YesNo?, App?, Sends, App).
yield_app(I, At, Id, Cl, Ap, Ss?, Ap1?) :- ground(I?), ground(At?), ground(Id?), ground(Ap?) | app_recs(Ap?, R), closed_or_all(I?, At?, Id?, Cl?, R?, Done), yield_app1(Done?, I?, At?, Id?, Ap?, Ss, Ap1).

procedure closed_or_all(Info?, Attempt?, Peer?, YesNo?, Recs?, YesNo).
closed_or_all(I, At, Id, Cl, R, Done?) :- all_yes(I?, At?, Id?, R?, All), or(Cl?, All?, Done).

procedure yield_app1(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
yield_app1(yes, _, _, _, Ap, [], Ap?).
yield_app1(no, I, At, Id, Ap, Ss?, Ap1?) :- abort_own(I?, At?, Id?, Ap?, Ss, Ap1).

procedure abort_own(Info?, Attempt?, Peer?, App?, Sends, App).
abort_own(I, At, Id, app(S, K, _, R), Ss?, app(S?, K?, unlocked, [wounded(At?), closed(At?) | R?])) :- ground(I?), ground(At?), ground(Id?) | info_q(I?, Q), tell(Q?, Id?, outcome(At?, yield), Ss).

procedure wound_effect(Info?, Attempt?, St?, Sends, St).
wound_effect(I, B, St, Ss?, St1?) :- ground(I?), ground(B?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), attempt_id(B?, P), same(P?, Id?, Own), wound_app(Own?, I?, B?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure wound_app(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
wound_app(yes, I, B, Id, Ap, Ss?, Ap1?) :- abort_own(I?, B?, Id?, Ap?, Ss, Ap1).
wound_app(no, _, B, _, app(S, K, L, R), [to(J?, yield(B?))], app(S?, K?, L?, [yielded(B?) | R?])) :- ground(B?) | attempt_id(B?, J).

procedure introduce_effect(Peer?, Peer?, St?, St).
introduce_effect(Q, R, St, St1?) :- ground(St?) | st_app(St?, Ap), introduce_app(Q?, R?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure introduce_app(Peer?, Peer?, App?, App).
introduce_app(Q, R, app(S, K, L, Rc), app(S?, K?, L?, [introduced(Q?, R?) | Rc?])).

procedure all_yes(Info?, Attempt?, Peer?, Recs?, YesNo).
all_yes(I, At, Id, R, B?) :- ground(At?), ground(Id?), ground(R?) | info_q(I?, Q), all_yes1(Q?, At?, Id?, R?, B).

procedure all_yes1(Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes1([], _, _, _, yes).
all_yes1([P | Ps], At, Id, R, B?) :- ground(P?), ground(At?), ground(Id?), ground(R?) | same(P?, Id?, Me), mem(got(At?, P?, yes), R?, G), or(Me?, G?, Ok), all_yes2(Ok?, Ps?, At?, Id?, R?, B).

procedure all_yes2(YesNo?, Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes2(no, _, _, _, _, no).
all_yes2(yes, Ps, At, Id, R, B?) :- all_yes1(Ps?, At?, Id?, R?, B).

procedure outcome_effect(Info?, Attempt?, Decision?, St?, Outputs, Nets, St).
outcome_effect(I, At, Z, St, Ns?, Ms?, St2?) :- ground(I?), ground(At?), ground(Z?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), st_req(At?, St?, Mi, En), outcome_app(I?, At?, Z?, Id?, Mi?, En?, Ap?, Ns, Ap1), outcome_intros(Z?, At?, Id?, St?, Ap1?, Ms, Ap2), set_app(St?, Ap2?, St1), st_held(St?, Hd), outcome_held(Z?, I?, Id?, Hd?, Hd1), set_held(St1?, Hd1?, St2).

procedure outcome_intros(Decision?, Attempt?, Peer?, St?, App?, Nets, App).
outcome_intros(commit, At, Id, St, Ap, Ms?, Ap1?) :- ground(At?), ground(St?) | attempt_class(At?, P), iota_known(P?, Id?, St?, Ps), st_ix(St?, Ix), ix_intros(Ix?, In), commit_intros(Ps?, Id?, In?, Ap?, Ms, Ap1).
outcome_intros(abort(_, _), _, _, _, Ap, [], Ap?).
outcome_intros(yield, _, _, _, Ap, [], Ap?).

procedure outcome_app(Info?, Attempt?, Decision?, Peer?, YesNo?, YesNo?, App?, Outputs, App).
outcome_app(I, At, commit, Id, _, _, app(S, K, L, R), [], app(S1?, K?, L1?, R1?)) :- ground(I?), ground(At?) | attempt_class(At?, P), apply_part(P?, Id?, S?, S1), release(L?, At?, L1), end_approvals(I?, Id?, [closed(At?) | R?], R1, _).
outcome_app(I, At, abort(Q, D), Id, Mi, Ed, app(S, K, L, R), Ns?, app(S?, K?, L1?, R1?)) :- ground(At?), ground(D?) | release(L?, At?, L1), attempt_names(At?, Nm), abort_ends(Nm?, Mi?, Ed?, I?, At?, Id?, [closed(At?) | R?], R1, En), attempt_class(At?, C), ended_notice(En?, C?, Q?, D?, Ns).
outcome_app(_, At, yield, _, _, _, app(S, K, L, R), [], app(S?, K?, L1?, [closed(At?) | R?])) :- ground(At?) | release(L?, At?, L1).

procedure outcome_held(Decision?, Info?, Peer?, Helds?, Helds).
outcome_held(commit, I, Id, Hd, Hd1?) :- drop_held_class(Hd?, I?, Id?, Hd1).
outcome_held(abort(_, _), _, _, Hd, Hd?).
outcome_held(yield, _, _, Hd, Hd?).

procedure abort_ends(Names?, YesNo?, YesNo?, Info?, Attempt?, Peer?, Recs?, Recs, YesNo).
abort_ends(request(Rr, K), Mi, Ed, _, _, _, R, R1?, En?) :- end_request(Rr?, K?, Mi?, Ed?, R?, R1, En).
abort_ends(none, _, _, I, At, Id, R, R1?, En?) :- ground(At?), ground(R?) | attempt_class(At?, C), guards_part(C?, Id?, Gd), mem(voted(At?, yes), R?, Vy), mem(answered(At?, yes), R?, Ay), or(Vy?, Ay?, Said), and(Gd?, Said?, B), guard_ends(B?, I?, Id?, R?, R1, En).

procedure end_request(Rho?, Integer?, YesNo?, YesNo?, Recs?, Recs, YesNo).
end_request(Rr, K, Mine, Done, R, R1?, En?) :- neg(Done?, Open), and(Mine?, Open?, B), end_request1(B?, Rr?, K?, R?, R1, En).

procedure end_request1(YesNo?, Rho?, Integer?, Recs?, Recs, YesNo).
end_request1(yes, Rr, K, R, [ended(Rr?, K?) | R?], yes).
end_request1(no, _, _, R, R?, no).

procedure end_approvals(Info?, Peer?, Recs?, Recs, YesNo).
end_approvals(I, Id, R, R1?, En?) :- ground(R?) | pending_approvals(R?, I?, Id?, R?, Es), end_all(Es?, R?, R1, En).

procedure approval_of(Info?, Peer?, Recs?, YesNo).
approval_of(I, Id, R, B?) :- ground(R?) | pending_approvals(R?, I?, Id?, R?, Es), some_rec(Es?, B).

procedure pending_approvals(Recs?, Info?, Peer?, Recs?, Recs).
pending_approvals([], _, _, _, []).
pending_approvals([requested(Rr, K) | Rs], I, Id, R, Es?) :- ground(Rr?), ground(I?), ground(R?), integer(K?) | mem(ended(Rr?, K?), R?, Done), neg(Done?, Open), rho_of_class(Rr?, I?, Id?, Of), and(Open?, Of?, B), pending_approvals(Rs?, I?, Id?, R?, Es1), keep_rec(B?, ended(Rr?, K?), Es1?, Es).
pending_approvals([answered(At, yes) | Rs], I, Id, R, Es?) :- ground(At?), ground(I?), ground(R?) | mem(ended(At?), R?, Done), neg(Done?, Open), of_class(At?, I?, Of), and(Open?, Of?, B), pending_approvals(Rs?, I?, Id?, R?, Es1), keep_rec(B?, ended(At?), Es1?, Es).
pending_approvals([_ | Rs], I, Id, R, Es?) :- otherwise | pending_approvals(Rs?, I?, Id?, R?, Es).

procedure keep_rec(YesNo?, Rec?, Recs?, Recs).
keep_rec(yes, X, Es, [X? | Es?]).
keep_rec(no, _, Es, Es?).

procedure end_all(Recs?, Recs?, Recs, YesNo).
end_all([], R, R?, no).
end_all([E | Es], R, R1?, yes) :- app([E? | Es?], R?, R1).

procedure some_rec(Recs?, YesNo).
some_rec([], no).
some_rec([_ | _], yes).

procedure rho_of_class(Rho?, Info?, Peer?, YesNo).
rho_of_class(one(C), I, _, B?) :- term_of_class(C?, I?, B).
rho_of_class(rho(N), I, Id, B?) :- in_rho(I?, N?, Id?, B).

procedure drop_held_class(Helds?, Info?, Peer?, Helds).
drop_held_class([], _, _, []).
drop_held_class([held(F, Rr, K) | Hs], I, Id, Hs1?) :- ground(Rr?), ground(I?) | rho_of_class(Rr?, I?, Id?, Of), drop_held_class(Hs?, I?, Id?, Hs0), keep_held(Of?, held(F?, Rr?, K?), Hs0?, Hs1).

procedure keep_held(YesNo?, Held?, Helds?, Helds).
keep_held(yes, _, Hs, Hs?).
keep_held(no, H, Hs, [H? | Hs?]).

procedure drop_named(Names?, Helds?, Helds).
drop_named(none, Hd, Hd?).
drop_named(request(Rr, K), Hd, Hd1?) :- drop_req(Hd?, Rr?, K?, Hd1).

procedure drop_req(Helds?, Rho?, Integer?, Helds).
drop_req([], _, _, []).
drop_req([held(F, Rr1, K1) | Hs], Rr, K, Hs1?) :- ground(Rr1?), ground(Rr?), integer(K1?), integer(K?) | same(Rr1?, Rr?, E1), same_int(K1?, K?, E2), and(E1?, E2?, E), drop_req(Hs?, Rr?, K?, Hs0), keep_held(E?, held(F?, Rr1?, K1?), Hs0?, Hs1).

procedure release(Lock?, Attempt?, Lock).
release(unlocked, _, unlocked).
release(held(A), At, unlocked) :- (A? =?= At?) | true.
release(held(A), _, held(A?)) :- otherwise | true.

procedure send_all(Sends?, St?, Nets, St).
send_all(Ss, St, Ms?, St?) :- ground(St?) | st_id(St?, Id), cargo_msgs(Ss?, Id?, Ms).

procedure cargo_msgs(Sends?, Peer?, Nets).
cargo_msgs([], _, []).
cargo_msgs([to(T, X) | Ss], Id, [msg(T?, cargo(Id?, X?)) | Ms?]) :- ground(Id?) | cargo_msgs(Ss?, Id?, Ms).

procedure put_all(Nets?, Stream(Net), Stream(Net)?).
put_all([], Out?, Out).
put_all([M | Ms], [M? | Out?], Cont) :- put_all(Ms?, Out, Cont?).

procedure spend(YesNo?, St?, Recs?, St, Recs).
spend(no, St, H, St?, H?).
spend(yes, St, H, St2?, H1?) :- ground(St?) | st_app(St?, Ap), st_ix(St?, Ix), st_id(St?, Id), spend_app(Ap?, Ix?, Id?, Ap1, Ix1, Ms), set_app(St?, Ap1?, St1), set_ix(St1?, Ix1?, St2), app(Ms?, H?, H1).

procedure spend_app(App?, Ix?, Peer?, App, Ix, Recs).
spend_app(app(S, K, L, R), Ix, Id, app(S?, K?, L?, R1?), Ix2?, Ms?) :- ground(R?) | closed_of(R?, Cl), ends_of(R?, Ea), spend_ix(R?, R?, Id?, Ix?, Ix1), spend_app1(R?, Cl?, Ea?, Ix1?, R1, Ms, Ix2).

procedure spend_app1(Recs?, Attempts?, Recs?, Ix?, Recs, Recs, Ix).
spend_app1(R, Cl, Ea, ix(Tr, Wl, In, ic(S0, Ns0, Pe)), R1?, Ms?, ix(Tr1?, Wl?, In1?, ic(S0?, Ns0?, Pe1?))) :- spend_split(R?, Cl?, Ea?, Tr?, R1, Ms, Is, Tr1), intros_out(Is?, Pe?, Pe1, Is1), app(Is1?, In?, In1).

procedure intros_out(Recs?, Pairs?, Pairs, Recs).
intros_out([], Pe, Pe?, []).
intros_out([introduced(Q, R) | Is], Pe, Pe1?, [introduced(Q?, R?) | Is1?]) :- ground(Q?), ground(R?) | remove_all(pr(Q?, R?), Pe?, Pe0), intros_out(Is?, Pe0?, Pe1, Is1).
intros_out([X | Is], Pe, Pe1?, [X? | Is1?]) :- otherwise | intros_out(Is?, Pe?, Pe1, Is1).

procedure closed_of(Recs?, Attempts).
closed_of([], []).
closed_of([closed(A) | Rs], [A? | Cl?]) :- closed_of(Rs?, Cl).
closed_of([_ | Rs], Cl?) :- otherwise | closed_of(Rs?, Cl).

procedure ends_of(Recs?, Recs).
ends_of([], []).
ends_of([ended(A) | Rs], [ended(A?) | Es?]) :- ends_of(Rs?, Es).
ends_of([ended(Rr, K) | Rs], [ended(Rr?, K?) | Es?]) :- ends_of(Rs?, Es).
ends_of([_ | Rs], Es?) :- otherwise | ends_of(Rs?, Es).

procedure spend_ix(Recs?, Recs?, Peer?, Ix?, Ix).
spend_ix([], _, _, Ix, Ix?).
spend_ix([closed(A) | Rs], R, Id, ix(Tr, Wl, In, Ic), Ix1?) :- ground(A?), ground(R?), ground(Id?) | attempt_id(A?, I), attempt_k(A?, K), trie_put(K?, a(I?), Tr?, Tr1), attempt_id(A?, P), same(P?, Id?, Own), mem(wounded(A?), R?, Wd), and(Own?, Wd?, W), wl_add(W?, A?, Wl?, Wl1), spend_ix(Rs?, R?, Id?, ix(Tr1?, Wl1?, In?, Ic?), Ix1).
spend_ix([ended(Rr, K) | Rs], R, Id, ix(Tr, Wl, In, Ic), Ix1?) :- ground(Rr?), integer(K?) | trie_put(K?, r(Rr?), Tr?, Tr1), spend_ix(Rs?, R?, Id?, ix(Tr1?, Wl?, In?, Ic?), Ix1).
spend_ix([_ | Rs], R, Id, Ix, Ix1?) :- otherwise | spend_ix(Rs?, R?, Id?, Ix?, Ix1).

procedure wl_add(YesNo?, Attempt?, Attempts?, Attempts).
wl_add(yes, A, Wl, [A? | Wl?]).
wl_add(no, _, Wl, Wl?).

procedure spend_split(Recs?, Attempts?, Recs?, Trie?, Recs, Recs, Recs, Trie).
spend_split([], _, _, Tr, [], [], [], Tr?).
spend_split([E | Es], Cl, Ea, Tr, Ks?, Ms?, Is?, Tr2?) :- ground(E?), ground(Cl?), ground(Ea?) | spent_rec(E?, Cl?, Ea?, Tr?, F, Tr1), spend_split(Es?, Cl?, Ea?, Tr1?, Ks1, Ms1, Is1, Tr2), spend_one(F?, E?, Ks1?, Ms1?, Is1?, Ks, Ms, Is).

procedure spend_one(Fate?, Rec?, Recs?, Recs?, Recs?, Recs, Recs, Recs).
spend_one(keep, E, Ks, Ms, Is, [E? | Ks?], Ms?, Is?).
spend_one(move, E, Ks, Ms, Is, Ks?, [E? | Ms?], Is?).
spend_one(intro, E, Ks, Ms, Is, Ks?, Ms?, [E? | Is?]).

procedure spent_rec(Rec?, Attempts?, Recs?, Trie?, Fate, Trie).
spent_rec(asked(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(answered(A, no), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(answered(A, yes), _, Ea, Tr, F?, Tr1?) :- ground(A?) | mem(ended(A?), Ea?, En), attempt_id(A?, I), attempt_k(A?, K), trie_look(K?, a(I?), Tr?, Cd, Tr1), and(En?, Cd?, B), fate_of(B?, F).
spent_rec(voted(A, _), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(got(A, _, _), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(closed(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(wounded(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(yielded(A), Cl, _, Tr, F?, Tr?) :- in_closed(A?, Cl?, F).
spent_rec(ended(A), _, _, Tr, F?, Tr1?) :- ground(A?) | attempt_id(A?, I), attempt_k(A?, K), trie_look(K?, a(I?), Tr?, Cd, Tr1), fate_of(Cd?, F).
spent_rec(requested(Rr, K), _, Ea, Tr, F?, Tr?) :- mem(ended(Rr?, K?), Ea?, B), fate_of(B?, F).
spent_rec(ended(_, _), _, _, Tr, move, Tr?).
spent_rec(introduced(_, _), _, _, Tr, intro, Tr?).

procedure in_closed(Attempt?, Attempts?, Fate).
in_closed(A, Cl, F?) :- mem(A?, Cl?, B), fate_of(B?, F).

procedure fate_of(YesNo?, Fate).
fate_of(yes, move).
fate_of(no, keep).

procedure trie_put(Integer?, Tag?, Trie?, Trie).
trie_put(K, G, nil, T?) :- trie_put(K?, G?, t([], nil, nil), T).
trie_put(K, G, t(Gs, Z, O), t([G? | Gs?], Z?, O?)) :- (K? =< 1) | true.
trie_put(K, G, t(Gs, Z, O), T?) :- (K? > 1) | M := (K? mod 2), K1 := (K? // 2), trie_put1(M?, K1?, G?, Gs?, Z?, O?, T).

procedure trie_put1(Integer?, Integer?, Tag?, Tags?, Trie?, Trie?, Trie).
trie_put1(M, K1, G, Gs, Z, O, t(Gs?, Z1?, O?)) :- (M? =:= 0) | trie_put(K1?, G?, Z?, Z1).
trie_put1(M, K1, G, Gs, Z, O, t(Gs?, Z?, O1?)) :- (M? =\= 0) | trie_put(K1?, G?, O?, O1).

procedure trie_has(Integer?, Tag?, Trie?, YesNo).
trie_has(_, _, nil, no).
trie_has(K, G, t(Gs, _, _), B?) :- (K? =< 1) | mem(G?, Gs?, B).
trie_has(K, G, t(_, Z, O), B?) :- (K? > 1) | M := (K? mod 2), K1 := (K? // 2), trie_has1(M?, K1?, G?, Z?, O?, B).

procedure trie_has1(Integer?, Integer?, Tag?, Trie?, Trie?, YesNo).
trie_has1(M, K1, G, Z, _, B?) :- (M? =:= 0) | trie_has(K1?, G?, Z?, B).
trie_has1(M, K1, G, _, O, B?) :- (M? =\= 0) | trie_has(K1?, G?, O?, B).

procedure trie_look(Integer?, Tag?, Trie?, YesNo, Trie).
trie_look(_, _, nil, no, nil).
trie_look(K, G, t(Gs, Z, O), B?, t(Gs?, Z?, O?)) :- (K? =< 1), ground(Gs?) | mem(G?, Gs?, B).
trie_look(K, G, t(Gs, Z, O), B?, T?) :- (K? > 1) | M := (K? mod 2), K1 := (K? // 2), trie_look1(M?, K1?, G?, Gs?, Z?, O?, B, T).

procedure trie_look1(Integer?, Integer?, Tag?, Tags?, Trie?, Trie?, YesNo, Trie).
trie_look1(M, K1, G, Gs, Z, O, B?, t(Gs?, Z1?, O?)) :- (M? =:= 0) | trie_look(K1?, G?, Z?, B, Z1).
trie_look1(M, K1, G, Gs, Z, O, B?, t(Gs?, Z?, O1?)) :- (M? =\= 0) | trie_look(K1?, G?, O?, B, O1).

procedure rec_closed(Attempt?, Recs?, Trie?, YesNo).
rec_closed(A, R, Tr, B?) :- ground(A?) | mem(closed(A?), R?, B1), attempt_id(A?, I), attempt_k(A?, K), trie_has(K?, a(I?), Tr?, B2), or(B1?, B2?, B).

procedure st_closed(Attempt?, St?, YesNo).
st_closed(A, st(_, app(_, _, _, R), _, _, _, _, _, _, _, _, _, _, ix(Tr, _, _, _), _), B?) :- rec_closed(A?, R?, Tr?, B).

procedure trie_closed(Attempt?, Recs?, Trie?, YesNo, Trie).
trie_closed(A, R, Tr, B?, Tr1?) :- ground(A?) | mem(closed(A?), R?, B1), attempt_id(A?, I), attempt_k(A?, K), trie_look(K?, a(I?), Tr?, B2, Tr1), or(B1?, B2?, B).

procedure st_req(Attempt?, St?, YesNo, YesNo).
st_req(attempt(_, _, _, _, none), _, no, no).
st_req(attempt(_, _, _, _, request(Rr, K)), st(_, app(_, _, _, R), _, _, _, _, _, _, _, _, _, _, ix(Tr, _, _, _), _), B?, E?) :- ground(Rr?), integer(K?) | req_scan(R?, Rr?, K?, no, no, B1, E1), trie_has(K?, r(Rr?), Tr?, T), req_or(B1?, E1?, T?, B, E).

procedure req_or(YesNo?, YesNo?, YesNo?, YesNo, YesNo).
req_or(_, _, yes, yes, yes).
req_or(B1, E1, no, B1?, E1?).

procedure req_scan(Recs?, Rho?, Integer?, YesNo?, YesNo?, YesNo, YesNo).
req_scan([], _, _, B, E, B?, E?).
req_scan([requested(R1, K1) | Rs], Rr, K, _, E, B1?, E1?) :- (R1? =?= Rr?), (K1? =:= K?) | req_scan(Rs?, Rr?, K?, yes, E?, B1, E1).
req_scan([ended(R1, K1) | Rs], Rr, K, B, _, B1?, E1?) :- (R1? =?= Rr?), (K1? =:= K?) | req_scan(Rs?, Rr?, K?, B?, yes, B1, E1).
req_scan([_ | Rs], Rr, K, B, E, B1?, E1?) :- otherwise | req_scan(Rs?, Rr?, K?, B?, E?, B1, E1).

procedure st_introduced(Peer?, Peer?, St?, YesNo).
st_introduced(Q, R, st(_, app(_, _, _, Rc), _, _, _, _, _, _, _, _, _, _, ix(_, _, In, _), _), B?) :- ground(Q?), ground(R?) | mem(introduced(Q?, R?), Rc?, B1), mem(introduced(Q?, R?), In?, B2), or(B1?, B2?, B).

procedure ix_intros(Ix?, Recs).
ix_intros(ix(_, _, In, _), In?).

procedure unlocked(Lock?, YesNo).
unlocked(unlocked, yes).
unlocked(held(_), no).

procedure no_question(Info?, Recs?, Recs?, YesNo).
no_question(_, [], _, yes).
no_question(I, [asked(At) | Rs], R, B?) :- ground(I?), ground(At?), ground(R?) | pending_rec(At?, R?, P), of_class(At?, I?, Cl), and(P?, Cl?, Q), no_question1(Q?, I?, Rs?, R?, B).
no_question(I, [_ | Rs], R, B?) :- otherwise | no_question(I?, Rs?, R?, B).

procedure no_question1(YesNo?, Info?, Recs?, Recs?, YesNo).
no_question1(yes, _, _, _, no).
no_question1(no, I, Rs, R, B?) :- no_question(I?, Rs?, R?, B).

procedure pending_rec(Attempt?, Recs?, YesNo).
pending_rec(At, R, B?) :- ground(At?), ground(R?) | mem(asked(At?), R?, B1), has_vote(At?, R?, B2), mem(closed(At?), R?, B3), or(B2?, B3?, B23), neg(B23?, B4), and(B1?, B4?, B).

procedure has_vote(Attempt?, Recs?, YesNo).
has_vote(_, [], no).
has_vote(At, [voted(A, _) | _], yes) :- (At? =?= A?) | true.
has_vote(At, [_ | Rs], B?) :- otherwise | has_vote(At?, Rs?, B).

procedure has_answer(Attempt?, Recs?, YesNo).
has_answer(_, [], no).
has_answer(At, [answered(A, _) | _], yes) :- (At? =?= A?) | true.
has_answer(At, [_ | Rs], B?) :- otherwise | has_answer(At?, Rs?, B).

procedure answer_of(Attempt?, Recs?, YesNo).
answer_of(_, [], no).
answer_of(At, [answered(A, Y) | _], Y?) :- (At? =?= A?) | true.
answer_of(At, [_ | Rs], Y?) :- otherwise | answer_of(At?, Rs?, Y).

procedure of_class(Attempt?, Info?, YesNo).
of_class(attempt(_, _, _, C, _), I, B?) :- term_of_class(C?, I?, B).

procedure term_of_class(Class?, Info?, YesNo).
term_of_class(C, ci(_, Ps, Q, _, Ms), B?) :- ground(C?) | term_spec(C?, _, Rs, Bn), of_class1(Rs?, Bn?, Ps?, Q?, Ms?, B).

procedure of_class1(RoleSpecs?, Binding?, Deltas?, Peers?, Mates?, YesNo).
of_class1(Rs, Bn, Ps, Q, Ms, B?) :- ground(Rs?), ground(Bn?) | sig_of(Rs?, Bn?, Ps1), in_class(Rs?, Bn?, Ps1?, Ps?, Q?, Ms?, B).

procedure others_known(Info?, V?, Known).
others_known(I, v(Id, _, _, _, _, Kn), K?) :- info_q(I?, Q), first_unknown(Q?, Id?, Kn?, K).

procedure first_unknown(Peers?, Peer?, Kn?, Known).
first_unknown([], _, _, allknown).
first_unknown([P | Ps], Id, Kn, K?) :- ground(P?), ground(Id?), ground(Kn?) | same(P?, Id?, Me), known_kn(P?, Kn?, Kp), or(Me?, Kp?, Ok), first_unknown1(Ok?, P?, Ps?, Id?, Kn?, K).

procedure first_unknown1(YesNo?, Peer?, Peers?, Peer?, Kn?, Known).
first_unknown1(yes, _, Ps, Id, Kn, K?) :- first_unknown(Ps?, Id?, Kn?, K).
first_unknown1(no, P, _, _, _, unknown(P?)).

procedure known_st(Peer?, St?, YesNo).
known_st(P, st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), B?) :- known_kn(P?, kn(Se?, Rc?, ISe?, IRc?), B).

procedure known_kn(Peer?, Kn?, YesNo).
known_kn(P, kn(Se, Rc, ISe, IRc), B?) :- ground(P?) | known_peer(P?, Se?, Rc?, B1), known_peer(P?, ISe?, IRc?, B2), or(B1?, B2?, B).

procedure known_peer(Peer?, Peers?, Peers?, YesNo).
known_peer(P, Se, Rc, B?) :- ground(P?) | mem(P?, Se?, B1), mem(P?, Rc?, B2), and(B1?, B2?, B).

procedure known_ok(Known?, YesNo).
known_ok(allknown, yes).
known_ok(unknown(_), no).

procedure go_or_drop(YesNo?, Info?, Cond).
go_or_drop(yes, I, go(I?)).
go_or_drop(no, _, drop).

procedure no_prior_start(V?, YesNo).
no_prior_start(v(_, _, _, R, Pd, _), B?) :- any_answered_yes(R?, Q), empty_pends(Pd?, E), neg(Q?, NQ), and(E?, NQ?, B).

procedure empty_pends(Pends?, YesNo).
empty_pends([], yes).
empty_pends([_ | _], no).

procedure any_answered_yes(Recs?, YesNo).
any_answered_yes(R, B?) :- ground(R?) | any_answered_yes1(R?, R?, B).

procedure any_answered_yes1(Recs?, Recs?, YesNo).
any_answered_yes1([], _, no).
any_answered_yes1([answered(G, yes) | Rs], R, B?) :- ground(G?), ground(R?) | pending_rec(G?, R?, P), any_answered_yes2(P?, Rs?, R?, B).
any_answered_yes1([_ | Rs], R, B?) :- otherwise | any_answered_yes1(Rs?, R?, B).

procedure any_answered_yes2(YesNo?, Recs?, Recs?, YesNo).
any_answered_yes2(yes, _, _, yes).
any_answered_yes2(no, Rs, R, B?) :- any_answered_yes1(Rs?, R?, B).

procedure precedes(Peer?, Peer?, YesNo).
precedes(P, Q, yes) :- '@<'(P?, Q?) | true.
precedes(_, _, no) :- otherwise | true.

procedure guarding_parts(Parts?, Peer?, Classes).
guarding_parts([], _, []).
guarding_parts([pt(T, G, Op) | Ps], Id, R?) :- ground(Id?) | mem(Id?, G?, B1), no_opener(Op?, B2), and(B1?, B2?, B), guarding_parts(Ps?, Id?, R1), keep_class(B?, T?, R1?, R).

procedure no_opener(Opener?, YesNo).
no_opener(opener(_), no).
no_opener(guarded_part, yes).

procedure opening_parts(Parts?, Peer?, Classes).
opening_parts([], _, []).
opening_parts([pt(T, G, Op) | Ps], Id, R?) :- ground(Id?) | is_opener(Op?, Id?, B1), some_peer(G?, B2), neg(B2?, B3), and(B1?, B3?, B), opening_parts(Ps?, Id?, R1), keep_class(B?, T?, R1?, R).

procedure is_opener(Opener?, Peer?, YesNo).
is_opener(opener(P), Id, B?) :- same(P?, Id?, B).
is_opener(guarded_part, _, no).

procedure all_in(Peers?, Peers?, YesNo).
all_in([], _, yes).
all_in([P | Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).

procedure all_in1(YesNo?, Peers?, Peers?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).

procedure part_dom(Class?, Peer?, GAtoms?, YesNo).
part_dom(P, Id, S, B?) :- ground(P?), ground(Id?), ground(S?) | term_spec(P?, Nm, Rs, Bn), part_dom1(Nm?, Rs?, Bn?, Id?, S?, B).

procedure part_dom1(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
part_dom1(Nm, Rs, Bn, Id, S, B?) :- ground(Nm?), ground(Bn?), ground(Id?), ground(S?) | reflexive_preds(Rf), hat(Rf?, Id?, S?, Sh), mate_dom(Nm?, Rs?, Bn?, Id?, Sh?, B1), listing_ok(Nm?, Bn?, Id?, S?, B2), and(B1?, B2?, B).

procedure hat(Preds?, Peer?, GAtoms?, GAtoms).
hat([], _, S, S?).
hat([P | Ps], Id, S, [g(P?, [p(Id?)]) | R?]) :- ground(Id?) | hat(Ps?, Id?, S?, R).

procedure unable_reason(Class?, Peer?, GAtoms?, Reason).
unable_reason(P, Id, S, unable(L?, H?)) :- ground(P?), ground(S?) | term_spec(P?, Nm, Rs, Bn), unable_atoms(Nm?, Rs?, Bn?, Id?, S?, L0, H0), atoms_of(L0?, L), atoms_of(H0?, H).

procedure unable_atoms(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
unable_atoms(Nm, Rs, Bn, Id, S, L?, H?) :- ground(Nm?), ground(Rs?), ground(Bn?), ground(S?) | reflexive_preds(Rf), hat(Rf?, Id?, S?, Sh), specs_at(Rs?, 1, Bn?, Id?, RsP), unlocal(Bn?, B0), unable_at(RsP?, B0?, Sh?, L1, H1), listing_gaps(Nm?, Bn?, Id?, S?, L2, H2), app(L1?, L2?, L), app(H1?, H2?, H).

procedure unable_at(RoleSpecs?, Binding?, GAtoms?, GAtoms, GAtoms).
unable_at(RsP, B0, Sh, L?, H?) :- ground(RsP?), ground(B0?), ground(Sh?) | reqs_of(RsP?, Q0), match_all(Q0?, Sh?, B0?, Cs), first_or(Cs?, B0?, Bn), unable_at1(RsP?, Bn?, Sh?, L, H).

procedure first_or(Bindings?, Binding?, Binding).
first_or([B | _], _, B?).
first_or([], B, B?).

procedure unable_at1(RoleSpecs?, Binding?, GAtoms?, GAtoms, GAtoms).
unable_at1(RsP, Bn, Sh, L?, H?) :- ground(RsP?), ground(Bn?), ground(Sh?) | reqs_of(RsP?, Q), img_atoms(Q?, Bn?, G), ms_diff(G?, Sh?, L), forbs_of(RsP?, F), img_atoms(F?, Bn?, Fg), held_in(Fg?, Sh?, H0), dedup(H0?, H).

procedure held_in(GAtoms?, GAtoms?, GAtoms).
held_in([], _, []).
held_in([G | Gs], Sh, H?) :- ground(G?), ground(Sh?) | mem(G?, Sh?, In), held_in(Gs?, Sh?, H1), keep_g(In?, G?, H1?, H).

procedure keep_g(YesNo?, GAtom?, GAtoms?, GAtoms).
keep_g(yes, G, H, [G? | H?]).
keep_g(no, _, H, H?).

procedure listing_gaps(Constant?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
listing_gaps(Nm, Bn, Id, S, L?, H?) :- schema_entry(Nm?, E), listing_gaps1(E?, Bn?, Id?, S?, L, H).

procedure listing_gaps1(Schema?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
listing_gaps1(schema(_, _, _), _, _, _, [], []).
listing_gaps1(lschema(_, _, _, Lsts), Bn, Id, S, L?, H?) :- gaps_of(Lsts?, Bn?, Id?, S?, L, H).

procedure gaps_of(Listings?, Binding?, Peer?, GAtoms?, GAtoms, GAtoms).
gaps_of([], _, _, _, [], []).
gaps_of([listing(I, Bi, Rho, As) | Lsts], Bn, Id, S, L?, H?) :- ground(Bn?), ground(S?) | role_person(Bi?, Bn?, P), same(P?, Id?, Base), gaps_one(Base?, I?, Rho?, As?, Bn?, S?, L1, H1), gaps_of(Lsts?, Bn?, Id?, S?, L2, H2), app(L1?, L2?, L), app(H1?, H2?, H).

procedure gaps_one(YesNo?, Integer?, Constant?, Vars?, Binding?, GAtoms?, GAtoms, GAtoms).
gaps_one(no, _, _, _, _, _, [], []).
gaps_one(yes, I, Rho, As, Bn, S, L?, H?) :- ground(Rho?), ground(As?), ground(Bn?), ground(S?) | copies_of(Bn?, I?, Want), list_at(Rho?, As?, Bn?, S?, Have), img_args(As?, Bn?, Vs), gaps_two(Want?, Have?, Rho?, Vs?, L, H).

procedure gaps_two(Peers?, Peers?, Constant?, Vals?, GAtoms, GAtoms).
gaps_two(Want, Have, Rho, Vs, L?, H?) :- ground(Want?), ground(Have?), ground(Rho?), ground(Vs?) | peers_minus(Want?, Have?, Lp), peers_minus(Have?, Want?, Hp), listing_atoms(Lp?, Rho?, Vs?, L), listing_atoms(Hp?, Rho?, Vs?, H).

procedure peers_minus(Peers?, Peers?, Peers).
peers_minus([], _, []).
peers_minus([P | Ps], Qs, R?) :- ground(Qs?) | mem(P?, Qs?, In), peers_minus(Ps?, Qs?, R1), keep_out(In?, P?, R1?, R).

procedure keep_out(YesNo?, Peer?, Peers?, Peers).
keep_out(yes, _, R, R?).
keep_out(no, P, R, [P? | R?]).

procedure listing_atoms(Peers?, Constant?, Vals?, GAtoms).
listing_atoms([], _, _, []).
listing_atoms([Q | Qs], Rho, Vs, [g(Rho?, [p(Q?) | Vs?]) | Gs?]) :- ground(Rho?), ground(Vs?) | listing_atoms(Qs?, Rho?, Vs?, Gs).

procedure ready_parts(Classes?, Peer?, GAtoms?, Classes).
ready_parts([], _, _, []).
ready_parts([P | Ps], Id, S, R?) :- ground(P?), ground(Id?), ground(S?) | part_dom(P?, Id?, S?, B), ready_parts(Ps?, Id?, S?, R1), keep_class(B?, P?, R1?, R).

procedure keep_class(YesNo?, Class?, Classes?, Classes).
keep_class(yes, P, R, [P? | R?]).
keep_class(no, _, R, R?).

procedure same_part(Info?, Class?, Class?, YesNo).
same_part(I, C1, C2, B?) :- ground(I?), ground(C1?), ground(C2?) | info_q(I?, Q), binding_of(C1?, N1, B1), binding_of(C2?, N2, B2), same_part1(Q?, N1?, B1?, N2?, B2?, B).

procedure same_part1(Peers?, Constant?, Binding?, Constant?, Binding?, YesNo).
same_part1(Q, N1, B1, N2, B2, B?) :- ground(N1?), ground(B1?), ground(N2?), ground(B2?) | marked_people(N1?, B1?, G1), marked_people(N2?, B2?, G2), same_bpart(Q?, N1?, B1?, G1?, N2?, B2?, G2?, B).

procedure same_bpart(Peers?, Constant?, Binding?, Peers?, Constant?, Binding?, Peers?, YesNo).
same_bpart(Q, N1, B1, G1, N2, B2, G2, B?) :- ground(B1?), ground(B2?) | same(G1?, G2?, E1), bound_spec(N1?, B1?, Rs1), bound_spec(N2?, B2?, Rs2), reflexive_preds(Rf), same_doms(Q?, Rs1?, B1?, Rs2?, B2?, Rf?, E2), and(E1?, E2?, B).

procedure marked_people(Constant?, Binding?, Peers).
marked_people(Nm, B, G?) :- ground(B?) | bound_spec(Nm?, B?, Rs), marked_of(Rs?, B?, G).

procedure marked_of(RoleSpecs?, Binding?, Peers).
marked_of(Rs, B, G?) :- ground(Rs?) | guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), sort_peers(Gp?, Gs), dedup(Gs?, G).

procedure same_doms(Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
same_doms([], _, _, _, _, _, yes).
same_doms([P | Ps], Rs1, B1, Rs2, B2, Rf, B?) :- ground(P?), ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?) | reqs_at(Rs1?, B1?, P?, Rf?, R1), reqs_at(Rs2?, B2?, P?, Rf?, R2), forbs_at(Rs1?, B1?, P?, F1), forbs_at(Rs2?, B2?, P?, F2), dedup(F1?, F1s), dedup(F2?, F2s), ms_eq(R1?, R2?, E1), ms_eq(F1s?, F2s?, E2), and(E1?, E2?, E), same_doms1(E?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, B).

procedure same_doms1(YesNo?, Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
same_doms1(no, _, _, _, _, _, _, no).
same_doms1(yes, Ps, Rs1, B1, Rs2, B2, Rf, B?) :- same_doms(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, B).

procedure term_part(Class?, Info?, Class?, YesNo).
term_part(E, I, P, B?) :- ground(E?), ground(I?), ground(P?) | term_of_class(E?, I?, In), term_part1(In?, E?, I?, P?, B).

procedure term_part1(YesNo?, Class?, Info?, Class?, YesNo).
term_part1(no, _, _, _, no).
term_part1(yes, E, I, P, B?) :- same_part(I?, E?, P?, B).

procedure mate_dom(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
mate_dom(Nm, Rs, B, Id, Sh, R?) :- ground(Rs?), ground(B?), ground(Id?), ground(Sh?) | dom_bindings(Nm?, Rs?, B?, Id?, Sh?, Bs), some_binding(Bs?, R).

procedure dom_bindings(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, Bindings).
dom_bindings(Nm, Rs, B, Id, Sh, Bs?) :- ground(Nm?), ground(Rs?), ground(B?), ground(Id?), ground(Sh?) | specs_at(Rs?, 1, B?, Id?, RsP), unlocal(B?, B0), con_at(Nm?, B?, Id?, Con), dom_bindings1(RsP?, B0?, Sh?, Con?, Bs).

procedure dom_bindings1(RoleSpecs?, Binding?, GAtoms?, Constraint?, Bindings).
dom_bindings1(RsP, B0, Sh, Con, Bs?) :- ground(RsP?), ground(Sh?), ground(Con?) | reqs_of(RsP?, Q), match_all(Q?, Sh?, B0?, Cs), dom_keep(Cs?, RsP?, Sh?, Con?, Bs).

procedure dom_keep(Bindings?, RoleSpecs?, GAtoms?, Constraint?, Bindings).
dom_keep([], _, _, _, []).
dom_keep([B | Bs], RsP, Sh, Con, R?) :- ground(B?), ground(RsP?), ground(Sh?), ground(Con?) | cand_ok(RsP?, B?, Sh?, O1), con_holds(Con?, B?, O2), and(O1?, O2?, Ok), dom_keep(Bs?, RsP?, Sh?, Con?, R1), keep_binding(Ok?, B?, R1?, R).

procedure reqs_of(RoleSpecs?, SAtoms).
reqs_of([], []).
reqs_of([R | Rs], Q?) :- ground(R?) | rs_req(R?, Q1), reqs_of(Rs?, Q2), app(Q1?, Q2?, Q).

procedure cand_ok(RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok([], _, _, yes).
cand_ok([R | Rs], B, Sh, Out?) :- ground(R?), ground(B?), ground(Sh?) | rs_req(R?, Q), img_atoms(Q?, B?, G), ms_sub(G?, Sh?, B1), rs_forb(R?, F), forb_ok(F?, B?, Sh?, B2), and(B1?, B2?, B3), cand_ok1(B3?, Rs?, B?, Sh?, Out).

procedure cand_ok1(YesNo?, RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok1(no, _, _, _, no).
cand_ok1(yes, Rs, B, Sh, Out?) :- cand_ok(Rs?, B?, Sh?, Out).

procedure forb_ok(SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok([], _, _, yes).
forb_ok([A | As], B, Sh, R?) :- ground(A?), ground(B?), ground(Sh?) | atom_bound(A?, B?, Bd), forb_one(Bd?, A?, B?, Sh?, R1), forb_ok1(R1?, As?, B?, Sh?, R).

procedure forb_one(YesNo?, SAtom?, Binding?, GAtoms?, YesNo).
forb_one(no, _, _, _, yes).
forb_one(yes, A, B, Sh, R?) :- ground(Sh?) | img_atom(A?, B?, G), mem(G?, Sh?, In), neg(In?, R).

procedure forb_ok1(YesNo?, SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok1(no, _, _, _, no).
forb_ok1(yes, As, B, Sh, R?) :- forb_ok(As?, B?, Sh?, R).

procedure apply_part(Class?, Peer?, GAtoms?, GAtoms).
apply_part(P, Id, S, S1?) :- ground(P?), ground(Id?), ground(S?) | term_spec(P?, Nm, Rs, Bn), reflexive_preds(Rf), hat(Rf?, Id?, S?, Sh), dom_bindings(Nm?, Rs?, Bn?, Id?, Sh?, Bs), term_spec(P?, _, Rs2, Bn2), apply_with(Bs?, Rs2?, Bn2?, Id?, S?, S1).

procedure apply_with(Bindings?, RoleSpecs?, Binding?, Peer?, GAtoms?, GAtoms).
apply_with([B | _], Rs, _, Id, S, S1?) :- ground(Rs?), ground(B?), ground(Id?) | specs_at(Rs?, 1, B?, Id?, RsP), joins(RsP?, B?, D, A), ms_diff(S?, D?, S0), app(A?, S0?, S1).
apply_with([], Rs, Bn, Id, S, S1?) :- ground(Rs?), ground(Bn?), ground(Id?) | specs_at(Rs?, 1, Bn?, Id?, RsP), joins(RsP?, Bn?, D, A), ms_diff(S?, D?, S0), app(A?, S0?, S1).

procedure delta_at(Deltas?, Peer?, GAtoms, GAtoms).
delta_at([], _, [], []).
delta_at([delta(P, D, A) | _], Id, D?, A?) :- (P? =?= Id?) | true.
delta_at([_ | Ps], Id, D?, A?) :- otherwise | delta_at(Ps?, Id?, D, A).

procedure st_class(Class?, St?, ClassRes, St).
st_class(C, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), R?, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca1?, Pd?, Pr?, Hd?, Ix?, Rq?)) :- ground(Id?) | class_info(C?, Id?, Ca?, R, Ca1).

procedure class_info(Class?, Peer?, Infos?, ClassRes, Infos).
class_info(C, Id, Ca, R?, Ca1?) :- ground(C?) | binding_of(C?, Nm, B), class_info1(Nm?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info1(Constant?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info1(Nm, B, C, Id, Ca, R?, Ca1?) :- ground(Nm?), ground(B?) | bound_spec(Nm?, B?, Rs), rule_spec_ok(Nm?, B?, V0), con_live(Nm?, B?, Vc), and(V0?, Vc?, V1), class_info2(V1?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info2(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info2(V1, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | admissible(Rs?, B?, V2), and(V1?, V2?, V), class_info3(V?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info3(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info3(no, _, _, _, _, Ca, nocls, Ca?).
class_info3(yes, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | sig_of(Rs?, B?, Ps), class_info4(Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info4(Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info4(Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Id?), ground(Rs?), ground(B?) | deltas_valid(Ps?, V1), deltas_peers(Ps?, Q), mem(Id?, Q?, V2), deltas_peers(Ps?, Q1), reflexive_preds(Rf), live_at(Q1?, Rs?, B?, Rf?, V3), and(V1?, V2?, V12), and(V12?, V3?, V), class_info5(V?, Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info5(YesNo?, Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info5(no, _, _, _, _, _, Ca, nocls, Ca?).
class_info5(yes, Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Ca?) | cache_find(Rs?, B?, Ps?, Ca?, F), class_info6(F?, Ps?, C?, Id?, Ca?, R, Ca1).

procedure class_info6(ClassRes?, Deltas?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info6(cls(I), _, _, _, Ca, cls(I?), Ca?).
class_info6(nocls, Ps, C, Id, Ca, R?, Ca1?) :- new_info(C?, Ps?, Id?, I), add_info(I?, Ca?, R, Ca1).

procedure add_info(Info?, Infos?, ClassRes, Infos).
add_info(I, Ca, cls(I?), Ca1?) :- ground(I?) | app(Ca?, [I?], Ca1).

procedure cache_find(RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find(_, _, _, [], nocls).
cache_find(Rs, B, Ps, [ci(C, Ps1, Q, Pts, Ms) | Is], R?) :- ground(Rs?), ground(B?), ground(Ps?), ground(Ps1?), ground(Q?), ground(Ms?) | in_class(Rs?, B?, Ps?, Ps1?, Q?, Ms?, E), cache_find1(E?, ci(C?, Ps1?, Q?, Pts?, Ms?), Rs?, B?, Ps?, Is?, R).

procedure cache_find1(YesNo?, Info?, RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find1(yes, I, _, _, _, _, cls(I?)).
cache_find1(no, _, Rs, B, Ps, Is, R?) :- cache_find(Rs?, B?, Ps?, Is?, R).

procedure new_info(Class?, Deltas?, Peer?, Info).
new_info(C, Ps, Id, I?) :- ground(Ps?) | contract_schemas(Ss), reflexive_preds(Rf), mates_of(Ss?, Ps?, Ms0), dedup_mates(Ms0?, Ms1), deltas_peers(Ps?, Q), new_info0(C?, Ps?, Ms1?, Q?, Rf?, Id?, I).

procedure new_info0(Class?, Deltas?, Mates?, Peers?, Preds?, Peer?, Info).
new_info0(C, Ps, Ms1, Q, Rf, Id, I?) :- ground(C?), ground(Q?), ground(Rf?) | live_mates(Ms1?, Q?, Rf?, Ms2), binding_of(C?, Nm, B), class_mates(Nm?, B?, Ms2?, Q?, Rf?, Ms), new_info1(C?, Ps?, Ms?, Id?, I).

procedure new_info1(Class?, Deltas?, Mates?, Peer?, Info).
new_info1(C, Ps, Ms, Id, ci(C?, Ps?, Q?, Pts?, Ms?)) :- ground(Ps?), ground(Ms?) | deltas_peers(Ps?, Q), deltas_peers(Ps?, Q1), info_parts_of(Ms?, Q1?, Id?, Pts).

procedure info_q(Info?, Peers).
info_q(ci(_, _, Q, _, _), Q?).

procedure info_parts(Info?, Parts).
info_parts(ci(_, _, _, Pts, _), Pts?).

procedure sig_of(RoleSpecs?, Binding?, Deltas).
sig_of(Rs, B, Ps?) :- ground(Rs?), ground(B?) | role_persons(Rs?, 1, B?, Ws), dedup(Ws?, Q), deltas_for(Q?, Rs?, B?, Ps).

procedure role_persons(RoleSpecs?, Integer?, Binding?, Peers).
role_persons([], _, _, []).
role_persons([_ | Rs], I, B, [P? | Ps?]) :- integer(I?), ground(B?) | role_person(I?, B?, P), I1 := (I? + 1), role_persons(Rs?, I1?, B?, Ps).

procedure deltas_for(Peers?, RoleSpecs?, Binding?, Deltas).
deltas_for([], _, _, []).
deltas_for([P | Ps], Rs, B, [delta(P?, D?, A?) | Xs?]) :- ground(P?), ground(Rs?), ground(B?) | specs_at(Rs?, 1, B?, P?, RsP), joins(RsP?, B?, D, A), deltas_for(Ps?, Rs?, B?, Xs).

procedure joins(RoleSpecs?, Binding?, GAtoms, GAtoms).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) | dels_join(RsP?, B?, [], D), adds_join(RsP?, B?, [], A).

procedure dels_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
dels_join([], _, Acc, Acc?).
dels_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_del(R?, D), img_atoms(D?, B?, G), ms_join(Acc?, G?, Acc1), dels_join(Rs?, B?, Acc1?, Out).

procedure adds_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
adds_join([], _, Acc, Acc?).
adds_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_add(R?, A), img_atoms(A?, B?, G), ms_join(Acc?, G?, Acc1), adds_join(Rs?, B?, Acc1?, Out).

procedure specs_at(RoleSpecs?, Integer?, Binding?, Peer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R | Rs], I, B, P, Out?) :- integer(I?), ground(B?), ground(P?) | role_person(I?, B?, Q), I1 := (I? + 1), specs_at(Rs?, I1?, B?, P?, Rest), keep_spec(Q?, P?, R?, Rest?, Out).

procedure keep_spec(Peer?, Peer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R? | Rest?]) :- (Q? =?= P?) | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.

procedure deltas_valid(Deltas?, YesNo).
deltas_valid([], yes).
deltas_valid([delta(_, D, A) | Ps], B?) :- ground(A?) | ms_meets(D?, A?, M), neg(M?, B1), deltas_valid1(B1?, Ps?, B).

procedure deltas_valid1(YesNo?, Deltas?, YesNo).
deltas_valid1(no, _, no).
deltas_valid1(yes, Ps, B?) :- deltas_valid(Ps?, B).

procedure deltas_peers(Deltas?, Peers).
deltas_peers([], []).
deltas_peers([delta(P, _, _) | Ps], [P? | Qs?]) :- deltas_peers(Ps?, Qs).

procedure deltas_eq(Deltas?, Deltas?, YesNo).
deltas_eq(A, B, E?) :- ground(A?), ground(B?) | len_deltas(A?, La), len_deltas(B?, Lb), same_int(La?, Lb?, E1), deltas_in(A?, B?, E2), and(E1?, E2?, E).

procedure len_deltas(Deltas?, Integer).
len_deltas([], 0).
len_deltas([_ | Ps], N?) :- len_deltas(Ps?, M), N := (M? + 1).

procedure deltas_in(Deltas?, Deltas?, YesNo).
deltas_in([], _, yes).
deltas_in([X | Xs], B, E?) :- ground(B?) | delta_in(X?, B?, E1), deltas_in1(E1?, Xs?, B?, E).

procedure deltas_in1(YesNo?, Deltas?, Deltas?, YesNo).
deltas_in1(no, _, _, no).
deltas_in1(yes, Xs, B, E?) :- deltas_in(Xs?, B?, E).

procedure delta_in(Delta?, Deltas?, YesNo).
delta_in(_, [], no).
delta_in(delta(P, D, A), [delta(Q, D1, A1) | Ps], E?) :- (P? =?= Q?), ground(D?), ground(A?) | ms_eq(D?, D1?, E1), ms_eq(A?, A1?, E2), and(E1?, E2?, E3), delta_in1(E3?, delta(P?, D?, A?), Ps?, E).
delta_in(X, [_ | Ps], E?) :- otherwise | delta_in(X?, Ps?, E).

procedure delta_in1(YesNo?, Delta?, Deltas?, YesNo).
delta_in1(yes, _, _, yes).
delta_in1(no, X, Ps, E?) :- delta_in(X?, Ps?, E).

procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) | rs_len(Rs?, K), pairs_ok(1, K?, Rs?, B?, R).

procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- (I? > K?) | true.
pairs_ok(I, K, Rs, B, R?) :- (I? =< K?), ground(Rs?), ground(B?) | J := (I? + 1), pair_row(I?, J?, K?, Rs?, B?, R1), I1 := (I? + 1), pairs_ok1(R1?, I1?, K?, Rs?, B?, R).

procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).

procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- (J? > K?) | true.
pair_row(I, J, K, Rs, B, R?) :- (J? =< K?), ground(Rs?), ground(B?) | role_person(I?, B?, P), role_person(J?, B?, Q), nth_spec(Rs?, I?, RI), nth_spec(Rs?, J?, RJ), pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1), J1 := (J? + 1), pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).

procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).

procedure pair_ok(Peer?, Peer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- (P? =?= Q?) | role_names(RI?, J?, A1), role_names(RJ?, I?, A2), or(A1?, A2?, A), neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.

procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(rs(_, A, D, _, _), J, R?) :- integer(J?) | names_role(A?, J?, R1), names_role(D?, J?, R2), or(R1?, R2?, R).

procedure names_role(SAtoms?, Integer?, YesNo).
names_role([], _, no).
names_role([times(_, A) | As], J, R?) :- names_role([A? | As?], J?, R).
names_role([atom(_, Vs) | As], J, R?) :- integer(J?), ground(Vs?) | flat_names(Vs?, Fs), mem(role(J?), Fs?, R1), sgn_names(Vs?, J?, R2), or(R1?, R2?, R12), names_role1(R12?, As?, J?, R).

procedure names_role1(YesNo?, SAtoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, As, J, R?) :- names_role(As?, J?, R).

procedure sgn_names(Vars?, Integer?, YesNo).
sgn_names([], _, no).
sgn_names([sgn(_, I) | _], J, yes) :- (I? =:= J?) | true.
sgn_names([_ | Vs], J, R?) :- otherwise | sgn_names(Vs?, J?, R).

procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) | adds_of(Rs?, Ad), reqs_of(Rs?, Rq), guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), atoms_vars(Ad?, Av), adm_each(Av?, Rq?, B?, Gp?, R).

procedure adm_each(Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V | Vs], Rq, B, Gp, R?) :- ground(V?), ground(Rq?), ground(B?), ground(Gp?) | adm_var(V?, Rq?, B?, Gp?, R1), adm_each1(R1?, Vs?, Rq?, B?, Gp?, R).

procedure adm_each1(YesNo?, Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Rq, B, Gp, R?) :- adm_each(Vs?, Rq?, B?, Gp?, R).

procedure adm_var(Var?, SAtoms?, Binding?, Peers?, YesNo).
adm_var(svar(X), Rq, B, Gp, R?) :- ground(X?), ground(B?) | atoms_vars(Rq?, Qv), mem(svar(X?), Qv?, InReq), lookup(svar(X?), B?, F), adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(nterm(_), _, _, _, yes).
adm_var(sgn(_, _), _, _, _, yes).
adm_var(num(_), _, _, _, yes).

procedure adm_var1(YesNo?, Found?, Peers?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(s(speech(_, P))), Gp, R?) :- mem(P?, Gp?, R).
adm_var1(no, found(p(_)), _, no).
adm_var1(no, found(c(_)), _, no).
adm_var1(no, found(n(_)), _, no).
adm_var1(no, found(lv(_, _)), _, no).
adm_var1(no, free, _, no).

procedure adds_of(RoleSpecs?, SAtoms).
adds_of([], []).
adds_of([R | Rs], A?) :- rs_add(R?, A1), adds_of(Rs?, A2), app(A1?, A2?, A).

procedure atoms_vars(SAtoms?, Vars).
atoms_vars([], []).
atoms_vars([atom(_, Vs) | As], R?) :- flat_names(Vs?, Ws), atoms_vars(As?, R1), app(Ws?, R1?, R).
atoms_vars([times(V, A) | As], [V? | R?]) :- atoms_vars([A? | As?], R).

procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([rs(guarded, _, _, _, _) | Rs], I, [I? | Is?]) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).
guard_roles([rs(unguarded, _, _, _, _) | Rs], I, Is?) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).

procedure persons_of(Ints?, Binding?, Peers).
persons_of([], _, []).
persons_of([I | Is], B, [P? | Ps?]) :- ground(B?) | role_person(I?, B?, P), persons_of(Is?, B?, Ps).

procedure mates_of(Schemas?, Deltas?, Mates).
mates_of([], _, []).
mates_of([schema(Nm, _, Rs) | Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Ps?) | deltas_peers(Ps?, Q), rs_len(Rs?, K), fit_assigns(K?, Q?, Rs?, Ps?, As), mates_assigns(As?, Nm?, Rs?, Ps?, M1), mates_of(Ss?, Ps?, M2), app(M1?, M2?, M).
mates_of([lschema(Nm, _, Rs, Lsts) | Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Lsts?), ground(Ps?) | deltas_peers(Ps?, Q), rs_len(Rs?, K), blank_listed(Lsts?, Rs?, Rs0), fit_assigns(K?, Q?, Rs0?, Ps?, As0), on_base(As0?, Lsts?, As), deltas_peers(Ps?, Q1), sort_peers(Q1?, Q2), subsets(Q2?, Ls), tuples(Lsts?, Ls?, Ts), listed_mates(Ts?, As?, Nm?, Rs?, Lsts?, Ps?, M1), mates_of(Ss?, Ps?, M2), app(M1?, M2?, M).

procedure on_base(Bindings?, Listings?, Bindings).
on_base([], _, []).
on_base([B | Bs], Lsts, R?) :- ground(B?), ground(Lsts?) | on_bases(Lsts?, B?, E), on_base(Bs?, Lsts?, R1), keep_binding(E?, B?, R1?, R).

procedure on_bases(Listings?, Binding?, YesNo).
on_bases([], _, yes).
on_bases([listing(I, Bi, _, _) | Lsts], B, E?) :- ground(B?) | role_person(I?, B?, P), role_person(Bi?, B?, Q), same(P?, Q?, E1), on_bases(Lsts?, B?, E2), and(E1?, E2?, E).

procedure keep_binding(YesNo?, Binding?, Bindings?, Bindings).
keep_binding(yes, B, R, [B? | R?]).
keep_binding(no, _, R, R?).

procedure subsets(Peers?, PeerLists).
subsets([], [[]]).
subsets([P | Ps], R?) :- ground(P?), ground(Ps?) | subsets(Ps?, S1), with_first(S1?, P?, S2), subsets(Ps?, S3), app(S2?, S3?, R).

procedure with_first(PeerLists?, Peer?, PeerLists).
with_first([], _, []).
with_first([L | Ls], P, [[P? | L?] | R?]) :- ground(P?) | with_first(Ls?, P?, R).

procedure tuples(Listings?, PeerLists?, ListTuples).
tuples([], _, [[]]).
tuples([_ | Lsts], Ls, R?) :- ground(Ls?) | tuples(Lsts?, Ls?, R1), prepend_each(Ls?, R1?, R).

procedure prepend_each(PeerLists?, ListTuples?, ListTuples).
prepend_each([], _, []).
prepend_each([L | Ls], Ts, R?) :- ground(L?), ground(Ts?) | with_head(Ts?, L?, R1), prepend_each(Ls?, Ts?, R2), app(R1?, R2?, R).

procedure with_head(ListTuples?, Peers?, ListTuples).
with_head([], _, []).
with_head([T | Ts], L, [[L? | T?] | R?]) :- ground(L?) | with_head(Ts?, L?, R).

procedure listed_mates(ListTuples?, Bindings?, Constant?, RoleSpecs?, Listings?, Deltas?, Mates).
listed_mates([], _, _, _, _, _, []).
listed_mates([T | Ts], As, Nm, Rs, Lsts, Ps, M?) :- ground(T?), ground(As?), ground(Nm?), ground(Rs?), ground(Lsts?), ground(Ps?) | rs_len(Rs?, K), K1 := (K? + 1), tuple_binds(Lsts?, T?, K1?, Cs), extend_all(As?, Cs?, Bs), spec_for(Rs?, Lsts?, T?, Rs1), mates_assigns(Bs?, Nm?, Rs1?, Ps?, M1), listed_mates(Ts?, As?, Nm?, Rs?, Lsts?, Ps?, M2), app(M1?, M2?, M).

procedure extend_all(Bindings?, Binding?, Bindings).
extend_all([], _, []).
extend_all([B | Bs], Cs, [B1? | R?]) :- ground(Cs?) | app(B?, Cs?, B1), extend_all(Bs?, Cs?, R).

procedure fit_assigns(Integer?, Peers?, RoleSpecs?, Deltas?, Bindings).
fit_assigns(K, Q, Rs, Ps, As?) :- fit_roles(1, K?, Q?, Rs?, Ps?, [], As).

procedure fit_roles(Integer?, Integer?, Peers?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_roles(I, K, _, _, _, B, [B?]) :- (I? > K?) | true.
fit_roles(I, K, Q, Rs, Ps, B, As?) :- (I? =< K?), ground(Q?), ground(Rs?) | nth_spec(Rs?, I?, R), fit_one(Q?, I?, K?, Q?, R?, Rs?, Ps?, B?, As).

procedure fit_one(Peers?, Integer?, Integer?, Peers?, RoleSpec?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_one([], _, _, _, _, _, _, _, []).
fit_one([P | Qs], I, K, Q, R, Rs, Ps, B, As?) :- ground(P?), integer(I?), ground(Q?), ground(R?), ground(Rs?), ground(Ps?), ground(B?) | fits(R?, [b(role(I?), p(P?)) | B?], P?, Ps?, Ok), I1 := (I? + 1), fit_next(Ok?, I1?, K?, Q?, Rs?, Ps?, [b(role(I?), p(P?)) | B?], As1), fit_one(Qs?, I?, K?, Q?, R?, Rs?, Ps?, B?, As2), app(As1?, As2?, As).

procedure fit_next(YesNo?, Integer?, Integer?, Peers?, RoleSpecs?, Deltas?, Binding?, Bindings).
fit_next(no, _, _, _, _, _, _, []).
fit_next(yes, I, K, Q, Rs, Ps, B, As?) :- fit_roles(I?, K?, Q?, Rs?, Ps?, B?, As).

procedure fits(RoleSpec?, Binding?, Peer?, Deltas?, YesNo).
fits(R, B, P, Ps, Ok?) :- ground(R?) | delta_at(Ps?, P?, D, A), rs_del(R?, Dr), rs_add(R?, Ar), match_all(Dr?, D?, B?, Bs), match_all_each(Bs?, Ar?, A?, Ms), some_binding(Ms?, Ok).

procedure some_binding(Bindings?, YesNo).
some_binding([], no).
some_binding([_ | _], yes).

procedure assigns(Integer?, Peers?, Bindings).
assigns(K, Q, R?) :- assigns1(1, K?, Q?, [[]], R).

procedure assigns1(Integer?, Integer?, Peers?, Bindings?, Bindings).
assigns1(I, K, _, Acc, Acc?) :- (I? > K?) | true.
assigns1(I, K, Q, Acc, R?) :- (I? =< K?), ground(Q?) | extend_role(Acc?, I?, Q?, Acc1), I1 := (I? + 1), assigns1(I1?, K?, Q?, Acc1?, R).

procedure extend_role(Bindings?, Integer?, Peers?, Bindings).
extend_role([], _, _, []).
extend_role([B | Bs], I, Q, R?) :- ground(B?), integer(I?), ground(Q?) | extend_one(Q?, I?, B?, R1), extend_role(Bs?, I?, Q?, R2), app(R1?, R2?, R).

procedure extend_one(Peers?, Integer?, Binding?, Bindings).
extend_one([], _, _, []).
extend_one([P | Ps], I, B, [[b(role(I?), p(P?)) | B?] | R?]) :- ground(B?), integer(I?) | extend_one(Ps?, I?, B?, R).

procedure mates_assigns(Bindings?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_assigns([], _, _, _, []).
mates_assigns([B | Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | deltas_peers(Ps?, Q), role_persons(Rs?, 1, B?, Ws), all_in(Q?, Ws?, Onto), rule_spec_ok(Nm?, B?, Ok), and(Onto?, Ok?, Go), mates_assign(Go?, B?, Nm?, Rs?, Ps?, M1), mates_assigns(Bs?, Nm?, Rs?, Ps?, M2), app(M1?, M2?, M).

procedure mates_assign(YesNo?, Binding?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_assign(no, _, _, _, _, []).
mates_assign(yes, B, Nm, Rs, Ps, M?) :- ground(Rs?), ground(Ps?) | match_deltas(Ps?, Rs?, [B?], Bs), mates_check(Bs?, Nm?, Rs?, Ps?, M).

procedure match_deltas(Deltas?, RoleSpecs?, Bindings?, Bindings).
match_deltas([], _, Bs, Bs?).
match_deltas([delta(P, D, A) | Ps], Rs, Bs, R?) :- ground(P?), ground(D?), ground(A?), ground(Rs?) | match_delta(Bs?, P?, D?, A?, Rs?, Bs1), match_deltas(Ps?, Rs?, Bs1?, R).

procedure match_delta(Bindings?, Peer?, GAtoms?, GAtoms?, RoleSpecs?, Bindings).
match_delta([], _, _, _, _, []).
match_delta([B | Bs], P, D, A, Rs, R?) :- ground(B?), ground(P?), ground(D?), ground(A?), ground(Rs?) | specs_at(Rs?, 1, B?, P?, RsP), match_delta1(RsP?, B?, D?, A?, B2), match_delta(Bs?, P?, D?, A?, Rs?, R2), app(B2?, R2?, R).

procedure match_delta1(RoleSpecs?, Binding?, GAtoms?, GAtoms?, Bindings).
match_delta1(RsP, B, D, A, R?) :- ground(RsP?), ground(A?) | dels_of(RsP?, Dp), adds_of(RsP?, Ap), match_all(Dp?, D?, B?, B1), match_all_each(B1?, Ap?, A?, R).

procedure dels_of(RoleSpecs?, SAtoms).
dels_of([], []).
dels_of([R | Rs], A?) :- rs_del(R?, A1), dels_of(Rs?, A2), app(A1?, A2?, A).

procedure mates_check(Bindings?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_check([], _, _, _, []).
mates_check([B | Bs], Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | local_norm(Nm?, B?, Nb), mates_check1(Nb?, Nm?, Rs?, Ps?, M1), mates_check(Bs?, Nm?, Rs?, Ps?, M2), app(M1?, M2?, M).

procedure mates_check1(LNorm?, Constant?, RoleSpecs?, Deltas?, Mates).
mates_check1(badnorm, _, _, _, []).
mates_check1(norm(B), Nm, Rs, Ps, M?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Ps?) | sig_of(Rs?, B?, Ps1), deltas_eq(Ps?, Ps1?, E1), admissible(Rs?, B?, E2), and(E1?, E2?, E), mate_of(E?, B?, Nm?, Rs?, M).

procedure local_norm(Constant?, Binding?, LNorm).
local_norm(Nm, B, R?) :- ground(Nm?), ground(B?) | schema_numeric(Nm?, N), local_norm1(N?, Nm?, B?, R).

procedure local_norm1(Numeric?, Constant?, Binding?, LNorm).
local_norm1(numeric(_, Ls, _), Nm, B, R?) :- ground(Ls?), ground(Nm?), ground(B?) | lv_wrong(B?, Ls?, Nm?, W), locals_put(Ls?, Nm?, B?, B1), norm_or_bad(W?, B1?, R).

procedure norm_or_bad(YesNo?, Binding?, LNorm).
norm_or_bad(no, B, norm(B?)).
norm_or_bad(yes, _, badnorm).

procedure lv_wrong(Binding?, Vars?, Constant?, YesNo).
lv_wrong([], _, _, no).
lv_wrong([b(V, X) | Bs], Ls, Nm, W?) :- ground(V?), ground(X?), ground(Ls?), ground(Nm?) | mem(V?, Ls?, IsL), entry_wrong(IsL?, V?, X?, Nm?, W1), lv_wrong(Bs?, Ls?, Nm?, W2), or(W1?, W2?, W).

procedure entry_wrong(YesNo?, Var?, Val?, Constant?, YesNo).
entry_wrong(yes, V, X, Nm, W?) :- local_wrong(V?, X?, Nm?, W).
entry_wrong(no, _, X, _, W?) :- is_lv(X?, W).

procedure local_wrong(Var?, Val?, Constant?, YesNo).
local_wrong(num(Xn), X, Nm, W?) :- ground(Xn?), ground(Nm?) | same(X?, lv(Nm?, Xn?), S), neg(S?, W).
local_wrong(_, _, _, yes) :- otherwise | true.

procedure is_lv(Val?, YesNo).
is_lv(lv(_, _), yes).
is_lv(p(_), no).
is_lv(s(_), no).
is_lv(c(_), no).
is_lv(n(_), no).

procedure locals_put(Vars?, Constant?, Binding?, Binding).
locals_put([], _, B, B?).
locals_put([V | Vs], Nm, B, B2?) :- ground(V?), ground(Nm?), ground(B?) | lookup(V?, B?, F), local_put(F?, V?, Nm?, B?, B1), locals_put(Vs?, Nm?, B1?, B2).

procedure local_put(Found?, Var?, Constant?, Binding?, Binding).
local_put(free, num(X), Nm, B, [b(num(X?), lv(Nm?, X?)) | B?]) :- ground(X?), ground(Nm?) | true.
local_put(found(_), _, _, B, B?).
local_put(free, V, _, B, B?) :- otherwise, ground(V?) | true.

procedure mate_of(YesNo?, Binding?, Constant?, RoleSpecs?, Mates).
mate_of(no, _, _, _, []).
mate_of(yes, B, Nm, Rs, [mate(Nm?, B?, G?, F?)]) :- ground(B?), ground(Rs?) | guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), sort_peers(Gp?, Gs), dedup(Gs?, G), role_person(1, B?, F).

procedure dedup_mates(Mates?, Mates).
dedup_mates([], []).
dedup_mates([M | Ms], [M? | R?]) :- ground(M?) | drop_mate(M?, Ms?, Ms1), dedup_mates(Ms1?, R).

procedure drop_mate(Mate?, Mates?, Mates).
drop_mate(_, [], []).
drop_mate(mate(N, B, G, F), [mate(N1, B1, G1, F1) | Ms], R?) :- ground(N?), ground(B?), ground(G?), ground(F?), ground(N1?), ground(B1?) | same(N?, N1?, E1), ms_eq(B?, B1?, E2), and(E1?, E2?, E), drop_mate1(E?, mate(N?, B?, G?, F?), mate(N1?, B1?, G1?, F1?), Ms?, R).

procedure drop_mate1(YesNo?, Mate?, Mate?, Mates?, Mates).
drop_mate1(yes, M, _, Ms, R?) :- drop_mate(M?, Ms?, R).
drop_mate1(no, M, M1, Ms, [M1? | R?]) :- drop_mate(M?, Ms?, R).

procedure info_parts_of(Mates?, Peers?, Peer?, Parts).
info_parts_of(Ms, Q, Id, Pts?) :- ground(Ms?) | parts_of(Ms?, Ms?, Q?, Id?, [], Pts).

procedure parts_of(Mates?, Mates?, Peers?, Peer?, Mates?, Parts).
parts_of([], _, _, _, _, []).
parts_of([M | Ms], All, Q, Id, Seen, Pts?) :- ground(M?), ground(Q?), ground(Seen?) | part_seen(Seen?, M?, Q?, Old), parts_of1(Old?, M?, Ms?, All?, Q?, Id?, Seen?, Pts).

procedure parts_of1(YesNo?, Mate?, Mates?, Mates?, Peers?, Peer?, Mates?, Parts).
parts_of1(yes, _, Ms, All, Q, Id, Seen, Pts?) :- parts_of(Ms?, All?, Q?, Id?, Seen?, Pts).
parts_of1(no, mate(N, B, G, F), Ms, All, Q, Id, Seen, [pt(T?, G?, Op?) | Pts?]) :- ground(N?), ground(B?), ground(G?), ground(F?), ground(All?), ground(Q?), ground(Id?) | class_of(N?, B?, Id?, T), part_firsts(All?, mate(N?, B?, G?, F?), Q?, Fs), part_gfirsts(All?, mate(N?, B?, G?, F?), Q?, G?, Fo), part_opener(G?, Fs?, Fo?, Op), parts_of(Ms?, All?, Q?, Id?, [mate(N?, B?, G?, F?) | Seen?], Pts).

procedure part_seen(Mates?, Mate?, Peers?, YesNo).
part_seen([], _, _, no).
part_seen([S | Ss], M, Q, B?) :- ground(M?), ground(Q?) | same_mpart(Q?, S?, M?, B1), part_seen1(B1?, Ss?, M?, Q?, B).

procedure part_seen1(YesNo?, Mates?, Mate?, Peers?, YesNo).
part_seen1(yes, _, _, _, yes).
part_seen1(no, Ss, M, Q, B?) :- part_seen(Ss?, M?, Q?, B).

procedure part_firsts(Mates?, Mate?, Peers?, Peers).
part_firsts([], _, _, []).
part_firsts([mate(N, B, G, F) | Ms], M, Q, Fs?) :- ground(F?), ground(M?), ground(Q?) | same_mpart(Q?, mate(N?, B?, G?, F?), M?, S), part_firsts(Ms?, M?, Q?, Fs1), keep_peer(S?, F?, Fs1?, Fs).

procedure part_gfirsts(Mates?, Mate?, Peers?, Peers?, Peers).
part_gfirsts([], _, _, _, []).
part_gfirsts([mate(N, B, G1, F) | Ms], M, Q, G, Fs?) :- ground(N?), ground(F?), ground(M?), ground(Q?), ground(G?) | same_mpart(Q?, mate(N?, B?, G1?, F?), M?, S), opens_guarded(N?, O), mem(F?, G?, InG), neg(InG?, NotG), and(S?, O?, S1), and(S1?, NotG?, K), part_gfirsts(Ms?, M?, Q?, G?, Fs1), keep_peer(K?, F?, Fs1?, Fs).

procedure opens_guarded(Constant?, YesNo).
opens_guarded(Nm, B?) :- schema_entry(Nm?, E), opens_guarded1(E?, B).

procedure opens_guarded1(Schema?, YesNo).
opens_guarded1(schema(_, _, _), no).
opens_guarded1(lschema(_, _, _, []), no).
opens_guarded1(lschema(_, _, Rs, [listing(_, Bi, _, _) | _]), B?) :- ground(Rs?), integer(Bi?) | nth_spec(Rs?, Bi?, R), spec_unguarded(R?, B).

procedure spec_unguarded(RoleSpec?, YesNo).
spec_unguarded(rs(unguarded, _, _, _, _), yes).
spec_unguarded(rs(guarded, _, _, _, _), no).

procedure part_opener(Peers?, Peers?, Peers?, Opener).
part_opener([], Fs, _, Op?) :- sort_peers(Fs?, Ss), least_opener(Ss?, Op).
part_opener([_ | _], _, Fo, Op?) :- sort_peers(Fo?, Ss), least_opener(Ss?, Op).

procedure least_opener(Peers?, Opener).
least_opener([P | _], opener(P?)).
least_opener([], guarded_part).

procedure same_mpart(Peers?, Mate?, Mate?, YesNo).
same_mpart(Q, mate(N1, B1, G1, _), mate(N2, B2, G2, _), B?) :- same_bpart(Q?, N1?, B1?, G1?, N2?, B2?, G2?, B).

procedure in_class(RoleSpecs?, Binding?, Deltas?, Deltas?, Peers?, Mates?, YesNo).
in_class(Rs, B, Ps, Ps1, Q, Ms, R?) :- deltas_eq(Ps?, Ps1?, E), in_class1(E?, Rs?, B?, Q?, Ms?, R).

procedure in_class1(YesNo?, RoleSpecs?, Binding?, Peers?, Mates?, YesNo).
in_class1(no, _, _, _, _, no).
in_class1(yes, Rs, B, Q, Ms, R?) :- reflexive_preds(Rf), linked_any(Ms?, Rs?, B?, Q?, Rf?, R).

procedure linked_any(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any([], _, _, _, _, no).
linked_any([mate(N, B2, _, _) | Ms], Rs, B, Q, Rf, L?) :- ground(Rs?), ground(B?), ground(B2?), ground(Q?), ground(Rf?) | bound_spec(N?, B2?, Rs2), linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L1), linked_any1(L1?, Ms?, Rs?, B?, Q?, Rf?, L).

procedure linked_any1(YesNo?, Mates?, RoleSpecs?, Binding?, Peers?, Preds?, YesNo).
linked_any1(yes, _, _, _, _, _, yes).
linked_any1(no, Ms, Rs, B, Q, Rf, L?) :- linked_any(Ms?, Rs?, B?, Q?, Rf?, L).

procedure class_mates(Constant?, Binding?, Mates?, Peers?, Preds?, Mates).
class_mates(Nm, B, Ms, Q, Rf, Cls?) :- ground(Nm?), ground(B?), ground(Ms?) | bound_spec(Nm?, B?, Rs), mate_of(yes, B?, Nm?, Rs?, M0), grow(M0?, Ms?, Q?, Rf?, [], In), keep_mates(Ms?, In?, Cls).

procedure grow(Mates?, Mates?, Peers?, Preds?, Mates?, Mates).
grow([], _, _, _, Done, Done?).
grow([mate(N, B, G, F) | Fs], Rest, Q, Rf, Done, Out?) :- ground(N?), ground(B?), ground(Rest?), ground(Q?), ground(Rf?) | bound_spec(N?, B?, Rs), split_linked(Rest?, Rs?, B?, Q?, Rf?, New, Keep), app(Fs?, New?, Fs1), grow(Fs1?, Keep?, Q?, Rf?, [mate(N?, B?, G?, F?) | Done?], Out).

procedure split_linked(Mates?, RoleSpecs?, Binding?, Peers?, Preds?, Mates, Mates).
split_linked([], _, _, _, _, [], []).
split_linked([mate(N2, B2, G2, F2) | Ms], Rs, B, Q, Rf, New?, Keep?) :- ground(N2?), ground(B2?), ground(Rs?), ground(B?), ground(Q?), ground(Rf?) | bound_spec(N2?, B2?, Rs2), linked(Q?, Rs?, B?, Rs2?, B2?, Rf?, L), split_linked(Ms?, Rs?, B?, Q?, Rf?, New1, Keep1), split_one(L?, mate(N2?, B2?, G2?, F2?), New1?, Keep1?, New, Keep).

procedure split_one(YesNo?, Mate?, Mates?, Mates?, Mates, Mates).
split_one(yes, M, New, Keep, [M? | New?], Keep?).
split_one(no, M, New, Keep, New?, [M? | Keep?]).

procedure keep_mates(Mates?, Mates?, Mates).
keep_mates([], _, []).
keep_mates([M | Ms], In, R?) :- ground(M?), ground(In?) | mem(M?, In?, B), keep_mates(Ms?, In?, R1), keep_mate(B?, M?, R1?, R).

procedure keep_mate(YesNo?, Mate?, Mates?, Mates).
keep_mate(yes, M, R, [M? | R?]).
keep_mate(no, _, R, R?).

procedure live_mates(Mates?, Peers?, Preds?, Mates).
live_mates([], _, _, []).
live_mates([mate(N, B, G, F) | Ms], Q, Rf, R?) :- ground(N?), ground(B?), ground(Q?), ground(Rf?) | bound_spec(N?, B?, Rs), live_at(Q?, Rs?, B?, Rf?, L0), con_live(N?, B?, Lc), and(L0?, Lc?, L), live_mates(Ms?, Q?, Rf?, R1), keep_mate(L?, mate(N?, B?, G?, F?), R1?, R).

procedure live_at(Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at([], _, _, _, yes).
live_at([P | Ps], Rs, B, Rf, Ok?) :- ground(P?), ground(Rs?), ground(B?), ground(Rf?) | reqs_at(Rs?, B?, P?, Rf?, R), forbs_at(Rs?, B?, P?, F), live_one(R?, F?, P?, Rf?, Ok1), live_at1(Ok1?, Ps?, Rs?, B?, Rf?, Ok).

procedure live_at1(YesNo?, Peers?, RoleSpecs?, Binding?, Preds?, YesNo).
live_at1(no, _, _, _, _, no).
live_at1(yes, Ps, Rs, B, Rf, Ok?) :- live_at(Ps?, Rs?, B?, Rf?, Ok).

procedure live_one(CAtoms?, CAtoms?, Peer?, Preds?, YesNo).
live_one(R, F, P, Rf, Ok?) :- ground(F?) | ms_meets(R?, F?, M1), own_reflexive_in(F?, P?, Rf?, M2), or(M1?, M2?, M), neg(M?, Ok).

procedure linked(Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked([], _, _, _, _, _, yes).
linked([P | Ps], Rs1, B1, Rs2, B2, Rf, L?) :- ground(P?), ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?) | reqs_at(Rs1?, B1?, P?, Rf?, R1), reqs_at(Rs2?, B2?, P?, Rf?, R2), forbs_at(Rs1?, B1?, P?, F1), forbs_at(Rs2?, B2?, P?, F2), bound_cs(R1?, Rb1), bound_cs(R2?, Rb2), ms_meets(Rb1?, F2?, C1), ms_meets(Rb2?, F1?, C2), or(C1?, C2?, C), linked1(C?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

procedure linked1(YesNo?, Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
linked1(yes, _, _, _, _, _, _, no).
linked1(no, Ps, Rs1, B1, Rs2, B2, Rf, L?) :- linked(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, L).

procedure reqs_at(RoleSpecs?, Binding?, Peer?, Preds?, CAtoms).
reqs_at(Rs, B, P, Rf, R?) :- ground(B?), ground(P?) | specs_at(Rs?, 1, B?, P?, RsP), reqs_of(RsP?, Q), cimg_atoms(Q?, B?, R0), drop_own_reflexive(R0?, P?, Rf?, R).

procedure forbs_at(RoleSpecs?, Binding?, Peer?, CAtoms).
forbs_at(Rs, B, P, F?) :- ground(B?) | specs_at(Rs?, 1, B?, P?, RsP), forbs_of(RsP?, Fs), cimg_atoms(Fs?, B?, F).

procedure forbs_of(RoleSpecs?, SAtoms).
forbs_of([], []).
forbs_of([R | Rs], F?) :- rs_forb(R?, F1), forbs_of(Rs?, F2), app(F1?, F2?, F).

procedure drop_own_reflexive(CAtoms?, Peer?, Preds?, CAtoms).
drop_own_reflexive([], _, _, []).
drop_own_reflexive([A | As], P, Rf, R?) :- ground(A?), ground(P?), ground(Rf?) | own_atom(A?, P?, Rf?, Own), drop_own_reflexive(As?, P?, Rf?, R1), keep_c(Own?, A?, R1?, R).

procedure own_reflexive_in(CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in([], _, _, no).
own_reflexive_in([A | As], P, Rf, B?) :- ground(P?), ground(Rf?) | own_atom(A?, P?, Rf?, B1), own_reflexive_in1(B1?, As?, P?, Rf?, B).

procedure own_reflexive_in1(YesNo?, CAtoms?, Peer?, Preds?, YesNo).
own_reflexive_in1(yes, _, _, _, yes).
own_reflexive_in1(no, As, P, Rf, B?) :- own_reflexive_in(As?, P?, Rf?, B).

procedure own_atom(CAtom?, Peer?, Preds?, YesNo).
own_atom(cmp_atom(N, [cmp_val(p(Q))]), P, Rf, B?) :- (Q? =?= P?) | mem(N?, Rf?, B).
own_atom(_, _, _, no) :- otherwise | true.

procedure bound_cs(CAtoms?, CAtoms).
bound_cs([], []).
bound_cs([A | As], R?) :- ground(A?) | has_free(A?, Fr), bound_cs(As?, R1), keep_c(Fr?, A?, R1?, R).

procedure has_free(CAtom?, YesNo).
has_free(cmp_atom(_, Xs), B?) :- has_free1(Xs?, B).

procedure has_free1(CVals?, YesNo).
has_free1([], no).
has_free1([cmp_free(_) | _], yes).
has_free1([cmp_val(_) | Xs], B?) :- has_free1(Xs?, B).

procedure keep_c(YesNo?, CAtom?, CAtoms?, CAtoms).
keep_c(no, A, R, [A? | R?]).
keep_c(yes, _, R, R?).

procedure cimg_atoms(SAtoms?, Binding?, CAtoms).
cimg_atoms([], _, []).
cimg_atoms([A | As], B, Cs?) :- ground(B?) | cimg_one(A?, B?, C1), cimg_atoms(As?, B?, C2), app(C1?, C2?, Cs).

procedure cimg_one(SAtom?, Binding?, CAtoms).
cimg_one(atom(P, Vs), B, [cmp_atom(P?, Xs?)]) :- cimg_args(Vs?, B?, Xs).
cimg_one(times(V, A), B, Cs?) :- ground(B?) | num_of(V?, B?, K), cimg_one(A?, B?, C1), copies(K?, C1?, Cs).

procedure cimg_args(Vars?, Binding?, CVals).
cimg_args([], _, []).
cimg_args([sgn(Y, I) | Vs], B, [X? | Xs?]) :- ground(B?), ground(Y?), ground(I?) | lookup(svar(Y?), B?, F), role_person(I?, B?, P), cimg_sgn(F?, P?, sgn(Y?, I?), X), cimg_args(Vs?, B?, Xs).
cimg_args([num(X) | Vs], B, [cmp_val(n(N?)) | Xs?]) :- integer(X?) | N := X?, cimg_args(Vs?, B?, Xs).
cimg_args([nterm(N) | Vs], B, [X? | Xs?]) :- ground(B?), ground(N?) | nt_vars(N?, Ws), vars_bound(Ws?, B?, Bd), cimg_name(Bd?, N?, B?, X), cimg_args(Vs?, B?, Xs).
cimg_args([V | Vs], B, [X? | Xs?]) :- otherwise, ground(B?), ground(V?) | lookup(V?, B?, F), cimg_val(F?, V?, X), cimg_args(Vs?, B?, Xs).

procedure cimg_val(Found?, Var?, CVal).
cimg_val(found(X), _, cmp_val(X?)).
cimg_val(free, V, cmp_free(V?)).

procedure cimg_name(YesNo?, NTerm?, Binding?, CVal).
cimg_name(yes, N, B, cmp_val(c(C?))) :- nt_img(N?, B?, C).
cimg_name(no, N, _, cmp_free(nterm(N?))).

procedure cimg_sgn(Found?, Peer?, Var?, CVal).
cimg_sgn(found(s(S)), P, _, cmp_val(s(speech(S?, P?)))).
cimg_sgn(_, _, V, cmp_free(V?)) :- otherwise | true.

procedure bound_spec(Constant?, Binding?, RoleSpecs).
bound_spec(Nm, B, Rs?) :- schema_entry(Nm?, E), bound_spec1(E?, B?, Rs).

procedure bound_spec1(Schema?, Binding?, RoleSpecs).
bound_spec1(schema(_, _, Rs), _, Rs?).
bound_spec1(lschema(_, _, Rs, Lsts), B, Rs1?) :- ground(Rs?), ground(B?), ground(Lsts?) | lists_of(Lsts?, B?, Ls), spec_for(Rs?, Lsts?, Ls?, Rs1).

procedure lists_of(Listings?, Binding?, PeerLists).
lists_of([], _, []).
lists_of([listing(I, _, _, _) | Lsts], B, [L? | Ls?]) :- ground(B?) | copies_of(B?, I?, L), lists_of(Lsts?, B?, Ls).

procedure spec_for(RoleSpecs?, Listings?, PeerLists?, RoleSpecs).
spec_for(Rs, Lsts, Ls, Rs1?) :- ground(Rs?), ground(Lsts?) | blank_listed(Lsts?, Rs?, Rs0), listed_copies(Lsts?, Ls?, Rs?, Cs), app(Rs0?, Cs?, Rs1).

procedure blank_listed(Listings?, RoleSpecs?, RoleSpecs).
blank_listed([], Rs, Rs?).
blank_listed([listing(I, _, _, _) | Lsts], Rs, Rs2?) :- blank_at(Rs?, I?, 1, Rs1), blank_listed(Lsts?, Rs1?, Rs2).

procedure listed_copies(Listings?, PeerLists?, RoleSpecs?, RoleSpecs).
listed_copies([], _, _, []).
listed_copies([listing(I, _, _, _) | Lsts], [L | Ls], Rs, Cs?) :- ground(Rs?) | nth_spec(Rs?, I?, R), spec_copies(L?, R?, C1), listed_copies(Lsts?, Ls?, Rs?, C2), app(C1?, C2?, Cs).
listed_copies([_ | _], [], _, []).

procedure blank_at(RoleSpecs?, Integer?, Integer?, RoleSpecs).
blank_at([], _, _, []).
blank_at([R | Rs], I, J, [X? | Xs?]) :- integer(I?), integer(J?) | blank_one(I?, J?, R?, X), J1 := (J? + 1), blank_at(Rs?, I?, J1?, Xs).

procedure blank_one(Integer?, Integer?, RoleSpec?, RoleSpec).
blank_one(I, J, _, rs(unguarded, [], [], [], [])) :- (I? =:= J?) | true.
blank_one(_, _, R, R?) :- otherwise | true.

procedure spec_copies(Peers?, RoleSpec?, RoleSpecs).
spec_copies([], _, []).
spec_copies([_ | Ps], R, [R? | Rs?]) :- ground(R?) | spec_copies(Ps?, R?, Rs).

procedure copies_of(Binding?, Integer?, List(Peer)).
copies_of(B, I, L?) :- ground(B?), integer(I?) | NI := (0 - I?), neg_people(B?, NI?, Ps0), sort_peers(Ps0?, Ps1), dedup(Ps1?, L).

procedure neg_people(Binding?, Integer?, Peers).
neg_people([], _, []).
neg_people([b(role(J), p(Q)) | Bs], NI, [Q? | Ps?]) :- (J? =:= NI?) | neg_people(Bs?, NI?, Ps).
neg_people([_ | Bs], NI, Ps?) :- otherwise | neg_people(Bs?, NI?, Ps).

procedure listed_binding(Constant?, Binding?, PeerLists?, Binding).
listed_binding(Nm, B0, Ls, B?) :- schema_entry(Nm?, E), listed_binding1(E?, B0?, Ls?, B).

procedure listed_binding1(Schema?, Binding?, PeerLists?, Binding).
listed_binding1(schema(_, _, _), B0, _, B0?).
listed_binding1(lschema(_, _, Rs, Lsts), B0, Ls, B?) :- ground(Rs?), ground(B0?), ground(Lsts?) | rs_len(Rs?, K), base_binds(Lsts?, B0?, Bb), sorted_lists(Ls?, Ls1), K1 := (K? + 1), tuple_binds(Lsts?, Ls1?, K1?, Cs), app(Bb?, Cs?, Bc), app(B0?, Bc?, B).

procedure base_binds(Listings?, Binding?, Binding).
base_binds([], _, []).
base_binds([listing(I, Bi, _, _) | Lsts], B0, [b(role(I?), p(P?)) | Bs?]) :- ground(B0?) | role_person(Bi?, B0?, P), base_binds(Lsts?, B0?, Bs).

procedure sorted_lists(PeerLists?, PeerLists).
sorted_lists([], []).
sorted_lists([L | Ls], [L1? | Ls1?]) :- sort_peers(L?, L0), dedup(L0?, L1), sorted_lists(Ls?, Ls1).

procedure tuple_binds(Listings?, PeerLists?, Integer?, Binding).
tuple_binds([], _, _, []).
tuple_binds([listing(I, _, _, _) | Lsts], [L | Ls], J, Bs?) :- ground(L?), integer(I?) | copy_binds(L?, J?, Cs, J1), NI := (0 - I?), neg_binds(L?, NI?, Ns), tuple_binds(Lsts?, Ls?, J1?, Bs1), app(Ns?, Bs1?, Bs2), app(Cs?, Bs2?, Bs).
tuple_binds([_ | _], [], _, []).

procedure copy_binds(Peers?, Integer?, Binding, Integer).
copy_binds([], J, [], J?).
copy_binds([Q | Qs], J, [b(role(J?), p(Q?)) | Bs?], J2?) :- integer(J?) | J1 := (J? + 1), copy_binds(Qs?, J1?, Bs, J2).

procedure neg_binds(Peers?, Integer?, Binding).
neg_binds([], _, []).
neg_binds([Q | Qs], NI, [b(role(NI?), p(Q?)) | Bs?]) :- integer(NI?) | neg_binds(Qs?, NI?, Bs).

procedure listed_people(Constant?, Binding?, GAtoms?, PeerLists).
listed_people(Nm, B0, S, Ls?) :- schema_entry(Nm?, E), listed_people1(E?, B0?, S?, Ls).

procedure listed_people1(Schema?, Binding?, GAtoms?, PeerLists).
listed_people1(schema(_, _, _), _, _, []).
listed_people1(lschema(_, _, _, Lsts), B0, S, Ls?) :- lists_at(Lsts?, B0?, S?, Ls).

procedure lists_at(Listings?, Binding?, GAtoms?, PeerLists).
lists_at([], _, _, []).
lists_at([listing(_, _, Rho, As) | Lsts], B0, S, [L? | Ls?]) :- ground(B0?), ground(S?) | list_at(Rho?, As?, B0?, S?, L), lists_at(Lsts?, B0?, S?, Ls).

procedure list_at(Constant?, Vars?, Binding?, GAtoms?, List(Peer)).
list_at(Rho, As, B0, S, L?) :- ground(As?), ground(B0?), ground(S?) | img_args(As?, B0?, Vs), listing_in(S?, Rho?, Vs?, Ps0), sort_peers(Ps0?, Ps1), dedup(Ps1?, L).

procedure listing_in(GAtoms?, Constant?, Vals?, Peers).
listing_in([], _, _, []).
listing_in([g(F, [p(Q) | Xs]) | Gs], Rho, Vs, Ps?) :- ground(F?), ground(Xs?), ground(Rho?), ground(Vs?) | same(F?, Rho?, E1), same(Xs?, Vs?, E2), and(E1?, E2?, E), listing_in(Gs?, Rho?, Vs?, Ps1), keep_peer(E?, Q?, Ps1?, Ps).
listing_in([_ | Gs], Rho, Vs, Ps?) :- otherwise | listing_in(Gs?, Rho?, Vs?, Ps).

procedure listed_class(Constant?, Binding?, GAtoms?, Class).
listed_class(Nm, B0, S, C?) :- ground(Nm?), ground(B0?) | listed_people(Nm?, B0?, S?, Ls), listed_binding(Nm?, B0?, Ls?, B), role_person(1, B0?, D), class_of(Nm?, B?, D?, C).

procedure listing_ok(Constant?, Binding?, Peer?, GAtoms?, YesNo).
listing_ok(Nm, B, Id, S, Ok?) :- schema_entry(Nm?, E), listing_ok1(E?, B?, Id?, S?, Ok).

procedure listing_ok1(Schema?, Binding?, Peer?, GAtoms?, YesNo).
listing_ok1(schema(_, _, _), _, _, _, yes).
listing_ok1(lschema(_, _, _, Lsts), B, Id, S, Ok?) :- listings_ok(Lsts?, B?, Id?, S?, Ok).

procedure listings_ok(Listings?, Binding?, Peer?, GAtoms?, YesNo).
listings_ok([], _, _, _, yes).
listings_ok([listing(I, Bi, Rho, As) | Lsts], B, Id, S, Ok?) :- ground(B?), ground(Id?), ground(S?) | role_person(Bi?, B?, P), same(P?, Id?, Base), listing_one(Base?, I?, Rho?, As?, B?, S?, Ok1), listings_ok1(Ok1?, Lsts?, B?, Id?, S?, Ok).

procedure listing_one(YesNo?, Integer?, Constant?, Vars?, Binding?, GAtoms?, YesNo).
listing_one(no, _, _, _, _, _, yes).
listing_one(yes, I, Rho, As, B, S, Ok?) :- ground(B?) | copies_of(B?, I?, L), list_at(Rho?, As?, B?, S?, L1), same(L?, L1?, Ok).

procedure listings_ok1(YesNo?, Listings?, Binding?, Peer?, GAtoms?, YesNo).
listings_ok1(no, _, _, _, _, no).
listings_ok1(yes, Lsts, B, Id, S, Ok?) :- listings_ok(Lsts?, B?, Id?, S?, Ok).

procedure rule_spec_ok(Constant?, Binding?, YesNo).
rule_spec_ok(Nm, B, Ok?) :- schema_entry(Nm?, E), rule_spec(E?, Rs0), rule_ok(Rs0?, B?, Ok).

procedure rule_spec(Schema?, RoleSpecs).
rule_spec(schema(_, _, Rs), Rs?).
rule_spec(lschema(_, _, Rs, Lsts), Rs0?) :- blank_listed(Lsts?, Rs?, Rs0).

procedure term_spec(Class?, Constant, RoleSpecs, Binding).
term_spec(C, Nm?, Rs?, B?) :- ground(C?) | binding_of(C?, Nm0, B0), term_spec1(Nm0?, B0?, Nm, Rs, B).

procedure term_spec1(Constant?, Binding?, Constant, RoleSpecs, Binding).
term_spec1(Nm0, B0, Nm0?, Rs?, B0?) :- ground(Nm0?), ground(B0?) | bound_spec(Nm0?, B0?, Rs).

procedure nth_spec(RoleSpecs?, Integer?, RoleSpec).
nth_spec([], _, rs(unguarded, [], [], [], [])).
nth_spec([R | _], I, R?) :- (I? =:= 1) | true.
nth_spec([_ | Rs], I, R?) :- (I? > 1) | I1 := (I? - 1), nth_spec(Rs?, I1?, R).

procedure rs_len(RoleSpecs?, Integer).
rs_len([], 0).
rs_len([_ | Rs], N?) :- rs_len(Rs?, M), N := (M? + 1).

procedure rs_add(RoleSpec?, SAtoms).
rs_add(rs(_, A, _, _, _), A?).

procedure rs_del(RoleSpec?, SAtoms).
rs_del(rs(_, _, D, _, _), D?).

procedure rs_req(RoleSpec?, SAtoms).
rs_req(rs(_, _, D, K, _), R?) :- app(K?, D?, R).

procedure rs_forb(RoleSpec?, SAtoms).
rs_forb(rs(_, _, _, _, F), F?).

procedure role_person(Integer?, Binding?, Peer).
role_person(I, B, P?) :- lookup(role(I?), B?, F), found_peer(F?, P).

procedure found_peer(Found?, Peer).
found_peer(found(p(P)), P?).
found_peer(found(s(_)), unbound).
found_peer(found(c(_)), unbound).
found_peer(found(n(_)), unbound).
found_peer(found(lv(_, _)), unbound).
found_peer(free, unbound).

procedure lookup(Var?, Binding?, Found).
lookup(_, [], free).
lookup(V, [b(W, X) | _], found(X?)) :- (V? =?= W?) | true.
lookup(V, [_ | Bs], F?) :- otherwise | lookup(V?, Bs?, F).

procedure img_atoms(SAtoms?, Binding?, GAtoms).
img_atoms([], _, []).
img_atoms([A | As], B, Gs?) :- ground(B?) | img_one(A?, B?, G1), img_atoms(As?, B?, G2), app(G1?, G2?, Gs).

procedure img_one(SAtom?, Binding?, GAtoms).
img_one(atom(P, Vs), B, [g(P?, Xs?)]) :- img_args(Vs?, B?, Xs).
img_one(times(V, A), B, Gs?) :- ground(B?) | num_of(V?, B?, K), img_one(A?, B?, G1), copies(K?, G1?, Gs).

procedure(X) copies(NumRes?, Stream(X)?, Stream(X)).
copies(num_is(K), G, Gs?) :- (K? > 0), ground(G?) | K1 := (K? - 1), copies(num_is(K1?), G?, Gs1), app(G?, Gs1?, Gs).
copies(num_is(K), _, []) :- (K? =< 0) | true.
copies(no_num, G, G?).

procedure img_atom(SAtom?, Binding?, GAtom).
img_atom(atom(P, Vs), B, g(P?, Xs?)) :- img_args(Vs?, B?, Xs).
img_atom(times(_, A), B, G?) :- img_atom(A?, B?, G).

procedure img_args(Vars?, Binding?, Vals).
img_args([], _, []).
img_args([sgn(Y, I) | Vs], B, [X? | Xs?]) :- ground(B?), ground(Y?), ground(I?) | lookup(svar(Y?), B?, F), role_person(I?, B?, P), img_sgn(F?, P?, X), img_args(Vs?, B?, Xs).
img_args([nterm(N) | Vs], B, [c(C?) | Xs?]) :- ground(B?), ground(N?) | nt_img(N?, B?, C), img_args(Vs?, B?, Xs).
img_args([num(X) | Vs], B, [n(N?) | Xs?]) :- integer(X?) | N := X?, img_args(Vs?, B?, Xs).
img_args([V | Vs], B, [X? | Xs?]) :- otherwise, ground(B?) | lookup(V?, B?, F), img_val(F?, X), img_args(Vs?, B?, Xs).

procedure nt_img(NTerm?, Binding?, CName).
nt_img(own(I), B, community(P?)) :- role_person(I?, B?, P).
nt_img(own_var(X), B, community(P?)) :- val_peer(pvar(X?), B?, unbound, P).
nt_img(ext(N, Y), B, dot(C?, S?)) :- ground(B?) | nt_img(N?, B?, C), val_speech(svar(Y?), B?, unbound, S).

procedure nt_vars(NTerm?, Vars).
nt_vars(own(I), [role(I?)]).
nt_vars(own_var(X), [pvar(X?)]).
nt_vars(ext(N, Y), Vs?) :- nt_vars(N?, Vs0), app(Vs0?, [svar(Y?)], Vs).

procedure flat_names(Vars?, Vars).
flat_names([], []).
flat_names([nterm(N) | Vs], R?) :- nt_vars(N?, Ws), flat_names(Vs?, R1), app(Ws?, R1?, R).
flat_names([V | Vs], [V? | R?]) :- otherwise | flat_names(Vs?, R).

procedure img_val(Found?, Val).
img_val(found(X), X?).
img_val(free, p(unbound)).

procedure img_sgn(Found?, Peer?, Val).
img_sgn(found(s(S)), P, s(speech(S?, P?))).
img_sgn(_, _, p(unbound)) :- otherwise | true.

procedure atom_bound(SAtom?, Binding?, YesNo).
atom_bound(atom(_, Vs), B, R?) :- vars_bound(Vs?, B?, R).
atom_bound(times(_, A), B, R?) :- atom_bound(A?, B?, R).

procedure vars_bound(Vars?, Binding?, YesNo).
vars_bound([], _, yes).
vars_bound([num(X) | Vs], B, R?) :- integer(X?) | vars_bound(Vs?, B?, R).
vars_bound([nterm(N) | Vs], B, R?) :- ground(N?) | nt_vars(N?, Ws), app(Ws?, Vs?, Vs1), vars_bound(Vs1?, B?, R).
vars_bound([V | Vs], B, R?) :- otherwise, ground(B?) | lookup(V?, B?, F), vars_bound1(F?, Vs?, B?, R).

procedure vars_bound1(Found?, Vars?, Binding?, YesNo).
vars_bound1(free, _, _, no).
vars_bound1(found(_), Vs, B, R?) :- vars_bound(Vs?, B?, R).

procedure match_all(SAtoms?, GAtoms?, Binding?, Bindings).
match_all([], _, B, [B?]).
match_all([A | As], Gs, B, R?) :- ground(Gs?) | match_into(A?, Gs?, B?, Bs0), dedup(Bs0?, Bs), match_all_each(Bs?, As?, Gs?, R).

procedure match_all_each(Bindings?, SAtoms?, GAtoms?, Bindings).
match_all_each([], _, _, []).
match_all_each([B | Bs], As, Gs, R?) :- ground(As?), ground(Gs?) | match_all(As?, Gs?, B?, R1), match_all_each(Bs?, As?, Gs?, R2), app(R1?, R2?, R).

procedure match_into(SAtom?, GAtoms?, Binding?, Bindings).
match_into(times(V, A), Gs, B, R?) :- ground(V?), ground(A?), ground(Gs?), ground(B?) | match_into(A?, Gs?, B?, Bs), count_bind(Bs?, V?, A?, Gs?, R).
match_into(_, [], _, []).
match_into(A, [G | Gs], B, R?) :- ground(A?), ground(B?) | match_atom(A?, G?, B?, M), match_into1(M?, A?, Gs?, B?, R).

procedure match_into1(Match?, SAtom?, GAtoms?, Binding?, Bindings).
match_into1(match(B1), A, Gs, B, [B1? | R?]) :- match_into(A?, Gs?, B?, R).
match_into1(nomatch, A, Gs, B, R?) :- match_into(A?, Gs?, B?, R).

procedure match_atom(SAtom?, GAtom?, Binding?, Match).
match_atom(atom(P, Vs), g(Q, Xs), B, R?) :- (P? =?= Q?) | match_args(Vs?, Xs?, B?, R).
match_atom(_, _, _, nomatch) :- otherwise | true.

procedure match_args(Vars?, Vals?, Binding?, Match).
match_args([], [], B, match(B?)).
match_args([], [_ | _], _, nomatch).
match_args([_ | _], [], _, nomatch).
match_args([sgn(Y, I) | Vs], [X | Xs], B, R?) :- ground(Y?), ground(I?), ground(X?), ground(B?) | sgn_parts(X?, Ps), match_sgn(Ps?, Y?, I?, Vs?, Xs?, B?, R).
match_args([nterm(N) | Vs], [X | Xs], B, R?) :- ground(N?), ground(X?), ground(B?) | name_parts(N?, X?, Ps), match_name(Ps?, Vs?, Xs?, B?, R).
match_args([num(X) | Vs], [Y | Ys], B, R?) :- integer(X?), ground(Y?), ground(B?) | lit_val(X?, Y?, E), lit_then(E?, Vs?, Ys?, B?, R).
match_args([V | Vs], [X | Xs], B, R?) :- otherwise, ground(V?), ground(X?), ground(B?) | lookup(V?, B?, F), kind_ok(V?, X?, K), match_one(F?, K?, V?, X?, Vs?, Xs?, B?, R).

procedure lit_val(Integer?, Val?, YesNo).
lit_val(X, n(K), yes) :- (X? =:= K?) | true.
lit_val(_, _, no) :- otherwise | true.

procedure lit_then(YesNo?, Vars?, Vals?, Binding?, Match).
lit_then(yes, Vs, Ys, B, R?) :- match_args(Vs?, Ys?, B?, R).
lit_then(no, _, _, _, nomatch).

procedure count_bind(Bindings?, Var?, SAtom?, GAtoms?, Bindings).
count_bind([], _, _, _, []).
count_bind([B | Bs], V, A, Gs, [B1? | R?]) :- ground(B?), ground(V?), ground(A?), ground(Gs?) | num_of(V?, B?, K), count_bind1(K?, V?, A?, Gs?, B?, B1), count_bind(Bs?, V?, A?, Gs?, R).

procedure count_bind1(NumRes?, Var?, SAtom?, GAtoms?, Binding?, Binding).
count_bind1(num_is(_), _, _, _, B, B?).
count_bind1(no_num, V, A, Gs, B, [b(V?, n(N?)) | B?]) :- ground(B?), ground(V?) | img_atom(A?, B?, G), count_g(G?, Gs?, N).

procedure count_g(GAtom?, GAtoms?, Integer).
count_g(_, [], 0).
count_g(G, [H | Hs], N?) :- (G? =?= H?) | count_g(G?, Hs?, M), N := (M? + 1).
count_g(G, [_ | Hs], N?) :- otherwise | count_g(G?, Hs?, N).

procedure name_parts(NTerm?, Val?, NameParts).
name_parts(N, c(C), Ps?) :- nt_parts(N?, C?, Ps).
name_parts(_, p(_), noparts).
name_parts(_, s(_), noparts).
name_parts(_, n(_), noparts).
name_parts(_, lv(_, _), noparts).

procedure nt_parts(NTerm?, CName?, NameParts).
nt_parts(own(I), community(P), parts([role(I?)], [p(P?)])).
nt_parts(own_var(X), community(P), parts([pvar(X?)], [p(P?)])).
nt_parts(ext(N, Y), dot(C, S), Ps?) :- nt_parts(N?, C?, Ps0), nt_more(Ps0?, Y?, S?, Ps).
nt_parts(_, _, noparts) :- otherwise | true.

procedure nt_more(NameParts?, Constant?, Speech?, NameParts).
nt_more(parts(Vs, Xs), Y, S, parts(Vs1?, Xs1?)) :- app(Vs?, [svar(Y?)], Vs1), app(Xs?, [s(S?)], Xs1).
nt_more(noparts, _, _, noparts).

procedure match_name(NameParts?, Vars?, Vals?, Binding?, Match).
match_name(parts(Ws, Ys), Vs, Xs, B, R?) :- app(Ws?, Vs?, Vs1), app(Ys?, Xs?, Xs1), match_args(Vs1?, Xs1?, B?, R).
match_name(noparts, _, _, _, nomatch).

procedure sgn_parts(Val?, SgnParts).
sgn_parts(s(speech(speech(U, Q), P)), signed(s(speech(U?, Q?)), P?)).
sgn_parts(s(speech(utterance(_), _)), unsigned).
sgn_parts(p(_), unsigned).
sgn_parts(c(_), unsigned).
sgn_parts(n(_), unsigned).
sgn_parts(lv(_, _), unsigned).

procedure match_sgn(SgnParts?, Constant?, Integer?, Vars?, Vals?, Binding?, Match).
match_sgn(signed(S, P), Y, I, Vs, Xs, B, R?) :- match_args([svar(Y?), role(I?) | Vs?], [S?, p(P?) | Xs?], B?, R).
match_sgn(unsigned, _, _, _, _, _, nomatch).

procedure match_one(Found?, YesNo?, Var?, Val?, Vars?, Vals?, Binding?, Match).
match_one(found(W), _, _, X, Vs, Xs, B, R?) :- (W? =?= X?) | match_args(Vs?, Xs?, B?, R).
match_one(found(_), _, _, _, _, _, _, nomatch) :- otherwise | true.
match_one(free, yes, V, X, Vs, Xs, B, R?) :- match_args(Vs?, Xs?, [b(V?, X?) | B?], R).
match_one(free, no, _, _, _, _, _, nomatch).

procedure kind_ok(Var?, Val?, YesNo).
kind_ok(role(_), p(_), yes).
kind_ok(role(_), s(_), no).
kind_ok(pvar(_), p(_), yes).
kind_ok(pvar(_), s(_), no).
kind_ok(svar(_), p(_), no).
kind_ok(svar(_), s(_), yes).
kind_ok(sgn(_, _), p(_), no).
kind_ok(sgn(_, _), s(_), no).
kind_ok(sgn(_, _), c(_), no).
kind_ok(nterm(_), _, no).
kind_ok(role(_), c(_), no).
kind_ok(pvar(_), c(_), no).
kind_ok(svar(_), c(_), no).
kind_ok(num(_), n(_), yes).
kind_ok(num(_), lv(_, _), yes).
kind_ok(num(_), p(_), no).
kind_ok(num(_), s(_), no).
kind_ok(num(_), c(_), no).
kind_ok(role(_), n(_), no).
kind_ok(role(_), lv(_, _), no).
kind_ok(pvar(_), n(_), no).
kind_ok(pvar(_), lv(_, _), no).
kind_ok(svar(_), n(_), no).
kind_ok(svar(_), lv(_, _), no).
kind_ok(sgn(_, _), n(_), no).
kind_ok(sgn(_, _), lv(_, _), no).

procedure val_peer(Var?, Binding?, Peer?, Peer).
val_peer(V, B, D, P?) :- lookup(V?, B?, F), val_peer1(F?, D?, P).

procedure val_peer1(Found?, Peer?, Peer).
val_peer1(found(p(P)), _, P?).
val_peer1(found(s(_)), D, D?).
val_peer1(found(c(_)), D, D?).
val_peer1(found(n(_)), D, D?).
val_peer1(found(lv(_, _)), D, D?).
val_peer1(free, D, D?).

procedure val_speech(Var?, Binding?, Peer?, Speech).
val_speech(V, B, D, S?) :- lookup(V?, B?, F), val_speech1(F?, D?, S).

procedure val_speech1(Found?, Peer?, Speech).
val_speech1(found(s(S)), _, S?).
val_speech1(found(p(_)), D, speech(utterance(none), D?)).
val_speech1(found(c(_)), D, speech(utterance(none), D?)).
val_speech1(found(n(_)), D, speech(utterance(none), D?)).
val_speech1(found(lv(_, _)), D, speech(utterance(none), D?)).
val_speech1(free, D, speech(utterance(none), D?)).

procedure num_of(Var?, Binding?, NumRes).
num_of(num(X), _, num_is(N?)) :- integer(X?) | N := X?.
num_of(V, B, R?) :- otherwise, ground(B?) | lookup(V?, B?, F), num_found(F?, R).

procedure num_found(Found?, NumRes).
num_found(found(n(K)), num_is(K?)).
num_found(found(p(_)), no_num).
num_found(found(s(_)), no_num).
num_found(found(c(_)), no_num).
num_found(found(lv(_, _)), no_num).
num_found(free, no_num).

procedure val_num(Var?, Binding?, Integer).
val_num(V, B, K?) :- num_of(V?, B?, R), num_val(R?, K).

procedure num_val(NumRes?, Integer).
num_val(num_is(K), K?).
num_val(no_num, 0).

procedure con_holds(Constraint?, Binding?, YesNo).
con_holds(true, _, yes).
con_holds(and(C1, C2), B, R?) :- ground(B?) | con_holds(C1?, B?, R1), con_holds(C2?, B?, R2), and(R1?, R2?, R).
con_holds(eq(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_eq(A?, C?, R).
con_holds(le(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_le(A?, C?, R).
con_holds(lt(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_gt(C?, A?, R).
con_holds(ge(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_le(C?, A?, R).
con_holds(gt(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_gt(A?, C?, R).
con_holds(succ(X, Y), B, R?) :- ground(B?) | num_of(X?, B?, A), num_of(Y?, B?, C), num_succ(A?, C?, R).
con_holds(or(C1, C2), B, R?) :- ground(B?) | con_holds(C1?, B?, R1), con_holds(C2?, B?, R2), or(R1?, R2?, R).

procedure expr_val(Expr?, Binding?, NumRes).
expr_val(plus(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(plus, A?, C?, R).
expr_val(minus(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(minus, A?, C?, R).
expr_val(mul(X, Y), B, R?) :- ground(B?) | expr_val(X?, B?, A), expr_val(Y?, B?, C), num_op(mul, A?, C?, R).
expr_val(num(X), B, R?) :- ground(B?) | num_of(num(X?), B?, R).
expr_val(role(_), _, no_num).
expr_val(pvar(_), _, no_num).
expr_val(svar(_), _, no_num).
expr_val(sgn(_, _), _, no_num).
expr_val(nterm(_), _, no_num).

procedure num_op(Constant?, NumRes?, NumRes?, NumRes).
num_op(plus, num_is(A), num_is(C), num_is(K?)) :- integer(A?), integer(C?) | K := (A? + C?).
num_op(minus, num_is(A), num_is(C), num_is(K?)) :- integer(A?), integer(C?) | K := (A? - C?).
num_op(mul, num_is(A), num_is(C), num_is(K?)) :- integer(A?), integer(C?) | K := (A? * C?).
num_op(_, _, _, no_num) :- otherwise | true.

procedure num_eq(NumRes?, NumRes?, YesNo).
num_eq(num_is(A), num_is(C), yes) :- (A? =:= C?) | true.
num_eq(_, _, no) :- otherwise | true.

procedure num_gt(NumRes?, NumRes?, YesNo).
num_gt(num_is(A), num_is(C), yes) :- (A? > C?) | true.
num_gt(_, _, no) :- otherwise | true.

procedure num_le(NumRes?, NumRes?, YesNo).
num_le(num_is(A), num_is(C), yes) :- (A? =< C?) | true.
num_le(_, _, no) :- otherwise | true.

procedure num_succ(NumRes?, NumRes?, YesNo).
num_succ(num_is(A), num_is(C), R?) :- integer(A?), integer(C?) | A1 := (A? + 1), same_int(A1?, C?, R).
num_succ(_, _, no) :- otherwise | true.

procedure con_at(Constant?, Binding?, Peer?, Constraint).
con_at(Nm, B, Id, C?) :- ground(Nm?), ground(B?) | schema_numeric(Nm?, N), con_at0(N?, B?, Id?, C).

procedure con_at0(Numeric?, Binding?, Peer?, Constraint).
con_at0(numeric(C, _, every), _, _, C?).
con_at0(numeric(C, _, at(I)), B, Id, C1?) :- ground(B?) | role_person(I?, B?, P), same(P?, Id?, Me), con_if(Me?, C?, C1).

procedure con_if(YesNo?, Constraint?, Constraint).
con_if(yes, C, C?).
con_if(no, _, true).

procedure con_live(Constant?, Binding?, YesNo).
con_live(Nm, B, V?) :- ground(Nm?) | schema_numeric(Nm?, N), con_live1(N?, B?, V).

procedure con_live1(Numeric?, Binding?, YesNo).
con_live1(numeric(C, _, every), B, V?) :- con_holds(C?, B?, V).
con_live1(numeric(_, _, at(_)), _, yes).

procedure unlocal(Binding?, Binding).
unlocal([], []).
unlocal([b(_, lv(_, _)) | Bs], R?) :- unlocal(Bs?, R).
unlocal([E | Bs], [E? | R?]) :- otherwise | unlocal(Bs?, R).

procedure con_extend(Constraint?, Binding?, Bindings).
con_extend(C, B, Bs?) :- ground(C?), ground(B?) | con_ext1(C?, B?, Bs1), con_again(Bs1?, C?, B?, Bs).

procedure con_again(Bindings?, Constraint?, Binding?, Bindings).
con_again([], _, _, []).
con_again([B1 | Bs], C, B, R?) :- ground(B1?), ground(B?), ground(C?) | blen(B1?, N1), blen(B?, N), con_again1(N1?, N?, B1?, C?, R1), con_again(Bs?, C?, B?, R2), app(R1?, R2?, R).

procedure con_again1(Integer?, Integer?, Binding?, Constraint?, Bindings).
con_again1(N1, N, B1, C, R?) :- (N1? > N?) | con_extend(C?, B1?, R).
con_again1(_, _, B1, _, [B1?]) :- otherwise | true.

procedure blen(Binding?, Integer).
blen([], 0).
blen([_ | Bs], N?) :- blen(Bs?, M), N := (M? + 1).

procedure con_ext1(Constraint?, Binding?, Bindings).
con_ext1(true, B, [B?]).
con_ext1(and(C1, C2), B, Bs?) :- ground(B?) | con_ext1(C2?, B?, Bs2), ext_by(Bs2?, C1?, Bs).
con_ext1(eq(X, Y), B, Bs?) :- ground(X?), ground(Y?), ground(B?) | eq_ext(X?, Y?, B?, Bs).
con_ext1(le(_, _), B, [B?]).
con_ext1(lt(_, _), B, [B?]).
con_ext1(ge(_, _), B, [B?]).
con_ext1(gt(_, _), B, [B?]).
con_ext1(succ(X, Y), B, Bs?) :- ground(B?), ground(X?), ground(Y?) | num_of(X?, B?, A), num_of(Y?, B?, C), succ_ext(A?, C?, X?, Y?, B?, Bs).
con_ext1(or(C1, C2), B, Bs?) :- ground(B?) | con_ext1(C1?, B?, Bs1), con_ext1(C2?, B?, Bs2), app(Bs1?, Bs2?, Bs).

procedure ext_by(Bindings?, Constraint?, Bindings).
ext_by([], _, []).
ext_by([B | Bs], C, R?) :- ground(C?) | con_ext1(C?, B?, R1), ext_by(Bs?, C?, R2), app(R1?, R2?, R).

procedure eq_ext(Expr?, Expr?, Binding?, Bindings).
eq_ext(X, Y, B, Bs?) :- ground(X?), ground(Y?), ground(B?) | expr_free(X?, B?, [], F1), expr_free(Y?, B?, F1?, F), eq_ext1(F?, X?, Y?, B?, Bs).

procedure eq_ext1(Vars?, Expr?, Expr?, Binding?, Bindings).
eq_ext1([V], X, Y, B, Bs?) :- ground(V?), ground(X?), ground(Y?), ground(B?) | expr_val(minus(X?, Y?), [b(V?, n(0)) | B?], D0), expr_val(minus(X?, Y?), [b(V?, n(1)) | B?], D1), eq_solve(D0?, D1?, V?, B?, Bs).
eq_ext1(_, _, _, B, [B?]) :- otherwise | true.

procedure eq_solve(NumRes?, NumRes?, Var?, Binding?, Bindings).
eq_solve(num_is(D0), num_is(D1), V, B, Bs?) :- integer(D0?), integer(D1?) | C := (D1? - D0?), eq_solve1(C?, D0?, V?, B?, Bs).
eq_solve(_, _, _, B, [B?]) :- otherwise | true.

procedure eq_solve1(Integer?, Integer?, Var?, Binding?, Bindings).
eq_solve1(C, D0, V, B, [[b(V?, n(K?)) | B?]]) :- (C? =\= 0), ((D0? mod C?) =:= 0) | K := ((0 - D0?) // C?).
eq_solve1(_, _, _, B, [B?]) :- otherwise | true.

procedure expr_free(Expr?, Binding?, Vars?, Vars).
expr_free(plus(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(minus(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(mul(X, Y), B, F0, F?) :- ground(B?) | expr_free(X?, B?, F0?, F1), expr_free(Y?, B?, F1?, F).
expr_free(num(X), _, F0, F0?) :- integer(X?) | true.
expr_free(num(X), B, F0, F?) :- otherwise, ground(X?), ground(B?), ground(F0?) | num_of(num(X?), B?, R), leaf_free1(R?, num(X?), F0?, F).
expr_free(role(_), _, F0, F0?).
expr_free(pvar(_), _, F0, F0?).
expr_free(svar(_), _, F0, F0?).
expr_free(sgn(_, _), _, F0, F0?).
expr_free(nterm(_), _, F0, F0?).

procedure leaf_free1(NumRes?, Var?, Vars?, Vars).
leaf_free1(num_is(_), _, F0, F0?).
leaf_free1(no_num, V, F0, F?) :- ground(V?), ground(F0?) | var_in(V?, F0?, In), add_var(In?, V?, F0?, F).

procedure var_in(Var?, Vars?, YesNo).
var_in(_, [], no).
var_in(V, [W | _], yes) :- (V? =?= W?) | true.
var_in(V, [_ | Ws], R?) :- otherwise | var_in(V?, Ws?, R).

procedure add_var(YesNo?, Var?, Vars?, Vars).
add_var(yes, _, F0, F0?).
add_var(no, V, F0, [V? | F0?]).

procedure succ_ext(NumRes?, NumRes?, Var?, Var?, Binding?, Bindings).
succ_ext(num_is(A), no_num, _, Y, B, [[b(Y?, n(A1?)) | B?]]) :- integer(A?) | A1 := (A? + 1).
succ_ext(no_num, num_is(C), X, _, B, [[b(X?, n(C1?)) | B?]]) :- integer(C?) | C1 := (C? - 1).
succ_ext(_, _, _, _, B, [B?]) :- otherwise | true.

procedure nums_bound(Constant?, Binding?, YesNo).
nums_bound(Nm, B, Ok?) :- ground(Nm?) | schema_entry(Nm?, E), schema_head(E?, Hd), hd_nums_bound(Hd?, B?, Ok).

procedure schema_head(Schema?, Vars).
schema_head(schema(_, Hd, _), Hd?).
schema_head(lschema(_, Hd, _, _), Hd?).

procedure hd_nums_bound(Vars?, Binding?, YesNo).
hd_nums_bound([], _, yes).
hd_nums_bound([num(X) | Vs], B, Ok?) :- ground(X?), ground(B?) | num_of(num(X?), B?, K), is_num(K?, O1), hd_nums_bound(Vs?, B?, O2), and(O1?, O2?, Ok).
hd_nums_bound([_ | Vs], B, Ok?) :- otherwise | hd_nums_bound(Vs?, B?, Ok).

procedure is_num(NumRes?, YesNo).
is_num(num_is(_), yes).
is_num(no_num, no).

procedure st_id(St?, Peer).
st_id(st(Id, _, _, _, _, _, _, _, _, _, _, _, _, _), Id?).

procedure st_app(St?, App).
st_app(st(_, Ap, _, _, _, _, _, _, _, _, _, _, _, _), Ap?).

procedure st_count(St?, Integer).
st_count(st(_, _, D, _, _, _, _, _, _, _, _, _, _, _), D?).

procedure st_sent(St?, Peers).
st_sent(st(_, _, _, Se, _, _, _, _, _, _, _, _, _, _), Se?).

procedure st_recd(St?, Peers).
st_recd(st(_, _, _, _, Rc, _, _, _, _, _, _, _, _, _), Rc?).

procedure st_known(St?, List(Key)).
st_known(st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), Ks?) :- ground(Se?), ground(ISe?) | app(Se?, ISe?, Ps), known_sorted(Ps?, kn(Se?, Rc?, ISe?, IRc?), Ks).

procedure known_sorted(Peers?, Kn?, List(Key)).
known_sorted(Ps, Kn, Ks?) :- ground(Ps?) | dedup(Ps?, Ps1), known_of(Ps1?, Kn?, K0), sort_peers(K0?, Ks).

procedure known_of(Peers?, Kn?, Peers).
known_of([], _, []).
known_of([P | Ps], Kn, Ks?) :- ground(P?), ground(Kn?) | known_kn(P?, Kn?, B), known_of(Ps?, Kn?, K1), keep_peer(B?, P?, K1?, Ks).

procedure keep_peer(YesNo?, Peer?, Peers?, Peers).
keep_peer(yes, P, Ks, [P? | Ks?]).
keep_peer(no, _, Ks, Ks?).

procedure st_isent(St?, Peers).
st_isent(st(_, _, _, _, _, ISe, _, _, _, _, _, _, _, _), ISe?).

procedure st_irecd(St?, Peers).
st_irecd(st(_, _, _, _, _, _, IRc, _, _, _, _, _, _, _), IRc?).

procedure st_waits(St?, Waits).
st_waits(st(_, _, _, _, _, _, _, W, _, _, _, _, _, _), W?).

procedure st_pends(St?, Pends).
st_pends(st(_, _, _, _, _, _, _, _, _, Pd, _, _, _, _), Pd?).

procedure st_ix(St?, Ix).
st_ix(st(_, _, _, _, _, _, _, _, _, _, _, _, Ix, _), Ix?).

procedure set_ix(St?, Ix?, St).
set_ix(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, _, Rq), Ix, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_trie(St?, Trie).
st_trie(st(_, _, _, _, _, _, _, _, _, _, _, _, ix(Tr, _, _, _), _), Tr?).

procedure st_kn(St?, Kn).
st_kn(st(_, _, _, Se, Rc, ISe, IRc, _, _, _, _, _, _, _), kn(Se?, Rc?, ISe?, IRc?)).

procedure st_view(St?, V).
st_view(st(Id, app(S, _, L, R), _, Se, Rc, ISe, IRc, _, _, Pd, _, _, _, _), v(Id?, S?, L?, R?, Pd?, kn(Se?, Rc?, ISe?, IRc?))).

procedure v_id(V?, Peer).
v_id(v(Id, _, _, _, _, _), Id?).

procedure v_ms(V?, GAtoms).
v_ms(v(_, S, _, _, _, _), S?).

procedure v_recs(V?, Recs).
v_recs(v(_, _, _, R, _, _), R?).

procedure v_pends(V?, Pends).
v_pends(v(_, _, _, _, Pd, _), Pd?).

procedure v_kn(V?, Kn).
v_kn(v(_, _, _, _, _, Kn), Kn?).

procedure set_app(St?, App?, St).
set_app(st(Id, _, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), Ap, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure set_waits(St?, Waits?, St).
set_waits(st(Id, Ap, D, Se, Rc, ISe, IRc, _, Ca, Pd, Pr, Hd, Ix, Rq), W, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_made(St?, Rhos).
st_made(st(_, _, _, _, _, _, _, _, _, _, Pr, _, _, _), Pr?).

procedure set_made(St?, Rhos?, St).
set_made(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, _, Hd, Ix, Rq), Pr, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_held(St?, Helds).
st_held(st(_, _, _, _, _, _, _, _, _, _, _, Hd, _, _), Hd?).

procedure set_held(St?, Helds?, St).
set_held(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, _, Ix, Rq), Hd, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure st_reqs(St?, Proposals).
st_reqs(st(_, _, _, _, _, _, _, _, _, _, _, _, _, Rq), Rq?).

procedure set_reqs(St?, Proposals?, St).
set_reqs(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, _), Rq, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure set_pends(St?, Pends?, St).
set_pends(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, _, Pr, Hd, Ix, Rq), Pd, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_pend_once(Pend?, St?, St).
add_pend_once(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?, Pr?, Hd?, Ix?, Rq?)) :- ground(X?), ground(Pd?) | mem(X?, Pd?, In), add_pend1(In?, X?, Pd?, Pd1).

procedure add_pend1(YesNo?, Pend?, Pends?, Pends).
add_pend1(yes, _, Pd, Pd?).
add_pend1(no, X, Pd, Pd1?) :- app(Pd?, [X?], Pd1).

procedure drop_pend(Pend?, St?, St).
drop_pend(X, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd1?, Pr?, Hd?, Ix?, Rq?)) :- remove_all(X?, Pd?, Pd1).

procedure add_sent(Peer?, St?, St).
add_sent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, [Q? | Se?], Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_isent(Peer?, St?, St).
add_isent(Q, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, [Q? | ISe?], IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_irecd(Peer?, St?, St).
add_irecd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, Rc?, ISe?, [P? | IRc?], W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure add_recd(Peer?, St?, St).
add_recd(P, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D?, Se?, [P? | Rc?], ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)).

procedure advance(St?, St).
advance(st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr, Hd, Ix, Rq), st(Id?, Ap?, D1?, Se?, Rc?, ISe?, IRc?, W?, Ca?, Pd?, Pr?, Hd?, Ix?, Rq?)) :- D1 := (D? + 1).

procedure app_recs(App?, Recs).
app_recs(app(_, _, _, R), R?).

procedure app_count(App?, Integer).
app_count(app(_, K, _, _), K?).

procedure app_state(App?, GAtoms).
app_state(app(S, _, _, _), S?).

procedure attempt_id(Attempt?, Peer).
attempt_id(attempt(I, _, _, _, _), I?).

procedure attempt_k(Attempt?, Integer).
attempt_k(attempt(_, K, _, _, _), K?).

procedure attempt_rank(Attempt?, Integer).
attempt_rank(attempt(_, _, P, _, _), P?).

procedure attempt_class(Attempt?, Class).
attempt_class(attempt(_, _, _, C, _), C?).

procedure attempt_names(Attempt?, Names).
attempt_names(attempt(_, _, _, _, Nm), Nm?).

procedure and(YesNo?, YesNo?, YesNo).
and(yes, B, B?).
and(no, _, no).

procedure or(YesNo?, YesNo?, YesNo).
or(yes, _, yes).
or(no, B, B?).

procedure neg(YesNo?, YesNo).
neg(yes, no).
neg(no, yes).

procedure(X) same(X?, X?, YesNo).
same(P, Q, yes) :- (P? =?= Q?) | true.
same(_, _, no) :- otherwise | true.

procedure same_int(Integer?, Integer?, YesNo).
same_int(M, N, yes) :- (M? =:= N?) | true.
same_int(_, _, no) :- otherwise | true.

procedure sort_peers(Peers?, Peers).
sort_peers([], []).
sort_peers([P | Ps], S?) :- sort_peers(Ps?, S1), insert_peer(P?, S1?, S).

procedure insert_peer(Peer?, Peers?, Peers).
insert_peer(P, [], [P?]).
insert_peer(P, [Q | Qs], [P?, Q? | Qs?]) :- '@<'(P?, Q?) | true.
insert_peer(P, [Q | Qs], [Q? | R?]) :- otherwise | insert_peer(P?, Qs?, R).

procedure(X) app(Stream(X)?, Stream(X)?, Stream(X)).
app([], Ys, Ys?).
app([X | Xs], Ys, [X? | Zs?]) :- app(Xs?, Ys?, Zs).

procedure(X) mem(X?, Stream(X)?, YesNo).
mem(_, [], no).
mem(X, [Y | _], yes) :- (X? =?= Y?) | true.
mem(X, [_ | Ys], R?) :- otherwise | mem(X?, Ys?, R).

procedure(X) dedup(Stream(X)?, Stream(X)).
dedup([], []).
dedup([X | Xs], [X? | Ys?]) :- ground(X?) | remove_all(X?, Xs?, Xs1), dedup(Xs1?, Ys).

procedure(X) remove_all(X?, Stream(X)?, Stream(X)).
remove_all(_, [], []).
remove_all(X, [Y | Ys], Zs?) :- (X? =?= Y?) | remove_all(X?, Ys?, Zs).
remove_all(X, [Y | Ys], [Y? | Zs?]) :- otherwise | remove_all(X?, Ys?, Zs).

procedure(X) ms_remove(X?, Stream(X)?, YesNo, Stream(X)).
ms_remove(_, [], no, []).
ms_remove(X, [Y | Ys], yes, Ys?) :- (X? =?= Y?) | true.
ms_remove(X, [Y | Ys], F?, [Y? | Zs?]) :- otherwise | ms_remove(X?, Ys?, F, Zs).

procedure(X) ms_diff(Stream(X)?, Stream(X)?, Stream(X)).
ms_diff(A, [], A?).
ms_diff(A, [X | Xs], C?) :- ms_remove(X?, A?, _, A1), ms_diff(A1?, Xs?, C).

procedure(X) ms_sub(Stream(X)?, Stream(X)?, YesNo).
ms_sub([], _, yes).
ms_sub([X | Xs], B, R?) :- ms_remove(X?, B?, F, B1), ms_sub1(F?, Xs?, B1?, R).

procedure(X) ms_sub1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_sub1(no, _, _, no).
ms_sub1(yes, Xs, B, R?) :- ms_sub(Xs?, B?, R).

procedure(X) ms_eq(Stream(X)?, Stream(X)?, YesNo).
ms_eq(A, B, R?) :- ground(A?), ground(B?) | ms_sub(A?, B?, R1), ms_sub(B?, A?, R2), and(R1?, R2?, R).

procedure(X) ms_join(Stream(X)?, Stream(X)?, Stream(X)).
ms_join(A, B, C?) :- ground(A?) | ms_diff(B?, A?, D), app(A?, D?, C).

procedure(X) ms_meets(Stream(X)?, Stream(X)?, YesNo).
ms_meets([], _, no).
ms_meets([X | Xs], B, R?) :- ground(B?) | mem(X?, B?, R1), ms_meets1(R1?, Xs?, B?, R).

procedure(X) ms_meets1(YesNo?, Stream(X)?, Stream(X)?, YesNo).
ms_meets1(yes, _, _, yes).
ms_meets1(no, Xs, B, R?) :- ms_meets(Xs?, B?, R).

%% --- the dispatcher (programs/vglp/dispatcher.glp) ---

Inputs(T) ::= [Input(T) | Inputs(T)].
Route(T) ::= route(Integer, Inputs(T)?).
Routes(T) ::= [] ; [Route(T) | Routes(T)].
Deads(T) ::= [] ; [Inputs(T)? | Deads(T)].
Formed(X) ::= formed(X) ; refused.
Done ::= done.
Ask(Q) ::= ask(Constant, Q).
Spawn(Q, T) ::= spawn(Integer, Q, Inputs(T), Stream(Draw(T))?).
Event(Q, T) ::= Ask(Q) ; Input(T) ; Draw(T).
Events(Q, T) ::= [Event(Q, T) | Events(Q, T)].
Turn ::= ask ; grant ; draw.

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Channel(Stream(_), Stream(_)), Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), ch(MIn?, _), Ss?) :- split_grants(PIn?, Inputs, MIn), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, POut, [], [], 1, Ss).

procedure(Q, T) dispatch(Stream(Ask(Q))?, PersonChannel(T)?, Stream(_), Stream(Draw(T))?, Stream(Spawn(Q, T))).
dispatch(Asks, ch(PIn, POut?), MIn?, ODs, Ss?) :- split_grants(PIn?, Inputs, MIn), merge_draws(ODs?, DOut?, POut), fair(ask, Asks?, Inputs?, COut?, Es), serve(Es?, COut, DOut, [], [], 1, Ss).

procedure(T) merge_draws(Stream(Draw(T))?, PersonOut(T)?, PersonOut(T)).
merge_draws([X | Xs], Ys, [X? | Zs?]) :- merge_draws_(Ys?, Xs?, Zs).
merge_draws(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws(Xs?, Ys?, Zs).
merge_draws([], Ys, Ys?).

procedure(T) merge_draws_(PersonOut(T)?, Stream(Draw(T))?, PersonOut(T)).
merge_draws_([X | Xs], Ys, [X? | Zs?]) :- merge_draws(Ys?, Xs?, Zs).
merge_draws_(Xs, [Y | Ys], [Y? | Zs?]) :- merge_draws_(Xs?, Ys?, Zs).
merge_draws_(Xs, [], Xs?).

procedure(T) split_grants(PersonIn(T)?, Inputs(T), Stream(_)).
split_grants([input(Id, P, R) | Gs], [input(Id?, P?, R?) | Is?], Ms?) :- split_grants(Gs?, Is, Ms).

procedure(Q, T) fair(Turn?, Stream(Ask(Q))?, Inputs(T)?, Stream(Draw(T))?, Events(Q, T)).
fair(ask, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(grant, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(draw, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(ask, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).
fair(grant, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(draw, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(ask, As, Is, [D | Ds], Es?) :- Es = [D? | Es1?], fair(ask, As?, Is?, Ds?, Es1).
fair(grant, [A | As], Is, Ds, Es?) :- Es = [A? | Es1?], fair(grant, As?, Is?, Ds?, Es1).
fair(draw, As, [I | Is], Ds, Es?) :- Es = [I? | Es1?], fair(draw, As?, Is?, Ds?, Es1).

procedure(Q, T) serve(Events(Q, T)?, Stream(Draw(T)), PersonOut(T), Routes(T)?, Deads(T)?, Integer?, Stream(Spawn(Q, T))).
serve([ask(_, Q) | Es], CInto?, DOut?, Rs, Xs, N, [spawn(N?, Q?, Gs?, Ds) | Ss?]) :- ground(N?) | merge(Ds?, CInto1?, CInto), N1 := (N? + 1), serve(Es?, CInto1, DOut, [route(N?, Gs) | Rs?], Xs?, N1?, Ss).
serve([input(Id, P, R) | Es], CInto?, DOut?, Rs, Xs, N, Ss?) :- route_grant(input(Id?, P?, R?), Rs?, Rs1), serve(Es?, CInto, DOut, Rs1?, Xs?, N?, Ss).
serve([draw(Id, W, V) | Es], CInto?, [draw(Id?, W?, V?) | DOut?], Rs, Xs, N, Ss?) :- serve(Es?, CInto, DOut, Rs?, Xs?, N?, Ss).
serve([withdraw(Id) | Es], CInto?, [withdraw(Id?) | DOut?], Rs, Xs, N, Ss?) :- ground(Id?) | remove_route(Id?, Rs?, Rs1, Xs?, Xs1), serve(Es?, CInto, DOut, Rs1?, Xs1?, N?, Ss).

procedure(T) route_grant(Input(T)?, Routes(T)?, Routes(T)).
route_grant(input(Id, P, R), [route(Id1, [input(Id?, P?, R?) | Gs1?]) | Rs], [route(Id1?, Gs1) | Rs?]) :- (Id? =?= Id1?) | true.
route_grant(G, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?]) :- otherwise | route_grant(G?, Rs?, Rs1).
route_grant(_, [], []).

procedure(T) remove_route(Integer?, Routes(T)?, Routes(T), Deads(T)?, Deads(T)).
remove_route(Id, [route(Id1, Gs?) | Rs], Rs?, Xs, [Gs | Xs?]) :- (Id? =?= Id1?) | true.
remove_route(Id, [route(Id1, Gs?) | Rs], [route(Id1?, Gs) | Rs1?], Xs, Xs1?) :- otherwise | remove_route(Id?, Rs?, Rs1, Xs?, Xs1).
remove_route(_, [], [], Xs, Xs?).

procedure(T) run_end(Integer?, Done?, Stream(Draw(T))).
run_end(Id, done, [withdraw(Id?)]).

procedure all_done(Stream(Done)?, Done).
all_done([done | Ds], D?) :- all_done(Ds?, D).
all_done([], done).

procedure shown(Path?, _?, Stream(_)).
shown(_, X, [X?]) :- ground(X?) | true.
shown(P, X, [pending(P?) | Vs?]) :- shown_whole(X?, Vs).

procedure shown_whole(_?, Stream(_)).
shown_whole(X, [X?]) :- ground(X?) | true.

procedure thread(Path?, Stream(_)?, Stream(Stream(_))).
thread(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread(_, [], [[]]).
thread(P, Xs, [[] | Vs?]) :- thread_tail(P?, Xs?, Vs).

procedure thread_tail(Path?, Stream(_)?, Stream(Stream(_))).
thread_tail(P, [X | Xs], Vs?) :- thread_cell(P?, X?, Xs?, Vs).
thread_tail(_, [], []).

procedure thread_cell(Path?, _?, Stream(_)?, Stream(Stream(_))).
thread_cell(P, X, Xs, Vs?) :- ground(P?) | path(P?, 1, P1), path(P?, 2, P2), shown(P1?, X?, V1), thread(P2?, Xs?, V2), cons_views(V1?, V2?, Vs).

procedure cons_views(Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_views([E | Es], [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_views([], _, []).
cons_views(_, [], []).

procedure cons_more(_?, Stream(_)?, Stream(_)?, Stream(Stream(_))?, Stream(Stream(_))).
cons_more(_, T, [E | Es], Ts, [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(E, _, Es, [T | Ts], [[E? | T?] | Vs?]) :- ground(E?), ground(T?) | cons_more(E?, T?, Es?, Ts?, Vs).
cons_more(_, _, [], [], []).

procedure path(Path?, Integer?, Path).
path([I | P], J, [I? | Q?]) :- path(P?, J?, Q).
path([], J, [J?]).

procedure form_string(_?, Formed(String)).
form_string(R, F?) :- string(R?) | F = formed(R?).
form_string(_, refused) :- otherwise | true.

procedure form_integer(_?, Formed(Integer)).
form_integer(R, F?) :- integer(R?) | F = formed(R?).
form_integer(_, refused) :- otherwise | true.

procedure form_number(_?, Formed(Number)).
form_number(R, F?) :- number(R?) | F = formed(R?).
form_number(_, refused) :- otherwise | true.

procedure form_real(_?, Formed(Real)).
form_real(R, F?) :- real(R?) | F = formed(R?).
form_real(_, refused) :- otherwise | true.

procedure form_constant(_?, Formed(Constant)).
form_constant(R, F?) :- constant(R?) | F = formed(R?).
form_constant(_, refused) :- otherwise | true.

procedure form_module(_?, Formed(Module)).
form_module(R, F?) :- module(R?) | F = formed(R?).
form_module(_, refused) :- otherwise | true.

%% --- the construct process of each interactive type ---

Drawn ::= menu_w(_) ; approval_w(_) ; output(List(Output)) ; Request ; YesNo.

exported procedure dispatch(Stream(Ask(Question))?, PersonChannel(Drawn)?, Channel(Stream(_), Stream(Output))).
dispatch(Asks, PCh, ch(MIn?, MOut)) :- dispatch(Asks?, PCh?, MIn, ODs?, Ss), output(named(last_state, thread(menu([form(view, [field('List(Atom)', thread(menu([shown, form(knows, [field('Peer', shown)]), form(coin, [field('Peer', shown)])]))), field('List(Key)', thread), field('List(Approved)', thread(menu([form(establish, [field('Peer', shown)]), form(meet, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(mint, [field('Peer', shown), field('Integer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Integer', shown), field('Peer', shown), field('Integer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown), field('Integer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))), field('List(Tab)', thread(menu([form(tab, [field('String', shown), field('Constant', shown)]), form(tab, [field('String', shown), field('Constant', shown), field('Constant', shown)])])))]), form(refused, [field('Approved', menu([form(establish, [field('Peer', shown)]), form(meet, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(mint, [field('Peer', shown), field('Integer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Integer', shown), field('Peer', shown), field('Integer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown), field('Integer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])])), field('Key', shown), field('Reason', menu([shown, shown, form(unable, [field('List(Atom)', thread(menu([shown, form(knows, [field('Peer', shown)]), form(coin, [field('Peer', shown)])]))), field('List(Atom)', thread(menu([shown, form(knows, [field('Peer', shown)]), form(coin, [field('Peer', shown)])])))])]))])]))), MOut?, ODs), constructs(Ss?).

procedure constructs(Stream(Spawn(Question, Drawn))?).
constructs([spawn(Id, Q, Gs, Ds?) | Ss]) :- construct(Id?, Q?, Gs?, Ds), constructs(Ss?).
constructs([]).

procedure construct(Integer?, Question?, Inputs(Drawn)?, Stream(Draw(Drawn))).
construct(Id, menu_w(X), Gs, Ds?) :- present_menu([], X?, Gs?, _, Vs, Done), run_menu_w(Id?, named(social_menu, form(menu, [field('Key', shown), field('List(Key)', thread), field('Request', form(propose, [field('Proposal', menu([act(place('Contacts', 1, [], [], [], [], []), label('Establish', form(establish, [field('Peer', peer)]))), act(place('Contacts', 1, [2], [], [], [2], []), act(place('Contacts', 2, [1], [], [], [2], []), label('Meet', form(meet, [field('Peer', peer), field(person, peer)])))), act(place('Contacts', 1, [2], [], [item(2, knows)], [], []), act(place('Contacts', 2, [1], [], [item(1, knows)], [], []), label('Introduce', form(introduce, [field('Peer', peer), field('Peer', peer), field(person, peer)])))), act(place('Coins', 1, [], [], [], [], []), label('Mint', form(mint, [field('Peer', peer), field(amount, number)]))), act(place('Coins', 1, [2], [], [item(2, knows)], [], []), act(place('Coins', 2, [1], [], [item(1, knows)], [], []), label('Swap', form(swap, [field('Peer', peer), field('Peer', peer), field('issuer given', peer), field('amount given', number), field('issuer wanted', peer), field('amount wanted', number)])))), act(place('Coins', 1, [2], [], [item(2, knows), item(2, coin)], [], []), label('Pay', form(pay, [field('Peer', peer), field('Peer', peer), field(amount, number)]))), act(place('Coins', 1, [2], [], [item(2, knows), item(2, coin)], [], []), label('Redeem', form(redeem, [field('Peer', peer), field('Peer', peer), field('issuer wanted', peer)])))]))]))])), Vs?, Done?, Ds).
construct(Id, approval_w(X), Gs, Ds?) :- present_approval([], X?, Gs?, _, Vs, Done), run_approval_w(Id?, named(approval_sentence, form(approval, [field('Asking', menu([form(attempt, [field('Peer', shown), field('Integer', shown), field('Integer', shown), field('Class', menu([form(establish, [field('Peer', shown)]), form(meet, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(mint, [field('Peer', shown), field('Integer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Integer', shown), field('Peer', shown), field('Integer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown), field('Integer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])])), field('Names', menu([shown, form(request, [field('Rho', menu([form(one, [field('Class', menu([form(establish, [field('Peer', shown)]), form(meet, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(mint, [field('Peer', shown), field('Integer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Integer', shown), field('Peer', shown), field('Integer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown), field('Integer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))]), form(rho, [field('Proposal', menu([form(establish, [field('Peer', shown)]), form(meet, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(mint, [field('Peer', shown), field('Integer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Integer', shown), field('Peer', shown), field('Integer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown), field('Integer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))])])), field('Integer', shown)])]))]), form(hello, [field('Peer', shown), field('Proposal', menu([form(establish, [field('Peer', shown)]), form(meet, [field('Peer', shown), field('Peer', shown)]), form(introduce, [field('Peer', shown), field('Peer', shown), field('Peer', shown)]), form(mint, [field('Peer', shown), field('Integer', shown)]), form(swap, [field('Peer', shown), field('Peer', shown), field('Peer', shown), field('Integer', shown), field('Peer', shown), field('Integer', shown)]), form(pay, [field('Peer', shown), field('Peer', shown), field('Integer', shown)]), form(redeem, [field('Peer', shown), field('Peer', shown), field('Peer', shown)])]))])])), field('List(Word)', thread(menu([form(text, [field('String', shown)]), form(person, [field('Peer', shown)]), form(named, [field('String', shown), field('Peer', shown)]), form(valued, [field('String', shown), field('Integer', shown)])]))), field('YesNo', buttons([yes, no]))])), Vs?, Done?, Ds).

procedure output(Widget?, Stream(Output)?, Stream(Draw(Drawn))).
output(W, Ms, [draw(0, W?, output([])) | Ds?]) :- ground(W?) | output_more(W?, Ms?, [], Ds).

procedure output_more(Widget?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_more(W, [M | Ms], Es, Ds?) :- ground(M?), ground(Es?) | output_add(Es?, M?, Es1), output_draw(W?, Ms?, Es1?, Ds).
output_more(_, [], _, []).

procedure output_draw(Widget?, Stream(Output)?, List(Output)?, Stream(Draw(Drawn))).
output_draw(W, Ms, Es, [draw(0, W?, output(Es?)) | Ds?]) :- ground(W?), ground(Es?) | output_more(W?, Ms?, Es?, Ds).

procedure output_add(List(Output)?, Output?, List(Output)).
output_add([E | Es], M, [E? | Es1?]) :- output_add(Es?, M?, Es1).
output_add([], M, [M?]).

procedure join_proposal_establish_1(Formed(Peer)?, Formed(Proposal)).
join_proposal_establish_1(formed(X1), formed(establish(X1?))).
join_proposal_establish_1(refused, refused).

procedure join_proposal_meet_2(Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_meet_2(formed(X1), formed(X2), formed(meet(X1?, X2?))).
join_proposal_meet_2(refused, _, refused).
join_proposal_meet_2(_, refused, refused).

procedure join_proposal_introduce_3(Formed(Peer)?, Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_introduce_3(formed(X1), formed(X2), formed(X3), formed(introduce(X1?, X2?, X3?))).
join_proposal_introduce_3(refused, _, _, refused).
join_proposal_introduce_3(_, refused, _, refused).
join_proposal_introduce_3(_, _, refused, refused).

procedure join_proposal_mint_2(Formed(Peer)?, Formed(Integer)?, Formed(Proposal)).
join_proposal_mint_2(formed(X1), formed(X2), formed(mint(X1?, X2?))).
join_proposal_mint_2(refused, _, refused).
join_proposal_mint_2(_, refused, refused).

procedure join_proposal_swap_6(Formed(Peer)?, Formed(Peer)?, Formed(Peer)?, Formed(Integer)?, Formed(Peer)?, Formed(Integer)?, Formed(Proposal)).
join_proposal_swap_6(formed(X1), formed(X2), formed(X3), formed(X4), formed(X5), formed(X6), formed(swap(X1?, X2?, X3?, X4?, X5?, X6?))).
join_proposal_swap_6(refused, _, _, _, _, _, refused).
join_proposal_swap_6(_, refused, _, _, _, _, refused).
join_proposal_swap_6(_, _, refused, _, _, _, refused).
join_proposal_swap_6(_, _, _, refused, _, _, refused).
join_proposal_swap_6(_, _, _, _, refused, _, refused).
join_proposal_swap_6(_, _, _, _, _, refused, refused).

procedure join_proposal_pay_3(Formed(Peer)?, Formed(Peer)?, Formed(Integer)?, Formed(Proposal)).
join_proposal_pay_3(formed(X1), formed(X2), formed(X3), formed(pay(X1?, X2?, X3?))).
join_proposal_pay_3(refused, _, _, refused).
join_proposal_pay_3(_, refused, _, refused).
join_proposal_pay_3(_, _, refused, refused).

procedure join_proposal_redeem_3(Formed(Peer)?, Formed(Peer)?, Formed(Peer)?, Formed(Proposal)).
join_proposal_redeem_3(formed(X1), formed(X2), formed(X3), formed(redeem(X1?, X2?, X3?))).
join_proposal_redeem_3(refused, _, _, refused).
join_proposal_redeem_3(_, refused, _, refused).
join_proposal_redeem_3(_, _, refused, refused).

procedure form_proposal(_?, Formed(Proposal)).
form_proposal(establish(R1), F?) :- form_string(R1?, F1), join_proposal_establish_1(F1?, F).
form_proposal(meet(R1, R2), F?) :- form_string(R1?, F1), form_string(R2?, F2), join_proposal_meet_2(F1?, F2?, F).
form_proposal(introduce(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), join_proposal_introduce_3(F1?, F2?, F3?, F).
form_proposal(mint(R1, R2), F?) :- form_string(R1?, F1), form_integer(R2?, F2), join_proposal_mint_2(F1?, F2?, F).
form_proposal(swap(R1, R2, R3, R4, R5, R6), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), form_integer(R4?, F4), form_string(R5?, F5), form_integer(R6?, F6), join_proposal_swap_6(F1?, F2?, F3?, F4?, F5?, F6?, F).
form_proposal(pay(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_integer(R3?, F3), join_proposal_pay_3(F1?, F2?, F3?, F).
form_proposal(redeem(R1, R2, R3), F?) :- form_string(R1?, F1), form_string(R2?, F2), form_string(R3?, F3), join_proposal_redeem_3(F1?, F2?, F3?, F).
form_proposal(_, refused) :- otherwise | true.

procedure join_request_propose_1(Formed(Proposal)?, Formed(Request)).
join_request_propose_1(formed(X1), formed(propose(X1?))).
join_request_propose_1(refused, refused).

procedure form_request(_?, Formed(Request)).
form_request(propose(R1), F?) :- form_proposal(R1?, F1), join_request_propose_1(F1?, F).
form_request(_, refused) :- otherwise | true.

procedure answer_request(Path?, Request, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_request(R?, F), take_request(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_request(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_request(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_request(Formed(Request)?, Path?, Request, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_request(formed(V), _, V?, _, Gs, Gs?, done).
take_request(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_request(P?, X, Gs?, Gs1, Done).

procedure start_menu_menu_3(Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
start_menu_menu_3([V1 | S1], [V2 | S2], [V3 | S3], [menu(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_menu_menu_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
start_menu_menu_3([], _, _, []).
start_menu_menu_3(_, [], _, []).
start_menu_menu_3(_, _, [], []).

procedure comb_menu_menu_3(_?, _?, _?, Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
comb_menu_menu_3(_, V2, V3, [V1 | S1], S2, S3, [menu(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_menu_menu_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_menu_menu_3(V1, _, V3, S1, [V2 | S2], S3, [menu(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_menu_menu_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_menu_menu_3(_, _, _, [], [], [], []).

procedure present_menu(Path?, Menu?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_menu(P, menu(H1, H2, H3?), Gs, Gs1?, Vs?, D3?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, Q2), thread(Q2?, H2?, V2), path(P?, 3, M3), path(P?, 3, Q3), answer_request(Q3?, H3, Gs?, Gs1, D3), start_menu_menu_3(V1?, V2?, [input(M3?)], Vs).
present_menu(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_menu_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_menu_wait(Path?, Menu?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_menu_wait(P, menu(H1, H2, H3?), Gs, Gs1?, Vs?, Done?) :- present_menu(P?, menu(H1?, H2?, H3), Gs?, Gs1, Vs, Done).
present_menu_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_menu_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_menu_w(Integer?, Widget?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_menu_w(Id, _, _, done, [withdraw(Id?)]).
run_menu_w(Id, W, [V | Vs], Done, [draw(Id?, W?, menu_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_menu_w(Id?, W?, Vs?, Done?, Ds).
run_menu_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

procedure form_yesNo(_?, Formed(YesNo)).
form_yesNo(yes, formed(yes)).
form_yesNo(no, formed(no)).
form_yesNo(_, refused) :- otherwise | true.

procedure answer_yesNo(Path?, YesNo, Inputs(Drawn)?, Inputs(Drawn), Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- P1? =?= P?, ground(R?) | form_yesNo(R?, F), take_yesNo(F?, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).
answer_yesNo(P, X?, [input(Id, P1, R) | Gs], Gs1?, Done?) :- otherwise | take_yesNo(refused, P?, X, input(Id?, P1?, R?), Gs?, Gs1, Done).

procedure take_yesNo(Formed(YesNo)?, Path?, YesNo, Input(Drawn)?, Inputs(Drawn)?, Inputs(Drawn), Done).
take_yesNo(formed(V), _, V?, _, Gs, Gs?, done).
take_yesNo(refused, P, X?, G, Gs, [G? | Gs1?], Done?) :- answer_yesNo(P?, X, Gs?, Gs1, Done).

procedure start_approval_approval_3(Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
start_approval_approval_3([V1 | S1], [V2 | S2], [V3 | S3], [approval(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_approval_approval_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
start_approval_approval_3([], _, _, []).
start_approval_approval_3(_, [], _, []).
start_approval_approval_3(_, _, [], []).

procedure comb_approval_approval_3(_?, _?, _?, Stream(_)?, Stream(_)?, Stream(_)?, Stream(_)).
comb_approval_approval_3(_, V2, V3, [V1 | S1], S2, S3, [approval(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_approval_approval_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_approval_approval_3(V1, _, V3, S1, [V2 | S2], S3, [approval(V1?, V2?, V3?) | Vs?]) :- ground(V1?), ground(V2?), ground(V3?) | comb_approval_approval_3(V1?, V2?, V3?, S1?, S2?, S3?, Vs).
comb_approval_approval_3(_, _, _, [], [], [], []).

procedure present_approval(Path?, Approval?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_approval(P, approval(H1, H2, H3?), Gs, Gs1?, Vs?, D3?) :- ground(P?) | path(P?, 1, Q1), shown(Q1?, H1?, V1), path(P?, 2, Q2), thread(Q2?, H2?, V2), path(P?, 3, M3), path(P?, 3, Q3), answer_yesNo(Q3?, H3, Gs?, Gs1, D3), start_approval_approval_3(V1?, V2?, [input(M3?)], Vs).
present_approval(P, X, Gs, Gs1?, [pending(P?) | Vs?], Done?) :- ground(P?) | present_approval_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure present_approval_wait(Path?, Approval?, Inputs(Drawn)?, Inputs(Drawn), Stream(_), Done).
present_approval_wait(P, approval(H1, H2, H3?), Gs, Gs1?, Vs?, Done?) :- present_approval(P?, approval(H1?, H2?, H3), Gs?, Gs1, Vs, Done).
present_approval_wait(P, X, [G | Gs], [G? | Gs1?], Vs?, Done?) :- present_approval_wait(P?, X?, Gs?, Gs1, Vs, Done).

procedure run_approval_w(Integer?, Widget?, Stream(_)?, Done?, Stream(Draw(Drawn))).
run_approval_w(Id, _, _, done, [withdraw(Id?)]).
run_approval_w(Id, W, [V | Vs], Done, [draw(Id?, W?, approval_w(V?)) | Ds?]) :- ground(W?), ground(V?) | run_approval_w(Id?, W?, Vs?, Done?, Ds).
run_approval_w(Id, _, [], Done, Ds?) :- run_end(Id?, Done?, Ds).

