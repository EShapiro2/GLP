%% ---------------------------------------------------------------------------
%% GC.glp --- the grassroots currencies contract, Currencies' (a contract is
%% its platform's paper's; Coordination Appendix C), in the term form
%% programs/gsc reads (its README, "Writing a contract").  The clauses are in
%% GC.txt beside this file.  GC extends GKK, Grassroots Keys and Knowledge,
%% GSC's (programs/gsc/GKK.glp; Udi, 2026-10-20), so the term holds GKK's
%% three schemas, establish, meet and introduce, and four of its own over the
%% predicate coin: coin(u) in the state of p is a coin issued by u and held
%% by p; the paper writes the predicate as the cent sign, which is not a GLP
%% constant.  Every role but establish's requires identity.  Clauses 2 to 4
%% require that Alice knows Bob, and clause 2 that Bob knows Alice: the swap
%% requires knows of the other at both roles, and pay and redeem require
%% knows(q) at p (Udi, 2026-10-20, in chat with GSC #5 and Currencies #11).
%% No role requires a friend.  The schemas are at unit amounts: mint mints
%% one coin, and a swap exchanges one coin for one; the paper's amounts k and
%% k' are multiplicities on the atoms (GC, Appendix A).  GSC's checker
%% (programs/gsc/test_gsc.sh) and vGLP's compiler to the canonical CVA
%% platform (programs/vglp/cva/compile.sh) read the term from here,
%% contract_named/2 printing it.
%%
%% This term is the one source of the schemas: a run of the cascade prints
%% their notation from it as schemas.txt (cascade.sh, programs/gsc/notation.glp),
%% and the notation hand-written above each term until 2026-10-20 is gone
%% (Udi, 2026-10-20; Code #12 to Currencies, 13:45 UTC).  Each comment below
%% names the clause a schema realises.  A role is rs(Guard, Add, Del, Keep,
%% Forb), its +(i), -(i), =(i) and not(i), and is named by its index, role(1)
%% the schema's first role; a schema's second argument lists its variables in
%% the order of its head; u, v, r and c are agent variables, pvar.
%% Written by Currencies #11 Cowork, 2026-10-20, in place of the term of
%% 2026-10-18 in GSC's old form, schema(Name, Roles).
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Schema    ::= schema(Constant, Args, RoleSpecs) ; cschema(Constant, Args, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gc, C): the contract, GC (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gc,
%% GKK:1, Identity.
   [schema(establish, [],
       [rs(guarded, [atom(identity, [])], [], [], [])]),
%% GKK:2, Meeting.
    schema(meet, [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
%% GKK:3, Introduction: p, who knows q and c, introduces c to q, who knows p.
    schema(introduce, [pvar(c)],
       [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
        rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GC:1, Minting: p mints a p-coin.
    schema(mint, [],
       [rs(guarded, [atom(coin, [role(1)])], [], [atom(identity, [])], [])]),
%% GC:2, Swap: p and q, who know each other, swap a u-coin of p's for a v-coin of q's.
    schema(swap, [pvar(u), pvar(v)],
       [rs(guarded, [atom(coin, [pvar(v)])], [atom(coin, [pvar(u)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(guarded, [atom(coin, [pvar(u)])], [atom(coin, [pvar(v)])], [atom(identity, []), atom(knows, [role(1)])], [])]),
%% GC:3, Payment: p pays a q-coin to q, whom p knows.
    schema(pay, [],
       [rs(guarded,   [], [atom(coin, [role(2)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(coin, [role(2)])], [], [atom(identity, [])], [])]),
%% GC:4, Redemption: p redeems a q-coin against an r-coin q holds, q whom p knows.
    schema(redeem, [pvar(r)],
       [rs(guarded,   [atom(coin, [pvar(r)])], [atom(coin, [role(2)])], [atom(identity, []), atom(knows, [role(2)])], []),
        rs(unguarded, [atom(coin, [role(2)])], [atom(coin, [pvar(r)])], [atom(identity, [])], [])])]).
