% contract_named(denominated_coins, C): the contract, Denominated Coins.
procedure contract_named(Constant?, SDeclared).
contract_named(denominated_coins, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(issue, ['Alice'], ['Dollar', 'Sum'], [times(num('Sum'), atom(coin, ['Alice', 'Alice', const('Dollar')]))], [atom(identity, ['Alice']), atom(issued_in, ['Alice', const('Dollar')])], true, ['Alice']),
 sas(swap, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob']), one('Dave', ['Alice', 'Bob', 'Carol'])], ['Carol', 'Dollar', 'Sum', 'Dave', 'Total'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol', const('Dollar')]))), times(num('Sum'), atom(coin, ['Bob', 'Carol', const('Dollar')])), not(times(num('Total'), atom(coin, ['Bob', 'Dave', const('Dollar')]))), times(num('Total'), atom(coin, ['Alice', 'Dave', const('Dollar')])), atom(knows, ['Bob', 'Carol']), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), times(num('Sum'), atom(coin, ['Alice', 'Carol', const('Dollar')])), times(num('Total'), atom(coin, ['Bob', 'Dave', const('Dollar')]))], true, ['Alice', 'Bob']),
 sas(pay, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Carol', 'Dollar', 'Sum'], [not(times(num('Sum'), atom(coin, ['Alice', 'Carol', const('Dollar')]))), times(num('Sum'), atom(coin, ['Bob', 'Carol', const('Dollar')])), atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Carol', const('Dollar')]))], true, ['Alice', 'Bob']),
 sas(pay_issuer, ['Alice', 'Bob'], ['Dollar', 'Sum'], [not(times(num('Sum'), atom(coin, ['Alice', 'Bob', const('Dollar')]))), times(num('Sum'), atom(coin, ['Bob', 'Bob', const('Dollar')]))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Bob', const('Dollar')]))], true, ['Alice']),
 sas(deposit, ['Alice', 'Carol', one('Dave', ['Alice', 'Carol']), one('Bob', 'Dave')], ['Dave', 'Dollar', 'Sum', 'Bob', 'Cond'], [not(times(num('Sum'), atom(coin, ['Alice', 'Dave', const('Dollar')]))), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', const('Dollar'), 'Alice', 'Bob', 'Cond']))], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Bob']), times(num('Sum'), atom(coin, ['Alice', 'Dave', const('Dollar')]))], true, ['Alice', 'Carol']),
 sas(release, ['Carol', 'Bob', one('Dave', ['Carol', 'Bob']), one('Alice', 'Dave')], ['Dave', 'Dollar', 'Alice', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', const('Dollar'), 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(coin, ['Bob', 'Dave', const('Dollar')])), atom(knows, ['Bob', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Bob']), atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol']), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', const('Dollar'), 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Bob']),
 sas(return, ['Carol', 'Alice', one('Dave', ['Carol', 'Alice']), one('Bob', 'Dave')], ['Dave', 'Dollar', 'Bob', 'Cond', 'Sum'], [not(times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', const('Dollar'), 'Alice', 'Bob', 'Cond']))), times(num('Sum'), atom(coin, ['Alice', 'Dave', const('Dollar')])), atom(knows, ['Alice', 'Dave'])], [atom(identity, ['Carol']), atom(identity, ['Alice']), atom(knows, ['Carol', 'Alice']), atom(knows, ['Alice', 'Carol']), times(num('Sum'), atom(escrow_coin, ['Carol', 'Dave', const('Dollar'), 'Alice', 'Bob', 'Cond']))], true, ['Carol', 'Alice']),
 sas(redeem, ['Alice', 'Bob', one('Carol', ['Alice', 'Bob'])], ['Dollar', 'Carol'], [not(atom(coin, ['Alice', 'Bob', const('Dollar')])), atom(coin, ['Bob', 'Bob', const('Dollar')]), not(atom(coin, ['Bob', 'Carol', const('Dollar')])), atom(coin, ['Alice', 'Carol', const('Dollar')]), atom(knows, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(coin, ['Alice', 'Bob', const('Dollar')]), atom(coin, ['Bob', 'Carol', const('Dollar')])], true, ['Alice']),
 sas(first_issue, ['Alice'], ['Dollar', 'Sum'], [times(num('Sum'), atom(coin, ['Alice', 'Alice', const('Dollar')])), atom(issued_in, ['Alice', const('Dollar')])], [atom(identity, ['Alice']), not(atom(issued_in, ['Alice', '_']))], true, ['Alice'])])).
