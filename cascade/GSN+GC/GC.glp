%% ---------------------------------------------------------------------------
%% GC.glp --- the grassroots currencies contract, Currencies' (a contract is
%% its platform's paper's; Coordination Appendix C), in the clause syntax of
%% GSC's paper, Section 3.2, sas(Name, Names, Vars, Head, Body, Constraint,
%% Guards), as programs/gsc/README.md reads it; its types, SSchema and
%% SContract, are the root's (programs/self.glp), declared once for every
%% contract (GSC, 2026-11-09, no duplicate content).  The clauses are in
%% GC.txt beside this file.  GC extends GKK, Grassroots Keys and Knowledge,
%% GSC's (programs/gsc/GKK.glp; Udi, 2026-10-20), so the term holds GKK's
%% three schemas, establish, acquaint and introduce (GKK:2 Acquaintance since 2026-10-25), and four of its own over the
%% predicate coin: coin(u) in the state of p is a coin issued by u and held
%% by p; the paper writes the predicate as the cent sign, which is not a GLP
%% constant.  Every role but establish's requires identity.  Clauses 2 to 4
%% require that Alice knows Bob, and clause 2 that Bob knows Alice: the swap
%% requires knows of the other at both roles, and pay and redeem require
%% knows(q) at p (Udi, 2026-10-20, in chat with GSC #5 and Currencies #11).
%% No role requires a friend.  A coin carries its issuer's public key, so
%% whoever holds one knows its issuer (GC, Section 2.1): swap and redeem add
%% knows of the issuer of what a role receives at that role, and pay adds
%% none, the payee receiving coins of their own issue (Udi, 2026-10-25,
%% approving Currencies #13's answer to the review of 2026-10-24, C12).
%% Amounts are numbers, as act schemas allow
%% them (GSC, Section 3.2): mint mints k coins, a swap exchanges k coins for
%% k1, and a payment pays k, the paper's multiplicities k and k' (GC,
%% Appendix A); num(k) is a value variable k, listed in Vars in the order of
%% the paper's head, and times(num(k), A) the atom A k times.  GSC's checker
%% (programs/gsc/test_gsc.sh) and vGLP's compiler to the canonical CVA
%% platform (programs/vglp/cva/compile.sh) read the term from here,
%% contract_named/2 printing it.
%%
%% This term is the one source of the schemas: a run of the cascade prints
%% their notation from it as schemas.txt (cascade.sh, programs/gsc/notation.glp),
%% and the notation hand-written above each term until 2026-10-20 is gone
%% (Udi, 2026-10-20; Code #12 to Currencies, 13:45 UTC).  Each comment below
%% names the clause a schema realises.  Each atom carries its holder first,
%% a role by its name in Names, the clause's names (GSC #8, 2026-10-25; Udi
%% approving), so that a pragma's name maps to its role; the head holds,
%% role by role, the atoms the role adds and then those it deletes, negated;
%% the body, role by role, the atoms it deletes, those it keeps, and those it
%% forbids, negated; Guards the roles that must will the act; u, v and r are
%% party variables, in Names after the roles.
%% Written by Currencies #11 Cowork, 2026-10-20, in place of the term of
%% 2026-10-18 in GSC's old form, schema(Name, Roles); establish forbidding
%% identity by Currencies #12, 2026-10-23.  The multiplicities k and k1 are
%% positive whole numbers, as every multiplicity is (GSC, 2026-10-23: a
%% multiplicity is a positive whole number, by what counting is), so the
%% schemas carry no constraint on them.  Knows of the issuer at the
%% receiving roles, Currencies #13 Cowork, 2026-10-25.  In the clause
%% syntax, the root's types in place of a copy of them, the schemas
%% unchanged, Currencies #18, 2026-11-11.
%% ---------------------------------------------------------------------------

%% contract_named(gc, C): the contract, GC (Coordination Appendix C).
procedure contract_named(Constant?, SContract).
contract_named(gc,
   [
    %% GKK:1, Identity: act once, so establish forbids the identity it adds (Udi, 2026-10-23, to GSC #6).
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice']))],
       true,
       ['Alice']),
    %% GKK:2, Acquaintance.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']),
        atom(identity, ['Bob'])],
       true,
       ['Alice', 'Bob']),
    %% GKK:3, Introduction: p, who knows q and c, introduces c to q, who knows p.
    sas(introduce, ['Alice', 'Bob', c], [c],
       [atom(knows, ['Bob', c])],
       [atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(knows, ['Alice', c]),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
    %% GC:1, Minting: p mints k p-coins.
    sas(mint, ['Alice'], [k],
       [times(num(k), atom(coin, ['Alice', 'Alice']))],
       [atom(identity, ['Alice'])],
       true,
       ['Alice']),
    %% GC:2, Swap: p and q, who know each other, swap k u-coins of p's for k1 v-coins of q's; each comes to know the issuer of what they receive.
    sas(swap, ['Alice', 'Bob', u, v], [u, k, v, k1],
       [times(num(k1), atom(coin, ['Alice', v])),
        atom(knows, ['Alice', v]),
        not(times(num(k), atom(coin, ['Alice', u]))),
        times(num(k), atom(coin, ['Bob', u])),
        atom(knows, ['Bob', u]),
        not(times(num(k1), atom(coin, ['Bob', v])))],
       [times(num(k), atom(coin, ['Alice', u])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        times(num(k1), atom(coin, ['Bob', v])),
        atom(identity, ['Bob']),
        atom(knows, ['Bob', 'Alice'])],
       true,
       ['Alice', 'Bob']),
    %% GC:3, Payment: p pays k q-coins to q, whom p knows.
    sas(pay, ['Alice', 'Bob'], [k],
       [not(times(num(k), atom(coin, ['Alice', 'Bob']))),
        times(num(k), atom(coin, ['Bob', 'Bob']))],
       [times(num(k), atom(coin, ['Alice', 'Bob'])),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob'])],
       true,
       ['Alice']),
    %% GC:4, Redemption: p redeems a q-coin against an r-coin q holds, q whom p knows; p comes to know r.
    sas(redeem, ['Alice', 'Bob', r], [r],
       [atom(coin, ['Alice', r]),
        atom(knows, ['Alice', r]),
        not(atom(coin, ['Alice', 'Bob'])),
        atom(coin, ['Bob', 'Bob']),
        not(atom(coin, ['Bob', r]))],
       [atom(coin, ['Alice', 'Bob']),
        atom(identity, ['Alice']),
        atom(knows, ['Alice', 'Bob']),
        atom(coin, ['Bob', r]),
        atom(identity, ['Bob'])],
       true,
       ['Alice'])]).
