%% ---------------------------------------------------------------------------
%% GFF-FR.glp --- the contract of fault-resilient feeds, GFF's (Udi, 2026-10-28), GFF's seventeen schemas and redundant_forward; GFF.glp is the source of the seventeen.  Originally: GFF.glp --- the contract of feeds and followers, GFF's (Coordination
%% Appendix C; Udi, 2026-10-27), in the term form programs/gsc reads (its
%% README, "Writing a contract").  GFF extends GSG (programs/gsc/GSG.glp), so
%% the term holds GKK's three schemas and GSG's two; the clauses are in GFF.txt
%% beside this file.  Written by GFF #1 Cowork by
%% /Grassroots/docs/speech-act-schemas-guide.md; the notation of each schema is
%% printed from the term by a run of the cascade (schemas.txt).
%%
%% 2026-10-28 midday, on the branch GFF-chooser, the contract in Udi's words.
%% Seventeen schemas over fifteen predicates: identity and knows, GKK's;
%% friend, GSG's; and GFF's twelve: feed(x), at Alice, an item x posted to
%% Alice's feed (GFF:1); wants(b), at Alice, that Alice wants to follow b
%% (GFF:2, the willed act); follows_friend(b), at Alice, that Alice follows
%% their friend b, and friend_follower(a), at b, that their friend a follows
%% them; follows(b, c), at Alice, that Alice follows b through their friend c,
%% following(b), once for each following of b, and follower(a, b), at Carol,
%% that a follows b through Carol (GFF:3); friend_follows(c, b), at Alice,
%% Carol's update that Carol follows b (GFF:5); item(x, b), at a follower, an
%% item x of b's feed, its identity, the act its author signed, with path(x, y, c),
%% y the signatures over x along a path it came by and c the friend it came by
%% that path from, one for each path (tied, so that Shortening reads the signatures of
%% the path from the friend it leaves; Code's play, 2026-10-28), and sent(x, a), at the sender, that x
%% was sent to a (GFF:4).  GKK:4, Signing, describes no act of its own.
%%
%% Three marks of this branch, GFF's proposals to the language (Udi,
%% 2026-10-28): every_so_often, on a role of an act whose clause opens so, which
%% may change nothing, the act recurring, how often the implementation's;
%% received, on the receiving role of a sending, requiring nothing but identity
%% and only adding, the schema compiling to two VMAT transactions, the sender's,
%% which requires the sender to know the recipient and sends, by CVA's send
%% lifted to VMAT, and the recipient's, which takes the message in --- so a
%% recipient who is down holds no sender; and, with them, the Algorithms
%% section of the pragmas, which says when the machines' acts are taken.
%%
%% A role is rs(Guard, Add, Del, Keep, Forb), its +(i), -(i), =(i) and not(i),
%% and is named by its index, role(1) the schema's first role.
%% ---------------------------------------------------------------------------

NameTerm  ::= own(Integer) ; own_var(Constant) ; nvar(Constant)
            ; ext(NameTerm, Constant).
Arg       ::= role(Integer) ; pvar(Constant) ; svar(Constant) ; nterm(NameTerm)
            ; sgn(Constant, Integer).
Args      ::= [] ; [Arg | Args].
Atom      ::= atom(Constant, Args).
Atoms     ::= [] ; [Atom | Atoms].
Guard     ::= guarded ; unguarded ; every_so_often ; received ; guarded_at(Constant).
RoleKind  ::= seated(NameTerm, Constant) ; constituent(NameTerm, Constant).
RoleSpec  ::= rs(Guard, Atoms, Atoms, Atoms, Atoms)
            ; crs(RoleKind, Guard, Atoms, Atoms, Atoms, Atoms).
RoleSpecs ::= [] ; [RoleSpec | RoleSpecs].
Reach     ::= reach(NameTerm, Constant, NameTerm).
Reaches   ::= [] ; [Reach | Reaches].
Names     ::= [] ; [Constant | Names].
Constraint ::= true ; and(Constraint, Constraint) ; signed(Arg, Arg) ; unsigned(Arg, Arg).
Schema    ::= schema(Constant, Names, Args, RoleSpecs) ; nschema(Constant, Names, Args, Constraint, RoleSpecs) ; cschema(Constant, Names, Args, Reaches, RoleSpecs).
Contract  ::= [] ; [Schema | Contract].
Preds     ::= [] ; [Constant | Preds].
Declared  ::= Contract ; reflexive(Preds, Contract).

%% contract_named(gff_fr, C): the contract, GFF-FR (Coordination Appendix C).
procedure contract_named(Constant?, Declared).
contract_named(gff_fr,
   [%% GKK:1 to GKK:3 and GSG:1, GSG:2, as GSG.glp has them.
    schema(establish, ['Alice'], [],
       [rs(guarded, [atom(identity, [])], [], [], [atom(identity, [])])]),
    schema(acquaint, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(knows, [role(2)])], [], [atom(identity, [])], []),
        rs(guarded, [atom(knows, [role(1)])], [], [atom(identity, [])], [])]),
    schema(introduce, ['Alice', 'Bob'], [pvar(c)],
       [rs(guarded, [], [], [atom(identity, []), atom(knows, [role(2)]), atom(knows, [pvar(c)])], []),
        rs(guarded, [atom(knows, [pvar(c)])], [], [atom(identity, []), atom(knows, [role(1)])], [])]),
    schema(befriend, ['Alice', 'Bob'], [],
       [rs(guarded, [atom(friend, [role(2)])], [], [atom(identity, []), atom(knows, [role(2)])], [atom(friend, [role(2)])]),
        rs(guarded, [atom(friend, [role(1)])], [], [atom(identity, []), atom(knows, [role(1)])], [atom(friend, [role(1)])])]),
    schema(unfriend, ['Alice', 'Bob'], [],
       [rs(guarded,   [], [atom(friend, [role(2)])], [atom(identity, [])], []),
        rs(unguarded, [], [atom(friend, [role(1)])], [atom(identity, [])], [])]),
%% GFF:1, Feed.  Alice posts an item x to their feed; x is a speech act Alice signs (GKK:4).
    schema(post, ['Alice'], [svar(x)],
       [rs(guarded, [atom(feed, [svar(x)])], [], [atom(identity, [])], [atom(feed, [svar(x)])])]),
%% GFF:2, Following Volition.  Alice, who knows b but is not their friend, wants to follow b: the willed act, follow, the button [Follow].
    schema(follow, ['Alice'], [pvar(b)],
       [rs(guarded, [atom(wants, [pvar(b)])], [], [atom(identity, []), atom(knows, [pvar(b)])],
                    [atom(friend, [pvar(b)]), atom(wants, [pvar(b)])])]),
%% GFF:2, Following Volition.  Alice ceases to want to follow b: the willed act, unfollow, the button [Unfollow].
    schema(unfollow, ['Alice'], [pvar(b)],
       [rs(guarded, [], [atom(wants, [pvar(b)])], [atom(identity, [])], [])]),
%% GFF:2, Following Volition.  Friends follow each other: an act of the two machines.
    schema(friends_follow, ['Alice', 'Bob'], [],
       [rs(unguarded, [atom(follows_friend, [role(2)]), atom(following, [role(2)])], [],
                      [atom(identity, []), atom(friend, [role(2)])],
                      [atom(follows_friend, [role(2)])]),
        rs(unguarded, [atom(friend_follower, [role(1)])], [], [atom(identity, [])], [])]),
%% GFF:2, Following Volition.  A friend's following ends with the friendship.
    schema(friend_following_ended, ['Alice', 'Bob'], [],
       [rs(unguarded, [], [atom(follows_friend, [role(2)]), atom(following, [role(2)])],
                      [atom(identity, [])], [atom(friend, [role(2)])]),
        rs(unguarded, [], [atom(friend_follower, [role(1)])], [atom(identity, [])], [])]),
%% GFF:3, Following via Friend.  Alice, who wants to follow b, follows b through their friend Carol that follows b: the machines' act, taken as the Algorithms pragma says; it allows several friends at once.
    schema(via_friend, ['Alice', 'Carol'], [pvar(b)],
       [rs(unguarded, [atom(follows, [pvar(b), role(2)]), atom(following, [pvar(b)])], [],
                      [atom(identity, []), atom(wants, [pvar(b)]), atom(friend, [role(2)])],
                      [atom(follows, [pvar(b), role(2)])]),
        rs(unguarded, [atom(follower, [role(1), pvar(b)])], [],
                      [atom(identity, []), atom(following, [pvar(b)])], [])]),
%% GFF:3, Following via Friend.  'When Alice wants': Alice, who follows b through Carol and no longer wants to follow b, ceases following b through Carol, the machines' act, cease_via, with no clause of its own (Udi, 2026-10-28).
    schema(cease_via, ['Alice', 'Carol'], [pvar(b)],
       [rs(unguarded, [], [atom(follows, [pvar(b), role(2)]), atom(following, [pvar(b)])],
                      [atom(identity, [])], [atom(wants, [pvar(b)])]),
        rs(unguarded, [], [atom(follower, [role(1), pvar(b)])], [atom(identity, [])], [])]),
%% GFF:3, Following via Friend.  Alice's following of b through Carol ends when Carol ceases to follow b; Carol opens it, being the one who knows (Code #16, 2026-10-28).
    schema(path_broken, ['Carol', 'Alice'], [pvar(b)],
       [rs(unguarded, [], [atom(follower, [role(2), pvar(b)])], [atom(identity, [])], [atom(following, [pvar(b)])]),
        rs(unguarded, [], [atom(follows, [pvar(b), role(1)]), atom(following, [pvar(b)])],
                      [atom(identity, [])], [])]),
%% GFF:3, Following via Friend.  Alice's following of b through Carol ends when Carol ceases to be Alice's friend.
    schema(friendship_ended, ['Alice', 'Carol'], [pvar(b)],
       [rs(unguarded, [], [atom(follows, [pvar(b), role(2)]), atom(following, [pvar(b)])],
                      [atom(identity, [])], [atom(friend, [role(2)])]),
        rs(unguarded, [], [atom(follower, [role(1), pvar(b)])], [atom(identity, [])], [])]),
%% GFF:4, Delivery.  Bob sends an item x they posted to their friend Alice, who follows Bob by friendship; a sending; x carries Bob's signature from its posting (GKK:4).
    schema(deliver_own, ['Bob', 'Alice'], [svar(x)],
       [rs(unguarded, [atom(sent, [svar(x), role(2)])], [],
                      [atom(identity, []), atom(feed, [svar(x)]), atom(friend_follower, [role(2)]), atom(friend, [role(2)])],
                      [atom(sent, [svar(x), role(2)])]),
        rs(received, [atom(item, [svar(x), role(1)]), atom(path, [svar(x), svar(x), role(1)])], [], [atom(identity, [])], [])]),
%% GFF:4, Delivery.  'Carol forwards to Alice who follows Bob through Carol every item on Bob's feed not signed by Alice': a sending, signed over (GKK:4), with the constraint unsigned(Alice, y), 'Alice did not sign y', which the language gives (GKK:4, second half); x is sent to each friend once however many paths it came by.
    nschema(deliver_on, ['Carol', 'Alice'], [pvar(b), pvar(c), svar(x), svar(y)], unsigned(role(2), svar(y)),
       [rs(unguarded, [atom(sent, [svar(x), role(2)])], [],
                      [atom(identity, []), atom(following, [pvar(b)]), atom(item, [svar(x), pvar(b)]), atom(path, [svar(x), svar(y), pvar(c)]),
                       atom(follower, [role(2), pvar(b)]), atom(friend, [role(2)])],
                      [atom(sent, [svar(x), role(2)])]),
        rs(received, [atom(item, [svar(x), pvar(b)]), atom(path, [svar(x), sgn(y, 1), role(1)])], [], [atom(identity, [])], [])]),
%% GFF:5, Updating.  'Every so often, Carol updates their friend Alice' that Carol follows b, and that Carol no longer does; Carol's role is marked every_so_often.  Carol names b by knowing b (GKK:2), which is never undone.
    schema(update, ['Carol', 'Alice'], [pvar(b)],
       [rs(every_so_often, [], [], [atom(identity, []), atom(friend, [role(2)]), atom(following, [pvar(b)])], []),
        rs(unguarded, [atom(friend_follows, [role(1), pvar(b)])], [], [atom(identity, [])],
                      [atom(friend_follows, [role(1), pvar(b)])])]),
    schema(update_ceased, ['Carol', 'Alice'], [pvar(b)],
       [rs(every_so_often, [], [], [atom(identity, []), atom(friend, [role(2)]), atom(knows, [pvar(b)])], [atom(following, [pvar(b)])]),
        rs(unguarded, [], [atom(friend_follows, [role(1), pvar(b)])], [atom(identity, [])], [])]),
%% GFF-FR:2, Redundant forwarding.  Alice, who follows b through two friends, Dave among them, and received from Carol an item x of b's feed not signed by Dave, forwards it to Dave: a sending, the machines' act.  'Through Carol and through Dave' is following(b) twice at Alice with follows(b, Dave); Carol is c of path(x, y, c), bound from Alice's state (the relaxed rule, 2026-10-28); 'not signed by Dave' is the constraint.
    nschema(redundant_forward, ['Alice', 'Dave'], [pvar(b), pvar(c), svar(x), svar(y)], unsigned(role(2), svar(y)),
       [rs(unguarded, [atom(sent, [svar(x), role(2)])], [],
                      [atom(identity, []), atom(following, [pvar(b)]), atom(following, [pvar(b)]), atom(follows, [pvar(b), role(2)]),
                       atom(item, [svar(x), pvar(b)]), atom(path, [svar(x), svar(y), pvar(c)])],
                      [atom(sent, [svar(x), role(2)])]),
        rs(received, [atom(item, [svar(x), pvar(b)]), atom(path, [svar(x), sgn(y, 1), role(1)])], [],
                      [atom(identity, [])], [])])]).
