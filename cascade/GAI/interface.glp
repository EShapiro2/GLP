  type('Recs', [[], ['Rec' | 'Recs']]),
  type('App', [app('GAtoms', 'Integer', 'Lock', 'Recs')]),
  type('Pend', [deferred('Net')]),
  type('Pends', [[], ['Pend' | 'Pends']]),
  type('WKey', [op('Class'), vt('Attempt'), cm('Attempt'), wd('Attempt', 'Attempt'), ip('Peer', 'Peer')]),
  type('Wait', [w('WKey', 'Integer')]),
  type('Waits', [[], ['Wait' | 'Waits']]),
  type('WFound', [at('Integer'), unseen]),
  type('St', [st('Peer', 'App', 'Integer', 'Peers', 'Peers', 'Peers', 'Peers', 'Waits', 'Infos', 'Pends', 'Classes')]),
  type('OpenApproval', [oc('Attempt', dual('Close'))]),
  type('OpenApprovals', [[], ['OpenApproval' | 'OpenApprovals']]),
  type('Send', [to('Peer', 'Cargo')]),
  type('Sends', [[], ['Send' | 'Sends']]),
  type('Subj', [sub('Info'), pair, prop('Info', 'Class')]),
  type('Cand', [cand('WKey', 'Subj')]),
  type('Cands', [[], ['Cand' | 'Cands']]),
  type('Choice', [take('WKey', 'Subj'), none]),
  type('Pair', [pr('Peer', 'Peer')]),
  type('Pairs', [[], ['Pair' | 'Pairs']]),
  type('PKey', [key('WKey'), nokey]),
  type('Cond', [go('Info'), drop]),
  type('PCond', [pgo('Info', 'Class'), pdrop]),
  type('Named', [named('Class'), unnamed]),
  type('Classes', [[], ['Class' | 'Classes']]),
  type('Aged', [aged('Integer', 'YesNo', 'Class')]),
  type('Ageds', [[], ['Aged' | 'Ageds']]),
  type('Pick', [picked('Aged'), nopick]),
