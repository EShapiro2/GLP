%% The interface of the canonical CVA platform of GAI in sGLP's term form
%% (programs/sglp/README.md, "The term form"), printed by programs/sglp/cva/interface.sh
%% from platform.vglp and platform.glp beside it: the types the platform defines
%% and those of the root it names, its volitional procedure declarations, and
%% compiled(P, N) of each procedure of its canonical compilation.  An owner's
%% sGLP source is transformed against it (programs/sglp/transform.sh --interface).

exported procedure interface(SglpTerms).
interface([
  type('Class', [establish('Peer'), befriend('Peer', 'Peer'), unfriend_p('Peer', 'Peer'), unfriend_q('Peer', 'Peer'), enter('Peer', 'Peer', 'Speech'), agent_befriend('Peer', 'Peer', 'Peer', 'Speech'), agents_befriend('Peer', 'Peer', 'Peer', 'Peer', 'Speech', 'Speech'), agent_unfriend('Peer', 'Peer', 'Peer'), retire('Peer', 'Peer'), sign('Peer', 'Speech'), message('Peer', 'Peer', 'Speech'), forward('Peer', 'Peer', 'Speech')]),
  type('Proposal', [establish('Peer'), befriend('Peer', 'Peer'), unfriend_p('Peer', 'Peer'), unfriend_q('Peer', 'Peer'), enter('Peer', 'Peer', 'Speech'), agent_befriend('Peer', 'Peer', 'Peer', 'Speech'), agents_befriend('Peer', 'Peer', 'Peer', 'Peer', 'Speech', 'Speech'), agent_unfriend('Peer', 'Peer', 'Peer'), retire('Peer', 'Peer'), sign('Peer', 'Speech'), message('Peer', 'Peer', 'Speech'), forward('Peer', 'Peer', 'Speech')]),
  type('Request', [propose('Proposal'), known('Peer')]),
  type('Atom', [identity, retired, friend('Peer'), agent, principal('Peer'), principal_of('Peer'), item('Speech'), attestation('Speech'), agent_of('Peer', 'Peer', 'Speech'), retired_of('Peer'), authored('Speech')]),
  type('Peer', ['Key']),
  type('Speech', [speech('Utterance', 'Peer')]),
  type('Utterance', [utterance('String'), 'Speech']),
  type('YesNo', [yes, no]),
  type('Decision', [commit, abort]),
  type('Attempt', [attempt('Peer', 'Integer', 'Integer', 'Class')]),
  type('Cargo', [start('Attempt'), vote('Attempt', 'YesNo'), outcome('Attempt', 'Decision'), yield('Attempt')]),
  type('Content', [hello('Peer'), ihello('Peer'), intro('Peer', 'Peer'), cargo('Peer', 'Cargo')]),
  type('Net', [msg('Peer', 'Content')]),
  type('Approval', [approval('Attempt', dual('YesNo'))]),
  type('Menu', [menu('Key', 'List'('Key'), dual('Request'))]),
  type('Close', [close]),
  type('Trigger', [req('Request'), net('Net'), answered('Attempt', 'YesNo'), recheck, own]),
  type('Var', [role('Integer'), pvar('Constant'), svar('Constant'), sgn('Constant', 'Integer'), nterm('NTerm')]),
  type('NTerm', [own('Integer'), own_var('Constant'), ext('NTerm', 'Constant')]),
  type('Vars', [[], ['Var' | 'Vars']]),
  type('SAtom', [atom('Constant', 'Vars')]),
  type('SAtoms', [[], ['SAtom' | 'SAtoms']]),
  type('Guard', [guarded, unguarded]),
  type('RoleSpec', [rs('Guard', 'SAtoms', 'SAtoms', 'SAtoms', 'SAtoms')]),
  type('RoleSpecs', [[], ['RoleSpec' | 'RoleSpecs']]),
  type('Schema', [schema('Constant', 'Vars', 'RoleSpecs'), lschema('Constant', 'Vars', 'RoleSpecs', 'Listing')]),
  type('Listing', [listing('Integer', 'Integer', 'Constant', 'Vars')]),
  type('PeerLists', [[], ['Peers' | 'PeerLists']]),
  type('Schemas', [[], ['Schema' | 'Schemas']]),
  type('Preds', [[], ['Constant' | 'Preds']]),
  type('CName', [community('Peer'), dot('CName', 'Speech')]),
  type('Val', [p('Peer'), s('Speech'), c('CName')]),
  type('NameParts', [parts('Vars', 'Vals'), noparts]),
  type('Vals', [[], ['Val' | 'Vals']]),
  type('GAtom', [g('Constant', 'Vals')]),
  type('GAtoms', [[], ['GAtom' | 'GAtoms']]),
  type('Output', [view('List'('Atom'), 'List'('Key')), refused('Class', 'Key'), yielded('Class')]),
  type('Shown', [shown('Atom'), unshown]),
  type('Bind', [b('Var', 'Val')]),
  type('Binding', [[], ['Bind' | 'Binding']]),
  type('Bindings', [[], ['Binding' | 'Bindings']]),
  type('Found', [found('Val'), free]),
  type('Match', [match('Binding'), nomatch]),
  type('SgnParts', [signed('Val', 'Peer'), unsigned]),
  type('Peers', [[], ['Peer' | 'Peers']]),
  type('Nets', [[], ['Net' | 'Nets']]),
  type('Ints', [[], ['Integer' | 'Ints']]),
  type('Delta', [delta('Peer', 'GAtoms', 'GAtoms')]),
  type('Deltas', [[], ['Delta' | 'Deltas']]),
  type('Mate', [mate('Constant', 'Binding', 'Peers', 'Peer')]),
  type('Mates', [[], ['Mate' | 'Mates']]),
  type('Opener', [opener('Peer'), guarded_part]),
  type('Part', [pt('Class', 'Peers', 'Opener')]),
  type('Parts', [[], ['Part' | 'Parts']]),
  type('Info', [ci('Class', 'Deltas', 'Peers', 'Parts', 'Mates')]),
  type('Infos', [[], ['Info' | 'Infos']]),
  type('ClassRes', [cls('Info'), nocls]),
