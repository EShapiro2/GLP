%% Local-Overlay.glp --- printed by adopt.py from Local-Overlay.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Local-Overlay.txt and run adopt.py 'Local Overlay'.
% contract_named(local_overlay, C): the contract, Local Overlay.
procedure contract_named(Constant?, SDeclared).
contract_named(local_overlay, environment([bound, closer, furthest, may_point_friend], reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], ['Carol'], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(point_friend, ['Alice', 'Bob'], [], [atom(points_to, ['Alice', 'Bob'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), not(atom(points_to, ['Alice', 'Bob'])), atom(may_point_friend, ['Alice', 'Bob'])], true, ['Alice']),
 sas(point_transitive, ['Alice', 'Bob', 'Carol'], ['Carol'], [atom(points_to, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(knows, ['Alice', 'Carol']), atom(points_to, ['Alice', 'Bob']), atom(points_to, ['Bob', 'Carol']), not(atom(points_to, ['Alice', 'Carol'])), atom(closer, ['Alice', 'Carol'])], true, ['Alice']),
 sas(unpoint, ['Alice', 'Bob'], ['Bob'], [not(atom(points_to, ['Alice', 'Bob']))], [atom(identity, ['Alice']), atom(points_to, ['Alice', 'Bob']), atom(bound, ['Alice', val('D')]), atom(furthest, ['Alice', 'Bob'])], gt(cardinality(['X1'], atom(points_to, ['Alice', 'X1']), true), val('D')), ['Alice'])]))).
