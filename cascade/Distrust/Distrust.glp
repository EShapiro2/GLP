%% Distrust.glp --- printed by adopt.py from Distrust.txt: the contract's full schemas, the Calculus's term.glp.txt,
%% complete in itself.  Not to be edited: edit Distrust.txt and run adopt.py Distrust.
% contract_named(distrust, C): the contract, Distrust.
procedure contract_named(Constant?, SDeclared).
contract_named(distrust, reflexive([knows], [sas(establish, ['Alice'], [], [atom(identity, ['Alice']), atom(person, ['Alice'])], [not(atom(identity, ['Alice']))], true, ['Alice']),
 sas(acquaint, ['Alice', 'Bob'], [], [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob'])], true, ['Alice', 'Bob']),
 sas(introduce, ['Bob', 'Alice', 'Carol'], [], [atom(knows, ['Bob', 'Carol'])], [atom(identity, ['Bob']), atom(identity, ['Alice']), atom(identity, ['Carol']), atom(person, ['Alice']), atom(person, ['Bob']), atom(person, ['Carol']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), atom(knows, ['Alice', 'Carol'])], true, ['Alice', 'Bob']),
 sas(befriend, ['Alice', 'Bob'], [], [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], true, ['Alice', 'Bob']),
 sas(unfriend, ['Alice', 'Bob'], [], [not(atom(friend, ['Alice', 'Bob'])), not(atom(friend, ['Bob', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Bob']), atom(person, ['Alice']), atom(person, ['Bob']), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])], true, ['Alice']),
 sas(distrust, ['Alice', 'Carol'], [], [atom(distrusts, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), not(atom(friend, ['Alice', 'Carol'])), not(atom(friend, ['Carol', 'Alice'])), not(atom(distrusts, ['Alice', 'Carol']))], true, ['Alice']),
 sas(distrust_friend, ['Alice', 'Carol'], [], [atom(distrusts, ['Alice', 'Carol']), not(atom(friend, ['Alice', 'Carol'])), not(atom(friend, ['Carol', 'Alice']))], [atom(identity, ['Alice']), atom(identity, ['Carol']), atom(knows, ['Alice', 'Carol']), not(atom(distrusts, ['Alice', 'Carol'])), atom(friend, ['Alice', 'Carol']), atom(friend, ['Carol', 'Alice'])], true, ['Alice']),
 sas(propagate, ['Alice', 'Bob', 'Carol'], ['Carol'], [atom(distrusts, ['Alice', 'Carol'])], [atom(identity, ['Alice']), atom(identity, ['Bob']), not(atom(knows, ['Alice', 'Carol'])), atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice']), atom(distrusts, ['Bob', 'Carol']), not(atom(distrusts, ['Alice', 'Carol']))], true, ['Alice']),
 sas(cease, ['Alice', 'Carol'], ['Carol'], [not(atom(distrusts, ['Alice', 'Carol']))], [atom(identity, ['Alice']), atom(distrusts, ['Alice', 'Carol'])], true, ['Alice'])])).
