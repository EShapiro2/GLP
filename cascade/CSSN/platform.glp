procedure binding_of(Class?, Constant, Binding).
binding_of(establish(V1), establish, [b(role(1), p(V1?))]).
binding_of(befriend(V1, V2), befriend, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(unfriend(V1, V2), unfriend, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(sign(V1, V2), sign, [b(role(1), p(V1?)), b(svar(x), s(V2?))]).
binding_of(message(V1, V2, V3), message, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(x), s(V3?))]).
binding_of(forward(V1, V2, V3), forward, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(x), s(V3?))]).
binding_of(create(V1, V2), create, [b(role(1), p(V1?)), b(svar(n), s(V2?))]).
binding_of(join(V1, V2, V3), join, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(n), s(V3?))]).
binding_of(leave(V1, V2, V3), leave, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(n), s(V3?))]).
binding_of(close(V1, V2, V3), close, B?) :- listed_binding(close, [b(role(1), p(V1?)), b(svar(n), s(V3?))], [V2?], B).
binding_of(drop(V1, V2, V3), drop, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(n), s(V3?))]).
binding_of(post_own(V1, V2, V3), post_own, [b(role(1), p(V1?)), b(svar(x), s(V2?)), b(svar(n), s(V3?))]).
binding_of(post(V1, V2, V3, V4), post, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(x), s(V3?)), b(svar(n), s(V4?))]).
binding_of(post_forward(V1, V2, V3, V4), post_forward, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(x), s(V3?)), b(svar(n), s(V4?))]).
binding_of(deliver(V1, V2, V3, V4), deliver, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(y), s(V3?)), b(svar(n), s(V4?))]).
binding_of(deliver_own(V1, V2, V3, V4), deliver_own, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(y), s(V3?)), b(svar(n), s(V4?))]).
binding_of(enter(V1, V2), enter, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(enter_2(V1, V2, V3), enter_2, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?))]).
binding_of(of_age(V1, V2), of_age, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(of_age_2(V1, V2, V3), of_age_2, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?))]).
binding_of(child_befriend(V1, V2, V3, V4), child_befriend, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?)), b(role(4), p(V4?))]).
binding_of(child_adult_befriend(V1, V2, V3), child_adult_befriend, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?))]).
binding_of(child_unfriend(V1, V2, V3), child_unfriend, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?))]).
binding_of(parent_unfriend(V1, V2), parent_unfriend, [b(role(1), p(V1?)), b(role(2), p(V2?))]).
binding_of(parent_unfriend_2(V1, V2, V3), parent_unfriend_2, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?))]).
binding_of(child_join(V1, V2, V3, V4), child_join, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?)), b(svar(n), s(V4?))]).
binding_of(child_join_2(V1, V2, V3, V4, V5), child_join_2, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?)), b(role(4), p(V4?)), b(svar(n), s(V5?))]).
binding_of(child_leave(V1, V2, V3, V4), child_leave, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(role(3), p(V3?)), b(svar(n), s(V4?))]).
binding_of(child_close(V1, V2, V3, V4), child_close, B?) :- listed_binding(child_close, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(n), s(V4?))], [V3?], B).

procedure class_of(Constant?, Binding?, Peer?, Class).
class_of(establish, B, D, establish(V1?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1).
class_of(befriend, B, D, befriend(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(unfriend, B, D, unfriend(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(sign, B, D, sign(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_speech(svar(x), B?, D?, V2).
class_of(message, B, D, message(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(x), B?, D?, V3).
class_of(forward, B, D, forward(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(x), B?, D?, V3).
class_of(create, B, D, create(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_speech(svar(n), B?, D?, V2).
class_of(join, B, D, join(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(n), B?, D?, V3).
class_of(leave, B, D, leave(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(n), B?, D?, V3).
class_of(close, B, D, close(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), copies_of(B?, 2, V2), val_speech(svar(n), B?, D?, V3).
class_of(drop, B, D, drop(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(n), B?, D?, V3).
class_of(post_own, B, D, post_own(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_speech(svar(x), B?, D?, V2), val_speech(svar(n), B?, D?, V3).
class_of(post, B, D, post(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(x), B?, D?, V3), val_speech(svar(n), B?, D?, V4).
class_of(post_forward, B, D, post_forward(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(x), B?, D?, V3), val_speech(svar(n), B?, D?, V4).
class_of(deliver, B, D, deliver(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(y), B?, D?, V3), val_speech(svar(n), B?, D?, V4).
class_of(deliver_own, B, D, deliver_own(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_speech(svar(y), B?, D?, V3), val_speech(svar(n), B?, D?, V4).
class_of(enter, B, D, enter(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(enter_2, B, D, enter_2(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3).
class_of(of_age, B, D, of_age(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(of_age_2, B, D, of_age_2(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3).
class_of(child_befriend, B, D, child_befriend(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3), val_peer(role(4), B?, D?, V4).
class_of(child_adult_befriend, B, D, child_adult_befriend(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3).
class_of(child_unfriend, B, D, child_unfriend(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3).
class_of(parent_unfriend, B, D, parent_unfriend(V1?, V2?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2).
class_of(parent_unfriend_2, B, D, parent_unfriend_2(V1?, V2?, V3?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3).
class_of(child_join, B, D, child_join(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3), val_speech(svar(n), B?, D?, V4).
class_of(child_join_2, B, D, child_join_2(V1?, V2?, V3?, V4?, V5?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3), val_peer(role(4), B?, D?, V4), val_speech(svar(n), B?, D?, V5).
class_of(child_leave, B, D, child_leave(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), val_peer(role(3), B?, D?, V3), val_speech(svar(n), B?, D?, V4).
class_of(child_close, B, D, child_close(V1?, V2?, V3?, V4?)) :- ground(B?), ground(D?) | val_peer(role(1), B?, D?, V1), val_peer(role(2), B?, D?, V2), copies_of(B?, 3, V3), val_speech(svar(n), B?, D?, V4).

procedure name_class(Proposal?, GAtoms?, Class).
name_class(establish(V1), _, establish(V1?)).
name_class(befriend(V1, V2), _, befriend(V1?, V2?)).
name_class(unfriend(V1, V2), _, unfriend(V1?, V2?)).
name_class(sign(V1, V2), _, sign(V1?, V2?)).
name_class(message(V1, V2, V3), _, message(V1?, V2?, V3?)).
name_class(forward(V1, V2, V3), _, forward(V1?, V2?, V3?)).
name_class(create(V1, V2), _, create(V1?, V2?)).
name_class(join(V1, V2, V3), _, join(V1?, V2?, V3?)).
name_class(leave(V1, V2, V3), _, leave(V1?, V2?, V3?)).
name_class(close(V1, V3), St, C?) :- listed_class(close, [b(role(1), p(V1?)), b(svar(n), s(V3?))], St?, C).
name_class(post_own(V1, V2, V3), _, post_own(V1?, V2?, V3?)).
name_class(post(V1, V2, V3, V4), _, post(V1?, V2?, V3?, V4?)).
name_class(post_forward(V1, V2, V3, V4), _, post_forward(V1?, V2?, V3?, V4?)).
name_class(enter(V1, V2), _, enter(V1?, V2?)).
name_class(enter_2(V1, V2, V3), _, enter_2(V1?, V2?, V3?)).
name_class(of_age(V1, V2), _, of_age(V1?, V2?)).
name_class(of_age_2(V1, V2, V3), _, of_age_2(V1?, V2?, V3?)).
name_class(child_befriend(V1, V2, V3, V4), _, child_befriend(V1?, V2?, V3?, V4?)).
name_class(child_adult_befriend(V1, V2, V3), _, child_adult_befriend(V1?, V2?, V3?)).
name_class(child_unfriend(V1, V2, V3), _, child_unfriend(V1?, V2?, V3?)).
name_class(parent_unfriend(V1, V2), _, parent_unfriend(V1?, V2?)).
name_class(parent_unfriend_2(V1, V2, V3), _, parent_unfriend_2(V1?, V2?, V3?)).
name_class(child_join(V1, V2, V3, V4), _, child_join(V1?, V2?, V3?, V4?)).
name_class(child_join_2(V1, V2, V3, V4, V5), _, child_join_2(V1?, V2?, V3?, V4?, V5?)).
name_class(child_leave(V1, V2, V3, V4), _, child_leave(V1?, V2?, V3?, V4?)).
name_class(child_close(V1, V2, V4), St, C?) :- listed_class(child_close, [b(role(1), p(V1?)), b(role(2), p(V2?)), b(svar(n), s(V4?))], St?, C).

exported procedure agent(Peer?, Stream(Net)?, Stream(Net), Stream(Output), Stream(Ask(Question))).
agent(Id, NetIn, Out?, [view([], []) | Thr?], D?) :- ground(Id?) | request(Id?, [], Rq, D1), tag_net(NetIn?, Nt), merge(Rq?, Nt?, M1), merge(M1?, Ans?, M2), merge(M2?, [own | Ow?], In), agent_goal([], In?, yes, Ans, Thr, Out, Ow, [], st(Id?, app([], 0, unlocked, []), 0, [], [], [], [], [], [], [], []), D2), merge(D1?, D2?, D).

procedure request(Key?, List(Key)?, Stream(Trigger), Stream(Ask(Question))).
request(S1, S2, S3?, [ask('Menu', menu_w(X?)) | D?]) :- request1(S1?, S2?, S3, X, D).

procedure request1(Key?, List(Key)?, Stream(Trigger), Menu, Stream(Ask(Question))).
request1(Id, Ks, Out?, menu(Id?, Ks?, R), []) :- ground(Id?), ground(Ks?) | await_request(R?, Out).

procedure await_request(Request?, Stream(Trigger)).
await_request(propose(C), [req(propose(C?))]).
await_request(known(Q), [req(known(Q?))]).

procedure ask_next(St?, Stream(Trigger), Stream(Trigger)?, Stream(Ask(Question))).
ask_next(St, Ans?, Ans1, D?) :- ground(St?) | st_id(St?, Id), st_known(St?, Ks), request(Id?, Ks?, R, D), merge(R?, Ans1?, Ans).

procedure tag_net(Stream(Net)?, Stream(Trigger)).
tag_net([M | Ms], [net(M?) | Ts?]) :- tag_net(Ms?, Ts).
tag_net([], []).

procedure respond(Attempt?, Close?, Stream(Trigger), Stream(Ask(Question))).
respond(S1, S2, S3?, [ask('Approval', approval_w(X?)) | D?]) :- respond1(S1?, S2?, S3, X, D).

procedure respond1(Attempt?, Close?, Stream(Trigger), Approval, Stream(Ask(Question))).
respond1(At, Cl, Out?, approval(At?, YN), []) :- ground(At?) | await(At?, YN?, Cl?, Out).

procedure await(Attempt?, YesNo?, Close?, Stream(Trigger)).
await(At, yes, _, [answered(At?, yes)]).
await(At, no, _, [answered(At?, no)]).
await(_, _, close, []).

procedure agent_goal(Stream(Trigger)?, Stream(Trigger)?, YesNo?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
agent_goal([T | Ls], In, U, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- then_local(U?, Th), step(T?, Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
agent_goal([], [T | In], U, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- then_read(U?, Th), step(T?, Th?, [], In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
agent_goal([], [], _, [], [], [], [], _, _, []).

procedure then_local(YesNo?, Then).
then_local(yes, own_unread).
then_local(no, no_own).

procedure then_read(YesNo?, Then).
then_read(yes, own_unread).
then_read(no, write_own).

procedure step(Trigger?, Then?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
step(req(propose(N)), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(N?), ground(St?) | st_app(St?, Ap0), ask_next(St?, Ans, Ans1?, D1), st_ms(St?, S), name_class(N?, S?, C), propose_cond(C?, St?, Cd, St1), dispatch_propose(Cd?, Th?, Ap0?, Ls?, In?, Ans1, Thr, Out, Ow, Approvals?, St1?, D2), merge(D1?, D2?, D).
step(req(known(Q)), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(Q?), ground(St?) | st_app(St?, Ap0), ask_next(St?, Ans, Ans1?, D1), known_cond(Q?, St?, Cd), dispatch_known(Cd?, Q?, Th?, Ap0?, Ls?, In?, Ans1, Thr, Out, Ow, Approvals?, St?, D2), merge(D1?, D2?, D).
step(net(msg(_, hello(P))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(P?), ground(St?) | st_app(St?, Ap0), hello_cond(P?, St?, Cd), dispatch_hello(Cd?, P?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
step(net(msg(_, ihello(P))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(P?), ground(St?) | st_app(St?, Ap0), ihello_cond(P?, St?, Cd), dispatch_ihello(Cd?, P?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
step(net(msg(_, intro(_, Q))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(Q?), ground(St?) | st_app(St?, Ap0), intro_cond(Q?, St?, Cd), dispatch_intro(Cd?, Q?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
step(net(msg(To, cargo(F, X))), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(To?), ground(F?), ground(X?), ground(St?) | st_app(St?, Ap0), message_cond(X?, St?, Cd, St1), dispatch_message(Cd?, msg(To?, cargo(F?, X?)), F?, X?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St1?, D).
step(answered(At, YN), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?), ground(YN?), ground(St?) | st_app(St?, Ap0), close_approval(At?, Approvals?, Approvals1), answer_cond(At?, St?, Cd, St1), dispatch_answer(Cd?, YN?, At?, Th?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals1?, St1?, D).
step(recheck, Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(St?) | st_pends(St?, Pd), recheck_find(Pd?, St?, F), recheck1(F?, Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
step(own, _, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- take_own(Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure next(Then?, YesNo?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
next(Th, Kick, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(Ap0?), ground(St?) | app_changed(Ap0?, St?, Ca1), app_changed(Ap0?, St?, Ca2), or(Ca2?, Kick?, Re), close_falsified(Ca1?, Approvals?, St?, Approvals1), repend(Re?, St?, Ag, St1), own_after(Th?, Ow, Ow1?, U), app(Ag?, Ls?, L1), show_state(Ap0?, St?, Thr, Thr1?), agent_goal(L1?, In?, U?, Ans, Thr1, Out, Ow1, Approvals1?, St1?, D).

procedure show_state(App?, St?, Stream(Output), Stream(Output)?).
show_state(Ap0, St, Thr?, Thr1) :- ground(Ap0?), ground(St?) | app_ms(Ap0?, S0), st_ms(St?, S1), ms_eq(S0?, S1?, Sm), neg(Sm?, Ch), show_view(Ch?, St?, Thr, Thr1?).

procedure show_known(Peer?, St?, St?, Stream(Output), Stream(Output)?, St).
show_known(Q, St0, St, Thr?, Thr1, St?) :- ground(Q?), ground(St0?), ground(St?) | known_st(Q?, St0?, B0), known_st(Q?, St?, B1), neg(B0?, N0), and(N0?, B1?, B), show_view(B?, St?, Thr, Thr1?).

procedure show_view(YesNo?, St?, Stream(Output), Stream(Output)?).
show_view(no, _, Thr1?, Thr1).
show_view(yes, St, [V? | Thr1?], Thr1) :- view_of(St?, V).

procedure view_of(St?, Output).
view_of(St, view(A?, Ks?)) :- ground(St?) | st_ms(St?, S), atoms_of(S?, A), st_known(St?, Ks).

procedure app_ms(App?, GAtoms).
app_ms(app(S, _, _, _), S?).

procedure st_ms(St?, GAtoms).
st_ms(st(_, app(S, _, _, _), _, _, _, _, _, _, _, _, _), S?).

procedure atoms_of(GAtoms?, List(Atom)).
atoms_of([], []).
atoms_of([G | Gs], As?) :- atom_of(G?, Sh), atoms_of(Gs?, As1), shown_cons(Sh?, As1?, As).

procedure shown_cons(Shown?, List(Atom)?, List(Atom)).
shown_cons(shown(A), As, [A? | As?]).
shown_cons(unshown, As, As?).

procedure noticed(NoticeOf?, Attempt?, App?, St?, Stream(Output), Stream(Output)?, St).
noticed(K, At, Ap0, St, Thr?, Thr1, St?) :- ground(K?), ground(At?), ground(Ap0?), ground(St?) | closed_proposed(At?, Ap0?, St?, B), attempt_class(At?, C), notice_of(K?, C?, N), put_notice(B?, N?, Thr, Thr1?).

procedure notice_of(NoticeOf?, Class?, Output).
notice_of(refused_by(Q), C, refused(C?, Q?)).
notice_of(yielded_by, C, yielded(C?)).

procedure put_notice(YesNo?, Output?, Stream(Output), Stream(Output)?).
put_notice(yes, N, [N? | Thr1?], Thr1).
put_notice(no, _, Thr1?, Thr1).

procedure closed_proposed(Attempt?, App?, St?, YesNo).
closed_proposed(At, Ap0, St, B?) :- ground(At?), ground(Ap0?), ground(St?) | app_recs(Ap0?, R0), mem(closed(At?), R0?, Cl0), neg(Cl0?, Open0), st_app(St?, Ap1), app_recs(Ap1?, R1), mem(closed(At?), R1?, Cl1), st_id(St?, Id), attempt_id(At?, P), same(P?, Id?, Own), attempt_class(At?, C), binding_of(C?, Nm, Bn), marked_people(Nm?, Bn?, G), some_peer(G?, Gd), and(Open0?, Cl1?, B1), and(B1?, Own?, B2), and(B2?, Gd?, B).

procedure some_peer(Peers?, YesNo).
some_peer([], no).
some_peer([_ | _], yes).

procedure app_changed(App?, St?, YesNo).
app_changed(Ap0, St, C?) :- ground(Ap0?), ground(St?) | st_app(St?, Ap1), same(Ap0?, Ap1?, Sm), neg(Sm?, C).

procedure own_after(Then?, Stream(Trigger), Stream(Trigger)?, YesNo).
own_after(write_own, [own | Ow1?], Ow1, yes).
own_after(own_unread, Ow1?, Ow1, yes).
own_after(no_own, Ow1?, Ow1, no).

procedure repend(YesNo?, St?, Stream(Trigger), St).
repend(no, St, [], St?).
repend(yes, St, Ag?, St?) :- ground(St?) | st_pends(St?, Pd), pend_triggers(Pd?, Ag).

procedure pend_triggers(Pends?, Stream(Trigger)).
pend_triggers([], []).
pend_triggers([_ | _], [recheck]).

procedure propose_cond(Class?, St?, PCond, St).
propose_cond(C, St, Cd?, St2?) :- ground(C?), ground(St?) | st_class(C?, St?, R, St1), propose_cond1(R?, C?, St1?, Cd, St2).

procedure propose_cond1(ClassRes?, Class?, St?, PCond, St).
propose_cond1(nocls, _, St, pdrop, St?).
propose_cond1(cls(I), C, St, Cd?, St?) :- ground(I?), ground(C?), ground(St?) | st_id(St?, Id), info_parts(I?, Pts), guarding_parts(Pts?, Id?, Ps), initiate_cond(Ps?, I?, named(C?), St?, Cd).

procedure initiate_cond(Classes?, Info?, Named?, St?, PCond).
initiate_cond([], _, _, _, pdrop).
initiate_cond([P | Ps], I, N, St, Cd?) :- ground(I?), ground(N?), ground(St?) | free_i(I?, St?, Fr), no_prior_start(St?, Np), others_known(I?, St?, K), known_ok(K?, Kn), and(Fr?, Np?, B1), and(B1?, Kn?, B), initiate_part(B?, [P? | Ps?], I?, N?, St?, Cd).

procedure initiate_part(YesNo?, Classes?, Info?, Named?, St?, PCond).
initiate_part(no, _, _, _, _, pdrop).
initiate_part(yes, Ps, I, N, St, Cd?) :- ground(I?), ground(N?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_state(Ap?, S), st_props(St?, Pr), ready_parts(Ps?, Id?, S?, Rs), aged_parts(Rs?, I?, N?, Pr?, As), pick_part(As?, nopick, F), part_cond(F?, I?, N?, Cd).

procedure part_cond(Pick?, Info?, Named?, PCond).
part_cond(nopick, _, _, pdrop).
part_cond(picked(aged(_, yes, _)), I, named(C), pgo(I?, C?)).
part_cond(picked(aged(_, yes, P)), I, unnamed, pgo(I?, P?)).
part_cond(picked(aged(_, no, P)), I, _, pgo(I?, P?)).

procedure aged_parts(Classes?, Info?, Named?, Classes?, Ageds).
aged_parts([], _, _, _, []).
aged_parts([P | Ps], I, N, Pr, [aged(A?, Nd?, P?) | As?]) :- ground(P?), ground(I?), ground(N?), ground(Pr?) | part_age(Pr?, I?, P?, 1, A), named_part(N?, I?, P?, Nd), aged_parts(Ps?, I?, N?, Pr?, As).

procedure part_age(Classes?, Info?, Class?, Integer?, Integer).
part_age([], _, _, _, 0).
part_age([E | Es], I, P, K, A?) :- ground(E?), ground(I?), ground(P?), integer(K?) | term_part(E?, I?, P?, Sm), part_age1(Sm?, Es?, I?, P?, K?, A).

procedure part_age1(YesNo?, Classes?, Info?, Class?, Integer?, Integer).
part_age1(yes, _, _, _, K, K?).
part_age1(no, Es, I, P, K, A?) :- K1 := (K? + 1), part_age(Es?, I?, P?, K1?, A).

procedure named_part(Named?, Info?, Class?, YesNo).
named_part(unnamed, _, _, no).
named_part(named(C), I, P, B?) :- same_part(I?, C?, P?, B).

procedure pick_part(Ageds?, Pick?, Pick).
pick_part([], F, F?).
pick_part([X | Xs], nopick, F?) :- pick_part(Xs?, picked(X?), F).
pick_part([X | Xs], picked(Y), F?) :- ground(X?), ground(Y?) | before(X?, Y?, B), pick_part1(B?, X?, Y?, Xs?, F).

procedure pick_part1(YesNo?, Aged?, Aged?, Ageds?, Pick).
pick_part1(yes, X, _, Xs, F?) :- pick_part(Xs?, picked(X?), F).
pick_part1(no, _, Y, Xs, F?) :- pick_part(Xs?, picked(Y?), F).

procedure before(Aged?, Aged?, YesNo).
before(aged(A1, _, _), aged(A2, _, _), yes) :- (A1? < A2?) | true.
before(aged(A1, _, _), aged(A2, _, _), no) :- (A1? > A2?) | true.
before(aged(A1, N1, _), aged(A2, N2, _), B?) :- (A1? =:= A2?) | named_first(N1?, N2?, B).

procedure named_first(YesNo?, YesNo?, YesNo).
named_first(yes, no, yes).
named_first(_, _, no) :- otherwise | true.

procedure dispatch_propose(PCond?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_propose(pgo(I, P), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(I?), ground(P?), ground(St?) | propose_effect(I?, P?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, St2?, D).
dispatch_propose(pdrop, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure known_cond(Peer?, St?, YesNo).
known_cond(Q, St, R?) :- ground(Q?), ground(St?) | st_id(St?, Id), st_sent(St?, Se), same(Q?, Id?, S1), mem(Q?, Se?, S2), or(S1?, S2?, S), neg(S?, R).

procedure dispatch_known(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_known(yes, Q, Th, Ap0, Ls, In, Ans?, Thr?, [msg(Q?, hello(Id?)) | Out?], Ow?, Approvals, St, D?) :- ground(Q?), ground(St?) | st_id(St?, Id), add_sent(Q?, St?, St1), show_known(Q?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, St2?, D).
dispatch_known(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure hello_cond(Peer?, St?, YesNo).
hello_cond(P, St, R?) :- ground(St?) | st_recd(St?, Rc), mem(P?, Rc?, B), neg(B?, R).

procedure dispatch_hello(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_hello(yes, P, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(P?), ground(St?) | add_recd(P?, St?, St1), show_known(P?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, St2?, D).
dispatch_hello(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure intro_cond(Peer?, St?, YesNo).
intro_cond(Q, St, R?) :- ground(Q?), ground(St?) | st_id(St?, Id), st_isent(St?, ISe), same(Q?, Id?, S1), mem(Q?, ISe?, S2), known_st(Q?, St?, S3), or(S1?, S2?, S12), or(S12?, S3?, S), neg(S?, R).

procedure dispatch_intro(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_intro(yes, Q, Th, Ap0, Ls, In, Ans?, Thr?, [msg(Q?, ihello(Id?)) | Out?], Ow?, Approvals, St, D?) :- ground(Q?), ground(St?) | st_id(St?, Id), add_isent(Q?, St?, St1), show_known(Q?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, St2?, D).
dispatch_intro(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure ihello_cond(Peer?, St?, YesNo).
ihello_cond(P, St, R?) :- ground(St?) | st_irecd(St?, Rc), mem(P?, Rc?, B), neg(B?, R).

procedure dispatch_ihello(YesNo?, Peer?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_ihello(yes, P, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(P?), ground(St?) | add_irecd(P?, St?, St1), show_known(P?, St?, St1?, Thr, Thr1?, St2), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out, Ow, Approvals?, St2?, D).
dispatch_ihello(no, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure message_cond(Cargo?, St?, MCond, St).
message_cond(X, St, Cd?, St1?) :- ground(X?), ground(St?) | cargo_class(X?, C), st_class(C?, St?, R, St0), message_cond1(R?, X?, St0?, Cd, St1).

procedure message_cond1(ClassRes?, Cargo?, St?, MCond, St).
message_cond1(nocls, _, St, noparticipant, St?).
message_cond1(cls(I), start(At), St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), mem(closed(At?), R?, Cl), start_cond(Cl?, I?, At?, St?, Cd).
message_cond1(cls(I), vote(_, _), St, mgo(I?), St?).
message_cond1(cls(I), yield(_), St, mgo(I?), St?).
message_cond1(cls(I), outcome(_, _), St, mgo(I?), St?).

procedure start_cond(YesNo?, Info?, Attempt?, St?, MCond).
start_cond(yes, I, _, _, mgo(I?)).
start_cond(no, I, At, St, Cd?) :- ground(I?) | start_waits(I?, At?, St?, W), defer_cond1(W?, I?, Cd).

procedure defer_cond1(YesNo?, Info?, MCond).
defer_cond1(yes, _, mdefer).
defer_cond1(no, I, mgo(I?)).

procedure start_waits(Info?, Attempt?, St?, YesNo).
start_waits(I, A, St, W?) :- ground(I?), ground(A?), ground(St?) | st_pends(St?, Pd), held_prior(Pd?, A?, W1), st_app(St?, Ap), app_recs(Ap?, R), question_prior(R?, A?, W2), free_i(I?, St?, Fr), neg(Fr?, W3), or(W1?, W2?, W12), or(W12?, W3?, W).

procedure held_prior(Pends?, Attempt?, YesNo).
held_prior([], _, no).
held_prior([deferred(msg(_, cargo(_, start(B)))) | Ps], A, W?) :- ground(A?), ground(B?) | same(A?, B?, Sm), prio(B?, A?, Pr), neg(Sm?, NSm), and(NSm?, Pr?, W1), held_prior1(W1?, Ps?, A?, W).
held_prior([_ | Ps], A, W?) :- otherwise | held_prior(Ps?, A?, W).

procedure held_prior1(YesNo?, Pends?, Attempt?, YesNo).
held_prior1(yes, _, _, yes).
held_prior1(no, Ps, A, W?) :- held_prior(Ps?, A?, W).

procedure question_prior(Recs?, Attempt?, YesNo).
question_prior(R, A, W?) :- ground(R?) | question_prior1(R?, R?, A?, W).

procedure question_prior1(Recs?, Recs?, Attempt?, YesNo).
question_prior1([], _, _, no).
question_prior1([answered(G, yes) | Rs], R, A, W?) :- ground(G?), ground(R?), ground(A?) | pending_rec(G?, R?, P), same(G?, A?, Sm), neg(Sm?, NSm), prio(G?, A?, Pr), and(P?, NSm?, W0), and(W0?, Pr?, W1), question_prior2(W1?, Rs?, R?, A?, W).
question_prior1([_ | Rs], R, A, W?) :- otherwise | question_prior1(Rs?, R?, A?, W).

procedure question_prior2(YesNo?, Recs?, Recs?, Attempt?, YesNo).
question_prior2(yes, _, _, _, yes).
question_prior2(no, Rs, R, A, W?) :- question_prior1(Rs?, R?, A?, W).

procedure question_waits(Attempt?, St?, YesNo).
question_waits(A, St, W?) :- ground(St?) | st_app(St?, Ap), app_lock_recs(Ap?, L, R), question_prior(R?, A?, W1), unlocked(L?, U), neg(U?, W2), or(W1?, W2?, W).

procedure app_lock_recs(App?, Lock, Recs).
app_lock_recs(app(_, _, L, R), L?, R?).

procedure free_i(Info?, St?, YesNo).
free_i(I, St, B?) :- ground(St?) | st_app(St?, Ap), free_app(I?, Ap?, B).

procedure free_app(Info?, App?, YesNo).
free_app(I, app(_, _, L, R), B?) :- ground(R?) | unlocked(L?, B1), no_question(I?, R?, R?, B2), and(B1?, B2?, B).

procedure start_blocker(YesNo?, Info?, St?, Blocker).
start_blocker(no, _, _, noblk).
start_blocker(yes, I, St, Bk?) :- ground(St?) | st_app(St?, Ap), app_lock_recs(Ap?, L, R), start_blocker1(L?, I?, R?, Bk).

procedure start_blocker1(Lock?, Info?, Recs?, Blocker).
start_blocker1(held(B), _, _, blk(B?)).
start_blocker1(unlocked, I, R, Bk?) :- ground(R?) | class_question(R?, I?, R?, Bk).

procedure class_question(Recs?, Info?, Recs?, Blocker).
class_question([], _, _, noblk).
class_question([asked(G) | Rs], I, R, Bk?) :- ground(G?), ground(I?), ground(R?) | pending_rec(G?, R?, P), of_class(G?, I?, Cl), and(P?, Cl?, B), class_question1(B?, G?, Rs?, I?, R?, Bk).
class_question([_ | Rs], I, R, Bk?) :- otherwise | class_question(Rs?, I?, R?, Bk).

procedure class_question1(YesNo?, Attempt?, Recs?, Info?, Recs?, Blocker).
class_question1(yes, G, _, _, _, blk(G?)).
class_question1(no, _, Rs, I, R, Bk?) :- class_question(Rs?, I?, R?, Bk).

procedure question_blocker(YesNo?, St?, Blocker).
question_blocker(no, _, noblk).
question_blocker(yes, St, Bk?) :- ground(St?) | st_app(St?, Ap), app_lock_recs(Ap?, L, _), lock_blocker(L?, Bk).

procedure lock_blocker(Lock?, Blocker).
lock_blocker(held(B), blk(B?)).
lock_blocker(unlocked, noblk).

procedure prio(Attempt?, Attempt?, YesNo).
prio(A, B, P?) :- ground(A?), ground(B?) | attempt_rank(A?, RA), attempt_rank(B?, RB), attempt_id(A?, IA), attempt_id(B?, IB), prio1(RA?, RB?, IA?, IB?, P).

procedure prio1(Integer?, Integer?, Peer?, Peer?, YesNo).
prio1(RA, RB, _, _, yes) :- (RA? < RB?) | true.
prio1(RA, RB, _, _, no) :- (RA? > RB?) | true.
prio1(RA, RB, IA, IB, P?) :- (RA? =:= RB?) | precedes(IA?, IB?, P).

procedure cargo_class(Cargo?, Class).
cargo_class(start(attempt(_, _, _, C)), C?).
cargo_class(vote(attempt(_, _, _, C), _), C?).
cargo_class(yield(attempt(_, _, _, C)), C?).
cargo_class(outcome(attempt(_, _, _, C), _), C?).

procedure recheck_find(Pends?, St?, FoundNet).
recheck_find([], _, nonefound).
recheck_find([deferred(M) | Ps], St, F?) :- ground(M?), ground(St?) | held_takeable(M?, St?, T), recheck_find1(T?, M?, Ps?, St?, F).
recheck_find([_ | Ps], St, F?) :- otherwise | recheck_find(Ps?, St?, F).

procedure recheck_find1(YesNo?, Net?, Pends?, St?, FoundNet).
recheck_find1(yes, M, _, _, found(M?)).
recheck_find1(no, _, Ps, St, F?) :- recheck_find(Ps?, St?, F).

procedure held_takeable(Net?, St?, YesNo).
held_takeable(msg(_, cargo(_, start(A))), St, T?) :- ground(A?), ground(St?) | attempt_class(A?, C), st_class(C?, St?, Cr, _), held_takeable1(Cr?, A?, St?, T).
held_takeable(_, _, no) :- otherwise | true.

procedure held_takeable1(ClassRes?, Attempt?, St?, YesNo).
held_takeable1(nocls, _, _, no).
held_takeable1(cls(I), A, St, T?) :- ground(A?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), mem(closed(A?), R?, Cl), start_waits(I?, A?, St?, W), neg(W?, NW), or(Cl?, NW?, T).

procedure recheck1(FoundNet?, Then?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
recheck1(found(M), Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- step(net(M?), Th?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
recheck1(nonefound, Th, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(St?) | st_app(St?, Ap0), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure dispatch_message(MCond?, Net?, Peer?, Cargo?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_message(noparticipant, _, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
dispatch_message(mdefer, M, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- add_pend_once(deferred(M?), St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St1?, D).
dispatch_message(mgo(I), M, _, start(At), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?) | drop_pend(deferred(M?), St?, St0), start_effect(I?, At?, St0?, Ss, Cr, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), spawn(Cr?, Approvals?, Approvals1, Ans, Ans1?, D1), next(Th?, yes, Ap0?, Ls?, In?, Ans1, Thr, Out1, Ow, Approvals1?, St2?, D2), merge(D1?, D2?, D).
dispatch_message(mgo(I), _, F, vote(At, Y), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?), ground(F?), ground(Ap0?) | tally_effect(I?, At?, F?, Y?, St?, Ss, St1), noticed(refused_by(F?), At?, Ap0?, St1?, Thr, Thr1?, St1n), send_all(Ss?, St1n?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out1, Ow, Approvals?, St2?, D).
dispatch_message(mgo(I), _, _, yield(At), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?), ground(Ap0?) | yield_effect(I?, At?, St?, Ss, St1), noticed(yielded_by, At?, Ap0?, St1?, Thr, Thr1?, St1n), send_all(Ss?, St1n?, Ms, St2), put_all(Ms?, Out, Out1?), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr1, Out1, Ow, Approvals?, St2?, D).
dispatch_message(mgo(I), _, _, outcome(At, Z), Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?) | outcome_effect(I?, At?, Z?, St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St1?, D).

procedure spawn(ApprovalRes?, OpenApprovals?, OpenApprovals, Stream(Trigger), Stream(Trigger)?, Stream(Ask(Question))).
spawn(noapproval, Cs, Cs?, Ans?, Ans, []).
spawn(approval_for(At), Cs, [oc(At?, Cl) | Cs?], Ans?, Ans1, D?) :- ground(At?) | respond(At?, Cl?, R, D), merge(R?, Ans1?, Ans).

procedure answer_cond(Attempt?, St?, Cond, St).
answer_cond(At, St, Cd?, St2?) :- ground(At?), ground(St?) | attempt_class(At?, C), st_class(C?, St?, R, St1), answer_cond1(R?, At?, St1?, Cd, St2).

procedure answer_cond1(ClassRes?, Attempt?, St?, Cond, St).
answer_cond1(nocls, _, St, drop, St?).
answer_cond1(cls(I), At, St, Cd?, St?) :- ground(I?), ground(At?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), unanswered(At?, R?, Ok), go_or_drop(Ok?, I?, Cd).

procedure unanswered(Attempt?, Recs?, YesNo).
unanswered(At, R, B?) :- ground(At?), ground(R?) | pending_rec(At?, R?, P), has_answer(At?, R?, H), neg(H?, Un), and(P?, Un?, B).

procedure dispatch_answer(Cond?, YesNo?, Attempt?, Then?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_answer(go(_), YN, At, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?) | answer_effect(YN?, At?, St?, St1), next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St1?, D).
dispatch_answer(drop, _, _, Th, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(Th?, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure close_approval(Attempt?, OpenApprovals?, OpenApprovals).
close_approval(_, [], []).
close_approval(At, [oc(B, close) | Cs], Cs?) :- (At? =?= B?) | true.
close_approval(At, [oc(B, Cl?) | Cs], [oc(B?, Cl) | Cs1?]) :- otherwise | close_approval(At?, Cs?, Cs1).

procedure close_falsified(YesNo?, OpenApprovals?, St?, OpenApprovals).
close_falsified(no, Cs, _, Cs?).
close_falsified(yes, Cs, St, Cs1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), close_approvals(Cs?, R?, Cs1).

procedure close_approvals(OpenApprovals?, Recs?, OpenApprovals).
close_approvals([], _, []).
close_approvals([oc(At, Cl?) | Cs], R, Cs1?) :- ground(At?), ground(R?) | pending_rec(At?, R?, P), close_one(P?, At?, Cl, Cs?, R?, Cs1).

procedure close_one(YesNo?, Attempt?, Close, OpenApprovals?, Recs?, OpenApprovals).
close_one(no, _, close, Cs, R, Cs1?) :- close_approvals(Cs?, R?, Cs1).
close_one(yes, At, Cl?, Cs, R, [oc(At?, Cl) | Cs1?]) :- close_approvals(Cs?, R?, Cs1).

procedure take_own(Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
take_own(Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(St?) | st_app(St?, Ap0), own_cond(St?, Ch, St1), dispatch_own(Ch?, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St1?, D).

procedure own_cond(St?, Choice, St).
own_cond(St, Ch?, St2?) :- ground(St?) | opening(St?, Is, St1), own_cond1(Is?, St1?, Ch, St2).

procedure own_cond1(Infos?, St?, Choice, St).
own_cond1(Is, St, Ch?, St5?) :- ground(Is?), ground(St?) | op_cands(Is?, St?, Cs1), st_app(St?, Ap), app_recs(Ap?, R), vote_cands0(R?, St?, Cs2, St2), commit_cands_st(St2?, Cs3, St3), wound_cands0(St3?, Cs4, St4), intro_cands(St?, Cs5), app(Cs1?, Cs2?, C12), app(C12?, Cs3?, C123), app(C123?, Cs4?, C1234), app(C1234?, Cs5?, Cs), own_cond2(Cs?, St4?, Ch, St5).

procedure own_cond2(Cands?, St?, Choice, St).
own_cond2(Cs, St, Ch?, St2?) :- ground(St?) | st_waits(St?, W), st_app(St?, Ap), app_recs(Ap?, R), prune_waits(W?, R?, W0), st_count(St?, D), choose(Cs?, W0?, D?, Ch0, W1), set_waits(St?, W1?, St1), count_own(Ch0?, St1?, Ch, St2).

procedure count_own(Choice?, St?, Choice, St).
count_own(none, St, none, St?).
count_own(take(K, S), St, take(K?, S?), St1?) :- advance(St?, St1).

procedure op_cands(Infos?, St?, Cands).
op_cands([], _, []).
op_cands([I | Is], St, Cs?) :- ground(I?), ground(St?) | st_id(St?, Id), info_parts(I?, Pts), opening_parts(Pts?, Id?, Ps), part_cands(Ps?, I?, St?, Cs1), op_cands(Is?, St?, Cs2), app(Cs1?, Cs2?, Cs).

procedure part_cands(Classes?, Info?, St?, Cands).
part_cands([], _, _, []).
part_cands([P | Ps], I, St, Cs?) :- ground(I?), ground(St?) | initiate_cond([P?], I?, unnamed, St?, Cd), part_cands(Ps?, I?, St?, Cs1), keep_cand(Cd?, Cs1?, Cs).

procedure keep_cand(PCond?, Cands?, Cands).
keep_cand(pgo(I, P), Cs, [cand(op(P?), prop(I?, P?)) | Cs?]) :- ground(P?) | true.
keep_cand(pdrop, Cs, Cs?).

procedure vote_cands0(Recs?, St?, Cands, St).
vote_cands0(R, St, Cs?, St1?) :- ground(R?) | vote_cands(R?, R?, St?, [], Cs, St1).

procedure vote_cands(Recs?, Recs?, St?, Cands?, Cands, St).
vote_cands([], _, St, Cs, Cs?, St?).
vote_cands([answered(At, Y) | Rs], R, St, Acc, Cs?, St2?) :- ground(At?), ground(Y?), ground(R?), ground(St?) | pending_rec(At?, R?, P), attempt_id(At?, Q), known_st(Q?, St?, Kn), and(P?, Kn?, B1), question_waits(At?, St?, Wt), vote_free(Y?, Wt?, Fr), and(B1?, Fr?, B), attempt_class(At?, C), st_class(C?, St?, Cr, St1), vote_cand(B?, Cr?, vt(At?), Acc?, Acc1), vote_cands(Rs?, R?, St1?, Acc1?, Cs, St2).
vote_cands([_ | Rs], R, St, Acc, Cs?, St1?) :- otherwise | vote_cands(Rs?, R?, St?, Acc?, Cs, St1).

procedure vote_free(YesNo?, YesNo?, YesNo).
vote_free(no, _, yes).
vote_free(yes, W, F?) :- neg(W?, F).

procedure vote_cand(YesNo?, ClassRes?, WKey?, Cands?, Cands).
vote_cand(yes, cls(I), K, Acc, [cand(K?, sub(I?)) | Acc?]).
vote_cand(yes, nocls, _, Acc, Acc?).
vote_cand(no, _, _, Acc, Acc?).

procedure commit_cands_st(St?, Cands, St).
commit_cands_st(St, Cs?, St1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), commit_cands0(R?, St?, Cs, St1).

procedure commit_cands0(Recs?, St?, Cands, St).
commit_cands0(R, St, Cs?, St1?) :- ground(R?) | commit_cands(R?, R?, St?, [], Cs, St1).

procedure commit_cands(Recs?, Recs?, St?, Cands?, Cands, St).
commit_cands([], _, St, Cs, Cs?, St?).
commit_cands([voted(At, yes) | Rs], R, St, Acc, Cs?, St2?) :- ground(At?), ground(R?), ground(St?) | st_id(St?, Id), attempt_id(At?, P), same(P?, Id?, Own), attempt_class(At?, C), st_class(C?, St?, Cr, St1), commit_cand(Own?, Cr?, At?, Id?, R?, Acc?, Acc1), commit_cands(Rs?, R?, St1?, Acc1?, Cs, St2).
commit_cands([_ | Rs], R, St, Acc, Cs?, St1?) :- otherwise | commit_cands(Rs?, R?, St?, Acc?, Cs, St1).

procedure commit_cand(YesNo?, ClassRes?, Attempt?, Peer?, Recs?, Cands?, Cands).
commit_cand(yes, cls(I), At, Id, R, Acc, Cs?) :- ground(I?), ground(At?), ground(R?) | mem(closed(At?), R?, Cl), neg(Cl?, Open), all_yes(I?, At?, Id?, R?, All), and(Open?, All?, B), vote_cand(B?, cls(I?), cm(At?), Acc?, Cs).
commit_cand(_, _, _, _, _, Acc, Acc?) :- otherwise | true.

procedure wound_cands0(St?, Cands, St).
wound_cands0(St, Cs?, St3?) :- ground(St?) | st_pends(St?, Pd), wound_starts(Pd?, St?, [], Cs1, St1), wound_cands1(Cs1?, St1?, Cs, St3).

procedure wound_cands1(Cands?, St?, Cands, St).
wound_cands1(Acc, St, Cs?, St1?) :- ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), wound_questions0(R?, St?, Acc?, Cs, St1).

procedure wound_starts(Pends?, St?, Cands?, Cands, St).
wound_starts([], St, Acc, Acc?, St?).
wound_starts([deferred(msg(_, cargo(_, start(A)))) | Ps], St, Acc, Cs?, St3?) :- ground(A?), ground(St?) | attempt_class(A?, C), st_class(C?, St?, Cr, St1), wound_start(Cr?, A?, St1?, Acc?, Acc1, St2), wound_starts(Ps?, St2?, Acc1?, Cs, St3).
wound_starts([_ | Ps], St, Acc, Cs?, St1?) :- otherwise | wound_starts(Ps?, St?, Acc?, Cs, St1).

procedure wound_start(ClassRes?, Attempt?, St?, Cands?, Cands, St).
wound_start(nocls, _, St, Acc, Acc?, St?).
wound_start(cls(I), A, St, Acc, Cs?, St?) :- ground(I?), ground(A?), ground(St?) | st_app(St?, Ap), app_recs(Ap?, R), mem(closed(A?), R?, Cl), start_waits(I?, A?, St?, W), neg(Cl?, Open), and(Open?, W?, B), start_blocker(B?, I?, St?, Bk), wound_by(Bk?, A?, St?, Acc?, Cs).

procedure wound_questions0(Recs?, St?, Cands?, Cands, St).
wound_questions0(R, St, Acc, Cs?, St1?) :- ground(R?) | wound_questions(R?, R?, St?, Acc?, Cs, St1).

procedure wound_questions(Recs?, Recs?, St?, Cands?, Cands, St).
wound_questions([], _, St, Acc, Acc?, St?).
wound_questions([answered(A, yes) | Rs], R, St, Acc, Cs?, St1?) :- ground(A?), ground(R?), ground(St?) | pending_rec(A?, R?, P), question_blocker(P?, St?, Bk), wound_by(Bk?, A?, St?, Acc?, Acc1), wound_questions(Rs?, R?, St?, Acc1?, Cs, St1).
wound_questions([_ | Rs], R, St, Acc, Cs?, St1?) :- otherwise | wound_questions(Rs?, R?, St?, Acc?, Cs, St1).

procedure wound_by(Blocker?, Attempt?, St?, Cands?, Cands).
wound_by(noblk, _, _, Acc, Acc?).
wound_by(blk(B), A, St, Acc, Cs?) :- ground(B?), ground(A?), ground(St?) | attempt_class(B?, C), st_class(C?, St?, Cr, _), wound_by_c(Cr?, A?, B?, St?, Acc?, Cs).

procedure wound_by_c(ClassRes?, Attempt?, Attempt?, St?, Cands?, Cands).
wound_by_c(nocls, _, _, _, Acc, Acc?).
wound_by_c(cls(I), A, B, St, Acc, Cs?) :- ground(I?), ground(A?), ground(B?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_recs(Ap?, R), wound_rec(I?, A?, B?, Id?, R?, Ok), vote_cand(Ok?, cls(I?), wd(A?, B?), Acc?, Cs).

procedure wound_rec(Info?, Attempt?, Attempt?, Peer?, Recs?, YesNo).
wound_rec(I, A, B, Id, R, Ok?) :- ground(I?), ground(B?), ground(Id?), ground(R?) | prio(A?, B?, Pr), mem(yielded(B?), R?, Yd), neg(Yd?, NYd), attempt_id(B?, P), same(P?, Id?, Own), all_yes(I?, B?, Id?, R?, All), wound_by2(Own?, All?, Ok1), and(Pr?, NYd?, B1), and(B1?, Ok1?, Ok).

procedure wound_by2(YesNo?, YesNo?, YesNo).
wound_by2(no, _, yes).
wound_by2(yes, All, Ok?) :- neg(All?, Ok).

procedure intro_cands(St?, Cands).
intro_cands(St, Cs?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_state(Ap?, S), introduction_preds(E), named_by(E?, S?, Id?, Ns0), dedup(Ns0?, Ns1), sort_peers(Ns1?, Ns), pairs_of(Ns?, Ps), intro_keep(Ps?, St?, Cs).

procedure named_by(Preds?, GAtoms?, Peer?, Peers).
named_by(_, [], _, []).
named_by(E, [g(P, [p(Q)]) | Gs], Id, Ns?) :- ground(E?), ground(Q?), ground(Id?) | mem(P?, E?, In), same(Q?, Id?, Me), neg(Me?, NMe), and(In?, NMe?, B), named_by(E?, Gs?, Id?, N1), keep_peer(B?, Q?, N1?, Ns).
named_by(E, [_ | Gs], Id, Ns?) :- otherwise | named_by(E?, Gs?, Id?, Ns).

procedure pairs_of(Peers?, Pairs).
pairs_of([], []).
pairs_of([Q | Qs], Ps?) :- ground(Q?), ground(Qs?) | pairs_with(Q?, Qs?, P1), pairs_of(Qs?, P2), app(P1?, P2?, Ps).

procedure pairs_with(Peer?, Peers?, Pairs).
pairs_with(_, [], []).
pairs_with(Q, [R | Rs], [pr(Q?, R?) | Ps?]) :- ground(Q?) | pairs_with(Q?, Rs?, Ps).

procedure intro_keep(Pairs?, St?, Cands).
intro_keep([], _, []).
intro_keep([pr(Q, R) | Ps], St, Cs?) :- ground(Q?), ground(R?), ground(St?) | known_st(Q?, St?, K1), known_st(R?, St?, K2), st_app(St?, Ap), app_recs(Ap?, Rc), mem(introduced(Q?, R?), Rc?, Done), neg(Done?, ND), and(K1?, K2?, K12), and(K12?, ND?, B), intro_keep(Ps?, St?, C1), keep_icand(B?, Q?, R?, C1?, Cs).

procedure keep_icand(YesNo?, Peer?, Peer?, Cands?, Cands).
keep_icand(yes, Q, R, Cs, [cand(ip(Q?, R?), pair) | Cs?]).
keep_icand(no, _, _, Cs, Cs?).

procedure prune_waits(Waits?, Recs?, Waits).
prune_waits([], _, []).
prune_waits([w(K, T) | Ws], R, Ws1?) :- ground(K?), ground(R?) | dead_key(K?, R?, Dd), prune_waits(Ws?, R?, Rest), prune_wait(Dd?, w(K?, T?), Rest?, Ws1).

procedure prune_wait(YesNo?, Wait?, Waits?, Waits).
prune_wait(no, X, Ws, [X? | Ws?]).
prune_wait(yes, _, Ws, Ws?).

procedure dead_key(WKey?, Recs?, YesNo).
dead_key(op(_), _, no).
dead_key(vt(A), R, D?) :- ground(A?), ground(R?) | has_vote(A?, R?, V), mem(closed(A?), R?, Cl), or(V?, Cl?, D).
dead_key(cm(A), R, D?) :- mem(closed(A?), R?, D).
dead_key(wd(_, B), R, D?) :- ground(B?), ground(R?) | mem(closed(B?), R?, Cl), mem(yielded(B?), R?, Yd), or(Cl?, Yd?, D).
dead_key(ip(Q, R1), R, D?) :- mem(introduced(Q?, R1?), R?, D).

procedure dispatch_own(Choice?, App?, Stream(Trigger)?, Stream(Trigger)?, Stream(Trigger), Stream(Output), Stream(Net), Stream(Trigger), OpenApprovals?, St?, Stream(Ask(Question))).
dispatch_own(none, Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- next(no_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
dispatch_own(take(op(_), prop(I, P)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- dispatch_propose(pgo(I?, P?), write_own, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).
dispatch_own(take(vt(At), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?), ground(I?) | vote_effect(I?, At?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, St2?, D).
dispatch_own(take(cm(At), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(At?), ground(I?) | commit_effect(I?, At?, St?, Ss, St1), send_all(Ss?, St1?, Ms, St2), put_all(Ms?, Out, Out1?), next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out1, Ow, Approvals?, St2?, D).
dispatch_own(take(wd(_, B), sub(I)), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- ground(B?), ground(I?), ground(Ap0?) | wound_effect(I?, B?, St?, Ss, St1), noticed(yielded_by, B?, Ap0?, St1?, Thr, Thr1?, St1n), send_all(Ss?, St1n?, Ms, St2), put_all(Ms?, Out, Out1?), next(write_own, no, Ap0?, Ls?, In?, Ans, Thr1, Out1, Ow, Approvals?, St2?, D).
dispatch_own(take(ip(Q, R), pair), Ap0, Ls, In, Ans?, Thr?, [msg(Q?, intro(Id?, R?)), msg(R?, intro(Id?, Q?)) | Out?], Ow?, Approvals, St, D?) :- ground(Q?), ground(R?), ground(St?) | st_id(St?, Id), introduce_effect(Q?, R?, St?, St1), next(write_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St1?, D).
dispatch_own(take(_, _), Ap0, Ls, In, Ans?, Thr?, Out?, Ow?, Approvals, St, D?) :- otherwise | next(no_own, no, Ap0?, Ls?, In?, Ans, Thr, Out, Ow, Approvals?, St?, D).

procedure opening(St?, Infos, St).
opening(St, Is?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), app_state(Ap?, S), contract_schemas(Ss), reflexive_preds(Rf), opening1(Ss?, Rf?, Id?, S?, St?, Is, St1).

procedure opening1(Schemas?, Preds?, Peer?, GAtoms?, St?, Infos, St).
opening1(Ss, Rf, Id, S, St, Is?, St1?) :- ground(Id?), ground(S?) | hat(Rf?, Id?, S?, Sh), opened(Ss?, Id?, Sh?, Cs), meet_all(Cs?, St?, [], Is0, St1), dedup(Is0?, Is).

procedure opened(Schemas?, Peer?, GAtoms?, Stream(Class)).
opened([], _, _, []).
opened([schema(Nm, _, Rs) | Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | guard_roles(Rs?, 1, Gs), opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1), opened(Ss?, Id?, Sh?, C2), app(C1?, C2?, Cs).
opened([lschema(Nm, _, Rs, _) | Ss], Id, Sh, Cs?) :- ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | guard_roles(Rs?, 1, Gs), opened1(Gs?, Nm?, Rs?, Id?, Sh?, C1), opened(Ss?, Id?, Sh?, C2), app(C1?, C2?, Cs).

procedure opened1(Ints?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened1([_ | _], _, _, _, _, []).
opened1([], _, [], _, _, []).
opened1([], Nm, [R | Rs], Id, Sh, Cs?) :- ground(R?), ground(Id?), ground(Sh?) | rs_req(R?, Q), match_all(Q?, Sh?, [b(role(1), p(Id?))], Bs), opened2(Bs?, Nm?, [R? | Rs?], Id?, Sh?, Cs).

procedure opened2(Bindings?, Constant?, RoleSpecs?, Peer?, GAtoms?, Stream(Class)).
opened2([], _, _, _, _, []).
opened2([B | Bs], Nm, Rs, Id, Sh, Cs?) :- ground(B?), ground(Nm?), ground(Rs?), ground(Id?), ground(Sh?) | first_spec(Rs?, R1), cand_ok([R1?], B?, Sh?, Ok), opened3(Ok?, Nm?, B?, Id?, Sh?, C1), opened2(Bs?, Nm?, Rs?, Id?, Sh?, C2), app(C1?, C2?, Cs).

procedure opened3(YesNo?, Constant?, Binding?, Peer?, GAtoms?, Stream(Class)).
opened3(no, _, _, _, _, []).
opened3(yes, Nm, B, Id, Sh, [C?]) :- ground(Nm?), ground(B?) | listed_people(Nm?, B?, Sh?, Ls), listed_binding(Nm?, B?, Ls?, B1), class_of(Nm?, B1?, Id?, C).

procedure first_spec(RoleSpecs?, RoleSpec).
first_spec([R | _], R?).
first_spec([], rs(unguarded, [], [], [], [])).

procedure meet_all(Stream(Class)?, St?, Infos?, Infos, St).
meet_all([], St, Is, Is?, St?).
meet_all([C | Cs], St, Is, Is2?, St2?) :- ground(C?), ground(St?) | st_class(C?, St?, R, St1), add_cls(R?, Is?, Is1), meet_all(Cs?, St1?, Is1?, Is2, St2).

procedure add_cls(ClassRes?, Infos?, Infos).
add_cls(nocls, Is, Is?).
add_cls(cls(I), Is, Is1?) :- app(Is?, [I?], Is1).

procedure choose(Cands?, Waits?, Integer?, Choice, Waits).
choose(Cs, W, D, Ch?, W2?) :- ground(Cs?), ground(W?), integer(D?) | ensure_waits(Cs?, W?, D?, W1), choose1(Cs?, W1?, D?, Ch, W2).

procedure choose1(Cands?, Waits?, Integer?, Choice, Waits).
choose1(Cs, W1, D, Ch?, W2?) :- ground(W1?), integer(D?) | pick(Cs?, W1?, Ch, Ky), D1 := (D? + 1), retake(Ky?, W1?, D1?, W2).

procedure ensure_waits(Cands?, Waits?, Integer?, Waits).
ensure_waits([], W, _, W?).
ensure_waits([cand(K, _) | Cs], W, D, W2?) :- ground(K?), ground(W?), integer(D?) | wait_of(K?, W?, F), ensure1(F?, K?, W?, D?, W1), ensure_waits(Cs?, W1?, D?, W2).

procedure ensure1(WFound?, WKey?, Waits?, Integer?, Waits).
ensure1(at(_), _, W, _, W?).
ensure1(unseen, K, W, D, [w(K?, D?) | W?]).

procedure wait_of(WKey?, Waits?, WFound).
wait_of(_, [], unseen).
wait_of(K, [w(K1, T) | _], at(T?)) :- (K? =?= K1?) | true.
wait_of(K, [_ | Ws], F?) :- otherwise | wait_of(K?, Ws?, F).

procedure pick(Cands?, Waits?, Choice, PKey).
pick([], _, none, nokey).
pick([cand(K, I) | Cs], W, Ch?, Ky?) :- ground(K?), ground(W?) | began_at(K?, W?, T), best(Cs?, W?, T?, K?, I?, Ch, Ky).

procedure best(Cands?, Waits?, Integer?, WKey?, Subj?, Choice, PKey).
best([], _, _, K, I, take(K?, I?), key(K?)) :- ground(K?) | true.
best([cand(K2, I2) | Cs], W, T, K, I, Ch?, Ky?) :- ground(K2?), ground(W?) | began_at(K2?, W?, T2), best1(T2?, T?, K2?, I2?, K?, I?, Cs?, W?, Ch, Ky).

procedure best1(Integer?, Integer?, WKey?, Subj?, WKey?, Subj?, Cands?, Waits?, Choice, PKey).
best1(T2, T, K2, I2, _, _, Cs, W, Ch?, Ky?) :- (T2? < T?) | best(Cs?, W?, T2?, K2?, I2?, Ch, Ky).
best1(T2, T, _, _, K, I, Cs, W, Ch?, Ky?) :- (T2? >= T?) | best(Cs?, W?, T?, K?, I?, Ch, Ky).

procedure began_at(WKey?, Waits?, Integer).
began_at(K, W, T?) :- wait_of(K?, W?, F), began_of(F?, T).

procedure began_of(WFound?, Integer).
began_of(at(T), T?).
began_of(unseen, 0).

procedure retake(PKey?, Waits?, Integer?, Waits).
retake(nokey, W, _, W?).
retake(key(K), W, D, W1?) :- set_wait(K?, D?, W?, W1).

procedure set_wait(WKey?, Integer?, Waits?, Waits).
set_wait(K, D, [], [w(K?, D?)]).
set_wait(K, D, [w(K1, _) | Ws], [w(K1?, D?) | Ws?]) :- (K? =?= K1?) | true.
set_wait(K, D, [X | Ws], [X? | Ws1?]) :- otherwise | set_wait(K?, D?, Ws?, Ws1).

procedure propose_effect(Info?, Class?, St?, Sends, St).
propose_effect(I, P, St, Ss?, St2?) :- ground(I?), ground(P?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), st_app(St?, Ap0), app_count(Ap0?, K), K1 := (K? + 1), st_app(St?, Ap2), app_recs(Ap2?, R), rank_of(I?, P?, Id?, R?, K1?, Pi), propose_app(I?, attempt(Id?, K1?, Pi?, P?), Ap?, Ss, Ap1), set_app(St?, Ap1?, St1), note_part(I?, P?, St1?, St2).

procedure rank_of(Info?, Class?, Peer?, Recs?, Integer?, Integer).
rank_of(I, P, Id, R, K1, Pi?) :- ground(R?), integer(K1?) | last_own(R?, I?, P?, Id?, nolast, L), rank_of1(L?, R?, K1?, Pi).

procedure rank_of1(Last?, Recs?, Integer?, Integer).
rank_of1(nolast, _, K1, K1?).
rank_of1(last(A), R, K1, Pi?) :- ground(A?), ground(R?) | mem(wounded(A?), R?, W), attempt_rank(A?, P), rank_of2(W?, P?, K1?, Pi).

procedure rank_of2(YesNo?, Integer?, Integer?, Integer).
rank_of2(yes, P, _, P?).
rank_of2(no, _, K1, K1?).

procedure last_own(Recs?, Info?, Class?, Peer?, Last?, Last).
last_own([], _, _, _, L, L?).
last_own([voted(A, yes) | Rs], I, P, Id, L, L1?) :- ground(A?), ground(I?), ground(P?), ground(Id?) | attempt_id(A?, Q), same(Q?, Id?, Own), attempt_class(A?, C), term_part(C?, I?, P?, Pt), and(Own?, Pt?, B), later(B?, A?, L?, L0), last_own(Rs?, I?, P?, Id?, L0?, L1).
last_own([_ | Rs], I, P, Id, L, L1?) :- otherwise | last_own(Rs?, I?, P?, Id?, L?, L1).

procedure later(YesNo?, Attempt?, Last?, Last).
later(no, _, L, L?).
later(yes, A, nolast, last(A?)).
later(yes, A, last(B), L?) :- ground(A?), ground(B?) | attempt_k(A?, KA), attempt_k(B?, KB), later1(KA?, KB?, A?, B?, L).

procedure later1(Integer?, Integer?, Attempt?, Attempt?, Last).
later1(KA, KB, A, _, last(A?)) :- (KA? > KB?) | true.
later1(KA, KB, _, B, last(B?)) :- (KA? =< KB?) | true.

procedure note_part(Info?, Class?, St?, St).
note_part(I, P, St, St1?) :- ground(I?), ground(P?), ground(St?) | st_props(St?, Pr), drop_part(Pr?, I?, P?, Pr1), app(Pr1?, [P?], Pr2), set_props(St?, Pr2?, St1).

procedure drop_part(Classes?, Info?, Class?, Classes).
drop_part([], _, _, []).
drop_part([E | Es], I, P, R?) :- ground(E?), ground(I?), ground(P?) | term_part(E?, I?, P?, Sm), drop_part1(Sm?, E?, Es?, I?, P?, R).

procedure drop_part1(YesNo?, Class?, Classes?, Info?, Class?, Classes).
drop_part1(yes, _, Es, I, P, R?) :- drop_part(Es?, I?, P?, R).
drop_part1(no, E, Es, I, P, [E? | R?]) :- drop_part(Es?, I?, P?, R).

procedure propose_app(Info?, Attempt?, App?, Sends, App).
propose_app(I, At, Ap, Ss?, Ap1?) :- ground(I?), ground(At?) | attempt_id(At?, Id), info_q(I?, Q), only_me(Q?, Id?, One), propose_app1(One?, I?, At?, Ap?, Ss, Ap1).

procedure propose_app1(YesNo?, Info?, Attempt?, App?, Sends, App).
propose_app1(yes, I, At, app(S, _, L, R), [], app(S1?, K?, L?, [closed(At?), voted(At?, yes) | R?])) :- ground(At?) | attempt_id(At?, Id), attempt_k(At?, K), apply_info(I?, Id?, S?, S1).
propose_app1(no, I, At, app(S, _, _, R), Ss?, app(S?, K?, held(At?), [voted(At?, yes) | R?])) :- ground(At?), ground(I?) | attempt_id(At?, Id), attempt_k(At?, K), info_q(I?, Q), tell(Q?, Id?, start(At?), Ss).

procedure only_me(Peers?, Peer?, YesNo).
only_me([P], Id, yes) :- (P? =?= Id?) | true.
only_me(_, _, no) :- otherwise | true.

procedure tell(Peers?, Peer?, Cargo?, Sends).
tell([], _, _, []).
tell([Q | Qs], Id, X, Ss?) :- ground(Q?), ground(Id?), ground(X?) | same(Q?, Id?, Me), tell1(Me?, Q?, X?, Ss1?, Ss), tell(Qs?, Id?, X?, Ss1).

procedure tell1(YesNo?, Peer?, Cargo?, Sends?, Sends).
tell1(yes, _, _, Ss, Ss?).
tell1(no, Q, X, Ss, [to(Q?, X?) | Ss?]).

procedure vote_app(Attempt?, YesNo?, App?, Sends, App).
vote_app(At, yes, app(S, K, _, R), [to(I?, vote(At?, yes))], app(S?, K?, held(At?), [voted(At?, yes) | R?])) :- ground(At?) | attempt_id(At?, I).
vote_app(At, no, app(S, K, L, R), [to(I?, vote(At?, no))], app(S?, K?, L?, [voted(At?, no) | R?])) :- ground(At?) | attempt_id(At?, I).

procedure start_effect(Info?, Attempt?, St?, Sends, ApprovalRes, St).
start_effect(I, At, St, Ss?, Cr?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), start_app(I?, At?, Id?, Ap?, Ss, Cr, Ap1), set_app(St?, Ap1?, St1).

procedure start_app(Info?, Attempt?, Peer?, App?, Sends, ApprovalRes, App).
start_app(I, At, Id, app(S, K, L, R), Ss?, Cr?, Ap1?) :- ground(At?), ground(R?), integer(K?) | attempt_k(At?, KA), max_int(K?, KA?, K1), mem(closed(At?), R?, Cl), start_app1(Cl?, I?, At?, Id?, app(S?, K1?, L?, R?), Ss, Cr, Ap1).

procedure max_int(Integer?, Integer?, Integer).
max_int(A, B, A?) :- (A? >= B?) | true.
max_int(A, B, B?) :- (A? < B?) | true.

procedure start_app1(YesNo?, Info?, Attempt?, Peer?, App?, Sends, ApprovalRes, App).
start_app1(yes, _, _, _, Ap, [], noapproval, Ap?).
start_app1(no, _, At, Id, Ap, Ss?, Cr?, Ap1?) :- ground(At?), ground(Id?), ground(Ap?) | app_state(Ap?, S), attempt_class(At?, C), part_dom(C?, Id?, S?, Rd), asked_by(At?, Id?, Ak), start_app2(Rd?, Ak?, At?, Ap?, Ss, Cr, Ap1).

procedure start_app2(YesNo?, YesNo?, Attempt?, App?, Sends, ApprovalRes, App).
start_app2(no, _, At, Ap, Ss?, noapproval, Ap1?) :- vote_app(At?, no, Ap?, Ss, Ap1).
start_app2(yes, yes, At, app(S, K, L, R), [], approval_for(At?), app(S?, K?, L?, [asked(At?) | R?])) :- ground(At?) | true.
start_app2(yes, no, At, Ap, Ss?, noapproval, Ap1?) :- vote_app(At?, yes, Ap?, Ss, Ap1).

procedure asked_by(Attempt?, Peer?, YesNo).
asked_by(At, Id, B?) :- ground(At?), ground(Id?) | attempt_id(At?, P), attempt_class(At?, C), binding_of(C?, Nm, Bn), marked_people(Nm?, Bn?, G), mem(Id?, G?, In), same(Id?, P?, Me), neg(Me?, NotMe), and(In?, NotMe?, B).

procedure answer_effect(YesNo?, Attempt?, St?, St).
answer_effect(YN, At, St, St1?) :- ground(St?) | st_app(St?, Ap), answer_app(YN?, At?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure answer_app(YesNo?, Attempt?, App?, App).
answer_app(YN, At, app(S, K, L, R), app(S?, K?, L?, [answered(At?, YN?) | R?])).

procedure vote_effect(Info?, Attempt?, St?, Sends, St).
vote_effect(I, At, St, Ss?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), vote_app0(I?, At?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure vote_app0(Info?, Attempt?, Peer?, App?, Sends, App).
vote_app0(_, At, Id, Ap, Ss?, Ap1?) :- ground(At?), ground(Ap?) | app_recs(Ap?, R), answer_of(At?, R?, YN), vote_yes(YN?, At?, Id?, Ap?, Y), vote_app(At?, Y?, Ap?, Ss, Ap1).

procedure vote_yes(YesNo?, Attempt?, Peer?, App?, YesNo).
vote_yes(no, _, _, _, no).
vote_yes(yes, At, Id, app(S, _, _, _), Y?) :- attempt_class(At?, C), part_dom(C?, Id?, S?, Y).

procedure tally_effect(Info?, Attempt?, Peer?, YesNo?, St?, Sends, St).
tally_effect(I, At, F, Y, St, Ss?, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), tally_app(I?, At?, F?, Y?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure tally_app(Info?, Attempt?, Peer?, YesNo?, Peer?, App?, Sends, App).
tally_app(I, At, F, Y, Id, Ap, Ss?, Ap1?) :- ground(At?), ground(Ap?) | app_recs(Ap?, R), mem(closed(At?), R?, Cl), tally_app1(Cl?, I?, At?, F?, Y?, Id?, Ap?, Ss, Ap1).

procedure tally_app1(YesNo?, Info?, Attempt?, Peer?, YesNo?, Peer?, App?, Sends, App).
tally_app1(yes, _, _, _, _, _, Ap, [], Ap?).
tally_app1(no, I, At, F, no, Id, app(S, K, _, R), Ss?, app(S?, K?, unlocked, [closed(At?), got(At?, F?, no) | R?])) :- ground(At?), ground(I?) | info_q(I?, Q), tell(Q?, Id?, outcome(At?, abort), Ss).
tally_app1(no, _, At, F, yes, _, app(S, K, L, R), [], app(S?, K?, L?, [got(At?, F?, yes) | R?])).

procedure commit_effect(Info?, Attempt?, St?, Sends, St).
commit_effect(I, At, St, Ss?, St1?) :- ground(I?), ground(At?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), commit_app(I?, At?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure commit_app(Info?, Attempt?, Peer?, App?, Sends, App).
commit_app(I, At, Id, app(S, K, _, R), Ss?, app(S1?, K?, unlocked, [closed(At?) | R?])) :- ground(I?), ground(At?), ground(Id?) | apply_info(I?, Id?, S?, S1), info_q(I?, Q), tell(Q?, Id?, outcome(At?, commit), Ss).

procedure yield_effect(Info?, Attempt?, St?, Sends, St).
yield_effect(I, At, St, Ss?, St1?) :- ground(I?), ground(At?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), yield_app(I?, At?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure yield_app(Info?, Attempt?, Peer?, App?, Sends, App).
yield_app(I, At, Id, Ap, Ss?, Ap1?) :- ground(I?), ground(At?), ground(Id?), ground(Ap?) | app_recs(Ap?, R), closed_or_all(I?, At?, Id?, R?, Done), yield_app1(Done?, I?, At?, Id?, Ap?, Ss, Ap1).

procedure closed_or_all(Info?, Attempt?, Peer?, Recs?, YesNo).
closed_or_all(I, At, Id, R, Done?) :- ground(At?), ground(R?) | mem(closed(At?), R?, Cl), all_yes(I?, At?, Id?, R?, All), or(Cl?, All?, Done).

procedure yield_app1(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
yield_app1(yes, _, _, _, Ap, [], Ap?).
yield_app1(no, I, At, Id, Ap, Ss?, Ap1?) :- abort_own(I?, At?, Id?, Ap?, Ss, Ap1).

procedure abort_own(Info?, Attempt?, Peer?, App?, Sends, App).
abort_own(I, At, Id, app(S, K, _, R), Ss?, app(S?, K?, unlocked, [wounded(At?), closed(At?) | R?])) :- ground(I?), ground(At?), ground(Id?) | info_q(I?, Q), tell(Q?, Id?, outcome(At?, abort), Ss).

procedure wound_effect(Info?, Attempt?, St?, Sends, St).
wound_effect(I, B, St, Ss?, St1?) :- ground(I?), ground(B?), ground(St?) | st_id(St?, Id), st_app(St?, Ap), attempt_id(B?, P), same(P?, Id?, Own), wound_app(Own?, I?, B?, Id?, Ap?, Ss, Ap1), set_app(St?, Ap1?, St1).

procedure wound_app(YesNo?, Info?, Attempt?, Peer?, App?, Sends, App).
wound_app(yes, I, B, Id, Ap, Ss?, Ap1?) :- abort_own(I?, B?, Id?, Ap?, Ss, Ap1).
wound_app(no, _, B, _, app(S, K, L, R), [to(J?, yield(B?))], app(S?, K?, L?, [yielded(B?) | R?])) :- ground(B?) | attempt_id(B?, J).

procedure introduce_effect(Peer?, Peer?, St?, St).
introduce_effect(Q, R, St, St1?) :- ground(St?) | st_app(St?, Ap), introduce_app(Q?, R?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure introduce_app(Peer?, Peer?, App?, App).
introduce_app(Q, R, app(S, K, L, Rc), app(S?, K?, L?, [introduced(Q?, R?) | Rc?])).

procedure all_yes(Info?, Attempt?, Peer?, Recs?, YesNo).
all_yes(I, At, Id, R, B?) :- ground(At?), ground(Id?), ground(R?) | info_q(I?, Q), all_yes1(Q?, At?, Id?, R?, B).

procedure all_yes1(Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes1([], _, _, _, yes).
all_yes1([P | Ps], At, Id, R, B?) :- ground(P?), ground(At?), ground(Id?), ground(R?) | same(P?, Id?, Me), mem(got(At?, P?, yes), R?, G), or(Me?, G?, Ok), all_yes2(Ok?, Ps?, At?, Id?, R?, B).

procedure all_yes2(YesNo?, Peers?, Attempt?, Peer?, Recs?, YesNo).
all_yes2(no, _, _, _, _, no).
all_yes2(yes, Ps, At, Id, R, B?) :- all_yes1(Ps?, At?, Id?, R?, B).

procedure outcome_effect(Info?, Attempt?, Decision?, St?, St).
outcome_effect(I, At, Z, St, St1?) :- ground(St?) | st_id(St?, Id), st_app(St?, Ap), outcome_app(I?, At?, Z?, Id?, Ap?, Ap1), set_app(St?, Ap1?, St1).

procedure outcome_app(Info?, Attempt?, Decision?, Peer?, App?, App).
outcome_app(I, At, commit, Id, app(S, K, L, R), app(S1?, K?, L1?, [closed(At?) | R?])) :- ground(At?) | apply_info(I?, Id?, S?, S1), release(L?, At?, L1).
outcome_app(_, At, abort, _, app(S, K, L, R), app(S?, K?, L1?, [closed(At?) | R?])) :- ground(At?) | release(L?, At?, L1).

procedure release(Lock?, Attempt?, Lock).
release(unlocked, _, unlocked).
release(held(A), At, unlocked) :- (A? =?= At?) | true.
release(held(A), _, held(A?)) :- otherwise | true.

procedure send_all(Sends?, St?, Nets, St).
send_all(Ss, St, Ms?, St?) :- ground(St?) | st_id(St?, Id), cargo_msgs(Ss?, Id?, Ms).

procedure cargo_msgs(Sends?, Peer?, Nets).
cargo_msgs([], _, []).
cargo_msgs([to(T, X) | Ss], Id, [msg(T?, cargo(Id?, X?)) | Ms?]) :- ground(Id?) | cargo_msgs(Ss?, Id?, Ms).

procedure put_all(Nets?, Stream(Net), Stream(Net)?).
put_all([], Out?, Out).
put_all([M | Ms], [M? | Out?], Cont) :- put_all(Ms?, Out, Cont?).

procedure unlocked(Lock?, YesNo).
unlocked(unlocked, yes).
unlocked(held(_), no).

procedure no_question(Info?, Recs?, Recs?, YesNo).
no_question(_, [], _, yes).
no_question(I, [asked(At) | Rs], R, B?) :- ground(I?), ground(At?), ground(R?) | pending_rec(At?, R?, P), of_class(At?, I?, Cl), and(P?, Cl?, Q), no_question1(Q?, I?, Rs?, R?, B).
no_question(I, [_ | Rs], R, B?) :- otherwise | no_question(I?, Rs?, R?, B).

procedure no_question1(YesNo?, Info?, Recs?, Recs?, YesNo).
no_question1(yes, _, _, _, no).
no_question1(no, I, Rs, R, B?) :- no_question(I?, Rs?, R?, B).

procedure pending_rec(Attempt?, Recs?, YesNo).
pending_rec(At, R, B?) :- ground(At?), ground(R?) | mem(asked(At?), R?, B1), has_vote(At?, R?, B2), mem(closed(At?), R?, B3), or(B2?, B3?, B23), neg(B23?, B4), and(B1?, B4?, B).

procedure has_vote(Attempt?, Recs?, YesNo).
has_vote(_, [], no).
has_vote(At, [voted(A, _) | _], yes) :- (At? =?= A?) | true.
has_vote(At, [_ | Rs], B?) :- otherwise | has_vote(At?, Rs?, B).

procedure has_answer(Attempt?, Recs?, YesNo).
has_answer(_, [], no).
has_answer(At, [answered(A, _) | _], yes) :- (At? =?= A?) | true.
has_answer(At, [_ | Rs], B?) :- otherwise | has_answer(At?, Rs?, B).

procedure answer_of(Attempt?, Recs?, YesNo).
answer_of(_, [], no).
answer_of(At, [answered(A, Y) | _], Y?) :- (At? =?= A?) | true.
answer_of(At, [_ | Rs], Y?) :- otherwise | answer_of(At?, Rs?, Y).

procedure of_class(Attempt?, Info?, YesNo).
of_class(attempt(_, _, _, C), I, B?) :- term_of_class(C?, I?, B).

procedure term_of_class(Class?, Info?, YesNo).
term_of_class(C, ci(_, Ps, Q, _, Ms), B?) :- ground(C?) | term_spec(C?, _, Rs, Bn), of_class1(Rs?, Bn?, Ps?, Q?, Ms?, B).

procedure of_class1(RoleSpecs?, Binding?, Deltas?, Peers?, Mates?, YesNo).
of_class1(Rs, Bn, Ps, Q, Ms, B?) :- ground(Rs?), ground(Bn?) | sig_of(Rs?, Bn?, Ps1), in_class(Rs?, Bn?, Ps1?, Ps?, Q?, Ms?, B).

procedure others_known(Info?, St?, Known).
others_known(I, St, K?) :- ground(St?) | info_q(I?, Q), st_id(St?, Id), first_unknown(Q?, Id?, St?, K).

procedure first_unknown(Peers?, Peer?, St?, Known).
first_unknown([], _, _, allknown).
first_unknown([P | Ps], Id, St, K?) :- ground(P?), ground(Id?), ground(St?) | same(P?, Id?, Me), known_st(P?, St?, Kn), or(Me?, Kn?, Ok), first_unknown1(Ok?, P?, Ps?, Id?, St?, K).

procedure first_unknown1(YesNo?, Peer?, Peers?, Peer?, St?, Known).
first_unknown1(yes, _, Ps, Id, St, K?) :- first_unknown(Ps?, Id?, St?, K).
first_unknown1(no, P, _, _, _, unknown(P?)).

procedure known_st(Peer?, St?, YesNo).
known_st(P, St, B?) :- ground(P?), ground(St?) | st_sent(St?, Se), st_recd(St?, Rc), st_isent(St?, ISe), st_irecd(St?, IRc), known_peer(P?, Se?, Rc?, B1), known_peer(P?, ISe?, IRc?, B2), or(B1?, B2?, B).

procedure known_peer(Peer?, Peers?, Peers?, YesNo).
known_peer(P, Se, Rc, B?) :- ground(P?) | mem(P?, Se?, B1), mem(P?, Rc?, B2), and(B1?, B2?, B).

procedure known_ok(Known?, YesNo).
known_ok(allknown, yes).
known_ok(unknown(_), no).

procedure go_or_drop(YesNo?, Info?, Cond).
go_or_drop(yes, I, go(I?)).
go_or_drop(no, _, drop).

procedure no_prior_start(St?, YesNo).
no_prior_start(St, B?) :- ground(St?) | st_pends(St?, Pd), st_app(St?, Ap), app_recs(Ap?, R), any_answered_yes(R?, Q), empty_pends(Pd?, E), neg(Q?, NQ), and(E?, NQ?, B).

procedure empty_pends(Pends?, YesNo).
empty_pends([], yes).
empty_pends([_ | _], no).

procedure any_answered_yes(Recs?, YesNo).
any_answered_yes(R, B?) :- ground(R?) | any_answered_yes1(R?, R?, B).

procedure any_answered_yes1(Recs?, Recs?, YesNo).
any_answered_yes1([], _, no).
any_answered_yes1([answered(G, yes) | Rs], R, B?) :- ground(G?), ground(R?) | pending_rec(G?, R?, P), any_answered_yes2(P?, Rs?, R?, B).
any_answered_yes1([_ | Rs], R, B?) :- otherwise | any_answered_yes1(Rs?, R?, B).

procedure any_answered_yes2(YesNo?, Recs?, Recs?, YesNo).
any_answered_yes2(yes, _, _, yes).
any_answered_yes2(no, Rs, R, B?) :- any_answered_yes1(Rs?, R?, B).

procedure precedes(Peer?, Peer?, YesNo).
precedes(P, Q, yes) :- '@<'(P?, Q?) | true.
precedes(_, _, no) :- otherwise | true.

procedure guarding_parts(Parts?, Peer?, Classes).
guarding_parts([], _, []).
guarding_parts([pt(T, G, Op) | Ps], Id, R?) :- ground(Id?) | mem(Id?, G?, B1), no_opener(Op?, B2), and(B1?, B2?, B), guarding_parts(Ps?, Id?, R1), keep_class(B?, T?, R1?, R).

procedure no_opener(Opener?, YesNo).
no_opener(opener(_), no).
no_opener(guarded_part, yes).

procedure opening_parts(Parts?, Peer?, Classes).
opening_parts([], _, []).
opening_parts([pt(T, G, Op) | Ps], Id, R?) :- ground(Id?) | is_opener(Op?, Id?, B1), some_peer(G?, B2), neg(B2?, B3), and(B1?, B3?, B), opening_parts(Ps?, Id?, R1), keep_class(B?, T?, R1?, R).

procedure is_opener(Opener?, Peer?, YesNo).
is_opener(opener(P), Id, B?) :- same(P?, Id?, B).
is_opener(guarded_part, _, no).

procedure all_in(Peers?, Peers?, YesNo).
all_in([], _, yes).
all_in([P | Ps], Q, B?) :- ground(Q?) | mem(P?, Q?, B1), all_in1(B1?, Ps?, Q?, B).

procedure all_in1(YesNo?, Peers?, Peers?, YesNo).
all_in1(no, _, _, no).
all_in1(yes, Ps, Q, B?) :- all_in(Ps?, Q?, B).

procedure part_dom(Class?, Peer?, GAtoms?, YesNo).
part_dom(P, Id, S, B?) :- ground(P?), ground(Id?), ground(S?) | term_spec(P?, Nm, Rs, Bn), part_dom1(Nm?, Rs?, Bn?, Id?, S?, B).

procedure part_dom1(Constant?, RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
part_dom1(Nm, Rs, Bn, Id, S, B?) :- ground(Bn?), ground(Id?), ground(S?) | reflexive_preds(Rf), hat(Rf?, Id?, S?, Sh), mate_dom(Rs?, Bn?, Id?, Sh?, B1), listing_ok(Nm?, Bn?, Id?, S?, B2), and(B1?, B2?, B).

procedure hat(Preds?, Peer?, GAtoms?, GAtoms).
hat([], _, S, S?).
hat([P | Ps], Id, S, [g(P?, [p(Id?)]) | R?]) :- ground(Id?) | hat(Ps?, Id?, S?, R).

procedure ready_parts(Classes?, Peer?, GAtoms?, Classes).
ready_parts([], _, _, []).
ready_parts([P | Ps], Id, S, R?) :- ground(P?), ground(Id?), ground(S?) | part_dom(P?, Id?, S?, B), ready_parts(Ps?, Id?, S?, R1), keep_class(B?, P?, R1?, R).

procedure keep_class(YesNo?, Class?, Classes?, Classes).
keep_class(yes, P, R, [P? | R?]).
keep_class(no, _, R, R?).

procedure same_part(Info?, Class?, Class?, YesNo).
same_part(I, C1, C2, B?) :- ground(I?), ground(C1?), ground(C2?) | info_q(I?, Q), binding_of(C1?, N1, B1), binding_of(C2?, N2, B2), same_part1(Q?, N1?, B1?, N2?, B2?, B).

procedure same_part1(Peers?, Constant?, Binding?, Constant?, Binding?, YesNo).
same_part1(Q, N1, B1, N2, B2, B?) :- ground(N1?), ground(B1?), ground(N2?), ground(B2?) | marked_people(N1?, B1?, G1), marked_people(N2?, B2?, G2), same_bpart(Q?, N1?, B1?, G1?, N2?, B2?, G2?, B).

procedure same_bpart(Peers?, Constant?, Binding?, Peers?, Constant?, Binding?, Peers?, YesNo).
same_bpart(Q, N1, B1, G1, N2, B2, G2, B?) :- ground(B1?), ground(B2?) | same(G1?, G2?, E1), bound_spec(N1?, B1?, Rs1), bound_spec(N2?, B2?, Rs2), reflexive_preds(Rf), same_doms(Q?, Rs1?, B1?, Rs2?, B2?, Rf?, E2), and(E1?, E2?, B).

procedure marked_people(Constant?, Binding?, Peers).
marked_people(Nm, B, G?) :- ground(B?) | bound_spec(Nm?, B?, Rs), marked_of(Rs?, B?, G).

procedure marked_of(RoleSpecs?, Binding?, Peers).
marked_of(Rs, B, G?) :- ground(Rs?) | guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), sort_peers(Gp?, Gs), dedup(Gs?, G).

procedure same_doms(Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
same_doms([], _, _, _, _, _, yes).
same_doms([P | Ps], Rs1, B1, Rs2, B2, Rf, B?) :- ground(P?), ground(Rs1?), ground(B1?), ground(Rs2?), ground(B2?), ground(Rf?) | reqs_at(Rs1?, B1?, P?, Rf?, R1), reqs_at(Rs2?, B2?, P?, Rf?, R2), forbs_at(Rs1?, B1?, P?, F1), forbs_at(Rs2?, B2?, P?, F2), dedup(F1?, F1s), dedup(F2?, F2s), ms_eq(R1?, R2?, E1), ms_eq(F1s?, F2s?, E2), and(E1?, E2?, E), same_doms1(E?, Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, B).

procedure same_doms1(YesNo?, Peers?, RoleSpecs?, Binding?, RoleSpecs?, Binding?, Preds?, YesNo).
same_doms1(no, _, _, _, _, _, _, no).
same_doms1(yes, Ps, Rs1, B1, Rs2, B2, Rf, B?) :- same_doms(Ps?, Rs1?, B1?, Rs2?, B2?, Rf?, B).

procedure term_part(Class?, Info?, Class?, YesNo).
term_part(E, I, P, B?) :- ground(E?), ground(I?), ground(P?) | term_of_class(E?, I?, In), term_part1(In?, E?, I?, P?, B).

procedure term_part1(YesNo?, Class?, Info?, Class?, YesNo).
term_part1(no, _, _, _, no).
term_part1(yes, E, I, P, B?) :- same_part(I?, E?, P?, B).

procedure mate_dom(RoleSpecs?, Binding?, Peer?, GAtoms?, YesNo).
mate_dom(Rs, B, Id, Sh, R?) :- ground(Rs?), ground(B?), ground(Id?), ground(Sh?) | specs_at(Rs?, 1, B?, Id?, RsP), mate_dom1(RsP?, B?, Sh?, R).

procedure mate_dom1(RoleSpecs?, Binding?, GAtoms?, YesNo).
mate_dom1(RsP, B, Sh, R?) :- ground(RsP?), ground(Sh?) | reqs_of(RsP?, Q), match_all(Q?, Sh?, B?, Bs), cands_ok(Bs?, RsP?, Sh?, R).

procedure reqs_of(RoleSpecs?, SAtoms).
reqs_of([], []).
reqs_of([R | Rs], Q?) :- ground(R?) | rs_req(R?, Q1), reqs_of(Rs?, Q2), app(Q1?, Q2?, Q).

procedure cands_ok(Bindings?, RoleSpecs?, GAtoms?, YesNo).
cands_ok([], _, _, no).
cands_ok([B | Bs], RsP, Sh, R?) :- ground(RsP?), ground(Sh?) | cand_ok(RsP?, B?, Sh?, R1), cands_ok1(R1?, Bs?, RsP?, Sh?, R).

procedure cands_ok1(YesNo?, Bindings?, RoleSpecs?, GAtoms?, YesNo).
cands_ok1(yes, _, _, _, yes).
cands_ok1(no, Bs, RsP, Sh, R?) :- cands_ok(Bs?, RsP?, Sh?, R).

procedure cand_ok(RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok([], _, _, yes).
cand_ok([R | Rs], B, Sh, Out?) :- ground(R?), ground(B?), ground(Sh?) | rs_req(R?, Q), img_atoms(Q?, B?, G), ms_sub(G?, Sh?, B1), rs_forb(R?, F), forb_ok(F?, B?, Sh?, B2), and(B1?, B2?, B3), cand_ok1(B3?, Rs?, B?, Sh?, Out).

procedure cand_ok1(YesNo?, RoleSpecs?, Binding?, GAtoms?, YesNo).
cand_ok1(no, _, _, _, no).
cand_ok1(yes, Rs, B, Sh, Out?) :- cand_ok(Rs?, B?, Sh?, Out).

procedure forb_ok(SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok([], _, _, yes).
forb_ok([A | As], B, Sh, R?) :- ground(A?), ground(B?), ground(Sh?) | atom_bound(A?, B?, Bd), forb_one(Bd?, A?, B?, Sh?, R1), forb_ok1(R1?, As?, B?, Sh?, R).

procedure forb_one(YesNo?, SAtom?, Binding?, GAtoms?, YesNo).
forb_one(no, _, _, _, yes).
forb_one(yes, A, B, Sh, R?) :- ground(Sh?) | img_atom(A?, B?, G), mem(G?, Sh?, In), neg(In?, R).

procedure forb_ok1(YesNo?, SAtoms?, Binding?, GAtoms?, YesNo).
forb_ok1(no, _, _, _, no).
forb_ok1(yes, As, B, Sh, R?) :- forb_ok(As?, B?, Sh?, R).

procedure apply_info(Info?, Peer?, GAtoms?, GAtoms).
apply_info(ci(_, Ps, _, _, _), Id, S, S1?) :- ground(Id?) | delta_at(Ps?, Id?, D, A), ms_diff(S?, D?, S0), app(A?, S0?, S1).

procedure delta_at(Deltas?, Peer?, GAtoms, GAtoms).
delta_at([], _, [], []).
delta_at([delta(P, D, A) | _], Id, D?, A?) :- (P? =?= Id?) | true.
delta_at([_ | Ps], Id, D?, A?) :- otherwise | delta_at(Ps?, Id?, D, A).

procedure st_class(Class?, St?, ClassRes, St).
st_class(C, st(Id, Ap, D, Se, Rc, ISe, IRc, W, Ca, Pd, Pr), R?, st(Id?, Ap?, D?, Se?, Rc?, ISe?, IRc?, W?, Ca1?, Pd?, Pr?)) :- ground(Id?) | class_info(C?, Id?, Ca?, R, Ca1).

procedure class_info(Class?, Peer?, Infos?, ClassRes, Infos).
class_info(C, Id, Ca, R?, Ca1?) :- ground(C?) | binding_of(C?, Nm, B), class_info1(Nm?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info1(Constant?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info1(Nm, B, C, Id, Ca, R?, Ca1?) :- ground(Nm?), ground(B?) | bound_spec(Nm?, B?, Rs), rule_spec_ok(Nm?, B?, V1), class_info2(V1?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info2(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info2(V1, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | admissible(Rs?, B?, V2), and(V1?, V2?, V), class_info3(V?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info3(YesNo?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info3(no, _, _, _, _, Ca, nocls, Ca?).
class_info3(yes, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Rs?), ground(B?) | sig_of(Rs?, B?, Ps), class_info4(Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info4(Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info4(Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Id?), ground(Rs?), ground(B?) | deltas_valid(Ps?, V1), deltas_peers(Ps?, Q), mem(Id?, Q?, V2), deltas_peers(Ps?, Q1), reflexive_preds(Rf), live_at(Q1?, Rs?, B?, Rf?, V3), and(V1?, V2?, V12), and(V12?, V3?, V), class_info5(V?, Ps?, Rs?, B?, C?, Id?, Ca?, R, Ca1).

procedure class_info5(YesNo?, Deltas?, RoleSpecs?, Binding?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info5(no, _, _, _, _, _, Ca, nocls, Ca?).
class_info5(yes, Ps, Rs, B, C, Id, Ca, R?, Ca1?) :- ground(Ps?), ground(Ca?) | cache_find(Rs?, B?, Ps?, Ca?, F), class_info6(F?, Ps?, C?, Id?, Ca?, R, Ca1).

procedure class_info6(ClassRes?, Deltas?, Class?, Peer?, Infos?, ClassRes, Infos).
class_info6(cls(I), _, _, _, Ca, cls(I?), Ca?).
class_info6(nocls, Ps, C, Id, Ca, R?, Ca1?) :- new_info(C?, Ps?, Id?, I), add_info(I?, Ca?, R, Ca1).

procedure add_info(Info?, Infos?, ClassRes, Infos).
add_info(I, Ca, cls(I?), Ca1?) :- ground(I?) | app(Ca?, [I?], Ca1).

procedure cache_find(RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find(_, _, _, [], nocls).
cache_find(Rs, B, Ps, [ci(C, Ps1, Q, Pts, Ms) | Is], R?) :- ground(Rs?), ground(B?), ground(Ps?), ground(Ps1?), ground(Q?), ground(Ms?) | in_class(Rs?, B?, Ps?, Ps1?, Q?, Ms?, E), cache_find1(E?, ci(C?, Ps1?, Q?, Pts?, Ms?), Rs?, B?, Ps?, Is?, R).

procedure cache_find1(YesNo?, Info?, RoleSpecs?, Binding?, Deltas?, Infos?, ClassRes).
cache_find1(yes, I, _, _, _, _, cls(I?)).
cache_find1(no, _, Rs, B, Ps, Is, R?) :- cache_find(Rs?, B?, Ps?, Is?, R).

procedure new_info(Class?, Deltas?, Peer?, Info).
new_info(C, Ps, Id, I?) :- ground(Ps?) | contract_schemas(Ss), reflexive_preds(Rf), mates_of(Ss?, Ps?, Ms0), dedup_mates(Ms0?, Ms1), deltas_peers(Ps?, Q), new_info0(C?, Ps?, Ms1?, Q?, Rf?, Id?, I).

procedure new_info0(Class?, Deltas?, Mates?, Peers?, Preds?, Peer?, Info).
new_info0(C, Ps, Ms1, Q, Rf, Id, I?) :- ground(C?), ground(Q?), ground(Rf?) | live_mates(Ms1?, Q?, Rf?, Ms2), binding_of(C?, Nm, B), class_mates(Nm?, B?, Ms2?, Q?, Rf?, Ms), new_info1(C?, Ps?, Ms?, Id?, I).

procedure new_info1(Class?, Deltas?, Mates?, Peer?, Info).
new_info1(C, Ps, Ms, Id, ci(C?, Ps?, Q?, Pts?, Ms?)) :- ground(Ps?), ground(Ms?) | deltas_peers(Ps?, Q), deltas_peers(Ps?, Q1), info_parts_of(Ms?, Q1?, Id?, Pts).

procedure info_q(Info?, Peers).
info_q(ci(_, _, Q, _, _), Q?).

procedure info_parts(Info?, Parts).
info_parts(ci(_, _, _, Pts, _), Pts?).

procedure sig_of(RoleSpecs?, Binding?, Deltas).
sig_of(Rs, B, Ps?) :- ground(Rs?), ground(B?) | role_persons(Rs?, 1, B?, Ws), dedup(Ws?, Q), deltas_for(Q?, Rs?, B?, Ps).

procedure role_persons(RoleSpecs?, Integer?, Binding?, Peers).
role_persons([], _, _, []).
role_persons([_ | Rs], I, B, [P? | Ps?]) :- integer(I?), ground(B?) | role_person(I?, B?, P), I1 := (I? + 1), role_persons(Rs?, I1?, B?, Ps).

procedure deltas_for(Peers?, RoleSpecs?, Binding?, Deltas).
deltas_for([], _, _, []).
deltas_for([P | Ps], Rs, B, [delta(P?, D?, A?) | Xs?]) :- ground(P?), ground(Rs?), ground(B?) | specs_at(Rs?, 1, B?, P?, RsP), joins(RsP?, B?, D, A), deltas_for(Ps?, Rs?, B?, Xs).

procedure joins(RoleSpecs?, Binding?, GAtoms, GAtoms).
joins(RsP, B, D?, A?) :- ground(RsP?), ground(B?) | dels_join(RsP?, B?, [], D), adds_join(RsP?, B?, [], A).

procedure dels_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
dels_join([], _, Acc, Acc?).
dels_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_del(R?, D), img_atoms(D?, B?, G), ms_join(Acc?, G?, Acc1), dels_join(Rs?, B?, Acc1?, Out).

procedure adds_join(RoleSpecs?, Binding?, GAtoms?, GAtoms).
adds_join([], _, Acc, Acc?).
adds_join([R | Rs], B, Acc, Out?) :- ground(B?) | rs_add(R?, A), img_atoms(A?, B?, G), ms_join(Acc?, G?, Acc1), adds_join(Rs?, B?, Acc1?, Out).

procedure specs_at(RoleSpecs?, Integer?, Binding?, Peer?, RoleSpecs).
specs_at([], _, _, _, []).
specs_at([R | Rs], I, B, P, Out?) :- integer(I?), ground(B?), ground(P?) | role_person(I?, B?, Q), I1 := (I? + 1), specs_at(Rs?, I1?, B?, P?, Rest), keep_spec(Q?, P?, R?, Rest?, Out).

procedure keep_spec(Peer?, Peer?, RoleSpec?, RoleSpecs?, RoleSpecs).
keep_spec(Q, P, R, Rest, [R? | Rest?]) :- (Q? =?= P?) | true.
keep_spec(_, _, _, Rest, Rest?) :- otherwise | true.

procedure deltas_valid(Deltas?, YesNo).
deltas_valid([], yes).
deltas_valid([delta(_, D, A) | Ps], B?) :- ground(A?) | ms_meets(D?, A?, M), neg(M?, B1), deltas_valid1(B1?, Ps?, B).

procedure deltas_valid1(YesNo?, Deltas?, YesNo).
deltas_valid1(no, _, no).
deltas_valid1(yes, Ps, B?) :- deltas_valid(Ps?, B).

procedure deltas_peers(Deltas?, Peers).
deltas_peers([], []).
deltas_peers([delta(P, _, _) | Ps], [P? | Qs?]) :- deltas_peers(Ps?, Qs).

procedure deltas_eq(Deltas?, Deltas?, YesNo).
deltas_eq(A, B, E?) :- ground(A?), ground(B?) | len_deltas(A?, La), len_deltas(B?, Lb), same_int(La?, Lb?, E1), deltas_in(A?, B?, E2), and(E1?, E2?, E).

procedure len_deltas(Deltas?, Integer).
len_deltas([], 0).
len_deltas([_ | Ps], N?) :- len_deltas(Ps?, M), N := (M? + 1).

procedure deltas_in(Deltas?, Deltas?, YesNo).
deltas_in([], _, yes).
deltas_in([X | Xs], B, E?) :- ground(B?) | delta_in(X?, B?, E1), deltas_in1(E1?, Xs?, B?, E).

procedure deltas_in1(YesNo?, Deltas?, Deltas?, YesNo).
deltas_in1(no, _, _, no).
deltas_in1(yes, Xs, B, E?) :- deltas_in(Xs?, B?, E).

procedure delta_in(Delta?, Deltas?, YesNo).
delta_in(_, [], no).
delta_in(delta(P, D, A), [delta(Q, D1, A1) | Ps], E?) :- (P? =?= Q?), ground(D?), ground(A?) | ms_eq(D?, D1?, E1), ms_eq(A?, A1?, E2), and(E1?, E2?, E3), delta_in1(E3?, delta(P?, D?, A?), Ps?, E).
delta_in(X, [_ | Ps], E?) :- otherwise | delta_in(X?, Ps?, E).

procedure delta_in1(YesNo?, Delta?, Deltas?, YesNo).
delta_in1(yes, _, _, yes).
delta_in1(no, X, Ps, E?) :- delta_in(X?, Ps?, E).

procedure rule_ok(RoleSpecs?, Binding?, YesNo).
rule_ok(Rs, B, R?) :- ground(Rs?) | rs_len(Rs?, K), pairs_ok(1, K?, Rs?, B?, R).

procedure pairs_ok(Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok(I, K, _, _, yes) :- (I? > K?) | true.
pairs_ok(I, K, Rs, B, R?) :- (I? =< K?), ground(Rs?), ground(B?) | J := (I? + 1), pair_row(I?, J?, K?, Rs?, B?, R1), I1 := (I? + 1), pairs_ok1(R1?, I1?, K?, Rs?, B?, R).

procedure pairs_ok1(YesNo?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pairs_ok1(no, _, _, _, _, no).
pairs_ok1(yes, I, K, Rs, B, R?) :- pairs_ok(I?, K?, Rs?, B?, R).

procedure pair_row(Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row(_, J, K, _, _, yes) :- (J? > K?) | true.
pair_row(I, J, K, Rs, B, R?) :- (J? =< K?), ground(Rs?), ground(B?) | role_person(I?, B?, P), role_person(J?, B?, Q), nth_spec(Rs?, I?, RI), nth_spec(Rs?, J?, RJ), pair_ok(P?, Q?, RI?, RJ?, I?, J?, R1), J1 := (J? + 1), pair_row1(R1?, I?, J1?, K?, Rs?, B?, R).

procedure pair_row1(YesNo?, Integer?, Integer?, Integer?, RoleSpecs?, Binding?, YesNo).
pair_row1(no, _, _, _, _, _, no).
pair_row1(yes, I, J, K, Rs, B, R?) :- pair_row(I?, J?, K?, Rs?, B?, R).

procedure pair_ok(Peer?, Peer?, RoleSpec?, RoleSpec?, Integer?, Integer?, YesNo).
pair_ok(P, Q, RI, RJ, I, J, R?) :- (P? =?= Q?) | role_names(RI?, J?, A1), role_names(RJ?, I?, A2), or(A1?, A2?, A), neg(A?, R).
pair_ok(_, _, _, _, _, _, yes) :- otherwise | true.

procedure role_names(RoleSpec?, Integer?, YesNo).
role_names(rs(_, A, D, _, _), J, R?) :- integer(J?) | names_role(A?, J?, R1), names_role(D?, J?, R2), or(R1?, R2?, R).

procedure names_role(SAtoms?, Integer?, YesNo).
names_role([], _, no).
names_role([atom(_, Vs) | As], J, R?) :- integer(J?), ground(Vs?) | flat_names(Vs?, Fs), mem(role(J?), Fs?, R1), sgn_names(Vs?, J?, R2), or(R1?, R2?, R12), names_role1(R12?, As?, J?, R).

procedure names_role1(YesNo?, SAtoms?, Integer?, YesNo).
names_role1(yes, _, _, yes).
names_role1(no, As, J, R?) :- names_role(As?, J?, R).

procedure sgn_names(Vars?, Integer?, YesNo).
sgn_names([], _, no).
sgn_names([sgn(_, I) | _], J, yes) :- (I? =:= J?) | true.
sgn_names([_ | Vs], J, R?) :- otherwise | sgn_names(Vs?, J?, R).

procedure admissible(RoleSpecs?, Binding?, YesNo).
admissible(Rs, B, R?) :- ground(Rs?), ground(B?) | adds_of(Rs?, Ad), reqs_of(Rs?, Rq), guard_roles(Rs?, 1, Gi), persons_of(Gi?, B?, Gp), atoms_vars(Ad?, Av), adm_each(Av?, Rq?, B?, Gp?, R).

procedure adm_each(Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each([], _, _, _, yes).
adm_each([V | Vs], Rq, B, Gp, R?) :- ground(V?), ground(Rq?), ground(B?), ground(Gp?) | adm_var(V?, Rq?, B?, Gp?, R1), adm_each1(R1?, Vs?, Rq?, B?, Gp?, R).

procedure adm_each1(YesNo?, Vars?, SAtoms?, Binding?, Peers?, YesNo).
adm_each1(no, _, _, _, _, no).
adm_each1(yes, Vs, Rq, B, Gp, R?) :- adm_each(Vs?, Rq?, B?, Gp?, R).

procedure adm_var(Var?, SAtoms?, Binding?, Peers?, YesNo).
adm_var(svar(X), Rq, B, Gp, R?) :- ground(X?), ground(B?) | atoms_vars(Rq?, Qv), mem(svar(X?), Qv?, InReq), lookup(svar(X?), B?, F), adm_var1(InReq?, F?, Gp?, R).
adm_var(role(_), _, _, _, yes).
adm_var(pvar(_), _, _, _, yes).
adm_var(nterm(_), _, _, _, yes).
adm_var(sgn(_, _), _, _, _, yes).

procedure adm_var1(YesNo?, Found?, Peers?, YesNo).
adm_var1(yes, _, _, yes).
adm_var1(no, found(s(speech(_, P))), Gp, R?) :- mem(P?, Gp?, R).
adm_var1(no, found(p(_)), _, no).
adm_var1(no, found(c(_)), _, no).
adm_var1(no, free, _, no).

procedure adds_of(RoleSpecs?, SAtoms).
adds_of([], []).
adds_of([R | Rs], A?) :- rs_add(R?, A1), adds_of(Rs?, A2), app(A1?, A2?, A).

procedure atoms_vars(SAtoms?, Vars).
atoms_vars([], []).
atoms_vars([atom(_, Vs) | As], R?) :- flat_names(Vs?, Ws), atoms_vars(As?, R1), app(Ws?, R1?, R).

procedure guard_roles(RoleSpecs?, Integer?, Ints).
guard_roles([], _, []).
guard_roles([rs(guarded, _, _, _, _) | Rs], I, [I? | Is?]) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).
guard_roles([rs(unguarded, _, _, _, _) | Rs], I, Is?) :- integer(I?) | I1 := (I? + 1), guard_roles(Rs?, I1?, Is).

procedure persons_of(Ints?, Binding?, Peers).
persons_of([], _, []).
persons_of([I | Is], B, [P? | Ps?]) :- ground(B?) | role_person(I?, B?, P), persons_of(Is?, B?, Ps).

procedure mates_of(Schemas?, Deltas?, Mates).
mates_of([], _, []).
mates_of([schema(Nm, _, Rs) | Ss], Ps, M?) :- ground(Nm?), ground(Rs?), ground(Ps?) | deltas_peers(Ps?, Q), rs_len(Rs?, K), assigns(K?, Q?, As), mates_assigns(As?, Nm?, Rs?, Ps?, M1), mates_of(Ss?, Ps?, M2), app(M1?, M2?, M).
