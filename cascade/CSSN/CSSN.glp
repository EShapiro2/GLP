%% ---------------------------------------------------------------------------
%% CSSN.glp --- CSSN, the child-safe social network, CSSN's, its clauses in CSSN.txt beside this file: it instantiates GSNW (GSNW.glp beside this file), a child for a ward and a parent for a guardian, and restricts and extends it (Udi, 2026-11-10, to CSSN #14), in the terms of GSC's paper, Section Relations among Contracts, and in the clause syntax of its Section 3.2, for programs/vglp/cva/compiler to compile into its canonical CVA platform (CSSN, Section 4.6.1).
%% The term is an instance of GSNW, instance_named(cssn, gsnw, Bindings, Additions) (GSC's paper, Definition Parametric contract; programs/gsc/README.md, "Parametric contracts and their instances"): its parameter ward written child and guardian_of parenting, creator, created, guarded_by and retired as GSNW writes them, and CSSN's names for twenty of GSNW's acts, child for ward, children for wards and parent for guardian (Udi, 2026-11-10, to GSC #14; GSC 22605d6); it restates no schema of GSNW.
%% Four schemas.  Three replace GSNW's, the restrictions, by GSC's Proposition Syntactic restrictions (d), an added guard that changes no state: child_acquaint and children_acquaint take a parent of each child, who knows the other agent (CSSN:2), and child_create a parent's consent, the child signing the group's name (CSSN:3).  One is added, the extension: of_age (CSSN:4), which deletes child where it adds person.  With GSNW's thirty-five the instance has thirty-nine.
%% Written by CSSN #14 Cowork, 2026-11-10, and as an instance by CSSN #15, 2026-11-11, once the readers took instance_named (Code #27, CSSN_inbox 2026-11-11 19:53 UTC); printed by docs/gen_gsnw.py of the CSSN paper's repository, which prints GSNW.glp from programs/gsc/GnW.glp beside it.  The earlier history is in git.
%% ---------------------------------------------------------------------------

%% introduction_named(cssn, I): the contract's introduction predicate, knows, by which an agent introduces to each other, at the level of the machines, every two agents its person knows (CSSN, Section 4.6.1, "The program"; vGLP, Section 5.4), in the form of programs/vglp/cva/contracts.glp.
Intro ::= no_introduction ; introduction(Constant).
procedure introduction_named(Constant?, Intro).
introduction_named(cssn, introduction(knows)).

% instance_named(cssn, gsnw, Bindings, Additions): the contract, CSSN, an instance of GSNW.
procedure instance_named(Constant?, Constant, SBindings, SDeclared).
instance_named(cssn, gsnw,
   [ward = child,
    guardian_of = parenting,
    make_guardian = make_parent,
    end_guardian = end_parent,
    guardian_unfriend = parent_unfriend,
    ward_acquaint = child_acquaint,
    ward_befriend = child_befriend,
    ward_unfriend = child_unfriend,
    ward_end = child_end,
    wards_acquaint = children_acquaint,
    wards_befriend = children_befriend,
    ward_message = child_message,
    ward_create = child_create,
    ward_join = child_join,
    wards_join = children_join,
    ward_leave = child_leave,
    ward_remove = child_remove,
    ward_withdraw = child_withdraw,
    ward_close = child_close,
    guardian_close = parent_close,
    ward_post_own = child_post_own,
    ward_post = child_post],
   [
%% CSSN:2, A child's acquaintances, restricting GnW:3's by GSC's Proposition Syntactic restrictions (d): Carol, a child of Alice, comes to know Bob by an act of Carol, Alice and Bob, provided Alice knows Bob.
    sas(child_acquaint, ['Carol', 'Bob', 'Alice'], [],
       [atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Bob']), atom(person, ['Bob']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(knows, ['Alice', 'Bob'])],
       true, ['Carol', 'Bob', 'Alice']),
%% CSSN:2, restricting GnW:4's by (d): Carol comes to know Dave, a child of Bob, by an act of Carol, Alice, Dave and Bob, provided Alice knows Dave and Bob, and Bob knows Carol and Alice; Alice and Bob possibly one person.
    sas(children_acquaint, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
       [atom(knows, ['Carol', 'Dave']), atom(knows, ['Dave', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Dave']), atom(child, ['Dave']), atom(guarded_by, ['Dave', 'Bob']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(knows, ['Alice', 'Bob']),
        atom(identity, ['Bob']), atom(person, ['Bob']), atom(parenting, ['Bob', 'Dave']),
        atom(knows, ['Bob', 'Carol']), atom(knows, ['Bob', 'Alice'])],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% CSSN:3, A child's group, restricting GSNW:2's by (d): Carol creates a group with the consent of a parent, Alice; Carol signs its name.
    sas(child_create, ['Carol', 'Alice'], [n],
       [atom(member, ['Carol', ext(own('Carol'), n)]), atom(listed, ['Carol', 'Carol', n])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Alice']),
        not(atom(member, ['Carol', ext(own('Carol'), n)])), not(atom(closed, ['Carol', n])),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(parenting, ['Alice', 'Carol'])],
       signed('Carol', n), ['Carol', 'Alice']),
%% CSSN:4, Coming of age, CSSN's extension: Alice, the creator of Carol, declares Carol of age, which ends every guardianship of Carol, of every parent Erin, the friendships remaining, and Carol is then a person.
    sas(of_age, ['Carol', 'Alice', 'Erin'], [],
       [atom(person, ['Carol']), not(atom(child, ['Carol'])), not(atom(creator, ['Carol', 'Alice'])),
        not(atom(guarded_by, ['Carol', '_'])),
        not(atom(created, ['Alice', 'Carol'])),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), true, [not(atom(parenting, ['Erin', 'Carol']))])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(creator, ['Carol', 'Alice']),
        atom(guarded_by, ['Carol', 'Alice']),
        atom(identity, ['Alice']), atom(person, ['Alice']), atom(created, ['Alice', 'Carol']),
        atom(parenting, ['Alice', 'Carol']),
        forall(['Erin'], atom(guarded_by, ['Carol', 'Erin']), true,
               and(atom(identity, ['Erin']), and(atom(person, ['Erin']), atom(parenting, ['Erin', 'Carol']))))],
       true, ['Alice'])
]).
