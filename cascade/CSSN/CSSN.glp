%% ---------------------------------------------------------------------------
%% CSSN.glp --- CSSN, the child-safe social network, CSSN's, its clauses in CSSN.txt beside this file, amending GSN and GnW, GSC's (programs/gsc), with GSG and GKK beneath them, in the clause syntax of GSC's paper, Section 3.2 (the form is described in programs/gsc/GKK.glp and programs/gsc/README.md, "Writing a contract"), for programs/vglp/cva/compiler to compile into its canonical CVA platform (CSSN, Section 4.6.1).  This term is the one source of the schemas; a run of the cascade prints their notation from it (schemas.txt).
%% Thirty-one schemas.  GSN's fourteen for persons: child forbidden at every role of acquaint, introduce, befriend, create and join; unfriend forbidding at either role the creator and a parent of the other; a child messages, posts, leaves a group and ends a friendship by GSN's schemas (CSSN:6; GnW:3).  Seventeen for children, which realise GnW and CSSN in CSSN's own predicates: enter (GnW:1, CSSN:1); make_parent, end_parent, resign and parent_unfriend (GnW:2); child_acquaint and child_acquaint_2 (CSSN:2); child_adult_befriend, child_unfriend, child_join, child_leave and child_close (GnW:3); child_befriend and child_join_2 (GnW:4, CSSN:3); child_create (CSSN:3); of_age (CSSN:4); and retire (GnW:5).
%% Carol, a child, holds child, the mark, and creator of her creator; the creator holds created of Carol; every parent, the creator among them, holds parenting of Carol, and Carol holds guarded_by of each parent the creator made.  Every role requires identity, except the role of establish and the child's role of enter, which forbid it and add it.  retired is a leaving mark: every guard forbids it, no schema deletes it, and retire, which adds it, requires child there.  In the terms of GSC's paper, Section "Contracts with Wards": the marks {child}, the guardianship (child, identity, creator, created, parenting), acquaint unobstructed but for the marks, and the relay acts child_acquaint, with a ward role, a free role and the parent as its guardian role, and child_acquaint_2, with two ward roles and their parents as guardian roles; the listed roles of close, child_close, of_age and retire are those of CSSN's Definition "Syntactically grassroots with wards" (CSSN, Appendix B.4).
%% Rewritten by CSSN #14 Cowork, 2026-11-10, from the checker's old term form, schema/cschema with rs(Guard, Add, Delete, Require, Forbid) (GLP 5e617682), into the clause syntax, schema by schema with the same requirements and effects, but introduce, which follows GnW's: Carol a reading role, child forbidden there (Udi, 2026-11-03, to GSC #10; GAI #11, CSSN_inbox 2026-11-05 07:05 UTC).  The earlier history is in git.
%% ---------------------------------------------------------------------------

SNT         ::= own(Constant) ; ext(SNT, Constant).
SArg        ::= Constant ; own(Constant) ; ext(SNT, Constant) ; num(Constant)
              ; sgn(Constant, Constant).
SArgs       ::= [] ; [SArg | SArgs].
SAtom       ::= atom(Constant, SArgs).
SMult       ::= SAtom ; times(SArg, SAtom).
SQLit       ::= SMult ; not(SMult).
SQLits      ::= [] ; [SQLit | SQLits].
SLit        ::= SQLit ; forall(Constant, SAtom, SQLits).
SLits       ::= [] ; [SLit | SLits].
SExpr       ::= SArg ; plus(SExpr, SExpr) ; minus(SExpr, SExpr) ; mul(SExpr, SExpr)
              ; author_of(Constant).
SConstraint ::= true ; and(SConstraint, SConstraint)
              ; eq(SExpr, SExpr) ; ne(SExpr, SExpr) ; le(SExpr, SExpr) ; lt(SExpr, SExpr)
              ; ge(SExpr, SExpr) ; gt(SExpr, SExpr) ; succ(SArg, SArg)
              ; or(SConstraint, SConstraint)
              ; signed(SArg, SArg) ; unsigned(SArg, SArg).
RName       ::= Constant ; one(Constant, Constant).
Names       ::= [] ; [RName | Names].
PNames      ::= [] ; [Constant | PNames].
Schema      ::= sas(Constant, Names, PNames, SLits, SLits, SConstraint, PNames).
Contract    ::= [] ; [Schema | Contract].
Preds       ::= [] ; [Constant | Preds].
Declared    ::= Contract ; reflexive(Preds, Contract).

%% introduction_named(cssn, I): the contract's introduction predicate, knows, by which an agent introduces to each other, at the level of the machines, every two agents its person knows (CSSN, Section 4.6.1, "The program"; vGLP, Section 5.4), in the form of programs/vglp/cva/contracts.glp.
Intro ::= no_introduction ; introduction(Constant).
procedure introduction_named(Constant?, Intro).
introduction_named(cssn, introduction(knows)).

% contract_named(cssn, C): the contract, CSSN, friend and knows reflexive.
procedure contract_named(Constant?, Declared).
contract_named(cssn, reflexive([friend, knows],
   [
%% GKK:1, Identity.
    sas(establish, ['Alice'], [],
       [atom(identity, ['Alice'])],
       [not(atom(identity, ['Alice'])), not(atom(retired, ['Alice']))], true, ['Alice']),
%% GKK:2, Acquaintance, for two persons.
    sas(acquaint, ['Alice', 'Bob'], [],
       [atom(knows, ['Alice', 'Bob']), atom(knows, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), not(atom(child, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Alice', 'Bob']),
%% GKK:3, Introduction, for persons, with Bob's consent: GnW's introduce, child forbidden at its roles, Carol, the person introduced, a reading role.
    sas(introduce, ['Alice', 'Bob', 'Carol'], [],
       [atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), atom(knows, ['Alice', 'Carol']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']),
        not(atom(child, ['Bob'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Carol']), not(atom(child, ['Carol'])), not(atom(retired, ['Carol']))],
       true, ['Alice', 'Bob']),
%% GSG:1, Friendship, for two persons who know each other.
    sas(befriend, ['Alice', 'Bob'], [],
       [atom(friend, ['Alice', 'Bob']), atom(friend, ['Bob', 'Alice'])],
       [atom(identity, ['Alice']), atom(knows, ['Alice', 'Bob']), not(atom(friend, ['Alice', 'Bob'])),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Alice']), not(atom(friend, ['Bob', 'Alice'])),
        not(atom(child, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Alice', 'Bob']),
%% GSG:2, Ending a friendship, and GnW:3 for a child, but for the friendships GnW:1 and GnW:2 protect; every membership between the two ends with it (GSN:3).
    sas(unfriend, ['Alice', 'Bob'], [],
       [not(atom(friend, ['Alice', 'Bob'])), not(atom(listed, ['Alice', 'Bob', '_'])),
        not(atom(member, ['Alice', ext(own('Bob'), '_')])),
        not(atom(friend, ['Bob', 'Alice'])), not(atom(listed, ['Bob', 'Alice', '_'])),
        not(atom(member, ['Bob', ext(own('Alice'), '_')]))],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']),
        not(atom(creator, ['Alice', 'Bob'])), not(atom(parenting, ['Alice', 'Bob'])),
        not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice']),
        not(atom(creator, ['Bob', 'Alice'])), not(atom(parenting, ['Bob', 'Alice']))],
       true, ['Alice']),
%% GSN:1, Messaging, and CSSN:6 for a child.
    sas(message, ['Alice', 'Bob'], [x],
       [atom(received, ['Bob', x, 'Alice'])],
       [atom(identity, ['Alice']), atom(friend, ['Alice', 'Bob']), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob'])],
       true, ['Alice']),
%% GSN:2, Group, for a person.
    sas(create, ['Alice'], [n],
       [atom(member, ['Alice', ext(own('Alice'), n)]), atom(listed, ['Alice', 'Alice', n])],
       [atom(identity, ['Alice']), not(atom(child, ['Alice'])),
        not(atom(member, ['Alice', ext(own('Alice'), n)])), not(atom(closed, ['Alice', n])),
        not(atom(retired, ['Alice']))],
       true, ['Alice']),
%% GSN:3, Joining and Leaving, for two persons; a child joins by child_join or child_join_2.
    sas(join, ['Alice', 'Bob'], [n],
       [atom(listed, ['Alice', 'Bob', n]), atom(member, ['Bob', ext(own('Alice'), n)])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]), atom(friend, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), not(atom(child, ['Bob'])),
        not(atom(member, ['Bob', ext(own('Alice'), n)])), not(atom(retired, ['Bob']))],
       true, ['Alice', 'Bob']),
%% GSN:3, Bob ends his membership, and GnW:3 for a child.
    sas(leave, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(listed, ['Alice', 'Bob', n]),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)]), not(atom(retired, ['Bob']))],
       true, ['Bob']),
%% GSN:3, Alice, the leader, ends Bob's membership, and GnW:3 for a child.
    sas(remove, ['Alice', 'Bob'], [n],
       [not(atom(listed, ['Alice', 'Bob', n])), not(atom(member, ['Bob', ext(own('Alice'), n)]))],
       [atom(identity, ['Alice']), atom(listed, ['Alice', 'Bob', n]), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       true, ['Alice']),
%% GSN:2, the leader closes the group by leaving it, ending the membership of every Bob she lists.
    sas(close, ['Alice', 'Bob'], [n],
       [atom(closed, ['Alice', n]), not(atom(listed, ['Alice', 'Alice', n])),
        not(atom(member, ['Alice', ext(own('Alice'), n)])),
        forall('Bob', atom(listed, ['Alice', 'Bob', n]),
               [not(atom(member, ['Bob', ext(own('Alice'), n)]))])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Alice', n]), not(atom(retired, ['Alice'])),
        forall('Bob', atom(listed, ['Alice', 'Bob', n]),
               [atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])])],
       true, ['Alice']),
%% GSN:4, Group messaging, and CSSN:6 for a child: the leader's own post.
    sas(post_own, ['Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        not(atom(posted, ['Alice', x, n])), not(atom(retired, ['Alice']))],
       true, ['Alice']),
%% GSN:4: a member's post, sent to the leader.
    sas(post, ['Bob', 'Alice'], [x, n],
       [atom(posted, ['Alice', x, n])],
       [atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)]), not(atom(retired, ['Bob'])),
        atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(posted, ['Alice', x, n])), not(atom(retired, ['Alice']))],
       true, ['Bob']),
%% GSN:4: the leader delivers a post to a member, unguarded.
    sas(deliver, ['Alice', 'Bob'], [x, n],
       [atom(delivered, ['Alice', x, 'Bob', n]), atom(received_in, ['Bob', x, 'Alice', n])],
       [atom(identity, ['Alice']), atom(member, ['Alice', ext(own('Alice'), n)]),
        atom(posted, ['Alice', x, n]), atom(listed, ['Alice', 'Bob', n]), atom(friend, ['Alice', 'Bob']),
        not(atom(delivered, ['Alice', x, 'Bob', n])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Alice'), n)])],
       true, []),
%% GnW:1, Creation, with CSSN:1, Parent: the creator, Alice, chooses Carol's key pair and becomes Carol's creator, parent and friend.
    sas(enter, ['Alice', 'Carol'], [],
       [atom(created, ['Alice', 'Carol']), atom(parenting, ['Alice', 'Carol']),
        atom(friend, ['Alice', 'Carol']), atom(knows, ['Alice', 'Carol']),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(creator, ['Carol', 'Alice']),
        atom(friend, ['Carol', 'Alice']), atom(knows, ['Carol', 'Alice'])],
       [atom(identity, ['Alice']), not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        not(atom(identity, ['Carol'])), not(atom(retired, ['Carol']))],
       true, ['Alice', 'Carol']),
%% GnW:2, Joint guardianship: an act of Alice, the creator, and Bob, her friend, who becomes a parent and a friend of Carol; Carol records Bob as a parent.
    sas(make_parent, ['Alice', 'Bob', 'Carol'], [],
       [atom(parenting, ['Bob', 'Carol']), atom(friend, ['Bob', 'Carol']), atom(knows, ['Bob', 'Carol']),
        atom(guarded_by, ['Carol', 'Bob']), atom(friend, ['Carol', 'Bob']), atom(knows, ['Carol', 'Bob'])],
       [atom(identity, ['Alice']), atom(created, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Alice']), not(atom(child, ['Bob'])),
        not(atom(parenting, ['Bob', 'Carol'])), not(atom(friend, ['Bob', 'Carol'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(creator, ['Carol', 'Alice']),
        not(atom(friend, ['Carol', 'Bob']))],
       true, ['Alice', 'Bob']),
%% GnW:2: the creator ends Bob's guardianship of Carol.
    sas(end_parent, ['Alice', 'Bob', 'Carol'], [],
       [not(atom(parenting, ['Bob', 'Carol'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Alice']), atom(created, ['Alice', 'Carol']), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(parenting, ['Bob', 'Carol']), not(atom(created, ['Bob', 'Carol'])),
        atom(identity, ['Carol']), atom(guarded_by, ['Carol', 'Bob'])],
       true, ['Alice']),
%% GnW:2: Bob ends his own guardianship of Carol and stays her friend.
    sas(resign, ['Bob', 'Carol'], [],
       [not(atom(parenting, ['Bob', 'Carol'])), not(atom(guarded_by, ['Carol', 'Bob']))],
       [atom(identity, ['Bob']), atom(parenting, ['Bob', 'Carol']),
        not(atom(created, ['Bob', 'Carol'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Bob'])],
       true, ['Bob']),
%% GnW:2: Bob ends his guardianship by ending his friendship with Carol, every membership between the two ending with it.
    sas(parent_unfriend, ['Bob', 'Carol'], [],
       [not(atom(parenting, ['Bob', 'Carol'])), not(atom(friend, ['Bob', 'Carol'])),
        not(atom(listed, ['Bob', 'Carol', '_'])), not(atom(member, ['Bob', ext(own('Carol'), '_')])),
        not(atom(guarded_by, ['Carol', 'Bob'])), not(atom(friend, ['Carol', 'Bob'])),
        not(atom(listed, ['Carol', 'Bob', '_'])), not(atom(member, ['Carol', ext(own('Bob'), '_')]))],
       [atom(identity, ['Bob']), atom(parenting, ['Bob', 'Carol']), atom(friend, ['Bob', 'Carol']),
        not(atom(created, ['Bob', 'Carol'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(guarded_by, ['Carol', 'Bob']),
        atom(friend, ['Carol', 'Bob'])],
       true, ['Bob']),
%% CSSN:4, Coming of age: the creator declares Carol of age, which ends every guardianship of Carol, the creator's and that of every parent Bob she made, the friendships remaining.
    sas(of_age, ['Carol', 'Alice', 'Bob'], [],
       [not(atom(child, ['Carol'])), not(atom(creator, ['Carol', 'Alice'])), not(atom(guarded_by, ['Carol', '_'])),
        not(atom(created, ['Alice', 'Carol'])), not(atom(parenting, ['Alice', 'Carol'])),
        forall('Bob', atom(guarded_by, ['Carol', 'Bob']), [not(atom(parenting, ['Bob', 'Carol']))])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(creator, ['Carol', 'Alice']),
        atom(identity, ['Alice']), atom(created, ['Alice', 'Carol']), atom(parenting, ['Alice', 'Carol']),
        not(atom(retired, ['Alice'])),
        forall('Bob', atom(guarded_by, ['Carol', 'Bob']),
               [atom(identity, ['Bob']), atom(parenting, ['Bob', 'Carol']), not(atom(created, ['Bob', 'Carol']))])],
       true, ['Alice']),
%% GnW:5, Retiring: the creator ends her friendship with Carol, which ends every guardianship of Carol, of every parent Bob she made, and every friendship and membership of Carol, with every friend Dave, the creator among them; retired is the leaving mark.
    sas(retire, ['Carol', 'Alice', 'Bob', 'Dave'], [],
       [atom(retired, ['Carol']), not(atom(child, ['Carol'])), not(atom(creator, ['Carol', 'Alice'])),
        not(atom(guarded_by, ['Carol', '_'])), not(atom(friend, ['Carol', '_'])),
        not(atom(listed, ['Carol', '_', '_'])), not(atom(member, ['Carol', '_'])),
        not(atom(created, ['Alice', 'Carol'])), not(atom(parenting, ['Alice', 'Carol'])),
        forall('Bob', atom(guarded_by, ['Carol', 'Bob']), [not(atom(parenting, ['Bob', 'Carol']))]),
        forall('Dave', atom(friend, ['Carol', 'Dave']),
               [not(atom(friend, ['Dave', 'Carol'])), not(atom(listed, ['Dave', 'Carol', '_'])),
                not(atom(member, ['Dave', ext(own('Carol'), '_')]))])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(creator, ['Carol', 'Alice']),
        not(atom(retired, ['Carol'])),
        atom(identity, ['Alice']), atom(created, ['Alice', 'Carol']), atom(parenting, ['Alice', 'Carol']),
        not(atom(retired, ['Alice'])),
        forall('Bob', atom(guarded_by, ['Carol', 'Bob']),
               [atom(identity, ['Bob']), atom(parenting, ['Bob', 'Carol']), not(atom(created, ['Bob', 'Carol']))]),
        forall('Dave', atom(friend, ['Carol', 'Dave']), [atom(identity, ['Dave']), atom(friend, ['Dave', 'Carol'])])],
       true, ['Alice']),
%% CSSN:2, A child's acquaintances: Carol comes to know Bob by an act of Carol, Alice and Bob, provided Alice knows Bob.
    sas(child_acquaint, ['Carol', 'Bob', 'Alice'], [],
       [atom(knows, ['Carol', 'Bob']), atom(knows, ['Bob', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), not(atom(retired, ['Carol'])),
        atom(identity, ['Bob']), not(atom(child, ['Bob'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(knows, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Carol', 'Bob', 'Alice']),
%% CSSN:2: Carol and Dave come to know each other by an act of the four, provided Alice knows Dave and Bob, and Bob knows Carol and Alice; Alice and Bob possibly one person.
    sas(child_acquaint_2, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
       [atom(knows, ['Carol', 'Dave']), atom(knows, ['Dave', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), not(atom(retired, ['Carol'])),
        atom(identity, ['Dave']), atom(child, ['Dave']), not(atom(retired, ['Dave'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(knows, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(parenting, ['Bob', 'Dave']),
        atom(knows, ['Bob', 'Carol']), atom(knows, ['Bob', 'Alice']),
        not(atom(child, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% GnW:4: Carol and Dave, who know each other, become friends, provided each parent knows the other child and is a friend of the other parent, by an act of the four; Alice and Bob possibly one person.
    sas(child_befriend, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [],
       [atom(friend, ['Carol', 'Dave']), atom(friend, ['Dave', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(knows, ['Carol', 'Dave']),
        not(atom(friend, ['Carol', 'Dave'])), not(atom(retired, ['Carol'])),
        atom(identity, ['Dave']), atom(child, ['Dave']), atom(knows, ['Dave', 'Carol']),
        not(atom(friend, ['Dave', 'Carol'])), not(atom(retired, ['Dave'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(friend, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(parenting, ['Bob', 'Dave']),
        atom(knows, ['Bob', 'Carol']), atom(friend, ['Bob', 'Alice']),
        not(atom(child, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% GnW:3: Carol and Bob, who know each other, become friends, provided Alice is a friend of Bob, by an act of the three.
    sas(child_adult_befriend, ['Carol', 'Bob', 'Alice'], [],
       [atom(friend, ['Carol', 'Bob']), atom(friend, ['Bob', 'Carol'])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(knows, ['Carol', 'Bob']),
        not(atom(friend, ['Carol', 'Bob'])), not(atom(retired, ['Carol'])),
        atom(identity, ['Bob']), atom(knows, ['Bob', 'Carol']), not(atom(child, ['Bob'])),
        not(atom(friend, ['Bob', 'Carol'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Carol', 'Bob', 'Alice']),
%% GnW:3: Alice ends a friendship of Carol with Bob, other than a parent, every membership between the two ending with it.
    sas(child_unfriend, ['Carol', 'Bob', 'Alice'], [],
       [not(atom(friend, ['Carol', 'Bob'])), not(atom(listed, ['Carol', 'Bob', '_'])),
        not(atom(member, ['Carol', ext(own('Bob'), '_')])),
        not(atom(friend, ['Bob', 'Carol'])), not(atom(listed, ['Bob', 'Carol', '_'])),
        not(atom(member, ['Bob', ext(own('Carol'), '_')]))],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(friend, ['Carol', 'Bob']),
        atom(identity, ['Bob']), atom(friend, ['Bob', 'Carol']), not(atom(parenting, ['Bob', 'Carol'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Alice']),
%% GnW:3: Carol joins the group of Bob, her friend, provided Alice is a friend of Bob, by an act of the three.
    sas(child_join, ['Bob', 'Carol', 'Alice'], [n],
       [atom(listed, ['Bob', 'Carol', n]), atom(member, ['Carol', ext(own('Bob'), n)])],
       [atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Bob'), n)]), atom(friend, ['Bob', 'Carol']),
        not(atom(child, ['Bob'])), not(atom(retired, ['Bob'])),
        atom(identity, ['Carol']), atom(child, ['Carol']),
        not(atom(member, ['Carol', ext(own('Bob'), n)])), not(atom(retired, ['Carol'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']), atom(friend, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Bob', 'Carol', 'Alice']),
%% GnW:4 with CSSN:3: Dave joins the group of Carol, his friend, provided each parent knows the other child and is a friend of the other parent, by an act of the four; Alice and Bob possibly one person.
    sas(child_join_2, ['Carol', 'Dave', 'Alice', one('Bob', 'Alice')], [n],
       [atom(listed, ['Carol', 'Dave', n]), atom(member, ['Dave', ext(own('Carol'), n)])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(member, ['Carol', ext(own('Carol'), n)]),
        atom(friend, ['Carol', 'Dave']), not(atom(retired, ['Carol'])),
        atom(identity, ['Dave']), atom(child, ['Dave']),
        not(atom(member, ['Dave', ext(own('Carol'), n)])), not(atom(retired, ['Dave'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        atom(knows, ['Alice', 'Dave']), atom(friend, ['Alice', 'Bob']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        atom(identity, ['Bob']), atom(parenting, ['Bob', 'Dave']),
        atom(knows, ['Bob', 'Carol']), atom(friend, ['Bob', 'Alice']),
        not(atom(child, ['Bob'])), not(atom(retired, ['Bob']))],
       true, ['Carol', 'Dave', 'Alice', 'Bob']),
%% GnW:3: Alice ends Carol's membership of Bob's group.
    sas(child_leave, ['Bob', 'Carol', 'Alice'], [n],
       [not(atom(listed, ['Bob', 'Carol', n])), not(atom(member, ['Carol', ext(own('Bob'), n)]))],
       [atom(identity, ['Bob']), atom(listed, ['Bob', 'Carol', n]),
        atom(identity, ['Carol']), atom(child, ['Carol']), atom(member, ['Carol', ext(own('Bob'), n)]),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Alice']),
%% GnW:3: Alice closes the group Carol leads, ending the membership of every Bob Carol lists.
    sas(child_close, ['Carol', 'Alice', 'Bob'], [n],
       [atom(closed, ['Carol', n]), not(atom(listed, ['Carol', 'Carol', n])),
        not(atom(member, ['Carol', ext(own('Carol'), n)])),
        forall('Bob', atom(listed, ['Carol', 'Bob', n]),
               [not(atom(member, ['Bob', ext(own('Carol'), n)]))])],
       [atom(identity, ['Carol']), atom(child, ['Carol']), atom(member, ['Carol', ext(own('Carol'), n)]),
        atom(listed, ['Carol', 'Carol', n]),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice'])),
        forall('Bob', atom(listed, ['Carol', 'Bob', n]),
               [atom(identity, ['Bob']), atom(member, ['Bob', ext(own('Carol'), n)])])],
       true, ['Alice']),
%% CSSN:3, A child's group: Carol creates a group with the consent of Alice, a parent.
    sas(child_create, ['Carol', 'Alice'], [n],
       [atom(member, ['Carol', ext(own('Carol'), n)]), atom(listed, ['Carol', 'Carol', n])],
       [atom(identity, ['Carol']), atom(child, ['Carol']),
        not(atom(member, ['Carol', ext(own('Carol'), n)])), not(atom(closed, ['Carol', n])),
        not(atom(retired, ['Carol'])),
        atom(identity, ['Alice']), atom(parenting, ['Alice', 'Carol']),
        not(atom(child, ['Alice'])), not(atom(retired, ['Alice']))],
       true, ['Carol', 'Alice'])])).
