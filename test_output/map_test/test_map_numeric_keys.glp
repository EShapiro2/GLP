% Test 9: Numeric keys
% Verifies maps work with integer and mixed key types.

procedure test_int_key(_).
test_int_key(Result?) :-
    map_new(M0),
    map_put(M0?, 1, hello, M1),
    map_put(M1?, 2, world, M2),
    map_get(M2?, 1, Result).

procedure test_mixed_keys(_, _).
test_mixed_keys(R1?, R2?) :-
    map_new(M0),
    map_put(M0?, name, alice, M1),
    map_put(M1?, 42, answer, M2),
    lookup_mixed(M2?, name, 42, R1, R2).

procedure lookup_mixed(_?, _?, _?, _, _).
lookup_mixed(M, K1, K2, V1?, V2?) :-
    map_contains(M?, K1?) |
    _map_get(M?, K1?, V1),
    map_get(M?, K2?, V2).
