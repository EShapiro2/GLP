% Test 10: SRSW-compliant map threading
% Verifies the functional (immutable) threading pattern:
% each map variable (M0, M1, M2, M3) is written once and read once.

procedure test_thread(_).
test_thread(Result?) :-
    map_new(M0),
    map_put(M0?, x, 10, M1),
    map_put(M1?, y, 20, M2),
    map_put(M2?, z, 30, M3),
    map_get(M3?, z, Result).
