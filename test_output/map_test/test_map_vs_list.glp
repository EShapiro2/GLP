% Benchmark: Map O(1) lookup vs Association List O(n) scan
%
% Builds both a Dart HashMap and a GLP association list of size N,
% then performs K lookups on each. List lookup scans for key N
% (worst case: last element), map lookup uses the same key.

% ===== Map operations (built-in) =====

% Recursive map builder: keys N down to 1, value = N*10
procedure build_map(Number?, _?, _).
build_map(N, M, Final?) :-
    N? > 0 |
    V := N? * 10,
    map_put(M?, N?, V?, M1),
    N1 := N? - 1,
    build_map(N1?, M1?, Final).
build_map(N, M, M?) :-
    N? =:= 0 | true.

% Repeat map lookup K times (key is parameterized)
procedure repeat_map_get(Number?, _?, Number?, _).
repeat_map_get(K, M, Key, Done?) :-
    K? > 0, map_contains(M?, Key?) |
    _map_get(M?, Key?, _),
    K1 := K? - 1,
    repeat_map_get(K1?, M?, Key?, Done).
repeat_map_get(K, _, _, done) :-
    K? =:= 0 | true.

% ===== Association list operations =====

% Build assoc list: [kv(1, 10), kv(2, 20), ..., kv(N, N*10)]
procedure build_list(Number?, _?, _).
build_list(N, Acc, Final?) :-
    N? > 0 |
    V := N? * 10,
    N1 := N? - 1,
    build_list(N1?, [kv(N?, V?)|Acc?], Final).
build_list(N, Acc, Acc?) :-
    N? =:= 0 | true.

% Linear scan lookup: O(n) worst case
procedure list_lookup(_?, Number?, _).
list_lookup([kv(K, V)|_], Key, V?) :- K? =:= Key? | true.
list_lookup([_|Rest], Key, Val?) :- list_lookup(Rest?, Key?, Val).

% Repeat list lookup K times
procedure repeat_list_get(Number?, _?, Number?, _).
repeat_list_get(K, List, Key, Done?) :-
    K? > 0, ground(List?), ground(Key?) |
    list_lookup(List?, Key?, _),
    K1 := K? - 1,
    repeat_list_get(K1?, List?, Key?, Done).
repeat_list_get(K, _, _, done) :-
    K? =:= 0 | true.

% ===== Benchmark drivers =====

% Map: build + K lookups on key N (O(1) per lookup)
procedure bench_map(Number?, Number?, _).
bench_map(N, K, Done?) :-
    ground(N?) |
    map_new(M0),
    build_map(N?, M0?, Final),
    repeat_map_get(K?, Final?, N?, Done).

% List: build + K lookups on key N (O(n) per lookup — worst case, key N is last)
procedure bench_list(Number?, Number?, _).
bench_list(N, K, Done?) :-
    ground(N?) |
    build_list(N?, [], List),
    repeat_list_get(K?, List?, N?, Done).

% Build-only baselines (for subtracting build cost)
procedure build_map_only(Number?, _).
build_map_only(N, done) :-
    map_new(M0),
    build_map(N?, M0?, _).

procedure build_list_only(Number?, _).
build_list_only(N, done) :-
    build_list(N?, [], _).
