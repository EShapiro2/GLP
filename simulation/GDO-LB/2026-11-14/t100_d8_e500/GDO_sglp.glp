   clause(gd_choose5(nothing, var('_'), var('Kn'), var('Pt'), var('Act?')), [], [gd_idle(var('Kn?'), var('Pt?'), var('Act'))]),

   decl(gd_idle(dual('List'('Key')), dual('List'('Key')), 'GdAct')),
