:-
'>'(TX?, X?)
,
'>'('-'(TX?, X?), Bd?)
|
':='(X1, '+'(X?, Bd?))
.
gd_towards(X, TX, Bd, X1?, 0)
:-
'<'(TX?, X?)
,
'>'('-'(X?, TX?), Bd?)
|
':='(X1, '-'(X?, Bd?))
.
