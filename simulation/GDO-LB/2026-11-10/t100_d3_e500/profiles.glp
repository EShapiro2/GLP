%% person(eager)
%% binds(Request, eager_request)
%% binds(Approval, eager_approval)
exported procedure eager_request(Request, Person?, Integer?, MutualRef?).
eager_request(R?, person(Me, _, As), S, Scr)
:-
stream_append(seen(L), Scr?, _)
,
gd_menu(12, Me?, [], As?, L?, S?, slot(R), Scr?)
.
exported procedure eager_approval(Approval?, Person?, Integer?, MutualRef?).
eager_approval(approval(_, _, A?), _, _, _)
:-
gd_say(slot(A), yes)
.

%% person(lazy)
%% binds(Request, lazy_request)
%% binds(Approval, lazy_approval)
exported procedure lazy_request(Request, Person?, Integer?, MutualRef?).
lazy_request(R?, person(Me, _, As), S, Scr)
:-
stream_append(seen(L), Scr?, _)
,
gd_menu(3, Me?, [], As?, L?, S?, slot(R), Scr?)
.
exported procedure lazy_approval(Approval?, Person?, Integer?, MutualRef?).
lazy_approval(approval(_, _, A?), _, _, _)
:-
gd_say(slot(A), yes)
.
procedure gd_say(Slot(YesNo)?, YesNo?).
gd_say(slot(V?), V)
.
procedure gd_request(Slot(Request)?, Request?).
gd_request(slot(V?), V)
.
