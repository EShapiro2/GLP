procedure gd_towards(Integer?, Integer?, Integer?, Integer, Integer).
gd_towards(X, TX, Bd, TX?, Rem?)
:-
'=<'(abs('-'(TX?, X?)), Bd?)
|
':='(Rem, '-'(Bd?, abs('-'(TX?, X?))))
.
