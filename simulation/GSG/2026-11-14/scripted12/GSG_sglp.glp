%% GSG12_sglp.glp --- the sGLP source of the larger simulation of GSG (programs/sglp/gsg), in the
%% term form the transformation reads, for the canonical platform of GSG as recorded,
%% cascade/GSG/platform.glp, and twelve agents, keyed p01 to p12.  Printed by gen12.sh.
%%
%% Two circles of six, p01 Alice to p06 Frank and p07 Grace to p12 Leo, joined by one
%% acquaintance, Frank's and Grace's.  Each person meets its two neighbours in its circle
%% (GKK:2), introduces them to each other (GKK:3), and befriends its neighbours and those it
%% was introduced to (GSG:1).  Frank introduces Grace to Eve and to Alice, and Grace introduces
%% Frank to Heidi and to Leo, so friendships cross between the circles.  Alice, Dave, Ivan and
%% Leo each end one friendship at times (GSG:2).
%%
%% Two approval profiles: the agreeable person approves whatever it is asked; the choosy person
%% declines one request in three.  A friendship is made only by the act of both (GSG:1): the
%% proposal of one and the approval of the other.
%%
%%   person scripted.     Request =::= script_request.   one proposal drawn from the list, 2/hour
%%   person agreeable.    Approval =::= agree.           yes, 6/hour
%%   person choosy.       Approval =::= choose.          yes, yes or no, drawn, 6/hour
%%   run 12 agents [requests ~ (scripted : 1.0), approvals ~ (agreeable : 0.67, choosy : 0.33)]
%%       until 4 days seed 1.

exported procedure source(SglpTerms).
source([
   person(scripted),
   binds('Request', script_request),
   decl(script_request('Request', dual('Person'), dual('Integer'))),
   clause(script_request(var('R?'), person(p01, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 22, var('K'), var('_')), rated(act(var('K?'), p01, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p02, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 19, var('K'), var('_')), rated(act(var('K?'), p02, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p03, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 19, var('K'), var('_')), rated(act(var('K?'), p03, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p04, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 20, var('K'), var('_')), rated(act(var('K?'), p04, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p05, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 21, var('K'), var('_')), rated(act(var('K?'), p05, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p06, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 32, var('K'), var('_')), rated(act(var('K?'), p06, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p07, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 32, var('K'), var('_')), rated(act(var('K?'), p07, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p08, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 21, var('K'), var('_')), rated(act(var('K?'), p08, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p09, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 20, var('K'), var('_')), rated(act(var('K?'), p09, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p10, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 19, var('K'), var('_')), rated(act(var('K?'), p10, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p11, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 19, var('K'), var('_')), rated(act(var('K?'), p11, slot(var('R'))), rate(2, hour))]),
   clause(script_request(var('R?'), person(p12, var('_'), var('_')), var('S')), [],
          [random(var('S?'), 22, var('K'), var('_')), rated(act(var('K?'), p12, slot(var('R'))), rate(2, hour))]),
