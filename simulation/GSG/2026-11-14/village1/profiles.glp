gs_without([], _, [])
.
gs_without([X | Xs], Y, Zs?)
:-
'=?='(X?, Y?)
,
ground(Y?)
|
gs_without(Xs?, Y?, Zs)
.
gs_without([X | Xs], Y, [X? | Zs?])
:-
otherwise
,
ground(Y?)
|
gs_without(Xs?, Y?, Zs)
.
