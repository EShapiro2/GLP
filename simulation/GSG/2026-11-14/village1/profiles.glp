gs_app(Xs?, Ys?, Zs)
.
procedure gs_two(List(Key)?, Integer?, List(Key), Integer).
gs_two([], S, [], S?)
.
gs_two([X], S, [X?], S?)
.
gs_two([X, Y | Xs], S, Two?, S2?)
:-
ground(X?)
,
