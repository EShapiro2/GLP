.
procedure gs_mem(Key?, List(Key)?, YesNo).
gs_mem(_, [], no)
.
gs_mem(X, [Y | _], yes)
:-
'=?='(X?, Y?)
|
true
.
gs_mem(X, [_ | Ys], R?)
:-
otherwise
|
