.
procedure gs_pick(GsKeys1?, Integer?, Key, Integer).
gs_pick([X0 | Xs], S, X?, S1?)
:-
ground(X0?)
,
ground(Xs?)
|
gs_length(Xs?, N0)
,
':='(N, '+'(N0?, 1))
,
random(S?, N?, K, S1)
,
gs_nth(K?, X0?, Xs?, X)
.
procedure gs_length(List(Key)?, Integer).
gs_length([], 0)
.
gs_length([_ | Xs], N?)
:-
gs_length(Xs?, N1)
,
':='(N, '+'(N1?, 1))
.
procedure gs_nth(Integer?, Key?, List(Key)?, Key).
gs_nth(1, X0, _, X0?)
.
gs_nth(K, _, [X1 | Xs], X?)
:-
'>'(K?, 1)
|
':='(K1, '-'(K?, 1))
,
gs_nth(K1?, X1?, Xs?, X)
.
gs_nth(K, X0, [], X0?)
:-
'>'(K?, 1)
|
true
.
