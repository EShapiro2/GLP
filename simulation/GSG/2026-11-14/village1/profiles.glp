%% Printed by programs/sglp/transform.glp from the sGLP source in the term form
%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(given, cva_profiles)

GsFam ::= fam(Integer, List(Key), List(Key)).

GsAttr ::= village(Integer) ; household(List(Key)) ; knows(List(Key)) ; families(List(GsFam)).

Person ::= person(Key, Constant, List(GsAttr)).

GsKeys ::= ks(Key, Key).

GsPick ::= pick(Key) ; nothing.

GsKeys1 ::= [Key | List(Key)].

GsTodo ::= establish ; acquaint(Key) ; steady.

GsPair ::= acq(Key, Key).
exported procedure gs_villages1(Integer?, List(Person)).
gs_villages1(S, Ps?)
:-
gs_keys(Ks)
,
gs_census(Ks?, S?, Ps)
.
procedure gs_draw(List(GsKeys)?, Integer?, Integer?, Integer?, List(GsFam), Integer).
gs_draw([], _, _, S, [], S?)
.
gs_draw([ks(P1, P2) | Ks], V, F, S, [fam(V?, Pa?, []) | Fs?], S2?)
:-
ground(V?)
|
random(S?, 100, K1, S1)
,
gs_parents(K1?, P1?, P2?, Pa)
,
gs_next(V?, F?, V1, F1)
,
gs_draw(Ks?, V1?, F1?, S1?, Fs, S2)
.
procedure gs_persons(List(GsFam)?, List(GsFam)?, List(GsPair)?, List(Person)).
gs_persons([], _, _, [])
.
gs_persons([fam(V, Pa, _) | Fs], All, Pairs, Ps?)
:-
ground(V?)
,
ground(Pa?)
,
ground(All?)
,
ground(Pairs?)
|
gs_adult_persons(Pa?, V?, Pa?, All?, Pairs?, Ps1)
,
gs_persons(Fs?, All?, Pairs?, Ps2)
,
gs_app_persons(Ps1?, Ps2?, Ps)
.
procedure gs_adult_persons(List(Key)?, Integer?, List(Key)?, List(GsFam)?, List(GsPair)?, List(Person)).
gs_adult_persons([], _, _, _, _, [])
.
gs_adult_persons([P | Pa], V, Pa0, All, Pairs, [person(P?, adult, [village(V?), household(Pa0?), knows(Kn?), families(All?)]) | Ps?])
:-
ground(P?)
,
ground(V?)
,
ground(Pa0?)
,
ground(All?)
,
ground(Pairs?)
|
gs_village_parents(All?, V?, P?, Vp)
,
gs_acq_of(P?, Pairs?, Ac)
,
gs_app(Vp?, Ac?, Kn)
,
gs_adult_persons(Pa?, V?, Pa0?, All?, Pairs?, Ps)
.
procedure gs_last_view(List(Output)?, List(Atom)).
gs_last_view([], [])
.
gs_last_view([view(_, As, _, _, _) | _], As?)
.
gs_last_view([_ | L], As?)
:-
otherwise
|
gs_last_view(L?, As)
.
procedure gs_census(List(GsKeys)?, Integer?, List(Person)).
gs_census(Ks, S, Ps?)
:-
gs_draw(Ks?, 1, 1, S?, Fs, S1)
,
gs_persons_all(Fs?, S1?, Ps)
.
procedure gs_persons_all(List(GsFam)?, Integer?, List(Person)).
gs_persons_all(Fs, S, Ps?)
:-
ground(Fs?)
|
gs_acq(Fs?, Fs?, S?, Pairs)
,
gs_persons_pairs(Fs?, Pairs?, Ps)
.
procedure gs_persons_pairs(List(GsFam)?, List(GsPair)?, List(Person)).
gs_persons_pairs(Fs, Pairs, Ps?)
:-
ground(Fs?)
,
ground(Pairs?)
|
gs_persons(Fs?, Fs?, Pairs?, Ps)
.
procedure gs_acq(List(GsFam)?, List(GsFam)?, Integer?, List(GsPair)).
gs_acq([], _, _, [])
.
gs_acq([fam(V, Pa, _) | Fs], All, S, Pairs?)
:-
ground(V?)
,
ground(All?)
|
gs_other_parents(All?, V?, Op)
,
gs_acq_parents(Pa?, Op?, S?, Pairs1, S1)
,
gs_acq(Fs?, All?, S1?, Pairs2)
,
gs_app_pairs(Pairs1?, Pairs2?, Pairs)
.
procedure gs_acq_parents(List(Key)?, List(Key)?, Integer?, List(GsPair), Integer).
gs_acq_parents([], _, S, [], S?)
.
gs_acq_parents([P | Pa], Op, S, Pairs?, S2?)
:-
ground(P?)
,
ground(Op?)
|
gs_two(Op?, S?, Ac, S1)
,
