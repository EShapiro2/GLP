.
procedure gs_first_missing1(YesNo?, Key?, List(Key)?, List(Key)?, GsPick).
gs_first_missing1(no, X, _, _, pick(X?))
.
gs_first_missing1(yes, _, Xs, Ks, P?)
:-
gs_first_missing(Xs?, Ks?, P)
.
procedure gs_pick_or_nothing(List(Key)?, Integer?, GsPick).
gs_pick_or_nothing([], _, nothing)
.
gs_pick_or_nothing([X | Xs], S, pick(Q?))
:-
gs_pick([X? | Xs?], S?, Q, _)
.
procedure gs_has_identity(List(Atom)?, YesNo).
gs_has_identity([], no)
.
gs_has_identity([identity | _], yes)
.
gs_has_identity([_ | As], R?)
:-
otherwise
|
gs_has_identity(As?, R)
.
procedure gs_knows_atoms(List(Atom)?, List(Key)).
gs_knows_atoms([], [])
.
gs_knows_atoms([knows(Q) | As], [Q? | Qs?])
:-
gs_knows_atoms(As?, Qs)
.
gs_knows_atoms([_ | As], Qs?)
:-
otherwise
|
gs_knows_atoms(As?, Qs)
.
procedure gs_request(Token?, Slot(Request)?, Request?).
gs_request(stop, _, _)
.
gs_request(go(_), slot(V?), V)
.
procedure gs_offer(Integer?, Key?, List(Key)?, List(GsAttr)?, List(Atom)?, Integer?, Slot(Request)?).
gs_offer(Local, Me, Ks, As, Atoms, S, slot(W?))
:-
ground(Me?)
,
ground(Ks?)
,
ground(As?)
|
gs_attr_families(As?, All)
,
gs_attr_village(As?, V)
,
gs_friends(Atoms?, Fr)
,
gs_cands(All?, V?, Me?, Ks?, Fr?, Vc, Oc)
,
random(S?, 100, D, S1)
,
gs_offer_from(D?, Local?, Vc?, Oc?, Me?, Ks?, S1?, slot(W))
.
procedure gs_cands(List(GsFam)?, Integer?, Key?, List(Key)?, List(Key)?, List(Key), List(Key)).
gs_cands(All, V, Me, Ks, Fr, Vc?, Oc?)
:-
ground(All?)
,
ground(V?)
,
ground(Ks?)
,
ground(Fr?)
|
gs_village_parents(All?, V?, Me?, Vp)
,
gs_other_parents(All?, V?, Op)
,
gs_inter(Vp?, Ks?, Vk)
,
gs_minus(Vk?, Fr?, Vc)
,
gs_inter(Op?, Ks?, Ok)
,
gs_minus(Ok?, Fr?, Oc)
.
procedure gs_offer_from(Integer?, Integer?, List(Key)?, List(Key)?, Key?, List(Key)?, Integer?, Slot(Request)?).
gs_offer_from(D, Local, Vc, Oc, Me, Ks, S, slot(W?))
:-
'=<'(D?, Local?)
|
gs_offer_to(Vc?, Oc?, Me?, Ks?, S?, slot(W))
.
gs_offer_from(D, Local, Vc, Oc, Me, Ks, S, slot(W?))
:-
'>'(D?, Local?)
|
gs_offer_to(Oc?, Vc?, Me?, Ks?, S?, slot(W))
.
procedure gs_offer_to(List(Key)?, List(Key)?, Key?, List(Key)?, Integer?, Slot(Request)?).
gs_offer_to([X | Xs], _, Me, _, S, slot(propose(befriend(Me?, Q?))))
:-
gs_pick([X? | Xs?], S?, Q, _)
.
gs_offer_to([], [X | Xs], Me, _, S, slot(propose(befriend(Me?, Q?))))
:-
gs_pick([X? | Xs?], S?, Q, _)
.
gs_offer_to([], [], Me, _, _, slot(propose(establish(Me?))))
.
procedure gs_introduce(Integer?, Key?, List(Key)?, List(GsAttr)?, List(Atom)?, Integer?, Slot(Request)?).
gs_introduce(Local, Me, Ks, As, Atoms, S, slot(W?))
:-
ground(As?)
,
ground(Atoms?)
,
ground(Me?)
|
gs_friends(Atoms?, Fr)
,
gs_attr_families(As?, All)
,
gs_all_parents(All?, Ap)
,
gs_inter(Fr?, Ap?, Fp)
,
gs_without(Fp?, Me?, Fq)
,
gs_two(Fq?, S?, Two, S1)
,
gs_introduce1(Two?, Local?, Me?, Ks?, As?, Atoms?, S1?, slot(W))
.
procedure gs_introduce1(List(Key)?, Integer?, Key?, List(Key)?, List(GsAttr)?, List(Atom)?, Integer?, Slot(Request)?).
gs_introduce1([Q, C], _, Me, _, _, _, _, slot(propose(introduce(Me?, Q?, C?))))
.
gs_introduce1(_, Local, Me, Ks, As, Atoms, S, slot(W?))
:-
otherwise
|
gs_offer(Local?, Me?, Ks?, As?, Atoms?, S?, slot(W))
.
procedure gs_end_friendship1(GsPick?, Integer?, Key?, List(Key)?, List(GsAttr)?, List(Atom)?, Integer?, Slot(Request)?).
gs_end_friendship1(pick(Q), _, Me, _, _, _, _, slot(propose(unfriend(Me?, Q?))))
.
gs_end_friendship1(nothing, Local, Me, Ks, As, Atoms, S, slot(W?))
:-
gs_offer(Local?, Me?, Ks?, As?, Atoms?, S?, slot(W))
.
procedure gs_say(Slot(YesNo)?, YesNo?).
gs_say(slot(V?), V)
.
procedure gs_yes_if(Integer?, Integer?, YesNo).
gs_yes_if(K, P, yes)
:-
'=<'(K?, P?)
|
true
.
gs_yes_if(K, P, no)
:-
'>'(K?, P?)
|
true
.

%% person(local)
%% binds(Request, local_request)
exported procedure local_request(Request, Person?, Integer?, MutualRef?).
local_request(R?, person(Me, _, As), S, Scr)
:-
stream_append(seen(L), Scr?, _)
,
gs_menu(95, Me?, As?, L?, S?, slot(R))
.

%% person(open)
%% binds(Request, open_request)
exported procedure open_request(Request, Person?, Integer?, MutualRef?).
open_request(R?, person(Me, _, As), S, Scr)
:-
stream_append(seen(L), Scr?, _)
,
gs_menu(60, Me?, As?, L?, S?, slot(R))
.
procedure gs_menu(Integer?, Key?, List(GsAttr)?, List(Output)?, Integer?, Slot(Request)?).
gs_menu(Local, Me, As, L, S, slot(W?))
:-
gs_last_view(L?, Atoms)
,
gs_menu1(Atoms?, Local?, Me?, As?, S?, slot(W))
.
procedure gs_menu1(List(Atom)?, Integer?, Key?, List(GsAttr)?, Integer?, Slot(Request)?).
gs_menu1(Atoms, Local, Me, As, S, slot(W?))
:-
ground(Atoms?)
,
ground(As?)
,
ground(Me?)
|
gs_has_identity(Atoms?, Id)
,
gs_attr_knows(As?, Kn)
,
gs_knows_atoms(Atoms?, Kw)
,
gs_knows_atoms(Atoms?, Ks)
,
gs_first_missing(Kn?, Kw?, Q)
,
gs_todo(Id?, Q?, T)
,
gs_do(T?, Local?, Me?, Ks?, As?, Atoms?, S?, slot(W))
.
procedure gs_todo(YesNo?, GsPick?, GsTodo).
gs_todo(no, _, establish)
.
gs_todo(yes, pick(Q), acquaint(Q?))
.
gs_todo(yes, nothing, steady)
.
procedure gs_do(GsTodo?, Integer?, Key?, List(Key)?, List(GsAttr)?, List(Atom)?, Integer?, Slot(Request)?).
gs_do(establish, _, Me, _, _, _, _, slot(W?))
:-
rated(0.0022222222222222222, Tok)
,
gs_request(Tok?, slot(W), propose(establish(Me?)))
.
gs_do(acquaint(Q), _, Me, _, _, _, _, slot(W?))
:-
rated(0.0022222222222222222, Tok)
,
gs_request(Tok?, slot(W), propose(acquaint(Me?, Q?)))
.
gs_do(steady, Local, Me, Ks, As, Atoms, S, slot(W?))
:-
random(S?, 52, K, S1)
,
rated(0.0005555555555555556, Tok)
,
gs_act(Tok?, K?, Local?, Me?, Ks?, As?, Atoms?, S1?, slot(W))
.
procedure gs_act(Token?, Integer?, Integer?, Key?, List(Key)?, List(GsAttr)?, List(Atom)?, Integer?, Slot(Request)?).
gs_act(stop, _, _, _, _, _, _, _, _)
.
gs_act(go(_), K, Local, Me, Ks, As, Atoms, S, slot(W?))
:-
'=<'(K?, 45)
|
gs_offer(Local?, Me?, Ks?, As?, Atoms?, S?, slot(W))
.
gs_act(go(_), K, Local, Me, Ks, As, Atoms, S, slot(W?))
:-
'>'(K?, 45)
,
'=<'(K?, 51)
|
gs_introduce(Local?, Me?, Ks?, As?, Atoms?, S?, slot(W))
.
gs_act(go(_), 52, Local, Me, Ks, As, Atoms, S, slot(W?))
:-
gs_end_friendship(Local?, Me?, Ks?, As?, Atoms?, S?, slot(W))
.
procedure gs_end_friendship(Integer?, Key?, List(Key)?, List(GsAttr)?, List(Atom)?, Integer?, Slot(Request)?).
gs_end_friendship(Local, Me, Ks, As, Atoms, S, slot(W?))
:-
ground(Me?)
,
ground(Atoms?)
|
gs_friends(Atoms?, Fr)
,
random(S?, 2147483646, S1, S2)
,
gs_pick_or_nothing(Fr?, S1?, Q)
,
gs_end_friendship1(Q?, Local?, Me?, Ks?, As?, Atoms?, S2?, slot(W))
.

%% person(keen)
%% binds(Approval, keen_approval)
exported procedure keen_approval(Approval?, Person?, Integer?, MutualRef?).
keen_approval(approval(hello(_, _), _, A?), _, _, _)
:-
gs_say(slot(A), yes)
.
keen_approval(approval(attempt(_, _, _, acquaint(_, _), _), _, A?), _, _, _)
:-
gs_say(slot(A), yes)
.
keen_approval(approval(attempt(_, _, _, introduce(_, _, _), _), _, A?), _, _, _)
:-
gs_say(slot(A), yes)
.
keen_approval(approval(attempt(_, _, _, C, _), _, A?), _, S, _)
:-
otherwise
|
rated(0.0005555555555555556, Tok)
,
gs_answer(Tok?, 90, C?, S?, slot(A))
.

%% person(choosy)
%% binds(Approval, choosy_approval)
exported procedure choosy_approval(Approval?, Person?, Integer?, MutualRef?).
choosy_approval(approval(hello(_, _), _, A?), _, _, _)
:-
gs_say(slot(A), yes)
.
choosy_approval(approval(attempt(_, _, _, acquaint(_, _), _), _, A?), _, _, _)
:-
gs_say(slot(A), yes)
.
choosy_approval(approval(attempt(_, _, _, introduce(_, _, _), _), _, A?), _, _, _)
:-
gs_say(slot(A), yes)
.
choosy_approval(approval(attempt(_, _, _, C, _), _, A?), _, S, _)
:-
otherwise
|
rated(0.0005555555555555556, Tok)
,
gs_answer(Tok?, 50, C?, S?, slot(A))
.
procedure gs_answer(Token?, Integer?, Class?, Integer?, Slot(YesNo)?).
gs_answer(stop, _, _, _, _)
.
gs_answer(go(_), P, befriend(_, _), S, slot(A?))
:-
random(S?, 100, K, _)
,
gs_yes_if(K?, P?, A)
.
gs_answer(go(_), _, _, _, slot(yes))
:-
otherwise
|
true
.
