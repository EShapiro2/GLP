,
gs_app_pairs(Pairs1?, Pairs2?, Pairs)
.
procedure gs_pairs_of(Key?, List(Key)?, List(GsPair)).
gs_pairs_of(_, [], [])
.
gs_pairs_of(P, [A | As], [acq(P?, A?) | Pairs?])
:-
ground(P?)
|
gs_pairs_of(P?, As?, Pairs)
.
procedure gs_app_pairs(List(GsPair)?, List(GsPair)?, List(GsPair)).
gs_app_pairs([], Ys, Ys?)
.
gs_app_pairs([X | Xs], Ys, [X? | Zs?])
:-
gs_app_pairs(Xs?, Ys?, Zs)
.
procedure gs_acq_of(Key?, List(GsPair)?, List(Key)).
gs_acq_of(_, [], [])
.
gs_acq_of(P, [acq(P1, A) | Pairs], [A? | Ac?])
:-
'=?='(P?, P1?)
,
ground(P?)
|
gs_acq_of(P?, Pairs?, Ac)
.
gs_acq_of(P, [acq(B, P2) | Pairs], [B? | Ac?])
:-
'=?='(P?, P2?)
,
ground(P?)
|
gs_acq_of(P?, Pairs?, Ac)
.
gs_acq_of(P, [_ | Pairs], Ac?)
:-
otherwise
|
gs_acq_of(P?, Pairs?, Ac)
.
procedure gs_parents(Integer?, Key?, Key?, List(Key)).
gs_parents(K, P1, P2, [P1?, P2?])
:-
'=<'(K?, 70)
|
true
.
