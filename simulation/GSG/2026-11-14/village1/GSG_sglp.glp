%% ---------------------------------------------------------------------------
%% The sGLP source of GSG's village simulation (programs/sglp/gsg), printed by
%% genV.sh 1 1 1 0.5 0.5, in the term form the transformation reads, over the
%% canonical platform of GSG as recorded, cascade/GSG/platform.glp and interface.glp.
%%
%% It is CSSN's simulation of the social graph (programs/sglp/cssn/CSSN_sglp.glp; CSSN,
%% Section 5) without the children.  The census: villages of ten households, a household of
%% two adults 70 times in 100 and one otherwise; an adult knows at the start the adults of
%% their own village and two adults of other villages, their acquaintances, acquaintance
%% being mutual.  The menu, the approach of an adult, local or open: an adult first
%% establishes their identity, then comes to know each adult they know from outside the app,
%% one per menu (acquaint, GKK:2); each of these after seven or eight minutes on average.  Then
%% the adult answers the menu twice an hour on average: 45 in 52 an offer of friendship
%% (befriend, GSG:1) to an adult they know who is not yet a friend, of their own village 95
%% times in 100 for a local adult and 60 for an open one, uniformly from the list; 6 in 52
%% introducing a friend to another friend (introduce, GKK:3), the two drawn uniformly; and 1
%% in 52 ending a friendship (unfriend, GSG:2), the friend drawn uniformly; each falling back
%% to an offer where it has no one to act on, and an offer to a proposal the platform refuses,
%% establish, where there is no one to offer to.  The policy of an adult, keen or choosy: a meeting
%% and an introduction approved at once; an offer of friendship approved 90 times in 100 by a
%% keen adult and 50 by a choosy one, after half an hour on average; anything else approved.
%% CSSN's rates are a year's; these are a day's, so that a run of a day or two shows what
%% CSSN's year shows.
%%
%%   run gs_villages1 [ approach of adult ~ (local : 0.5 ; open : 0.5),
%%                     policy of adult ~ (keen : 0.5 ; choosy : 0.5) ]
%%       until 1 days seed 1.
%% ---------------------------------------------------------------------------

exported procedure source(SglpTerms).
source([
   type('GsFam', [fam('Integer', 'List'('Key'), 'List'('Key'))]),
   type('GsAttr', [village('Integer'), household('List'('Key')), knows('List'('Key')), families('List'('GsFam'))]),
   type('Person', [person('Key', 'Constant', 'List'('GsAttr'))]),
   type('GsKeys', [ks('Key', 'Key')]),
   type('GsPick', [pick('Key'), nothing]),
   type('GsKeys1', [['Key' | 'List'('Key')]]),
   type('GsTodo', [establish, acquaint('Key'), steady]),
   type('GsPair', [acq('Key', 'Key')]),

   %% THE CENSUS.
   decl(gs_villages1(dual('Integer'), 'List'('Person'))),
   clause(gs_villages1(var('S'), var('Ps?')), [], [gs_keys(var('Ks')), gs_census(var('Ks?'), var('S?'), var('Ps'))]),
   %% gs_draw(Ks?, V?, F?, S?, Fs, S1): the households, from the key table, ten to a village; a household has no children.
   decl(gs_draw(dual('List'('GsKeys')), dual('Integer'), dual('Integer'), dual('Integer'), 'List'('GsFam'), 'Integer')),
   clause(gs_draw([], var('_'), var('_'), var('S'), [], var('S?')), [], []),
   clause(gs_draw([ks(var('P1'), var('P2')) | var('Ks')], var('V'), var('F'), var('S'), [fam(var('V?'), var('Pa?'), []) | var('Fs?')], var('S2?')), [ground(var('V?'))], [random(var('S?'), 100, var('K1'), var('S1')), gs_parents(var('K1?'), var('P1?'), var('P2?'), var('Pa')), gs_next(var('V?'), var('F?'), var('V1'), var('F1')), gs_draw(var('Ks?'), var('V1?'), var('F1?'), var('S1?'), var('Fs'), var('S2'))]),
   %% gs_persons(Fs?, All?, Pairs?, Ps): the adults of the households Fs.
   decl(gs_persons(dual('List'('GsFam')), dual('List'('GsFam')), dual('List'('GsPair')), 'List'('Person'))),
   clause(gs_persons([], var('_'), var('_'), []), [], []),
   clause(gs_persons([fam(var('V'), var('Pa'), var('_')) | var('Fs')], var('All'), var('Pairs'), var('Ps?')), [ground(var('V?')), ground(var('Pa?')), ground(var('All?')), ground(var('Pairs?'))], [gs_adult_persons(var('Pa?'), var('V?'), var('Pa?'), var('All?'), var('Pairs?'), var('Ps1')), gs_persons(var('Fs?'), var('All?'), var('Pairs?'), var('Ps2')), gs_app_persons(var('Ps1?'), var('Ps2?'), var('Ps'))]),
   decl(gs_adult_persons(dual('List'('Key')), dual('Integer'), dual('List'('Key')), dual('List'('GsFam')), dual('List'('GsPair')), 'List'('Person'))),
   clause(gs_adult_persons([], var('_'), var('_'), var('_'), var('_'), []), [], []),
   clause(gs_adult_persons([var('P') | var('Pa')], var('V'), var('Pa0'), var('All'), var('Pairs'), [person(var('P?'), adult, [village(var('V?')), household(var('Pa0?')), knows(var('Kn?')), families(var('All?'))]) | var('Ps?')]), [ground(var('P?')), ground(var('V?')), ground(var('Pa0?')), ground(var('All?')), ground(var('Pairs?'))], [gs_village_parents(var('All?'), var('V?'), var('P?'), var('Vp')), gs_acq_of(var('P?'), var('Pairs?'), var('Ac')), gs_app(var('Vp?'), var('Ac?'), var('Kn')), gs_adult_persons(var('Pa?'), var('V?'), var('Pa0?'), var('All?'), var('Pairs?'), var('Ps'))]),
   %% gs_last_view(L?, Atoms): the atoms of the last view seen, [] where none was shown; GSG's view names its key first.
   decl(gs_last_view(dual('List'('Output')), 'List'('Atom'))),
   clause(gs_last_view([], []), [], []),
   clause(gs_last_view([view(var('_'), var('As'), var('_'), var('_'), var('_')) | var('_')], var('As?')), [], []),
   clause(gs_last_view([var('_') | var('L')], var('As?')), [otherwise], [gs_last_view(var('L?'), var('As'))]),

   %% CSSN's helpers, as they stand.
   decl(gs_census(dual('List'('GsKeys')), dual('Integer'), 'List'('Person'))),
   clause(gs_census(var('Ks'), var('S'), var('Ps?')), [], [gs_draw(var('Ks?'), 1, 1, var('S?'), var('Fs'), var('S1')), gs_persons_all(var('Fs?'), var('S1?'), var('Ps'))]),
   decl(gs_persons_all(dual('List'('GsFam')), dual('Integer'), 'List'('Person'))),
   clause(gs_persons_all(var('Fs'), var('S'), var('Ps?')), [ground(var('Fs?'))], [gs_acq(var('Fs?'), var('Fs?'), var('S?'), var('Pairs')), gs_persons_pairs(var('Fs?'), var('Pairs?'), var('Ps'))]),
   decl(gs_persons_pairs(dual('List'('GsFam')), dual('List'('GsPair')), 'List'('Person'))),
   clause(gs_persons_pairs(var('Fs'), var('Pairs'), var('Ps?')), [ground(var('Fs?')), ground(var('Pairs?'))], [gs_persons(var('Fs?'), var('Fs?'), var('Pairs?'), var('Ps'))]),
   decl(gs_acq(dual('List'('GsFam')), dual('List'('GsFam')), dual('Integer'), 'List'('GsPair'))),
   clause(gs_acq([], var('_'), var('_'), []), [], []),
   clause(gs_acq([fam(var('V'), var('Pa'), var('_')) | var('Fs')], var('All'), var('S'), var('Pairs?')), [ground(var('V?')), ground(var('All?'))], [gs_other_parents(var('All?'), var('V?'), var('Op')), gs_acq_parents(var('Pa?'), var('Op?'), var('S?'), var('Pairs1'), var('S1')), gs_acq(var('Fs?'), var('All?'), var('S1?'), var('Pairs2')), gs_app_pairs(var('Pairs1?'), var('Pairs2?'), var('Pairs'))]),
   decl(gs_acq_parents(dual('List'('Key')), dual('List'('Key')), dual('Integer'), 'List'('GsPair'), 'Integer')),
   clause(gs_acq_parents([], var('_'), var('S'), [], var('S?')), [], []),
   clause(gs_acq_parents([var('P') | var('Pa')], var('Op'), var('S'), var('Pairs?'), var('S2?')), [ground(var('P?')), ground(var('Op?'))], [gs_two(var('Op?'), var('S?'), var('Ac'), var('S1')), gs_pairs_of(var('P?'), var('Ac?'), var('Pairs1')), gs_acq_parents(var('Pa?'), var('Op?'), var('S1?'), var('Pairs2'), var('S2')), gs_app_pairs(var('Pairs1?'), var('Pairs2?'), var('Pairs'))]),
   decl(gs_pairs_of(dual('Key'), dual('List'('Key')), 'List'('GsPair'))),
   clause(gs_pairs_of(var('_'), [], []), [], []),
   clause(gs_pairs_of(var('P'), [var('A') | var('As')], [acq(var('P?'), var('A?')) | var('Pairs?')]), [ground(var('P?'))], [gs_pairs_of(var('P?'), var('As?'), var('Pairs'))]),
   decl(gs_app_pairs(dual('List'('GsPair')), dual('List'('GsPair')), 'List'('GsPair'))),
   clause(gs_app_pairs([], var('Ys'), var('Ys?')), [], []),
   clause(gs_app_pairs([var('X') | var('Xs')], var('Ys'), [var('X?') | var('Zs?')]), [], [gs_app_pairs(var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(gs_acq_of(dual('Key'), dual('List'('GsPair')), 'List'('Key'))),
   clause(gs_acq_of(var('_'), [], []), [], []),
   clause(gs_acq_of(var('P'), [acq(var('P1'), var('A')) | var('Pairs')], [var('A?') | var('Ac?')]), ['=?='(var('P?'), var('P1?')), ground(var('P?'))], [gs_acq_of(var('P?'), var('Pairs?'), var('Ac'))]),
   clause(gs_acq_of(var('P'), [acq(var('B'), var('P2')) | var('Pairs')], [var('B?') | var('Ac?')]), ['=?='(var('P?'), var('P2?')), ground(var('P?'))], [gs_acq_of(var('P?'), var('Pairs?'), var('Ac'))]),
   clause(gs_acq_of(var('P'), [var('_') | var('Pairs')], var('Ac?')), [otherwise], [gs_acq_of(var('P?'), var('Pairs?'), var('Ac'))]),
   decl(gs_parents(dual('Integer'), dual('Key'), dual('Key'), 'List'('Key'))),
   clause(gs_parents(var('K'), var('P1'), var('P2'), [var('P1?'), var('P2?')]), ['=<'(var('K?'), 70)], [true]),
   clause(gs_parents(var('K'), var('P1'), var('_'), [var('P1?')]), ['>'(var('K?'), 70)], [true]),
   decl(gs_next(dual('Integer'), dual('Integer'), 'Integer', 'Integer')),
   clause(gs_next(var('V'), 10, var('V1?'), 1), [], [':='(var('V1'), '+'(var('V?'), 1))]),
   clause(gs_next(var('V'), var('F'), var('V?'), var('F1?')), ['<'(var('F?'), 10)], [':='(var('F1'), '+'(var('F?'), 1))]),
   decl(gs_app_persons(dual('List'('Person')), dual('List'('Person')), 'List'('Person'))),
   clause(gs_app_persons([], var('Ys'), var('Ys?')), [], []),
   clause(gs_app_persons([var('X') | var('Xs')], var('Ys'), [var('X?') | var('Zs?')]), [], [gs_app_persons(var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(gs_village_parents(dual('List'('GsFam')), dual('Integer'), dual('Key'), 'List'('Key'))),
   clause(gs_village_parents([], var('_'), var('_'), []), [], []),
   clause(gs_village_parents([fam(var('V'), var('Pa'), var('_')) | var('Fs')], var('V0'), var('Me'), var('Vp?')), ['=?='(var('V?'), var('V0?')), ground(var('V0?')), ground(var('Me?'))], [gs_without(var('Pa?'), var('Me?'), var('Pa1')), gs_village_parents(var('Fs?'), var('V0?'), var('Me?'), var('Vp1')), gs_app(var('Pa1?'), var('Vp1?'), var('Vp'))]),
   clause(gs_village_parents([fam(var('_'), var('_'), var('_')) | var('Fs')], var('V0'), var('Me'), var('Vp?')), [otherwise], [gs_village_parents(var('Fs?'), var('V0?'), var('Me?'), var('Vp'))]),
   decl(gs_other_parents(dual('List'('GsFam')), dual('Integer'), 'List'('Key'))),
   clause(gs_other_parents([], var('_'), []), [], []),
   clause(gs_other_parents([fam(var('V'), var('_'), var('_')) | var('Fs')], var('V0'), var('Op?')), ['=?='(var('V?'), var('V0?')), ground(var('V0?'))], [gs_other_parents(var('Fs?'), var('V0?'), var('Op'))]),
   clause(gs_other_parents([fam(var('_'), var('Pa'), var('_')) | var('Fs')], var('V0'), var('Op?')), [otherwise], [gs_other_parents(var('Fs?'), var('V0?'), var('Op1')), gs_app(var('Pa?'), var('Op1?'), var('Op'))]),
   decl(gs_app(dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(gs_app([], var('Ys'), var('Ys?')), [], []),
   clause(gs_app([var('X') | var('Xs')], var('Ys'), [var('X?') | var('Zs?')]), [], [gs_app(var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(gs_two(dual('List'('Key')), dual('Integer'), 'List'('Key'), 'Integer')),
   clause(gs_two([], var('S'), [], var('S?')), [], []),
   clause(gs_two([var('X')], var('S'), [var('X?')], var('S?')), [], []),
   clause(gs_two([var('X'), var('Y') | var('Xs')], var('S'), var('Two?'), var('S2?')), [ground(var('X?')), ground(var('Y?')), ground(var('Xs?'))], [gs_pick([var('X?'), var('Y?') | var('Xs?')], var('S?'), var('A'), var('S1')), gs_two1(var('A?'), [var('X?'), var('Y?') | var('Xs?')], var('S1?'), var('Two'), var('S2'))]),
   decl(gs_two1(dual('Key'), dual('List'('Key')), dual('Integer'), 'List'('Key'), 'Integer')),
   clause(gs_two1(var('A'), var('Xs'), var('S'), var('Two?'), var('S1?')), [ground(var('A?'))], [gs_without(var('Xs?'), var('A?'), var('Rest')), gs_two2(var('Rest?'), var('A?'), var('S?'), var('Two'), var('S1'))]),
   decl(gs_two2(dual('List'('Key')), dual('Key'), dual('Integer'), 'List'('Key'), 'Integer')),
   clause(gs_two2([], var('A'), var('S'), [var('A?')], var('S?')), [], []),
   clause(gs_two2([var('X') | var('Xs')], var('A'), var('S'), [var('A?'), var('B?')], var('S1?')), [], [gs_pick([var('X?') | var('Xs?')], var('S?'), var('B'), var('S1'))]),
   decl(gs_pick(dual('GsKeys1'), dual('Integer'), 'Key', 'Integer')),
   clause(gs_pick([var('X0') | var('Xs')], var('S'), var('X?'), var('S1?')), [ground(var('X0?')), ground(var('Xs?'))], [gs_length(var('Xs?'), var('N0')), ':='(var('N'), '+'(var('N0?'), 1)), random(var('S?'), var('N?'), var('K'), var('S1')), gs_nth(var('K?'), var('X0?'), var('Xs?'), var('X'))]),
   decl(gs_length(dual('List'('Key')), 'Integer')),
   clause(gs_length([], 0), [], []),
   clause(gs_length([var('_') | var('Xs')], var('N?')), [], [gs_length(var('Xs?'), var('N1')), ':='(var('N'), '+'(var('N1?'), 1))]),
   decl(gs_nth(dual('Integer'), dual('Key'), dual('List'('Key')), 'Key')),
   clause(gs_nth(1, var('X0'), var('_'), var('X0?')), [], []),
   clause(gs_nth(var('K'), var('_'), [var('X1') | var('Xs')], var('X?')), ['>'(var('K?'), 1)], [':='(var('K1'), '-'(var('K?'), 1)), gs_nth(var('K1?'), var('X1?'), var('Xs?'), var('X'))]),
   clause(gs_nth(var('K'), var('X0'), [], var('X0?')), ['>'(var('K?'), 1)], [true]),
   decl(gs_without(dual('List'('Key')), dual('Key'), 'List'('Key'))),
   clause(gs_without([], var('_'), []), [], []),
   clause(gs_without([var('X') | var('Xs')], var('Y'), var('Zs?')), ['=?='(var('X?'), var('Y?')), ground(var('Y?'))], [gs_without(var('Xs?'), var('Y?'), var('Zs'))]),
   clause(gs_without([var('X') | var('Xs')], var('Y'), [var('X?') | var('Zs?')]), [otherwise, ground(var('Y?'))], [gs_without(var('Xs?'), var('Y?'), var('Zs'))]),
   decl(gs_minus(dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(gs_minus(var('Xs'), [], var('Xs?')), [], []),
   clause(gs_minus(var('Xs'), [var('Y') | var('Ys')], var('Zs?')), [], [gs_without(var('Xs?'), var('Y?'), var('Xs1')), gs_minus(var('Xs1?'), var('Ys?'), var('Zs'))]),
   decl(gs_inter(dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(gs_inter([], var('_'), []), [], []),
   clause(gs_inter([var('X') | var('Xs')], var('Ys'), var('Zs?')), [ground(var('X?')), ground(var('Ys?'))], [gs_mem(var('X?'), var('Ys?'), var('In')), gs_inter1(var('In?'), var('X?'), var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(gs_inter1(dual('YesNo'), dual('Key'), dual('List'('Key')), dual('List'('Key')), 'List'('Key'))),
   clause(gs_inter1(yes, var('X'), var('Xs'), var('Ys'), [var('X?') | var('Zs?')]), [], [gs_inter(var('Xs?'), var('Ys?'), var('Zs'))]),
   clause(gs_inter1(no, var('_'), var('Xs'), var('Ys'), var('Zs?')), [], [gs_inter(var('Xs?'), var('Ys?'), var('Zs'))]),
   decl(gs_mem(dual('Key'), dual('List'('Key')), 'YesNo')),
   clause(gs_mem(var('_'), [], no), [], []),
   clause(gs_mem(var('X'), [var('Y') | var('_')], yes), ['=?='(var('X?'), var('Y?'))], [true]),
   clause(gs_mem(var('X'), [var('_') | var('Ys')], var('R?')), [otherwise], [gs_mem(var('X?'), var('Ys?'), var('R'))]),
   decl(gs_attr_knows(dual('List'('GsAttr')), 'List'('Key'))),
   clause(gs_attr_knows([], []), [], []),
   clause(gs_attr_knows([knows(var('Kn')) | var('_')], var('Kn?')), [], []),
   clause(gs_attr_knows([var('_') | var('As')], var('Kn?')), [otherwise], [gs_attr_knows(var('As?'), var('Kn'))]),
   decl(gs_attr_village(dual('List'('GsAttr')), 'Integer')),
   clause(gs_attr_village([], 0), [], []),
   clause(gs_attr_village([village(var('V')) | var('_')], var('V?')), [], []),
   clause(gs_attr_village([var('_') | var('As')], var('V?')), [otherwise], [gs_attr_village(var('As?'), var('V'))]),
   decl(gs_attr_families(dual('List'('GsAttr')), 'List'('GsFam'))),
   clause(gs_attr_families([], []), [], []),
   clause(gs_attr_families([families(var('Fs')) | var('_')], var('Fs?')), [], []),
   clause(gs_attr_families([var('_') | var('As')], var('Fs?')), [otherwise], [gs_attr_families(var('As?'), var('Fs'))]),
   decl(gs_friends(dual('List'('Atom')), 'List'('Key'))),
   clause(gs_friends([], []), [], []),
   clause(gs_friends([friend(var('Q')) | var('As')], [var('Q?') | var('Fs?')]), [], [gs_friends(var('As?'), var('Fs'))]),
   clause(gs_friends([var('_') | var('As')], var('Fs?')), [otherwise], [gs_friends(var('As?'), var('Fs'))]),
   decl(gs_all_parents(dual('List'('GsFam')), 'List'('Key'))),
   clause(gs_all_parents([], []), [], []),
   clause(gs_all_parents([fam(var('_'), var('Pa'), var('_')) | var('Fs')], var('Ps?')), [], [gs_all_parents(var('Fs?'), var('Ps1')), gs_app(var('Pa?'), var('Ps1?'), var('Ps'))]),
   decl(gs_first_missing(dual('List'('Key')), dual('List'('Key')), 'GsPick')),
   clause(gs_first_missing([], var('_'), nothing), [], []),
   clause(gs_first_missing([var('X') | var('Xs')], var('Ks'), var('P?')), [ground(var('X?')), ground(var('Ks?'))], [gs_mem(var('X?'), var('Ks?'), var('In')), gs_first_missing1(var('In?'), var('X?'), var('Xs?'), var('Ks?'), var('P'))]),
   decl(gs_first_missing1(dual('YesNo'), dual('Key'), dual('List'('Key')), dual('List'('Key')), 'GsPick')),
   clause(gs_first_missing1(no, var('X'), var('_'), var('_'), pick(var('X?'))), [], []),
   clause(gs_first_missing1(yes, var('_'), var('Xs'), var('Ks'), var('P?')), [], [gs_first_missing(var('Xs?'), var('Ks?'), var('P'))]),
   decl(gs_pick_or_nothing(dual('List'('Key')), dual('Integer'), 'GsPick')),
   clause(gs_pick_or_nothing([], var('_'), nothing), [], []),
   clause(gs_pick_or_nothing([var('X') | var('Xs')], var('S'), pick(var('Q?'))), [], [gs_pick([var('X?') | var('Xs?')], var('S?'), var('Q'), var('_'))]),
   decl(gs_has_identity(dual('List'('Atom')), 'YesNo')),
   clause(gs_has_identity([], no), [], []),
   clause(gs_has_identity([identity | var('_')], yes), [], []),
   clause(gs_has_identity([var('_') | var('As')], var('R?')), [otherwise], [gs_has_identity(var('As?'), var('R'))]),
   decl(gs_knows_atoms(dual('List'('Atom')), 'List'('Key'))),
   clause(gs_knows_atoms([], []), [], []),
   clause(gs_knows_atoms([knows(var('Q')) | var('As')], [var('Q?') | var('Qs?')]), [], [gs_knows_atoms(var('As?'), var('Qs'))]),
   clause(gs_knows_atoms([var('_') | var('As')], var('Qs?')), [otherwise], [gs_knows_atoms(var('As?'), var('Qs'))]),
   decl(gs_request(dual('Slot'('Request')), dual('Request'))),
   clause(gs_request(slot(var('V?')), var('V')), [], []),
   decl(gs_offer(dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('GsAttr')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_offer(var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), [ground(var('Me?')), ground(var('Ks?')), ground(var('As?'))], [gs_attr_families(var('As?'), var('All')), gs_attr_village(var('As?'), var('V')), gs_friends(var('Atoms?'), var('Fr')), gs_cands(var('All?'), var('V?'), var('Me?'), var('Ks?'), var('Fr?'), var('Vc'), var('Oc')), random(var('S?'), 100, var('D'), var('S1')), gs_offer_from(var('D?'), var('Local?'), var('Vc?'), var('Oc?'), var('Me?'), var('Ks?'), var('S1?'), slot(var('W')))]),
   decl(gs_cands(dual('List'('GsFam')), dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('Key')), 'List'('Key'), 'List'('Key'))),
   clause(gs_cands(var('All'), var('V'), var('Me'), var('Ks'), var('Fr'), var('Vc?'), var('Oc?')), [ground(var('All?')), ground(var('V?')), ground(var('Ks?')), ground(var('Fr?'))], [gs_village_parents(var('All?'), var('V?'), var('Me?'), var('Vp')), gs_other_parents(var('All?'), var('V?'), var('Op')), gs_inter(var('Vp?'), var('Ks?'), var('Vk')), gs_minus(var('Vk?'), var('Fr?'), var('Vc')), gs_inter(var('Op?'), var('Ks?'), var('Ok')), gs_minus(var('Ok?'), var('Fr?'), var('Oc'))]),
   decl(gs_offer_from(dual('Integer'), dual('Integer'), dual('List'('Key')), dual('List'('Key')), dual('Key'), dual('List'('Key')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_offer_from(var('D'), var('Local'), var('Vc'), var('Oc'), var('Me'), var('Ks'), var('S'), slot(var('W?'))), ['=<'(var('D?'), var('Local?'))], [gs_offer_to(var('Vc?'), var('Oc?'), var('Me?'), var('Ks?'), var('S?'), slot(var('W')))]),
   clause(gs_offer_from(var('D'), var('Local'), var('Vc'), var('Oc'), var('Me'), var('Ks'), var('S'), slot(var('W?'))), ['>'(var('D?'), var('Local?'))], [gs_offer_to(var('Oc?'), var('Vc?'), var('Me?'), var('Ks?'), var('S?'), slot(var('W')))]),
   decl(gs_offer_to(dual('List'('Key')), dual('List'('Key')), dual('Key'), dual('List'('Key')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_offer_to([var('X') | var('Xs')], var('_'), var('Me'), var('_'), var('S'), slot(propose(befriend(var('Me?'), var('Q?'))))), [], [gs_pick([var('X?') | var('Xs?')], var('S?'), var('Q'), var('_'))]),
   clause(gs_offer_to([], [var('X') | var('Xs')], var('Me'), var('_'), var('S'), slot(propose(befriend(var('Me?'), var('Q?'))))), [], [gs_pick([var('X?') | var('Xs?')], var('S?'), var('Q'), var('_'))]),
   clause(gs_offer_to([], [], var('Me'), var('_'), var('_'), slot(propose(establish(var('Me?'))))), [], []),
   decl(gs_introduce(dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('GsAttr')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_introduce(var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), [ground(var('As?')), ground(var('Atoms?')), ground(var('Me?'))], [gs_friends(var('Atoms?'), var('Fr')), gs_attr_families(var('As?'), var('All')), gs_all_parents(var('All?'), var('Ap')), gs_inter(var('Fr?'), var('Ap?'), var('Fp')), gs_without(var('Fp?'), var('Me?'), var('Fq')), gs_two(var('Fq?'), var('S?'), var('Two'), var('S1')), gs_introduce1(var('Two?'), var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S1?'), slot(var('W')))]),
   decl(gs_introduce1(dual('List'('Key')), dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('GsAttr')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_introduce1([var('Q'), var('C')], var('_'), var('Me'), var('_'), var('_'), var('_'), var('_'), slot(propose(introduce(var('Me?'), var('Q?'), var('C?'))))), [], []),
   clause(gs_introduce1(var('_'), var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), [otherwise], [gs_offer(var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S?'), slot(var('W')))]),
   decl(gs_end_friendship1(dual('GsPick'), dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('GsAttr')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_end_friendship1(pick(var('Q')), var('_'), var('Me'), var('_'), var('_'), var('_'), var('_'), slot(propose(unfriend(var('Me?'), var('Q?'))))), [], []),
   clause(gs_end_friendship1(nothing, var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), [], [gs_offer(var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S?'), slot(var('W')))]),
   decl(gs_say(dual('Slot'('YesNo')), dual('YesNo'))),
   clause(gs_say(slot(var('V?')), var('V')), [], []),
   decl(gs_yes_if(dual('Integer'), dual('Integer'), 'YesNo')),
   clause(gs_yes_if(var('K'), var('P'), yes), ['=<'(var('K?'), var('P?'))], [true]),
   clause(gs_yes_if(var('K'), var('P'), no), ['>'(var('K?'), var('P?'))], [true]),

   %% THE MENU.  The approach: local or open, the share of offers made in the own village.
   person(local),
   binds('Request', local_request),
   decl(local_request('Request', dual('Person'), dual('Integer'))),
   clause(local_request(var('R?'), person(var('Me'), var('_'), var('As')), var('S')), [], [seen(var('L')), gs_menu(95, var('Me?'), var('As?'), var('L?'), var('S?'), slot(var('R')))]),
   person(open),
   binds('Request', open_request),
   decl(open_request('Request', dual('Person'), dual('Integer'))),
   clause(open_request(var('R?'), person(var('Me'), var('_'), var('As')), var('S')), [], [seen(var('L')), gs_menu(60, var('Me?'), var('As?'), var('L?'), var('S?'), slot(var('R')))]),
   decl(gs_menu(dual('Integer'), dual('Key'), dual('List'('GsAttr')), dual('List'('Output')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_menu(var('Local'), var('Me'), var('As'), var('L'), var('S'), slot(var('W?'))), [], [gs_last_view(var('L?'), var('Atoms')), gs_menu1(var('Atoms?'), var('Local?'), var('Me?'), var('As?'), var('S?'), slot(var('W')))]),
   decl(gs_menu1(dual('List'('Atom')), dual('Integer'), dual('Key'), dual('List'('GsAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_menu1(var('Atoms'), var('Local'), var('Me'), var('As'), var('S'), slot(var('W?'))), [ground(var('Atoms?')), ground(var('As?')), ground(var('Me?'))], [gs_has_identity(var('Atoms?'), var('Id')), gs_attr_knows(var('As?'), var('Kn')), gs_knows_atoms(var('Atoms?'), var('Kw')), gs_knows_atoms(var('Atoms?'), var('Ks')), gs_first_missing(var('Kn?'), var('Kw?'), var('Q')), gs_todo(var('Id?'), var('Q?'), var('T')), gs_do(var('T?'), var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S?'), slot(var('W')))]),
   decl(gs_todo(dual('YesNo'), dual('GsPick'), 'GsTodo')),
   clause(gs_todo(no, var('_'), establish), [], []),
   clause(gs_todo(yes, pick(var('Q')), acquaint(var('Q?'))), [], []),
   clause(gs_todo(yes, nothing, steady), [], []),
   decl(gs_do(dual('GsTodo'), dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('GsAttr')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_do(establish, var('_'), var('Me'), var('_'), var('_'), var('_'), var('_'), slot(var('W?'))), [], [rated(gs_request(slot(var('W')), propose(establish(var('Me?')))), rate(8, hour))]),
   clause(gs_do(acquaint(var('Q')), var('_'), var('Me'), var('_'), var('_'), var('_'), var('_'), slot(var('W?'))), [], [rated(gs_request(slot(var('W')), propose(acquaint(var('Me?'), var('Q?')))), rate(8, hour))]),
   clause(gs_do(steady, var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), [], [random(var('S?'), 52, var('K'), var('S1')), rated(gs_act(var('K?'), var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S1?'), slot(var('W'))), rate(2, hour))]),
   %% gs_act(K?, ...): the act drawn, K in 1..52: 45 an offer, 6 an introduction, 1 an ending.
   decl(gs_act(dual('Integer'), dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('GsAttr')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_act(var('K'), var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), ['=<'(var('K?'), 45)], [gs_offer(var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S?'), slot(var('W')))]),
   clause(gs_act(var('K'), var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), ['>'(var('K?'), 45), '=<'(var('K?'), 51)], [gs_introduce(var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S?'), slot(var('W')))]),
   clause(gs_act(52, var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), [], [gs_end_friendship(var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S?'), slot(var('W')))]),
   %% gs_end_friendship: propose(unfriend(Me, Q)), Q a friend drawn uniformly; an offer where there is none.
   decl(gs_end_friendship(dual('Integer'), dual('Key'), dual('List'('Key')), dual('List'('GsAttr')), dual('List'('Atom')), dual('Integer'), dual('Slot'('Request')))),
   clause(gs_end_friendship(var('Local'), var('Me'), var('Ks'), var('As'), var('Atoms'), var('S'), slot(var('W?'))), [ground(var('Me?')), ground(var('Atoms?'))], [gs_friends(var('Atoms?'), var('Fr')), random(var('S?'), 2147483646, var('S1'), var('S2')), gs_pick_or_nothing(var('Fr?'), var('S1?'), var('Q')), gs_end_friendship1(var('Q?'), var('Local?'), var('Me?'), var('Ks?'), var('As?'), var('Atoms?'), var('S2?'), slot(var('W')))]),

   %% THE POLICY.  Keen or choosy: an offer of friendship approved 90 or 50 times in 100.
   person(keen),
   binds('Approval', keen_approval),
   decl(keen_approval(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(keen_approval(approval(hello(var('_'), var('_')), var('_'), var('A?')), var('_'), var('_')), [], [gs_say(slot(var('A')), yes)]),
   clause(keen_approval(approval(attempt(var('_'), var('_'), var('_'), acquaint(var('_'), var('_')), var('_')), var('_'), var('A?')), var('_'), var('_')), [], [gs_say(slot(var('A')), yes)]),
   clause(keen_approval(approval(attempt(var('_'), var('_'), var('_'), introduce(var('_'), var('_'), var('_')), var('_')), var('_'), var('A?')), var('_'), var('_')), [], [gs_say(slot(var('A')), yes)]),
   clause(keen_approval(approval(attempt(var('_'), var('_'), var('_'), var('C'), var('_')), var('_'), var('A?')), var('_'), var('S')), [otherwise], [rated(gs_answer(90, var('C?'), var('S?'), slot(var('A'))), rate(2, hour))]),
   person(choosy),
   binds('Approval', choosy_approval),
   decl(choosy_approval(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(choosy_approval(approval(hello(var('_'), var('_')), var('_'), var('A?')), var('_'), var('_')), [], [gs_say(slot(var('A')), yes)]),
   clause(choosy_approval(approval(attempt(var('_'), var('_'), var('_'), acquaint(var('_'), var('_')), var('_')), var('_'), var('A?')), var('_'), var('_')), [], [gs_say(slot(var('A')), yes)]),
   clause(choosy_approval(approval(attempt(var('_'), var('_'), var('_'), introduce(var('_'), var('_'), var('_')), var('_')), var('_'), var('A?')), var('_'), var('_')), [], [gs_say(slot(var('A')), yes)]),
   clause(choosy_approval(approval(attempt(var('_'), var('_'), var('_'), var('C'), var('_')), var('_'), var('A?')), var('_'), var('S')), [otherwise], [rated(gs_answer(50, var('C?'), var('S?'), slot(var('A'))), rate(2, hour))]),
   decl(gs_answer(dual('Integer'), dual('Class'), dual('Integer'), dual('Slot'('YesNo')))),
   clause(gs_answer(var('P'), befriend(var('_'), var('_')), var('S'), slot(var('A?'))), [], [random(var('S?'), 100, var('K'), var('_')), gs_yes_if(var('K?'), var('P?'), var('A'))]),
   clause(gs_answer(var('_'), var('_'), var('_'), slot(yes)), [otherwise], [true]),

   %% THE RUN.
   run(gs_villages1, [mix(approach, adult, [share(local, 0.5), share(open, 0.5)]), mix(policy, adult, [share(keen, 0.5), share(choosy, 0.5)])], 1, day, 1),

   %% THE KEY TABLE: two keys a household, v<village>h<household>a and b.
   decl(gs_keys('List'('GsKeys'))),
   clause(gs_keys([ks(v1h01a, v1h01b), ks(v1h02a, v1h02b), ks(v1h03a, v1h03b), ks(v1h04a, v1h04b), ks(v1h05a, v1h05b), ks(v1h06a, v1h06b), ks(v1h07a, v1h07b), ks(v1h08a, v1h08b), ks(v1h09a, v1h09b), ks(v1h10a, v1h10b)]), [], [])]).
