%% Printed by programs/sglp/transform.glp from the sGLP source in the term form
%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(given, cva_population)

%% The run declaration of the source:
%% (run(cs_village1, [mix(approach, parent, [share(local, 0.5), share(open, 0.5)]), mix(policy, parent, [share(strict, 0.0), share(permissive, 1.0)]), mix(response, child, [share(choosy, 1.0), share(keen, 0.0)])], 1, year, 1))

Profiles
::=
parent(Dimension1, Dimension2)
;
child(Dimension3)
.
Dimension1
::=
local
;
open
.
Dimension2
::=
strict
;
permissive
.
Dimension3
::=
choosy
;
keen
.
Ask ::= ask(Constant, Question).
Question
::=
menu_w(Menu)
;
approval_w(Approval)
.
CsFam
::=
fam(Integer, List(Key), List(Key))
.
CsAttr
::=
village(Integer)
;
parents(List(Key))
;
children(List(Key))
;
knows(List(Key))
;
families(List(CsFam))
.
Person
::=
person(Key, Constant, List(CsAttr))
.
CsKeys
::=
ks(Key, Key, Key, Key, Key)
.
CsPick
::=
pick(Key)
;
nothing
.
CsKeys1
::=
[Key | List(Key)]
.
CsTodo
::=
establish
;
meet(Key)
;
enter1(Key, Key)
;
mkp(Key, Key, Key)
;
steady
.
CsMk
::=
mk(Key, Key)
;
none
.
CsPair
::=
acq(Key, Key)
.

