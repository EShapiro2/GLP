%% The person process (sGLP's paper, Section 3, Definition "Person Process"; Section 4, "The person process").
exported procedure person(Integer?, Profiles?, Person?, MutualRef?, MutualRef?, Integer?, MutualRef?, Stream(Ask)?).
person(A, parent(local, D2), H, Mon, Scr, Seed, Log, [ask('Menu', menu_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
local_menu(Y?, H?, K?, Mon?, Scr?)
,
relay_1(A?, 'Menu', E?, Y, Mon?, Log?)
,
person(A?, parent(local, D2?), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, parent(open, D2), H, Mon, Scr, Seed, Log, [ask('Menu', menu_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
open_menu(Y?, H?, K?, Mon?, Scr?)
,
relay_1(A?, 'Menu', E?, Y, Mon?, Log?)
,
person(A?, parent(open, D2?), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, parent(D1, strict), H, Mon, Scr, Seed, Log, [ask('Approval', approval_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
strict_approval(Y?, H?, K?, Mon?, Scr?)
,
relay_2(A?, 'Approval', E?, Y, Mon?, Log?)
,
person(A?, parent(D1?, strict), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, parent(D1, permissive), H, Mon, Scr, Seed, Log, [ask('Approval', approval_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
permissive_approval(Y?, H?, K?, Mon?, Scr?)
,
relay_2(A?, 'Approval', E?, Y, Mon?, Log?)
,
person(A?, parent(D1?, permissive), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, child(choosy), H, Mon, Scr, Seed, Log, [ask('Menu', menu_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
child_menu(Y?, H?, K?, Mon?, Scr?)
,
relay_1(A?, 'Menu', E?, Y, Mon?, Log?)
,
person(A?, child(choosy), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, child(choosy), H, Mon, Scr, Seed, Log, [ask('Approval', approval_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
choosy_approval(Y?, H?, K?, Mon?, Scr?)
,
relay_2(A?, 'Approval', E?, Y, Mon?, Log?)
,
person(A?, child(choosy), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, child(keen), H, Mon, Scr, Seed, Log, [ask('Menu', menu_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
child_menu(Y?, H?, K?, Mon?, Scr?)
,
relay_1(A?, 'Menu', E?, Y, Mon?, Log?)
,
person(A?, child(keen), H?, Mon?, Scr?, S?, Log?, As?)
.
person(A, child(keen), H, Mon, Scr, Seed, Log, [ask('Approval', approval_w(E)) | As])
:-
ground(H?)
|
random(Seed?, 2147483646, K, S)
,
profiles
#
keen_approval(Y?, H?, K?, Mon?, Scr?)
,
relay_2(A?, 'Approval', E?, Y, Mon?, Log?)
,
person(A?, child(keen), H?, Mon?, Scr?, S?, Log?, As?)
.
person(_, _, _, _, _, _, _, []).

%% The relay of an interactive type (Definition "Copy, Relay").
procedure
relay_1
(
Integer?
,
Constant?
,
Menu
?
,
Menu
,
MutualRef?
,
MutualRef?
)
.
relay_1(A, Type, menu(X1, X2, X3?), menu(X1?, X2?, Y3), Mon, Log)
:-
ground(X1?)
,
ground(X2?)
|
answer_1(A?, Type?, X1?, X2?, Y3?, X3, Mon?, Log?)
.

%% The relay of an interactive type (Definition "Copy, Relay").
procedure
relay_2
(
Integer?
,
Constant?
,
Approval
?
,
Approval
,
MutualRef?
,
MutualRef?
)
.
relay_2(A, Type, approval(X1, X2, X3?), approval(X1?, X2?, Y3), Mon, Log)
:-
ground(X1?)
,
ground(X2?)
|
answer_2(A?, Type?, X1?, X2?, Y3?, X3, Mon?, Log?)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_1
(
Integer?
,
Constant?
,
Key
?
,
List(Key)
?
,
Request
?
,
Request
,
MutualRef?
,
MutualRef?
)
.
answer_1(A, Type, X1, X2, Y3, Y3?, Mon, Log)
:-
ground(Y3?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, menu(X1?, X2?, Y3?)), Log?, _)
.

%% The answer, handed over and logged (Section 4, "The person process" and "The log").
procedure
answer_2
(
Integer?
,
Constant?
,
Asking
?
,
List(Word)
?
,
YesNo
?
,
YesNo
,
MutualRef?
,
MutualRef?
)
.
answer_2(A, Type, X1, X2, Y3, Y3?, Mon, Log)
:-
ground(Y3?)
|
stream_append(time(Time), Mon?, _)
,
stream_append(entry(Time?, A?, Type?, approval(X1?, X2?, Y3?)), Log?, _)
.

%% The screen of an agent (sGLP's paper, Section 3, Definition "Screen, Seen"; Section 4, "The screen" and "The log").
Seen(X) ::= seen(List(X)?).
exported procedure(X) screen(Integer?, Stream(X)?, List(X)?, Stream(Seen(X))?, MutualRef?, MutualRef?).
screen(A, [E|O], Os, Rs, Mon, Log) :- ground(E?) | stream_append(time(Time), Mon?, _), stream_append(entry(Time?, A?, output, E?), Log?, _), screen(A?, O?, [E?|Os?], Rs?, Mon?, Log?).
screen(A, O, Os, [seen(Os?)|Rs], Mon, Log) :- ground(Os?) | screen(A?, O?, Os?, Rs?, Mon?, Log?).
screen(_, [], _, [], _, _).

%% An agent's screen on the program's output O to its person, and its reference, Scr, on which the person goals request seen(L).
exported procedure(X) start_screen(Integer?, Stream(X)?, MutualRef?, MutualRef?, MutualRef).
start_screen(A, O, Mon, Log, Scr?) :- allocate_mutual_reference(Scr, Rs), screen(A?, O?, [], Rs?, Mon?, Log?).

%% The run declaration: its persons, horizon, seed and thresholds.
exported procedure
declaration
(
Constant
,
Number
,
Span
,
Integer
,
Integer
,
Integer
,
Integer
)
.
declaration(cs_village1, 1, year, 1, 50, 0, 100)
.

%% The persons of the run, drawn by its census (sGLP's paper, Section 3, Definition "Person, Census", and after Definition "Well-Formed"; Appendix B).
exported procedure
persons
(
Integer?
,
Stream(Key)
?
,
Constant
,
List(Person)
,
Integer
)
.
persons(B, _, Ok?, Ps?, B1?)
:-
integer(B?)
|
profiles
#
cs_village1(B?, Ps0)
,
checked(Ps0?, Ok, Ps)
,
skip(4096, B?, B1)
.
procedure skip(Integer?, Integer?, Integer).
skip(0, S, S?).
skip(J, S, S1?) :- J? > 0, integer(S?) | random(S?, 1, _, S2), J1 := J? - 1, skip(J1?, S2?, S1).
procedure checked(List(Person)?, Constant, List(Person)).
checked([], no, []).
checked([P|Ps], Ok?, [P?|Ps?]) :- ground(P?), ground(Ps?) | roles_ok([P?|Ps?], Ok).
procedure roles_ok(List(Person)?, Constant).
roles_ok([], yes).
roles_ok([person(_, parent, _) | Ps], Ok?)
:-
roles_ok(Ps?, Ok)
.
roles_ok([person(_, child, _) | Ps], Ok?)
:-
roles_ok(Ps?, Ok)
.
roles_ok([_|_], no) :- otherwise | true.

%% An agent's stochastic person, one profile per dimension of the role of its person, drawn from its block (Appendix B).
exported procedure
stochastic_person
(
Integer?
,
Person
?
,
Integer?
,
Integer?
,
Integer?
,
Profiles
,
Integer
)
.
stochastic_person(B, person(_, parent, _), T1, T2, _, parent(P1?, P2?), S?)
:-
random(B?, 100, K1, B1)
,
random(B1?, 100, K2, S)
,
approach(K1?, T1?, P1)
,
policy(K2?, T2?, P2)
.
stochastic_person(B, person(_, child, _), _, _, T3, child(P1?), S?)
:-
random(B?, 100, K1, S)
,
response(K1?, T3?, P1)
.

%% The draw of the dimension(approach)
procedure
approach
(
Integer?
,
Integer?
,
Dimension1
)
.
approach(K, T1, local)
:-
'=<'(K?, T1?)
|
true
.
approach(K, T1, open)
:-
'>'(K?, T1?)
|
true
.

%% The draw of the dimension(policy)
procedure
policy
(
Integer?
,
Integer?
,
Dimension2
)
.
policy(K, T1, strict)
:-
'=<'(K?, T1?)
|
true
.
policy(K, T1, permissive)
:-
'>'(K?, T1?)
|
true
.

%% The draw of the dimension(response)
procedure
response
(
Integer?
,
Integer?
,
Dimension3
)
.
response(K, T1, choosy)
:-
'=<'(K?, T1?)
|
true
.
response(K, T1, keen)
:-
'>'(K?, T1?)
|
true
.

%% The run's entries of one arity, for the harness of every canonical CVA platform (programs/sglp/cva/).
exported procedure
run_declaration
(
Constant
,
Number
,
Span
,
Integer
)
.
run_declaration(cs_village1, 1, year, 1)
.

%% An agent's seat on the platform: its key, and the writers of its ask stream and of the program's output to its person, which its initial goal writes.
Seat
(
X
)
::=
seat
(
Key
,
Stream(Ask)
?
,
Stream(X)
?
)
.
exported procedure
cva_check
(
Integer?
,
Stream(Key)
?
,
Constant
)
.
cva_check(B, Ks, Ok?) :- persons(B?, Ks?, Ok, _, _).
exported procedure(X)
cva_agents
(
Integer?
,
Stream(Key)
?
,
MutualRef?
,
MutualRef?
,
Stream(Key)
,
Stream(Seat(X))
)
.
cva_agents(B, Ks, Mon, Log, Keys?, Seats?) :- persons(B?, Ks?, _, Ps, B1), seats(1, Ps?, B1?, Mon?, Log?, Keys, Seats).
procedure(X)
seats
(
Integer?
,
List(Person)
?
,
Integer?
,
MutualRef?
,
MutualRef?
,
Stream(Key)
,
Stream(Seat(X))
)
.
seats(_, [], _, _, _, [], []).
seats(A, [person(K, R, V)|Ps], B, Mon, Log, [K?|Ks?], [seat(K?, Asks, O)|Ss?]) :- integer(A?), integer(B?), ground(K?), ground(V?) | stochastic_agent(A?, B?, person(K?, R?, V?), Mon?, Log?, Asks?, O?), skip(4096, B?, B2), A1 := A? + 1, seats(A1?, Ps?, B2?, Mon?, Log?, Ks, Ss).
procedure(X)
stochastic_agent
(
Integer?
,
Integer?
,
Person
?
,
MutualRef?
,
MutualRef?
,
Stream(Ask)
?
,
Stream(X)
?
)
.
stochastic_agent(A, B, H, Mon, Log, Asks, O)
:-
ground(H?)
|
stochastic_person(B?, H?, 50, 0, 100, P, S)
,
random(S?, 2147483646, Seed, _)
,
start_screen(A?, O?, Mon?, Log?, Scr)
,
person(A?, P?, H?, Mon?, Scr?, Seed?, Log?, Asks?)
.
exported procedure
cva_draw
(
Integer?
,
Stream(Key)
?
,
Stream(_)
)
.
cva_draw(B, Ks, D?) :- persons(B?, Ks?, _, Ps, B1), drawn(1, Ps?, B1?, D).
procedure drawn(Integer?, List(Person)?, Integer?, Stream(_)).
drawn(_, [], _, []).
drawn(A, [H | Hs], B, [agent(A?, P?) | D?])
:-
integer(A?)
,
integer(B?)
,
ground(H?)
|
stochastic_person(B?, H?, 50, 0, 100, P, _)
,
skip(4096, B?, B2)
,
':='(A1, '+'(A?, 1))
,
drawn(A1?, Hs?, B2?, D)
.
