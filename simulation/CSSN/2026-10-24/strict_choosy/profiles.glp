.

CsKeys
::=
ks(Key, Key, Key, Key, Key)
.

CsPick
::=
pick(Key)
;
nothing
.

CsKeys1
::=
[Key | List(Key)]
.

CsTodo
::=
establish
;
meet(Key)
;
enter1(Key, Key)
;
mkp(Key, Key, Key)
;
steady
.

CsMk
::=
mk(Key, Key)
;
none
.

CsPair
::=
acq(Key, Key)
.
