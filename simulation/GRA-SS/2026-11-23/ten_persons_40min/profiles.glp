.
procedure gr_keys_of(Constant?, List(Atom)?, List(Key)).
gr_keys_of(_, [], [])
.
gr_keys_of(knows, [knows(Q) | As], [Q? | Qs?])
:-
gr_keys_of(knows, As?, Qs)
.
gr_keys_of(friend, [friend(Q) | As], [Q? | Qs?])
:-
gr_keys_of(friend, As?, Qs)
.
gr_keys_of(points, [points_to(Q) | As], [Q? | Qs?])
:-
gr_keys_of(points, As?, Qs)
.
gr_keys_of(W, [_ | As], Qs?)
:-
otherwise
|
gr_keys_of(W?, As?, Qs)
.
procedure gr_first_missing(List(Key)?, List(Key)?, GrPick).
gr_first_missing([], _, nothing)
.
gr_first_missing([X | Xs], Ks, P?)
:-
ground(X?)
,
ground(Ks?)
|
gr_mem(X?, Ks?, In)
,
gr_fm1(In?, X?, Xs?, Ks?, P)
.
procedure gr_fm1(Constant?, Key?, List(Key)?, List(Key)?, GrPick).
gr_fm1(no, X, _, _, pick(X?))
.
gr_fm1(yes, _, Xs, Ks, P?)
:-
gr_first_missing(Xs?, Ks?, P)
.
procedure gr_mem(Key?, List(Key)?, Constant).
gr_mem(_, [], no)
.
gr_mem(X, [Y | _], yes)
:-
'=?='(X?, Y?)
|
true
.
gr_mem(X, [_ | Ys], R?)
:-
otherwise
|
gr_mem(X?, Ys?, R)
.

%% person(steady)
%% binds(Request, steady_request)
%% binds(Approval, steady_approval)
exported procedure steady_request(Request, Person?, Integer?, MutualRef?).
steady_request(R?, person(Me, _, As), S, Scr)
:-
rated(0.1, Tok)
,
gr_tick(Tok?, Me?, As?, S?, slot(R), Scr?)
.
exported procedure steady_approval(Approval?, Person?, Integer?, MutualRef?).
steady_approval(approval(_, _, A?), _, _, _)
:-
gr_say(slot(A), yes)
.
procedure gr_say(Slot(YesNo)?, YesNo?).
gr_say(slot(V?), V)
.
procedure gr_tick(Token?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_tick(stop, _, _, _, _, _)
.
gr_tick(go(_), Me, As, S, slot(W?), Scr)
:-
stream_append(seen(L), Scr?, _)
,
gr_view(L?, Atoms)
,
gr_decide(Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_decide(List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_decide(Atoms, Me, As, S, slot(W?), Scr)
:-
ground(Atoms?)
,
ground(Me?)
,
ground(As?)
|
gr_has_id(Atoms?, Id)
,
gr_d1(Id?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_d1(Constant?, List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_d1(no, _, Me, _, _, slot(propose(establish(Me?))), _)
.
gr_d1(yes, Atoms, Me, As, S, slot(W?), Scr)
:-
ground(Atoms?)
|
gr_at(Atoms?, P)
,
gr_d2(P?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_d2(GrPos?, List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_d2(nopos, _, Me, As, _, slot(propose(move(Me?, X?, Y?))), _)
:-
gr_home(As?, X, Y)
.
gr_d2(pos(X, Y), Atoms, Me, As, S, slot(W?), Scr)
:-
ground(Atoms?)
,
ground(As?)
|
gr_aknows(As?, Kn)
,
gr_keys_of(knows, Atoms?, Kw)
,
gr_first_missing(Kn?, Kw?, U)
,
gr_d3(U?, X?, Y?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_d3(GrPick?, Integer?, Integer?, List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_d3(pick(Q), _, _, _, Me, _, _, slot(propose(acquaint(Me?, Q?))), _)
.
gr_d3(nothing, X, Y, Atoms, Me, As, S, slot(W?), Scr)
:-
ground(Atoms?)
,
ground(As?)
|
gr_aknows(As?, Kn)
,
gr_keys_of(friend, Atoms?, Fr)
,
gr_first_missing(Kn?, Fr?, U)
,
gr_d4(U?, X?, Y?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_d4(GrPick?, Integer?, Integer?, List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_d4(pick(Q), _, _, _, Me, _, _, slot(propose(befriend(Me?, Q?))), _)
.
gr_d4(nothing, X, Y, Atoms, Me, As, S, slot(W?), Scr)
:-
ground(Atoms?)
,
ground(As?)
|
gr_apoints(As?, Pt0)
,
gr_keys_of(points, Atoms?, Pt)
,
gr_first_missing(Pt0?, Pt?, U)
,
gr_d5(U?, X?, Y?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_d5(GrPick?, Integer?, Integer?, List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_d5(pick(Q), _, _, _, Me, _, _, slot(propose(point_friend(Me?, Q?))), _)
.
gr_d5(nothing, X, Y, Atoms, Me, As, S, slot(W?), Scr)
:-
ground(As?)
,
ground(Atoms?)
|
gr_kind(As?, K)
,
gr_clock(Atoms?, C)
,
gr_role(K?, C?, X?, Y?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_role(Constant?, Integer?, Integer?, Integer?, List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_role(rider, C, X, Y, Atoms, Me, As, S, slot(W?), Scr)
:-
ground(Atoms?)
|
gr_ride(Atoms?, R)
,
gr_rider(R?, C?, X?, Y?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
gr_role(driver, C, X, Y, Atoms, Me, As, S, slot(W?), _)
:-
ground(Atoms?)
|
gr_ride(Atoms?, R)
,
gr_driver(R?, C?, X?, Y?, Atoms?, Me?, As?, S?, slot(W))
.
procedure gr_ping(Key?, Slot(Request)?).
gr_ping(Me, slot(propose(withdraw(Me?, 0))))
.
procedure gr_step(Key?, Integer?, Integer?, Integer?, Integer?, Slot(Request)?).
gr_step(Me, X, Y, TX, TY, slot(W?))
:-
'=:='(X?, TX?)
,
'=:='(Y?, TY?)
|
gr_ping(Me?, slot(W))
.
gr_step(Me, X, Y, TX, TY, slot(propose(move(Me?, X1?, Y1?))))
:-
otherwise
|
gr_towards(X?, TX?, 83, X1, Rem)
,
gr_towards(Y?, TY?, Rem?, Y1, _)
.
procedure gr_towards(Integer?, Integer?, Integer?, Integer, Integer).
gr_towards(X, TX, Bd, TX?, Rem?)
:-
'=<'(abs('-'(TX?, X?)), Bd?)
|
':='(Rem, '-'(Bd?, abs('-'(TX?, X?))))
.
gr_towards(X, TX, Bd, X1?, 0)
:-
'>'(TX?, X?)
,
'>'('-'(TX?, X?), Bd?)
|
':='(X1, '+'(X?, Bd?))
.
gr_towards(X, TX, Bd, X1?, 0)
:-
'<'(TX?, X?)
,
'>'('-'(X?, TX?), Bd?)
|
':='(X1, '-'(X?, Bd?))
.
procedure gr_rider(GrRide?, Integer?, Integer?, Integer?, List(Atom)?, Key?, List(GrAttr)?, Integer?, Slot(Request)?, MutualRef?).
gr_rider(withb(B), C, X, Y, Atoms, Me, _, _, slot(W?), _)
:-
ground(Atoms?)
,
ground(B?)
|
gr_picked(Atoms?, B?, Pk)
,
gr_rider_ride(Pk?, B?, C?, X?, Y?, Atoms?, Me?, slot(W))
.
gr_rider(noride, C, X, Y, Atoms, Me, As, S, slot(W?), Scr)
:-
ground(Atoms?)
|
gr_open(Atoms?, O)
,
gr_rider_free(O?, C?, X?, Y?, Atoms?, Me?, As?, S?, slot(W), Scr?)
.
procedure gr_picked(List(Atom)?, Key?, Constant).
gr_picked([], _, no)
.
gr_picked([pickup(Q) | _], B, yes)
:-
'=?='(Q?, B?)
|
true
.
gr_picked([_ | As], B, R?)
:-
otherwise
|
gr_picked(As?, B?, R)
.
procedure gr_rider_ride(Constant?, Key?, Integer?, Integer?, Integer?, List(Atom)?, Key?, Slot(Request)?).
gr_rider_ride(no, B, C, _, _, Atoms, Me, slot(W?))
:-
ground(Atoms?)
|
gr_awarded(Atoms?, St)
,
gr_rterms(Atoms?, T)
,
':='(Due, '+'(St?, T?))
,
gr_wait_pickup(Due?, B?, C?, Me?, slot(W))
.
gr_rider_ride(yes, B, C, X, Y, Atoms, Me, slot(W?))
:-
ground(Atoms?)
,
ground(B?)
|
gr_rroute(Atoms?, PX, PY, QX, QY)
,
gr_picked_on(Atoms?, B?, Pk)
,
gr_car(PX?, PY?, QX?, QY?, Pk?, C?, CX, CY)
,
gr_ride_on(CX?, CY?, X?, Y?, QX?, QY?, B?, Atoms?, Me?, slot(W))
.
procedure gr_car(Integer?, Integer?, Integer?, Integer?, Integer?, Integer?, Integer, Integer).
gr_car(PX, PY, QX, QY, Pk, C, CX?, CY?)
:-
ground(Pk?)
,
ground(C?)
|
':='(Dist, '*'(500, '-'(C?, Pk?)))
,
gr_towards(PX?, QX?, Dist?, CX, Rem)
,
gr_towards(PY?, QY?, Rem?, CY, _)
.
procedure gr_ride_on(Integer?, Integer?, Integer?, Integer?, Integer?, Integer?, Key?, List(Atom)?, Key?, Slot(Request)?).
gr_ride_on(CX, CY, X, _, _, _, _, _, Me, slot(propose(move(Me?, CX?, CY?))))
:-
'=\\='(CX?, X?)
|
true
.
gr_ride_on(CX, CY, X, Y, _, _, _, _, Me, slot(propose(move(Me?, CX?, CY?))))
:-
'=:='(CX?, X?)
,
'=\\='(CY?, Y?)
|
true
.
gr_ride_on(_, _, X, Y, QX, QY, B, Atoms, Me, slot(W?))
:-
otherwise
|
gr_at_dest(X?, Y?, QX?, QY?, B?, Atoms?, Me?, slot(W))
.
procedure gr_wait_pickup(Integer?, Key?, Integer?, Key?, Slot(Request)?).
gr_wait_pickup(Due, B, C, Me, slot(propose(cancel_waiting(Me?, B?, Due?))))
:-
'>'(C?, Due?)
|
true
.
gr_wait_pickup(_, B, C, Me, slot(propose(pickup(Me?, B?, C?))))
:-
otherwise
|
true
.
procedure gr_awarded(List(Atom)?, Integer).
gr_awarded([], 0)
.
gr_awarded([awarded(St, _) | _], St?)
.
gr_awarded([_ | As], R?)
:-
otherwise
|
gr_awarded(As?, R)
.
procedure gr_at_dest(Integer?, Integer?, Integer?, Integer?, Key?, List(Atom)?, Key?, Slot(Request)?).
gr_at_dest(X, Y, QX, QY, B, Atoms, Me, slot(W?))
:-
'=:='(X?, QX?)
,
'=:='(Y?, QY?)
,
ground(Atoms?)
,
ground(B?)
|
gr_awarded(Atoms?, St)
,
gr_adelay(Atoms?, Dl)
,
gr_picked_on(Atoms?, B?, Pk)
,
gr_fare(Atoms?, Pr)
,
gr_rlambda(Atoms?, L)
,
':='(Due, '+'(St?, Dl?))
,
gr_release(Pk?, Due?, Pr?, L?, B?, Me?, slot(W))
.
gr_at_dest(_, _, _, _, _, _, Me, slot(W?))
:-
otherwise
|
gr_ping(Me?, slot(W))
.
procedure gr_adelay(List(Atom)?, Integer).
gr_adelay([], 0)
.
gr_adelay([awarded(_, Dl) | _], Dl?)
.
gr_adelay([_ | As], R?)
:-
otherwise
|
gr_adelay(As?, R)
.
procedure gr_fare(List(Atom)?, Integer).
gr_fare([], 0)
.
gr_fare([fare(P) | _], P?)
.
gr_fare([_ | As], R?)
:-
otherwise
|
gr_fare(As?, R)
.
procedure gr_picked_on(List(Atom)?, Key?, Integer).
gr_picked_on([], _, 0)
.
gr_picked_on([picked(Q, E) | _], B, E?)
:-
'=?='(Q?, B?)
|
true
.
gr_picked_on([_ | As], B, E?)
:-
otherwise
|
gr_picked_on(As?, B?, E)
.
procedure gr_rlambda(List(Atom)?, Integer).
gr_rlambda([], 0)
.
gr_rlambda([ride_terms(L, _) | _], L?)
.
gr_rlambda([_ | As], R?)
:-
otherwise
|
gr_rlambda(As?, R)
.
procedure gr_release(Integer?, Integer?, Integer?, Integer?, Key?, Key?, Slot(Request)?).
gr_release(Pk, Due, _, _, B, Me, slot(propose(arrive_on_time(Me?, B?, Due?))))
:-
'=<'(Pk?, Due?)
|
