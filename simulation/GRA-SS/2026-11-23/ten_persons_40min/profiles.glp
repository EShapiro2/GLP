%% Printed by programs/sglp/transform/transform.glp from the sGLP source in the term form
%% (README.md, "The term form"); edit the source and run transform.sh, not this file.
%% transform(given, cva_profiles)

GrXY ::= xy(Integer, Integer).

GrLoc ::= loc(Key, Integer, Integer).

GrAttr ::= home(Integer, Integer) ; kind(Constant) ; knows(List(Key)) ; points(List(Key)) ; table(List(GrLoc)) ; dests(List(GrXY)).

Person ::= person(Key, Constant, List(GrAttr)).

GrPick ::= pick(Key) ; nothing.

GrPos ::= pos(Integer, Integer) ; nopos.

GrRide ::= withb(Key) ; noride.

GrUr ::= ur(Key, Constant, Integer, Integer) ; noun.

GrLead ::= lead(Key, Integer, Integer) ; nolead.

GrDk ::= dk(Integer, Key).

GrCall ::= cl(Key, Constant) ; nocall.
exported procedure gr_town(Integer?, List(Person)).
gr_town(_, Ps?)
:-
gr_keys(Ks)
,
gr_keys(Ks2)
,
gr_xys(XYs)
,
gr_locs(Ks?, XYs?, Locs)
,
gr_persons(Ks2?, Locs?, Ps)
.
procedure gr_keys(List(Key)).
gr_keys([d01, d02, d03, d04, d05, d06, r01, r02, r03, r04])
.
procedure gr_xys(List(GrXY)).
gr_xys([xy(2185, 4405), xy(2713, 4877), xy(1366, 5769), xy(2504, 5562), xy(1398, 6389), xy(2767, 6366), xy(1623, 5730), xy(2293, 6820), xy(528, 5002), xy(1363, 7197)])
.
procedure gr_dests(List(GrXY)).
gr_dests([xy(2195, 12810), xy(1080, 7547), xy(3272, 7643), xy(2838, 8195), xy(2452, 1387), xy(1681, 3643), xy(2553, 9322), xy(3516, 8976)])
.
procedure gr_locs(List(Key)?, List(GrXY)?, List(GrLoc)).
gr_locs([], _, [])
.
gr_locs([_ | _], [], [])
.
gr_locs([K | Ks], [xy(X, Y) | XYs], [loc(K?, X?, Y?) | Ls?])
:-
gr_locs(Ks?, XYs?, Ls)
.
procedure gr_persons(List(Key)?, List(GrLoc)?, List(Person)).
gr_persons([], _, [])
.
gr_persons([Me | Ks], Locs, [P? | Ps?])
:-
ground(Me?)
,
ground(Locs?)
|
gr_person(Me?, Locs?, P)
,
gr_persons(Ks?, Locs?, Ps)
.
procedure gr_person(Key?, List(GrLoc)?, Person).
gr_person(Me, Locs, person(Me?, agent, [home(X?, Y?), kind(K?), knows(Kn?), points(Pt?), table(Locs?), dests(Ds?)]))
:-
ground(Me?)
,
ground(Locs?)
|
gr_loc_of(Me?, Locs?, X, Y)
,
gr_kind_of(Me?, K)
,
gr_others(Locs?, Me?, Kn)
,
gr_near_drivers(Locs?, Me?, Pt)
,
gr_dests(Ds)
.
procedure gr_kind_of(Key?, Constant).
gr_kind_of(K, driver)
:-
'@<'(K?, e)
|
true
.
gr_kind_of(_, rider)
:-
otherwise
|
true
.
procedure gr_loc_of(Key?, List(GrLoc)?, Integer, Integer).
gr_loc_of(_, [], 0, 0)
.
gr_loc_of(Me, [loc(Q, X, Y) | _], X?, Y?)
:-
'=?='(Me?, Q?)
|
true
.
gr_loc_of(Me, [_ | Ls], X?, Y?)
:-
otherwise
,
ground(Me?)
|
gr_loc_of(Me?, Ls?, X, Y)
.
procedure gr_others(List(GrLoc)?, Key?, List(Key)).
gr_others([], _, [])
.
gr_others([loc(Q, _, _) | Ls], Me, Ks?)
:-
'=?='(Q?, Me?)
|
gr_others(Ls?, Me?, Ks)
.
gr_others([loc(Q, _, _) | Ls], Me, [Q? | Ks?])
:-
otherwise
,
ground(Me?)
|
gr_others(Ls?, Me?, Ks)
.
procedure gr_near_drivers(List(GrLoc)?, Key?, List(Key)).
gr_near_drivers(Locs, Me, Pt?)
:-
ground(Locs?)
,
ground(Me?)
|
gr_loc_of(Me?, Locs?, X, Y)
,
gr_dsorted(Locs?, Me?, X?, Y?, Ds)
,
gr_take(3, Ds?, Pt)
.
procedure gr_dsorted(List(GrLoc)?, Key?, Integer?, Integer?, List(GrDk)).
gr_dsorted([], _, _, _, [])
.
gr_dsorted([loc(Q, X1, Y1) | Ls], Me, X, Y, Ds?)
:-
ground(Q?)
,
ground(Me?)
,
ground(X?)
,
ground(Y?)
|
gr_kind_of(Q?, K)
,
gr_same(Q?, Me?, Sm)
,
gr_dsorted1(K?, Sm?, Q?, X1?, Y1?, X?, Y?, Ls?, Me?, Ds)
.
procedure gr_dsorted1(Constant?, Constant?, Key?, Integer?, Integer?, Integer?, Integer?, List(GrLoc)?, Key?, List(GrDk)).
gr_dsorted1(driver, no, Q, X1, Y1, X, Y, Ls, Me, Ds?)
:-
ground(X?)
,
ground(Y?)
|
gr_dist(X?, Y?, X1?, Y1?, D)
,
gr_dsorted(Ls?, Me?, X?, Y?, Ds0)
,
gr_insert(dk(D?, Q?), Ds0?, Ds)
.
gr_dsorted1(_, _, _, _, _, X, Y, Ls, Me, Ds?)
:-
otherwise
|
gr_dsorted(Ls?, Me?, X?, Y?, Ds)
.
procedure gr_same(Key?, Key?, Constant).
gr_same(A, B, yes)
:-
'=?='(A?, B?)
|
true
.
gr_same(_, _, no)
:-
otherwise
|
true
.
procedure gr_dist(Integer?, Integer?, Integer?, Integer?, Integer).
gr_dist(X, Y, X1, Y1, D?)
:-
':='(D, '+'(abs('-'(X?, X1?)), abs('-'(Y?, Y1?))))
.
procedure gr_insert(GrDk?, List(GrDk)?, List(GrDk)).
gr_insert(dk(D, Q), [], [dk(D?, Q?)])
.
gr_insert(dk(D, Q), [dk(D1, Q1) | Ds], [dk(D?, Q?), dk(D1?, Q1?) | Ds?])
:-
'=<'(D?, D1?)
|
true
.
gr_insert(dk(D, Q), [dk(D1, Q1) | Ds], [dk(D1?, Q1?) | R?])
:-
'>'(D?, D1?)
|
gr_insert(dk(D?, Q?), Ds?, R)
.
procedure gr_take(Integer?, List(GrDk)?, List(Key)).
gr_take(0, _, [])
.
gr_take(K, [], [])
:-
'>'(K?, 0)
|
true
.
gr_take(K, [dk(_, Q) | Ds], [Q? | Qs?])
:-
'>'(K?, 0)
|
':='(K1, '-'(K?, 1))
,
gr_take(K1?, Ds?, Qs)
.
procedure gr_home(List(GrAttr)?, Integer, Integer).
gr_home([], 0, 0)
.
gr_home([home(X, Y) | _], X?, Y?)
.
gr_home([_ | As], X?, Y?)
:-
otherwise
|
gr_home(As?, X, Y)
.
procedure gr_kind(List(GrAttr)?, Constant).
gr_kind([], rider)
.
gr_kind([kind(K) | _], K?)
.
gr_kind([_ | As], K?)
:-
otherwise
|
gr_kind(As?, K)
.
procedure gr_aknows(List(GrAttr)?, List(Key)).
gr_aknows([], [])
.
gr_aknows([knows(V) | _], V?)
.
gr_aknows([_ | As], V?)
:-
otherwise
|
gr_aknows(As?, V)
.
procedure gr_apoints(List(GrAttr)?, List(Key)).
gr_apoints([], [])
.
gr_apoints([points(V) | _], V?)
.
gr_apoints([_ | As], V?)
:-
otherwise
|
gr_apoints(As?, V)
.
procedure gr_atable(List(GrAttr)?, List(GrLoc)).
gr_atable([], [])
.
gr_atable([table(V) | _], V?)
.
gr_atable([_ | As], V?)
:-
otherwise
|
gr_atable(As?, V)
.
procedure gr_adests(List(GrAttr)?, List(GrXY)).
gr_adests([], [])
.
gr_adests([dests(V) | _], V?)
.
gr_adests([_ | As], V?)
:-
otherwise
|
gr_adests(As?, V)
.
procedure gr_view(List(Output)?, List(Atom)).
gr_view([], [])
.
gr_view([view(_, A, _, _, _) | _], A?)
.
gr_view([refused(_, _, _) | L], A?)
:-
gr_view(L?, A)
.
procedure gr_has_id(List(Atom)?, Constant).
gr_has_id([], no)
.
gr_has_id([identity | _], yes)
.
gr_has_id([_ | As], R?)
:-
otherwise
|
gr_has_id(As?, R)
.
procedure gr_clock(List(Atom)?, Integer).
gr_clock([], 0)
.
gr_clock([clock(C) | _], C?)
.
gr_clock([_ | As], R?)
:-
otherwise
|
gr_clock(As?, R)
.
procedure gr_at(List(Atom)?, GrPos).
gr_at([], nopos)
.
gr_at([at(X, Y) | _], pos(X?, Y?))
.
gr_at([_ | As], R?)
:-
otherwise
|
gr_at(As?, R)
.
procedure gr_ride(List(Atom)?, GrRide).
gr_ride([], noride)
.
gr_ride([rides_with(B) | _], withb(B?))
.
gr_ride([_ | As], R?)
:-
otherwise
|
