.

GrTrip ::= trip(Constant) ; notrip.
procedure gr_open(List(Atom)?, GrTrip).
gr_open([], notrip)
.
gr_open([open_call(T) | _], trip(T?))
.
gr_open([_ | As], R?)
:-
otherwise
|
gr_open(As?, R)
.
procedure gr_unranked(List(Atom)?, GrUr).
gr_unranked([], noun)
.
gr_unranked([unranked(B, T, F, D) | _], ur(B?, T?, F?, D?))
.
gr_unranked([_ | As], R?)
:-
otherwise
|
