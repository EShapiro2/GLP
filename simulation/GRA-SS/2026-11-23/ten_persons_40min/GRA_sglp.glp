%% ---------------------------------------------------------------------------
%% GRA_sglp.glp --- SCRATCH (LBM, Ohad, 2026-11-22): a simulation of the
%% Second-Score Auction under sGLP, over the canonical CVA platform of the
%% scratch rules of programs/lbm/Auction.txt and Second-Score-Auction.txt
%% (branch gra-numbers), whose interface the cascade prints as
%% cascade/Second-Score-Auction/interface.glp.  Run with the scratch harness,
%% programs/sglp/gra/harness.glp.in (environment, clock, view filter):
%%   bash programs/sglp/gra/record.sh <dir>
%%
%% What it simulates.  Six drivers and four riders at real Manhattan pickup
%% points (GDO_sglp.glp's table).  Everyone first establishes, comes to know
%% and befriends everyone, and points to their three nearest drivers.  A
%% rider with nothing to do calls, about every two minutes, from where she is
%% to a destination drawn from the table, for three minutes of bidding, with
%% the terms A 50, lambda drawn in 1..3, T 10 minutes and a deposit of 5.  The
%% call carries its pickup point to the drivers.  A driver without a ride bids on
%% every call he has received: the delay his street
%% distance to the pickup point at 500 metres a minute, the fare 8 plus half
%% the delay plus a draw of 1..8.  After the bidding the rider ranks the bids
%% one by one and awards the ride by the second score, or closes the call.
%% The driver drives to the pickup point, about 500 metres a minute; the rider
%% waits there and records the pickup when he is there; from the pickup both
%% are where the car is, 500 metres a minute along the street path from the
%% pickup point to the destination, by the clock, so that both phones report
%% the same place; at the destination the rider releases the fare and the
%% refund min(P, lambda * lateness).  A rider not picked up by T cancels.  A
%% rider stays where her ride ended.  Time: the platform's day is one
%% simulated minute (the harness); the clock is read from the view.
%% ---------------------------------------------------------------------------

exported procedure source(SglpTerms).
source([
   %% The types.
   type('GrXY', [xy('Integer', 'Integer')]),
   type('GrLoc', [loc('Key', 'Integer', 'Integer')]),
   type('GrAttr', [home('Integer', 'Integer'), kind('Constant'), knows('List'('Key')), points('List'('Key')), table('List'('GrLoc')), dests('List'('GrXY'))]),
   type('Person', [person('Key', 'Constant', 'List'('GrAttr'))]),
   type('GrPick', [pick('Key'), nothing]),
   type('GrPos', [pos('Integer', 'Integer'), nopos]),
   type('GrRide', [withb('Key'), noride]),
   type('GrUr', [ur('Key', 'Constant', 'Integer', 'Integer'), noun]),
   type('GrLead', [lead('Key', 'Integer', 'Integer'), nolead]),
   type('GrDk', [dk('Integer', 'Key')]),
   type('GrCall', [cl('Key', 'Constant'), nocall]),
   %% THE CENSUS: six drivers and four riders at real Manhattan pickup points (GDO_sglp.glp's gd_manhattan).
   decl(gr_town(dual('Integer'), 'List'('Person'))),
   clause(gr_town(var('_'), var('Ps?')), [], [gr_keys(var('Ks')), gr_keys(var('Ks2')), gr_xys(var('XYs')), gr_locs(var('Ks?'), var('XYs?'), var('Locs')), gr_persons(var('Ks2?'), var('Locs?'), var('Ps'))]),
   decl(gr_keys('List'('Key'))),
   clause(gr_keys([d01, d02, d03, d04, d05, d06, r01, r02, r03, r04]), [], []),
   decl(gr_xys('List'('GrXY'))),
   clause(gr_xys([xy(2185, 4405), xy(2713, 4877), xy(1366, 5769), xy(2504, 5562), xy(1398, 6389), xy(2767, 6366), xy(1623, 5730), xy(2293, 6820), xy(528, 5002), xy(1363, 7197)]), [], []),
   decl(gr_dests('List'('GrXY'))),
   clause(gr_dests([xy(2195, 12810), xy(1080, 7547), xy(3272, 7643), xy(2838, 8195), xy(2452, 1387), xy(1681, 3643), xy(2553, 9322), xy(3516, 8976)]), [], []),
   decl(gr_locs(dual('List'('Key')), dual('List'('GrXY')), 'List'('GrLoc'))),
   clause(gr_locs([], var('_'), []), [], []),
   clause(gr_locs([var('_')|var('_')], [], []), [], []),
   clause(gr_locs([var('K')|var('Ks')], [xy(var('X'), var('Y'))|var('XYs')], [loc(var('K?'), var('X?'), var('Y?'))|var('Ls?')]), [], [gr_locs(var('Ks?'), var('XYs?'), var('Ls'))]),
   decl(gr_persons(dual('List'('Key')), dual('List'('GrLoc')), 'List'('Person'))),
   clause(gr_persons([], var('_'), []), [], []),
   clause(gr_persons([var('Me')|var('Ks')], var('Locs'), [var('P?')|var('Ps?')]), [ground(var('Me?')), ground(var('Locs?'))], [gr_person(var('Me?'), var('Locs?'), var('P')), gr_persons(var('Ks?'), var('Locs?'), var('Ps'))]),
   decl(gr_person(dual('Key'), dual('List'('GrLoc')), 'Person')),
   clause(gr_person(var('Me'), var('Locs'), person(var('Me?'), agent, [home(var('X?'), var('Y?')), kind(var('K?')), knows(var('Kn?')), points(var('Pt?')), table(var('Locs?')), dests(var('Ds?'))])), [ground(var('Me?')), ground(var('Locs?'))], [gr_loc_of(var('Me?'), var('Locs?'), var('X'), var('Y')), gr_kind_of(var('Me?'), var('K')), gr_others(var('Locs?'), var('Me?'), var('Kn')), gr_near_drivers(var('Locs?'), var('Me?'), var('Pt')), gr_dests(var('Ds'))]),
   decl(gr_kind_of(dual('Key'), 'Constant')),
   clause(gr_kind_of(var('K'), driver), ['@<'(var('K?'), e)], [true]),
   clause(gr_kind_of(var('_'), rider), [otherwise], [true]),
   decl(gr_loc_of(dual('Key'), dual('List'('GrLoc')), 'Integer', 'Integer')),
   clause(gr_loc_of(var('_'), [], 0, 0), [], []),
   clause(gr_loc_of(var('Me'), [loc(var('Q'), var('X'), var('Y'))|var('_')], var('X?'), var('Y?')), ['=?='(var('Me?'), var('Q?'))], [true]),
   clause(gr_loc_of(var('Me'), [var('_')|var('Ls')], var('X?'), var('Y?')), [otherwise, ground(var('Me?'))], [gr_loc_of(var('Me?'), var('Ls?'), var('X'), var('Y'))]),
   decl(gr_others(dual('List'('GrLoc')), dual('Key'), 'List'('Key'))),
   clause(gr_others([], var('_'), []), [], []),
   clause(gr_others([loc(var('Q'), var('_'), var('_'))|var('Ls')], var('Me'), var('Ks?')), ['=?='(var('Q?'), var('Me?'))], [gr_others(var('Ls?'), var('Me?'), var('Ks'))]),
   clause(gr_others([loc(var('Q'), var('_'), var('_'))|var('Ls')], var('Me'), [var('Q?')|var('Ks?')]), [otherwise, ground(var('Me?'))], [gr_others(var('Ls?'), var('Me?'), var('Ks'))]),
   %% gr_near_drivers(Locs?, Me?, Pt): the three drivers nearest Me, by street distance, Me not among them.
   decl(gr_near_drivers(dual('List'('GrLoc')), dual('Key'), 'List'('Key'))),
   clause(gr_near_drivers(var('Locs'), var('Me'), var('Pt?')), [ground(var('Locs?')), ground(var('Me?'))], [gr_loc_of(var('Me?'), var('Locs?'), var('X'), var('Y')), gr_dsorted(var('Locs?'), var('Me?'), var('X?'), var('Y?'), var('Ds')), gr_take(3, var('Ds?'), var('Pt'))]),
   decl(gr_dsorted(dual('List'('GrLoc')), dual('Key'), dual('Integer'), dual('Integer'), 'List'('GrDk'))),
   clause(gr_dsorted([], var('_'), var('_'), var('_'), []), [], []),
   clause(gr_dsorted([loc(var('Q'), var('X1'), var('Y1'))|var('Ls')], var('Me'), var('X'), var('Y'), var('Ds?')), [ground(var('Q?')), ground(var('Me?')), ground(var('X?')), ground(var('Y?'))], [gr_kind_of(var('Q?'), var('K')), gr_same(var('Q?'), var('Me?'), var('Sm')), gr_dsorted1(var('K?'), var('Sm?'), var('Q?'), var('X1?'), var('Y1?'), var('X?'), var('Y?'), var('Ls?'), var('Me?'), var('Ds'))]),
   decl(gr_dsorted1(dual('Constant'), dual('Constant'), dual('Key'), dual('Integer'), dual('Integer'), dual('Integer'), dual('Integer'), dual('List'('GrLoc')), dual('Key'), 'List'('GrDk'))),
   clause(gr_dsorted1(driver, no, var('Q'), var('X1'), var('Y1'), var('X'), var('Y'), var('Ls'), var('Me'), var('Ds?')), [ground(var('X?')), ground(var('Y?'))], [gr_dist(var('X?'), var('Y?'), var('X1?'), var('Y1?'), var('D')), gr_dsorted(var('Ls?'), var('Me?'), var('X?'), var('Y?'), var('Ds0')), gr_insert(dk(var('D?'), var('Q?')), var('Ds0?'), var('Ds'))]),
   clause(gr_dsorted1(var('_'), var('_'), var('_'), var('_'), var('_'), var('X'), var('Y'), var('Ls'), var('Me'), var('Ds?')), [otherwise], [gr_dsorted(var('Ls?'), var('Me?'), var('X?'), var('Y?'), var('Ds'))]),
   decl(gr_same(dual('Key'), dual('Key'), 'Constant')),
   clause(gr_same(var('A'), var('B'), yes), ['=?='(var('A?'), var('B?'))], [true]),
   clause(gr_same(var('_'), var('_'), no), [otherwise], [true]),
   decl(gr_dist(dual('Integer'), dual('Integer'), dual('Integer'), dual('Integer'), 'Integer')),
   clause(gr_dist(var('X'), var('Y'), var('X1'), var('Y1'), var('D?')), [], [':='(var('D'), '+'(abs('-'(var('X?'), var('X1?'))), abs('-'(var('Y?'), var('Y1?')))))]),
   decl(gr_insert(dual('GrDk'), dual('List'('GrDk')), 'List'('GrDk'))),
   clause(gr_insert(dk(var('D'), var('Q')), [], [dk(var('D?'), var('Q?'))]), [], []),
   clause(gr_insert(dk(var('D'), var('Q')), [dk(var('D1'), var('Q1'))|var('Ds')], [dk(var('D?'), var('Q?')), dk(var('D1?'), var('Q1?'))|var('Ds?')]), ['=<'(var('D?'), var('D1?'))], [true]),
   clause(gr_insert(dk(var('D'), var('Q')), [dk(var('D1'), var('Q1'))|var('Ds')], [dk(var('D1?'), var('Q1?'))|var('R?')]), ['>'(var('D?'), var('D1?'))], [gr_insert(dk(var('D?'), var('Q?')), var('Ds?'), var('R'))]),
   decl(gr_take(dual('Integer'), dual('List'('GrDk')), 'List'('Key'))),
   clause(gr_take(0, var('_'), []), [], []),
   clause(gr_take(var('K'), [], []), ['>'(var('K?'), 0)], [true]),
   clause(gr_take(var('K'), [dk(var('_'), var('Q'))|var('Ds')], [var('Q?')|var('Qs?')]), ['>'(var('K?'), 0)], [':='(var('K1'), '-'(var('K?'), 1)), gr_take(var('K1?'), var('Ds?'), var('Qs'))]),
   %% The attributes.
   decl(gr_home(dual('List'('GrAttr')), 'Integer', 'Integer')),
   clause(gr_home([], 0, 0), [], []),
   clause(gr_home([home(var('X'), var('Y'))|var('_')], var('X?'), var('Y?')), [], []),
   clause(gr_home([var('_')|var('As')], var('X?'), var('Y?')), [otherwise], [gr_home(var('As?'), var('X'), var('Y'))]),
   decl(gr_kind(dual('List'('GrAttr')), 'Constant')),
   clause(gr_kind([], rider), [], []),
   clause(gr_kind([kind(var('K'))|var('_')], var('K?')), [], []),
   clause(gr_kind([var('_')|var('As')], var('K?')), [otherwise], [gr_kind(var('As?'), var('K'))]),
   decl(gr_aknows(dual('List'('GrAttr')), 'List'('Key'))),
   clause(gr_aknows([], []), [], []),
   clause(gr_aknows([knows(var('V'))|var('_')], var('V?')), [], []),
   clause(gr_aknows([var('_')|var('As')], var('V?')), [otherwise], [gr_aknows(var('As?'), var('V'))]),
   decl(gr_apoints(dual('List'('GrAttr')), 'List'('Key'))),
   clause(gr_apoints([], []), [], []),
   clause(gr_apoints([points(var('V'))|var('_')], var('V?')), [], []),
   clause(gr_apoints([var('_')|var('As')], var('V?')), [otherwise], [gr_apoints(var('As?'), var('V'))]),
   decl(gr_atable(dual('List'('GrAttr')), 'List'('GrLoc'))),
   clause(gr_atable([], []), [], []),
   clause(gr_atable([table(var('V'))|var('_')], var('V?')), [], []),
   clause(gr_atable([var('_')|var('As')], var('V?')), [otherwise], [gr_atable(var('As?'), var('V'))]),
   decl(gr_adests(dual('List'('GrAttr')), 'List'('GrXY'))),
   clause(gr_adests([], []), [], []),
   clause(gr_adests([dests(var('V'))|var('_')], var('V?')), [], []),
   clause(gr_adests([var('_')|var('As')], var('V?')), [otherwise], [gr_adests(var('As?'), var('V'))]),
   %% What the last view shows.
   decl(gr_view(dual('List'('Output')), 'List'('Atom'))),
   clause(gr_view([], []), [], []),
   clause(gr_view([view(var('_'), var('A'), var('_'), var('_'), var('_'))|var('_')], var('A?')), [], []),
   clause(gr_view([refused(var('_'), var('_'), var('_'))|var('L')], var('A?')), [], [gr_view(var('L?'), var('A'))]),
   decl(gr_has_id(dual('List'('Atom')), 'Constant')),
   clause(gr_has_id([], no), [], []),
   clause(gr_has_id([identity|var('_')], yes), [], []),
   clause(gr_has_id([var('_')|var('As')], var('R?')), [otherwise], [gr_has_id(var('As?'), var('R'))]),
   decl(gr_clock(dual('List'('Atom')), 'Integer')),
   clause(gr_clock([], 0), [], []),
   clause(gr_clock([clock(var('C'))|var('_')], var('C?')), [], []),
   clause(gr_clock([var('_')|var('As')], var('R?')), [otherwise], [gr_clock(var('As?'), var('R'))]),
   decl(gr_at(dual('List'('Atom')), 'GrPos')),
   clause(gr_at([], nopos), [], []),
   clause(gr_at([at(var('X'), var('Y'))|var('_')], pos(var('X?'), var('Y?'))), [], []),
   clause(gr_at([var('_')|var('As')], var('R?')), [otherwise], [gr_at(var('As?'), var('R'))]),
   decl(gr_ride(dual('List'('Atom')), 'GrRide')),
   clause(gr_ride([], noride), [], []),
   clause(gr_ride([rides_with(var('B'))|var('_')], withb(var('B?'))), [], []),
   clause(gr_ride([var('_')|var('As')], var('R?')), [otherwise], [gr_ride(var('As?'), var('R'))]),
   type('GrTrip', [trip('Constant'), notrip]),
   decl(gr_open(dual('List'('Atom')), 'GrTrip')),
   clause(gr_open([], notrip), [], []),
   clause(gr_open([open_call(var('T'))|var('_')], trip(var('T?'))), [], []),
   clause(gr_open([var('_')|var('As')], var('R?')), [otherwise], [gr_open(var('As?'), var('R'))]),
   decl(gr_unranked(dual('List'('Atom')), 'GrUr')),
   clause(gr_unranked([], noun), [], []),
   clause(gr_unranked([unranked(var('B'), var('T'), var('F'), var('D'))|var('_')], ur(var('B?'), var('T?'), var('F?'), var('D?'))), [], []),
   clause(gr_unranked([var('_')|var('As')], var('R?')), [otherwise], [gr_unranked(var('As?'), var('R'))]),
   decl(gr_keys_of(dual('Constant'), dual('List'('Atom')), 'List'('Key'))),
   clause(gr_keys_of(var('_'), [], []), [], []),
   clause(gr_keys_of(knows, [knows(var('Q'))|var('As')], [var('Q?')|var('Qs?')]), [], [gr_keys_of(knows, var('As?'), var('Qs'))]),
   clause(gr_keys_of(friend, [friend(var('Q'))|var('As')], [var('Q?')|var('Qs?')]), [], [gr_keys_of(friend, var('As?'), var('Qs'))]),
   clause(gr_keys_of(points, [points_to(var('Q'))|var('As')], [var('Q?')|var('Qs?')]), [], [gr_keys_of(points, var('As?'), var('Qs'))]),
   clause(gr_keys_of(var('W'), [var('_')|var('As')], var('Qs?')), [otherwise], [gr_keys_of(var('W?'), var('As?'), var('Qs'))]),
   decl(gr_first_missing(dual('List'('Key')), dual('List'('Key')), 'GrPick')),
   clause(gr_first_missing([], var('_'), nothing), [], []),
   clause(gr_first_missing([var('X')|var('Xs')], var('Ks'), var('P?')), [ground(var('X?')), ground(var('Ks?'))], [gr_mem(var('X?'), var('Ks?'), var('In')), gr_fm1(var('In?'), var('X?'), var('Xs?'), var('Ks?'), var('P'))]),
   decl(gr_fm1(dual('Constant'), dual('Key'), dual('List'('Key')), dual('List'('Key')), 'GrPick')),
   clause(gr_fm1(no, var('X'), var('_'), var('_'), pick(var('X?'))), [], []),
   clause(gr_fm1(yes, var('_'), var('Xs'), var('Ks'), var('P?')), [], [gr_first_missing(var('Xs?'), var('Ks?'), var('P'))]),
   decl(gr_mem(dual('Key'), dual('List'('Key')), 'Constant')),
   clause(gr_mem(var('_'), [], no), [], []),
   clause(gr_mem(var('X'), [var('Y')|var('_')], yes), ['=?='(var('X?'), var('Y?'))], [true]),
   clause(gr_mem(var('X'), [var('_')|var('Ys')], var('R?')), [otherwise], [gr_mem(var('X?'), var('Ys?'), var('R'))]),
   %% THE PROFILE.  One profile, steady, a tick every ten seconds on average; every approval yes.
   person(steady),
   binds('Request', steady_request),
   binds('Approval', steady_approval),
   decl(steady_request('Request', dual('Person'), dual('Integer'))),
   clause(steady_request(var('R?'), person(var('Me'), var('_'), var('As')), var('S')), [], [rated(gr_tick(var('Me?'), var('As?'), var('S?'), slot(var('R'))), rate(6, minute))]),
   decl(steady_approval(dual('Approval'), dual('Person'), dual('Integer'))),
   clause(steady_approval(approval(var('_'), var('_'), var('A?')), var('_'), var('_')), [], [gr_say(slot(var('A')), yes)]),
   decl(gr_say(dual('Slot'('YesNo')), dual('YesNo'))),
   clause(gr_say(slot(var('V?')), var('V')), [], []),
   decl(gr_tick(dual('Key'), dual('List'('GrAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gr_tick(var('Me'), var('As'), var('S'), slot(var('W?'))), [], [seen(var('L')), gr_view(var('L?'), var('Atoms')), gr_decide(var('Atoms?'), var('Me?'), var('As?'), var('S?'), slot(var('W')))]),
   %% THE SETUP: identity, a place, everyone known, befriended, and the three nearest drivers pointed to.
   decl(gr_decide(dual('List'('Atom')), dual('Key'), dual('List'('GrAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gr_decide(var('Atoms'), var('Me'), var('As'), var('S'), slot(var('W?'))), [ground(var('Atoms?')), ground(var('Me?')), ground(var('As?'))], [gr_has_id(var('Atoms?'), var('Id')), gr_d1(var('Id?'), var('Atoms?'), var('Me?'), var('As?'), var('S?'), slot(var('W')))]),
   decl(gr_d1(dual('Constant'), dual('List'('Atom')), dual('Key'), dual('List'('GrAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gr_d1(no, var('_'), var('Me'), var('_'), var('_'), slot(propose(establish(var('Me?'))))), [], []),
   clause(gr_d1(yes, var('Atoms'), var('Me'), var('As'), var('S'), slot(var('W?'))), [ground(var('Atoms?'))], [gr_at(var('Atoms?'), var('P')), gr_d2(var('P?'), var('Atoms?'), var('Me?'), var('As?'), var('S?'), slot(var('W')))]),
   decl(gr_d2(dual('GrPos'), dual('List'('Atom')), dual('Key'), dual('List'('GrAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gr_d2(nopos, var('_'), var('Me'), var('As'), var('_'), slot(propose(move(var('Me?'), var('X?'), var('Y?'))))), [], [gr_home(var('As?'), var('X'), var('Y'))]),
   clause(gr_d2(pos(var('X'), var('Y')), var('Atoms'), var('Me'), var('As'), var('S'), slot(var('W?'))), [ground(var('Atoms?')), ground(var('As?'))], [gr_aknows(var('As?'), var('Kn')), gr_keys_of(knows, var('Atoms?'), var('Kw')), gr_first_missing(var('Kn?'), var('Kw?'), var('U')), gr_d3(var('U?'), var('X?'), var('Y?'), var('Atoms?'), var('Me?'), var('As?'), var('S?'), slot(var('W')))]),
   decl(gr_d3(dual('GrPick'), dual('Integer'), dual('Integer'), dual('List'('Atom')), dual('Key'), dual('List'('GrAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gr_d3(pick(var('Q')), var('_'), var('_'), var('_'), var('Me'), var('_'), var('_'), slot(propose(acquaint(var('Me?'), var('Q?'))))), [], []),
   clause(gr_d3(nothing, var('X'), var('Y'), var('Atoms'), var('Me'), var('As'), var('S'), slot(var('W?'))), [ground(var('Atoms?')), ground(var('As?'))], [gr_aknows(var('As?'), var('Kn')), gr_keys_of(friend, var('Atoms?'), var('Fr')), gr_first_missing(var('Kn?'), var('Fr?'), var('U')), gr_d4(var('U?'), var('X?'), var('Y?'), var('Atoms?'), var('Me?'), var('As?'), var('S?'), slot(var('W')))]),
   decl(gr_d4(dual('GrPick'), dual('Integer'), dual('Integer'), dual('List'('Atom')), dual('Key'), dual('List'('GrAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gr_d4(pick(var('Q')), var('_'), var('_'), var('_'), var('Me'), var('_'), var('_'), slot(propose(befriend(var('Me?'), var('Q?'))))), [], []),
   clause(gr_d4(nothing, var('X'), var('Y'), var('Atoms'), var('Me'), var('As'), var('S'), slot(var('W?'))), [ground(var('Atoms?')), ground(var('As?'))], [gr_apoints(var('As?'), var('Pt0')), gr_keys_of(points, var('Atoms?'), var('Pt')), gr_first_missing(var('Pt0?'), var('Pt?'), var('U')), gr_d5(var('U?'), var('X?'), var('Y?'), var('Atoms?'), var('Me?'), var('As?'), var('S?'), slot(var('W')))]),
   decl(gr_d5(dual('GrPick'), dual('Integer'), dual('Integer'), dual('List'('Atom')), dual('Key'), dual('List'('GrAttr')), dual('Integer'), dual('Slot'('Request')))),
   clause(gr_d5(pick(var('Q')), var('_'), var('_'), var('_'), var('Me'), var('_'), var('_'), slot(propose(point_friend(var('Me?'), var('Q?'))))), [], []),
