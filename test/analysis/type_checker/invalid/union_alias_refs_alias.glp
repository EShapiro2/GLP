% Test: Union alias referencing another alias
% Expected: FAIL - union alias cannot reference another alias

BaseType ::= base.
AliasToBase ::= BaseType.
OtherType ::= other.

% This should fail: AliasToBase is a simple alias, not a defined type
BadUnion ::= AliasToBase ; OtherType.

procedure test(BadUnion?).
test(base).
test(other).
