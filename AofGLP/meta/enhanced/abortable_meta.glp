%% abortable_meta.glp - Abortable metainterpreter
%% Source: CP Collected Papers, Ch 25 (Safra & Shapiro)
%%
%% Adds ability to abort computation via Abort argument.
%% When Abort is bound to 'abort', computation stops.

run(true, _).                                    %% halt
run((A, B), Abort) :-                            %% fork
    ground(Abort?), ~(Abort? =?= abort) |
    run(A?, Abort?),
    run(B?, Abort?).
run(Goal, Abort) :-                              %% reduce
    ~(Goal? =?= true), ~(Goal? =?= (_, _)),
    ~(Abort? =?= abort) |
    reduce(Goal?, Body),
    run(Body?, Abort?).
run(_, abort).                                   %% abort

%% Object program: merge
reduce(merge([X|Xs], Ys, [X?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge(Xs, [Y|Ys], [Y?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge([], [], []), true).

%% Usage: run(Goal, Abort?)
%% To abort: bind Abort to 'abort'
