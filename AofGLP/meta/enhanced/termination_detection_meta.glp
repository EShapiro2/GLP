%% termination_detection_meta.glp - Termination detecting metainterpreter
%% Source: CP Collected Papers, Ch 25 (Safra & Shapiro)
%%
%% Uses short-circuit technique to detect distributed termination.
%% Initial call: run(Goal, chain(done, Done))
%% Done? binds to 'done' when computation terminates.

run(true, chain(Chain, Chain?)).                 %% halt - close circuit
run((A, B), chain(Left, Right?)) :-              %% fork - split chain
    run(A?, chain(Left?, Middle)),
    run(B?, chain(Middle?, Right)).
run(Goal, chain(Left, Right?)) :-                %% reduce - pass chain
    ground(Goal?),
    ~(Goal? =?= true), ~(Goal? =?= (_, _)) |
    reduce(Goal?, Body),
    run(Body?, chain(Left?, Right)).

%% Object program: merge
reduce(merge([X|Xs], Ys, [X?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge(Xs, [Y|Ys], [Y?|Zs?]), merge(Xs?, Ys?, Zs)).
reduce(merge([], [], []), true).

%% Usage:
%% run(MyGoal, chain(done, Done)), wait_for(Done?).
%% wait_for(done).
