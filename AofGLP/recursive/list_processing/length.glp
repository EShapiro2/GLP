%% length.glp - List length with accumulator
%% Source: Standard GLP list operations

length(Xs, N?) :- length_acc(Xs?, 0, N).

length_acc([], Acc, Acc?).
length_acc([_|Xs], Acc, N?) :-
    Acc1 := Acc? + 1,
    length_acc(Xs?, Acc1?, N).

%% Metainterpreter support
reduce(length(Xs, N?), length_acc(Xs?, 0, N)).
reduce(length_acc([], Acc, Acc?), true).
reduce(length_acc([_|Xs], Acc, N?), (Acc1 := Acc? + 1, length_acc(Xs?, Acc1?, N))).
reduce((X? := T), true) :- X := T? | true.
